//! Emit Wado from a parsed java2wado `JExpr` / `JStmt`. Operators pass through,
//! `$`-refs route through `resolve_attr_ref`, a string `+` chain becomes a
//! template literal, and method mapping is snake_case over the grammar's own
//! `@members` methods (see `java2wado.md`). A method call or constant that
//! resolves to nothing real is a loud error, not a silently broken emit.

use { ParserRule } from "../ir.wado";
use { resolve_attr_ref, rule_binding_for, rule_is_left_recursive, LR_ACC_LOCAL } from "../action_translate.wado";
use { to_snake_case } from "../ident.wado";
use { JExpr, JMember, JCall, JCast, JStmt, JLocal, JAssign } from "./jparser.wado";
use { tokenize_java } from "./jlexer.wado";
use { parse_java_expr, parse_java_stmts } from "./jparser.wado";

/// Emit environment: the recognizer handle (`p` in a parse / predicate body,
/// `self` in a `@members` method body), the grammar name (for the
/// `<Name>Parser` / `<Name>Lexer` token-constant qualifier), and the snake_cased
/// `@members` method names a call may resolve to.
pub struct JEnv {
    pub this_bind: String,
    pub grammar: String,
    pub methods: List<String>,
}

pub fn translate_java_expr(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    let tokens = tokenize_java(body)?;
    let expr = parse_java_expr(&tokens)?;
    return emit_expr(rule, rules, &expr, vals_in_scope, bindings, env);
}

pub fn translate_java_stmts(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    let tokens = tokenize_java(body)?;
    let stmts = parse_java_stmts(&tokens)?;
    return emit_java_stmts(rule, rules, &stmts, vals_in_scope, bindings, env);
}

/// Space-joined statements (each already carries its `;`).
pub fn emit_java_stmts(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    stmts: &List<JStmt>,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    let mut out = String::from("");
    for let mut i = 0; i < stmts.len(); i += 1 {
        if i > 0 {
            out.push_str(&" ");
        }
        out.push_str(&emit_stmt(rule, rules, &stmts[i], vals_in_scope, bindings, env)?);
    }
    return Result::Ok(out);
}

fn emit_stmt(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    s: &JStmt,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    return match s {
        Expr(e) => {
            let w = emit_expr(rule, rules, e, vals_in_scope, bindings, env)?;
            Result::Ok(`{w};`);
        },
        Local(l) => emit_local(rule, rules, l, vals_in_scope, bindings, env),
        Assign(a) => {
            let target = emit_expr(rule, rules, &a.target, vals_in_scope, bindings, env)?;
            let value = emit_expr(rule, rules, &a.value, vals_in_scope, bindings, env)?;
            Result::Ok(`{target} {a.op} {value};`);
        },
        Return(v) => match v {
            Some(e) => {
                let w = emit_expr(rule, rules, e, vals_in_scope, bindings, env)?;
                Result::Ok(`return {w};`);
            },
            None => Result::Ok("return;"),
        },
    };
}

fn emit_local(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    l: &JLocal,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    let ty = match map_java_type(&l.ty) {
        Some(t) => t,
        None => {
            return Result::Err(`java2wado: unsupported local type '{l.ty}'`);
        },
    };
    let init = match &l.init {
        Some(e) => emit_expr(rule, rules, e, vals_in_scope, bindings, env)?,
        None => {
            return Result::Err(`java2wado: local '{l.name}' needs an initializer`);
        },
    };
    return Result::Ok(`let mut {l.name}: {ty} = {init};`);
}

/// Emit `System.out.print`/`println` as `<this>.emit(<template>)`, rendering the
/// argument as a template literal and appending `\n` for `println`.
fn emit_print(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    args: &List<JExpr>,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
    newline: bool,
) -> Result<String, String> {
    let mut tmpl = String::from("`");
    if !args.is_empty() {
        append_parts(rule, rules, &args[0], vals_in_scope, bindings, env, &mut tmpl)?;
    }
    if newline {
        tmpl.push_str(&"\\n");
    }
    tmpl.push('`');
    return Result::Ok(`{env.this_bind}.emit({tmpl})`);
}

/// Java primitive / `String` type text to its Wado type, or `None` if outside
/// the subset (a loud error — the subset grows on demand).
pub fn map_java_type(ty: &String) -> Option<String> {
    return match ty.trim() {
        "int" => Option::Some("i32"),
        "short" => Option::Some("i16"),
        "byte" => Option::Some("i8"),
        "long" => Option::Some("i64"),
        "float" => Option::Some("f32"),
        "double" => Option::Some("f64"),
        "boolean" => Option::Some("bool"),
        "String" => Option::Some("String"),
        _ => null,
    };
}

pub fn emit_expr(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    return match e {
        Int(v) => Result::Ok(*v),
        Bool(b) => Result::Ok(if *b { String::from("true") } else { String::from("false") }),
        Str(c) => Result::Ok(`"{*c}"`),
        Attr(text) => resolve_attr_ref(rule, rules, text, vals_in_scope, bindings, &env.this_bind),
        Name(n) => Result::Ok(if *n == "this" { env.this_bind } else { *n }),
        Member(m) => emit_member(rule, rules, m, vals_in_scope, bindings, env),
        Call(c) => emit_call(rule, rules, c, vals_in_scope, bindings, env),
        Cast(c) => emit_expr(rule, rules, &c.operand, vals_in_scope, bindings, env),
        Unary(u) => {
            let operand = emit_expr(rule, rules, &u.operand, vals_in_scope, bindings, env)?;
            Result::Ok(`{u.op}{operand}`);
        },
        Paren(p) => {
            let inner = emit_expr(rule, rules, &p.inner, vals_in_scope, bindings, env)?;
            Result::Ok(`({inner})`);
        },
        Binary(b) => {
            if b.op == "+" && is_string_concat(e) {
                emit_template(rule, rules, e, vals_in_scope, bindings, env);
            } else {
                let l = emit_expr(rule, rules, &b.lhs, vals_in_scope, bindings, env)?;
                let r = emit_expr(rule, rules, &b.rhs, vals_in_scope, bindings, env)?;
                Result::Ok(`{l} {b.op} {r}`);
            }
        },
    };
}

fn emit_member(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    m: &JMember,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    if name_is(&m.recv, &"this") {
        return Result::Ok(`{env.this_bind}.{m.name}`);
    }
    if is_upper_ident(&m.name) && is_name(&m.recv) {
        if recv_is_grammar_class(env, &m.recv) {
            return Result::Ok(`TK_{m.name}`);
        }
        return Result::Err(`java2wado: unknown constant '{name_text(&m.recv)}.{m.name}'`);
    }
    let r = emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
    return Result::Ok(`{r}.{m.name}`);
}

fn emit_call(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    c: &JCall,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    if let Member(m) = &c.callee {
        if is_ctx_expr(&m.recv) {
            return emit_ctx_child(rule, m, &c.args, bindings);
        }
    }
    let args_w = emit_args(rule, rules, &c.args, vals_in_scope, bindings, env)?;
    return match &c.callee {
        Member(m) => emit_member_call(rule, rules, m, &c.args, &args_w, vals_in_scope, bindings, env),
        Name(n) => {
            if *n == "getText" {
                Result::Ok(`{env.this_bind}.rule_text()`);
            } else if method_declared(env, n) {
                Result::Ok(`{env.this_bind}.{to_snake_case(n)}({args_w})`);
            } else {
                Result::Err(unknown_method_err(n));
            }
        },
        _ => Result::Err("java2wado: unsupported call target"),
    };
}

/// Whether `e` reduces (through parens and casts) to the `$ctx` special — the
/// receiver of a ctx-child accessor `((BinaryContext)$ctx).e(0)`.
fn is_ctx_expr(e: &JExpr) -> bool {
    return match e {
        Attr(t) => *t == "$ctx",
        Paren(p) => is_ctx_expr(&p.inner),
        Cast(c) => is_ctx_expr(&c.operand),
        _ => false,
    };
}

/// Map `((Ctx)$ctx).<rule>(i)` onto the LR operand vals: child 0 is the
/// precedence accumulator `_lr_acc`, child i>=1 is the i-th suffix self-ref.
/// Only valid inside a left-recursive rule for its own children; else a loud error.
fn emit_ctx_child(
    rule: &ParserRule,
    m: &JMember,
    args: &List<JExpr>,
    bindings: &List<[bool, String, String]>,
) -> Result<String, String> {
    if !rule_is_left_recursive(rule) {
        return Result::Err("java2wado: `$ctx` child access is only supported in a left-recursive rule");
    }
    if m.name != rule.name {
        return Result::Err(`java2wado: $ctx.{m.name}(...): only the rule's own children are supported`);
    }
    if args.is_empty() {
        return Result::Err(`java2wado: $ctx.{m.name}(): token/child accessor form not yet supported`);
    }
    let idx = match &args[0] {
        Int(s) => *s,
        _ => {
            return Result::Err(`java2wado: $ctx.{m.name}(...): child index must be an integer literal`);
        },
    };
    if idx == "0" {
        return Result::Ok(LR_ACC_LOCAL);
    }
    return Result::Ok(rule_binding_for(bindings, &m.name));
}

fn emit_member_call(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    m: &JMember,
    raw_args: &List<JExpr>,
    args_w: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    let meth = m.name;
    if (meth == "println" || meth == "print") && is_system_out(&m.recv) {
        let newline = meth == "println";
        return emit_print(rule, rules, raw_args, vals_in_scope, bindings, env, newline);
    }
    if meth == "getText" {
        if name_is(&m.recv, &"_input") {
            return Result::Ok(`{env.this_bind}.input_text()`);
        }
        let r = emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
        return Result::Ok(`{env.this_bind}.token_text({r})`);
    }
    if meth == "LA" && name_is(&m.recv, &"_input") {
        return Result::Ok(`{env.this_bind}.la({*args_w})`);
    }
    if meth == "LT" && name_is(&m.recv, &"_input") {
        return Result::Ok(`{env.this_bind}.lt({*args_w})`);
    }
    if meth == "equals" {
        if raw_args.is_empty() {
            return Result::Err("java2wado: .equals() with no argument");
        }
        let r = emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
        let a = emit_expr(rule, rules, &raw_args[0], vals_in_scope, bindings, env)?;
        return Result::Ok(`({r} == {a})`);
    }
    if !method_declared(env, &meth) {
        return Result::Err(unknown_method_err(&meth));
    }
    let recv_w = if name_is(&m.recv, &"this") {
        env.this_bind;
    } else {
        emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
    };
    return Result::Ok(`{recv_w}.{to_snake_case(&meth)}({*args_w})`);
}

/// Whether `name` resolves to a declared `@members` method (compared
/// snake_cased, matching the call-site rewrite and the method definition).
fn method_declared(env: &JEnv, name: &String) -> bool {
    let snake = to_snake_case(name);
    for let m of &env.methods {
        if *m == snake {
            return true;
        }
    }
    return false;
}

fn unknown_method_err(name: &String) -> String {
    return `java2wado: unsupported method '{*name}': not a @members method or a recognizer API method`;
}

/// Whether `e` names the grammar's own parser / lexer class (`<Name>Parser` /
/// `<Name>Lexer`), the qualifier of a token constant `TParser.ELSE`.
fn recv_is_grammar_class(env: &JEnv, e: &JExpr) -> bool {
    return match e {
        Name(q) => *q == `{env.grammar}Parser` || *q == `{env.grammar}Lexer`,
        _ => false,
    };
}

fn name_text(e: &JExpr) -> String {
    return match e {
        Name(n) => *n,
        _ => "",
    };
}

fn emit_args(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    args: &List<JExpr>,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    let mut out = String::from("");
    for let mut i = 0; i < args.len(); i += 1 {
        if i > 0 {
            out.push_str(&", ");
        }
        out.push_str(&emit_expr(rule, rules, &args[i], vals_in_scope, bindings, env)?);
    }
    return Result::Ok(out);
}

fn name_is(e: &JExpr, s: &String) -> bool {
    return match e {
        Name(n) => *n == *s,
        _ => false,
    };
}

fn is_name(e: &JExpr) -> bool {
    return e matches { Name(_) };
}

fn is_system_out(e: &JExpr) -> bool {
    return match e {
        Member(m) => name_is(&m.recv, &"System") && m.name == "out",
        _ => false,
    };
}

/// An all-uppercase identifier (`NL`, `ELSE`, `LL_EXACT`): a token-type constant
/// when qualified (`TParser.NL`). Digits and `_` allowed; needs one A-Z.
fn is_upper_ident(name: &String) -> bool {
    let mut has_alpha = false;
    for let c of name.chars() {
        if c >= 'A' && c <= 'Z' {
            has_alpha = true;
        } else if !(c >= '0' && c <= '9' || c == '_') {
            return false;
        }
    }
    return has_alpha;
}

/// Whether a `+` chain is string concatenation: some leaf is a string literal.
fn is_string_concat(e: &JExpr) -> bool {
    return match e {
        Str(_) => true,
        Binary(b) => b.op == "+" && (is_string_concat(&b.lhs) || is_string_concat(&b.rhs)),
        Paren(p) => is_string_concat(&p.inner),
        _ => false,
    };
}

/// Emit a string `+` chain as a Wado template literal.
fn emit_template(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
) -> Result<String, String> {
    let mut out = String::from("`");
    append_parts(rule, rules, e, vals_in_scope, bindings, env, &mut out)?;
    out.push('`');
    return Result::Ok(out);
}

fn append_parts(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
    out: &mut String,
) -> Result<(), String> {
    return match e {
        Str(c) => {
            out.push_str(&escape_template(c));
            Result::Ok(());
        },
        Binary(b) => {
            if b.op == "+" && is_string_concat(e) {
                append_parts(rule, rules, &b.lhs, vals_in_scope, bindings, env, out)?;
                append_parts(rule, rules, &b.rhs, vals_in_scope, bindings, env, out)?;
                Result::Ok(());
            } else {
                append_interp(rule, rules, e, vals_in_scope, bindings, env, out);
            }
        },
        Paren(p) => {
            if is_string_concat(&p.inner) {
                append_parts(rule, rules, &p.inner, vals_in_scope, bindings, env, out);
            } else {
                append_interp(rule, rules, e, vals_in_scope, bindings, env, out);
            }
        },
        _ => append_interp(rule, rules, e, vals_in_scope, bindings, env, out),
    };
}

fn append_interp(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    env: &JEnv,
    out: &mut String,
) -> Result<(), String> {
    let expr = emit_expr(rule, rules, e, vals_in_scope, bindings, env)?;
    out.push('{');
    out.push_str(&expr);
    out.push('}');
    return Result::Ok(());
}

/// Escape a string-literal part for Wado template text: the braces and backtick
/// that carry template meaning. Java `\`-escapes pass through unchanged.
fn escape_template(content: &String) -> String {
    let mut out = String::with_capacity(content.chars().count());
    for let c of content.chars() {
        if c == '{' || c == '}' || c == '`' {
            out.push('\\');
        }
        out.push(c);
    }
    return out;
}
