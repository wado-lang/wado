//! Emit Wado from a parsed java2wado `JExpr` / `JStmt`. Operators pass through,
//! `$`-refs route through `resolve_attr_ref`, a string `+` chain becomes a
//! template literal, and method mapping is snake_case over the grammar's own
//! `@members` methods (see `action.md`). A method call or constant that
//! resolves to nothing real is a loud error, not a silently broken emit.

use { ParserRule, Alternative, AttrDecl, Element, GrammarOption, Visibility } from "../ir.wado";
use {
    lexer_matched_text_expr,
    lexer_cursor_column_expr,
    lexer_token_start_column_expr,
    resolve_lexer_attr_ref,
    LexerAttrEnv,
    AttrUse,
    resolve_attr_ref,
    rule_binding_for,
    token_null_test,
    text_presence,
    binding_name,
    ref_is_call_ctx,
    ref_is_ctx_to_string_tree,
    RULE_START_TOK_LOCAL,
    LR_ACC_LOCAL,
} from "../action_translate.wado";
use { rule_is_left_recursive } from "../lr_util.wado";
use { to_snake_case, escape_ident } from "../ident.wado";
use { AltBinding } from "../attr_resolve.wado";
use { wado } from "lib:wadopoet";
use { JExpr, JMember, JCall, JStmt, JLocal, JAssign, JBinary } from "./jparser.wado";
use { tokenize_java } from "./jlexer.wado";
use { parse_java_expr, parse_java_stmts } from "./jparser.wado";

/// Emit environment: the recognizer handle (`p` in a parse / predicate body,
/// `lx` in a lexer action, `self` in a `@members` method body), the grammar name
/// (for the `<Name>Parser` / `<Name>Lexer` token-constant qualifier), and the
/// `@members` names a body may resolve against.
pub struct JEnv {
    pub this_bind: String,
    pub grammar: String,
    pub members: MemberNames,
    /// The rendered expected-token set at this site — a generation-time
    /// constant in Gale. Empty where codegen cannot answer, which reports.
    pub expected: String = "",
    /// True inside a lexer action / predicate body, where the recognizer API is
    /// the lexer's: `getText()` is the matched slice rather than a rule's token
    /// span, and a `$`-attribute resolves against the match fn's cursor.
    /// Defaulted so the parser-side construction sites are unchanged.
    pub lexer: bool = false,
    /// Whether this body can write to the recognizer's output sink. False in a
    /// lexer predicate: it is evaluated for every candidate rule during the
    /// tournament, including the losers, so printing from one would be wrong
    /// even if the sink were reachable from the match fn. Defaulted true so the
    /// parser-side construction sites are unchanged.
    pub sink: bool = true,
    /// Names declared as locals by the body itself (`int n = 1;`), so a later
    /// statement can read them. Collected up front because the emitter walks
    /// statements without carrying a scope.
    pub locals: List<String> = [],
    /// Those of `locals` whose Java type is `String`.
    pub string_locals: List<String> = [],
    /// Those of `string_locals` that may hold Java's `null`: each carries its
    /// presence in a `bool` beside it (`present_local`), since the text a Wado
    /// `String` holds cannot say so.
    pub nullable_locals: List<String> = [],
    /// The enclosing rule's argument names, in their surface spelling. Java
    /// reaches an argument bare; Gale stores it in the value channel, so the
    /// bare name resolves to `$name` rather than to the generated parameter.
    pub args: List<String> = [],
    /// Whether the recognizer handle here is a shared reference. True only in a
    /// lexer predicate; every other body may write.
    pub read_only: bool = false,
    /// Whether the grammar declares a lexer mode, which is what gives `$mode` a
    /// latch to write.
    pub uses_modes: bool = false,
    /// True inside a `@members` method body. A member is a method on the
    /// recognizer struct, so it reaches the fields and the sibling methods but
    /// stands outside any one match: the cursor locals and the rule's start
    /// token belong to the generated functions, not to the struct.
    pub in_members: bool = false,
}

/// What an action / predicate body may resolve a bare name against: the
/// `@members` methods and fields the grammar declares. All snake_cased, as the
/// declarations are. Filled through `add_field` / `add_method`, so a name never
/// lands without its type.
pub struct MemberNames {
    pub methods: List<String> = [],
    /// A field is reachable bare in Java, so a body that reads one has to emit
    /// the same access `this.<x>` does — unqualified, it names nothing.
    pub fields: List<String> = [],
    /// The methods taking `&mut self`. A lexer predicate holds `&Lexer` — the
    /// tournament must not mutate through a losing candidate — so a call to one
    /// from there is refused, not emitted.
    pub mutating: List<String> = [],
    /// The fields of type `String` and the methods returning one, whose `+`
    /// concatenates in Java.
    pub string_fields: List<String> = [],
    pub string_methods: List<String> = [],
}

impl MemberNames {
    pub fn add_field<S: AsStrSlice>(&mut self, name: S, is_string: bool) {
        self.fields.push(name.to_string());
        if is_string {
            self.string_fields.push(name.to_string());
        }
    }

    pub fn add_method<S: AsStrSlice>(&mut self, name: S, mutates: bool, returns_string: bool) {
        self.methods.push(name.to_string());
        if mutates {
            self.mutating.push(name.to_string());
        }
        if returns_string {
            self.string_methods.push(name.to_string());
        }
    }
}

impl JEnv {
    /// Bring `name` into scope as a local, of Java type `String` or not.
    pub fn add_local<S: AsStrSlice>(&mut self, name: S, is_string: bool) {
        self.locals.push(name.to_string());
        if is_string {
            self.string_locals.push(name.to_string());
        }
    }
}

/// The ANTLR recognizer API this translator answers for. A variant added here
/// does not compile until `api_host` and `api_needs_frame` answer for it.
enum ApiCall {
    /// `getText()`: the lexer's matched slice, the parser's rule span.
    Text,
    /// `getCharPositionInLine()`.
    CharPos,
    /// `_tokenStartCharPositionInLine`.
    TokenStartCharPos,
    /// `getRuleInvocationStack()`.
    RuleStack,
    /// `_input.getText()`.
    InputText,
    /// `<token>.getText()`.
    TokenText,
    /// `_input.LA(k)`.
    La,
    /// `_input.LT(k)`.
    Lt,
}

/// Which recognizer carries the call. The generated `Lexer` has characters and
/// a cursor; the `Parser` has tokens and rules; neither carries the other's.
enum ApiHost {
    Parser,
    Lexer,
    Either,
}

fn api_host(call: ApiCall) -> ApiHost {
    return match call {
        Text => ApiHost::Either,
        CharPos | TokenStartCharPos => ApiHost::Lexer,
        RuleStack | InputText | TokenText | La | Lt => ApiHost::Parser,
    };
}

/// Whether the call reads the enclosing match — the lexer's `src` / `start` /
/// `pos`, or the parser's rule-start token. A `@members` method has neither.
fn api_needs_frame(call: ApiCall) -> bool {
    return match call {
        Text | CharPos | TokenStartCharPos => true,
        RuleStack | InputText | TokenText | La | Lt => false,
    };
}

fn api_name(call: ApiCall) -> String {
    return match call {
        Text => "getText()",
        CharPos => "getCharPositionInLine()",
        TokenStartCharPos => "_tokenStartCharPositionInLine",
        RuleStack => "getRuleInvocationStack()",
        InputText => "_input.getText()",
        TokenText => "<token>.getText()",
        La => "_input.LA()",
        Lt => "_input.LT()",
    };
}

/// The expression a recognizer-API call emits, or a loud error where the body
/// cannot reach it. Every spelling of every special goes through here.
fn api_expr<S: AsStrSlice>(env: &JEnv, call: ApiCall, expr: S) -> Result<String, String> {
    let wrong_host = match api_host(call) {
        Parser => env.lexer,
        Lexer => !env.lexer,
        Either => false,
    };
    if wrong_host {
        builtin::cold_path();
        let carried = if env.lexer { "the parser's token stream" } else { "the lexer's match cursor" };
        return Result::Err(`java2wado: '${api_name(call)}' reads ${carried}, which this body has no access to`);
    }
    if api_needs_frame(call) && env.in_members {
        builtin::cold_path();
        return Result::Err(
            `java2wado: @members: '${api_name(call)}' reads the match window, which a member method stands outside of`,
        );
    }
    return Result::Ok(expr.to_string());
}

/// Translate a lexer `{ ... }` action body. The lexer has no enclosing parser
/// rule, so the parser-only context (rule, sibling rules, value channel, label
/// bindings) is empty — any body that reaches for it fails loudly through the
/// same paths a parser body would.
pub fn translate_java_lexer_stmts<S: AsStrSlice>(body: S, env: &JEnv) -> Result<String, String> {
    let rule = lexer_body_rule();
    let rules: List<ParserRule> = [];
    let bindings: List<AltBinding> = [];
    let tokens = tokenize_java(body)?;
    let stmts = parse_java_stmts(&tokens)?;
    return emit_java_stmts(&rule, &rules, &stmts, false, &bindings, &with_locals(env, &stmts));
}

/// Translate a lexer `{ ... }?` predicate body to a Wado boolean expression.
pub fn translate_java_lexer_expr<S: AsStrSlice>(body: S, env: &JEnv) -> Result<String, String> {
    let mut env = *env;
    env.sink = false;
    env.read_only = true;
    let rule = lexer_body_rule();
    let rules: List<ParserRule> = [];
    let bindings: List<AltBinding> = [];
    let tokens = tokenize_java(body)?;
    let expr = parse_java_expr(&tokens)?;
    return emit_expr(&rule, &rules, &expr, false, &bindings, &env);
}

fn lexer_body_rule() -> ParserRule {
    let opts: List<GrammarOption> = [];
    let alts: List<Alternative> = [];
    return ParserRule::new("", Visibility::Public, opts, alts);
}

pub fn translate_java_expr<S: AsStrSlice>(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: S,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    let tokens = tokenize_java(body)?;
    let expr = parse_java_expr(&tokens)?;
    return emit_expr(rule, rules, &expr, vals_in_scope, bindings, env);
}

pub fn translate_java_stmts<S: AsStrSlice>(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: S,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    let tokens = tokenize_java(body)?;
    let stmts = parse_java_stmts(&tokens)?;
    return emit_java_stmts(rule, rules, &stmts, vals_in_scope, bindings, &with_locals(env, &stmts));
}

/// `env` plus the locals a statement list declares. `emit_local` emits them as
/// real Wado locals, so a later statement naming one is resolvable — and names
/// the enclosing recognizer's own field, which the local shadows. Appended, not
/// assigned: the caller may already have seeded a scope the body's own
/// declarations join (a rule's arguments, a member method's parameters).
pub fn with_locals(env: &JEnv, stmts: &List<JStmt>) -> JEnv {
    let mut scoped = *env;
    for let st of stmts {
        if let Local(l) = st {
            scoped.add_local(&l.name, l.ty == "String");
        }
    }
    return scoped;
}

/// Space-joined statements (each already carries its `;`).
pub fn emit_java_stmts(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    stmts: &List<JStmt>,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    let env = &with_nullable_locals(rule, rules, stmts, bindings, env);
    let mut out = String::from("");
    for let mut i = 0; i < stmts.len(); i += 1 {
        if i > 0 {
            out.push_str(" ");
        }
        out.push_str(&emit_stmt(rule, rules, &stmts[i], vals_in_scope, bindings, env)?);
    }
    return Result::Ok(out);
}

/// `env` with `nullable_locals` filled: each `String` local some statement
/// stores a value in that may be `null`, to a fixed point, since one such
/// local makes another it is copied into one too.
fn with_nullable_locals(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    stmts: &List<JStmt>,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> JEnv {
    let mut scoped = *env;
    let mut grew = true;
    while grew {
        grew = false;
        for let st of stmts {
            let Some([name, value]) = local_store(st) else {
                continue;
            };
            if scoped.string_locals.contains(&name)
                && !scoped.nullable_locals.contains(&name)
                && value_presence(rule, rules, &value, bindings, &scoped) matches { Some(_) } {
                scoped.nullable_locals.push(name);
                grew = true;
            }
        }
    }
    return scoped;
}

/// The local `st` stores a whole value in, beside that value: a declaration's
/// initializer or a plain `=`.
fn local_store(st: &JStmt) -> Option<[String, JExpr]> {
    return match st {
        Local(l) => l.init.map(|init| [l.name, init]),
        Assign(a) && a.op == "=" => match &a.target {
            Name(n) => Option::Some([*n, a.value]),
            _ => null,
        },
        _ => null,
    };
}

/// Refuse to hand a method a `String` that may be Java's `null`: its parameter
/// is a Wado `String`, which cannot carry that.
fn refuse_nullable_args(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    args: &List<JExpr>,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<(), String> {
    for let a of args {
        if value_presence(rule, rules, a, bindings, env) matches { Some(_) } {
            return Result::Err("java2wado: a method argument that may be null is unsupported: a String parameter cannot hold null");
        }
    }
    return Result::Ok(());
}

/// The `bool` local carrying whether the nullable `String` local `name` holds
/// a value.
fn present_local<S: AsStrSlice>(name: S) -> String {
    return escape_ident(`${name}__present`);
}

/// Where the `String` value `e` may be Java's `null`, the condition under which
/// it is not; `null` where it always holds a value. A label's text that may not
/// have matched, the `null` literal, and a nullable local are the ones that may.
fn value_presence(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Option<String> {
    let presence = match without_parens(e) {
        Name(n) && *n == "null" => Option::Some("false"),
        Name(n) && env.nullable_locals.contains(n) => Option::Some(present_local(n)),
        _ => text_presence_of(rule, rules, e, bindings),
    };
    return match presence {
        Some(p) && p == "true" => null,
        _ => presence,
    };
}

/// A `String` value as Wado holds it: Java's `null` reads as its text.
fn string_value(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    if name_is(without_parens(e), "null") {
        return Result::Ok("\"null\"");
    }
    return emit_expr(rule, rules, e, vals_in_scope, bindings, env);
}

fn emit_stmt(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    s: &JStmt,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    return match s {
        Expr(e) => {
            let w = emit_expr(rule, rules, e, vals_in_scope, bindings, env)?;
            Result::Ok(`${w};`);
        },
        Local(l) => emit_local(rule, rules, l, vals_in_scope, bindings, env),
        Assign(a) => {
            let target = emit_assign_target(rule, rules, a, vals_in_scope, bindings, env)?;
            let stored = local_store(s);
            let value = match &stored {
                Some([name, v]) && env.string_locals.contains(name) => string_value(rule, rules, v, vals_in_scope, bindings, env)?,
                _ => {
                    if value_presence(rule, rules, &a.value, bindings, env) matches { Some(_) } {
                        return Result::Err("java2wado: storing a String that may be null outside a local is unsupported");
                    }
                    emit_expr(rule, rules, &a.value, vals_in_scope, bindings, env)?;
                },
            };
            let store = `${target} ${a.op} ${value};`;
            match stored {
                Some([name, v]) && env.nullable_locals.contains(&name) => {
                    let present = value_presence(rule, rules, &v, bindings, env).unwrap_or("true");
                    Result::Ok(`${store} ${present_local(&name)} = ${present};`);
                },
                _ => Result::Ok(store),
            }
        },
        Return(v) => match v {
            Some(e) => {
                let w = emit_expr(rule, rules, e, vals_in_scope, bindings, env)?;
                Result::Ok(`return ${w};`);
            },
            None => Result::Ok("return;"),
        },
        // Java's assertions need `-ea`; Wado's always run. A live assert is the
        // stronger reading, and the one Gale takes everywhere else.
        Assert(a) => {
            let cond = emit_expr(rule, rules, &a.cond, vals_in_scope, bindings, env)?;
            match &a.message {
                Some(m) => Result::Ok(wado`assert ${cond}, "${*m}";`),
                None => Result::Ok(`assert ${cond};`),
            }
        },
    };
}

fn lexer_attr_env(env: &JEnv) -> LexerAttrEnv {
    return LexerAttrEnv { in_action: !env.read_only, uses_modes: env.uses_modes };
}

/// An assignment's left-hand side. A `$`-attribute there is a write, and
/// `$mode`'s write is a different field from its read, so the site's own syntax
/// decides which — `emit_expr` alone would have to guess.
fn emit_assign_target(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    a: &JAssign,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    if let Attr(text) = &a.target && env.lexer && !env.in_members {
        let use_ = if a.op == "=" { AttrUse::Write } else { AttrUse::ReadWrite };
        return resolve_lexer_attr_ref(text, &lexer_attr_env(env), use_);
    }
    return emit_expr(rule, rules, &a.target, vals_in_scope, bindings, env);
}

fn emit_local(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    l: &JLocal,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    let ty = match map_java_type(&l.ty) {
        Some(t) => t,
        None => {
            return Result::Err(`java2wado: unsupported local type '${l.ty}'`);
        },
    };
    let Some(e) = &l.init else {
        return Result::Err(`java2wado: local '${l.name}' needs an initializer`);
    };
    let init = if env.string_locals.contains(&l.name) {
        string_value(rule, rules, e, vals_in_scope, bindings, env)?;
    } else {
        emit_expr(rule, rules, e, vals_in_scope, bindings, env)?;
    };
    let decl = `let mut ${escape_ident(&l.name)}: ${ty} = ${init};`;
    if !env.nullable_locals.contains(&l.name) {
        return Result::Ok(decl);
    }
    let present = value_presence(rule, rules, e, bindings, env).unwrap_or("true");
    return Result::Ok(`${decl} let mut ${present_local(&l.name)}: bool = ${present};`);
}

/// Emit `System.out.print`/`println` as `<this>.emit(<template>)`, rendering the
/// argument as a template literal and appending `\n` for `println`.
fn emit_print(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    args: &List<JExpr>,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
    newline: bool,
) -> Result<String, String> {
    let mut tmpl = String::from("`");
    if !args.is_empty() {
        append_part(rule, rules, &args[0], vals_in_scope, bindings, env, &mut tmpl)?;
    }
    if newline {
        tmpl.push_str("\\n");
    }
    tmpl.push('`');
    if !env.sink {
        builtin::cold_path();
        return Result::Err("java2wado: a lexer predicate cannot print — it runs for losing candidates too");
    }
    return Result::Ok(`${env.this_bind}.emit(${tmpl})`);
}

/// Java primitive / `String` type text to its Wado type, or `None` if outside
/// the subset (a loud error — the subset grows on demand).
pub fn map_java_type<S: AsStrSlice>(ty: S) -> Option<String> {
    return match ty.trim() {
        "int" => Option::Some("i32"),
        "short" => Option::Some("i16"),
        "byte" => Option::Some("i8"),
        "long" => Option::Some("i64"),
        "boolean" => Option::Some("bool"),
        "String" => Option::Some("String"),
        _ => null,
    };
}

pub fn emit_expr(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    return match e {
        Int(v) => Result::Ok(*v),
        Bool(b) => Result::Ok(if *b { String::from("true") } else { String::from("false") }),
        Str(c) => Result::Ok(`"${*c}"`),
        Attr(text) => {
            if env.in_members {
                builtin::cold_path();
                Result::Err(
                    `java2wado: @members: '${*text}' is an attribute of a match, which a member method stands outside of`,
                );
            } else if env.lexer {
                resolve_lexer_attr_ref(text, &lexer_attr_env(env));
            } else {
                resolve_attr_ref(rule, rules, text, vals_in_scope, bindings, &env.this_bind);
            }
        },
        Name(n) => {
            if *n == "this" {
                Result::Ok(env.this_bind);
            } else {
                name_expr(rule, rules, n, vals_in_scope, bindings, env);
            }
        },
        Member(m) => emit_member(rule, rules, m, vals_in_scope, bindings, env),
        Call(c) => emit_call(rule, rules, c, vals_in_scope, bindings, env),
        Cast(c) => {
            // An integer target is left to Wado's inference. A floating one
            // asks for Java's numeric promotion, which the subset does not model.
            if c.ty == "double" || c.ty == "float" {
                builtin::cold_path();
                Result::Err(`java2wado: a '(${c.ty})' cast needs Java's numeric promotion, which is unsupported`);
            } else {
                emit_expr(rule, rules, &c.operand, vals_in_scope, bindings, env);
            }
        },
        Unary(u) => {
            let operand = emit_expr(rule, rules, &u.operand, vals_in_scope, bindings, env)?;
            Result::Ok(`${u.op}${operand}`);
        },
        Paren(p) => {
            let inner = emit_expr(rule, rules, &p.inner, vals_in_scope, bindings, env)?;
            Result::Ok(`(${inner})`);
        },
        Binary(b) => {
            if b.op == "+" {
                emit_plus(rule, rules, e, vals_in_scope, bindings, env);
            } else if let Some(test) = token_presence_test(rule, rules, b, bindings, env) {
                Result::Ok(test);
            } else {
                let l = emit_expr(rule, rules, &b.lhs, vals_in_scope, bindings, env)?;
                let r = emit_expr(rule, rules, &b.rhs, vals_in_scope, bindings, env)?;
                let presence = [
                    text_presence_of(rule, rules, &b.lhs, bindings),
                    text_presence_of(rule, rules, &b.rhs, bindings),
                ];
                let folded = match text_identity(&presence) {
                    Some(same) && b.op == "==" => same,
                    Some(same) && b.op == "!=" => `!${same}`,
                    _ => {
                        return Result::Ok(`${l} ${b.op} ${r}`);
                    },
                };
                // The fold still evaluates each operand, in Java's order.
                let mut evaluated = String::new();
                if has_call(&b.lhs) {
                    evaluated.push_str(`let _ = ${l}; `);
                }
                if has_call(&b.rhs) {
                    evaluated.push_str(`let _ = ${r}; `);
                }
                Result::Ok(if evaluated.is_empty() { folded } else { `(eq: { ${evaluated}${folded} })` });
            }
        },
    };
}

fn emit_member(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    m: &JMember,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    if name_is(&m.recv, "this") {
        return this_field_expr(env, &m.name);
    }
    if let Name(qualifier) = &m.recv && is_upper_ident(&m.name) {
        if is_grammar_class(env, qualifier) {
            return Result::Ok(`TK_${m.name}`);
        }
        return Result::Err(`java2wado: unknown constant '${*qualifier}.${m.name}'`);
    }
    let r = emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
    return Result::Ok(`${r}.${m.name}`);
}

fn emit_call(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    c: &JCall,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    if let Member(m) = &c.callee {
        if is_ctx_expr(&m.recv) {
            return emit_ctx_child(rule, m, &c.args, bindings);
        }
        // `getExpectedTokens().toString(getVocabulary())`: the site fixes the
        // set and the grammar the vocabulary, so the idiom is one constant. The
        // other `IntervalSet.toString` overloads render token numbers instead,
        // which is not the string codegen has.
        if m.name == "toString" && call_names(&m.recv, "getExpectedTokens") {
            if !(c.args.len() == 1 && call_names(&c.args[0], "getVocabulary")) {
                return Result::Err(
                    "java2wado: only getExpectedTokens().toString(getVocabulary()) is supported; the other overloads render token numbers",
                );
            }
            if env.expected.is_empty() {
                return Result::Err(
                    "java2wado: getExpectedTokens() is only available in a rule's @init / @after, where codegen knows the set",
                );
            }
            return Result::Ok(wado`"${env.expected}"`);
        }
    }
    // `$ctx.toStringTree(this)`: the `$`-attr lexer captures the whole
    // `$ctx.toStringTree` as the call target, so the trailing `(this)` lands
    // here. Its Wado form is nullary; drop the redundant parser argument.
    if let Attr(t) = &c.callee {
        if ref_is_ctx_to_string_tree(t) {
            return resolve_attr_ref(rule, rules, t, vals_in_scope, bindings, &env.this_bind);
        }
    }
    let args_w = emit_args(rule, rules, &c.args, vals_in_scope, bindings, env)?;
    return match &c.callee {
        Member(m) => emit_member_call(rule, rules, m, &c.args, &args_w, vals_in_scope, bindings, env),
        Name(n) => {
            refuse_nullable_args(rule, rules, &c.args, bindings, env)?;
            emit_recognizer_call(env, n, &args_w);
        },
        _ => Result::Err("java2wado: unsupported call target"),
    };
}

/// A call on the recognizer itself, written bare (`m()`) or through `this.` —
/// one resolution for both spellings, so a rule about a call (which API it
/// belongs to, whether the body may reach it) holds however it is written.
fn emit_recognizer_call<S: AsStrSlice, S1: AsStrSlice>(env: &JEnv, name: S, args_w: S1) -> Result<String, String> {
    if name == "getText" {
        return api_expr(env, ApiCall::Text, if env.lexer {
            lexer_matched_text_expr();
        } else {
            `${env.this_bind}.rule_text(${RULE_START_TOK_LOCAL})`;
        });
    }
    if name == "getCharPositionInLine" {
        return api_expr(env, ApiCall::CharPos, lexer_cursor_column_expr());
    }
    if name == "getRuleInvocationStack" {
        return api_expr(env, ApiCall::RuleStack, `${env.this_bind}.rule_stack()`);
    }
    check_member_call_reachable(env, name)?;
    return Result::Ok(`${env.this_bind}.${to_snake_case(name)}(${args_w})`);
}

/// `<token> == null` / `!= null`, either way round and through parens, where
/// the token is a label or reference (`$x`) or a context's accessor for one
/// (`$ctx.ID()`). The accessor reads what `$ID` does, unless the name repeats
/// in that context: ANTLR4 then returns a list, which is never null.
fn token_presence_test(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    b: &JBinary,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Option<String> {
    if b.op != "!=" && b.op != "==" {
        return null;
    }
    let negated = b.op == "!=";
    let operand = if name_is(without_parens(&b.rhs), "null") {
        &b.lhs;
    } else if name_is(without_parens(&b.lhs), "null") {
        &b.rhs;
    } else {
        return null;
    };
    let reference = match without_parens(operand) {
        Attr(text) => {
            if let Some(p) = text_presence(rule, rules, text, bindings) {
                return Option::Some(if negated { p } else { `!(${p})` });
            }
            *text;
        },
        Call(c) && c.args.is_empty() => {
            let Some(name) = ctx_token_accessor(&c.callee) else {
                return null;
            };
            let count = ctx_token_count(rule, &c.callee, &name);
            if count == 0 {
                return null;
            }
            if count > 1 {
                return Option::Some(if negated { "true" } else { "false" });
            }
            if !bindings.iter_ref().any(|bound| bound.binds(true, &binding_name(&name))) {
                return Option::Some(if negated { "false" } else { "true" });
            }
            `$${name}`;
        },
        Name(n) && env.string_locals.contains(n) => {
            let present = value_presence(rule, rules, operand, bindings, env).unwrap_or("true");
            return Option::Some(if negated { present } else { `!(${present})` });
        },
        _ => {
            return null;
        },
    };
    return token_null_test(rule, rules, &reference, bindings, negated);
}

/// The token `callee` names when it is a `$ctx` accessor: `$ctx.ID`, which
/// the `$`-scanner reads as one reference, or one on a cast.
fn ctx_token_accessor(callee: &JExpr) -> Option<String> {
    return match callee {
        Attr(t) => t.strip_prefix("$ctx.").map(|name| name.to_string()),
        Member(m) && is_ctx_expr(&m.recv) => Option::Some(m.name),
        _ => null,
    };
}

/// The condition under which the label text `e` reads is there
/// (`text_presence`), or `null` where `e` reads none.
fn text_presence_of(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    bindings: &List<AltBinding>,
) -> Option<String> {
    return match without_parens(e) {
        Attr(text) => text_presence(rule, rules, text, bindings),
        _ => null,
    };
}

/// Java's `==` where a side reads a label's text (`presence`, either side):
/// a read returns a fresh `String`, so the two are the same reference only
/// where both are `null`. `null` where neither side reads one.
fn text_identity(presence: &[Option<String>, Option<String>]) -> Option<String> {
    return match presence {
        [Some(l), Some(r)] => Option::Some(`(!(${*l}) && !(${*r}))`),
        [Some(_), None] | [None, Some(_)] => Option::Some("false"),
        [None, None] => null,
    };
}

/// Java's `l.equals(r)`, where `r` may be a label text that is not there
/// (`r_present`): a missing one equals nothing.
fn text_equals<S: AsStrSlice, S1: AsStrSlice>(r_present: &Option<String>, l: S, r: S1) -> String {
    return match r_present {
        Some(p) && *p != "true" => `(${*p} && ${l} == ${r})`,
        _ => `(${l} == ${r})`,
    };
}

/// Whether evaluating `e` calls a method, the one way a Java expression of the
/// subset has an effect.
fn has_call(e: &JExpr) -> bool {
    return match e {
        Call(_) => true,
        Member(m) => has_call(&m.recv),
        Cast(c) => has_call(&c.operand),
        Unary(u) => has_call(&u.operand),
        Binary(b) => has_call(&b.lhs) || has_call(&b.rhs),
        Paren(p) => has_call(&p.inner),
        Int(_) | Str(_) | Bool(_) | Attr(_) | Name(_) => false,
    };
}

fn without_parens(e: &JExpr) -> &JExpr {
    return match e {
        Paren(p) => without_parens(&p.inner),
        _ => e,
    };
}

/// How often token `name` can occur in one match of the context `ctx` is cast
/// to: a labeled alternative's own (`#add` → `AddContext`) or, uncast, the
/// rule's, whose alternatives exclude each other.
fn ctx_token_count(rule: &ParserRule, accessor: &JExpr, name: &String) -> i32 {
    let class = match accessor {
        Member(m) => ctx_cast_class(&m.recv),
        _ => null,
    };
    let mut count = 0;
    for let alt of &rule.alternatives {
        let in_context = match [&class, &alt.label] {
            [Some(c), Some(label)] => *c == `${capitalized(label)}Context`,
            _ => true,
        };
        if in_context {
            count = i32::max(count, token_occurrences(&alt.elements, name));
        }
    }
    return count;
}

/// ANTLR4 names a labeled alternative's context class by the label with its
/// first letter raised, and leaves the rest as written.
fn capitalized(label: &String) -> String {
    let mut chars = label.chars();
    let first = chars.next().expect("an alternative label is a name");
    let mut out = String::new();
    out.push(first.to_ascii_uppercase());
    out.push_str(&label.substr_bytes(first.len_utf8(), label.len()));
    return out;
}

/// The class `e` casts `$ctx` to (`((AddContext)$ctx)`), or `null` uncast.
fn ctx_cast_class(e: &JExpr) -> Option<String> {
    return match e {
        Paren(p) => ctx_cast_class(&p.inner),
        Cast(c) => Option::Some(c.ty),
        _ => null,
    };
}

fn token_occurrences(elements: &List<Element>, name: &String) -> i32 {
    let mut count = 0;
    for let e of elements {
        count += token_occurrences_in(e, name);
    }
    return count;
}

/// How often token `name` can occur in one match of `e`, where a loop's body
/// counts as twice: more than once is all the accessor's shape asks.
fn token_occurrences_in(e: &Element, name: &String) -> i32 {
    return match e {
        TokenRef(t) => if t.name == *name { 1 } else { 0 },
        Label(l) => token_occurrences_in(&l.element, name),
        Repeat(r) => {
            let once = token_occurrences_in(&r.element, name);
            if r.kind matches { Optional } { once } else { 2 * once };
        },
        Group(g) => g.alternatives.iter_ref().fold(0, |n, a| i32::max(n, token_occurrences(&a.elements, name))),
        RuleRef(_) | Literal(_) | Wildcard(_) | Not(_) => 0,
    };
}

/// Whether `e` reduces (through parens and casts) to the `$ctx` special — the
/// receiver of a ctx-child accessor `((BinaryContext)$ctx).e(0)`.
fn is_ctx_expr(e: &JExpr) -> bool {
    return match e {
        Attr(t) => *t == "$ctx",
        Paren(p) => is_ctx_expr(&p.inner),
        Cast(c) => is_ctx_expr(&c.operand),
        _ => false,
    };
}

/// Map `((Ctx)$ctx).<rule>(i)` onto the LR operand vals: child 0 is the
/// precedence accumulator `_lr_acc`, child i>=1 is the i-th suffix self-ref.
/// Only valid inside a left-recursive rule for its own children; else a loud error.
fn emit_ctx_child(
    rule: &ParserRule,
    m: &JMember,
    args: &List<JExpr>,
    bindings: &List<AltBinding>,
) -> Result<String, String> {
    if !rule_is_left_recursive(rule) {
        return Result::Err("java2wado: `$ctx` child access is only supported in a left-recursive rule");
    }
    if m.name != rule.name {
        return Result::Err(`java2wado: $ctx.${m.name}(...): only the rule's own children are supported`);
    }
    if args.is_empty() {
        return Result::Err(`java2wado: $ctx.${m.name}(): token/child accessor form not yet supported`);
    }
    let idx = match &args[0] {
        Int(s) => *s,
        _ => {
            return Result::Err(`java2wado: $ctx.${m.name}(...): child index must be an integer literal`);
        },
    };
    if idx == "0" {
        return Result::Ok(LR_ACC_LOCAL);
    }
    return Result::Ok(rule_binding_for(bindings, &m.name));
}

fn emit_member_call<S: AsStrSlice>(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    m: &JMember,
    raw_args: &List<JExpr>,
    args_w: S,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    let meth = m.name;
    // `$x.ctx.toStringTree(this)`: `$x.ctx` already resolves to the rendered
    // node, so the call the `$`-attr scanner left behind is dropped.
    if meth == "toStringTree" {
        if let Attr(t) = &m.recv && ref_is_call_ctx(t) {
            return resolve_attr_ref(rule, rules, t, vals_in_scope, bindings, &env.this_bind);
        }
    }
    if (meth == "println" || meth == "print") && is_system_out(&m.recv) {
        let newline = meth == "println";
        return emit_print(rule, rules, raw_args, vals_in_scope, bindings, env, newline);
    }
    // `this.m()` is the bare `m()` under another spelling, recognizer API
    // included: `this.getText()` in a lexer is the matched slice, not a token's.
    if name_is(&m.recv, "this") {
        refuse_nullable_args(rule, rules, raw_args, bindings, env)?;
        return emit_recognizer_call(env, &meth, args_w);
    }
    if meth == "getText" {
        if name_is(&m.recv, "_input") {
            return api_expr(env, ApiCall::InputText, `${env.this_bind}.input_text()`);
        }
        let r = emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
        return api_expr(env, ApiCall::TokenText, `${env.this_bind}.token_text(${r})`);
    }
    if meth == "LA" && name_is(&m.recv, "_input") {
        return api_expr(env, ApiCall::La, `${env.this_bind}.la(${args_w})`);
    }
    if meth == "LT" && name_is(&m.recv, "_input") {
        return api_expr(env, ApiCall::Lt, `${env.this_bind}.lt(${args_w})`);
    }
    if meth == "equals" {
        if raw_args.is_empty() {
            return Result::Err("java2wado: .equals() with no argument");
        }
        let r = emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
        let a = string_value(rule, rules, &raw_args[0], vals_in_scope, bindings, env)?;
        // A missing receiver throws in the jar; a missing argument equals nothing.
        let eq = text_equals(&value_presence(rule, rules, &raw_args[0], bindings, env), &r, &a);
        return Result::Ok(match value_presence(rule, rules, &m.recv, bindings, env) {
            Some(p) => `(if ${p} { ${eq} } else { panic("NullPointerException") })`,
            None => eq,
        });
    }
    check_member_call_reachable(env, &meth)?;
    refuse_nullable_args(rule, rules, raw_args, bindings, env)?;
    let recv_w = emit_expr(rule, rules, &m.recv, vals_in_scope, bindings, env)?;
    return Result::Ok(`${recv_w}.${to_snake_case(&meth)}(${args_w})`);
}

/// What a name at a *name* position denotes — Java's variable namespace, which
/// holds no methods. A call position asks `method_declared` instead.
enum NameTarget {
    /// A local the body declares, or a method parameter. Shadows the rest, as
    /// Java's own scoping does.
    Local,
    /// A rule argument. It is `$name` under another spelling — the generated
    /// parameter is stored into the value channel at entry — so it resolves
    /// there and a write through either spelling is visible to both.
    RuleArg,
    Field,
    /// Nothing the recognizer declares as a variable.
    Unknown,
}

fn resolve_name<S: AsStrSlice>(env: &JEnv, name: S) -> NameTarget {
    if env.locals.contains_str(name) {
        return NameTarget::Local;
    }
    if env.args.contains_str(name) {
        return NameTarget::RuleArg;
    }
    if env.members.fields.contains(&to_snake_case(name)) {
        return NameTarget::Field;
    }
    return NameTarget::Unknown;
}

/// Whether a `@members` method declares `name`. Java's namespaces are separate
/// — `int depth = 0; int depth() {}` is legal — so a variable never hides one.
fn method_declared<S: AsStrSlice>(env: &JEnv, name: S) -> bool {
    return env.members.methods.contains(&to_snake_case(name));
}

/// The access a name emits, or a loud error. What a lexer body has left over is
/// an ANTLR field Gale does not model (`_input`, ...), which emitted verbatim
/// would reference nothing; a parser body keeps it as the rule's own scope.
fn name_expr<S: AsStrSlice>(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    name: S,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    if name == "_tokenStartCharPositionInLine" {
        return api_expr(env, ApiCall::TokenStartCharPos, lexer_token_start_column_expr());
    }
    return match resolve_name(env, name) {
        Local => Result::Ok(escape_ident(name)),
        RuleArg => resolve_attr_ref(rule, rules, `$${name}`, vals_in_scope, bindings, &env.this_bind),
        Field => Result::Ok(`${env.this_bind}.${to_snake_case(name)}`),
        Unknown => if env.lexer {
            builtin::cold_path();
            Result::Err(`java2wado: unsupported lexer name '${name}': not a @members field`);
        } else if is_upper_ident(name) {
            // The parser class's own token-type constant, reached unqualified.
            Result::Ok(`TK_${name}`);
        } else {
            Result::Ok(name.to_string());
        },
    };
}

/// The access `this.<name>` emits. `this.` reaches a field and nothing else in
/// Java — never a local, never an argument — so the resolution that admits those
/// is not the one this site may take.
fn this_field_expr<S: AsStrSlice>(env: &JEnv, name: S) -> Result<String, String> {
    let snake = to_snake_case(name);
    if env.members.fields.contains(&snake) || !env.lexer {
        return Result::Ok(`${env.this_bind}.${snake}`);
    }
    builtin::cold_path();
    return Result::Err(`java2wado: unsupported lexer name 'this.${name}': not a @members field`);
}

/// Refuse a member call this body cannot make. Both spellings — `this.m()` and
/// the bare `m()` — reach the same method, so both come through here.
fn check_member_call_reachable<S: AsStrSlice>(env: &JEnv, meth: S) -> Result<(), String> {
    if !method_declared(env, meth) {
        builtin::cold_path();
        return Result::Err(unknown_method_err(meth));
    }
    // A lexer predicate holds `&Lexer`: the tournament has no business mutating
    // through a losing candidate.
    if env.read_only && env.members.mutating.contains(&to_snake_case(meth)) {
        builtin::cold_path();
        return Result::Err(
            `java2wado: @members method '${meth}' writes through the recognizer, which a lexer predicate — evaluated for losing candidates too — must not do`,
        );
    }
    return Result::Ok(());
}

fn unknown_method_err<S: AsStrSlice>(name: S) -> String {
    return `java2wado: unsupported method '${name}': not a @members method or a recognizer API method`;
}

/// Whether `name` is the grammar's own parser / lexer class (`<Name>Parser` /
/// `<Name>Lexer`), the qualifier of a token constant `TParser.ELSE`.
fn is_grammar_class<S: AsStrSlice>(env: &JEnv, name: S) -> bool {
    return name == `${env.grammar}Parser` || name == `${env.grammar}Lexer`;
}

fn emit_args(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    args: &List<JExpr>,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    let mut out = String::from("");
    for let mut i = 0; i < args.len(); i += 1 {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(&emit_expr(rule, rules, &args[i], vals_in_scope, bindings, env)?);
    }
    return Result::Ok(out);
}

/// Whether `e` is a no-argument call of `name` (`getExpectedTokens()`).
fn call_names<S: AsStrSlice>(e: &JExpr, name: S) -> bool {
    if let Call(c) = e {
        return name_is(&c.callee, name) && c.args.is_empty();
    }
    return false;
}

/// Whether `e` is the bare name `s`.
pub fn name_is<S: AsStrSlice>(e: &JExpr, s: S) -> bool {
    return match e {
        Name(n) => *n == s.as_str_slice(),
        _ => false,
    };
}

fn is_system_out(e: &JExpr) -> bool {
    return match e {
        Member(m) => name_is(&m.recv, "System") && m.name == "out",
        _ => false,
    };
}

/// An all-uppercase identifier (`NL`, `ELSE`, `LL_EXACT`): a token-type constant,
/// qualified (`TParser.NL`) or not. Digits and `_` allowed; needs one A-Z.
fn is_upper_ident<S: AsStrSlice>(name: S) -> bool {
    let mut has_alpha = false;
    for let c of name.chars() {
        if c.is_ascii_uppercase() {
            has_alpha = true;
        } else if !(c.is_ascii_digit() || c == '_') {
            return false;
        }
    }
    return has_alpha;
}

/// Whether `e` has Java type `String`, which makes a `+` it is an operand of a
/// concatenation. Java decides by the operands' static types, so this answers
/// from the declarations the body can see.
fn is_java_string(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> bool {
    return match e {
        Str(_) => true,
        Attr(text) => attr_is_string(rule, rules, text, bindings),
        Name(n) => match resolve_name(env, n) {
            Local => env.string_locals.contains_str(n),
            RuleArg => declares_string(&rule.args, n),
            Field => env.members.string_fields.contains(&to_snake_case(n)),
            Unknown => false,
        },
        Member(m) => name_is(&m.recv, "this") && env.members.string_fields.contains(&to_snake_case(&m.name)),
        Call(c) => match &c.callee {
            Name(n) => is_string_api(n) || env.members.string_methods.contains(&to_snake_case(n)),
            Member(m) => is_string_api(&m.name)
                || name_is(&m.recv, "this") && env.members.string_methods.contains(&to_snake_case(&m.name)),
            _ => false,
        },
        Cast(c) => c.ty == "String",
        Binary(b) => b.op == "+" && concat_start(rule, rules, &plus_chain(e), bindings, env) matches { Some(_) },
        Paren(p) => is_java_string(rule, rules, &p.inner, bindings, env),
        Int(_) | Bool(_) | Unary(_) => false,
    };
}

/// Whether `$name` or `$name.member` reads a `String`: a `.text`, or an
/// attribute its rule declares `String`.
fn attr_is_string(rule: &ParserRule, rules: &List<ParserRule>, text: &String, bindings: &List<AltBinding>) -> bool {
    let body = text.substr_bytes(1, text.len());
    let Some(dot) = body.find(".") else {
        return body == "text"
            || declares_string(&rule.args, &body)
            || declares_string(&rule.returns_decls, &body)
            || declares_string(&rule.locals_decls, &body);
    };
    let label = body.substr_bytes(0, dot);
    let member = body.substr_bytes(dot + 1, body.len());
    if member == "text" {
        return true;
    }
    for let b of bindings {
        if b.binds(false, &label) {
            for let r of rules {
                if r.name == b.ref_name {
                    return declares_string(&r.returns_decls, &member);
                }
            }
        }
    }
    return false;
}

fn declares_string<S: AsStrSlice>(decls: &List<AttrDecl>, name: S) -> bool {
    for let d of decls {
        if d.name == name.as_str_slice() {
            return d.type_text.trim() == "String";
        }
    }
    return false;
}

/// The recognizer and `Object` methods returning a `String` on any receiver.
fn is_string_api<S: AsStrSlice>(name: S) -> bool {
    return name matches { "getText" | "toString" };
}

/// A left-associative `+` chain: its leftmost operand, then each `+` from the
/// innermost out, so `links[i].rhs` is operand `i + 1`.
struct PlusChain {
    first: &JExpr,
    links: List<&JBinary>,
}

fn plus_chain(e: &JExpr) -> PlusChain {
    let mut links: List<&JBinary> = [];
    let mut cur = e;
    while let Binary(b) = cur && b.op == "+" {
        links.push(b);
        cur = &b.lhs;
    }
    links.reverse();
    return PlusChain { first: cur, links };
}

/// Where Java's left-to-right evaluation turns the chain into a concatenation:
/// the link whose right operand is the first `String`, -1 when the leftmost
/// operand already is one, null when no operand is.
fn concat_start(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    chain: &PlusChain,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Option<i32> {
    if is_java_string(rule, rules, chain.first, bindings, env) {
        return Option::Some(-1);
    }
    for let i of 0..<chain.links.len() {
        if is_java_string(rule, rules, &chain.links[i].rhs, bindings, env) {
            return Option::Some(i);
        }
    }
    return null;
}

/// Emit a `+` chain: arithmetic until an operand is a `String`, a template
/// literal from there. Each operand is classified once.
fn emit_plus(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
) -> Result<String, String> {
    let chain = plus_chain(e);
    let Some(start) = concat_start(rule, rules, &chain, bindings, env) else {
        let mut out = emit_expr(rule, rules, chain.first, vals_in_scope, bindings, env)?;
        for let l of &chain.links {
            out.push_str(" + ");
            out.push_str(&emit_expr(rule, rules, &l.rhs, vals_in_scope, bindings, env)?);
        }
        return Result::Ok(out);
    };
    let mut out = String::from("`");
    append_concat(rule, rules, &chain, start, vals_in_scope, bindings, env, &mut out)?;
    out.push('`');
    return Result::Ok(out);
}

/// Append the parts of a chain that concatenates from link `start` on. What
/// precedes it is arithmetic, and so one interpolated value.
fn append_concat(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    chain: &PlusChain,
    start: i32,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
    out: &mut String,
) -> Result<(), String> {
    let head = if start < 0 { chain.first } else { &chain.links[start].lhs };
    append_part(rule, rules, head, vals_in_scope, bindings, env, out)?;
    for let i of i32::max(start, 0)..<chain.links.len() {
        append_part(rule, rules, &chain.links[i].rhs, vals_in_scope, bindings, env, out)?;
    }
    return Result::Ok(());
}

/// Append `e` as template text: a literal's text, a concatenation's own parts
/// (parenthesized or not), anything else interpolated.
fn append_part(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
    out: &mut String,
) -> Result<(), String> {
    return match e {
        Str(c) => {
            out.push_str(&escape_template(c));
            Result::Ok(());
        },
        Binary(b) && b.op == "+" => {
            let chain = plus_chain(e);
            match concat_start(rule, rules, &chain, bindings, env) {
                Some(start) => append_concat(rule, rules, &chain, start, vals_in_scope, bindings, env, out),
                None => append_interp(rule, rules, e, vals_in_scope, bindings, env, out),
            }
        },
        Paren(p) && is_java_string(rule, rules, &p.inner, bindings, env) => {
            append_part(rule, rules, &p.inner, vals_in_scope, bindings, env, out);
        },
        _ => append_interp(rule, rules, e, vals_in_scope, bindings, env, out),
    };
}

fn append_interp(
    rule: &ParserRule,
    rules: &List<ParserRule>,
    e: &JExpr,
    vals_in_scope: bool,
    bindings: &List<AltBinding>,
    env: &JEnv,
    out: &mut String,
) -> Result<(), String> {
    let expr = emit_expr(rule, rules, e, vals_in_scope, bindings, env)?;
    out.push_str("${");
    out.push_str(&expr);
    out.push('}');
    return Result::Ok(());
}

/// Escape a string-literal part for Wado template text. Only `$` (which could
/// start a `${` interpolation) and the backtick carry template meaning; braces
/// are literal. Java `\`-escapes pass through unchanged.
fn escape_template<S: AsStrSlice>(content: S) -> String {
    let mut out = String::with_capacity(content.chars().count());
    for let c of content.chars() {
        if c == '$' || c == '`' {
            out.push('\\');
        }
        out.push(c);
    }
    return out;
}
