//! What an action body can name in one parser rule, settled from the surface
//! rule once, so the translator and the action emit never walk it.

use { ActionSource, AltAction, Alternative, AttrDecl, Element, ParserRule, push_alt_actions } from "./ir.wado";
use { rule_is_left_recursive } from "./lr_util.wado";
use { HashMap } from "core:collections";

/// One parser rule as its action bodies see it.
pub struct RuleAttrs {
    pub name: String,
    pub args: List<AttrDecl> = [],
    pub returns_decls: List<AttrDecl> = [],
    pub locals_decls: List<AttrDecl> = [],
    pub init_action: Option<ActionSource> = null,
    pub after_action: Option<ActionSource> = null,
    pub left_recursive: bool = false,
    pub env: AttrEnv = AttrEnv {},
    /// Every action and predicate body running in the rule's own frame: its
    /// prequels', its alternatives', and those of the groups nested in them.
    pub action_bodies: List<String> = [],
    /// The id of every action and predicate the rule holds, prequels first.
    pub action_ids: List<i32> = [],
    pub alt_tokens: List<AltTokens> = [],
}

/// One alternative as `$ctx`'s token accessors see it.
pub struct AltTokens {
    pub label: Option<String>,
    /// How often each token can occur in one match, where a loop's body counts
    /// as twice: more than once is all the accessor's shape asks.
    pub counts: HashMap<String, i32>,
}

impl AltTokens {
    pub fn count(&self, name: &String) -> i32 {
        return self.counts.get_str(name).unwrap_or(0);
    }
}

internal struct LabelInfo {
    internal name: String,
    internal list: bool,
    internal is_token: bool,
    /// The referenced element's name: the rule name for a rule label (for member
    /// validation against its `returns`) or the token name for a token label
    /// (for the by-name alias). Empty when neither applies.
    internal ref_name: String,
}

/// The attribute environment of one parser rule: the names it defines.
pub struct AttrEnv {
    internal labels: List<LabelInfo> = [],
    internal attrs: List<String> = [],
    internal token_refs: List<String> = [],
    internal rule_refs: List<String> = [],
    /// `underlying_name → label` aliases: a labeled ref (`q=e`, `x=ID`) is also
    /// reachable by the referenced element's name (`$e`, `$ID`), resolving to the
    /// label's storage. Registered only when that name has a single labeled
    /// occurrence and no unlabeled one, matching ANTLR erroring on ambiguity.
    internal label_aliases: List<[String, String]> = [],
}

/// `rule_attrs_of` for each of `rules`, in their order.
pub fn rule_attrs_table(rules: &List<ParserRule>) -> List<RuleAttrs> {
    return rules.iter_ref().map(|r| rule_attrs_of(r)).collect();
}

fn rule_attrs_of(rule: &ParserRule) -> RuleAttrs {
    let mut action_bodies: List<String> = [];
    let mut action_ids: List<i32> = [];
    for let a of &[rule.init_action, rule.after_action] {
        if let Some(src) = a {
            action_bodies.push(src.text);
            action_ids.push(src.action_id);
        }
    }
    let mut actions: List<&AltAction> = [];
    for let alt of &rule.alternatives {
        push_alt_action_bodies(alt, &mut action_bodies);
        push_alt_actions(alt, &mut actions);
    }
    for let a of &actions {
        action_ids.push(a.source.action_id);
    }
    return RuleAttrs {
        name: rule.name,
        args: rule.args,
        returns_decls: rule.returns_decls,
        locals_decls: rule.locals_decls,
        init_action: rule.init_action,
        after_action: rule.after_action,
        left_recursive: rule_is_left_recursive(rule),
        env: build_attr_env(rule),
        action_bodies,
        action_ids,
        alt_tokens: rule.alternatives
            .iter_ref()
            .map(|a| AltTokens { label: a.label, counts: token_counts(&a.elements) })
            .collect(),
    };
}

fn token_counts(elements: &List<Element>) -> HashMap<String, i32> {
    let mut out = HashMap::<String, i32>::new();
    for let e of elements {
        for let [name, n] of token_counts_in(e).entries() {
            out[*name] = out.get_str(name).unwrap_or(0) + *n;
        }
    }
    return out;
}

fn token_counts_in(e: &Element) -> HashMap<String, i32> {
    return match e {
        TokenRef(t) => {
            let mut one = HashMap::<String, i32>::new();
            one[t.name] = 1;
            one;
        },
        Label(l) => token_counts_in(&l.element),
        Repeat(r) => {
            let once = token_counts_in(&r.element);
            if r.kind matches { _::Optional } {
                once;
            } else {
                let mut twice = HashMap::<String, i32>::new();
                for let [name, n] of once.entries() {
                    twice[*name] = 2 * *n;
                }
                twice;
            }
        },
        Group(g) => {
            let mut most = HashMap::<String, i32>::new();
            for let a of &g.alternatives {
                for let [name, n] of token_counts(&a.elements).entries() {
                    most[*name] = i32::max(most.get_str(name).unwrap_or(0), *n);
                }
            }
            most;
        },
        RuleRef(_) | Literal(_) | Wildcard(_) | Not(_) => HashMap::<String, i32>::new(),
    };
}

fn push_alt_action_bodies(alt: &Alternative, out: &mut List<String>) {
    for let a of &alt.actions {
        out.push(a.source.text);
    }
    for let e of &alt.elements {
        push_element_action_bodies(e, out);
    }
}

/// Every body running inside `elem`.
pub fn push_element_action_bodies(elem: &Element, out: &mut List<String>) {
    match elem {
        Group(g) => {
            for let alt of &g.alternatives {
                push_alt_action_bodies(alt, out);
            }
        },
        Repeat(rep) => push_element_action_bodies(&rep.element, out),
        Label(lab) => push_element_action_bodies(&lab.element, out),
        Not(n) => push_element_action_bodies(&n.element, out),
        // `a[$x.text]` is translated against the caller, so its arguments read
        // the caller's captures exactly as an action body does.
        RuleRef(r) => if let Some(src) = &r.arg_action {
            out.push(src.text);
        },
        _ => {
        },
    }
}

/// Build a rule's attribute environment by collecting its declared
/// attributes and walking its alternatives for labels and unlabeled refs.
fn build_attr_env(rule: &ParserRule) -> AttrEnv {
    let mut attrs: List<String> = [];
    for let d of &rule.args {
        attrs.push(d.name);
    }
    for let d of &rule.returns_decls {
        attrs.push(d.name);
    }
    for let d of &rule.locals_decls {
        attrs.push(d.name);
    }
    let mut labels: List<LabelInfo> = [];
    let mut token_refs: List<String> = [];
    let mut rule_refs: List<String> = [];
    for let alt of &rule.alternatives {
        for let e of &alt.elements {
            collect_env_element(e, &mut labels, &mut token_refs, &mut rule_refs);
        }
    }
    let label_aliases = build_label_aliases(&labels, &rule_refs, &token_refs);
    return AttrEnv { labels, attrs, token_refs, rule_refs, label_aliases };
}

/// Build the `underlying_name → label` alias table so a labeled ref is also
/// reachable by the referenced element's name: `$e` for `q=e`, `$ID` for
/// `x=ID`. Registered only when that name has exactly one labeled occurrence
/// and no unlabeled reference (of the same token/rule kind); an ambiguous
/// reference stays unresolved, a loud error as ANTLR reports. The alias is a
/// fallback (`resolve_one` tries direct resolution first), so it never shadows
/// a same-named declared attribute or label.
fn build_label_aliases(
    labels: &List<LabelInfo>,
    rule_refs: &List<String>,
    token_refs: &List<String>,
) -> List<[String, String]> {
    let mut aliases: List<[String, String]> = [];
    for let lab of labels {
        if lab.list || lab.ref_name == "" {
            continue;
        }
        let refs = if lab.is_token { token_refs } else { rule_refs };
        if count_labeled_ref(labels, &lab.ref_name, lab.is_token) != 1 || refs.contains_str(&lab.ref_name) {
            continue;
        }
        aliases.push([lab.ref_name, lab.name]);
    }
    return aliases;
}

fn count_labeled_ref<S: AsStrSlice>(labels: &List<LabelInfo>, ref_name: S, is_token: bool) -> i32 {
    let mut n = 0;
    for let lab of labels {
        if !lab.list && lab.is_token == is_token && lab.ref_name == ref_name.as_str_slice() {
            n += 1;
        }
    }
    return n;
}

fn collect_env_element(
    elem: &Element,
    labels: &mut List<LabelInfo>,
    token_refs: &mut List<String>,
    rule_refs: &mut List<String>,
) {
    match *elem {
        Label(lab) => {
            let [is_token, ref_name] = classify_labeled(&lab.element);
            labels.push(LabelInfo { name: lab.name, list: lab.list, is_token, ref_name });
        },
        RuleRef(rr) => rule_refs.push(rr.name),
        TokenRef(tr) => token_refs.push(tr.name),
        Group(g) => {
            for let alt of &g.alternatives {
                for let e of &alt.elements {
                    collect_env_element(e, labels, token_refs, rule_refs);
                }
            }
        },
        Repeat(rep) => collect_env_element(&rep.element, labels, token_refs, rule_refs),
        Not(n) => collect_env_element(&n.element, labels, token_refs, rule_refs),
        _ => {
        },
    }
}

/// Classify a labeled element as token-bound or rule-bound, returning
/// `[is_token, ref_name]`. A `RuleRef` is a rule (its name backs member
/// validation); a `TokenRef` is a token (its name backs the by-name alias); a
/// `Literal` is a token with no addressable name. Other shapes default
/// token-like.
fn classify_labeled(elem: &Element) -> [bool, String] {
    return match *elem {
        RuleRef(rr) => [false, rr.name],
        TokenRef(tr) => [true, tr.name],
        Literal(_) => [true, ""],
        Not(n) => classify_labeled(&n.element),
        _ => [true, ""],
    };
}
