//! Gale's library API.
//!
//! Currently exposes `gale-highlight`: grammar-agnostic rendering helpers for
//! Gale-generated highlighters (`Theme`, `document`, `run_cli`). The
//! grammar-specific `highlight()` / `parse()` functions live in each generated
//! parser, not here — see `highlight/facade.wado`.

pub use { Theme, document, theme_css, run_cli } from "./highlight/facade.wado";
