//! Gale's library API.
//!
//! Currently exposes `gale-highlight`: the grammar-agnostic `run_cli` batch
//! driver for Gale-generated highlighters. The grammar-specific `highlight()` /
//! `parse()` functions live in each generated parser, not here — see
//! `highlight/facade.wado`.

pub use { run_cli } from "./highlight/facade.wado";
