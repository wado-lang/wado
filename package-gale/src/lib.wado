//! Gale's library API.
//!
//! `gale-highlight`: grammar-agnostic helpers for Gale-generated highlighters.
//! `Theme` / `stylesheet` / `default_theme` turn a capture-class -> color map
//! into CSS; `run_cli` is a batch-highlight CLI driver. The grammar-specific
//! `highlight()` / `parse()` functions live in each generated parser, not here
//! — see `highlight/facade.wado`.

pub use { Theme, stylesheet, default_theme } from "./highlight/theme.wado";
pub use { run_cli } from "./highlight/facade.wado";
