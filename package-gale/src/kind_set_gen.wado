//! Token-set tables — `_kind_set_<id>` helpers, `FOLLOW_TABLES` with its
//! `FOLLOW_SITE_<id>` names, and `SYNC_<id>` globals — and the lookahead
//! conditions that read them. Module-level emit: `codegen` writes the tables
//! once, rule bodies only intern sets and build conditions.

use { EmitContext } from "./emit_context.wado";
use { follow_site_name, kind_set_fn_name, sync_bits_name, sync_list_name } from "./table_registry.wado";
use { HashSet } from "core:collections";
use { FOLLOW_SITE_LIMIT, FOLLOW_TABLES } from "./gen_util.wado";
use { sets_overlap, union_kind_arrays } from "./token_kinds.wado";
use { Reading } from "./readings.wado";
use { MAX_LOOKAHEAD_DEPTH } from "./prediction.wado";
use { DISPATCH_KIND_LOCAL } from "./ident.wado";
use { CodeWriter, FnSpec } from "lib:wadopoet";

/// Scan-side twin of `gen_lookahead_condition`. Uses
/// `tokens[pos + d]` (guarded by `pos + d < tokens.len()`) instead
/// of `p.peek_at(d)`. Multi-token sets route through
/// `EmitContext::kind_check_str` so they collapse to a `_kind_set_<id>(...)`
/// helper call; otherwise a 120-keyword set inlined at every dispatch
/// site bloats the generated wasm by hundreds of KB.
pub fn gen_scan_lookahead_condition(ctx: &mut EmitContext, sig: &List<List<i32>>) -> String {
    return join_lookahead_condition(ctx, sig, sig.len(), LookaheadAccess::Scan);
}

/// No token kinds: the default for a parameter naming the kinds already proven
/// or wanted.
pub global NO_KINDS: List<i32> = [];

/// A token set as the by-reference argument a membership test reads.
pub fn sync_set_ref(ctx: &mut EmitContext, sync: &List<i32>) -> String {
    return `&${ctx.sync_bits_ref(ctx.sync_set(*sync))}`;
}

/// A token set as the by-reference kind list a diagnostic names.
pub fn expected_set_ref(ctx: &mut EmitContext, expected: &List<i32>) -> String {
    return `&${ctx.sync_list_ref(ctx.sync_set(*expected))}`;
}

/// `p.expect_set(...)` consuming one token of `kinds`.
pub fn expect_set_call(ctx: &mut EmitContext, kinds: &List<i32>) -> String {
    let set = ctx.sync_set(*kinds);
    return `p.expect_set(&${ctx.sync_bits_ref(set)}, &${ctx.sync_list_ref(set)})`;
}

enum LookaheadAccess {
    Scan,
    ScanKind,
    Parse,
    ParseKind,
}

fn join_lookahead_condition(ctx: &mut EmitContext, sig: &List<List<i32>>, depth: i32, access: LookaheadAccess) -> String {
    let mut result = String::with_capacity(128);
    for let mut d = 0; d < depth; d += 1 {
        if d > 0 {
            result.push_str(" && ");
        }
        let part = match access {
            ScanKind && d == 0 => ctx.kind_check_str(&sig[d], DISPATCH_KIND_LOCAL),
            Scan | ScanKind => {
                let idx_expr = if d == 0 { `pos` } else { `pos + ${d}` };
                let check = ctx.kind_check_str(&sig[d], `tokens[${idx_expr}]`);
                `${idx_expr} < tokens.len() && ${check}`;
            },
            Parse => {
                let check_expr = if d == 0 { `p.peek_kind()` } else { `p.peek_at(${d})` };
                ctx.kind_check_str(&sig[d], &check_expr);
            },
            ParseKind => {
                let check_expr = if d == 0 { DISPATCH_KIND_LOCAL } else { `p.peek_at(${d})` };
                ctx.kind_check_str(&sig[d], &check_expr);
            },
        };
        result.push_str(&part);
    }
    return result;
}

pub fn gen_lookahead_condition(ctx: &mut EmitContext, sig: &List<List<i32>>) -> String {
    return join_lookahead_condition(ctx, sig, sig.len(), LookaheadAccess::Parse);
}

/// Emit the `_kind_set_<id>(k) -> bool` helper of each interned kind set the
/// emitted code names in `used`.
pub fn gen_kind_set_helpers(w: &mut CodeWriter, ctx: &EmitContext, used: &HashSet<String>) {
    for let entry of ctx.tables.kind_sets() {
        if used.contains(kind_set_fn_name(entry.id)) {
            gen_kind_set_helper_raw(w, entry.id, &ctx.analysis.token_names_of(&entry.tokens));
        }
    }
}

/// Emit the runtime FOLLOW tables: `FOLLOW_TABLES` holds every distinct
/// position set once, as a row of `stride` bitset words, and each site the
/// emitted code names as a row. The row opens with the set its readings can start with and whether one
/// is empty (`set << 1 | empty`), which turns most queries away at one test,
/// then each reading as a header (`len << 1 | ends`) and its positions' set
/// indices. `FOLLOW_SITE_<id>` is the row's 1-based
/// number, so a continuation is a scalar a call site composes with a shift, and
/// a rule takes one parameter rather than a row of slots.
pub fn gen_follow_tables(w: &mut CodeWriter, ctx: &EmitContext, used: &HashSet<String>) {
    // No caller-FOLLOW gate anywhere ⇒ no call site names the tables. A grammar
    // that gates on a forwarded `follow` alone names no site and still reads
    // the tables, so only the sites are conditional.
    if !ctx.plan.emit_follow {
        return;
    }
    let mut sets: List<List<i32>> = [];
    let mut starts: List<String> = ["0"];
    let mut readings: List<String> = [];
    let mut names: List<String> = [];
    let all_sites = ctx.tables.follow_sites();
    for let mut site_id = 0; site_id < all_sites.len(); site_id += 1 {
        let name = follow_site_name(site_id);
        if !used.contains(name) {
            continue;
        }
        let site = &all_sites[site_id];
        let [heads, has_empty] = site_heads(site);
        readings.push(`${intern_position_set(&mut sets, &heads) << 1 | if has_empty { 1 } else { 0 }}`);
        for let r of site {
            readings.push(`${r.kinds.len() << 1 | if r.ends { 1 } else { 0 }}`);
            for let position of &r.kinds {
                readings.push(`${intern_position_set(&mut sets, position)}`);
            }
        }
        starts.push(`${readings.len()}`);
        assert starts.len() - 1 <= FOLLOW_SITE_LIMIT, "the sites must fit a continuation slot";
        names.push(`global ${name}: i64 = ${starts.len() - 1};`);
    }
    let stride = (ctx.analysis.token_kind_count() - 1 >> 5) + 1;
    let mut rendered: List<String> = [];
    for let set of &sets {
        assert !set.is_empty(), "a reading's position takes some kind";
        let words = kind_bitset_words(set);
        assert words.len() <= stride;
        rendered.extend(&words);
        for let _ of words.len()..<stride {
            rendered.push("0");
        }
    }
    w.line(`global ${FOLLOW_TABLES}: FollowTables = FollowTables {`);
    w.line(`    stride: ${stride},`);
    w.line(`    sets: [${rendered.join(", ")}],`);
    w.line(`    starts: [${starts.join(", ")}],`);
    w.line(`    readings: [${readings.join(", ")}],`);
    w.line("};");
    for let line of &names {
        w.line(line);
    }
    w.blank();
}

/// A set of token kinds as the words `kind_set_has` tests: kind `k` is bit
/// `k & 31` of word `k >> 5`.
pub fn kind_bitset_words(set: &List<i32>) -> List<String> {
    let mut words: List<i32> = [];
    for let kind of set {
        assert *kind >= 0;
        let w = *kind >> 5;
        while words.len() <= w {
            words.push(0);
        }
        words[w] |= 1 << (*kind & 31);
    }
    let mut out: List<String> = [];
    for let word of &words {
        out.push(if *word == i32::MIN { String::from("i32::MIN") } else { `${*word}` });
    }
    return out;
}

/// The kinds a site's readings start with, and whether one of them is empty. A
/// site is never only the empty reading, which `continuation_arg` forwards
/// instead, so some reading starts with a token.
fn site_heads(site: &List<Reading>) -> [List<i32>, bool] {
    let mut heads: List<i32> = [];
    let mut has_empty = false;
    for let r of site {
        if r.kinds.is_empty() {
            has_empty = true;
        } else {
            heads = union_kind_arrays(&heads, &r.kinds[0]);
        }
    }
    assert !heads.is_empty(), "a site starts with some token";
    return [heads, has_empty];
}

/// The index of `set` in `sets`, appending it when it is new. A grammar
/// interns a handful of distinct positions, so a scan beats a map.
fn intern_position_set(sets: &mut List<List<i32>>, set: &List<i32>) -> i32 {
    for let mut i = 0; i < sets.len(); i += 1 {
        if sets[i] == *set {
            return i;
        }
    }
    sets.push(*set);
    return sets.len() - 1;
}

/// Emit the token-set globals: `EMPTY_SYNC`, then per interned set its
/// `SYNC_<id>` bits and its `EXPECTED_<id>` kind list, each only where `used`
/// names it.
pub fn gen_sync_set_globals(w: &mut CodeWriter, ctx: &EmitContext, used: &HashSet<String>) {
    // Also the empty wanted-set `fail` takes, so a lexer-only grammar — whose
    // `Parser` runtime is still emitted — needs it too.
    w.line("global EMPTY_SYNC: List<i32> = [];");
    for let entry of ctx.tables.sync_sets() {
        let bits = sync_bits_name(entry.id);
        if used.contains(bits) {
            w.line(`global ${bits}: List<i32> = [${kind_bitset_words(&entry.tokens).join(", ")}];`);
        }
        let list = sync_list_name(entry.id);
        if used.contains(list) {
            w.line(`global ${list}: List<i32> = [${ctx.analysis.token_names_of(&entry.tokens).join(", ")}];`);
        }
    }
    w.blank();
}

fn gen_kind_set_helper_raw(w: &mut CodeWriter, id: i32, tokens: &List<String>) {
    let mut f = FnSpec::new(kind_set_fn_name(id));
    f.add_param("k", "i32");
    f.set_return_type("bool");
    f.emit_begin(w);
    let mut body = String::with_capacity(64);
    body.push_str("return k matches { ");
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            body.push_str(" | ");
        }
        body.push_str(&tokens[i]);
    }
    body.push_str(" };");
    w.line(&body);
    w.end();
    w.blank();
}

pub fn build_lookahead_condition(ctx: &mut EmitContext, pos_sets: &List<List<i32>>, depth: i32) -> String {
    return join_lookahead_condition(ctx, pos_sets, depth, LookaheadAccess::ParseKind);
}

/// `build_lookahead_condition` inside a scan, which reads `kind` as the parse does.
pub fn build_scan_lookahead_condition(ctx: &mut EmitContext, pos_sets: &List<List<i32>>, depth: i32) -> String {
    return join_lookahead_condition(ctx, pos_sets, depth, LookaheadAccess::ScanKind);
}

pub fn find_needed_depth(all_position_sets: &List<List<List<i32>>>) -> i32 {
    let max_k = MAX_LOOKAHEAD_DEPTH;
    for let mut depth = 1; depth <= max_k; depth += 1 {
        let mut all_ok = true;
        for let mut i = 0; i < all_position_sets.len(); i += 1 {
            for let mut j = i + 1; j < all_position_sets.len(); j += 1 {
                let mut still_ambiguous = true;
                for let mut d = 0; d < depth; d += 1 {
                    if d >= all_position_sets[i].len() || d >= all_position_sets[j].len() {
                        still_ambiguous = false;
                        break;
                    }
                    if !sets_overlap(&all_position_sets[i][d], &all_position_sets[j][d]) {
                        still_ambiguous = false;
                        break;
                    }
                }
                if still_ambiguous {
                    all_ok = false;
                }
            }
        }
        if all_ok {
            return depth;
        }
    }
    return max_k;
}
