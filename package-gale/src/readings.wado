//! The ways a sequence of grammar elements can begin, at most `k` tokens deep,
//! as the runtime FOLLOW gate reads a continuation site. A reading is one run of
//! positions; readings of the same length that agree on whether the sequence
//! ends there merge, so a site holds at most `2k + 1` of them however many ways
//! its elements derive.

use { dedup_append_arr } from "./list_util.wado";
use { append_ids, bits_set } from "./token_kinds.wado";

/// One way a sequence begins: the kinds at each position, and whether the
/// sequence ends right after them, so that what follows it is read next. A
/// reading as long as the budget never ends: the gate reads no further.
pub struct Reading {
    /// Per position, the kinds valid there. An empty position admits any kind,
    /// as `.` and `~x` do.
    pub kinds: List<List<i32>>,
    pub ends: bool,
}

/// The one reading of a sequence that matches nothing and ends.
pub fn readings_empty(k: i32) -> List<Reading> {
    let mut out: List<Reading> = [];
    readings_add(&mut out, Reading { kinds: [], ends: true }, k);
    return out;
}

/// The one reading of a single position admitting `kinds`.
pub fn readings_of_position(kinds: List<i32>, k: i32) -> List<Reading> {
    let mut out: List<Reading> = [];
    readings_add(&mut out, Reading {
        kinds: [kinds],
        ends: true,
    }, k);
    return out;
}

/// Add `reading` to `out`, cut at `k` positions, merged into the reading of
/// its length and ending where there is one. Whether `out` grew.
pub fn readings_add(out: &mut List<Reading>, reading: Reading, k: i32) -> bool {
    return readings_add_joined(out, &reading.kinds, &[], reading.ends, k);
}

/// `readings_add` of the reading `head`'s positions then `tail`'s make, built
/// only where no reading of its length and ending is there to absorb it.
fn readings_add_joined(
    out: &mut List<Reading>,
    head: &List<List<i32>>,
    tail: &List<List<i32>>,
    ends: bool,
    k: i32,
) -> bool {
    let len = i32::min(head.len() + tail.len(), k);
    let ends = ends && len < k;
    let key = reading_key(len, ends);
    let mut at = 0;
    while at < out.len() && reading_key(out[at].kinds.len(), out[at].ends) < key {
        at += 1;
    }
    if at < out.len() && reading_key(out[at].kinds.len(), out[at].ends) == key {
        let mut grew = false;
        for let i of 0..<len {
            let from = if i < head.len() { &head[i] } else { &tail[i - head.len()] };
            grew = position_absorb(&mut out[at].kinds[i], from) || grew;
        }
        return grew;
    }
    let mut kinds: List<List<i32>> = [];
    for let i of 0..<len {
        kinds.push(if i < head.len() { head[i] } else { tail[i - head.len()] });
    }
    out.insert(at, Reading { kinds, ends });
    return true;
}

fn reading_key(len: i32, ends: bool) -> i32 {
    return len * 2 + if ends { 1 } else { 0 };
}

/// Widen `into` to admit what `from` admits. Whether it grew.
fn position_absorb(into: &mut List<i32>, from: &List<i32>) -> bool {
    if into.is_empty() {
        return false;
    }
    if from.is_empty() {
        into.clear();
        return true;
    }
    let before = into.len();
    if before * from.len() <= 64 {
        dedup_append_arr(into, from);
        return into.len() != before;
    }
    let mut held: List<u64> = [];
    for let i of 0..<before {
        bits_set(&mut held, into[i]);
    }
    append_ids(into, &mut held, from);
    return into.len() != before;
}

/// Every reading of `from`, cut at `k`.
pub fn readings_union_into(out: &mut List<Reading>, from: &List<Reading>, k: i32) {
    for let r of from {
        readings_add(out, *r, k);
    }
}

/// `head`'s reading, then `tail`'s, cut at `k`. A head reading that ends
/// continues into `tail`. Whether `out` grew.
pub fn reading_then(out: &mut List<Reading>, head: &Reading, tail: &List<Reading>, k: i32) -> bool
    contract head.ends
{
    let mut grew = false;
    for let t of tail {
        grew = readings_add_joined(out, &head.kinds, &t.kinds, t.ends, k) || grew;
    }
    return grew;
}

/// Whether some reading continues into what follows the sequence.
pub fn readings_end(readings: &List<Reading>) -> bool {
    return readings.iter_ref().any(|r| r.ends);
}

/// Whether the sequence is nothing but the empty one.
pub fn readings_are_empty(readings: &List<Reading>) -> bool {
    return readings.len() == 1 && readings[0].ends && readings[0].kinds.is_empty();
}
