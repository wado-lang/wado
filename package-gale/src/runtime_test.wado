use {
    Span,
    Token,
    LexerSlice,
    ParseError,
    CstNode,
    CstChild,
    TreeRecorder,
    Visitor,
    normalize_tree,
    HighlightMapping,
    HighlightOverride,
    HighlightCapture,
    HighlightVisitor,
    highlight_html,
    to_lexer_string,
} from "./runtime.wado";

fn ls(text: String) -> LexerSlice {
    return LexerSlice::from_string(text);
}

test "to_lexer_string interleaves non-default-channel trivia in source order" {
    // `A: 'a' -> mode(for);` then `B: 'b' -> channel(break);` (channel 2).
    // The B token is non-default-channel, so the generated tokenizer parks it
    // in the following token's leading_trivia. ANTLR4 still emits it into the
    // stream in source order with a `channel=N` attribute and a sequential
    // index. Mirrors `LexerExec/ReservedWordsEscaping`.
    let a = Token::new(0, ls("a"), Span::new(0, 1));
    let b = Token::with_channel(1, ls("b"), Span::new(1, 2), [], 2);
    let eof = Token::with_trivia(2, ls(""), Span::new(2, 2), [b]);
    let tokens: Array<Token> = [a, eof];
    let actual = to_lexer_string(&tokens, &"ab", 2);
    let expected = "[@0,0:0='a',<1>,1:0]
[@1,1:1='b',<2>,channel=2,1:1]
[@2,2:1='<EOF>',<-1>,1:2]
";
    assert actual == expected, `actual:\n{actual}\nexpected:\n{expected}`;
}

test "to_lexer_string skips default-channel (skip) trivia without consuming an index" {
    // Skip tokens also land in leading_trivia but carry channel 0; ANTLR4
    // discards them entirely, so they must neither appear in the dump nor
    // advance the `@index` counter.
    let a = Token::new(0, ls("a"), Span::new(0, 1));
    let ws = Token::new(1, ls(" "), Span::new(1, 2));
    let c = Token::with_trivia(0, ls("c"), Span::new(2, 3), [ws]);
    let tokens: Array<Token> = [a, c];
    let actual = to_lexer_string(&tokens, &"a c", 2);
    let expected = "[@0,0:0='a',<1>,1:0]
[@1,2:2='c',<1>,1:2]
";
    assert actual == expected, `actual:\n{actual}\nexpected:\n{expected}`;
}

test "Span::new creates span" {
    let s = Span::new(0, 5);
    assert s.start == 0;
    assert s.end == 5;
}

test "Span::len returns length" {
    let s = Span::new(3, 10);
    assert s.len() == 7;
}

test "Span::merge combines two spans" {
    let a = Span::new(5, 10);
    let b = Span::new(2, 8);
    let merged = a.merge(&b);
    assert merged.start == 2;
    assert merged.end == 10;
}

test "Span equality" {
    let a = Span::new(0, 5);
    let b = Span::new(0, 5);
    let c = Span::new(1, 5);
    assert a == b;
    assert a != c;
}

test "LexerSlice basic" {
    let chars: Array<char> = ['h', 'e', 'l', 'l', 'o'];
    let s = LexerSlice::new(&chars, 0, 5);
    assert s.len() == 5;
    assert !s.is_empty();
    assert s.to_string() == "hello";
}

test "LexerSlice empty" {
    let chars: Array<char> = [];
    let s = LexerSlice::empty(&chars);
    assert s.is_empty();
    assert s.len() == 0;
}

test "LexerSlice from_string" {
    let s = LexerSlice::from_string("hello");
    assert s.len() == 5;
    assert s.to_string() == "hello";
}

test "LexerSlice eq" {
    let a = ls("hello");
    let b = ls("hello");
    let c = ls("world");
    assert a == b;
    assert a != c;
}

test "LexerSlice eq_str" {
    let s = ls("hello");
    assert LexerSlice::eq_str(&"hello", &s);
    assert !LexerSlice::eq_str(&"world", &s);
    assert !LexerSlice::eq_str(&"hell", &s);
    assert !LexerSlice::eq_str(&"helloo", &s);
}

test "LexerSlice push_to" {
    let s = ls("world");
    let mut out = String::with_capacity(16);
    out.push_str(&"hello ");
    s.push_to(&mut out);
    assert out == "hello world";
}

test "LexerSlice display" {
    let s = ls("world");
    let msg = `hello {s}`;
    assert msg == "hello world";
}

test "Token::new creates token" {
    let t = Token::new(1, ls("hello"), Span::new(0, 5));
    assert t.kind == 1;
    assert t.text.to_string() == "hello";
    assert t.span == Span::new(0, 5);
}

// Note: Token equality test skipped due to compiler bug with recursive struct
// ref field Eq (see wado-compiler/tests/fixtures/recursive_struct_ref_eq.wado)

test "Token::new has empty leading_trivia" {
    let t = Token::new(1, ls("hello"), Span::new(0, 5));
    assert t.leading_trivia.is_empty();
}

test "Token::with_trivia attaches trivia" {
    let ws = Token::new(99, ls(" "), Span::new(0, 1));
    let trivia: Array<Token> = [ws];
    let t = Token::with_trivia(1, ls("hello"), Span::new(1, 6), trivia);
    assert t.leading_trivia.len() == 1;
    assert t.leading_trivia[0].text.to_string() == " ";
}

test "ParseError::new creates error" {
    let expected: Array<String> = ["INT", "STRING"];
    let err = ParseError::new("unexpected token", Span::new(5, 6), expected);
    assert err.message == "unexpected token";
    assert err.span == Span::new(5, 6);
    assert err.expected.len() == 2;
    assert err.expected[0] == "INT";
    assert err.expected[1] == "STRING";
}

test "TreeRecorder builds CstNode" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(0, &"root", &Span::new(0, 10));
    rec.visit_token(&Token::new(1, ls("hello"), Span::new(0, 5)));
    rec.visit_token(&Token::new(2, ls("world"), Span::new(6, 11)));
    rec.exit_rule(0, &"root", &Span::new(0, 10));
    let tree = rec.build();
    assert tree.name == "root";
    assert tree.children.len() == 2;
    if let Token(t) = tree.children[0] {
        assert t.text.to_string() == "hello";
    } else {
        panic("expected Token");
    }
}

test "TreeRecorder builds nested tree" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(0, &"parent", &Span::new(0, 20));
    rec.enter_rule(1, &"child", &Span::new(0, 5));
    rec.visit_token(&Token::new(1, ls("a"), Span::new(0, 1)));
    rec.exit_rule(1, &"child", &Span::new(0, 5));
    rec.visit_token(&Token::new(2, ls("b"), Span::new(10, 11)));
    rec.exit_rule(0, &"parent", &Span::new(0, 20));
    let tree = rec.build();
    assert tree.name == "parent";
    assert tree.children.len() == 2;
    if let Node(child) = tree.children[0] {
        assert child.name == "child";
        assert child.children.len() == 1;
    } else {
        panic("expected Node");
    }
}

test "to_string_tree leaf token" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(0, &"root", &Span::new(0, 2));
    rec.visit_token(&Token::new(1, ls("42"), Span::new(0, 2)));
    rec.exit_rule(0, &"root", &Span::new(0, 2));
    let tree = rec.build();
    assert tree.to_string_tree() == "(root 42)", `got: {tree.to_string_tree()}`;
}

test "to_string_tree nested" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(0, &"a", &Span::new(0, 10));
    rec.enter_rule(1, &"b", &Span::new(0, 2));
    rec.visit_token(&Token::new(1, ls("x"), Span::new(0, 1)));
    rec.exit_rule(1, &"b", &Span::new(0, 2));
    rec.visit_token(&Token::new(2, ls("+"), Span::new(3, 4)));
    rec.enter_rule(1, &"b", &Span::new(5, 7));
    rec.visit_token(&Token::new(1, ls("y"), Span::new(5, 6)));
    rec.exit_rule(1, &"b", &Span::new(5, 7));
    rec.exit_rule(0, &"a", &Span::new(0, 10));
    let tree = rec.build();
    assert tree.to_string_tree() == "(a (b x) + (b y))", `got: {tree.to_string_tree()}`;
}

test "to_string_tree skips empty text tokens" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(0, &"root", &Span::new(0, 5));
    rec.visit_token(&Token::new(1, ls("x"), Span::new(0, 1)));
    rec.visit_token(&Token::new(0, ls(""), Span::new(1, 1)));
    rec.exit_rule(0, &"root", &Span::new(0, 5));
    let tree = rec.build();
    assert tree.to_string_tree() == "(root x)", `got: {tree.to_string_tree()}`;
}

test "normalize_tree collapses whitespace" {
    let input = "
        (json
          (value 42))
    ";
    assert normalize_tree(&input) == "(json (value 42))";
}

test "normalize_tree preserves quoted strings" {
    let input = "
        (pair \"hello  world\" : (value 1))
    ";
    assert normalize_tree(&input) == "(pair \"hello  world\" : (value 1))";
}

test "normalize_tree single line passthrough" {
    let input = "(a (b x) + (b y))";
    assert normalize_tree(&input) == "(a (b x) + (b y))";
}

test "highlight_html escapes HTML and wraps captures" {
    let source = "<div>";
    let captures: Array<HighlightCapture> = [HighlightCapture { capture: "tag", start: 0, end: 5 }];
    let html = highlight_html(&source, &captures);
    assert html == `<span class="tag">&lt;div&gt;</span>`, `got: {html}`;
}

test "highlight_html emits plain text for gaps" {
    let source = "a + b";
    let captures: Array<HighlightCapture> = [HighlightCapture { capture: "operator", start: 2, end: 3 }];
    let html = highlight_html(&source, &captures);
    assert html == `a <span class="operator">+</span> b`, `got: {html}`;
}

test "highlight_html converts dot-separated captures to CSS classes" {
    let source = "{";
    let captures: Array<HighlightCapture> = [HighlightCapture { capture: "punctuation.bracket", start: 0, end: 1 }];
    let html = highlight_html(&source, &captures);
    assert html == `<span class="punctuation bracket">\{</span>`, `got: {html}`;
}

test "HighlightVisitor collects captures from tokens" {
    let mapping = HighlightMapping {
        defaults: ["string", "number", ""],
        rule_names: ["root"],
        overrides: [],
    };
    let mut visitor = HighlightVisitor::new(mapping);
    visitor.enter_rule(0, &"root", &Span::new(0, 10));
    visitor.visit_token(&Token::new(0, ls("\"hi\""), Span::new(0, 4)));
    visitor.visit_token(&Token::new(1, ls("42"), Span::new(5, 7)));
    visitor.visit_token(&Token::new(2, ls(" "), Span::new(7, 8)));
    visitor.exit_rule(0, &"root", &Span::new(0, 10));
    assert visitor.captures.len() == 2, `expected 2, got {visitor.captures.len()}`;
    assert visitor.captures[0].capture == "string";
    assert visitor.captures[0].start == 0;
    assert visitor.captures[0].end == 4;
    assert visitor.captures[1].capture == "number";
    assert visitor.captures[1].start == 5;
    assert visitor.captures[1].end == 7;
}

test "HighlightVisitor applies context overrides" {
    let mapping = HighlightMapping {
        defaults: ["string"],
        rule_names: ["root", "pair"],
        overrides: [HighlightOverride { rule_name: "pair", token_kind: 0, capture: "string.special.key" }],
    };
    let mut visitor = HighlightVisitor::new(mapping);
    visitor.enter_rule(0, &"root", &Span::new(0, 20));
    visitor.enter_rule(1, &"pair", &Span::new(0, 10));
    visitor.visit_token(&Token::new(0, ls("\"key\""), Span::new(0, 5)));
    visitor.exit_rule(1, &"pair", &Span::new(0, 10));
    visitor.visit_token(&Token::new(0, ls("\"val\""), Span::new(11, 16)));
    visitor.exit_rule(0, &"root", &Span::new(0, 20));
    assert visitor.captures[0].capture == "string.special.key", `got: {visitor.captures[0].capture}`;
    assert visitor.captures[1].capture == "string", `got: {visitor.captures[1].capture}`;
}

test "HighlightVisitor handles trivia" {
    let mapping = HighlightMapping {
        defaults: ["comment", "keyword"],
        rule_names: ["root"],
        overrides: [],
    };
    let mut visitor = HighlightVisitor::new(mapping);
    let trivia: Array<Token> = [Token::new(0, ls("/* hi */"), Span::new(0, 8))];
    let token = Token::with_trivia(1, ls("if"), Span::new(9, 11), trivia);
    visitor.enter_rule(0, &"root", &Span::new(0, 11));
    visitor.visit_token(&token);
    visitor.exit_rule(0, &"root", &Span::new(0, 11));
    assert visitor.captures.len() == 2;
    assert visitor.captures[0].capture == "comment";
    assert visitor.captures[0].start == 0;
    assert visitor.captures[1].capture == "keyword";
    assert visitor.captures[1].start == 9;
}
