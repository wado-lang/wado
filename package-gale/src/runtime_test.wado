use { Span, Token, LexerSlice, ParseError, TokenStream } from "./runtime/lex.wado";
use { normalize_tree, to_lexer_string } from "./runtime/tools.wado";
use {
    HighlightMapping,
    HighlightOverride,
    HighlightCapture,
    HighlightVisitor,
    highlight_html,
} from "./runtime/highlight.wado";

fn ls(text: String) -> LexerSlice {
    return LexerSlice::from_string(text);
}

/// Build a TokenStream over `src` from `[kind, start, end]` token specs (no
/// trivia). The returned stream borrows a fresh char list; GC keeps it alive.
fn stream_of(src: String, specs: List<[i32, i32, i32]>) -> TokenStream {
    let chars: List<char> = src.chars().collect();
    let mut ts = TokenStream::new(&chars);
    for let s of &specs {
        let lo = ts.trivia_mark();
        ts.push_token(s.0, s.1, s.2, lo, ts.trivia_mark());
    }
    return ts;
}

test "to_lexer_string interleaves non-default-channel trivia in source order" {
    // `A: 'a' -> mode(for);` then `B: 'b' -> channel(break);` (channel 2).
    // The B token is non-default-channel, so the generated tokenizer parks it
    // in the following token's leading_trivia. ANTLR4 still emits it into the
    // stream in source order with a `channel=N` attribute and a sequential
    // index. Mirrors `LexerExec/ReservedWordsEscaping`.
    let chars: List<char> = "ab".chars().collect();
    let mut ts = TokenStream::new(&chars);
    let lo_a = ts.trivia_mark();
    ts.push_token(0, 0, 1, lo_a, ts.trivia_mark());  // 'a', channel 0
    let lo_eof = ts.trivia_mark();
    ts.push_trivia(1, 1, 2, 2);  // 'b', channel 2 (hidden)
    ts.push_token(2, 2, 2, lo_eof, ts.trivia_mark());  // EOF carrying 'b' as trivia
    let actual = to_lexer_string(&ts, 2);
    let expected = "[@0,0:0='a',<1>,1:0]
[@1,1:1='b',<2>,channel=2,1:1]
[@2,2:1='<EOF>',<-1>,1:2]
";
    assert actual == expected;
}

test "to_lexer_string skips default-channel (skip) trivia without consuming an index" {
    // Skip tokens also land in leading_trivia but carry channel 0; ANTLR4
    // discards them entirely, so they must neither appear in the dump nor
    // advance the `@index` counter.
    let chars: List<char> = "a c".chars().collect();
    let mut ts = TokenStream::new(&chars);
    let lo_a = ts.trivia_mark();
    ts.push_token(0, 0, 1, lo_a, ts.trivia_mark());  // 'a'
    let lo_c = ts.trivia_mark();
    ts.push_trivia(1, 1, 2, 0);  // ' ' skip (channel 0)
    ts.push_token(0, 2, 3, lo_c, ts.trivia_mark());  // 'c' with skip trivia
    let actual = to_lexer_string(&ts, 2);
    let expected = "[@0,0:0='a',<1>,1:0]
[@1,2:2='c',<1>,1:2]
";
    assert actual == expected;
}

test "Span::new creates span" {
    let s = Span::new(0, 5);
    assert s.start == 0;
    assert s.end == 5;
}

test "TokenStream push_token keeps parallel arrays in lockstep and reads back" {
    // Source "ab c": tokens 'a'(0..1), 'b'(1..2), 'c'(3..4); a single space
    // (1 char) is leading trivia of 'c'.
    let chars: List<char> = "ab c".chars().collect();
    let mut ts = TokenStream::new(&chars);

    let lo0 = ts.trivia_mark();
    ts.push_token(10, 0, 1, lo0, ts.trivia_mark());
    let lo1 = ts.trivia_mark();
    ts.push_token(11, 1, 2, lo1, ts.trivia_mark());
    // 'c' has one leading space (skip/hidden trivia on channel 0).
    let lo2 = ts.trivia_mark();
    ts.push_trivia(99, 2, 3, 0);
    ts.push_token(12, 3, 4, lo2, ts.trivia_mark());

    assert ts.len() == 3;
    assert ts.kind_at(0) == 10;
    assert ts.kind_at(2) == 12;
    assert ts.span_at(2) == Span::new(3, 4);
    assert ts.token_text(0) == "a";
    assert ts.token_text(2) == "c";
    assert !ts.is_empty_text(0);

    // Token 2 owns exactly the one trivia entry; tokens 0 and 1 own none.
    assert ts.triv_lo[0] == ts.triv_hi[0];
    assert ts.triv_hi[2] - ts.triv_lo[2] == 1;
    assert ts.triv_kinds[ts.triv_lo[2]] == 99;
    assert ts.triv_chans[ts.triv_lo[2]] == 0;
}

test "TokenStream empty-text token reports empty (EOF sentinel)" {
    let chars: List<char> = "x".chars().collect();
    let mut ts = TokenStream::new(&chars);
    let lo = ts.trivia_mark();
    ts.push_token(0, 1, 1, lo, ts.trivia_mark());
    assert ts.is_empty_text(0);
    assert ts.token_text(0) == "";
}

test "ParseError::new leaves position at defaults" {
    let e = ParseError::new("oops", Span::new(0, 1), ["A"]);
    assert e.line == 1;
    assert e.col == 0;
    assert e.rule_stack.is_empty();
}

test "ParseError::at carries resolved position" {
    let e = ParseError::at(`expected '}', got "for"`, Span::new(40, 43), ["TK_RBRACE"], 12, 5);
    assert e.line == 12;
    assert e.col == 5;
    assert `${e}` == `parse error at 12:5: expected '}', got "for"`;
}

test "ParseError Display renders rule stack outermost-first" {
    let mut e = ParseError::at("unexpected token", Span::new(3, 4), ["TK_X"], 2, 7);
    // rule_stack is stored innermost-first, as the wrappers push it.
    e.rule_stack.push("statement");
    e.rule_stack.push("block");
    e.rule_stack.push("program");
    assert e.rule_path() == "program > block > statement";
    assert `${e}` == "parse error at 2:7: unexpected token\n  in rule: program > block > statement";
}

test "Span::len returns length" {
    let s = Span::new(3, 10);
    assert s.len() == 7;
}

test "Span::merge combines two spans" {
    let a = Span::new(5, 10);
    let b = Span::new(2, 8);
    let merged = a.merge(&b);
    assert merged.start == 2;
    assert merged.end == 10;
}

test "Span equality" {
    let a = Span::new(0, 5);
    let b = Span::new(0, 5);
    let c = Span::new(1, 5);
    assert a == b;
    assert a != c;
}

test "LexerSlice basic" {
    let chars: List<char> = ['h', 'e', 'l', 'l', 'o'];
    let s = LexerSlice::new(&chars, 0, 5);
    assert s.len() == 5;
    assert !s.is_empty();
    assert s.to_string() == "hello";
}

test "LexerSlice empty" {
    let chars: List<char> = [];
    let s = LexerSlice::empty(&chars);
    assert s.is_empty();
    assert s.len() == 0;
}

test "LexerSlice from_string" {
    let s = LexerSlice::from_string("hello");
    assert s.len() == 5;
    assert s.to_string() == "hello";
}

test "LexerSlice eq" {
    let a = ls("hello");
    let b = ls("hello");
    let c = ls("world");
    assert a == b;
    assert a != c;
}

test "LexerSlice eq_str" {
    let s = ls("hello");
    assert LexerSlice::eq_str(&"hello", &s);
    assert !LexerSlice::eq_str(&"world", &s);
    assert !LexerSlice::eq_str(&"hell", &s);
    assert !LexerSlice::eq_str(&"helloo", &s);
}

test "LexerSlice push_to" {
    let s = ls("world");
    let mut out = String::with_capacity(16);
    out.push_str(&"hello ");
    s.push_to(&mut out);
    assert out == "hello world";
}

test "LexerSlice display" {
    let s = ls("world");
    let msg = `hello ${s}`;
    assert msg == "hello world";
}

test "Token::new creates token" {
    let t = Token::new(1, ls("hello"), Span::new(0, 5));
    assert t.kind == 1;
    assert t.text.to_string() == "hello";
    assert t.span == Span::new(0, 5);
}

// Note: Token equality test skipped due to compiler bug with recursive struct
// ref field Eq (see wado-compiler/tests/fixtures/recursive_struct_ref_eq.wado)

test "Token::new has empty leading_trivia" {
    let t = Token::new(1, ls("hello"), Span::new(0, 5));
    assert t.leading_trivia.is_empty();
}

test "Token::with_trivia attaches trivia" {
    let ws = Token::new(99, ls(" "), Span::new(0, 1));
    let trivia: List<Token> = [ws];
    let t = Token::with_trivia(1, ls("hello"), Span::new(1, 6), trivia);
    assert t.leading_trivia.len() == 1;
    assert t.leading_trivia[0].text.to_string() == " ";
}

test "ParseError::new creates error" {
    let expected: List<String> = ["INT", "STRING"];
    let err = ParseError::new("unexpected token", Span::new(5, 6), expected);
    assert err.message == "unexpected token";
    assert err.span == Span::new(5, 6);
    assert err.expected.len() == 2;
    assert err.expected[0] == "INT";
    assert err.expected[1] == "STRING";
}

test "normalize_tree collapses whitespace" {
    let input = "
        (json
          (value 42))
    ";
    assert normalize_tree(&input) == "(json (value 42))";
}

test "normalize_tree preserves quoted strings" {
    let input = "
        (pair \"hello  world\" : (value 1))
    ";
    assert normalize_tree(&input) == "(pair \"hello  world\" : (value 1))";
}

test "normalize_tree single line passthrough" {
    let input = "(a (b x) + (b y))";
    assert normalize_tree(&input) == "(a (b x) + (b y))";
}

test "highlight_html escapes HTML and wraps captures" {
    let source = "<div>";
    let captures: List<HighlightCapture> = [
        HighlightCapture { capture_id: 0, start: 0, end: 5 },
    ];
    let html = highlight_html(&source, &captures, &["tag"]);
    assert html == `<span class="tag">&lt;div&gt;</span>`;
}

test "highlight_html emits plain text for gaps" {
    let source = "a + b";
    let captures: List<HighlightCapture> = [
        HighlightCapture { capture_id: 0, start: 2, end: 3 },
    ];
    let html = highlight_html(&source, &captures, &["operator"]);
    assert html == `a <span class="operator">+</span> b`;
}

test "HighlightVisitor converts dot-separated captures to CSS classes" {
    let mapping = HighlightMapping {
        defaults: ["punctuation.bracket"],
        rule_names: ["root"],
        overrides: [],
    };
    let visitor = HighlightVisitor::new(mapping);
    assert visitor.capture_names[0] == "punctuation.bracket";
    assert visitor.capture_classes[0] == "punctuation bracket";

    let source = "{";
    let captures: List<HighlightCapture> = [
        HighlightCapture { capture_id: 0, start: 0, end: 1 },
    ];
    let html = highlight_html(&source, &captures, &visitor.capture_classes);
    assert html == `<span class="punctuation bracket">\{</span>`;
}

test "HighlightVisitor collects captures from tokens" {
    let mapping = HighlightMapping {
        defaults: ["string", "number", ""],
        rule_names: ["root"],
        overrides: [],
    };
    let ts = stream_of("01234567", [
        [0, 0, 4],
        [1, 5, 7],
        [2, 7, 8],
    ]);
    let mut visitor = HighlightVisitor::new(mapping);
    visitor.hl_enter(0);
    visitor.hl_visit_token(&ts, 0);
    visitor.hl_visit_token(&ts, 1);
    visitor.hl_visit_token(&ts, 2);
    visitor.hl_exit();
    assert visitor.captures.len() == 2;
    assert visitor.capture_names[visitor.captures[0].capture_id] == "string";
    assert visitor.captures[0].start == 0;
    assert visitor.captures[0].end == 4;
    assert visitor.capture_names[visitor.captures[1].capture_id] == "number";
    assert visitor.captures[1].start == 5;
    assert visitor.captures[1].end == 7;
}

test "HighlightVisitor applies context overrides" {
    let mapping = HighlightMapping {
        defaults: ["string"],
        rule_names: ["root", "pair"],
        overrides: [
            HighlightOverride { rule_name: "pair", token_kind: 0, capture: "string.special.key" },
        ],
    };
    let ts = stream_of("0123456789012345", [
        [0, 0, 5],
        [0, 11, 16],
    ]);
    let mut visitor = HighlightVisitor::new(mapping);
    visitor.hl_enter(0);
    visitor.hl_enter(1);
    visitor.hl_visit_token(&ts, 0);
    visitor.hl_exit();
    visitor.hl_visit_token(&ts, 1);
    visitor.hl_exit();
    assert visitor.capture_names[visitor.captures[0].capture_id] == "string.special.key";
    assert visitor.capture_names[visitor.captures[1].capture_id] == "string";
}

test "HighlightVisitor handles trivia" {
    let mapping = HighlightMapping {
        defaults: ["comment", "keyword"],
        rule_names: ["root"],
        overrides: [],
    };
    let chars: List<char> = "0123456789a".chars().collect();
    let mut ts = TokenStream::new(&chars);
    let lo = ts.trivia_mark();
    ts.push_trivia(0, 0, 8, 0);  // "/* hi */" comment trivia
    ts.push_token(1, 9, 11, lo, ts.trivia_mark());  // "if" keyword
    let mut visitor = HighlightVisitor::new(mapping);
    visitor.hl_enter(0);
    visitor.hl_visit_token(&ts, 0);
    visitor.hl_exit();
    assert visitor.captures.len() == 2;
    assert visitor.capture_names[visitor.captures[0].capture_id] == "comment";
    assert visitor.captures[0].start == 0;
    assert visitor.capture_names[visitor.captures[1].capture_id] == "keyword";
    assert visitor.captures[1].start == 9;
}
