use {
    Span, Token, ParseError, CstNode, CstChild, TreeRecorder, Visitor, normalize_tree,
    HighlightMapping, HighlightOverride, HighlightCapture, HighlightVisitor,
    highlight_html, highlight_html_page,
} from "./runtime.wado";

test "Span::new creates span" {
    let s = Span::new(0, 5);
    assert s.start == 0;
    assert s.end == 5;
}

test "Span::len returns length" {
    let s = Span::new(3, 10);
    assert s.len() == 7;
}

test "Span::merge combines two spans" {
    let a = Span::new(5, 10);
    let b = Span::new(2, 8);
    let merged = a.merge(&b);
    assert merged.start == 2;
    assert merged.end == 10;
}

test "Span equality" {
    let a = Span::new(0, 5);
    let b = Span::new(0, 5);
    let c = Span::new(1, 5);
    assert a == b;
    assert a != c;
}

test "Token::new creates token" {
    let t = Token::new(1, "hello", Span::new(0, 5));
    assert t.kind == 1;
    assert t.text == "hello";
    assert t.span == Span::new(0, 5);
}

test "Token equality" {
    let a = Token::new(1, "x", Span::new(0, 1));
    let b = Token::new(1, "x", Span::new(0, 1));
    let c = Token::new(2, "x", Span::new(0, 1));
    assert a == b;
    assert a != c;
}

test "Token::new has empty leading_trivia" {
    let t = Token::new(1, "hello", Span::new(0, 5));
    assert t.leading_trivia.is_empty();
}

test "Token::with_trivia attaches trivia" {
    let ws = Token::new(99, " ", Span::new(0, 1));
    let trivia: Array<Token> = [ws];
    let t = Token::with_trivia(1, "hello", Span::new(1, 6), trivia);
    assert t.leading_trivia.len() == 1;
    assert t.leading_trivia[0].text == " ";
}

test "ParseError::new creates error" {
    let expected: Array<String> = ["INT", "STRING"];
    let err = ParseError::new("unexpected token", Span::new(5, 6), expected);
    assert err.message == "unexpected token";
    assert err.span == Span::new(5, 6);
    assert err.expected.len() == 2;
    assert err.expected[0] == "INT";
    assert err.expected[1] == "STRING";
}

test "TreeRecorder builds CstNode" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(&"root", &Span::new(0, 10));
    rec.visit_token(&Token::new(1, "hello", Span::new(0, 5)));
    rec.visit_token(&Token::new(2, "world", Span::new(6, 11)));
    rec.exit_rule(&"root", &Span::new(0, 10));
    let tree = rec.build();
    assert tree.name == "root";
    assert tree.children.len() == 2;
    if let Token(t) = tree.children[0] {
        assert t.text == "hello";
    } else {
        panic("expected Token");
    }
}

test "TreeRecorder builds nested tree" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(&"parent", &Span::new(0, 20));
    rec.enter_rule(&"child", &Span::new(0, 5));
    rec.visit_token(&Token::new(1, "a", Span::new(0, 1)));
    rec.exit_rule(&"child", &Span::new(0, 5));
    rec.visit_token(&Token::new(2, "b", Span::new(10, 11)));
    rec.exit_rule(&"parent", &Span::new(0, 20));
    let tree = rec.build();
    assert tree.name == "parent";
    assert tree.children.len() == 2;
    if let Node(child) = tree.children[0] {
        assert child.name == "child";
        assert child.children.len() == 1;
    } else {
        panic("expected Node");
    }
}

test "to_string_tree leaf token" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(&"root", &Span::new(0, 2));
    rec.visit_token(&Token::new(1, "42", Span::new(0, 2)));
    rec.exit_rule(&"root", &Span::new(0, 2));
    let tree = rec.build();
    assert tree.to_string_tree() == "(root 42)", `got: {tree.to_string_tree()}`;
}

test "to_string_tree nested" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(&"a", &Span::new(0, 10));
    rec.enter_rule(&"b", &Span::new(0, 2));
    rec.visit_token(&Token::new(1, "x", Span::new(0, 1)));
    rec.exit_rule(&"b", &Span::new(0, 2));
    rec.visit_token(&Token::new(2, "+", Span::new(3, 4)));
    rec.enter_rule(&"b", &Span::new(5, 7));
    rec.visit_token(&Token::new(1, "y", Span::new(5, 6)));
    rec.exit_rule(&"b", &Span::new(5, 7));
    rec.exit_rule(&"a", &Span::new(0, 10));
    let tree = rec.build();
    assert tree.to_string_tree() == "(a (b x) + (b y))", `got: {tree.to_string_tree()}`;
}

test "to_string_tree skips empty text tokens" {
    let mut rec = TreeRecorder::new();
    rec.enter_rule(&"root", &Span::new(0, 5));
    rec.visit_token(&Token::new(1, "x", Span::new(0, 1)));
    rec.visit_token(&Token::new(0, "", Span::new(1, 1)));
    rec.exit_rule(&"root", &Span::new(0, 5));
    let tree = rec.build();
    assert tree.to_string_tree() == "(root x)", `got: {tree.to_string_tree()}`;
}

test "normalize_tree collapses whitespace" {
    let input = "
        (json
          (value 42))
    ";
    assert normalize_tree(&input) == "(json (value 42))";
}

test "normalize_tree preserves quoted strings" {
    let input = "
        (pair \"hello  world\" : (value 1))
    ";
    assert normalize_tree(&input) == "(pair \"hello  world\" : (value 1))";
}

test "normalize_tree single line passthrough" {
    let input = "(a (b x) + (b y))";
    assert normalize_tree(&input) == "(a (b x) + (b y))";
}

test "highlight_html escapes HTML and wraps captures" {
    let source = "<div>";
    let captures: Array<HighlightCapture> = [
        HighlightCapture { capture: "tag", start: 0, end: 5 },
    ];
    let html = highlight_html(&source, &captures);
    assert html == `<span class="tag">&lt;div&gt;</span>`, `got: {html}`;
}

test "highlight_html emits plain text for gaps" {
    let source = "a + b";
    let captures: Array<HighlightCapture> = [
        HighlightCapture { capture: "operator", start: 2, end: 3 },
    ];
    let html = highlight_html(&source, &captures);
    assert html == `a <span class="operator">+</span> b`, `got: {html}`;
}

test "highlight_html converts dot-separated captures to CSS classes" {
    let source = "{";
    let captures: Array<HighlightCapture> = [
        HighlightCapture { capture: "punctuation.bracket", start: 0, end: 1 },
    ];
    let html = highlight_html(&source, &captures);
    assert html == `<span class="punctuation bracket">\{</span>`, `got: {html}`;
}

test "HighlightVisitor collects captures from tokens" {
    let mapping = HighlightMapping {
        defaults: ["string", "number", ""],
        overrides: [],
    };
    let mut visitor = HighlightVisitor::new(mapping);
    visitor.enter_rule(&"root", &Span::new(0, 10));
    visitor.visit_token(&Token::new(0, "\"hi\"", Span::new(0, 4)));
    visitor.visit_token(&Token::new(1, "42", Span::new(5, 7)));
    visitor.visit_token(&Token::new(2, " ", Span::new(7, 8)));
    visitor.exit_rule(&"root", &Span::new(0, 10));
    assert visitor.captures.len() == 2, `expected 2, got {visitor.captures.len()}`;
    assert visitor.captures[0].capture == "string";
    assert visitor.captures[0].start == 0;
    assert visitor.captures[0].end == 4;
    assert visitor.captures[1].capture == "number";
    assert visitor.captures[1].start == 5;
    assert visitor.captures[1].end == 7;
}

test "HighlightVisitor applies context overrides" {
    let mapping = HighlightMapping {
        defaults: ["string"],
        overrides: [HighlightOverride { rule_name: "pair", token_kind: 0, capture: "string.special.key" }],
    };
    let mut visitor = HighlightVisitor::new(mapping);
    visitor.enter_rule(&"root", &Span::new(0, 20));
    visitor.enter_rule(&"pair", &Span::new(0, 10));
    visitor.visit_token(&Token::new(0, "\"key\"", Span::new(0, 5)));
    visitor.exit_rule(&"pair", &Span::new(0, 10));
    visitor.visit_token(&Token::new(0, "\"val\"", Span::new(11, 16)));
    visitor.exit_rule(&"root", &Span::new(0, 20));
    assert visitor.captures[0].capture == "string.special.key", `got: {visitor.captures[0].capture}`;
    assert visitor.captures[1].capture == "string", `got: {visitor.captures[1].capture}`;
}

test "HighlightVisitor handles trivia" {
    let mapping = HighlightMapping {
        defaults: ["comment", "keyword"],
        overrides: [],
    };
    let mut visitor = HighlightVisitor::new(mapping);
    let trivia: Array<Token> = [Token::new(0, "/* hi */", Span::new(0, 8))];
    let token = Token::with_trivia(1, "if", Span::new(9, 11), trivia);
    visitor.enter_rule(&"root", &Span::new(0, 11));
    visitor.visit_token(&token);
    visitor.exit_rule(&"root", &Span::new(0, 11));
    assert visitor.captures.len() == 2;
    assert visitor.captures[0].capture == "comment";
    assert visitor.captures[0].start == 0;
    assert visitor.captures[1].capture == "keyword";
    assert visitor.captures[1].start == 9;
}

test "highlight_html_page produces complete HTML" {
    let source = "42";
    let captures: Array<HighlightCapture> = [
        HighlightCapture { capture: "number", start: 0, end: 2 },
    ];
    let html = highlight_html_page(&source, &captures);
    assert html.len() > 0;
    let has_doctype = html.chars().collect()[0] == '<';
    assert has_doctype;
    // Check it contains the number span
    let expected_span = `<span class="number">42</span>`;
    let mut found = false;
    // Simple substring check by searching for the expected content
    let html_chars = html.chars().collect();
    let exp_chars = expected_span.chars().collect();
    for let mut i = 0; i <= html_chars.len() - exp_chars.len(); i += 1 {
        let mut match_ = true;
        for let mut j = 0; j < exp_chars.len(); j += 1 {
            if html_chars[i + j] != exp_chars[j] {
                match_ = false;
                break;
            }
        }
        if match_ {
            found = true;
            break;
        }
    }
    assert found, "expected HTML to contain number span";
}
