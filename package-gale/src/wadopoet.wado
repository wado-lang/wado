/// WadoPoet — KotlinPoet-style code generation for Wado.
///
/// Hybrid design: `CodeWriter` handles indentation and blocks;
/// builder specs (`StructSpec`, `VariantSpec`, `FnSpec`, etc.)
/// provide type-safe declaration construction.
///
/// Function bodies remain string-based via `CodeWriter` — the same
/// pragmatic split as JavaPoet/KotlinPoet's `CodeBlock`.
pub struct CodeWriter {
    buf: String,
    indent_level: i32,
    fresh_line: bool,
    id_counter: i32,
}

impl CodeWriter {
    pub fn new() -> CodeWriter {
        // Pre-size to 64 KB: amortizes `String::grow` doublings over the
        // codegen pass (Rust*.g4 output ≈ 1.3 MB), negligible for small grammars.
        return CodeWriter::with_capacity(65536);
    }

    pub fn with_capacity(initial: i32) -> CodeWriter {
        return CodeWriter {
            buf: String::with_capacity(initial),
            indent_level: 0,
            fresh_line: true,
            id_counter: 0,
        };
    }

    /// Write text with auto-indentation at line starts.
    pub fn write(&mut self, text: &String) {
        for let c of text.chars() {
            if c == '\n' {
                self.buf.push('\n');
                self.fresh_line = true;
            } else {
                if self.fresh_line {
                    self.write_indent();
                    self.fresh_line = false;
                }
                self.buf.push(c);
            }
        }
    }

    /// Write a complete line (auto-indented, with trailing newline).
    pub fn line(&mut self, text: &String) {
        self.write_indent();
        self.buf.push_str(text);
        self.buf.push('\n');
        self.fresh_line = true;
    }

    /// Emit a blank line.
    pub fn blank(&mut self) {
        self.buf.push('\n');
        self.fresh_line = true;
    }

    /// Begin a block: emits "opener {" and increases indentation.
    pub fn begin(&mut self, opener: &String) {
        self.write_indent();
        self.buf.push_str(opener);
        self.buf.push_str(&" {\n");
        self.fresh_line = true;
        self.indent_level += 1;
    }

    /// End a block: decreases indentation and emits "}".
    pub fn end(&mut self) {
        self.indent_level -= 1;
        self.write_indent();
        self.buf.push_str(&"}\n");
        self.fresh_line = true;
    }

    /// End a block with a trailing suffix, e.g. "," or "\n".
    pub fn end_with(&mut self, suffix: &String) {
        self.indent_level -= 1;
        self.write_indent();
        self.buf.push('}');
        self.buf.push_str(suffix);
        self.buf.push('\n');
        self.fresh_line = true;
    }

    /// Close the current block and open a new one: "} opener {".
    /// Useful for else-if chains: `w.else_begin("else if cond")`.
    pub fn else_begin(&mut self, opener: &String) {
        self.indent_level -= 1;
        self.write_indent();
        self.buf.push_str(&"} ");
        self.buf.push_str(opener);
        self.buf.push_str(&" {\n");
        self.fresh_line = true;
        self.indent_level += 1;
    }

    /// Increase indentation level manually.
    pub fn indent(&mut self) {
        self.indent_level += 1;
    }

    /// Decrease indentation level manually.
    pub fn dedent(&mut self) {
        self.indent_level -= 1;
    }

    /// Generate a unique ID (replaces manual counter threading).
    pub fn next_id(&mut self) -> i32 {
        let id = self.id_counter;
        self.id_counter += 1;
        return id;
    }

    /// Append raw text with no indentation handling.
    pub fn raw(&mut self, text: &String) {
        self.buf.push_str(text);
        if text.len() > 0 {
            let chars: List<char> = text.chars().collect();
            self.fresh_line = chars[chars.len() - 1] == '\n';
        }
    }

    /// Return the generated code. Asserts that indentation is balanced.
    pub fn to_string(&self) -> String {
        assert self.indent_level == 0, `CodeWriter: unbalanced indentation (level={self.indent_level})`;
        return self.buf;
    }

    fn write_indent(&mut self) {
        for let mut i = 0; i < self.indent_level; i += 1 {
            self.buf.push_str(&"    ");
        }
    }
}

/// A Wado string literal. `Display` writes the source text of a `"..."`
/// literal that the Wado lexer reads back to the wrapped value: only `"`,
/// `\`, and control characters are escaped; every other scalar — including
/// all printable non-ASCII (Japanese, emoji, …) — is emitted verbatim.
///
/// This is deliberately *not* `Inspect`. `Inspect` is debug output and may
/// truncate or change format; `StrLit` is bound to the Wado string-literal
/// grammar and guarantees round-trippable source.
pub struct StrLit {
    value: String,
}

/// A Wado char literal (`'x'`). Same escaping contract as `StrLit`, escaping
/// `'` instead of `"`.
pub struct CharLit {
    value: char,
}

/// Wrap `value` so interpolating it in a template emits a valid Wado string
/// literal: `str_lit(&"a\"b")` formats to `"a\"b"`.
pub fn str_lit(value: &String) -> StrLit {
    return StrLit { value: *value };
}

/// Wrap `value` so interpolating it in a template emits a valid Wado char
/// literal: `char_lit('\n')` formats to `'\n'`.
pub fn char_lit(value: char) -> CharLit {
    return CharLit { value };
}

/// Write `c` as the body of a Wado literal delimited by `quote` (`'"'` for a
/// string, `'\''` for a char). Escapes the delimiter, the backslash, and
/// control characters; passes every other scalar through unchanged so
/// printable non-ASCII text survives intact.
///
/// The control-char policy mirrors `Inspect for String` in core's
/// `format.wado` (see WEP: Inspect). Keep the two in lockstep: a literal
/// emitted here and a `{x:?}` debug rendering must escape the same set.
fn write_literal_char(f: &mut Formatter, c: char, quote: char) {
    if c == quote || c == '\\' {
        f.write_char('\\');
        f.write_char(c);
    } else if c == '\n' {
        f.write_str(&"\\n");
    } else if c == '\r' {
        f.write_str(&"\\r");
    } else if c == '\t' {
        f.write_str(&"\\t");
    } else {
        let code = c as i32;
        if code < 0x20 || code == 0x7f {
            // C0 control / DEL with no named escape: `\u{HEX}`.
            f.write_str(&"\\u{");
            f.write_str(&`{code:x}`);
            f.write_char('}');
        } else {
            f.write_char(c);
        }
    }
}

impl Display for StrLit {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_char('"');
        for let c of self.value.chars() {
            write_literal_char(f, c, '"');
        }
        f.write_char('"');
    }
}

impl Display for CharLit {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_char('\'');
        write_literal_char(f, self.value, '\'');
        f.write_char('\'');
    }
}

pub struct FieldSpec {
    pub name: String,
    pub type_str: String,
    pub is_pub: bool,
}

impl FieldSpec {
    pub fn new(name: &String, type_str: &String) -> FieldSpec {
        return FieldSpec { name: *name, type_str: *type_str, is_pub: false };
    }

    pub fn new_pub(name: &String, type_str: &String) -> FieldSpec {
        return FieldSpec { name: *name, type_str: *type_str, is_pub: true };
    }
}

pub struct StructSpec {
    pub name: String,
    fields: List<FieldSpec>,
    is_pub: bool,
}

impl StructSpec {
    pub fn new(name: &String) -> StructSpec {
        return StructSpec { name: *name, fields: [], is_pub: false };
    }

    pub fn set_pub(&mut self) -> &mut StructSpec with stores[self] {
        self.is_pub = true;
        return self;
    }

    pub fn add_field(&mut self, name: &String, type_str: &String) -> &mut StructSpec with stores[self] {
        self.fields.push(FieldSpec::new(name, type_str));
        return self;
    }

    pub fn add_pub_field(&mut self, name: &String, type_str: &String) -> &mut StructSpec with stores[self] {
        self.fields.push(FieldSpec::new_pub(name, type_str));
        return self;
    }

    pub fn add_field_spec(&mut self, field: FieldSpec) -> &mut StructSpec with stores[self] {
        self.fields.push(field);
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        let prefix = if self.is_pub { "pub " } else { "" };
        w.begin(&`{prefix}struct {self.name}`);
        for let field of &self.fields {
            let vis = if field.is_pub { "pub " } else { "" };
            w.line(&`{vis}{field.name}: {field.type_str},`);
        }
        w.end();
    }
}

pub struct VariantCase {
    pub name: String,
    pub payload: Option<String>,
}

pub struct VariantSpec {
    pub name: String,
    cases: List<VariantCase>,
    is_pub: bool,
}

impl VariantSpec {
    pub fn new(name: &String) -> VariantSpec {
        return VariantSpec { name: *name, cases: [], is_pub: false };
    }

    pub fn set_pub(&mut self) -> &mut VariantSpec with stores[self] {
        self.is_pub = true;
        return self;
    }

    pub fn add_case(&mut self, name: &String) -> &mut VariantSpec with stores[self] {
        self.cases.push(VariantCase { name: *name, payload: null });
        return self;
    }

    pub fn add_case_with_payload(&mut self, name: &String, payload: &String) -> &mut VariantSpec with stores[self] {
        self.cases.push(VariantCase {
            name: *name,
            payload: Option::<String>::Some(*payload),
        });
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        let prefix = if self.is_pub { "pub " } else { "" };
        w.begin(&`{prefix}variant {self.name}`);
        for let case of &self.cases {
            if let Some(p) = &case.payload {
                w.line(&`{case.name}({*p}),`);
            } else {
                w.line(&`{case.name},`);
            }
        }
        w.end();
    }
}

pub struct EnumMember {
    pub name: String,
    pub trailing_comment: Option<String>,
}

pub struct EnumSpec {
    pub name: String,
    members: List<EnumMember>,
    is_pub: bool,
}

impl EnumSpec {
    pub fn new(name: &String) -> EnumSpec {
        return EnumSpec { name: *name, members: [], is_pub: false };
    }

    pub fn set_pub(&mut self) -> &mut EnumSpec with stores[self] {
        self.is_pub = true;
        return self;
    }

    pub fn add_member(&mut self, name: &String) -> &mut EnumSpec with stores[self] {
        self.members.push(EnumMember { name: *name, trailing_comment: null });
        return self;
    }

    pub fn add_member_with_comment(&mut self, name: &String, comment: &String) -> &mut EnumSpec with stores[self] {
        self.members.push(EnumMember {
            name: *name,
            trailing_comment: Option::<String>::Some(*comment),
        });
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        let prefix = if self.is_pub { "pub " } else { "" };
        w.begin(&`{prefix}enum {self.name}`);
        for let member of &self.members {
            if let Some(c) = &member.trailing_comment {
                w.line(&`{member.name},  // {*c}`);
            } else {
                w.line(&`{member.name},`);
            }
        }
        w.end();
    }
}

pub struct ParamSpec {
    pub name: String,
    pub type_str: String,
    pub is_mut: bool = false,
    pub default_value: Option<String> = null,
}

impl ParamSpec {
    pub fn new(name: &String, type_str: &String) -> ParamSpec {
        return ParamSpec { name: *name, type_str: *type_str };
    }
}

/// Join strings with ", " — the separator every spec list (generics,
/// effects, …) renders with.
fn join_comma(items: &List<String>) -> String {
    let mut out = String::with_capacity(items.len() * 8);
    for let mut i = 0; i < items.len(); i += 1 {
        if i > 0 {
            out.push_str(&", ");
        }
        out.push_str(&items[i]);
    }
    return out;
}

pub struct FnSpec {
    pub name: String,
    params: List<ParamSpec>,
    return_type: Option<String>,
    is_pub: bool,
    is_export: bool,
    /// Generic type parameters, each rendered verbatim between the name
    /// and the parameter list (e.g. `"V: Visitor"` → `fn walk<V: Visitor>(`).
    generics: List<String>,
    /// Effect names for the `with …` clause, rendered after the return
    /// type (e.g. `["Stdout", "Stderr"]` → ` with Stdout, Stderr`).
    effects: List<String>,
    receiver: Option<String>,
}

impl FnSpec {
    pub fn new(name: &String) -> FnSpec {
        return FnSpec {
            name: *name,
            params: [],
            return_type: null,
            is_pub: false,
            is_export: false,
            generics: [],
            effects: [],
            receiver: null,
        };
    }

    pub fn set_pub(&mut self) -> &mut FnSpec with stores[self] {
        self.is_pub = true;
        return self;
    }

    /// Mark the function `export` (component-model export). Mutually
    /// exclusive with `pub`; `export` wins if both are set.
    pub fn set_export(&mut self) -> &mut FnSpec with stores[self] {
        self.is_export = true;
        return self;
    }

    pub fn add_generic(&mut self, generic: &String) -> &mut FnSpec with stores[self] {
        self.generics.push(*generic);
        return self;
    }

    pub fn add_effect(&mut self, effect_name: &String) -> &mut FnSpec with stores[self] {
        self.effects.push(*effect_name);
        return self;
    }

    pub fn set_receiver(&mut self, recv: &String) -> &mut FnSpec with stores[self] {
        self.receiver = Option::<String>::Some(*recv);
        return self;
    }

    pub fn add_param(&mut self, name: &String, type_str: &String) -> &mut FnSpec with stores[self] {
        self.params.push(ParamSpec::new(name, type_str));
        return self;
    }

    pub fn add_param_spec(&mut self, param: ParamSpec) -> &mut FnSpec with stores[self] {
        self.params.push(param);
        return self;
    }

    pub fn set_return_type(&mut self, type_str: &String) -> &mut FnSpec with stores[self] {
        self.return_type = Option::<String>::Some(*type_str);
        return self;
    }

    /// Emit the function signature as a `begin` block (opens `{`).
    /// Caller writes the body via `w`, then calls `w.end()`.
    pub fn emit_begin(&self, w: &mut CodeWriter) {
        w.begin(&self.signature());
    }

    /// Build the full signature string.
    pub fn signature(&self) -> String {
        let mut sig = String::with_capacity(64);
        if self.is_export {
            sig.push_str(&"export ");
        } else if self.is_pub {
            sig.push_str(&"pub ");
        }
        sig.push_str(&`fn {self.name}`);
        if self.generics.len() > 0 {
            sig.push_str(&`<{join_comma(&self.generics)}>`);
        }
        sig.push_str(&"(");
        let mut first = true;
        if let Some(recv) = &self.receiver {
            sig.push_str(recv);
            first = false;
        }
        for let param of &self.params {
            if !first {
                sig.push_str(&", ");
            }
            if param.is_mut {
                sig.push_str(&"mut ");
            }
            sig.push_str(&`{param.name}: {param.type_str}`);
            if let Some(d) = &param.default_value {
                sig.push_str(&` = {*d}`);
            }
            first = false;
        }
        sig.push_str(&")");
        if let Some(ret) = &self.return_type {
            sig.push_str(&` -> {*ret}`);
        }
        if self.effects.len() > 0 {
            sig.push_str(&` with {join_comma(&self.effects)}`);
        }
        return sig;
    }
}

pub struct GlobalSpec {
    pub name: String,
    type_str: String,
    initializer: String,
    is_pub: bool,
    is_mut: bool,
    trailing_comment: Option<String>,
}

impl GlobalSpec {
    pub fn new(name: &String, type_str: &String, initializer: &String) -> GlobalSpec {
        return GlobalSpec {
            name: *name,
            type_str: *type_str,
            initializer: *initializer,
            is_pub: false,
            is_mut: false,
            trailing_comment: null,
        };
    }

    pub fn set_pub(&mut self) -> &mut GlobalSpec with stores[self] {
        self.is_pub = true;
        return self;
    }

    pub fn set_trailing_comment(&mut self, comment: &String) -> &mut GlobalSpec with stores[self] {
        self.trailing_comment = Option::<String>::Some(*comment);
        return self;
    }

    pub fn emit(&self, w: &mut CodeWriter) {
        let vis = if self.is_pub { "pub " } else { "" };
        let mutability = if self.is_mut { "mut " } else { "" };
        let trailer = if let Some(c) = &self.trailing_comment {
            `  // {*c}`;
        } else {
            "";
        };
        w.line(&`{vis}global {mutability}{self.name}: {self.type_str} = {self.initializer};{trailer}`);
    }
}

pub struct ImplSpec {
    type_name: String,
    trait_name: Option<String>,
}

impl ImplSpec {
    pub fn new(type_name: &String) -> ImplSpec {
        return ImplSpec { type_name: *type_name, trait_name: null };
    }

    pub fn new_trait(trait_name: &String, type_name: &String) -> ImplSpec {
        return ImplSpec {
            type_name: *type_name,
            trait_name: Option::<String>::Some(*trait_name),
        };
    }

    pub fn emit_begin(&self, w: &mut CodeWriter) {
        if let Some(t) = &self.trait_name {
            w.begin(&`impl {*t} for {self.type_name}`);
        } else {
            w.begin(&`impl {self.type_name}`);
        }
    }
}
