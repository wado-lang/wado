//! `gale dump --lexer` rendering — per lexer rule, the matcher that covers its
//! text and the emit strategy of every decision inside it.
//!
//! Nothing here decides anything. `lexer_rule_route` says which matcher covers
//! a rule, and `lexer_rule_plan` — the tree `gen_lexer` itself emits from —
//! says which strategy every decision below it took and where. This module
//! renders that plan, so the report cannot name a strategy the emit did not
//! choose, nor reach a construct the emit did not.
//!
//! Not reported: a repeat directly under another repeat or a `~`. No sequence
//! surrounds such a position, so there is no strategy to pick.

use {
    Grammar,
    GrammarOption,
    LexerRule,
    LexerAlternative,
    LexerElement,
    CharClass,
    LexerRepeatElement,
} from "./ir.wado";
use {
    LitToken,
    KeywordInfo,
    LexerRuleRoute,
    LexerAltsEmit,
    LexerRepeatEmit,
    LexerGroupEmit,
    collect_literal_tokens,
    collect_keyword_rules,
    resolve_ci,
    lexer_try_fn_name,
    lexer_rule_route,
    lexer_alt_suffix,
    find_fragment,
    lexer_rule_plan,
    LexerBodyPlan,
    LexerSeqPlan,
    LexerStepPlan,
    LexerGroupPlan,
    LexerGroupShape,
    LexerRepeatPlan,
    LexerElemPlan,
} from "./lexer_gen.wado";
use { grammar_needs_latn, build_latn } from "./latn.wado";
use { TreeMap } from "core:collections";

/// Read-only inputs every walk step needs. Assembled once from the grammar,
/// exactly as `generate` assembles them for `gen_lexer`.
struct DumpCtx {
    rules: List<LexerRule>,
    grammar_opts: List<GrammarOption>,
    keywords: List<KeywordInfo>,
    lit_tokens: List<LitToken>,
    grammar_ci: bool,
    /// `name -> latn rule index` for the rules routed to the runtime lexer
    /// simulator instead of a static matcher.
    atn_class: TreeMap<String, i32>,
}

/// The report under construction: the text plus the per-strategy tallies the
/// trailing summary prints. `scope` prefixes a decision line with the chain of
/// inlined fragments it was reached through (empty in the rule's own body).
struct DumpOut {
    text: String,
    scope: String = "",
    route_matcher: i32 = 0,
    route_keyword: i32 = 0,
    route_literal: i32 = 0,
    route_inlined_fragment: i32 = 0,
    route_recursive_fragment: i32 = 0,
    route_virtual: i32 = 0,
    route_atn: i32 = 0,
    repeat_plain: i32 = 0,
    repeat_lookahead: i32 = 0,
    repeat_non_greedy: i32 = 0,
    group_first_match: i32 = 0,
    group_arm_scoring: i32 = 0,
    alts_first_match: i32 = 0,
    alts_maximal_munch: i32 = 0,
}

/// Render the per-rule lexer emit report for a grammar.
///
/// Takes the surface `Grammar` alone, deriving every input `gen_lexer` reads
/// the way `generate` derives it.
pub fn render_lexer_dump(grammar: &Grammar) -> String {
    let empty_opts: List<GrammarOption> = [];
    let ctx = DumpCtx {
        rules: grammar.lexer_rules,
        grammar_opts: grammar.options,
        keywords: collect_keyword_rules(&grammar.lexer_rules, &grammar.options),
        lit_tokens: collect_literal_tokens(&grammar.parser_rules),
        grammar_ci: resolve_ci(&grammar.options, &empty_opts),
        atn_class: latn_rule_indices(grammar),
    };

    let mut o = DumpOut {
        text: String::with_capacity(256 + 192 * grammar.lexer_rules.len()),
    };
    o.text.push_str(&`grammar ${grammar.name} (lexer)\n\n`);
    for let rule of &grammar.lexer_rules {
        render_rule(&mut o, &ctx, rule);
    }
    render_summary(&mut o);
    return o.text;
}

/// The lexer-ATN routing map, built exactly as `generate` builds it: nothing
/// unless some rule is ATN-class, then one entry per such rule.
fn latn_rule_indices(grammar: &Grammar) -> TreeMap<String, i32> {
    let mut out = TreeMap::<String, i32>::new();
    if !grammar_needs_latn(grammar) {
        return out;
    }
    let latn = build_latn(grammar);
    for let name of &latn.atn_class_rules {
        if let Some(idx) = latn.rule_index.get(*name) {
            out[*name] = idx;
        }
    }
    return out;
}

fn render_rule(o: &mut DumpOut, ctx: &DumpCtx, rule: &LexerRule) {
    let route = lexer_rule_route(
        rule,
        &ctx.rules,
        &ctx.keywords,
        &ctx.lit_tokens,
        &ctx.grammar_opts,
        ctx.grammar_ci,
    );

    o.text.push_str(&`rule ${rule.name} — `);
    // An ATN-class rule has a matcher, but its body is one `latn_match` call:
    // the static strategies below never apply to it.
    if let Some(idx) = ctx.atn_class.get(rule.name) {
        o.route_atn += 1;
        o.text.push_str(&`ATN-class: latn_match (latn rule ${idx})\n`);
        return;
    }
    count_route(o, &route);
    o.text.push_str(&route_label(rule, &route));
    o.text.push('\n');

    if route_emits_body(&route) {
        walk_rule_body(o, ctx, rule);
    }
}

fn count_route(o: &mut DumpOut, route: &LexerRuleRoute) {
    match route {
        Matcher => o.route_matcher += 1,
        RecursiveFragment => o.route_recursive_fragment += 1,
        InlinedFragment => o.route_inlined_fragment += 1,
        Virtual => o.route_virtual += 1,
        Keyword(_) => o.route_keyword += 1,
        SharedLiteral(_) => o.route_literal += 1,
    }
}

fn route_label(rule: &LexerRule, route: &LexerRuleRoute) -> String {
    let try_fn = lexer_try_fn_name(&rule.name);
    return match route {
        Matcher => `matcher ${try_fn}`,
        RecursiveFragment => `recursive fragment: matcher ${try_fn}`,
        InlinedFragment => "fragment: inlined at each use site",
        Virtual => "virtual token: no text to match",
        Keyword(k) => `keyword classifier (carrier ${k.carrier})${also_matcher_suffix(k.also_matcher, &try_fn)}`,
        SharedLiteral(l) => `shared literal matcher (${l.const_name})${also_matcher_suffix(l.also_matcher, &try_fn)}`,
    };
}

/// A called rule keeps its own matcher on top of whatever else covers its text.
fn also_matcher_suffix(also: bool, try_fn: &String) -> String {
    if !also {
        return "";
    }
    return ` + matcher ${*try_fn} (another rule calls it)`;
}

/// Whether the rule's body is emitted somewhere, so its decisions belong under
/// this entry. An inlined fragment's are reported at its use sites instead.
fn route_emits_body(route: &LexerRuleRoute) -> bool {
    return match route {
        Matcher | RecursiveFragment => true,
        Virtual | InlinedFragment => false,
        Keyword(k) => k.also_matcher,
        SharedLiteral(l) => l.also_matcher,
    };
}

// ==========================================================================
// The walk — mirrors gen_lexer_alt_seq / gen_lexer_alts / gen_lexer_elem
// ==========================================================================

/// Render the rule's body from the plan the emitter takes its decisions from.
/// Nothing here decides anything: every branch below reads the plan, so this
/// report cannot describe a strategy the emit did not choose, nor reach a
/// construct the emit did not.
fn walk_rule_body(o: &mut DumpOut, ctx: &DumpCtx, rule: &LexerRule) {
    let plan = lexer_rule_plan(rule, &ctx.rules, &ctx.grammar_opts);
    render_body(o, ctx, &rule.body, &plan.body, /*top=*/ true);
}

/// `top` is the rule's own body alternation. It is reported even out of tail
/// position — that a rule's alternation cannot take maximal munch is a thing
/// someone asks this dump for — while a nested one there stays quiet, its
/// enclosing construct having already reported the decision.
fn render_body(o: &mut DumpOut, ctx: &DumpCtx, alts: &List<LexerAlternative>, plan: &LexerBodyPlan, top: bool) {
    match plan {
        Single(seq) => render_seq(o, ctx, &alts[0], seq),
        Alts(ap) => {
            if top || !ap.emit matches { FirstMatchNotTail } {
                if ap.emit matches { MaximalMunch } {
                    o.alts_maximal_munch += 1;
                } else {
                    o.alts_first_match += 1;
                }
                decision_line(o, &`alternation ${alts_text(alts, 0)} — ${alts_emit_label(ap.emit)}`);
            }
            for let mut i = 0; i < alts.len(); i += 1 {
                render_seq(o, ctx, &alts[i], &ap.arms[i]);
            }
        },
    }
}

fn render_seq(o: &mut DumpOut, ctx: &DumpCtx, alt: &LexerAlternative, plan: &LexerSeqPlan) {
    for let mut i = 0; i < plan.steps.len(); i += 1 {
        let elem = &alt.elements[i];
        match &plan.steps[i] {
            Repeat(rp) => render_repeat(o, ctx, alt, i, rp),
            Group(gp) => render_group(o, ctx, alt, i, gp),
            Elem(ep) => render_elem(o, ctx, elem, ep),
        }
    }
}

/// `SingleArm` is not an alternation and `NoSuffix` is the tail-alternation
/// decision `render_body` reports, so neither is a line here.
fn render_group(o: &mut DumpOut, ctx: &DumpCtx, alt: &LexerAlternative, index: i32, plan: &LexerGroupPlan) {
    let Group(g_alts) = &alt.elements[index] else {
        panic("a group step plans something other than a group");
    };
    if !plan.emit matches { FirstMatchSingleArm | FirstMatchNoSuffix } {
        if plan.emit matches { ArmScoring } {
            o.group_arm_scoring += 1;
        } else {
            o.group_first_match += 1;
        }
        let suffix = LexerAlternative { elements: lexer_alt_suffix(alt, index) };
        decision_line(
            o,
            &`alternation ${alts_text(g_alts, 0)}${suffix_text(&suffix)} — ${group_emit_label(plan.emit)}`,
        );
    }
    match &plan.shape {
        // The suffix is a step of the enclosing sequence, which renders it — the
        // scoring only peeks it.
        Scored(arms) => {
            for let mut a = 0; a < g_alts.len(); a += 1 {
                render_seq(o, ctx, &g_alts[a], &arms[a]);
            }
        },
        FirstMatch(body) => render_body(o, ctx, g_alts, body, /*top=*/ false),
    }
}

fn render_repeat(o: &mut DumpOut, ctx: &DumpCtx, alt: &LexerAlternative, index: i32, plan: &LexerRepeatPlan) {
    match plan.emit {
        NonGreedy => {
            o.repeat_non_greedy += 1;
        },
        LookaheadAware => {
            o.repeat_lookahead += 1;
        },
        PlainOptional | PlainNoSuffix | PlainInnerNotPerChar | PlainPredicateAfter | PlainSuffixDisjoint | PlainSuffixNotPeekable => {
            o.repeat_plain += 1;
        },
    }
    let suffix = LexerAlternative { elements: lexer_alt_suffix(alt, index) };
    decision_line(
        o,
        &`repeat ${elem_text(&alt.elements[index], 0)}${suffix_text(&suffix)} — ${repeat_emit_label(plan.emit)}`,
    );
    let Repeat(rep) = &alt.elements[index] else {
        panic("a repeat step plans something other than a repeat");
    };
    render_elem(o, ctx, &rep.element, &plan.inner);
    if let Some(cut) = &plan.rest {
        render_seq(o, ctx, &cut.alt, &cut.plan);
    }
}

/// The ` then <suffix>` a decision line carries, so the reason it gives can be
/// read against the thing it is about. Empty when nothing follows.
fn suffix_text(suffix: &LexerAlternative) -> String {
    if suffix.elements.is_empty() {
        return "";
    }
    return ` then ${alt_text(suffix, 0)}`;
}

fn render_elem(o: &mut DumpOut, ctx: &DumpCtx, elem: &LexerElement, plan: &LexerElemPlan) {
    match plan {
        Body(body) => {
            let Group(alts) = elem else {
                // The only other element planned as a body is a rule reference
                // whose fragment the emit inlines here.
                let RuleRef(name) = elem else {
                    panic("a body plan against neither a group nor a rule reference");
                };
                let Some(frag) = find_fragment(&ctx.rules, name) else {
                    panic("a body plan against a rule reference with no fragment");
                };
                let saved = o.scope;
                o.scope = `${o.scope}${name} › `;
                render_body(o, ctx, &frag.body, body, /*top=*/ false);
                o.scope = saved;
                return;
            };
            render_body(o, ctx, alts, body, /*top=*/ false);
        },
        PlainRepeat(nested) => {
            let Repeat(rep) = elem else {
                panic("a repeat plan against something other than a repeat");
            };
            render_elem(o, ctx, &rep.element, &nested.inner);
        },
        Not(nested) => {
            let Not(n) = elem else {
                panic("a not plan against something other than a not");
            };
            render_elem(o, ctx, &n.element, &nested.inner);
        },
        Leaf => {
        },
    }
}

fn decision_line(o: &mut DumpOut, text: &String) {
    o.text.push_str(&"  ");
    o.text.push_str(&o.scope);
    o.text.push_str(text);
    o.text.push('\n');
}

// ==========================================================================
// Strategy labels
// ==========================================================================

fn alts_emit_label(emit: LexerAltsEmit) -> String {
    return match emit {
        MaximalMunch => "maximal munch: every arm scanned from the same start, longest wins",
        FirstMatchNotTail => "first-match: not in tail position, a longer arm could strand what follows",
        FirstMatchSingleArm => "first-match: one arm",
        FirstMatchFixedLenArms => "first-match: every arm consumes the same fixed length",
        FirstMatchArmPredicate => "first-match: an arm carries a semantic predicate",
    };
}

fn group_emit_label(emit: LexerGroupEmit) -> String {
    return match emit {
        ArmScoring => "arm scoring: each arm scored on how far arm-plus-suffix reaches",
        FirstMatchSingleArm => "first-match: one arm",
        FirstMatchNoSuffix => "first-match: nothing follows",
        FirstMatchFixedLenArms => "first-match: every arm consumes the same fixed length",
        FirstMatchArmPredicate => "first-match: an arm carries a semantic predicate",
        FirstMatchArmsDisjoint => "first-match: no two arms can match at the same position",
        FirstMatchPredicateAfter => "first-match: a semantic predicate follows the alternation",
        FirstMatchSuffixNotPeekable => "first-match: the suffix carries a semantic predicate, so it cannot be peeked",
    };
}

fn repeat_emit_label(emit: LexerRepeatEmit) -> String {
    return match emit {
        NonGreedy => "non-greedy: min-match loop, the rest of the alternative is tried first",
        LookaheadAware => "lookahead-aware: the inner can eat a char the suffix needs",
        PlainOptional => "plain loop: one optional element, no loop to overshoot with",
        PlainNoSuffix => "plain loop: nothing follows the repeat",
        PlainInnerNotPerChar => "plain loop: the inner does not consume exactly one char per iteration",
        PlainPredicateAfter => "plain loop: a semantic predicate follows the repeat",
        PlainSuffixDisjoint => "plain loop: the inner cannot eat the suffix's first char",
        PlainSuffixNotPeekable => "plain loop: the suffix carries a semantic predicate, so it cannot be peeked",
    };
}

// ==========================================================================
// Summary
// ==========================================================================

fn render_summary(o: &mut DumpOut) {
    let routes = `routes: matcher ${o.route_matcher}, keyword classifier ${o.route_keyword}, shared literal ${o.route_literal}, inlined fragment ${o.route_inlined_fragment}, recursive fragment ${o.route_recursive_fragment}, virtual ${o.route_virtual}, ATN-class ${o.route_atn}`;
    let repeats = `greedy repeat: plain ${o.repeat_plain}, lookahead-aware ${o.repeat_lookahead}; non-greedy repeat: ${o.repeat_non_greedy}`;
    let groups = `alternation + suffix: first-match ${o.group_first_match}, arm scoring ${o.group_arm_scoring}`;
    let alts = `alternation: first-match ${o.alts_first_match}, maximal munch ${o.alts_maximal_munch}`;
    o.text.push_str(&`\nstrategies:\n  ${routes}\n  ${repeats}\n  ${groups}\n  ${alts}\n`);
}

// ==========================================================================
// Element rendering — a short g4-shaped label so a line names its construct
// ==========================================================================

/// Nesting past this renders as `…`: the label identifies a construct, it does
/// not reproduce the grammar.
global ELEM_TEXT_MAX_DEPTH: i32 = 3;

/// A `[\p{L}]`-style class is hundreds of ranges; enough of them to recognize
/// the class is enough.
global ELEM_TEXT_MAX_RANGES: i32 = 6;

fn alts_text(alts: &List<LexerAlternative>, depth: i32) -> String {
    let mut s = String::with_capacity(24);
    s.push('(');
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 {
            s.push_str(&" | ");
        }
        s.push_str(&alt_text(&alts[i], depth));
    }
    s.push(')');
    return s;
}

fn alt_text(alt: &LexerAlternative, depth: i32) -> String {
    if alt.elements.is_empty() {
        return "ε";
    }
    let mut s = String::with_capacity(16);
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        if i > 0 {
            s.push(' ');
        }
        s.push_str(&elem_text(&alt.elements[i], depth));
    }
    return s;
}

fn elem_text(elem: &LexerElement, depth: i32) -> String {
    if depth > ELEM_TEXT_MAX_DEPTH {
        return "…";
    }
    return match *elem {
        Literal(text) => literal_text(&text),
        CharRange(pair) => {
            let mut s = String::with_capacity(8);
            push_quoted_char(&mut s, pair.0);
            s.push_str(&"..");
            push_quoted_char(&mut s, pair.1);
            s;
        },
        CharClass(cc) => char_class_text(&cc),
        AnyChar => ".",
        RuleRef(name) => name,
        Group(alts) => alts_text(&alts, depth + 1),
        Repeat(rep) => `${elem_text(&rep.element, depth)}${repeat_suffix(&rep)}`,
        Not(n) => `~${elem_text(&n.element, depth)}`,
    };
}

fn repeat_suffix(rep: &LexerRepeatElement) -> String {
    let kind = match rep.kind {
        Star => "*",
        Plus => "+",
        Optional => "?",
    };
    return if rep.non_greedy { `${kind}?` } else { kind };
}

fn literal_text(text: &String) -> String {
    let mut s = String::with_capacity(text.len() + 2);
    s.push('\'');
    for let c of text.chars() {
        push_escaped_char(&mut s, c);
    }
    s.push('\'');
    return s;
}

fn char_class_text(cc: &CharClass) -> String {
    let mut s = String::with_capacity(16);
    if cc.negated {
        s.push('~');
    }
    s.push('[');
    for let mut i = 0; i < cc.ranges.len(); i += 1 {
        if i >= ELEM_TEXT_MAX_RANGES {
            s.push('…');
            break;
        }
        let r = &cc.ranges[i];
        push_escaped_char(&mut s, r.start);
        if r.end != r.start {
            s.push('-');
            push_escaped_char(&mut s, r.end);
        }
    }
    s.push(']');
    return s;
}

fn push_quoted_char(s: &mut String, c: char) {
    s.push('\'');
    push_escaped_char(s, c);
    s.push('\'');
}

fn push_escaped_char(s: &mut String, c: char) {
    match c {
        '\n' => s.push_str(&"\\n"),
        '\r' => s.push_str(&"\\r"),
        '\t' => s.push_str(&"\\t"),
        '\\' => s.push_str(&"\\\\"),
        '\'' => s.push_str(&"\\'"),
        _ => {
            let code = c as i32;
            if code < 0x20 || code == 0x7F {
                s.push_str(&`\\u{${code:x}}`);
            } else {
                s.push(c);
            }
        },
    }
}
