//! White-box tests for `prediction_node_eq`, the predicate `find_merge_branch`
//! folds two dispatch branches on. It must cover every field the emit reads.

use {
    PredictionNode,
    PredictionDispatch,
    PredictionBranch,
    AmbiguousNode,
    AmbiguityReason,
    prediction_node_eq,
} from "./prediction.wado";

fn ambiguous(alts: List<i32>, reason: AmbiguityReason) -> PredictionNode {
    return PredictionNode::Ambiguous(AmbiguousNode { alts, reason });
}

fn dispatch(child: PredictionNode) -> PredictionNode {
    return PredictionNode::Dispatch(PredictionDispatch {
        depth: 1,
        branches: [
            PredictionBranch {
                tokens: [1],
                child,
            },
        ],
    });
}

test "prediction_node_eq: Ambiguous leaves over the same alternatives fold, whatever the reason" {
    // Every reason emits the same decision among the alternatives, so
    // splitting the branch on the label alone would duplicate identical code.
    let a = ambiguous([0, 1], AmbiguityReason::AtEndConflict);
    let b = ambiguous([0, 1], AmbiguityReason::MaxDepth);
    assert prediction_node_eq(&a, &b);
}

test "prediction_node_eq: a nested Ambiguous is compared through the Dispatch" {
    // A leaf difference must survive one level of nesting.
    let a = dispatch(ambiguous([0, 1], AmbiguityReason::MaxDepth));
    let b = dispatch(ambiguous([0, 2], AmbiguityReason::MaxDepth));
    assert !prediction_node_eq(&a, &b);
    let c = dispatch(ambiguous([0, 1], AmbiguityReason::AtEndConflict));
    assert prediction_node_eq(&a, &c);
}

test "prediction_node_eq: sub-dispatches differing in guard tokens are not equal" {
    let a = PredictionNode::Dispatch(PredictionDispatch {
        depth: 1,
        branches: [
            PredictionBranch {
                tokens: [1],
                child: PredictionNode::Leaf(0),
            },
        ],
    });
    let b = PredictionNode::Dispatch(PredictionDispatch {
        depth: 1,
        branches: [
            PredictionBranch {
                tokens: [2],
                child: PredictionNode::Leaf(0),
            },
        ],
    });
    assert !prediction_node_eq(&a, &b);
}

test "prediction_node_eq: sub-dispatches differing in depth are not equal" {
    let a = PredictionNode::Dispatch(PredictionDispatch {
        depth: 1,
        branches: [
            PredictionBranch {
                tokens: [1],
                child: PredictionNode::Leaf(0),
            },
        ],
    });
    let b = PredictionNode::Dispatch(PredictionDispatch {
        depth: 2,
        branches: [
            PredictionBranch {
                tokens: [1],
                child: PredictionNode::Leaf(0),
            },
        ],
    });
    assert !prediction_node_eq(&a, &b);
}
