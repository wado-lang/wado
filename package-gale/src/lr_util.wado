//! Surface-IR classifiers for direct left recursion: the one answer lowering,
//! emit, action translation and the scan gate all read.

use { Alternative, Element, ParserRule } from "./ir.wado";

/// True iff the alternative starts with a self-reference to the
/// enclosing rule. Mirrors ANTLR4's direct-LR detection.
pub fn alt_is_left_recursive<S: AsStrSlice>(alt: &Alternative, rule_name: S) -> bool {
    if alt.elements.is_empty() {
        return false;
    }
    return element_is_self_ref(&alt.elements[0], rule_name);
}

/// Whether a left-recursive alternative continues past its leading
/// self-reference, which makes it an edge of the loop-entry decision.
/// `expr : expr` does not.
pub fn lr_alt_has_suffix(alt: &Alternative) -> bool {
    return alt.elements.len() > 1;
}

/// Whether any alternative is directly left-recursive. ANTLR4 rewrites only
/// direct LR (`vendor/antlr4/doc/left-recursion.md`).
pub fn rule_is_left_recursive(rule: &ParserRule) -> bool {
    return rule.alternatives.iter_ref().any(|alt| alt_is_left_recursive(alt, &rule.name));
}

/// True iff the alternative matches ANTLR4's `prefix` shape from
/// `LeftRecursiveRuleWalker.g`:
///   prefix : ALT element+ recurse epsilonElement* ;
/// i.e. the alt does NOT start with a self-reference but its LAST
/// element IS a self-reference. Examples: `'-' e`, `('~'|'!') e`,
/// `'(' typespec ')' e`. Counter-examples that look superficially
/// similar but are NOT prefix alts in ANTLR4's classification:
///   - `'(' e ')'` — last elem is `')'`, not self-ref → "other" alt
///   - `'new' T ( ... e ... )` — last elem is a Group → "other" alt
/// "Other" alts (`otherAlt`) are NOT given a precedence rewrite in
/// ANTLR4: their inner self-refs run with `_p = 0`, accepting all
/// LR operators inside.
///
/// Gale's IR has already stripped action bodies and semantic predicates,
/// so the upstream `epsilonElement*` tail collapses to the empty case.
fn is_prefix_alt<S: AsStrSlice>(alt: &Alternative, rule_name: S) -> bool {
    if alt_is_left_recursive(alt, rule_name) {
        return false;
    }
    if alt.elements.len() == 0 {
        return false;
    }
    let last_idx = alt.elements.len() - 1;
    return element_is_self_ref(&alt.elements[last_idx], rule_name);
}

/// True iff the element is a RuleRef to `rule_name`, possibly labeled, so a
/// labeled self-ref (`b=e`) is still recognised.
pub fn element_is_self_ref<S: AsStrSlice>(elem: &Element, rule_name: S) -> bool {
    if let RuleRef(r) = unwrap_label(elem) {
        return r.name == rule_name.as_str_slice();
    }
    return false;
}

/// Peel a single `Label` wrapper from `elem` if present. Used by
/// the LR classifiers so labeled self-refs are recognised as
/// self-refs.
pub fn unwrap_label(elem: &Element) -> &Element {
    if let Label(lab) = elem {
        return &lab.element;
    }
    return elem;
}

/// Compute the `min_prec` value to pass into self-recursive RuleRef calls
/// inside a prefix alt. ANTLR4's left-recursion transform calls the inner
/// `e` of a prefix alt with the alt's own precedence (`e[precedence(alt)]`),
/// so any LR suffix below the prefix alt in source order is excluded.
///
/// Returns 0 if the alt is not a prefix alt, or if the rule has no LR alts
/// (in which case `parse_<rule>` has no `min_prec` parameter and the
/// override would not be valid).
///
/// Formula: count the LR alts at positions strictly greater than `alt_index`
/// in `rule.alternatives`. Their `own_prec` values are 1..N (N = the count),
/// so setting `min_prec = N + 1` rejects all of them while still admitting
/// LR alts that come before this prefix.
pub fn compute_prefix_self_ref_min_prec(rule: &ParserRule, alt_index: i32) -> i32 {
    let alts = &rule.alternatives;
    let rule_name = &rule.name;
    if alt_index < 0 || alt_index >= alts.len() {
        return 0;
    }
    let alt = &alts[alt_index];
    if !is_prefix_alt(alt, rule_name) {
        return 0;
    }
    let mut lr_after = 0;
    let mut has_any_lr = false;
    for let mut i = 0; i < alts.len(); i += 1 {
        if alt_is_left_recursive(&alts[i], rule_name) {
            has_any_lr = true;
            if i > alt_index {
                lr_after += 1;
            }
        }
    }
    if !has_any_lr {
        return 0;
    }
    return lr_after + 1;
}
