pub struct LitToken {
    pub text: String,
    pub const_name: String,
}

pub struct KeywordInfo {
    pub rule_name: String,
    pub lowercase_text: String,
    pub char_ci: List<bool>,
}

/// ANTLR4 `caseInsensitive` resolution: a rule-level option (when present)
/// overrides the grammar-level option. ANTLR4 spec: `doc/options.md`.
fn lookup_ci_option(opts: &List<GrammarOption>) -> Option<bool> {
    for let opt of opts {
        if opt.name != "caseInsensitive" {
            continue;
        }
        if let Ident(v) = &opt.value {
            return Option::<bool>::Some(*v == "true");
        }
    }
    return null;
}

pub fn resolve_ci(grammar_opts: &List<GrammarOption>, rule_opts: &List<GrammarOption>) -> bool {
    if let Some(b) = lookup_ci_option(rule_opts) {
        return b;
    }
    if let Some(b) = lookup_ci_option(grammar_opts) {
        return b;
    }
    return false;
}

/// Expand one char range into the set of ranges needed to match it
/// case-insensitively. The original range is always included. When the range
/// intersects ASCII letters, the opposing-case sub-range is appended.
/// Non-letter chars are not folded (ANTLR4 only does one-length transforms).
pub fn fold_range_ci(start: char, end: char, out: &mut List<CharRange>) {
    out.push(CharRange { start, end });
    if start <= 'z' && end >= 'a' {
        let lo = if start < 'a' { 'a' } else { start };
        let hi = if end > 'z' { 'z' } else { end };
        out.push(CharRange {
            start: lo.to_ascii_uppercase(),
            end: hi.to_ascii_uppercase(),
        });
    }
    if start <= 'Z' && end >= 'A' {
        let lo = if start < 'A' { 'A' } else { start };
        let hi = if end > 'Z' { 'Z' } else { end };
        out.push(CharRange {
            start: lo.to_ascii_lowercase(),
            end: hi.to_ascii_lowercase(),
        });
    }
}

fn seen_contains(seen: &List<String>, text: &String) -> bool {
    for let item of seen {
        if *item == *text {
            return true;
        }
    }
    return false;
}

pub fn collect_literal_tokens(parser_rules: &List<ParserRule>) -> List<LitToken> {
    let mut seen: List<String> = [];
    let mut result: List<LitToken> = [];
    for let rule of parser_rules {
        for let alt of rule.alternatives {
            collect_lits_from_elements(&alt.elements, &mut seen, &mut result);
        }
    }
    return result;
}

/// Case-folding in `literal_const_name` (lowercase → uppercase) can map two
/// distinct literals (`'and'`, `'AND'`) onto the same base const name. That
/// would emit duplicate globals / `try_lit_*` fns / `token_kind_name` arms and
/// break compilation, so the second and later occurrences get a numeric
/// suffix (`TK_LIT_AND`, `TK_LIT_AND_2`, …). Deterministic in source order.
fn disambiguate_const_name(base: &String, result: &List<LitToken>) -> String {
    let mut candidate = *base;
    let mut n = 2;
    while const_name_taken(result, &candidate) {
        candidate = `${*base}_${n}`;
        n += 1;
    }
    return candidate;
}

fn const_name_taken(result: &List<LitToken>, name: &String) -> bool {
    for let lit of result {
        if lit.const_name == *name {
            return true;
        }
    }
    return false;
}

fn collect_lits_from_elements(elements: &List<Element>, seen: &mut List<String>, result: &mut List<LitToken>) {
    for let elem of elements {
        collect_lits_from_element(elem, seen, result);
    }
}

fn collect_lits_from_element(elem: &Element, seen: &mut List<String>, result: &mut List<LitToken>) {
    match *elem {
        Literal(l) => {
            if !seen_contains(seen, &l.text) {
                seen.push(l.text);
                let base = literal_const_name(&l.text);
                let const_name = disambiguate_const_name(&base, result);
                result.push(LitToken { text: l.text, const_name });
            }
        },
        Repeat(rep) => collect_lits_from_element(&rep.element, seen, result),
        Group(g) => {
            for let alt of &g.alternatives {
                collect_lits_from_elements(&alt.elements, seen, result);
            }
        },
        Label(lab) => collect_lits_from_element(&lab.element, seen, result),
        // `~ X` is a set-complement transformer. The literal `'x'` inside
        // still needs to be hoisted to an anonymous lexer token so the
        // runtime `match_not([TK_LIT_X])` call resolves. Without this arm
        // any parser-rule `~'x'` / `~('x'|'y')` emits a reference to an
        // undefined TK_LIT_X (Sets/ParserNotToken, Sets/ParserNotSet, …).
        Not(n) => collect_lits_from_element(&n.element, seen, result),
        _ => (),
    }
}

/// One position in the canonical token numbering: slot `i` of
/// `token_slot_order` is the token whose kind id is `i`.
pub variant TokenSlot {
    /// Index into the lexer-rule list (non-fragment).
    Rule(i32),
    /// The `TK_EOF` sentinel.
    Eof,
    /// The `TK_ERROR` no-match sentinel (absent when a user rule named
    /// `ERROR` claims the identifier).
    Error,
    /// Index into the literal-token list.
    Lit(i32),
}

/// The canonical token numbering, shared by every emitter that indexes by
/// token kind: `gen_token_constants` (the `TK_*` globals), the highlight
/// `defaults` capture table (indexed `defaults[kind]` at runtime), and the
/// ATN builder's `build_token_kinds`. Keeping them on one source prevents
/// the tables from drifting out of alignment.
///
/// Order mirrors ANTLR4's SemanticPipeline.assignLexerTokenTypes:
/// non-fragment rules WITHOUT a `more` / `type(...)` command get the low
/// token types in declaration order, then the `more` / `type` rules are
/// numbered (a rule that always `more`s never produces a parser-visible
/// token, so ANTLR4 pushes its type to the back). Then `TK_EOF`, then the
/// `TK_ERROR` sentinel — unless a user rule named `ERROR` claims the same
/// identifier (`ERROR : .;` is itself a catch-all aligned with the
/// sentinel's role; `EOF` stays uncollapsed as an ANTLR4-reserved
/// built-in). Literal tokens close the numbering.
pub fn token_slot_order(lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) -> List<TokenSlot> {
    let mut slots: List<TokenSlot> = [];
    for let want_deferred of [false, true] {
        for let mut i = 0; i < lexer_rules.len(); i += 1 {
            let rule = &lexer_rules[i];
            if rule.is_fragment {
                continue;
            }
            let deferred = rule.more || rule.type_override matches { Some(_) };
            if deferred != want_deferred {
                continue;
            }
            slots.push(TokenSlot::Rule(i));
        }
    }
    slots.push(TokenSlot::Eof);
    if !rule_name_exists(lexer_rules, &"ERROR") {
        slots.push(TokenSlot::Error);
    }
    for let mut i = 0; i < lit_tokens.len(); i += 1 {
        slots.push(TokenSlot::Lit(i));
    }
    return slots;
}

pub fn gen_token_constants(w: &mut CodeWriter, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) {
    let slots = token_slot_order(lexer_rules, lit_tokens);
    let mut idx = 0;
    for let slot of &slots {
        let init = `${idx}`;
        match *slot {
            Rule(ri) => {
                let rule = &lexer_rules[ri];
                let name = `TK_${rule.name}`;
                let mut g = GlobalSpec::new(&name, "i32", &init, Vis::Pub);
                if rule.is_virtual {
                    g.set_trailing_comment(&"virtual");
                }
                g.emit(w);
            },
            Eof => GlobalSpec::new("TK_EOF", "i32", &init, Vis::Pub).emit(w),
            Error => GlobalSpec::new("TK_ERROR", "i32", &init, Vis::Pub).emit(w),
            Lit(li) => GlobalSpec::new(&lit_tokens[li].const_name, "i32", &init, Vis::Pub).emit(w),
        }
        idx += 1;
    }
    // `-> type(N)` (numeric) assigns the emitted token an explicit ANTLR4
    // type id of exactly N (vendor/antlr4/doc/lexer-rules.md). The lexer
    // body emits `TK_<N>`; we emit the matching global here with value
    // `N - 1` so `to_lexer_string`'s `kind + 1` remap round-trips to N.
    // `N == 0` would yield a negative kind clashing with `best_end = -1`
    // and is reserved as INVALID_TYPE upstream; skip it.
    let mut emitted_numeric: List<i32> = [];
    for let rule of lexer_rules {
        if rule.is_fragment {
            continue;
        }
        if let Some(target) = &rule.type_override {
            if let Some(n) = parse_token_type_numeric(target) {
                if n < 1 {
                    continue;
                }
                if rule_name_exists(lexer_rules, &`${n}`) {
                    continue;
                }
                if emitted_numeric.contains(&n) {
                    continue;
                }
                GlobalSpec::new(&`TK_${n}`, "i32", &`${n - 1}`, Vis::Pub).emit(w);
                emitted_numeric.push(n);
            }
        }
    }
    w.blank();
}

/// Returns `Some(n)` when `s` is a non-negative base-10 integer that fits in
/// `i32` (the runtime token-kind type). Anything else — a token name, an
/// overflowing value, an empty string — returns `None` so the caller can
/// defer to the regular `TK_<name>` path.
fn parse_token_type_numeric(s: &String) -> Option<i32> {
    if s.is_empty() {
        return null;
    }
    let mut acc: i64 = 0;
    for let c of s.chars() {
        if c < '0' || c > '9' {
            return null;
        }
        acc = acc * 10 + (c as i32 - '0' as i32) as i64;
        if acc > i32::MAX as i64 {
            return null;
        }
    }
    return Option::<i32>::Some(acc as i32);
}

fn rule_name_exists(lexer_rules: &List<LexerRule>, name: &String) -> bool {
    for let rule of lexer_rules {
        if !rule.is_fragment && rule.name == *name {
            return true;
        }
    }
    return false;
}

pub fn gen_lexer(
    w: &mut CodeWriter,
    grammar: &Grammar,
    lit_tokens: &List<LitToken>,
    atn_class: &TreeMap<String, i32>,
    members: &MemberDecls,
    has_members: bool,
    sc_name: &String,
    sc_ops: &List<SuperOp>,
) {
    let empty_opts: List<GrammarOption> = [];
    let grammar_ci = resolve_ci(&grammar.options, &empty_opts);
    let keywords = collect_keyword_rules(&grammar.lexer_rules, &grammar.options);
    // A superClass base is wired independently of the action language.
    let ea = lexer_grammar_executes_actions(grammar) || !sc_name.is_empty();
    let act_rule_names = executed_action_rule_names(grammar);
    let has_actions = !act_rule_names.is_empty();
    let uses_modes = has_modes(&grammar.mode_names);
    if !sc_name.is_empty() {
        gen_super_interface(w, sc_name, sc_ops);
    }
    gen_lexer_struct(w, members, has_actions, uses_modes);
    if has_actions {
        if uses_modes {
            gen_mode_constants(w, &grammar.mode_names);
        }
        gen_lexer_apply_fns(w, grammar, has_members);
    }
    gen_lexer_match_fns(
        w,
        &grammar.lexer_rules,
        &keywords,
        lit_tokens,
        &grammar.options,
        atn_class,
        ea,
        has_members,
        sc_name,
    );
    gen_literal_match_fns(w, lit_tokens, grammar_ci, has_members);
    gen_keyword_classifier_fn(w, &keywords);
    gen_tokenize_fn(
        w,
        &grammar.lexer_rules,
        lit_tokens,
        &grammar.mode_names,
        &keywords,
        &grammar.options,
        &act_rule_names,
        has_members,
        sc_name,
    );
    gen_token_kind_name_fn(w, &grammar.lexer_rules, lit_tokens);
}

fn gen_lexer_struct(w: &mut CodeWriter, members: &MemberDecls, has_actions: bool, uses_modes: bool) {
    let mut s = StructSpec::new("Lexer");
    s.add_field(&"chars", &"List<char>");
    s.add_field(&"pos", &"i32");
    for let mf of &members.fields {
        s.add_field_default(&mf.name, &mf.ty, &mf.init);
    }
    if has_actions {
        s.add_field_default(&"act_output", &"String", &"\"\"");
        s.add_field_default(&"act_type", &"i32", &"-1");
        s.add_field_default(&"act_channel", &"i32", &"-1");
        s.add_field_default(&"act_skip", &"bool", &"false");
        s.add_field_default(&"act_more", &"bool", &"false");
        if uses_modes {
            s.add_field_default(&"act_push_mode", &"i32", &"-1");
            s.add_field_default(&"act_pop_mode", &"bool", &"false");
            s.add_field_default(&"act_set_mode", &"i32", &"-1");
        }
    }
    s.emit(w);
    w.blank();

    ImplSpec::new("Lexer").emit_begin(w);

    let mut f = FnSpec::new("new");
    f.add_param(&"input", &"&String");
    f.set_return_type(&"Lexer");
    f.emit_begin(w);
    w.line(&"return Lexer { chars: input.to_chars(), pos: 0 };");
    w.end();
    w.blank();

    let mut f2 = FnSpec::new("at_end");
    f2.set_receiver(&"&self");
    f2.set_return_type(&"bool");
    f2.emit_begin(w);
    w.line(&"return self.pos >= self.chars.len();");
    w.end();
    w.blank();

    let mut f3 = FnSpec::new("slice");
    f3.set_receiver(&"&self");
    f3.add_param(&"start", &"i32");
    f3.add_param(&"end", &"i32");
    f3.set_return_type(&"LexerSlice");
    f3.add_stores(&"self");
    f3.emit_begin(w);
    w.line(&"return LexerSlice::new(&self.chars, start, end);");
    w.end();

    if has_actions {
        gen_lexer_action_methods(w, uses_modes);
    }

    for let m of &members.methods {
        w.blank();
        w.line(m);
    }

    w.end();  // impl
    w.blank();
}

fn gen_lexer_action_methods(w: &mut CodeWriter, uses_modes: bool) {
    w.blank();
    // Deliberately outside `reset_actions`: the sink is the whole run's output,
    // not one token's.
    let mut fe = FnSpec::new("emit");
    fe.set_receiver(&"&mut self");
    fe.add_param(&"s", &"String");
    fe.emit_begin(w);
    w.line(&"self.act_output.push_str(&s);");
    w.end();
    w.blank();

    let mut fr = FnSpec::new("reset_actions");
    fr.set_receiver(&"&mut self");
    fr.emit_begin(w);
    w.line(&"self.act_type = -1;");
    w.line(&"self.act_channel = -1;");
    w.line(&"self.act_skip = false;");
    w.line(&"self.act_more = false;");
    if uses_modes {
        w.line(&"self.act_push_mode = -1;");
        w.line(&"self.act_pop_mode = false;");
        w.line(&"self.act_set_mode = -1;");
    }
    w.end();
    w.blank();

    lexer_setter(w, &"set_type", &"t", &"act_type");
    w.blank();
    lexer_setter(w, &"set_channel", &"c", &"act_channel");
    w.blank();
    lexer_flag(w, &"skip", &"act_skip");
    w.blank();
    lexer_flag(w, &"more", &"act_more");

    if uses_modes {
        w.blank();
        lexer_setter(w, &"push_mode", &"m", &"act_push_mode");
        w.blank();
        lexer_flag(w, &"pop_mode", &"act_pop_mode");
        w.blank();
        lexer_setter(w, &"set_mode", &"m", &"act_set_mode");
    }
}

fn lexer_setter(w: &mut CodeWriter, name: &String, arg: &String, field: &String) {
    let mut f = FnSpec::new(name);
    f.set_receiver(&"&mut self");
    f.add_param(arg, &"i32");
    f.emit_begin(w);
    w.line(&`self.${*field} = ${*arg};`);
    w.end();
}

fn lexer_flag(w: &mut CodeWriter, name: &String, field: &String) {
    let mut f = FnSpec::new(name);
    f.set_receiver(&"&mut self");
    f.emit_begin(w);
    w.line(&`self.${*field} = true;`);
    w.end();
}

fn gen_lexer_match_fns(
    w: &mut CodeWriter,
    lexer_rules: &List<LexerRule>,
    keywords: &List<KeywordInfo>,
    lit_tokens: &List<LitToken>,
    grammar_opts: &List<GrammarOption>,
    atn_class: &TreeMap<String, i32>,
    ea: bool,
    hm: bool,
    sc_name: &String,
) {
    let empty_opts: List<GrammarOption> = [];
    let grammar_ci = resolve_ci(grammar_opts, &empty_opts);
    for let rule of lexer_rules {
        if rule.is_virtual {
            // Virtual token (from `tokens { }` block): no match function
            // needed — the tokenizer can never produce it directly. Only
            // `type(X)` rewrites or actions can emit one.
        } else if !rule.is_fragment {
            if !is_keyword_rule_name(&rule.name, keywords)
                && !is_literal_duplicate(rule, lit_tokens, grammar_opts, grammar_ci) {
                gen_lexer_match_fn(w, rule, lexer_rules, grammar_opts, atn_class, ea, hm, sc_name);
            }
        } else if fragment_is_recursive(rule, lexer_rules) {
            // A recursive fragment needs its own `try_*` matcher (non-
            // recursive fragments are inlined at each use site). `gen_lexer_match_fn`
            // resolves case-insensitivity from `resolve_ci(grammar_opts,
            // &rule.options)`, so a rule-level `options { caseInsensitive=... }`
            // on the fragment overrides the grammar-level flag.
            gen_lexer_match_fn(w, rule, lexer_rules, grammar_opts, atn_class, ea, hm, sc_name);
        }
    }
}

fn fragment_is_recursive(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    let mut visited: List<String> = [];
    return fragment_refs_self(&rule.name, &rule.body, all_rules, &mut visited);
}

fn fragment_refs_self(
    target: &String,
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    visited: &mut List<String>,
) -> bool {
    for let alt of alts {
        for let elem of &alt.elements {
            if fragment_elem_refs_self(target, elem, all_rules, visited) {
                return true;
            }
        }
    }
    return false;
}

fn fragment_elem_refs_self(
    target: &String,
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    visited: &mut List<String>,
) -> bool {
    match *elem {
        RuleRef(name) => {
            if name == *target {
                return true;
            }
            if visited.iter().any(|v: &String| *v == name) {
                return false;
            }
            visited.push(name);
            let frag = find_fragment(all_rules, &name);
            if let Some(f) = frag {
                return fragment_refs_self(target, &f.body, all_rules, visited);
            }
            return false;
        },
        Group(alts) => {
            return fragment_refs_self(target, &alts, all_rules, visited);
        },
        Repeat(rep) => {
            return fragment_elem_refs_self(target, &rep.element, all_rules, visited);
        },
        Not(not_elem) => {
            return fragment_elem_refs_self(target, &not_elem.element, all_rules, visited);
        },
        _ => {
            return false;
        },
    }
}

/// Generated scanner-function name for the lexer rule called `name`.
/// The rule name is used verbatim (case-preserved): lexer rule names are
/// g4 identifiers, so `try_<name>` is always a valid Wado identifier, and
/// preserving case keeps distinct rules distinct (`ID` vs `Id` →
/// `try_ID` / `try_Id`) without any collision-resolution bookkeeping.
/// Single source of truth so every emit site agrees on the name.
pub fn lexer_try_fn_name(name: &String) -> String {
    return `try_${*name}`;
}

/// Whether some lexer rule reaches `rule` through a generated `try_` call rather
/// than inlining it — a non-fragment rule or a recursive fragment. Such a fn is
/// entered with the caller's suffix still to consume, so its body alternation
/// must not take the maximal-munch emit. An inlined fragment is safe: the inline
/// path carries the caller's tail position with it.
fn lexer_rule_is_called(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    if rule.is_fragment && !fragment_is_recursive(rule, all_rules) {
        return false;
    }
    for let other of all_rules {
        for let alt of &other.body {
            if lexer_alt_refs_rule(alt, &rule.name) {
                return true;
            }
        }
    }
    return false;
}

fn lexer_alt_refs_rule(alt: &LexerAlternative, name: &String) -> bool {
    for let e of &alt.elements {
        if lexer_elem_refs_rule(e, name) {
            return true;
        }
    }
    return false;
}

fn lexer_elem_refs_rule(elem: &LexerElement, name: &String) -> bool {
    return match *elem {
        RuleRef(n) => n == *name,
        Group(alts) => {
            for let a of alts {
                if lexer_alt_refs_rule(&a, name) {
                    return true;
                }
            }
            false;
        },
        Repeat(rep) => lexer_elem_refs_rule(&rep.element, name),
        Not(n) => lexer_elem_refs_rule(&n.element, name),
        _ => false,
    };
}

fn gen_lexer_match_fn(
    w: &mut CodeWriter,
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    atn_class: &TreeMap<String, i32>,
    ea: bool,
    hm: bool,
    sc_name: &String,
) {
    let fn_name = lexer_try_fn_name(&rule.name);
    let ci = resolve_ci(grammar_opts, &rule.options);
    gen_visibility_comment(w, &rule.visibility);
    let mut f = FnSpec::new(&fn_name);
    if hm {
        f.add_param(&"lx", &"&Lexer");
    } else {
        f.add_param(&"chars", &"&List<char>");
    }
    f.add_param(&"start", &"i32");
    f.set_return_type(&"i32");
    // The `Foo::op(LexerView { chars, .. })` call carries the effect and the
    // view literal stores the char-stream ref, so declare both `with Foo` and
    // `stores` for that ref.
    if !sc_name.is_empty() && lexer_rule_calls_super(rule, all_rules, sc_name) {
        f.add_effect(sc_name);
        if hm {
            f.add_stores(&"lx");
        } else {
            f.add_stores(&"chars");
        }
    }
    f.emit_begin(w);
    if hm {
        w.line(&"let chars = &lx.chars;");
    }
    // ATN-class rule (recursive non-greedy body): the static single-pass
    // emitter cannot decide it, so delegate to the runtime lexer simulator.
    if let Some(idx) = atn_class.get(rule.name) {
        w.line(&`return latn_match(&LATN_SIM, ${idx}, chars, start);`);
        w.end();
        w.blank();
        return;
    }
    w.line(&"let mut pos = start;");
    let tail = !lexer_rule_is_called(rule, all_rules);
    if rule.body.len() == 1 {
        // gen_lexer_alt_seq places the alt's predicates; a false one returns -1
        // so the tokenizer tries the next rule.
        gen_lexer_alt_seq(w, &rule.body[0], all_rules, &"return -1", ci, ea, hm, tail, false);
        w.line(&"return pos;");
    } else {
        gen_lexer_alts(w, &rule.body, all_rules, &"return -1", ci, ea, hm, tail, false);
        w.line(&"return pos;");
    }
    w.end();
    w.blank();
}

/// Emit each semantic predicate at position `before` as a guard
/// (`if !(cond) { <fail_action>; }`) in a lexer rule's match fn. The condition
/// runs through the identity translator (`translate_lexer_predicate`), resolving
/// lexer `$`-attributes (`$text`) against the match fn's `chars` / `start` /
/// `pos`; an unresolvable reference is a loud codegen error. `fail_action` is
/// `return -1` for a single-alt rule and `break <label>` inside a multi-alt
/// rule / group / fragment (a false predicate falls through to the next alt).
/// `gen_lexer_alt_seq` drives this over every `before_index` (alt-initial, mid,
/// trailing), so predicates at any position in an alt are placed.
fn gen_lexer_rule_predicates(w: &mut CodeWriter, actions: &List<AltAction>, before: i32, ea: bool, fail_action: &String) {
    if !ea {
        return;
    }
    for let a of actions {
        if a.before_index != before {
            continue;
        }
        if a.kind matches { Predicate } {
            let cond = match translate_lexer_predicate(&a.source.text) {
                Ok(c) => c,
                Err(e) => panic(`lexer predicate: ${e}`),
            };
            w.line(&`if !(${cond}) \{ ${fail_action}; \}`);
        }
    }
}

/// Whether codegen runs `{ ... }` action bodies for this grammar's lexer at
/// all. A `language = Java` lexer qualifies because codegen stages its bodies
/// into Wado before emit (`rewrite_lexer_java_bodies`), which carves out a
/// `superClass` grammar.
pub fn lexer_grammar_executes_actions(grammar: &Grammar) -> bool {
    return grammar.action_language matches { Wado } || action_language_is_emittable(grammar);
}

/// Whether this rule's top-level actions run: an executing grammar, a real
/// (non-fragment, non-virtual) rule. Both single-alt and multi-alt rules run
/// their alternatives' top-level `{ ... }` actions (a multi-alt rule re-matches
/// to find the winning alternative in `apply_<rule>_actions`). Fragments and
/// actions nested inside an element still warn. (A single-literal rule folded
/// into the keyword classifier does not set `best_act`, so its action does not
/// run — see the known limitations in `action.md`.)
pub fn lexer_rule_executes_actions(grammar: &Grammar, rule: &LexerRule) -> bool {
    return lexer_grammar_executes_actions(grammar) && !rule.is_fragment && !rule.is_virtual;
}

/// Whether the action replay can interleave `alt`'s actions with its match, so
/// each runs at the cursor it was written at. A `Group` is fine — the replay
/// re-selects the arm that won. A `Repeat` is not: it matches an unknown number
/// of times, and the non-greedy / lookahead-aware emitters restructure the
/// sequence around it, so an alt carrying one keeps the flat emit.
pub fn lexer_alt_replayable(alt: &LexerAlternative, all_rules: &List<LexerRule>) -> bool {
    for let e of &alt.elements {
        if !lexer_element_replayable(e, all_rules) {
            return false;
        }
    }
    return true;
}

fn lexer_element_replayable(elem: &LexerElement, all_rules: &List<LexerRule>) -> bool {
    return match *elem {
        Literal(_) | CharRange(_) | CharClass(_) | AnyChar => true,
        Repeat(_) => false,
        Not(n) => lexer_element_replayable(&n.element, all_rules),
        Group(alts) => {
            for let a of alts {
                if !lexer_alt_replayable(&a, all_rules) {
                    return false;
                }
            }
            true;
        },
        RuleRef(name) => match find_fragment(all_rules, &name) {
            Some(f) => {
                if fragment_is_recursive(f, all_rules) {
                    return true;
                }
                for let a of &f.body {
                    if !lexer_alt_replayable(a, all_rules) {
                        return false;
                    }
                }
                true;
            },
            None => true,
        },
    };
}

pub fn lexer_rule_replayable(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    for let alt of &rule.body {
        if !lexer_alt_replayable(alt, all_rules) {
            return false;
        }
    }
    return true;
}

/// The action ids codegen runs for `rule`: every alternative's top-level
/// `{ ... }` actions, plus — when the rule replays — the actions nested in a
/// `Group`, which the replay reaches. Single source of truth shared by the
/// apply-fn emit and `warn_unhandled_lexer_actions`, so a run action and a
/// warned-unhandled action cannot disagree.
fn lexer_rule_executed_action_ids(grammar: &Grammar, rule: &LexerRule, out: &mut List<i32>) {
    if !lexer_rule_executes_actions(grammar, rule) {
        return;
    }
    let replays = lexer_rule_replayable(rule, &grammar.lexer_rules);
    for let alt of &rule.body {
        collect_lexer_run_action_ids(alt, replays, &grammar.lexer_rules, out);
    }
}

/// The action ids that run for `alt`: its own top-level actions, and — under a
/// replay — those of everything the emit inlines below it (a `Group`'s arms and
/// a non-recursive fragment's body, both of which the replay walks into).
fn collect_lexer_run_action_ids(alt: &LexerAlternative, replays: bool, all_rules: &List<LexerRule>, out: &mut List<i32>) {
    for let a of &alt.actions {
        if a.kind matches { Action } {
            out.push(a.source.action_id);
        }
    }
    if !replays {
        return;
    }
    for let e of &alt.elements {
        for let inner of &inlined_alts_of(e, all_rules) {
            collect_lexer_run_action_ids(inner, true, all_rules, out);
        }
    }
}

/// The alternatives `elem` inlines into its enclosing sequence: a `Group`'s
/// arms, or a non-recursive fragment's body. A `Repeat` / `Not` / rule call
/// keeps its contents to itself as far as action placement is concerned.
fn inlined_alts_of(elem: &LexerElement, all_rules: &List<LexerRule>) -> List<LexerAlternative> {
    return match *elem {
        Group(alts) => alts,
        RuleRef(name) => match find_fragment(all_rules, &name) {
            Some(f) => {
                if fragment_is_recursive(f, all_rules) {
                    return [];
                }
                f.body;
            },
            None => [],
        },
        _ => [],
    };
}

/// Every action id codegen runs anywhere in the grammar's lexer. A fragment's
/// actions run through the rules that inline it, not through the fragment's own
/// entry, so the warn pass has to ask the whole grammar rather than one rule.
pub fn lexer_grammar_run_action_ids(grammar: &Grammar) -> List<i32> {
    let mut out: List<i32> = [];
    for let rule of &grammar.lexer_rules {
        lexer_rule_executed_action_ids(grammar, rule, &mut out);
    }
    return out;
}

/// Names of the lexer rules whose top-level actions codegen runs, in grammar
/// order. A rule's position in this list is its `act_index` — the tournament
/// records it in `best_act`, and the commit dispatches `apply_<name>_actions`.
/// Empty keeps every actionless / predicate-only grammar byte-identical (no
/// action-effect surface on `Lexer`, no `apply_*` fn, no `best_act` wiring).
pub fn executed_action_rule_names(grammar: &Grammar) -> List<String> {
    let mut names: List<String> = [];
    for let rule of &grammar.lexer_rules {
        let mut ids: List<i32> = [];
        lexer_rule_executed_action_ids(grammar, rule, &mut ids);
        if ids.len() > 0 {
            names.push(rule.name);
        }
    }
    return names;
}

/// Emit a `MODE_<NAME>` constant per lexer mode so a `language = Wado` action
/// can name a target mode (`lx.push_mode(MODE_TAG)`) instead of a bare index.
/// Only emitted for a `mode` grammar that runs actions.
fn gen_mode_constants(w: &mut CodeWriter, mode_names: &List<String>) {
    for let mut i = 0; i < mode_names.len(); i += 1 {
        GlobalSpec::new(&`MODE_${mode_names[i]}`, "i32", &`${i}`, Vis::Pub).emit(w);
    }
    w.blank();
}

/// Emit the replay fn per executing rule: `apply_<rule>_actions(lx, start, end)`,
/// called post-tournament for the winner only, so a losing candidate's actions
/// never run. Bodies are identity-translated.
///
/// A replayable rule (`lexer_rule_replayable`) re-runs its own match with the
/// actions dropped in at their cursors. One the replay cannot follow keeps the
/// flat emit: every alternative's top-level actions at the end of the match,
/// selected by a match-only `winning_alt_<rule>` helper.
fn gen_lexer_apply_fns(w: &mut CodeWriter, grammar: &Grammar, has_members: bool) {
    for let rule of &grammar.lexer_rules {
        let mut ids: List<i32> = [];
        lexer_rule_executed_action_ids(grammar, rule, &mut ids);
        if ids.is_empty() {
            continue;
        }
        let ci = resolve_ci(&grammar.options, &rule.options);
        let replays = lexer_rule_replayable(rule, &grammar.lexer_rules);
        if !replays && rule.body.len() > 1 {
            gen_lexer_winning_alt_fn(w, rule, &grammar.lexer_rules, ci, has_members);
        }
        let mut f = FnSpec::new(&apply_fn_name(&rule.name));
        f.add_param(&"lx", &"&mut Lexer");
        f.add_param(&"start", &"i32");
        f.add_param(&"end", &"i32");
        f.emit_begin(w);
        if replays {
            gen_lexer_apply_replay_body(w, rule, &grammar.lexer_rules, ci, has_members);
        } else {
            gen_lexer_apply_flat_body(w, rule, ci, has_members);
        }
        w.end();
        w.blank();
    }
}

/// The replay body: `pos` becomes a live cursor over the rule's own match, and
/// each action is emitted where it sits in that match.
fn gen_lexer_apply_replay_body(
    w: &mut CodeWriter,
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    ci: bool,
    has_members: bool,
) {
    w.line(&"let chars = &lx.chars;");
    w.line(&"let mut pos = start;");
    // `ea` here only re-selects the arm the match took; a single-alt body has
    // nothing to select, so it never re-evaluates a predicate.
    let tail = !lexer_rule_is_called(rule, all_rules);
    if rule.body.len() == 1 {
        gen_lexer_alt_seq(w, &rule.body[0], all_rules, &"return", ci, false, has_members, tail, true);
    } else {
        gen_lexer_alts(w, &rule.body, all_rules, &"return", ci, true, has_members, tail, true);
    }
}

fn gen_lexer_apply_flat_body(w: &mut CodeWriter, rule: &LexerRule, ci: bool, has_members: bool) {
    if apply_body_reads_chars(rule, has_members) {
        w.line(&"let chars = &lx.chars;");
    }
    if apply_body_reads_cursor(rule) {
        w.line(&"let pos = end;");
    }
    if rule.body.len() == 1 {
        gen_lexer_alt_action_stmts(w, &rule.body[0]);
        return;
    }
    let wa_arg = if has_members { "lx" } else { "chars" };
    w.line(&`let _walt = winning_alt_${rule.name}(${wa_arg}, start);`);
    let mut first = true;
    for let mut ai = 0; ai < rule.body.len(); ai += 1 {
        if !lexer_alt_has_action(&rule.body[ai]) {
            continue;
        }
        if first {
            w.begin(&`if _walt == ${ai}`);
            first = false;
        } else {
            w.else_begin(&`else if _walt == ${ai}`);
        }
        gen_lexer_alt_action_stmts(w, &rule.body[ai]);
    }
    if !first {
        w.end();
    }
}

/// Whether any of `rule`'s executed action bodies reads the match cursor.
/// `$text` is the un-staged identity form; `pos` covers a body already staged
/// into Wado, and a hand-written Wado body that names the cursor directly.
fn apply_body_reads_cursor(rule: &LexerRule) -> bool {
    for let alt of &rule.body {
        for let a of &alt.actions {
            if a.kind matches { Action } && (a.source.text.contains("$text") || a.source.text.contains("pos")) {
                return true;
            }
        }
    }
    return false;
}

fn apply_body_reads_chars(rule: &LexerRule, has_members: bool) -> bool {
    if rule.body.len() > 1 && !has_members {
        return true;
    }
    for let alt of &rule.body {
        for let a of &alt.actions {
            if a.kind matches { Action } && (a.source.text.contains("$text") || a.source.text.contains("chars")) {
                return true;
            }
        }
    }
    return false;
}

/// Whether an alt carries a top-level `{ ... }` action (not a predicate).
fn lexer_alt_has_action(alt: &LexerAlternative) -> bool {
    for let a of &alt.actions {
        if a.kind matches { Action } {
            return true;
        }
    }
    return false;
}

/// Emit an alt's top-level actions (identity-translated) as statements.
fn gen_lexer_alt_action_stmts(w: &mut CodeWriter, alt: &LexerAlternative) {
    for let a of &alt.actions {
        if !a.kind matches { Action } {
            continue;
        }
        let body = match translate_lexer_action(&a.source.text) {
            Ok(b) => b,
            Err(e) => panic(`lexer action: ${e}`),
        };
        emit_lexer_action_stmt(w, &body);
    }
}

/// Emit `winning_alt_<rule>(chars, start) -> i32`: a match-only re-scan that
/// returns the index of the alternative `gen_lexer_alts` picked from `start`, or
/// -1. The selection mirrors `gen_lexer_alts` exactly, so the actions the caller
/// then replays belong to the alternative that actually matched. No side
/// effects — the caller runs the actions.
fn gen_lexer_winning_alt_fn(
    w: &mut CodeWriter,
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    ci: bool,
    has_members: bool,
) {
    let mut f = FnSpec::new(&`winning_alt_${rule.name}`);
    if has_members {
        f.add_param(&"lx", &"&Lexer");
    } else {
        f.add_param(&"chars", &"&List<char>");
    }
    f.add_param(&"start", &"i32");
    f.set_return_type(&"i32");
    f.emit_begin(w);
    if has_members {
        w.line(&"let chars = &lx.chars;");
    }
    w.line(&"let mut pos = start;");
    let longest = lexer_rule_body_prefers_longest(rule, all_rules);
    if longest {
        w.line(&"let mut best_end = -1;");
        w.line(&"let mut best_alt = -1;");
    }
    for let mut ai = 0; ai < rule.body.len(); ai += 1 {
        let label = `walt_${ai}`;
        w.begin(&`${label}:`);
        w.line(&"pos = start;");
        gen_lexer_alt_seq(w, &rule.body[ai], all_rules, &`break ${label}`, ci, true, has_members, longest, false);
        if longest {
            w.line(&`if pos > best_end \{ best_end = pos; best_alt = ${ai}; \}`);
        } else {
            w.line(&`return ${ai};`);
        }
        w.end();
    }
    if longest {
        w.line(&"return best_alt;");
    } else {
        w.line(&"return -1;");
    }
    w.end();
    w.blank();
}

/// Emit a translated lexer-action body as a statement. The identity translator
/// hands back a Wado expression/statement; normalize the trailing separator so
/// a body written with or without `;` yields exactly one statement.
fn emit_lexer_action_stmt(w: &mut CodeWriter, body: &String) {
    let trimmed = body.trim();
    if trimmed.ends_with(";") || trimmed.ends_with("}") {
        w.line(&trimmed);
    } else {
        w.line(&`${trimmed};`);
    }
}

fn apply_fn_name(rule_name: &String) -> String {
    return `apply_${*rule_name}_actions`;
}

/// Emit the post-tournament replay dispatch: for the winning rule (`best_act`),
/// reset the `Lexer`'s effect latches, run its `apply_<rule>_actions`, then fold
/// the latched effects into the tournament outcome. Only reached with
/// `best_act >= 0`, i.e. the winner runs actions.
fn gen_lexer_action_replay(w: &mut CodeWriter, act_rule_names: &List<String>, use_modes: bool, has_set_mode_rules: bool) {
    w.begin(&"if best_act >= 0");
    w.line(&"lexer.reset_actions();");
    for let mut i = 0; i < act_rule_names.len(); i += 1 {
        let call = `${apply_fn_name(&act_rule_names[i])}(&mut lexer, start, best_end);`;
        if i == 0 {
            w.begin(&`if best_act == ${i}`);
        } else {
            w.else_begin(&`else if best_act == ${i}`);
        }
        w.line(&call);
    }
    w.end();
    // Fold the latched effects into the tournament outcome. `best_channel` and
    // `best_more` exist because `has_actions` forced their machinery on;
    // `best_act_skip` feeds the `is_skip` decision below. An untouched
    // `act_type` / `act_channel` (<0) leaves the tournament value in place.
    w.line(&"if lexer.act_type >= 0 { best_kind = lexer.act_type; }");
    w.line(&"if lexer.act_channel >= 0 { best_channel = lexer.act_channel; }");
    w.line(&"if lexer.act_more { best_more = true; }");
    w.line(&"if lexer.act_skip { best_act_skip = true; }");
    if use_modes {
        w.line(&"if lexer.act_push_mode >= 0 { best_push_mode = lexer.act_push_mode; }");
        w.line(&"if lexer.act_pop_mode { best_pop_mode = true; }");
        if has_set_mode_rules {
            w.line(&"if lexer.act_set_mode >= 0 { best_set_mode = lexer.act_set_mode; }");
        }
    }
    w.end();
}

/// Collect the `Action`-kind ids in `alt` that codegen does not run — the exact
/// complement of `collect_lexer_run_action_ids`. `executes` is true for an alt of
/// an executing rule; `replays` is true when that rule's shape lets the replay
/// reach into a `Group`. An action under a `Repeat` (or under any element of a
/// non-replaying rule) is unhandled. Drives the loud safety net
/// (`warn_unhandled_lexer_actions` in `codegen`).
pub fn collect_unhandled_lexer_alt_action_ids(
    alt: &LexerAlternative,
    executes: bool,
    replays: bool,
    all_rules: &List<LexerRule>,
    out: &mut List<i32>,
) {
    if !executes {
        push_all_lexer_alt_action_ids(alt, out);
        return;
    }
    for let e of &alt.elements {
        let inlined = inlined_alts_of(e, all_rules);
        if replays && !inlined.is_empty() {
            for let inner of &inlined {
                collect_unhandled_lexer_alt_action_ids(inner, true, true, all_rules, out);
            }
            continue;
        }
        push_all_lexer_element_action_ids(e, out);
    }
}

fn push_all_lexer_alt_action_ids(alt: &LexerAlternative, out: &mut List<i32>) {
    for let a of &alt.actions {
        if a.kind matches { Action } {
            out.push(a.source.action_id);
        }
    }
    for let e of &alt.elements {
        push_all_lexer_element_action_ids(e, out);
    }
}

fn push_all_lexer_element_action_ids(elem: &LexerElement, out: &mut List<i32>) {
    match *elem {
        Group(alts) => {
            for let alt of &alts {
                push_all_lexer_alt_action_ids(alt, out);
            }
        },
        Repeat(rep) => push_all_lexer_element_action_ids(&rep.element, out),
        Not(n) => push_all_lexer_element_action_ids(&n.element, out),
        _ => {
        },
    }
}

fn gen_lexer_alts(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
    tail: bool,
    replay: bool,
) {
    if replay {
        gen_lexer_alts_replay(w, alts, all_rules, fail_action, ci, ea, hm, tail);
        return;
    }
    if tail && lexer_alts_prefer_longest(alts, all_rules) {
        gen_lexer_alts_longest(w, alts, all_rules, fail_action, ci, ea, hm);
        return;
    }
    let id = w.next_id();
    w.line(&`let alts_saved_${id} = pos;`);
    w.line(&`let mut alts_ok_${id} = false;`);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 {
            w.begin(&`if !alts_ok_${id}`);
        }
        let label = `alts_${id}_${i}`;
        w.begin(&`${label}:`);
        w.line(&`pos = alts_saved_${id};`);
        gen_lexer_alt_seq(w, &alts[i], all_rules, &`break ${label}`, ci, ea, hm, false, false);
        w.line(&`alts_ok_${id} = true;`);
        w.end();
    }
    for let mut i = 1; i < alts.len(); i += 1 {
        w.end();
    }
    w.line(&`if !alts_ok_${id} \{ ${fail_action}; \}`);
}

/// Maximal-munch emit for an alternation in tail position: every alternative is
/// scanned forward from the same start and the longest match wins, matching
/// ANTLR4's NFA→DFA lexer simulation (`I : ('a' | 'ab')` matches `ab`). Sound
/// without backtracking precisely because nothing follows the alternation, so
/// the alternative's length is the rule's length — an alternation with a suffix
/// keeps the first-match emit, where a longer arm could strand the suffix.
fn gen_lexer_alts_longest(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    w.line(&`let alts_saved_${id} = pos;`);
    w.line(&`let mut alts_best_${id} = -1;`);
    for let mut i = 0; i < alts.len(); i += 1 {
        let label = `alts_${id}_${i}`;
        w.begin(&`${label}:`);
        w.line(&`pos = alts_saved_${id};`);
        gen_lexer_alt_seq(w, &alts[i], all_rules, &`break ${label}`, ci, ea, hm, true, false);
        w.line(&`if pos > alts_best_${id} \{ alts_best_${id} = pos; \}`);
        w.end();
    }
    w.line(&`if alts_best_${id} < 0 \{ ${fail_action}; \}`);
    w.line(&`pos = alts_best_${id};`);
}

/// Replay an alternation: first pick the arm the match picked — scanning
/// match-only, so a losing arm's actions never run — then re-run just that arm
/// with its actions in place. Selection mirrors `gen_lexer_alts` exactly
/// (longest in tail position, first-match otherwise), so the replay lands on the
/// alternative the tournament actually matched.
fn gen_lexer_alts_replay(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
    tail: bool,
) {
    let id = w.next_id();
    let longest = tail && lexer_alts_prefer_longest(alts, all_rules);
    w.line(&`let sel_saved_${id} = pos;`);
    w.line(&`let mut sel_alt_${id} = -1;`);
    if longest {
        w.line(&`let mut sel_best_${id} = -1;`);
    }
    for let mut i = 0; i < alts.len(); i += 1 {
        if !longest && i > 0 {
            w.begin(&`if sel_alt_${id} < 0`);
        }
        let label = `sel_${id}_${i}`;
        w.begin(&`${label}:`);
        w.line(&`pos = sel_saved_${id};`);
        gen_lexer_alt_seq(w, &alts[i], all_rules, &`break ${label}`, ci, ea, hm, longest, false);
        if longest {
            w.line(&`if pos > sel_best_${id} \{ sel_best_${id} = pos; sel_alt_${id} = ${i}; \}`);
        } else {
            w.line(&`sel_alt_${id} = ${i};`);
        }
        w.end();
    }
    if !longest {
        for let mut i = 1; i < alts.len(); i += 1 {
            w.end();
        }
    }
    w.line(&`if sel_alt_${id} < 0 \{ ${*fail_action}; \}`);
    w.line(&`pos = sel_saved_${id};`);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i == 0 {
            w.begin(&`if sel_alt_${id} == ${i}`);
        } else {
            w.else_begin(&`else if sel_alt_${id} == ${i}`);
        }
        // `ea = false`: the selection pass already evaluated this arm. Running a
        // state-dependent predicate twice could reject here what it accepted
        // there, dropping the winner's actions while the token still commits.
        gen_lexer_alt_seq(w, &alts[i], all_rules, fail_action, ci, false, hm, longest, true);
    }
    w.end();
}

/// Whether a rule's own body alternation takes the maximal-munch emit. Every
/// site that has to agree on that decision — the match fn and the winning-alt
/// helper — reads it here.
fn lexer_rule_body_prefers_longest(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    return !lexer_rule_is_called(rule, all_rules) && lexer_alts_prefer_longest(&rule.body, all_rules);
}

/// Whether a tail-position alternation needs the maximal-munch emit. It does not
/// when every alternative consumes the same fixed number of chars (longest and
/// first-match coincide, so the cheaper emit stays byte-identical), nor when any
/// alternative carries a predicate anywhere below it (scanning every arm would
/// change how often a predicate is evaluated).
fn lexer_alts_prefer_longest(alts: &List<LexerAlternative>, all_rules: &List<LexerRule>) -> bool {
    if alts.len() < 2 {
        return false;
    }
    for let alt of alts {
        if lexer_alt_has_predicate_below(alt, all_rules) {
            return false;
        }
    }
    let mut common = -1;
    for let alt of alts {
        let len = lexer_alt_fixed_len(alt, all_rules);
        if let Some(n) = len {
            if common < 0 {
                common = n;
            } else if common != n {
                return true;
            }
        } else {
            return true;
        }
    }
    return false;
}

/// Whether `alt` carries a semantic predicate at its own level or anywhere the
/// emit inlines below it (a group's arms, a non-recursive fragment's body). A
/// nested predicate constrains the emit exactly as a top-level one does, so both
/// must disable the maximal-munch scan.
fn lexer_alt_has_predicate_below(alt: &LexerAlternative, all_rules: &List<LexerRule>) -> bool {
    for let a of &alt.actions {
        if a.kind matches { Predicate } {
            return true;
        }
    }
    for let e of &alt.elements {
        if lexer_elem_has_predicate_below(e, all_rules) {
            return true;
        }
    }
    return false;
}

fn lexer_elem_has_predicate_below(elem: &LexerElement, all_rules: &List<LexerRule>) -> bool {
    return match *elem {
        Group(alts) => {
            for let a of alts {
                if lexer_alt_has_predicate_below(&a, all_rules) {
                    return true;
                }
            }
            false;
        },
        Repeat(rep) => lexer_elem_has_predicate_below(&rep.element, all_rules),
        Not(n) => lexer_elem_has_predicate_below(&n.element, all_rules),
        RuleRef(name) => match find_fragment(all_rules, &name) {
            // A recursive fragment is a call, so its predicates stay inside it.
            Some(f) => {
                if fragment_is_recursive(f, all_rules) {
                    return false;
                }
                for let a of &f.body {
                    if lexer_alt_has_predicate_below(a, all_rules) {
                        return true;
                    }
                }
                false;
            },
            None => false,
        },
        _ => false,
    };
}

/// The exact number of chars an alternative consumes, or null when it is not a
/// fixed count (repeats, rule calls, recursive fragments).
fn lexer_alt_fixed_len(alt: &LexerAlternative, all_rules: &List<LexerRule>) -> Option<i32> {
    let mut total = 0;
    for let elem of &alt.elements {
        let len = lexer_elem_fixed_len(elem, all_rules);
        if let Some(n) = len {
            total += n;
        } else {
            return null;
        }
    }
    return Option::<i32>::Some(total);
}

fn lexer_elem_fixed_len(elem: &LexerElement, all_rules: &List<LexerRule>) -> Option<i32> {
    return match *elem {
        Literal(text) => Option::<i32>::Some(text.chars().count()),
        CharRange(_) | CharClass(_) | AnyChar => Option::<i32>::Some(1),
        // A complement consumes one char exactly when its inner set does.
        Not(n) => match lexer_elem_fixed_len(&n.element, all_rules) {
            Some(1) => Option::<i32>::Some(1),
            _ => null,
        },
        Group(alts) => {
            let mut common: Option<i32> = null;
            for let alt of alts {
                let len = lexer_alt_fixed_len(&alt, all_rules);
                if let Some(n) = len {
                    if let Some(c) = common {
                        if c != n {
                            return null;
                        }
                    } else {
                        common = Option::<i32>::Some(n);
                    }
                } else {
                    return null;
                }
            }
            common;
        },
        RuleRef(name) => {
            if name == "EOF" {
                return Option::<i32>::Some(0);
            }
            let frag = find_fragment(all_rules, &name);
            if let Some(f) = frag {
                if fragment_is_recursive(f, all_rules) {
                    return null;
                }
                return lexer_elem_fixed_len(&LexerElement::Group(f.body), all_rules);
            }
            null;
        },
        Repeat(_) => null,
    };
}

/// Whether `alt` has a semantic predicate strictly between element `after` and
/// the trailing position (`after < before_index < elements.len()`).
fn lexer_alt_has_predicate_after(alt: &LexerAlternative, after: i32) -> bool {
    for let a of &alt.actions {
        if a.kind matches { Predicate } && after < a.before_index < alt.elements.len() {
            return true;
        }
    }
    return false;
}

fn gen_lexer_alt_seq(
    w: &mut CodeWriter,
    alt: &LexerAlternative,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
    tail: bool,
    replay: bool,
) {
    // The last element inherits the sequence's tail position, unless a trailing
    // predicate follows it: the maximal-munch emit would gate the longest arm on
    // a predicate that a shorter one might have satisfied.
    let last_is_tail = tail && !lexer_alt_has_predicate_at(alt, alt.elements.len());
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        // Every `before_index == i` predicate (alt-initial and mid-alt); the
        // trailing one is emitted post-loop. Emitting here rather than in the
        // caller lets a single-alt inlined group / fragment gate its boundary
        // predicates. A predicate after a suffix-consuming repeat is placed there.
        gen_lexer_rule_predicates(w, &alt.actions, i, ea, fail_action);
        if replay {
            gen_lexer_alt_actions_at(w, &alt.actions, i);
        }
        let elem = &alt.elements[i];
        if let Repeat(rep) = elem {
            if rep.non_greedy {
                // Re-base the suffix's predicates onto the rest alt
                // (`before_index - (i + 1)`) so one after the repeat is still
                // emitted, inside the suffix the non-greedy emit consumes.
                // `return`: the rest alt covers `i + 1` through the trailing one.
                let mut rest_elems: List<LexerElement> = [];
                for let mut j = i + 1; j < alt.elements.len(); j += 1 {
                    rest_elems.push(alt.elements[j]);
                }
                let mut rest_actions: List<AltAction> = [];
                for let a of &alt.actions {
                    if a.before_index >= i + 1 {
                        rest_actions.push(
                            AltAction { kind: a.kind, source: a.source, before_index: a.before_index - (i + 1) },
                        );
                    }
                }
                let rest_alt = LexerAlternative { elements: rest_elems, actions: rest_actions };
                gen_lexer_non_greedy_repeat(w, rep, &rest_alt, all_rules, fail_action, ci, ea, hm);
                return;
            }
            // Greedy Plus / Star whose inner is a single-char-consuming
            // shape (Literal of one char / CharRange / CharClass /
            // AnyChar / Not over any of those / Group of single-element
            // alts) and whose entire suffix is also single-char-consuming:
            // a naive greedy loop can over-shoot and strand the suffix at
            // end-of-input (`'a' ~('b')+ 'c'` over `abc` is the canonical
            // ANTLR4 descriptor — `Sets/UnicodeNegated*`). ANTLR4's lexer
            // obtains the longest match via NFA→DFA simulation; we
            // replicate that here in a single forward pass with explicit
            // accept-state tracking (no backtracking). At every iteration
            // we peek whether the suffix could start at the current
            // position and record the latest such position; once the
            // inner stops matching we resume the cursor at that recorded
            // position and consume the suffix.
            //
            // Shapes outside that window (RuleRef inner / suffix, nested
            // Repeat, multi-element-alt Group) fall through to the
            // unchanged greedy emit below. The standard lexer algorithm
            // is correct there as long as the inner cannot consume the
            // suffix's first character — a property the descriptor
            // corpus does satisfy outside the simple window. If a future
            // grammar needs lookahead through a complex shape, generalise
            // the peek emitters instead of widening this trigger blindly.
            if rep.kind matches { Plus | Star }
                && i + 1 < alt.elements.len()
                && lexer_element_can_consume_simple(&rep.element) {
                let mut suffix_elems: List<LexerElement> = [];
                for let mut j = i + 1; j < alt.elements.len(); j += 1 {
                    suffix_elems.push(alt.elements[j]);
                }
                if lexer_suffix_is_peekable(&suffix_elems) {
                    // The peek/commit emitter carries no actions, so a predicate
                    // strictly after the repeat cannot be placed — fail loudly
                    // rather than drop it (the trailing one is still post-loop).
                    if lexer_alt_has_predicate_after(alt, i) {
                        panic(
                            `lexer predicate after a lookahead-aware greedy repeat is not yet supported (rule alt element ${i})`,
                        );
                    }
                    gen_lexer_repeat_lookahead_aware(w, rep, &suffix_elems, all_rules, fail_action, ci, ea, hm);
                    break;
                }
            }
        }
        gen_lexer_elem(
            w,
            elem,
            all_rules,
            fail_action,
            ci,
            ea,
            hm,
            last_is_tail && i == alt.elements.len() - 1,
            replay,
        );
    }
    gen_lexer_rule_predicates(w, &alt.actions, alt.elements.len(), ea, fail_action);
    if replay {
        gen_lexer_alt_actions_at(w, &alt.actions, alt.elements.len());
    }
}

/// Emit the `{ ... }` actions positioned at `before` as statements, in source
/// order. Only reached on the replay path, where `pos` is the live match cursor,
/// so a body reading the matched text sees exactly what ANTLR4's would.
fn gen_lexer_alt_actions_at(w: &mut CodeWriter, actions: &List<AltAction>, before: i32) {
    for let a of actions {
        if a.kind matches { Action } && a.before_index == before {
            let body = match translate_lexer_action(&a.source.text) {
                Ok(b) => b,
                Err(e) => panic(`lexer action: ${e}`),
            };
            emit_lexer_action_stmt(w, &body);
        }
    }
}

/// Whether `alt` carries a semantic predicate at position `at`.
fn lexer_alt_has_predicate_at(alt: &LexerAlternative, at: i32) -> bool {
    for let a of &alt.actions {
        if a.kind matches { Predicate } && a.before_index == at {
            return true;
        }
    }
    return false;
}

/// True for lexer elements safe to participate in the lookahead-aware
/// `gen_lexer_repeat_lookahead_aware` emit. `single_char` forces the
/// element to consume *exactly one char* — the constraint the
/// lookahead-aware emitter places on the `Plus` / `Star` inner so the
/// per-iteration peek records the right position. The same predicate
/// without `single_char` is what the SUFFIX must satisfy: each element
/// must be deterministic and side-effect-free when replayed inside the
/// peek block (so the peek's verdict matches the eventual commit).
/// Multi-char literals are accepted in the suffix because the peek
/// replays the same byte-wise comparisons the commit will run.
///
/// Either way, non-simple shapes (RuleRef, nested Repeat, multi-element
/// alts inside a Group) escape into a rule call, recurse into their
/// own loop, or pick an alternation arm that could diverge between
/// peek and commit, and are rejected.
fn lexer_element_can_replay(elem: &LexerElement, single_char: bool) -> bool {
    return match *elem {
        Literal(text) => !single_char || text.chars().count() == 1,
        CharRange(_) | CharClass(_) | AnyChar => true,
        Not(not_inner) => lexer_element_can_replay(&not_inner.element, single_char),
        // `~('b')` parses as `Not(Group([Alt([Literal("b")])]))`,
        // `~('b' | ' ')` as `Not(Group([Alt(['b']), Alt([' '])]))`.
        // Either shape consumes exactly one char as long as every alt
        // body is itself a single replay-safe element.
        Group(alts) => {
            for let alt of alts {
                if alt.elements.len() != 1 {
                    return false;
                }
                if !lexer_element_can_replay(&alt.elements[0], single_char) {
                    return false;
                }
            }
            !alts.is_empty();
        },
        _ => false,
    };
}

/// Convenience: the `Plus` / `Star` inner must consume exactly one
/// char per iteration so the lookahead-aware loop's per-iteration peek
/// records a position that is one char past the last successful inner.
fn lexer_element_can_consume_simple(elem: &LexerElement) -> bool {
    return lexer_element_can_replay(elem, /*single_char=*/ true);
}

/// True when every element in the suffix can be safely peeked via a
/// `save-pos / try-elem / restore-pos` block. Multi-char literals are
/// permitted: the peek replays the same byte-wise comparisons the
/// post-loop commit will run.
fn lexer_suffix_is_peekable(elements: &List<LexerElement>) -> bool {
    if elements.is_empty() {
        return false;
    }
    for let elem of elements {
        if !lexer_element_can_replay(elem, /*single_char=*/ false) {
            return false;
        }
    }
    return true;
}

/// Emit a greedy `Plus` / `Star` whose inner can consume the suffix's
/// first character, in single-pass forward DFA style. At every
/// position where the suffix could legally start we record the
/// position in `accept_<id>`; once the inner stops matching we rewind
/// the cursor exactly once to the latest recorded position and
/// consume the suffix normally. This is the standard lexer
/// longest-match algorithm (NFA→DFA with accept-state tracking),
/// performed without any try-fail-retry backtracking.
fn gen_lexer_repeat_lookahead_aware(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    suffix: &List<LexerElement>,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    let accept_var = `accept_${id}`;
    let loop_label = `la_rep_${id}`;

    w.line(&`let mut ${accept_var}: i32 = -1;`);

    // Star: zero iterations is a valid endpoint, so the suffix may
    // legally start at the current position even before any inner
    // consumption.
    if let Star = rep.kind {
        gen_lexer_suffix_peek(w, suffix, all_rules, &accept_var, ci, ea, hm);
    }

    // Plus: the first iteration is mandatory and may not be skipped.
    if let Plus = rep.kind {
        gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci, ea, hm, false, false);
        gen_lexer_suffix_peek(w, suffix, all_rules, &accept_var, ci, ea, hm);
    }

    // Forward scan: each iteration of the inner advances pos and
    // re-peeks the suffix. `accept_<id>` always holds the latest
    // position where the suffix could start; once the inner can no
    // longer match we exit the loop and resume from that position.
    w.begin(&"loop");
    w.line(&`let la_saved_${id} = pos;`);
    w.begin(&`${loop_label}:`);
    gen_lexer_elem(w, &rep.element, all_rules, &`break ${loop_label}`, ci, ea, hm, false, false);
    gen_lexer_suffix_peek(w, suffix, all_rules, &accept_var, ci, ea, hm);
    w.line(&"continue;");
    w.end();
    w.line(&`pos = la_saved_${id};`);
    w.line(&"break;");
    w.end();

    w.begin(&`if ${accept_var} < 0`);
    w.line(&`${*fail_action};`);
    w.end();
    w.line(&`pos = ${accept_var};`);

    // Re-consume the suffix to advance `pos` past it. The peek that
    // recorded `accept_var` already proved every suffix element
    // matches at that position, so divergence here can only mean a
    // codegen bug in `gen_lexer_suffix_peek` (peek and commit emit
    // different element shapes). Pass a `panic` fail-action instead
    // of the caller's `return -1` so such divergence traps loudly at
    // runtime rather than silently degrading to a "rule rejected"
    // verdict.
    let assert_msg = `lexer DFA invariant: gen_lexer_suffix_peek and the post-loop suffix commit must agree on match outcome (accept_<id> recorded a position the commit then rejected)`;
    let assert_fail = `panic("${assert_msg}")`;
    for let elem of suffix {
        gen_lexer_elem(w, elem, all_rules, &assert_fail, ci, ea, hm, false, false);
    }
}

/// Emit a save / try-suffix / restore block that records the current
/// position in `accept_var` iff every suffix element would match
/// starting here. Pos is restored unconditionally so the surrounding
/// forward scan continues without committing the peeked suffix.
fn gen_lexer_suffix_peek(
    w: &mut CodeWriter,
    suffix: &List<LexerElement>,
    all_rules: &List<LexerRule>,
    accept_var: &String,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    let save_var = `peek_save_${id}`;
    let matched_var = `peek_ok_${id}`;
    let label = `peek_${id}`;
    w.line(&`let ${save_var} = pos;`);
    w.line(&`let mut ${matched_var} = false;`);
    w.begin(&`${label}:`);
    for let elem of suffix {
        gen_lexer_elem(w, elem, all_rules, &`break ${label}`, ci, ea, hm, false, false);
    }
    w.line(&`${matched_var} = true;`);
    w.end();
    w.line(&`pos = ${save_var};`);
    w.begin(&`if ${matched_var}`);
    w.line(&`${*accept_var} = ${save_var};`);
    w.end();
}

fn gen_lexer_elem(
    w: &mut CodeWriter,
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
    tail: bool,
    replay: bool,
) {
    let call_ctx = if hm { "lx" } else { "chars" };
    match *elem {
        Literal(text) => {
            let chars: List<char> = text.chars().collect();
            for let mut i = 0; i < chars.len(); i += 1 {
                let mismatch = gen_char_mismatch(&`chars[pos]`, chars[i], ci);
                w.line(&`if pos >= chars.len() || ${mismatch} \{ ${fail_action}; \}`);
                w.line(&"pos += 1;");
            }
        },
        CharRange(pair) => {
            if ci {
                let mut ranges: List<CharRange> = [];
                fold_range_ci(pair.0, pair.1, &mut ranges);
                let cc = CharClass { ranges, negated: false };
                gen_char_class(w, &cc, fail_action);
            } else {
                w.line(
                    &`if pos >= chars.len() || !(chars[pos] matches \{ ${char_range_pat(pair.0..=pair.1)} \}) \{ ${fail_action}; \}`,
                );
                w.line(&"pos += 1;");
            }
        },
        CharClass(cc) => {
            let expanded = if ci { expand_char_class_ci(&cc) } else { cc };
            gen_char_class(w, &expanded, fail_action);
        },
        AnyChar => {
            w.line(&`if pos >= chars.len() \{ ${fail_action}; \}`);
            w.line(&"pos += 1;");
        },
        RuleRef(name) => {
            if name == "EOF" {
                w.line(&`if pos < chars.len() \{ ${fail_action}; \}`);
            } else {
                let frag = find_fragment(all_rules, &name);
                if let Some(f) = frag {
                    // Fragments inherit the caller's CI context when inlined.
                    // The recursive-fragment case uses its own `try_*` fn
                    // emitted separately with grammar-level CI.
                    if fragment_is_recursive(f, all_rules) {
                        let fn_name = lexer_try_fn_name(&name);
                        w.line(&`pos = ${fn_name}(${call_ctx}, pos);`);
                        w.line(&`if pos < 0 \{ ${fail_action}; \}`);
                    } else if f.body.len() == 1 {
                        gen_lexer_alt_seq(w, &f.body[0], all_rules, fail_action, ci, ea, hm, tail, replay);
                    } else {
                        gen_lexer_alts(w, &f.body, all_rules, fail_action, ci, ea, hm, tail, replay);
                    }
                } else {
                    let fn_name = lexer_try_fn_name(&name);
                    w.line(&`pos = ${fn_name}(${call_ctx}, pos);`);
                    w.line(&`if pos < 0 \{ ${fail_action}; \}`);
                }
            }
        },
        Group(alts) => {
            if alts.len() == 1 {
                gen_lexer_alt_seq(w, &alts[0], all_rules, fail_action, ci, ea, hm, tail, replay);
            } else {
                gen_lexer_alts(w, &alts, all_rules, fail_action, ci, ea, hm, tail, replay);
            }
        },
        Repeat(rep) => gen_lexer_repeat(w, &rep, all_rules, fail_action, ci, ea, hm),
        Not(not_elem) => gen_lexer_not(w, &not_elem, all_rules, fail_action, ci, ea, hm),
    }
}

fn expand_char_class_ci(cc: &CharClass) -> CharClass {
    let mut expanded: List<CharRange> = [];
    for let r of &cc.ranges {
        fold_range_ci(r.start, r.end, &mut expanded);
    }
    return CharClass { ranges: expanded, negated: cc.negated };
}

fn gen_char_class(w: &mut CodeWriter, cc: &CharClass, fail_action: &String) {
    w.line(&`if pos >= chars.len() \{ ${fail_action}; \}`);
    let cond = char_class_disjunction(cc);
    if cc.negated {
        w.line(&`if ${cond} \{ ${*fail_action}; \}`);
    } else {
        w.line(&`if !(${cond}) \{ ${*fail_action}; \}`);
    }
    w.line(&"pos += 1;");
}

/// Build `(chars[pos] matches { 'x' | 'lo'..='hi' | ... })` for a char class.
fn char_class_disjunction(cc: &CharClass) -> String {
    if cc.ranges.len() == 0 {
        return "(false)";
    }
    let mut s = String::with_capacity(64);
    s.push_str(&"(chars[pos] matches { ");
    let mut first = true;
    for let range of &cc.ranges {
        if !first {
            s.push_str(&" | ");
        }
        first = false;
        s.push_str(&`${char_range_pat(range.start..=range.end)}`);
    }
    s.push_str(&" })");
    return s;
}

fn gen_lexer_repeat(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    let label = `rep_${id}`;
    if let Star = rep.kind {
        w.begin(&"loop");
        w.line(&`let rep_saved_${id} = pos;`);
        w.begin(&`${label}:`);
        gen_lexer_elem(w, &rep.element, all_rules, &`break ${label}`, ci, ea, hm, false, false);
        w.line(&"continue;");
        w.end();
        w.line(&`pos = rep_saved_${id};`);
        w.line(&"break;");
        w.end();
    }
    if let Plus = rep.kind {
        gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci, ea, hm, false, false);
        w.begin(&"loop");
        w.line(&`let rep_saved_${id} = pos;`);
        w.begin(&`${label}:`);
        gen_lexer_elem(w, &rep.element, all_rules, &`break ${label}`, ci, ea, hm, false, false);
        w.line(&"continue;");
        w.end();
        w.line(&`pos = rep_saved_${id};`);
        w.line(&"break;");
        w.end();
    }
    if let Optional = rep.kind {
        w.line(&`let opt_saved_${id} = pos;`);
        w.line(&`let mut opt_ok_${id} = false;`);
        w.begin(&`${label}:`);
        gen_lexer_elem(w, &rep.element, all_rules, &`break ${label}`, ci, ea, hm, false, false);
        w.line(&`opt_ok_${id} = true;`);
        w.end();
        w.line(&`if !opt_ok_${id} \{ pos = opt_saved_${id}; \}`);
    }
}

fn gen_lexer_non_greedy_repeat(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    rest: &LexerAlternative,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    let label = `ng_${id}`;
    // For Plus, match at least one element first
    if let Plus = rep.kind {
        gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci, ea, hm, false, false);
    }
    // Loop: try matching the rest first (non-greedy), otherwise consume one more
    w.begin(&"loop");
    // Try exit: match rest of elements
    w.line(&`let ng_saved_${id} = pos;`);
    w.line(&`let mut ng_exit_${id} = false;`);
    w.begin(&`${label}:`);
    gen_lexer_alt_seq(w, rest, all_rules, &`break ${label}`, ci, ea, hm, false, false);
    w.line(&`ng_exit_${id} = true;`);
    w.end();
    w.begin(&`if ng_exit_${id}`);
    w.line(&"break;");
    w.end();
    // Exit failed, restore pos and consume one element
    w.line(&`pos = ng_saved_${id};`);
    gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci, ea, hm, false, false);
    w.end();
}

fn gen_lexer_not(
    w: &mut CodeWriter,
    not_elem: &LexerNotElement,
    all_rules: &List<LexerRule>,
    fail_action: &String,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    if let CharClass(cc) = not_elem.element {
        let expanded = if ci { expand_char_class_ci(&cc) } else { cc };
        let flipped = CharClass {
            ranges: expanded.ranges,
            negated: !expanded.negated,
        };
        gen_char_class(w, &flipped, fail_action);
        return;
    }
    let id = w.next_id();
    let label = `not_${id}`;
    w.line(&`if pos >= chars.len() \{ ${fail_action}; \}`);
    w.line(&`let not_saved_${id} = pos;`);
    w.line(&`let mut not_matched_${id} = false;`);
    w.begin(&`${label}:`);
    gen_lexer_elem(w, &not_elem.element, all_rules, &`break ${label}`, ci, ea, hm, false, false);
    w.line(&`not_matched_${id} = true;`);
    w.end();
    w.line(&`pos = not_saved_${id};`);
    w.line(&`if not_matched_${id} \{ ${fail_action}; \}`);
    w.line(&"pos += 1;");
}

fn find_fragment(all_rules: &List<LexerRule>, name: &String) -> Option<&LexerRule> with stores[all_rules] {
    for let rule of all_rules {
        if rule.name == *name && rule.is_fragment {
            return Option::<&LexerRule>::Some(rule);
        }
    }
    return null;
}

/// Tries to extract a single lowercase char from a case-insensitive CharClass (e.g., [aA]).
fn try_extract_ci_char(cc: &CharClass) -> Option<char> {
    if cc.negated {
        return null;
    }
    if cc.ranges.len() == 1 {
        let r = &cc.ranges[0];
        if r.start == r.end {
            return Option::<char>::Some(r.start.to_ascii_lowercase());
        }
        return null;
    }
    if cc.ranges.len() == 2 {
        let r0 = &cc.ranges[0];
        let r1 = &cc.ranges[1];
        if r0.start == r0.end
            && r1.start == r1.end
            && r0.start != r1.start
            && r0.start.to_ascii_lowercase() == r1.start.to_ascii_lowercase() {
            return Option::<char>::Some(r0.start.to_ascii_lowercase());
        }
    }
    return null;
}

/// Extracts a [lowercase_char, is_case_insensitive] pair from a lexer element.
/// When `rule_ci` is true, plain literal chars are treated as case-insensitive
/// too — ANTLR4's `caseInsensitive` option folds every grammar-level char to
/// its opposing-case partner.
fn try_extract_keyword_char(elem: &LexerElement, all_rules: &List<LexerRule>, rule_ci: bool) -> Option<[char, bool]> {
    return match elem {
        Literal(text) => {
            let mut iter = text.chars();
            let first = iter.next();
            if let Some(c) = first {
                if iter.next() matches { None } {
                    let is_letter = c.to_ascii_lowercase() != c.to_ascii_uppercase();
                    let ci = rule_ci && is_letter;
                    Option::<[char, bool]>::Some([c.to_ascii_lowercase(), ci]);
                } else {
                    null;
                }
            } else {
                null;
            }
        },
        CharClass(cc) => {
            let ch = try_extract_ci_char(cc);
            if let Some(c) = ch {
                Option::<[char, bool]>::Some([c, true]);
            } else if !cc.negated && cc.ranges.len() == 1 && cc.ranges[0].start == cc.ranges[0].end {
                let c = cc.ranges[0].start;
                let is_letter = c.to_ascii_lowercase() != c.to_ascii_uppercase();
                let ci = rule_ci && is_letter;
                Option::<[char, bool]>::Some([c.to_ascii_lowercase(), ci]);
            } else {
                null;
            }
        },
        RuleRef(name) => {
            let frag = find_fragment(all_rules, name);
            if let Some(f) = frag {
                if f.body.len() == 1 && f.body[0].elements.len() == 1 {
                    try_extract_keyword_char(&f.body[0].elements[0], all_rules, rule_ci);
                } else {
                    null;
                }
            } else {
                null;
            }
        },
        CharRange(_) | AnyChar | Group(_) | Repeat(_) | Not(_) => null,
    };
}

/// Analyzes a lexer rule to determine if it's a fixed keyword pattern.
/// Returns KeywordInfo if it matches a sequence of case-insensitive (or literal) chars.
fn try_extract_keyword_info(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
) -> Option<KeywordInfo> {
    if rule.is_fragment || rule.body.len() != 1 {
        return null;
    }
    // Rules carrying lexer commands (more, channel, type(X), mode(X)/pushMode/popMode, skip)
    // cannot be shortcut via keyword dispatch — the keyword classifier only rewrites
    // `best_kind`, it does not propagate the command state to the tokenize loop.
    if rule.skip
        || rule.more
        || rule.channel != 0
        || rule.type_override matches { Some(_) }
        || rule.mode != 0
        || rule.set_mode >= 0
        || rule.push_mode >= 0
        || rule.pop_mode {
        return null;
    }
    let alt = &rule.body[0];
    if alt.elements.is_empty() {
        return null;
    }
    let rule_ci = resolve_ci(grammar_opts, &rule.options);
    let mut text = String::with_capacity(alt.elements.len());
    let mut char_ci: List<bool> = [];
    for let elem of &alt.elements {
        if let Some(pair) = try_extract_keyword_char(elem, all_rules, rule_ci) {
            text.push(pair.0);
            char_ci.push(pair.1);
        } else {
            return null;
        }
    }
    // Only treat identifier-like patterns as keywords (letters, digits, underscores).
    // `text` is already lowercased by try_extract_keyword_char.
    for let c of text.chars() {
        if !c.is_ascii_lowercase() && c != '_' && !(c >= '0' && c <= '9') {
            return null;
        }
    }
    return Option::<KeywordInfo>::Some(KeywordInfo {
        rule_name: rule.name,
        lowercase_text: text,
        char_ci,
    });
}

/// Collects all keyword rules from the grammar.
///
/// The keyword path is an optimisation: instead of dispatching keyword-shaped
/// rules through their own first-character branch, the tokenize loop runs
/// `classify_keyword` after a carrier rule has matched the same characters
/// (the gate is `best_end > start`). ANTLR4 has no such precondition (every
/// lexer rule is its own dispatch path), so a candidate is admitted only when
/// `keyword_carrier_admits` confirms the shortcut stays ANTLR4-faithful;
/// the rest fall back to the regular dispatch path (`gen_lexer_match_fn`).
pub fn collect_keyword_rules(lexer_rules: &List<LexerRule>, grammar_opts: &List<GrammarOption>) -> List<KeywordInfo> {
    let mut candidates: List<KeywordInfo> = [];
    let mut candidate_indices: List<i32> = [];
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let rule = &lexer_rules[i];
        if rule.is_fragment || rule.is_virtual {
            continue;
        }
        let info = try_extract_keyword_info(rule, lexer_rules, grammar_opts);
        if let Some(kw) = info {
            candidates.push(kw);
            candidate_indices.push(i);
        }
    }
    // Precompute the first-char set (and declaration index) of each potential
    // carrier rule. A carrier is any non-keyword token rule the classifier can
    // run behind; the keyword classifier only fires once a carrier has matched
    // the same characters (the `best_end > start` gate). Indices are needed
    // because ANTLR4 awards a same-length match to the earliest rule, so a
    // keyword may only shortcut through carriers that follow it (see
    // `keyword_carrier_admits`).
    let mut carrier_indices: List<i32> = [];
    let mut carrier_first_chars: List<List<[char, char]>> = [];
    let mut carrier_is_wildcard: List<bool> = [];
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let rule = &lexer_rules[i];
        if rule.is_fragment || rule.is_virtual {
            continue;
        }
        if is_keyword_rule_name(&rule.name, &candidates) {
            continue;
        }
        let try_call = build_rule_try_call(rule, lexer_rules, false, false, false, false, grammar_opts);
        carrier_indices.push(i);
        carrier_first_chars.push(try_call.first_chars);
        carrier_is_wildcard.push(try_call.is_wildcard);
    }
    let mut result: List<KeywordInfo> = [];
    for let mut c = 0; c < candidates.len(); c += 1 {
        let kw = &candidates[c];
        if keyword_carrier_admits(
            kw,
            candidate_indices[c],
            &carrier_indices,
            &carrier_first_chars,
            &carrier_is_wildcard,
        ) {
            result.push(*kw);
        }
    }
    return result;
}

/// Decides whether a keyword candidate may use the classifier shortcut.
///
/// A carrier and the keyword tie on the keyword's own text length whenever the
/// carrier matches exactly the keyword text, so ANTLR4 awards that match to
/// whichever rule is declared first. The shortcut rewrites a carrier match into
/// the keyword unconditionally, so it is only sound when:
///
/// - some carrier declared *after* the keyword can match its first character
///   (reachability — otherwise the classifier never runs and the rule would be
///   unreachable), and
/// - no carrier declared *before* the keyword can match its first character
///   (priority — that earlier carrier wins the tie under ANTLR4 rules, so
///   reclassifying its match into the keyword would mis-tag it; the canonical
///   case is `A : 'a' EOF; B : 'a';`, where carrier A precedes keyword B).
///
/// Using the first character as the collision proxy is conservative: a rejected
/// candidate simply falls back to regular first-character dispatch, where the
/// strict `>` longest-match comparison already honours declaration order.
fn keyword_carrier_admits(
    kw: &KeywordInfo,
    kw_index: i32,
    carrier_indices: &List<i32>,
    carrier_first_chars: &List<List<[char, char]>>,
    carrier_is_wildcard: &List<bool>,
) -> bool {
    let first_char = kw.lowercase_text.chars().next().unwrap();
    let first_ci = kw.char_ci[0];
    let upper = if first_ci { first_char.to_ascii_uppercase() } else { first_char };
    let mut has_later_carrier = false;
    for let mut i = 0; i < carrier_indices.len(); i += 1 {
        let covers = carrier_is_wildcard[i]
            || char_matches_ranges(first_char, &carrier_first_chars[i])
            || first_ci && upper != first_char && char_matches_ranges(upper, &carrier_first_chars[i]);
        if !covers {
            continue;
        }
        if carrier_indices[i] < kw_index {
            // An earlier carrier ties with the keyword and wins under ANTLR4
            // priority — the shortcut would mis-reclassify its match.
            return false;
        }
        has_later_carrier = true;
    }
    return has_later_carrier;
}

fn is_keyword_rule_name(name: &String, keywords: &List<KeywordInfo>) -> bool {
    for let kw of keywords {
        if kw.rule_name == *name {
            return true;
        }
    }
    return false;
}

/// Extracts the fixed literal text from a lexer rule, if it's a pure literal sequence.
fn try_extract_fixed_text(rule: &LexerRule) -> Option<String> {
    if rule.is_fragment || rule.body.len() != 1 {
        return null;
    }
    let alt = &rule.body[0];
    let mut text = String::with_capacity(alt.elements.len());
    for let elem of &alt.elements {
        if let Literal(s) = elem {
            text.push_str(s);
        } else {
            return null;
        }
    }
    return Option::<String>::Some(text);
}

/// Check if a lexer rule has the same fixed text as any literal token.
///
/// Parser literals inherit the grammar-level `caseInsensitive` setting, so a
/// lexer rule with a divergent rule-level CI override must keep its own
/// `try_*` function instead of being deduped against the shared literal.
fn is_literal_duplicate(
    rule: &LexerRule,
    lit_tokens: &List<LitToken>,
    grammar_opts: &List<GrammarOption>,
    grammar_ci: bool,
) -> bool {
    if rule.mode != 0 {
        return false;
    }
    let rule_ci = resolve_ci(grammar_opts, &rule.options);
    if rule_ci != grammar_ci {
        return false;
    }
    let text = try_extract_fixed_text(rule);
    if let Some(t) = &text {
        for let lit of lit_tokens {
            if lit.text == *t {
                return true;
            }
        }
    }
    return false;
}

/// Sentinel for the keyword-length min-finding loop below: larger than
/// any realistic lexer keyword, so the first real length replaces it.
global KEYWORD_LEN_SENTINEL: i32 = 9999;

fn gen_keyword_classifier_fn(w: &mut CodeWriter, keywords: &List<KeywordInfo>) {
    if keywords.is_empty() {
        return;
    }

    let mut f = FnSpec::new("classify_keyword");
    f.add_param(&"chars", &"&List<char>");
    f.add_param(&"start", &"i32");
    f.add_param(&"end", &"i32");
    f.set_return_type(&"i32");
    f.emit_begin(w);

    w.line(&"let len = end - start;");

    // Find min/max keyword length (ASCII keywords: byte len == char count)
    let mut min_len = KEYWORD_LEN_SENTINEL;
    let mut max_len = 0;
    for let kw of keywords {
        let l = kw.lowercase_text.len();
        if l < min_len {
            min_len = l;
        }
        if l > max_len {
            max_len = l;
        }
    }

    let mut first_len = true;
    for let mut target_len = min_len; target_len <= max_len; target_len += 1 {
        // Check if any keywords have this length
        let mut has_any = false;
        for let kw of keywords {
            if kw.lowercase_text.len() == target_len {
                has_any = true;
            }
        }
        if !has_any {
            continue;
        }

        if first_len {
            w.begin(&`if len == ${target_len}`);
            first_len = false;
        } else {
            w.else_begin(&`else if len == ${target_len}`);
        }

        // Group keywords of this length by first character for dispatch
        let mut len_keywords: List<&KeywordInfo> = [];
        for let kw of keywords {
            if kw.lowercase_text.len() == target_len {
                len_keywords.push(kw);
            }
        }
        // Collect unique first chars
        let mut first_chars: List<char> = [];
        for let kw of &len_keywords {
            let fc = kw.lowercase_text.chars().next().unwrap();
            let mut found = false;
            for let existing of &first_chars {
                if *existing == fc {
                    found = true;
                    break;
                }
            }
            if !found {
                first_chars.push(fc);
            }
        }
        first_chars.sort();
        // Emit first-char dispatch within this length group if >1 first char
        if first_chars.len() > 1 {
            let mut first_fc = true;
            for let fc of &first_chars {
                let guard = gen_char_guard(&"chars[start]", *fc, true);
                if first_fc {
                    w.begin(&`if ${guard}`);
                    first_fc = false;
                } else {
                    w.else_begin(&`else if ${guard}`);
                }
                for let kw of &len_keywords {
                    if kw.lowercase_text.chars().next().unwrap() != *fc {
                        continue;
                    }
                    gen_keyword_check(w, *kw);
                }
            }
            w.end();
        } else {
            for let kw of &len_keywords {
                gen_keyword_check(w, *kw);
            }
        }
    }
    if !first_len {
        w.end();
    }

    w.line(&"return -1;");
    w.end();
    w.blank();
}

fn gen_char_guard(access: &String, c: char, ci: bool) -> String {
    let lower = c.to_ascii_lowercase();
    let upper = c.to_ascii_uppercase();
    if ci && lower != upper {
        return `${access}.eq_ignore_ascii_case(&${char_lit(lower)})`;
    }
    return `${access} == ${char_lit(c)}`;
}

fn gen_char_mismatch(access: &String, c: char, ci: bool) -> String {
    let lower = c.to_ascii_lowercase();
    let upper = c.to_ascii_uppercase();
    if ci && lower != upper {
        return `!${access}.eq_ignore_ascii_case(&${char_lit(lower)})`;
    }
    return `${access} != ${char_lit(c)}`;
}

fn gen_keyword_check(w: &mut CodeWriter, kw: &KeywordInfo) {
    let kw_chars: List<char> = kw.lowercase_text.chars().collect();
    w.write(&"if ");
    for let mut kc = 0; kc < kw_chars.len(); kc += 1 {
        if kc > 0 {
            w.write(&" && ");
        }
        let lower = kw_chars[kc];
        if kw.char_ci[kc] {
            w.write(&`chars[start + ${kc}].eq_ignore_ascii_case(&${char_lit(lower)})`);
        } else {
            w.write(&`chars[start + ${kc}] == ${char_lit(lower)}`);
        }
    }
    w.write(&` \{ return TK_${kw.rule_name}; \}\n`);
}

fn gen_literal_match_fns(w: &mut CodeWriter, lit_tokens: &List<LitToken>, ci: bool, hm: bool) {
    for let lit of lit_tokens {
        let chars: List<char> = lit.text.chars().collect();
        let fn_name = lit_try_fn_name(&lit.const_name);
        let mut f = FnSpec::new(&fn_name);
        if hm {
            f.add_param(&"lx", &"&Lexer");
        } else {
            f.add_param(&"chars", &"&List<char>");
        }
        f.add_param(&"start", &"i32");
        f.set_return_type(&"i32");
        f.emit_begin(w);
        if hm {
            w.line(&"let chars = &lx.chars;");
        }
        w.line(&"let pos = start;");
        for let mut i = 0; i < chars.len(); i += 1 {
            let mismatch = gen_char_mismatch(&`chars[pos + ${i}]`, chars[i], ci);
            w.line(&`if pos + ${i} >= chars.len() || ${mismatch} \{ return -1; \}`);
        }
        let len = chars.len();
        w.line(&`return pos + ${len};`);
        w.end();
        w.blank();
    }
}

fn lit_try_fn_name(const_name: &String) -> String {
    let mut result = String::with_capacity(const_name.len() + 4);
    result.push_str(&"try_lit_");
    let chars: List<char> = const_name.chars().collect();
    for let mut i = 7; i < chars.len(); i += 1 {
        result.push(chars[i].to_ascii_lowercase());
    }
    return result;
}

fn has_modes(mode_names: &List<String>) -> bool {
    return mode_names.len() > 1;
}

fn has_set_mode(rules: &List<LexerRule>) -> bool {
    for let r of rules {
        if r.set_mode >= 0 {
            return true;
        }
    }
    return false;
}

fn has_more(rules: &List<LexerRule>) -> bool {
    for let r of rules {
        if r.more {
            return true;
        }
    }
    return false;
}

fn has_channel(rules: &List<LexerRule>) -> bool {
    for let r of rules {
        if r.channel != 0 {
            return true;
        }
    }
    return false;
}

struct TryCall {
    fn_name: String,
    token_kind: String,
    extra: String,
    first_chars: List<[char, char]>,
    is_wildcard: bool,
    is_catch_all: bool,
    /// Index of this rule's `apply_<rule>_actions` replay, or -1 when the rule
    /// runs no `{ ... }` action. When the rule wins the tournament, its winner
    /// block records `best_act = act_index` so the commit dispatches the replay.
    act_index: i32 = -1,
}

fn best_state_extras(
    push_mode: i32,
    pop_mode: bool,
    set_mode: i32,
    more: bool,
    channel: i32,
    emit_modes: bool,
    has_set_mode_rules: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
) -> String {
    let mut s = String::with_capacity(64);
    if emit_modes {
        if push_mode >= 0 {
            s.push_str(&` best_push_mode = ${push_mode};`);
        } else {
            s.push_str(&" best_push_mode = -1;");
        }
        if pop_mode {
            s.push_str(&" best_pop_mode = true;");
        } else {
            s.push_str(&" best_pop_mode = false;");
        }
    }
    if has_set_mode_rules {
        if set_mode >= 0 {
            s.push_str(&` best_set_mode = ${set_mode};`);
        } else {
            s.push_str(&" best_set_mode = -1;");
        }
    }
    if has_more_rules {
        if more {
            s.push_str(&" best_more = true;");
        } else {
            s.push_str(&" best_more = false;");
        }
    }
    if has_channel_rules {
        if channel != 0 {
            s.push_str(&` best_channel = ${channel};`);
        } else {
            s.push_str(&" best_channel = 0;");
        }
    }
    return s;
}

fn default_extras(use_modes: bool, has_set_mode_rules: bool, has_more_rules: bool, has_channel_rules: bool) -> String {
    return best_state_extras(-1, false, -1, false, 0, use_modes, has_set_mode_rules, has_more_rules, has_channel_rules);
}

fn literal_command_extras(
    lit: &LitToken,
    lexer_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    grammar_ci: bool,
    emit_modes: bool,
    has_set_mode_rules: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
) -> String {
    for let rule of lexer_rules {
        if rule.is_fragment || rule.is_virtual || rule.mode != 0 {
            continue;
        }
        if resolve_ci(grammar_opts, &rule.options) != grammar_ci {
            continue;
        }
        if try_extract_fixed_text(rule) == Option::Some(lit.text) {
            return best_state_extras(
                rule.push_mode,
                rule.pop_mode,
                rule.set_mode,
                rule.more,
                rule.channel,
                emit_modes,
                has_set_mode_rules,
                has_more_rules,
                has_channel_rules,
            );
        }
    }
    return default_extras(emit_modes, has_set_mode_rules, has_more_rules, has_channel_rules);
}

/// Compute the first-char set for a lexer rule body's first element.
fn build_rule_try_call(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    use_modes: bool,
    has_set_mode_rules: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
    grammar_opts: &List<GrammarOption>,
) -> TryCall {
    let ci = resolve_ci(grammar_opts, &rule.options);
    let fn_name = lexer_try_fn_name(&rule.name);
    // `type(X)` rewrites the kind used when emitting the token. Use the
    // override kind at emit time so downstream code (parser, token_kind_name)
    // sees the renamed type. The rule itself still has its own TK_<name>
    // constant; the override only affects emission.
    let token_kind = if let Some(override_name) = rule.type_override {
        `TK_${override_name}`;
    } else {
        `TK_${rule.name}`;
    };
    let extra = best_state_extras(
        rule.push_mode,
        rule.pop_mode,
        rule.set_mode,
        rule.more,
        rule.channel,
        use_modes,
        has_set_mode_rules,
        has_more_rules,
        has_channel_rules,
    );
    let mut chars: List<[char, char]> = [];
    let is_wc = compute_elem_first_chars(&rule.body, all_rules, &mut chars, ci).0;
    // A catch-all rule (e.g., UNEXPECTED_CHAR: .) matches any single character.
    // It's only useful in the wildcard fallback, never in specific dispatch branches
    // where another rule already matches at least 1 character.
    let catch_all = is_wc
        && rule.body.len() == 1
        && rule.body[0].elements.len() == 1
        && rule.body[0].elements[0] matches { AnyChar };
    return TryCall {
        fn_name,
        token_kind,
        extra,
        first_chars: chars,
        is_wildcard: is_wc,
        is_catch_all: catch_all,
    };
}

/// Analyze first elements of rule body alternatives to find first-char set.
/// Returns true if it's a wildcard (any char could match).
/// Compute the first-char set of a lexer rule body into `out`.
/// Returns `[wildcard, nullable]`:
///   - `wildcard`: the first set is unbounded (negated class, opaque rule ref,
///     `.`) — the dispatch treats the rule as matching any char.
///   - `nullable`: the body can match empty, so a caller folding a sequence
///     must also include the following element's first set.
/// A nullable leading element (`x?` / `x*`) contributes its first chars and the
/// walk continues to the next element (rather than collapsing to wildcard).
pub fn compute_elem_first_chars(
    body: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    out: &mut List<[char, char]>,
    ci: bool,
) -> [bool, bool] {
    let mut seen = TreeSet::<i64>::new();
    return elem_first_chars_dedup(body, all_rules, out, &mut seen, ci);
}

fn elem_first_chars_dedup(
    body: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    out: &mut List<[char, char]>,
    seen: &mut TreeSet<i64>,
    ci: bool,
) -> [bool, bool] {
    let mut any_nullable = false;
    for let alt of body {
        if alt.elements.is_empty() {
            return [true, false];
        }
        let mut alt_nullable = true;
        for let mut i = 0; i < alt.elements.len(); i += 1 {
            let r = compute_single_elem_first(&alt.elements[i], all_rules, out, seen, ci);
            if r.0 {
                return [true, false];
            }
            if !r.1 {
                alt_nullable = false;
                break;
            }
        }
        if alt_nullable {
            any_nullable = true;
        }
    }
    return [false, any_nullable];
}

fn add_folded_range(out: &mut List<[char, char]>, seen: &mut TreeSet<i64>, start: char, end: char, ci: bool) {
    if !ci {
        add_range(out, seen, start, end);
        return;
    }
    let mut folded: List<CharRange> = [];
    fold_range_ci(start, end, &mut folded);
    for let r of &folded {
        add_range(out, seen, r.start, r.end);
    }
}

/// First-char set of a single lexer element into `out`, returning
/// `[wildcard, nullable]` (see `compute_elem_first_chars`).
fn compute_single_elem_first(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    out: &mut List<[char, char]>,
    seen: &mut TreeSet<i64>,
    ci: bool,
) -> [bool, bool] {
    match *elem {
        Literal(text) => {
            let c = text.chars().next().unwrap();
            add_folded_range(out, seen, c, c, ci);
            return [false, false];
        },
        CharRange(pair) => {
            add_folded_range(out, seen, pair.0, pair.1, ci);
            return [false, false];
        },
        CharClass(cc) => {
            if cc.negated {
                return [true, false];
            }
            for let r of &cc.ranges {
                add_folded_range(out, seen, r.start, r.end, ci);
            }
            return [false, false];
        },
        RuleRef(name) => {
            for let rule of all_rules {
                if rule.name == name && rule.is_fragment {
                    return elem_first_chars_dedup(&rule.body, all_rules, out, seen, ci);
                }
            }
            return [true, false];
        },
        Repeat(rep) => {
            let inner = compute_single_elem_first(&rep.element, all_rules, out, seen, ci);
            if inner.0 {
                return [true, false];
            }
            // `?` / `*` make this element skippable, so the rule's first set
            // extends into the next element; `+` inherits the inner nullability.
            let nullable = rep.kind matches { Star | Optional } || inner.1;
            return [false, nullable];
        },
        Group(alts) => {
            return elem_first_chars_dedup(&alts, all_rules, out, seen, ci);
        },
        _ => {
            return [true, false];
        },
    }
}

fn range_key(start: char, end: char) -> i64 {
    return (start as i32 as i64) << 32 | end as i32 as i64;
}

/// Check if a char matches any of the ranges in first_chars.
fn char_matches_ranges(c: char, ranges: &List<[char, char]>) -> bool {
    for let r of ranges {
        if c >= r[0] && c <= r[1] {
            return true;
        }
    }
    return false;
}

fn add_range(out: &mut List<[char, char]>, seen: &mut TreeSet<i64>, start: char, end: char) {
    if seen.insert(range_key(start, end)) {
        out.push([start, end]);
    }
}

/// Sorted-by-start view of a call's first-char ranges for O(log n) membership:
/// `max_end[i]` is the largest range end among `starts[0..=i]`, so a char `c`
/// matches some range iff the last start <= `c` has `max_end >= c`.
struct RangeIndex {
    starts: List<char>,
    max_end: List<char>,
}

fn build_range_index(ranges: &List<[char, char]>) -> RangeIndex {
    let mut sorted = *ranges;
    sorted.sort();
    let mut starts: List<char> = [];
    let mut max_end: List<char> = [];
    for let mut i = 0; i < sorted.len(); i += 1 {
        starts.push(sorted[i][0]);
        let e = sorted[i][1];
        if i > 0 && max_end[i - 1] > e {
            max_end.push(max_end[i - 1]);
        } else {
            max_end.push(e);
        }
    }
    return RangeIndex { starts, max_end };
}

fn range_index_matches(idx: &RangeIndex, c: char) -> bool {
    let i = bound_char(&idx.starts, c, true) - 1;
    if i < 0 {
        return false;
    }
    return idx.max_end[i] >= c;
}

/// First index whose element is > `c` (`after` true) or >= `c` (`after`
/// false) in a sorted list — upper and lower bound sharing one search.
fn bound_char(chars: &List<char>, c: char, after: bool) -> i32 {
    let mut lo = 0;
    let mut hi = chars.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if chars[mid] < c || after && chars[mid] == c {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// Count of sorted `chars` inside `[lo, hi]`.
fn count_in_sorted(chars: &List<char>, lo: char, hi: char) -> i32 {
    return bound_char(chars, hi, true) - bound_char(chars, lo, false);
}

/// True when `ranges` shares a char with `probe` that no single-char branch
/// already claims. Those branches come first, so a rule whose first set inside
/// `probe` is entirely `claimed` chars is unreachable from the range branch.
/// `claimed` must be sorted; the claimed-count query is two binary searches.
fn ranges_meet_unclaimed(ranges: &List<[char, char]>, probe: [char, char], claimed: &List<char>) -> bool {
    for let mut i = 0; i < ranges.len(); i += 1 {
        let r = ranges[i];
        let lo = if r[0] > probe[0] { r[0] } else { probe[0] };
        let hi = if r[1] < probe[1] { r[1] } else { probe[1] };
        if lo > hi {
            continue;
        }
        // A `\p{...}` set runs to hundreds of ranges each wider than the whole
        // single-char branch set, so answer those by width alone.
        let width = hi as i32 - lo as i32 + 1;
        if width > claimed.len() {
            return true;
        }
        if count_in_sorted(claimed, lo, hi) < width {
            return true;
        }
    }
    return false;
}

/// The pattern of the branch every other branch falls through to; emitted as
/// a bare `else` rather than a match arm.
global FALLBACK_PATTERN: String = "_";

/// One branch of the emitted first-char dispatch: a char pattern and the
/// `try_` calls a char matching it must run, in grammar order.
struct DispatchGroup {
    pattern: String,
    calls: List<i32>,
}

/// Fold each branch into its immediate predecessor when the two have the same
/// call list — `[\p{L}]` is ~700 ranges that all route to the same rules.
///
/// Adjacency is the safety argument: the chain is first-match-wins, so folding
/// into a *non*-adjacent earlier branch would let a char skip the branch
/// between them, which usually has a different call list.
fn coalesce_equal_groups(groups: &mut List<DispatchGroup>) {
    let mut merged: List<DispatchGroup> = [];
    for let g of groups {
        let last = merged.len() - 1;
        if last >= 0 && merged[last].calls == g.calls {
            merged[last].pattern.push_str(&` | ${g.pattern}`);
        } else {
            merged.push(*g);
        }
    }
    *groups = merged;
}

fn build_dispatch_groups(calls: &List<TryCall>) -> List<DispatchGroup> {
    let mut single_chars: List<char> = [];
    for let call of calls {
        if call.is_wildcard {
            continue;
        }
        for let r of &call.first_chars {
            if r[0] == r[1] {
                single_chars.push(r[0]);
            }
        }
    }
    single_chars.sort();
    let mut all_chars: List<char> = [];
    for let mut i = 0; i < single_chars.len(); i += 1 {
        if i == 0 || single_chars[i] != single_chars[i - 1] {
            all_chars.push(single_chars[i]);
        }
    }

    let mut range_indexes: List<RangeIndex> = [];
    for let call of calls {
        range_indexes.push(build_range_index(&call.first_chars));
    }

    let mut groups: List<DispatchGroup> = [];

    // For each unique single char, find all matching calls (excluding catch-all rules)
    let mut group_by_calls = TreeMap::<List<i32>, i32>::new();
    for let c of &all_chars {
        let mut matching: List<i32> = [];
        for let mut i = 0; i < calls.len(); i += 1 {
            if calls[i].is_catch_all {
                continue;
            }
            if calls[i].is_wildcard || range_index_matches(&range_indexes[i], *c) {
                matching.push(i);
            }
        }
        // Check if this group already exists
        if let Some(gi) = group_by_calls.get(matching) {
            groups[gi].pattern.push_str(&` | ${char_lit(*c)}`);
        } else {
            group_by_calls[matching] = groups.len();
            groups.push(DispatchGroup {
                pattern: `${char_lit(*c)}`,
                calls: matching,
            });
        }
    }

    // One group per distinct range. The chain is first-match-wins, so a char in
    // two rules' overlapping ranges only reaches the first group covering it —
    // that group therefore carries every rule the range meets, not just the one
    // the range came from. A rule that cannot match simply fails its `try_`.
    let mut distinct_ranges: List<[char, char]> = [];
    let mut range_seen = TreeSet::<i64>::new();
    for let mut i = 0; i < calls.len(); i += 1 {
        if calls[i].is_wildcard {
            continue;
        }
        for let r of &calls[i].first_chars {
            if r[0] != r[1] && range_seen.insert(range_key(r[0], r[1])) {
                distinct_ranges.push(*r);
            }
        }
    }
    for let r of &distinct_ranges {
        let mut cs: List<i32> = [];
        for let mut j = 0; j < calls.len(); j += 1 {
            if calls[j].is_catch_all {
                continue;
            }
            if calls[j].is_wildcard || ranges_meet_unclaimed(&calls[j].first_chars, *r, &all_chars) {
                cs.push(j);
            }
        }
        groups.push(DispatchGroup {
            pattern: `${char_lit(r[0])}..=${char_lit(r[1])}`,
            calls: cs,
        });
    }

    coalesce_equal_groups(&mut groups);

    // The fallback branch. A single-char-only call is fully covered by its own
    // branch above; a range-based one can still admit a char no branch claims.
    let mut wildcard_calls: List<i32> = [];
    for let mut i = 0; i < calls.len(); i += 1 {
        if calls[i].is_wildcard {
            wildcard_calls.push(i);
            continue;
        }
        let mut has_range = false;
        for let r of &calls[i].first_chars {
            if r[0] != r[1] {
                has_range = true;
            }
        }
        if has_range {
            wildcard_calls.push(i);
        }
    }
    if !wildcard_calls.is_empty() {
        groups.push(DispatchGroup { pattern: String::from(FALLBACK_PATTERN), calls: wildcard_calls });
    }

    // Grammar order, so a same-length match goes to the first rule in the
    // grammar (ANTLR4's tie-break). Insertion order does not carry it.
    for let mut gi = 0; gi < groups.len(); gi += 1 {
        groups[gi].calls.sort();
    }

    return groups;
}

fn gen_dispatch_groups(
    w: &mut CodeWriter,
    calls: &List<TryCall>,
    groups: &List<DispatchGroup>,
    needs_extras: bool,
    has_actions: bool,
    has_members: bool,
) {
    // If only a wildcard group exists, emit calls directly without dispatch
    if groups.len() == 1 && groups[0].pattern == FALLBACK_PATTERN {
        gen_group_calls(w, calls, &groups[0].calls, needs_extras, has_actions, has_members);
        return;
    }
    let mut first_group = true;
    for let g of groups {
        let is_wc = g.pattern == FALLBACK_PATTERN;
        if is_wc {
            if first_group {
                gen_group_calls(w, calls, &g.calls, needs_extras, has_actions, has_members);
                continue;
            }
            w.else_begin(&"else");
        } else if first_group {
            w.begin(&`if first_char matches \{ ${g.pattern} \}`);
        } else {
            w.else_begin(&`else if first_char matches \{ ${g.pattern} \}`);
        }
        first_group = false;
        gen_group_calls(w, calls, &g.calls, needs_extras, has_actions, has_members);
    }
    if !first_group {
        w.end();
    }
}

fn gen_group_calls(
    w: &mut CodeWriter,
    calls: &List<TryCall>,
    indices: &List<i32>,
    needs_extras: bool,
    has_actions: bool,
    has_members: bool,
) {
    let ctx = if has_members { "&lexer" } else { "&lexer.chars" };
    // Uniform `try_*` call per candidate (keep the longest match). Single-char
    // literals are not hand-inlined — the wado compiler folds the tiny bodies.
    for let call_idx of indices {
        let call = &calls[*call_idx];
        w.line(&`end = ${call.fn_name}(${ctx}, start);`);
        // Under `has_actions` EVERY winner block reassigns `best_act` — the
        // rule's replay index, or -1 for a literal / non-action rule — so a
        // longer non-action match that supersedes an earlier action match does
        // not leave `best_act` pointing at the losing action rule.
        let act = if has_actions { ` best_act = ${call.act_index};` } else { String::new() };
        if needs_extras {
            w.line(&`if end > best_end \{ best_end = end; best_kind = ${call.token_kind};${call.extra}${act} \}`);
        } else {
            w.line(&`if end > best_end \{ best_end = end; best_kind = ${call.token_kind};${act} \}`);
        }
    }
}

/// Index of `name` in `names`, or -1. Small linear scan — the executed-action
/// rule list is short.
fn index_of_name(names: &List<String>, name: &String) -> i32 {
    for let mut i = 0; i < names.len(); i += 1 {
        if names[i] == *name {
            return i;
        }
    }
    return -1;
}

fn gen_tokenize_fn(
    w: &mut CodeWriter,
    lexer_rules: &List<LexerRule>,
    lit_tokens: &List<LitToken>,
    mode_names: &List<String>,
    keywords: &List<KeywordInfo>,
    grammar_opts: &List<GrammarOption>,
    act_rule_names: &List<String>,
    has_members: bool,
    sc_name: &String,
) {
    let has_actions = !act_rule_names.is_empty();
    let use_modes = has_modes(mode_names);
    // A lexer action may call `lx.more()` / `lx.set_channel(n)` / `lx.set_mode(m)`,
    // so an action grammar needs the `more_start` / `best_more` / `best_channel`
    // / `best_set_mode` commit machinery even when no rule carries the matching
    // `-> more` / `-> channel` / `-> mode` command. `set_mode` only applies in
    // a `mode` grammar, so its machinery is forced only under `use_modes`.
    let has_set_mode_rules = has_set_mode(lexer_rules) || has_actions && use_modes;
    let has_more_rules = has_more(lexer_rules) || has_actions;
    let has_channel_rules = has_channel(lexer_rules) || has_actions;
    let empty_opts: List<GrammarOption> = [];
    let grammar_ci = resolve_ci(grammar_opts, &empty_opts);

    let mut f = FnSpec::new("tokenize", Vis::Pub);
    f.add_param(&"input", &"&String");
    f.set_return_type(&"TokenStream");
    // `tokenize` calls the op-carrying `try_<rule>` fns, so it propagates the effect.
    if !sc_name.is_empty() {
        f.add_effect(sc_name);
    }
    f.emit_begin(w);
    w.line(&"let mut lexer = Lexer::new(input);");
    // Struct-of-arrays token storage: the lexer pushes flat i32s, never a
    // per-token aggregate. `triv_lo` marks where the current token's leading
    // trivia begins; it advances to the next mark after each emitted token.
    w.line(&"let mut ts = TokenStream::new(&lexer.chars);");
    w.line(&"let mut triv_lo = ts.trivia_mark();");

    if has_more_rules {
        // Tracks the start position of a pending `more` sequence; -1 means
        // no pending `more` data. When a non-`more` rule emits, it uses
        // `more_start` as the token start so the emitted text includes
        // all previously-`more`'d characters.
        w.line(&"let mut more_start: i32 = -1;");
    }

    if use_modes {
        w.line(&"let mut mode_stack: List<i32> = [];");
        w.line(&"let mut current_mode: i32 = 0;");
    }

    w.begin(&"while !lexer.at_end()");
    w.line(&"let start = lexer.pos;");
    w.line(&"let mut best_end: i32 = -1;");
    w.line(&"let mut best_kind: i32 = TK_ERROR;");
    w.line(&"let mut end: i32 = -1;");
    if has_actions {
        // Which winning rule's `apply_<rule>_actions` to replay post-tournament
        // (-1 = none). Set in the winner block alongside `best_end`/`best_kind`.
        w.line(&"let mut best_act: i32 = -1;");
        // Latched by an action's `lx.skip()` (no `best_skip` tournament var
        // exists — skip is otherwise decided by `best_kind`).
        w.line(&"let mut best_act_skip = false;");
    }
    w.line(&"let first_char = lexer.chars[start];");

    if use_modes {
        w.line(&"let mut best_push_mode: i32 = -1;");
        w.line(&"let mut best_pop_mode = false;");
    }
    if has_set_mode_rules {
        w.line(&"let mut best_set_mode: i32 = -1;");
    }
    if has_more_rules {
        w.line(&"let mut best_more = false;");
    }
    if has_channel_rules {
        w.line(&"let mut best_channel: i32 = 0;");
    }

    if use_modes {
        let mode_ctx = if has_members { "&lexer" } else { "&lexer.chars" };
        // Generate mode dispatch
        for let mut mi = 0; mi < mode_names.len(); mi += 1 {
            if mi == 0 {
                w.begin(&`if current_mode == ${mi}`);
            } else {
                w.else_begin(&`else if current_mode == ${mi}`);
            }
            // Literal tokens only in default mode
            if mi == 0 {
                for let lit of lit_tokens {
                    let fn_name = lit_try_fn_name(&lit.const_name);
                    w.line(&`end = ${fn_name}(${mode_ctx}, start);`);
                    let lit_reset = literal_command_extras(
                        lit,
                        lexer_rules,
                        grammar_opts,
                        grammar_ci,
                        true,
                        has_set_mode_rules,
                        has_more_rules,
                        has_channel_rules,
                    );
                    // A literal never runs an action; under `has_actions` its
                    // winner block still resets `best_act` to -1 so it cannot
                    // inherit an earlier action rule's index.
                    let lit_act = if has_actions { " best_act = -1;" } else { "" };
                    w.line(
                        &`if end > best_end \{ best_end = end; best_kind = ${lit.const_name};${lit_reset}${lit_act} \}`,
                    );
                }
            }
            for let rule of lexer_rules {
                if !rule.is_fragment
                    && !rule.is_virtual
                    && rule.mode == mi
                    && !is_keyword_rule_name(&rule.name, keywords)
                    && !is_literal_duplicate(rule, lit_tokens, grammar_opts, grammar_ci) {
                    let fn_name = lexer_try_fn_name(&rule.name);
                    w.line(&`end = ${fn_name}(${mode_ctx}, start);`);
                    let extra = best_state_extras(
                        rule.push_mode,
                        rule.pop_mode,
                        rule.set_mode,
                        rule.more,
                        rule.channel,
                        true,
                        has_set_mode_rules,
                        has_more_rules,
                        has_channel_rules,
                    );
                    // `type(X)` rewrites the emitted kind. The rule still has
                    // its own TK_<name> constant; the override only affects
                    // the emitted token.
                    let emit_kind = if let Some(override_name) = rule.type_override {
                        `TK_${override_name}`;
                    } else {
                        `TK_${rule.name}`;
                    };
                    // Under `has_actions` every winner block reassigns
                    // `best_act` (the replay index, or -1) so a longer non-action
                    // match cannot inherit an earlier action rule's index — see
                    // the modeless dispatch (`gen_group_calls`).
                    let act = if has_actions {
                        ` best_act = ${index_of_name(act_rule_names, &rule.name)};`;
                    } else {
                        String::new();
                    };
                    w.line(&`if end > best_end \{ best_end = end; best_kind = ${emit_kind};${extra}${act} \}`);
                }
            }
        }
        w.end();  // mode dispatch
    } else {
        // No modes — first-character dispatch
        let needs_extras = has_set_mode_rules || has_more_rules || has_channel_rules;
        let mut all_calls: List<TryCall> = [];
        for let lit of lit_tokens {
            let fn_name = lit_try_fn_name(&lit.const_name);
            let c = lit.text.chars().next().unwrap();
            let mut fc: List<[char, char]> = [];
            let mut fc_seen = TreeSet::<i64>::new();
            // Parser literals inherit grammar-level caseInsensitive. Under CI,
            // the literal's first char may appear in either case.
            add_folded_range(&mut fc, &mut fc_seen, c, c, grammar_ci);
            let tk = lit.const_name;
            let lit_extras = literal_command_extras(
                lit,
                lexer_rules,
                grammar_opts,
                grammar_ci,
                false,
                has_set_mode_rules,
                has_more_rules,
                has_channel_rules,
            );
            all_calls.push(TryCall {
                fn_name,
                token_kind: tk,
                extra: lit_extras,
                first_chars: fc,
                is_wildcard: false,
                is_catch_all: false,
            });
        }
        for let rule of lexer_rules {
            if !rule.is_fragment
                && !rule.is_virtual
                && !is_keyword_rule_name(&rule.name, keywords)
                && !is_literal_duplicate(rule, lit_tokens, grammar_opts, grammar_ci) {
                let mut call = build_rule_try_call(
                    rule,
                    lexer_rules,
                    false,
                    has_set_mode_rules,
                    has_more_rules,
                    has_channel_rules,
                    grammar_opts,
                );
                call.act_index = index_of_name(act_rule_names, &rule.name);
                all_calls.push(call);
            }
        }
        let groups = build_dispatch_groups(&all_calls);
        gen_dispatch_groups(w, &all_calls, &groups, needs_extras, has_actions, has_members);
    }

    // Keyword reclassification: check if the matched text is actually a keyword.
    // classify_keyword does length-based dispatch internally, so no first-char guard needed.
    if !keywords.is_empty() {
        w.begin(&"if best_end > start");
        w.line(&"let kw_kind = classify_keyword(&lexer.chars, start, best_end);");
        w.line(&"if kw_kind >= 0 { best_kind = kw_kind; }");
        w.end();
    }

    // A zero-length match (`best_end == start`) is legitimate when a rule
    // matches the empty string and switches mode — ANTLR4 issue #688 ("Lexer
    // cannot match zero-length tokens"). Such a match makes forward progress
    // only through the mode change, so accept it just when one is pending;
    // otherwise treating `best_end == start` as a match would spin the `while`
    // loop forever. With no modes a zero-length match can never progress, so
    // the strict `<= start` guard is kept.
    let no_match_guard = if use_modes {
        // `best_push_mode` / `best_pop_mode` always exist under `use_modes`;
        // `best_set_mode` only when the grammar has a `mode(X)` rule.
        let mut stalled = String::from("best_push_mode < 0 && !best_pop_mode");
        if has_set_mode_rules {
            stalled.push_str(&" && best_set_mode < 0");
        }
        `best_end < start || (best_end == start && ${stalled})`;
    } else {
        String::from("best_end <= start");
    };
    w.begin(&`if ${no_match_guard}`);
    emit_token_commit(w, &"TK_ERROR", &"start", &"start + 1");
    w.line(&"lexer.pos = start + 1;");
    w.else_begin(&"else");

    // Winner-replay: the chosen rule's `{ ... }` actions run once, here, on the
    // committed match — never for a losing candidate. Placed after keyword
    // reclassification so an explicit `set_type` wins, and before the
    // skip/more/channel commit so its effects (`best_kind`) feed them.
    if has_actions {
        gen_lexer_action_replay(w, act_rule_names, use_modes, has_set_mode_rules);
    }

    // `more` rules accumulate text into the next emitted token. `tok_start`
    // is the earliest start position of the current pending `more` chain,
    // or `start` if no `more` is pending.
    if has_more_rules {
        w.line(&"let tok_start = if more_start >= 0 { more_start } else { start };");
    } else {
        w.line(&"let tok_start = start;");
    }

    let skip_names: List<String> = lexer_rules.iter().filter(|rule: &LexerRule| rule.skip).map(
        |rule: &LexerRule| `TK_${rule.name}`,
    ).collect();
    // An action's `lx.skip()` latches `best_act_skip`; OR it into the
    // command-derived skip decision so either route routes the token to trivia.
    let act_skip = if has_actions { " || best_act_skip" } else { "" };
    if skip_names.is_empty() {
        w.line(&`let is_skip = false${act_skip};`);
    } else {
        w.write(&"let is_skip = best_kind matches { ");
        for let mut i = 0; i < skip_names.len(); i += 1 {
            if i > 0 {
                w.write(&" | ");
            }
            w.write(&skip_names[i]);
        }
        w.write(&` }${act_skip};\n`);
    }

    if has_more_rules {
        // A `more` match suppresses emission and remembers the starting
        // position so the next non-`more` match covers the full span.
        w.begin(&"if best_more");
        w.line(&"if more_start < 0 { more_start = start; }");
        w.else_begin(&"else if is_skip");
        w.line(&"ts.push_trivia(best_kind, tok_start, best_end, 0);");
        w.line(&"more_start = -1;");
        if has_channel_rules {
            // Non-default channels are invisible to the parser — route to
            // trivia with the channel id preserved. ANTLR4 treats any
            // non-DEFAULT channel the same way at the parser boundary.
            w.else_begin(&"else if best_channel != 0");
            w.line(&"ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
            w.line(&"more_start = -1;");
        }
        w.else_begin(&"else");
        emit_token_commit(w, &"best_kind", &"tok_start", &"best_end");
        w.line(&"more_start = -1;");
        w.end();
    } else {
        w.begin(&"if is_skip");
        w.line(&"ts.push_trivia(best_kind, tok_start, best_end, 0);");
        if has_channel_rules {
            // Non-default channels are invisible to the parser — route to
            // trivia with the channel id preserved. ANTLR4 treats any
            // non-DEFAULT channel the same way at the parser boundary.
            w.else_begin(&"else if best_channel != 0");
            w.line(&"ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
        }
        w.else_begin(&"else");
        emit_token_commit(w, &"best_kind", &"tok_start", &"best_end");
        w.end();
    }

    if use_modes {
        w.begin(&"if best_push_mode >= 0");
        w.line(&"mode_stack.push(current_mode);");
        w.line(&"current_mode = best_push_mode;");
        w.line(&"best_push_mode = -1;");
        w.end();
        w.begin(&"if best_pop_mode");
        w.begin(&"if mode_stack.is_empty()");
        w.line(&"current_mode = 0;");
        w.else_begin(&"else");
        w.line(&"current_mode = mode_stack[mode_stack.len() - 1];");
        w.line(&"mode_stack.pop();");
        w.end();
        w.line(&"best_pop_mode = false;");
        w.end();
        if has_set_mode_rules {
            // `mode(X)` replaces the current mode directly — no stack push.
            w.begin(&"if best_set_mode >= 0");
            w.line(&"current_mode = best_set_mode;");
            w.line(&"best_set_mode = -1;");
            w.end();
        }
    }

    w.line(&"lexer.pos = best_end;");
    w.end();  // else
    w.end();  // while
    // EOF sentinel: zero-length, carrying any trailing trivia. No reset
    // follows (the stream ends here), so this stays inline rather than
    // using `emit_token_commit`.
    w.line(&"ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());");
    if has_actions {
        w.line(&"ts.output = lexer.act_output;");
    }
    w.line(&"return ts;");
    w.end();  // fn
    w.blank();
}

/// Emit a default-channel token commit: push it with the pending leading-trivia
/// range `[triv_lo, trivia_mark())`, then reopen the range for the next token.
fn emit_token_commit(w: &mut CodeWriter, kind: &String, start: &String, end: &String) {
    w.line(&`ts.push_token(${*kind}, ${*start}, ${*end}, triv_lo, ts.trivia_mark());`);
    w.line(&"triv_lo = ts.trivia_mark();");
}

fn gen_token_kind_name_fn(w: &mut CodeWriter, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) {
    let mut f = FnSpec::new("token_kind_name", Vis::Pub);
    f.add_param(&"kind", &"i32");
    f.set_return_type(&"String");
    f.emit_begin(w);

    w.line(&"return match kind {");
    w.indent();
    for let rule of lexer_rules {
        if !rule.is_fragment {
            let trailer = if rule.is_virtual { "  // virtual" } else { "" };
            w.line(&`TK_${rule.name} => "${rule.name}",${trailer}`);
        }
    }
    w.line(&"TK_EOF => \"Eof\",");
    // Mirror the sentinel collapse in `gen_token_constants`: when the
    // user owns `TK_ERROR`, the rule's own arm covers it.
    if !rule_name_exists(lexer_rules, &"ERROR") {
        w.line(&"TK_ERROR => \"Error\",");
    }
    for let lit of lit_tokens {
        let name = lit.const_name;
        w.line(&`${name} => "${name}",`);
    }
    w.line(&"_ => \"Unknown\",");
    w.dedent();
    w.line(&"};");
    w.end();  // fn
    w.blank();
}
