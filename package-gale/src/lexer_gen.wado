/// A grammar literal rendered the way ANTLR4's vocabulary shows it: the source
/// form, single-quoted.
pub type LitName = String;

/// Tag `text` as a grammar literal's display name: `lit_name("+")` formats to
/// `'+'`. `LitToken.text` holds the literal with its escapes already resolved,
/// so this puts them back — a readable rendering, not a round-trip.
pub fn lit_name<S: AsStrSlice>(text: S) -> LitName {
    return text as LitName;
}

impl Display for LitName {
    pub fn fmt(&self, f: &mut Formatter) {
        f.write_str(wado`'${*self as String}'`);
    }
}

pub struct LitToken {
    pub text: String,
    pub const_name: String,
}

pub struct KeywordInfo {
    pub rule_name: String,
    /// As written, except that a char matched in both cases is lowercase.
    pub text: String,
    pub char_ci: List<bool>,
    /// The rule whose match `classify_keyword` reclassifies into this keyword.
    /// Filled by `collect_keyword_rules`, which only returns admitted
    /// candidates; empty on one still being considered.
    pub carrier: String = "",
}

/// ANTLR4 `caseInsensitive` resolution: a rule-level option (when present)
/// overrides the grammar-level option. ANTLR4 spec: `doc/options.md`.
fn lookup_ci_option(opts: &List<GrammarOption>) -> Option<bool> {
    for let opt of opts {
        if opt.name != "caseInsensitive" {
            continue;
        }
        if let Ident(v) = &opt.value {
            return Option::<bool>::Some(*v == "true");
        }
    }
    return null;
}

pub fn resolve_ci(grammar_opts: &List<GrammarOption>, rule_opts: &List<GrammarOption>) -> bool {
    if let Some(b) = lookup_ci_option(rule_opts) {
        return b;
    }
    if let Some(b) = lookup_ci_option(grammar_opts) {
        return b;
    }
    return false;
}

/// Expand one char range into the set of ranges needed to match it
/// case-insensitively. The original range is always included. When the range
/// intersects ASCII letters, the opposing-case sub-range is appended.
/// Non-letter chars are not folded (ANTLR4 only does one-length transforms).
/// Whether `start..=end`, widened as `fold_range_ci` widens it under `ci`,
/// holds `c`: the set's membership without building it.
pub fn folded_range_contains(start: char, end: char, ci: bool, c: char) -> bool {
    if start <= c <= end {
        return true;
    }
    if !ci || !c.is_ascii_alphabetic() {
        return false;
    }
    let partner = if c.is_ascii_lowercase() { c.to_ascii_uppercase() } else { c.to_ascii_lowercase() };
    return start <= partner <= end;
}

pub fn fold_range_ci(start: char, end: char, out: &mut List<CharRange>) {
    out.push(CharRange { start, end });
    if start <= 'z' && end >= 'a' {
        let lo = if start < 'a' { 'a' } else { start };
        let hi = if end > 'z' { 'z' } else { end };
        out.push(CharRange {
            start: lo.to_ascii_uppercase(),
            end: hi.to_ascii_uppercase(),
        });
    }
    if start <= 'Z' && end >= 'A' {
        let lo = if start < 'A' { 'A' } else { start };
        let hi = if end > 'Z' { 'Z' } else { end };
        out.push(CharRange {
            start: lo.to_ascii_lowercase(),
            end: hi.to_ascii_lowercase(),
        });
    }
}

pub fn collect_literal_tokens(parser_rules: &List<ParserRule>) -> List<LitToken> {
    let mut seen: List<String> = [];
    let mut result: List<LitToken> = [];
    for let rule of parser_rules {
        for let alt of &rule.alternatives {
            collect_lits_from_elements(&alt.elements, &mut seen, &mut result);
        }
    }
    return result;
}

/// `literal_const_name` spells symbols as words, so distinct literals (`'<'` /
/// `'LT'`) can share a base name. Later ones get a suffix (`TK_LIT_LT_2`), which
/// `resolve_kind_ids` stamps on the IR.
fn disambiguate_const_name<S: AsStrSlice>(base: S, result: &List<LitToken>) -> String {
    let mut candidate = base.to_string();
    let mut n = 2;
    while const_name_taken(result, &candidate) {
        candidate = `${base}_${n}`;
        n += 1;
    }
    return candidate;
}

fn const_name_taken<S: AsStrSlice>(result: &List<LitToken>, name: S) -> bool {
    return result.iter_ref().any(|lit| lit.const_name == name.as_str_slice());
}

fn collect_lits_from_elements(elements: &List<Element>, seen: &mut List<String>, result: &mut List<LitToken>) {
    for let elem of elements {
        collect_lits_from_element(elem, seen, result);
    }
}

fn collect_lits_from_element(elem: &Element, seen: &mut List<String>, result: &mut List<LitToken>) {
    match *elem {
        Literal(l) => {
            if !seen.contains_str(&l.text) {
                seen.push(l.text);
                let base = literal_const_name(&l.text);
                let const_name = disambiguate_const_name(&base, result);
                result.push(LitToken { text: l.text, const_name });
            }
        },
        Repeat(rep) => collect_lits_from_element(&rep.element, seen, result),
        Group(g) => {
            for let alt of &g.alternatives {
                collect_lits_from_elements(&alt.elements, seen, result);
            }
        },
        Label(lab) => collect_lits_from_element(&lab.element, seen, result),
        // `~ X` is a set-complement transformer. The literal `'x'` inside
        // still needs to be hoisted to an anonymous lexer token so the
        // runtime `match_not([TK_LIT_x])` call resolves. Without this arm
        // any parser-rule `~'x'` / `~('x'|'y')` emits a reference to an
        // undefined TK_LIT_x (Sets/ParserNotToken, Sets/ParserNotSet, …).
        Not(n) => collect_lits_from_element(&n.element, seen, result),
        _ => (),
    }
}

/// One position in the canonical token numbering: slot `i` of
/// `token_slot_order` is the token whose kind id is `i`.
pub variant TokenSlot {
    /// Index into the lexer-rule list (non-fragment).
    Rule(i32),
    /// The `TK_EOF` sentinel.
    Eof,
    /// The `TK_ERROR` no-match sentinel (absent when a user rule named
    /// `ERROR` claims the identifier).
    Error,
    /// Index into the literal-token list.
    Lit(i32),
}

/// The canonical token numbering, shared by every emitter that indexes by
/// token kind: `gen_token_constants` (the `TK_*` globals), the highlight
/// `defaults` capture table (indexed `defaults[kind]` at runtime), and the
/// ATN builder's `build_token_kinds`. Keeping them on one source prevents
/// the tables from drifting out of alignment.
///
/// Order mirrors ANTLR4's SemanticPipeline.assignLexerTokenTypes:
/// non-fragment rules WITHOUT a `more` / `type(...)` command get the low
/// token types in declaration order, then the `more` / `type` rules are
/// numbered (a rule that always `more`s never produces a parser-visible
/// token, so ANTLR4 pushes its type to the back). Then `TK_EOF`, then the
/// `TK_ERROR` sentinel — unless a user rule named `ERROR` claims the same
/// identifier (`ERROR : .;` is itself a catch-all aligned with the
/// sentinel's role; `EOF` stays uncollapsed as an ANTLR4-reserved
/// built-in). Literal tokens close the numbering.
pub fn token_slot_order(lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) -> List<TokenSlot> {
    let mut slots: List<TokenSlot> = [];
    for let want_deferred of [false, true] {
        for let mut i = 0; i < lexer_rules.len(); i += 1 {
            let rule = &lexer_rules[i];
            if rule.is_fragment {
                continue;
            }
            let deferred = rule.more || rule.type_override matches { Some(_) };
            if deferred != want_deferred {
                continue;
            }
            slots.push(TokenSlot::Rule(i));
        }
    }
    slots.push(TokenSlot::Eof);
    if !rule_name_exists(lexer_rules, "ERROR") {
        slots.push(TokenSlot::Error);
    }
    for let mut i = 0; i < lit_tokens.len(); i += 1 {
        slots.push(TokenSlot::Lit(i));
    }
    return slots;
}

pub fn gen_token_constants(w: &mut CodeWriter, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) {
    let slots = token_slot_order(lexer_rules, lit_tokens);
    let mut idx = 0;
    for let slot of &slots {
        let init = `${idx}`;
        match *slot {
            Rule(ri) => {
                let rule = &lexer_rules[ri];
                let name = `TK_${rule.name}`;
                let mut g = GlobalSpec::new(&name, "i32", &init, Vis::Pub);
                if rule.is_virtual {
                    g.set_trailing_comment("virtual");
                }
                g.emit(w);
            },
            Eof => GlobalSpec::new("TK_EOF", "i32", &init, Vis::Pub).emit(w),
            Error => GlobalSpec::new("TK_ERROR", "i32", &init, Vis::Pub).emit(w),
            Lit(li) => GlobalSpec::new(&lit_tokens[li].const_name, "i32", &init, Vis::Pub).emit(w),
        }
        idx += 1;
    }
    // `-> type(N)` (numeric) assigns the emitted token an explicit ANTLR4
    // type id of exactly N (vendor/antlr4/doc/lexer-rules.md). The lexer
    // body emits `TK_<N>`; we emit the matching global here with value
    // `N - 1` so `to_lexer_string`'s `kind + 1` remap round-trips to N.
    // `N == 0` would yield a negative kind clashing with `best_end = -1`
    // and is reserved as INVALID_TYPE upstream; skip it.
    let mut emitted_numeric: List<i32> = [];
    for let rule of lexer_rules {
        if rule.is_fragment {
            continue;
        }
        if let Some(target) = &rule.type_override {
            if let Some(n) = parse_token_type_numeric(target) {
                if n < 1 {
                    continue;
                }
                if rule_name_exists(lexer_rules, `${n}`) {
                    continue;
                }
                if emitted_numeric.contains(&n) {
                    continue;
                }
                GlobalSpec::new(`TK_${n}`, "i32", `${n - 1}`, Vis::Pub).emit(w);
                emitted_numeric.push(n);
            }
        }
    }
    w.blank();
}

/// Returns `Some(n)` when `s` is a non-negative base-10 integer that fits in
/// `i32` (the runtime token-kind type). Anything else — a token name, an
/// overflowing value, an empty string — returns `None` so the caller can
/// defer to the regular `TK_<name>` path.
fn parse_token_type_numeric<S: AsStrSlice>(s: S) -> Option<i32> {
    if s.is_empty() {
        return null;
    }
    let mut acc: i64 = 0;
    for let c of s.chars() {
        if c < '0' || c > '9' {
            return null;
        }
        acc = acc * 10 + (c as i32 - '0' as i32) as i64;
        if acc > i32::MAX as i64 {
            return null;
        }
    }
    return Option::<i32>::Some(acc as i32);
}

fn rule_name_exists<S: AsStrSlice>(lexer_rules: &List<LexerRule>, name: S) -> bool {
    return lexer_rules.iter_ref().any(|rule| !rule.is_fragment && rule.name == name.as_str_slice());
}

pub fn gen_lexer<S: AsStrSlice>(
    w: &mut CodeWriter,
    grammar: &Grammar,
    lit_tokens: &List<LitToken>,
    atn_class: &TreeMap<String, i32>,
    members: &MemberDecls,
    has_members: bool,
    sc_name: S,
    sc_ops: &List<SuperOp>,
    mode_use: &ModeAttrUse,
) {
    let empty_opts: List<GrammarOption> = [];
    let grammar_ci = resolve_ci(&grammar.options, &empty_opts);
    let keywords = collect_keyword_rules(&grammar.lexer_rules, &grammar.options);
    let routes = lexer_rule_routes(&grammar.lexer_rules, &keywords, lit_tokens, &grammar.options, grammar_ci, atn_class);
    // A superClass base is wired independently of the action language.
    let ea = lexer_grammar_executes_actions(grammar) || !sc_name.is_empty();
    let act_rule_names = executed_action_rule_names(grammar);
    let has_actions = !act_rule_names.is_empty();
    let uses_modes = has_modes(&grammar.mode_names);
    let surface = lexer_surface(grammar, members, sc_ops, mode_use);
    if !sc_name.is_empty() {
        gen_super_interface(w, sc_name, sc_ops);
    }
    gen_lexer_struct(w, members, &surface);
    if has_actions {
        if uses_modes {
            gen_mode_constants(w, &grammar.mode_names);
        }
        gen_lexer_apply_fns(w, grammar, has_members, sc_name);
    }
    gen_lexer_match_fns(
        w,
        &grammar.lexer_rules,
        &routes,
        &grammar.options,
        atn_class,
        ea,
        has_members,
        sc_name,
    );
    w.write_hoisted();
    gen_literal_match_fns(w, lit_tokens, grammar_ci, has_members);
    gen_keyword_classifier_fn(w, &keywords);
    gen_tokenize_fn(
        w,
        &grammar.lexer_rules,
        &routes,
        lit_tokens,
        &grammar.mode_names,
        &keywords,
        &grammar.options,
        &act_rule_names,
        has_members,
        sc_name,
        &surface,
    );
    gen_token_kind_name_fn(w, &grammar.lexer_rules, lit_tokens);
}

/// What the generated `Lexer` has to carry, and what turns each part on.
///
/// The parts have different producers: an effect is committed only by a rule
/// that runs actions, while the output sink is written by anything that prints —
/// an action, or a `@members` method. Spelled as a separate condition at each
/// emit site, those sets were never compared, and the one that had gained a
/// producer kept the narrower test: a members-only lexer got a method calling an
/// `emit` its struct did not carry. They are enumerated here instead, side by
/// side, where a part whose producers differ from its neighbour's is a
/// difference someone reads rather than one they have to remember.
pub struct LexerSurface {
    /// The commit latches (`act_type`, `act_skip`, …) and `reset_actions`.
    pub commit_latches: bool = false,
    /// The output sink: the `act_output` field and the `emit` method.
    pub sink: bool = false,
    /// `push_mode` / `pop_mode` / `set_mode` and the latches they write.
    pub mode_commands: bool = false,
    /// The current mode a `$mode` read answers with, seeded per token.
    pub current_mode: bool = false,
    /// The mode invariant repeated at the commit, for the one write that
    /// reaches the latch without passing a command method (`$mode = X`).
    pub mode_write_guard: bool = false,
    /// A base action op drives the lexer from the user's own module, so what it
    /// reaches has to be `pub`.
    pub base_driven: bool = false,
}

pub fn lexer_surface(
    grammar: &Grammar,
    members: &MemberDecls,
    sc_ops: &List<SuperOp>,
    mode_use: &ModeAttrUse,
) -> LexerSurface {
    let runs_actions = !executed_action_rule_names(grammar).is_empty();
    let modes = runs_actions && has_modes(&grammar.mode_names);
    return LexerSurface {
        commit_latches: runs_actions,
        sink: runs_actions || members_present(members),
        mode_commands: modes,
        current_mode: modes && mode_use.reads,
        mode_write_guard: modes && mode_use.writes,
        base_driven: sc_ops.iter_ref().any(|o: &SuperOp| !o.is_predicate),
    };
}

fn gen_lexer_struct(w: &mut CodeWriter, members: &MemberDecls, surface: &LexerSurface) {
    let vis = if surface.base_driven { Vis::Pub } else { Vis::Private };
    let mut s = StructSpec::new("Lexer", vis);
    s.add_field("chars", "List<char>");
    s.add_field("pos", "i32");
    for let mf of &members.fields {
        s.add_field_default(&mf.name, &mf.ty, &mf.init);
    }
    if surface.sink {
        s.add_field_default("act_output", "String", "\"\"");
    }
    if surface.commit_latches {
        s.add_field_default("act_type", "i32", "-1");
        s.add_field_default("act_channel", "i32", "-1");
        s.add_field_default("act_skip", "bool", "false");
        s.add_field_default("act_more", "bool", "false");
    }
    if surface.mode_commands {
        s.add_field_default("act_push_mode", "i32", "-1");
        s.add_field_default("act_pop_mode", "bool", "false");
        s.add_field_default(&LEXER_SET_MODE_FIELD, "i32", "-1");
        // ANTLR's `_modeStack.size()`, which a base branches on.
        s.add_field_default("act_mode_depth", "i32", "0");
    }
    if surface.current_mode {
        // ANTLR's `_mode`: the mode the token is being matched in, seeded per
        // token. Only a body that reads `$mode` needs it.
        s.add_field_default(&LEXER_MODE_FIELD, "i32", "0");
    }
    s.emit(w);
    w.blank();

    ImplSpec::new("Lexer").emit_begin(w);

    let mut f = FnSpec::new("new");
    f.add_generic("S: AsStrSlice");
    f.add_param("input", "S");
    f.set_return_type("Lexer");
    f.emit_begin(w);
    w.line("return Lexer { chars: input.to_chars(), pos: 0 };");
    w.end();
    w.blank();

    let mut f2 = FnSpec::new("at_end");
    f2.set_receiver("&self");
    f2.set_return_type("bool");
    f2.emit_begin(w);
    w.line("return self.pos >= self.chars.len();");
    w.end();

    if surface.commit_latches {
        gen_lexer_action_methods(w, surface, vis);
    } else if surface.sink {
        gen_lexer_emit_fn(w, vis);
    }

    for let m of &members.methods {
        w.blank();
        w.line(&m.source);
    }

    w.end();  // impl
    w.blank();
}

/// The output sink every translated `print` writes. Deliberately outside
/// `reset_actions`: the sink is the whole run's output, not one token's.
fn gen_lexer_emit_fn(w: &mut CodeWriter, vis: Vis) {
    w.blank();
    let mut fe = FnSpec::new("emit", vis);
    fe.set_receiver("&mut self");
    fe.add_param("s", "String");
    fe.emit_begin(w);
    w.line("self.act_output.push_str(&s);");
    w.end();
}

fn gen_lexer_action_methods(w: &mut CodeWriter, surface: &LexerSurface, vis: Vis) {
    gen_lexer_emit_fn(w, vis);
    w.blank();

    // The type / channel latches are seeded with what the tournament decided, so
    // an action reading `$type` sees the token's current type as ANTLR's would,
    // and one that writes neither leaves the outcome unchanged.
    let mut fr = FnSpec::new("reset_actions");
    fr.set_receiver("&mut self");
    fr.add_param("kind", "i32");
    fr.add_param("channel", "i32");
    if surface.mode_commands {
        fr.add_param("depth", "i32");
        if surface.current_mode {
            fr.add_param("mode", "i32");
        }
    }
    fr.emit_begin(w);
    w.line("self.act_type = kind;");
    w.line("self.act_channel = channel;");
    w.line("self.act_skip = false;");
    w.line("self.act_more = false;");
    if surface.mode_commands {
        w.line("self.act_push_mode = -1;");
        w.line("self.act_pop_mode = false;");
        w.line(`self.${LEXER_SET_MODE_FIELD} = -1;`);
        w.line("self.act_mode_depth = depth;");
        if surface.current_mode {
            w.line(`self.${LEXER_MODE_FIELD} = mode;`);
        }
    }
    w.end();
    w.blank();

    lexer_setter(w, "set_type", "t", "act_type", vis);
    w.blank();
    lexer_setter(w, "set_channel", "c", "act_channel", vis);
    w.blank();
    lexer_flag(w, "skip", "act_skip", vis);
    w.blank();
    lexer_flag(w, "more", "act_more", vis);

    if surface.mode_commands {
        w.blank();
        gen_lexer_mode_commands(w, vis, surface);
    }
}

/// The mode commands. Each is a single latch the commit applies once per token,
/// in a fixed push-pop-set order — hence the guard, which sees every command
/// issued before it. A `$mode` assignment writes the set latch without passing
/// one, so where a grammar has that spelling the commit repeats the invariant
/// over the latches themselves.
///
/// A command also moves the current mode `$mode` reads, as ANTLR's `mode(X)` /
/// `pushMode(X)` do. `set_mode` needs no write of its own — its latch is what
/// the reader answers with first — and `pop_mode` cannot make one: its restored
/// mode lives on the tokenize loop's stack and not on the `Lexer`. It clears the
/// field instead, so a read after it fails loudly rather than answering the mode
/// just left.
fn gen_lexer_mode_commands(w: &mut CodeWriter, vis: Vis, surface: &LexerSurface) {
    let mut fp = FnSpec::new("push_mode", vis);
    fp.set_receiver("&mut self");
    fp.add_param("m", "i32");
    fp.emit_begin(w);
    gen_one_mode_command_assert(w);
    w.line("self.act_push_mode = m;");
    w.line("self.act_mode_depth += 1;");
    gen_current_mode_write(w, surface, "m");
    w.end();
    w.blank();

    let mut fo = FnSpec::new("pop_mode", vis);
    fo.set_receiver("&mut self");
    fo.emit_begin(w);
    gen_one_mode_command_assert(w);
    w.line("self.act_pop_mode = true;");
    w.line("self.act_mode_depth -= 1;");
    gen_current_mode_write(w, surface, "-1");
    w.end();
    w.blank();

    let mut fs = FnSpec::new("set_mode", vis);
    fs.set_receiver("&mut self");
    fs.add_param("m", "i32");
    fs.emit_begin(w);
    gen_one_mode_command_assert(w);
    w.line(`self.${LEXER_SET_MODE_FIELD} = m;`);
    w.end();
    w.blank();

    if surface.current_mode {
        gen_current_mode_reader(w, vis);
        w.blank();
    }
    lexer_reader(w, "mode_depth", "act_mode_depth", vis);
}

fn gen_current_mode_write<S: AsStrSlice>(w: &mut CodeWriter, surface: &LexerSurface, value: S) {
    if surface.current_mode {
        w.line(`self.${LEXER_MODE_FIELD} = ${value};`);
    }
}

/// What `$mode` reads: the mode this token is being matched in, moved by any
/// command the action has already issued. A `$mode` assignment reaches the set
/// latch without passing a command method, so the pending switch answers first —
/// `$mode = X` and `lx.set_mode(X)` are one write, and a read after either sees
/// `X`. The assert covers the one mode the `Lexer` cannot name — `pop_mode`'s
/// restore target.
fn gen_current_mode_reader(w: &mut CodeWriter, vis: Vis) {
    let mut f = FnSpec::new(&LEXER_MODE_READER, vis);
    f.set_receiver("&self");
    f.set_return_type("i32");
    f.emit_begin(w);
    w.line(`if self.${LEXER_SET_MODE_FIELD} >= 0 { return self.${LEXER_SET_MODE_FIELD}; }`);
    w.line(
        `assert self.${LEXER_MODE_FIELD} >= 0, "\$mode after pop_mode reads a mode only the mode stack holds";`,
    );
    w.line(`return self.${LEXER_MODE_FIELD};`);
    w.end();
}

fn gen_one_mode_command_assert(w: &mut CodeWriter) {
    w.line(
        `assert self.act_push_mode < 0 && !self.act_pop_mode && self.${LEXER_SET_MODE_FIELD} < 0, "a lexer action may issue at most one mode command per token";`,
    );
}

fn lexer_reader<S: AsStrSlice, S1: AsStrSlice>(w: &mut CodeWriter, name: S, field: S1, vis: Vis) {
    let mut f = FnSpec::new(name, vis);
    f.set_receiver("&self");
    f.set_return_type("i32");
    f.emit_begin(w);
    w.line(`return self.${field};`);
    w.end();
}

fn lexer_setter<S: AsStrSlice, S1: AsStrSlice, S2: AsStrSlice>(
    w: &mut CodeWriter,
    name: S,
    arg: S1,
    field: S2,
    vis: Vis,
) {
    let mut f = FnSpec::new(name, vis);
    f.set_receiver("&mut self");
    f.add_param(arg, "i32");
    f.emit_begin(w);
    w.line(`self.${field} = ${arg};`);
    w.end();
}

fn lexer_flag<S: AsStrSlice, S1: AsStrSlice>(w: &mut CodeWriter, name: S, field: S1, vis: Vis) {
    let mut f = FnSpec::new(name, vis);
    f.set_receiver("&mut self");
    f.emit_begin(w);
    w.line(`self.${field} = true;`);
    w.end();
}

fn gen_lexer_match_fns<S: AsStrSlice>(
    w: &mut CodeWriter,
    lexer_rules: &List<LexerRule>,
    routes: &List<LexerRuleRoute>,
    grammar_opts: &List<GrammarOption>,
    atn_class: &TreeMap<String, i32>,
    ea: bool,
    hm: bool,
    sc_name: S,
) {
    check_lexer_calls_resolve(lexer_rules, routes, atn_class);
    let plans = lexer_matcher_plans(lexer_rules, routes, grammar_opts, atn_class);
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        if routes[i].has_match_fn() {
            gen_lexer_match_fn(
                w,
                &lexer_rules[i],
                &plans.rules[i],
                lexer_rules,
                grammar_opts,
                atn_class,
                ea,
                hm,
                sc_name,
            );
        }
    }
    for let frag of &plans.fragments {
        gen_lexer_fragment_fn(w, frag, lexer_rules, ea, hm, sc_name);
    }
}

fn gen_lexer_fragment_fn<S: AsStrSlice>(
    w: &mut CodeWriter,
    frag: &LexerFragmentFn,
    all_rules: &List<LexerRule>,
    ea: bool,
    hm: bool,
    sc_name: S,
) {
    let Some(rule) = find_fragment(all_rules, &frag.key.name) else {
        panic("a fragment matcher names no fragment");
    };
    begin_lexer_matcher(w, &frag.key.fn_name(), rule, all_rules, hm, sc_name);
    end_lexer_matcher(w, rule, &frag.plan, all_rules, frag.key.ci, ea, hm);
}

/// Open a matcher `fn_name(chars, start) -> i32` over `rule`'s text.
fn begin_lexer_matcher<S: AsStrSlice, S1: AsStrSlice>(
    w: &mut CodeWriter,
    fn_name: S,
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    hm: bool,
    sc_name: S1,
) {
    let mut f = FnSpec::new(fn_name);
    if hm {
        f.add_param("lx", "&Lexer");
    } else {
        f.add_param("chars", "&List<char>");
    }
    f.add_param("start", "i32");
    f.set_return_type("i32");
    // A `Foo::op(LexerView { chars, .. })` call in the body is what makes the
    // generated function carry `with Foo`.
    if !sc_name.is_empty() && lexer_rule_match_calls_super(rule, all_rules, sc_name) {
        f.add_effect(sc_name);
    }
    f.emit_begin(w);
    if hm {
        w.line("let chars = &lx.chars;");
    }
}

/// Emit `rule`'s body under `plan` and close the matcher, returning the end.
fn end_lexer_matcher(
    w: &mut CodeWriter,
    rule: &LexerRule,
    plan: &LexerBodyPlan,
    all_rules: &List<LexerRule>,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    w.line("let mut pos = start;");
    gen_lexer_body(w, &rule.body, plan, all_rules, "return -1", ci, ea, hm, false);
    w.line("return pos;");
    w.end();
    w.blank();
}

/// Which matcher covers a lexer rule's text. `has_match_fn` reduces it to
/// whether the rule gets a `try_` matcher of its own.
pub variant LexerRuleRoute {
    /// Own `try_` matcher, reached from the first-char dispatch.
    Matcher,
    /// A `tokens { }` entry: no text, so nothing to match.
    Virtual,
    /// Non-recursive fragment: a `frag_` matcher per case folding and tail
    /// position its references need (`lexer_fragment_fns`).
    CalledFragment,
    /// Non-recursive fragment carrying a predicate or an action, which read the
    /// caller's state: inlined into each rule that references it.
    InlinedFragment,
    /// Recursive fragment: reached by call, so it keeps its own matcher.
    RecursiveFragment,
    /// Recursive fragment only `latn_match` reaches, so no matcher calls it.
    Unreached,
    /// Folded into the keyword classifier, which rewrites the carrier rule's
    /// match into this keyword.
    Keyword(LexerKeywordRoute),
    /// Same fixed text as a parser literal, so the shared literal matcher
    /// covers it.
    SharedLiteral(LexerLiteralRoute),
    /// Earlier rules take every match it could make, so it never wins.
    Subsumed(LexerSubsumedRoute),
}

pub struct LexerSubsumedRoute {
    pub by: List<String>,
    /// As `LexerKeywordRoute::also_matcher`.
    pub also_matcher: bool = false,
}

pub struct LexerKeywordRoute {
    pub carrier: String,
    /// A rule an emitted matcher calls keeps a `try_` matcher on top of the
    /// classifier shortcut.
    pub also_matcher: bool = false,
}

pub struct LexerLiteralRoute {
    pub const_name: String,
    /// As `LexerKeywordRoute::also_matcher`.
    pub also_matcher: bool = false,
}

impl LexerRuleRoute {
    /// Whether the first-char dispatch calls the rule's own matcher.
    pub fn is_dispatched(&self) -> bool {
        return self matches { Matcher };
    }

    /// Whether the rule gets its own `try_` matcher.
    pub fn has_match_fn(&self) -> bool {
        return match self {
            Matcher | RecursiveFragment => true,
            Virtual | CalledFragment | InlinedFragment | Unreached => false,
            Keyword(k) => k.also_matcher,
            SharedLiteral(l) => l.also_matcher,
            Subsumed(s) => s.also_matcher,
        };
    }
}

/// Every lexer rule's route, by declaration index. `atn_class` names the rules
/// matched by `latn_match`, whose bodies call no `try_` matcher.
pub fn lexer_rule_routes(
    lexer_rules: &List<LexerRule>,
    keywords: &List<KeywordInfo>,
    lit_tokens: &List<LitToken>,
    grammar_opts: &List<GrammarOption>,
    grammar_ci: bool,
    atn_class: &TreeMap<String, i32>,
) -> List<LexerRuleRoute> {
    let mut routes: List<LexerRuleRoute> = [];
    for let rule of lexer_rules {
        let route = lexer_rule_route(rule, &routes, lexer_rules, keywords, lit_tokens, grammar_opts, grammar_ci);
        routes.push(route);
    }
    let called = statically_called_rules(lexer_rules, &routes, atn_class);
    for let mut i = 0; i < routes.len(); i += 1 {
        routes[i] = route_with_callers(routes[i], called.contains(&lexer_rules[i].name));
    }
    return routes;
}

/// The rules whose `try_` matcher an emitted matcher calls: reached from the
/// dispatched rules through every body emitted statically.
fn statically_called_rules(
    lexer_rules: &List<LexerRule>,
    routes: &List<LexerRuleRoute>,
    atn_class: &TreeMap<String, i32>,
) -> List<String> {
    let mut emitted: List<String> = [];
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let name = &lexer_rules[i].name;
        if routes[i].is_dispatched() && !atn_class.contains_key_str(name) {
            emitted.push(*name);
        }
    }
    let mut called: List<String> = [];
    for let mut k = 0; k < emitted.len(); k += 1 {
        let Some(rule) = find_lexer_rule(lexer_rules, &emitted[k]) else {
            panic("an emitted matcher names no rule");
        };
        for let name of &lexer_rule_calls(rule, lexer_rules) {
            if called.contains(name) {
                continue;
            }
            called.push(*name);
            if !atn_class.contains_key_str(name) && !emitted.contains(name) {
                emitted.push(*name);
            }
        }
    }
    return called;
}

fn route_with_callers(route: LexerRuleRoute, called: bool) -> LexerRuleRoute {
    return match route {
        RecursiveFragment => if called { route } else { LexerRuleRoute::Unreached },
        Keyword(k) => LexerRuleRoute::Keyword(LexerKeywordRoute { ..k, also_matcher: called }),
        SharedLiteral(l) => LexerRuleRoute::SharedLiteral(LexerLiteralRoute { ..l, also_matcher: called }),
        Subsumed(s) => LexerRuleRoute::Subsumed(LexerSubsumedRoute { ..s, also_matcher: called }),
        Matcher | Virtual | CalledFragment | InlinedFragment | Unreached => route,
    };
}

/// `rule`'s route, given the routes of the rules declared before it.
fn lexer_rule_route(
    rule: &LexerRule,
    earlier: &List<LexerRuleRoute>,
    lexer_rules: &List<LexerRule>,
    keywords: &List<KeywordInfo>,
    lit_tokens: &List<LitToken>,
    grammar_opts: &List<GrammarOption>,
    grammar_ci: bool,
) -> LexerRuleRoute {
    if rule.is_virtual {
        return LexerRuleRoute::Virtual;
    }
    if rule.is_fragment {
        return if fragment_is_recursive(rule, lexer_rules) {
            LexerRuleRoute::RecursiveFragment;
        } else if fragment_is_callable(rule, lexer_rules) {
            LexerRuleRoute::CalledFragment;
        } else {
            LexerRuleRoute::InlinedFragment;
        };
    }
    for let kw of keywords {
        if kw.rule_name == rule.name {
            return LexerRuleRoute::Keyword(LexerKeywordRoute { carrier: kw.carrier });
        }
    }
    if let Some(const_name) = literal_duplicate_const(rule, lexer_rules, lit_tokens, grammar_opts, grammar_ci) {
        return LexerRuleRoute::SharedLiteral(LexerLiteralRoute { const_name });
    }
    let by = lexer_rule_subsumers(rule, earlier, lexer_rules);
    if !by.is_empty() {
        return LexerRuleRoute::Subsumed(LexerSubsumedRoute { by });
    }
    return LexerRuleRoute::Matcher;
}

/// The earlier rules that make every match `rule` could make, so it never wins
/// the tie. Empty unless the grammar's shape shows it.
fn lexer_rule_subsumers(rule: &LexerRule, earlier: &List<LexerRuleRoute>, lexer_rules: &List<LexerRule>) -> List<String> {
    let index = earlier.len();
    assert lexer_rules[index].name == rule.name, "routes are derived in declaration order";
    let mut refs: List<String> = [];
    if lexer_alts_are_rule_refs(&rule.body, &mut refs) {
        let mut by: List<String> = [];
        for let name of &refs {
            if !lexer_rule_outranks(name, rule.mode, earlier, lexer_rules) {
                return [];
            }
            if !by.contains(name) {
                by.push(*name);
            }
        }
        return by;
    }
    for let mut i = 0; i < index; i += 1 {
        let prior = &lexer_rules[i];
        if prior.body.iter_ref().any(|alt| lexer_alt_offers_whole(alt, &rule.name))
            && lexer_rule_outranks(&prior.name, rule.mode, earlier, lexer_rules) {
            return [prior.name];
        }
    }
    return [];
}

/// Whether every alternative is one rule reference, reading through a group
/// that is an alternative's only element.
fn lexer_alts_are_rule_refs(alts: &List<LexerAlternative>, out: &mut List<String>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        match &alt.elements[0] {
            RuleRef(name) => out.push(*name),
            Group(inner) => {
                if !lexer_alts_are_rule_refs(inner, out) {
                    return false;
                }
            },
            _ => {
                return false;
            },
        }
    }
    return !alts.is_empty();
}

/// Whether `alt` can match exactly what rule `name` matches: it opens with
/// `name` or a group offering it as an arm, and everything after is optional.
fn lexer_alt_offers_whole(alt: &LexerAlternative, name: &String) -> bool {
    if alt.elements.is_empty() {
        return false;
    }
    let offers = match &alt.elements[0] {
        RuleRef(n) => n == name,
        Group(arms) => arms.iter_ref().any(|a| a.elements.len() == 1
            && a.elements[0] matches { RuleRef(n) && n == *name }),
        _ => false,
    };
    let rest_optional = (1..<alt.elements.len()).all(
        |i| alt.elements[i] matches { Repeat(r) && r.kind matches { Optional | Star } },
    );
    return offers && rest_optional;
}

/// Whether token rule `name` is one of the `earlier` rules, dispatched in
/// `mode`, and matches whatever its body does: no predicate can refuse it.
fn lexer_rule_outranks(name: &String, mode: i32, earlier: &List<LexerRuleRoute>, lexer_rules: &List<LexerRule>) -> bool {
    let Some(at) = lexer_rules.iter_ref().position(|r| r.name == *name) else {
        return false;
    };
    if at >= earlier.len() {
        return false;
    }
    let prior = &lexer_rules[at];
    if prior.mode != mode || prior.is_fragment || !earlier[at].is_dispatched() {
        return false;
    }
    let mut preds: List<i32> = [];
    collect_lexer_predicate_ids(prior, lexer_rules, &mut preds);
    return preds.is_empty();
}

/// Every `try_` call the emitter is about to make resolves to a matcher.
///
/// A rule reference lowers to a call by name, while which rules get a matcher is
/// decided separately. A mismatch would otherwise reach the user as `unknown
/// function 'try_X'` against generated source, with no way back to the rule that
/// asked for it — so it is caught here, where the names are still in hand.
fn check_lexer_calls_resolve(
    lexer_rules: &List<LexerRule>,
    routes: &List<LexerRuleRoute>,
    atn_class: &TreeMap<String, i32>,
) {
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let caller = &lexer_rules[i];
        if !emits_static_matcher(&routes[i], caller, atn_class) {
            continue;
        }
        for let name of &lexer_rule_calls(caller, lexer_rules) {
            let target = lexer_rules.iter_ref().position(|r| r.name == *name);
            if !target matches { Some(t) && routes[t].has_match_fn() } {
                panic(
                    `lexer rule '${caller.name}' calls ${lexer_try_fn_name(name)}, but '${*name}' has no matcher`,
                );
            }
        }
    }
}

/// Whether `rule` gets a `try_` matcher whose body is emitted here rather than
/// delegated to `latn_match`.
fn emits_static_matcher(route: &LexerRuleRoute, rule: &LexerRule, atn_class: &TreeMap<String, i32>) -> bool {
    return route.has_match_fn() && !atn_class.contains_key_str(&rule.name);
}

/// The rules `rule`'s emitted body calls by their `try_` matcher, reading
/// through the non-recursive fragments emitted along with it.
fn lexer_rule_calls(rule: &LexerRule, all_rules: &List<LexerRule>) -> List<String> {
    let mut out: List<String> = [];
    for let alt of &rule.body {
        for let elem of &alt.elements {
            collect_lexer_calls(elem, all_rules, &mut out);
        }
    }
    return out;
}

/// Names `elem` reaches through a `try_` call, matching the `RuleRef` arm of
/// `gen_lexer_leaf`.
fn collect_lexer_calls(elem: &LexerElement, all_rules: &List<LexerRule>, out: &mut List<String>) {
    match *elem {
        RuleRef(name) => {
            if name == "EOF" {
                return;
            }
            if let Some(f) = find_fragment(all_rules, &name) {
                if !fragment_is_recursive(f, all_rules) {
                    for let alt of &f.body {
                        for let e of &alt.elements {
                            collect_lexer_calls(e, all_rules, out);
                        }
                    }
                    return;
                }
            }
            if !out.contains(&name) {
                out.push(name);
            }
        },
        Group(alts) => {
            for let alt of &alts {
                for let e of &alt.elements {
                    collect_lexer_calls(e, all_rules, out);
                }
            }
        },
        Repeat(rep) => collect_lexer_calls(&rep.element, all_rules, out),
        Not(not_elem) => collect_lexer_calls(&not_elem.element, all_rules, out),
        _ => {
        },
    }
}

/// Whether a non-recursive fragment can be reached through a `frag_` matcher:
/// a predicate or an action reads the caller's `start`, so it must be inlined.
fn fragment_is_callable(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    return !rule.body.iter_ref().any(
        |a| lexer_alt_has_predicate_below(a, all_rules) || lexer_alt_has_any_action(a, all_rules),
    );
}

/// Rewrite each group or fragment reference hiding a contested alternation from
/// what follows it, so the alternation scores its arms against that suffix.
pub fn splice_suffixed_alternations(grammar: &mut Grammar) {
    let rules = grammar.lexer_rules;
    for let rule of &mut grammar.lexer_rules {
        for let alt of &mut rule.body {
            splice_alt(alt, &rules);
        }
    }
}

fn splice_alt(alt: &mut LexerAlternative, rules: &List<LexerRule>) {
    // Re-reading `i` after a splice reaches what the splice exposed, which a
    // nested group's own last element may now be followed by.
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        splice_within(&mut alt.elements[i], rules);
        if i + 1 == alt.elements.len() {
            continue;
        }
        let Some(inner) = spliced_elements(&alt.elements[i], rules) else {
            continue;
        };
        let added = inner.len() - 1;
        for let a of &mut alt.actions {
            if a.before_index > i {
                a.before_index += added;
            }
        }
        let mut spliced: List<LexerElement> = [];
        for let mut j = 0; j < alt.elements.len(); j += 1 {
            if j == i {
                spliced.extend(&inner);
            } else {
                spliced.push(alt.elements[j]);
            }
        }
        alt.elements = spliced;
        i -= 1;
    }
}

fn splice_within(elem: &mut LexerElement, rules: &List<LexerRule>) {
    match elem {
        Group(arms) => {
            for let arm of arms {
                splice_alt(arm, rules);
            }
        },
        Repeat(rep) => splice_within(&mut rep.element, rules),
        _ => {
        },
    }
}

/// The elements `elem` stands for in its sequence, when a contested alternation
/// sits at its end: a single alternative's own, or a fragment body as a group.
fn spliced_elements(elem: &LexerElement, rules: &List<LexerRule>) -> Option<List<LexerElement>> {
    let body = match elem {
        Group(arms) => *arms,
        RuleRef(name) => match find_fragment(rules, name) {
            Some(f) && !fragment_is_recursive(f, rules) => f.body,
            _ => {
                return null;
            },
        },
        _ => {
            return null;
        },
    };
    if body.len() == 1 && body[0].actions.is_empty() && seq_ends_contested(&body[0], rules) {
        return Option::Some(body[0].elements);
    }
    // Read folded: a splice rewrites to an equal sequence, so reading wide only
    // splices more.
    if elem matches { RuleRef(_) } && lexer_alts_contested(&body, rules, /*ci=*/ true) {
        return Option::Some([LexerElement::Group(body)]);
    }
    return null;
}

fn seq_ends_contested(seq: &LexerAlternative, rules: &List<LexerRule>) -> bool {
    if seq.elements.is_empty() {
        return false;
    }
    let last = &seq.elements[seq.elements.len() - 1];
    if let Group(arms) = last && lexer_alts_contested(arms, rules, /*ci=*/ true) {
        return true;
    }
    return spliced_elements(last, rules) matches { Some(_) };
}

/// Whether an alternation takes the longest arm and two arms can match the same text.
pub fn lexer_alts_contested(arms: &List<LexerAlternative>, rules: &List<LexerRule>, ci: bool) -> bool {
    return arms.len() >= 2
        && lexer_alts_scan(arms, rules) matches { Longest }
        && lexer_alts_can_collide(arms, rules, ci);
}

/// Whether a fragment references itself (directly or through another
/// fragment), which is what keeps it from being inlined at its use sites.
pub fn fragment_is_recursive(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    let mut visited: List<String> = [];
    return fragment_refs_self(&rule.name, &rule.body, all_rules, &mut visited);
}

fn fragment_refs_self<S: AsStrSlice>(
    target: S,
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    visited: &mut List<String>,
) -> bool {
    for let alt of alts {
        for let elem of &alt.elements {
            if fragment_elem_refs_self(target, elem, all_rules, visited) {
                return true;
            }
        }
    }
    return false;
}

fn fragment_elem_refs_self<S: AsStrSlice>(
    target: S,
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    visited: &mut List<String>,
) -> bool {
    match *elem {
        RuleRef(name) => {
            if name == target.as_str_slice() {
                return true;
            }
            if visited.contains_str(&name) {
                return false;
            }
            visited.push(name);
            let frag = find_fragment(all_rules, &name);
            if let Some(f) = frag {
                return fragment_refs_self(target, &f.body, all_rules, visited);
            }
            return false;
        },
        Group(alts) => {
            return fragment_refs_self(target, &alts, all_rules, visited);
        },
        Repeat(rep) => {
            return fragment_elem_refs_self(target, &rep.element, all_rules, visited);
        },
        Not(not_elem) => {
            return fragment_elem_refs_self(target, &not_elem.element, all_rules, visited);
        },
        _ => {
            return false;
        },
    }
}

/// Generated scanner-function name for the lexer rule called `name`.
/// The rule name is used verbatim (case-preserved): lexer rule names are
/// g4 identifiers, so `try_<name>` is always a valid Wado identifier, and
/// preserving case keeps distinct rules distinct (`ID` vs `Id` →
/// `try_ID` / `try_Id`) without any collision-resolution bookkeeping.
/// Single source of truth so every emit site agrees on the name.
pub fn lexer_try_fn_name<S: AsStrSlice>(name: S) -> String {
    return `try_${name}`;
}

/// Whether some lexer rule reaches `rule` through its `try_` matcher, which is
/// then never in tail position: the caller's suffix is still to consume.
pub fn lexer_rule_is_called(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    if rule.is_fragment && !fragment_is_recursive(rule, all_rules) {
        return false;
    }
    for let other of all_rules {
        for let alt of &other.body {
            if lexer_alt_refs_rule(alt, &rule.name) {
                return true;
            }
        }
    }
    return false;
}

fn lexer_alt_refs_rule<S: AsStrSlice>(alt: &LexerAlternative, name: S) -> bool {
    return alt.elements.iter_ref().any(|e| lexer_elem_refs_rule(e, name));
}

fn lexer_elem_refs_rule<S: AsStrSlice>(elem: &LexerElement, name: S) -> bool {
    return match *elem {
        RuleRef(n) => n == name.as_str_slice(),
        Group(alts) => {
            for let a of &alts {
                if lexer_alt_refs_rule(a, name) {
                    return true;
                }
            }
            false;
        },
        Repeat(rep) => lexer_elem_refs_rule(&rep.element, name),
        Not(n) => lexer_elem_refs_rule(&n.element, name),
        _ => false,
    };
}

fn gen_lexer_match_fn<S: AsStrSlice>(
    w: &mut CodeWriter,
    rule: &LexerRule,
    plan: &Option<LexerBodyPlan>,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    atn_class: &TreeMap<String, i32>,
    ea: bool,
    hm: bool,
    sc_name: S,
) {
    gen_visibility_comment(w, &rule.visibility);
    begin_lexer_matcher(w, &lexer_try_fn_name(&rule.name), rule, all_rules, hm, sc_name);
    // ATN-class rule: the static single-pass emitter cannot decide it, so
    // delegate to the runtime lexer simulator.
    if let Some(idx) = atn_class.get(rule.name) {
        let longest = !lexer_rule_has_non_greedy(rule, all_rules);
        w.line(`return latn_match(&LATN_SIM, ${idx}, chars, start, ${longest});`);
        w.end();
        w.blank();
        return;
    }
    let Some(plan) = plan else {
        unreachable();
    };
    end_lexer_matcher(w, rule, plan, all_rules, resolve_ci(grammar_opts, &rule.options), ea, hm);
}

/// Emit each semantic predicate at position `before` as a guard
/// (`if !(cond) { <fail_action>; }`) in a lexer rule's match fn. The condition
/// is the staged body (`stage_lexer_bodies` resolved its lexer `$`-attributes
/// against the match fn's `chars` / `start` / `pos`). `fail_action` is
/// `return -1` for a single-alt rule and `break <label>` inside a multi-alt
/// rule / group / fragment (a false predicate falls through to the next alt).
/// `gen_lexer_alt_seq` drives this over every `before_index` (alt-initial, mid,
/// trailing), so predicates at any position in an alt are placed.
fn gen_lexer_rule_predicates<S: AsStrSlice>(
    w: &mut CodeWriter,
    actions: &List<AltAction>,
    before: i32,
    ea: bool,
    fail_action: S,
) {
    if !ea {
        return;
    }
    for let a of actions {
        if a.before_index != before {
            continue;
        }
        if a.kind matches { Predicate } {
            w.line(`if !(${a.source.text}) { ${fail_action}; }`);
        }
    }
}

/// Which of `$mode`'s two fields the grammar's lexer bodies name. Read from the
/// `.g4` bodies, so it has to run before staging translates them into Wado.
pub fn lexer_mode_attr_use(grammar: &Grammar) -> ModeAttrUse {
    let mut out = ModeAttrUse {};
    for let rule of &grammar.lexer_rules {
        for let alt of &rule.body {
            alt_mode_attr_use(alt, &mut out);
        }
    }
    return out;
}

fn alt_mode_attr_use(alt: &LexerAlternative, out: &mut ModeAttrUse) {
    for let a of &alt.actions {
        // A predicate reaching a commit latch is refused, so a `$mode` there
        // reaches neither field and must not turn one on.
        if a.kind matches { Action } {
            body_mode_attr_use(&a.source.text, out);
        }
    }
    for let e of &alt.elements {
        element_mode_attr_use(e, out);
    }
}

fn element_mode_attr_use(elem: &LexerElement, out: &mut ModeAttrUse) {
    match *elem {
        Group(alts) => {
            for let alt of &alts {
                alt_mode_attr_use(alt, out);
            }
        },
        Repeat(rep) => element_mode_attr_use(&rep.element, out),
        Not(n) => element_mode_attr_use(&n.element, out),
        _ => {
        },
    }
}

/// Whether codegen runs `{ ... }` action bodies for this grammar's lexer at
/// all. A `language = Java` lexer qualifies because codegen stages its bodies
/// into Wado before emit (`stage_lexer_bodies`), which carves out a
/// `superClass` grammar. Such a grammar still qualifies when every action body
/// is nothing but `this.<method>()` base calls: the rewrite turns those into
/// Wado on its own, with no host translator involved.
pub fn lexer_grammar_executes_actions(grammar: &Grammar) -> bool {
    // An unwired base leaves every `this.` call in place, and no translator has
    // a receiver for it.
    if lexer_bodies_name_unwired_base(grammar) {
        return false;
    }
    if grammar.action_language matches { Wado } || action_language_is_emittable(grammar) {
        return true;
    }
    return match lexer_superclass_name(grammar) {
        Some(base) => lexer_action_bodies_are_base_calls(grammar, &base),
        None => false,
    };
}

/// Whether this rule's top-level actions run, given `grammar_executes` from
/// `lexer_grammar_executes_actions`: a real (non-fragment, non-virtual) rule of
/// an executing grammar. That answer is a parameter because computing it walks
/// every action body, and every caller here asks once per rule. Both
/// single-alt and multi-alt rules run their
/// alternatives' top-level `{ ... }` actions (a multi-alt rule re-matches to
/// find the winning alternative in `apply_<rule>_actions`). Fragments and
/// actions nested inside an element still warn. A rule carrying a body folds
/// into neither dispatch shortcut (`lexer_rule_carries_body`), so it keeps the
/// `try_` fn that sets `best_act`.
pub fn lexer_rule_executes_actions(grammar_executes: bool, rule: &LexerRule) -> bool {
    return grammar_executes && !rule.is_fragment && !rule.is_virtual;
}

/// The action ids codegen runs for `rule`: every alternative's top-level
/// `{ ... }` actions plus the ones nested in a `Group`, which the replay
/// reaches. Single source of truth shared by the apply-fn emit and
/// `warn_unhandled_lexer_actions`, so a run action and a warned-unhandled
/// action cannot disagree.
fn lexer_rule_executed_action_ids(grammar: &Grammar, grammar_executes: bool, rule: &LexerRule, out: &mut List<i32>) {
    if !lexer_rule_executes_actions(grammar_executes, rule) {
        return;
    }
    for let alt of &rule.body {
        collect_lexer_run_action_ids(alt, &grammar.lexer_rules, out);
    }
}

/// The action ids that run for `alt`: its own top-level actions, and those of
/// everything the emit inlines below it (a `Group`'s arms and a non-recursive
/// fragment's body, both of which the replay walks into).
fn collect_lexer_run_action_ids(alt: &LexerAlternative, all_rules: &List<LexerRule>, out: &mut List<i32>) {
    for let a of &alt.actions {
        if a.kind matches { Action } {
            out.push(a.source.action_id);
        }
    }
    for let e of &alt.elements {
        for let inner of &inlined_alts_of(e, all_rules) {
            collect_lexer_run_action_ids(inner, all_rules, out);
        }
    }
}

/// The alternatives `elem` inlines into its enclosing sequence: a `Group`'s
/// arms, a non-recursive fragment's body, or what a `Repeat` iterates.
fn inlined_alts_of(elem: &LexerElement, all_rules: &List<LexerRule>) -> List<LexerAlternative> {
    return match *elem {
        Group(alts) => alts,
        Repeat(rep) => inlined_alts_of(&rep.element, all_rules),
        RuleRef(name) => match find_fragment(all_rules, &name) {
            Some(f) => {
                if fragment_is_recursive(f, all_rules) {
                    return [];
                }
                f.body;
            },
            None => [],
        },
        _ => [],
    };
}

/// Every action id codegen runs anywhere in the grammar's lexer. A fragment's
/// actions run through the rules that inline it, not through the fragment's own
/// entry, so the warn pass has to ask the whole grammar rather than one rule.
pub fn lexer_grammar_run_action_ids(grammar: &Grammar) -> List<i32> {
    let executes = lexer_grammar_executes_actions(grammar);
    let mut out: List<i32> = [];
    for let rule of &grammar.lexer_rules {
        lexer_rule_executed_action_ids(grammar, executes, rule, &mut out);
    }
    return out;
}

/// Names of the lexer rules whose top-level actions codegen runs, in grammar
/// order. A rule's position in this list is its `act_index` — the tournament
/// records it in `best_act`, and the commit dispatches `apply_<name>_actions`.
/// Empty keeps every actionless / predicate-only grammar byte-identical (no
/// action-effect surface on `Lexer`, no `apply_*` fn, no `best_act` wiring).
pub fn executed_action_rule_names(grammar: &Grammar) -> List<String> {
    let executes = lexer_grammar_executes_actions(grammar);
    let mut names: List<String> = [];
    for let rule of &grammar.lexer_rules {
        let mut ids: List<i32> = [];
        lexer_rule_executed_action_ids(grammar, executes, rule, &mut ids);
        if ids.len() > 0 {
            names.push(rule.name);
        }
    }
    return names;
}

/// Emit a `MODE_<NAME>` constant per lexer mode so a `language = Wado` action
/// can name a target mode (`lx.push_mode(MODE_TAG)`) instead of a bare index.
/// Only emitted for a `mode` grammar that runs actions.
fn gen_mode_constants(w: &mut CodeWriter, mode_names: &List<String>) {
    for let mut i = 0; i < mode_names.len(); i += 1 {
        GlobalSpec::new(`MODE_${mode_names[i]}`, "i32", `${i}`, Vis::Pub).emit(w);
    }
    w.blank();
}

/// Emit the replay fn per executing rule: `apply_<rule>_actions(lx, start, end)`,
/// called post-tournament for the winner only, so a losing candidate's actions
/// never run. Bodies arrive staged (`stage_lexer_bodies`).
///
/// The rule re-runs its own match with the actions dropped in at their cursors —
/// every emit the match can take replays, restructured repeats included.
fn gen_lexer_apply_fns<S: AsStrSlice>(w: &mut CodeWriter, grammar: &Grammar, has_members: bool, sc_name: S) {
    let executes = lexer_grammar_executes_actions(grammar);
    for let rule of &grammar.lexer_rules {
        let mut ids: List<i32> = [];
        lexer_rule_executed_action_ids(grammar, executes, rule, &mut ids);
        if ids.is_empty() {
            continue;
        }
        let ci = resolve_ci(&grammar.options, &rule.options);
        // A base op reached from the replayed match carries the effect, as in
        // `try_`.
        let replay_super = !sc_name.is_empty() && lexer_rule_replay_calls_super(rule, &grammar.lexer_rules, sc_name);
        let mut f = FnSpec::new(&apply_fn_name(&rule.name));
        f.add_param("lx", "&mut Lexer");
        f.add_param("start", "i32");
        f.add_param("end", "i32");
        if replay_super {
            f.add_effect(sc_name);
        }
        f.emit_begin(w);
        gen_lexer_apply_replay_body(w, rule, &grammar.lexer_rules, &grammar.options, ci, has_members);
        w.end();
        w.blank();
    }
}

/// The replay body: `pos` becomes a live cursor over the rule's own match, and
/// each action is emitted where it sits in that match.
fn gen_lexer_apply_replay_body(
    w: &mut CodeWriter,
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    ci: bool,
    has_members: bool,
) {
    w.line("let chars = &lx.chars;");
    w.line("let mut pos = start;");
    // `ea` here only re-selects the arm the match took; a single-alt body has
    // nothing to select, so it never re-evaluates a predicate.
    let plan = lexer_rule_plan(rule, all_rules, grammar_opts);
    let ea = plan matches { Alts(_) };
    gen_lexer_body(w, &rule.body, &plan, all_rules, "return", ci, ea, has_members, true);
}

/// Emit a staged lexer-action body as a statement, normalizing the trailing
/// separator so a body written with or without `;` yields exactly one.
fn emit_lexer_action_stmt<S: AsStrSlice>(w: &mut CodeWriter, body: S) {
    let trimmed = body.trim();
    if trimmed.ends_with(";") || trimmed.ends_with("}") {
        w.line(&trimmed);
    } else {
        w.line(`${trimmed};`);
    }
}

fn apply_fn_name<S: AsStrSlice>(rule_name: S) -> String {
    return `apply_${rule_name}_actions`;
}

/// Emit the post-tournament replay dispatch: for the winning rule (`best_act`),
/// reset the `Lexer`'s effect latches, run its `apply_<rule>_actions`, then fold
/// the latched effects into the tournament outcome. Only reached with
/// `best_act >= 0`, i.e. the winner runs actions.
fn gen_lexer_action_replay(
    w: &mut CodeWriter,
    act_rule_names: &List<String>,
    use_modes: bool,
    has_set_mode_rules: bool,
    surface: &LexerSurface,
) {
    w.begin("if best_act >= 0");
    if use_modes {
        let mode_seed = if surface.current_mode { ", current_mode" } else { "" };
        w.line(`lexer.reset_actions(best_kind, best_channel, mode_stack.len()${mode_seed});`);
    } else {
        w.line("lexer.reset_actions(best_kind, best_channel);");
    }
    for let mut i = 0; i < act_rule_names.len(); i += 1 {
        let call = `${apply_fn_name(&act_rule_names[i])}(&mut lexer, start, best_end);`;
        if i == 0 {
            w.begin(`if best_act == ${i}`);
        } else {
            w.else_begin(`else if best_act == ${i}`);
        }
        w.line(&call);
    }
    w.end();
    // Fold the latched effects into the tournament outcome. `best_channel` and
    // `best_more` exist because `has_actions` forced their machinery on;
    // `best_act_skip` feeds the `is_skip` decision below. The type / channel
    // latches were seeded with these values, so an action that wrote neither
    // hands them straight back.
    w.line("best_kind = lexer.act_type;");
    w.line("best_channel = lexer.act_channel;");
    w.line("if lexer.act_more { best_more = true; }");
    w.line("if lexer.act_skip { best_act_skip = true; }");
    if use_modes {
        // The commit applies the latches in a fixed push-pop-set order, so two
        // of them would silently reorder. Every command method guards what it
        // can see, which covers the invariant on its own; only a `$mode`
        // assignment reaches the set latch without passing one, so the check is
        // repeated here over the latches themselves exactly where that spelling
        // exists.
        if surface.mode_write_guard {
            w.line(
                `assert (if lexer.act_push_mode >= 0 { 1 } else { 0 }) + (if lexer.act_pop_mode { 1 } else { 0 }) + (if lexer.${LEXER_SET_MODE_FIELD} >= 0 { 1 } else { 0 }) <= 1, "a lexer action may issue at most one mode command per token";`,
            );
        }
        w.line("if lexer.act_push_mode >= 0 { best_push_mode = lexer.act_push_mode; }");
        w.line("if lexer.act_pop_mode { best_pop_mode = true; }");
        if has_set_mode_rules {
            w.line(`if lexer.${LEXER_SET_MODE_FIELD} >= 0 { best_set_mode = lexer.${LEXER_SET_MODE_FIELD}; }`);
        }
    }
    w.end();
}

/// Collect the `Action`-kind ids in `alt` that codegen does not run — the exact
/// complement of `collect_lexer_run_action_ids`. `executes` is true for an alt of
/// an executing rule. An action the replay cannot reach — one under a `~`, or in
/// a recursive fragment the emit calls rather than inlines — is unhandled.
/// Drives the loud safety net (`warn_unhandled_lexer_actions` in `codegen`).
pub fn collect_unhandled_lexer_alt_action_ids(
    alt: &LexerAlternative,
    executes: bool,
    all_rules: &List<LexerRule>,
    out: &mut List<i32>,
) {
    if !executes {
        push_all_lexer_alt_action_ids(alt, out);
        return;
    }
    for let e of &alt.elements {
        let inlined = inlined_alts_of(e, all_rules);
        if inlined.is_empty() {
            push_all_lexer_element_action_ids(e, out);
            continue;
        }
        for let inner of &inlined {
            collect_unhandled_lexer_alt_action_ids(inner, true, all_rules, out);
        }
    }
}

/// Every semantic-predicate id `rule` carries, its referenced rules included:
/// the lexer ATN inlines those, so their predicates share the rule's fate.
pub fn collect_lexer_predicate_ids(rule: &LexerRule, all_rules: &List<LexerRule>, out: &mut List<i32>) {
    let mut visiting: List<String> = [];
    push_lexer_rule_predicate_ids(rule, all_rules, &mut visiting, out);
}

fn push_lexer_rule_predicate_ids(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    visiting: &mut List<String>,
    out: &mut List<i32>,
) {
    if visiting.contains(&rule.name) {
        return;
    }
    visiting.push(rule.name);
    for let alt of &rule.body {
        push_lexer_alt_predicate_ids(alt, all_rules, visiting, out);
    }
}

fn push_lexer_alt_predicate_ids(
    alt: &LexerAlternative,
    all_rules: &List<LexerRule>,
    visiting: &mut List<String>,
    out: &mut List<i32>,
) {
    for let a of &alt.actions {
        if a.kind matches { Predicate } {
            out.push(a.source.action_id);
        }
    }
    for let e of &alt.elements {
        push_lexer_element_predicate_ids(e, all_rules, visiting, out);
    }
}

fn push_lexer_element_predicate_ids(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    visiting: &mut List<String>,
    out: &mut List<i32>,
) {
    match *elem {
        Group(alts) => {
            for let alt of &alts {
                push_lexer_alt_predicate_ids(alt, all_rules, visiting, out);
            }
        },
        Repeat(rep) => push_lexer_element_predicate_ids(&rep.element, all_rules, visiting, out),
        Not(n) => push_lexer_element_predicate_ids(&n.element, all_rules, visiting, out),
        RuleRef(name) => {
            if let Some(r) = find_lexer_rule(all_rules, &name) {
                push_lexer_rule_predicate_ids(r, all_rules, visiting, out);
            }
        },
        _ => {
        },
    }
}

fn push_all_lexer_alt_action_ids(alt: &LexerAlternative, out: &mut List<i32>) {
    for let a of &alt.actions {
        if a.kind matches { Action } {
            out.push(a.source.action_id);
        }
    }
    for let e of &alt.elements {
        push_all_lexer_element_action_ids(e, out);
    }
}

fn push_all_lexer_element_action_ids(elem: &LexerElement, out: &mut List<i32>) {
    match *elem {
        Group(alts) => {
            for let alt of &alts {
                push_all_lexer_alt_action_ids(alt, out);
            }
        },
        Repeat(rep) => push_all_lexer_element_action_ids(&rep.element, out),
        Not(n) => push_all_lexer_element_action_ids(&n.element, out),
        _ => {
        },
    }
}

/// Emit a body of alternatives — a rule's own, a group's, or an inlined
/// fragment's — as the plan shapes it. One alternative is not an alternation, so
/// it goes straight to the sequence.
fn gen_lexer_body<S: AsStrSlice>(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    plan: &LexerBodyPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    match plan {
        Single(seq) => gen_lexer_alt_seq(w, &alts[0], seq, 0, all_rules, fail_action, ci, ea, hm, replay),
        Alts(ap) => gen_lexer_alts(w, alts, ap, all_rules, fail_action, ci, ea, hm, replay),
    }
}

fn gen_lexer_alts<S: AsStrSlice>(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    plan: &LexerAltsPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    if replay {
        gen_lexer_alts_replay(w, alts, plan, all_rules, fail_action, ci, ea, hm);
        return;
    }
    if plan.emit matches { MaximalMunch } {
        gen_lexer_alts_longest(w, alts, plan, all_rules, fail_action, ci, ea, hm);
        return;
    }
    // Sibling arms leaving one block: a cascade of `if !ok` nests a level per
    // alternative, eleven deep for a css3 unit fragment.
    let id = w.next_id();
    w.line(`let alts_saved_${id} = pos;`);
    w.begin(`alts_done_${id}:`);
    for let mut i = 0; i < alts.len(); i += 1 {
        let label = `alts_${id}_${i}`;
        w.begin(`${label}:`);
        w.line(`pos = alts_saved_${id};`);
        gen_lexer_arm_probe(w, &alts[i], &plan.arms[i], all_rules, `break ${label}`, ci, ea, hm, replay);
        w.line(`break alts_done_${id};`);
        w.end();
    }
    w.line(`${fail_action};`);
    w.end();
}

/// Maximal-munch emit for an alternation in tail position: every alternative is
/// scanned forward from the same start and the longest match wins, matching
/// ANTLR4's NFA→DFA lexer simulation (`I : ('a' | 'ab')` matches `ab`). Sound
/// without backtracking precisely because nothing follows the alternation, so
/// the alternative's length is the rule's length — an alternation with a suffix
/// keeps the first-match emit, where a longer arm could strand the suffix.
fn gen_lexer_alts_longest<S: AsStrSlice>(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    plan: &LexerAltsPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    w.line(`let alts_saved_${id} = pos;`);
    w.line(`let mut alts_best_${id} = -1;`);
    for let mut i = 0; i < alts.len(); i += 1 {
        let label = `alts_${id}_${i}`;
        w.begin(`${label}:`);
        w.line(`pos = alts_saved_${id};`);
        gen_lexer_arm_probe(w, &alts[i], &plan.arms[i], all_rules, `break ${label}`, ci, ea, hm, /*replay=*/ false);
        w.line(`if pos > alts_best_${id} { alts_best_${id} = pos; }`);
        w.end();
    }
    w.line(`if alts_best_${id} < 0 { ${fail_action}; }`);
    w.line(`pos = alts_best_${id};`);
}

/// Replay an alternation: first pick the arm the match picked — scanning
/// match-only, so a losing arm's actions never run — then re-run just that arm
/// with its actions in place. Selection mirrors `gen_lexer_alts` exactly
/// (longest in tail position, first-match otherwise), so the replay lands on the
/// alternative the tournament actually matched.
fn gen_lexer_alts_replay<S: AsStrSlice>(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    plan: &LexerAltsPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    let longest = plan.emit matches { MaximalMunch };
    w.line(`let sel_saved_${id} = pos;`);
    w.line(`let mut sel_alt_${id} = -1;`);
    if longest {
        w.line(`let mut sel_best_${id} = -1;`);
    } else {
        w.begin(`sel_done_${id}:`);
    }
    for let mut i = 0; i < alts.len(); i += 1 {
        let label = `sel_${id}_${i}`;
        w.begin(`${label}:`);
        w.line(`pos = sel_saved_${id};`);
        gen_lexer_arm_probe(w, &alts[i], &plan.arms[i], all_rules, `break ${label}`, ci, ea, hm, /*replay=*/ true);
        if longest {
            w.line(`if pos > sel_best_${id} { sel_best_${id} = pos; sel_alt_${id} = ${i}; }`);
        } else {
            w.line(`sel_alt_${id} = ${i};`);
            w.line(`break sel_done_${id};`);
        }
        w.end();
    }
    if !longest {
        w.end();
    }
    w.line(`if sel_alt_${id} < 0 { ${fail_action}; }`);
    w.line(`pos = sel_saved_${id};`);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i == 0 {
            w.begin(`if sel_alt_${id} == ${i}`);
        } else {
            w.else_begin(`else if sel_alt_${id} == ${i}`);
        }
        // `ea = false`: the selection pass already evaluated this arm. Running a
        // state-dependent predicate twice could reject here what it accepted
        // there, dropping the winner's actions while the token still commits.
        gen_lexer_alt_seq(w, &alts[i], &plan.arms[i], 0, all_rules, fail_action, ci, false, hm, true);
    }
    w.end();
}

/// How an alternation is emitted once it is in tail position, and — when the
/// cheap first-match emit already gives ANTLR4's answer — why.
pub enum LexerAltsScan {
    /// Maximal munch: every arm is scanned from the same start, longest wins.
    Longest,
    /// Fewer than two arms — no choice to make.
    SingleArm,
    /// Every arm consumes the same fixed number of chars, so longest and
    /// first-match coincide and the cheaper emit stays byte-identical.
    FixedLenArms,
    /// An arm carries a semantic predicate anywhere below it, which the lexer
    /// ATN cannot run. Only the routing question reads this; the emit measures
    /// such an arm like any other (`lexer_alts_lengths`).
    ArmPredicate,
}

/// How the arms compare on length, which is the whole of what the emit needs:
/// it runs a predicate while scoring, so an arm carrying one is still an arm to
/// measure. A predicate says whether its own arm matches, never how the lengths
/// compare, so it is orthogonal to this question.
pub fn lexer_alts_lengths(alts: &List<LexerAlternative>, all_rules: &List<LexerRule>) -> LexerAltsScan {
    if alts.len() < 2 {
        return LexerAltsScan::SingleArm;
    }
    let mut common = -1;
    for let alt of alts {
        let len = lexer_alt_fixed_len(alt, all_rules);
        if let Some(n) = len {
            if common < 0 {
                common = n;
            } else if common != n {
                return LexerAltsScan::Longest;
            }
        } else {
            return LexerAltsScan::Longest;
        }
    }
    return LexerAltsScan::FixedLenArms;
}

/// `lexer_alts_lengths` for the routing question, where a predicate is
/// disqualifying: `latn_match` refuses one, so a predicate-carrying alternation
/// is never the undecidable-arms case that routes to the lexer ATN.
pub fn lexer_alts_scan(alts: &List<LexerAlternative>, all_rules: &List<LexerRule>) -> LexerAltsScan {
    if alts.len() < 2 {
        return LexerAltsScan::SingleArm;
    }
    for let alt of alts {
        if lexer_alt_has_predicate_below(alt, all_rules) {
            return LexerAltsScan::ArmPredicate;
        }
    }
    return lexer_alts_lengths(alts, all_rules);
}

/// Whether a tail-position alternation needs the maximal-munch emit.
/// The emit an alternation takes, tail position included: the whole
/// `gen_lexer_alts` decision as one value.
pub enum LexerAltsEmit {
    MaximalMunch,
    /// Something after the alternation still has to be consumed, so a longer
    /// arm could strand it.
    FirstMatchNotTail,
    FirstMatchSingleArm,
    FirstMatchFixedLenArms,
    /// No two arms can match at the same position, so the first to match is
    /// the only one.
    FirstMatchArmsDisjoint,
}

pub fn lexer_alts_emit(
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    ci: bool,
    tail: bool,
) -> LexerAltsEmit {
    if !tail {
        return LexerAltsEmit::FirstMatchNotTail;
    }
    return match lexer_alts_lengths(alts, all_rules) {
        Longest => if lexer_alts_can_collide(alts, all_rules, ci) {
            LexerAltsEmit::MaximalMunch;
        } else {
            LexerAltsEmit::FirstMatchArmsDisjoint;
        },
        SingleArm => LexerAltsEmit::FirstMatchSingleArm,
        FixedLenArms => LexerAltsEmit::FirstMatchFixedLenArms,
        ArmPredicate => panic("lexer_alts_lengths never reports the routing question's predicate carve-out"),
    };
}

/// Whether a non-greedy subrule makes the earliest accept this rule's answer
/// (`CMT : '/*' (CMT | .)+? '*/'` ends at the first `*/`). With none, the rule
/// is an ordinary maximal-munch token and the simulator must take the longest.
fn lexer_rule_has_non_greedy(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    let mut visiting: List<String> = [rule.name];
    return lexer_alts_have_non_greedy(&rule.body, all_rules, &mut visiting);
}

pub fn lexer_alts_have_non_greedy(
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    visiting: &mut List<String>,
) -> bool {
    for let alt of alts {
        for let elem of &alt.elements {
            if lexer_elem_has_non_greedy(elem, all_rules, visiting) {
                return true;
            }
        }
    }
    return false;
}

/// `visiting` guards a fragment that reaches itself — the recursive comment
/// fragment walks forever without it.
fn lexer_elem_has_non_greedy(elem: &LexerElement, all_rules: &List<LexerRule>, visiting: &mut List<String>) -> bool {
    match *elem {
        Repeat(rep) => {
            return rep.non_greedy || lexer_elem_has_non_greedy(&rep.element, all_rules, visiting);
        },
        Group(alts) => {
            return lexer_alts_have_non_greedy(&alts, all_rules, visiting);
        },
        Not(n) => {
            return lexer_elem_has_non_greedy(&n.element, all_rules, visiting);
        },
        RuleRef(name) => {
            if visiting.contains(&name) {
                return false;
            }
            // `collect_reachable` inlines whatever `find_lexer_rule` resolves,
            // so a token rule reached from here is as much a part of the
            // simulated rule as a fragment: the decision must walk the same
            // graph the ATN is built from.
            let Some(f) = find_lexer_rule(all_rules, &name) else {
                return false;
            };
            visiting.push(name);
            let found = lexer_alts_have_non_greedy(&f.body, all_rules, visiting);
            visiting.pop();
            return found;
        },
        Literal(_) | CharRange(_) | CharClass(_) | AnyChar => {
            return false;
        },
    }
}

/// Whether `alt` carries a semantic predicate at its own level or anywhere the
/// emit inlines below it (a group's arms, a non-recursive fragment's body). A
/// nested predicate constrains the emit exactly as a top-level one does, so both
/// must disable the maximal-munch scan.
fn lexer_alt_has_predicate_below(alt: &LexerAlternative, all_rules: &List<LexerRule>) -> bool {
    for let a of &alt.actions {
        if a.kind matches { Predicate } {
            return true;
        }
    }
    return alt.elements.iter_ref().any(|e| lexer_elem_has_predicate_below(e, all_rules));
}

fn lexer_elem_has_predicate_below(elem: &LexerElement, all_rules: &List<LexerRule>) -> bool {
    return match *elem {
        Group(alts) => {
            for let a of alts {
                if lexer_alt_has_predicate_below(&a, all_rules) {
                    return true;
                }
            }
            false;
        },
        Repeat(rep) => lexer_elem_has_predicate_below(&rep.element, all_rules),
        Not(n) => lexer_elem_has_predicate_below(&n.element, all_rules),
        RuleRef(name) => match find_fragment(all_rules, &name) {
            // A recursive fragment is a call, so its predicates stay inside it.
            Some(f) => {
                if fragment_is_recursive(f, all_rules) {
                    return false;
                }
                for let a of &f.body {
                    if lexer_alt_has_predicate_below(a, all_rules) {
                        return true;
                    }
                }
                false;
            },
            None => false,
        },
        _ => false,
    };
}

/// The exact number of chars an alternative consumes, or null when it is not a
/// fixed count (repeats, rule calls, recursive fragments).
fn lexer_alt_fixed_len(alt: &LexerAlternative, all_rules: &List<LexerRule>) -> Option<i32> {
    let mut total = 0;
    for let elem of &alt.elements {
        let len = lexer_elem_fixed_len(elem, all_rules);
        if let Some(n) = len {
            total += n;
        } else {
            return null;
        }
    }
    return Option::<i32>::Some(total);
}

fn lexer_elem_fixed_len(elem: &LexerElement, all_rules: &List<LexerRule>) -> Option<i32> {
    return match *elem {
        Literal(text) => Option::<i32>::Some(text.chars().count()),
        CharRange(_) | CharClass(_) | AnyChar => Option::<i32>::Some(1),
        // A complement consumes one char exactly when its inner set does.
        Not(n) => match lexer_elem_fixed_len(&n.element, all_rules) {
            Some(1) => Option::<i32>::Some(1),
            _ => null,
        },
        Group(alts) => {
            let mut common: Option<i32> = null;
            for let alt of alts {
                let len = lexer_alt_fixed_len(&alt, all_rules);
                if let Some(n) = len {
                    if let Some(c) = common {
                        if c != n {
                            return null;
                        }
                    } else {
                        common = Option::<i32>::Some(n);
                    }
                } else {
                    return null;
                }
            }
            common;
        },
        RuleRef(name) => {
            if name == "EOF" {
                return Option::<i32>::Some(0);
            }
            let frag = find_fragment(all_rules, &name);
            if let Some(f) = frag {
                if fragment_is_recursive(f, all_rules) {
                    return null;
                }
                return lexer_elem_fixed_len(&LexerElement::Group(f.body), all_rules);
            }
            null;
        },
        Repeat(_) => null,
    };
}

/// The predicate setting a match-only probe runs under. Under a replay it is
/// always on: a probe reproduces a decision the match already made — which arm
/// won, how many iterations a loop kept, where a non-greedy loop exited — and
/// the match fn evaluates predicates wherever an `apply_<rule>_actions` exists
/// at all (`gen_lexer`'s `ea` is true whenever a rule executes actions). The
/// walk that follows a probe still does not, so a state-dependent predicate
/// cannot reject the winner's actions after the decision is settled.
fn probe_ea(replay: bool, ea: bool) -> bool {
    return replay || ea;
}

/// Match an arm for a selection pass: no actions, and predicates exactly where
/// the match evaluated them. Every arm-scoring and first-match selection goes
/// through here, so none can hand the enclosing body's `ea` to a decision and
/// score an arm the match had ruled out.
fn gen_lexer_arm_probe<S: AsStrSlice>(
    w: &mut CodeWriter,
    alt: &LexerAlternative,
    plan: &LexerSeqPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    gen_lexer_alt_seq(w, alt, plan, 0, all_rules, fail_action, ci, probe_ea(replay, ea), hm, false);
}

/// The id a probe's locals carry. Only a replay emits a probe, so only a replay
/// mints one — the match pass keeps the numbering it had.
fn probe_id(w: &mut CodeWriter, replay: bool) -> i32 {
    return if replay { w.next_id() } else { 0 };
}

/// How a repeat at `alt.elements[index]` is emitted, and — when the plain
/// greedy loop is enough — why the lookahead-aware one was not needed.
pub enum LexerRepeatEmit {
    /// `*?` / `+?`: min-match loop that tries the rest of the alt first.
    NonGreedy,
    /// Forward scan with accept-state tracking, so the loop can hand back the
    /// chars the suffix needs (`gen_lexer_repeat_lookahead_aware`).
    LookaheadAware,
    /// `?` — one optional element, no loop that could overshoot.
    PlainOptional,
    /// Nothing follows the repeat, so it cannot strand a suffix.
    PlainNoSuffix,
    /// The inner does not consume exactly one char per iteration, so there is
    /// no per-iteration position for the scan to record.
    PlainInnerNotPerChar,
    /// A semantic predicate sits between the repeat and the alt's end; peeking
    /// the suffix would evaluate it once per iteration.
    PlainPredicateAfter,
    /// The inner cannot eat a char the suffix needs, so the plain loop already
    /// stops where the suffix must start.
    PlainSuffixDisjoint,
    /// The suffix carries a semantic predicate, so peeking it would change how
    /// often the grammar sees it.
    PlainSuffixNotPeekable,
}

pub fn lexer_repeat_emit(alt: &LexerAlternative, index: i32, all_rules: &List<LexerRule>, ci: bool) -> LexerRepeatEmit {
    let Repeat(rep) = &alt.elements[index] else {
        panic("lexer_repeat_emit: element is not a Repeat");
    };
    if rep.non_greedy {
        return LexerRepeatEmit::NonGreedy;
    }
    if !rep.kind matches { Plus | Star } {
        return LexerRepeatEmit::PlainOptional;
    }
    if index + 1 >= alt.elements.len() {
        return LexerRepeatEmit::PlainNoSuffix;
    }
    if !lexer_element_can_consume_simple(&rep.element) {
        return LexerRepeatEmit::PlainInnerNotPerChar;
    }
    if lexer_alt_has_predicate_after(alt, index) {
        return LexerRepeatEmit::PlainPredicateAfter;
    }
    let suffix = lexer_alt_suffix(alt, index);
    if !lexer_repeat_can_eat_suffix(&rep.element, &suffix, all_rules, ci) {
        return LexerRepeatEmit::PlainSuffixDisjoint;
    }
    if !lexer_suffix_is_peekable(&suffix, all_rules) {
        return LexerRepeatEmit::PlainSuffixNotPeekable;
    }
    return LexerRepeatEmit::LookaheadAware;
}

/// How an alternation at `alt.elements[index]` that has a suffix after it is
/// emitted, and — when first-match already gives ANTLR4's answer — why the arms
/// need not be scored against the suffix. A tail-position alternation (no
/// suffix) is `lexer_alts_emit`'s decision instead.
pub enum LexerGroupEmit {
    /// Each arm is scored on how far arm-plus-suffix reaches
    /// (`gen_lexer_alts_lookahead_aware`).
    ArmScoring,
    FirstMatchSingleArm,
    /// Nothing follows: `lexer_alts_emit` decides this one.
    FirstMatchNoSuffix,
    /// Every arm consumes the same fixed number of chars.
    FirstMatchFixedLenArms,
    /// No two arms can match at the same position, so which arm wins is not a
    /// decision at all.
    FirstMatchArmsDisjoint,
    /// A semantic predicate sits between the alternation and the alt's end.
    FirstMatchPredicateAfter,
    /// The suffix carries a semantic predicate, so it cannot be peeked.
    FirstMatchSuffixNotPeekable,
}

pub fn lexer_group_emit(alt: &LexerAlternative, index: i32, all_rules: &List<LexerRule>, ci: bool) -> LexerGroupEmit {
    let Group(g_alts) = &alt.elements[index] else {
        panic("lexer_group_emit: element is not a Group");
    };
    if g_alts.len() < 2 {
        return LexerGroupEmit::FirstMatchSingleArm;
    }
    if index + 1 >= alt.elements.len() {
        return LexerGroupEmit::FirstMatchNoSuffix;
    }
    // `lexer_alts_lengths`, not `lexer_alts_scan`: this is an emit decision, and
    // the emit runs a predicate while scoring, so an arm carrying one is still
    // an arm to measure. The carve-out in `lexer_alts_scan` answers the routing
    // question, where a predicate is disqualifying because `latn_match` cannot
    // run one.
    match lexer_alts_lengths(g_alts, all_rules) {
        SingleArm => {
            return LexerGroupEmit::FirstMatchSingleArm;
        },
        FixedLenArms => {
            return LexerGroupEmit::FirstMatchFixedLenArms;
        },
        ArmPredicate => {
            panic("lexer_alts_lengths never reports the routing question's predicate carve-out");
        },
        Longest => {
        },
    }
    if !lexer_alts_can_collide(g_alts, all_rules, ci) {
        return LexerGroupEmit::FirstMatchArmsDisjoint;
    }
    if lexer_alt_has_predicate_after(alt, index) {
        return LexerGroupEmit::FirstMatchPredicateAfter;
    }
    if !lexer_suffix_is_peekable(&lexer_alt_suffix(alt, index), all_rules) {
        return LexerGroupEmit::FirstMatchSuffixNotPeekable;
    }
    return LexerGroupEmit::ArmScoring;
}

/// The elements of `alt` after `after` — what a repeat or an alternation at
/// that position has to leave behind for the rest of the sequence.
pub fn lexer_alt_suffix(alt: &LexerAlternative, after: i32) -> List<LexerElement> {
    let mut out: List<LexerElement> = [];
    for let mut j = after + 1; j < alt.elements.len(); j += 1 {
        out.push(alt.elements[j]);
    }
    return out;
}

/// The rest of `alt` after `after`, as the alternative a non-greedy repeat
/// consumes: the trailing elements with every action from `after + 1` onwards
/// re-based onto them (`before_index - (after + 1)`).
///
/// The re-basing is what keeps a predicate positioned after the repeat — the
/// trailing one included — placed: the non-greedy emit returns instead of
/// falling out of the element loop, so the loop's post-pass never runs for it.
fn lexer_alt_rest(alt: &LexerAlternative, after: i32) -> LexerAlternative {
    let mut actions: List<AltAction> = [];
    for let a of &alt.actions {
        if a.before_index >= after + 1 {
            actions.push(AltAction { kind: a.kind, source: a.source, before_index: a.before_index - (after + 1) });
        }
    }
    return LexerAlternative { elements: lexer_alt_suffix(alt, after), actions };
}

/// Whether the alternative's last element inherits the sequence's tail
/// position. It does not when a trailing predicate follows it: the
/// maximal-munch emit would gate the longest arm on a predicate a shorter one
/// might have satisfied.
fn lexer_alt_last_is_tail(alt: &LexerAlternative, tail: bool) -> bool {
    return tail && !lexer_alt_has_predicate_at(alt, alt.elements.len());
}

/// Whether `alt` has a semantic predicate strictly between element `after` and
/// the trailing position (`after < before_index < elements.len()`).
fn lexer_alt_has_predicate_after(alt: &LexerAlternative, after: i32) -> bool {
    return alt.actions.iter_ref().any(|a| a.kind matches { Predicate } && after < a.before_index < alt.elements.len());
}

// ==========================================================================
// The emit plan — decided once, consumed by the emitter and by the dump
// ==========================================================================

/// A body of alternatives — a rule's own, a group's, or an inlined fragment's —
/// and every strategy the emit takes below it. `gen_lexer` and the dump both
/// descend this, so neither re-derives a decision nor reaches a construct the
/// other does not.
pub variant LexerBodyPlan {
    /// One alternative is not an alternation: no strategy to take.
    Single(LexerSeqPlan),
    Alts(LexerAltsPlan),
}

pub struct LexerAltsPlan {
    pub emit: LexerAltsEmit,
    pub arms: List<LexerSeqPlan>,
}

/// One alternative: a step per element, in source order.
pub struct LexerSeqPlan {
    pub steps: List<LexerStepPlan>,
}

pub variant LexerStepPlan {
    /// A repeat the sequence decides for, which may consume what follows it.
    Repeat(LexerRepeatPlan),
    /// An alternation, with the strategy that picks between its arms.
    Group(LexerGroupPlan),
    /// Everything else, including an inlined fragment.
    Elem(LexerElemPlan),
}

pub struct LexerGroupPlan {
    pub emit: LexerGroupEmit,
    pub shape: LexerGroupShape,
}

pub variant LexerGroupShape {
    /// Scored arms. The suffix is only peeked, so it stays a step of the
    /// enclosing sequence rather than being planned a second time here.
    Scored(List<LexerSeqPlan>),
    FirstMatch(LexerBodyPlan),
}

pub struct LexerRepeatPlan {
    pub emit: LexerRepeatEmit,
    pub inner: LexerElemPlan,
    /// A non-greedy loop's exit try, the one emit that lowers what follows
    /// outside the sequence's own tail position. `null` for every other.
    pub rest: Option<LexerCutPlan> = null,
}

/// An alternative cut out of the sequence, with its plan. Carried together so
/// neither consumer cuts it again.
pub struct LexerCutPlan {
    pub alt: LexerAlternative,
    pub plan: LexerSeqPlan,
}

pub variant LexerElemPlan {
    /// A group, or a fragment inlined at this reference.
    Body(LexerBodyPlan),
    /// A repeat inside a `~` or another repeat: no alternative around it to
    /// strand, so no suffix decision.
    PlainRepeat(LexerNestedPlan),
    Not(LexerNestedPlan),
    /// A group, `~` or inlined fragment that consumes one char out of a set:
    /// one class test (`lexer_elem_char_set`).
    CharSet(CharClass),
    /// A non-recursive fragment reached through its `frag_` matcher.
    Call(LexerFragmentKey),
    /// A literal, a char class or range, `.`, `EOF`, or a rule reached by call.
    Leaf,
}

/// One `frag_` matcher: the fragment, planned in its caller's case folding and
/// tail position.
pub struct LexerFragmentKey {
    pub name: String,
    pub ci: bool,
    /// Set only where it changes the plan, so equal bodies share one matcher.
    pub tail: bool,
}

impl LexerFragmentKey {
    /// Lexer rule names start uppercase, so the lowercase markers cannot collide.
    pub fn fn_name(&self) -> String {
        let ci = if self.ci { "ci_" } else { "" };
        let tail = if self.tail { "tail_" } else { "" };
        return `frag_${ci}${tail}${self.name}`;
    }
}

pub struct LexerFragmentFn {
    pub key: LexerFragmentKey,
    pub plan: LexerBodyPlan,
}

/// The plan of each rule whose `try_` body is emitted here, by declaration index,
/// and every `frag_` matcher those plans reach, in first-reached order.
pub struct LexerMatcherPlans {
    pub rules: List<Option<LexerBodyPlan>>,
    pub fragments: List<LexerFragmentFn>,
}

pub fn lexer_matcher_plans(
    lexer_rules: &List<LexerRule>,
    routes: &List<LexerRuleRoute>,
    grammar_opts: &List<GrammarOption>,
    atn_class: &TreeMap<String, i32>,
) -> LexerMatcherPlans {
    let mut rules: List<Option<LexerBodyPlan>> = [];
    let mut keys: List<LexerFragmentKey> = [];
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let rule = &lexer_rules[i];
        if emits_static_matcher(&routes[i], rule, atn_class) {
            let plan = lexer_rule_plan(rule, lexer_rules, grammar_opts);
            collect_body_calls(&plan, &mut keys);
            rules.push(Option::Some(plan));
        } else {
            rules.push(null);
        }
    }
    let mut out: List<LexerFragmentFn> = [];
    for let mut i = 0; i < keys.len(); i += 1 {
        let key = keys[i];
        let Some(f) = find_fragment(lexer_rules, &key.name) else {
            panic("a fragment call names no fragment");
        };
        let plan = plan_body(&f.body, lexer_rules, key.ci, key.tail);
        collect_body_calls(&plan, &mut keys);
        out.push(LexerFragmentFn { key, plan });
    }
    return LexerMatcherPlans { rules, fragments: out };
}

fn collect_body_calls(plan: &LexerBodyPlan, out: &mut List<LexerFragmentKey>) {
    match plan {
        Single(seq) => collect_seq_calls(seq, out),
        Alts(ap) => {
            for let arm of &ap.arms {
                collect_seq_calls(arm, out);
            }
        },
    }
}

fn collect_seq_calls(plan: &LexerSeqPlan, out: &mut List<LexerFragmentKey>) {
    for let step of &plan.steps {
        match step {
            Repeat(rp) => {
                collect_elem_calls(&rp.inner, out);
                if let Some(cut) = &rp.rest {
                    collect_seq_calls(&cut.plan, out);
                }
            },
            Group(gp) => match &gp.shape {
                Scored(arms) => {
                    for let arm of arms {
                        collect_seq_calls(arm, out);
                    }
                },
                FirstMatch(body) => collect_body_calls(body, out),
            },
            Elem(ep) => collect_elem_calls(ep, out),
        }
    }
}

fn collect_elem_calls(plan: &LexerElemPlan, out: &mut List<LexerFragmentKey>) {
    match plan {
        Body(body) => collect_body_calls(body, out),
        PlainRepeat(nested) | Not(nested) => collect_elem_calls(&nested.inner, out),
        Call(key) => {
            if !out.contains(key) {
                out.push(*key);
            }
        },
        CharSet(_) | Leaf => {
        },
    }
}

/// A variant cannot carry itself directly.
pub struct LexerNestedPlan {
    pub inner: LexerElemPlan,
}

/// Plan `rule`'s body the way `gen_lexer_match_fn` emits it: a rule reached by
/// call is entered with its caller's suffix still to consume, so its body
/// alternation is not in tail position.
pub fn lexer_rule_plan(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
) -> LexerBodyPlan {
    let ci = resolve_ci(grammar_opts, &rule.options);
    let tail = !lexer_rule_is_called(rule, all_rules);
    return plan_body(&rule.body, all_rules, ci, tail);
}

fn plan_body(alts: &List<LexerAlternative>, all_rules: &List<LexerRule>, ci: bool, tail: bool) -> LexerBodyPlan {
    if alts.len() == 1 {
        return LexerBodyPlan::Single(plan_seq(&alts[0], all_rules, ci, tail));
    }
    let emit = lexer_alts_emit(alts, all_rules, ci, tail);
    // Maximal munch scans every arm to its end, and of disjoint arms only one
    // can match, so each arm inherits the tail position; first-match does not.
    let arm_tail = emit matches { MaximalMunch | FirstMatchArmsDisjoint };
    let mut arms: List<LexerSeqPlan> = [];
    for let alt of alts {
        arms.push(plan_seq(alt, all_rules, ci, arm_tail));
    }
    return LexerBodyPlan::Alts(LexerAltsPlan { emit, arms });
}

fn plan_seq(alt: &LexerAlternative, all_rules: &List<LexerRule>, ci: bool, tail: bool) -> LexerSeqPlan {
    let last_is_tail = lexer_alt_last_is_tail(alt, tail);
    let mut steps: List<LexerStepPlan> = [];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        let elem = &alt.elements[i];
        let elem_tail = last_is_tail && i == alt.elements.len() - 1;
        if let Repeat(rep) = elem {
            let emit = lexer_repeat_emit(alt, i, all_rules, ci);
            // Every emit runs the inner as its own loop body, so nothing of the
            // alternative follows it there.
            let inner = plan_elem(&rep.element, all_rules, ci, false);
            // The exit try runs the rest of the alternative — its re-based
            // predicates included — outside the sequence's tail position, so it
            // is the one cut planned apart.
            if emit matches { NonGreedy } {
                let rest = lexer_alt_rest(alt, i);
                let plan = plan_seq(&rest, all_rules, ci, false);
                steps.push(LexerStepPlan::Repeat(LexerRepeatPlan {
                    emit,
                    inner,
                    rest: Option::Some(LexerCutPlan { alt: rest, plan }),
                }));
                return LexerSeqPlan { steps };
            }
            // Lookahead-aware peeks and commits the remaining steps in the tail
            // position they were planned in, so they stay steps of this sequence.
            steps.push(LexerStepPlan::Repeat(LexerRepeatPlan { emit, inner }));
            continue;
        }
        if let Group(g_alts) = elem {
            if let Some(set) = lexer_composite_char_set(elem, all_rules, ci) {
                steps.push(LexerStepPlan::Elem(LexerElemPlan::CharSet(set)));
                continue;
            }
            let emit = lexer_group_emit(alt, i, all_rules, ci);
            let shape = if emit matches { ArmScoring } {
                // Each arm is scanned match-only, outside tail position.
                let mut arms: List<LexerSeqPlan> = [];
                for let g of g_alts {
                    arms.push(plan_seq(g, all_rules, ci, false));
                }
                LexerGroupShape::Scored(arms);
            } else {
                LexerGroupShape::FirstMatch(plan_body(g_alts, all_rules, ci, elem_tail));
            };
            steps.push(LexerStepPlan::Group(LexerGroupPlan { emit, shape }));
            continue;
        }
        steps.push(LexerStepPlan::Elem(plan_elem(elem, all_rules, ci, elem_tail)));
    }
    return LexerSeqPlan { steps };
}

fn plan_elem(elem: &LexerElement, all_rules: &List<LexerRule>, ci: bool, tail: bool) -> LexerElemPlan {
    if let Some(set) = lexer_composite_char_set(elem, all_rules, ci) {
        return LexerElemPlan::CharSet(set);
    }
    return match *elem {
        Group(alts) => LexerElemPlan::Body(plan_body(&alts, all_rules, ci, tail)),
        Repeat(rep) => LexerElemPlan::PlainRepeat(LexerNestedPlan {
            inner: plan_elem(&rep.element, all_rules, ci, false),
        }),
        Not(n) => LexerElemPlan::Not(LexerNestedPlan { inner: plan_elem(&n.element, all_rules, ci, false) }),
        // A recursive fragment keeps its own matcher and is reached by call, as
        // `EOF` and a non-fragment rule are.
        RuleRef(name) => match find_fragment(all_rules, &name) {
            Some(f) => if fragment_is_recursive(f, all_rules) {
                LexerElemPlan::Leaf;
            } else if fragment_is_callable(f, all_rules) {
                let tail_changes_plan = tail
                    && plan_body(&f.body, all_rules, ci, true) != plan_body(&f.body, all_rules, ci, false);
                LexerElemPlan::Call(LexerFragmentKey { name, ci, tail: tail_changes_plan });
            } else {
                LexerElemPlan::Body(plan_body(&f.body, all_rules, ci, tail));
            },
            None => LexerElemPlan::Leaf,
        },
        Literal(_) | CharRange(_) | CharClass(_) | AnyChar => LexerElemPlan::Leaf,
    };
}

/// `lexer_elem_char_set` of a group, `~` or fragment reference: the composites
/// a set test replaces. A leaf is already one.
fn lexer_composite_char_set(elem: &LexerElement, all_rules: &List<LexerRule>, ci: bool) -> Option<CharClass> {
    if elem matches { Literal(_) | CharRange(_) | CharClass(_) | AnyChar | Repeat(_) } {
        return null;
    }
    return lexer_elem_char_set(elem, all_rules, ci);
}

/// The set `elem` takes exactly one char from, folded for `ci`, when that is
/// all it does: no action, no predicate, no other length.
fn lexer_elem_char_set(elem: &LexerElement, all_rules: &List<LexerRule>, ci: bool) -> Option<CharClass> {
    return match elem {
        Literal(s) => {
            let mut cs = s.chars();
            let Some(c) = cs.next() else {
                return null;
            };
            if cs.next() matches { Some(_) } {
                return null;
            }
            Option::Some(folded_class(c, c, ci));
        },
        CharRange(pair) => Option::Some(folded_class(pair.0, pair.1, ci)),
        CharClass(cc) => Option::Some(folded_char_class(cc, ci)),
        Not(n) => match lexer_elem_char_set(&n.element, all_rules, ci) {
            Some(inner) => Option::Some(CharClass { ranges: inner.ranges, negated: !inner.negated }),
            None => null,
        },
        Group(alts) => lexer_alts_char_set(alts, all_rules, ci),
        RuleRef(name) => match find_fragment(all_rules, name) {
            Some(f) => if fragment_is_recursive(f, all_rules) {
                null;
            } else {
                lexer_alts_char_set(&f.body, all_rules, ci);
            },
            None => null,
        },
        AnyChar | Repeat(_) => null,
    };
}

/// The union of the arms' sets, each arm one positive set and nothing else.
fn lexer_alts_char_set(alts: &List<LexerAlternative>, all_rules: &List<LexerRule>, ci: bool) -> Option<CharClass> {
    let mut ranges: List<CharRange> = [];
    for let alt of alts {
        if !alt.actions.is_empty() || alt.elements.len() != 1 {
            return null;
        }
        let Some(set) = lexer_elem_char_set(&alt.elements[0], all_rules, ci) else {
            return null;
        };
        if set.negated {
            return null;
        }
        for let r of &set.ranges {
            ranges.push(*r);
        }
    }
    return Option::Some(CharClass { ranges: merged_char_ranges(&ranges), negated: false });
}

fn folded_class(start: char, end: char, ci: bool) -> CharClass {
    let mut ranges: List<CharRange> = [];
    if ci {
        fold_range_ci(start, end, &mut ranges);
    } else {
        ranges.push(CharRange { start, end });
    }
    return CharClass { ranges, negated: false };
}

/// `ranges` sorted, with overlapping and adjacent ones joined.
fn merged_char_ranges(ranges: &List<CharRange>) -> List<CharRange> {
    let mut sorted = *ranges;
    sorted.sort_by(|a, b| a.start.cmp(&b.start));
    let mut out: List<CharRange> = [];
    for let r of &sorted {
        if !out.is_empty() && r.start as i32 <= out[out.len() - 1].end as i32 + 1 {
            let last = out.len() - 1;
            if r.end > out[last].end {
                out[last].end = r.end;
            }
            continue;
        }
        out.push(*r);
    }
    return out;
}

/// Emit `alt` from element `from` on, taking every strategy from `plan`. `from`
/// lets an emit re-lower the tail of a sequence — a scored alternation peeks it,
/// a lookahead-aware repeat peeks then commits it — from those same steps.
fn gen_lexer_alt_seq<S: AsStrSlice>(
    w: &mut CodeWriter,
    alt: &LexerAlternative,
    plan: &LexerSeqPlan,
    from: i32,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    assert !replay || !ea, "the replay pass never re-evaluates a predicate the selection pass already answered";
    for let mut i = from; i < plan.steps.len(); i += 1 {
        // Every `before_index == i` predicate; the trailing one is post-loop.
        // Placed here rather than in the caller so a single-alt inlined group or
        // fragment gates its boundary predicates.
        gen_lexer_rule_predicates(w, &alt.actions, i, ea, fail_action);
        if replay {
            gen_lexer_alt_actions_at(w, &alt.actions, i);
        }
        match &plan.steps[i] {
            Repeat(rp) => {
                let Repeat(rep) = &alt.elements[i] else {
                    panic("a repeat step plans something other than a repeat");
                };
                let flow = gen_lexer_repeat_step(w, alt, plan, i, rep, rp, all_rules, fail_action, ci, ea, hm, replay);
                if flow matches { Done } {
                    return;
                }
                if flow matches { Stop } {
                    break;
                }
            },
            Group(gp) => {
                let Group(g_alts) = &alt.elements[i] else {
                    panic("a group step plans something other than a group");
                };
                match &gp.shape {
                    Scored(arms) => gen_lexer_alts_lookahead_aware(
                        w,
                        g_alts,
                        arms,
                        alt,
                        plan,
                        i + 1,
                        all_rules,
                        fail_action,
                        ci,
                        ea,
                        hm,
                        replay,
                    ),
                    FirstMatch(body) => gen_lexer_body(w, g_alts, body, all_rules, fail_action, ci, ea, hm, replay),
                }
            },
            Elem(ep) => gen_lexer_elem(w, &alt.elements[i], ep, all_rules, fail_action, ci, ea, hm, replay),
        }
    }
    gen_lexer_rule_predicates(w, &alt.actions, alt.elements.len(), ea, fail_action);
    if replay {
        gen_lexer_alt_actions_at(w, &alt.actions, alt.elements.len());
    }
}

/// What the sequence loop does after a step that may have consumed what follows
/// it.
enum SeqFlow {
    /// The step consumed only itself.
    Next,
    /// The step consumed the rest of the sequence; its trailing predicate and
    /// action are still the loop's to place.
    Stop,
    /// The step consumed the rest of the sequence, trailing predicate and action
    /// included.
    Done,
}

/// Emit the repeat at `alt.elements[index]`, and say how much of what follows it
/// took with it.
fn gen_lexer_repeat_step<S: AsStrSlice>(
    w: &mut CodeWriter,
    alt: &LexerAlternative,
    plan: &LexerSeqPlan,
    index: i32,
    rep: &LexerRepeatElement,
    rp: &LexerRepeatPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) -> SeqFlow {
    if rp.emit matches { NonGreedy } {
        let Some(cut) = &rp.rest else {
            panic("a non-greedy repeat plans no rest");
        };
        // The rest alt covers `index + 1` through the trailing predicate.
        gen_lexer_non_greedy_repeat(
            w,
            rep,
            &rp.inner,
            &cut.alt,
            &cut.plan,
            all_rules,
            fail_action,
            ci,
            ea,
            hm,
            replay,
        );
        return SeqFlow::Done;
    }
    if rp.emit matches { LookaheadAware } {
        // A naive greedy loop can over-shoot and strand the suffix at
        // end-of-input (`'a' ~('b')+ 'c'` over `abc`, the canonical
        // `Sets/UnicodeNegated*` descriptor). ANTLR4's lexer gets the longest
        // match by NFA→DFA simulation; the same answer comes out of a single
        // forward pass with explicit accept-state tracking — each iteration peeks
        // whether the suffix could start here and records the latest such
        // position, and once the inner stops matching the cursor resumes there.
        gen_lexer_repeat_lookahead_aware(
            w,
            rep,
            &rp.inner,
            alt,
            plan,
            index + 1,
            all_rules,
            fail_action,
            ci,
            ea,
            hm,
            replay,
        );
        // The emit consumes the suffix itself, and on the replay path runs the
        // actions written across it — the trailing one included.
        return if replay { SeqFlow::Done } else { SeqFlow::Stop };
    }
    gen_lexer_repeat(w, rep, &rp.inner, all_rules, fail_action, ci, ea, hm, replay);
    return SeqFlow::Next;
}

/// Emit the `{ ... }` actions positioned at `before` as statements, in source
/// order. Only reached on the replay path, where `pos` is the live match cursor,
/// so a body reading the matched text sees exactly what ANTLR4's would.
fn gen_lexer_alt_actions_at(w: &mut CodeWriter, actions: &List<AltAction>, before: i32) {
    for let a of actions {
        if a.kind matches { Action } && a.before_index == before {
            emit_lexer_action_stmt(w, &a.source.text);
        }
    }
}

/// Whether `alt` carries a semantic predicate at position `at`.
fn lexer_alt_has_predicate_at(alt: &LexerAlternative, at: i32) -> bool {
    return alt.actions.iter_ref().any(|a| a.kind matches { Predicate } && a.before_index == at);
}

/// Whether the greedy loop could eat a char the suffix needs — the one thing
/// a plain greedy loop cannot recover from, since it never looks past the
/// inner. Either side answering "unknown" counts as an overlap, so the answer
/// errs towards the emit that consults the suffix.
fn lexer_repeat_can_eat_suffix(
    inner: &LexerElement,
    suffix: &List<LexerElement>,
    all_rules: &List<LexerRule>,
    ci: bool,
) -> bool {
    let mut inner_visiting: List<String> = [];
    let inner_chars = lexer_elem_leading_chars(inner, all_rules, ci, false, &mut inner_visiting);
    let mut suffix_visiting: List<String> = [];
    let suffix_chars = lexer_seq_leading_chars(suffix, all_rules, ci, true, &mut suffix_visiting);
    return match [inner_chars, suffix_chars] {
        [Some(a), Some(b)] => leading_chars_overlap(&a, &b),
        _ => true,
    };
}

/// The chars a construct can begin with, and whether it can be skipped
/// entirely. `negated` inverts `ranges`, which is how `~[/!]` (and `.`, an
/// empty negated set) is carried — the complement is what makes
/// `('//' | ~[/!])`'s arms provably exclusive, and `~'*'` provably disjoint
/// from a `'*'`-led suffix. Code points, not `char`, so cutting one set out
/// of another never has to name a boundary `char` cannot hold.
struct LeadingChars {
    ranges: List<[i32, i32]>,
    negated: bool,
    nullable: bool,
}

/// Whether two arms could both match at the same position — the only case
/// where which arm wins is a decision at all. When no two can, the cheap
/// first-match emit already gives ANTLR4's answer and the arms need not be
/// scored against the suffix. An arm whose leading chars are unknown, or that
/// can match empty, answers "yes".
pub fn lexer_alts_can_collide(alts: &List<LexerAlternative>, all_rules: &List<LexerRule>, ci: bool) -> bool {
    let mut sets: List<LeadingChars> = [];
    for let alt of alts {
        let mut visiting: List<String> = [];
        let leading = lexer_seq_leading_chars(&alt.elements, all_rules, ci, /*follow_refs=*/ true, &mut visiting);
        match leading {
            Some(s) => {
                if s.nullable {
                    return true;
                }
                sets.push(s);
            },
            None => {
                return true;
            },
        }
    }
    for let mut i = 0; i < sets.len(); i += 1 {
        for let mut j = i + 1; j < sets.len(); j += 1 {
            if leading_chars_overlap(&sets[i], &sets[j]) {
                return true;
            }
        }
    }
    return false;
}

/// Walk a sequence, taking in each element's leading chars until one that
/// cannot be skipped. Null when any element is unknown; `nullable` when the
/// whole sequence can match empty.
fn lexer_seq_leading_chars(
    elements: &List<LexerElement>,
    all_rules: &List<LexerRule>,
    ci: bool,
    follow_refs: bool,
    visiting: &mut List<String>,
) -> Option<LeadingChars> {
    // The empty positive set matches nothing — the identity this folds from.
    let mut acc = LeadingChars { ranges: [], negated: false, nullable: true };
    for let elem of elements {
        let step = lexer_elem_leading_chars(elem, all_rules, ci, follow_refs, visiting);
        match step {
            Some(s) => {
                acc = union_leading_chars(&acc, &s);
                if !s.nullable {
                    acc.nullable = false;
                    return Option::<LeadingChars>::Some(acc);
                }
            },
            None => {
                return null;
            },
        }
    }
    acc.nullable = true;
    return Option::<LeadingChars>::Some(acc);
}

fn lexer_alts_leading_chars(
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    ci: bool,
    follow_refs: bool,
    visiting: &mut List<String>,
) -> Option<LeadingChars> {
    if alts.is_empty() {
        return null;
    }
    let mut acc = LeadingChars { ranges: [], negated: false, nullable: false };
    for let alt of alts {
        let arm = lexer_seq_leading_chars(&alt.elements, all_rules, ci, follow_refs, visiting);
        match arm {
            Some(s) => {
                let nullable = acc.nullable || s.nullable;
                acc = union_leading_chars(&acc, &s);
                acc.nullable = nullable;
            },
            None => {
                return null;
            },
        }
    }
    return Option::<LeadingChars>::Some(acc);
}

fn lexer_elem_leading_chars(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    ci: bool,
    follow_refs: bool,
    visiting: &mut List<String>,
) -> Option<LeadingChars> {
    return match *elem {
        Literal(text) => match text.chars().next() {
            Some(c) => plain_leading_chars(&folded_ranges(c, c, ci)),
            None => null,
        },
        CharRange(pair) => plain_leading_chars(&folded_ranges(pair.0, pair.1, ci)),
        CharClass(cc) => {
            // A case-folded complement is not the complement of the folded
            // ranges, so a negated class under `ci` stays unknown.
            if cc.negated && ci {
                return null;
            }
            let mut ranges: List<[i32, i32]> = [];
            for let r of &cc.ranges {
                for let f of &folded_ranges(r.start, r.end, ci) {
                    ranges.push(*f);
                }
            }
            Option::<LeadingChars>::Some(LeadingChars { ranges, negated: cc.negated, nullable: false });
        },
        AnyChar => any_leading_chars(),
        Not(not_inner) => {
            // Folding widens a positive set but narrows its complement, so a
            // complement read under `ci` could invent a disjointness that does
            // not hold. Same guard as the negated `CharClass` above.
            if ci {
                return null;
            }
            match lexer_elem_leading_chars(&not_inner.element, all_rules, ci, follow_refs, visiting) {
                Some(inner) => if inner.negated || inner.nullable {
                    null;
                } else {
                    Option::<LeadingChars>::Some(
                        LeadingChars { ranges: inner.ranges, negated: true, nullable: false },
                    );
                },
                None => null,
            }
        },
        Repeat(rep) => match lexer_elem_leading_chars(&rep.element, all_rules, ci, follow_refs, visiting) {
            Some(inner) => Option::<LeadingChars>::Some(
                LeadingChars {
                    ranges: inner.ranges,
                    negated: inner.negated,
                    nullable: rep.kind matches { Star | Optional } || inner.nullable,
                },
            ),
            None => null,
        },
        Group(alts) => lexer_alts_leading_chars(&alts, all_rules, ci, follow_refs, visiting),
        RuleRef(name) => {
            if !follow_refs || name == "EOF" || visiting.contains(&name) {
                return null;
            }
            // On the path, not visited: a rule named twice in one suffix is two
            // independent reads, and only a cycle is unanswerable.
            visiting.push(name);
            let reached = match find_lexer_rule(all_rules, &name) {
                // The callee resolves its own `caseInsensitive`, which is not
                // visible from here, so the folded reading is the safe one: a
                // wider set can lose a disjointness proof, never invent one.
                Some(rule) => lexer_alts_leading_chars(&rule.body, all_rules, /*ci=*/ true, follow_refs, visiting),
                None => null,
            };
            visiting.pop();
            reached;
        },
    };
}

fn plain_leading_chars(ranges: &List<[i32, i32]>) -> Option<LeadingChars> {
    return Option::<LeadingChars>::Some(LeadingChars { ranges: *ranges, negated: false, nullable: false });
}

/// The set every char satisfies — `.`, and the reading a complement that
/// cannot be narrowed falls back to.
fn any_leading_chars() -> Option<LeadingChars> {
    return Option::<LeadingChars>::Some(LeadingChars { ranges: [], negated: true, nullable: false });
}

fn folded_ranges(start: char, end: char, ci: bool) -> List<[i32, i32]> {
    return folded_class(start, end, ci).ranges.iter_ref().map(|r: &CharRange| [r.start as i32, r.end as i32]).collect();
}

/// Union two leading sets. A complement absorbs a plain set by dropping the
/// plain set's chars from its exclusion list — `~[/*]` followed by `'/'`
/// leaves `~'*'`, which is what keeps a `'*'`-led repeat off the peek — and
/// two complements union to the complement of their intersection.
fn union_leading_chars(acc: &LeadingChars, add: &LeadingChars) -> LeadingChars {
    let nullable = acc.nullable;
    if acc.negated && add.negated {
        return LeadingChars { ranges: ranges_intersect(&acc.ranges, &add.ranges), negated: true, nullable };
    }
    if acc.negated {
        return LeadingChars { ranges: ranges_minus(&acc.ranges, &add.ranges), negated: true, nullable };
    }
    if add.negated {
        return LeadingChars { ranges: ranges_minus(&add.ranges, &acc.ranges), negated: true, nullable };
    }
    let mut ranges = acc.ranges;
    for let r of &add.ranges {
        ranges.push(*r);
    }
    return LeadingChars { ranges, negated: false, nullable };
}

/// Whether some char satisfies both sets. Two complements always can in
/// practice — it would take two negated classes that between them name every
/// code point — so that pair answers "yes" without computing it.
fn leading_chars_overlap(a: &LeadingChars, b: &LeadingChars) -> bool {
    if a.negated && b.negated {
        return true;
    }
    if a.negated {
        return !ranges_minus(&b.ranges, &a.ranges).is_empty();
    }
    if b.negated {
        return !ranges_minus(&a.ranges, &b.ranges).is_empty();
    }
    return !ranges_intersect(&a.ranges, &b.ranges).is_empty();
}

/// `a` with every char of `b` cut out.
fn ranges_minus(a: &List<[i32, i32]>, b: &List<[i32, i32]>) -> List<[i32, i32]> {
    let mut out: List<[i32, i32]> = [];
    for let r of a {
        let mut pieces: List<[i32, i32]> = [*r];
        for let cut of b {
            let mut next: List<[i32, i32]> = [];
            for let p of &pieces {
                if cut.1 < p.0 || cut.0 > p.1 {
                    next.push(*p);
                    continue;
                }
                if p.0 < cut.0 {
                    next.push([p.0, cut.0 - 1]);
                }
                if cut.1 < p.1 {
                    next.push([cut.1 + 1, p.1]);
                }
            }
            pieces = next;
        }
        for let p of &pieces {
            out.push(*p);
        }
    }
    return out;
}

/// Expansion steps `lexer_second_chars` takes before it answers "unknown", which
/// is what bounds a loop over a repeat whose body can match empty.
global SECOND_CHARS_BUDGET: i32 = 64;

/// What a token can hold after its first char: the code points its second
/// position admits, and whether it can end after one char.
struct SecondChars {
    ranges: List<[i32, i32]>,
    may_end: bool,
}

/// `SecondChars` of a rule body, or null when some path is unknown.
fn lexer_second_chars(alts: &List<LexerAlternative>, all_rules: &List<LexerRule>, ci: bool) -> Option<SecondChars> {
    let mut budget = SECOND_CHARS_BUDGET;
    let mut acc = SecondChars { ranges: [], may_end: false };
    for let alt of alts {
        if !add_second_chars(&alt.elements, all_rules, ci, &mut budget, &mut acc) {
            return null;
        }
    }
    return Option::Some(acc);
}

/// Adds to `acc` what can follow the first char `elements` consume. False when
/// that is unknown.
fn add_second_chars(
    elements: &List<LexerElement>,
    all_rules: &List<LexerRule>,
    ci: bool,
    budget: &mut i32,
    acc: &mut SecondChars,
) -> bool {
    *budget -= 1;
    // A path that ends here consumed no first char, so no second char tests it.
    if *budget < 0 || elements.is_empty() {
        return false;
    }
    let rest: List<LexerElement> = elements.iter_value().skip(1).collect();
    return match elements[0] {
        Literal(text) => {
            let chars: List<char> = text.chars().collect();
            if chars.is_empty() {
                return add_second_chars(&rest, all_rules, ci, budget, acc);
            }
            if chars.len() == 1 {
                return add_following_chars(&rest, all_rules, ci, acc);
            }
            acc.ranges.extend(&folded_ranges(chars[1], chars[1], ci));
            true;
        },
        CharRange(_) | CharClass(_) | AnyChar | Not(_) => add_following_chars(&rest, all_rules, ci, acc),
        Group(alts) => add_alts_second_chars(&alts, &rest, all_rules, ci, budget, acc),
        RuleRef(name) => match find_lexer_rule(all_rules, &name) {
            // A rule its own `try_` matches folds case its own way, so it is read
            // folded, as `lexer_elem_leading_chars` reads it.
            Some(r) => {
                let folds_own_way = !r.is_fragment || fragment_is_recursive(r, all_rules);
                add_alts_second_chars(&r.body, &rest, all_rules, ci || folds_own_way, budget, acc);
            },
            None => false,
        },
        Repeat(rep) => {
            let mut taken: List<LexerElement> = [rep.element];
            if !rep.kind matches { Optional } {
                taken.push(LexerElement::Repeat(LexerRepeatElement { ..rep, kind: RepeatKind::Star }));
            }
            taken.extend(&rest);
            let skipped = rep.kind matches { Plus } || add_second_chars(&rest, all_rules, ci, budget, acc);
            skipped && add_second_chars(&taken, all_rules, ci, budget, acc);
        },
    };
}

fn add_alts_second_chars(
    alts: &List<LexerAlternative>,
    rest: &List<LexerElement>,
    all_rules: &List<LexerRule>,
    ci: bool,
    budget: &mut i32,
    acc: &mut SecondChars,
) -> bool {
    for let alt of alts {
        let mut seq = alt.elements;
        seq.extend(rest);
        if !add_second_chars(&seq, all_rules, ci, budget, acc) {
            return false;
        }
    }
    return true;
}

/// Adds to `acc` the chars `rest` can begin with, once one char is consumed.
fn add_following_chars(rest: &List<LexerElement>, all_rules: &List<LexerRule>, ci: bool, acc: &mut SecondChars) -> bool {
    let mut visiting: List<String> = [];
    let Some(lead) = lexer_seq_leading_chars(rest, all_rules, ci, /*follow_refs=*/ true, &mut visiting) else {
        return false;
    };
    if lead.nullable {
        acc.may_end = true;
    }
    acc.ranges.extend(&if lead.negated {
        ranges_minus(&[
            [0, 0x10FFFF],
        ], &lead.ranges);
    } else {
        lead.ranges;
    });
    return true;
}

fn ranges_intersect(a: &List<[i32, i32]>, b: &List<[i32, i32]>) -> List<[i32, i32]> {
    let mut out: List<[i32, i32]> = [];
    for let x of a {
        for let y of b {
            let lo = i32::max(x.0, y.0);
            let hi = i32::min(x.1, y.1);
            if lo <= hi {
                out.push([lo, hi]);
            }
        }
    }
    return out;
}

/// The `Plus` / `Star` inner of a lookahead-aware repeat must consume
/// exactly one char per iteration, so the loop's per-iteration peek records
/// a position one char past the last successful inner. A RuleRef escapes
/// into a rule call and a nested Repeat runs its own loop, so neither has a
/// per-char iteration to record against.
///
/// `~('b')` parses as `Not(Group([Alt([Literal("b")])]))` and `~('b' | ' ')`
/// as `Not(Group([Alt(['b']), Alt([' '])]))`; either consumes exactly one
/// char as long as every alt body is a single one-char element.
fn lexer_element_can_consume_simple(elem: &LexerElement) -> bool {
    return match *elem {
        Literal(text) => text.chars().count() == 1,
        CharRange(_) | CharClass(_) | AnyChar => true,
        Not(not_inner) => lexer_element_can_consume_simple(&not_inner.element),
        Group(alts) => {
            for let alt of alts {
                if alt.elements.len() != 1 {
                    return false;
                }
                if !lexer_element_can_consume_simple(&alt.elements[0]) {
                    return false;
                }
            }
            !alts.is_empty();
        },
        RuleRef(_) | Repeat(_) => false,
    };
}

/// True when the suffix can be safely peeked. Shape is not the constraint —
/// `gen_lexer_suffix_seq` lowers it as the commit will and `pos` is restored
/// — but a semantic predicate is: the peek would evaluate it once per scored
/// arm or repeat iteration and again on commit, changing how often the
/// grammar sees it and letting a state-dependent one answer differently in
/// the two passes.
fn lexer_suffix_is_peekable(elements: &List<LexerElement>, all_rules: &List<LexerRule>) -> bool {
    if elements.is_empty() {
        return false;
    }
    for let elem of elements {
        let mut visiting: List<String> = [];
        if !lexer_elem_is_peek_safe(elem, all_rules, &mut visiting) {
            return false;
        }
    }
    return true;
}

/// Whether peeking `elem` evaluates no semantic predicate. A rule reference is
/// followed rather than treated as a boundary — unlike
/// `lexer_elem_has_predicate_below`, where the callee runs once, the peek runs
/// it twice. `visiting` breaks reference cycles; a rule already on the path
/// contributes nothing new.
fn lexer_elem_is_peek_safe(elem: &LexerElement, all_rules: &List<LexerRule>, visiting: &mut List<String>) -> bool {
    return match *elem {
        Literal(_) | CharRange(_) | CharClass(_) | AnyChar => true,
        Not(not_inner) => lexer_elem_is_peek_safe(&not_inner.element, all_rules, visiting),
        Repeat(rep) => lexer_elem_is_peek_safe(&rep.element, all_rules, visiting),
        Group(alts) => {
            for let a of alts {
                if !lexer_alt_is_peek_safe(&a, all_rules, visiting) {
                    return false;
                }
            }
            !alts.is_empty();
        },
        RuleRef(name) => {
            if name == "EOF" || visiting.contains(&name) {
                return true;
            }
            visiting.push(name);
            match find_lexer_rule(all_rules, &name) {
                Some(r) => {
                    for let a of &r.body {
                        if !lexer_alt_is_peek_safe(a, all_rules, visiting) {
                            return false;
                        }
                    }
                    true;
                },
                None => false,
            }
        },
    };
}

fn lexer_alt_is_peek_safe(alt: &LexerAlternative, all_rules: &List<LexerRule>, visiting: &mut List<String>) -> bool {
    for let a of &alt.actions {
        if a.kind matches { Predicate } {
            return false;
        }
    }
    for let e of &alt.elements {
        if !lexer_elem_is_peek_safe(e, all_rules, visiting) {
            return false;
        }
    }
    return true;
}

/// Emit a greedy `Plus` / `Star` whose inner can consume the suffix's
/// first character, in single-pass forward DFA style. At every
/// position where the suffix could legally start we record the
/// position in `accept_<id>`; once the inner stops matching we rewind
/// the cursor exactly once to the latest recorded position and
/// consume the suffix normally. This is the standard lexer
/// longest-match algorithm (NFA→DFA with accept-state tracking),
/// performed without any try-fail-retry backtracking.
///
/// On the replay path the scan stays match-only and a second walk re-runs the
/// iterations it kept — never the ones it tried and gave back — then the rest,
/// so every action lands at the cursor it was written at.
fn gen_lexer_repeat_lookahead_aware<S: AsStrSlice>(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    inner: &LexerElemPlan,
    alt: &LexerAlternative,
    plan: &LexerSeqPlan,
    from: i32,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    let id = w.next_id();
    let accept_var = `accept_${id}`;
    let loop_label = `la_rep_${id}`;
    // The scan settles where the loop stops, so on the replay path it evaluates
    // the predicates the match evaluated (`probe_ea`); the walk below does not.
    let pea = probe_ea(replay, ea);

    if replay {
        w.line(`let la_start_${id} = pos;`);
    }
    w.line(`let mut ${accept_var}: i32 = -1;`);

    // Star: zero iterations is a valid endpoint, so the suffix may
    // legally start at the current position even before any inner
    // consumption.
    if let Star = rep.kind {
        gen_lexer_suffix_peek(w, alt, plan, from, all_rules, &accept_var, ci, pea, hm);
    }

    // Plus: the first iteration is mandatory and may not be skipped.
    if let Plus = rep.kind {
        gen_lexer_elem(w, &rep.element, inner, all_rules, fail_action, ci, pea, hm, false);
        gen_lexer_suffix_peek(w, alt, plan, from, all_rules, &accept_var, ci, pea, hm);
    }

    // Forward scan: each iteration of the inner advances pos and
    // re-peeks the suffix. `accept_<id>` always holds the latest
    // position where the suffix could start; once the inner can no
    // longer match we exit the loop and resume from that position.
    w.begin("loop");
    w.line(`let la_saved_${id} = pos;`);
    w.begin(`${loop_label}:`);
    gen_lexer_elem(w, &rep.element, inner, all_rules, `break ${loop_label}`, ci, pea, hm, false);
    gen_lexer_suffix_peek(w, alt, plan, from, all_rules, &accept_var, ci, pea, hm);
    w.line("continue;");
    w.end();
    w.line(`pos = la_saved_${id};`);
    w.line("break;");
    w.end();

    w.begin(`if ${accept_var} < 0`);
    w.line(`${fail_action};`);
    w.end();

    if replay {
        // Each iteration consumes exactly one char (`PlainInnerNotPerChar` is
        // the alternative emit otherwise), so the accept position alone says how
        // many of them the match kept.
        assert lexer_element_can_consume_simple(&rep.element), "a lookahead-aware repeat's inner consumes exactly one char per iteration";
        w.line(`pos = la_start_${id};`);
        gen_lexer_replay_to(w, &rep.element, inner, all_rules, &accept_var, ci, hm);
        gen_lexer_alt_seq(w, alt, plan, from, all_rules, fail_action, ci, ea, hm, /*replay=*/ true);
        return;
    }
    w.line(`pos = ${accept_var};`);

    // Re-consume the suffix to advance `pos` past it. The peek that
    // recorded `accept_var` already proved every suffix element
    // matches at that position, so divergence here can only mean a
    // codegen bug in `gen_lexer_suffix_peek` (peek and commit emit
    // different element shapes). Pass a `panic` fail-action instead
    // of the caller's `return -1` so such divergence traps loudly at
    // runtime rather than silently degrading to a "rule rejected"
    // verdict.
    let assert_msg = `lexer DFA invariant: gen_lexer_suffix_peek and the post-loop suffix commit must agree on match outcome (accept_<id> recorded a position the commit then rejected)`;
    let assert_fail = `panic("${assert_msg}")`;
    gen_lexer_suffix_seq(w, alt, plan, from, all_rules, &assert_fail, ci, ea, hm);
}

/// Re-walk `inner` from the cursor to `bound`, with its actions on. The scan
/// that set `bound` already proved every iteration up to it matches, so a
/// mismatch — or a cursor landing anywhere but `bound` — is a codegen bug, and
/// traps loudly rather than degrading to a "rule rejected" verdict.
fn gen_lexer_replay_to<S: AsStrSlice>(
    w: &mut CodeWriter,
    inner: &LexerElement,
    inner_plan: &LexerElemPlan,
    all_rules: &List<LexerRule>,
    bound: S,
    ci: bool,
    hm: bool,
) {
    let msg = `lexer replay invariant: the action pass must re-walk exactly the iterations the scan accepted`;
    let fail = `panic("${msg}")`;
    w.begin(`while pos < ${bound}`);
    gen_lexer_elem(w, inner, inner_plan, all_rules, &fail, ci, /*ea=*/ false, hm, /*replay=*/ true);
    w.end();
    w.line(`if pos != ${bound} { ${fail}; }`);
}

/// Maximal-munch emit for an alternation that has a suffix after it.
///
/// The arm matching first need not be the one letting the rule match
/// (`('a' | 'ab') 'bc'` on `abbc` needs the second), and neither need the
/// longest (`('x' | 'xy') 'yz'` on `xyz` needs the first). ANTLR4 simulates
/// the whole rule, so the winner is the arm whose arm-plus-suffix reaches
/// furthest — scored on the suffix, not the arm, which differs once the suffix
/// is itself variable-length (`('p' | 'pq') ('qrs' | 'r')` on `pqrs`). Ties go
/// to the first arm.
///
/// Same single-pass accept-state tracking as
/// `gen_lexer_repeat_lookahead_aware`, and no try-fail-retry: the selection
/// scan is match-only, so a losing arm never runs an action.
fn gen_lexer_alts_lookahead_aware<S: AsStrSlice>(
    w: &mut CodeWriter,
    alts: &List<LexerAlternative>,
    arms: &List<LexerSeqPlan>,
    alt: &LexerAlternative,
    plan: &LexerSeqPlan,
    from: i32,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    let id = w.next_id();
    w.line(`let la_saved_${id} = pos;`);
    w.line(`let mut la_reach_${id}: i32 = -1;`);
    w.line(`let mut la_end_${id}: i32 = -1;`);
    w.line(`let mut la_win_${id}: i32 = -1;`);
    let mut arm_ends: List<String> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let label = `la_alt_${id}_${i}`;
        w.line(`let mut la_arm_${id}_${i}: i32 = -1;`);
        w.begin(`${label}:`);
        w.line(`pos = la_saved_${id};`);
        gen_lexer_arm_probe(w, &alts[i], &arms[i], all_rules, `break ${label}`, ci, ea, hm, replay);
        w.line(`la_arm_${id}_${i} = pos;`);
        w.end();
        let pattern = if i == alts.len() - 1 { "_" } else { `${i}` };
        arm_ends.push(`${pattern} => la_arm_${id}_${i}`);
    }
    // One suffix peek, run from each arm's end in turn: the suffix is emitted
    // once rather than once per arm.
    w.begin(`for let mut la_i_${id} = 0; la_i_${id} < ${alts.len()}; la_i_${id} += 1`);
    w.line(`let la_at_${id} = match la_i_${id} { ${arm_ends.join(", ")} };`);
    w.line(`if la_at_${id} < 0 { continue; }`);
    w.line(`pos = la_at_${id};`);
    w.line(`let mut la_tot_${id}: i32 = -1;`);
    gen_lexer_suffix_peek(
        w,
        alt,
        plan,
        from,
        all_rules,
        `la_tot_${id}`,
        ci,
        probe_ea(replay, ea),
        hm,
        /*record_end=*/ true,
    );
    // Strict `>` over arms in source order gives ANTLR4's tie-break.
    w.begin(`if la_tot_${id} > la_reach_${id}`);
    w.line(`la_reach_${id} = la_tot_${id};`);
    w.line(`la_end_${id} = la_at_${id};`);
    w.line(`la_win_${id} = la_i_${id};`);
    w.end();
    w.end();
    w.line(`if la_win_${id} < 0 { ${fail_action}; }`);
    if !replay {
        w.line(`pos = la_end_${id};`);
        return;
    }
    // Re-run the winner so its actions fire at the cursor they were written at.
    // `ea = false`: re-evaluating a state-dependent predicate could reject here
    // what the selection pass accepted.
    w.line(`pos = la_saved_${id};`);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i == 0 {
            w.begin(`if la_win_${id} == ${i}`);
        } else {
            w.else_begin(`else if la_win_${id} == ${i}`);
        }
        gen_lexer_alt_seq(w, &alts[i], &arms[i], 0, all_rules, fail_action, ci, false, hm, true);
    }
    w.end();
}

/// Lower what follows `alt.elements[from - 1]` the way the sequence itself
/// would: the same steps of the same plan, from the same index. Both the peek
/// and the commit go through here, so what a peek proves is what the commit then
/// runs — and neither can pick a strategy the sequence would not have.
///
/// The alternative's own actions stay with the alternative: the emit that cuts
/// here either breaks out to the post-loop pass or replays the whole sequence,
/// so this pass carries the elements alone.
fn gen_lexer_suffix_seq<S: AsStrSlice>(
    w: &mut CodeWriter,
    alt: &LexerAlternative,
    plan: &LexerSeqPlan,
    from: i32,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let bare = LexerAlternative { elements: alt.elements };
    gen_lexer_alt_seq(w, &bare, plan, from, all_rules, fail_action, ci, ea, hm, /*replay=*/ false);
}

/// Emit a save / try-suffix / restore block that records a position in
/// `accept_var` iff the suffix would match starting here. Pos is restored
/// unconditionally so the surrounding forward scan continues without
/// committing the peeked suffix.
///
/// `record_end` picks which position: a repeat wants where the suffix would
/// START, to resume its cursor there; an alternation wants where it would END,
/// which is how far the whole rule reaches through the arm being scored.
fn gen_lexer_suffix_peek<S: AsStrSlice>(
    w: &mut CodeWriter,
    alt: &LexerAlternative,
    plan: &LexerSeqPlan,
    from: i32,
    all_rules: &List<LexerRule>,
    accept_var: S,
    ci: bool,
    ea: bool,
    hm: bool,
    record_end: bool = false,
) {
    let id = w.next_id();
    let save_var = `peek_save_${id}`;
    let matched_var = `peek_ok_${id}`;
    let end_var = `peek_end_${id}`;
    let label = `peek_${id}`;
    w.line(`let ${save_var} = pos;`);
    if lexer_suffix_always_matches(alt, plan, from) {
        gen_lexer_suffix_seq(w, alt, plan, from, all_rules, "unreachable()", ci, ea, hm);
        w.line(`${accept_var} = ${if record_end { "pos" } else { save_var }};`);
        w.line(`pos = ${save_var};`);
        return;
    }
    w.line(`let mut ${matched_var} = false;`);
    if record_end {
        w.line(`let mut ${end_var}: i32 = -1;`);
    }
    w.begin(`${label}:`);
    gen_lexer_suffix_seq(w, alt, plan, from, all_rules, `break ${label}`, ci, ea, hm);
    if record_end {
        w.line(`${end_var} = pos;`);
    }
    w.line(`${matched_var} = true;`);
    w.end();
    w.line(`pos = ${save_var};`);
    w.begin(`if ${matched_var}`);
    w.line(`${accept_var} = ${if record_end { end_var } else { save_var }};`);
    w.end();
}

/// Whether the steps of `alt` from `from` on match wherever they start: greedy
/// `?` and `*` loops, which stop rather than fail, with no predicate between.
fn lexer_suffix_always_matches(alt: &LexerAlternative, plan: &LexerSeqPlan, from: i32) -> bool {
    if alt.actions.iter_ref().any(|a| a.kind matches { Predicate } && a.before_index >= from) {
        return false;
    }
    for let mut i = from; i < plan.steps.len(); i += 1 {
        let Repeat(rp) = &plan.steps[i] else {
            return false;
        };
        let Repeat(rep) = &alt.elements[i] else {
            unreachable();
        };
        if !rep.kind matches { Optional | Star } || rp.emit matches { NonGreedy | LookaheadAware } {
            return false;
        }
    }
    return true;
}

fn gen_lexer_elem<S: AsStrSlice>(
    w: &mut CodeWriter,
    elem: &LexerElement,
    plan: &LexerElemPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    match plan {
        // A group, or the body of a fragment the plan inlines at this reference —
        // inheriting the caller's CI context, where a fragment reached by call
        // uses the grammar-level one in its own `try_*` fn.
        Body(body) => {
            let alts = elem_inlined_body(elem, all_rules);
            gen_lexer_body(w, &alts, body, all_rules, fail_action, ci, ea, hm, replay);
        },
        PlainRepeat(nested) => {
            let Repeat(rep) = elem else {
                panic("a repeat plan against something other than a repeat");
            };
            gen_lexer_repeat(w, rep, &nested.inner, all_rules, fail_action, ci, ea, hm, replay);
        },
        Not(nested) => {
            let Not(not_elem) = elem else {
                panic("a negation plan against something other than a `~`");
            };
            gen_lexer_not(w, not_elem, &nested.inner, all_rules, fail_action, ci, ea, hm);
        },
        CharSet(set) => gen_char_class(w, set, fail_action),
        Call(key) => gen_lexer_call(w, &key.fn_name(), fail_action, hm),
        Leaf => gen_lexer_leaf(w, elem, fail_action, ci, hm),
    }
}

fn gen_lexer_call<S: AsStrSlice, S1: AsStrSlice>(w: &mut CodeWriter, fn_name: S, fail_action: S1, hm: bool) {
    let call_ctx = if hm { "lx" } else { "chars" };
    w.line(`pos = ${fn_name}(${call_ctx}, pos);`);
    w.line(`if pos < 0 { ${fail_action}; }`);
}

/// The alternatives a `Body` plan covers: a group's own, or the body of the
/// fragment inlined at a rule reference.
fn elem_inlined_body(elem: &LexerElement, all_rules: &List<LexerRule>) -> List<LexerAlternative> {
    if let Group(alts) = elem {
        return *alts;
    }
    let RuleRef(name) = elem else {
        panic("a body plan against neither a group nor a rule reference");
    };
    let Some(f) = find_fragment(all_rules, name) else {
        panic("a body plan against a rule reference with no fragment");
    };
    return f.body;
}

/// An element the emit consumes without descending into it: a literal, a char
/// class or range, `.`, `EOF`, or a rule reached by its own `try_*` fn.
fn gen_lexer_leaf<S: AsStrSlice>(w: &mut CodeWriter, elem: &LexerElement, fail_action: S, ci: bool, hm: bool) {
    match *elem {
        Literal(text) => {
            let chars: List<char> = text.chars().collect();
            for let mut i = 0; i < chars.len(); i += 1 {
                let mismatch = gen_char_mismatch(`chars[pos]`, chars[i], ci);
                w.line(`if pos >= chars.len() || ${mismatch} { ${fail_action}; }`);
                w.line("pos += 1;");
            }
        },
        CharRange(pair) => {
            if ci {
                gen_char_class(w, &folded_class(pair.0, pair.1, ci), fail_action);
            } else {
                w.line(
                    `if pos >= chars.len() || !(chars[pos] matches { ${char_pat(pair.0, pair.1)} }) { ${fail_action}; }`,
                );
                w.line("pos += 1;");
            }
        },
        CharClass(cc) => {
            gen_char_class(w, &folded_char_class(&cc, ci), fail_action);
        },
        AnyChar => {
            w.line(`if pos >= chars.len() { ${fail_action}; }`);
            w.line("pos += 1;");
        },
        RuleRef(name) => {
            if name == "EOF" {
                w.line(`if pos < chars.len() { ${fail_action}; }`);
            } else {
                gen_lexer_call(w, &lexer_try_fn_name(&name), fail_action, hm);
            }
        },
        Group(_) | Repeat(_) | Not(_) => panic("a composite element planned as a leaf"),
    }
}

fn folded_char_class(cc: &CharClass, ci: bool) -> CharClass {
    if !ci {
        return *cc;
    }
    let mut expanded: List<CharRange> = [];
    for let r of &cc.ranges {
        fold_range_ci(r.start, r.end, &mut expanded);
    }
    return CharClass { ranges: expanded, negated: cc.negated };
}

fn gen_char_class<S: AsStrSlice>(w: &mut CodeWriter, cc: &CharClass, fail_action: S) {
    w.line(`if pos >= chars.len() { ${fail_action}; }`);
    let cond = char_class_disjunction(w, cc);
    if cc.negated {
        w.line(`if ${cond} { ${fail_action}; }`);
    } else {
        w.line(`if !(${cond}) { ${fail_action}; }`);
    }
    w.line("pos += 1;");
}

/// A class with more ranges than this is tested by a function defined once,
/// rather than spelled out at every site: `\p{L}` alone is hundreds.
global SHARED_CHAR_SET_MIN_RANGES: i32 = 16;

/// `(chars[pos] matches { 'x' | 'lo'..='hi' | ... })` for a char class, or a
/// call to the shared function testing a large one.
fn char_class_disjunction(w: &mut CodeWriter, cc: &CharClass) -> String {
    if cc.ranges.len() == 0 {
        return "(false)";
    }
    let pattern = || cc.ranges.iter_ref().map(|r| char_pat(r.start, r.end)).collect().join(" | ");
    if cc.ranges.len() <= SHARED_CHAR_SET_MIN_RANGES {
        return `(chars[pos] matches { ${pattern()} })`;
    }
    let key = cc.ranges.iter_ref().map(|r| `${r.start as u32:x}-${r.end as u32:x}`).collect().join(",");
    let name = w.hoist_fn(
        &key,
        "in_char_set_",
        |name: &String| `fn ${*name}(c: char) -> bool {\n    return c matches { ${pattern()} };\n}\n\n`,
    );
    return `${name}(chars[pos])`;
}

fn gen_lexer_repeat<S: AsStrSlice>(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    inner: &LexerElemPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool = false,
) {
    let id = w.next_id();
    let label = if rep.kind matches { Optional } { `opt_${id}` } else { `rep_${id}` };
    let break_label = `break ${label}`;
    if let Star = rep.kind {
        w.begin("loop");
        w.line(`let rep_saved_${id} = pos;`);
        w.begin(`${label}:`);
        gen_lexer_repeat_iteration(w, rep, inner, all_rules, &break_label, ci, ea, hm, replay, id);
        w.line("continue;");
        w.end();
        w.line(`pos = rep_saved_${id};`);
        w.line("break;");
        w.end();
    }
    if let Plus = rep.kind {
        gen_lexer_repeat_iteration(w, rep, inner, all_rules, fail_action, ci, ea, hm, replay, id);
        // The loop's own probe names, minted rather than derived: two iterations
        // in one fn must not share a `rep_probe_`.
        let loop_id = w.next_id();
        w.begin("loop");
        w.line(`let rep_saved_${id} = pos;`);
        w.begin(`${label}:`);
        gen_lexer_repeat_iteration(w, rep, inner, all_rules, &break_label, ci, ea, hm, replay, loop_id);
        w.line("continue;");
        w.end();
        w.line(`pos = rep_saved_${id};`);
        w.line("break;");
        w.end();
    }
    if let Optional = rep.kind {
        w.line(`let opt_saved_${id} = pos;`);
        w.line(`let mut opt_ok_${id} = false;`);
        w.begin(`${label}:`);
        gen_lexer_repeat_iteration(w, rep, inner, all_rules, &break_label, ci, ea, hm, replay, id);
        w.line(`opt_ok_${id} = true;`);
        w.end();
        w.line(`if !opt_ok_${id} { pos = opt_saved_${id}; }`);
    }
}

/// One iteration of a repeat: the inner element, and on the replay path a
/// match-only probe of it first, so a non-matching iteration runs no action.
fn gen_lexer_repeat_iteration<S: AsStrSlice>(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    inner: &LexerElemPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
    id: i32,
) {
    if !replay {
        gen_lexer_elem(w, &rep.element, inner, all_rules, fail_action, ci, ea, hm, false);
        return;
    }
    // Whether this iteration ran is the match's decision, so the probe evaluates
    // the predicates the match evaluated (`probe_ea`); the walk below does not.
    let pea = probe_ea(replay, ea);
    if !lexer_element_has_action(&rep.element, all_rules) {
        gen_lexer_elem(w, &rep.element, inner, all_rules, fail_action, ci, pea, hm, false);
        // Same bound as the action-carrying form below: the replay stops where
        // the match did, whatever the match consulted to stop there.
        w.line(`if pos > end { ${fail_action}; }`);
        return;
    }
    let probe = `rep_probe_${id}`;
    w.line(`let ${probe}_saved = pos;`);
    w.line(`let mut ${probe}_ok = false;`);
    w.begin(`${probe}:`);
    gen_lexer_elem(w, &rep.element, inner, all_rules, `break ${probe}`, ci, pea, hm, false);
    w.line(`${probe}_ok = true;`);
    w.end();
    // The winner's extent bounds the replay: an iteration reaching past `end`
    // is not part of the match, however the match pass came to stop there.
    w.line(`if !${probe}_ok || pos > end { pos = ${probe}_saved; ${fail_action}; }`);
    w.line(`pos = ${probe}_saved;`);
    gen_lexer_elem(w, &rep.element, inner, all_rules, fail_action, ci, ea, hm, true);
}

/// Whether `elem` carries an action anywhere inside it, counting what a rule
/// reference inlines — the only reason an iteration needs its match-only probe.
fn lexer_element_has_action(elem: &LexerElement, all_rules: &List<LexerRule>) -> bool {
    return match *elem {
        Group(alts) => alts.iter_ref().any(|a: &LexerAlternative| lexer_alt_has_any_action(a, all_rules)),
        Repeat(rep) => lexer_element_has_action(&rep.element, all_rules),
        Not(n) => lexer_element_has_action(&n.element, all_rules),
        RuleRef(name) => match find_fragment(all_rules, &name) {
            Some(f) => !fragment_is_recursive(f, all_rules)
                && f.body.iter_ref().any(
                    |a: &LexerAlternative| lexer_alt_has_any_action(a, all_rules),
                ),
            None => false,
        },
        Literal(_) | CharRange(_) | CharClass(_) | AnyChar => false,
    };
}

fn lexer_alt_has_any_action(alt: &LexerAlternative, all_rules: &List<LexerRule>) -> bool {
    return alt.actions.iter_ref().any(|a: &AltAction| a.kind matches { Action })
        || alt.elements.iter_ref().any(|e: &LexerElement| lexer_element_has_action(e, all_rules));
}

/// Emit a non-greedy `*?` / `+?`: each iteration tries the rest first and only
/// consumes another inner element when the rest does not match here.
///
/// On the replay path the exit try stays match-only and the rest is re-run once
/// after the loop, from the position that ended it — so the rest's actions fire
/// for the iteration that exits and for no other.
fn gen_lexer_non_greedy_repeat<S: AsStrSlice>(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    inner: &LexerElemPlan,
    rest: &LexerAlternative,
    rest_plan: &LexerSeqPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
    replay: bool,
) {
    let id = w.next_id();
    let label = `ng_${id}`;
    // The exit try decides which iteration ends the loop, so on the replay path
    // it evaluates the predicates the match evaluated (`probe_ea`); the rest is
    // then re-run below without them, its decision already made.
    let pea = probe_ea(replay, ea);
    // Each iteration goes through the same bounded form the greedy loop uses, so
    // the replay stops where the match did: an inner carrying an action mutates
    // what the exit try's predicates read, which the match pass never saw.
    let iter_id = probe_id(w, replay);
    if let Plus = rep.kind {
        let plus_id = probe_id(w, replay);
        gen_lexer_repeat_iteration(w, rep, inner, all_rules, fail_action, ci, ea, hm, replay, plus_id);
    }
    // Loop: try matching the rest first (non-greedy), otherwise consume one more
    w.begin("loop");
    // Try exit: match rest of elements
    w.line(`let ng_saved_${id} = pos;`);
    w.line(`let mut ng_exit_${id} = false;`);
    w.begin(`${label}:`);
    gen_lexer_alt_seq(w, rest, rest_plan, 0, all_rules, `break ${label}`, ci, pea, hm, false);
    w.line(`ng_exit_${id} = true;`);
    w.end();
    if replay {
        w.line(`pos = ng_saved_${id};`);
    }
    w.begin(`if ng_exit_${id}`);
    w.line("break;");
    w.end();
    // Exit failed, restore pos and consume one element
    if !replay {
        w.line(`pos = ng_saved_${id};`);
    }
    gen_lexer_repeat_iteration(w, rep, inner, all_rules, fail_action, ci, ea, hm, replay, iter_id);
    w.end();
    if replay {
        gen_lexer_alt_seq(w, rest, rest_plan, 0, all_rules, fail_action, ci, ea, hm, /*replay=*/ true);
    }
}

fn gen_lexer_not<S: AsStrSlice>(
    w: &mut CodeWriter,
    not_elem: &LexerNotElement,
    inner: &LexerElemPlan,
    all_rules: &List<LexerRule>,
    fail_action: S,
    ci: bool,
    ea: bool,
    hm: bool,
) {
    let id = w.next_id();
    let label = `not_${id}`;
    w.line(`if pos >= chars.len() { ${fail_action}; }`);
    w.line(`let not_saved_${id} = pos;`);
    w.line(`let mut not_matched_${id} = false;`);
    w.begin(`${label}:`);
    gen_lexer_elem(w, &not_elem.element, inner, all_rules, `break ${label}`, ci, ea, hm, false);
    w.line(`not_matched_${id} = true;`);
    w.end();
    w.line(`pos = not_saved_${id};`);
    w.line(`if not_matched_${id} { ${fail_action}; }`);
    w.line("pos += 1;");
}

pub fn find_fragment<S: AsStrSlice>(all_rules: &List<LexerRule>, name: S) -> Option<&LexerRule> {
    return all_rules.iter_ref().find(|r: &LexerRule| r.name == name.as_str_slice() && r.is_fragment);
}

/// The lowercase char a both-cases pair like `[aA]` matches.
fn try_extract_ci_char(cc: &CharClass) -> Option<char> {
    if cc.negated || cc.ranges.len() != 2 {
        return null;
    }
    let r0 = &cc.ranges[0];
    let r1 = &cc.ranges[1];
    if r0.start == r0.end
        && r1.start == r1.end
        && r0.start != r1.start
        && r0.start.to_ascii_lowercase() == r1.start.to_ascii_lowercase() {
        return Option::<char>::Some(r0.start.to_ascii_lowercase());
    }
    return null;
}

/// Appends the chars `elem` matches one per position, or returns false when it
/// matches anything else. `rule_ci` folds each letter to both cases.
fn push_keyword_chars(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    rule_ci: bool,
    text: &mut String,
    char_ci: &mut List<bool>,
) -> bool {
    match elem {
        Literal(s) => {
            for let c of s.chars() {
                push_keyword_char(c, rule_ci, text, char_ci);
            }
            return true;
        },
        CharClass(cc) => {
            if let Some(c) = try_extract_ci_char(cc) {
                text.push(c);
                char_ci.push(true);
                return true;
            }
            if cc.negated || cc.ranges.len() != 1 || cc.ranges[0].start != cc.ranges[0].end {
                return false;
            }
            push_keyword_char(cc.ranges[0].start, rule_ci, text, char_ci);
            return true;
        },
        RuleRef(name) => {
            let Some(f) = find_fragment(all_rules, name) else {
                return false;
            };
            if f.body.len() != 1 || fragment_is_recursive(f, all_rules) {
                return false;
            }
            for let e of &f.body[0].elements {
                if !push_keyword_chars(e, all_rules, rule_ci, text, char_ci) {
                    return false;
                }
            }
            return true;
        },
        CharRange(_) | AnyChar | Group(_) | Repeat(_) | Not(_) => {
            return false;
        },
    }
}

fn push_keyword_char(c: char, rule_ci: bool, text: &mut String, char_ci: &mut List<bool>) {
    let ci = rule_ci && c.to_ascii_lowercase() != c.to_ascii_uppercase();
    text.push(if ci { c.to_ascii_lowercase() } else { c });
    char_ci.push(ci);
}

/// Whether the rule carries any `{ ... }` action or `{ ... }?` predicate, the
/// fragments it inlines included. Both shortcuts that drop a rule's own `try_`
/// fn — the keyword classifier and the shared literal matcher — ask this: the
/// dispatch entry they stand in for is what records `best_act`, so a rule folded
/// into either would have its actions collected as running and then never run.
fn lexer_rule_carries_body(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    if rule.body.iter_ref().any(|a: &LexerAlternative| lexer_alt_has_any_action(a, all_rules)) {
        return true;
    }
    let mut preds: List<i32> = [];
    collect_lexer_predicate_ids(rule, all_rules, &mut preds);
    return !preds.is_empty();
}

/// Analyzes a lexer rule to determine if it's a fixed keyword pattern.
/// Returns KeywordInfo if it matches a sequence of case-insensitive (or literal) chars.
fn try_extract_keyword_info(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
) -> Option<KeywordInfo> {
    if rule.is_fragment || rule.body.len() != 1 {
        return null;
    }
    // Rules carrying lexer commands (more, channel, type(X), mode(X)/pushMode/popMode, skip)
    // cannot be shortcut via keyword dispatch — the keyword classifier only rewrites
    // `best_kind`, it does not propagate the command state to the tokenize loop.
    if rule.skip
        || rule.more
        || rule.channel != 0
        || rule.type_override matches { Some(_) }
        || rule.mode != 0
        || rule.set_mode >= 0
        || rule.push_mode >= 0
        || rule.pop_mode {
        return null;
    }
    // An action or a predicate is the same problem in the same place: the
    // classifier runs behind a carrier's match, so the winner replay dispatches
    // the carrier's actions and never this rule's, and the carrier's match
    // already settled what a predicate here would have had a say in.
    if lexer_rule_carries_body(rule, all_rules) {
        return null;
    }
    let alt = &rule.body[0];
    if alt.elements.is_empty() {
        return null;
    }
    let rule_ci = resolve_ci(grammar_opts, &rule.options);
    let mut text = String::with_capacity(alt.elements.len());
    let mut char_ci: List<bool> = [];
    for let elem of &alt.elements {
        if !push_keyword_chars(elem, all_rules, rule_ci, &mut text, &mut char_ci) {
            return null;
        }
    }
    if text.is_empty() || !text.chars().all(is_ident_char) {
        return null;
    }
    return Option::<KeywordInfo>::Some(KeywordInfo { rule_name: rule.name, text, char_ci });
}

/// Collects all keyword rules from the grammar.
///
/// The keyword path is an optimisation: instead of dispatching keyword-shaped
/// rules through their own first-character branch, the tokenize loop runs
/// `classify_keyword` after a carrier rule has matched the same characters
/// (the gate is `keyword_carrier_kinds`). ANTLR4 has no such precondition (every
/// lexer rule is its own dispatch path), so a candidate is admitted only when
/// `keyword_carrier_admits` confirms the shortcut stays ANTLR4-faithful;
/// the rest fall back to the regular dispatch path (`gen_lexer_match_fn`).
pub fn collect_keyword_rules(lexer_rules: &List<LexerRule>, grammar_opts: &List<GrammarOption>) -> List<KeywordInfo> {
    let mut candidates: List<KeywordInfo> = [];
    let mut candidate_indices: List<i32> = [];
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let rule = &lexer_rules[i];
        // A keyword is matched by reclassifying a carrier's match, so the rule
        // gets no `try_` matcher of its own — which a rule referencing it
        // would still call.
        if rule.is_fragment || rule.is_virtual || lexer_rule_is_called(rule, lexer_rules) {
            continue;
        }
        let info = try_extract_keyword_info(rule, lexer_rules, grammar_opts);
        if let Some(kw) = info {
            candidates.push(kw);
            candidate_indices.push(i);
        }
    }
    // Indices: ANTLR4 gives a same-length match to the earliest rule, so a
    // keyword shortcuts only through a carrier after it (`keyword_carrier_admits`).
    let mut carrier_indices: List<i32> = [];
    let mut carrier_first_chars: List<List<[char, char]>> = [];
    let mut carrier_is_wildcard: List<bool> = [];
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let rule = &lexer_rules[i];
        if rule.is_fragment || rule.is_virtual {
            continue;
        }
        if is_keyword_rule_name(&rule.name, &candidates) {
            continue;
        }
        let try_call = build_rule_try_call(rule, lexer_rules, false, false, false, false, grammar_opts);
        carrier_indices.push(i);
        carrier_first_chars.push(try_call.first_chars);
        carrier_is_wildcard.push(try_call.is_wildcard);
    }
    let mut result: List<KeywordInfo> = [];
    for let mut c = 0; c < candidates.len(); c += 1 {
        let kw = &candidates[c];
        let carrier = keyword_carrier_admits(
            kw,
            candidate_indices[c],
            lexer_rules,
            grammar_opts,
            &carrier_indices,
            &carrier_first_chars,
            &carrier_is_wildcard,
        );
        if carrier >= 0 {
            result.push(KeywordInfo { ..*kw, carrier: lexer_rules[carrier_indices[carrier]].name });
        }
    }
    return result;
}

/// How a keyword scan answers what it cannot read: `Proven` says no, for a
/// shortcut that must hold; `Possible` says yes, for a gate that must not miss.
enum KeywordReading {
    /// Every case of the keyword, along a path whose predicates cannot refuse.
    Proven,
    /// Some case of the keyword, along any path.
    Possible,
}

/// Whether `rule` matches `kw`'s whole text, read as `reading` says.
fn lexer_rule_matches_keyword(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    kw: &KeywordInfo,
    reading: KeywordReading,
) -> bool {
    let mut visiting: List<String> = [rule.name];
    let ci = resolve_ci(grammar_opts, &rule.options);
    let ends = keyword_alts_ends(&rule.body, all_rules, grammar_opts, kw, reading, ci, &[0], &mut visiting);
    return ends.contains(&kw.text.len());
}

/// The keyword positions `alts` can end at, entered at any of `starts`.
fn keyword_alts_ends(
    alts: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    kw: &KeywordInfo,
    reading: KeywordReading,
    ci: bool,
    starts: &List<i32>,
    visiting: &mut List<String>,
) -> List<i32> {
    let mut out: List<i32> = [];
    for let alt of alts {
        if reading matches { Proven } && lexer_alt_has_predicate_below(alt, all_rules) {
            continue;
        }
        let mut at = *starts;
        for let elem of &alt.elements {
            at = keyword_elem_ends(elem, all_rules, grammar_opts, kw, reading, ci, &at, visiting);
        }
        add_keyword_ends(&mut out, &at);
    }
    return out;
}

fn keyword_elem_ends(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    kw: &KeywordInfo,
    reading: KeywordReading,
    ci: bool,
    starts: &List<i32>,
    visiting: &mut List<String>,
) -> List<i32> {
    let len = kw.text.len();
    match elem {
        Literal(s) => {
            let cs: List<char> = s.chars().collect();
            return starts.iter_ref().filter(
                |p| *p + cs.len() <= len
                    && (0..<cs.len()).all(
                        |i| keyword_chars_admitted(kw, *p + i, reading, |c| folded_range_contains(cs[i], cs[i], ci, c)),
                    ),
            ).map(|p| *p + cs.len()).collect();
        },
        RuleRef(name) => {
            let callee = find_lexer_rule(all_rules, name);
            if visiting.contains(name) || callee matches { None } {
                return unread_keyword_ends(kw, reading, starts);
            }
            let callee = callee.unwrap();
            let inlined = callee.is_fragment && !fragment_is_recursive(callee, all_rules);
            let callee_ci = if inlined { ci } else { resolve_ci(grammar_opts, &callee.options) };
            visiting.push(*name);
            let ends = keyword_alts_ends(
                &callee.body,
                all_rules,
                grammar_opts,
                kw,
                reading,
                callee_ci,
                starts,
                visiting,
            );
            visiting.pop();
            return ends;
        },
        Group(alts) => {
            return keyword_alts_ends(alts, all_rules, grammar_opts, kw, reading, ci, starts, visiting);
        },
        Repeat(rep) => {
            // A non-greedy loop stops at its shortest match, not at the keyword's end.
            if rep.non_greedy && reading matches { Proven } {
                return [];
            }
            let mut out: List<i32> = if rep.kind matches { Plus } { [] } else { *starts };
            let mut frontier = *starts;
            loop {
                let reached = keyword_elem_ends(
                    &rep.element,
                    all_rules,
                    grammar_opts,
                    kw,
                    reading,
                    ci,
                    &frontier,
                    visiting,
                );
                let fresh: List<i32> = reached.iter_ref().filter(|p| !out.contains(p)).map(|p| *p).collect();
                add_keyword_ends(&mut out, &fresh);
                if fresh.is_empty() || rep.kind matches { Optional } {
                    return out;
                }
                frontier = fresh;
            }
        },
        CharRange(pair) => {
            return starts.iter_ref().filter(
                |p| *p < len
                    && keyword_chars_admitted(kw, *p, reading, |c| folded_range_contains(pair.0, pair.1, ci, c)),
            ).map(|p| *p + 1).collect();
        },
        CharClass(cc) && !(cc.negated && ci) => {
            let admits = |c: char| cc.negated != cc.ranges.iter_ref().any(|r| folded_range_contains(
                r.start,
                r.end,
                ci,
                c,
            ));
            return starts.iter_ref().filter(|p| *p < len && keyword_chars_admitted(kw, *p, reading, admits)).map(
                |p| *p + 1,
            ).collect();
        },
        CharClass(_) | AnyChar | Not(_) => {
            let mut no_refs: List<String> = [];
            let Some(set) = lexer_elem_leading_chars(elem, all_rules, ci, false, &mut no_refs) else {
                return unread_keyword_ends(kw, reading, starts);
            };
            return starts.iter_ref().filter(|p| *p < len && keyword_chars_in(kw, *p, &set, reading)).map(|p| *p + 1).collect(
            );
        },
    }
}

fn add_keyword_ends(out: &mut List<i32>, ends: &List<i32>) {
    for let p of ends {
        if !out.contains(p) {
            out.push(*p);
        }
    }
}

/// Where a construct the scan cannot read may end: nowhere when proving,
/// anywhere from its start on otherwise.
fn unread_keyword_ends(kw: &KeywordInfo, reading: KeywordReading, starts: &List<i32>) -> List<i32> {
    let mut out: List<i32> = [];
    if reading matches { Possible } {
        for let p of starts {
            add_keyword_ends(&mut out, &(*p..=kw.text.len()).collect());
        }
    }
    return out;
}

/// Whether the chars `kw` accepts at `pos` are in `set`: every one when
/// proving, any one otherwise.
fn keyword_chars_in(kw: &KeywordInfo, pos: i32, set: &LeadingChars, reading: KeywordReading) -> bool {
    return keyword_chars_admitted(
        kw,
        pos,
        reading,
        |c| set.negated != set.ranges.iter_ref().any(|r| c as i32 >= r.0 && c as i32 <= r.1),
    );
}

/// Whether `admits` takes the chars `kw` accepts at `pos`: every one when
/// proving, any one otherwise.
fn keyword_chars_admitted(kw: &KeywordInfo, pos: i32, reading: KeywordReading, admits: fn(char) -> bool) -> bool {
    let accepts = keyword_accepts(kw, pos);
    return if reading matches { Proven } {
        accepts.iter_ref().all(|c| admits(*c));
    } else {
        accepts.iter_ref().any(|c| admits(*c));
    };
}

/// Decides whether a keyword candidate may use the classifier shortcut.
///
/// A carrier and the keyword tie on the keyword's own text length whenever the
/// carrier matches exactly the keyword text, so ANTLR4 awards that match to
/// whichever rule is declared first. The shortcut rewrites a carrier match into
/// the keyword unconditionally, so it is only sound when:
///
/// - some default-mode carrier declared *after* the keyword matches the
///   keyword's whole text (reachability — the classifier only runs on a span a
///   carrier matched: `D : 'h' '2'` behind `C : .` is asked about `h`, never
///   `h2`), and
/// - no carrier declared *before* the keyword can match its first character
///   (priority — that earlier carrier wins the tie under ANTLR4 rules, so
///   reclassifying its match into the keyword would mis-tag it; the canonical
///   case is `A : 'a' EOF; B : 'a';`, where carrier A precedes keyword B).
///
/// Using the first character as the collision proxy is conservative: a rejected
/// candidate simply falls back to regular first-character dispatch, where the
/// strict `>` longest-match comparison already honours declaration order.
///
/// Returns the position in `carrier_indices` of the first admitting carrier, or
/// -1 when the candidate is rejected. The scan runs to the end either way: a
/// carrier declared before the keyword vetoes it however late it appears.
fn keyword_carrier_admits(
    kw: &KeywordInfo,
    kw_index: i32,
    lexer_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    carrier_indices: &List<i32>,
    carrier_first_chars: &List<List<[char, char]>>,
    carrier_is_wildcard: &List<bool>,
) -> i32 {
    let mut carrier = -1;
    for let mut i = 0; i < carrier_indices.len(); i += 1 {
        if !keyword_first_char_covered(kw, &carrier_first_chars[i], carrier_is_wildcard[i]) {
            continue;
        }
        if carrier_indices[i] < kw_index {
            // An earlier carrier ties with the keyword and wins under ANTLR4
            // priority — the shortcut would mis-reclassify its match. The
            // first character stays the proxy here: a carrier ruled out for
            // reachability may still collide, and rejecting is the safe side.
            return -1;
        }
        let rule = &lexer_rules[carrier_indices[i]];
        if carrier < 0
            && rule.mode == 0
            && lexer_rule_matches_keyword(rule, lexer_rules, grammar_opts, kw, KeywordReading::Proven) {
            carrier = i;
        }
    }
    return carrier;
}

fn keyword_first_char_covered(kw: &KeywordInfo, first_chars: &List<[char, char]>, is_wildcard: bool) -> bool {
    return is_wildcard || keyword_accepts(kw, 0).iter_ref().any(|c| char_matches_ranges(*c, first_chars));
}

/// The kinds of the default-mode dispatched rules that could match some
/// keyword's whole text: the matches `classify_keyword` is asked about.
fn keyword_carrier_kinds(
    lexer_rules: &List<LexerRule>,
    routes: &List<LexerRuleRoute>,
    keywords: &List<KeywordInfo>,
    grammar_opts: &List<GrammarOption>,
) -> List<String> {
    let mut kinds: List<String> = [];
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let rule = &lexer_rules[i];
        if rule.mode != 0 || !routes[i].is_dispatched() {
            continue;
        }
        let kind = lexer_rule_token_kind(rule);
        let try_call = build_rule_try_call(rule, lexer_rules, false, false, false, false, grammar_opts);
        let carries = keywords.iter_ref().any(
            |kw| keyword_first_char_covered(kw, &try_call.first_chars, try_call.is_wildcard)
                && lexer_rule_matches_keyword(rule, lexer_rules, grammar_opts, kw, KeywordReading::Possible),
        );
        if carries && !kinds.contains(&kind) {
            kinds.push(kind);
        }
    }
    return kinds;
}

fn is_keyword_rule_name<S: AsStrSlice>(name: S, keywords: &List<KeywordInfo>) -> bool {
    return keywords.iter_ref().any(|kw| kw.rule_name == name.as_str_slice());
}

/// Extracts the fixed literal text from a lexer rule, if it's a pure literal sequence.
fn try_extract_fixed_text(rule: &LexerRule) -> Option<String> {
    if rule.is_fragment || rule.body.len() != 1 {
        return null;
    }
    let alt = &rule.body[0];
    let mut text = String::with_capacity(alt.elements.len());
    for let elem of &alt.elements {
        if let Literal(s) = elem {
            text.push_str(s);
        } else {
            return null;
        }
    }
    return Option::<String>::Some(text);
}

/// The literal token constant covering a lexer rule's fixed text, when the
/// shared literal matcher can stand in for the rule's own `try_*` function.
///
/// Parser literals inherit the grammar-level `caseInsensitive` setting, so a
/// lexer rule with a divergent rule-level CI override must keep its own
/// `try_*` function instead of being deduped against the shared literal.
fn literal_duplicate_const(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    lit_tokens: &List<LitToken>,
    grammar_opts: &List<GrammarOption>,
    grammar_ci: bool,
) -> Option<String> {
    if rule.mode != 0 {
        return null;
    }
    // The shared matcher has no `best_act` entry to record, so a rule folded
    // into it would never run its own body (`lexer_rule_carries_body`).
    if lexer_rule_carries_body(rule, all_rules) {
        return null;
    }
    let rule_ci = resolve_ci(grammar_opts, &rule.options);
    if rule_ci != grammar_ci {
        return null;
    }
    let text = try_extract_fixed_text(rule);
    if let Some(t) = &text {
        for let lit of lit_tokens {
            if lit.text == *t {
                return Option::<String>::Some(lit.const_name);
            }
        }
    }
    return null;
}

fn gen_keyword_classifier_fn(w: &mut CodeWriter, keywords: &List<KeywordInfo>) {
    if keywords.is_empty() {
        return;
    }
    let mut f = FnSpec::new("classify_keyword");
    f.add_param("chars", "&List<char>");
    f.add_param("start", "i32");
    f.add_param("end", "i32");
    f.set_return_type("i32");
    f.emit_begin(w);
    let mut lens: List<i32> = [];
    for let kw of keywords {
        if !lens.contains(&kw.text.len()) {
            lens.push(kw.text.len());
        }
    }
    lens.sort();
    w.begin("match end - start");
    for let len of &lens {
        let same_len: List<KeywordInfo> = keywords.iter_ref().filter(|kw| kw.text.len() == *len).map(|kw| *kw).collect();
        gen_keyword_arm(w, `${*len}`, &same_len, 0);
    }
    w.line("_ => {},");
    w.end();
    w.line("return -1;");
    w.end();
    w.blank();
}

/// A match arm settling `group` — keywords of one length, in declaration order
/// — from `pos` on, testing each position once however many keywords share it.
fn gen_keyword_arm<S: AsStrSlice>(w: &mut CodeWriter, pattern: S, group: &List<KeywordInfo>, pos: i32) {
    let shared = keyword_shared_tests(group, pos);
    let at = pos + shared.len();
    if at == group[0].text.len() {
        w.line(`${pattern} => { ${keyword_trie_leaf(group, &shared)} },`);
        return;
    }
    w.begin(`${pattern} =>`);
    if !shared.is_empty() {
        w.begin(`if ${shared.join(" && ")}`);
    }
    w.begin(`match ${keyword_char_access(at)}`);
    for let arm of &keyword_arms(group, at) {
        gen_keyword_arm(w, &arm.pattern, &arm.keywords, at + 1);
    }
    w.line("_ => {},");
    w.end();
    if !shared.is_empty() {
        w.end();
    }
    w.end_with(",");
}

/// The tests every keyword in `group` makes alike, from `pos` on.
fn keyword_shared_tests(group: &List<KeywordInfo>, pos: i32) -> List<String> {
    let mut shared: List<String> = [];
    for let mut at = pos; at < group[0].text.len(); at += 1 {
        if !group.iter_ref().all(|kw| keyword_accepts(kw, at) == keyword_accepts(&group[0], at)) {
            break;
        }
        shared.push(keyword_char_test(&group[0], at));
    }
    return shared;
}

/// The one statement that settles `group` once its keywords no longer diverge.
/// A duplicate text goes to the first declared.
fn keyword_trie_leaf(group: &List<KeywordInfo>, shared: &List<String>) -> String {
    let ret = `return TK_${group[0].rule_name};`;
    return if shared.is_empty() { ret } else { `if ${shared.join(" && ")} { ${ret} }` };
}

/// One arm of a keyword match: the chars it takes and the keywords that
/// accept exactly those.
struct KeywordArm {
    pattern: String,
    keywords: List<KeywordInfo>,
}

fn keyword_arms(group: &List<KeywordInfo>, pos: i32) -> List<KeywordArm> {
    let mut chars: List<char> = [];
    for let kw of group {
        for let c of keyword_accepts(kw, pos) {
            if !chars.contains(&c) {
                chars.push(c);
            }
        }
    }
    chars.sort();
    let mut arms: List<KeywordArm> = [];
    for let c of &chars {
        let members: List<KeywordInfo> = group.iter_ref().filter(|kw| keyword_accepts(kw, pos).contains(c)).map(
            |kw| *kw,
        ).collect();
        if let Some(i) = arms.iter_ref().position(|a| a.keywords == members) {
            arms[i].pattern.push_str(` | '${*c}'`);
        } else {
            arms.push(KeywordArm { pattern: `'${*c}'`, keywords: members });
        }
    }
    return arms;
}

fn keyword_accepts(kw: &KeywordInfo, pos: i32) -> List<char> {
    let c = keyword_char_at(kw, pos);
    if kw.char_ci[pos] {
        return [c, c.to_ascii_uppercase()];
    }
    return [c];
}

fn keyword_char_at(kw: &KeywordInfo, pos: i32) -> char {
    return char::from_u32_unchecked(kw.text.get_byte_unchecked(pos) as u32);
}

fn keyword_char_access(pos: i32) -> String {
    return if pos == 0 { "chars[start]" } else { `chars[start + ${pos}]` };
}

fn keyword_char_test(kw: &KeywordInfo, pos: i32) -> String {
    let access = keyword_char_access(pos);
    let c = keyword_char_at(kw, pos);
    if kw.char_ci[pos] {
        return wado`${access}.eq_ignore_ascii_case(&'${c}')`;
    }
    return wado`${access} == '${c}'`;
}

fn gen_char_mismatch<S: AsStrSlice>(access: S, c: char, ci: bool) -> String {
    let lower = c.to_ascii_lowercase();
    let upper = c.to_ascii_uppercase();
    let expr = access.to_string();
    if ci && lower != upper {
        return wado`!${expr}.eq_ignore_ascii_case(&'${lower}')`;
    }
    return `${expr} != ${char_pat(c, c)}`;
}

/// A char or range pattern for generated source, escaping any char past ASCII
/// that prints as nothing on its own.
fn char_pat(start: char, end: char) -> String {
    if start == end {
        return quoted_char(start);
    }
    return `${quoted_char(start)}..=${quoted_char(end)}`;
}

/// The `General_Category` groups whose chars print as nothing on their own.
global UNPRINTED_CHAR_GROUPS: List<String> = ["Z", "M", "C"];

fn quoted_char(c: char) -> String {
    let code = c as u32;
    if code > 0x7F && UNPRINTED_CHAR_GROUPS.iter_ref().any(|g| icu::value_contains("gc", *g, c).unwrap()) {
        return `'\\u{${code:x}}'`;
    }
    return `${char_range_pat(c..=c)}`;
}

fn gen_literal_match_fns(w: &mut CodeWriter, lit_tokens: &List<LitToken>, ci: bool, hm: bool) {
    for let lit of lit_tokens {
        let chars: List<char> = lit.text.chars().collect();
        let fn_name = lit_try_fn_name(&lit.const_name);
        let mut f = FnSpec::new(&fn_name);
        if hm {
            f.add_param("lx", "&Lexer");
        } else {
            f.add_param("chars", "&List<char>");
        }
        f.add_param("start", "i32");
        f.set_return_type("i32");
        f.emit_begin(w);
        if hm {
            w.line("let chars = &lx.chars;");
        }
        w.line("let pos = start;");
        for let mut i = 0; i < chars.len(); i += 1 {
            let mismatch = gen_char_mismatch(`chars[pos + ${i}]`, chars[i], ci);
            w.line(`if pos + ${i} >= chars.len() || ${mismatch} { return -1; }`);
        }
        let len = chars.len();
        w.line(`return pos + ${len};`);
        w.end();
        w.blank();
    }
}

fn lit_try_fn_name(const_name: &String) -> String {
    let Some(suffix) = const_name.strip_prefix("TK_LIT_") else {
        panic(`lit_try_fn_name: \`${const_name}\` is not a literal's token name`);
    };
    return `try_lit_${suffix}`;
}

fn has_modes(mode_names: &List<String>) -> bool {
    return mode_names.len() > 1;
}

fn has_set_mode(rules: &List<LexerRule>) -> bool {
    return rules.iter_ref().any(|r| r.set_mode >= 0);
}

fn has_more(rules: &List<LexerRule>) -> bool {
    return rules.iter_ref().any(|r| r.more);
}

fn has_channel(rules: &List<LexerRule>) -> bool {
    return rules.iter_ref().any(|r| r.channel != 0);
}

/// Whether `rule` always matches once its first character does: every
/// alternative is one char-consuming element, with nothing after it and no
/// predicate below it that could reject the match. Deliberately narrow — a
/// wrong `false` costs a branch one extra catch-all call, a wrong `true` loses
/// the match.
fn lexer_rule_total_on_first_char(rule: &LexerRule, all_rules: &List<LexerRule>) -> bool {
    if rule.body.is_empty() {
        return false;
    }
    for let alt of &rule.body {
        if !alt.actions.is_empty() || alt.elements.len() != 1 {
            return false;
        }
        // `('a' {p}? | 'b')` carries its predicate on the group's arm, not here.
        if lexer_alt_has_predicate_below(alt, all_rules) {
            return false;
        }
        if !lexer_element_can_consume_simple(&alt.elements[0]) {
            return false;
        }
    }
    return true;
}

/// The catch-alls a dispatch branch carries: none when every member matches on
/// its first character, else all but the last-resort ones.
fn branch_catch_all_calls(calls: &List<TryCall>, members: &List<i32>) -> List<i32> {
    if members.iter_ref().all(|i| calls[*i].total_on_first_char) {
        return [];
    }
    let last_resort = last_resort_calls(calls);
    return (0..<calls.len()).filter(|i| calls[i].is_catch_all && !last_resort.contains(&i)).collect();
}

/// The catch-alls declared after every other candidate: any other match ties
/// and wins, so these run once after the dispatch, where nothing matched.
fn last_resort_calls(calls: &List<TryCall>) -> List<i32> {
    let mut out: List<i32> = [];
    for let mut i = calls.len() - 1; i >= 0 && calls[i].is_catch_all; i -= 1 {
        out.push(i);
    }
    out.reverse();
    return out;
}

struct TryCall {
    fn_name: String,
    token_kind: String,
    extra: String,
    first_chars: List<[char, char]>,
    is_wildcard: bool,
    is_catch_all: bool,
    /// The rule matches whenever its first character does. A branch made only
    /// of these always produces a match, which is what lets the catch-all stay
    /// out of it.
    total_on_first_char: bool,
    /// What the match can hold after its first char, for the second-char
    /// dispatch. Null when unknown.
    second_chars: Option<SecondChars>,
    /// Index of this rule's `apply_<rule>_actions` replay, or -1 when the rule
    /// runs no `{ ... }` action. When the rule wins the tournament, its winner
    /// block records `best_act = act_index` so the commit dispatches the replay.
    act_index: i32 = -1,
}

fn best_state_extras(
    push_mode: i32,
    pop_mode: bool,
    set_mode: i32,
    more: bool,
    channel: i32,
    emit_modes: bool,
    has_set_mode_rules: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
) -> String {
    let mut s = String::with_capacity(64);
    if emit_modes {
        if push_mode >= 0 {
            s.push_str(` best_push_mode = ${push_mode};`);
        } else {
            s.push_str(" best_push_mode = -1;");
        }
        if pop_mode {
            s.push_str(" best_pop_mode = true;");
        } else {
            s.push_str(" best_pop_mode = false;");
        }
    }
    if has_set_mode_rules {
        if set_mode >= 0 {
            s.push_str(` best_set_mode = ${set_mode};`);
        } else {
            s.push_str(" best_set_mode = -1;");
        }
    }
    if has_more_rules {
        if more {
            s.push_str(" best_more = true;");
        } else {
            s.push_str(" best_more = false;");
        }
    }
    if has_channel_rules {
        if channel != 0 {
            s.push_str(` best_channel = ${channel};`);
        } else {
            s.push_str(" best_channel = 0;");
        }
    }
    return s;
}

fn default_extras(use_modes: bool, has_set_mode_rules: bool, has_more_rules: bool, has_channel_rules: bool) -> String {
    return best_state_extras(-1, false, -1, false, 0, use_modes, has_set_mode_rules, has_more_rules, has_channel_rules);
}

fn literal_command_extras(
    lit: &LitToken,
    lexer_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    grammar_ci: bool,
    emit_modes: bool,
    has_set_mode_rules: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
) -> String {
    for let rule of lexer_rules {
        if rule.is_fragment || rule.is_virtual || rule.mode != 0 {
            continue;
        }
        if resolve_ci(grammar_opts, &rule.options) != grammar_ci {
            continue;
        }
        if try_extract_fixed_text(rule) == Option::Some(lit.text) {
            return best_state_extras(
                rule.push_mode,
                rule.pop_mode,
                rule.set_mode,
                rule.more,
                rule.channel,
                emit_modes,
                has_set_mode_rules,
                has_more_rules,
                has_channel_rules,
            );
        }
    }
    return default_extras(emit_modes, has_set_mode_rules, has_more_rules, has_channel_rules);
}

/// The kind a match of `rule` is emitted as. `type(X)` renames it; the rule
/// still has its own `TK_<name>` constant.
fn lexer_rule_token_kind(rule: &LexerRule) -> String {
    if let Some(override_name) = rule.type_override {
        return `TK_${override_name}`;
    }
    return `TK_${rule.name}`;
}

/// Compute the first-char set for a lexer rule body's first element.
fn build_rule_try_call(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    use_modes: bool,
    has_set_mode_rules: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
    grammar_opts: &List<GrammarOption>,
) -> TryCall {
    let ci = resolve_ci(grammar_opts, &rule.options);
    let fn_name = lexer_try_fn_name(&rule.name);
    let token_kind = lexer_rule_token_kind(rule);
    let extra = best_state_extras(
        rule.push_mode,
        rule.pop_mode,
        rule.set_mode,
        rule.more,
        rule.channel,
        use_modes,
        has_set_mode_rules,
        has_more_rules,
        has_channel_rules,
    );
    let mut chars: List<[char, char]> = [];
    let is_wc = compute_elem_first_chars(&rule.body, all_rules, &mut chars, ci, grammar_opts).0;
    // A catch-all (`UNEXPECTED_CHAR : .`) matches any single character, so it
    // is redundant only in a branch whose rules all match on their first
    // character — see `branch_catch_all_calls`.
    let catch_all = is_wc
        && rule.body.len() == 1
        && rule.body[0].elements.len() == 1
        && rule.body[0].elements[0] matches { AnyChar };
    return TryCall {
        fn_name,
        token_kind,
        extra,
        first_chars: chars,
        is_wildcard: is_wc,
        is_catch_all: catch_all,
        total_on_first_char: lexer_rule_total_on_first_char(rule, all_rules),
        second_chars: lexer_second_chars(&rule.body, all_rules, ci),
    };
}

/// Analyze first elements of rule body alternatives to find first-char set.
/// Returns true if it's a wildcard (any char could match).
/// Compute the first-char set of a lexer rule body into `out`.
/// Returns `[wildcard, nullable]`:
///   - `wildcard`: the first set is unbounded (negated class, opaque rule ref,
///     `.`) — the dispatch treats the rule as matching any char.
///   - `nullable`: the body can match empty, so a caller folding a sequence
///     must also include the following element's first set.
/// A nullable leading element (`x?` / `x*`) contributes its first chars and the
/// walk continues to the next element (rather than collapsing to wildcard).
pub fn compute_elem_first_chars(
    body: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    out: &mut List<[char, char]>,
    ci: bool,
    grammar_opts: &List<GrammarOption>,
) -> [bool, bool] {
    let mut seen = TreeSet::<i64>::new();
    let mut visiting: List<String> = [];
    return elem_first_chars_dedup(body, all_rules, out, &mut seen, ci, grammar_opts, &mut visiting);
}

fn elem_first_chars_dedup(
    body: &List<LexerAlternative>,
    all_rules: &List<LexerRule>,
    out: &mut List<[char, char]>,
    seen: &mut TreeSet<i64>,
    ci: bool,
    grammar_opts: &List<GrammarOption>,
    visiting: &mut List<String>,
) -> [bool, bool] {
    let mut any_nullable = false;
    for let alt of body {
        if alt.elements.is_empty() {
            return [true, false];
        }
        let mut alt_nullable = true;
        for let mut i = 0; i < alt.elements.len(); i += 1 {
            let r = compute_single_elem_first(&alt.elements[i], all_rules, out, seen, ci, grammar_opts, visiting);
            if r.0 {
                return [true, false];
            }
            if !r.1 {
                alt_nullable = false;
                break;
            }
        }
        if alt_nullable {
            any_nullable = true;
        }
    }
    return [false, any_nullable];
}

fn add_folded_range(out: &mut List<[char, char]>, seen: &mut TreeSet<i64>, start: char, end: char, ci: bool) {
    if !ci {
        add_range(out, seen, start, end);
        return;
    }
    let mut folded: List<CharRange> = [];
    fold_range_ci(start, end, &mut folded);
    for let r of &folded {
        add_range(out, seen, r.start, r.end);
    }
}

/// First-char set of a single lexer element into `out`, returning
/// `[wildcard, nullable]` (see `compute_elem_first_chars`).
fn compute_single_elem_first(
    elem: &LexerElement,
    all_rules: &List<LexerRule>,
    out: &mut List<[char, char]>,
    seen: &mut TreeSet<i64>,
    ci: bool,
    grammar_opts: &List<GrammarOption>,
    visiting: &mut List<String>,
) -> [bool, bool] {
    match *elem {
        Literal(text) => {
            let c = text.chars().next().unwrap();
            add_folded_range(out, seen, c, c, ci);
            return [false, false];
        },
        CharRange(pair) => {
            add_folded_range(out, seen, pair.0, pair.1, ci);
            return [false, false];
        },
        CharClass(cc) => {
            if cc.negated {
                return [true, false];
            }
            for let r of &cc.ranges {
                add_folded_range(out, seen, r.start, r.end, ci);
            }
            return [false, false];
        },
        RuleRef(name) => {
            // A reference contributes the referenced rule's first chars,
            // `fragment` or not. Two cases fall back to wildcard: a rule
            // already on the walk, and a callee this walk cannot fold for.
            for let rule of all_rules {
                if rule.name == name {
                    if visiting.contains(&rule.name) || callee_folds_other_case(rule, all_rules, grammar_opts, ci) {
                        return [true, false];
                    }
                    visiting.push(rule.name);
                    let r = elem_first_chars_dedup(&rule.body, all_rules, out, seen, ci, grammar_opts, visiting);
                    visiting.pop();
                    return r;
                }
            }
            return [true, false];
        },
        Repeat(rep) => {
            let inner = compute_single_elem_first(&rep.element, all_rules, out, seen, ci, grammar_opts, visiting);
            if inner.0 {
                return [true, false];
            }
            // `?` / `*` make this element skippable, so the rule's first set
            // extends into the next element; `+` inherits the inner nullability.
            let nullable = rep.kind matches { Star | Optional } || inner.1;
            return [false, nullable];
        },
        Group(alts) => {
            return elem_first_chars_dedup(&alts, all_rules, out, seen, ci, grammar_opts, visiting);
        },
        _ => {
            return [true, false];
        },
    }
}

/// Whether `rule` has its own `try_` and folds a case the walk's `ci` does
/// not. An inlined fragment carries the caller's folding, so it cannot.
fn callee_folds_other_case(
    rule: &LexerRule,
    all_rules: &List<LexerRule>,
    grammar_opts: &List<GrammarOption>,
    ci: bool,
) -> bool {
    if rule.is_fragment && !fragment_is_recursive(rule, all_rules) {
        return false;
    }
    return resolve_ci(grammar_opts, &rule.options) != ci;
}

fn range_key(start: char, end: char) -> i64 {
    return start as i32 as i64 << 32 | end as i32 as i64;
}

/// Check if a char matches any of the ranges in first_chars.
fn char_matches_ranges(c: char, ranges: &List<[char, char]>) -> bool {
    return ranges.iter_ref().any(|r| c >= r[0] && c <= r[1]);
}

fn add_range(out: &mut List<[char, char]>, seen: &mut TreeSet<i64>, start: char, end: char) {
    if seen.insert(range_key(start, end)) {
        out.push([start, end]);
    }
}

/// Sorted-by-start view of a call's first-char ranges for O(log n) membership:
/// `max_end[i]` is the largest range end among `starts[0..=i]`, so a char `c`
/// matches some range iff the last start <= `c` has `max_end >= c`.
struct RangeIndex {
    starts: List<char>,
    max_end: List<char>,
}

fn build_range_index(ranges: &List<[char, char]>) -> RangeIndex {
    let mut sorted = *ranges;
    sorted.sort();
    let mut starts: List<char> = [];
    let mut max_end: List<char> = [];
    for let mut i = 0; i < sorted.len(); i += 1 {
        starts.push(sorted[i][0]);
        let e = sorted[i][1];
        if i > 0 && max_end[i - 1] > e {
            max_end.push(max_end[i - 1]);
        } else {
            max_end.push(e);
        }
    }
    return RangeIndex { starts, max_end };
}

fn range_index_matches(idx: &RangeIndex, c: char) -> bool {
    let i = upper_bound(&idx.starts, c) - 1;
    if i < 0 {
        return false;
    }
    return idx.max_end[i] >= c;
}

/// First index of sorted `chars` whose element is greater than `c`.
fn upper_bound(chars: &List<char>, c: char) -> i32 {
    let mut lo = 0;
    let mut hi = chars.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if chars[mid] <= c {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// The pattern of the arm every char no other arm claims falls to.
global FALLBACK_PATTERN: String = "_";

/// One arm of the emitted first-char dispatch: a char pattern and the `try_`
/// calls a char matching it must run, in grammar order.
struct DispatchGroup {
    pattern: String,
    calls: List<i32>,
}

/// The arms of the emitted first-char dispatch: a partition of the character
/// space at every first-set boundary, one arm per distinct call list.
fn build_dispatch_groups(calls: &List<TryCall>) -> List<DispatchGroup> {
    let mut cuts = TreeSet::<i32>::new();
    for let call of calls {
        if call.is_wildcard {
            continue;
        }
        for let r of &call.first_chars {
            cuts.insert(r[0] as i32);
            cuts.insert(r[1] as i32 + 1);
        }
    }
    // A TreeSet iterates in insertion order.
    let mut points: List<i32> = cuts.into_iter().collect();
    points.sort();

    let mut range_indexes: List<RangeIndex> = [];
    for let call of calls {
        range_indexes.push(build_range_index(&call.first_chars));
    }

    let mut groups: List<DispatchGroup> = [];
    let mut group_by_calls = TreeMap::<List<i32>, i32>::new();
    for let mut i = 0; i + 1 < points.len(); i += 1 {
        let mut spans: List<CharRange> = [];
        clip_to_scalars(&mut spans, points[i], points[i + 1] - 1);
        if spans.is_empty() {
            continue;
        }
        let mut members: List<i32> = [];
        for let mut j = 0; j < calls.len(); j += 1 {
            if calls[j].is_catch_all {
                continue;
            }
            // The interval lies wholly inside each range it meets, so any char
            // of it answers for all of it.
            if calls[j].is_wildcard || range_index_matches(&range_indexes[j], spans[0].start) {
                members.push(j);
            }
        }
        if members.is_empty() {
            continue;
        }
        for let ci of &branch_catch_all_calls(calls, &members) {
            members.push(*ci);
        }
        // Grammar order, so a same-length match goes to the first rule in the
        // grammar (ANTLR4's tie-break). Insertion order does not carry it.
        members.sort();
        let pattern = spans.iter_ref().map(|s| char_pat(s.start, s.end)).collect().join(" | ");
        if let Some(gi) = group_by_calls.get(members) {
            groups[gi].pattern.push_str(` | ${pattern}`);
        } else {
            group_by_calls[members] = groups.len();
            groups.push(DispatchGroup { pattern, calls: members });
        }
    }

    // A char no interval claims is outside every bounded first set, so only a
    // rule with an unbounded one can match it.
    let last_resort = last_resort_calls(calls);
    let mut wildcard_calls: List<i32> = [];
    for let mut i = 0; i < calls.len(); i += 1 {
        if calls[i].is_wildcard && !last_resort.contains(&i) {
            wildcard_calls.push(i);
        }
    }
    if !wildcard_calls.is_empty() {
        groups.push(DispatchGroup { pattern: String::from(FALLBACK_PATTERN), calls: wildcard_calls });
    }

    return groups;
}

/// The `try_` candidates one lexer mode dispatches over: parser literals
/// (default mode only), then that mode's rules. Shared by the moded and the
/// modeless tokenizer so both dispatch on the first character.
fn build_mode_try_calls(
    mode: i32,
    lexer_rules: &List<LexerRule>,
    lit_tokens: &List<LitToken>,
    routes: &List<LexerRuleRoute>,
    grammar_opts: &List<GrammarOption>,
    grammar_ci: bool,
    act_rule_names: &List<String>,
    use_modes: bool,
    has_set_mode_rules: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
) -> List<TryCall> {
    let mut calls: List<TryCall> = [];
    if mode == 0 {
        for let lit of lit_tokens {
            let fn_name = lit_try_fn_name(&lit.const_name);
            let text: List<char> = lit.text.chars().collect();
            let c = text[0];
            let mut fc: List<[char, char]> = [];
            let mut fc_seen = TreeSet::<i64>::new();
            // Parser literals inherit grammar-level caseInsensitive.
            add_folded_range(&mut fc, &mut fc_seen, c, c, grammar_ci);
            let lit_extras = literal_command_extras(
                lit,
                lexer_rules,
                grammar_opts,
                grammar_ci,
                use_modes,
                has_set_mode_rules,
                has_more_rules,
                has_channel_rules,
            );
            calls.push(TryCall {
                fn_name,
                token_kind: lit.const_name,
                extra: lit_extras,
                first_chars: fc,
                is_wildcard: false,
                is_catch_all: false,
                total_on_first_char: text.len() == 1,
                second_chars: Option::Some(if text.len() == 1 {
                    SecondChars { ranges: [], may_end: true };
                } else {
                    SecondChars { ranges: folded_ranges(text[1], text[1], grammar_ci), may_end: false };
                }),
            });
        }
    }
    for let mut i = 0; i < lexer_rules.len(); i += 1 {
        let rule = &lexer_rules[i];
        if rule.mode == mode && routes[i].is_dispatched() {
            let mut call = build_rule_try_call(
                rule,
                lexer_rules,
                use_modes,
                has_set_mode_rules,
                has_more_rules,
                has_channel_rules,
                grammar_opts,
            );
            call.act_index = index_of_name(act_rule_names, &rule.name);
            calls.push(call);
        }
    }
    return calls;
}

fn gen_dispatch_groups(
    w: &mut CodeWriter,
    calls: &List<TryCall>,
    groups: &List<DispatchGroup>,
    needs_extras: bool,
    has_actions: bool,
    has_members: bool,
) {
    if groups.len() == 1 && groups[0].pattern == FALLBACK_PATTERN {
        gen_group_calls(w, calls, &groups[0].calls, needs_extras, has_actions, has_members);
    } else if !groups.is_empty() {
        // The arms are a partition, so an else-if chain's order buys nothing and
        // would put the letters and digits behind every punctuation branch.
        let has_wildcard_arm = groups.iter_ref().any(|g| g.pattern == FALLBACK_PATTERN);
        w.begin("match first_char");
        for let g of groups {
            w.begin(`${g.pattern} =>`);
            gen_second_char_dispatch(w, calls, &g.calls, needs_extras, has_actions, has_members);
            w.end_with(",");
        }
        // `char` has no finite case list, so the arms alone never exhaust it.
        if !has_wildcard_arm {
            w.line("_ => {},");
        }
        w.end();
    }
    let last_resort = last_resort_calls(calls);
    if !last_resort.is_empty() {
        w.begin("if best_end <= start");
        gen_group_calls(w, calls, &last_resort, needs_extras, has_actions, has_members);
        w.end();
    }
}

/// One first-char arm's calls, split again on the second char when that leaves
/// some calls out: `/` need not try `/*` comments before `/=`.
fn gen_second_char_dispatch(
    w: &mut CodeWriter,
    calls: &List<TryCall>,
    members: &List<i32>,
    needs_extras: bool,
    has_actions: bool,
    has_members: bool,
) {
    let arms = second_char_arms(calls, members);
    if !arms.iter_ref().any(|a| a.calls.len() < members.len()) {
        gen_group_calls(w, calls, members, needs_extras, has_actions, has_members);
        return;
    }
    // A call every arm runs is emitted once where grammar order allows it: the
    // run before the first filtered call, and the run after the last.
    let admitted_everywhere = |m: i32| second_char_admits(&calls[m], -1);
    let mut lead = 0;
    while admitted_everywhere(members[lead]) {
        lead += 1;
    }
    let mut trail = members.len();
    while admitted_everywhere(members[trail - 1]) {
        trail -= 1;
    }
    let leading: List<i32> = members.iter_value().take(lead).collect();
    let trailing: List<i32> = members.iter_value().skip(trail).collect();
    gen_group_calls(w, calls, &leading, needs_extras, has_actions, has_members);
    // Past the end, only a call that can end after one char matches, and the
    // NUL a missing char reads as runs every such call whichever arm it lands in.
    w.line("let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\\u{0}' };");
    w.begin("match second_char");
    for let arm of &arms {
        let middle: List<i32> = arm.calls.iter_value().filter(|m| !leading.contains(&m) && !trailing.contains(&m)).collect(
        );
        w.begin(`${arm.pattern} =>`);
        gen_group_calls(w, calls, &middle, needs_extras, has_actions, has_members);
        w.end_with(",");
    }
    w.end();
    gen_group_calls(w, calls, &trailing, needs_extras, has_actions, has_members);
}

/// A partition of the second char among `members`, each arm in grammar order.
/// The `_` arm holds the calls `second_char_admits` places in every arm.
fn second_char_arms(calls: &List<TryCall>, members: &List<i32>) -> List<DispatchGroup> {
    let mut cuts = TreeSet::<i32>::new();
    for let m of members {
        if let Some(s) = &calls[*m].second_chars && !s.may_end {
            for let r of &s.ranges {
                cuts.insert(r.0);
                cuts.insert(r.1 + 1);
            }
        }
    }
    let mut points: List<i32> = cuts.into_iter().collect();
    points.sort();
    let mut arms: List<DispatchGroup> = [];
    let mut arm_by_calls = TreeMap::<List<i32>, i32>::new();
    for let mut i = 0; i + 1 < points.len(); i += 1 {
        let mut spans: List<CharRange> = [];
        clip_to_scalars(&mut spans, points[i], points[i + 1] - 1);
        if spans.is_empty() {
            continue;
        }
        let at = points[i];
        let arm_calls: List<i32> = members.iter_value().filter(|m| second_char_admits(&calls[m], at)).collect();
        let pattern = spans.iter_ref().map(|s| char_pat(s.start, s.end)).collect().join(" | ");
        if let Some(ai) = arm_by_calls.get(arm_calls) {
            arms[ai].pattern.push_str(` | ${pattern}`);
        } else {
            arm_by_calls[arm_calls] = arms.len();
            arms.push(DispatchGroup { pattern, calls: arm_calls });
        }
    }
    let rest: List<i32> = members.iter_value().filter(|m| second_char_admits(&calls[m], -1)).collect();
    let covers_every_char = !points.is_empty() && points[0] == 0 && points[points.len() - 1] == 0x110000;
    if covers_every_char && !arms.iter_ref().any(|a| a.calls == rest) {
        return arms;
    }
    let mut out: List<DispatchGroup> = arms.into_iter().filter(|a| a.calls != rest).collect();
    out.push(DispatchGroup { pattern: String::from(FALLBACK_PATTERN), calls: rest });
    return out;
}

/// Whether `call` can hold code point `at` second; -1 asks for a char no
/// bounded set names.
fn second_char_admits(call: &TryCall, at: i32) -> bool {
    let Some(s) = &call.second_chars else {
        return true;
    };
    return s.may_end || s.ranges.iter_ref().any(|r| r.0 <= at && at <= r.1);
}

fn gen_group_calls(
    w: &mut CodeWriter,
    calls: &List<TryCall>,
    indices: &List<i32>,
    needs_extras: bool,
    has_actions: bool,
    has_members: bool,
) {
    let ctx = if has_members { "&lexer" } else { "&lexer.chars" };
    // Uniform `try_*` call per candidate (keep the longest match). Single-char
    // literals are not hand-inlined — the wado compiler folds the tiny bodies.
    for let call_idx of indices {
        let call = &calls[*call_idx];
        w.line(`end = ${call.fn_name}(${ctx}, start);`);
        // Under `has_actions` EVERY winner block reassigns `best_act` — the
        // rule's replay index, or -1 for a literal / non-action rule — so a
        // longer non-action match that supersedes an earlier action match does
        // not leave `best_act` pointing at the losing action rule.
        let act = if has_actions { ` best_act = ${call.act_index};` } else { String::new() };
        if needs_extras {
            w.line(`if end > best_end { best_end = end; best_kind = ${call.token_kind};${call.extra}${act} }`);
        } else {
            w.line(`if end > best_end { best_end = end; best_kind = ${call.token_kind};${act} }`);
        }
    }
}

/// Index of `name` in `names`, or -1. Small linear scan — the executed-action
/// rule list is short.
fn index_of_name<S: AsStrSlice>(names: &List<String>, name: S) -> i32 {
    for let mut i = 0; i < names.len(); i += 1 {
        if names[i] == name.as_str_slice() {
            return i;
        }
    }
    return -1;
}

fn gen_tokenize_fn<S: AsStrSlice>(
    w: &mut CodeWriter,
    lexer_rules: &List<LexerRule>,
    routes: &List<LexerRuleRoute>,
    lit_tokens: &List<LitToken>,
    mode_names: &List<String>,
    keywords: &List<KeywordInfo>,
    grammar_opts: &List<GrammarOption>,
    act_rule_names: &List<String>,
    has_members: bool,
    sc_name: S,
    surface: &LexerSurface,
) {
    let has_actions = !act_rule_names.is_empty();
    let use_modes = has_modes(mode_names);
    // A lexer action may call `lx.more()` / `lx.set_channel(n)` / `lx.set_mode(m)`,
    // so an action grammar needs the `more_start` / `best_more` / `best_channel`
    // / `best_set_mode` commit machinery even when no rule carries the matching
    // `-> more` / `-> channel` / `-> mode` command. `set_mode` only applies in
    // a `mode` grammar, so its machinery is forced only under `use_modes`.
    let has_set_mode_rules = has_set_mode(lexer_rules) || has_actions && use_modes;
    let has_more_rules = has_more(lexer_rules) || has_actions;
    let has_channel_rules = has_channel(lexer_rules) || has_actions;
    let empty_opts: List<GrammarOption> = [];
    let grammar_ci = resolve_ci(grammar_opts, &empty_opts);

    let mut f = FnSpec::new("tokenize", Vis::Pub);
    f.add_generic("S: AsStrSlice");
    f.add_param("input", "S");
    f.set_return_type("TokenStream");
    // `tokenize` calls the op-carrying `try_<rule>` fns, so it propagates the effect.
    if !sc_name.is_empty() {
        f.add_effect(sc_name);
    }
    f.emit_begin(w);
    w.line("let mut lexer = Lexer::new(input);");
    // Struct-of-arrays token storage: the lexer pushes flat i32s, never a
    // per-token aggregate. `triv_lo` marks where the current token's leading
    // trivia begins; it advances to the next mark after each emitted token.
    w.line("let mut ts = TokenStream::new(&lexer.chars);");
    w.line("let mut triv_lo = ts.trivia_mark();");

    if has_more_rules {
        // Tracks the start position of a pending `more` sequence; -1 means
        // no pending `more` data. When a non-`more` rule emits, it uses
        // `more_start` as the token start so the emitted text includes
        // all previously-`more`'d characters.
        w.line("let mut more_start: i32 = -1;");
    }

    if use_modes {
        w.line("let mut mode_stack: List<i32> = [];");
        w.line("let mut current_mode: i32 = 0;");
    }

    w.begin("while !lexer.at_end()");
    w.line("let start = lexer.pos;");
    w.line("let mut best_end: i32 = -1;");
    w.line("let mut best_kind: i32 = TK_ERROR;");
    w.line("let mut end: i32 = -1;");
    if has_actions {
        // Which winning rule's `apply_<rule>_actions` to replay post-tournament
        // (-1 = none). Set in the winner block alongside `best_end`/`best_kind`.
        w.line("let mut best_act: i32 = -1;");
        // Latched by an action's `lx.skip()` (no `best_skip` tournament var
        // exists — skip is otherwise decided by `best_kind`).
        w.line("let mut best_act_skip = false;");
    }
    w.line("let first_char = lexer.chars[start];");

    if use_modes {
        w.line("let mut best_push_mode: i32 = -1;");
        w.line("let mut best_pop_mode = false;");
    }
    if has_set_mode_rules {
        w.line("let mut best_set_mode: i32 = -1;");
    }
    if has_more_rules {
        w.line("let mut best_more = false;");
    }
    if has_channel_rules {
        w.line("let mut best_channel: i32 = 0;");
    }

    // Under `use_modes` every winner block assigns `best_push_mode` /
    // `best_pop_mode`, so the extras are never empty.
    let needs_extras = use_modes || has_set_mode_rules || has_more_rules || has_channel_rules;
    if use_modes {
        for let mut mi = 0; mi < mode_names.len(); mi += 1 {
            if mi == 0 {
                w.begin(`if current_mode == ${mi}`);
            } else {
                w.else_begin(`else if current_mode == ${mi}`);
            }
            let calls = build_mode_try_calls(
                mi,
                lexer_rules,
                lit_tokens,
                routes,
                grammar_opts,
                grammar_ci,
                act_rule_names,
                true,
                has_set_mode_rules,
                has_more_rules,
                has_channel_rules,
            );
            let groups = build_dispatch_groups(&calls);
            gen_dispatch_groups(w, &calls, &groups, needs_extras, has_actions, has_members);
        }
        w.end();  // mode dispatch
    } else {
        let calls = build_mode_try_calls(
            0,
            lexer_rules,
            lit_tokens,
            routes,
            grammar_opts,
            grammar_ci,
            act_rule_names,
            false,
            has_set_mode_rules,
            has_more_rules,
            has_channel_rules,
        );
        let groups = build_dispatch_groups(&calls);
        gen_dispatch_groups(w, &calls, &groups, needs_extras, has_actions, has_members);
    }

    // A zero-length match (`best_end == start`) is legitimate when a rule
    // matches the empty string and switches mode — ANTLR4 issue #688 ("Lexer
    // cannot match zero-length tokens"). Such a match makes forward progress
    // only through the mode change, so accept it just when one is pending;
    // otherwise treating `best_end == start` as a match would spin the `while`
    // loop forever. With no modes a zero-length match can never progress, so
    // the strict `<= start` guard is kept.
    let no_match_guard = if use_modes {
        // `best_push_mode` / `best_pop_mode` always exist under `use_modes`;
        // `best_set_mode` only when the grammar has a `mode(X)` rule.
        let mut stalled = String::from("best_push_mode < 0 && !best_pop_mode");
        if has_set_mode_rules {
            stalled.push_str(" && best_set_mode < 0");
        }
        `best_end < start || (best_end == start && ${stalled})`;
    } else {
        String::from("best_end <= start");
    };
    w.begin(`if ${no_match_guard}`);
    w.line(
        "let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);",
    );
    w.line("triv_lo = ts.trivia_mark();");
    w.line("lexer.pos = start + 1;");
    w.else_begin("else");
    if !keywords.is_empty() {
        let kinds = keyword_carrier_kinds(lexer_rules, routes, keywords, grammar_opts);
        assert !kinds.is_empty(), "an admitted keyword's carrier, or the rule subsuming it, is dispatched";
        let mut gate = if kinds.len() == 1 {
            `best_kind == ${kinds[0]}`;
        } else {
            `best_kind matches { ${kinds.join(" | ")} }`;
        };
        if use_modes {
            gate = `current_mode == 0 && ${gate}`;
        }
        // The keyword precedes its carrier, so it takes the match whole: none
        // of the carrier's commands or actions apply.
        let mut dropped = default_extras(use_modes, has_set_mode_rules, has_more_rules, has_channel_rules);
        if has_actions {
            dropped.push_str(" best_act = -1;");
        }
        w.begin(`if ${gate}`);
        w.line("let kw_kind = classify_keyword(&lexer.chars, start, best_end);");
        w.line(`if kw_kind >= 0 { best_kind = kw_kind;${dropped} }`);
        w.end();
    }

    // Winner-replay: the chosen rule's `{ ... }` actions run once, here, on the
    // committed match — never for a losing candidate. Placed after keyword
    // reclassification so an explicit `set_type` wins, and before the
    // skip/more/channel commit so its effects (`best_kind`) feed them.
    if has_actions {
        gen_lexer_action_replay(w, act_rule_names, use_modes, has_set_mode_rules, surface);
    }

    // `more` rules accumulate text into the next emitted token. `tok_start`
    // is the earliest start position of the current pending `more` chain,
    // or `start` if no `more` is pending.
    if has_more_rules {
        w.line("let tok_start = if more_start >= 0 { more_start } else { start };");
    } else {
        w.line("let tok_start = start;");
    }

    let skip_names: List<String> = lexer_rules.iter_ref().filter(|rule: &LexerRule| rule.skip).map(
        |rule: &LexerRule| `TK_${rule.name}`,
    ).collect();
    // An action's `lx.skip()` latches `best_act_skip`; OR it into the
    // command-derived skip decision so either route routes the token to trivia.
    let act_skip = if has_actions { " || best_act_skip" } else { "" };
    // Without either, `is_skip` is a compile-time `false`.
    let has_skip = !skip_names.is_empty() || has_actions;
    if skip_names.is_empty() {
        if has_skip {
            w.line(`let is_skip = false${act_skip};`);
        }
    } else {
        w.write("let is_skip = best_kind matches { ");
        for let mut i = 0; i < skip_names.len(); i += 1 {
            if i > 0 {
                w.write(" | ");
            }
            w.write(&skip_names[i]);
        }
        w.write(` }${act_skip};\n`);
    }

    gen_lexer_emit_hook(w, sc_name, has_skip, has_more_rules, has_channel_rules);

    if has_more_rules {
        // A `more` match suppresses emission and remembers the starting
        // position so the next non-`more` match covers the full span.
        w.begin("if best_more");
        w.line("if more_start < 0 { more_start = start; }");
        if has_skip {
            w.else_begin("else if is_skip");
            w.line("ts.push_trivia(best_kind, tok_start, best_end, 0);");
            w.line("more_start = -1;");
        }
        if has_channel_rules {
            // Non-default channels are invisible to the parser — route to
            // trivia with the channel id preserved. ANTLR4 treats any
            // non-DEFAULT channel the same way at the parser boundary.
            w.else_begin("else if best_channel != 0");
            w.line("ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
            w.line("more_start = -1;");
        }
        w.else_begin("else");
        emit_token_commit(w, "best_kind", "tok_start", "best_end");
        w.line("more_start = -1;");
        w.end();
    } else if has_skip || has_channel_rules {
        if has_skip {
            w.begin("if is_skip");
            w.line("ts.push_trivia(best_kind, tok_start, best_end, 0);");
        }
        if has_channel_rules {
            // Non-default channels are invisible to the parser — route to
            // trivia with the channel id preserved. ANTLR4 treats any
            // non-DEFAULT channel the same way at the parser boundary.
            if has_skip {
                w.else_begin("else if best_channel != 0");
            } else {
                w.begin("if best_channel != 0");
            }
            w.line("ts.push_trivia(best_kind, tok_start, best_end, best_channel);");
        }
        w.else_begin("else");
        emit_token_commit(w, "best_kind", "tok_start", "best_end");
        w.end();
    } else {
        emit_token_commit(w, "best_kind", "tok_start", "best_end");
    }

    if use_modes {
        w.begin("if best_push_mode >= 0");
        w.line("mode_stack.push(current_mode);");
        w.line("current_mode = best_push_mode;");
        w.line("best_push_mode = -1;");
        w.end();
        w.begin("if best_pop_mode");
        w.begin("if mode_stack.is_empty()");
        w.line("current_mode = 0;");
        w.else_begin("else");
        w.line("current_mode = mode_stack[mode_stack.len() - 1];");
        w.line("mode_stack.pop();");
        w.end();
        w.line("best_pop_mode = false;");
        w.end();
        if has_set_mode_rules {
            // `mode(X)` replaces the current mode directly — no stack push.
            w.begin("if best_set_mode >= 0");
            w.line("current_mode = best_set_mode;");
            w.line("best_set_mode = -1;");
            w.end();
        }
    }

    w.line("lexer.pos = best_end;");
    w.end();  // else
    w.end();  // while
    // EOF sentinel: zero-length, carrying any trailing trivia. No reset
    // follows (the stream ends here), so this stays inline rather than
    // using `emit_token_commit`.
    w.line("ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());");
    if surface.sink {
        w.line("ts.output = lexer.act_output;");
    }
    w.line("return ts;");
    w.end();  // fn
    w.blank();
}

/// Call the base's `emit` hook for a token that will be pushed. Placed after
/// the skip / more decision, so a suppressed match never reaches the base and a
/// non-default channel still does. The hook may retype the token.
fn gen_lexer_emit_hook<S: AsStrSlice>(
    w: &mut CodeWriter,
    sc_name: S,
    has_skip: bool,
    has_more_rules: bool,
    has_channel_rules: bool,
) {
    if sc_name.is_empty() {
        return;
    }
    let mut guard = String::new();
    if has_skip {
        guard.push_str("!is_skip");
    }
    if has_more_rules {
        if !guard.is_empty() {
            guard.push_str(" && ");
        }
        guard.push_str("!best_more");
    }
    let channel = if has_channel_rules { "best_channel" } else { "0" };
    let call = `best_kind = ${super_emit_hook_expr(sc_name, &channel)};`;
    if guard.is_empty() {
        w.line(&call);
        return;
    }
    w.begin(`if ${guard}`);
    w.line(&call);
    w.end();
}

/// Emit a default-channel token commit: push it with the pending leading-trivia
/// range `[triv_lo, trivia_mark())`, then reopen the range for the next token.
fn emit_token_commit<S: AsStrSlice, S1: AsStrSlice, S2: AsStrSlice>(w: &mut CodeWriter, kind: S, start: S1, end: S2) {
    w.line(`ts.push_token(${kind}, ${start}, ${end}, triv_lo, ts.trivia_mark());`);
    w.line("triv_lo = ts.trivia_mark();");
}

/// The display names ANTLR4's `Vocabulary` gives the token kinds, by kind id: a
/// token defined by a single literal prints that literal, every other its name.
pub fn vocab_display_names(
    lexer_rules: &List<LexerRule>,
    lit_tokens: &List<LitToken>,
    kind_names: &List<String>,
) -> List<String> {
    let mut out: List<String> = [];
    for let name of kind_names {
        out.push(vocab_display_name(name, lexer_rules, lit_tokens));
    }
    return out;
}

fn vocab_display_name<S: AsStrSlice>(kind_name: S, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) -> String {
    // `lit_name`, not hand-quoting: `token_kind_name` renders a literal through
    // it, and the two are one vocabulary — a `'` or a newline in the text has to
    // come back escaped the same way in both.
    for let lit of lit_tokens {
        if lit.const_name == kind_name.as_str_slice() {
            return `${lit_name(lit.text)}`;
        }
    }
    if let Some(rule_name) = kind_name.strip_prefix("TK_") {
        if let Some(rule) = find_lexer_rule(lexer_rules, &rule_name) {
            // The alias shape is exactly ANTLR4's `literalNames` entry: a rule
            // whose whole body is one string literal.
            if let Some(text) = lexer_alias_text(rule) {
                return `${lit_name(text)}`;
            }
        }
        return rule_name.to_string();
    }
    return kind_name.to_string();
}

fn gen_token_kind_name_fn(w: &mut CodeWriter, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) {
    let mut f = FnSpec::new("token_kind_name", Vis::Pub);
    f.add_param("kind", "i32");
    f.set_return_type("String");
    f.emit_begin(w);

    w.line("return match kind {");
    w.indent();
    for let rule of lexer_rules {
        if !rule.is_fragment {
            let trailer = if rule.is_virtual { "  // virtual" } else { "" };
            w.line(wado`TK_${rule.name} => "${rule.name}",${trailer}`);
        }
    }
    w.line("TK_EOF => \"Eof\",");
    // Mirror the sentinel collapse in `gen_token_constants`: when the
    // user owns `TK_ERROR`, the rule's own arm covers it.
    if !rule_name_exists(lexer_rules, "ERROR") {
        w.line("TK_ERROR => \"Error\",");
    }
    // A literal names itself by its source form, `'+'`, not the `TK_LIT_PLUS`
    // constant Gale interned it under.
    for let lit of lit_tokens {
        w.line(wado`${lit.const_name} => "${lit_name(lit.text)}",`);
    }
    w.line("_ => \"Unknown\",");
    w.dedent();
    w.line("};");
    w.end();  // fn
    w.blank();
}

/// `TOKEN_NAMES`, ANTLR4's `Vocabulary.getDisplayName` by kind, which `<missing X>`
/// reads: a rule whose whole body is one literal shows as that literal.
pub fn gen_token_names_global(w: &mut CodeWriter, lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) {
    let mut names: List<String> = [];
    for let slot of &token_slot_order(lexer_rules, lit_tokens) {
        let name = match *slot {
            Rule(ri) => match lexer_alias_text(&lexer_rules[ri]) {
                Some(text) => `${lit_name(text)}`,
                None => lexer_rules[ri].name,
            },
            Eof => "Eof",
            Error => "Error",
            Lit(li) => `${lit_name(lit_tokens[li].text)}`,
        };
        names.push(wado`"${name}"`);
    }
    w.line(`global TOKEN_NAMES: List<String> = [${names.join(", ")}];`);
    w.blank();
}
