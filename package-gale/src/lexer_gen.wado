use {
    Grammar,
    GrammarOption,
    OptionValue,
    LexerRule,
    LexerAlt,
    LexerElement,
    LexerRepeatElement,
    LexerNotElement,
    CharClass,
    CharRange,
    RepeatKind,
    ParserRule,
    Alternative,
    Element,
    RepeatElement,
    LabelElement,
} from "./ir.wado";
use { to_lower, escape_char, literal_const_name, gen_visibility_comment } from "./gen_util.wado";
use { CodeWriter, StructSpec, ImplSpec, FnSpec, GlobalSpec } from "./wadopoet.wado";

pub struct LitToken {
    pub text: String,
    pub const_name: String,
}

pub struct KeywordInfo {
    pub rule_name: String,
    pub lowercase_text: String,
    pub char_ci: Array<bool>,
}

/// ANTLR4 `caseInsensitive` resolution: a rule-level option (when present)
/// overrides the grammar-level option. ANTLR4 spec: `doc/options.md`.
fn lookup_ci_option(opts: &Array<GrammarOption>) -> Option<bool> {
    for let opt of opts {
        if opt.name != "caseInsensitive" {
            continue;
        }
        if let Ident(v) = &opt.value {
            return Option::<bool>::Some(*v == "true");
        }
    }
    return null;
}

pub fn resolve_ci(grammar_opts: &Array<GrammarOption>, rule_opts: &Array<GrammarOption>) -> bool {
    if let Some(b) = lookup_ci_option(rule_opts) {
        return b;
    }
    if let Some(b) = lookup_ci_option(grammar_opts) {
        return b;
    }
    return false;
}

/// Expand one char range into the set of ranges needed to match it
/// case-insensitively. The original range is always included. When the range
/// intersects ASCII letters, the opposing-case sub-range is appended.
/// Non-letter chars are not folded (ANTLR4 only does one-length transforms).
fn fold_range_ci(start: char, end: char, out: &mut Array<CharRange>) {
    out.push(CharRange { start, end });
    if start <= 'z' && end >= 'a' {
        let lo = if start < 'a' { 'a' } else { start };
        let hi = if end > 'z' { 'z' } else { end };
        out.push(CharRange {
            start: lo.to_ascii_uppercase(),
            end: hi.to_ascii_uppercase(),
        });
    }
    if start <= 'Z' && end >= 'A' {
        let lo = if start < 'A' { 'A' } else { start };
        let hi = if end > 'Z' { 'Z' } else { end };
        out.push(CharRange {
            start: lo.to_ascii_lowercase(),
            end: hi.to_ascii_lowercase(),
        });
    }
}

fn seen_contains(seen: &Array<String>, text: &String) -> bool {
    for let item of seen {
        if *item == *text {
            return true;
        }
    }
    return false;
}

pub fn collect_literal_tokens(parser_rules: &Array<ParserRule>) -> Array<LitToken> {
    let mut seen: Array<String> = [];
    let mut result: Array<LitToken> = [];
    for let rule of parser_rules {
        for let alt of rule.alternatives {
            collect_lits_from_elements(&alt.elements, &mut seen, &mut result);
        }
    }
    return result;
}

fn collect_lits_from_elements(elements: &Array<Element>, seen: &mut Array<String>, result: &mut Array<LitToken>) {
    for let elem of elements {
        collect_lits_from_element(elem, seen, result);
    }
}

fn collect_lits_from_element(elem: &Element, seen: &mut Array<String>, result: &mut Array<LitToken>) {
    match *elem {
        Literal(l) => {
            if !seen_contains(seen, &l.text) {
                seen.push(l.text);
                result.push(LitToken { text: l.text, const_name: literal_const_name(&l.text) });
            }
        },
        Repeat(rep) => collect_lits_from_element(&rep.element, seen, result),
        Group(g) => {
            for let alt of &g.alternatives {
                collect_lits_from_elements(&alt.elements, seen, result);
            }
        },
        Label(lab) => collect_lits_from_element(&lab.element, seen, result),
        // `~ X` is a set-complement transformer. The literal `'x'` inside
        // still needs to be hoisted to an anonymous lexer token so the
        // runtime `match_not([TK_LIT_X])` call resolves. Without this arm
        // any parser-rule `~'x'` / `~('x'|'y')` emits a reference to an
        // undefined TK_LIT_X (Sets/ParserNotToken, Sets/ParserNotSet, …).
        Not(n) => collect_lits_from_element(&n.element, seen, result),
        _ => (),
    }
}

pub fn gen_token_constants(w: &mut CodeWriter, lexer_rules: &Array<LexerRule>, lit_tokens: &Array<LitToken>) {
    let mut idx = 0;
    for let rule of lexer_rules {
        if !rule.is_fragment {
            let name = `TK_{rule.name}`;
            let init = `{idx}`;
            let mut g = GlobalSpec::new(&name, "i32", &init);
            if rule.is_virtual {
                g.set_trailing_comment(&"virtual");
            }
            g.emit(w);
            idx += 1;
        }
    }
    let eof_init = `{idx}`;
    GlobalSpec::new("TK_EOF", "i32", &eof_init).emit(w);
    idx += 1;
    let err_init = `{idx}`;
    GlobalSpec::new("TK_ERROR", "i32", &err_init).emit(w);
    idx += 1;
    for let lit of lit_tokens {
        let init = `{idx}`;
        GlobalSpec::new(&lit.const_name, "i32", &init).emit(w);
        idx += 1;
    }
    w.blank();
}

pub fn gen_lexer(w: &mut CodeWriter, grammar: &Grammar, lit_tokens: &Array<LitToken>) {
    let empty_opts: Array<GrammarOption> = [];
    let grammar_ci = resolve_ci(&grammar.options, &empty_opts);
    let keywords = collect_keyword_rules(&grammar.lexer_rules, &grammar.options);
    gen_lexer_struct(w);
    gen_lexer_match_fns(w, &grammar.lexer_rules, &keywords, lit_tokens, &grammar.options);
    gen_literal_match_fns(w, lit_tokens, grammar_ci);
    gen_keyword_classifier_fn(w, &keywords);
    gen_tokenize_fn(w, &grammar.lexer_rules, lit_tokens, &grammar.mode_names, &keywords, &grammar.options);
    gen_token_kind_name_fn(w, &grammar.lexer_rules, lit_tokens);
}

fn gen_lexer_struct(w: &mut CodeWriter) {
    let mut s = StructSpec::new("Lexer");
    s.add_field(&"chars", &"Array<char>");
    s.add_field(&"pos", &"i32");
    s.emit(w);
    w.blank();

    ImplSpec::new("Lexer").emit_begin(w);

    let mut f = FnSpec::new("new");
    f.add_param(&"input", &"&String");
    f.set_return_type(&"Lexer");
    f.emit_begin(w);
    w.line(&"return Lexer { chars: input.chars().collect(), pos: 0 };");
    w.end();
    w.blank();

    let mut f2 = FnSpec::new("at_end");
    f2.set_receiver(&"&self");
    f2.set_return_type(&"bool");
    f2.emit_begin(w);
    w.line(&"return self.pos >= self.chars.len();");
    w.end();
    w.blank();

    let mut f3 = FnSpec::new("slice");
    f3.set_receiver(&"&self");
    f3.add_param(&"start", &"i32");
    f3.add_param(&"end", &"i32");
    f3.set_return_type(&"LexerSlice");
    f3.emit_begin(w);
    w.line(&"return LexerSlice::new(&self.chars, start, end);");
    w.end();

    w.end();  // impl
    w.blank();
}

fn gen_lexer_match_fns(w: &mut CodeWriter, lexer_rules: &Array<LexerRule>, keywords: &Array<KeywordInfo>, lit_tokens: &Array<LitToken>, grammar_opts: &Array<GrammarOption>) {
    let empty_opts: Array<GrammarOption> = [];
    let grammar_ci = resolve_ci(grammar_opts, &empty_opts);
    for let rule of lexer_rules {
        if rule.is_virtual {
            // Virtual token (from `tokens { }` block): no match function
            // needed — the tokenizer can never produce it directly. Only
            // `type(X)` rewrites or actions can emit one.
        } else if !rule.is_fragment {
            if !is_keyword_rule_name(&rule.name, keywords)
                && !is_literal_duplicate(rule, lit_tokens, grammar_opts, grammar_ci) {
                gen_lexer_match_fn(w, rule, lexer_rules, grammar_opts);
            }
        } else if fragment_is_recursive(rule, lexer_rules) {
            // Fragments inherit the grammar-level CI flag (rule-level options
            // on fragments are uncommon; ANTLR4 applies grammar-level CI to
            // fragments uniformly).
            gen_lexer_match_fn(w, rule, lexer_rules, grammar_opts);
        }
    }
}

fn fragment_is_recursive(rule: &LexerRule, all_rules: &Array<LexerRule>) -> bool {
    let mut visited: Array<String> = [];
    return fragment_refs_self(&rule.name, &rule.body, all_rules, &mut visited);
}

fn fragment_refs_self(target: &String, alts: &Array<LexerAlt>, all_rules: &Array<LexerRule>, visited: &mut Array<String>) -> bool {
    for let alt of alts {
        for let elem of &alt.elements {
            if fragment_elem_refs_self(target, elem, all_rules, visited) {
                return true;
            }
        }
    }
    return false;
}

fn fragment_elem_refs_self(target: &String, elem: &LexerElement, all_rules: &Array<LexerRule>, visited: &mut Array<String>) -> bool {
    match *elem {
        RuleRef(name) => {
            if name == *target {
                return true;
            }
            if visited.iter().any(|v: String| v == name) {
                return false;
            }
            visited.push(name);
            let frag = find_fragment(all_rules, &name);
            if let Some(f) = frag {
                return fragment_refs_self(target, &f.body, all_rules, visited);
            }
            return false;
        },
        Group(alts) => {
            return fragment_refs_self(target, &alts, all_rules, visited);
        },
        Repeat(rep) => {
            return fragment_elem_refs_self(target, &rep.element, all_rules, visited);
        },
        Not(not_elem) => {
            return fragment_elem_refs_self(target, &not_elem.element, all_rules, visited);
        },
        _ => {
            return false;
        },
    }
}

fn gen_lexer_match_fn(w: &mut CodeWriter, rule: &LexerRule, all_rules: &Array<LexerRule>, grammar_opts: &Array<GrammarOption>) {
    let fn_name = `try_{to_lower(&rule.name)}`;
    let ci = resolve_ci(grammar_opts, &rule.options);
    gen_visibility_comment(w, &rule.visibility);
    let mut f = FnSpec::new(&fn_name);
    f.add_param(&"chars", &"&Array<char>");
    f.add_param(&"start", &"i32");
    f.set_return_type(&"i32");
    f.emit_begin(w);
    w.line(&"let mut pos = start;");
    if rule.body.len() == 1 {
        gen_lexer_alt_seq(w, &rule.body[0], all_rules, &"return -1", ci);
        w.line(&"return pos;");
    } else {
        gen_lexer_alts(w, &rule.body, all_rules, &"return -1", ci);
        w.line(&"return pos;");
    }
    w.end();
    w.blank();
}

fn gen_lexer_alts(w: &mut CodeWriter, alts: &Array<LexerAlt>, all_rules: &Array<LexerRule>, fail_action: &String, ci: bool) {
    let id = w.next_id();
    w.line(&`let alts_saved_{id} = pos;`);
    w.line(&`let mut alts_ok_{id} = false;`);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 {
            w.begin(&`if !alts_ok_{id}`);
        }
        let label = `alts_{id}_{i}`;
        w.begin(&`{label}:`);
        w.line(&`pos = alts_saved_{id};`);
        gen_lexer_alt_seq(w, &alts[i], all_rules, &`break {label}`, ci);
        w.line(&`alts_ok_{id} = true;`);
        w.end();
    }
    for let mut i = 1; i < alts.len(); i += 1 {
        w.end();
    }
    w.line(&`if !alts_ok_{id} \{ {fail_action}; \}`);
}

fn gen_lexer_alt_seq(w: &mut CodeWriter, alt: &LexerAlt, all_rules: &Array<LexerRule>, fail_action: &String, ci: bool) {
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        let elem = &alt.elements[i];
        if let Repeat(rep) = elem {
            if rep.non_greedy {
                // Build a sub-alt from remaining elements
                let mut rest_elems: Array<LexerElement> = [];
                for let mut j = i + 1; j < alt.elements.len(); j += 1 {
                    rest_elems.push(alt.elements[j]);
                }
                let rest_alt = LexerAlt { elements: rest_elems };
                gen_lexer_non_greedy_repeat(w, rep, &rest_alt, all_rules, fail_action, ci);
                return;
            }
            // Greedy Plus / Star whose inner is a single-char-consuming
            // shape (Literal of one char / CharRange / CharClass /
            // AnyChar / Not over any of those / Group of single-element
            // alts) and whose entire suffix is also single-char-consuming:
            // a naive greedy loop can over-shoot and strand the suffix at
            // end-of-input (`'a' ~('b')+ 'c'` over `abc` is the canonical
            // ANTLR4 descriptor — `Sets/UnicodeNegated*`). ANTLR4's lexer
            // obtains the longest match via NFA→DFA simulation; we
            // replicate that here in a single forward pass with explicit
            // accept-state tracking (no backtracking). At every iteration
            // we peek whether the suffix could start at the current
            // position and record the latest such position; once the
            // inner stops matching we resume the cursor at that recorded
            // position and consume the suffix.
            //
            // Shapes outside that window (RuleRef inner / suffix, nested
            // Repeat, multi-element-alt Group) fall through to the
            // unchanged greedy emit below. The standard lexer algorithm
            // is correct there as long as the inner cannot consume the
            // suffix's first character — a property the descriptor
            // corpus does satisfy outside the simple window. If a future
            // grammar needs lookahead through a complex shape, generalise
            // the peek emitters instead of widening this trigger blindly.
            if rep.kind matches { Plus | Star }
                && i + 1 < alt.elements.len()
                && lexer_element_can_consume_simple(&rep.element) {
                let mut suffix_elems: Array<LexerElement> = [];
                for let mut j = i + 1; j < alt.elements.len(); j += 1 {
                    suffix_elems.push(alt.elements[j]);
                }
                if lexer_suffix_is_peekable(&suffix_elems) {
                    gen_lexer_repeat_lookahead_aware(w, rep, &suffix_elems, all_rules, fail_action, ci);
                    return;
                }
            }
        }
        gen_lexer_elem(w, elem, all_rules, fail_action, ci);
    }
}

/// True for lexer elements that consume exactly one char and never
/// branch into rule references or nested loops. The lookahead-aware
/// emitter restricts both inner and suffix to these shapes because
/// it peeks the suffix at every iteration; non-simple shapes would
/// either escape into a rule call (rule refs), recurse into their own
/// loop (nested Repeats), or pick an alternation arm that diverges
/// between peek and the eventual commit (multi-alt Groups).
fn lexer_element_can_consume_simple(elem: &LexerElement) -> bool {
    return match *elem {
        Literal(text) => text.chars().count() == 1,
        CharRange(_) => true,
        CharClass(_) => true,
        AnyChar => true,
        Not(not_inner) => lexer_element_can_consume_simple(&not_inner.element),
        // `~('b')` parses as `Not(Group([Alt([Literal("b")])]))`,
        // `~('b' | ' ')` as `Not(Group([Alt(['b']), Alt([' '])]))`.
        // Either shape consumes exactly one char as long as every
        // alt body is itself a single simple element.
        Group(alts) => {
            for let alt of alts {
                if alt.elements.len() != 1 {
                    return false;
                }
                if !lexer_element_can_consume_simple(&alt.elements[0]) {
                    return false;
                }
            }
            !alts.is_empty();
        },
        _ => false,
    };
}

/// True when every element in the suffix can be safely peeked via a
/// `save-pos / try-elem / restore-pos` block. Required by
/// `gen_lexer_repeat_lookahead_aware` so the per-iteration peek that
/// records `last_accept` produces the same answer as the post-loop
/// commit. Multi-char literals are accepted because the peek replays
/// the same byte-wise comparisons the commit will run.
fn lexer_suffix_is_peekable(elements: &Array<LexerElement>) -> bool {
    if elements.is_empty() {
        return false;
    }
    for let elem of elements {
        if !lexer_element_is_peekable(elem) {
            return false;
        }
    }
    return true;
}

fn lexer_element_is_peekable(elem: &LexerElement) -> bool {
    return match *elem {
        Literal(_) => true,
        CharRange(_) => true,
        CharClass(_) => true,
        AnyChar => true,
        Not(not_inner) => lexer_element_is_peekable(&not_inner.element),
        Group(alts) => {
            for let alt of alts {
                if alt.elements.len() != 1 {
                    return false;
                }
                if !lexer_element_is_peekable(&alt.elements[0]) {
                    return false;
                }
            }
            !alts.is_empty();
        },
        _ => false,
    };
}

/// Emit a greedy `Plus` / `Star` whose inner can consume the suffix's
/// first character, in single-pass forward DFA style. At every
/// position where the suffix could legally start we record the
/// position in `accept_<id>`; once the inner stops matching we rewind
/// the cursor exactly once to the latest recorded position and
/// consume the suffix normally. This is the standard lexer
/// longest-match algorithm (NFA→DFA with accept-state tracking),
/// performed without any try-fail-retry backtracking.
fn gen_lexer_repeat_lookahead_aware(
    w: &mut CodeWriter,
    rep: &LexerRepeatElement,
    suffix: &Array<LexerElement>,
    all_rules: &Array<LexerRule>,
    fail_action: &String,
    ci: bool,
) {
    let id = w.next_id();
    let accept_var = `accept_{id}`;
    let loop_label = `la_rep_{id}`;

    w.line(&`let mut {accept_var}: i32 = -1;`);

    // Star: zero iterations is a valid endpoint, so the suffix may
    // legally start at the current position even before any inner
    // consumption.
    if let Star = rep.kind {
        gen_lexer_suffix_peek(w, suffix, all_rules, &accept_var, ci);
    }

    // Plus: the first iteration is mandatory and may not be skipped.
    if let Plus = rep.kind {
        gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci);
        gen_lexer_suffix_peek(w, suffix, all_rules, &accept_var, ci);
    }

    // Forward scan: each iteration of the inner advances pos and
    // re-peeks the suffix. `accept_<id>` always holds the latest
    // position where the suffix could start; once the inner can no
    // longer match we exit the loop and resume from that position.
    w.begin(&"loop");
    w.line(&`let la_saved_{id} = pos;`);
    w.begin(&`{loop_label}:`);
    gen_lexer_elem(w, &rep.element, all_rules, &`break {loop_label}`, ci);
    gen_lexer_suffix_peek(w, suffix, all_rules, &accept_var, ci);
    w.line(&"continue;");
    w.end();
    w.line(&`pos = la_saved_{id};`);
    w.line(&"break;");
    w.end();

    w.begin(&`if {accept_var} < 0`);
    w.line(&`{*fail_action};`);
    w.end();
    w.line(&`pos = {accept_var};`);

    // Re-consume the suffix to advance `pos` past it. The peek that
    // recorded `accept_var` already proved it matches, so the actual
    // emit cannot fail in well-formed input — the fail_action here is
    // unreachable but kept for shape symmetry with regular emit.
    for let elem of suffix {
        gen_lexer_elem(w, elem, all_rules, fail_action, ci);
    }
}

/// Emit a save / try-suffix / restore block that records the current
/// position in `accept_var` iff every suffix element would match
/// starting here. Pos is restored unconditionally so the surrounding
/// forward scan continues without committing the peeked suffix.
fn gen_lexer_suffix_peek(
    w: &mut CodeWriter,
    suffix: &Array<LexerElement>,
    all_rules: &Array<LexerRule>,
    accept_var: &String,
    ci: bool,
) {
    let id = w.next_id();
    let save_var = `peek_save_{id}`;
    let matched_var = `peek_ok_{id}`;
    let label = `peek_{id}`;
    w.line(&`let {save_var} = pos;`);
    w.line(&`let mut {matched_var} = false;`);
    w.begin(&`{label}:`);
    for let elem of suffix {
        gen_lexer_elem(w, elem, all_rules, &`break {label}`, ci);
    }
    w.line(&`{matched_var} = true;`);
    w.end();
    w.line(&`pos = {save_var};`);
    w.begin(&`if {matched_var}`);
    w.line(&`{*accept_var} = {save_var};`);
    w.end();
}

fn gen_lexer_elem(w: &mut CodeWriter, elem: &LexerElement, all_rules: &Array<LexerRule>, fail_action: &String, ci: bool) {
    match *elem {
        Literal(text) => {
            let chars: Array<char> = text.chars().collect();
            for let mut i = 0; i < chars.len(); i += 1 {
                let mismatch = gen_char_mismatch(&`chars[pos]`, chars[i], ci);
                w.line(&`if pos >= chars.len() || {mismatch} \{ {fail_action}; \}`);
                w.line(&"pos += 1;");
            }
        },
        CharRange(pair) => {
            if ci {
                let mut ranges: Array<CharRange> = [];
                fold_range_ci(pair.0, pair.1, &mut ranges);
                let cc = CharClass { ranges, negated: false };
                gen_char_class(w, &cc, fail_action);
            } else {
                w.line(
                    &`if pos >= chars.len() || !({escape_char(pair.0)} <= chars[pos] <= {escape_char(pair.1)}) \{ {fail_action}; \}`,
                );
                w.line(&"pos += 1;");
            }
        },
        CharClass(cc) => {
            let expanded = if ci { expand_char_class_ci(&cc) } else { cc };
            gen_char_class(w, &expanded, fail_action);
        },
        AnyChar => {
            w.line(&`if pos >= chars.len() \{ {fail_action}; \}`);
            w.line(&"pos += 1;");
        },
        RuleRef(name) => {
            if name == "EOF" {
                w.line(&`if pos < chars.len() \{ {fail_action}; \}`);
            } else {
                let frag = find_fragment(all_rules, &name);
                if let Some(f) = frag {
                    // Fragments inherit the caller's CI context when inlined.
                    // The recursive-fragment case uses its own `try_*` fn
                    // emitted separately with grammar-level CI.
                    if fragment_is_recursive(f, all_rules) {
                        let fn_name = `try_{to_lower(&name)}`;
                        w.line(&`pos = {fn_name}(chars, pos);`);
                        w.line(&`if pos < 0 \{ {fail_action}; \}`);
                    } else if f.body.len() == 1 {
                        gen_lexer_alt_seq(w, &f.body[0], all_rules, fail_action, ci);
                    } else {
                        gen_lexer_alts(w, &f.body, all_rules, fail_action, ci);
                    }
                } else {
                    let fn_name = `try_{to_lower(&name)}`;
                    w.line(&`pos = {fn_name}(chars, pos);`);
                    w.line(&`if pos < 0 \{ {fail_action}; \}`);
                }
            }
        },
        Group(alts) => {
            if alts.len() == 1 {
                gen_lexer_alt_seq(w, &alts[0], all_rules, fail_action, ci);
            } else {
                gen_lexer_alts(w, &alts, all_rules, fail_action, ci);
            }
        },
        Repeat(rep) => gen_lexer_repeat(w, &rep, all_rules, fail_action, ci),
        Not(not_elem) => gen_lexer_not(w, &not_elem, all_rules, fail_action, ci),
    }
}

fn expand_char_class_ci(cc: &CharClass) -> CharClass {
    let mut expanded: Array<CharRange> = [];
    for let r of &cc.ranges {
        fold_range_ci(r.start, r.end, &mut expanded);
    }
    return CharClass { ranges: expanded, negated: cc.negated };
}

fn gen_char_class(w: &mut CodeWriter, cc: &CharClass, fail_action: &String) {
    w.line(&`if pos >= chars.len() \{ {fail_action}; \}`);
    if cc.negated {
        w.write(&"if false");
        for let range of cc.ranges {
            if range.start == range.end {
                w.write(&` || chars[pos] == {escape_char(range.start)}`);
            } else {
                w.write(&` || {escape_char(range.start)} <= chars[pos] <= {escape_char(range.end)}`);
            }
        }
        w.write(&` \{ {*fail_action}; \}
`);
    } else {
        w.write(&"if !(false");
        for let range of cc.ranges {
            if range.start == range.end {
                w.write(&` || chars[pos] == {escape_char(range.start)}`);
            } else {
                w.write(&` || {escape_char(range.start)} <= chars[pos] <= {escape_char(range.end)}`);
            }
        }
        w.write(&`) \{ {*fail_action}; \}
`);
    }
    w.line(&"pos += 1;");
}

fn gen_lexer_repeat(w: &mut CodeWriter, rep: &LexerRepeatElement, all_rules: &Array<LexerRule>, fail_action: &String, ci: bool) {
    let id = w.next_id();
    let label = `rep_{id}`;
    if let Star = rep.kind {
        w.begin(&"loop");
        w.line(&`let rep_saved_{id} = pos;`);
        w.begin(&`{label}:`);
        gen_lexer_elem(w, &rep.element, all_rules, &`break {label}`, ci);
        w.line(&"continue;");
        w.end();
        w.line(&`pos = rep_saved_{id};`);
        w.line(&"break;");
        w.end();
    }
    if let Plus = rep.kind {
        gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci);
        w.begin(&"loop");
        w.line(&`let rep_saved_{id} = pos;`);
        w.begin(&`{label}:`);
        gen_lexer_elem(w, &rep.element, all_rules, &`break {label}`, ci);
        w.line(&"continue;");
        w.end();
        w.line(&`pos = rep_saved_{id};`);
        w.line(&"break;");
        w.end();
    }
    if let Optional = rep.kind {
        w.line(&`let opt_saved_{id} = pos;`);
        w.line(&`let mut opt_ok_{id} = false;`);
        w.begin(&`{label}:`);
        gen_lexer_elem(w, &rep.element, all_rules, &`break {label}`, ci);
        w.line(&`opt_ok_{id} = true;`);
        w.end();
        w.line(&`if !opt_ok_{id} \{ pos = opt_saved_{id}; \}`);
    }
}

fn gen_lexer_non_greedy_repeat(w: &mut CodeWriter, rep: &LexerRepeatElement, rest: &LexerAlt, all_rules: &Array<LexerRule>, fail_action: &String, ci: bool) {
    let id = w.next_id();
    let label = `ng_{id}`;
    // For Plus, match at least one element first
    if let Plus = rep.kind {
        gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci);
    }
    // Loop: try matching the rest first (non-greedy), otherwise consume one more
    w.begin(&"loop");
    // Try exit: match rest of elements
    w.line(&`let ng_saved_{id} = pos;`);
    w.line(&`let mut ng_exit_{id} = false;`);
    w.begin(&`{label}:`);
    gen_lexer_alt_seq(w, rest, all_rules, &`break {label}`, ci);
    w.line(&`ng_exit_{id} = true;`);
    w.end();
    w.begin(&`if ng_exit_{id}`);
    w.line(&"break;");
    w.end();
    // Exit failed, restore pos and consume one element
    w.line(&`pos = ng_saved_{id};`);
    gen_lexer_elem(w, &rep.element, all_rules, fail_action, ci);
    w.end();
}

fn gen_lexer_not(w: &mut CodeWriter, not_elem: &LexerNotElement, all_rules: &Array<LexerRule>, fail_action: &String, ci: bool) {
    if let CharClass(cc) = not_elem.element {
        let expanded = if ci { expand_char_class_ci(&cc) } else { cc };
        let flipped = CharClass {
            ranges: expanded.ranges,
            negated: !expanded.negated,
        };
        gen_char_class(w, &flipped, fail_action);
        return;
    }
    let id = w.next_id();
    let label = `not_{id}`;
    w.line(&`if pos >= chars.len() \{ {fail_action}; \}`);
    w.line(&`let not_saved_{id} = pos;`);
    w.line(&`let mut not_matched_{id} = false;`);
    w.begin(&`{label}:`);
    gen_lexer_elem(w, &not_elem.element, all_rules, &`break {label}`, ci);
    w.line(&`not_matched_{id} = true;`);
    w.end();
    w.line(&`pos = not_saved_{id};`);
    w.line(&`if not_matched_{id} \{ {fail_action}; \}`);
    w.line(&"pos += 1;");
}

fn find_fragment(all_rules: &Array<LexerRule>, name: &String) -> Option<&LexerRule> {
    for let rule of all_rules {
        if rule.name == *name && rule.is_fragment {
            return Option::<&LexerRule>::Some(rule);
        }
    }
    return null;
}

/// Tries to extract a single lowercase char from a case-insensitive CharClass (e.g., [aA]).
fn try_extract_ci_char(cc: &CharClass) -> Option<char> {
    if cc.negated {
        return null;
    }
    if cc.ranges.len() == 1 {
        let r = &cc.ranges[0];
        if r.start == r.end {
            return Option::<char>::Some(r.start.to_ascii_lowercase());
        }
        return null;
    }
    if cc.ranges.len() == 2 {
        let r0 = &cc.ranges[0];
        let r1 = &cc.ranges[1];
        if r0.start == r0.end
            && r1.start == r1.end
            && r0.start != r1.start
            && r0.start.to_ascii_lowercase() == r1.start.to_ascii_lowercase() {
            return Option::<char>::Some(r0.start.to_ascii_lowercase());
        }
    }
    return null;
}

/// Extracts a [lowercase_char, is_case_insensitive] pair from a lexer element.
/// When `rule_ci` is true, plain literal chars are treated as case-insensitive
/// too — ANTLR4's `caseInsensitive` option folds every grammar-level char to
/// its opposing-case partner.
fn try_extract_keyword_char(elem: &LexerElement, all_rules: &Array<LexerRule>, rule_ci: bool) -> Option<[char, bool]> {
    if let Literal(text) = elem {
        let mut iter = text.chars();
        if let Some(c) = iter.next() {
            if let None = iter.next() {
                let is_letter = c.to_ascii_lowercase() != c.to_ascii_uppercase();
                let ci = rule_ci && is_letter;
                return Option::<[char, bool]>::Some([c.to_ascii_lowercase(), ci]);
            }
        }
        return null;
    }
    if let CharClass(cc) = elem {
        let ch = try_extract_ci_char(cc);
        if let Some(c) = ch {
            return Option::<[char, bool]>::Some([c, true]);
        }
        if !cc.negated && cc.ranges.len() == 1 && cc.ranges[0].start == cc.ranges[0].end {
            let c = cc.ranges[0].start;
            let is_letter = c.to_ascii_lowercase() != c.to_ascii_uppercase();
            let ci = rule_ci && is_letter;
            return Option::<[char, bool]>::Some([c.to_ascii_lowercase(), ci]);
        }
        return null;
    }
    if let RuleRef(name) = elem {
        let frag = find_fragment(all_rules, name);
        if let Some(f) = frag {
            if f.body.len() == 1 && f.body[0].elements.len() == 1 {
                return try_extract_keyword_char(&f.body[0].elements[0], all_rules, rule_ci);
            }
        }
        return null;
    }
    return null;
}

/// Analyzes a lexer rule to determine if it's a fixed keyword pattern.
/// Returns KeywordInfo if it matches a sequence of case-insensitive (or literal) chars.
fn try_extract_keyword_info(rule: &LexerRule, all_rules: &Array<LexerRule>, grammar_opts: &Array<GrammarOption>) -> Option<KeywordInfo> {
    if rule.is_fragment || rule.body.len() != 1 {
        return null;
    }
    // Rules carrying lexer commands (more, channel, type(X), mode(X)/pushMode/popMode, skip)
    // cannot be shortcut via keyword dispatch — the keyword classifier only rewrites
    // `best_kind`, it does not propagate the command state to the tokenize loop.
    if rule.skip
        || rule.more
        || rule.channel != 0
        || rule.type_override matches { Some(_) }
        || rule.mode != 0
        || rule.set_mode >= 0
        || rule.push_mode >= 0
        || rule.pop_mode {
        return null;
    }
    let alt = &rule.body[0];
    if alt.elements.is_empty() {
        return null;
    }
    let rule_ci = resolve_ci(grammar_opts, &rule.options);
    let mut text = String::with_capacity(alt.elements.len());
    let mut char_ci: Array<bool> = [];
    for let elem of &alt.elements {
        if let Some(pair) = try_extract_keyword_char(elem, all_rules, rule_ci) {
            text.push(pair.0);
            char_ci.push(pair.1);
        } else {
            return null;
        }
    }
    // Only treat identifier-like patterns as keywords (letters, digits, underscores).
    // `text` is already lowercased by try_extract_keyword_char.
    for let c of text.chars() {
        if !c.is_ascii_lowercase() && c != '_' && !(c >= '0' && c <= '9') {
            return null;
        }
    }
    return Option::<KeywordInfo>::Some(KeywordInfo {
        rule_name: rule.name,
        lowercase_text: text,
        char_ci,
    });
}

/// Collects all keyword rules from the grammar.
///
/// The keyword path is an optimisation: instead of dispatching keyword-shaped
/// rules through their own first-character branch, the tokenize loop runs
/// `classify_keyword` after a longer non-keyword rule has already matched the
/// same characters (the gate is `best_end > start`). The optimisation is
/// only sound when some non-keyword rule could match the keyword's first
/// character — otherwise the classifier never runs and the rule is
/// unreachable. ANTLR4 has no such precondition (every lexer rule is its own
/// dispatch path); to stay compatible Gale must not classify a rule as a
/// keyword unless that precondition holds. Candidates that fail the check
/// fall back to the regular dispatch path (`gen_lexer_match_fn`).
pub fn collect_keyword_rules(lexer_rules: &Array<LexerRule>, grammar_opts: &Array<GrammarOption>) -> Array<KeywordInfo> {
    let mut candidates: Array<KeywordInfo> = [];
    for let rule of lexer_rules {
        if rule.is_fragment || rule.is_virtual {
            continue;
        }
        let info = try_extract_keyword_info(rule, lexer_rules, grammar_opts);
        if let Some(kw) = info {
            candidates.push(kw);
        }
    }
    // Precompute the first-char set of each potential carrier rule once, so
    // the per-candidate filter below is O(carriers + candidates) rather than
    // O(carriers × candidates) `compute_first_chars` calls. A single
    // wildcard carrier (e.g. `UNEXPECTED : .;`) covers every candidate, so
    // we short-circuit and skip the filter entirely.
    let mut carrier_first_chars: Array<Array<[char, char]>> = [];
    let mut any_wildcard_carrier = false;
    for let rule of lexer_rules {
        if rule.is_fragment || rule.is_virtual {
            continue;
        }
        if is_keyword_rule_name(&rule.name, &candidates) {
            continue;
        }
        let try_call = compute_first_chars(rule, lexer_rules, false, false, false, false, grammar_opts);
        if try_call.is_wildcard {
            any_wildcard_carrier = true;
            break;
        }
        carrier_first_chars.push(try_call.first_chars);
    }
    let mut result: Array<KeywordInfo> = [];
    for let kw of &candidates {
        if any_wildcard_carrier || keyword_has_carrier(kw, &carrier_first_chars) {
            result.push(*kw);
        }
    }
    return result;
}

/// Returns true if some precomputed carrier first-char set covers `kw`'s
/// first character (folded to either case when `kw`'s first character is
/// case-insensitive).
fn keyword_has_carrier(kw: &KeywordInfo, carrier_first_chars: &Array<Array<[char, char]>>) -> bool {
    let first_char = kw.lowercase_text.chars().next().unwrap();
    let first_ci = kw.char_ci[0];
    let upper = if first_ci { first_char.to_ascii_uppercase() } else { first_char };
    for let ranges of carrier_first_chars {
        if char_matches_ranges(first_char, ranges) {
            return true;
        }
        if first_ci && upper != first_char && char_matches_ranges(upper, ranges) {
            return true;
        }
    }
    return false;
}

fn is_keyword_rule_name(name: &String, keywords: &Array<KeywordInfo>) -> bool {
    for let kw of keywords {
        if kw.rule_name == *name {
            return true;
        }
    }
    return false;
}

/// Extracts the fixed literal text from a lexer rule, if it's a pure literal sequence.
fn try_extract_fixed_text(rule: &LexerRule) -> Option<String> {
    if rule.is_fragment || rule.body.len() != 1 {
        return null;
    }
    let alt = &rule.body[0];
    let mut text = String::with_capacity(alt.elements.len());
    for let elem of &alt.elements {
        if let Literal(s) = elem {
            text.push_str(s);
        } else {
            return null;
        }
    }
    return Option::<String>::Some(text);
}

/// Check if a lexer rule has the same fixed text as any literal token.
///
/// Parser literals inherit the grammar-level `caseInsensitive` setting, so a
/// lexer rule with a divergent rule-level CI override must keep its own
/// `try_*` function instead of being deduped against the shared literal.
fn is_literal_duplicate(rule: &LexerRule, lit_tokens: &Array<LitToken>, grammar_opts: &Array<GrammarOption>, grammar_ci: bool) -> bool {
    let rule_ci = resolve_ci(grammar_opts, &rule.options);
    if rule_ci != grammar_ci {
        return false;
    }
    let text = try_extract_fixed_text(rule);
    if let Some(t) = &text {
        for let lit of lit_tokens {
            if lit.text == *t {
                return true;
            }
        }
    }
    return false;
}

fn gen_keyword_classifier_fn(w: &mut CodeWriter, keywords: &Array<KeywordInfo>) {
    if keywords.is_empty() {
        return;
    }

    let mut f = FnSpec::new("classify_keyword");
    f.add_param(&"chars", &"&Array<char>");
    f.add_param(&"start", &"i32");
    f.add_param(&"end", &"i32");
    f.set_return_type(&"i32");
    f.emit_begin(w);

    w.line(&"let len = end - start;");

    // Find min/max keyword length (ASCII keywords: byte len == char count)
    let mut min_len = 9999;
    let mut max_len = 0;
    for let kw of keywords {
        let l = kw.lowercase_text.len();
        if l < min_len {
            min_len = l;
        }
        if l > max_len {
            max_len = l;
        }
    }

    let mut first_len = true;
    for let mut target_len = min_len; target_len <= max_len; target_len += 1 {
        // Check if any keywords have this length
        let mut has_any = false;
        for let kw of keywords {
            if kw.lowercase_text.len() == target_len {
                has_any = true;
            }
        }
        if !has_any {
            continue;
        }

        if first_len {
            w.begin(&`if len == {target_len}`);
            first_len = false;
        } else {
            w.else_begin(&`else if len == {target_len}`);
        }

        // Group keywords of this length by first character for dispatch
        let mut len_keywords: Array<&KeywordInfo> = [];
        for let kw of keywords {
            if kw.lowercase_text.len() == target_len {
                len_keywords.push(kw);
            }
        }
        // Collect unique first chars
        let mut first_chars: Array<char> = [];
        for let kw of &len_keywords {
            let fc = kw.lowercase_text.chars().next().unwrap();
            let mut found = false;
            for let existing of &first_chars {
                if *existing == fc {
                    found = true;
                }
            }
            if !found {
                first_chars.push(fc);
            }
        }
        first_chars.sort();
        // Emit first-char dispatch within this length group if >1 first char
        if first_chars.len() > 1 {
            let mut first_fc = true;
            for let fc of &first_chars {
                let guard = gen_char_guard(&"chars[start]", *fc, true);
                if first_fc {
                    w.begin(&`if {guard}`);
                    first_fc = false;
                } else {
                    w.else_begin(&`else if {guard}`);
                }
                for let kw of &len_keywords {
                    if kw.lowercase_text.chars().next().unwrap() != *fc {
                        continue;
                    }
                    emit_keyword_check(w, *kw);
                }
            }
            w.end();
        } else {
            for let kw of &len_keywords {
                emit_keyword_check(w, *kw);
            }
        }
    }
    if !first_len {
        w.end();
    }

    w.line(&"return -1;");
    w.end();
    w.blank();
}

fn gen_char_guard(access: &String, c: char, ci: bool) -> String {
    let lower = c.to_ascii_lowercase();
    let upper = c.to_ascii_uppercase();
    if ci && lower != upper {
        return `{access}.eq_ignore_ascii_case(&{escape_char(lower)})`;
    }
    return `{access} == {escape_char(c)}`;
}

fn gen_char_mismatch(access: &String, c: char, ci: bool) -> String {
    let lower = c.to_ascii_lowercase();
    let upper = c.to_ascii_uppercase();
    if ci && lower != upper {
        return `!{access}.eq_ignore_ascii_case(&{escape_char(lower)})`;
    }
    return `{access} != {escape_char(c)}`;
}

fn emit_keyword_check(w: &mut CodeWriter, kw: &KeywordInfo) {
    let kw_chars: Array<char> = kw.lowercase_text.chars().collect();
    w.write(&"if ");
    for let mut ci = 0; ci < kw_chars.len(); ci += 1 {
        if ci > 0 {
            w.write(&" && ");
        }
        let lower = kw_chars[ci];
        if kw.char_ci[ci] {
            w.write(&`chars[start + {ci}].eq_ignore_ascii_case(&{escape_char(lower)})`);
        } else {
            w.write(&`chars[start + {ci}] == {escape_char(lower)}`);
        }
    }
    w.write(&` \{ return TK_{kw.rule_name}; \}\n`);
}

fn gen_literal_match_fns(w: &mut CodeWriter, lit_tokens: &Array<LitToken>, ci: bool) {
    for let lit of lit_tokens {
        let chars: Array<char> = lit.text.chars().collect();
        let fn_name = lit_try_fn_name(&lit.const_name);
        let mut f = FnSpec::new(&fn_name);
        f.add_param(&"chars", &"&Array<char>");
        f.add_param(&"start", &"i32");
        f.set_return_type(&"i32");
        f.emit_begin(w);
        w.line(&"let pos = start;");
        for let mut i = 0; i < chars.len(); i += 1 {
            let mismatch = gen_char_mismatch(&`chars[pos + {i}]`, chars[i], ci);
            w.line(&`if pos + {i} >= chars.len() || {mismatch} \{ return -1; \}`);
        }
        let len = chars.len();
        w.line(&`return pos + {len};`);
        w.end();
        w.blank();
    }
}

fn lit_try_fn_name(const_name: &String) -> String {
    let mut result = String::with_capacity(const_name.len() + 4);
    result.push_str(&"try_lit_");
    let chars: Array<char> = const_name.chars().collect();
    for let mut i = 7; i < chars.len(); i += 1 {
        result.push(chars[i].to_ascii_lowercase());
    }
    return result;
}

fn has_modes(mode_names: &Array<String>) -> bool {
    return mode_names.len() > 1;
}

fn has_set_mode(rules: &Array<LexerRule>) -> bool {
    for let r of rules {
        if r.set_mode >= 0 {
            return true;
        }
    }
    return false;
}

fn has_more(rules: &Array<LexerRule>) -> bool {
    for let r of rules {
        if r.more {
            return true;
        }
    }
    return false;
}

fn has_channel(rules: &Array<LexerRule>) -> bool {
    for let r of rules {
        if r.channel != 0 {
            return true;
        }
    }
    return false;
}

struct TryCall {
    fn_name: String,
    token_kind: String,
    extra: String,
    first_chars: Array<[char, char]>,
    is_wildcard: bool,
    is_catch_all: bool,
    match_length: i32,
}

/// Build the default "reset" extras for state variables that exist in the
/// current lexer shape. Used for literal-token calls that have no rule flags
/// of their own — they still need to reset the state written by the previous
/// best match.
fn default_extras(use_modes: bool, has_set_mode_rules: bool, has_more_rules: bool, has_channel_rules: bool) -> String {
    let mut extras = String::with_capacity(64);
    if use_modes {
        extras.push_str(&" best_push_mode = -1; best_pop_mode = false;");
    }
    if has_set_mode_rules {
        extras.push_str(&" best_set_mode = -1;");
    }
    if has_more_rules {
        extras.push_str(&" best_more = false;");
    }
    if has_channel_rules {
        extras.push_str(&" best_channel = 0;");
    }
    return extras;
}

/// Compute the first-char set for a lexer rule body's first element.
fn compute_first_chars(rule: &LexerRule, all_rules: &Array<LexerRule>, use_modes: bool, has_set_mode_rules: bool, has_more_rules: bool, has_channel_rules: bool, grammar_opts: &Array<GrammarOption>) -> TryCall {
    let ci = resolve_ci(grammar_opts, &rule.options);
    let fn_name = `try_{to_lower(&rule.name)}`;
    // `type(X)` rewrites the kind used when emitting the token. Use the
    // override kind at emit time so downstream code (parser, token_kind_name)
    // sees the renamed type. The rule itself still has its own TK_<name>
    // constant; the override only affects emission.
    let token_kind = if let Some(override_name) = rule.type_override {
        `TK_{override_name}`;
    } else {
        `TK_{rule.name}`;
    };
    let mut extra = String::with_capacity(64);
    if use_modes {
        if rule.push_mode >= 0 {
            extra.push_str(&` best_push_mode = {rule.push_mode};`);
        } else {
            extra.push_str(&" best_push_mode = -1;");
        }
        if rule.pop_mode {
            extra.push_str(&" best_pop_mode = true;");
        } else {
            extra.push_str(&" best_pop_mode = false;");
        }
    }
    if has_set_mode_rules {
        if rule.set_mode >= 0 {
            extra.push_str(&` best_set_mode = {rule.set_mode};`);
        } else {
            extra.push_str(&" best_set_mode = -1;");
        }
    }
    if has_more_rules {
        if rule.more {
            extra.push_str(&" best_more = true;");
        } else {
            extra.push_str(&" best_more = false;");
        }
    }
    if has_channel_rules {
        if rule.channel != 0 {
            extra.push_str(&` best_channel = {rule.channel};`);
        } else {
            extra.push_str(&" best_channel = 0;");
        }
    }
    let mut chars: Array<[char, char]> = [];
    let is_wc = compute_elem_first_chars(&rule.body, all_rules, &mut chars, ci);
    // A catch-all rule (e.g., UNEXPECTED_CHAR: .) matches any single character.
    // It's only useful in the wildcard fallback, never in specific dispatch branches
    // where another rule already matches at least 1 character.
    let catch_all = is_wc
        && rule.body.len() == 1
        && rule.body[0].elements.len() == 1
        && rule.body[0].elements[0] matches { AnyChar };
    return TryCall {
        fn_name,
        token_kind,
        extra,
        first_chars: chars,
        is_wildcard: is_wc,
        is_catch_all: catch_all,
        match_length: -1,
    };
}

/// Analyze first elements of rule body alternatives to find first-char set.
/// Returns true if it's a wildcard (any char could match).
fn compute_elem_first_chars(body: &Array<LexerAlt>, all_rules: &Array<LexerRule>, out: &mut Array<[char, char]>, ci: bool) -> bool {
    for let alt of body {
        if alt.elements.is_empty() {
            return true;
        }
        let elem = &alt.elements[0];
        if compute_single_elem_first(elem, all_rules, out, ci) {
            return true;
        }
    }
    return false;
}

fn add_folded_range(out: &mut Array<[char, char]>, start: char, end: char, ci: bool) {
    if !ci {
        add_range(out, start, end);
        return;
    }
    let mut folded: Array<CharRange> = [];
    fold_range_ci(start, end, &mut folded);
    for let r of &folded {
        add_range(out, r.start, r.end);
    }
}

fn compute_single_elem_first(elem: &LexerElement, all_rules: &Array<LexerRule>, out: &mut Array<[char, char]>, ci: bool) -> bool {
    match *elem {
        Literal(text) => {
            let c = text.chars().next().unwrap();
            add_folded_range(out, c, c, ci);
            return false;
        },
        CharRange(pair) => {
            add_folded_range(out, pair.0, pair.1, ci);
            return false;
        },
        CharClass(cc) => {
            if cc.negated {
                return true;
            }
            for let r of &cc.ranges {
                add_folded_range(out, r.start, r.end, ci);
            }
            return false;
        },
        RuleRef(name) => {
            for let rule of all_rules {
                if rule.name == name && rule.is_fragment {
                    return compute_elem_first_chars(&rule.body, all_rules, out, ci);
                }
            }
            return true;
        },
        Repeat(rep) => {
            let is_wc = compute_single_elem_first(&rep.element, all_rules, out, ci);
            if is_wc {
                return true;
            }
            if rep.kind matches { Star } || rep.kind matches { Optional } {
                return true;
            }
            return false;
        },
        Group(alts) => {
            return compute_elem_first_chars(&alts, all_rules, out, ci);
        },
        _ => {
            return true;
        },
    }
}

fn add_range(out: &mut Array<[char, char]>, start: char, end: char) {
    for let r of out {
        if r[0] == start && r[1] == end {
            return;
        }
    }
    out.push([start, end]);
}

/// Check if a char matches any of the ranges in first_chars.
fn char_matches_ranges(c: char, ranges: &Array<[char, char]>) -> bool {
    for let r of ranges {
        if c >= r[0] && c <= r[1] {
            return true;
        }
    }
    return false;
}

/// Build dispatch groups: for each unique first char, which try calls apply?
struct DispatchGroup {
    guard: String,
    calls: Array<i32>,
}

fn build_dispatch_groups(calls: &Array<TryCall>) -> Array<DispatchGroup> {
    // Collect all unique single chars from first_chars
    let mut all_chars: Array<char> = [];
    for let call of calls {
        if call.is_wildcard {
            continue;
        }
        for let r of &call.first_chars {
            if r[0] == r[1] {
                let mut found = false;
                for let existing of &all_chars {
                    if *existing == r[0] {
                        found = true;
                    }
                }
                if !found {
                    all_chars.push(r[0]);
                }
            }
        }
    }
    all_chars.sort();

    let mut groups: Array<DispatchGroup> = [];

    // For each unique single char, find all matching calls (excluding catch-all rules)
    for let c of &all_chars {
        let mut matching: Array<i32> = [];
        for let mut i = 0; i < calls.len(); i += 1 {
            if calls[i].is_catch_all {
                continue;
            }
            if calls[i].is_wildcard || char_matches_ranges(*c, &calls[i].first_chars) {
                matching.push(i);
            }
        }
        // Check if this group already exists
        let mut merged = false;
        for let g of &mut groups {
            if arrays_equal(&g.calls, &matching) {
                // Add char to existing group's guard
                g.guard.push_str(&` || first_char == {escape_char(*c)}`);
                merged = true;
            }
        }
        if !merged {
            groups.push(DispatchGroup {
                guard: `first_char == {escape_char(*c)}`,
                calls: matching,
            });
        }
    }

    // Collect all ranged entries (ranges where start != end)
    let mut range_calls: Array<i32> = [];
    for let mut i = 0; i < calls.len(); i += 1 {
        if calls[i].is_wildcard {
            continue;
        }
        for let r of &calls[i].first_chars {
            if r[0] != r[1] {
                let mut found = false;
                for let existing of &range_calls {
                    if *existing == i {
                        found = true;
                    }
                }
                if !found {
                    range_calls.push(i);
                }
            }
        }
    }

    // Merge range-based calls into groups or add them to wildcard fallback
    // For simplicity, add range-based calls to a "range group" with their guard
    for let mut i = 0; i < calls.len(); i += 1 {
        if calls[i].is_wildcard {
            continue;
        }
        for let r of &calls[i].first_chars {
            if r[0] != r[1] {
                // Build range guard
                let guard = `{escape_char(r[0])} <= first_char <= {escape_char(r[1])}`;
                // Find or create group
                let mut found_group = false;
                for let g of &mut groups {
                    if g.guard == guard {
                        let mut already = false;
                        for let ci of &g.calls {
                            if *ci == i {
                                already = true;
                            }
                        }
                        if !already {
                            g.calls.push(i);
                        }
                        found_group = true;
                    }
                }
                if !found_group {
                    let mut cs: Array<i32> = [];
                    cs.push(i);
                    // Also add non-catch-all wildcards
                    for let mut j = 0; j < calls.len(); j += 1 {
                        if calls[j].is_wildcard && !calls[j].is_catch_all {
                            cs.push(j);
                        }
                    }
                    groups.push(DispatchGroup { guard, calls: cs });
                }
            }
        }
    }

    // Wildcard fallback: only include wildcard calls, range-based calls,
    // and calls whose first_chars include characters not covered by specific groups.
    // Single-char-only calls are fully covered by their specific dispatch branches.
    let mut wildcard_calls: Array<i32> = [];
    for let mut i = 0; i < calls.len(); i += 1 {
        if calls[i].is_wildcard {
            wildcard_calls.push(i);
            continue;
        }
        let mut has_range = false;
        for let r of &calls[i].first_chars {
            if r[0] != r[1] {
                has_range = true;
            }
        }
        if has_range {
            wildcard_calls.push(i);
        }
    }
    if !wildcard_calls.is_empty() {
        groups.push(DispatchGroup { guard: String::from("true"), calls: wildcard_calls });
    }

    // Sort each group's calls by original index to preserve grammar priority order.
    // When wildcards and range-based calls are mixed in a group, the insertion order
    // may not match grammar order — sorting restores it so that same-length matches
    // respect ANTLR4-style "first rule in grammar wins" priority.
    for let g of &mut groups {
        g.calls.sort();
    }

    return groups;
}

fn emit_dispatch_groups(w: &mut CodeWriter, calls: &Array<TryCall>, groups: &Array<DispatchGroup>, needs_extras: bool) {
    // If only a wildcard group exists, emit calls directly without dispatch
    if groups.len() == 1 && groups[0].guard == "true" {
        emit_group_calls(w, calls, &groups[0].calls, needs_extras, true);
        return;
    }
    let mut first_group = true;
    for let g of groups {
        let is_wc = g.guard == "true";
        if is_wc {
            if first_group {
                emit_group_calls(w, calls, &g.calls, needs_extras, true);
                continue;
            }
            w.else_begin(&"else");
        } else if first_group {
            w.begin(&`if {g.guard}`);
        } else {
            w.else_begin(&`else if {g.guard}`);
        }
        first_group = false;
        emit_group_calls(w, calls, &g.calls, needs_extras, is_wc);
    }
    if !first_group {
        w.end();
    }
}

fn emit_group_calls(w: &mut CodeWriter, calls: &Array<TryCall>, indices: &Array<i32>, needs_extras: bool, is_wildcard_group: bool) {
    for let ci of indices {
        let call = &calls[*ci];
        // In specific dispatch branches, single-char literals are guaranteed to match
        // (the dispatch already confirmed the character). Inline the result
        // instead of calling the try_* function.
        if !is_wildcard_group && call.match_length == 1 {
            if needs_extras {
                w.line(
                    &`if start + 1 > best_end \{ best_end = start + 1; best_kind = {call.token_kind};{call.extra} \}`,
                );
            } else {
                w.line(&`if start + 1 > best_end \{ best_end = start + 1; best_kind = {call.token_kind}; \}`);
            }
            continue;
        }
        w.line(&`end = {call.fn_name}(&lexer.chars, start);`);
        if needs_extras {
            w.line(&`if end > best_end \{ best_end = end; best_kind = {call.token_kind};{call.extra} \}`);
        } else {
            w.line(&`if end > best_end \{ best_end = end; best_kind = {call.token_kind}; \}`);
        }
    }
}

fn arrays_equal(a: &Array<i32>, b: &Array<i32>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for let mut i = 0; i < a.len(); i += 1 {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn gen_tokenize_fn(w: &mut CodeWriter, lexer_rules: &Array<LexerRule>, lit_tokens: &Array<LitToken>, mode_names: &Array<String>, keywords: &Array<KeywordInfo>, grammar_opts: &Array<GrammarOption>) {
    let use_modes = has_modes(mode_names);
    let has_set_mode_rules = has_set_mode(lexer_rules);
    let has_more_rules = has_more(lexer_rules);
    let has_channel_rules = has_channel(lexer_rules);
    let empty_opts: Array<GrammarOption> = [];
    let grammar_ci = resolve_ci(grammar_opts, &empty_opts);

    let mut f = FnSpec::new("tokenize");
    f.set_pub();
    f.add_param(&"input", &"&String");
    f.set_return_type(&"Array<Token>");
    f.emit_begin(w);
    w.line(&"let mut lexer = Lexer::new(input);");
    w.line(&"let mut tokens: Array<Token> = [];");
    w.line(&"let mut trivia: Array<Token> = [];");

    if has_more_rules {
        // Tracks the start position of a pending `more` sequence; -1 means
        // no pending `more` data. When a non-`more` rule emits, it uses
        // `more_start` as the token start so the emitted text includes
        // all previously-`more`'d characters.
        w.line(&"let mut more_start: i32 = -1;");
    }

    if use_modes {
        w.line(&"let mut mode_stack: Array<i32> = [];");
        w.line(&"let mut current_mode: i32 = 0;");
    }

    w.begin(&"while !lexer.at_end()");
    w.line(&"let start = lexer.pos;");
    w.line(&"let mut best_end: i32 = -1;");
    w.line(&"let mut best_kind: i32 = TK_ERROR;");
    w.line(&"let mut end: i32 = -1;");
    w.line(&"let first_char = lexer.chars[start];");

    if use_modes {
        w.line(&"let mut best_push_mode: i32 = -1;");
        w.line(&"let mut best_pop_mode = false;");
    }
    if has_set_mode_rules {
        w.line(&"let mut best_set_mode: i32 = -1;");
    }
    if has_more_rules {
        w.line(&"let mut best_more = false;");
    }
    if has_channel_rules {
        w.line(&"let mut best_channel: i32 = 0;");
    }

    if use_modes {
        // Generate mode dispatch
        for let mut mi = 0; mi < mode_names.len(); mi += 1 {
            if mi == 0 {
                w.begin(&`if current_mode == {mi}`);
            } else {
                w.else_begin(&`else if current_mode == {mi}`);
            }
            // Literal tokens only in default mode
            if mi == 0 {
                for let lit of lit_tokens {
                    let fn_name = lit_try_fn_name(&lit.const_name);
                    w.line(&`end = {fn_name}(&lexer.chars, start);`);
                    let mut lit_reset = String::from(" best_push_mode = -1; best_pop_mode = false;");
                    if has_set_mode_rules {
                        lit_reset.push_str(&" best_set_mode = -1;");
                    }
                    if has_more_rules {
                        lit_reset.push_str(&" best_more = false;");
                    }
                    if has_channel_rules {
                        lit_reset.push_str(&" best_channel = 0;");
                    }
                    w.line(
                        &`if end > best_end \{ best_end = end; best_kind = {lit.const_name};{lit_reset} \}`,
                    );
                }
            }
            for let rule of lexer_rules {
                if !rule.is_fragment
                    && !rule.is_virtual
                    && rule.mode == mi
                    && !is_keyword_rule_name(&rule.name, keywords)
                    && !is_literal_duplicate(rule, lit_tokens, grammar_opts, grammar_ci) {
                    let fn_name = `try_{to_lower(&rule.name)}`;
                    w.line(&`end = {fn_name}(&lexer.chars, start);`);
                    let mut extra = String::with_capacity(64);
                    if rule.push_mode >= 0 {
                        extra.push_str(&` best_push_mode = {rule.push_mode};`);
                    } else {
                        extra.push_str(&" best_push_mode = -1;");
                    }
                    if rule.pop_mode {
                        extra.push_str(&" best_pop_mode = true;");
                    } else {
                        extra.push_str(&" best_pop_mode = false;");
                    }
                    if has_set_mode_rules {
                        if rule.set_mode >= 0 {
                            extra.push_str(&` best_set_mode = {rule.set_mode};`);
                        } else {
                            extra.push_str(&" best_set_mode = -1;");
                        }
                    }
                    if has_more_rules {
                        if rule.more {
                            extra.push_str(&" best_more = true;");
                        } else {
                            extra.push_str(&" best_more = false;");
                        }
                    }
                    if has_channel_rules {
                        if rule.channel != 0 {
                            extra.push_str(&` best_channel = {rule.channel};`);
                        } else {
                            extra.push_str(&" best_channel = 0;");
                        }
                    }
                    // `type(X)` rewrites the emitted kind. The rule still has
                    // its own TK_<name> constant; the override only affects
                    // the emitted token.
                    let emit_kind = if let Some(override_name) = rule.type_override {
                        `TK_{override_name}`;
                    } else {
                        `TK_{rule.name}`;
                    };
                    w.line(&`if end > best_end \{ best_end = end; best_kind = {emit_kind};{extra} \}`);
                }
            }
        }
        w.end();  // mode dispatch
    } else {
        // No modes — first-character dispatch
        let needs_extras = has_set_mode_rules || has_more_rules || has_channel_rules;
        let lit_extras = default_extras(false, has_set_mode_rules, has_more_rules, has_channel_rules);
        let mut all_calls: Array<TryCall> = [];
        for let lit of lit_tokens {
            let fn_name = lit_try_fn_name(&lit.const_name);
            let c = lit.text.chars().next().unwrap();
            let mut fc: Array<[char, char]> = [];
            // Parser literals inherit grammar-level caseInsensitive. Under CI,
            // the literal's first char may appear in either case.
            add_folded_range(&mut fc, c, c, grammar_ci);
            let tk = lit.const_name;
            let mlen = lit.text.chars().count();
            all_calls.push(TryCall {
                fn_name,
                token_kind: tk,
                extra: lit_extras,
                first_chars: fc,
                is_wildcard: false,
                is_catch_all: false,
                match_length: mlen,
            });
        }
        for let rule of lexer_rules {
            if !rule.is_fragment
                && !rule.is_virtual
                && !is_keyword_rule_name(&rule.name, keywords)
                && !is_literal_duplicate(rule, lit_tokens, grammar_opts, grammar_ci) {
                all_calls.push(compute_first_chars(
                    rule,
                    lexer_rules,
                    false,
                    has_set_mode_rules,
                    has_more_rules,
                    has_channel_rules,
                    grammar_opts,
                ));
            }
        }
        let groups = build_dispatch_groups(&all_calls);
        emit_dispatch_groups(w, &all_calls, &groups, needs_extras);
    }

    // Keyword reclassification: check if the matched text is actually a keyword.
    // classify_keyword does length-based dispatch internally, so no first-char guard needed.
    if !keywords.is_empty() {
        w.begin(&"if best_end > start");
        w.line(&"let kw_kind = classify_keyword(&lexer.chars, start, best_end);");
        w.line(&"if kw_kind >= 0 { best_kind = kw_kind; }");
        w.end();
    }

    w.begin(&"if best_end <= start");
    w.line(
        &"let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);",
    );
    w.line(&"tokens.push(tok);");
    w.line(&"trivia = [];");
    w.line(&"lexer.pos = start + 1;");
    w.else_begin(&"else");

    // `more` rules accumulate text into the next emitted token. `tok_start`
    // is the earliest start position of the current pending `more` chain,
    // or `start` if no `more` is pending.
    if has_more_rules {
        w.line(&"let tok_start = if more_start >= 0 { more_start } else { start };");
    } else {
        w.line(&"let tok_start = start;");
    }

    let mut skip_names: Array<String> = [];
    for let rule of lexer_rules {
        if rule.skip {
            skip_names.push(`TK_{rule.name}`);
        }
    }
    if skip_names.is_empty() {
        w.line(&"let is_skip = false;");
    } else {
        w.write(&"let is_skip = best_kind matches { ");
        for let mut i = 0; i < skip_names.len(); i += 1 {
            if i > 0 {
                w.write(&" | ");
            }
            w.write(&skip_names[i]);
        }
        w.write(&" };\n");
    }

    if has_more_rules {
        // A `more` match suppresses emission and remembers the starting
        // position so the next non-`more` match covers the full span.
        w.begin(&"if best_more");
        w.line(&"if more_start < 0 { more_start = start; }");
        w.else_begin(&"else if is_skip");
        w.line(&"trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));");
        w.line(&"more_start = -1;");
        if has_channel_rules {
            // Non-default channels are invisible to the parser — route to
            // trivia with the channel id preserved. ANTLR4 treats any
            // non-DEFAULT channel the same way at the parser boundary.
            w.else_begin(&"else if best_channel != 0");
            w.line(
                &"trivia.push(Token::with_channel(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), [], best_channel));",
            );
            w.line(&"more_start = -1;");
        }
        w.else_begin(&"else");
        w.line(
            &"let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);",
        );
        w.line(&"tokens.push(tok);");
        w.line(&"trivia = [];");
        w.line(&"more_start = -1;");
        w.end();
    } else {
        w.begin(&"if is_skip");
        w.line(&"trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));");
        if has_channel_rules {
            // Non-default channels are invisible to the parser — route to
            // trivia with the channel id preserved. ANTLR4 treats any
            // non-DEFAULT channel the same way at the parser boundary.
            w.else_begin(&"else if best_channel != 0");
            w.line(
                &"trivia.push(Token::with_channel(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), [], best_channel));",
            );
        }
        w.else_begin(&"else");
        w.line(
            &"let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);",
        );
        w.line(&"tokens.push(tok);");
        w.line(&"trivia = [];");
        w.end();
    }

    if use_modes {
        w.begin(&"if best_push_mode >= 0");
        w.line(&"mode_stack.push(current_mode);");
        w.line(&"current_mode = best_push_mode;");
        w.line(&"best_push_mode = -1;");
        w.end();
        w.begin(&"if best_pop_mode");
        w.begin(&"if mode_stack.is_empty()");
        w.line(&"current_mode = 0;");
        w.else_begin(&"else");
        w.line(&"current_mode = mode_stack[mode_stack.len() - 1];");
        w.line(&"mode_stack.pop();");
        w.end();
        w.line(&"best_pop_mode = false;");
        w.end();
        if has_set_mode_rules {
            // `mode(X)` replaces the current mode directly — no stack push.
            w.begin(&"if best_set_mode >= 0");
            w.line(&"current_mode = best_set_mode;");
            w.line(&"best_set_mode = -1;");
            w.end();
        }
    }

    w.line(&"lexer.pos = best_end;");
    w.end();  // else
    w.end();  // while
    w.line(
        &"tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));",
    );
    w.line(&"return tokens;");
    w.end();  // fn
    w.blank();
}

fn gen_token_kind_name_fn(w: &mut CodeWriter, lexer_rules: &Array<LexerRule>, lit_tokens: &Array<LitToken>) {
    let mut f = FnSpec::new("token_kind_name");
    f.set_pub();
    f.add_param(&"kind", &"i32");
    f.set_return_type(&"String");
    f.emit_begin(w);

    w.line(&"return match kind {");
    w.indent();
    for let rule of lexer_rules {
        if !rule.is_fragment {
            let trailer = if rule.is_virtual { "  // virtual" } else { "" };
            w.line(&`TK_{rule.name} => "{rule.name}",{trailer}`);
        }
    }
    w.line(&"TK_EOF => \"Eof\",");
    w.line(&"TK_ERROR => \"Error\",");
    for let lit of lit_tokens {
        let name = lit.const_name;
        w.line(&`{name} => "{name}",`);
    }
    w.line(&"_ => \"Unknown\",");
    w.dedent();
    w.line(&"};");
    w.end();  // fn
    w.blank();
}
