//! Lexer `{ ... }` action execution (Stage C, `language = Wado`).
//!
//! A lexer action runs at the tournament commit for the *winning* rule only,
//! never for a losing candidate. Codegen folds the action-effect surface onto
//! `Lexer`, an `apply_<rule>_actions` replay per executing rule, and a `best_act` tracker
//! folded into the commit. These tests pin the emit shape, the byte-identical
//! guard for actionless grammars, and the loud safety net for action forms
//! codegen does not yet execute (nested-group, multi-alt, mode grammars).

use { parse } from "./g4/parser.wado";
use { generate, GenerateOptions } from "./codegen.wado";
use { Diagnostic, DiagnosticKind } from "./gir.wado";

global OPTS: GenerateOptions = GenerateOptions {};

fn gen_source(src: &String) -> String {
    let mut g = parse(*src).unwrap();
    return generate(&mut g, &OPTS).source;
}

fn count_unsupported(diags: &List<Diagnostic>) -> i32 {
    let mut n = 0;
    for let d of diags {
        if d.kind matches { UnsupportedAction } {
            n += 1;
        }
    }
    return n;
}

fn unsupported_count(src: &String) -> i32 {
    let mut g = parse(*src).unwrap();
    return count_unsupported(&generate(&mut g, &OPTS).diagnostics);
}

test "a single-alt lexer set_type action is emitted and not warned" {
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert src.contains("fn reset_actions"), "Lexer action-effect surface emitted";
    assert src.contains("fn apply_A_actions"), "per-rule replay fn emitted";
    assert src.contains("lx.set_type(TK_B);"), "translated action body emitted";
    assert src.contains("best_act"), "tournament tracks the winning action rule";
    assert unsupported_count(&"lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
") == 0, "an executed lexer action must not warn";
}

test "command-style lexer actions emit their fold and API" {
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
SK : 'a' { lx.skip() } ;
CH : 'c' { lx.set_channel(1) } ;
MO : 'm' { lx.more() } ;
B : 'b' ;
");
    assert src.contains("fn skip"), "skip API method emitted";
    assert src.contains("fn set_channel"), "set_channel API method emitted";
    assert src.contains("fn more"), "more API method emitted";
    assert src.contains("best_act_skip"), "skip folds through best_act_skip";
    assert src.contains("best_channel = lexer.act_channel;"), "channel folds into best_channel";
    assert src.contains("if lexer.act_more"), "more folds into best_more";
}

test "mode-op lexer actions emit MODE_ constants and the fold" {
    let src = gen_source(&"grammar L;
options { language = Wado; }
prog : (LT | GT | W)* ;
LT : '<' { lx.push_mode(MODE_INNER) } ;
W : [a-z]+ ;
mode INNER;
GT : '>' { lx.pop_mode() } ;
N : [0-9]+ ;
");
    assert src.contains("MODE_DEFAULT_MODE"), "default mode constant emitted";
    assert src.contains("MODE_INNER"), "named mode constant emitted";
    assert src.contains("fn push_mode"), "push_mode API emitted";
    assert src.contains("fn pop_mode"), "pop_mode API emitted";
    assert src.contains("if lexer.act_push_mode >= 0"), "push_mode folds into best_push_mode";
    assert src.contains("if lexer.act_pop_mode"), "pop_mode folds into best_pop_mode";
}

test "a modeless action grammar emits no mode-op API (gated)" {
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
");
    assert !src.contains("act_push_mode"), "no mode fields without modes";
    assert !src.contains("MODE_"), "no mode constants without modes";
}

test "every winner block resets best_act under an action grammar" {
    // Regression: a non-action rule / literal that wins after an action rule
    // must reset best_act (to -1), else it replays the losing action rule.
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
SHORT : [a-z] { lx.set_type(TK_RETYPED) } ;
LONG : [a-z] [a-z] ;
WS : ' ' -> skip ;
");
    // LONG carries no action; its winner block must still assign best_act = -1.
    assert src.contains("best_kind = TK_LONG; best_more = false; best_channel = 0; best_act = -1;")
        || src.contains("best_kind = TK_LONG;") && src.contains("best_act = -1;"), "non-action winner block must reset best_act";
}

test "an actionless grammar keeps no action machinery (byte-identical guard)" {
    let src = gen_source(&"lexer grammar L;
A : 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("reset_actions"), "no action-effect surface without actions";
    assert !src.contains("best_act"), "no best_act without actions";
    assert !src.contains("apply_"), "no apply fn without actions";
}

test "a predicate-only grammar keeps no action-replay machinery" {
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
KW : [a-z]+ { $text == \"cat\" }? ;
ID : [a-z]+ ;
WS : ' ' -> skip ;
");
    assert !src.contains("reset_actions"), "predicates need no action-effect surface";
    assert !src.contains("best_act"), "predicates need no best_act";
}

test "a Wado lexer body naming `this` is still reported, members or not" {
    // The identity translator analyses no host text, so `this` has nothing to
    // receive it whatever the grammar declares. Only java2wado resolves one.
    let src = &"lexer grammar L;
options { language = Wado; }
@members { count: i32 = 0 }
A : 'a' { this.count += 1 } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) > 0, "a Wado body naming `this` must be reported";
    assert !gen_source(src).contains("this.count"), "the untranslatable body must not be emitted";
}

test "a language=Java lexer grammar carries its @lexer::members" {
    let src = &"lexer grammar L;
@members { int nest = 0; }
A : 'a' { nest = nest + 1; } ;
WS : ' ' -> skip ;
";
    assert gen_source(src).contains("nest: i32"), "a Java lexer member field lands on the Lexer";
    assert unsupported_count(src) == 0, "a body reaching a Java lexer member must not warn";
}

test "a Java lexer member method takes the receiver its body needs" {
    // A predicate runs inside `try_<rule>(lx: &Lexer, ...)`, so only a `&self`
    // method is reachable from one. The receiver follows the body: `deep` reads,
    // `push` writes.
    let src = gen_source(&"lexer grammar L;
@members {
    int depth = 0;
    boolean deep() { return this.depth > 1; }
    void push() { this.depth = this.depth + 1; }
}
A : 'a' { this.push(); } ;
B : 'b' { this.deep() }? ;
WS : ' ' -> skip ;
");
    assert src.contains("fn deep(&self) -> bool"), "a reading member method takes &self";
    assert src.contains("fn push(&mut self)"), "a writing member method takes &mut self";
    assert src.contains("if !(lx.deep()) { return -1; }"), "the predicate calls the member through the lexer handle";
}

test "a lexer predicate calling a writing member method is refused" {
    // The tournament evaluates a predicate for every candidate rule, losers
    // included, so it holds `&Lexer` and a `&mut self` call cannot be emitted.
    // Both spellings reach the same method, so both are refused.
    let qualified = &"lexer grammar L;
@members {
    int depth = 0;
    boolean bump() { this.depth = this.depth + 1; return true; }
}
A : 'a' { this.bump() }? ;
WS : ' ' -> skip ;
";
    assert unsupported_count(qualified) == 1, "a mutating `this.m()` from a lexer predicate must be reported";
    assert !gen_source(qualified).contains("lx.bump()"), "the refused call must not be emitted";

    let bare = &"lexer grammar L;
@members {
    int depth = 0;
    boolean bump() { this.depth = this.depth + 1; return true; }
}
A : 'a' { bump() }? ;
WS : ' ' -> skip ;
";
    assert unsupported_count(bare) == 1, "a mutating bare `m()` from a lexer predicate must be reported";
    assert !gen_source(bare).contains("lx.bump()"), "the refused call must not be emitted";
}

test "a camelCase Java member field reads the same by either spelling" {
    // The declaration is snake_cased like a method name, so `this.nestLevel` and
    // the bare `nestLevel` resolve to the one field the struct carries.
    let src = &"lexer grammar L;
@members { int nestLevel = 0; }
A : 'a' { nestLevel = this.nestLevel + 1; } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "both spellings must resolve";
    let out = gen_source(src);
    assert out.contains("nest_level: i32"), "the field is declared snake_cased";
    assert out.contains("lx.nest_level = lx.nest_level + 1;"), `both reads agree: ${out}`;
}

test "an undeclared Java lexer field is reported by either spelling" {
    // A lexer body reaches only what `@members` declares. Emitting `lx.<name>`
    // for a name the block never declared would put a field on the `Lexer` that
    // does not exist, so `this.<x>` is refused exactly as the bare `x` is.
    let qualified = &"lexer grammar L;
@members { int depth = 0; }
A : 'a' { this.missing = 1; } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(qualified) == 1, "an undeclared `this.<field>` must be reported";
    assert !gen_source(qualified).contains("lx.missing"), "the refused read must not be emitted";

    let bare = &"lexer grammar L;
@members { int depth = 0; }
A : 'a' { missing = 1; } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(bare) == 1, "an undeclared bare field must be reported";
}

test "a lexer predicate that prints is reported, not wired to the sink" {
    // A predicate is evaluated for every candidate rule, losers included, so
    // printing from one would emit output the tournament discards.
    assert unsupported_count(&"lexer grammar L;
A : 'a'+ { System.out.println(\"x\") }? ;
WS : ' ' -> skip ;
") == 1, "a printing lexer predicate must surface UnsupportedAction";
}

test "a Java lexer body can declare and read its own local" {
    let src = gen_source(&"lexer grammar L;
A : 'a'+ { int n = 1; System.out.println(\"n=\" + n); } ;
WS : ' ' -> skip ;
");
    assert src.contains("let mut n: i32 = 1;"), "the local is emitted";
    assert src.contains("lx.emit(`n=${n}"), "a later statement reads it";
}

test "a language=Java lexer body prints through the lexer output sink" {
    let src = gen_source(&"lexer grammar L;
A : 'a' {System.out.println(getText());} ;
WS : ' ' -> skip ;
");
    assert src.contains("fn emit"), "the lexer output sink is emitted";
    assert src.contains("lx.emit("), "System.out.println becomes a sink write";
    assert src.contains("ts.output = lexer.act_output;"), "the sink is threaded onto the token stream";
}

test "an unmodelled ANTLR lexer field is a loud diagnostic, not broken code" {
    // `_hitEOF` is a recognizer field Gale does not model. Passing it through
    // verbatim would emit Wado referencing nothing, so the body must be dropped
    // and reported instead.
    let src = &"lexer grammar L;
A : 'a'+ { _hitEOF }? ;
NL : '\n' ;
";
    assert unsupported_count(src) == 1, "an unmodelled lexer field must surface UnsupportedAction";
    assert !gen_source(src).contains("_hitEOF"), "the untranslatable body must not be emitted";
}

test "a nested-group lexer action runs in the arm that won" {
    // The action sits inside a `( ... )` group. The replay re-selects the arm
    // the match took, then runs that arm's actions in place — so it executes,
    // and nothing warns.
    let src = &"lexer grammar L;
options { language = Wado; }
A : ('a' { lx.set_type(TK_B) } | 'c') ;
B : 'b' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "a nested-group action no longer warns";
    let out = gen_source(src);
    assert out.contains("lx.set_type(TK_B);"), "the nested action is emitted";
    // Selection before replay is what keeps the losing arm silent.
    assert out.contains("sel_alt_"), "the replay selects the winning arm first";
}

test "a predicate in an ATN-class lexer rule is refused, not silently dropped" {
    // The rule routes to `latn_match`, and the lexer ATN has no predicate
    // transition, so without a refusal it matches input the predicate rejects.
    let src = &"lexer grammar L;
options { language = Wado; }
CMT : '/*' ( CMT | . )+? { false }? '*/' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 1, "an ATN-class rule's predicate must surface UnsupportedAction";
}

test "an ATN-class lexer rule with no predicate stays byte-identical" {
    let src = &"lexer grammar L;
options { language = Wado; }
CMT : '/*' ( CMT | . )+? '*/' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "the refusal must not fire on a predicate-free ATN-class rule";
}

test "an unresolvable lexer $-attribute is reported, not a generator panic" {
    // Staging runs where a `ctx` is in hand; emit has none to warn through.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type($nope) } ;
B : 'b' ;
";
    assert unsupported_count(src) == 1, "an unresolvable $-attribute must surface UnsupportedAction";
    assert !gen_source(src).contains("$nope"), "the untranslatable body must not be emitted";
}

test "a lexer action under a Repeat runs once per iteration" {
    // The replay probes each iteration match-only before running it with the
    // action, so an iteration that does not match leaves no trace.
    let src = &"lexer grammar L;
options { language = Wado; }
A : ('a' { lx.set_type(TK_B) })+ ;
B : 'b' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "an action under a plain repeat no longer warns";
    let out = gen_source(src);
    assert out.contains("rep_probe_"), "each replayed iteration is probed match-only first";
    assert out.contains("lx.set_type(TK_B);"), "the action is emitted inside the replayed loop";
}

test "the lexer $-attributes resolve to the match window and the commit latches" {
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
A : 'a'+ { if $text == \"aa\" { $type = TK_B } } ;
C : 'c' { $channel = 1 } ;
D : 'd' { if $index - start == 1 && $pos > 0 { $channel = 2 } } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert src.contains("LexerSlice::new(chars, start, pos).to_string() == \"aa\""), "$text is the matched slice";
    assert src.contains("lx.act_type = TK_B"), "$type writes the type latch";
    assert src.contains("lx.act_channel = 1"), "$channel writes the channel latch";
    assert src.contains("pos - start == 1"), "$index is the match cursor";
    assert src.contains("char_pos_in_line(chars, pos) > 0"), "$pos is the cursor's column";
}

test "$mode writes the mode latch, and needs a grammar that has one" {
    let with_modes = &"lexer grammar L;
options { language = Wado; }
A : 'a' { $mode = MODE_TAIL } ;
mode TAIL;
B : 'b' ;
";
    assert unsupported_count(with_modes) == 0, "$mode in a mode grammar must not warn";
    assert gen_source(with_modes).contains("lx.act_set_mode = MODE_TAIL"), "$mode writes the mode latch";

    let no_modes = &"lexer grammar L;
options { language = Wado; }
A : 'a' { $mode = 1 } ;
B : 'b' ;
";
    assert unsupported_count(no_modes) == 1, "$mode with no mode to switch to must be reported";
}

test "$mode reads the mode the token is being matched in" {
    // The set latch is the pending command (-1 until one is issued), so a read
    // of it would answer -1 rather than the current mode. It has its own field,
    // seeded per token from the tokenize loop's `current_mode`.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' { if $mode == 0 { $mode = MODE_TAIL } } ;
mode TAIL;
B : 'b' ;
";
    assert unsupported_count(src) == 0, "reading $mode must not warn";
    let out = gen_source(src);
    assert out.contains("lx.mode() == 0"), "the read goes through the current-mode reader";
    assert out.contains("lx.act_set_mode = MODE_TAIL"), "the assignment still writes the command latch";
    assert out.contains("lexer.reset_actions(best_kind, best_channel, mode_stack.len(), current_mode);"), "the current mode is seeded per token";
    assert out.contains("self.act_mode = m;"), "a mode command moves what a later read answers";
    assert out.contains("assert self.act_mode >= 0,"), "pop_mode's restore target is not on the Lexer, and says so";
}

test "a $mode read only a predicate asks for turns nothing on" {
    // The predicate is refused (a latch answers nothing during the tournament),
    // so the read never reaches the field — which must therefore not be emitted.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' { $mode == 0 }? ;
mode TAIL;
B : 'b' ;
";
    assert unsupported_count(src) == 1, "a latch read from a lexer predicate must be reported";
    let out = gen_source(src);
    assert !out.contains("fn mode(&self)"), "no current-mode reader for a read that is refused";
    assert !out.contains("act_mode ="), "and no field to seed";
}

test "$mode cannot be read and assigned in one site" {
    // The read and the write are different fields, so `+=` has no single
    // expression to become.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' { $mode += 1 } ;
mode TAIL;
B : 'b' ;
";
    assert unsupported_count(src) == 1, "a compound assignment to $mode must be reported";
}

test "a lexer attribute over the match window is not assignable" {
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' { $text = \"b\" } ;
B : 'b' ;
";
    assert unsupported_count(src) == 1, "$text is a read of the match window";
}

test "a keyword-shaped rule carrying a body is matched, not reclassified" {
    // The keyword classifier runs behind a carrier's match and rewrites only
    // `best_kind`: the replay would dispatch the carrier's actions and never
    // this rule's, and the carrier's match already settled what the predicate
    // would have had a say in. So such a rule keeps its own matcher.
    let with_action = gen_source(&"grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' { lx.set_channel(1) } ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
");
    assert with_action.contains("fn try_A("), "an action-carrying keyword keeps its own matcher";
    assert with_action.contains("apply_A_actions(&mut lexer, start, best_end);"), "so its actions are dispatched";

    let with_pred = gen_source(&"grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' { start == 0 }? ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
");
    assert with_pred.contains("fn try_A("), "a predicate-carrying keyword keeps its own matcher";

    // The shortcut still applies to the plain shape it was written for.
    let plain = gen_source(&"grammar T;
options { language = Wado; }
r : A ID ;
A : 'A' ;
ID : [a-zA-Z]+ ;
WS : [ \\t\\n\\r]+ -> skip ;
");
    assert !plain.contains("fn try_A("), "a bare keyword is still reclassified from its carrier";
    assert plain.contains("fn classify_keyword("), "by the classifier";
}

test "a lexer predicate cannot reach the commit latches" {
    // A predicate is evaluated for every candidate rule, losers included, so it
    // settles nothing about the token that wins.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a'+ { $type == 1 }? ;
B : 'b' ;
";
    assert unsupported_count(src) == 1, "a latch read from a lexer predicate must be reported";
}

test "a lexer action under a lookahead-aware repeat runs once per accepted iteration" {
    // `~'b'` can eat the `'c'` the suffix needs, so the loop scans forward and
    // rewinds to the last position the suffix could start at. The replay
    // re-walks exactly the iterations that scan kept, not the ones it tried.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' (~'b' { lx.set_type(TK_B) })+ 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "an action under a lookahead-aware repeat no longer warns";
    let out = gen_source(src);
    assert out.contains("lx.set_type(TK_B);"), "the action is emitted";
    assert out.contains("while pos < accept_"), "the replay stops at the accept the scan settled on";
}

test "a replay's decision probe evaluates the predicates the match evaluated" {
    // The non-greedy exit try decides which iteration ends the loop. Emitting it
    // without the predicate the match saw would exit earlier, running the
    // alternative's actions at a cursor the match never stopped at.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' .*? { pos > start + 2 }? 'c' { lx.set_type(TK_B) } ;
B : 'b' ;
";
    assert unsupported_count(src) == 0, "a predicate after a non-greedy repeat must not warn";
    let out = gen_source(src);
    // Twice: once in `try_A`, once in the replay's exit try.
    assert count_occurrences(&out, &"pos > start + 2") == 2, `the replay probe keeps the predicate: ${out}`;
}

/// How many times `needle` appears in `haystack`.
fn count_occurrences(haystack: &String, needle: &String) -> i32 {
    let mut n = 0;
    let mut pos = 0;
    loop {
        let rest = haystack.substr_bytes(pos, haystack.len());
        let found = rest.find(*needle);
        if found matches { None } {
            return n;
        }
        n += 1;
        pos += found.unwrap() + needle.len();
    }
}

test "a lexer action under a non-greedy repeat runs once per iteration" {
    // The exit probe stays match-only on the replay path, so the rest's actions
    // run once — from the iteration that ended the loop.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' (~'b' { lx.set_type(TK_B) })*? 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "an action under a non-greedy repeat no longer warns";
    assert gen_source(src).contains("lx.set_type(TK_B);"), "the action is emitted";
}

test "an action after a restructured repeat keeps its place in the alt" {
    // The lookahead-aware emit consumes the suffix itself, so an action written
    // between the repeat and the alt's end travels with the suffix or is lost.
    let src = &"lexer grammar L;
options { language = Wado; }
A : 'a' ~('b')+ { lx.set_type(TK_B) } 'c' ;
B : 'b' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "a mid-alt action after a restructured repeat must not warn";
    assert gen_source(src).contains("lx.set_type(TK_B);"), "the action is emitted";
}

test "a multi-alt lexer rule runs each alt's top-level action (no warn)" {
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_X) } | 'c' { lx.set_type(TK_Y) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert src.contains("lx.set_type(TK_X);"), "alt 0 action emitted";
    assert src.contains("lx.set_type(TK_Y);"), "alt 1 action emitted";
    assert unsupported_count(&"lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_X) } | 'c' { lx.set_type(TK_Y) } ;
B : 'b' ;
WS : ' ' -> skip ;
") == 0, "multi-alt top-level actions must not warn";
}

test "a multi-alt rule around a restructured repeat replays instead of running flat" {
    // The lookahead-aware repeat used to force the whole rule onto the flat
    // emit — every alt's actions at the end of the match, the arm picked by a
    // `winning_alt_` helper. The replay now walks this shape, so the helper is
    // gone and each alt runs its own actions in place.
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
A : 'a' ~('b')+ 'c' { lx.set_type(TK_X) } | 'd' { lx.set_type(TK_Y) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn winning_alt_A"), "the replay selects the arm itself";
    assert src.contains("sel_alt_"), "the replay selects the winning arm match-only first";
}

test "an action inside an inlined fragment runs, and is not warned as unhandled" {
    // The replay walks into a non-recursive fragment, so the fragment's action
    // runs even though the referencing rule carries none of its own. The
    // run-set and the warn-set must agree about that.
    let src = &"lexer grammar L;
options { language = Wado; }
A : F 'z' ;
fragment F : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "an inlined fragment's action is not unhandled";
    let out = gen_source(src);
    assert out.contains("fn apply_A_actions"), "the referencing rule gets a replay fn";
    assert out.contains("lx.set_type(TK_B);"), "the fragment's action is emitted";
}

test "a superClass action op runs from the replay, not from the match fn" {
    // The action op is the only base call, so `try_A` — which never emits an
    // action — stays effect-free and only the replay carries `with B`.
    let src = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert src.contains("fn hit(view: LexerView, lx: &mut Lexer);"), "an action op returns unit and reaches the lexer";
    assert src.contains("fn apply_A_actions(lx: &mut Lexer, start: i32, end: i32) with (B, stores[lx])"), "the replay carries the base effect";
    assert src.contains("B::hit(LexerView { chars, start, pos }, lx);"), "the action op is called from the replay";
    assert src.contains("fn try_A(chars: &List<char>, start: i32) -> i32 {"), "a match fn with no predicate op stays effect-free";
}

test "a superClass action op reaches the lexer mode state" {
    // The depth is a tokenize-loop local, so it rides on the `Lexer`.
    let src = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert src.contains("fn mode_depth(&self) -> i32 {"), "the base can read the mode-stack depth";
    assert src.contains("lexer.reset_actions(best_kind, best_channel, mode_stack.len());"), "the depth is seeded per token";
    assert src.contains("self.act_mode_depth += 1;"), "push_mode keeps the depth the base reads consistent";
    assert src.contains("self.act_mode_depth -= 1;"), "pop_mode keeps the depth the base reads consistent";
}

test "a base method used as both a predicate and an action is refused" {
    let src = &"lexer grammar L;
options { superClass = B; language = Wado; }
A : { this.m() }? 'a' { this.m() } ;
WS : ' ' -> skip ;
";
    // Two reports: the refused base, and the action that can no longer run.
    assert unsupported_count(src) == 2, "a mixed-role base method must be reported";
    let out = gen_source(src);
    assert !out.contains("pub interface B {"), "a refused base is not wired";
}

test "an action may issue at most one mode command per token" {
    let commands_only = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert commands_only.contains("assert self.act_push_mode < 0 && !self.act_pop_mode && self.act_set_mode < 0,"), "each mode command guards against a second one";
    // Every command passes that guard, so a grammar whose only mode writes are
    // commands has the invariant covered — it must not pay for it again per
    // token.
    assert !commands_only.contains("<= 1, \"a lexer action may issue at most one mode command per token\""), "no second check where every write passes a command";

    // A `$mode` assignment reaches the set latch without passing one, so there
    // the commit repeats the invariant over the latches themselves.
    let assigns_mode = gen_source(&"lexer grammar L;
options { language = Wado; }
A : 'a' { $mode = MODE_TAIL } ;
mode TAIL;
B : 'b' ;
");
    assert assigns_mode.contains("<= 1, \"a lexer action may issue at most one mode command per token\""), "the commit guards the latches a $mode assignment can reach";
}

test "the current-mode read is emitted only for a grammar that asks for it" {
    let unread = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : '[' { this.hit() } ;
WS : ' ' -> skip ;
mode Arg;
C : ']' ;
");
    assert !unread.contains("fn mode(&self)"), "no current-mode read where no body reads one";
    assert !unread.contains("act_mode ="), "and no field to seed";
    assert unread.contains("fn mode_depth(&self) -> i32 {"), "the depth a base branches on stays";
}

test "the emit hook fires once per emitted token, never for a skipped one" {
    let src = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert src.contains("if !is_skip"), "a skipped token never reaches the base";
    assert src.contains(
        "best_kind = B::emit(LexerView { chars: &lexer.chars, start: tok_start, pos: best_end }, best_kind, best_channel);",
    ), "the hook takes the token span and may retype it";
}

test "a predicate-only base gets the emit hook without the channel machinery" {
    // No action and no `-> channel` rule means no `best_channel` local.
    let src = gen_source(&"lexer grammar L;
options { superClass = B; }
A : { this.ok() }? 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("best_channel"), "the channel machinery stays off";
    assert src.contains(
        "best_kind = B::emit(LexerView { chars: &lexer.chars, start: tok_start, pos: best_end }, best_kind, 0);",
    ), "the hook takes the default channel";
}

test "a base whose only override is the emit hook is still wired" {
    // No `this.<m>()` call anywhere, so the grammar contributes zero ops.
    let src = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' ;
WS : ' ' -> skip ;
");
    assert src.contains("pub interface B {"), "a hook-only base still gets an interface";
    assert src.contains("fn emit(view: LexerView, ty: i32, channel: i32) -> i32 {"), "the hook is declared";
    assert src.contains("::emit(LexerView"), "the tokenize loop calls it";
    assert src.contains("pub fn tokenize(input: &String) -> TokenStream with B"), "tokenize carries the effect";
}

test "a grammar with no base has no emit hook" {
    let src = gen_source(&"lexer grammar L;
options { language = Wado; }
A : 'a' { lx.set_type(TK_B) } ;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert !src.contains("::emit(LexerView"), "no base, no lifecycle call";
}

test "a modeless grammar keeps the mode-state surface off" {
    let src = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn mode_depth(&self)"), "no modes, no mode-state reads";
    assert src.contains("lexer.reset_actions(best_kind, best_channel);"), "a modeless reset takes no mode state";
}

test "a superClass grammar's host-code action body is reported, not emitted" {
    // java2wado is carved out for a superClass grammar, so a Java body only runs
    // when the base-call rewrite alone turns it into Wado. This one does not.
    let src = &"lexer grammar L;
options { superClass = B; }
A : 'a' { int n = 1; this.hit(); } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 1, "an untranslatable superClass action body must be reported";
    let out = gen_source(src);
    assert !out.contains("fn apply_A_actions"), "no replay is emitted for an action that cannot run";
    assert out.contains("pub interface B {"), "the base stays wired for its other ops";
}

test "a superClass predicate-only grammar keeps its action surface off" {
    // RustLexer's shape: base calls, but no `{ ... }` action anywhere. Nothing
    // gains the action machinery.
    let src = gen_source(&"lexer grammar L;
options { superClass = B; }
A : { this.ok() }? 'a' ;
WS : ' ' -> skip ;
");
    assert !src.contains("fn apply_"), "a predicate-only base emits no replay fn";
    assert !src.contains("act_type"), "a predicate-only base emits no action-effect surface";
}

test "a superClass call's literal arguments settle its operation's signature" {
    let src = &"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(2) } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 0, "a literal argument needs no other signature source";
    let out = gen_source(src);
    assert out.contains("fn set_channel(view: LexerView, lx: &mut Lexer, a0: i32);"), out;
    assert out.contains("B::set_channel(LexerView { chars, start, pos }, lx, 2)"), out;
}

test "a superClass call whose argument has no evident type is refused" {
    // The interface would have to invent the type, so wiring the base would run
    // `set_channel` against a signature nothing settled. Refuse and say so.
    let src = &"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(n + 1) } ;
WS : ' ' -> skip ;
";
    // Two reports: the refused base, and the action that can no longer run.
    assert unsupported_count(src) == 2, "an unsettled base call must be reported";
    let out = gen_source(src);
    assert !out.contains("pub interface B"), "no interface is emitted for a base Gale cannot represent";
    assert !out.contains("B::set_channel"), "the call must not be emitted against a guessed signature";
    assert !out.contains("this.setChannel"), "a body naming `this` must not reach the generated module";
}

test "an expression that merely starts and ends with a quote is not a literal" {
    let src = &"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.setChannel(\"x\" + y + \"z\") } ;
WS : ' ' -> skip ;
";
    assert unsupported_count(src) == 2, "concatenation settles no signature either";
    let out = gen_source(src);
    assert !out.contains("pub interface B"), "no interface for a base whose call takes an unrepresentable argument";
    assert !out.contains("+ y +"), "the host expression must not be spliced into the call";
}

test "a zero-argument base call is still wired" {
    let out = gen_source(&"lexer grammar L;
options { superClass = B; language = Wado; }
A : 'a' { this.hit() } ;
WS : ' ' -> skip ;
");
    assert out.contains("pub interface B"), "the argument-free base stays wired";
}
