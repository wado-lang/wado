use { ParserRule } from "./ir.wado";
use { EmitContext } from "./emit_context.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { GenSettings } from "./gen_settings.wado";
use { RuleFollow } from "./follow_env.wado";
use { TableRegistry } from "./table_registry.wado";
use { ParserPlan } from "./parser_plan.wado";
use { Diagnostics, admits_is_untestable, admits_or_everything, admits_or_untestable } from "./gir.wado";

fn mk_ctx() -> EmitContext {
    let rules: List<ParserRule> = [];
    return EmitContext::new(
        GrammarAnalysis::new(&rules),
        GenSettings {},
        RuleFollow::unknown(),
        TableRegistry::new(),
        Diagnostics {},
        ParserPlan {},
    );
}

fn ids(ctx: &mut EmitContext, names: List<String>) -> List<i32> {
    return ctx.analysis.token_ids_of(&names);
}

/// The id a single-depth mask over `kind` interns as.
fn intern_mask(ctx: &mut EmitContext, kind: String) -> i32 {
    let kinds = ids(ctx, [kind]);
    let Some(id) = ctx.tables.intern_follow_mask([ctx.analysis.canonical_ids(kinds)]) else {
        panic("a constrained mask interns");
    };
    return id;
}

test "an empty set is not a condition until the site says what it admits" {
    // The set does not carry the answer; the site does.
    let mut ctx = mk_ctx();
    let empty: List<i32> = [];
    // Both render `true`; they are still not the same answer. One admits every
    // token and may keep its place among the arms, the other cannot be decided
    // and belongs after every arm that can.
    let exact = admits_or_everything(&empty);
    let undecidable = admits_or_untestable(&empty);
    assert ctx.admits_check_str(&exact, "k") == "true", "a wildcard admits every token";
    assert ctx.admits_check_str(&undecidable, "k") == "true", "an untestable arm has no test to render";
    assert !admits_is_untestable(&exact), "a wildcard decides; ordering it last loses the lowest-alternative rule";
    assert admits_is_untestable(&undecidable), "an arm with no first set does not decide";
}

test "a non-empty set renders the same either way" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO"]);
    let narrows = ctx.admits_check_str(&admits_or_everything(&toks), "k");
    let selects = ctx.admits_check_str(&admits_or_untestable(&toks), "k");
    assert narrows == "k == TK_FOO", `expected "k == TK_FOO", got "${narrows}"`;
    assert selects == narrows, "which reading an empty set takes cannot change a non-empty one";
}

test "kind_check_str: single token uses '==' not 'matches'" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO"]);
    let s = ctx.kind_check_str(&toks, "kind");
    assert s == "kind == TK_FOO", `expected "kind == TK_FOO", got "${s}"`;
    // Single-token check must NOT intern (no helper would be emitted).
    assert ctx.tables.kind_sets().is_empty(), "single-token check should not intern";
}

test "kind_check_str: multi-token uses helper call" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO", "TK_BAR"]);
    let s = ctx.kind_check_str(&toks, "k");
    assert s == "_kind_set_0(k)", `expected helper call, got "${s}"`;
    assert ctx.tables.kind_sets().len() == 1;
}

test "intern_kind_set: same set returns same id (insertion order)" {
    let mut ctx = mk_ctx();
    let ab = ids(&mut ctx, ["TK_A", "TK_B"]);
    let cd = ids(&mut ctx, ["TK_C", "TK_D"]);
    let id1 = ctx.intern_kind_set(&ab);
    let id2 = ctx.intern_kind_set(&cd);
    let id1_again = ctx.intern_kind_set(&ab);
    assert id1 == 0;
    assert id2 == 1;
    assert id1_again == id1, `expected reuse of id ${id1}, got ${id1_again}`;
}

test "intern_kind_set: order-independent (sets are unordered)" {
    let mut ctx = mk_ctx();
    let abc = ids(&mut ctx, ["TK_A", "TK_B", "TK_C"]);
    let cab = ids(&mut ctx, ["TK_C", "TK_A", "TK_B"]);
    let bca = ids(&mut ctx, ["TK_B", "TK_C", "TK_A"]);
    let id1 = ctx.intern_kind_set(&abc);
    let id2 = ctx.intern_kind_set(&cab);
    let id3 = ctx.intern_kind_set(&bca);
    assert id1 == id2 && id2 == id3, `permutations must collapse: ${id1} ${id2} ${id3}`;
    assert ctx.tables.kind_sets().len() == 1;
}

test "intern_kind_set: duplicates within a set are deduplicated" {
    let mut ctx = mk_ctx();
    let with_dup = ids(&mut ctx, ["TK_A", "TK_B", "TK_A"]);
    let no_dup = ids(&mut ctx, ["TK_A", "TK_B"]);
    let id1 = ctx.intern_kind_set(&with_dup);
    let id2 = ctx.intern_kind_set(&no_dup);
    assert id1 == id2, "duplicate-tolerant interning";
    let entries = ctx.tables.kind_sets();
    assert entries.len() == 1;
    assert entries[0].tokens.len() == 2, `expected 2 unique tokens, got ${entries[0].tokens.len()}`;
}

test "intern_kind_set: stored tokens are sorted by name" {
    let mut ctx = mk_ctx();
    let unsorted = ids(&mut ctx, ["TK_C", "TK_A", "TK_B"]);
    ctx.intern_kind_set(&unsorted);
    let entries = ctx.tables.kind_sets();
    assert entries.len() == 1;
    let toks = ctx.analysis.token_names_of(&entries[0].tokens);
    assert toks[0] == "TK_A";
    assert toks[1] == "TK_B";
    assert toks[2] == "TK_C";
}

test "a table reference belongs to the innermost function frame, else to the root" {
    let mut ctx = mk_ctx();
    let outer_mask = intern_mask(&mut ctx, "TK_X");
    let inner_mask = intern_mask(&mut ctx, "TK_Y");
    ctx.follow_mask_ref(outer_mask);
    ctx.cursor.begin_ref_frame();
    ctx.cursor.begin_ref_frame();
    assert ctx.follow_mask_ref(inner_mask) == "FOLLOW_MASK_1";
    let inner = ctx.cursor.end_ref_frame();
    let outer = ctx.cursor.end_ref_frame();
    assert inner.contains("FOLLOW_MASK_1") && inner.len() == 1;
    assert outer.len() == 0;
    let root = ctx.cursor.take_root_refs();
    assert root.contains("FOLLOW_MASK_0") && root.len() == 1;
}

test "kind_sets: returns entries in insertion order" {
    let mut ctx = mk_ctx();
    let xy = ids(&mut ctx, ["TK_X", "TK_Y"]);
    let ab = ids(&mut ctx, ["TK_A", "TK_B"]);
    let mn = ids(&mut ctx, ["TK_M", "TK_N"]);
    ctx.intern_kind_set(&xy);
    ctx.intern_kind_set(&ab);
    ctx.intern_kind_set(&mn);
    let entries = ctx.tables.kind_sets();
    assert entries.len() == 3;
    assert entries[0].id == 0;
    assert entries[1].id == 1;
    assert entries[2].id == 2;
    // First-seen set should come first regardless of token order.
    assert ctx.analysis.token_name(entries[0].tokens[0]) == "TK_X";
    assert ctx.analysis.token_name(entries[1].tokens[0]) == "TK_A";
    assert ctx.analysis.token_name(entries[2].tokens[0]) == "TK_M";
}

test "kind_negate_check_str: single token uses '!='" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO"]);
    let s = ctx.kind_negate_check_str(&toks, "k");
    assert s == "k != TK_FOO", `expected "k != TK_FOO", got "${s}"`;
    assert ctx.tables.kind_sets().is_empty();
}

test "kind_negate_check_str: multi-token uses negated helper" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_A", "TK_B"]);
    let s = ctx.kind_negate_check_str(&toks, "k");
    assert s == "!_kind_set_0(k)", `expected negated helper, got "${s}"`;
    assert ctx.tables.kind_sets().len() == 1;
}

test "kind_negate_check_str: shares ids with kind_check_str" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_A", "TK_B"]);
    let pos = ctx.kind_check_str(&toks, "k");
    let neg = ctx.kind_negate_check_str(&toks, "k");
    // Both reference the same helper id, just with/without the leading `!`.
    assert pos == "_kind_set_0(k)";
    assert neg == "!_kind_set_0(k)";
    assert ctx.tables.kind_sets().len() == 1, "positive and negative must share";
}
