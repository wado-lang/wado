//! Attribute-reference scanner for action / predicate bodies.
//!
//! ANTLR4 `$x` / `$x.member` attribute references are ANTLR semantics, not
//! host-language semantics (see `action.md`, "Attribute resolution"), so
//! Gale scans the opaque fragment for them itself, independent of the
//! action language. This module is the raw lexical layer: it locates every
//! `$ident(.ident)?` reference and its span within the fragment, skipping
//! string literals (`'...'`, `"..."`) and comments (`//`, `/* */`) so a
//! `$` inside host text is never mistaken for a reference. Mapping a raw
//! reference onto a rule's attribute environment (labels, args, returns,
//! specials) is a later resolution step that consumes these.

use {
    scan_string,
    scan_line_comment,
    scan_block_comment,
    scan_template,
    ident_end,
    is_id_start_char,
} from "./g4/scan.wado";
use { char_at } from "./runtime/lex.wado";

/// A raw `$name` or `$name.member` attribute reference located in a
/// fragment, with its byte span within the fragment text (`start` points
/// at the `$`, `end` is one past the last byte of the reference).
pub struct AttrRef {
    pub name: String,
    /// The `.member` suffix (`text`, `int`, a `returns` field, ...), or
    /// `null` for a bare `$name`. Only the first `.ident` is captured;
    /// deeper host access chains are resolved by the substitution layer.
    pub member: Option<String> = null,
    pub start: i32,
    pub end: i32,
}

/// Locate every `$ident(.ident)?` reference in `body`, in source order.
/// String literals and comments are skipped so their contents never yield
/// a reference. Backtick template strings are skipped too, EXCEPT their
/// `${ ... }` interpolation regions, where `$refs` are Wado expressions to
/// substitute — a literal `$` in template text is not a reference. A lone
/// `$` not followed by an identifier is host text.
pub fn find_attr_refs<S: AsStrSlice>(body: S) -> List<AttrRef> {
    let src = body.as_str_slice();
    let mut out: List<AttrRef> = [];
    scan_refs(&src, 0, src.len(), &mut out);
    return out;
}

fn scan_refs(src: &StrSlice, start: i32, end: i32, out: &mut List<AttrRef>) {
    let mut i = start;
    while i < end {
        let b = src.byte_at(i);
        if b == b'\'' || b == b'"' {
            i = scan_string(src, i);
            continue;
        }
        if b == b'`' {
            // Only the holes are code; the template's text never names a reference.
            let [after, holes] = scan_template(src, i, end);
            for let h of &holes {
                scan_refs(src, h.0, h.1, out);
            }
            i = after;
            continue;
        }
        if b == b'/' && i + 1 < end && src.byte_at(i + 1) == b'/' {
            i = scan_line_comment(src, i);
            continue;
        }
        if b == b'/' && i + 1 < end && src.byte_at(i + 1) == b'*' {
            i = scan_block_comment(src, i);
            continue;
        }
        if let Some(r) = attr_ref_at(src, i, end) {
            i = r.end;
            out.push(r);
            continue;
        }
        i += 1;
    }
}

/// The `$ident(.ident)?` reference starting at `pos`, or `null` where `pos`
/// holds no `$` followed by an identifier.
pub fn attr_ref_at(src: &StrSlice, pos: i32, end: i32) -> Option<AttrRef> {
    let [name_end, ref_end] = attr_ref_span(src, pos, end)?;
    let name = src.slice(pos + 1, name_end).to_string();
    if ref_end == name_end {
        return Option::Some(AttrRef { name, start: pos, end: name_end });
    }
    let member = Option::Some(src.slice(name_end + 1, ref_end).to_string());
    return Option::Some(AttrRef { name, member, start: pos, end: ref_end });
}

/// `attr_ref_at`'s name end and reference end, without copying either part.
pub fn attr_ref_span(src: &StrSlice, pos: i32, end: i32) -> Option<[i32, i32]> {
    if !(src.byte_at(pos) == b'$' && pos + 1 < end && is_id_start_char(char_at(src, pos + 1))) {
        return null;
    }
    let name_end = ident_end(src, pos + 1, end);
    if name_end + 1 < end && src.byte_at(name_end) == b'.' && is_id_start_char(char_at(src, name_end + 1)) {
        return Option::Some([name_end, ident_end(src, name_end + 1, end)]);
    }
    return Option::Some([name_end, name_end]);
}
