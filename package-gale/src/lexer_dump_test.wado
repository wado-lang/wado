//! Tests for `render_lexer_dump(Grammar) -> String`.
//!
//! Each test is a minimal `.g4` shaped to force one emit strategy, asserted by
//! substring so spacing stays free to change. The point is that the report
//! names the branch the lexer emitter took and why the cheaper one was not
//! available — the question `gale dump --lexer` exists to answer.

use {
    merge_grammars,
    synthesize_implicit_tokens,
    normalize_caches,
    canonicalize_empty_alt_groups,
    unwrap_labeled_transparent_groups,
} from "./ir.wado";
use { render_lexer_dump } from "./lexer_dump.wado";
use { parse } from "./g4/parser.wado";

/// Run the front-end the way `cmd_dump` does, then render the lexer report.
fn lexer_dump(input: &String) -> String {
    let mut merged = merge_grammars([parse(*input).unwrap()]);
    synthesize_implicit_tokens(&mut merged);
    canonicalize_empty_alt_groups(&mut merged);
    unwrap_labeled_transparent_groups(&mut merged);
    normalize_caches(&mut merged);
    return render_lexer_dump(&merged);
}

fn str_contains(haystack: &String, needle: &String) -> bool {
    let h_len = haystack.len();
    let n_len = needle.len();
    if n_len > h_len {
        return false;
    }
    for let mut i = 0; i <= h_len - n_len; i += 1 {
        let mut found = true;
        for let mut j = 0; j < n_len; j += 1 {
            if haystack.get_byte_unchecked(i + j) != needle.get_byte_unchecked(j) {
                found = false;
                break;
            }
        }
        if found {
            return true;
        }
    }
    return false;
}

test "lexer dump names the grammar and summarizes strategies" {
    let report = lexer_dump(&"grammar T;
r : ID ;
ID : [a-z]+ ;");

    assert str_contains(&report, &"grammar T (lexer)"), report;
    assert str_contains(&report, &"rule ID — matcher try_ID"), report;
    assert str_contains(&report, &"strategies:"), report;
    assert str_contains(&report, &"routes: matcher 1"), report;
}

test "lexer dump reports a tail alternation as maximal munch" {
    // `('0' | [1-9] [0-9]*)` — the arms reach different lengths, and nothing
    // follows, so every arm is scanned and the longest wins.
    let report = lexer_dump(&"grammar T;
r : INT ;
INT : '0' | [1-9] [0-9]* ;");

    assert str_contains(&report, &"maximal munch"), report;
    assert str_contains(&report, &"maximal munch 1"), report;
}

test "lexer dump reports equal-length arms as first-match" {
    // Both arms consume exactly one char, so longest and first-match coincide
    // and the cheaper emit stays byte-identical.
    let report = lexer_dump(&"grammar T;
r : AB ;
AB : 'a' | 'b' ;");

    assert str_contains(&report, &"first-match: every arm consumes the same fixed length"), report;
}

test "lexer dump reports a called rule's alternation as not-tail" {
    // `B` is entered from `A` with `'z'` still to consume, so its body
    // alternation cannot take maximal munch however long an arm reaches.
    let report = lexer_dump(&"grammar T;
r : A ;
A : B 'z' ;
B : 'a' | 'ab' ;");

    assert str_contains(&report, &"first-match: not in tail position"), report;
}

test "lexer dump reports a greedy repeat whose inner cannot eat the suffix" {
    // `~'*'` is provably disjoint from the `'*'`-led suffix, so the plain loop
    // already stops where the suffix must start.
    let report = lexer_dump(&"grammar T;
r : CMT ;
CMT : '/*' ~'*'* '*/' ;");

    assert str_contains(&report, &"repeat ~'*'* then '*/' — plain loop: the inner cannot eat the suffix's first char"), report;
    assert str_contains(&report, &"plain 1, lookahead-aware 0"), report;
}

test "lexer dump reports a lookahead-aware greedy repeat" {
    // `~('b')+` can eat the `'c'`... it cannot; `.` can. A `.`-led greedy
    // repeat with a suffix is exactly the over-shoot the forward scan with
    // accept-state tracking exists for.
    let report = lexer_dump(&"grammar T;
r : S ;
S : 'a' .+ 'c' ;");

    assert str_contains(&report, &"lookahead-aware: the inner can eat a char the suffix needs"), report;
    assert str_contains(&report, &"lookahead-aware 1"), report;
}

test "lexer dump reports a non-greedy repeat" {
    let report = lexer_dump(&"grammar T;
r : CMT ;
CMT : '/*' .*? '*/' ;");

    assert str_contains(&report, &"non-greedy: min-match loop"), report;
    assert str_contains(&report, &"non-greedy repeat: 1"), report;
}

test "lexer dump reports arm scoring for an alternation with a suffix" {
    // `('a' | 'ab') 'bc'` on `abbc` needs the second arm, which is neither the
    // first to match nor decidable without the suffix.
    let report = lexer_dump(&"grammar T;
r : I ;
I : ('a' | 'ab') 'bc' ;");

    assert str_contains(&report, &"alternation ('a' | 'ab') then 'bc' — arm scoring"), report;
    assert str_contains(&report, &"arm scoring 1"), report;
}

test "lexer dump reports disjoint arms with a suffix as first-match" {
    // The arms cannot both match at the same position, so which one wins is
    // not a decision and the scoring scan is not needed.
    let report = lexer_dump(&"grammar T;
r : I ;
I : ('a' | 'bcd') 'z' ;");

    assert str_contains(&report, &"first-match: no two arms can match at the same position"), report;
}

test "lexer dump reports the keyword classifier and its carrier" {
    // `IF` is a fixed per-char pattern, reclassified out of a match by the
    // later, wider `ID`.
    let report = lexer_dump(&"grammar T;
r : IF ID ;
IF : [iI] [fF] ;
ID : [a-z]+ ;");

    assert str_contains(&report, &"rule IF — keyword classifier (carrier ID)"), report;
    assert str_contains(&report, &"keyword classifier 1"), report;
}

test "lexer dump reports a rule the shared literal matcher covers" {
    // `X : 'x'` has the same fixed text as the parser's `'x'` literal.
    let report = lexer_dump(&"grammar T;
r : 'x' X ;
X : 'x' ;");

    assert str_contains(&report, &"shared literal matcher (TK_LIT_X)"), report;
}

test "lexer dump separates inlined from recursive fragments" {
    // `NEST` references itself, so it keeps a matcher; `D` is inlined at the
    // use site and its constructs are reported there, under the `D › ` prefix.
    let report = lexer_dump(&"grammar T;
r : N ;
N : NEST ;
fragment NEST : '(' NEST* ')' ;
fragment D : [0-9] ;
NUM : D+ ;");

    assert str_contains(&report, &"rule NEST — recursive fragment: matcher try_NEST"), report;
    assert str_contains(&report, &"rule D — fragment: inlined at each use site"), report;
    assert str_contains(&report, &"recursive fragment 1"), report;
}

test "lexer dump reports a tokens-block entry as a virtual token" {
    let report = lexer_dump(&"grammar T;
tokens { VT }
r : ID ;
ID : [a-z]+ ;");

    assert str_contains(&report, &"rule VT — virtual token: no text to match"), report;
    assert str_contains(&report, &"virtual 1"), report;
}

test "lexer dump reports an ATN-class rule as routed to latn_match" {
    // A non-greedy repeat whose body recurses into its own rule is the class
    // static lexing cannot decide.
    let report = lexer_dump(&"grammar T;
r : CMT ;
CMT : '/*' (CMT | .)+? '*/' ;");

    assert str_contains(&report, &"rule CMT — ATN-class: latn_match (latn rule 0)"), report;
    assert str_contains(&report, &"ATN-class 1"), report;
}

test "lexer dump keeps a predicate-carrying alternation off the scoring scan" {
    // Scanning every arm would evaluate the predicate more often than the
    // grammar says, so the emit stays first-match.
    let report = lexer_dump(&"grammar T;
r : I ;
I : ('a' | {true}? 'ab') 'bc' ;");

    assert str_contains(&report, &"first-match: an arm carries a semantic predicate"), report;
}

test "lexer dump names a rule's constructs with its own element text" {
    let report = lexer_dump(&"grammar T;
r : WS ;
WS : [ \\t\\r\\n]+ -> skip ;");

    assert str_contains(&report, &"repeat [ \\t\\r\\n]+"), report;
    assert str_contains(&report, &"plain loop: nothing follows the repeat"), report;
}
