test "lower simple rule with Not" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "no_int",
        Visibility::Default,
        [],
        [alt_of([Element::Not(NotElement {
            element: Element::TokenRef(TokenRefElement::new("INT")),
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Excluded(e) = &s.body.ops[0] {
            assert e.kinds.len() == 1;
            assert e.kinds[0] == "TK_INT";
            assert e.field == "not_int";
        } else {
            panic("expected Op::Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower dedupes same-name fields" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "two_ints",
        Visibility::Default,
        [],
        [alt_of([
            Element::TokenRef(TokenRefElement::new("INT")),
            Element::TokenRef(TokenRefElement::new("INT")),
        ])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 2;
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "int";
        } else {
            panic("expected first Token");
        }
        if let Token(t) = &s.body.ops[1] {
            assert t.field == "int_2";
        } else {
            panic("expected second Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower multi-alt rule with disjoint first sets produces Direct dispatch" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "expr",
        Visibility::Default,
        [],
        [
            alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
            alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            alt_of([Element::TokenRef(TokenRefElement::new("ID"))]),
        ],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        assert m.alts.len() == 3;
        assert m.scan_alts.len() == 3;
        // Per-alt case_name and struct_name follow the
        // `case_names_for_rule` convention. Without explicit alt
        // labels, names are positional: `Alt0`, `Alt1`, ... and the
        // struct combines the rule's bare base ("Expr" — `ExprNode`
        // with the `Node` suffix stripped) with the case name.
        assert m.alts[0].case_name == "Alt0";
        assert m.alts[0].struct_name == "ExprAlt0";
        assert m.alts[1].case_name == "Alt1";
        assert m.alts[1].struct_name == "ExprAlt1";
        assert m.alts[2].case_name == "Alt2";
        assert m.alts[2].struct_name == "ExprAlt2";

        if let Direct(d) = &m.dispatch {
            assert d.branches.len() == 3;
            assert d.branches[0].alt_index == 0;
            assert d.branches[0].tokens[0] == "TK_INT";
            assert d.branches[1].alt_index == 1;
            assert d.branches[1].tokens[0] == "TK_STRING";
            assert d.branches[2].alt_index == 2;
            assert d.branches[2].tokens[0] == "TK_ID";
        } else {
            panic("expected MultiAltDispatch::Direct");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower multi-alt rule with labeled alts uses label as case name" {
    let mut g = empty_grammar(&"T");
    // `expr : INT #IntLit | STRING #StrLit ;` (each alt labeled).
    let mut int_alt = alt_of([Element::TokenRef(TokenRefElement::new("INT"))]);
    int_alt.label = Option::<String>::Some("IntLit");
    let mut str_alt = alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]);
    str_alt.label = Option::<String>::Some("StrLit");
    g.parser_rules = [ParserRule::new(
        "expr",
        Visibility::Default,
        [],
        [int_alt, str_alt],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        // When all alts are labeled, `case_names_for_rule` uses the
        // labels directly (positional `Alt0`/`Alt1` only fires for
        // unlabeled rules).
        assert m.alts[0].case_name == "IntLit";
        assert m.alts[0].struct_name == "ExprIntLit";
        assert m.alts[1].case_name == "StrLit";
        assert m.alts[1].struct_name == "ExprStrLit";
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower interns multi-element first set from Direct dispatch branch" {
    // `expr : num | STRING ;`
    // `num  : INT | FLOAT ;`
    //
    // `num`'s first set is `{TK_INT, TK_FLOAT}` (multi-alt,
    // disjoint), so when `expr`'s `RuleRef(num)` alt computes its
    // own first set the result is `{TK_INT, TK_FLOAT}` — a
    // two-element `DispatchBranch.tokens` that Phase 2.7 should
    // intern as a single `KindSet`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::RuleRef(RuleRefElement::new("num"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            ],
        ),
        ParserRule::new(
            "num",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("FLOAT"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.kind_sets.len() == 1;
    let ks = &lowered.kind_sets[0];
    assert ks.id == 0;
    // Canonical form: sorted alphabetically.
    assert ks.tokens.len() == 2;
    assert ks.tokens[0] == "TK_FLOAT";
    assert ks.tokens[1] == "TK_INT";
}

test "lower kind set registry collapses identical sets to one id" {
    // Two rules whose alts share the same multi-token first set
    // should produce only ONE entry in `kind_sets`. Both `expr`
    // and `lit` reference `num`, so the dispatch branch covering
    // alt 0 in each rule has the same `{TK_FLOAT, TK_INT}` set.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::RuleRef(RuleRefElement::new("num"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            ],
        ),
        ParserRule::new(
            "lit",
            Visibility::Default,
            [],
            [
                alt_of([Element::RuleRef(RuleRefElement::new("num"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("BYTES"))]),
            ],
        ),
        ParserRule::new(
            "num",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("FLOAT"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.kind_sets.len() == 1;
    assert lowered.kind_sets[0].id == 0;
}

test "lower produces empty kind_sets when every dispatch branch is single-token" {
    // Two-alt rule where each alt's first set is a single token.
    // Direct dispatch yields two single-token branches — neither
    // contributes to `kind_sets`, so the registry stays empty.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "expr",
        Visibility::Default,
        [],
        [
            alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
            alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
        ],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.kind_sets.is_empty();
}

test "lower transparent Group wraps single leaf element" {
    // `wrapped : (INT) ;` — a syntactic wrapper with no struct of
    // its own. The GroupOp carries `Transparent` shape and the
    // inner Op is the leaf Token verbatim.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "wrapped",
        Visibility::Default,
        [],
        [alt_of([Element::Group(GroupElement::new([
            alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
        ]))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let Transparent = &go.shape {
                assert true;
            } else {
                panic("expected GroupShape::Transparent");
            }
            assert go.alts.len() == 1;
            assert go.alts[0].ops.len() == 1;
            if let Token(t) = &go.alts[0].ops[0] {
                assert t.kind == "TK_INT";
                // Transparent: inner field is bound in the
                // surrounding alt's scope, so dedup uses the same
                // name table.
                assert t.field == "int";
            } else {
                panic("expected inner Token");
            }
            assert go.scan_alts.len() == 1;
            assert go.scan_alts[0].elements.len() == 1;
            if let Token(t) = &go.scan_alts[0].elements[0] {
                assert t.kind == "TK_INT";
            } else {
                panic("expected scan-side inner Token");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower transparent Group dedupes against surrounding scope" {
    // `pair : INT (INT) ;` — the second INT lives inside a
    // Transparent group, so its binding still nests in the outer
    // alt's name table. Dedup turns the inner field into `int_2`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "pair",
        Visibility::Default,
        [],
        [alt_of([
            Element::TokenRef(TokenRefElement::new("INT")),
            Element::Group(GroupElement::new([
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
            ])),
        ])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "int";
        } else {
            panic("expected first Token");
        }
        if let Group(go) = &s.body.ops[1] {
            if let Token(t) = &go.alts[0].ops[0] {
                // The Transparent group inherits the surrounding
                // dedup table, so the second INT is `int_2`.
                assert t.field == "int_2";
            } else {
                panic("expected Token inside Group");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower greedy Star Repeat with TokenRef inner" {
    // `tokens : INT* ;`
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "tokens",
        Visibility::Default,
        [],
        [alt_of([Element::Repeat(RepeatElement {
            kind: RepeatKind::Star,
            element: Element::TokenRef(TokenRefElement::new("INT")),
            non_greedy: false,
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Repeat(r) = &s.body.ops[0] {
            // RepeatKind round-trips from surface IR to GIR.
            if let Star = r.kind { assert true; } else { panic("expected Star"); }
            // Strategy is Plain at Phase 2.x.partial.
            if let Plain = &r.strategy { assert true; } else { panic("expected Plain"); }
            // Inner Op is the leaf Token, with its own (fresh) field
            // — the binding name inside the loop body, not the
            // surrounding alt's list-typed field.
            if let Token(t) = &r.body {
                assert t.kind == "TK_INT";
                assert t.field == "int";
            } else {
                panic("expected inner Token");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower greedy Plus Repeat with RuleRef inner" {
    // `exprs : expr+ ;`
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "exprs",
        Visibility::Default,
        [],
        [alt_of([Element::Repeat(RepeatElement {
            kind: RepeatKind::Plus,
            element: Element::RuleRef(RuleRefElement::new("expr")),
            non_greedy: false,
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(r) = &s.body.ops[0] {
            if let Plus = r.kind { assert true; } else { panic("expected Plus"); }
            if let RuleCall(c) = &r.body {
                assert c.target_name == "expr";
                assert c.field == "expr";
            } else {
                panic("expected inner RuleCall");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat scan body mirrors parse body" {
    // Scan side gets its own ScanElement::Repeat with the same kind
    // and inner shape, no field bindings, ScanRepeatStrategy::Plain.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "tokens",
        Visibility::Default,
        [],
        [alt_of([Element::Repeat(RepeatElement {
            kind: RepeatKind::Star,
            element: Element::TokenRef(TokenRefElement::new("INT")),
            non_greedy: false,
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(r) = &s.scan_body.elements[0] {
            if let Star = r.kind { assert true; } else { panic("expected Star (scan)"); }
            if let Plain = &r.strategy { assert true; } else { panic("expected Plain (scan)"); }
            if let Token(t) = &r.body {
                assert t.kind == "TK_INT";
            } else {
                panic("expected inner ScanElement::Token");
            }
        } else {
            panic("expected ScanElement::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule produces scan body mirroring leaf ops" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "mix",
        Visibility::Default,
        [],
        [alt_of([
            Element::TokenRef(TokenRefElement::new("ID")),
            Element::Literal(LiteralElement::new("=")),
            Element::RuleRef(RuleRefElement::new("expr")),
            Element::Wildcard(WildcardElement::new()),
            Element::Not(NotElement {
                element: Element::TokenRef(TokenRefElement::new("INT")),
            }),
        ])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.scan_body.elements.len() == 5;
        if let Token(t) = &s.scan_body.elements[0] {
            assert t.kind == "TK_ID";
        } else {
            panic("scan_body[0] != Token");
        }
        if let Token(t) = &s.scan_body.elements[1] {
            assert t.kind == "TK_LIT_EQ";
        } else {
            panic("scan_body[1] != Token (literal)");
        }
        if let RuleCall(r) = &s.scan_body.elements[2] {
            assert r.target_snake == "expr";
            assert r.min_prec_arg == 0;
            assert r.variant_id matches { None };
        } else {
            panic("scan_body[2] != RuleCall");
        }
        if let Wildcard = &s.scan_body.elements[3] {
            assert true;
        } else {
            panic("scan_body[3] != Wildcard");
        }
        if let Excluded(e) = &s.scan_body.elements[4] {
            assert e.kinds.len() == 1;
            assert e.kinds[0] == "TK_INT";
        } else {
            panic("scan_body[4] != Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower scan element flattens scalar Label" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "labelled",
        Visibility::Default,
        [],
        [alt_of([Element::Label(LabelElement::new(
            "lhs",
            false,
            Element::TokenRef(TokenRefElement::new("ID")),
        ))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.scan_body.elements.len() == 1;
        if let Token(t) = &s.scan_body.elements[0] {
            assert t.kind == "TK_ID";
        } else {
            panic("expected Token in scan_body");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower scalar Label rebinds inner field name" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "labelled",
        Visibility::Default,
        [],
        [alt_of([Element::Label(LabelElement::new(
            "lhs",
