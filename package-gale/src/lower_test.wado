test "lower Label dedupes against surrounding alt names" {
    let mut g = empty_grammar(&"T");
    // `lhs=ID lhs=ID` — two scalar labels with the same name.
    // dedup_name should produce "lhs" then "lhs_2".
    g.parser_rules = [
        ParserRule::new(
            "two_labels",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Label(LabelElement::new(
                        "lhs",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Label(LabelElement::new(
                        "lhs",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "lhs";
        } else {
            panic("expected first Token");
        }
        if let Token(t) = &s.body.ops[1] {
            assert t.field == "lhs_2";
        } else {
            panic("expected second Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower carries every leaf op in order" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "mix",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Literal(LiteralElement::new(":")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::Wildcard(WildcardElement::new()),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 4;
        if let Token(_) = &s.body.ops[0] {
            assert true;
        } else {
            panic("ops[0] != Token");
        }
        if let Literal(_) = &s.body.ops[1] {
            assert true;
        } else {
            panic("ops[1] != Literal");
        }
        if let RuleCall(_) = &s.body.ops[2] {
            assert true;
        } else {
            panic("ops[2] != RuleCall");
        }
        if let Wildcard(_) = &s.body.ops[3] {
            assert true;
        } else {
            panic("ops[3] != Wildcard");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower enumerates leaf field decls with span and Plain kinds" {
    // `mix : ID ':' expr ;` — leaf ops produce a 4-field struct
    // (span + id + colon + expr), all `Plain` kind.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "mix",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Literal(LiteralElement::new(":")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
            ],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.fields.len() == 4, `expected 4 fields, got {s.body.fields.len()}`;
        assert s.body.fields[0].name == "span";
        if let Span = &s.body.fields[0].kind {
            assert true;
        } else {
            panic("expected Span kind for leading field");
        }
        assert s.body.fields[1].name == "id";
        assert s.body.fields[1].type_str == "Token";
        assert s.body.fields[2].name == "colon";
        assert s.body.fields[2].type_str == "Token";
        assert s.body.fields[3].name == "expr";
        assert s.body.fields[3].type_str == "ExprNode", s.body.fields[3].type_str;
        if let Plain = &s.body.fields[3].kind {
            assert true;
        } else {
            panic("expected Plain kind for RuleCall field");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower enumerates Repeat field decls with List/Optional kinds" {
    // `r : INT* INT? ;` — Star produces `int_list: Array<Token>`,
    // Optional produces `int: Option<Token>`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span, int_list, int]
        assert s.body.fields.len() == 3, `expected 3 fields, got {s.body.fields.len()}`;
        assert s.body.fields[1].name == "int_list";
        assert s.body.fields[1].type_str == "Array<Token>";
        if let List = &s.body.fields[1].kind {
            assert true;
        } else {
            panic("expected List kind for Star Repeat");
        }
        assert s.body.fields[2].name == "int";
        assert s.body.fields[2].type_str == "Option<Token>";
        if let Optional = &s.body.fields[2].kind {
            assert true;
        } else {
            panic("expected Optional kind for Optional Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SingleAlt Group body enumerates list-label inner as Array field" {
    // `r : ID (COMMA b+=ID)* ;` — the `(COMMA b+=ID)` SingleAlt
    // group's inner `b+=ID` is a list label. The SingleAlt struct
    // must carry `b: Array<Token>`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Group(GroupElement::new([
                            alt_of([
                                Element::TokenRef(TokenRefElement::new("COMMA")),
                                Element::Label(LabelElement::new(
                                    "b",
                                    true,
                                    Element::TokenRef(TokenRefElement::new("ID")),
                                )),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        // Repeat is ops[1]; its body is the SingleAlt Group.
        if let Repeat(rep) = &s.body.ops[1] {
            if let Group(go) = &rep.body {
                if let SingleAlt(_) = &go.shape {
                    let inner_ops = &go.alts[0].ops;
                    assert inner_ops.len() == 2, `expected 2 inner ops, got {inner_ops.len()}`;
                    // ops[1] must be Op::ListLabel for `b+=ID`.
                    if let ListLabel(ll) = &inner_ops[1] {
                        assert ll.field == "b", ll.field;
                    } else if let Token(t) = &inner_ops[1] {
                        panic(`ops[1] is Token(field={t.field}); ListLabel expected`);
                    } else if let RuleCall(r) = &inner_ops[1] {
                        panic(`ops[1] is RuleCall(field={r.field}); ListLabel expected`);
                    } else if let Literal(l) = &inner_ops[1] {
                        panic(`ops[1] is Literal(field={l.field}); ListLabel expected`);
                    } else {
                        panic(`ops[1] is some other variant; ListLabel expected`);
                    }
                    let inner_fields = &go.alts[0].fields;
                    assert inner_fields.len() == 2, `expected 2 inner fields, got {inner_fields.len()}`;
                    assert inner_fields[0].type_str == "Token";
                    assert inner_fields[1].name == "b", inner_fields[1].name;
                    assert inner_fields[1].type_str == "Array<Token>", inner_fields[1].type_str;
                } else {
                    panic("expected GroupShape::SingleAlt");
                }
            } else {
                panic("expected Op::Group inside Repeat body");
            }
        } else {
            panic("expected Op::Repeat at ops[1]");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SingleAlt Group body enumerates inner FieldDecls without span" {
    // `assignment : (name=ID '=' INT) ;` — the SingleAlt inner body
    // gets its own `IdEqIntItem` struct with `id`, `eq`, `int` —
    // no leading `span` field (the outer rule struct owns the span).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "assignment",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Group(GroupElement::new([
                        alt_of([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::Literal(LiteralElement::new("=")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let SingleAlt(_) = &go.shape {
                let inner_fields = &go.alts[0].fields;
                assert inner_fields.len() == 3, `expected 3 inner fields, got {inner_fields.len()}`;
                assert inner_fields[0].name == "id";
                assert inner_fields[0].type_str == "Token";
                assert inner_fields[1].name == "eq";
                assert inner_fields[1].type_str == "Token";
                assert inner_fields[2].name == "int";
                assert inner_fields[2].type_str == "Token";
                // None of them is the Span sentinel — the outer rule
                // struct already carries the span.
                for let f of inner_fields {
                    if let Span = &f.kind {
                        panic(`SingleAlt inner field '{f.name}' must not be Span`);
                    }
                }
            } else {
                panic("expected GroupShape::SingleAlt");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower General Group inner alts enumerate per-alt FieldDecls without span" {
    // `node : (stmt | 'go' expr) ;` — General group with two alts
    // produces `NodeGroup0` enum + `NodeGroup0Alt0` / `NodeGroup0Alt1`
    // structs. Each inner alt struct carries its own FieldDecls
    // (no `span` — the outer `NodeNode` owns it).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "node",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Group(GroupElement::new([
                        alt_of([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt_of([
                            Element::Literal(LiteralElement::new("go")),
                            Element::RuleRef(RuleRefElement::new("expr")),
                        ]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let General(_) = &go.shape {
                assert go.alts.len() == 2;
                // Alt 0: single RuleRef `stmt` → `stmt` field.
                let alt0_fields = &go.alts[0].fields;
                assert alt0_fields.len() == 1, `alt 0 expected 1 field, got {alt0_fields.len()}`;
                assert alt0_fields[0].name == "stmt";
                assert alt0_fields[0].type_str == "StmtNode", alt0_fields[0].type_str;
                // Alt 1: literal `'go'` + `expr` → two fields.
                let alt1_fields = &go.alts[1].fields;
                assert alt1_fields.len() == 2, `alt 1 expected 2 fields, got {alt1_fields.len()}`;
                assert alt1_fields[0].name == "lit_go";
                assert alt1_fields[0].type_str == "Token";
                assert alt1_fields[1].name == "expr";
                assert alt1_fields[1].type_str == "ExprNode";
            } else {
                panic("expected GroupShape::General");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat field name dedupes against outer scope" {
    // `r : int_list=ID INT* ;` — outer label takes `int_list`,
    // the unlabeled `INT*` dedups its outer struct field to
    // `int_list_2`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Label(LabelElement::new(
                        "int_list",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span, int_list (label), int_list_2 (Repeat dedup)]
        assert s.body.fields.len() == 3;
        assert s.body.fields[1].name == "int_list";
        assert s.body.fields[2].name == "int_list_2", s.body.fields[2].name;
        // Op.field on the Repeat carries the same deduped name.
        if let Repeat(rep) = &s.body.ops[1] {
            assert rep.field == "int_list_2", rep.field;
        } else {
            panic("expected Op::Repeat at index 1");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Group field decls match shape's outer field/type" {
    // `r : (K_A | K_B) (stmt | expr) (a b) ;`
    // `stmt : ID ; expr : INT ;`
    // — TokenOnly, SimpleCst, SingleAlt shapes each produce one
    // field on the outer struct.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Group(GroupElement::new([
                        alt_of([Element::TokenRef(TokenRefElement::new("K_A"))]),
                        alt_of([Element::TokenRef(TokenRefElement::new("K_B"))]),
                    ])),
                    Element::Group(GroupElement::new([
                        alt_of([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt_of([Element::RuleRef(RuleRefElement::new("expr"))]),
                    ])),
                    Element::Group(GroupElement::new([
                        alt_of([
                            Element::TokenRef(TokenRefElement::new("A")),
                            Element::TokenRef(TokenRefElement::new("B")),
                        ]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span, k_a_or_k_b: Token, stmt_or_expr: Option<StmtOrExprGroup>, a_b: ABItem]
        // Standalone SimpleCst groups surface as `Option<>` to match
        // parser_gen's `gen_consume_group_store_optional` storage pattern.
        assert s.body.fields.len() == 4, `expected 4 fields, got {s.body.fields.len()}`;
        assert s.body.fields[1].name == "k_a_or_k_b";
        assert s.body.fields[1].type_str == "Token";
        assert s.body.fields[2].name == "stmt_or_expr";
        assert s.body.fields[2].type_str == "Option<StmtOrExprGroup>", s.body.fields[2].type_str;
        assert s.body.fields[3].name == "a_b";
        assert s.body.fields[3].type_str == "ABItem", s.body.fields[3].type_str;
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower LR rule splits atom and lr_alts and assigns precedence" {
    // `expr : INT | expr '+' expr | expr '*' expr ;`
    // Two LR alts (`+` and `*`) plus one atom (`INT`). ANTLR4's
    // precedence assignment: first LR alt = highest = total_lr,
    // last = 1. So `+` (alt 1, lr_position 0) → own_prec = 2;
    // `*` (alt 2, lr_position 1) → own_prec = 1.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::Literal(LiteralElement::new("+")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
                alt_of([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::Literal(LiteralElement::new("*")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let LeftRecursive(l) = &lowered.parser_rules[0] {
        assert l.header.name == "expr";
        // Atom: only the non-LR alt (alt_index 0).
        assert l.atom.alts.len() == 1;
        assert l.atom.alts[0].alt_index == 0;
        // LR alts: alts 1 and 2, in source order.
        assert l.lr_alts.len() == 2;
        assert l.lr_alts[0].alt_index == 1;
        assert l.lr_alts[0].own_prec == 2;
        assert l.lr_alts[1].alt_index == 2;
        assert l.lr_alts[1].own_prec == 1;
        // Each suffix has 2 elements (the operator + trailing self-ref).
        assert l.lr_alts[0].suffix.ops.len() == 2;
        assert l.lr_alts[1].suffix.ops.len() == 2;
        // Trailing self-ref at original-element index 2.
        assert l.lr_alts[0].last_self_ref_idx == 2;
        assert l.lr_alts[1].last_self_ref_idx == 2;
        // Left-associative by default: conflict_min = own_prec + 1.
        assert l.lr_alts[0].conflict_min == 3;
        assert l.lr_alts[1].conflict_min == 2;
        assert !l.lr_alts[0].right_associative;
        // Suffix first sets are the operator tokens.
        assert l.lr_alts[0].suffix_first.len() == 1;
        assert l.lr_alts[1].suffix_first.len() == 1;
        // Both LR alts have non-empty suffixes → both valid.
        assert l.lr_dispatch.valid_lr_alts.len() == 2;
        // Disjoint first sets → two singleton groups.
        assert l.lr_dispatch.groups.len() == 2;
    } else {
        panic("expected Rule::LeftRecursive");
    }
}

test "lower LR rule respects right-associative conflict_min" {
    // `expr : INT | <assoc=right> expr '**' expr ;`
    // Right-assoc: conflict_min = own_prec (not own_prec + 1).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                Alternative {
                    label: null,
                    options: [
                        GrammarOption {
                            name: "assoc",
                            value: OptionValue::Ident("right"),
                        },
                    ],
                    elements: [
                        Element::RuleRef(RuleRefElement::new("expr")),
                        Element::Literal(LiteralElement::new("**")),
                        Element::RuleRef(RuleRefElement::new("expr")),
                    ],
                },
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let LeftRecursive(l) = &lowered.parser_rules[0] {
        assert l.lr_alts.len() == 1;
        assert l.lr_alts[0].right_associative;
        assert l.lr_alts[0].own_prec == 1;
        // Right-assoc floor: conflict_min == own_prec.
        assert l.lr_alts[0].conflict_min == 1, `expected 1, got {l.lr_alts[0].conflict_min}`;
    } else {
        panic("expected Rule::LeftRecursive");
    }
}

test "lower LR rule with no trailing self-ref records last_self_ref_idx -1" {
    // `expr : INT | expr '++' ;` — the LR alt has no internal
    // self-ref beyond the leading prefix.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::RuleRef(RuleRefElement::new("expr")), Element::Literal(LiteralElement::new("++"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let LeftRecursive(l) = &lowered.parser_rules[0] {
        assert l.lr_alts.len() == 1;
        assert l.lr_alts[0].last_self_ref_idx == -1;
        assert l.lr_alts[0].suffix.ops.len() == 1;
    } else {
        panic("expected Rule::LeftRecursive");
    }
}

test "lower non-greedy Wildcard Repeat carries outer_follow as exit_first" {
    // `comment : '/*' .*? '*/' ;` — `.*?` exits when `*/` appears.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "comment",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Literal(LiteralElement::new("/*")),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Wildcard(WildcardElement::new()),
                        non_greedy: true,
                    }),
                    Element::Literal(LiteralElement::new("*/")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[1] {
            if let NonGreedy(ng) = &rep.strategy {
                // exit_first carries the trailing `*/` literal kind.
                assert ng.exit_first.len() == 1, `expected 1, got {ng.exit_first.len()}`;
                assert ng.exit_first[0] == "TK_LIT_STARSLASH", ng.exit_first[0];
                assert ng.exit_second.is_empty();
            } else {
                panic("expected RepeatStrategy::NonGreedy");
            }
        } else {
            panic("expected Op::Repeat at index 1");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower non-greedy TokenRef Repeat carries outer_follow as exit_first" {
