test "lower simple rule with Not" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "no_int",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Not(NotElement {
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Excluded(e) = &s.body.ops[0] {
            assert e.kinds.len() == 1;
            assert e.kinds[0] == "TK_INT";
            assert e.field == "not_int";
        } else {
            panic("expected Op::Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule with Not over multi-token Group" {
    // `r : ~ ( INT | FLOAT ) ;` — Not over a Group whose alts are
    // each a single token. The kinds array carries both
    // alternative kinds.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "no_num",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Not(NotElement {
                        element: Element::Group(GroupElement::new([
                            alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                            alt_of([Element::TokenRef(TokenRefElement::new("FLOAT"))]),
                        ])),
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Excluded(e) = &s.body.ops[0] {
            assert e.kinds.len() == 2;
            assert e.kinds[0] == "TK_INT";
            assert e.kinds[1] == "TK_FLOAT";
        } else {
            panic("expected Op::Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower dedupes same-name fields" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "two_ints",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("INT")), Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 2;
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "int";
        } else {
            panic("expected first Token");
        }
        if let Token(t) = &s.body.ops[1] {
            assert t.field == "int_2";
        } else {
            panic("expected second Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower multi-alt rule with disjoint first sets produces Direct dispatch" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("ID"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        assert m.alts.len() == 3;
        assert m.scan_alts.len() == 3;
        // Per-alt case_name and struct_name follow the
        // `case_names_for_rule` convention. Without explicit alt
        // labels, names are positional: `Alt0`, `Alt1`, ... and the
        // struct combines the rule's bare base ("Expr" — `ExprNode`
        // with the `Node` suffix stripped) with the case name.
        assert m.alts[0].case_name == "Alt0";
        assert m.alts[0].struct_name == "ExprAlt0";
        assert m.alts[1].case_name == "Alt1";
        assert m.alts[1].struct_name == "ExprAlt1";
        assert m.alts[2].case_name == "Alt2";
        assert m.alts[2].struct_name == "ExprAlt2";

        if let Direct(d) = &m.dispatch {
            assert d.branches.len() == 3;
            assert d.branches[0].alt_index == 0;
            assert d.branches[0].tokens[0] == "TK_INT";
            assert d.branches[1].alt_index == 1;
            assert d.branches[1].tokens[0] == "TK_STRING";
            assert d.branches[2].alt_index == 2;
            assert d.branches[2].tokens[0] == "TK_ID";
        } else {
            panic("expected MultiAltDispatch::Direct");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower multi-alt rule with labeled alts uses label as case name" {
    let mut g = empty_grammar(&"T");
    // `expr : INT #IntLit | STRING #StrLit ;` (each alt labeled).
    let mut int_alt = alt_of([Element::TokenRef(TokenRefElement::new("INT"))]);
    int_alt.label = Option::<String>::Some("IntLit");
    let mut str_alt = alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]);
    str_alt.label = Option::<String>::Some("StrLit");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [int_alt, str_alt],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        // When all alts are labeled, `case_names_for_rule` uses the
        // labels directly (positional `Alt0`/`Alt1` only fires for
        // unlabeled rules).
        assert m.alts[0].case_name == "IntLit";
        assert m.alts[0].struct_name == "ExprIntLit";
        assert m.alts[1].case_name == "StrLit";
        assert m.alts[1].struct_name == "ExprStrLit";
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower interns multi-element first set from Direct dispatch branch" {
    // `expr : num | STRING ;`
    // `num  : INT | FLOAT ;`
    //
    // `num`'s first set is `{TK_INT, TK_FLOAT}` (multi-alt,
    // disjoint), so when `expr`'s `RuleRef(num)` alt computes its
    // own first set the result is `{TK_INT, TK_FLOAT}` — a
    // two-element `DispatchBranch.tokens` that Phase 2.7 should
    // intern as a single `KindSet`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::RuleRef(RuleRefElement::new("num"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            ],
        ),
        ParserRule::new(
            "num",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("FLOAT"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.kind_sets.len() == 1;
    let ks = &lowered.kind_sets[0];
    assert ks.id == 0;
    // Canonical form: sorted alphabetically.
    assert ks.tokens.len() == 2;
    assert ks.tokens[0] == "TK_FLOAT";
    assert ks.tokens[1] == "TK_INT";
}

test "lower kind set registry collapses identical sets to one id" {
    // Two rules whose alts share the same multi-token first set
    // should produce only ONE entry in `kind_sets`. Both `expr`
    // and `lit` reference `num`, so the dispatch branch covering
    // alt 0 in each rule has the same `{TK_FLOAT, TK_INT}` set.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::RuleRef(RuleRefElement::new("num"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            ],
        ),
        ParserRule::new(
            "lit",
            Visibility::Default,
            [],
            [
                alt_of([Element::RuleRef(RuleRefElement::new("num"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("BYTES"))]),
            ],
        ),
        ParserRule::new(
            "num",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("FLOAT"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.kind_sets.len() == 1;
    assert lowered.kind_sets[0].id == 0;
}

test "lower produces empty kind_sets when every dispatch branch is single-token" {
    // Two-alt rule where each alt's first set is a single token.
    // Direct dispatch yields two single-token branches — neither
    // contributes to `kind_sets`, so the registry stays empty.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.kind_sets.is_empty();
}

test "lower transparent Group wraps single leaf element" {
    // `wrapped : (INT) ;` — a syntactic wrapper with no struct of
    // its own. The GroupOp carries `Transparent` shape and the
    // inner Op is the leaf Token verbatim.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "wrapped",
            Visibility::Default,
            [],
            [alt_of([Element::Group(GroupElement::new([alt_of([Element::TokenRef(TokenRefElement::new("INT"))])]))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let Transparent = &go.shape {
                assert true;
            } else {
                panic("expected GroupShape::Transparent");
            }
            assert go.alts.len() == 1;
            assert go.alts[0].ops.len() == 1;
            if let Token(t) = &go.alts[0].ops[0] {
                assert t.kind == "TK_INT";
                // Transparent: inner field is bound in the
                // surrounding alt's scope, so dedup uses the same
                // name table.
                assert t.field == "int";
            } else {
                panic("expected inner Token");
            }
            assert go.scan_alts.len() == 1;
            assert go.scan_alts[0].elements.len() == 1;
            if let Token(t) = &go.scan_alts[0].elements[0] {
                assert t.kind == "TK_INT";
            } else {
                panic("expected scan-side inner Token");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower transparent Group dedupes against surrounding scope" {
    // `pair : INT (INT) ;` — the second INT lives inside a
    // Transparent group, so its binding still nests in the outer
    // alt's name table. Dedup turns the inner field into `int_2`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "pair",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("INT")),
                    Element::Group(GroupElement::new([alt_of([Element::TokenRef(TokenRefElement::new("INT"))])])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "int";
        } else {
            panic("expected first Token");
        }
        if let Group(go) = &s.body.ops[1] {
            if let Token(t) = &go.alts[0].ops[0] {
                // The Transparent group inherits the surrounding
                // dedup table, so the second INT is `int_2`.
                assert t.field == "int_2";
            } else {
                panic("expected Token inside Group");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower single-alt Group with two leaves produces SingleAlt shape" {
    // `assignment : (name=ID '=' INT) ;` — a single alt with 3
    // elements lowers to `GroupShape::SingleAlt`. The struct gets
    // its own name table; the surrounding alt sees a single field.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "assignment",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Group(GroupElement::new([
                        alt_of([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::Literal(LiteralElement::new("=")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let SingleAlt(sa) = &go.shape {
                // Struct name comes from `single_alt_group_type_name`.
                // `=` lowers to `eq` (per `symbol_char_names`).
                assert sa.struct_name == "IdEqIntItem", sa.struct_name;
                // Field name comes from `single_alt_group_field_name`.
                assert sa.field == "id_eq_int", sa.field;
                // owner_rule threads the surrounding rule through.
                assert sa.owner_rule == "assignment", sa.owner_rule;
            } else {
                panic("expected GroupShape::SingleAlt");
            }
            assert go.alts.len() == 1;
            assert go.alts[0].ops.len() == 3;
            assert go.alts[0].struct_name == "IdEqIntItem";
            assert go.scan_alts.len() == 1;
            assert go.scan_alts[0].elements.len() == 3;
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower single-alt Group uses fresh name table for inner ops" {
    // `pair : ID (ID INT) ;` — the outer ID dedups under `id`.
    // The inner Group is a SingleAlt, so its first ID gets the
    // base name `id` again (fresh table inside the struct).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "pair",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Group(GroupElement::new([
                        alt_of([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "id";
        } else {
            panic("expected first Token");
        }
        if let Group(go) = &s.body.ops[1] {
            if let SingleAlt(_) = &go.shape {
                assert true;
            } else {
                panic("expected GroupShape::SingleAlt");
            }
            // Inner ops live in a fresh name table — the inner ID
            // is `id` not `id_2`.
            if let Token(t) = &go.alts[0].ops[0] {
                assert t.field == "id", t.field;
            } else {
                panic("expected inner Token ID");
            }
            if let Token(t) = &go.alts[0].ops[1] {
                assert t.field == "int", t.field;
            } else {
                panic("expected inner Token INT");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower single-alt Group field name dedupes against outer scope" {
    // `r : id_int (ID INT) ;` — the outer field name `id_int`
    // collides with the inner group's `single_alt_group_field_name`,
    // which is also `id_int`. The outer name table dedupes the
    // group's field to `id_int_2`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Label(LabelElement::new(
                        "id_int",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Group(GroupElement::new([
                        alt_of([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[1] {
            if let SingleAlt(sa) = &go.shape {
                assert sa.field == "id_int_2", sa.field;
            } else {
                panic("expected GroupShape::SingleAlt");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower token-only Group produces TokenOnly shape with single field" {
    // `cmd : (K_INSERT | K_REPLACE) ;`
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "cmd",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Group(GroupElement::new([
                        alt_of([Element::TokenRef(TokenRefElement::new("K_INSERT"))]),
                        alt_of([Element::TokenRef(TokenRefElement::new("K_REPLACE"))]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let TokenOnly(to) = &go.shape {
                // Field name comes from `token_group_field_name`.
                assert to.field == "k_insert_or_k_replace", to.field;
            } else {
                panic("expected GroupShape::TokenOnly");
            }
            assert go.alts.len() == 2;
            assert go.alts[0].ops.len() == 1;
            assert go.alts[1].ops.len() == 1;
            // Direct dispatch on each alt's single token kind.
            if let Direct(dd) = &go.dispatch {
                assert dd.branches.len() == 2;
                assert dd.branches[0].tokens.len() == 1;
                assert dd.branches[0].tokens[0] == "TK_K_INSERT";
                assert dd.branches[0].alt_index == 0;
                assert dd.branches[1].tokens[0] == "TK_K_REPLACE";
                assert dd.branches[1].alt_index == 1;
            } else {
                panic("expected MultiAltDispatch::Direct");
            }
            // Scan side mirrors the parse-side dispatch.
            if let Direct(dd) = &go.scan_dispatch {
                assert dd.branches.len() == 2;
            } else {
                panic("expected scan dispatch Direct");
            }
            assert go.scan_alts.len() == 2;
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower token-only Group accepts Literal alts" {
    // `op : ('+' | '-') ;`
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "op",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Group(GroupElement::new([
                        alt_of([Element::Literal(LiteralElement::new("+"))]),
                        alt_of([Element::Literal(LiteralElement::new("-"))]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let TokenOnly(to) = &go.shape {
                assert to.field == "plus_or_minus", to.field;
            } else {
                panic("expected GroupShape::TokenOnly");
            }
            // Each alt's body op is the matched Literal.
            if let Literal(_) = &go.alts[0].ops[0] {
                assert true;
            } else {
                panic("expected Literal Op for `+` alt");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower token-only Group field dedupes against outer scope" {
    // `r : k_a (K_A | K_B) ;` — a label binds the outer field
    // `k_a`, then the group's `token_group_field_name` is
    // `k_a_or_k_b`. No collision today, so this just sanity-checks
    // that the outer scope sees the group's field through dedup.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Label(LabelElement::new(
                        "k_a_or_k_b",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Group(GroupElement::new([
                        alt_of([Element::TokenRef(TokenRefElement::new("K_A"))]),
                        alt_of([Element::TokenRef(TokenRefElement::new("K_B"))]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[1] {
            if let TokenOnly(to) = &go.shape {
                // Outer label took the base name; the group dedups
                // to `_2`.
                assert to.field == "k_a_or_k_b_2", to.field;
            } else {
                panic("expected GroupShape::TokenOnly");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SimpleCst Group with single-RuleRef alts produces SimpleCst shape" {
    // `wrap : (stmt | expr) ; stmt : ID ; expr : INT ;`
    // The wrap rule's group is SimpleCst — each alt is a single
    // distinct RuleRef with disjoint first sets.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "wrap",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Group(GroupElement::new([
                        alt_of([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt_of([Element::RuleRef(RuleRefElement::new("expr"))]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let SimpleCst(scst) = &go.shape {
                assert scst.type_name == "StmtOrExprGroup", scst.type_name;
                assert scst.field == "stmt_or_expr", scst.field;
            } else {
                panic("expected GroupShape::SimpleCst");
            }
            assert go.alts.len() == 2;
            assert go.alts[0].case_name == "Stmt", go.alts[0].case_name;
            assert go.alts[1].case_name == "Expr", go.alts[1].case_name;
            // Each body op is the matched RuleCall.
            if let RuleCall(rc) = &go.alts[0].ops[0] {
                assert rc.target_name == "stmt";
                assert rc.target_snake == "stmt";
                assert rc.field == "stmt";
            } else {
                panic("expected RuleCall for first alt");
            }
            // Direct dispatch on each rule's first set.
            if let Direct(dd) = &go.dispatch {
                assert dd.branches.len() == 2;
                assert dd.branches[0].tokens[0] == "TK_ID";
                assert dd.branches[1].tokens[0] == "TK_INT";
            } else {
                panic("expected MultiAltDispatch::Direct");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

