test "lower carries every leaf op in order" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "mix",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Literal(LiteralElement::new(":")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::Wildcard(WildcardElement::new()),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 4;
        if let Token(_) = &s.body.ops[0] {
            assert true;
        } else {
            panic("ops[0] != Token");
        }
        if let Literal(_) = &s.body.ops[1] {
            assert true;
        } else {
            panic("ops[1] != Literal");
        }
        if let RuleCall(_) = &s.body.ops[2] {
            assert true;
        } else {
            panic("ops[2] != RuleCall");
        }
        if let Wildcard(_) = &s.body.ops[3] {
            assert true;
        } else {
            panic("ops[3] != Wildcard");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower enumerates leaf field decls with span and Plain kinds" {
    // `mix : ID ':' expr ;` — leaf ops produce a 4-field struct
    // (span + id + colon + expr), all `Plain` kind.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "mix",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Literal(LiteralElement::new(":")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
            ],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.fields.len() == 4;
        assert s.body.fields[0].name == "span";
        if let Span = &s.body.fields[0].kind {
            assert true;
        } else {
            panic("expected Span kind for leading field");
        }
        assert s.body.fields[1].name == "id";
        assert s.body.fields[1].type_str == "i32";
        assert s.body.fields[2].name == "colon";
        assert s.body.fields[2].type_str == "i32";
        assert s.body.fields[3].name == "expr";
        assert s.body.fields[3].type_str == "ExprNode";
        if let Plain = &s.body.fields[3].kind {
            assert true;
        } else {
            panic("expected Plain kind for RuleCall field");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower enumerates Repeat field decls with List/Optional kinds" {
    // `r : INT* INT? ;` — Star produces `int_list: List<Token>`,
    // Optional produces `int: Option<Token>`.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span, int_list, int]
        assert s.body.fields.len() == 3;
        assert s.body.fields[1].name == "int_list";
        assert s.body.fields[1].type_str == "List<i32>";
        if let List = &s.body.fields[1].kind {
            assert true;
        } else {
            panic("expected List kind for Star Repeat");
        }
        assert s.body.fields[2].name == "int";
        assert s.body.fields[2].type_str == "Option<i32>";
        if let Optional = &s.body.fields[2].kind {
            assert true;
        } else {
            panic("expected Optional kind for Optional Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SingleAlt Group body enumerates list-label inner as List field" {
    // `r : ID (COMMA b+=ID)* ;` — the `(COMMA b+=ID)` SingleAlt
    // group's inner `b+=ID` is a list label. The SingleAlt struct
    // must carry `b: List<Token>`.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Group(GroupElement::new([
                            alt([
                                Element::TokenRef(TokenRefElement::new("COMMA")),
                                Element::Label(LabelElement::new(
                                    "b",
                                    true,
                                    Element::TokenRef(TokenRefElement::new("ID")),
                                )),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        // Repeat is ops[1]; its body is the SingleAlt Group.
        if let Repeat(rep) = &s.body.ops[1] {
            if let Group(go) = &rep.body {
                if let SingleAlt(_) = &go.shape {
                    let inner_ops = &go.alts[0].ops;
                    assert inner_ops.len() == 2, "expected 2 inner ops";
                    // ops[1] must be Op::ListLabel for `b+=ID`.
                    if let ListLabel(ll) = &inner_ops[1] {
                        assert ll.field == "b";
                    } else if let Token(t) = &inner_ops[1] {
                        panic(`ops[1] is Token(field=${t.field}); ListLabel expected`);
                    } else if let RuleCall(r) = &inner_ops[1] {
                        panic(`ops[1] is RuleCall(field=${r.field}); ListLabel expected`);
                    } else if let Literal(l) = &inner_ops[1] {
                        panic(`ops[1] is Literal(field=${l.field}); ListLabel expected`);
                    } else {
                        panic(`ops[1] is some other variant; ListLabel expected`);
                    }
                    let inner_fields = &go.alts[0].fields;
                    assert inner_fields.len() == 2, "expected 2 inner fields";
                    assert inner_fields[0].type_str == "i32";
                    assert inner_fields[1].name == "b";
                    assert inner_fields[1].type_str == "List<i32>";
                } else {
                    panic("expected GroupShape::SingleAlt");
                }
            } else {
                panic("expected Op::Group inside Repeat body");
            }
        } else {
            panic("expected Op::Repeat at ops[1]");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SingleAlt Group body enumerates inner FieldDecls without span" {
    // `assignment : (name=ID '=' INT) ;` — the SingleAlt inner body
    // gets its own `IdEqIntItem` struct with `id`, `eq`, `int` —
    // no leading `span` field (the outer rule struct owns the span).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "assignment",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::Literal(LiteralElement::new("=")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let SingleAlt(_) = &go.shape {
                let inner_fields = &go.alts[0].fields;
                assert inner_fields.len() == 3, "expected 3 inner fields";
                assert inner_fields[0].name == "id";
                assert inner_fields[0].type_str == "i32";
                assert inner_fields[1].name == "eq";
                assert inner_fields[1].type_str == "i32";
                assert inner_fields[2].name == "int";
                assert inner_fields[2].type_str == "i32";
                // None of them is the Span sentinel — the outer rule
                // struct already carries the span.
                for let f of inner_fields {
                    if let Span = &f.kind {
                        panic(`SingleAlt inner field '${f.name}' must not be Span`);
                    }
                }
            } else {
                panic("expected GroupShape::SingleAlt");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower General Group inner alts enumerate per-alt FieldDecls without span" {
    // `node : (stmt | 'go' expr) ;` — General group with two alts
    // produces `NodeGroup0` enum + `NodeGroup0Alt0` / `NodeGroup0Alt1`
    // structs. Each inner alt struct carries its own FieldDecls
    // (no `span` — the outer `NodeNode` owns it).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "node",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt([
                            Element::Literal(LiteralElement::new("go")),
                            Element::RuleRef(RuleRefElement::new("expr")),
                        ]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let General(_) = &go.shape {
                assert go.alts.len() == 2;
                // Alt 0: single RuleRef `stmt` → `stmt` field.
                let alt0_fields = &go.alts[0].fields;
                assert alt0_fields.len() == 1, "alt 0 expected 1 field";
                assert alt0_fields[0].name == "stmt";
                assert alt0_fields[0].type_str == "StmtNode";
                // Alt 1: literal `'go'` + `expr` → two fields.
                let alt1_fields = &go.alts[1].fields;
                assert alt1_fields.len() == 2, "alt 1 expected 2 fields";
                assert alt1_fields[0].name == "lit_go";
                assert alt1_fields[0].type_str == "i32";
                assert alt1_fields[1].name == "expr";
                assert alt1_fields[1].type_str == "ExprNode";
            } else {
                panic("expected GroupShape::General");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat field name dedupes against outer scope" {
    // `r : int_list=ID INT* ;` — outer label takes `int_list`,
    // the unlabeled `INT*` dedups its outer struct field to
    // `int_list_2`.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Label(LabelElement::new(
                        "int_list",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span, int_list (label), int_list_2 (Repeat dedup)]
        assert s.body.fields.len() == 3;
        assert s.body.fields[1].name == "int_list";
        assert s.body.fields[2].name == "int_list_2";
        // Op.field on the Repeat carries the same deduped name.
        if let Repeat(rep) = &s.body.ops[1] {
            assert rep.field == "int_list_2";
        } else {
            panic("expected Op::Repeat at index 1");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Group field decls match shape's outer field/type" {
    // `r : (K_A | K_B) (stmt | expr) (a b) ;`
    // `stmt : ID ; expr : INT ;`
    // — TokenOnly, SimpleCst, SingleAlt shapes each produce one
    // field on the outer struct.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([Element::TokenRef(TokenRefElement::new("K_A"))]),
                        alt([Element::TokenRef(TokenRefElement::new("K_B"))]),
                    ])),
                    Element::Group(GroupElement::new([
                        alt([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt([Element::RuleRef(RuleRefElement::new("expr"))]),
                    ])),
                    Element::Group(GroupElement::new([
                        alt([
                            Element::TokenRef(TokenRefElement::new("A")),
                            Element::TokenRef(TokenRefElement::new("B")),
                        ]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span, k_a_or_k_b: Token, stmt_or_expr: Option<StmtOrExprGroup>, a_b: ABItem]
        // Standalone SimpleCst groups surface as `Option<>` to match
        // parser_gen's `gen_consume_group_store_optional` storage pattern.
        assert s.body.fields.len() == 4;
        assert s.body.fields[1].name == "k_a_or_k_b";
        assert s.body.fields[1].type_str == "i32";
        assert s.body.fields[2].name == "stmt_or_expr";
        assert s.body.fields[2].type_str == "Option<StmtOrExprGroup>";
        assert s.body.fields[3].name == "a_b";
        assert s.body.fields[3].type_str == "ABItem";
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower LR rule splits atom and lr_alts and assigns precedence" {
    // `expr : INT | expr '+' expr | expr '*' expr ;`
    // Two LR alts (`+` and `*`) plus one atom (`INT`). ANTLR4's
    // precedence assignment: first LR alt = highest = total_lr,
    // last = 1. So `+` (alt 1, lr_position 0) → own_prec = 2;
    // `*` (alt 2, lr_position 1) → own_prec = 1.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::Literal(LiteralElement::new("+")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
                alt([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::Literal(LiteralElement::new("*")),
                    Element::RuleRef(RuleRefElement::new("expr")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let LeftRecursive(l) = &lowered.parser_rules[0] {
        assert l.header.name == "expr";
        // Atom: only the non-LR alt (alt_index 0).
        assert l.atom.alts.len() == 1;
        assert l.atom.alts[0].alt_index == 0;
        // LR alts: alts 1 and 2, in source order.
        assert l.lr_alts.len() == 2;
        assert l.lr_alts[0].alt_index == 1;
        assert l.lr_alts[0].own_prec == 2;
        assert l.lr_alts[1].alt_index == 2;
        assert l.lr_alts[1].own_prec == 1;
        // Each suffix has 2 elements (the operator + trailing self-ref).
        assert l.lr_alts[0].suffix.ops.len() == 2;
        assert l.lr_alts[1].suffix.ops.len() == 2;
        // Trailing self-ref at original-element index 2.
        assert l.lr_alts[0].last_self_ref_idx == 2;
        assert l.lr_alts[1].last_self_ref_idx == 2;
        // Left-associative by default: conflict_min = own_prec + 1.
        assert l.lr_alts[0].conflict_min == 3;
        assert l.lr_alts[1].conflict_min == 2;
        assert !l.lr_alts[0].right_associative;
        // Suffix first sets are the operator tokens.
        assert l.lr_alts[0].suffix_first.len() == 1;
        assert l.lr_alts[1].suffix_first.len() == 1;
        // Both LR alts have non-empty suffixes → both valid.
        assert l.lr_dispatch.valid_lr_alts.len() == 2;
        // Disjoint first sets → two singleton groups.
        assert l.lr_dispatch.groups.len() == 2;
    } else {
        panic("expected Rule::LeftRecursive");
    }
}

test "lower LR rule respects right-associative conflict_min" {
    // `expr : INT | <assoc=right> expr '**' expr ;`
    // Right-assoc: conflict_min = own_prec (not own_prec + 1).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt([Element::TokenRef(TokenRefElement::new("INT"))]),
                Alternative {
                    label: null,
                    options: [
                        GrammarOption {
                            name: "assoc",
                            value: OptionValue::Ident("right"),
                        },
                    ],
                    elements: [
                        Element::RuleRef(RuleRefElement::new("expr")),
                        Element::Literal(LiteralElement::new("**")),
                        Element::RuleRef(RuleRefElement::new("expr")),
                    ],
                },
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let LeftRecursive(l) = &lowered.parser_rules[0] {
        assert l.lr_alts.len() == 1;
        assert l.lr_alts[0].right_associative;
        assert l.lr_alts[0].own_prec == 1;
        // Right-assoc floor: conflict_min == own_prec.
        assert l.lr_alts[0].conflict_min == 1;
    } else {
        panic("expected Rule::LeftRecursive");
    }
}

test "lower LR rule with no trailing self-ref records last_self_ref_idx -1" {
    // `expr : INT | expr '++' ;` — the LR alt has no internal
    // self-ref beyond the leading prefix.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt([
                    Element::RuleRef(RuleRefElement::new("expr")),
                    Element::Literal(LiteralElement::new("++")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let LeftRecursive(l) = &lowered.parser_rules[0] {
        assert l.lr_alts.len() == 1;
        assert l.lr_alts[0].last_self_ref_idx == -1;
        assert l.lr_alts[0].suffix.ops.len() == 1;
    } else {
        panic("expected Rule::LeftRecursive");
    }
}

test "lower non-greedy Wildcard Repeat carries outer_follow as exit_first" {
    // `comment : '/*' .*? '*/' ;` — `.*?` exits when `*/` appears.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "comment",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Literal(LiteralElement::new("/*")),
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Wildcard(WildcardElement::new()),
                        non_greedy: true,
                    }),
                    Element::Literal(LiteralElement::new("*/")),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[1] {
            if let NonGreedy(ng) = &rep.strategy {
                // exit_first carries the trailing `*/` literal kind.
                assert ng.exit_first.len() == 1;
                assert an.token_name(ng.exit_first[0]) == "TK_LIT_STARSLASH";
                assert ng.exit_second.is_empty();
            } else {
                panic("expected RepeatStrategy::NonGreedy");
            }
        } else {
            panic("expected Op::Repeat at index 1");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower non-greedy single-element Group Repeat lowers body to TransparentGroup with empty body_first_set" {
    // `r : (.)*? '=' ;` — `(.)` is a single-alt single-element Group
    // that `lower_transparent_group` collapses to `Op::Group(Transparent)`
    // wrapping `Op::Wildcard`. The body admits every token, so the wrapped
    // shape exits by the simulator just as bare `.*?` does
    // (`non_greedy_exit_by_atn`).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Group(
                            GroupElement::new([alt([Element::Wildcard(WildcardElement::new())])]),
                        ),
                        non_greedy: true,
                    }),
                    Element::Literal(LiteralElement::new("=")),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let TransparentGroup = rep.body_shape {
                assert true;
            } else {
                panic("expected RepeatBodyShape::TransparentGroup");
            }
            // `( . )*?` admits every token and the first-set walk enumerates
            // none of them — the two facts the class carries at once.
            assert admits_is_everything(&rep.body_admits), "expected the wildcard body to admit everything";
            let enumerated = admits_enumerated(&rep.body_admits);
            assert enumerated.is_empty(), "expected no enumerated kinds";
            if let NonGreedy(ng) = &rep.strategy {
                assert ng.exit_first.len() == 1;
                assert an.token_name(ng.exit_first[0]) == "TK_LIT_EQ";
            } else {
                panic("expected RepeatStrategy::NonGreedy");
            }
        } else {
            panic("expected Op::Repeat at index 0");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower non-greedy TokenRef Repeat carries outer_follow as exit_first" {
    // `r : ID*? '=' ;` — non-greedy `ID*?` followed by required `=`.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("ID")),
                        non_greedy: true,
                    }),
                    Element::Literal(LiteralElement::new("=")),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let NonGreedy(ng) = &rep.strategy {
                assert ng.exit_first.len() == 1;
                assert an.token_name(ng.exit_first[0]) == "TK_LIT_EQ";
            } else {
                panic("expected RepeatStrategy::NonGreedy");
            }
        } else {
            panic("expected Op::Repeat at index 0");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower non-greedy Group Repeat fills exit_second from inner suffix" {
    // `r : (',' INT)*? ',' STRING ;` — peek(0)==',' for both
    // the inner and the follow; peek(1) distinguishes INT (inner)
    // from STRING (follow). `exit_second` carries the inner's
    // post-first first set so emit can disambiguate.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Group(GroupElement::new([
                            alt([
                                Element::Literal(LiteralElement::new(",")),
                                Element::TokenRef(TokenRefElement::new("INT")),
                            ]),
                        ])),
                        non_greedy: true,
                    }),
                    Element::Literal(LiteralElement::new(",")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let NonGreedy(ng) = &rep.strategy {
                // exit_first = first(',' STRING) = { TK_LIT_COMMA }.
                assert ng.exit_first.len() == 1;
                assert an.token_name(ng.exit_first[0]) == "TK_LIT_COMMA";
                // exit_second = first of inner-after-first = { TK_INT }.
                assert ng.exit_second.len() == 1;
                assert an.token_name(ng.exit_second[0]) == "TK_INT";
            } else {
                panic("expected RepeatStrategy::NonGreedy");
            }
            // body_second_position_first = first of inner-Group's
            // elements from index 1 = { TK_INT }. Consumed by emit's
            // `compute_non_greedy_condition` 2-token disambiguation arm.
            assert rep.body_second_position_first.len() == 1;
            assert an.token_name(rep.body_second_position_first[0]) == "TK_INT";
            // body_shape classifies the body op for emit's exhaustive
            // dispatch. The inner is a single-alt Group of two leaves
            // → SingleAlt shape → StorableGroup.
            if let StorableGroup = rep.body_shape {
                assert true;
            } else {
                panic("expected RepeatBodyShape::StorableGroup");
            }
        } else {
            panic("expected Op::Repeat at index 0");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower multi-alt rule with overlapping first sets emits Tournament dispatch" {
    // `r : ID INT | ID STRING ;` — both alts start with ID, so
    // overlap. Both are fully scannable → Tournament dispatch.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        if let Tournament(td) = &m.dispatch {
            assert td.alts.len() == 2;
            // Both alts have 2 elements; tie-break is source order.
            assert td.alts[0] == 0 || td.alts[0] == 1;
        } else {
            panic("expected MultiAltDispatch::Tournament");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower warns once when overlapping alts fall back to a tournament" {
    // Same `r : ID INT | ID STRING ;` shape: both alts start with ID,
    // so lowering picks a scan tournament and should raise exactly one
    // OverlapTournament diagnostic naming the rule and the shared token.
    // The scan-side dispatch lowers the same alts but must not duplicate
    // the warning.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    assert lowered.diagnostics.len() == 1;
    let d = &lowered.diagnostics[0];
    // The owner names the rule structurally, so tooling matches by equality.
    assert d.owner == DiagnosticOwner::rule_dispatch("r");
    if let OverlapTournament = &d.kind {
    } else {
        panic("expected DiagnosticKind::OverlapTournament");
    }
    // The message should name the shared lookahead token so a grammar
    // author can see why the alts overlapped.
    assert d.message.contains("TK_ID"), "message lacks shared token";
}

test "lower raises no diagnostics for disjoint alts" {
    // `r : ID | INT ;` — disjoint first sets dispatch directly with no
    // tournament, so there is nothing to warn about.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([Element::TokenRef(TokenRefElement::new("ID"))]),
                alt([Element::TokenRef(TokenRefElement::new("INT"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    assert lowered.diagnostics.is_empty(), "expected no diagnostics";
}

test "lower warns when an optional falls back to a scan guard" {
    // `r : (b c)? Z ;` — the optional's body leads with a rule reference, so
    // neither the k-token nor the shape lookahead can decide entry. It is
    // scannable, so lowering gates entry on speculatively scanning the body.
    let mut g = parse("grammar S;\nr : (b c)? Z ;\nb : X ;\nc : Y ;\nX : 'x' ;\nY : 'y' ;\nZ : 'z' ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);

    let mut found = 0;
    for let d of &lowered.diagnostics {
        if d.kind matches { OptionalScanGuardFallback } {
            found += 1;
            assert d.owner.rule == "r", "expected the warning to name rule 'r'";
            assert d.owner.site matches { Optional(_) };
        }
    }
    assert found == 1, "expected 1 scan-guard warning";
}

test "lower raises no scan-guard warning for a token-led optional" {
    // `r : (X Y)? Z ;` — a fixed leading token decides entry, so the
    // optional never reaches the scan guard.
    let mut g = parse("grammar S;\nr : (X Y)? Z ;\nX : 'x' ;\nY : 'y' ;\nZ : 'z' ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);

    for let d of &lowered.diagnostics {
        assert !d.kind matches { OptionalScanGuardFallback };
    }
}

test "lower Tournament sorts longer alt first" {
    // `r : ID INT STRING | ID INT ;` — both start with ID, but the
    // 3-element alt is "more specific" and sorts before the 2-elem
    // alt (longest-match wins).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        if let Tournament(td) = &m.dispatch {
            // alt 0 has 3 elements, alt 1 has 2; alt 0 sorts first.
            assert td.alts[0] == 0, "expected alt 0 first";
            assert td.alts[1] == 1;
        } else {
            panic("expected MultiAltDispatch::Tournament");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

// Runtime-FOLLOW redesign: lowering no longer registers per-(rule, mask)
// `__follow_<id>` variants. Instead each `RuleCall` carries a `FollowArg`
// (the runtime continuation to thread) and each tail-greedy `Repeat`
// carries `gate_caller_follow`. These two tests replace the retired
// variant-registration / variant-body suppression tests.

test "lower: RuleCall before a token gets a Combined FollowArg; callee tail Repeat gates" {
    // `r : a X ; a : X* ;` — the call to `a` is followed by `X`
    // (non-nullable), so its continuation is the static mask `[{X}]`;
    // `a`'s `X*` sits at the rule tail, so it gates on the caller follow.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new("r", Visibility::Default, [], [
            alt([
                Element::RuleRef(RuleRefElement::new("a")),
                Element::TokenRef(TokenRefElement::new("X")),
            ]),
        ]),
        ParserRule::new("a", Visibility::Default, [], [
            alt([
                Element::Repeat(RepeatElement {
                    kind: RepeatKind::Star,
                    element: Element::TokenRef(TokenRefElement::new("X")),
                    non_greedy: false,
                }),
            ]),
        ]),
    ];

    let lowered = lower(&g, &[]);
    // No variant bodies are ever produced now.
    // `r`'s `a` call carries the local suffix ahead of whatever `r` was called
    // with.
    if let Simple(s) = &lowered.parser_rules[0] {
        if let RuleCall(rc) = &s.body.ops[0] {
            assert rc.follow_arg matches { Combined(_) }, "expected Combined FollowArg at the `a` call";
        } else {
            panic("expected RuleCall");
        }
    } else {
        panic("expected Rule::Simple for r");
    }
    // `a`'s tail `X*` gates on the caller's continuation.
    if let Simple(s) = &lowered.parser_rules[1] {
        if let Repeat(rep) = &s.body.ops[0] {
            assert rep.gate_caller_follow, "expected gate_caller_follow on a's tail Repeat";
        } else {
            panic("expected Repeat in a");
        }
    } else {
        panic("expected Rule::Simple for a");
    }
}

test "lower: RuleCall at the rule tail forwards the runtime follow" {
    // `r : a ; a : X* ;` — `a` is the last element of `r`, so its
    // continuation is whatever `r` was itself called with → Forward.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new("r", Visibility::Default, [], [alt([Element::RuleRef(RuleRefElement::new("a"))])]),
        ParserRule::new("a", Visibility::Default, [], [
            alt([
                Element::Repeat(RepeatElement {
                    kind: RepeatKind::Star,
                    element: Element::TokenRef(TokenRefElement::new("X")),
                    non_greedy: false,
                }),
            ]),
        ]),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let RuleCall(rc) = &s.body.ops[0] {
            assert rc.follow_arg matches { Forward }, "expected Forward FollowArg at a tail call";
        } else {
            panic("expected RuleCall");
        }
    } else {
        panic("expected Rule::Simple for r");
    }
}

test "lower Optional Repeat over multi-token Group uses OptionalLookahead strategy" {
    // `r : ('-' '>')? ;` — single-alt Group with two fixed-token
    // elements. The Optional needs a 2-token lookahead to commit
    // to firing. Emits `OptionalLookahead` carrying the
    // per-position signature.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::Group(GroupElement::new([
                            alt([
                                Element::Literal(LiteralElement::new("-")),
                                Element::Literal(LiteralElement::new(">")),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let OptionalLookahead(ol) = &rep.strategy {
                // Per-position signature: [[TK_LIT_MINUS], [TK_LIT_GT]].
                assert ol.sig.len() == 2;
                assert an.token_name(ol.sig[0][0]) == "TK_LIT_MINUS";
                assert an.token_name(ol.sig[1][0]) == "TK_LIT_GT";
            } else {
                panic("expected RepeatStrategy::OptionalLookahead");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower drops the empty shape from a scan-side optional lookahead" {
    // `r : (X? Y?)? Z ;` — every element of the optional's body is itself
    // optional, so shape enumeration includes the all-off shape. That shape
    // selects nothing: no lookahead to gate on, no body to scan. Both the
    // parse and the scan lowering must drop it, so neither emitter has to
    // decide what a signature-less shape means.
    let mut g = parse("grammar S;\nr : (X? Y?)? Z ;\nX : 'x' ;\nY : 'y' ;\nZ : 'z' ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);

    let scan_elem = if let Simple(s) = &lowered.parser_rules[0] {
        &s.scan_body.elements[0];
    } else {
        panic("expected Rule::Simple for r");
    };
    if let OptionalLookahead(ole) = scan_elem {
        assert !ole.sigs.is_empty(), "expected at least one shape to survive";
        assert ole.sigs.len() == ole.bodies.len(), "sigs and bodies must stay parallel";
        for let mut i = 0; i < ole.sigs.len(); i += 1 {
            assert !ole.sigs[i].is_empty();
        }
    } else {
        panic("expected ScanElement::OptionalLookahead");
    }
}

test "lower Optional Repeat with single-token inner stays Plain" {
    // `r : INT? ;` — bare leaf Optional. Lower keeps the strategy at
    // `Plain`; emit's Optional+leaf arm in
    // `gen_op_repeat_with_follow_override` emits the single-token
    // guard directly from `inner_first`, so the `OptionalLookahead`
    // specialisation is unnecessary here.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Plain = &rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::Plain for single-token leaf Optional");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Optional Repeat over RuleRef-led Group inner uses OptionalScanGuard" {
    // `r : (a X)? ; a : Y ;` — Optional Repeat whose inner is a
    // single-alt Group starting with a RuleRef (not a fixed token).
    // K-token lookahead can't materialise (no leading literal /
    // TokenRef), and the elements include no nested Optionals so
    // shape lookahead doesn't apply either. The inner is scannable,
    // so `OptionalScanGuard` is the strategy emit picks.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::Group(GroupElement::new([
                            alt([
                                Element::RuleRef(RuleRefElement::new("a")),
                                Element::TokenRef(TokenRefElement::new("X")),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
        ParserRule::new(
            "a",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("Y"))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let OptionalScanGuard = &rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::OptionalScanGuard");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "canonicalizing collapses nested optionals through a bare wrapper" {
    // The parentheses around an already-optional body add a group that carries
    // nothing, and `(X?)?` is `X?` whether or not one stands between the two.
    let sources = [
        "grammar S;\nr : ((A|))? B ;\nA : 'a' ;\nB : 'b' ;\n",
        "grammar S;\nr : (A?)? B ;\nA : 'a' ;\nB : 'b' ;\n",
        "grammar S;\nr : ((A?))? B ;\nA : 'a' ;\nB : 'b' ;\n",
        // The fold mints an Optional itself, so it has to normalise like any
        // other: `( X | )` where `X` is already a repeat is a repeat over a
        // repeat, the shape lowering cannot name.
        "grammar S;\nr : ( A? | ) B ;\nA : 'a' ;\nB : 'b' ;\n",
        "grammar S;\nr : ( | A? ) B ;\nA : 'a' ;\nB : 'b' ;\n",
        "grammar S;\nr : ( A* | ) B ;\nA : 'a' ;\nB : 'b' ;\n",
        "grammar S;\nr : ( A+ | ) B ;\nA : 'a' ;\nB : 'b' ;\n",
        // Spelled directly, with no fold involved.
        "grammar S;\nr : (A*)? B ;\nA : 'a' ;\nB : 'b' ;\n",
        "grammar S;\nr : (A+)? B ;\nA : 'a' ;\nB : 'b' ;\n",
        // A closure over a repeat body reaches here whenever that body is
        // non-nullable, which is exactly what the epsilon-closure check lets
        // through — so the collapse cannot assume the outer one is an Optional.
        "grammar S;\nr : (A+)* B ;\nA : 'a' ;\nB : 'b' ;\n",
        "grammar S;\nr : (A+)+ B ;\nA : 'a' ;\nB : 'b' ;\n",
    ];
    for let src of &sources {
        let mut g = parse(*src).unwrap();
        canonicalize_empty_alt_groups(&mut g);
        assert_canonical_shape(&g);
        assign_atn_call_sites(&mut g);
        let lit = collect_literal_tokens(&g.parser_rules);
        let lowered = lower(&g, &lit);

        if let Simple(s) = &lowered.parser_rules[0] {
            if let Repeat(rep) = &s.body.ops[0] {
                assert !rep.body matches { Repeat(_) }, "nested Repeat survived";
            } else {
                panic(`expected Op::Repeat for: ${*src}`);
            }
        } else {
            panic("expected Rule::Simple");
        }
    }
}

test "lower Optional Repeat over a token-only Group inner stays Plain" {
    // `r : (X | Y | Z)? W ;` — every alternative is one token, so scanning
    // the body is the same test as peeking one token. The scan guard would
    // emit three one-token scans to answer what `first_check_str` answers
    // with a single kind check.
    let mut g = parse("grammar S;\nr : (X | Y | Z)? W ;\nX : 'x' ;\nY : 'y' ;\nZ : 'z' ;\nW : 'w' ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);

    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            assert rep.strategy matches { Plain }, "expected RepeatStrategy::Plain for a token-only Group inner";
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
    for let d of &lowered.diagnostics {
        assert !d.kind matches { OptionalScanGuardFallback };
    }
}

test "lower Optional Repeat over a token-only Group containing EOF keeps the scan guard" {
    // `r : (X | EOF)? ;` — `p.peek_kind()` reports `TK_EOF` past the end of
    // the stream while a scan fails there, so the peek is not the scan's
    // answer and the guard has to stay.
    let mut g = parse("grammar S;\nr : (X | EOF)? ;\nX : 'x' ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);

    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            assert rep.strategy matches { OptionalScanGuard }, "expected the EOF alternative to keep RepeatStrategy::OptionalScanGuard";
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Optional Repeat with many optionals does not enumerate 2^n shapes" {
    // A single-alt group with many nested Optionals would make
    // `try_optional_shape_lookahead` enumerate 2^n shapes (and `1 << n`
    // overflows i32 at n >= 31). Past the cap it must fall back to the
    // scan-guard strategy instead of selecting OptionalShapeLookahead.
    let mut inner_elems: List<Element> = [];
    for let mut i = 0; i < 12; i += 1 {
        inner_elems.push(Element::Repeat(RepeatElement {
            kind: RepeatKind::Optional,
            element: Element::TokenRef(TokenRefElement::new(`T${i}`)),
            non_greedy: false,
        }));
    }
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::Group(GroupElement::new([alt(inner_elems)])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let OptionalShapeLookahead(_) = &rep.strategy {
                panic("expected a fallback strategy, not 2^12-shape OptionalShapeLookahead");
            } else {
                assert true;
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat over General Group inner uses speculative group_counter id" {
    // `r : (stmt | INT INT)+ ; stmt : ID ;`
    // The General Group inside the Repeat gets group_index = 0
    // (the per-rule counter starts at 0 in alt 0). The Repeat's
    // outer struct field is `group_0_list` (Plus → `_list` suffix
    // on the General-Group base `group_<idx>`).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Plus,
                        element: Element::Group(GroupElement::new([
                            alt([Element::RuleRef(RuleRefElement::new("stmt"))]),
                            alt([
                                Element::TokenRef(TokenRefElement::new("INT")),
                                Element::TokenRef(TokenRefElement::new("INT")),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            // Outer field uses speculative counter id 0.
            assert rep.field == "group_0_list";
            // The inner Op is the General-Group, with the SAME id
            // (the inner lowering consumed the same counter value).
            if let Group(go) = &rep.body {
                if let General(gen) = &go.shape {
                    assert gen.group_index == 0;
                    assert gen.variant_type == "RGroup0";
                } else {
                    panic("expected nested General Group");
                }
            } else {
                panic("expected Op::Group inside Repeat");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat with list-label inner uses label name as outer field" {
    // `r : (names+=ID)* ;` — `+=` inside a `*` Repeat. The Repeat
    // becomes the array; the label name `names` IS the outer
    // struct field (no `_list` suffix).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Label(LabelElement::new(
                            "names",
                            true,
                            Element::TokenRef(TokenRefElement::new("ID")),
                        )),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            // The Repeat's outer field is `names`, not `id_list`.
            assert rep.field == "names";
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Transparent Group does not contribute a CST field" {
    // `r : (INT) ;` — Transparent group with a single leaf inner.
    // The wrapper has no CST struct slot of its own: `is_storable_group`
    // is false for this 1-alt-1-element shape, and lower's enumeration
    // must agree so the struct emit has the fields the parser assigns.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt([Element::Group(GroupElement::new([alt([Element::TokenRef(TokenRefElement::new("INT"))])]))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span] — the Transparent group does not surface a field.
        assert s.body.fields.len() == 1, "expected 1 field (span only)";
        if let Span = &s.body.fields[0].kind {
            assert true;
        } else {
            panic("expected leading Span field");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

/// The surface `RuleRefElement.atn_call_site` id (assigned by
/// `assign_atn_call_sites`) must thread onto the lowered `RuleCallOp` so
/// codegen can push the call's exact ATN return state (P4.2b).
fn rule_call_site(op: &Op) -> i32 {
    if let RuleCall(rc) = op {
        return rc.atn_call_site;
    }
    return -2;
}

test "atn_call_site threads from surface RuleRef to lowered RuleCallOp" {
    let mut g = parse("grammar S;\na : b c ;\nb : 'x' ;\nc : 'y' ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);
    // `a : b c` lowers to Simple with two top-level RuleCalls; the
    // depth-first call-site numbering gives a->b = 0, a->c = 1.
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 2, "rule a should have 2 ops";
        assert rule_call_site(&s.body.ops[0]) == 0, "a's call to b is call site 0";
        assert rule_call_site(&s.body.ops[1]) == 1, "a's call to c is call site 1";
    } else {
        panic("rule a should lower to Simple");
    }
}

test "a wildcard alt keeps the group off the Direct dispatch" {
    // `(assign | .)`: the wildcard alt's static first set is empty, so the
    // disjointness test reads it as its own token-led branch and the Direct
    // chain gives it an unreachable empty-token branch. Its real first set is
    // universal, so the decision belongs to the scan tournament.
    let mut g = parse("grammar S;\na : (assign | .) EOF ;\nassign : ID '=' ID ;\nID : [a-z]+ ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let Direct(dd) = &go.dispatch {
                for let b of &dd.branches {
                    assert !alt_class_first_set(&b.alt_class).is_empty();
                }
                panic("expected a scan Tournament for a group holding a wildcard alt");
            }
        } else {
            panic("expected the group op first");
        }
    } else {
        panic("rule a should lower to Simple");
    }
}

test "a prefix alt's scan operand climbs from the parse operand's precedence" {
    let mut g = parse("grammar S;\ne : e '*' e | '-' e | e '+' e | INT ;\nINT : [0-9]+ ;\n").unwrap();
    assign_atn_call_sites(&mut g);
    let lit = collect_literal_tokens(&g.parser_rules);
    let lowered = lower(&g, &lit);
    let LeftRecursive(l) = &lowered.parser_rules[0] else {
        panic("rule e should lower to LeftRecursive");
    };
    let prefix = &l.atom.alts[0];
    assert prefix.prefix_self_ref_min_prec == 2;
    let RuleCall(parse_rc) = &prefix.ops[1] else {
        panic("parse operand should be a RuleCall");
    };
    let RuleCall(scan_rc) = &l.atom.scan_alts[0].elements[1] else {
        panic("scan operand should be a RuleCall");
    };
    assert parse_rc.min_prec_arg == Option::Some(2);
    assert scan_rc.min_prec_arg == parse_rc.min_prec_arg;
}

// ===========================================================================
// `lexer_gen.wado`. The focus is anonymous-literal hoisting: parser-rule
// literals like `'x'` that ANTLR4 auto-promotes to anonymous lexer tokens must
// be discovered by `collect_literal_tokens` regardless of which IR transformer
// (`Not`, `Label`, `Group`, `Repeat`) wraps them. `gen_token_constants` also
// handles `-> type(N)` numeric overrides.
// ===========================================================================

use { count_occurrences } from "../tests/support/text.wado";
use { parse_grammar, lexer_dump } from "../tests/support/fixtures.wado";
use {
    gen_token_constants,
    gen_lexer,
    lexer_try_fn_name,
    lexer_mode_attr_use,
    LitToken,
    compute_elem_first_chars,
    resolve_ci,
    lit_name,
    fold_range_ci,
    folded_range_contains,
} from "./lexer_gen.wado";
use { CharRange } from "./ir.wado";
use { CodeWriter } from "lib:wadopoet";
use { MemberDecls, MemberField, MemberMethod } from "./java2wado/jmembers.wado";
use { SuperOp } from "./superclass.wado";
use { HashMap } from "core:collections";

fn const_names(lits: &List<LitToken>) -> List<String> {
    let mut out: List<String> = [];
    for let l of lits {
        out.push(l.const_name);
    }
    out.sort();
    return out;
}

test "collect_literal_tokens: plain top-level literals" {
    let g = parse_grammar("grammar T; a : 'x' 'y' ;");
    let lits = collect_literal_tokens(&g.parser_rules);
    let names = const_names(&lits);
    assert names.len() == 2;
    assert names[0] == "TK_LIT_x";
    assert names[1] == "TK_LIT_y";
}

test "collect_literal_tokens: a symbol word spelling a literal is disambiguated" {
    let g = parse_grammar("grammar T; a : '<' 'LT' ;");
    let names = const_names(&collect_literal_tokens(&g.parser_rules));
    assert names == ["TK_LIT_LT", "TK_LIT_LT_2"] as List<String>;
}

test "collect_literal_tokens: literals inside Group alternatives" {
    // `('x' | 'y')` — Group with two single-literal alts. The walker
    // already handles this through the `Group` arm.
    let g = parse_grammar("grammar T; a : ('x' | 'y') 'z' ;");
    let lits = collect_literal_tokens(&g.parser_rules);
    let names = const_names(&lits);
    assert names.len() == 3;
    assert names[0] == "TK_LIT_x";
    assert names[1] == "TK_LIT_y";
    assert names[2] == "TK_LIT_z";
}

test "collect_literal_tokens: literal inside Not — single token" {
    // `~'x'` — the canonical complement-of-a-literal shape. Source:
    // ANTLR4 runtime-testsuite descriptor Sets/ParserNotToken.txt.
    // The literal `'x'` defines the *exclusion* token, so it still
    // needs an anonymous TK_LIT_x token in the lexer for the runtime
    // `expect_not` call to reference.
    let g = parse_grammar("grammar T; a : ~'x' 'z' ;");
    let lits = collect_literal_tokens(&g.parser_rules);
    let names = const_names(&lits);
    assert names.len() == 2, "expected ['TK_LIT_x', 'TK_LIT_z']";
    assert names[0] == "TK_LIT_x";
    assert names[1] == "TK_LIT_z";
}

test "collect_literal_tokens: literals inside Not(Group(...)) — multi-alt set" {
    // `~('x'|'y')` — Sets/ParserNotSet.txt. The walker must descend
    // through the Not into the inner Group.
    let g = parse_grammar("grammar T; a : ~('x' | 'y') 'z' ;");
    let lits = collect_literal_tokens(&g.parser_rules);
    let names = const_names(&lits);
    assert names.len() == 3;
    assert names[0] == "TK_LIT_x";
    assert names[1] == "TK_LIT_y";
    assert names[2] == "TK_LIT_z";
}

test "collect_literal_tokens: literal inside Label(Not(Literal)) — labeled complement" {
    // `t=~'x' 'z'` — Sets/ParserNotTokenWithLabel.txt. Label wraps Not
    // wraps Literal; both transformers must transparently recurse.
    let g = parse_grammar("grammar T; a : t=~'x' 'z' ;");
    let lits = collect_literal_tokens(&g.parser_rules);
    let names = const_names(&lits);
    assert names.len() == 2;
    assert names[0] == "TK_LIT_x";
    assert names[1] == "TK_LIT_z";
}

test "collect_literal_tokens: literal inside Wildcard is ignored" {
    // Wildcard `.` is its own atom and carries no literal. Including
    // it next to a literal verifies the walker doesn't get confused.
    let g = parse_grammar("grammar T; a : 'x' . ;");
    let lits = collect_literal_tokens(&g.parser_rules);
    let names = const_names(&lits);
    assert names.len() == 1;
    assert names[0] == "TK_LIT_x";
}

fn token_globals_for<S: AsStrSlice>(input: S) -> String {
    let g = parse_grammar(input);
    let lits = collect_literal_tokens(&g.parser_rules);
    let mut w = CodeWriter::new();
    gen_token_constants(&mut w, &g.lexer_rules, &lits);
    return w.to_string();
}

test "lexer_try_fn_name: rule name is case-preserved" {
    // `ID` and `Id` would both fold to `try_id` if lowercased, defining the
    // same function twice. Preserving case keeps them distinct without any
    // collision bookkeeping.
    assert lexer_try_fn_name("ID") == "try_ID";
    assert lexer_try_fn_name("Id") == "try_Id";
}

test "gen_lexer: case-colliding rule names emit distinct try fns" {
    let g = parse_grammar("lexer grammar T; ID : 'a' ; Id : 'b' ;");
    let lits: List<LitToken> = [];
    let mut w = CodeWriter::new();
    let atn_class = HashMap::<String, i32>::new();
    let fields: List<MemberField> = [];
    let methods: List<MemberMethod> = [];
    let members = MemberDecls { fields, methods };
    let no_ops: List<SuperOp> = [];
    gen_lexer(&mut w, &g, &lits, &atn_class, &members, false, "", &no_ops, &lexer_mode_attr_use(&g));
    let out = w.to_string();
    assert out.contains("fn try_ID(");
    assert out.contains("fn try_Id(");
}

fn lexer_source<S: AsStrSlice>(src: S) -> String {
    let g = parse_grammar(src);
    let lits: List<LitToken> = [];
    let mut w = CodeWriter::new();
    let atn_class = HashMap::<String, i32>::new();
    let fields: List<MemberField> = [];
    let methods: List<MemberMethod> = [];
    let members = MemberDecls { fields, methods };
    let no_ops: List<SuperOp> = [];
    gen_lexer(&mut w, &g, &lits, &atn_class, &members, false, "", &no_ops, &lexer_mode_attr_use(&g));
    return w.to_string();
}

test "gen_lexer: the first-char dispatch is one match, not an else-if chain" {
    let out = lexer_source("lexer grammar L; A : 'a' ; B : 'b' ; N : [0-9]+ ;");
    assert out.contains("match first_char {");
    assert !out.contains("if first_char matches");
}

test "gen_lexer: dispatch arms follow char order, not grammar order" {
    let out = lexer_source("lexer grammar L; B : 'b' ; A : 'a' ; C : 'c' ;");
    let a = out.find("'a' => {").unwrap();
    let b = out.find("'b' => {").unwrap();
    let c = out.find("'c' => {").unwrap();
    assert a < b < c;
}

test "gen_lexer: a dispatch with no wildcard rule still covers every char" {
    let out = lexer_source("lexer grammar L; A : 'a' ; B : 'b' ;");
    assert out.contains("_ => {},");
}

test "gen_lexer: a catch-all declared last runs once, after the dispatch" {
    let out = lexer_source("lexer grammar L; A : [a-f] '1' ; D : [h] [0-9] ; ANY : . ;");
    assert count_occurrences(&out, "= try_ANY(") == 1;
    assert out.find("if best_end <= start {").unwrap() < out.find("= try_ANY(").unwrap();
}

test "gen_lexer: a catch-all declared first stays in the arms it ties in" {
    let out = lexer_source("lexer grammar L; ANY : . ; A : [a-f] '1' ; D : [h] [0-9] ;");
    assert count_occurrences(&out, "= try_ANY(") == 3;
}

test "gen_lexer: an alternation of single chars is one class test" {
    let out = lexer_source("lexer grammar L; fragment D : [0-9] ; A : ('_' | D | 'a'..'c' | 'b') 'z' ;");
    assert out.contains("matches { b'0'..=b'9' | b'_' | b'a'..=b'c' }");
    assert !out.contains("alts_");
}

test "gen_lexer: an ASCII class reads one byte, any other class decodes a char" {
    let out = lexer_source("lexer grammar L; A : [a-z] ; B : [é] ; C : ~[a] ;");
    assert out.contains("if !(unchecked src.byte_at(pos) matches { b'a'..=b'z' }) { return -1; }\n    pos += 1;");
    assert out.contains(
        "if !(char_at(src, pos) matches { 'é' }) { return -1; }\n    pos = src.ceil_char_boundary(pos + 1);",
    );
    assert out.contains(
        "if (unchecked src.byte_at(pos) matches { b'a' }) { return -1; }\n    pos = src.ceil_char_boundary(pos + 1);",
    );
}

test "gen_lexer: a large class is one shared function, however many sites test it" {
    let set = "[a\\u00e0b\\u00e1c\\u00e2d\\u00e3e\\u00e4f\\u00e5g\\u00e6h\\u00e7i\\u00e8]";
    let out = lexer_source(`lexer grammar L; A : ${set} '1' ; B : ${set} '2' ; C : ${set}+ ;`);
    assert count_occurrences(&out, "fn in_char_set_0(c: char) -> bool {") == 1;
    assert count_occurrences(&out, "in_char_set_0(char_at(src, pos))") == 4;
    assert !out.contains("in_char_set_1");
}

test "gen_lexer: arm scoring matches the suffix at one site, whatever the arm count" {
    let out = lexer_source("lexer grammar L; I : ('a' | 'ab' | 'abc') 'bcd' ;");
    assert count_occurrences(&out, "unchecked src.byte_at(pos) != b'd'") == 1;
}

test "gen_lexer: an optional element's block is labelled as one, not as a loop" {
    let out = lexer_source("lexer grammar L; A : 'a' 'bc'? ;");
    assert out.contains("opt_0: {");
    assert !out.contains("rep_");
}

test "gen_lexer: a char that prints as nothing is spelled as its escape" {
    let out = lexer_source("lexer grammar L; WS : [\\u00A0\\u2000-\\u200A] ;");
    assert out.contains("matches { '\\u{a0}' | '\\u{2000}'..='\\u{200a}' }");
}

test "gen_lexer: a literal past ASCII is matched as its UTF-8 bytes, one test per char" {
    let out = lexer_source("lexer grammar L; BOM : '\\uFEFF' 'é' ;");
    assert out.contains(
        "if pos + 3 > src.len() || unchecked src.byte_at(pos) != b'\\xef' || unchecked src.byte_at(pos + 1) != b'\\xbb' || unchecked src.byte_at(pos + 2) != b'\\xbf' { return -1; }\n    pos += 3;",
    );
    assert out.contains("unchecked src.byte_at(pos) != b'\\xc3' || unchecked src.byte_at(pos + 1) != b'\\xa9'");
}

test "gen_lexer: a negated single char is one class test" {
    let out = lexer_source("lexer grammar L; S : '\"' ~'\"'* '\"' ;");
    assert out.contains("if (unchecked src.byte_at(pos) matches { b'\"' }) { break");
    assert !out.contains("not_");
}

test "gen_lexer: tail alternation of unequal length uses the longest-match emit" {
    // ANTLR4's lexer takes the longest arm (`I` matches `ab`, not `a`).
    let out = lexer_source("lexer grammar L; I : ('a' | 'ab') ; J : . ;");
    assert out.contains("alts_best_");
}

test "gen_lexer: tail alternation of equal length keeps the first-match emit" {
    // Every arm consumes the same fixed count, so longest and first-match
    // coincide; the cheaper emit stays byte-identical for the common shape.
    let out = lexer_source("lexer grammar L; WS : ('  ' | '\n\n') ;");
    assert !out.contains("alts_best_");
    assert out.contains("alts_done_");
}

test "gen_lexer: first-match arms are siblings, not a cascade" {
    let two = lexer_source("lexer grammar L; K : ('a' | 'b') 'z' ;");
    let five = lexer_source("lexer grammar L; K : ('a' | 'b' | 'c' | 'd' | 'e') 'z' ;");
    assert max_indent(&five) == max_indent(&two);
}

fn max_indent<S: AsStrSlice>(source: S) -> i32 {
    let mut deepest = 0;
    for let line of source.lines() {
        let indent = line.len() - line.trim_start().len();
        if indent > deepest {
            deepest = indent;
        }
    }
    return deepest;
}

test "gen_lexer: alternation followed by a suffix keeps the first-match emit" {
    // A longer arm could strand the suffix, and Gale never backtracks.
    let out = lexer_source("lexer grammar L; K : ('x' | 'xy') 'yz' ;");
    assert !out.contains("alts_best_");
}

test "gen_lexer: tail alternation with a predicate is still scored by length" {
    // ANTLR4's lexer takes the longest arm, and a predicate says whether its
    // own arm matches — never how the arms compare on length. The carve-out in
    // `lexer_alts_contested` answers the *routing* question, where a predicate is
    // disqualifying because `latn_match` cannot run one; the emit runs it while
    // scoring.
    let out = lexer_source("lexer grammar L; options { language = Wado; } I : ('a' | 'ab' { false }?) ;");
    assert out.contains("alts_best_");
}

test "gen_token_constants: more rules numbered after non-more rules (ANTLR4 order)" {
    // ANTLR4's SemanticPipeline.assignLexerTokenTypes assigns token types to
    // non-fragment rules WITHOUT a `more` / `type(...)` command first, in
    // declaration order, then numbers the remaining `more` / `type` rules.
    // A `more` rule declared first must therefore receive the highest type.
    let out = token_globals_for("lexer grammar L; A: 'a' -> more; B: 'b'; C: 'c';");
    assert out.contains("global TK_B: i32 = 0");
    assert out.contains("global TK_C: i32 = 1");
    assert out.contains("global TK_A: i32 = 2");
}

test "gen_token_constants: numeric type(N) override emits TK_<N> = N - 1" {
    let out = token_globals_for("lexer grammar L; T_FFFF: 'FFFF' -> type(65535);");
    assert out.contains("global TK_T_FFFF: i32 = 0");
    assert out.contains("global TK_EOF: i32 = 1");
    assert out.contains("global TK_ERROR: i32 = 2");
    assert out.contains("global TK_65535: i32 = 65534");
}

test "gen_token_constants: duplicate type(N) overrides emit one global" {
    let out = token_globals_for("lexer grammar L; A: 'a' -> type(99); B: 'b' -> type(99);");
    assert count_occurrences(&out, "global TK_99:") == 1;
}

test "gen_token_constants: type(0) is skipped" {
    let out = token_globals_for("lexer grammar L; A: 'a' -> type(0);");
    assert !out.contains("TK_0:");
}

test "gen_token_constants: named type(X) override emits no extra global" {
    let out = token_globals_for("lexer grammar L; A: 'a' -> type(B); B: 'b';");
    // Expected globals: TK_A, TK_B, TK_EOF, TK_ERROR.
    assert count_occurrences(&out, "global TK_") == 4;
}

test "gen_token_constants: user ERROR rule suppresses sentinel emit" {
    let out = token_globals_for("grammar T; a : ID; ID: [a-z]+; ERROR: .;");
    assert count_occurrences(&out, "global TK_ERROR:") == 1;
}

test "gen_token_constants: TK_EOF sentinel is always emitted" {
    let out = token_globals_for("grammar T; a : ID; ID: [a-z]+;");
    assert count_occurrences(&out, "global TK_EOF:") == 1;
}

fn ranges_contain(ranges: &List<[char, char]>, c: char) -> bool {
    for let r of ranges {
        if c >= r[0] && c <= r[1] {
            return true;
        }
    }
    return false;
}

fn rule_first_chars<S: AsStrSlice>(g: &Grammar, name: S) -> [bool, List<[char, char]>] {
    for let rule of &g.lexer_rules {
        if rule.name == name.to_string() {
            let mut out: List<[char, char]> = [];
            let r = compute_elem_first_chars(&rule.body, &g.lexer_rules, &mut out, false, &g.options);
            return [r.0, out];
        }
    }
    panic(`lexer rule ${name} not found`);
}

/// `rule_first_chars` with the rule's real folding, as `build_rule_try_call`
/// resolves it. Needed to exercise a per-rule `caseInsensitive`.
fn rule_first_chars_resolved<S: AsStrSlice>(g: &Grammar, name: S) -> [bool, List<[char, char]>] {
    for let rule of &g.lexer_rules {
        if rule.name == name.to_string() {
            let mut out: List<[char, char]> = [];
            let ci = resolve_ci(&g.options, &rule.options);
            let r = compute_elem_first_chars(&rule.body, &g.lexer_rules, &mut out, ci, &g.options);
            return [r.0, out];
        }
    }
    panic(`lexer rule ${name} not found`);
}

test "compute_elem_first_chars: nullable leading element keeps a bounded first set" {
    // The nullable `'-'?` adds `-` and lets the walk continue into `[0-9]`; a
    // wildcard rule would dispatch `try_NUMBER` into every token branch.
    let g = parse_grammar("grammar T; SEMI : ';' ; NUMBER : '-'? [0-9]+ ;");
    let [is_wildcard, first] = rule_first_chars(&g, "NUMBER");
    assert !is_wildcard, "NUMBER must not be classified as wildcard";
    assert ranges_contain(&first, '-'), "first set must include '-'";
    assert ranges_contain(&first, '0') && ranges_contain(&first, '9'), "first set must include 0-9";
    assert !ranges_contain(&first, ';'), "first set must not include unrelated ';'";
}

test "compute_elem_first_chars: negated class is genuinely wildcard" {
    let g = parse_grammar("grammar T; x : TILDE ; TILDE : ~[a] ;");
    let [is_wildcard, _first] = rule_first_chars(&g, "TILDE");
    assert is_wildcard, "negated class must remain wildcard";
}

test "compute_elem_first_chars: a non-fragment rule reference narrows the set" {
    // RustLexer's shape: an alternation of three plain (non-fragment) rules,
    // each opening on `/`.
    let g = parse_grammar(
        "grammar T; x : ANY_COMMENT ; ANY_COMMENT : (LINE | BLOCK) ; LINE : '//' ~[\\r\\n]* ; BLOCK : '/*' .*? '*/' ;",
    );
    let [is_wildcard, first] = rule_first_chars(&g, "ANY_COMMENT");
    assert !is_wildcard, "an alternation of plain rules is not wildcard";
    assert ranges_contain(&first, '/'), "first set must include '/'";
    assert !ranges_contain(&first, 'a'), "first set must not include unrelated 'a'";
}

test "compute_elem_first_chars: a rule cycle stays wildcard" {
    // `BLOCK` <-> `INNER` recurses, so the walk cannot enumerate the set.
    let g = parse_grammar("grammar T; x : BLOCK ; BLOCK : (INNER | 'b') ; INNER : (BLOCK | 'i') ;");
    let [is_wildcard, _first] = rule_first_chars(&g, "BLOCK");
    assert is_wildcard, "a reference cycle must fall back to wildcard";
}

test "compute_elem_first_chars: a callee inheriting the grammar's case stays wildcard" {
    // `INNER` inherits the grammar's `caseInsensitive` and `OUTER` overrides
    // it, so walking `INNER` with the caller's folding loses `K`.
    let g = parse_grammar(
        "grammar T; options { caseInsensitive = true; } x : OUTER ; OUTER options { caseInsensitive = false; } : INNER '!' ; INNER : 'k' '#' ;",
    );
    let [is_wildcard, _first] = rule_first_chars_resolved(&g, "OUTER");
    assert is_wildcard, "a callee folding the grammar-level case must fall back to wildcard";
}

test "compute_elem_first_chars: an inlined fragment folds with its caller" {
    // A non-recursive fragment is inlined with the caller's `ci`, so the walk
    // reproduces it exactly and the case gate must not fire.
    let g = parse_grammar(
        "grammar T; options { caseInsensitive = true; } x : OUTER ; OUTER options { caseInsensitive = false; } : F '!' ; fragment F : 'k' ;",
    );
    let [is_wildcard, first] = rule_first_chars_resolved(&g, "OUTER");
    assert !is_wildcard, "an inlined fragment is reproducible, not wildcard";
    assert ranges_contain(&first, 'k'), "first set must include 'k'";
    assert !ranges_contain(&first, 'K'), "the caller folds no case, so 'K' is not in its set";
}

test "compute_elem_first_chars: a callee folding a different case stays wildcard" {
    let g = parse_grammar(
        "grammar T; x : OUTER ; OUTER : INNER ; INNER options { caseInsensitive = true; } : 'k' ;",
    );
    let [is_wildcard, _first] = rule_first_chars(&g, "OUTER");
    assert is_wildcard, "a case-insensitive callee must fall back to wildcard";
}

test "lit_name renders a grammar literal the way ANTLR4's vocabulary does" {
    assert `${lit_name("+")}` == "'+'";
    assert `${lit_name("and")}` == "'and'";
    // Printable non-ASCII stays verbatim, as in any Wado literal Gale emits.
    assert `${lit_name("あ")}` == "'あ'";
    // `LitToken.text` has its escapes resolved, so a real newline goes back to
    // `\n` — a readable rendering, not a round-trip.
    let mut nl = String::new();
    nl.push('\n');
    assert `${lit_name(nl)}` == "'\\n'";
    // The delimiter it escapes is `'`, not `"`.
    let mut apos = String::new();
    apos.push('i');
    apos.push('\'');
    apos.push('s');
    assert `${lit_name(apos)}` == "'i\\'s'";
    let mut quote = String::new();
    quote.push('"');
    assert `${lit_name(quote)}` == "'\"'";
}

test "folded_range_contains agrees with the ranges fold_range_ci builds" {
    let bounds: List<[char, char]> = [
        ['a', 'a'],
        ['Q', 'Q'],
        ['0', '9'],
        ['A', 'z'],
        ['_', 'c'],
        ['X', 'b'],
        ['\u{00C0}', '\u{00FF}'],
    ];
    for let [start, end] of bounds {
        let mut folded: List<CharRange> = [];
        fold_range_ci(start, end, &mut folded);
        for let code of 0..<0x100 {
            let c = char::from_u32(code as u32);
            let built = folded.iter_ref().any(|r| r.start <= c <= r.end);
            assert folded_range_contains(start, end, true, c) == built;
            assert folded_range_contains(start, end, false, c) == (start <= c <= end);
        }
    }
}

// ===========================================================================
// `render_lexer_dump`: each grammar forces one emit strategy, and the report
// must say why the cheaper one was not available.
// ===========================================================================

test "lexer dump names the grammar and summarizes strategies" {
    let report = lexer_dump("grammar T;
r : ID ;
ID : [a-z]+ ;");

    assert report.contains("grammar T (lexer)");
    assert report.contains("rule ID — matcher try_ID");
    assert report.contains("strategies:");
    assert report.contains("routes: matcher 1");
}

test "lexer dump reports a tail alternation as maximal munch" {
    // `('0' | [0-9] [0-9]*)` — the arms reach different lengths from the same
    // char, and nothing follows, so every arm is scanned and the longest wins.
    let report = lexer_dump("grammar T;
r : INT ;
INT : '0' | [0-9] [0-9]* ;");

    assert report.contains("maximal munch");
    assert report.contains("maximal munch 1");
}

test "lexer dump reports a tail alternation of disjoint arms as first-match" {
    // Only one arm can start at any char, so it is the only one that can match.
    let report = lexer_dump("grammar T;
r : INT ;
INT : '0' | [1-9] [0-9]* ;");

    assert report.contains(
        "alternation ('0' | [1-9] [0-9]*) — first-match: no two arms can match at the same position",
    );
    assert report.contains("maximal munch 0");
}

test "lexer dump reads a fragment's first chars when telling arms apart" {
    let report = lexer_dump("grammar T;
r : NUM ;
fragment D : [0-9] ;
NUM : D+ ('.' D*)? | '.' D+ ;");

    assert report.contains("— first-match: no two arms can match at the same position");
    assert report.contains("maximal munch 0");
}

test "lexer dump reports equal-length arms as first-match" {
    // Both arms consume exactly one char, so longest and first-match coincide
    // and the cheaper emit stays byte-identical.
    let report = lexer_dump("grammar T;
r : AB ;
AB : 'a' | 'b' ;");

    assert report.contains("first-match: every arm consumes the same fixed length");
}

test "lexer dump reports equal-length arms before a suffix as first-match" {
    let report = lexer_dump("grammar T;
r : OP ;
OP : ('ab' | 'cd') 'e' ;");

    assert report.contains(
        "alternation ('ab' | 'cd') then 'e' — first-match: every arm consumes the same fixed length",
    );
    assert report.contains("alternation + suffix: first-match 1, arm scoring 0");
}

test "lexer dump names an empty arm" {
    // The empty arm can match where the others do, so the arms are scored.
    let report = lexer_dump("grammar T;
r : NUM ;
NUM : [0-9]+ ('e' ('+' | '-' | ) [0-9]+)? ;");

    assert report.contains("alternation ('+' | '-' | ε) then [0-9]+ — arm scoring");
}

test "lexer dump shortens a class of many ranges" {
    let report = lexer_dump("grammar T;
r : ID ;
ID : [a-zA-Z_$0-9\\u00C0-\\u00D6\\u00D8-\\u00F6]+ ;");

    assert report.contains("repeat [a-zA-Z_$0-9À-Ö…]+ — plain: nothing follows the repeat");
}

test "lexer dump says a predicate after a construct makes it consult what follows" {
    // `[0-9]` cannot eat the `'z'` and nothing follows the alternation, so only
    // the predicate has a say in where each stops.
    let report = lexer_dump("grammar T;
r : S I ;
S : 'a' [0-9]+ {true}? 'z' ;
I : ('a' | 'ab') {true}? ;");

    assert report.contains("repeat [0-9]+ then 'z' — lookahead-aware");
    assert report.contains("alternation ('a' | 'ab') — arm scoring");
}

test "lexer dump leaves a repeat plain when a predicate follows only behind a char it cannot eat" {
    // The predicate runs only after `'z'`, which `[0-9]` cannot eat, so the loop
    // already stops where the predicate could run. An optional `'z'` lets it run
    // right where the loop stops.
    let report = lexer_dump("grammar T;
r : S O ;
S : 'a' [0-9]+ 'z' {true}? ;
O : 'b' [0-9]+ 'z'? {true}? ;");

    assert report.contains("repeat [0-9]+ then 'z' — plain: the inner cannot eat the suffix's first char");
    assert report.contains("repeat [0-9]+ then 'z'? — lookahead-aware");
}

test "lexer dump gives a repeat over a string the lookahead-aware scan" {
    let report = lexer_dump("grammar T;
r : S ;
S : 'x' ('ab')* 'ab' ;");

    assert report.contains("repeat ('ab')* then 'ab' — lookahead-aware");
}

test "lexer dump escapes a quote and an unprinted char" {
    let report = lexer_dump("grammar T;
r : CHR WS ;
CHR : '\\'' (~['\\\\] | '\\\\' .)+ '\\'' ;
WS : [ \\t\\f]+ -> skip ;");

    assert report.contains("then '\\'' — ");
    assert report.contains("repeat [ \\t\\u{c}]+");
}

test "lexer dump reports a keyword whose carrier is built of fragments and ranges" {
    let report = lexer_dump("grammar T;
r : IF ID ;
IF : 'if' ;
ID : LETTER (LETTER | '0'..'9')* ;
fragment LETTER : 'a'..'z' | '_' ;");

    assert report.contains("rule IF — keyword classifier (carrier ID)");
    assert report.contains("set (LETTER | '0'..'9') — one class test of 3 ranges: every arm is one char");
}

test "lexer dump reports a called rule's alternation as not-tail" {
    // `B` is entered from `A` with `'z'` still to consume, so its body
    // alternation cannot take maximal munch however long an arm reaches. It
    // reaches itself, so it stays a call rather than splicing into `A`.
    let report = lexer_dump("grammar T;
r : A ;
A : B 'z' ;
B : 'a' | 'ab' | 'c' B ;");

    assert report.contains("first-match: not in tail position");
}

test "lexer dump reports a greedy repeat whose inner cannot eat the suffix" {
    // `~'*'` is provably disjoint from the `'*'`-led suffix, so the plain loop
    // already stops where the suffix must start.
    let report = lexer_dump("grammar T;
r : CMT ;
CMT : '/*' ~'*'* '*/' ;");

    assert report.contains("repeat ~'*'* then '*/' — plain: the inner cannot eat the suffix's first char");
    assert report.contains("plain 1, lookahead-aware 0");
}

test "lexer dump reports a lookahead-aware greedy repeat" {
    // `.` matches the `'c'` the suffix needs, so a plain greedy loop would eat
    // it and strand the suffix at end-of-input.
    let report = lexer_dump("grammar T;
r : S ;
S : 'a' .+ 'c' ;");

    assert report.contains("lookahead-aware: the inner can eat a char the suffix needs");
    assert report.contains("lookahead-aware 1");
}

test "lexer dump reports a non-greedy repeat" {
    let report = lexer_dump("grammar T;
r : CMT ;
CMT : '/*' .*? '*/' ;");

    assert report.contains("non-greedy: min-match loop");
    assert report.contains("non-greedy repeat: 1");
}

test "lexer dump reports arm scoring for an alternation with a suffix" {
    // `('a' | 'ab') 'bc'` on `abbc` needs the second arm, which is neither the
    // first to match nor decidable without the suffix.
    let report = lexer_dump("grammar T;
r : I ;
I : ('a' | 'ab') 'bc' ;");

    assert report.contains("alternation ('a' | 'ab') then 'bc' — arm scoring");
    assert report.contains("arm scoring 1");
}

test "lexer dump reports a scored alternation's suffix once" {
    // A scored alternation only peeks its suffix and the sequence commits it, so
    // reporting it from both would double the constructs and the summary's tally.
    let report = lexer_dump("grammar T;
r : I ;
I : ('a' | 'ab') [0-9]* 'z' ;");

    assert count_occurrences(&report, "repeat [0-9]* then 'z'") == 1;
    assert report.contains("greedy repeat: plain 1");
}

test "lexer dump sees a predicate re-based onto a non-greedy repeat's rest" {
    // The non-greedy emit carries the alt's later predicates onto its rest, so the
    // `{true}?` lands after the `[0-9]*` and makes that repeat consult it.
    let report = lexer_dump("grammar T;
r : S ;
S : 'a' .*? [0-9]* {true}? 'x' ;");

    assert report.contains("repeat [0-9]* then 'x' — lookahead-aware");
    assert report.contains("plain 0, lookahead-aware 1");
}

test "lexer dump reports disjoint arms with a suffix as first-match" {
    // The arms cannot both match at the same position, so which one wins is
    // not a decision and the scoring scan is not needed.
    let report = lexer_dump("grammar T;
r : I ;
I : ('a' | 'bcd') 'z' ;");

    assert report.contains("first-match: no two arms can match at the same position");
}

test "lexer dump reports the keyword classifier and its carrier" {
    // `IF` is a fixed per-char pattern, reclassified out of a match by the
    // later, wider `ID`, which matches it in either case.
    let report = lexer_dump("grammar T;
r : IF ID ;
IF : [iI] [fF] ;
ID : [a-zA-Z]+ ;");

    assert report.contains("rule IF — keyword classifier (carrier ID)");
    assert report.contains("keyword classifier 1");
}

test "lexer dump keeps a keyword its carrier cannot match in every case on its own matcher" {
    let report = lexer_dump("grammar T;
r : IF ID ;
IF : [iI] [fF] ;
ID : [a-z]+ ;");

    assert report.contains("rule IF — matcher try_IF");
}

test "lexer dump reports a multi-char literal as a keyword" {
    let report = lexer_dump("grammar T;
r : AS ID ;
AS : 'as' ;
ID : [a-z]+ ;");

    assert report.contains("rule AS — keyword classifier (carrier ID)");
}

test "lexer dump reports a rule the shared literal matcher covers" {
    // A concatenated body is deduped, not aliased, so the literal covers it.
    let report = lexer_dump("grammar T;
r : 'xy' X ;
X : 'x' 'y' ;");

    assert report.contains("shared literal matcher (TK_LIT_xy)");
}

test "lexer dump reports a rule the parser also writes inline keeping its matcher" {
    let report = lexer_dump("grammar T;
r : 'x' X ;
X : 'x' ;");

    assert report.contains("rule X");
    assert !report.contains("shared literal matcher");
}

test "lexer dump reports an alternation of single chars as one set" {
    let report = lexer_dump("grammar T;
r : A ;
fragment D : [0-9] ;
A : ('_' | D) 'z' (D | 'x')* ;");

    assert report.contains("set ('_' | D) — one class test of 2 ranges");
    assert report.contains("set (D | 'x') — one class test of 2 ranges");
    assert report.contains("char set 2");
}

test "lexer dump reports a rule made of earlier rules as subsumed" {
    // Every match of `EITHER` is a match of `A` or `B` at the same length, and
    // both are declared first, so `EITHER` never wins and is not dispatched.
    let report = lexer_dump("grammar T;
r : A B EITHER ;
A : 'a' [0-9]* ;
B : 'b' ;
EITHER : (A | B) -> channel(HIDDEN) ;");

    assert report.contains("rule EITHER — subsumed by A, B: never the longest match");
    assert report.contains("subsumed 1");
}

test "lexer dump reports a rule an earlier rule offers whole as subsumed" {
    let report = lexer_dump("grammar T;
r : NUM ;
NUM : (DEC | HEX) 'u'? ;
DEC : [0-9]+ ;
HEX : '0x' [0-9a-f]+ ;
USE : NUM ;");

    assert report.contains(
        "rule DEC — subsumed by NUM: never the longest match + matcher try_DEC (another rule calls it)",
    );
    assert report.contains("rule HEX — subsumed by NUM");
    assert report.contains("rule USE — subsumed by NUM");
}

test "lexer dump keeps a rule an earlier rule offers only with a suffix" {
    // `NUM` needs its `'u'`, so a bare `DEC` match is not one of its matches.
    let report = lexer_dump("grammar T;
r : NUM ;
NUM : (DEC | HEX) 'u' ;
DEC : [0-9]+ ;
HEX : '0x' [0-9a-f]+ ;");

    assert report.contains("rule DEC — matcher try_DEC");
}

test "lexer dump keeps a rule whose subsumer carries a predicate" {
    let report = lexer_dump("grammar T;
r : NUM ;
NUM : {true}? DEC ;
DEC : [0-9]+ ;");

    assert report.contains("rule DEC — matcher try_DEC");
}

test "lexer dump keeps a rule made of later rules" {
    let report = lexer_dump("grammar T;
r : EITHER ;
EITHER : A | B ;
A : 'a' ;
B : 'b' ;");

    assert report.contains("rule EITHER — matcher try_EITHER");
}

test "lexer dump separates called, inlined and recursive fragments" {
    // `AB` before a suffix becomes a group scored against it, while both uses of
    // `CD` share one matcher. `P` carries a predicate, so it is inlined.
    let report = lexer_dump("grammar T;
r : N ;
N : NEST ;
fragment NEST : '(' NEST* ')' ;
fragment AB : 'a' | 'ab' ;
X : AB ;
Y : AB 'c' ;
fragment CD : 'c' 'd' ;
Z : CD ;
W : CD 'e' ;
fragment P : {true}? 'p' | 'pq' ;
PP : P ;");

    assert report.contains("rule NEST — recursive fragment: matcher try_NEST");
    assert report.contains("rule AB — fragment: a frag_ matcher per use context");
    assert report.contains("fragment matcher frag_tail_AB\n  alternation ('a' | 'ab') — maximal munch");
    assert report.contains("rule Y — matcher try_Y\n  alternation ('a' | 'ab') then 'c' — arm scoring");
    assert report.contains("fragment matcher frag_CD\n");
    assert report.contains("rule P — fragment: inlined at each use site");
    assert report.contains("  P › alternation ('p' | 'pq')");
    assert report.contains("called fragment 2 (2 frag_ matchers), inlined fragment 1, recursive fragment 1");
}

test "lexer dump reports a tokens-block entry as a virtual token" {
    let report = lexer_dump("grammar T;
tokens { VT }
r : ID ;
ID : [a-z]+ ;");

    assert report.contains("rule VT — virtual token: no text to match");
    assert report.contains("virtual 1");
}

test "lexer dump reports an ATN-class rule as routed to latn_match" {
    // A non-greedy repeat whose body recurses into its own rule is the class
    // static lexing cannot decide.
    let report = lexer_dump("grammar T;
r : CMT ;
CMT : '/*' (CMT | .)+? '*/' ;");

    assert report.contains("rule CMT — ATN-class: latn_match (latn rule 0)");
    assert report.contains("ATN-class 1");
}

test "lexer dump keeps a loop off the ATN when a negated fragment excludes the other arm's lead" {
    // JSON's STRING: `SAFE` excludes the `\\` every `ESC` starts with.
    let report = lexer_dump("grammar T;
r : STR ;
STR : '\"' (ESC | SAFE)* '\"' ;
fragment ESC : '\\\\' [\"\\\\nt] ;
fragment SAFE : ~[\"\\\\] ;");

    assert report.contains("rule STR — matcher try_STR");
    assert report.contains("ATN-class 0");
}

test "lexer dump reads a fragment in its caller's case-sensitive folding" {
    // Folded, `ESC` would lead with `U` too, which `SAFE` admits.
    let report = lexer_dump("grammar T;
r : STR ;
STR : '\"' (ESC | SAFE)* '\"' ;
fragment ESC : 'u' [0-9a-f] ;
fragment SAFE : ~[\"u] ;");

    assert report.contains("rule STR — matcher try_STR");
    assert report.contains("ATN-class 0");
}

test "lexer dump keeps a loop off the ATN when arms sharing a lead differ at the next char" {
    // Rust's STRING_LITERAL: every escape starts with `\\`, and none can stop there.
    let report = lexer_dump("grammar T;
r : STR ;
STR : '\"' (~[\"\\\\] | QUOTE_ESC | ASCII_ESC | '\\\\u{' [0-9a-f]+ '}')* '\"' ;
fragment QUOTE_ESC : '\\\\' ['\"] ;
fragment ASCII_ESC : '\\\\x' [0-7] [0-9a-f] | '\\\\' [nrt] ;");

    assert report.contains("rule STR — matcher try_STR");
    assert report.contains("ATN-class 0");
}

test "lexer dump routes a loop whose arms sharing a lead also share the next char" {
    let report = lexer_dump("grammar T;
r : STR ;
STR : '\"' (~[\"\\\\] | '\\\\' . | '\\\\x' [0-9a-f] [0-9a-f])* '\"' ;");

    assert report.contains("rule STR — ATN-class");
}

test "lexer dump routes a loop whose arm sharing a lead can stop after it" {
    let report = lexer_dump("grammar T;
r : STR ;
STR : '\"' (~[\"\\\\] | '\\\\' | '\\\\x' [0-9a-f])* '\"' ;");

    assert report.contains("rule STR — ATN-class");
}

test "lexer dump keeps a caseInsensitive loop off the ATN when a negated class excludes the other arm's lead" {
    let report = lexer_dump("grammar T;
options { caseInsensitive = true; }
r : STR ;
STR : '\"' ('\\\\' [nt] | ~[\"\\\\])* '\"' ;");

    assert report.contains("rule STR — matcher try_STR");
    assert report.contains("ATN-class 0");
}

test "lexer dump routes a caseInsensitive loop whose negated class admits the other arm's lead" {
    let report = lexer_dump("grammar T;
options { caseInsensitive = true; }
r : STR ;
STR : '\"' ('\\\\' [nt] | ~[\"])* '\"' ;");

    assert report.contains("rule STR — ATN-class");
}

test "lexer dump gives no matcher to a rule only an ATN-class rule calls" {
    // `latn_match` simulates what `RAW` and `CMT` reference itself, so neither
    // `CONTENT` nor `ANY_CMT` gets a `try_` matcher nothing would call.
    let report = lexer_dump("grammar T;
r : RAW | CMT ;
RAW : 'r' CONTENT ;
fragment CONTENT : '#' CONTENT '#' | '\"' .*? '\"' ;
CMT : '/*' (ANY_CMT | .)*? '*/' ;
ANY_CMT : CMT ;");

    assert report.contains("rule RAW — ATN-class");
    assert report.contains("rule CONTENT — recursive fragment: only latn_match reaches it, no matcher");
    assert report.contains("rule CMT — ATN-class");
    assert report.contains("rule ANY_CMT — subsumed by CMT: never the longest match\n");
}

test "lexer dump scores a predicate-carrying alternation by length" {
    // ANTLR4's lexer takes the longest arm, and a predicate says whether its own
    // arm matches, never how the arms compare on length.
    let report = lexer_dump("grammar T;
r : I ;
I : ('a' | {true}? 'ab') 'bc' ;");

    assert !report.contains("an arm carries a semantic predicate");
    assert report.contains("arm scoring");
}

test "lexer dump names a rule's constructs with its own element text" {
    let report = lexer_dump("grammar T;
r : WS ;
WS : [ \\t\\r\\n]+ -> skip ;");

    assert report.contains("repeat [ \\t\\r\\n]+");
    assert report.contains("plain: nothing follows the repeat");
}

// ===========================================================================
// `highlight_gen.wado`. `default_ids` is indexed by token kind, so its rows
// must follow the numbering `gen_token_constants` emits.
// ===========================================================================

use { alias_parser_literals } from "./ir.wado";
use { gen_highlight } from "./highlight_gen.wado";
use { parse_highlight_query } from "./highlight_query.wado";
use { Diagnostic, Diagnostics } from "./gir.wado";

/// The generated text and the diagnostics one query run produced.
fn highlight_run<S: AsStrSlice, S1: AsStrSlice>(input: S, query_src: S1) -> [String, List<Diagnostic>] {
    let mut g = parse_grammar(input);
    // Mirror `generate()`, whose `lit_tokens` never see an aliased text.
    alias_parser_literals(&mut g);
    let lits = collect_literal_tokens(&g.parser_rules);
    let query = parse_highlight_query(&query_src).unwrap();
    let mut diagnostics = Diagnostics {};
    let mut w = CodeWriter::new();
    gen_highlight(&mut w, &g, &lits, &query, &GenSettings {}, &mut diagnostics);
    return [
        w.to_string(),
        diagnostics.to_list(),
    ];
}

fn highlight_output_q<S: AsStrSlice, S1: AsStrSlice>(input: S, query_src: S1) -> String {
    return highlight_run(input, query_src).0;
}

fn highlight_output<S: AsStrSlice>(input: S) -> String {
    return highlight_output_q(input, "");
}

fn assert_one_warning<S: AsStrSlice>(run: &[String, List<Diagnostic>], needle: S) {
    assert run.1.len() == 1, "expected one diagnostic";
    assert run.1[0].message.contains(needle);
}

/// A rule capture the generator cannot expand: one warning, no overrides.
fn assert_capture_refused(run: &[String, List<Diagnostic>]) {
    assert_one_warning(run, "single token");
    assert !run.0.contains("RuleCapture {");
}

test "highlight defaults: more rule rows are deferred like token numbering" {
    // `A -> more` gets a deferred (high) token id in gen_token_constants,
    // so its defaults row must also come after the non-deferred rules.
    let out = highlight_output("grammar T;
r : B ;
A : 'a' -> more ;
B : 'b' ;
WS : ' ' -> skip ;
");
    let a = out.find("// TK_A").expect(out);
    let b = out.find("// TK_B").expect(out);
    let ws = out.find("// TK_WS").expect(out);
    assert b < a, "TK_B row must precede deferred TK_A row";
    assert ws < a, "TK_WS row must precede deferred TK_A row";
}

test "highlight fn: lexer-only grammar is tokenize-only (no walk_ call)" {
    // A lexer-only grammar generates no `parse`, so a `highlight_walk(...)` call
    // would not compile.
    let out = highlight_output("lexer grammar L;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert !out.contains("walk_(");
    assert out.contains("tokenize(input)");
}

test "highlight defaults: user ERROR rule suppresses the sentinel row" {
    // `gen_token_constants` emits no `TK_ERROR` sentinel here, so a defaults row
    // for one would shift every later row by one.
    let out = highlight_output("grammar T;
r : B ;
B : 'b' ;
ERROR : . ;
");
    let n = count_occurrences(&out, "// TK_ERROR");
    assert n == 1, "expected exactly one TK_ERROR row (the user rule)";
}

test "query maps a token to its default capture" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(B) @keyword");
    assert out.contains("0,  // TK_B @keyword");
}

test "query maps a literal token to its default capture" {
    let out = highlight_output_q("grammar T;
r : 'let' B ;
B : 'b' ;
", "\"let\" @keyword");
    assert out.contains(" @keyword\n");
}

test "highlight fn: a grammar with a parser walks the CST, query or not" {
    // Only an override reads the walk's rule stack, but a query without one is
    // walked too, so the highlight fn keeps one shape.
    let plain = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(B) @keyword");
    assert plain.contains("highlight_walk(&mut visitor");
    assert plain.contains("hl_cover_unvisited(");
    let contextual = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)");
    assert contextual.contains("highlight_walk(&mut visitor");
}

test "rule capture is one rule-level entry, not one per token" {
    // A contextual keyword the rule accepts as a name is then captured without
    // the query naming it.
    let out = highlight_output_q("grammar T;
r : name ;
name : IDENTIFIER | 'test' | 'task' ;
IDENTIFIER : [a-z]+ ;
", "(name) @variable");
    assert count_occurrences(&out, "RuleCapture {") == 1;
    assert out.contains("rule_captures: [\n        RuleCapture { rule_id: RK_NAME as i32, capture_id: 0, order: 0 },");
    assert out.contains("overrides_by_kind: [],");
}

test "the mapping is one global, resolved at generation time" {
    let out = highlight_output_q("grammar T;
r : name '(' ;
name : IDENTIFIER ;
IDENTIFIER : [a-z]+ ;
", "(name) @variable\n\"(\" @punctuation.bracket");
    assert out.contains("pub global HIGHLIGHT_MAPPING: HighlightMapping = HighlightMapping {");
    assert out.contains("HighlightVisitor::new(&HIGHLIGHT_MAPPING)");
    assert !out.contains("fn highlight_mapping");
    assert !out.contains("rule_names");
    assert out.contains("capture_classes: [\n        \"punctuation bracket\",\n        \"variable\",\n    ],");
}

test "the highlighter is a library: no CLI entry point, no imports" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(B) @keyword");
    assert !out.contains("fn run");
    assert !out.contains("use ");
}

test "a rule capture restates an earlier override on the same rule" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)\n(r) @keyword");
    assert !out.contains("string");
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_R as i32, capture_id: 0, order: 0 },  // @keyword") == 1;
}

test "an override on a kind a rule capture covers takes the capture's order" {
    let out = highlight_output_q("grammar T;
r : name ;
name : IDENTIFIER ;
IDENTIFIER : [a-z]+ ;
", "(name) @variable\n(name (IDENTIFIER) @type)");
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_NAME as i32, capture_id: 0, order: 0 },  // @type") == 1;
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_NAME as i32, capture_id: 1, order: 0 },  // @variable") == 1;
}

test "rule capture follows a rule that delegates to a naming rule" {
    // A grammar wraps a naming rule per use site so a query can capture that site
    // alone, as `fieldName : memberName` does in `Wado.g4`.
    let out = highlight_output_q("grammar T;
r : field ;
field : name ;
name : IDENTIFIER | 'test' | 'task' ;
IDENTIFIER : [a-z]+ ;
", "(field) @property");
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_FIELD as i32") == 1;
}

test "rule capture follows a delegation chain as long as the grammar makes it" {
    let out = highlight_output_q("grammar T;
r : a ;
a : b ;
b : c ;
c : d ;
d : e ;
e : name ;
name : IDENTIFIER | 'test' ;
IDENTIFIER : [a-z]+ ;
", "(a) @property");
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_A as i32") == 1;
}

test "rule capture on a delegation cycle warns instead of recurring forever" {
    assert_capture_refused(&highlight_run("grammar T;
r : a ;
a : b ;
b : a ;
IDENTIFIER : [a-z]+ ;
", "(a) @variable"));
}

test "rule capture on a multi-token rule warns instead of half-covering it" {
    assert_capture_refused(&highlight_run("grammar T;
r : pair ;
pair : IDENTIFIER IDENTIFIER ;
IDENTIFIER : [a-z]+ ;
", "(pair) @variable"));
}

test "query override emits a row under its token kind" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)");
    assert out.contains(
        "[  // TK_B\n            RuleCapture { rule_id: RK_R as i32, capture_id: 0, order: 0 },  // @string\n        ],",
    );
    assert out.contains("rule_captures: [],");
}

test "default on a named token the parser also writes inline maps that token" {
    let out = highlight_output_q("grammar T;
r : '(' B ')' ;
B : 'b' ;
LP : '(' ;
RP : ')' ;
", "(LP) @punctuation.bracket");
    assert out.contains("0,  // TK_LP @punctuation.bracket");
}

test "default on an action-bearing named token the parser also writes inline" {
    let out = highlight_output_q("grammar T;
options { language = Wado; }
r : '(' B ')' ;
B : 'b' ;
LP : '(' { lx.count += 1 } ;
RP : ')' ;
", "(LP) @punctuation.bracket");
    assert out.contains("0,  // TK_LP @punctuation.bracket");
    assert !out.contains("TK_LIT_LP");
}

test "later override for the same rule and token wins (last-wins)" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)
(r (B) @keyword)");
    assert count_occurrences(&out, "RuleCapture {") == 1;
    assert out.contains("// @keyword");
    assert !out.contains("string");
}

test "unknown token in query warns via ctx diagnostics" {
    assert_one_warning(&highlight_run("grammar T;
r : B ;
B : 'b' ;
", "(NOPE) @keyword"), "unknown token");
}

test "unknown parser rule in an override warns via ctx diagnostics" {
    assert_one_warning(&highlight_run("grammar T;
r : B ;
B : 'b' ;
", "(nope (B) @string)"), "unknown parser rule");
}

test "capture_vocabulary lists the query's distinct capture classes, sorted" {
    let out = highlight_output_q(
        "grammar T; s : KW STR KW ; KW : 'if' ; STR : '\"' ~[\"]* '\"' ;",
        "(KW) @keyword\n(STR) @string\n",
    );
    assert out.contains("capture_names: [\n        \"keyword\",\n        \"string\",\n    ],");
    assert out.contains("pub fn capture_vocabulary() -> List<String> {\n    return HIGHLIGHT_MAPPING.capture_names;\n}");
}

test "capture_vocabulary lists a capture shared by two selectors once" {
    let out = highlight_output_q(
        "grammar T; s : KW ID ; KW : 'if' ; ID : [a-z]+ ;",
        "(KW) @keyword\n(ID) @keyword\n",
    );
    assert out.contains("capture_names: [\n        \"keyword\",\n    ],");
}

test "capture_vocabulary is empty without a highlight query" {
    let out = highlight_output("grammar T; s : KW ; KW : 'if' ;");
    assert out.contains("capture_names: [],");
}

test "a later rule capture on the same rule replaces the earlier one" {
    let out = highlight_output_q("grammar T;
r : name ;
name : IDENTIFIER ;
IDENTIFIER : [a-z]+ ;
", "(name) @variable\n(name) @type");
    assert count_occurrences(&out, "RuleCapture {") == 1;
    assert out.contains("RuleCapture { rule_id: RK_NAME as i32, capture_id: 0, order: 0 },  // @type");
}

test "an override on a later token kind leaves an empty row for each kind before it" {
    let out = highlight_output_q("grammar T;
r : A B ;
A : 'a' ;
B : 'b' ;
", "(r (B) @string)");
    assert out.contains("overrides_by_kind: [\n        [],  // TK_A\n        [  // TK_B\n");
}

test "an unknown literal in a query warns, naming it as a literal" {
    assert_one_warning(&highlight_run("grammar T;
r : B ;
B : 'b' ;
", "\"zz\" @keyword"), "literal \"zz\"");
}

// ===========================================================================
// The runtime ATN simulator core.
//
// Builds ATNs with `atn.wado`, serializes, decodes through the inlined runtime
// (`atn_decode`), and drives `atn_predict_with_stack` to prove the engine
// mechanics: multi-token lookahead resolution, the greedy/non-greedy tie-break
// (min-alt-on-conflict + edge ordering), and the full-context (real
// rule-stack) cases that bind the dangling-`else` per caller context (the
// closing tests).
// ===========================================================================

use { atn_blob_bytes, Atn } from "./atn.wado";
use { build_atn, NON_GREEDY_G4, GREEDY_G4, LR_G4 } from "../tests/support/fixtures.wado";
use { TokenKinds } from "./token_kinds.wado";
use { atn_decode, AtnSim, ATN_BLOCK_START, ATN_BLOCK_END, ATN_STAR_LOOP_ENTRY, ATN_TR_RULE } from "./runtime/atn.wado";
use {
    AtnPredictor,
    atn_invocation_prec,
    atn_predict_once,
    atn_predict_with_stack,
    atn_unasked,
} from "./runtime/atn_predict.wado";
use { atn_lr_loop_decision, atn_with_lr_tables } from "./runtime/atn_lr.wado";
use { Span } from "./runtime/lex.wado";
use { Token } from "./g4/token.wado";
use { assign_action_ids } from "./ir.wado";

fn mk(kind: i32) -> Token {
    return Token::new(kind, "", Span::new(0, 0));
}

fn decode(atn: &Atn) -> AtnSim {
    return atn_with_lr_tables(atn_decode(&atn_blob_bytes(atn)));
}

/// Prediction with no caller context: the SLL question.
fn adaptive_predict(sim: &AtnSim, decision: i32, tokens: &Array<i32>, start_pos: i32, eof: i32) -> i32 {
    let empty: List<i32> = [];
    return atn_predict_with_stack(sim, decision, &empty, tokens, start_pos, eof);
}

/// The flat kinds array the ATN sim reads (the only token data prediction
/// uses), matching the generated parser's `&Array<i32>` scan currency.
fn to_kinds(toks: &List<Token>) -> Array<i32> {
    let mut kinds: List<i32> = [];
    for let t of toks {
        kinds.push(t.kind);
    }
    return kinds.to_array();
}

/// Decision number of parser rule `rule`'s top-level alternation block.
fn rule_block_decision(atn: &Atn, rule: i32) -> i32 {
    for let mut d = 0; d < atn.decision_state.len(); d += 1 {
        let s = &atn.states[atn.decision_state[d]];
        if s.kind == ATN_BLOCK_START && s.rule == rule {
            return d;
        }
    }
    return -1;
}

/// Decision number of the optional/loop whose decision state has an edge
/// straight to a BlockEnd (i.e. an EBNF repeat, not an N-way rule body).
fn optional_decision(atn: &Atn) -> i32 {
    for let mut d = 0; d < atn.decision_state.len(); d += 1 {
        let s = &atn.states[atn.decision_state[d]];
        if s.kind != ATN_BLOCK_START {
            continue;
        }
        for let t of &s.transitions {
            if atn.states[t.target].kind == ATN_BLOCK_END {
                return d;
            }
        }
    }
    return -1;
}

/// Kind of the state reached by `chosen`'s edge out of decision `d`.
fn alt_target_kind(atn: &Atn, d: i32, chosen: i32) -> i32 {
    let s = &atn.states[atn.decision_state[d]];
    return atn.states[s.transitions[chosen].target].kind;
}

/// Decision number of rule `rule`'s `STAR_LOOP_ENTRY` (the LR loop entry).
fn loop_entry_decision(atn: &Atn, rule: i32) -> i32 {
    for let mut d = 0; d < atn.decision_state.len(); d += 1 {
        let s = &atn.states[atn.decision_state[d]];
        if s.kind == ATN_STAR_LOOP_ENTRY && s.rule == rule {
            return d;
        }
    }
    return -1;
}

global K2_G4: String = "
grammar T;
a : ID '(' ')' | ID '[' ']' ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

test "predict resolves a two-token shared-prefix decision" {
    let g = parse(K2_G4).unwrap();
    let atn = build_atn(&g);
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 0);
    assert d >= 0, "rule `a` must have an alternation decision";
    // kinds: ID=0, WS=1, EOF=2, ERROR=3, '('=4, ')'=5, '['=6, ']'=7.
    let eof = 2;
    let paren: List<Token> = [
        mk(0),
        mk(4),
        mk(5),
    ];
    let brack: List<Token> = [
        mk(0),
        mk(6),
        mk(7),
    ];
    assert adaptive_predict(&sim, d, &to_kinds(&paren), 0, eof) == 0, "ID '(' ')' should pick alt 0";
    assert adaptive_predict(&sim, d, &to_kinds(&brack), 0, eof) == 1, "ID '[' ']' should pick alt 1";
}

// A numeric `type(N)` lexes a kind past the grammar's, which `.` and `~X` match
// (see "Bugs in ANTLR4 itself").
test "a wildcard predicts a kind past the grammar's" {
    let atn = build_atn(&parse("grammar T;\na : A X | . X | ~A X ;\nA : 'a' ;\nX : 'x' ;\n").unwrap());
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 0);
    let x = 1;
    let eof = 2;
    let foreign = atn.num_tokens + 5;
    assert adaptive_predict(&sim, d, &([x, x] as List<i32>).to_array(), 0, eof) == 1;
    assert adaptive_predict(&sim, d, &([foreign, x] as List<i32>).to_array(), 0, eof) == 1;
}

global K2_BRACE_G4: String = "
grammar T;
a : ID '(' ')' | ID '{' '}' ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

// The program-wide DFA caches one ATN's predictions, so a second ATN, even one
// of the same size, must not read them.
#[expect_trap]
test "the shared DFA refuses a second ATN of the same size" {
    let first = build_atn(&parse(K2_G4).unwrap());
    let second = build_atn(&parse(K2_BRACE_G4).unwrap());
    assert first.states.len() == second.states.len();
    let kinds = to_kinds(&[
        mk(0),
        mk(4),
        mk(5),
    ]);
    atn_predict_once(&decode(&first), rule_block_decision(&first, 0), &mut AtnPredictor::new(), &kinds, 0, 2);
    atn_predict_once(&decode(&second), rule_block_decision(&second, 0), &mut AtnPredictor::new(), &kinds, 0, 2);
}

global K2_PRED_G4: String = "
grammar T;
a : {p0}? ID '(' ')' | {p1}? ID '[' ']' ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

/// The action id of the predicate opening `rule`'s alternative `index`.
fn left_edge_pred_id(g: &Grammar, rule: i32, index: i32) -> i32 {
    let opening = g.parser_rules[rule].alternatives[index].prediction_guards()[0];
    assert opening.before_index == 0 && opening.kind matches { Predicate };
    return opening.source.action_id;
}

// ANTLR4 finds the viable alternatives first and only then drops the ones a
// false predicate gates (`doc/predicates.md`), so failing the only viable alt
// leaves none rather than handing the decision to one the input cannot take.
test "predict drops an alternative whose predicate fails from the viable ones" {
    let mut g = parse(K2_PRED_G4).unwrap();
    assign_action_ids(&mut g);
    let atn = build_atn(&g);
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 0);
    assert d >= 0, "rule `a` must have an alternation decision";
    let eof = 2;
    let empty: List<i32> = [];
    let paren: List<Token> = [
        mk(0),
        mk(4),
        mk(5),
    ];  // ID '(' ')' — only alt 0 is viable
    let kinds = to_kinds(&paren);
    let bracket = left_edge_pred_id(&g, 0, 1);
    let pick = |false_preds: List<i32>| atn_predict_with_stack(
        &sim,
        d,
        &empty,
        &kinds,
        0,
        eof,
        0,
        &false_preds,
        &[],
        |label| {
            assert label != bracket, "a predicate of an alternative the input rules out is never asked";
            return false;
        },
    );
    assert pick([]) == 0;
    assert pick([bracket]) == 0;
    assert pick([left_edge_pred_id(&g, 0, 0)]) == -1;
}

global COVER_G4: String = "grammar C;
s : a EOF ;
a : {p}? X Y? | X ;
X : 'x' ;
Y : 'y' ;
";

// After `x` the first alternative holds every state the second does, which
// settles the decision only while the first may win it.
test "a failed alternative covering the others does not settle the decision" {
    let mut g = parse(COVER_G4).unwrap();
    assign_atn_call_sites(&mut g);
    assign_action_ids(&mut g);
    let atn = build_atn(&g);
    let tk = TokenKinds::build(&g);
    let eof = tk.id_of("TK_EOF");
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 1);
    let stack: List<i32> = [-1, atn.call_site_returns[0]];
    let x_only = ([tk.id_of("TK_X"), eof] as List<i32>).to_array();
    let x_y = ([
        tk.id_of("TK_X"),
        tk.id_of("TK_Y"),
        eof,
    ] as List<i32>).to_array();
    let pick = |kinds: &Array<i32>, false_preds: List<i32>| atn_predict_with_stack(
        &sim,
        d,
        &stack,
        kinds,
        0,
        eof,
        0,
        &false_preds,
        &[],
        |_| false,
    );
    let p = left_edge_pred_id(&g, 1, 0);
    assert pick(&x_only, []) == 0;
    assert pick(&x_only, [p]) == 1;
    assert pick(&x_y, []) == 0;
    assert pick(&x_y, [p]) == -1;
}

global CALLEE_PRED_G4: String = "grammar P;
s : g X | A X ;
g : {q}? A | B ;
A : 'a' ; B : 'b' ; X : 'x' ;
";

// A predicate on one alternative of a called rule closes that path alone: `s`
// still takes its first alternative through `g`'s second.
test "a failed predicate in a called rule closes only its own path" {
    let mut g = parse(CALLEE_PRED_G4).unwrap();
    assign_action_ids(&mut g);
    let atn = build_atn(&g);
    let tk = TokenKinds::build(&g);
    let eof = tk.id_of("TK_EOF");
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 0);
    let empty: List<i32> = [];
    let q = [left_edge_pred_id(&g, 1, 0)] as List<i32>;
    let pick = |first: String, false_preds: &List<i32>| atn_predict_with_stack(
        &sim,
        d,
        &empty,
        &([
            tk.id_of(first),
            tk.id_of("TK_X"),
            eof,
        ] as List<i32>).to_array(),
        0,
        eof,
        0,
        false_preds,
        &[],
        |_| false,
    );
    assert pick("TK_A", &[]) == 0;
    assert pick("TK_A", &q) == 1;
    assert pick("TK_B", &q) == 0;
}

global OWN_PRED_G4: String = "grammar O;
s : r[0] r[1] EOF ;
r[int d] : {$d > 0}? A | ;
A : 'a' ;
";

// The predicate reads the invocation, so failing it under `r[0]` says nothing
// about `r[1]`, which takes the `a` after `r[0]` takes nothing.
test "a failed own-invocation predicate closes no other invocation's path" {
    let mut g = parse(OWN_PRED_G4).unwrap();
    assign_atn_call_sites(&mut g);
    assign_action_ids(&mut g);
    let atn = build_atn(&g);
    let tk = TokenKinds::build(&g);
    let eof = tk.id_of("TK_EOF");
    let sim = decode(&atn);
    let p = [left_edge_pred_id(&g, 1, 0)] as List<i32>;
    let stack: List<i32> = [-1, atn.call_site_returns[0]];
    let a = ([tk.id_of("TK_A"), eof] as List<i32>).to_array();
    let picked = atn_predict_with_stack(&sim, rule_block_decision(&atn, 1), &stack, &a, 0, eof, 0, &p, &p, |_| false);
    assert picked == 1;
}

test "non-greedy ?? picks the exit alt on the dangling-else conflict" {
    let g = parse(NON_GREEDY_G4).unwrap();
    let atn = build_atn(&g);
    let tk = TokenKinds::build(&g);
    let eof = tk.id_of("TK_EOF");
    let sim = decode(&atn);
    let d = optional_decision(&atn);
    assert d >= 0, "the `??` must produce an optional decision";
    // 'else'=7, 'x'=4 — both alts stay viable to EOF (true ambiguity).
    let toks: List<Token> = [
        mk(7),
        mk(4),
    ];
    let chosen = adaptive_predict(&sim, d, &to_kinds(&toks), 0, eof);
    // The chosen alt's edge must lead to BlockEnd: non-greedy prefers EXIT.
    assert alt_target_kind(&atn, d, chosen) == ATN_BLOCK_END, "non-greedy must choose the exit alt";
}

test "greedy ? picks the enter alt on the same conflict" {
    let g = parse(GREEDY_G4).unwrap();
    let atn = build_atn(&g);
    let tk = TokenKinds::build(&g);
    let eof = tk.id_of("TK_EOF");
    let sim = decode(&atn);
    let d = optional_decision(&atn);
    assert d >= 0, "the `?` must produce an optional decision";
    let toks: List<Token> = [
        mk(7),
        mk(4),
    ];
    let chosen = adaptive_predict(&sim, d, &to_kinds(&toks), 0, eof);
    // Greedy prefers ENTER: the chosen alt's edge must NOT go to BlockEnd.
    assert alt_target_kind(&atn, d, chosen) != ATN_BLOCK_END, "greedy must choose the enter alt";
}

// Full-context: the SAME `??` decision binds differently depending on the
// caller stack of ATN return states. This is the IfIfElseNonGreedyBinding1
// crux. The stack mirrors what the generated parser pushes at each rule
// call: the start-rule frame (-1, follow is EOF) at the bottom, then each
// call site's exact return state (`call_site_returns`). Call-site ids (the
// depth-first numbering of `assign_atn_call_sites`):
//   cs0 = start -> statement   (inside `statement+`)
//   cs1 = statement -> ifStatement
//   cs2 = ifStatement -> statement   (the mandatory one, before the `??`)
//   cs3 = ifStatement -> statement   (inside `('else' statement)??`)

test "full-context: inner ifStatement ?? skips the else (binds to outer)" {
    let mut g = parse(NON_GREEDY_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let eof = TokenKinds::build(&g).id_of("TK_EOF");
    let sim = decode(&atn);
    let d = optional_decision(&atn);
    let csr = &atn.call_site_returns;
    // Inner ifStatement reached via
    // start >(cs0) statement >(cs1) ifStatement >(cs2) statement >(cs1) ifStatement.
    let stack: List<i32> = [-1, csr[0], csr[1], csr[2], csr[1]];
    let toks: List<Token> = [
        mk(7),
        mk(4),
    ];
    let chosen = atn_predict_with_stack(&sim, d, &stack, &to_kinds(&toks), 0, eof);
    assert alt_target_kind(&atn, d, chosen) == ATN_BLOCK_END, "inner ?? must EXIT (let the outer take the else)";
}

test "full-context: outer ifStatement ?? consumes the else" {
    let mut g = parse(NON_GREEDY_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let eof = TokenKinds::build(&g).id_of("TK_EOF");
    let sim = decode(&atn);
    let d = optional_decision(&atn);
    let csr = &atn.call_site_returns;
    // Outermost ifStatement: start >(cs0) statement >(cs1) ifStatement.
    let stack: List<i32> = [-1, csr[0], csr[1]];
    let toks: List<Token> = [
        mk(7),
        mk(4),
    ];
    let chosen = atn_predict_with_stack(&sim, d, &stack, &to_kinds(&toks), 0, eof);
    assert alt_target_kind(&atn, d, chosen) != ATN_BLOCK_END, "outer ?? must ENTER (consume the else)";
}

// A recorded verdict answers only the caller stack it was asked under: the two
// tests above, asked at one position through one `AtnPredictor`.
test "a recorded verdict is keyed by the caller stack" {
    let mut g = parse(NON_GREEDY_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let eof = TokenKinds::build(&g).id_of("TK_EOF");
    let sim = decode(&atn);
    let d = optional_decision(&atn);
    let csr = &atn.call_site_returns;
    let kinds = to_kinds(&[
        mk(7),
        mk(4),
    ]);
    let mut state = AtnPredictor::new();
    state.stack = [-1, csr[0], csr[1], csr[2], csr[1]];
    let inner = atn_predict_once(&sim, d, &mut state, &kinds, 0, eof);
    state.stack = [-1, csr[0], csr[1]];
    let outer = atn_predict_once(&sim, d, &mut state, &kinds, 0, eof);
    assert alt_target_kind(&atn, d, inner) == ATN_BLOCK_END, "inner ?? must EXIT";
    assert alt_target_kind(&atn, d, outer) != ATN_BLOCK_END, "outer ?? must ENTER, not reuse the inner verdict";
    state.stack = [-1, csr[0], csr[1], csr[2], csr[1]];
    assert atn_predict_once(&sim, d, &mut state, &kinds, 0, eof) == inner, "the inner question answers as before";
}

// A scan whose result is kept for other callers hides the callers it has: a
// prediction that needs one reads the whole stack, and says so.
test "a prediction that needs a hidden caller reads the whole stack and says so" {
    let mut g = parse(NON_GREEDY_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let eof = TokenKinds::build(&g).id_of("TK_EOF");
    let sim = decode(&atn);
    let d = optional_decision(&atn);
    let csr = &atn.call_site_returns;
    let kinds = to_kinds(&[
        mk(7),
        mk(4),
    ]);
    let mut state = AtnPredictor::new();
    state.stack = [-1, csr[0], csr[1], csr[2], csr[1]];
    let hidden = state.hide_callers();
    let inner = atn_predict_once(&sim, d, &mut state, &kinds, 0, eof);
    assert state.reveal_callers(hidden);
    assert alt_target_kind(&atn, d, inner) == ATN_BLOCK_END, "inner ?? must EXIT, as with the whole stack";
    let again = state.hide_callers();
    assert atn_predict_once(&sim, d, &mut state, &kinds, 0, eof) == inner;
    assert state.reveal_callers(again), "a recorded verdict still says it read a hidden caller";
}

test "a prediction settled inside the visible frames reads no hidden caller" {
    let mut g = parse(NON_GREEDY_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let tk = TokenKinds::build(&g);
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 1);
    let mut state = AtnPredictor::new();
    state.stack = [-1, atn.call_site_returns[0]];
    let hidden = state.hide_callers();
    let x = to_kinds(&[mk(4)]);
    assert atn_predict_once(&sim, d, &mut state, &x, 0, tk.id_of("TK_EOF")) == 0;
    assert !state.reveal_callers(hidden);
}

global TWO_SITES_G4: String = "grammar E;
prog : top D ;
top : (r B | Q r) C ;
r : A | A B ;
A : 'a' ;
B : 'b' ;
C : 'c' ;
D : 'd' ;
Q : 'q' ;
";

// The predictions a parse caches answer the caller stack they were asked under.
// On `a b c`, `r` takes `a` at the `r B` call site and `a b` after `q`.
test "a cached prediction answers only its own caller stack" {
    let mut g = parse(TWO_SITES_G4).unwrap();
    assign_atn_call_sites(&mut g);
    let atn = build_atn(&g);
    let tk = TokenKinds::build(&g);
    let eof = tk.id_of("TK_EOF");
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 2);
    let csr = &atn.call_site_returns;
    let kinds = ([
        tk.id_of("TK_A"),
        tk.id_of("TK_B"),
        tk.id_of("TK_C"),
        tk.id_of("TK_D"),
        eof,
    ] as List<i32>).to_array();
    let mut state = AtnPredictor::new();
    for let round of 0..<2 {
        state.stack = [-1, csr[0], csr[1]];
        assert state.predict(&sim, d, &kinds, 0, eof, 0, &[], &[], atn_unasked) == 0, `round ${round}`;
        state.stack = [-1, csr[0], csr[2]];
        assert state.predict(&sim, d, &kinds, 0, eof, 0, &[], &[], atn_unasked) == 1, `round ${round}`;
    }
}

// P4.1: the rewritten LR loop-entry form is walkable. A naive
// pre-rewrite ATN (`expr -> RuleRef(expr) ...` at position 0) would
// left-recurse forever in `atn_closure`; the precedence-climbing rewrite
// stops at the atom block, so prediction terminates and returns a valid
// alternative. (Precedence-guided enter/exit selection itself is P4.3;
// here we only assert termination + a sane in-range result.)
test "LR loop-entry prediction terminates (no naive left recursion)" {
    let g = parse(LR_G4).unwrap();
    let atn = build_atn(&g);
    let eof = TokenKinds::build(&g).id_of("TK_EOF");
    let sim = decode(&atn);
    let d = loop_entry_decision(&atn, 0);
    assert d >= 0, "expr must have an LR loop-entry decision";
    // After the first atom, input continues with `'+' INT` (tk: INT=0,
    // WS=1, EOF=2, ERROR=3, '*'=4, '+'=5). Three loop-entry edges exist
    // (enter '*', enter '+', exit); the predictor must return one of them.
    let toks: List<Token> = [
        mk(5),
        mk(0),
    ];
    let chosen = adaptive_predict(&sim, d, &to_kinds(&toks), 0, eof);
    assert chosen >= 0 && chosen < 3, "LR loop-entry prediction out of range";
}

// P4.3: the loop-entry precedence predicate `{prec_i >= pr}?` prunes
// enter alts whose alt-precedence (`own_prec`) is below the current
// min-prec context. For `expr : expr '*' expr | expr '+' expr | INT`,
// the loop-entry edges are [enter '*' (own_prec 2), enter '+' (own_prec
// 1), exit]; raising the context to 2 disables the '+' alt (left
// associativity: a '+' right operand cannot re-enter '+').
test "precedence pruning gates LR loop-entry enter alts by min_prec" {
    let g = parse(LR_G4).unwrap();
    let atn = build_atn(&g);
    let eof = TokenKinds::build(&g).id_of("TK_EOF");
    let sim = decode(&atn);
    let d = loop_entry_decision(&atn, 0);
    // Tokens after the first atom: `'+' INT` (INT=0, '*'=4, '+'=5).
    let toks: List<Token> = [
        mk(5),
        mk(0),
    ];
    let empty: List<i32> = [];
    // pr=0: the '+' alt (own_prec 1) is enabled and matches → enter it (1).
    let lo = atn_predict_with_stack(&sim, d, &empty, &to_kinds(&toks), 0, eof, 0);
    assert lo == 1, "min_prec 0 should enter the '+' alt (1)";
    // pr=2: the '+' alt is pruned (1 < 2) and '*' does not match '+', so only
    // the exit edge survives → exit alt (2).
    let hi = atn_predict_with_stack(&sim, d, &empty, &to_kinds(&toks), 0, eof, 2);
    assert hi == 2, "min_prec 2 should prune '+' and exit (2)";
}

// A frame's restore precedence is the ATN's, not an LR-only table's: a
// simulator without them still pops a self-ref operand at its own precedence.
test "a decoded ATN restores each rule call's precedence" {
    let sim = atn_decode(&atn_blob_bytes(&build_atn(&parse(LR_G4).unwrap())));
    let mut raised = 0;
    for let mut j = 0; j < sim.tr_kind.len(); j += 1 {
        if sim.tr_kind[j] == ATN_TR_RULE {
            let frame: List<i32> = [sim.tr_follow[j]];
            assert atn_invocation_prec(&sim, &frame, 0) == sim.tr_prec[j];
            if sim.tr_prec[j] > 0 {
                raised += 1;
            }
        }
    }
    assert raised > 0, "the grammar calls a self-ref operand at a raised precedence";
}

// P4.4: the dedicated LR loop-entry decision (`atn_lr_loop_decision`) — the
// O(n) replacement for full ALL(*) simulation on LR loops. It encodes the
// true loop-entry semantics: precedence prune + yield-to-caller-mandatory.
test "LR loop decision: precedence gates enter/exit" {
    let g = parse(LR_G4).unwrap();
    let atn = build_atn(&g);
    let eof = TokenKinds::build(&g).id_of("TK_EOF");
    let sim = decode(&atn);
    let d = loop_entry_decision(&atn, 0);
    let mut empty = AtnPredictor::new();
    // After the first atom, `'+' INT` (INT=0, '*'=4, '+'=5). The exit edge is
    // the last (index 2); enter '*'=0, enter '+'=1.
    let toks: List<Token> = [
        mk(5),
        mk(0),
    ];
    // min_prec 0: enter the '+' alt (own_prec 1 >= 0, suffix starts with '+').
    assert atn_lr_loop_decision(&sim, &mut empty, d, &to_kinds(&toks), 0, eof, 0) == 1, "min_prec 0 enters '+'";
    // min_prec 2: '+' (own_prec 1 < 2) pruned, '*' suffix !startswith '+', exit.
    assert atn_lr_loop_decision(&sim, &mut empty, d, &to_kinds(&toks), 0, eof, 2) == 2, "min_prec 2 exits";
}

// A `~SEMI` operator suffix must match any token EXCEPT `SEMI`. The FIRST
// representation must carry the excluded label rather than treating the
// negated set as an unrestricted "matches anything" (which would make the
// loop wrongly enter on `SEMI`).
global LR_NEG_G4: String = "
grammar T;
e : e ~SEMI e | INT ;
INT : '0'..'9'+ ;
SEMI : ';' ;
WS : ' ' -> skip ;
";

test "atn_lr_loop_decision: ~SEMI suffix excludes the SEMI token" {
    let g = parse(LR_NEG_G4).unwrap();
    let atn = build_atn(&g);
    let sim = decode(&atn);
    let d = loop_entry_decision(&atn, 0);
    assert d >= 0, "rule `e` must have a loop-entry decision";
    // kinds (lexer order): INT=0, SEMI=1, WS=2, EOF=3.
    let mut empty = AtnPredictor::new();
    let eof = 3;
    // suffix `~SEMI e` must NOT admit SEMI(1): no enter edge matches → exit (alt 1).
    let on_semi: List<Token> = [
        mk(1),
        mk(0),
    ];
    assert atn_lr_loop_decision(&sim, &mut empty, d, &to_kinds(&on_semi), 0, eof) == 1, "~SEMI must not match SEMI";
    // it admits INT(0): enter the suffix (alt 0).
    let on_int: List<Token> = [
        mk(0),
        mk(0),
    ];
    assert atn_lr_loop_decision(&sim, &mut empty, d, &to_kinds(&on_int), 0, eof) == 0, "~SEMI matches INT";
}

// A caller stack becomes context nodes rather than a depth in the config key,
// so one 1000 frames deep predicts the token-led alternative like any other.
test "a deep caller stack predicts normally" {
    let g = parse(K2_G4).unwrap();
    let atn = build_atn(&g);
    let sim = decode(&atn);
    let d = rule_block_decision(&atn, 0);
    assert d >= 0, "rule `a` must have an alternation decision";
    let mut deep: List<i32> = [];
    for let mut i = 0; i < 1000; i += 1 {
        deep.push(-1);
    }
    // `a : ID '(' ')' | ID '[' ']'` on `ID ( )` → alt 0. (ID=0, '('=4, ')'=5.)
    let toks: List<Token> = [
        mk(0),
        mk(4),
        mk(5),
    ];
    assert atn_predict_with_stack(&sim, d, &deep, &to_kinds(&toks), 0, 2) == 0, "deep stack must still predict alt 0";
}

// An LR rule whose atom alternative is nullable (`a : ID?`) can begin with a
// loop operator: when `a` derives empty, `e` starts the `('+' e)*` loop, so
// `e`'s FIRST legitimately includes `'+'`. `atn_decode` must handle this (not
// reject it), and the operator must land in the rule's FIRST set.
global LR_NULLABLE_ATOM_G4: String = "
grammar T;
e : e '+' e | a ;
a : ID? ;
ID : 'a'..'z'+ ;
WS : ' ' -> skip ;
";

test "atn_decode: a nullable atom LR rule carries the operator in its FIRST" {
    let g = parse(LR_NULLABLE_ATOM_G4).unwrap();
    let atn = build_atn(&g);
    let sim = decode(&atn);
    // kinds (lexer order): ID=0, WS=1, EOF=2, ERROR=3, '+'=4. Rule 0 is `e`.
    assert sim.rule_first[0].contains(&4), "e's FIRST must include '+' (a is nullable)";
    assert sim.rule_first[0].contains(&0), "e's FIRST must include ID (via a)";
}

// ===========================================================================
// java2wado: the Java action, predicate and `@members` translator.
// ===========================================================================

use {
    translate_action,
    translate_predicate,
    translate_members,
    stage_lexer_bodies,
    translate_attr_types,
    should_emit_actions,
} from "./java2wado.wado";
use { grammar_has_superclass } from "./superclass.wado";
use { ActionLanguage } from "./ir.wado";
use { AltBinding } from "./attr_resolve.wado";
use { MemberNames, member_names } from "./java2wado/jmembers.wado";

global NO_BINDINGS: List<AltBinding> = [];
global NO_MEMBERS: MemberNames = MemberNames {};

fn java_pred<S: AsStrSlice, S1: AsStrSlice>(src: S, rule_src: S1, vals_in_scope: bool) -> String {
    return java_pred_m(src, rule_src, vals_in_scope, &NO_MEMBERS);
}

fn java_pred_m<S: AsStrSlice, S1: AsStrSlice>(
    src: S,
    rule_src: S1,
    vals_in_scope: bool,
    members: &MemberNames,
) -> String {
    let g = parse(`grammar T;
${rule_src}
`).unwrap();
    let lang = ActionLanguage::Java;
    return translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        src,
        vals_in_scope,
        &NO_BINDINGS,
        &g.name,
        members,
    ).unwrap();
}

fn java_pred_res<S: AsStrSlice, S1: AsStrSlice>(src: S, rule_src: S1, vals_in_scope: bool) -> Result<String, String> {
    let g = parse(`grammar T;
${rule_src}
`).unwrap();
    let lang = ActionLanguage::Java;
    return translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        src,
        vals_in_scope,
        &NO_BINDINGS,
        &g.name,
        &NO_MEMBERS,
    );
}

test "java predicate: this.field with arithmetic and comparison" {
    let out = java_pred("this.i % 2 == 0", "a : ID ;", false);
    assert out == "p.i % 2 == 0";
}

test "java predicate: rule arg reference" {
    let out = java_pred("$i == 1", "a[i32 i] : ID ;", true);
    assert out == "vals.i == 1";
}

test "java predicate: negation with parens" {
    // The field declaration is snake_cased, so every read of it is too.
    let out = java_pred("!(this.enumKeyword)", "a : ID ;", false);
    assert out == "!(p.enum_keyword)";
}

test "java predicate: input lookahead vs token constant" {
    let out = java_pred("_input.LA(1) != TParser.ELSE", "a : ID ;", false);
    assert out == "p.la(1) != TK_ELSE";
}

test "java predicate: token text equals" {
    let out = java_pred("_input.LT(1).getText().equals(\"x\")", "a : ID ;", false);
    assert out == "(p.token_text(p.lt(1)) == \"x\")";
}

test "java predicate: member method call snake-cases" {
    let members = MemberNames {
        methods: ["pred"],
    };
    let out = java_pred_m("this.pred($i == 99)", "a[i32 i] : ID ;", true, &members);
    assert out == "p.pred(vals.i == 99)";
}

test "java action: a bare @members field reads through the recognizer" {
    // Java reaches a field bare; unqualified it would name nothing in Wado.
    let members = MemberNames {
        fields: ["calls"],
    };
    let out = java_action_m("calls = calls + 1;", "a : ID ;", false, &members);
    assert out == "p.calls = p.calls + 1;";

    // A rule argument shadows the field, as it does in ANTLR's own output — and
    // it is `$calls` under another spelling, so both land on the one storage a
    // write has to be visible through.
    let shadowed = java_action_m("calls = calls + 1;", "a[i32 calls] : ID ;", true, &members);
    assert shadowed == "vals.calls = vals.calls + 1;";
}

test "java action: a bare rule argument is `$arg` under another spelling" {
    // The generated parameter is `escape_ident(to_snake_case(...))` and `$arg`
    // reads `vals.<raw>`, so passing the surface name through would name nothing
    // for a camelCased arg — and would leave a write invisible to `$arg`.
    let out = java_action_m(
        "maxDepth = maxDepth + 1;",
        "a[i32 maxDepth] : ID ;",
        true,
        &NO_MEMBERS,
    );
    assert out == "vals.maxDepth = vals.maxDepth + 1;";

    // A body-declared local of the same name shadows the argument.
    let local = java_action_m("int maxDepth = 2; maxDepth = 3;", "a[i32 maxDepth] : ID ;", true, &NO_MEMBERS);
    assert local == "let mut maxDepth: i32 = 2; maxDepth = 3;";
}

test "java: an undeclared recognizer method is a loud error" {
    let res = java_action_res("dumpDFA();", "a : ID ;", false);
    assert res.is_err(), "a call to an undeclared method must be a loud error, not a broken emit";
}

test "java: an unknown Type constant is a loud error" {
    let res = java_pred_res(
        "getInterpreter().setPredictionMode(PredictionMode.LL_EXACT_AMBIG_DETECTION)",
        "a : ID ;",
        false,
    );
    assert res.is_err(), "a call to an ANTLR-runtime API must be a loud error";
}

test "java: a declared @members method resolves; an undeclared sibling does not" {
    let members = MemberNames {
        methods: ["is_keyword"],
    };
    let ok = java_pred_m("this.isKeyword()", "a : ID ;", false, &members);
    assert ok == "p.is_keyword()";

    let res = java_pred_res("this.isKeyword()", "a : ID ;", false);
    assert res.is_err(), "an undeclared method must be a loud error even qualified by this";
}

test "java: a call resolves in Java's method namespace, not against the variables" {
    // Java declares methods and variables in separate namespaces, so a field of
    // the same name hides the method at a name position and never at a call one.
    let members = MemberNames {
        methods: ["depth"],
        fields: ["depth"],
    };
    let bare = java_action_m("depth();", "a : ID ;", false, &members);
    assert bare == "p.depth();";

    let qualified = java_action_m("this.depth();", "a : ID ;", false, &members);
    assert qualified == "p.depth();";

    // A rule argument shares the name too, and shadows only the read.
    let arg = java_action_m("depth(); depth = 1;", "a[i32 depth] : ID ;", true, &members);
    assert arg == "p.depth(); vals.depth = 1;";
}

test "java predicate: negated equals is parenthesized" {
    let out = java_pred("!getText().equals(\"+\")", "a : ID ;", false);
    assert out == "!(p.rule_text(_rule_start_tok) == \"+\")";
}

test "java members: method name is snake_cased at definition to match calls" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, "boolean isKeyword() { return true; }", "T").unwrap();
    assert m.methods.len() == 1;
    assert m.methods[0].source == "fn is_keyword(&self) -> bool { return true; }";
}

test "java members: the receiver follows what the body does" {
    // Fixed point over the block: a reader that only calls readers stays `&self`,
    // and one that reaches a writer through a call chain does not.
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        "int n = 0;
          boolean reads() { return this.n > 0; }
          void writes() { this.n = 1; }
          boolean delegates() { return this.reads(); }
          void indirect() { this.writes(); }",
        "T",
    ).unwrap();
    assert m.methods.len() == 4;
    assert !m.methods[0].mutates && m.methods[0].source.contains("fn reads(&self)");
    assert m.methods[1].mutates && m.methods[1].source.contains("fn writes(&mut self)");
    assert !m.methods[2].mutates;
    assert m.methods[3].mutates;
}

test "java members: a write one receiver down still counts" {
    // The mutating call is the *callee's* receiver, not an argument.
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        "int n = 0;
          String writes() { this.n = 1; return \"x\"; }
          boolean hidden() { return this.writes().equals(\"x\"); }",
        "T",
    ).unwrap();
    assert m.methods[1].mutates;
}

test "java members: a method body reads a field of its own block, bare or qualified" {
    // Java reaches a field either way, and the declaration is snake_cased, so
    // both spellings have to land on the same struct field.
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        "int nestLevel = 0;
          int bare() { return nestLevel + 1; }
          int qualified() { return this.nestLevel + 1; }",
        "T",
    ).unwrap();
    assert m.fields[0].name == "nest_level";
    assert m.methods[0].source.contains("return self.nest_level + 1;");
    assert m.methods[1].source.contains("return self.nest_level + 1;");
}

test "java members: a local or parameter shadows a field of the same name" {
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        "int n = 0;
          int shadowed(int n) { return n; }
          int local() { int n = 2; return n; }",
        "T",
    ).unwrap();
    assert m.methods[0].source.contains("return n;");
    assert m.methods[1].source.contains("return n;");
}

test "java members: a call on something other than the recognizer is not a member call" {
    // `s.trim()` only shares the name of the mutating member; it writes through
    // no recognizer, so `reads` keeps `&self` — and stays reachable from a lexer
    // predicate.
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        "int n = 0;
          void trim() { this.n = 1; }
          boolean reads(String s) { return s.trim().equals(\"x\"); }",
        "T",
    ).unwrap();
    assert m.methods[0].mutates;
    assert !m.methods[1].mutates && m.methods[1].source.contains("fn reads(&self");
}

test "java members: printing writes the output sink, so its method takes &mut self" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, "void say() { System.out.println(\"x\"); }", "T").unwrap();
    assert m.methods[0].mutates && m.methods[0].source.contains("fn say(&mut self)");
}

test "java predicate: boolean literal" {
    let out = java_pred("false", "a : ID ;", false);
    assert out == "false";
}

test "java expr: numeric plus is not string concat" {
    let g = parse("grammar T;
r : x=e ;
e returns [i32 v] : ID ;
").unwrap();
    let lang = ActionLanguage::Java;
    let out = translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        "$x.v + 1",
        false,
        &NO_BINDINGS,
        &g.name,
        &NO_MEMBERS,
    ).unwrap();
    assert out == "x.v + 1";
}

test "java expr: string concat becomes a template literal" {
    let g = parse("grammar T;
r : ID ;
").unwrap();
    let lang = ActionLanguage::Java;
    let out = translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        "\"ID \" + $ID.text",
        false,
        &NO_BINDINGS,
        &g.name,
        &NO_MEMBERS,
    ).unwrap();
    assert out == "`ID ${p.token_text(id)}`";
}

test "dispatcher routes language = Wado through the identity translator" {
    let g = parse("grammar T;
r returns [i32 v] : ID { $v = 1; } ;
").unwrap();
    let lang = ActionLanguage::Wado;
    let out = translate_action(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        " $v = 1; ",
        true,
        &NO_BINDINGS,
        &g.name,
        &NO_MEMBERS,
    ).unwrap();
    assert out == " vals.v = 1; ";
}

fn java_action<S: AsStrSlice, S1: AsStrSlice>(src: S, rule_src: S1, vals_in_scope: bool) -> String {
    return java_action_m(src, rule_src, vals_in_scope, &NO_MEMBERS);
}

fn java_action_m<S: AsStrSlice, S1: AsStrSlice>(
    src: S,
    rule_src: S1,
    vals_in_scope: bool,
    members: &MemberNames,
) -> String {
    let g = parse(`grammar T;
${rule_src}
`).unwrap();
    let lang = ActionLanguage::Java;
    return translate_action(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        src,
        vals_in_scope,
        &NO_BINDINGS,
        &g.name,
        members,
    ).unwrap();
}

fn java_action_res<S: AsStrSlice, S1: AsStrSlice>(src: S, rule_src: S1, vals_in_scope: bool) -> Result<String, String> {
    let g = parse(`grammar T;
${rule_src}
`).unwrap();
    let lang = ActionLanguage::Java;
    return translate_action(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        src,
        vals_in_scope,
        &NO_BINDINGS,
        &g.name,
        &NO_MEMBERS,
    );
}

test "java action: only the vocabulary-rendered expected set folds" {
    // `IntervalSet.toString()` renders raw token numbers and `toString(boolean)`
    // a different form again; only the vocabulary overload is what codegen has.
    let rule = "r : ID ;";
    let vocab = translate_action(
        &ActionLanguage::Java,
        &parse(`grammar T;
${rule}
`).unwrap().parser_rules[0],
        &parse(`grammar T;
${rule}
`).unwrap().parser_rules,
        "System.out.println(getExpectedTokens().toString(getVocabulary()));",
        false,
        &NO_BINDINGS,
        "T",
        &NO_MEMBERS,
        "{'a'}",
    );
    assert vocab matches { Ok(code) && code.contains("{'a'}") };

    for let body of &[
        "System.out.println(getExpectedTokens().toString());", "System.out.println(getExpectedTokens().toString(true));",
    ] {
        let out = translate_action(
            &ActionLanguage::Java,
            &parse(`grammar T;
${rule}
`).unwrap().parser_rules[0],
            &parse(`grammar T;
${rule}
`).unwrap().parser_rules,
            body,
            false,
            &NO_BINDINGS,
            "T",
            &NO_MEMBERS,
            "{'a'}",
        );
        assert out matches { Err(_) };
    }
}

test "java action: an assert message carries over only as a literal" {
    let rule = "r : ID ;";
    let plain = java_action("assert 1 == 1;", rule, false);
    assert plain == "assert 1 == 1;";

    let literal = java_action("assert 1 == 1 : \"nope\";", rule, false);
    assert literal == "assert 1 == 1, \"nope\";";

    // Java stringifies any expression there; dropping it would weaken the
    // assertion with nothing said.
    let expr = java_action_res("assert 1 == 1 : someValue;", rule, false);
    assert expr matches { Err(_) }, "a non-literal message must be refused";
}

test "java action: println appends a newline" {
    let out = java_action("System.out.println(\"enum\");", "a : ID ;", false);
    assert out == "p.emit(`enum\\n`);";
}

test "java action: print omits the newline" {
    let out = java_action("System.out.print(\"a\");", "a : ID ;", false);
    assert out == "p.emit(`a`);";
}

test "java action: println stringifies a value arg" {
    let out = java_action("System.out.println($x.v);", "r : x=e ; e returns [i32 v] : ID ;", false);
    assert out == "p.emit(`${x.v}\\n`);";
}

test "java action: println with a concat arg" {
    let out = java_action("System.out.println(\"ID \" + $ID.text);", "r : ID ;", false);
    assert out == "p.emit(`ID ${p.token_text(id)}\\n`);";
}

test "java action: ctx.toStringTree(this) drops the redundant parser arg" {
    let out = java_action("System.out.println($ctx.toStringTree(this));", "s : e EOF ; e : ID ;", false);
    assert out == "p.emit(`${p.rule_string_tree()}\\n`);";
}

test "java action: assignment to the value channel" {
    let out = java_action(
        "$v = $a.v + $b.v;",
        "r returns [i32 v] : a=e b=e ; e returns [i32 v] : ID ;",
        true,
    );
    assert out == "vals.v = a.v + b.v;";
}

test "java action: compound assignment on this.field" {
    let out = java_action("this.i += 1;", "a : ID ;", false);
    assert out == "p.i += 1;";
}

test "java action: local declaration maps the type" {
    let out = java_action("int x = 0;", "a : ID ;", false);
    assert out == "let mut x: i32 = 0;";
}

test "java action: multiple statements space-join" {
    let out = java_action("this.i += 1; System.out.print(\"i=\");", "a : ID ;", false);
    assert out == "p.i += 1; p.emit(`i=`);";
}

test "java action: ctx-cast LR-binary value idiom" {
    let g = parse("grammar T;
e returns [i32 v] : e '+' e | INT ;
").unwrap();
    let lang = ActionLanguage::Java;
    let bindings: List<AltBinding> = [
        AltBinding { is_token: false, base: "e", field: "e", ref_name: "e" },
    ];
    let out = translate_action(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        "$v = ((BinaryContext)$ctx).e(0).v + ((BinaryContext)$ctx).e(1).v;",
        true,
        &bindings,
        &g.name,
        &NO_MEMBERS,
    ).unwrap();
    assert out == "vals.v = _lr_acc.v + e.v;";
}

test "java predicate: ctx-cast child access maps to the LR accumulator" {
    let g = parse("grammar T;
e returns [i32 v] : e '+' e | INT ;
").unwrap();
    let lang = ActionLanguage::Java;
    let out = translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        "((BinaryContext)$ctx).e(0).v > 0",
        true,
        &NO_BINDINGS,
        &g.name,
        &NO_MEMBERS,
    ).unwrap();
    assert out == "_lr_acc.v > 0";
}

test "java: ctx-cast in a non-left-recursive rule is a loud error" {
    let g = parse("grammar T;
r returns [i32 v] : INT ;
").unwrap();
    let lang = ActionLanguage::Java;
    let res = translate_predicate(
        &lang,
        &g.parser_rules[0],
        &g.parser_rules,
        "((C)$ctx).r(0).v > 0",
        true,
        &NO_BINDINGS,
        &g.name,
        &NO_MEMBERS,
    );
    assert res.is_err(), "$ctx child access outside an LR rule must be a loud error";
}

test "java members: field declarations become struct fields" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, "boolean enumKeyword = true; int i = 0;", "T").unwrap();
    assert m.fields.len() == 2;
    assert m.fields[0].name == "enum_keyword" && m.fields[0].ty == "bool" && m.fields[0].init == "true";
    assert m.fields[1].name == "i" && m.fields[1].ty == "i32" && m.fields[1].init == "0";
    assert m.methods.is_empty(), "no methods expected";
}

test "java members: integer types map by exact Java width (byte=i8, short=i16, long=i64)" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, "byte b = 0; short s = 0; long l = 0;", "T").unwrap();
    assert m.fields.len() == 3;
    assert m.fields[0].ty == "i8";
    assert m.fields[1].ty == "i16";
    assert m.fields[2].ty == "i64";
}

test "java: a floating-point declaration is refused, wherever it is declared" {
    let lang = ActionLanguage::Java;
    for let ty of ["float", "double"] {
        assert translate_members(&lang, `${ty} d = 0;`, "T").is_err();
        assert translate_members(&lang, `${ty} f() { return 0; }`, "T").is_err();
        assert translate_members(&lang, `int f(${ty} x) { return 0; }`, "T").is_err();
        assert java_action_res(`${ty} x = 0;`, "a : ID ;", false).is_err();
    }
}

test "java members: method with a param, print, and return" {
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        "boolean pred(boolean v) { System.out.println(\"eval=\" + v); return v; }",
        "T",
    ).unwrap();
    assert m.fields.is_empty(), "no fields expected";
    assert m.methods.len() == 1;
    assert m.methods[0].source == "fn pred(&mut self, v: bool) -> bool { self.emit(`eval=${v}\\n`); return v; }";
}

test "java members: void method, no params" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, "public void foo() { System.out.println(\"foo\"); }", "T").unwrap();
    assert m.methods.len() == 1;
    assert m.methods[0].source == "fn foo(&mut self) { self.emit(`foo\\n`); }";
}

test "java members: a member method stands outside every match" {
    // The cursor locals and the rule's start token live in the generated
    // functions, not on the struct, so a window read here has to be a loud
    // error rather than an emit naming something that is not in scope.
    let lang = ActionLanguage::Java;
    for let body of &[
        "boolean head() { return getText(); }", "int col() { return getCharPositionInLine(); }",
        "int col() { return _tokenStartCharPositionInLine; }", "boolean head() { return $text; }",
    ] {
        assert translate_members(&lang, body, "T", /*lexer=*/ true).is_err();
    }
    assert translate_members(&lang, "boolean head() { return getText(); }", "T").is_err(), "parser side too";
}

test "java members: a lexer member resolves against the lexer's own surface" {
    // Collected for the lexer, so a name Gale does not model on it is reported
    // by name rather than passed through into the generated module.
    let lang = ActionLanguage::Java;
    let unmodelled = translate_members(&lang, "boolean at() { return _input; }", "T", /*lexer=*/ true);
    assert unmodelled.is_err(), "an unmodelled recognizer field must be reported";

    let src = "int n = 0; boolean deep() { return this.n > 1; }";
    let ok = translate_members(&lang, &src, "T", /*lexer=*/ true).unwrap();
    assert ok.methods.len() == 1;
    assert ok.methods[0].source == "fn deep(&self) -> bool { return self.n > 1; }";
}

test "the parser's token-stream API is refused in a lexer body" {
    // The generated `Lexer` has characters and a cursor, not tokens and rules,
    // so each of these would have emitted a method it does not carry.
    let lang = ActionLanguage::Java;
    let cases: List<[String, String]> = [
        ["_input.LA(1) == 0", "_input.LA()"],
        ["_input.LT(1).getText().equals(\"x\")", "_input.LT()"],
        ["_input.getText().equals(\"x\")", "_input.getText()"],
        ["getRuleInvocationStack()", "getRuleInvocationStack()"],
    ];
    for let [body, api] of cases {
        let mut g = parse(`lexer grammar L;
A : 'a' { ${body} }? ;
`).unwrap();
        let msgs = stage_lexer_bodies(&mut g, &lang, &NO_MEMBERS);
        assert msgs.len() == 1 && msgs[0].contains(`'${api}' reads the parser's token stream`);
    }

    // The same call in a parser body is the API it belongs to.
    let ok = java_pred("_input.LA(1) == 0", "a : ID ;", false);
    assert ok == "p.la(1) == 0";
}

test "a recognizer call resolves the same bare and through `this`" {
    // `getText()` and `this.getText()` are one call in Java. In a lexer both are
    // the matched slice; taking the `this.` spelling for a receiver made it a
    // token read the lexer has no stream for, and the body was dropped.
    let lang = ActionLanguage::Java;
    for let body of &["getText()", "this.getText()"] {
        let mut g = parse(`lexer grammar L;
A : 'a' { System.out.println(${*body}); } ;
`).unwrap();
        let msgs = stage_lexer_bodies(&mut g, &lang, &NO_MEMBERS);
        assert msgs.is_empty();
        let staged = g.lexer_rules[0].body[0].actions[0].source.text;
        assert staged.contains("span_text(src, start, pos)");
    }

    // And in a parser body both are the rule's own consumed span.
    let bare = java_action("System.out.println(getText());", "a : ID ;", false);
    let qualified = java_action("System.out.println(this.getText());", "a : ID ;", false);
    assert bare == qualified;
}

test "grammar_has_superclass keys the Phase 4 carve-out" {
    let with_super = parse("grammar T;
options { superClass = TBase; }
a : A ;
").unwrap();
    assert grammar_has_superclass(&with_super), "superClass grammar must be detected";

    let plain = parse("grammar T;
a : A ;
").unwrap();
    assert !grammar_has_superclass(&plain), "grammar without superClass must not be detected";
}

test "a ctx token accessor reads the token's binding, or a list where the name repeats" {
    let bindings: List<AltBinding> = [
        AltBinding { is_token: true, base: "a", field: "a" },
    ];
    let accessor = |grammar: &String| {
        let g = parse(grammar).unwrap();
        return translate_predicate(
            &ActionLanguage::Java,
            &g.parser_rules[0],
            &g.parser_rules,
            "((SContext)$ctx).A() != null",
            false,
            &bindings,
            &g.name,
            &NO_MEMBERS,
        );
    };
    assert accessor(&"grammar T;\ns : ID A ;\n") matches { Ok(code) && code == "a >= 0" };
    // A name occurring twice in the context gives ANTLR4 a list accessor.
    assert accessor(&"grammar T;\ns : A? A ;\n") matches { Ok(code) && code == "true" };
}

test "java action: a labeled rule's ctx renders through its captured node" {
    // `ParseTrees/RuleRef`: `$r.ctx` is the node, so the call on it is dropped.
    let out = java_action("System.out.println($r.ctx.toStringTree(this));", "s : r=a ;\na : 'x' ;", false);
    assert out == "p.emit(`${p.rule_tree_at(vals._node_r)}\\n`);";
}

test "java action: getRuleInvocationStack() reads the parser's rule stack" {
    let out = java_action("System.out.println(getRuleInvocationStack());", "a : ID ;", false);
    assert out == "p.emit(`${p.rule_stack()}\\n`);";
}

test "java predicate: && binds tighter than ||, as in Java" {
    let flat = java_pred("$i == 1 || $i == 2 && this.b", "a[i32 i] : ID ;", true);
    assert flat == "vals.i == 1 || vals.i == 2 && p.b";
    let grouped = java_pred("($i == 1 || $i == 2) && this.b", "a[i32 i] : ID ;", true);
    assert grouped == "(vals.i == 1 || vals.i == 2) && p.b";
}

test "java print: a string concat interpolates each operand that is not a string" {
    // Java adds `$i + 1` before concatenating, so it stays one interpolation.
    let out = java_action(
        "System.out.println(($i + 1) + \" y=\" + $i * 2 + (\"!\" + \"?\"));",
        "a[i32 i] : ID ;",
        true,
    );
    assert out == "p.emit(`${(vals.i + 1)} y=${vals.i * 2}!?\\n`);";
}

test "java print: `$` and backticks in a string literal stay text" {
    let out = java_action("System.out.println(\"cost ${n} `q`\");", "a : ID ;", false);
    assert out == "p.emit(`cost \\${n} \\`q\\`\\n`);";
}

test "java predicate: a null test reads the token's binding, and a member's as written" {
    let g = parse("grammar T;
s : ID A ;
").unwrap();
    let bindings: List<AltBinding> = [
        AltBinding { is_token: true, base: "a", field: "a" },
    ];
    let members = MemberNames {
        methods: ["f"],
    };
    let cases: List<[String, String]> = [
        ["((SContext)$ctx).A() == null", "a < 0"],
        ["this.n > 0", "p.n > 0"],
        ["this.n != 0", "p.n != 0"],
        ["this.n == null", "p.n == null"],
        ["f(1) == null", "p.f(1) == null"],
        ["f() == null", "p.f() == null"],
        ["this.f() == null", "p.f() == null"],
    ];
    for let [body, want] of cases {
        let out = translate_predicate(
            &ActionLanguage::Java,
            &g.parser_rules[0],
            &g.parser_rules,
            body,
            false,
            &bindings,
            &g.name,
            &members,
        );
        assert out matches { Ok(code) && code == want };
    }
}

test "java members: a method's receiver follows every way its body can write" {
    let m = translate_members(
        &ActionLanguage::Java,
        "int n = 0;
          void bump() { n = n + 1; }
          int take() { int r = this.next(); return r; }
          int next() { this.n = this.n + 1; return this.n; }
          boolean checked() { assert this.next() > 0; return true; }
          boolean negated() { return !(this.n > 0); }
          boolean same(int a, int b) { return a == b; }
          void reset() { this.n = 0; return; }
          boolean argued() { return this.same(this.next(), 1); }
          int widened() { return (int)this.next(); }",
        "T",
    ).unwrap();
    let mut mutating: List<String> = [];
    for let method of &m.methods {
        if method.mutates {
            mutating.push(method.name);
        }
    }
    let want: List<String> = ["bump", "take", "next", "checked", "reset", "argued", "widened"];
    assert mutating == want;
    assert m.methods[0].source == "fn bump(&mut self) { self.n = self.n + 1; }";
    assert m.methods[4].source == "fn negated(&self) -> bool { return !(self.n > 0); }";
    assert m.methods[5].source == "fn same(&self, a: i32, b: i32) -> bool { return a == b; }";
    assert m.methods[6].source == "fn reset(&mut self) { self.n = 0; return; }";

    let call = java_pred_m("this.same(1, 2)", "a : ID ;", false, &member_names(&m));
    assert call == "p.same(1, 2)";
}

test "java attribute types map to Wado; one outside the subset passes through" {
    let mut g = parse("grammar T;
r[int a] returns [boolean ok, List<String> xs] locals [long n] : ID ;
").unwrap();
    translate_attr_types(&mut g);
    let r = &g.parser_rules[0];
    assert r.args[0].type_text == "i32" && r.returns_decls[0].type_text == "bool";
    assert r.returns_decls[1].type_text == "List<String>" && r.locals_decls[0].type_text == "i64";
}

test "an action language without a translator is refused at every entry" {
    let g = parse("grammar T;
a : ID ;
").unwrap();
    let cpp = ActionLanguage::Other("Cpp");
    let action = translate_action(
        &cpp,
        &g.parser_rules[0],
        &g.parser_rules,
        "x();",
        false,
        &NO_BINDINGS,
        "T",
        &NO_MEMBERS,
    );
    assert action matches { Err(m) && m.contains("unsupported action language 'Cpp'") };
    let pred = translate_predicate(
        &cpp,
        &g.parser_rules[0],
        &g.parser_rules,
        "x()",
        false,
        &NO_BINDINGS,
        "T",
        &NO_MEMBERS,
    );
    assert pred matches { Err(m) && m.contains("unsupported action language 'Cpp'") };
    assert translate_members(&cpp, "int n = 0;", "T") matches { Err(m) && m.contains("'Cpp'") };
    let mut lexer = parse("lexer grammar L;
A : 'a' { x(); } ;
").unwrap();
    let msgs = stage_lexer_bodies(&mut lexer, &cpp, &NO_MEMBERS);
    assert msgs.len() == 1 && msgs[0].contains("'Cpp'");
}

test "a value channel alone turns the action machinery on" {
    // `returns` with no action body still gives callers a `$r.v` to read.
    let channel = parse("grammar T;
options { language = Wado; }
r returns [i32 v] : ID ;
").unwrap();
    assert should_emit_actions(&channel);
    let plain = parse("grammar T;
options { language = Wado; }
r : ID ;
").unwrap();
    assert !should_emit_actions(&plain);
}

test "java: an integer cast is dropped and its operand kept" {
    // Wado infers the operand's type from the comparison, so the cast adds nothing.
    let out = java_pred("(int)this.n > (long)3", "a : ID ;", false);
    assert out == "p.n > 3";
}

test "java: a floating cast is a loud error" {
    for let java of ["(double)this.n / 2 > 1", "(float)(this.n) / this.n > 1"] {
        let res = java_pred_res(java, "a : ID ;", false);
        assert res.is_err();
    }
}

test "java: a parenthesized name is a cast only when an operand follows it" {
    let cases: List<[String, String]> = [
        ["(int)(this.n) > 2", "(p.n) > 2"],
        ["(boolean)!this.b", "!p.b"],
        ["this.b == (true)", "p.b == (true)"],
        ["(true) == this.b", "(true) == p.b"],
    ];
    for let [java, wado] of cases {
        let out = java_pred(&java, "a : ID ;", false);
        assert out == wado;
    }
}

test "java action: an increment statement is a compound assignment" {
    let members = MemberNames {
        fields: ["ids"],
    };
    let cases: List<[String, String]> = [
        ["ids++;", "p.ids += 1;"],
        ["++ids;", "p.ids += 1;"],
        ["this.ids--;", "p.ids -= 1;"],
        ["(ids)++;", "p.ids += 1;"],
        ["--(this.ids);", "p.ids -= 1;"],
        ["int n = 0; n++;", "let mut n: i32 = 0; n += 1;"],
    ];
    for let [java, wado] of cases {
        let out = java_action_m(&java, "a : ID ;", false, &members);
        assert out == wado;
    }
}

test "java action: an increment inside an expression is refused" {
    // Its value differs between the prefix and postfix forms, which a compound
    // assignment cannot carry.
    let res = java_action_res("System.out.print(this.ids++);", "a : ID ;", false);
    assert res == Result::Err("java2wado: `++` and `--` are supported only as a statement");
}

test "java action: an increment of anything but a variable or field is refused" {
    let res = java_action_res("getText()++;", "a : ID ;", false);
    assert res == Result::Err("java2wado: `++` and `--` step a variable or a field");
}

test "java members: a field without an initializer takes its type's default" {
    let lang = ActionLanguage::Java;
    let m = translate_members(&lang, "int n; boolean b; long l;", "T").unwrap();
    let inits: List<String> = m.fields.iter_ref().map(|f: &MemberField| f.init).collect();
    assert inits == ["0", "false", "0"];
}

test "java members: a String field without an initializer is refused" {
    // Java's default is null, which a Wado String cannot hold.
    let lang = ActionLanguage::Java;
    let res = translate_members(&lang, "String name;", "T");
    assert res matches { Err(_) }, "a String field needs an initializer";
}

test "java: `+` with a String-typed operand concatenates" {
    let lang = ActionLanguage::Java;
    let members = member_names(
        &translate_members(&lang, "String label = \"x\"; String tag() { return label; }", "T").unwrap(),
    );
    // Types as `translate_attr_types` leaves them.
    let rule = "a[String t, i32 n] returns [String r] locals [String l] : ID ;";
    let cases: List<[String, String]> = [
        ["System.out.print($t + $n);", "p.emit(`${vals.t}${vals.n}`);"],
        ["System.out.print(t + n);", "p.emit(`${vals.t}${vals.n}`);"],
        ["System.out.print($n + $r);", "p.emit(`${vals.n}${vals.r}`);"],
        ["System.out.print($l + 1);", "p.emit(`${vals.l}${1}`);"],
        ["String s = \"x\"; System.out.print(s + $n);", "let mut s: String = \"x\"; p.emit(`${s}${vals.n}`);"],
        ["System.out.print(label + $n);", "p.emit(`${p.label}${vals.n}`);"],
        ["System.out.print($ID.text + $n);", "p.emit(`${p.token_text(id)}${vals.n}`);"],
        ["System.out.print($n + $n + $t);", "p.emit(`${vals.n + vals.n}${vals.t}`);"],
        ["System.out.print(tag() + $n);", "p.emit(`${p.tag()}${vals.n}`);"],
        ["System.out.print(this.tag() + $n);", "p.emit(`${p.tag()}${vals.n}`);"],
        ["System.out.print($n + ($t + $n) + $n);", "p.emit(`${vals.n}${vals.t}${vals.n}${vals.n}`);"],
    ];
    for let [java, wado] of cases {
        let out = java_action_m(&java, rule, true, &members);
        assert out == wado;
    }
}

test "java members: a String field or parameter makes `+` concatenate in a method" {
    let lang = ActionLanguage::Java;
    let m = translate_members(
        &lang,
        "String label = \"x\"; void show(int n) { System.out.print(label + n); } void tag(String s, int n) { System.out.print(s + n); }",
        "T",
    ).unwrap();
    assert m.methods[0].source == "fn show(&mut self, n: i32) { self.emit(`${self.label}${n}`); }";
    assert m.methods[1].source == "fn tag(&mut self, s: String, n: i32) { self.emit(`${s}${n}`); }";
}

test "java action: a comment translates to nothing" {
    let line = java_action("x++; // note\n", "a : ID ;", false);
    let block = java_action("x++; /* note */", "a : ID ;", false);
    let plain = java_action("x++;", "a : ID ;", false);
    assert line == plain;
    assert block == plain;
}

test "java: an unterminated string literal is a loud error" {
    assert java_action_res("System.out.println(\"abc); ", "a : ID ;", false).is_err();
    assert java_pred_res("this.s == \"ab", "a : ID ;", false).is_err();
}

// An iteration that ends behind a nested decision's empty alternative re-enters
// the loop's body, so that decision meets what the body opens with.
test "a decision inside a loop body meets the body's predicates through the loop-back" {
    let mut g = parse("grammar T;
r : ( {p}? 'a' | 'c' ( 'b' | ) )* 'x' ;
").unwrap();
    assign_atn_decisions(&mut g);
    let Repeat(rep) = g.parser_rules[0].alternatives[0].elements[0] else {
        panic("the loop leads the rule");
    };
    let Group(body) = rep.element else {
        panic("the loop's body is a group");
    };
    let Group(nested) = body.alternatives[1].elements[1] else {
        panic("the body's second alternative ends in a group");
    };
    let mut analysis = GrammarAnalysis::new(&g.parser_rules);
    let decisions = decision_predicates(&GenSettings { emit_actions: true }, &mut analysis);
    assert decisions.at_site(nested.atn_decision).len() == 1;
}

use { SllDfa, SllNode, SllEdge, SllForest } from "./atn_sll.wado";

test "a lookahead DFA's branches that decide alike merge" {
    let mut forest = SllForest::new(8);
    let start = forest.add(&SllDfa {
        nodes: [
            SllNode::Branch([SllEdge { tokens: [1], to: 1 }, SllEdge { tokens: [2], to: 2 }]),
            SllNode::Branch([SllEdge { tokens: [3], to: 3 }]),
            SllNode::Branch([SllEdge { tokens: [3], to: 4 }]),
            SllNode::Alt(0),
            SllNode::Alt(0),
        ],
        kinds: 8,
    });
    let merged: List<SllNode> = [
        SllNode::Alt(0),
        SllNode::Branch([SllEdge { tokens: [3], to: 0 }]),
        SllNode::Branch([SllEdge { tokens: [1, 2], to: 1 }]),
    ];
    assert forest.nodes == merged;
    assert start == 2;
    assert !forest.shared(1), "one edge reads the merged branch";
}

test "two lookahead DFAs share the branches that decide alike" {
    let mut forest = SllForest::new(8);
    let first = forest.add(&SllDfa {
        nodes: [SllNode::Branch([SllEdge { tokens: [1], to: 1 }]), SllNode::Branch([SllEdge { tokens: [3], to: 2 }]), SllNode::Alt(0)],
        kinds: 8,
    });
    let second = forest.add(&SllDfa {
        nodes: [SllNode::Branch([SllEdge { tokens: [7], to: 1 }]), SllNode::Branch([SllEdge { tokens: [3], to: 2 }]), SllNode::Alt(0)],
        kinds: 8,
    });
    assert forest.nodes.len() == 4;
    assert first != second;
    assert forest.shared(1);
}

test "a lookahead DFA's branches at different depths stay apart" {
    let mut forest = SllForest::new(8);
    forest.add(&SllDfa {
        nodes: [
            SllNode::Branch([SllEdge { tokens: [1], to: 1 }, SllEdge { tokens: [2], to: 2 }]),
            SllNode::Branch([SllEdge { tokens: [5], to: 3 }]),
            SllNode::Branch([SllEdge { tokens: [6], to: 4 }]),
            SllNode::Alt(0),
            SllNode::Branch([SllEdge { tokens: [5], to: 3 }]),
        ],
        kinds: 8,
    });
    assert forest.nodes.len() == 5;
}
