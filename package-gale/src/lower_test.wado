//! Smoke tests for `lower(Grammar) -> LoweredGrammar`. Each builds a minimal
//! `Grammar` by struct literal, exercising lowering apart from the g4 parser.

use {
    Grammar,
    GrammarOption,
    OptionValue,
    ParserRule,
    Alternative,
    Element,
    RuleRefElement,
    TokenRefElement,
    LiteralElement,
    WildcardElement,
    NotElement,
    LabelElement,
    RepeatElement,
    RepeatKind,
    GroupElement,
    Visibility,
} from "./ir.wado";
use { collect_literal_tokens } from "./lexer_gen.wado";
use { lower } from "./lower.wado";
use { LowerContext } from "./lower_context.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { GenSettings } from "./gen_settings.wado";
use {
    assert_canonical_shape,
    assign_atn_call_sites,
    assign_atn_decisions,
    canonicalize_empty_alt_groups,
} from "./ir.wado";
use { decision_predicates } from "./gate_conditions.wado";
use { parse } from "./g4/parser.wado";
use { empty_grammar, alt } from "../tests/support/fixtures.wado";
use {
    LoweredGrammar,
    Op,
    DiagnosticOwner,
    admits_enumerated,
    admits_is_everything,
    alt_class_first_set,
    AltClass,
} from "./gir.wado";

/// Lowers `g` without literal tokens, with the analysis whose table names the
/// kinds the lowering minted.
fn lower_keeping_kinds(g: &Grammar) -> [LoweredGrammar, GrammarAnalysis] {
    let mut ctx = LowerContext::new(GrammarAnalysis::new(&g.parser_rules), GenSettings {});
    let lowered = lower(g, &[], &mut ctx);
    return [lowered, ctx.analysis];
}

fn first_names(an: &GrammarAnalysis, class: &AltClass) -> List<String> {
    return an.token_names_of(&alt_class_first_set(class));
}

test "lower passes through grammar metadata" {
    let mut g = empty_grammar("JSON");
    g.source_files = ["JSON.g4"];
    let lowered = lower(&g, &[]);
    assert lowered.name == "JSON";
    assert lowered.source_files.len() == 1;
    assert lowered.source_files[0] == "JSON.g4";
    assert lowered.parser_rules.is_empty();
    assert lowered.mode_names.len() == 1;
}

test "lower simple rule with single TokenRef" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "value",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    assert lowered.parser_rules.len() == 1;
    let rule = &lowered.parser_rules[0];

    if let Simple(s) = rule {
        assert s.header.name == "value";
        assert s.header.snake_name == "value";
        assert s.header.type_name == "ValueNode";
        assert s.body.alt_index == 0;
        assert s.body.case_name == "";
        assert s.body.struct_name == "ValueNode";
        assert s.body.ops.len() == 1;
        if let Token(t) = &s.body.ops[0] {
            assert an.token_name(t.kind) == "TK_INT";
            assert t.field == "int";
        } else {
            panic("expected Op::Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule with Literal" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
