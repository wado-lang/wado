//! Smoke tests for `lower(Grammar) -> LoweredGrammar`.
//!
//! Phase 2.1 covers single-alternative rules with leaf elements
//! (TokenRef / Literal / RuleRef / Wildcard / Not). Tests build a
//! minimal `Grammar` directly via struct-literal syntax (no g4
//! parser) so the lowering invariants are exercised in isolation
//! from the front end.

use {
    Grammar,
    GrammarKind,
    ParserRule,
    Alternative,
    Element,
    RuleRefElement,
    TokenRefElement,
    LiteralElement,
    WildcardElement,
    NotElement,
    LabelElement,
    Visibility,
} from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use { lower } from "./lower.wado";
use {
    Rule,
    Op,
    ScanElement,
    MultiAltDispatch,
} from "./gir.wado";

fn empty_grammar(name: &String) -> Grammar {
    return Grammar {
        name: *name,
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
}

fn no_lit_tokens() -> Array<LitToken> {
    return [];
}

fn alt_of(elements: Array<Element>) -> Alternative {
    return Alternative {
        label: null,
        options: [],
        elements,
    };
}

test "lower passes through grammar metadata" {
    let mut g = empty_grammar(&"JSON");
    g.source_files = ["JSON.g4"];
    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.name == "JSON";
    assert lowered.source_files.len() == 1;
    assert lowered.source_files[0] == "JSON.g4";
    assert lowered.parser_rules.is_empty();
    assert lowered.variant_rules.is_empty();
    assert lowered.kind_sets.is_empty();
    assert lowered.mode_names.len() == 1;
}

test "lower simple rule with single TokenRef" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "value",
        Visibility::Default,
        [],
        [alt_of([Element::TokenRef(TokenRefElement::new("INT"))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.parser_rules.len() == 1;
    let rule = &lowered.parser_rules[0];

    if let Simple(s) = rule {
        assert s.header.name == "value";
        assert s.header.snake_name == "value";
        assert s.header.type_name == "ValueNode";
        assert s.body.alt_index == 0;
        assert s.body.case_name == "";
        assert s.body.struct_name == "ValueNode";
        assert s.body.ops.len() == 1;
        if let Token(t) = &s.body.ops[0] {
            assert t.kind == "TK_INT";
            assert t.field == "int";
        } else {
            panic("expected Op::Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule with Literal" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "punc",
        Visibility::Default,
        [],
        [alt_of([Element::Literal(LiteralElement::new("+"))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Literal(l) = &s.body.ops[0] {
            assert l.kind == "TK_LIT_PLUS";
            assert l.field == "plus";
        } else {
            panic("expected Op::Literal");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule with RuleRef" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "stmt",
        Visibility::Default,
        [],
        [alt_of([Element::RuleRef(RuleRefElement::new("expr"))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let RuleCall(r) = &s.body.ops[0] {
            assert r.target_name == "expr";
            assert r.target_snake == "expr";
            assert r.field == "expr";
            assert r.variant_id matches { None };
            assert r.min_prec_arg matches { None };
        } else {
            panic("expected Op::RuleCall");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule with Wildcard" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "any",
        Visibility::Default,
        [],
        [alt_of([Element::Wildcard(WildcardElement::new())])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Wildcard(w) = &s.body.ops[0] {
            assert w.field == "wildcard";
        } else {
            panic("expected Op::Wildcard");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule with Not" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "no_int",
        Visibility::Default,
        [],
        [alt_of([Element::Not(NotElement {
            element: Element::TokenRef(TokenRefElement::new("INT")),
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Excluded(e) = &s.body.ops[0] {
            assert e.kinds.len() == 1;
            assert e.kinds[0] == "TK_INT";
            assert e.field == "not_int";
        } else {
            panic("expected Op::Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower dedupes same-name fields" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "two_ints",
        Visibility::Default,
        [],
        [alt_of([
            Element::TokenRef(TokenRefElement::new("INT")),
            Element::TokenRef(TokenRefElement::new("INT")),
        ])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 2;
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "int";
        } else {
            panic("expected first Token");
        }
        if let Token(t) = &s.body.ops[1] {
            assert t.field == "int_2";
        } else {
            panic("expected second Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower multi-alt rule with disjoint first sets produces Direct dispatch" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "expr",
        Visibility::Default,
        [],
        [
            alt_of([Element::TokenRef(TokenRefElement::new("INT"))]),
            alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]),
            alt_of([Element::TokenRef(TokenRefElement::new("ID"))]),
        ],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        assert m.alts.len() == 3;
        assert m.scan_alts.len() == 3;
        // Per-alt case_name and struct_name follow the
        // `case_names_for_rule` convention. Without explicit alt
        // labels, names are positional: `Alt0`, `Alt1`, ... and the
        // struct combines the rule's bare base ("Expr" — `ExprNode`
        // with the `Node` suffix stripped) with the case name.
        assert m.alts[0].case_name == "Alt0";
        assert m.alts[0].struct_name == "ExprAlt0";
        assert m.alts[1].case_name == "Alt1";
        assert m.alts[1].struct_name == "ExprAlt1";
        assert m.alts[2].case_name == "Alt2";
        assert m.alts[2].struct_name == "ExprAlt2";

        if let Direct(d) = &m.dispatch {
            assert d.branches.len() == 3;
            assert d.branches[0].alt_index == 0;
            assert d.branches[0].tokens[0] == "TK_INT";
            assert d.branches[1].alt_index == 1;
            assert d.branches[1].tokens[0] == "TK_STRING";
            assert d.branches[2].alt_index == 2;
            assert d.branches[2].tokens[0] == "TK_ID";
        } else {
            panic("expected MultiAltDispatch::Direct");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower multi-alt rule with labeled alts uses label as case name" {
    let mut g = empty_grammar(&"T");
    // `expr : INT #IntLit | STRING #StrLit ;` (each alt labeled).
    let mut int_alt = alt_of([Element::TokenRef(TokenRefElement::new("INT"))]);
    int_alt.label = Option::<String>::Some("IntLit");
    let mut str_alt = alt_of([Element::TokenRef(TokenRefElement::new("STRING"))]);
    str_alt.label = Option::<String>::Some("StrLit");
    g.parser_rules = [ParserRule::new(
        "expr",
        Visibility::Default,
        [],
        [int_alt, str_alt],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        // When all alts are labeled, `case_names_for_rule` uses the
        // labels directly (positional `Alt0`/`Alt1` only fires for
        // unlabeled rules).
        assert m.alts[0].case_name == "IntLit";
        assert m.alts[0].struct_name == "ExprIntLit";
        assert m.alts[1].case_name == "StrLit";
        assert m.alts[1].struct_name == "ExprStrLit";
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower simple rule produces scan body mirroring leaf ops" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "mix",
        Visibility::Default,
        [],
        [alt_of([
            Element::TokenRef(TokenRefElement::new("ID")),
            Element::Literal(LiteralElement::new("=")),
            Element::RuleRef(RuleRefElement::new("expr")),
            Element::Wildcard(WildcardElement::new()),
            Element::Not(NotElement {
                element: Element::TokenRef(TokenRefElement::new("INT")),
            }),
        ])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.scan_body.elements.len() == 5;
        if let Token(t) = &s.scan_body.elements[0] {
            assert t.kind == "TK_ID";
        } else {
            panic("scan_body[0] != Token");
        }
        if let Token(t) = &s.scan_body.elements[1] {
            assert t.kind == "TK_LIT_EQ";
        } else {
            panic("scan_body[1] != Token (literal)");
        }
        if let RuleCall(r) = &s.scan_body.elements[2] {
            assert r.target_snake == "expr";
            assert r.min_prec_arg == 0;
            assert r.variant_id matches { None };
        } else {
            panic("scan_body[2] != RuleCall");
        }
        if let Wildcard = &s.scan_body.elements[3] {
            assert true;
        } else {
            panic("scan_body[3] != Wildcard");
        }
        if let Excluded(e) = &s.scan_body.elements[4] {
            assert e.kinds.len() == 1;
            assert e.kinds[0] == "TK_INT";
        } else {
            panic("scan_body[4] != Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower scan element flattens scalar Label" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "labelled",
        Visibility::Default,
        [],
        [alt_of([Element::Label(LabelElement::new(
            "lhs",
            false,
            Element::TokenRef(TokenRefElement::new("ID")),
        ))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.scan_body.elements.len() == 1;
        if let Token(t) = &s.scan_body.elements[0] {
            assert t.kind == "TK_ID";
        } else {
            panic("expected Token in scan_body");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower scalar Label rebinds inner field name" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "labelled",
        Visibility::Default,
        [],
        [alt_of([Element::Label(LabelElement::new(
            "lhs",
            false,
            Element::TokenRef(TokenRefElement::new("ID")),
        ))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Token(t) = &s.body.ops[0] {
            assert t.kind == "TK_ID";
            assert t.field == "lhs";
        } else {
            panic("expected Op::Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Label dedupes against surrounding alt names" {
    let mut g = empty_grammar(&"T");
    // `lhs=ID lhs=ID` — two scalar labels with the same name.
    // dedup_name should produce "lhs" then "lhs_2".
    g.parser_rules = [ParserRule::new(
        "two_labels",
        Visibility::Default,
        [],
        [alt_of([
            Element::Label(LabelElement::new(
                "lhs",
                false,
                Element::TokenRef(TokenRefElement::new("ID")),
            )),
            Element::Label(LabelElement::new(
                "lhs",
                false,
                Element::TokenRef(TokenRefElement::new("ID")),
            )),
        ])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "lhs";
        } else {
            panic("expected first Token");
        }
        if let Token(t) = &s.body.ops[1] {
            assert t.field == "lhs_2";
        } else {
            panic("expected second Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower carries every leaf op in order" {
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "mix",
        Visibility::Default,
        [],
        [alt_of([
            Element::TokenRef(TokenRefElement::new("ID")),
            Element::Literal(LiteralElement::new(":")),
            Element::RuleRef(RuleRefElement::new("expr")),
            Element::Wildcard(WildcardElement::new()),
        ])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 4;
        if let Token(_) = &s.body.ops[0] { assert true; } else { panic("ops[0] != Token"); }
        if let Literal(_) = &s.body.ops[1] { assert true; } else { panic("ops[1] != Literal"); }
        if let RuleCall(_) = &s.body.ops[2] { assert true; } else { panic("ops[2] != RuleCall"); }
        if let Wildcard(_) = &s.body.ops[3] { assert true; } else { panic("ops[3] != Wildcard"); }
    } else {
        panic("expected Rule::Simple");
    }
}
