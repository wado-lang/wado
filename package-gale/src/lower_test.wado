                assert scst.field == "stmt_or_expr_2", scst.field;
            } else {
                panic("expected GroupShape::SimpleCst");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower General Group with disjoint multi-shape alts produces General shape" {
    // `r : (stmt | INT INT) ; stmt : ID ;`
    // Alt 0 is RuleRef → first set {ID}; alt 1 starts with INT.
    // Mixed shape rules out SimpleCst / TokenOnly / SingleAlt, so
    // the classifier picks General.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt_of([Element::Group(GroupElement::new([
                alt_of([Element::RuleRef(RuleRefElement::new("stmt"))]),
                alt_of([
                    Element::TokenRef(TokenRefElement::new("INT")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
            ]))])],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let General(gen) = &go.shape {
                assert gen.variant_type == "RGroup0", gen.variant_type;
                assert gen.field == "group_0", gen.field;
                assert gen.group_index == 0;
                assert gen.alt_struct_names.len() == 2;
                assert gen.alt_struct_names[0] == "RGroup0Alt0", gen.alt_struct_names[0];
                assert gen.alt_struct_names[1] == "RGroup0Alt1", gen.alt_struct_names[1];
            } else {
                panic("expected GroupShape::General");
            }
            assert go.alts.len() == 2;
            assert go.alts[0].case_name == "Alt0", go.alts[0].case_name;
            assert go.alts[0].struct_name == "RGroup0Alt0", go.alts[0].struct_name;
            assert go.alts[1].case_name == "Alt1", go.alts[1].case_name;
            assert go.alts[1].ops.len() == 2;
            // Direct dispatch on each alt's first set.
            if let Direct(dd) = &go.dispatch {
                assert dd.branches.len() == 2;
                assert dd.branches[0].tokens[0] == "TK_ID";
                assert dd.branches[1].tokens[0] == "TK_INT";
            } else {
                panic("expected MultiAltDispatch::Direct");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower General Group group_index is per-rule cumulative" {
    // `r : (stmt | INT INT) (other | FLOAT FLOAT) ;`
    // `stmt : ID ; other : K_OTHER ;`
    // Two general groups; the second gets group_index = 1.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt_of([
                Element::Group(GroupElement::new([
                    alt_of([Element::RuleRef(RuleRefElement::new("stmt"))]),
                    alt_of([
                        Element::TokenRef(TokenRefElement::new("INT")),
                        Element::TokenRef(TokenRefElement::new("INT")),
                    ]),
                ])),
                Element::Group(GroupElement::new([
                    alt_of([Element::RuleRef(RuleRefElement::new("other"))]),
                    alt_of([
                        Element::TokenRef(TokenRefElement::new("FLOAT")),
                        Element::TokenRef(TokenRefElement::new("FLOAT")),
                    ]),
                ])),
            ])],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "other",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("K_OTHER"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 2;
        if let Group(go0) = &s.body.ops[0] {
            if let General(gen) = &go0.shape {
                assert gen.group_index == 0;
                assert gen.variant_type == "RGroup0", gen.variant_type;
                assert gen.field == "group_0", gen.field;
            } else {
                panic("expected first group General");
            }
        } else {
            panic("expected first Op::Group");
        }
        if let Group(go1) = &s.body.ops[1] {
            if let General(gen) = &go1.shape {
                assert gen.group_index == 1;
                assert gen.variant_type == "RGroup1", gen.variant_type;
                assert gen.field == "group_1", gen.field;
            } else {
                panic("expected second group General");
            }
        } else {
            panic("expected second Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat with nested SingleAlt Group inner" {
    // `r : (a b)* ;` — Repeat over a multi-element single-alt Group.
    // The Repeat body becomes a SingleAlt Group Op.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "r",
        Visibility::Default,
        [],
        [alt_of([Element::Repeat(RepeatElement {
            kind: RepeatKind::Star,
            element: Element::Group(GroupElement::new([
                alt_of([
                    Element::TokenRef(TokenRefElement::new("A")),
                    Element::TokenRef(TokenRefElement::new("B")),
                ]),
            ])),
            non_greedy: false,
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Group(go) = &rep.body {
                if let SingleAlt(_) = &go.shape {
                    assert true;
                } else {
                    panic("expected nested SingleAlt Group");
                }
                assert go.alts[0].ops.len() == 2;
            } else {
                panic("expected Repeat body to be Group");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SingleAlt Group containing nested Group" {
    // `r : (a (b c)) ;` — outer SingleAlt contains a nested
    // SingleAlt as its second element. Nested ops carry through
    // recursively.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "r",
        Visibility::Default,
        [],
        [alt_of([Element::Group(GroupElement::new([
            alt_of([
                Element::TokenRef(TokenRefElement::new("A")),
                Element::Group(GroupElement::new([
                    alt_of([
                        Element::TokenRef(TokenRefElement::new("B")),
                        Element::TokenRef(TokenRefElement::new("C")),
                    ]),
                ])),
            ]),
        ]))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(outer) = &s.body.ops[0] {
            if let SingleAlt(_) = &outer.shape {
                assert true;
            } else {
                panic("expected outer SingleAlt");
            }
            assert outer.alts[0].ops.len() == 2;
            if let Group(inner) = &outer.alts[0].ops[1] {
                if let SingleAlt(_) = &inner.shape {
                    assert true;
                } else {
                    panic("expected inner SingleAlt");
                }
                assert inner.alts[0].ops.len() == 2;
            } else {
                panic("expected nested Op::Group");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Transparent Group wrapping Repeat" {
    // `r : (a*) ;` — Transparent Group whose only inner element is
    // a Repeat. The Op is a Repeat directly (no Group wrapper at
    // emit time).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "r",
        Visibility::Default,
        [],
        [alt_of([Element::Group(GroupElement::new([
            alt_of([Element::Repeat(RepeatElement {
                kind: RepeatKind::Star,
                element: Element::TokenRef(TokenRefElement::new("A")),
                non_greedy: false,
            })]),
        ]))])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let Transparent = &go.shape {
                assert true;
            } else {
                panic("expected Transparent shape");
            }
            assert go.alts[0].ops.len() == 1;
            if let Repeat(_) = &go.alts[0].ops[0] {
                assert true;
            } else {
                panic("expected inner Repeat");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Optional Repeat with TokenRef inner uses Plain strategy" {
    // `r : INT? ;` — Optional Repeat. Without a follow-aware
    // variant context, the Plain strategy is correct: emit fires
    // `if peek_kind ∈ first(inner) { ... }`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "r",
        Visibility::Default,
        [],
        [alt_of([Element::Repeat(RepeatElement {
            kind: RepeatKind::Optional,
            element: Element::TokenRef(TokenRefElement::new("INT")),
            non_greedy: false,
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Optional = rep.kind {
                assert true;
            } else {
                panic("expected RepeatKind::Optional");
            }
            if let Plain = rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::Plain");
            }
            if let Token(t) = &rep.body {
                assert t.kind == "TK_INT";
            } else {
                panic("expected Token body");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower greedy Star Repeat with TokenRef inner" {
    // `tokens : INT* ;`
    let mut g = empty_grammar(&"T");
    g.parser_rules = [ParserRule::new(
        "tokens",
        Visibility::Default,
        [],
        [alt_of([Element::Repeat(RepeatElement {
            kind: RepeatKind::Star,
            element: Element::TokenRef(TokenRefElement::new("INT")),
            non_greedy: false,
        })])],
    )];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Repeat(r) = &s.body.ops[0] {
            // RepeatKind round-trips from surface IR to GIR.
            if let Star = r.kind { assert true; } else { panic("expected Star"); }
            // Strategy is Plain at Phase 2.x.partial.
            if let Plain = &r.strategy { assert true; } else { panic("expected Plain"); }
            // Inner Op is the leaf Token, with its own (fresh) field
            // — the binding name inside the loop body, not the
            // surrounding alt's list-typed field.
            if let Token(t) = &r.body {
                assert t.kind == "TK_INT";
                assert t.field == "int";
            } else {
                panic("expected inner Token");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

