test "lower simple rule with Not" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "no_int",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Not(NotElement {
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                    }),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Excluded(e) = &s.body.ops[0] {
            assert e.kinds.len() == 1;
            assert an.token_name(e.kinds[0]) == "TK_INT";
            assert e.field == "not_int";
        } else {
            panic("expected Op::Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower simple rule with Not over multi-token Group" {
    // `r : ~ ( INT | FLOAT ) ;` — Not over a Group whose alts are
    // each a single token. The kinds array carries both
    // alternative kinds.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "no_num",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Not(NotElement {
                        element: Element::Group(GroupElement::new([
                            alt([Element::TokenRef(TokenRefElement::new("INT"))]),
                            alt([Element::TokenRef(TokenRefElement::new("FLOAT"))]),
                        ])),
                    }),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Excluded(e) = &s.body.ops[0] {
            assert e.kinds.len() == 2;
            assert an.token_name(e.kinds[0]) == "TK_INT";
            assert an.token_name(e.kinds[1]) == "TK_FLOAT";
        } else {
            panic("expected Op::Excluded");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower dedupes same-name fields" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "two_ints",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("INT")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 2;
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "int";
        } else {
            panic("expected first Token");
        }
        if let Token(t) = &s.body.ops[1] {
            assert t.field == "int_2";
        } else {
            panic("expected second Token");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower multi-alt rule with disjoint first sets produces Direct dispatch" {
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [
                alt([Element::TokenRef(TokenRefElement::new("INT"))]),
                alt([Element::TokenRef(TokenRefElement::new("STRING"))]),
                alt([Element::TokenRef(TokenRefElement::new("ID"))]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        assert m.alts.len() == 3;
        assert m.scan_alts.len() == 3;
        // Per-alt case_name and struct_name follow the
        // `case_names_for_rule` convention. Without explicit alt
        // labels, names are positional: `Alt0`, `Alt1`, ... and the
        // struct combines the rule's bare base ("Expr" — `ExprNode`
        // with the `Node` suffix stripped) with the case name.
        assert m.alts[0].case_name == "Alt0";
        assert m.alts[0].struct_name == "ExprAlt0";
        assert m.alts[1].case_name == "Alt1";
        assert m.alts[1].struct_name == "ExprAlt1";
        assert m.alts[2].case_name == "Alt2";
        assert m.alts[2].struct_name == "ExprAlt2";

        if let Direct(d) = &m.dispatch {
            assert d.branches.len() == 3;
            assert d.branches[0].alt_index == 0;
            assert first_names(&an, &d.branches[0].alt_class)[0] == "TK_INT";
            assert d.branches[1].alt_index == 1;
            assert first_names(&an, &d.branches[1].alt_class)[0] == "TK_STRING";
            assert d.branches[2].alt_index == 2;
            assert first_names(&an, &d.branches[2].alt_class)[0] == "TK_ID";
        } else {
            panic("expected MultiAltDispatch::Direct");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower multi-alt rule with labeled alts uses label as case name" {
    let mut g = empty_grammar("T");
    // `expr : INT #IntLit | STRING #StrLit ;` (each alt labeled).
    let mut int_alt = alt([Element::TokenRef(TokenRefElement::new("INT"))]);
    int_alt.label = Option::<String>::Some("IntLit");
    let mut str_alt = alt([Element::TokenRef(TokenRefElement::new("STRING"))]);
    str_alt.label = Option::<String>::Some("StrLit");
    g.parser_rules = [
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [int_alt, str_alt],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        // When all alts are labeled, `case_names_for_rule` uses the
        // labels directly (positional `Alt0`/`Alt1` only fires for
        // unlabeled rules).
        assert m.alts[0].case_name == "IntLit";
        assert m.alts[0].struct_name == "ExprIntLit";
        assert m.alts[1].case_name == "StrLit";
        assert m.alts[1].struct_name == "ExprStrLit";
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower transparent Group wraps single leaf element" {
    // `wrapped : (INT) ;` — a syntactic wrapper with no struct of
    // its own. The GroupOp carries `Transparent` shape and the
    // inner Op is the leaf Token verbatim.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "wrapped",
            Visibility::Default,
            [],
            [alt([Element::Group(GroupElement::new([alt([Element::TokenRef(TokenRefElement::new("INT"))])]))])],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let Transparent = &go.shape {
                assert true;
            } else {
                panic("expected GroupShape::Transparent");
            }
            assert go.alts.len() == 1;
            assert go.alts[0].ops.len() == 1;
            if let Token(t) = &go.alts[0].ops[0] {
                assert an.token_name(t.kind) == "TK_INT";
                // Transparent: inner field is bound in the
                // surrounding alt's scope, so dedup uses the same
                // name table.
                assert t.field == "int";
            } else {
                panic("expected inner Token");
            }
            assert go.scan_group.alts.len() == 1;
            assert go.scan_group.alts[0].elements.len() == 1;
            if let Token(t) = &go.scan_group.alts[0].elements[0] {
                assert an.token_name(t.kind) == "TK_INT";
            } else {
                panic("expected scan-side inner Token");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower transparent Group dedupes against surrounding scope" {
    // `pair : INT (INT) ;` — the second INT lives inside a
    // Transparent group, so its binding still nests in the outer
    // alt's name table. Dedup turns the inner field into `int_2`.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "pair",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("INT")),
                    Element::Group(GroupElement::new([alt([Element::TokenRef(TokenRefElement::new("INT"))])])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "int";
        } else {
            panic("expected first Token");
        }
        if let Group(go) = &s.body.ops[1] {
            if let Token(t) = &go.alts[0].ops[0] {
                // The Transparent group inherits the surrounding
                // dedup table, so the second INT is `int_2`.
                assert t.field == "int_2";
            } else {
                panic("expected Token inside Group");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower single-alt Group with two leaves produces SingleAlt shape" {
    // `assignment : (name=ID '=' INT) ;` — a single alt with 3
    // elements lowers to `GroupShape::SingleAlt`. The struct gets
    // its own name table; the surrounding alt sees a single field.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "assignment",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::Literal(LiteralElement::new("=")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let SingleAlt(sa) = &go.shape {
                // Struct name comes from `single_alt_group_type_name`.
                // `=` lowers to `eq` (per `symbol_char_names`).
                assert sa.struct_name == "IdEqIntItem";
                // Field name comes from `single_alt_group_field_name`.
                assert sa.field == "id_eq_int";
                // owner_rule threads the surrounding rule through.
                assert sa.owner_rule == "assignment";
            } else {
                panic("expected GroupShape::SingleAlt");
            }
            assert go.alts.len() == 1;
            assert go.alts[0].ops.len() == 3;
            assert go.alts[0].struct_name == "IdEqIntItem";
            assert go.scan_group.alts.len() == 1;
            assert go.scan_group.alts[0].elements.len() == 3;
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower single-alt Group uses fresh name table for inner ops" {
    // `pair : ID (ID INT) ;` — the outer ID dedups under `id`.
    // The inner Group is a SingleAlt, so its first ID gets the
    // base name `id` again (fresh table inside the struct).
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "pair",
            Visibility::Default,
            [],
            [
                alt([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::Group(GroupElement::new([
                        alt([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Token(t) = &s.body.ops[0] {
            assert t.field == "id";
        } else {
            panic("expected first Token");
        }
        if let Group(go) = &s.body.ops[1] {
            if let SingleAlt(_) = &go.shape {
                assert true;
            } else {
                panic("expected GroupShape::SingleAlt");
            }
            // Inner ops live in a fresh name table — the inner ID
            // is `id` not `id_2`.
            if let Token(t) = &go.alts[0].ops[0] {
                assert t.field == "id";
            } else {
                panic("expected inner Token ID");
            }
            if let Token(t) = &go.alts[0].ops[1] {
                assert t.field == "int";
            } else {
                panic("expected inner Token INT");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower single-alt Group field name dedupes against outer scope" {
    // `r : id_int (ID INT) ;` — the outer field name `id_int`
    // collides with the inner group's `single_alt_group_field_name`,
    // which is also `id_int`. The outer name table dedupes the
    // group's field to `id_int_2`.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Label(LabelElement::new(
                        "id_int",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Group(GroupElement::new([
                        alt([
                            Element::TokenRef(TokenRefElement::new("ID")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[1] {
            if let SingleAlt(sa) = &go.shape {
                assert sa.field == "id_int_2";
            } else {
                panic("expected GroupShape::SingleAlt");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower token-only Group produces TokenOnly shape with single field" {
    // `cmd : (K_INSERT | K_REPLACE) ;`
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "cmd",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([Element::TokenRef(TokenRefElement::new("K_INSERT"))]),
                        alt([Element::TokenRef(TokenRefElement::new("K_REPLACE"))]),
                    ])),
                ]),
            ],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let TokenOnly(to) = &go.shape {
                // Field name comes from `token_group_field_name`.
                assert to.field == "k_insert_or_k_replace";
            } else {
                panic("expected GroupShape::TokenOnly");
            }
            assert go.alts.len() == 2;
            assert go.alts[0].ops.len() == 1;
            assert go.alts[1].ops.len() == 1;
            // Direct dispatch on each alt's single token kind.
            if let Direct(dd) = &go.dispatch {
                assert dd.branches.len() == 2;
                assert first_names(&an, &dd.branches[0].alt_class).len() == 1;
                assert first_names(&an, &dd.branches[0].alt_class)[0] == "TK_K_INSERT";
                assert dd.branches[0].alt_index == 0;
                assert first_names(&an, &dd.branches[1].alt_class)[0] == "TK_K_REPLACE";
                assert dd.branches[1].alt_index == 1;
            } else {
                panic("expected MultiAltDispatch::Direct");
            }
            assert go.scan_group.alts.len() == 2;
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower token-only Group accepts Literal alts" {
    // `op : ('+' | '-') ;`
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "op",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([Element::Literal(LiteralElement::new("+"))]),
                        alt([Element::Literal(LiteralElement::new("-"))]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[0] {
            if let TokenOnly(to) = &go.shape {
                assert to.field == "plus_or_minus";
            } else {
                panic("expected GroupShape::TokenOnly");
            }
            // Each alt's body op is the matched Literal.
            if let Literal(_) = &go.alts[0].ops[0] {
                assert true;
            } else {
                panic("expected Literal Op for `+` alt");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower token-only Group field dedupes against outer scope" {
    // `r : k_a (K_A | K_B) ;` — a label binds the outer field
    // `k_a`, then the group's `token_group_field_name` is
    // `k_a_or_k_b`. No collision today, so this just sanity-checks
    // that the outer scope sees the group's field through dedup.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Label(LabelElement::new(
                        "k_a_or_k_b",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Group(GroupElement::new([
                        alt([Element::TokenRef(TokenRefElement::new("K_A"))]),
                        alt([Element::TokenRef(TokenRefElement::new("K_B"))]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[1] {
            if let TokenOnly(to) = &go.shape {
                // Outer label took the base name; the group dedups
                // to `_2`.
                assert to.field == "k_a_or_k_b_2";
            } else {
                panic("expected GroupShape::TokenOnly");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SimpleCst Group with single-RuleRef alts produces SimpleCst shape" {
    // `wrap : (stmt | expr) ; stmt : ID ; expr : INT ;`
    // The wrap rule's group is SimpleCst — each alt is a single
    // distinct RuleRef with disjoint first sets.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "wrap",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt([Element::RuleRef(RuleRefElement::new("expr"))]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let SimpleCst(scst) = &go.shape {
                assert scst.type_name == "StmtOrExprGroup";
                assert scst.field == "stmt_or_expr";
            } else {
                panic("expected GroupShape::SimpleCst");
            }
            assert go.alts.len() == 2;
            assert go.alts[0].case_name == "Stmt";
            assert go.alts[1].case_name == "Expr";
            // Each body op is the matched RuleCall.
            if let RuleCall(rc) = &go.alts[0].ops[0] {
                assert rc.target_name == "stmt";
                assert rc.target_snake == "stmt";
                assert rc.field == "stmt";
            } else {
                panic("expected RuleCall for first alt");
            }
            // Direct dispatch on each rule's first set.
            if let Direct(dd) = &go.dispatch {
                assert dd.branches.len() == 2;
                assert first_names(&an, &dd.branches[0].alt_class)[0] == "TK_ID";
                assert first_names(&an, &dd.branches[1].alt_class)[0] == "TK_INT";
            } else {
                panic("expected MultiAltDispatch::Direct");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SimpleCst Group field dedupes against outer scope" {
    // `r : stmt_or_expr=ID (stmt | expr) ; stmt : INT ; expr : ID ;`
    // The outer label binds `stmt_or_expr` first; the group dedups
    // its base name to `stmt_or_expr_2`.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Label(LabelElement::new(
                        "stmt_or_expr",
                        false,
                        Element::TokenRef(TokenRefElement::new("ID")),
                    )),
                    Element::Group(GroupElement::new([
                        alt([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt([Element::RuleRef(RuleRefElement::new("expr"))]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("INT"))])],
        ),
        ParserRule::new(
            "expr",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("FLOAT"))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(go) = &s.body.ops[1] {
            if let SimpleCst(scst) = &go.shape {
                assert scst.field == "stmt_or_expr_2";
            } else {
                panic("expected GroupShape::SimpleCst");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower General Group with disjoint multi-shape alts produces General shape" {
    // `r : (stmt | INT INT) ; stmt : ID ;`
    // Alt 0 is RuleRef → first set {ID}; alt 1 starts with INT.
    // Mixed shape rules out SimpleCst / TokenOnly / SingleAlt, so
    // the classifier picks General.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt([
                            Element::TokenRef(TokenRefElement::new("INT")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
    ];

    let [lowered, an] = lower_keeping_kinds(&g);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Group(go) = &s.body.ops[0] {
            if let General(gen) = &go.shape {
                assert gen.variant_type == "RGroup0";
                assert gen.field == "group_0";
                assert gen.group_index == 0;
                assert gen.alt_struct_names.len() == 2;
                assert gen.alt_struct_names[0] == "RGroup0Alt0";
                assert gen.alt_struct_names[1] == "RGroup0Alt1";
            } else {
                panic("expected GroupShape::General");
            }
            assert go.alts.len() == 2;
            assert go.alts[0].case_name == "Alt0";
            assert go.alts[0].struct_name == "RGroup0Alt0";
            assert go.alts[1].case_name == "Alt1";
            assert go.alts[1].ops.len() == 2;
            // Direct dispatch on each alt's first set.
            if let Direct(dd) = &go.dispatch {
                assert dd.branches.len() == 2;
                assert first_names(&an, &dd.branches[0].alt_class)[0] == "TK_ID";
                assert first_names(&an, &dd.branches[1].alt_class)[0] == "TK_INT";
            } else {
                panic("expected MultiAltDispatch::Direct");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower General Group group_index is per-rule cumulative" {
    // `r : (stmt | INT INT) (other | FLOAT FLOAT) ;`
    // `stmt : ID ; other : K_OTHER ;`
    // Two general groups; the second gets group_index = 1.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([Element::RuleRef(RuleRefElement::new("stmt"))]),
                        alt([
                            Element::TokenRef(TokenRefElement::new("INT")),
                            Element::TokenRef(TokenRefElement::new("INT")),
                        ]),
                    ])),
                    Element::Group(GroupElement::new([
                        alt([Element::RuleRef(RuleRefElement::new("other"))]),
                        alt([
                            Element::TokenRef(TokenRefElement::new("FLOAT")),
                            Element::TokenRef(TokenRefElement::new("FLOAT")),
                        ]),
                    ])),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
        ParserRule::new(
            "other",
            Visibility::Default,
            [],
            [alt([Element::TokenRef(TokenRefElement::new("K_OTHER"))])],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 2;
        if let Group(go0) = &s.body.ops[0] {
            if let General(gen) = &go0.shape {
                assert gen.group_index == 0;
                assert gen.variant_type == "RGroup0";
                assert gen.field == "group_0";
            } else {
                panic("expected first group General");
            }
        } else {
            panic("expected first Op::Group");
        }
        if let Group(go1) = &s.body.ops[1] {
            if let General(gen) = &go1.shape {
                assert gen.group_index == 1;
                assert gen.variant_type == "RGroup1";
                assert gen.field == "group_1";
            } else {
                panic("expected second group General");
            }
        } else {
            panic("expected second Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat with nested SingleAlt Group inner" {
    // `r : (a b)* ;` — Repeat over a multi-element single-alt Group.
    // The Repeat body becomes a SingleAlt Group Op.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Group(GroupElement::new([
                            alt([
                                Element::TokenRef(TokenRefElement::new("A")),
                                Element::TokenRef(TokenRefElement::new("B")),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Group(go) = &rep.body {
                if let SingleAlt(_) = &go.shape {
                    assert true;
                } else {
                    panic("expected nested SingleAlt Group");
                }
                assert go.alts[0].ops.len() == 2;
            } else {
                panic("expected Repeat body to be Group");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower SingleAlt Group containing nested Group" {
    // `r : (a (b c)) ;` — outer SingleAlt contains a nested
    // SingleAlt as its second element. Nested ops carry through
    // recursively.
    let mut g = empty_grammar("T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt([
                    Element::Group(GroupElement::new([
                        alt([
                            Element::TokenRef(TokenRefElement::new("A")),
                            Element::Group(GroupElement::new([
                                alt([
                                    Element::TokenRef(TokenRefElement::new("B")),
                                    Element::TokenRef(TokenRefElement::new("C")),
                                ]),
                            ])),
                        ]),
                    ])),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &[]);
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Group(outer) = &s.body.ops[0] {
            if let SingleAlt(_) = &outer.shape {
                assert true;
            } else {
                panic("expected outer SingleAlt");
            }
            assert outer.alts[0].ops.len() == 2;
            if let Group(inner) = &outer.alts[0].ops[1] {
                if let SingleAlt(_) = &inner.shape {
                    assert true;
                } else {
                    panic("expected inner SingleAlt");
                }
                assert inner.alts[0].ops.len() == 2;
            } else {
                panic("expected nested Op::Group");
            }
        } else {
            panic("expected Op::Group");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

