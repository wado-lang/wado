        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower non-greedy Group Repeat fills exit_second from inner suffix" {
    // `r : (',' INT)*? ',' STRING ;` — peek(0)==',' for both
    // the inner and the follow; peek(1) distinguishes INT (inner)
    // from STRING (follow). `exit_second` carries the inner's
    // post-first first set so emit can disambiguate.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Group(GroupElement::new([
                            alt_of([
                                Element::Literal(LiteralElement::new(",")),
                                Element::TokenRef(TokenRefElement::new("INT")),
                            ]),
                        ])),
                        non_greedy: true,
                    }),
                    Element::Literal(LiteralElement::new(",")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let NonGreedy(ng) = &rep.strategy {
                // exit_first = first(',' STRING) = { TK_LIT_COMMA }.
                assert ng.exit_first.len() == 1;
                assert ng.exit_first[0] == "TK_LIT_COMMA";
                // exit_second = first of inner-after-first = { TK_INT }.
                assert ng.exit_second.len() == 1, `expected 1, got {ng.exit_second.len()}`;
                assert ng.exit_second[0] == "TK_INT", ng.exit_second[0];
            } else {
                panic("expected RepeatStrategy::NonGreedy");
            }
            // body_second_position_first = first of inner-Group's
            // elements from index 1 = { TK_INT }. Consumed by emit's
            // `compute_non_greedy_condition` 2-token disambiguation arm.
            assert rep.body_second_position_first.len() == 1,
                `expected 1, got {rep.body_second_position_first.len()}`;
            assert rep.body_second_position_first[0] == "TK_INT",
                rep.body_second_position_first[0];
            // body_shape classifies the body op for emit's exhaustive
            // dispatch. The inner is a single-alt Group of two leaves
            // → SingleAlt shape → StorableGroup.
            if let StorableGroup = rep.body_shape {
                assert true;
            } else {
                panic("expected RepeatBodyShape::StorableGroup");
            }
        } else {
            panic("expected Op::Repeat at index 0");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower multi-alt rule with overlapping first sets emits Tournament dispatch" {
    // `r : ID INT | ID STRING ;` — both alts start with ID, so
    // overlap. Both are fully scannable → Tournament dispatch.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("ID")), Element::TokenRef(TokenRefElement::new("INT"))]),
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        if let Tournament(td) = &m.dispatch {
            assert td.alts.len() == 2;
            // Both alts have 2 elements; tie-break is source order.
            assert td.alts[0] == 0 || td.alts[0] == 1;
        } else {
            panic("expected MultiAltDispatch::Tournament");
        }
        if let Tournament(_) = &m.scan_dispatch {
            assert true;
        } else {
            panic("expected scan_dispatch Tournament");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower Tournament sorts longer alt first" {
    // `r : ID INT STRING | ID INT ;` — both start with ID, but the
    // 3-element alt is "more specific" and sorts before the 2-elem
    // alt (longest-match wins).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::TokenRef(TokenRefElement::new("ID")),
                    Element::TokenRef(TokenRefElement::new("INT")),
                    Element::TokenRef(TokenRefElement::new("STRING")),
                ]),
                alt_of([Element::TokenRef(TokenRefElement::new("ID")), Element::TokenRef(TokenRefElement::new("INT"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let MultiAlt(m) = &lowered.parser_rules[0] {
        if let Tournament(td) = &m.dispatch {
            // alt 0 has 3 elements, alt 1 has 2; alt 0 sorts first.
            assert td.alts[0] == 0, `expected alt 0 first, got {td.alts[0]}`;
            assert td.alts[1] == 1;
        } else {
            panic("expected MultiAltDispatch::Tournament");
        }
    } else {
        panic("expected Rule::MultiAlt");
    }
}

test "lower registers follow-aware variant when caller follow overlaps callee tail-greedy" {
    // `r : a 'end' ; a : 'x'* ;`
    // The call to `a` at position 0 has caller-follow = first('end'),
    // which overlaps `a`'s tail-greedy first set (`'x'`)... actually
    // `'x'` is not in `'end'`'s first, so no variant here. Use a
    // case where they DO overlap: `r : a ; a : 'x'* ; ` — empty
    // outer_follow, no variant. Need a real overlap.
    //
    // `r : a STRING ; a : 'x'* ;` — outer_follow at `a` is `{TK_STRING}`.
    // tail_greedy_first(a) = first('x') = {TK_LIT_X}. No overlap.
    //
    // For an actual overlap, the callee's tail-greedy first must
    // include a token in the caller's follow. Construct:
    // `r : a X ; a : X* ;` — outer_follow = {TK_X}, tail-greedy = {TK_X}.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt_of([Element::RuleRef(RuleRefElement::new("a")), Element::TokenRef(TokenRefElement::new("X"))])],
        ),
        ParserRule::new(
            "a",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("X")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    // Variant registered → variant_rules has one entry.
    assert lowered.variant_rules.len() == 1, `expected 1 variant, got {lowered.variant_rules.len()}`;
    // The RuleCall at r's first op carries the variant_id.
    if let Simple(s) = &lowered.parser_rules[0] {
        if let RuleCall(rc) = &s.body.ops[0] {
            if let Some(id) = &rc.variant_id {
                assert *id == 0;
            } else {
                panic("expected variant_id on RuleCall");
            }
        } else {
            panic("expected RuleCall");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower variant_rules empty when no caller follow overlaps callee tail-greedy" {
    // `r : a X ; a : Y ;` — no Repeat → tail_greedy_first(a) = {}.
    // No variant registered.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt_of([Element::RuleRef(RuleRefElement::new("a")), Element::TokenRef(TokenRefElement::new("X"))])],
        ),
        ParserRule::new(
            "a",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("Y"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.variant_rules.is_empty();
}

test "lower variant body suppresses Repeat when first set is fully in follow mask" {
    // `r : a X ; a : X* ;`
    // At the call site `a X`, caller_follow = {TK_X}. `a`'s
    // tail-greedy first = {TK_X}. The variant `a__follow_0`
    // installs mask = {TK_X}; lowering `X*` then sees
    // first(X*) = {TK_X} ⊆ mask → Suppressed.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt_of([Element::RuleRef(RuleRefElement::new("a")), Element::TokenRef(TokenRefElement::new("X"))])],
        ),
        ParserRule::new(
            "a",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("X")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.variant_rules.len() == 1;
    if let Simple(s) = &lowered.variant_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Suppressed = &rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::Suppressed in variant body");
            }
        } else {
            panic("expected Op::Repeat in variant body");
        }
    } else {
        panic("expected Rule::Simple for variant body");
    }
    // The base (non-variant) rule still uses Plain.
    if let Simple(s) = &lowered.parser_rules[1] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Plain = &rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::Plain in base rule");
            }
        } else {
            panic("expected Op::Repeat in base rule");
        }
    } else {
        panic("expected Rule::Simple for base rule 'a'");
    }
}

test "lower variant body uses WithFollowSubtraction when mask partially overlaps inner first" {
    // `t : X | Y ;` — single-token rule whose first set is {X, Y}.
    // `a : t* ;` — the Repeat's inner is `t`, which IS a single-token
    //   element (its callee always consumes exactly one token), so
    //   tail_greedy_first_of_rule(a) = first(t) = {X, Y}.
    // `r : a X ;` — caller follow at `a` is {X}; mask = {X}.
    // Variant body re-lowers `a`'s `t*` with mask = {X}; the inner
    // first = {X, Y}, subtract mask → effective = {Y}.
    // → WithFollowSubtraction(effective_first = [Y]).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt_of([Element::RuleRef(RuleRefElement::new("a")), Element::TokenRef(TokenRefElement::new("X"))])],
        ),
        ParserRule::new(
            "a",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::RuleRef(RuleRefElement::new("t")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
        ParserRule::new(
            "t",
            Visibility::Default,
            [],
            [
                alt_of([Element::TokenRef(TokenRefElement::new("X"))]),
                alt_of([Element::TokenRef(TokenRefElement::new("Y"))]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    assert lowered.variant_rules.len() == 1, `expected 1 variant, got {lowered.variant_rules.len()}`;
    if let Simple(s) = &lowered.variant_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let WithFollowSubtraction(wfs) = &rep.strategy {
                assert wfs.effective_first.len() == 1;
                assert wfs.effective_first[0] == "TK_Y", wfs.effective_first[0];
            } else {
                panic("expected RepeatStrategy::WithFollowSubtraction");
            }
        } else {
            panic("expected Op::Repeat in variant body");
        }
    } else {
        panic("expected Rule::Simple for variant body");
    }
}

test "lower Optional Repeat over multi-token Group uses OptionalLookahead strategy" {
    // `r : ('-' '>')? ;` — single-alt Group with two fixed-token
    // elements. The Optional needs a 2-token lookahead to commit
    // to firing. Emits `OptionalLookahead` carrying the
    // per-position signature.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::Group(GroupElement::new([
                            alt_of([
                                Element::Literal(LiteralElement::new("-")),
                                Element::Literal(LiteralElement::new(">")),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let OptionalLookahead(ol) = &rep.strategy {
                // Per-position signature: [[TK_LIT_MINUS], [TK_LIT_GT]].
                assert ol.sig.len() == 2, `expected 2 positions, got {ol.sig.len()}`;
                assert ol.sig[0][0] == "TK_LIT_MINUS", ol.sig[0][0];
                assert ol.sig[1][0] == "TK_LIT_GT", ol.sig[1][0];
            } else {
                panic("expected RepeatStrategy::OptionalLookahead");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Optional Repeat with single-token inner stays Plain" {
    // `r : INT? ;` — bare leaf Optional. Lower keeps the strategy at
    // `Plain`; emit's Optional+leaf arm in
    // `gen_op_repeat_with_follow_override` emits the single-token
    // guard directly from `inner_first`, so the `OptionalLookahead`
    // specialisation is unnecessary here.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Plain = &rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::Plain for single-token leaf Optional");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Optional Repeat over RuleRef-led Group inner uses OptionalScanGuard" {
    // `r : (a X)? ; a : Y ;` — Optional Repeat whose inner is a
    // single-alt Group starting with a RuleRef (not a fixed token).
    // K-token lookahead can't materialise (no leading literal /
    // TokenRef), and the elements include no nested Optionals so
    // shape lookahead doesn't apply either. The inner is scannable,
    // so `OptionalScanGuard` is the strategy emit picks.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::Group(GroupElement::new([
                            alt_of([
                                Element::RuleRef(RuleRefElement::new("a")),
                                Element::TokenRef(TokenRefElement::new("X")),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
        ParserRule::new(
            "a",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("Y"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let OptionalScanGuard = &rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::OptionalScanGuard");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat over General Group inner uses speculative group_counter id" {
    // `r : (stmt | INT INT)+ ; stmt : ID ;`
    // The General Group inside the Repeat gets group_index = 0
    // (the per-rule counter starts at 0 in alt 0). The Repeat's
    // outer struct field is `group_0_list` (Plus → `_list` suffix
    // on the General-Group base `group_<idx>`).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Plus,
                        element: Element::Group(GroupElement::new([
                            alt_of([Element::RuleRef(RuleRefElement::new("stmt"))]),
                            alt_of([
                                Element::TokenRef(TokenRefElement::new("INT")),
                                Element::TokenRef(TokenRefElement::new("INT")),
                            ]),
                        ])),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
        ParserRule::new(
            "stmt",
            Visibility::Default,
            [],
            [alt_of([Element::TokenRef(TokenRefElement::new("ID"))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            // Outer field uses speculative counter id 0.
            assert rep.field == "group_0_list", rep.field;
            // The inner Op is the General-Group, with the SAME id
            // (the inner lowering consumed the same counter value).
            if let Group(go) = &rep.body {
                if let General(gen) = &go.shape {
                    assert gen.group_index == 0;
                    assert gen.variant_type == "RGroup0";
                } else {
                    panic("expected nested General Group");
                }
            } else {
                panic("expected Op::Group inside Repeat");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Repeat with list-label inner uses label name as outer field" {
    // `r : (names+=ID)* ;` — `+=` inside a `*` Repeat. The Repeat
    // becomes the array; the label name `names` IS the outer
    // struct field (no `_list` suffix).
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::Label(LabelElement::new(
                            "names",
                            true,
                            Element::TokenRef(TokenRefElement::new("ID")),
                        )),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            // The Repeat's outer field is `names`, not `id_list`.
            assert rep.field == "names", rep.field;
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Transparent Group does not contribute a CST field" {
    // `r : (INT) ;` — Transparent group with a single leaf inner.
    // The wrapper has no CST struct slot of its own; `parser_gen`'s
    // `has_field(Group)` returns `is_storable_group(...)` which is
    // false for this 1-alt-1-element shape. lower's enumeration must
    // match that decision so the GIR-driven struct emit produces the
    // same fields parser_gen's runtime construction assigns.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [alt_of([Element::Group(GroupElement::new([alt_of([Element::TokenRef(TokenRefElement::new("INT"))])]))])],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        // [span] — the Transparent group does not surface a field.
        assert s.body.fields.len() == 1, `expected 1 field (span only), got {s.body.fields.len()}`;
        if let Span = &s.body.fields[0].kind {
            assert true;
        } else {
            panic("expected leading Span field");
        }
    } else {
        panic("expected Rule::Simple");
    }
}
