        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower Optional Repeat with TokenRef inner uses Plain strategy" {
    // `r : INT? ;` — Optional Repeat. Without a follow-aware
    // variant context, the Plain strategy is correct: emit fires
    // `if peek_kind ∈ first(inner) { ... }`.
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "r",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Optional,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        if let Repeat(rep) = &s.body.ops[0] {
            if let Optional = rep.kind {
                assert true;
            } else {
                panic("expected RepeatKind::Optional");
            }
            if let Plain = rep.strategy {
                assert true;
            } else {
                panic("expected RepeatStrategy::Plain");
            }
            if let Token(t) = &rep.body {
                assert t.kind == "TK_INT";
            } else {
                panic("expected Token body");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

test "lower greedy Star Repeat with TokenRef inner" {
    // `tokens : INT* ;`
    let mut g = empty_grammar(&"T");
    g.parser_rules = [
        ParserRule::new(
            "tokens",
            Visibility::Default,
            [],
            [
                alt_of([
                    Element::Repeat(RepeatElement {
                        kind: RepeatKind::Star,
                        element: Element::TokenRef(TokenRefElement::new("INT")),
                        non_greedy: false,
                    }),
                ]),
            ],
        ),
    ];

    let lowered = lower(&g, &no_lit_tokens());
    if let Simple(s) = &lowered.parser_rules[0] {
        assert s.body.ops.len() == 1;
        if let Repeat(r) = &s.body.ops[0] {
            // RepeatKind round-trips from surface IR to GIR.
            if let Star = r.kind {
                assert true;
            } else {
                panic("expected Star");
            }
            // Strategy is Plain at Phase 2.x.partial.
            if let Plain = &r.strategy {
                assert true;
            } else {
                panic("expected Plain");
            }
            // Inner Op is the leaf Token, with its own (fresh) field
            // — the binding name inside the loop body, not the
            // surrounding alt's list-typed field.
            if let Token(t) = &r.body {
                assert t.kind == "TK_INT";
                assert t.field == "int";
            } else {
                panic("expected inner Token");
            }
        } else {
            panic("expected Op::Repeat");
        }
    } else {
        panic("expected Rule::Simple");
    }
}

