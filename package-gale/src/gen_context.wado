use { ParserRule, Alternative, Element, RepeatElement, LabelElement, RepeatKind } from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use {
    literal_const_name,
    str_set_from,
    is_single_alt_group,
    is_general_group,
    single_alt_group_type_name,
    count_general_groups,
} from "./gen_util.wado";
use { TreeMap } from "core:collections";

/// A token-kind set interned during parser codegen. Multi-element
/// `<expr> matches { TK_X | TK_Y | ... }` checks are emitted as
/// `_gale_kind_set_<id>(<expr>)`; the body is shared via a single
/// helper function emitted at the end of the parser section.
pub struct KindSetEntry {
    pub id: i32,
    /// Canonical (sorted, unique) token list. Tokens are `TK_*` global
    /// constants in the generated source.
    pub tokens: Array<String>,
}

/// A follow-aware variant of a parser rule, registered when a `RuleRef`
/// call site's caller-local `FOLLOW` set intersects the callee's
/// `tail_greedy_first` (the tokens its tail-position `Optional` / `Star`
/// / `Plus` elements would greedily consume). The variant's body is
/// emitted with that intersection treated as additional follow, which
/// suppresses tail-greedy consumption of tokens the caller is going to
/// claim — implementing one level of LL(*) full-context prediction
/// statically. See `vendor/antlr4/runtime/Java/src/org/antlr/v4/runtime/atn/LL1Analyzer.java`
/// for the dynamic analogue ANTLR4 performs at runtime.
pub struct FollowVariantEntry {
    pub id: i32,
    pub rule_name: String,
    /// Canonical (sorted, unique) intersection `tail_greedy_first(rule)
    /// ∩ caller_follow`. Stored as `TK_*` constant names for stability
    /// across runs and to share variants across call sites that produce
    /// the same intersection.
    pub mask: Array<String>,
    /// Set when at least one scan-side call site uses the variant.
    pub scan_used: bool,
    /// Set when at least one parse-side call site uses the variant.
    pub parse_used: bool,
}

/// Codegen-time context shared across emit walkers. Caches first /
/// nullable / single-token / scannable analyses, the kind-set
/// registry, and the variant-emit walker state.
///
/// Note on retired fields: `prefix_self_ref_min_prec` and
/// `scan_ruleref_min_prec` used to live here as walker mutables;
/// they were retired in Phase 2-F slice 5 once the corresponding
/// values landed directly on the GIR (`RuleCallOp.min_prec_arg`,
/// `ScanRuleCallElem.min_prec_arg`) or were threaded as explicit
/// parameters (`gen_scan_op_element`'s `min_prec_override`).
/// `ruleref_call_follow` was retired in issue #1043 step (5a) — the
/// op-driven walkers consume the per-call-site follow via
/// `RuleCallOp.variant_id` (baked by lower's
/// `compute_call_site_follow`) and the surface `gen_element` RuleRef
/// arm now always emits the regular `parse_X` (no variant).
/// `current_rule_name` was retired in (5b) — the General-group
/// emitters consume `GeneralShape.variant_type` /
/// `alt_struct_names` (baked under the canonical
/// `single_alt_owner`-resolved name in `lower_single_alt_group`),
/// `gen_bt_scan_op_elements` accepts the surrounding rule name as
/// an explicit parameter, and the residual surface walker reader in
/// `element_field_info` is unreachable post Phase 2-G (guarded by a
/// regression panic). `alt_gc_starts` and `group_counter` were
/// retired in (5c) — every general-group emit site reads
/// `GeneralShape.group_index` / `GeneralShape.variant_type` /
/// `GeneralShape.alt_struct_names` directly off the lowered IR; the
/// dead `AltBody.group_index_start` field (no surviving readers
/// after the walker counter retirement) is gone too. `current_follow_mask` and
/// `current_outer_follow` were retired in (5d) — lower threads the
/// surrounding variant's mask as `variant_mask: &Array<String>`
/// through every lowering function and the per-outer-position mask as
/// `outer_position_mask: &Array<String>` alongside it; the latter is
/// baked on `RepeatOp.position_mask`, which emit's
/// `gen_op_repeat_optional_rulecall` unions with its caller-supplied
/// follow (which `inner_walker_follow_for_repeat` clears to `[]` for
/// inner greedy Optionals). `compute_call_site_follow` takes the
/// variant mask as an explicit parameter for the deep-nullable suffix
/// propagation. With these fields gone,
/// `GenContext` no longer carries any walker-mutable state — every
/// caching / registry field is set up at construction and bookkeeping
/// is local to its writer.
pub struct GenContext {
    pub parser_rules: Array<ParserRule>,
    pub lit_tokens: Array<LitToken>,
    rule_index: TreeMap<String, i32>,
    first_cache: TreeMap<String, Array<String>>,
    single_token_cache: TreeMap<String, bool>,
    nullable_cache: TreeMap<String, bool>,
    scannable_cache: TreeMap<String, bool>,
    /// Maps single-alt group type name → the rule name that first defines it.
    /// Used to resolve general group type names inside shared single-alt groups.
    single_alt_owner: TreeMap<String, String>,
    /// Registry of token-kind sets keyed by canonical (sorted, joined
    /// with `|`) representation. IDs are assigned in insertion order so
    /// the same input grammar always produces the same helper names.
    kind_set_registry: TreeMap<String, KindSetEntry>,
    /// Cache of `tail_greedy_first(rule)` keyed by rule name.
    tail_greedy_cache: TreeMap<String, Array<String>>,
    /// Registry of follow-aware rule variants keyed by `rule_name + ':'
    /// + canonical_mask`. IDs are assigned in insertion order. See
    /// `FollowVariantEntry`.
    follow_variant_registry: TreeMap<String, FollowVariantEntry>,
    /// Registry keys in registration (= id) order. `follow_variants()`
    /// returns entries in this order so generated source is stable
    /// across runs. Each key directly indexes
    /// `follow_variant_registry`, giving an O(n) walk.
    follow_variant_order: Array<String>,
}

impl GenContext {
    pub fn new(parser_rules: &Array<ParserRule>, lit_tokens: &Array<LitToken>) -> GenContext {
        let mut rule_index = TreeMap::<String, i32>::new();
        for let mut i = 0; i < parser_rules.len(); i += 1 {
            rule_index[parser_rules[i].name] = i;
        }
        let single_alt_owner = build_single_alt_owner_map(parser_rules);
        return GenContext {
            parser_rules: *parser_rules,
            lit_tokens: *lit_tokens,
            rule_index,
            first_cache: TreeMap::<String, Array<String>>::new(),
            single_token_cache: TreeMap::<String, bool>::new(),
            nullable_cache: TreeMap::<String, bool>::new(),
            scannable_cache: TreeMap::<String, bool>::new(),
            single_alt_owner,
            kind_set_registry: TreeMap::<String, KindSetEntry>::new(),
            tail_greedy_cache: TreeMap::<String, Array<String>>::new(),
            follow_variant_registry: TreeMap::<String, FollowVariantEntry>::new(),
            follow_variant_order: [],
        };
    }

    pub fn find_rule(&self, name: &String) -> Option<&ParserRule> {
        let idx = self.rule_index.get(*name);
        if let Some(i) = idx {
            return Option::Some(&self.parser_rules[i]);
        }
        return null;
    }

    pub fn first_of_rule(&mut self, name: &String, visiting: &mut Array<String>) -> Array<String> {
        let cached = self.first_cache.get(*name);
        if let Some(result) = cached {
            return result;
        }

        let visiting_set = str_set_from(visiting);
        if visiting_set.contains(*name) {
            return [];
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result: Array<String> = [];

        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            for let alt of &rule.alternatives {
                let af = self.first_of_alt(alt, visiting);
                extend_dedup(&mut result, &af);
            }
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.first_cache[*name] = result;
        }

        return result;
    }

    pub fn first_of_element(&mut self, elem: &Element, visiting: &mut Array<String>) -> Array<String> {
        return match elem {
            TokenRef(t) => [`TK_{t.name}`],
            Literal(l) => [literal_const_name(&l.text)],
            RuleRef(r) => self.first_of_rule(&r.name, visiting),
            Group(g) => {
                let mut result: Array<String> = [];
                for let alt of &g.alternatives {
                    let af = self.first_of_alt(alt, visiting);
                    extend_dedup(&mut result, &af);
                }
                result;
            },
            Repeat(rep) => self.first_of_element(&rep.element, visiting),
            Label(lab) => self.first_of_element(&lab.element, visiting),
            // Wildcard and Not match an open-ended set of tokens; we cannot
            // enumerate FIRST statically. Returning [] disables static prediction
            // for alternatives starting with them — such alternatives must either
            // be in a single-alt rule, used as a fallback, or be distinguished
            // from their siblings by later elements.
            Wildcard(_) => [],
            Not(_) => [],
        };
    }

    pub fn first_of_alt(&mut self, alt: &Alternative, visiting: &mut Array<String>) -> Array<String> {
        let mut result: Array<String> = [];

        for let elem of &alt.elements {
            let elem_first = self.first_of_element(elem, visiting);
            extend_dedup(&mut result, &elem_first);
            if !is_nullable(elem) {
                break;
            }
        }
        return result;
    }

    pub fn first_of_elements_from(&mut self, elements: &Array<Element>, start: i32) -> Array<String> {
        let mut result: Array<String> = [];

        for let mut i = start; i < elements.len(); i += 1 {
            let mut visiting: Array<String> = [];
            let elem_first = self.first_of_element(&elements[i], &mut visiting);
            extend_dedup(&mut result, &elem_first);
            if !is_nullable(&elements[i]) {
                break;
            }
        }
        return result;
    }

    /// Returns FIRST sets indexed by INPUT TOKEN position relative to the alt start.
    ///
    /// Invariant: `result[d]` is the set of possible first tokens at input offset `d`
    /// **assuming the alt matches successfully up to that point**. Guards built from
    /// this mapping are sound disambiguators for caller-side lookahead.
    ///
    /// To maintain the element-pos-to-input-pos alignment, we only advance past an
    /// element if it is guaranteed to consume exactly 1 input token (non-nullable,
    /// single-token). Nullable or multi-token elements halt accumulation — the
    /// caller gets a shorter (but always sound) sequence.
    pub fn alt_position_first_sets(&mut self, alt: &Alternative, max_depth: i32) -> Array<Array<String>> {
        let mut result: Array<Array<String>> = [];
        let mut start = 0;
        while result.len() < max_depth && start < alt.elements.len() {
            // If the tail from `start` onwards is entirely nullable, the alt
            // can match 0 tokens from this offset — input[result.len()] is in
            // the follow-set, which `first` doesn't include. Guard would be
            // unsound. Halt.
            if self.tail_is_nullable_deep(&alt.elements, start) {
                break;
            }
            // Deep first-set: accumulate across deeply-nullable elements so the
            // set covers every token that can legitimately appear at this offset
            // when the alt matches.
            let first = self.deep_first_of_elements_from(&alt.elements, start);
            if first.len() == 0 {
                break;
            }
            result.push(first);

            // Advance past element[start] only if it consumes exactly 1 token;
            // otherwise result[d+1] would not align with input offset d+1.
            let mut visiting: Array<String> = [];
            if !self.element_is_single_token(&alt.elements[start], &mut visiting) {
                break;
            }
            start += 1;
        }
        return result;
    }

    /// Like `first_of_elements_from` but uses deep nullability so it correctly
    /// flows through `RuleRef`s whose underlying rule matches zero tokens.
    pub fn deep_first_of_elements_from(&mut self, elements: &Array<Element>, start: i32) -> Array<String> {
        let mut result: Array<String> = [];
        for let mut i = start; i < elements.len(); i += 1 {
            let mut fv: Array<String> = [];
            let elem_first = self.first_of_element(&elements[i], &mut fv);
            extend_dedup(&mut result, &elem_first);
            let mut nv: Array<String> = [];
            if !self.element_is_nullable_deep(&elements[i], &mut nv) {
                break;
            }
        }
        return result;
    }

    /// Deep nullability: true if every element from `start` onwards can match
    /// zero input tokens, recursively checking referenced rules (unlike the
    /// shallow `is_nullable` which only inspects top-level Repeat kind).
    ///
    /// Used both as "is the suffix from `start` nullable?" (by alt
    /// walkers gating follow propagation) and as "is the rule body
    /// nullable?" (by tail-greedy analysis).
    pub fn tail_is_nullable_deep(&mut self, elements: &Array<Element>, start: i32) -> bool {
        for let mut i = start; i < elements.len(); i += 1 {
            let mut visiting: Array<String> = [];
            if !self.element_is_nullable_deep(&elements[i], &mut visiting) {
                return false;
            }
        }
        return true;
    }

    pub fn element_is_nullable_deep(&mut self, elem: &Element, visiting: &mut Array<String>) -> bool {
        return match elem {
            TokenRef(_) => false,
            Literal(_) => false,
            Wildcard(_) => false,
            Not(_) => false,
            RuleRef(r) => self.rule_is_nullable(&r.name, visiting),
            Label(lab) => self.element_is_nullable_deep(&lab.element, visiting),
            Repeat(rep) => match rep.kind {
                Star | Optional => true,
                _ => self.element_is_nullable_deep(&rep.element, visiting),
            },
            Group(g) => {
                let mut any_nullable = false;
                for let alt of &g.alternatives {
                    let mut all_null = true;
                    for let e of &alt.elements {
                        if !self.element_is_nullable_deep(e, visiting) {
                            all_null = false;
                            break;
                        }
                    }
                    if all_null {
                        any_nullable = true;
                        break;
                    }
                }
                any_nullable;
            },
        };
    }

    pub fn rule_is_nullable(&mut self, name: &String, visiting: &mut Array<String>) -> bool {
        let cached = self.nullable_cache.get(*name);
        if let Some(val) = cached {
            return val;
        }

        let visiting_set = str_set_from(visiting);
        if visiting_set.contains(*name) {
            return false;
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result = false;
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            for let alt of &rule.alternatives {
                let mut all_null = true;
                for let e of &alt.elements {
                    if !self.element_is_nullable_deep(e, visiting) {
                        all_null = false;
                        break;
                    }
                }
                if all_null {
                    result = true;
                    break;
                }
            }
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.nullable_cache[*name] = result;
        }

        return result;
    }

    /// True if the element always consumes exactly 1 input token on match.
    /// Used to keep `alt_position_first_sets` element-to-input-position aligned.
    pub fn element_is_single_token(&mut self, elem: &Element, visiting: &mut Array<String>) -> bool {
        return match elem {
            TokenRef(_) => true,
            Literal(_) => true,
            Wildcard(_) => true,
            Not(_) => true,
            RuleRef(r) => self.rule_is_single_token(&r.name, visiting),
            Label(lab) => self.element_is_single_token(&lab.element, visiting),
            Group(_) => false,
            Repeat(_) => false,
        };
    }

    /// True if this element's `first` set is an *exact* predictor: i.e.
    /// "the first-set token is present at the input position" implies
    /// "this element will successfully consume that token (and only
    /// that token) when it matches". The criterion underlying LL repair
    /// for nullable suffixes (Phase 5 step 3): a deep-nullable suffix
    /// can contribute its first set to a `RuleRef`'s caller-follow only
    /// when every walked element is first-exact. Otherwise the
    /// suffix's first might be a multi-element alt's leading token
    /// whose suppression at the preceding `RuleRef` would leave the
    /// runtime stranded — this is the css3 selector / HTMLParser
    /// htmlContent hazard documented in `package-gale/CLAUDE.md`.
    ///
    /// Single-token elements are trivially first-exact. A `Repeat`
    /// inherits first-exactness from its inner: `b?` where `b : Y` has
    /// a single-token inner so its first is exactly `{Y}`. A `Group`
    /// is first-exact only when every alt is a single first-exact
    /// element — anything more complex risks the multi-element alt
    /// hazard.
    pub fn element_is_first_exact(&mut self, elem: &Element) -> bool {
        return match elem {
            TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => true,
            RuleRef(r) => {
                let mut visiting: Array<String> = [];
                self.rule_is_single_token(&r.name, &mut visiting);
            },
            Label(lab) => self.element_is_first_exact(&lab.element),
            Repeat(rep) => self.element_is_first_exact(&rep.element),
            Group(g) => {
                let mut all_exact = true;
                for let alt of &g.alternatives {
                    if alt.elements.len() != 1 {
                        all_exact = false;
                        break;
                    }
                    if !self.element_is_first_exact(&alt.elements[0]) {
                        all_exact = false;
                        break;
                    }
                }
                all_exact;
            },
        };
    }

    /// True if every element of `elements[start..]` is first-exact —
    /// the precondition for unioning the suffix's first set into a
    /// preceding `RuleRef`'s caller-follow when the suffix is
    /// deep-nullable. See `element_is_first_exact` for the semantic
    /// argument.
    pub fn deep_suffix_is_first_exact(&mut self, elements: &Array<Element>, start: i32) -> bool {
        for let mut i = start; i < elements.len(); i += 1 {
            if !self.element_is_first_exact(&elements[i]) {
                return false;
            }
        }
        return true;
    }

    /// Per-call-site caller-FOLLOW for the element at index `i` in
    /// `elements`. Single source of truth for the `lower` pre-pass
    /// (variant interning at `lower_scan_element` / `lower_op` RuleRef
    /// sites).
    ///
    /// Three cases:
    ///
    /// - Suffix is non-nullable: the immediate suffix's `first` set is
    ///   the only thing that can follow. Drop the outer follow.
    /// - Suffix is deep-nullable AND first-exact (every walked element's
    ///   first uniquely predicts that element matching, see
    ///   `element_is_first_exact`): the outer follow propagates through.
    ///   Union the suffix's first with `outer_follow`. This closes
    ///   `ll_nullable_suffix`'s gap.
    /// - Suffix is deep-nullable but NOT first-exact: drop the suffix's
    ///   first and propagate only `outer_follow`. This is the
    ///   "first-exact deep-nullable suffix" soundness invariant — see
    ///   `CLAUDE.md` "Failed Approaches" #3 for the rationale.
    ///
    /// `outer_follow` is the surrounding variant's mask (`[]` for
    /// regular non-variant bodies). Threaded from `lower`'s call chain
    /// rather than read from walker state.
    pub fn compute_call_site_follow(&mut self, elements: &Array<Element>, i: i32, outer_follow: &Array<String>) -> Array<String> {
        let first = self.first_of_elements_from(elements, i + 1);
        if !self.tail_is_nullable_deep(elements, i + 1) {
            return first;
        }
        if self.deep_suffix_is_first_exact(elements, i + 1) {
            return union_kind_arrays(&first, outer_follow);
        }
        return *outer_follow;
    }

    pub fn rule_is_single_token(&mut self, name: &String, visiting: &mut Array<String>) -> bool {
        let cached = self.single_token_cache.get(*name);
        if let Some(val) = cached {
            return val;
        }

        let visiting_set = str_set_from(visiting);
        if visiting_set.contains(*name) {
            return false;
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result = false;
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            let mut all_alts_ok = true;
            for let alt of &rule.alternatives {
                let mut non_nullable_count = 0;
                let mut single_ok = false;
                let mut has_nullable = false;
                for let elem of &alt.elements {
                    if is_nullable(elem) {
                        // A nullable element (Star/Optional Repeat) can consume
                        // additional tokens when its inner matches. e.g.
                        // `'-'? Integer` is 1 token without `-` but 2 with `-`.
                        // Treat any nullable element as disqualifying so the
                        // rule isn't misclassified as strictly single-token.
                        has_nullable = true;
                        break;
                    }
                    non_nullable_count += 1;
                    if non_nullable_count > 1 {
                        break;
                    }
                    if let TokenRef(_) | Literal(_) = elem {
                        single_ok = true;
                    } else if let RuleRef(r) = elem {
                        single_ok = self.rule_is_single_token(&r.name, visiting);
                    }
                }
                if has_nullable || non_nullable_count != 1 || !single_ok {
                    all_alts_ok = false;
                    break;
                }
            }
            result = all_alts_ok;
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.single_token_cache[*name] = result;
        }

        return result;
    }

    /// Returns true if the rule is safe to scan as a predicate prefix.
    ///
    /// Left-recursive (LR) rules have faithful `scan_X_atom` / `scan_X_prec` /
    /// `scan_X_lr_N` generated for them so nested scans can recurse through
    /// them correctly. The cost concern that previously forced a top-level
    /// LR gate here — exhaustive longest-match tournaments running every
    /// candidate's full LR scan even when an earlier alt already matched —
    /// is addressed at the dispatch sites: `emit_scan_partition_body`,
    /// `gen_group_scan_dispatch`, `gen_general_group_scan_dispatch`, and
    /// `gen_rule_ref_group_scan_dispatch` use first-success-wins on
    /// `sort_group_by_element_count` order, mirroring parse-side `bt_try`.
    /// Sorting longest-first ensures the most specific candidate is tried
    /// first, so commit-on-success is correctness-equivalent to longest-
    /// match here. See `AGENTS.md` "Failed Approaches: Removing the LR
    /// Gate ... 2026-04" for the historical context that ruled out a naive
    /// gate removal.
    pub fn is_rule_scannable(&mut self, name: &String, visiting: &mut Array<String>) -> bool {
        let cached = self.scannable_cache.get(*name);
        if let Some(val) = cached {
            return val;
        }

        let visiting_set = str_set_from(visiting);
        if visiting_set.contains(*name) {
            return true;
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result = false;
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            let mut all_ok = true;
            for let alt of &rule.alternatives {
                if !self.is_alt_scannable(&alt.elements, visiting) {
                    all_ok = false;
                    break;
                }
            }
            result = all_ok;
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.scannable_cache[*name] = result;
        }

        return result;
    }

    /// Returns true if every element in the sequence is scannable.
    pub fn is_alt_scannable(&mut self, elements: &Array<Element>, visiting: &mut Array<String>) -> bool {
        for let elem of elements {
            if !self.is_element_scannable(elem, visiting) {
                return false;
            }
        }
        return true;
    }

    /// Returns true if a single element is scannable.
    pub fn is_element_scannable(&mut self, elem: &Element, visiting: &mut Array<String>) -> bool {
        return match elem {
            TokenRef(_) | Literal(_) => true,
            RuleRef(r) => self.is_rule_scannable(&r.name, visiting),
            Label(lab) => self.is_element_scannable(&lab.element, visiting),
            Repeat(rep) => self.is_element_scannable(&rep.element, visiting),
            Group(g) => {
                for let alt of &g.alternatives {
                    if !self.is_alt_scannable(&alt.elements, visiting) {
                        return false;
                    }
                }
                return true;
            },
            // Wildcard advances by exactly one token (unless at EOF).
            Wildcard(_) => true,
            // `~ X` advances by one token when the current token is not in
            // the complement set. The inner element is required to be a
            // terminal or a simple terminal set, both of which are scannable.
            Not(_) => true,
        };
    }

    /// Get the rule name that owns the general group types inside a given
    /// single-alt group. Returns `fallback` if the type name is not a
    /// shared single-alt group (in practice every reached single-alt
    /// group is in the map; callers pass the surrounding rule's name as
    /// a defensive fallback).
    pub fn general_group_rule_name(&self, single_alt_type_name: &String, fallback: &String) -> String {
        if let Some(owner) = self.single_alt_owner.get(*single_alt_type_name) {
            return owner;
        }
        return *fallback;
    }

    /// Intern a token-kind set. The same set (regardless of input order
    /// or duplicates) maps to a single `id`. Helper IDs are assigned in
    /// first-seen order across the codegen pass.
    pub fn intern_kind_set(&mut self, tokens: &Array<String>) -> i32 {
        let canonical = canonical_kind_set(tokens);
        let key = join_pipe(&canonical);
        if let Some(entry) = self.kind_set_registry.get(key) {
            return entry.id;
        }
        let id = self.kind_set_registry.len();
        self.kind_set_registry[key] = KindSetEntry { id, tokens: canonical };
        return id;
    }

    /// All interned kind sets in helper-ID order (i.e. insertion order).
    /// Consumed by `gen_kind_set_helpers` to emit the helper functions.
    pub fn kind_sets(&self) -> Array<KindSetEntry> {
        return self.kind_set_registry.values();
    }

    /// Render a token-set membership check on `expr`.
    ///
    ///   - 0 tokens → `"true"` (the empty set never excludes anything in
    ///     practice; callers that build up first-sets use this).
    ///   - 1 token  → `<expr> == TK_X` (no `matches` overhead).
    ///   - ≥2 tokens → `_gale_kind_set_<id>(<expr>)` after interning.
    ///
    /// Multi-element sets always go through the helper indirection so
    /// duplicate sets across the grammar share a single function body
    /// in the generated wasm.
    pub fn kind_check_str(&mut self, tokens: &Array<String>, expr: &String) -> String {
        if tokens.is_empty() {
            return "true";
        }
        if tokens.len() == 1 {
            return `{*expr} == {tokens[0]}`;
        }
        let id = self.intern_kind_set(tokens);
        return `_gale_kind_set_{id}({*expr})`;
    }

    /// Sugar for `kind_check_str` against `p.peek_kind()`.
    pub fn first_check_str(&mut self, first_set: &Array<String>) -> String {
        return self.kind_check_str(first_set, &"p.peek_kind()");
    }

    /// Returns the set of token kinds that the rule's body may greedily
    /// consume at tail position, i.e. tokens that would be claimed by an
    /// `Optional` / `Star` / `Plus` element which has no required element
    /// after it in the alt.
    ///
    /// Used to filter follow-aware variant generation: if a `RuleRef`
    /// call site's caller-local `FOLLOW` does not intersect this set,
    /// the callee's tail-greedy elements cannot collide with the
    /// caller's expectations and no variant is needed.
    pub fn tail_greedy_first_of_rule(&mut self, name: &String, visiting: &mut Array<String>) -> Array<String> {
        let cached = self.tail_greedy_cache.get(*name);
        if let Some(result) = cached {
            return result;
        }

        let visiting_set = str_set_from(visiting);
        if visiting_set.contains(*name) {
            return [];
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result: Array<String> = [];
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            for let alt of &rule.alternatives {
                let af = self.tail_greedy_first_of_elements(&alt.elements, visiting);
                extend_dedup(&mut result, &af);
            }
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.tail_greedy_cache[*name] = result;
        }

        return result;
    }

    /// Walk an alt element list from the tail, collecting tail-greedy
    /// first sets. Stops at the first non-deeply-nullable element. A
    /// `Repeat (Optional|Star|Plus)` contributes `first_of_element(inner)`.
    /// A nested `Group` recurses per alt. A `RuleRef` to a rule with a
    /// non-empty `tail_greedy_first` contributes that set transitively.
    fn tail_greedy_first_of_elements(&mut self, elements: &Array<Element>, visiting: &mut Array<String>) -> Array<String> {
        let mut result: Array<String> = [];
        let mut i = elements.len() - 1;
        while i >= 0 {
            let elem = &elements[i];
            let tg = self.tail_greedy_first_of_element(elem, visiting);
            extend_dedup(&mut result, &tg);
            let mut nv: Array<String> = [];
            if !self.element_is_nullable_deep(elem, &mut nv) {
                break;
            }
            i -= 1;
        }
        return result;
    }

    fn tail_greedy_first_of_element(&mut self, elem: &Element, visiting: &mut Array<String>) -> Array<String> {
        return match elem {
            Repeat(rep) => {
                // Only count Repeats whose inner consumes EXACTLY one
                // token per iteration. Multi-token bodies like
                // `(htmlElement | CDATA | htmlComment) htmlChardata?`
                // in HTMLParser's `htmlContent` rule cannot be safely
                // suppressed by a follow mask: the outer caller's
                // follow set legitimately overlaps with the inner's
                // first set (e.g. TAG_OPEN starts a nested htmlElement
                // AS WELL AS the closing `</div>` tag), and the
                // runtime lookahead-2 distinguishes them in a way
                // static analysis cannot. Restricting to single-token
                // inners keeps the LL repair (`Y?` in `a : X Y?`)
                // working without breaking those grammars.
                let mut stv: Array<String> = [];
                let single = self.element_is_single_token(&rep.element, &mut stv);
                let result: Array<String> = if !single {
                    [];
                } else {
                    let mut fv: Array<String> = [];
                    self.first_of_element(&rep.element, &mut fv);
                };
                result;
            },
            Group(g) => {
                let mut acc: Array<String> = [];
                for let alt of &g.alternatives {
                    let inner = self.tail_greedy_first_of_elements(&alt.elements, visiting);
                    extend_dedup(&mut acc, &inner);
                }
                acc;
            },
            Label(lab) => self.tail_greedy_first_of_element(&lab.element, visiting),
            RuleRef(r) => self.tail_greedy_first_of_rule(&r.name, visiting),
            // Token / Literal / Wildcard / Not consume exactly one token
            // and never leak — they are the "stop" condition.
            TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => [],
        };
    }

    /// Intern a follow-aware variant for `rule_name` given a caller-side
    /// `caller_follow` set. The mask stored in the registry is the
    /// intersection with the rule's `tail_greedy_first`, so call sites
    /// whose follows differ outside that intersection share a single
    /// variant. Returns `None` when the intersection is empty (no
    /// variant required — caller should emit the regular `scan_X` /
    /// `parse_X` call). The `is_scan` flag records which side's call
    /// site triggered the registration; the variant emit pass uses the
    /// flags to decide whether to emit a scan-side body, parse-side
    /// body, or both.
    pub fn intern_follow_variant(&mut self, rule_name: &String, caller_follow: &Array<String>, is_scan: bool) -> Option<i32> {
        // Phase 5 step 6: every rule shape — single-alt, multi-alt, and
        // left-recursive — now routes variant emit through the unified
        // `gen_parse_fn_named` / `gen_scan_function_named` path. The
        // only remaining gate is the unknown-rule guard (which keeps
        // the registry from referencing rules the emit pass cannot
        // produce).
        let rule_opt = self.find_rule(rule_name);
        if rule_opt matches { None } {
            return null;
        }
        let mut visiting: Array<String> = [];
        let tg = self.tail_greedy_first_of_rule(rule_name, &mut visiting);
        if tg.is_empty() || caller_follow.is_empty() {
            return null;
        }
        let mut intersection: Array<String> = [];
        let follow_set = str_set_from(caller_follow);
        for let tk of &tg {
            if follow_set.contains(*tk) {
                intersection.push(*tk);
            }
        }
        if intersection.is_empty() {
            return null;
        }
        let canonical = canonical_kind_set(&intersection);
        let key = `{*rule_name}:{join_pipe(&canonical)}`;
        let existing_id: Option<i32> = if let Some(entry) = self.follow_variant_registry.get(key) {
            Option::<i32>::Some(entry.id);
        } else {
            null;
        };
        if let Some(id) = existing_id {
            let mut entry = self.follow_variant_registry[key];
            if is_scan {
                entry.scan_used = true;
            } else {
                entry.parse_used = true;
            }
            self.follow_variant_registry[key] = entry;
            return Option::<i32>::Some(id);
        }
        let id = self.follow_variant_order.len();
        let entry = FollowVariantEntry {
            id,
            rule_name: *rule_name,
            mask: canonical,
            scan_used: is_scan,
            parse_used: !is_scan,
        };
        self.follow_variant_registry[key] = entry;
        self.follow_variant_order.push(key);
        return Option::<i32>::Some(id);
    }

    /// All registered follow variants in registration (= id) order.
    /// Consumed by `emit_follow_variant` via the fixed-point loop in
    /// `gen_parser`. O(n) — each `follow_variant_order`
    /// entry is the registry key, so we look up directly.
    pub fn follow_variants(&self) -> Array<FollowVariantEntry> {
        let mut out: Array<FollowVariantEntry> = [];
        for let key of &self.follow_variant_order {
            if let Some(entry) = self.follow_variant_registry.get(*key) {
                out.push(entry);
            }
        }
        return out;
    }

    /// Render the negation of a token-set membership check —
    /// `!_gale_kind_set_<id>(<expr>)` for ≥2 tokens, else
    /// `<expr> != TK_X`. Used by non-greedy emit sites.
    pub fn kind_negate_check_str(&mut self, tokens: &Array<String>, expr: &String) -> String {
        if tokens.is_empty() {
            return "false";
        }
        if tokens.len() == 1 {
            return `{*expr} != {tokens[0]}`;
        }
        let id = self.intern_kind_set(tokens);
        return `!_gale_kind_set_{id}({*expr})`;
    }
}

/// Mirror of `is_left_recursive` from `parser_gen.wado` for use inside
/// `GenContext` where the codegen-side helper isn't visible. An alt is
/// left-recursive when its first non-trivial element is a self-reference
/// to the rule. ANTLR4 only rewrites direct left recursion (see
/// `vendor/antlr4/doc/left-recursion.md`), so a shallow first-element
/// check is sufficient.
fn rule_alt_is_left_recursive(alt: &Alternative, rule_name: &String) -> bool {
    if alt.elements.is_empty() {
        return false;
    }
    return rule_alt_element_is_self_ref(&alt.elements[0], rule_name);
}

fn rule_alt_element_is_self_ref(elem: &Element, rule_name: &String) -> bool {
    return match elem {
        RuleRef(r) => r.name == *rule_name,
        Label(lab) => rule_alt_element_is_self_ref(&lab.element, rule_name),
        _ => false,
    };
}

/// Sort tokens lexicographically and remove duplicates, producing the
/// canonical representative of the set. Two `matches { ... }` checks
/// over equal sets (regardless of order or repeated elements) collapse
/// to the same canonical form and therefore the same helper id.
fn canonical_kind_set(tokens: &Array<String>) -> Array<String> {
    let mut sorted = *tokens;
    sorted.sort();
    let mut out: Array<String> = [];
    for let mut i = 0; i < sorted.len(); i += 1 {
        if i == 0 || sorted[i] != sorted[i - 1] {
            out.push(sorted[i]);
        }
    }
    return out;
}

/// Join an already-canonicalised token list with `|`. The resulting
/// string is the registry key. `|` cannot appear in `TK_*` identifiers
/// so this is unambiguous.
fn join_pipe(tokens: &Array<String>) -> String {
    let mut s = String::with_capacity(64);
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            s.push('|');
        }
        s.push_str(tokens[i]);
    }
    return s;
}

/// Build a map from single-alt group type name to the first rule that contains it.
/// This ensures parser gen uses the same type names as the type gen for shared groups.
fn build_single_alt_owner_map(parser_rules: &Array<ParserRule>) -> TreeMap<String, String> {
    let mut map = TreeMap::<String, String>::new();
    for let rule of parser_rules {
        for let alt of &rule.alternatives {
            scan_elements_for_single_alt_groups(&alt.elements, &rule.name, &mut map);
        }
    }
    return map;
}

fn scan_elements_for_single_alt_groups(elements: &Array<Element>, rule_name: &String, map: &mut TreeMap<String, String>) {
    for let elem of elements {
        scan_element_for_single_alt_groups(elem, rule_name, map);
    }
}

fn scan_element_for_single_alt_groups(elem: &Element, rule_name: &String, map: &mut TreeMap<String, String>) {
    let alts = extract_group_alts_for_scan(elem);
    if let Some(group_alts) = alts {
        if is_single_alt_group(group_alts) {
            let type_name = single_alt_group_type_name(&group_alts[0]);
            if !map.contains_key(type_name) {
                map[type_name] = *rule_name;
            }
            // Recurse into the single-alt group's elements
            scan_elements_for_single_alt_groups(&group_alts[0].elements, rule_name, map);
        } else {
            // Recurse into multi-alt group alts
            for let alt of group_alts {
                scan_elements_for_single_alt_groups(&alt.elements, rule_name, map);
            }
        }
        return;
    }
    if let Repeat(rep) = elem {
        scan_element_for_single_alt_groups(&rep.element, rule_name, map);
        return;
    }
    if let Label(lab) = elem {
        scan_element_for_single_alt_groups(&lab.element, rule_name, map);
    }
}

fn extract_group_alts_for_scan(elem: &Element) -> Option<&Array<Alternative>> {
    if let Group(g) = elem {
        return Option::Some(&g.alternatives);
    }
    if let Repeat(rep) = elem {
        if let Group(g) = &rep.element {
            return Option::Some(&g.alternatives);
        }
    }
    return null;
}

pub fn is_nullable(elem: &Element) -> bool {
    if let Repeat(rep) = elem {
        if let Star | Optional = rep.kind {
            return true;
        }
    }
    return false;
}

pub fn sets_overlap(a: &Array<String>, b: &Array<String>) -> bool {
    let b_set = str_set_from(b);
    for let x of a {
        if b_set.contains(*x) {
            return true;
        }
    }
    return false;
}

pub fn is_simple_token_group(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        let elem = &alt.elements[0];
        if let TokenRef(_) | Literal(_) = elem {
            continue;
        }
        return false;
    }
    return true;
}

fn extend_dedup(target: &mut Array<String>, source: &Array<String>) {
    for let item of source {
        if !arr_contains(target, item) {
            target.push(*item);
        }
    }
}

/// Append-and-dedup union of two token-kind arrays, preserving the
/// order of `a` then appending new entries from `b`. Shared helper
/// for `compute_call_site_follow`; `union_sets` / `union_arrays` in
/// parser_gen and lower compute the same thing — keep this as the
/// canonical implementation.
pub fn union_kind_arrays(a: &Array<String>, b: &Array<String>) -> Array<String> {
    let mut result: Array<String> = [];
    for let tk of a {
        result.push(*tk);
    }
    for let tk of b {
        if !arr_contains(&result, tk) {
            result.push(*tk);
        }
    }
    return result;
}

fn arr_contains(arr: &Array<String>, value: &String) -> bool {
    for let item of arr {
        if *item == *value {
            return true;
        }
    }
    return false;
}

fn remove_from_visiting(visiting: &mut Array<String>, name: &String) {
    let mut new_arr: Array<String> = [];
    for let v of visiting {
        if *v != *name {
            new_arr.push(*v);
        }
    }
    *visiting = new_arr;
}
