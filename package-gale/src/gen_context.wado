use { ParserRule, Alternative, Element, RepeatElement, LabelElement, RepeatKind } from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use {
    literal_const_name,
    is_single_alt_group,
    is_general_group,
    single_alt_group_type_name,
    count_general_groups,
} from "./gen_util.wado";
use { Diagnostic, DiagnosticKind } from "./gir.wado";
use { TreeMap } from "core:collections";

/// A token-kind set interned during parser codegen. Multi-element
/// `<expr> matches { TK_X | TK_Y | ... }` checks are emitted as
/// `_gale_kind_set_<id>(<expr>)`; the body is shared via a single
/// helper function emitted at the end of the parser section.
pub struct KindSetEntry {
    pub id: i32,
    /// Canonical (sorted, unique) token list. Tokens are `TK_*` global
    /// constants in the generated source.
    pub tokens: List<String>,
}

/// A runtime FOLLOW-continuation mask interned during parser codegen.
/// Each distinct K-prefix mask is emitted once as a
/// `global FOLLOW_MASK_<id>: List<List<i32>> = [[TK_X], [TK_Y], …]` and
/// passed by reference to `follow_yields` at repair call sites — the
/// runtime-threaded replacement for the per-(rule, mask) cloned
/// `__follow_<id>` variant bodies. Interning the MASK (not rule×mask)
/// keeps the generated-parser growth proportional to the number of
/// distinct continuations, not the call graph.
pub struct FollowMaskEntry {
    pub id: i32,
    /// Canonical per-depth token sets. `mask[d]` lists the `TK_*`
    /// constants valid at depth `d` of the caller's continuation.
    pub mask: List<List<String>>,
}

/// Maximum K-prefix depth carried into `intern_follow_mask` for the
/// multi-token follow-mask path. Bounds the runtime peek; deeper
/// continuations are truncated (the deepest tokens are the cheapest to
/// disambiguate at runtime via the existing 1-token dispatch, so
/// truncation hurts precision rather than correctness).
pub global FOLLOW_MASK_MAX_K: i32 = 4;

/// Codegen-time context shared across emit walkers. Holds the
/// first / nullable / single-token / scannable caches, the
/// `single_alt_owner` and `kind_set` registries, and the
/// follow-mask registry. No walker-mutable state — every
/// per-walk value (caller follow, current rule name, etc.) is
/// threaded as an explicit parameter through the lowering and
/// emission call chains.
pub struct GenContext {
    pub parser_rules: List<ParserRule>,
    pub lit_tokens: List<LitToken>,
    rule_index: TreeMap<String, i32>,
    first_cache: TreeMap<String, List<String>>,
    single_token_cache: TreeMap<String, bool>,
    nullable_cache: TreeMap<String, bool>,
    scannable_cache: TreeMap<String, bool>,
    /// Maps single-alt group type name → the rule name that first defines it.
    /// Used to resolve general group type names inside shared single-alt groups.
    single_alt_owner: TreeMap<String, String>,
    /// Registry of token-kind sets keyed by canonical (sorted, joined
    /// with `|`) representation. IDs are assigned in insertion order so
    /// the same input grammar always produces the same helper names.
    kind_set_registry: TreeMap<String, KindSetEntry>,
    /// Registry of runtime FOLLOW-continuation masks keyed by canonical
    /// per-depth representation. IDs are assigned in insertion order so
    /// `FOLLOW_MASK_<id>` global names are stable across runs. See
    /// `FollowMaskEntry`.
    follow_mask_registry: TreeMap<String, FollowMaskEntry>,
    /// Cache of `tail_greedy_first(rule)` keyed by rule name.
    tail_greedy_cache: TreeMap<String, List<String>>,
    /// Prediction-strategy diagnostics raised during lowering, in the
    /// order lowering walked the rules. Drained into
    /// `LoweredGrammar.diagnostics` by `lower_with_ctx`. See
    /// `Diagnostic` in `gir.wado`.
    diagnostics: List<Diagnostic>,
    /// Set by lowering whenever it constructs a tail-greedy `Repeat`
    /// that gates on the caller's FOLLOW continuation. When it stays
    /// false the grammar has no caller-FOLLOW repair at all, so emit
    /// skips the entire FOLLOW machinery (the `follow` parameter, its
    /// call-site arguments, and the `FOLLOW_MASK_<id>` globals). This
    /// keeps deep-recursion grammars — which never read `follow` — from
    /// paying an extra stack slot per recursive frame (the
    /// `Performance/ExpressionGrammar_2` stack-exhaustion regression).
    caller_follow_gate_seen: bool,
    /// Set by lowering when it lowers a non-greedy optional (`??`). When
    /// set, emit includes the runtime ATN simulator infrastructure (the
    /// serialized `GALE_ATN_DATA` blob, the `Parser.atn`/`Parser.atn_stack`
    /// fields, and the rule-entry stack push/pop) and routes the `??`
    /// enter/skip decision through `atn_ng_optional_enter`. Grammars without
    /// a non-greedy `??` stay byte-identical. (`*?`/`+?` keep the dedicated
    /// non-greedy strategy and do not set this.)
    needs_atn_seen: bool,
    /// Set by lowering for an ATN-class LR rule. Gates the scan-side ATN
    /// globals (`GALE_ATN_SIM` / `GALE_SCAN_STACK`) so non-greedy-`??`-only
    /// grammars (which need the ATN simulator but no scan-side LR routing)
    /// do not carry a redundant decoded ATN / dead scan stack.
    needs_scan_atn_seen: bool,
    /// The ATN call-site → return-state correspondence (`Atn.call_site_returns`,
    /// indexed by `RuleRefElement.atn_call_site`). Populated after lowering
    /// by `set_atn_call_site_returns` when `needs_atn`, so parser emit can
    /// push each rule call's exact return state (`atn_ret_pending`). Empty
    /// for grammars that do not need the ATN. See P4.2b in `TODO.md`.
    atn_call_site_returns: List<i32>,
    /// Index of the parser rule currently being emitted (set by
    /// `gen_parse_fn`). Read when emitting a non-greedy `??`'s
    /// `atn_ng_optional_enter` call so the simulator knows which rule's
    /// exit-first decision to predict (the caller stack now holds return
    /// states, not rule indices). -1 outside rule-body emission.
    current_rule_index: i32,
    /// Per-rule ATN loop-entry (`STAR_LOOP_ENTRY`) decision number, indexed
    /// by rule, or -1 for a rule with no LR loop. Populated after `build_atn`
    /// (only when `needs_atn`); read by the LR dispatch emitter to route an
    /// ATN-class rule's loop-entry through `atn_predict_with_stack`.
    lr_loop_entry_decisions: List<i32>,
    /// Snake name of the ATN-class LR rule whose `scan_*` body is currently
    /// being emitted, or empty otherwise. Set by `gen_scan_lr_functions` so
    /// `gen_scan_op_element` recognises a self-ref operand scan and brackets it
    /// with `GALE_SCAN_STACK` push/pop (the scan caller stack the LR loop
    /// decision reads). Empty for every non-ATN-class scan, so they are
    /// byte-identical.
    scan_atn_rule_snake: String,
    /// When set, parser emit adds trace logging (rule enter/ok/fail plus
    /// multi-alt scan/pick/try decisions) — the `trace: true` generator
    /// option. Off by default.
    trace: bool,
}

impl GenContext {
    pub fn new(parser_rules: &List<ParserRule>, lit_tokens: &List<LitToken>) -> GenContext {
        let mut rule_index = TreeMap::<String, i32>::new();
        for let mut i = 0; i < parser_rules.len(); i += 1 {
            rule_index[parser_rules[i].name] = i;
        }
        let single_alt_owner = build_single_alt_owner_map(parser_rules);
        return GenContext {
            parser_rules: *parser_rules,
            lit_tokens: *lit_tokens,
            rule_index,
            first_cache: TreeMap::<String, List<String>>::new(),
            single_token_cache: TreeMap::<String, bool>::new(),
            nullable_cache: TreeMap::<String, bool>::new(),
            scannable_cache: TreeMap::<String, bool>::new(),
            single_alt_owner,
            kind_set_registry: TreeMap::<String, KindSetEntry>::new(),
            follow_mask_registry: TreeMap::<String, FollowMaskEntry>::new(),
            tail_greedy_cache: TreeMap::<String, List<String>>::new(),
            diagnostics: [],
            caller_follow_gate_seen: false,
            needs_atn_seen: false,
            needs_scan_atn_seen: false,
            atn_call_site_returns: [],
            current_rule_index: -1,
            lr_loop_entry_decisions: [],
            scan_atn_rule_snake: "",
            trace: false,
        };
    }

    /// Record that lowering emitted a tail-greedy caller-FOLLOW gate.
    /// Flips `emit_follow` on for the whole generated parser.
    pub fn mark_caller_follow_gate(&mut self) {
        self.caller_follow_gate_seen = true;
    }

    /// Whether the generated parser should emit the FOLLOW machinery
    /// (the `follow` parameter, its call arguments, and the
    /// `FOLLOW_MASK_<id>` globals). True iff lowering produced at least
    /// one caller-FOLLOW gate; otherwise `follow` would be threaded but
    /// never read, so it is pruned entirely.
    pub fn emit_follow(&self) -> bool {
        return self.caller_follow_gate_seen;
    }

    /// Record that lowering encountered a non-greedy repeat, so emit must
    /// include the ATN simulator infrastructure.
    pub fn mark_needs_atn(&mut self) {
        self.needs_atn_seen = true;
    }

    /// Whether the generated parser should emit the ATN simulator
    /// infrastructure (blob, `Parser.atn`/`atn_stack`, rule-entry
    /// stack maintenance). True iff lowering saw a non-greedy repeat.
    pub fn needs_atn(&self) -> bool {
        return self.needs_atn_seen;
    }

    /// Record that lowering saw an ATN-class LR rule (needs scan-side ATN
    /// globals). Implies `needs_atn`.
    pub fn mark_needs_scan_atn(&mut self) {
        self.needs_scan_atn_seen = true;
    }

    /// Whether to emit the scan-side ATN globals (`GALE_ATN_SIM` /
    /// `GALE_SCAN_STACK`). True iff an ATN-class LR rule exists.
    pub fn needs_scan_atn(&self) -> bool {
        return self.needs_scan_atn_seen;
    }

    /// Store the ATN call-site → return-state correspondence after the ATN
    /// is built (only when `needs_atn`). Read by `atn_ret_pending_arg`.
    pub fn set_atn_call_site_returns(&mut self, returns: &List<i32>) {
        self.atn_call_site_returns = *returns;
    }

    /// The exact ATN return state for surface call site `call_site`, or -1
    /// when unknown (no ATN built, the id is out of range, or the call site
    /// never got a `RuleRef` segment — e.g. the stripped leading LR self-ref).
    pub fn atn_call_site_return(&self, call_site: i32) -> i32 {
        if call_site < 0 || call_site >= self.atn_call_site_returns.len() {
            return -1;
        }
        return self.atn_call_site_returns[call_site];
    }

    /// Record the rule whose body is currently being emitted (its index in
    /// `parser_rules`). Set by `gen_parse_fn` before the body walk.
    pub fn set_current_rule_index(&mut self, idx: i32) {
        self.current_rule_index = idx;
    }

    /// The rule currently being emitted, or -1 outside rule-body emission.
    pub fn current_rule_index(&self) -> i32 {
        return self.current_rule_index;
    }

    /// Store the per-rule ATN loop-entry decision numbers (after `build_atn`).
    pub fn set_lr_loop_entry_decisions(&mut self, decs: &List<i32>) {
        self.lr_loop_entry_decisions = *decs;
    }

    /// The ATN loop-entry decision number for `rule`, or -1 if none / unbuilt.
    pub fn lr_loop_entry_decision(&self, rule: i32) -> i32 {
        if rule < 0 || rule >= self.lr_loop_entry_decisions.len() {
            return -1;
        }
        return self.lr_loop_entry_decisions[rule];
    }

    /// Mark (or clear with `""`) the ATN-class LR rule whose `scan_*` body is
    /// being emitted, so a self-ref operand scan brackets with the scan stack.
    pub fn set_scan_atn_rule(&mut self, snake: &String) {
        self.scan_atn_rule_snake = *snake;
    }

    /// If a self-ref operand scan to `target_snake` is being emitted inside an
    /// ATN-class rule's scan, the exact ATN return state to push onto
    /// `GALE_SCAN_STACK` (from `Atn.call_site_returns`); else -1.
    pub fn scan_atn_push_return(&self, target_snake: &String, atn_call_site: i32) -> i32 {
        if self.scan_atn_rule_snake.is_empty() || self.scan_atn_rule_snake != *target_snake {
            return -1;
        }
        return self.atn_call_site_return(atn_call_site);
    }

    /// Enable trace instrumentation in the generated parser (the
    /// `trace: true` generator option / `gale gen --trace`). Read across
    /// parser emit — by `gen_parser_struct` / `gen_rule_entry_wrapper`
    /// for the rule enter/ok/fail frames, and by `gen_multi_alt_body` /
    /// `gen_prediction_code` for the multi-alt scan/pick/try lines.
    pub fn set_trace(&mut self, on: bool) {
        self.trace = on;
    }

    /// Whether trace instrumentation should be emitted.
    pub fn is_trace(&self) -> bool {
        return self.trace;
    }

    /// Record a prediction-strategy diagnostic for `rule`, deduped on
    /// `(rule, message)`. A single decision site can be revisited: the
    /// parse and scan passes lower the same alts twice — both re-enter
    /// the same warn site with an identical `(rule, message)`.
    /// Collapsing here keeps each prediction warning
    /// reported once regardless of how many times lowering revisits the
    /// decision, so the dedup does not depend on a display-string
    /// heuristic. `message` already encodes everything `kind` does, so
    /// the pair is a sufficient key without an `Eq` on `DiagnosticKind`.
    pub fn warn(&mut self, rule: &String, kind: DiagnosticKind, message: String) {
        for let d of &self.diagnostics {
            if d.rule == *rule && d.message == message {
                return;
            }
        }
        self.diagnostics.push(Diagnostic { rule: *rule, kind, message });
    }

    /// Return the collected diagnostics (a value copy under Wado value
    /// semantics; `self` keeps its own). `lower_with_ctx` reads them
    /// exactly once into `LoweredGrammar.diagnostics`, so the copy is
    /// harmless.
    pub fn take_diagnostics(&self) -> List<Diagnostic> {
        return self.diagnostics;
    }

    /// Index of a parser rule by name (position in `parser_rules`), or -1.
    /// Matches `atn.wado::build_atn`'s rule indexing, so the generated
    /// parser can push this onto `atn_stack` for full-context prediction.
    pub fn rule_index_of(&self, name: &String) -> i32 {
        if let Some(i) = self.rule_index.get(*name) {
            return i;
        }
        return -1;
    }

    pub fn find_rule(&self, name: &String) -> Option<&ParserRule> {
        let idx = self.rule_index.get(*name);
        if let Some(i) = idx {
            return Option::Some(&self.parser_rules[i]);
        }
        return null;
    }

    pub fn first_of_rule(&mut self, name: &String, visiting: &mut List<String>) -> List<String> {
        let cached = self.first_cache.get(*name);
        if let Some(result) = cached {
            return result;
        }

        if visiting.contains(name) {
            return [];
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result: List<String> = [];

        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            for let alt of &rule.alternatives {
                let af = self.first_of_alt(alt, visiting);
                extend_dedup(&mut result, &af);
            }
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.first_cache[*name] = result;
        }

        return result;
    }

    pub fn first_of_element(&mut self, elem: &Element, visiting: &mut List<String>) -> List<String> {
        return match elem {
            TokenRef(t) => [`TK_{t.name}`],
            Literal(l) => [literal_const_name(&l.text)],
            RuleRef(r) => self.first_of_rule(&r.name, visiting),
            Group(g) => {
                let mut result: List<String> = [];
                for let alt of &g.alternatives {
                    let af = self.first_of_alt(alt, visiting);
                    extend_dedup(&mut result, &af);
                }
                result;
            },
            Repeat(rep) => self.first_of_element(&rep.element, visiting),
            Label(lab) => self.first_of_element(&lab.element, visiting),
            // Wildcard and Not match an open-ended set of tokens; we cannot
            // enumerate FIRST statically. Returning [] disables static prediction
            // for alternatives starting with them — such alternatives must either
            // be in a single-alt rule, used as a fallback, or be distinguished
            // from their siblings by later elements.
            Wildcard(_) => [],
            Not(_) => [],
        };
    }

    pub fn first_of_alt(&mut self, alt: &Alternative, visiting: &mut List<String>) -> List<String> {
        let mut result: List<String> = [];

        for let elem of &alt.elements {
            let elem_first = self.first_of_element(elem, visiting);
            extend_dedup(&mut result, &elem_first);
            if !is_nullable(elem) {
                break;
            }
        }
        return result;
    }

    pub fn first_of_elements_from(&mut self, elements: &List<Element>, start: i32) -> List<String> {
        let mut result: List<String> = [];

        for let mut i = start; i < elements.len(); i += 1 {
            let mut visiting: List<String> = [];
            let elem_first = self.first_of_element(&elements[i], &mut visiting);
            extend_dedup(&mut result, &elem_first);
            if !is_nullable(&elements[i]) {
                break;
            }
        }
        return result;
    }

    /// Returns FIRST sets indexed by INPUT TOKEN position relative to the alt start.
    ///
    /// Invariant: `result[d]` is the set of possible first tokens at input offset `d`
    /// **assuming the alt matches successfully up to that point**. Guards built from
    /// this mapping are sound disambiguators for caller-side lookahead.
    ///
    /// To maintain the element-pos-to-input-pos alignment, we only advance past an
    /// element if it is guaranteed to consume exactly 1 input token (non-nullable,
    /// single-token). Nullable or multi-token elements halt accumulation — the
    /// caller gets a shorter (but always sound) sequence.
    ///
    /// Thin wrapper around [`position_first_sets_from`] with `start = 0` —
    /// the generic form supports computing FIRST sets at an arbitrary
    /// suffix offset (the multi-token follow-mask path).
    pub fn alt_position_first_sets(&mut self, alt: &Alternative, max_depth: i32) -> List<List<String>> {
        return self.position_first_sets_from(&alt.elements, 0, max_depth);
    }

    /// Deep version of [`position_first_sets_from`] that expands
    /// `RuleRef` elements into the referenced rule's body. Used by
    /// `compute_follow_arg` to build a caller's multi-depth FOLLOW mask
    /// — `position_first_sets_from` halts at a `RuleRef` to a
    /// multi-token rule, hiding the depths the runtime gate needs to
    /// disambiguate iter vs. exit.
    ///
    /// Only single-alt non-cyclic `RuleRef`s are expanded; multi-alt
    /// `RuleRef`s halt accumulation (per-depth union of multi-alt
    /// prefixes would over-yield by matching cross-alt sequences that
    /// no real alt admits).
    ///
    /// Returns `(prefix, consumed_elements)`. `consumed_elements` is the
    /// number of surface elements from `elements[start..]` that the
    /// walk fully traversed (not the same as `prefix.len()` — a
    /// single-alt `RuleRef` consumes one surface element but its
    /// expanded body may contribute multiple depths). Callers needing
    /// to follow the suffix past the walk must use the element count,
    /// not the depth count.
    pub fn deep_position_first_sets_from(&mut self, elements: &List<Element>, start: i32, max_depth: i32, visiting: &mut List<String>) -> [List<List<String>>, i32] {
        let mut result: List<List<String>> = [];
        let final_cursor = self.deep_position_walk(elements, start, max_depth, &mut result, visiting);
        return [result, final_cursor - start];
    }

    /// Internal walker. Returns the cursor index reached when the walk
    /// finished — equal to `elements.len()` when fully consumed, less
    /// when the walk halted (early return after a multi-alt RuleRef,
    /// nullable suffix, `Group` / `Repeat` / `Wildcard`, etc.). The
    /// return value tells callers whether subsequent elements can be
    /// safely indexed (when fully consumed) or whether the walk hit a
    /// non-deterministic position (halted).
    fn deep_position_walk(&mut self, elements: &List<Element>, start: i32, max_depth: i32, result: &mut List<List<String>>, visiting: &mut List<String>) -> i32 {
        let mut cursor = start;
        while result.len() < max_depth && cursor < elements.len() {
            // Suffix from `cursor` must consume ≥1 token — otherwise the
            // alignment from position-d-set to input-offset-d breaks.
            if self.tail_is_nullable_deep(elements, cursor) {
                return cursor;
            }
            let elem = &elements[cursor];
            match elem {
                TokenRef(_) | Literal(_) => {
                    let mut fv: List<String> = [];
                    let first = self.first_of_element(elem, &mut fv);
                    if first.is_empty() {
                        return cursor;
                    }
                    result.push(first);
                    cursor += 1;
                },
                Label(lab) => {
                    // A label is positionally identical to its inner;
                    // recurse on a single-element sequence wrapping the
                    // labelled element. If that recursion halts (didn't
                    // walk the whole `[lab.element]`), this outer walk
                    // must halt too — otherwise we'd keep consuming
                    // subsequent surface elements at depths that no
                    // longer align with the un-fully-walked label.
                    let single: List<Element> = [lab.element];
                    let inner_final = self.deep_position_walk(&single, 0, max_depth, result, visiting);
                    if inner_final < single.len() {
                        return cursor;
                    }
                    cursor += 1;
                },
                RuleRef(r) => {
                    if visiting.contains(&r.name) {
                        return cursor;
                    }
                    let rule = self.find_rule(&r.name);
                    if let Some(rule) = rule {
                        if rule.alternatives.len() != 1 {
                            // Multi-alt: per-depth union would over-yield. Halt.
                            return cursor;
                        }
                        visiting.push(r.name);
                        let inner_elements = &rule.alternatives[0].elements;
                        let inner_final = self.deep_position_walk(inner_elements, 0, max_depth, result, visiting);
                        remove_from_visiting(visiting, &r.name);
                        // If the expansion halted inside the rule body
                        // (didn't reach `inner_elements.len()`), the
                        // surface element index of subsequent elements
                        // no longer corresponds to a contiguous input
                        // depth — halt the outer walk too.
                        if inner_final < inner_elements.len() {
                            return cursor;
                        }
                    } else {
                        return cursor;
                    }
                    cursor += 1;
                },
                Group(_) | Repeat(_) | Wildcard(_) | Not(_) => {
                    // Conservative halt: per-depth union across alts /
                    // optional iterations would over-yield; static
                    // wildcards can't be enumerated.
                    return cursor;
                },
            }
        }
        return cursor;
    }

    /// Returns FIRST sets indexed by INPUT TOKEN position relative to the
    /// suffix starting at `elements[start..]`. Generalises
    /// [`alt_position_first_sets`] by accepting an arbitrary `start`
    /// offset — used by the multi-token follow-mask path to read out a
    /// caller's K-token continuation prefix at a `RuleRef` call site.
    ///
    /// Halts (returns a shorter sequence) at the first nullable or
    /// multi-token element — preserving the input-offset alignment that
    /// makes the result a sound lookahead predictor. See
    /// [`alt_position_first_sets`] for the invariant details.
    pub fn position_first_sets_from(&mut self, elements: &List<Element>, start: i32, max_depth: i32) -> List<List<String>> {
        let mut result: List<List<String>> = [];
        let mut cursor = start;
        while result.len() < max_depth && cursor < elements.len() {
            // If the tail from `cursor` onwards is entirely nullable, the
            // alt can match 0 tokens from this offset — input[result.len()]
            // is in the follow-set, which `first` doesn't include. Guard
            // would be unsound. Halt.
            if self.tail_is_nullable_deep(elements, cursor) {
                break;
            }
            // Deep first-set: accumulate across deeply-nullable elements so the
            // set covers every token that can legitimately appear at this offset
            // when the alt matches.
            let first = self.deep_first_of_elements_from(elements, cursor);
            if first.len() == 0 {
                break;
            }
            result.push(first);

            // Advance past element[cursor] only if it consumes exactly 1 token;
            // otherwise result[d+1] would not align with input offset d+1.
            let mut visiting: List<String> = [];
            if !self.element_is_single_token(&elements[cursor], &mut visiting) {
                break;
            }
            cursor += 1;
        }
        return result;
    }

    /// Like `first_of_elements_from` but uses deep nullability so it correctly
    /// flows through `RuleRef`s whose underlying rule matches zero tokens.
    pub fn deep_first_of_elements_from(&mut self, elements: &List<Element>, start: i32) -> List<String> {
        let mut result: List<String> = [];
        for let mut i = start; i < elements.len(); i += 1 {
            let mut fv: List<String> = [];
            let elem_first = self.first_of_element(&elements[i], &mut fv);
            extend_dedup(&mut result, &elem_first);
            let mut nv: List<String> = [];
            if !self.element_is_nullable_deep(&elements[i], &mut nv) {
                break;
            }
        }
        return result;
    }

    /// Deep nullability: true if every element from `start` onwards can match
    /// zero input tokens, recursively checking referenced rules (unlike the
    /// shallow `is_nullable` which only inspects top-level Repeat kind).
    ///
    /// Used both as "is the suffix from `start` nullable?" (by alt
    /// walkers gating follow propagation) and as "is the rule body
    /// nullable?" (by tail-greedy analysis).
    pub fn tail_is_nullable_deep(&mut self, elements: &List<Element>, start: i32) -> bool {
        for let mut i = start; i < elements.len(); i += 1 {
            let mut visiting: List<String> = [];
            if !self.element_is_nullable_deep(&elements[i], &mut visiting) {
                return false;
            }
        }
        return true;
    }

    pub fn element_is_nullable_deep(&mut self, elem: &Element, visiting: &mut List<String>) -> bool {
        return match elem {
            TokenRef(_) => false,
            Literal(_) => false,
            Wildcard(_) => false,
            Not(_) => false,
            RuleRef(r) => self.rule_is_nullable(&r.name, visiting),
            Label(lab) => self.element_is_nullable_deep(&lab.element, visiting),
            Repeat(rep) => match rep.kind {
                Star | Optional => true,
                _ => self.element_is_nullable_deep(&rep.element, visiting),
            },
            Group(g) => {
                let mut any_nullable = false;
                for let alt of &g.alternatives {
                    let mut all_null = true;
                    for let e of &alt.elements {
                        if !self.element_is_nullable_deep(e, visiting) {
                            all_null = false;
                            break;
                        }
                    }
                    if all_null {
                        any_nullable = true;
                        break;
                    }
                }
                any_nullable;
            },
        };
    }

    pub fn rule_is_nullable(&mut self, name: &String, visiting: &mut List<String>) -> bool {
        let cached = self.nullable_cache.get(*name);
        if let Some(val) = cached {
            return val;
        }

        if visiting.contains(name) {
            return false;
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result = false;
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            for let alt of &rule.alternatives {
                let mut all_null = true;
                for let e of &alt.elements {
                    if !self.element_is_nullable_deep(e, visiting) {
                        all_null = false;
                        break;
                    }
                }
                if all_null {
                    result = true;
                    break;
                }
            }
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.nullable_cache[*name] = result;
        }

        return result;
    }

    /// True if the element always consumes exactly 1 input token on match.
    /// Used to keep `alt_position_first_sets` element-to-input-position aligned.
    pub fn element_is_single_token(&mut self, elem: &Element, visiting: &mut List<String>) -> bool {
        return match elem {
            TokenRef(_) => true,
            Literal(_) => true,
            Wildcard(_) => true,
            Not(_) => true,
            RuleRef(r) => self.rule_is_single_token(&r.name, visiting),
            Label(lab) => self.element_is_single_token(&lab.element, visiting),
            Group(_) => false,
            Repeat(_) => false,
        };
    }

    /// True if this element's `first` set is an *exact* predictor: i.e.
    /// "the first-set token is present at the input position" implies
    /// "this element will successfully consume that token (and only
    /// that token) when it matches". The criterion underlying LL repair
    /// for nullable suffixes (Phase 5 step 3): a deep-nullable suffix
    /// can contribute its first set to a `RuleRef`'s caller-follow only
    /// when every walked element is first-exact. Otherwise the
    /// suffix's first might be a multi-element alt's leading token
    /// whose suppression at the preceding `RuleRef` would leave the
    /// runtime stranded — this is the css3 selector / HTMLParser
    /// htmlContent hazard documented in `package-gale/CLAUDE.md`.
    ///
    /// Single-token elements are trivially first-exact. A `Repeat`
    /// inherits first-exactness from its inner: `b?` where `b : Y` has
    /// a single-token inner so its first is exactly `{Y}`. A `Group`
    /// is first-exact only when every alt is a single first-exact
    /// element — anything more complex risks the multi-element alt
    /// hazard.
    pub fn element_is_first_exact(&mut self, elem: &Element) -> bool {
        return match elem {
            TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => true,
            RuleRef(r) => {
                let mut visiting: List<String> = [];
                self.rule_is_single_token(&r.name, &mut visiting);
            },
            Label(lab) => self.element_is_first_exact(&lab.element),
            Repeat(rep) => self.element_is_first_exact(&rep.element),
            Group(g) => {
                let mut all_exact = true;
                for let alt of &g.alternatives {
                    if alt.elements.len() != 1 {
                        all_exact = false;
                        break;
                    }
                    if !self.element_is_first_exact(&alt.elements[0]) {
                        all_exact = false;
                        break;
                    }
                }
                all_exact;
            },
        };
    }

    /// True if every element of `elements[start..]` is first-exact —
    /// the precondition for unioning the suffix's first set into a
    /// preceding `RuleRef`'s caller-follow when the suffix is
    /// deep-nullable. See `element_is_first_exact` for the semantic
    /// argument.
    pub fn deep_suffix_is_first_exact(&mut self, elements: &List<Element>, start: i32) -> bool {
        for let mut i = start; i < elements.len(); i += 1 {
            if !self.element_is_first_exact(&elements[i]) {
                return false;
            }
        }
        return true;
    }

    /// Per-call-site caller-FOLLOW for the element at index `i` in
    /// `elements`. Single source of truth for the `FollowArg` mask
    /// `lower` builds at each `RuleRef` site (`compute_follow_arg`).
    ///
    /// Three cases:
    ///
    /// - Suffix is non-nullable: the immediate suffix's `first` set is
    ///   the only thing that can follow.
    /// - Suffix is deep-nullable AND first-exact (every walked element's
    ///   first uniquely predicts that element matching, see
    ///   `element_is_first_exact`): keep the suffix's `first`. This
    ///   closes `ll_nullable_suffix`'s gap.
    /// - Suffix is deep-nullable but NOT first-exact: drop the suffix's
    ///   first and return empty. This is the "first-exact deep-nullable
    ///   suffix" soundness invariant — see `CLAUDE.md` "Failed
    ///   Approaches" #3 for the rationale.
    pub fn compute_call_site_follow(&mut self, elements: &List<Element>, i: i32) -> List<String> {
        let first = self.first_of_elements_from(elements, i + 1);
        if !self.tail_is_nullable_deep(elements, i + 1) {
            return first;
        }
        if self.deep_suffix_is_first_exact(elements, i + 1) {
            return first;
        }
        return [] as List<String>;
    }

    pub fn rule_is_single_token(&mut self, name: &String, visiting: &mut List<String>) -> bool {
        let cached = self.single_token_cache.get(*name);
        if let Some(val) = cached {
            return val;
        }

        if visiting.contains(name) {
            return false;
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result = false;
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            let mut all_alts_ok = true;
            for let alt of &rule.alternatives {
                let mut non_nullable_count = 0;
                let mut single_ok = false;
                let mut has_nullable = false;
                for let elem of &alt.elements {
                    if is_nullable(elem) {
                        // A nullable element (Star/Optional Repeat) can consume
                        // additional tokens when its inner matches. e.g.
                        // `'-'? Integer` is 1 token without `-` but 2 with `-`.
                        // Treat any nullable element as disqualifying so the
                        // rule isn't misclassified as strictly single-token.
                        has_nullable = true;
                        break;
                    }
                    non_nullable_count += 1;
                    if non_nullable_count > 1 {
                        break;
                    }
                    if let TokenRef(_) | Literal(_) = elem {
                        single_ok = true;
                    } else if let RuleRef(r) = elem {
                        single_ok = self.rule_is_single_token(&r.name, visiting);
                    }
                }
                if has_nullable || non_nullable_count != 1 || !single_ok {
                    all_alts_ok = false;
                    break;
                }
            }
            result = all_alts_ok;
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.single_token_cache[*name] = result;
        }

        return result;
    }

    /// Returns true if the rule is safe to scan as a predicate prefix.
    ///
    /// Left-recursive (LR) rules have faithful `scan_X_atom` / `scan_X_prec` /
    /// `scan_X_lr_N` generated for them so nested scans can recurse through
    /// them correctly. The cost concern that previously forced a top-level
    /// LR gate here — exhaustive longest-match tournaments running every
    /// candidate's full LR scan even when an earlier alt already matched —
    /// is addressed at the dispatch sites: `emit_scan_partition_body`,
    /// `gen_group_scan_dispatch`, `gen_general_group_scan_dispatch`, and
    /// `gen_rule_ref_group_scan_dispatch` use first-success-wins on
    /// `sort_group_by_element_count` order, mirroring parse-side `bt_try`.
    /// Sorting longest-first ensures the most specific candidate is tried
    /// first, so commit-on-success is correctness-equivalent to longest-
    /// match here. See `AGENTS.md` "Failed Approaches: Removing the LR
    /// Gate ... 2026-04" for the historical context that ruled out a naive
    /// gate removal.
    pub fn is_rule_scannable(&mut self, name: &String, visiting: &mut List<String>) -> bool {
        let cached = self.scannable_cache.get(*name);
        if let Some(val) = cached {
            return val;
        }

        if visiting.contains(name) {
            return true;
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result = false;
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            let mut all_ok = true;
            for let alt of &rule.alternatives {
                if !self.is_alt_scannable(&alt.elements, visiting) {
                    all_ok = false;
                    break;
                }
            }
            result = all_ok;
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.scannable_cache[*name] = result;
        }

        return result;
    }

    /// Returns true if every element in the sequence is scannable.
    pub fn is_alt_scannable(&mut self, elements: &List<Element>, visiting: &mut List<String>) -> bool {
        for let elem of elements {
            if !self.is_element_scannable(elem, visiting) {
                return false;
            }
        }
        return true;
    }

    /// Returns true if a single element is scannable.
    pub fn is_element_scannable(&mut self, elem: &Element, visiting: &mut List<String>) -> bool {
        return match elem {
            TokenRef(_) | Literal(_) => true,
            RuleRef(r) => self.is_rule_scannable(&r.name, visiting),
            Label(lab) => self.is_element_scannable(&lab.element, visiting),
            Repeat(rep) => self.is_element_scannable(&rep.element, visiting),
            Group(g) => {
                for let alt of &g.alternatives {
                    if !self.is_alt_scannable(&alt.elements, visiting) {
                        return false;
                    }
                }
                return true;
            },
            // Wildcard advances by exactly one token (unless at EOF).
            Wildcard(_) => true,
            // `~ X` advances by one token when the current token is not in
            // the complement set. The inner element is required to be a
            // terminal or a simple terminal set, both of which are scannable.
            Not(_) => true,
        };
    }

    /// Get the rule name that owns the general group types inside a given
    /// single-alt group. Returns `fallback` if the type name is not a
    /// shared single-alt group (in practice every reached single-alt
    /// group is in the map; callers pass the surrounding rule's name as
    /// a defensive fallback).
    pub fn general_group_rule_name(&self, single_alt_type_name: &String, fallback: &String) -> String {
        if let Some(owner) = self.single_alt_owner.get(*single_alt_type_name) {
            return owner;
        }
        return *fallback;
    }

    /// Intern a token-kind set. The same set (regardless of input order
    /// or duplicates) maps to a single `id`. Helper IDs are assigned in
    /// first-seen order across the codegen pass.
    pub fn intern_kind_set(&mut self, tokens: &List<String>) -> i32 {
        let canonical = canonical_kind_set(tokens);
        let key = join_pipe(&canonical);
        if let Some(entry) = self.kind_set_registry.get(key) {
            return entry.id;
        }
        let id = self.kind_set_registry.len();
        self.kind_set_registry[key] = KindSetEntry { id, tokens: canonical };
        return id;
    }

    /// All interned kind sets in helper-ID order (i.e. insertion order).
    /// Consumed by `gen_kind_set_helpers` to emit the helper functions.
    pub fn kind_sets(&self) -> List<KindSetEntry> {
        return self.kind_set_registry.values();
    }

    /// Intern a runtime FOLLOW-continuation mask. The same canonical mask
    /// maps to a single `id`; `FOLLOW_MASK_<id>` globals are assigned in
    /// first-seen order across the codegen pass. Returns `null` for an
    /// effectively-empty mask (no depth carries a constraint) — such a
    /// mask never gates, so callers should pass `&EMPTY_FOLLOW` instead
    /// of interning a dead global.
    pub fn intern_follow_mask(&mut self, mask: &List<List<String>>) -> Option<i32> {
        // Trim trailing depth-sets that carry no constraint: `follow_yields`
        // skips empty depths, so `[[X], []]` gates identically to `[[X]]`
        // and a mask whose depths are all empty never gates at all (→ null,
        // caller passes `&EMPTY_FOLLOW`).
        let sorted = canonicalize_k_prefix(mask);
        let mut last_constrained: i32 = -1;
        for let mut d = 0; d < sorted.len(); d += 1 {
            if !sorted[d].is_empty() {
                last_constrained = d;
            }
        }
        if last_constrained < 0 {
            return null;
        }
        let mut canonical: List<List<String>> = [];
        for let mut d = 0; d <= last_constrained; d += 1 {
            canonical.push(sorted[d]);
        }
        let key = canonical_k_prefix_key(&canonical);
        if let Some(entry) = self.follow_mask_registry.get(key) {
            return Option::<i32>::Some(entry.id);
        }
        let id = self.follow_mask_registry.len();
        self.follow_mask_registry[key] = FollowMaskEntry { id, mask: canonical };
        return Option::<i32>::Some(id);
    }

    /// All interned FOLLOW masks in `FOLLOW_MASK_<id>` order (insertion
    /// order). Consumed by the global-emit pass.
    pub fn follow_masks(&self) -> List<FollowMaskEntry> {
        return self.follow_mask_registry.values();
    }

    /// Render a token-set membership check on `expr`.
    ///
    ///   - 0 tokens → `"true"` (the empty set never excludes anything in
    ///     practice; callers that build up first-sets use this).
    ///   - 1 token  → `<expr> == TK_X` (no `matches` overhead).
    ///   - ≥2 tokens → `_gale_kind_set_<id>(<expr>)` after interning.
    ///
    /// Multi-element sets always go through the helper indirection so
    /// duplicate sets across the grammar share a single function body
    /// in the generated wasm.
    pub fn kind_check_str(&mut self, tokens: &List<String>, expr: &String) -> String {
        if tokens.is_empty() {
            return "true";
        }
        if tokens.len() == 1 {
            return `{*expr} == {tokens[0]}`;
        }
        let id = self.intern_kind_set(tokens);
        return `_gale_kind_set_{id}({*expr})`;
    }

    /// Sugar for `kind_check_str` against `p.peek_kind()`.
    pub fn first_check_str(&mut self, first_set: &List<String>) -> String {
        return self.kind_check_str(first_set, &"p.peek_kind()");
    }

    /// Returns the set of token kinds that the rule's body may greedily
    /// consume at tail position, i.e. tokens that would be claimed by an
    /// `Optional` / `Star` / `Plus` element which has no required element
    /// after it in the alt.
    ///
    /// Used to gate the caller-FOLLOW repair: if a `RuleRef` call
    /// site's caller-local `FOLLOW` does not intersect this set, the
    /// callee's tail-greedy elements cannot collide with the caller's
    /// expectations and no FOLLOW argument is needed.
    pub fn tail_greedy_first_of_rule(&mut self, name: &String, visiting: &mut List<String>) -> List<String> {
        let cached = self.tail_greedy_cache.get(*name);
        if let Some(result) = cached {
            return result;
        }

        if visiting.contains(name) {
            return [];
        }

        let is_top_level = visiting.is_empty();
        visiting.push(*name);

        let mut result: List<String> = [];
        let rule = self.find_rule(name);
        if let Some(rule) = rule {
            for let alt of &rule.alternatives {
                let af = self.tail_greedy_first_of_elements(&alt.elements, visiting);
                extend_dedup(&mut result, &af);
            }
        }

        remove_from_visiting(visiting, name);

        if is_top_level {
            self.tail_greedy_cache[*name] = result;
        }

        return result;
    }

    /// Walk an alt element list from the tail, collecting tail-greedy
    /// first sets. Stops at the first non-deeply-nullable element. A
    /// `Repeat (Optional|Star|Plus)` contributes `first_of_element(inner)`.
    /// A nested `Group` recurses per alt. A `RuleRef` to a rule with a
    /// non-empty `tail_greedy_first` contributes that set transitively.
    fn tail_greedy_first_of_elements(&mut self, elements: &List<Element>, visiting: &mut List<String>) -> List<String> {
        let mut result: List<String> = [];
        let mut i = elements.len() - 1;
        while i >= 0 {
            let elem = &elements[i];
            let tg = self.tail_greedy_first_of_element(elem, visiting);
            extend_dedup(&mut result, &tg);
            let mut nv: List<String> = [];
            if !self.element_is_nullable_deep(elem, &mut nv) {
                break;
            }
            i -= 1;
        }
        return result;
    }

    fn tail_greedy_first_of_element(&mut self, elem: &Element, visiting: &mut List<String>) -> List<String> {
        return match elem {
            Repeat(rep) => {
                // Only count Repeats whose inner consumes EXACTLY one
                // token per iteration. Multi-token bodies like
                // `(htmlElement | CDATA | htmlComment) htmlChardata?`
                // in HTMLParser's `htmlContent` rule cannot be safely
                // suppressed by a follow mask: the outer caller's
                // follow set legitimately overlaps with the inner's
                // first set (e.g. TAG_OPEN starts a nested htmlElement
                // AS WELL AS the closing `</div>` tag), and the
                // runtime lookahead-2 distinguishes them in a way
                // static analysis cannot. Restricting to single-token
                // inners keeps the LL repair (`Y?` in `a : X Y?`)
                // working without breaking those grammars.
                let mut stv: List<String> = [];
                let single = self.element_is_single_token(&rep.element, &mut stv);
                let result: List<String> = if !single {
                    [];
                } else {
                    let mut fv: List<String> = [];
                    self.first_of_element(&rep.element, &mut fv);
                };
                result;
            },
            Group(g) => {
                let mut acc: List<String> = [];
                for let alt of &g.alternatives {
                    let inner = self.tail_greedy_first_of_elements(&alt.elements, visiting);
                    extend_dedup(&mut acc, &inner);
                }
                acc;
            },
            Label(lab) => self.tail_greedy_first_of_element(&lab.element, visiting),
            RuleRef(r) => self.tail_greedy_first_of_rule(&r.name, visiting),
            // Token / Literal / Wildcard / Not consume exactly one token
            // and never leak — they are the "stop" condition.
            TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => [],
        };
    }

    /// Render the negation of a token-set membership check —
    /// `!_gale_kind_set_<id>(<expr>)` for ≥2 tokens, else
    /// `<expr> != TK_X`. Used by non-greedy emit sites.
    pub fn kind_negate_check_str(&mut self, tokens: &List<String>, expr: &String) -> String {
        if tokens.is_empty() {
            return "false";
        }
        if tokens.len() == 1 {
            return `{*expr} != {tokens[0]}`;
        }
        let id = self.intern_kind_set(tokens);
        return `!_gale_kind_set_{id}({*expr})`;
    }
}

/// Sort tokens lexicographically and remove duplicates, producing the
/// canonical representative of the set. Two `matches { ... }` checks
/// over equal sets (regardless of order or repeated elements) collapse
/// to the same canonical form and therefore the same helper id.
fn canonical_kind_set(tokens: &List<String>) -> List<String> {
    let mut sorted = *tokens;
    sorted.sort();
    let mut out: List<String> = [];
    for let mut i = 0; i < sorted.len(); i += 1 {
        if i == 0 || sorted[i] != sorted[i - 1] {
            out.push(sorted[i]);
        }
    }
    return out;
}

/// Join an already-canonicalised token list with `|`. The resulting
/// string is the registry key. `|` cannot appear in `TK_*` identifiers
/// so this is unambiguous.
fn join_pipe(tokens: &List<String>) -> String {
    let mut s = String::with_capacity(64);
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            s.push('|');
        }
        s.push_str(&tokens[i]);
    }
    return s;
}

/// Build a map from single-alt group type name to the first rule that contains it.
/// This ensures parser gen uses the same type names as the type gen for shared groups.
fn build_single_alt_owner_map(parser_rules: &List<ParserRule>) -> TreeMap<String, String> {
    let mut map = TreeMap::<String, String>::new();
    for let rule of parser_rules {
        for let alt of &rule.alternatives {
            scan_elements_for_single_alt_groups(&alt.elements, &rule.name, &mut map);
        }
    }
    return map;
}

fn scan_elements_for_single_alt_groups(elements: &List<Element>, rule_name: &String, map: &mut TreeMap<String, String>) {
    for let elem of elements {
        scan_element_for_single_alt_groups(elem, rule_name, map);
    }
}

fn scan_element_for_single_alt_groups(elem: &Element, rule_name: &String, map: &mut TreeMap<String, String>) {
    let alts = extract_group_alts_for_scan(elem);
    if let Some(group_alts) = alts {
        if is_single_alt_group(group_alts) {
            let type_name = single_alt_group_type_name(&group_alts[0]);
            if !map.contains_key(type_name) {
                map[type_name] = *rule_name;
            }
            // Recurse into the single-alt group's elements
            scan_elements_for_single_alt_groups(&group_alts[0].elements, rule_name, map);
        } else {
            // Recurse into multi-alt group alts
            for let alt of group_alts {
                scan_elements_for_single_alt_groups(&alt.elements, rule_name, map);
            }
        }
        return;
    }
    if let Repeat(rep) = elem {
        scan_element_for_single_alt_groups(&rep.element, rule_name, map);
        return;
    }
    if let Label(lab) = elem {
        scan_element_for_single_alt_groups(&lab.element, rule_name, map);
    }
}

fn extract_group_alts_for_scan(elem: &Element) -> Option<&List<Alternative>> {
    if let Group(g) = elem {
        return Option::Some(&g.alternatives);
    }
    if let Repeat(rep) = elem {
        if let Group(g) = &rep.element {
            return Option::Some(&g.alternatives);
        }
    }
    return null;
}

pub fn is_nullable(elem: &Element) -> bool {
    if let Repeat(rep) = elem {
        if let Star | Optional = rep.kind {
            return true;
        }
    }
    return false;
}

pub fn sets_overlap(a: &List<String>, b: &List<String>) -> bool {
    for let x of a {
        if b.contains(x) {
            return true;
        }
    }
    return false;
}

pub fn is_simple_token_group(alts: &List<Alternative>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        let elem = &alt.elements[0];
        if let TokenRef(_) | Literal(_) = elem {
            continue;
        }
        return false;
    }
    return true;
}

fn extend_dedup(target: &mut List<String>, source: &List<String>) {
    for let item of source {
        if !target.contains(item) {
            target.push(*item);
        }
    }
}

/// Canonicalise a K-prefix mask: sort each depth's token list so two
/// otherwise-identical masks share the same registry key regardless of
/// the order in which the underlying analysis discovered the tokens.
fn canonicalize_k_prefix(prefix: &List<List<String>>) -> List<List<String>> {
    let mut result: List<List<String>> = [];
    for let depth_set of prefix {
        result.push(canonical_kind_set(depth_set));
    }
    return result;
}

/// String form of a K-prefix mask for use as a registry key.
/// Depths joined with `;`; tokens within a depth joined with `|`.
/// Empty mask → empty string (no key fragment).
fn canonical_k_prefix_key(prefix: &List<List<String>>) -> String {
    if prefix.is_empty() {
        return "";
    }
    let mut s = String::with_capacity(64);
    let mut first_depth = true;
    for let depth_set of prefix {
        if !first_depth {
            s.push_str(&";");
        }
        first_depth = false;
        s.push_str(&join_pipe(depth_set));
    }
    return s;
}

/// Append-and-dedup union of two token-kind arrays, preserving the
/// order of `a` then appending new entries from `b`. Canonical
/// implementation for every union-of-FIRST/FOLLOW sets in lower and
/// emit; the grammar sets that pass through here are bounded by the
/// rule's first/follow size (small in practice), so the linear
/// `List::contains` is fine.
pub fn union_kind_arrays(a: &List<String>, b: &List<String>) -> List<String> {
    let mut result: List<String> = [];
    for let tk of a {
        result.push(*tk);
    }
    for let tk of b {
        if !result.contains(tk) {
            result.push(*tk);
        }
    }
    return result;
}

fn remove_from_visiting(visiting: &mut List<String>, name: &String) {
    let mut new_arr: List<String> = [];
    for let v of visiting {
        if *v != *name {
            new_arr.push(*v);
        }
    }
    *visiting = new_arr;
}
