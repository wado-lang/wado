//! ATN (Augmented Transition Network) model and builder.
//!
//! This is the codegen-side representation of the grammar as an NFA, the
//! foundation of the hybrid runtime ATN simulator (see the "ATN-class
//! grammars" section of `TODO.md`). The simulator runs only at the cold
//! decisions that need it — today, non-greedy `??` (each one keyed to its own
//! decision number via `assign_atn_decisions` -> `Atn.decision_sites`) and an
//! ATN-class LR rule's loop entry; the static fast path handles everything
//! else. The ATN is the data it walks.
//!
//! Clean-room: the construction here follows the textbook Thompson-style
//! NFA-for-a-grammar (rule-start/stop states, alternation block-start
//! decision states, EBNF loop states). It does NOT read ANTLR4's
//! implementation (License hygiene, `AGENTS.md`).
//!
//! Embedding (decided design): the ATN is serialized to a packed,
//! column-oriented byte blob (`atn_blob_bytes`) that the generated parser
//! decodes once at construction (`runtime/atn.wado::atn_decode`) into SoA
//! arrays — see `atn_blob_bytes`'s doc comment for the wire layout. The
//! blob layout's constants (state kinds, transition kinds) are the single
//! source of truth in `runtime/atn.wado` — that module is embedded verbatim
//! into every parser and so cannot import from here, whereas this
//! compiler-side module freely `use`s it. `atn_test.wado` pins the
//! `atn_blob_bytes` -> `atn_decode` round-trip.

use { Grammar, ParserRule, Alternative, Element, RepeatKind } from "./ir.wado";
use { LoweredGrammar, Rule, LeftRecursiveRule, LrAlt } from "./gir.wado";
use { lower, element_is_self_ref } from "./lower.wado";
use { collect_literal_tokens, token_slot_order, LitToken } from "./lexer_gen.wado";
use { literal_const_name } from "./gen_util.wado";
use {
    ATN_BASIC,
    ATN_RULE_START,
    ATN_RULE_STOP,
    ATN_BLOCK_START,
    ATN_BLOCK_END,
    ATN_STAR_LOOP_ENTRY,
    ATN_STAR_LOOP_BACK,
    ATN_PLUS_LOOP_BACK,
    ATN_LOOP_END,
    ATN_TR_EPSILON,
    ATN_TR_ATOM,
    ATN_TR_NOT_ATOM,
    ATN_TR_WILDCARD,
    ATN_TR_RULE,
    ATN_TR_PRECEDENCE,
} from "./runtime/atn.wado";
use { TreeMap } from "core:collections";

// ATN state kinds and transition kinds are the wire-format protocol shared
// with the decoder; they live in `runtime/atn.wado` (imported above) so there
// is one numbering authority. A state is a
// *decision* iff its `decision` field is >= 0 (the simulator keys on that,
// not on the kind); the kind tells the closure how to traverse (`RuleStop`
// pops a return frame, loop-back states re-enter the decision, etc.).
// Transition `label`/`follow`/`prec` carry kind-specific data:
//  - Epsilon: all -1.
//  - Atom: `label` = token kind.
//  - NotAtom: `label` = the single excluded token kind.
//  - Wildcard: all -1 (matches any one token).
//  - RuleRef: `label` = invoked rule index, `follow` = return state id,
//    `prec` = precedence baked for an LR self-ref (0 otherwise).

pub struct AtnTransition {
    pub kind: i32,
    pub target: i32,
    pub label: i32 = -1,
    pub follow: i32 = -1,
    pub prec: i32 = 0,
}

pub struct AtnState {
    pub kind: i32,
    pub rule: i32 = -1,
    pub decision: i32 = -1,
    pub transitions: List<AtnTransition>,
}

/// A complete grammar ATN. `rule_start[r]` / `rule_stop[r]` index `states`
/// for parser rule `r` (same order as `Grammar.parser_rules`).
/// `decision_state[d]` is the state id of decision number `d`.
pub struct Atn {
    pub states: List<AtnState>,
    pub rule_start: List<i32>,
    pub rule_stop: List<i32>,
    pub decision_state: List<i32>,
    pub num_tokens: i32,
    /// Compile-time correspondence `atn_call_site -> return_state`, indexed
    /// by the surface `RuleRefElement.atn_call_site` id (`-1` for any id not
    /// assigned a `RuleRef` segment). NOT part of the serialized blob — the
    /// runtime never sees this map; codegen (P4.2b) reads it to push the
    /// exact return state around each rule call. Empty when call sites were
    /// not assigned (`assign_atn_call_sites` not run).
    pub call_site_returns: List<i32>,
    /// Compile-time correspondence `atn_decision -> decision number`, indexed
    /// by the surface `RepeatElement.atn_decision` / `GroupElement.atn_decision`
    /// id (`-1` for any id whose node marked no decision, e.g. a single-alt
    /// group). NOT part of the serialized blob — codegen reads it to emit each
    /// `??`'s exact `atn_predict_with_stack(sim, decision, …)` call, retiring
    /// the runtime "unique exit-first BlockStart" search. Empty when decision
    /// sites were not assigned (`assign_atn_decisions` not run).
    pub decision_sites: List<i32>,
}

/// The loop-entry (`STAR_LOOP_ENTRY`) decision number for parser rule
/// `rule`, or -1 if the rule has no LR loop. Codegen uses this to route an
/// ATN-class LR rule's loop-entry through the runtime simulator.
///
/// The dedicated LR loop entry is identified by its **precedence enter
/// edges**, not merely by being a `STAR_LOOP_ENTRY`: an ordinary `*` in the
/// rule's atom (e.g. `ID* 'between' …`) also builds a `STAR_LOOP_ENTRY` for
/// the same rule, earlier in state order, but carries no precedence
/// transitions. Returning that one would feed `atn_lr_loop_decision` the wrong
/// decision (its epsilon edge read as an LR-suffix index).
pub fn lr_loop_entry_decision(atn: &Atn, rule: i32) -> i32 {
    for let mut i = 0; i < atn.states.len(); i += 1 {
        let st = &atn.states[i];
        if st.kind == ATN_STAR_LOOP_ENTRY && st.rule == rule && st.decision >= 0 {
            // Scan this state's transitions for a precedence enter edge — the
            // marker of an LR rule's dedicated loop entry (an ordinary `*`
            // loop has none).
            let mut has_prec = false;
            for let t of &st.transitions {
                if t.kind == ATN_TR_PRECEDENCE {
                    has_prec = true;
                    break;
                }
            }
            if has_prec {
                return st.decision;
            }
        }
    }
    return -1;
}

/// The decision number of parser rule `rule`'s top-level alternation (the
/// `BlockStart` directly off its `RuleStart`), or -1 if the rule body marks
/// no decision (a single-alt rule). Codegen uses this to route an `AtEndConflict`
/// multi-alt `Ambiguous` site through `atn_predict_with_stack`. For an LR rule
/// this is the atom block's decision, not the loop entry (`lr_loop_entry_decision`).
pub fn rule_body_decision(atn: &Atn, rule: i32) -> i32 {
    let start = atn.rule_start[rule];
    if atn.states[start].transitions.is_empty() {
        return -1;
    }
    let body = atn.states[start].transitions[0].target;
    return atn.states[body].decision;
}

/// An empty ATN placeholder. Used by codegen as the `needs_atn == false`
/// default so the `Atn` variable is always initialized without paying for a
/// build the grammar does not need.
pub fn empty_atn() -> Atn {
    return Atn {
        states: [],
        rule_start: [],
        rule_stop: [],
        decision_state: [],
        num_tokens: 0,
        call_site_returns: [],
        decision_sites: [],
    };
}

fn sparse_set(list: &mut List<i32>, idx: i32, val: i32) {
    while list.len() <= idx {
        list.push(-1);
    }
    list[idx] = val;
}

/// Mutable accumulator used during construction.
struct AtnBuilder {
    states: List<AtnState>,
    rule_start: List<i32>,
    rule_stop: List<i32>,
    decision_state: List<i32>,
    kinds: TreeMap<String, i32>,
    num_tokens: i32,
    call_site_returns: List<i32>,
    decision_sites: List<i32>,
}

impl AtnBuilder {
    fn new_state(&mut self, kind: i32, rule: i32) -> i32 {
        let id = self.states.len();
        self.states.push(AtnState { kind, rule, decision: -1, transitions: [] });
        return id;
    }

    /// Record that the surface call site `call_site` returns to ATN state
    /// `return_state`. A `call_site` of -1 (unassigned `RuleRefElement`, e.g. a
    /// unit test that skipped `assign_atn_call_sites`) is ignored.
    fn record_call_site(&mut self, call_site: i32, return_state: i32) {
        if call_site < 0 {
            return;
        }
        sparse_set(&mut self.call_site_returns, call_site, return_state);
    }

    /// Allocate a fresh decision number and bind it to `state`.
    fn mark_decision(&mut self, state: i32) {
        let d = self.decision_state.len();
        self.decision_state.push(state);
        self.states[state].decision = d;
    }

    /// Allocate a fresh decision number for `state` (like `mark_decision`) and
    /// record the surface decision-site `site -> decision` correspondence so
    /// codegen can emit the exact decision number. A `site` of -1 (a node with
    /// no stamped id, e.g. a rule body / LR atom block) only marks the decision.
    fn mark_decision_for_site(&mut self, state: i32, site: i32) {
        let d = self.decision_state.len();
        self.mark_decision(state);
        if site < 0 {
            return;
        }
        sparse_set(&mut self.decision_sites, site, d);
    }

    fn add_eps(&mut self, from: i32, to: i32) {
        self.states[from].transitions.push(AtnTransition { kind: ATN_TR_EPSILON, target: to });
    }

    fn add_trans(&mut self, from: i32, t: AtnTransition) {
        self.states[from].transitions.push(t);
    }

    fn kind_of(&self, name: &String) -> i32 {
        if let Some(k) = self.kinds.get(*name) {
            return k;
        }
        return -1;
    }
}


/// Build the name -> token-kind-id map, driven by the same
/// `lexer_gen::token_slot_order` that numbers the generated `TK_*`
/// constants, so ATN atom labels match them by construction. Returns the
/// map and the total token count. Numeric `type(N)` overrides are not
/// modelled yet (no fixture needs them in the ATN path).
pub fn build_token_kinds(grammar: &Grammar) -> [TreeMap<String, i32>, i32] {
    let mut map = TreeMap::<String, i32>::new();
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    let slots = token_slot_order(&grammar.lexer_rules, &lit_tokens);
    let mut idx = 0;
    for let slot of &slots {
        match *slot {
            Rule(ri) => map[`TK_${grammar.lexer_rules[ri].name}`] = idx,
            Eof => map["TK_EOF"] = idx,
            Error => map["TK_ERROR"] = idx,
            Lit(li) => map[lit_tokens[li].const_name] = idx,
        }
        idx += 1;
    }
    return [map, idx];
}

/// Build the whole-grammar parser ATN, lowering the grammar on demand. This
/// is the convenience entry for unit tests and tooling; production codegen
/// (`gen_atn_data_global`) calls `build_atn_with` directly to reuse the
/// `LoweredGrammar` it has already computed.
pub fn build_atn(grammar: &Grammar) -> Atn {
    let lowered = lower(grammar, &collect_literal_tokens(&grammar.parser_rules));
    return build_atn_with(grammar, &lowered);
}

/// Build the whole-grammar parser ATN. Non-left-recursive rules are built
/// directly from the surface alternatives; left-recursive rules are built
/// in ANTLR4's rewritten precedence-climbing form
/// (`expr[pr] : (atom alts) ( {prec_i >= pr}? op_i expr[next_i] )*`) so the
/// simulator can walk them without infinite left recursion. The rewrite
/// reuses lowering's existing LR analysis (`LeftRecursiveRule` / `LrAlt`),
/// passed in via `lowered`; `lowered.parser_rules` runs parallel to
/// `grammar.parser_rules` (same source order and count).
pub fn build_atn_with(grammar: &Grammar, lowered: &LoweredGrammar) -> Atn {
    let tk = build_token_kinds(grammar);
    let mut b = AtnBuilder {
        states: [],
        rule_start: [],
        rule_stop: [],
        decision_state: [],
        kinds: tk.0,
        num_tokens: tk.1,
        call_site_returns: [],
        decision_sites: [],
    };

    let nrules = grammar.parser_rules.len();
    assert lowered.parser_rules.len() == nrules, "lowered/surface rule count mismatch";
    // Pre-allocate start/stop states so RuleRef targets resolve regardless
    // of definition order.
    for let mut r = 0; r < nrules; r += 1 {
        let start = b.new_state(ATN_RULE_START, r);
        let stop = b.new_state(ATN_RULE_STOP, r);
        b.rule_start.push(start);
        b.rule_stop.push(stop);
    }

    let mut rule_index = TreeMap::<String, i32>::new();
    for let mut r = 0; r < nrules; r += 1 {
        rule_index[grammar.parser_rules[r].name] = r;
    }

    for let mut r = 0; r < nrules; r += 1 {
        let rule = &grammar.parser_rules[r];
        let body = match &lowered.parser_rules[r] {
            LeftRecursive(lr) => build_lr_body(&mut b, rule, lr, r, &rule_index),
            _ => build_alternation(&mut b, &rule.alternatives, r, &rule_index, -1),
        };
        b.add_eps(b.rule_start[r], body.0);
        b.add_eps(body.1, b.rule_stop[r]);
    }

    return Atn {
        states: b.states,
        rule_start: b.rule_start,
        rule_stop: b.rule_stop,
        decision_state: b.decision_state,
        num_tokens: b.num_tokens,
        call_site_returns: b.call_site_returns,
        decision_sites: b.decision_sites,
    };
}

/// Build a left-recursive rule in ANTLR4's rewritten form and return its
/// `[entry, exit]` pair (the caller wires `rule_start -> entry` and
/// `exit -> rule_stop`). Shape:
///
/// ```text
///   atom-block (BlockStart over the non-LR alts)
///     -> STAR_LOOP_ENTRY (decision)
///          --{prec_i >= pr}?--> suffix_i -> STAR_LOOP_BACK -> entry   (one per LR alt)
///          --epsilon--> LOOP_END                                       (exit, greedy: last)
/// ```
///
/// Greedy loop ordering (enter edges first, exit last) mirrors `build_repeat`
/// Star, so the simulator's min-alt resolution prefers continuing the loop.
/// Each enter edge is a precedence-predicate transition carrying the alt's
/// `own_prec`; the trailing recursive operand (`expr[next_i]`) carries the
/// alt's `conflict_min` as its `RuleRef` precedence floor. The predicate is
/// evaluated in P4.3; here it is structural.
fn build_lr_body(
    b: &mut AtnBuilder,
    rule: &ParserRule,
    lr: &LeftRecursiveRule,
    r: i32,
    rule_index: &TreeMap<String, i32>,
) -> [i32, i32] {
    // Atom block: the non-LR alternatives, in source order. LR alts are
    // identified by their `alt_index`; everything else is an atom.
    let mut is_lr_alt: List<bool> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        is_lr_alt.push(false);
    }
    for let a of &lr.lr_alts {
        is_lr_alt[a.alt_index] = true;
    }
    let mut atom_alts: List<Alternative> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if !is_lr_alt[i] {
            atom_alts.push(rule.alternatives[i]);
        }
    }
    let atom_seg = build_alternation(b, &atom_alts, r, rule_index, -1);

    let entry = b.new_state(ATN_STAR_LOOP_ENTRY, r);
    let loop_end = b.new_state(ATN_LOOP_END, r);
    let back = b.new_state(ATN_STAR_LOOP_BACK, r);
    b.mark_decision(entry);

    // Union of every LR alt's suffix-first operator tokens — drives the
    // follow-aware precedence of nested self-refs in `build_lr_suffix`.
    let mut lr_first: List<String> = [];
    for let a of &lr.lr_alts {
        for let tk of &a.suffix_first {
            if !lr_first.contains(tk) {
                lr_first.push(*tk);
            }
        }
    }

    // One precedence-guarded enter edge per LR alt with a real suffix
    // (degenerate `expr : expr` skipped). `atn_lr_loop_decision` returns an
    // index over this list, and an ATN-class rule's `valid_lr_alts` is built
    // over the same set, so the index lines up with the dispatch branches and
    // `scan_X_lr_N` helpers. A `.`/`~X` operator is admitted by
    // `atn_first_admits`, so the loop entry stays well defined.
    for let a of &lr.lr_alts {
        let alt = &rule.alternatives[a.alt_index];
        if alt.elements.len() <= 1 {
            continue;
        }
        let suffix_seg = build_lr_suffix(b, alt, a, &rule.name, &lr_first, r, rule_index);
        b.add_trans(entry, AtnTransition { kind: ATN_TR_PRECEDENCE, target: suffix_seg.0, prec: a.own_prec });
        b.add_eps(suffix_seg.1, back);
    }
    b.add_eps(entry, loop_end);
    b.add_eps(back, entry);
    b.add_eps(atom_seg.1, entry);
    return [atom_seg.0, loop_end];
}

/// Build the suffix of one LR alt (`alt.elements[1..]`, the leading self-ref
/// stripped) as a sequence, returning `[entry, exit]`. Each element's self-ref
/// precedence is decided by `build_lr_suffix_element` from its own follow.
fn build_lr_suffix(
    b: &mut AtnBuilder,
    alt: &Alternative,
    lr_alt: &LrAlt,
    rule_name: &String,
    lr_first: &List<String>,
    r: i32,
    rule_index: &TreeMap<String, i32>,
) -> [i32, i32] {
    let entry = b.new_state(ATN_BASIC, r);
    let mut cursor = entry;
    for let mut i = 1; i < alt.elements.len(); i += 1 {
        // Whether an LR operator can follow this element in the rest of the
        // suffix. The LR loop can re-enter on an operator after the suffix,
        // so the suffix tail conservatively carries one (`tail_has = true`).
        let follow_has = elements_seq_first_has_lr(&alt.elements, i + 1, lr_first, true);
        let seg = build_lr_suffix_element(
            b,
            &alt.elements[i],
            rule_name,
            lr_first,
            lr_alt.conflict_min,
            follow_has,
            r,
            rule_index,
        );
        b.add_eps(cursor, seg.0);
        cursor = seg.1;
    }
    return [entry, cursor];
}

/// Build one LR-suffix element. A self-ref carries a precedence floor
/// (`conflict_min` when an LR operator can follow — `follow_has` — else 0, a
/// primary reference like a bracketed call arg); a nested self-ref recurses
/// through its container so each occurrence is decided from its own follow.
/// Mirrors the static path's `stamp_lr_self_ref_min_prec`, so the ATN models
/// the same language the parser does. Non-self-ref elements build generically.
fn build_lr_suffix_element(
    b: &mut AtnBuilder,
    elem: &Element,
    rule_name: &String,
    lr_first: &List<String>,
    conflict_min: i32,
    follow_has: bool,
    r: i32,
    rule_index: &TreeMap<String, i32>,
) -> [i32, i32] {
    if element_is_self_ref(elem, rule_name) {
        let prec = if follow_has { conflict_min } else { 0 };
        return self_ref_segment(b, r, prec, self_ref_call_site(elem));
    }
    if !element_contains_self_ref(elem, rule_name) {
        return build_element(b, elem, r, rule_index);
    }
    return match *elem {
        Label(lab) => build_lr_suffix_element(
            b,
            &lab.element,
            rule_name,
            lr_first,
            conflict_min,
            follow_has,
            r,
            rule_index,
        ),
        Group(g) => build_alternation_prec(
            b,
            &g.alternatives,
            rule_name,
            lr_first,
            conflict_min,
            follow_has,
            r,
            rule_index,
            g.atn_decision,
        ),
        Repeat(rep) => {
            // For `*` / `+` the body can be followed by another iteration
            // (its own FIRST) or by the Repeat's follow; `?` never re-iterates.
            let iter_has = match rep.kind {
                RepeatKind::Optional => follow_has,
                RepeatKind::Star => element_first_has_lr(&rep.element, lr_first) || follow_has,
                RepeatKind::Plus => element_first_has_lr(&rep.element, lr_first) || follow_has,
            };
            build_repeat_prec(
                b,
                rep.kind,
                rep.non_greedy,
                &rep.element,
                rule_name,
                lr_first,
                conflict_min,
                iter_has,
                r,
                rule_index,
                rep.atn_decision,
            );
        },
        // A self-ref nested under `Not` is not a rule operand; build generically.
        _ => build_element(b, elem, r, rule_index),
    };
}

/// Follow-aware mirror of `build_alternation` for an LR suffix subrule.
fn build_alternation_prec(
    b: &mut AtnBuilder,
    alts: &List<Alternative>,
    rule_name: &String,
    lr_first: &List<String>,
    conflict_min: i32,
    follow_has: bool,
    r: i32,
    rule_index: &TreeMap<String, i32>,
    site: i32,
) -> [i32, i32] {
    let start = b.new_state(ATN_BLOCK_START, r);
    let end = b.new_state(ATN_BLOCK_END, r);
    if alts.len() > 1 {
        b.mark_decision_for_site(start, site);
    }
    for let alt of alts {
        let seg = build_sequence_prec(b, &alt.elements, rule_name, lr_first, conflict_min, follow_has, r, rule_index);
        b.add_eps(start, seg.0);
        b.add_eps(seg.1, end);
    }
    if alts.is_empty() {
        b.add_eps(start, end);
    }
    return [start, end];
}

/// Follow-aware mirror of `build_sequence`: each element's follow within the
/// sequence (and `seq_tail_has` past it) decides its self-refs' precedence.
fn build_sequence_prec(
    b: &mut AtnBuilder,
    elements: &List<Element>,
    rule_name: &String,
    lr_first: &List<String>,
    conflict_min: i32,
    seq_tail_has: bool,
    r: i32,
    rule_index: &TreeMap<String, i32>,
) -> [i32, i32] {
    let entry = b.new_state(ATN_BASIC, r);
    let mut cursor = entry;
    for let mut j = 0; j < elements.len(); j += 1 {
        let follow_has = elements_seq_first_has_lr(elements, j + 1, lr_first, seq_tail_has);
        let seg = build_lr_suffix_element(b, &elements[j], rule_name, lr_first, conflict_min, follow_has, r, rule_index);
        b.add_eps(cursor, seg.0);
        cursor = seg.1;
    }
    return [entry, cursor];
}

/// Follow-aware mirror of `build_repeat`: identical state/edge shape, but the
/// inner element builds via `build_lr_suffix_element` with the iteration
/// follow `iter_has` (the caller folds in the body's re-entry FIRST).
fn build_repeat_prec(
    b: &mut AtnBuilder,
    kind: RepeatKind,
    non_greedy: bool,
    inner: &Element,
    rule_name: &String,
    lr_first: &List<String>,
    conflict_min: i32,
    iter_has: bool,
    r: i32,
    rule_index: &TreeMap<String, i32>,
    site: i32,
) -> [i32, i32] {
    return match kind {
        Optional => {
            let start = b.new_state(ATN_BLOCK_START, r);
            let end = b.new_state(ATN_BLOCK_END, r);
            b.mark_decision_for_site(start, site);
            let seg = build_lr_suffix_element(b, inner, rule_name, lr_first, conflict_min, iter_has, r, rule_index);
            if non_greedy {
                b.add_eps(start, end);
                b.add_eps(start, seg.0);
            } else {
                b.add_eps(start, seg.0);
                b.add_eps(start, end);
            }
            b.add_eps(seg.1, end);
            [start, end];
        },
        Star => {
            let entry = b.new_state(ATN_STAR_LOOP_ENTRY, r);
            let end = b.new_state(ATN_LOOP_END, r);
            b.mark_decision_for_site(entry, site);
            let seg = build_lr_suffix_element(b, inner, rule_name, lr_first, conflict_min, iter_has, r, rule_index);
            let back = b.new_state(ATN_STAR_LOOP_BACK, r);
            if non_greedy {
                b.add_eps(entry, end);
                b.add_eps(entry, seg.0);
            } else {
                b.add_eps(entry, seg.0);
                b.add_eps(entry, end);
            }
            b.add_eps(seg.1, back);
            b.add_eps(back, entry);
            [entry, end];
        },
        Plus => {
            let seg = build_lr_suffix_element(b, inner, rule_name, lr_first, conflict_min, iter_has, r, rule_index);
            let back = b.new_state(ATN_PLUS_LOOP_BACK, r);
            let end = b.new_state(ATN_LOOP_END, r);
            b.mark_decision_for_site(back, site);
            b.add_eps(seg.1, back);
            if non_greedy {
                b.add_eps(back, end);
                b.add_eps(back, seg.0);
            } else {
                b.add_eps(back, seg.0);
                b.add_eps(back, end);
            }
            [seg.0, end];
        },
    };
}

/// True iff FIRST(`elem`) can contain a token in `lr_first`. Opaque elements
/// (RuleRef / Wildcard / Not) return true conservatively so a nested self-ref
/// is never wrongly dropped to prec 0 when an operator might follow.
fn element_first_has_lr(elem: &Element, lr_first: &List<String>) -> bool {
    return match *elem {
        TokenRef(t) => lr_first.contains(&`TK_${t.name}`),
        Literal(l) => lr_first.contains(&literal_const_name(&l.text)),
        RuleRef(_) => true,
        Wildcard(_) => true,
        Not(_) => true,
        Repeat(rep) => element_first_has_lr(&rep.element, lr_first),
        Group(g) => {
            for let alt of &g.alternatives {
                if elements_seq_first_has_lr(&alt.elements, 0, lr_first, false) {
                    return true;
                }
            }
            false;
        },
        Label(lab) => element_first_has_lr(&lab.element, lr_first),
    };
}

/// True iff `elem` can match the empty string.
fn element_nullable(elem: &Element) -> bool {
    return match *elem {
        TokenRef(_) => false,
        Literal(_) => false,
        RuleRef(_) => false,
        Wildcard(_) => false,
        Not(_) => false,
        Repeat(rep) => match rep.kind {
            RepeatKind::Star => true,
            RepeatKind::Optional => true,
            RepeatKind::Plus => element_nullable(&rep.element),
        },
        Group(g) => {
            for let alt of &g.alternatives {
                if elements_all_nullable(&alt.elements) {
                    return true;
                }
            }
            false;
        },
        Label(lab) => element_nullable(&lab.element),
    };
}

fn elements_all_nullable(elements: &List<Element>) -> bool {
    for let elem of elements {
        if !element_nullable(elem) {
            return false;
        }
    }
    return true;
}

/// True iff the content of `elements[idx..]`, followed by `tail_has`, can
/// begin with a token in `lr_first` — the FOLLOW-has-LR-operator test for the
/// position just before `elements[idx]`.
fn elements_seq_first_has_lr(elements: &List<Element>, idx: i32, lr_first: &List<String>, tail_has: bool) -> bool {
    if idx >= elements.len() {
        return tail_has;
    }
    if element_first_has_lr(&elements[idx], lr_first) {
        return true;
    }
    if element_nullable(&elements[idx]) {
        return elements_seq_first_has_lr(elements, idx + 1, lr_first, tail_has);
    }
    return false;
}

/// True iff `elem` contains a self-reference to `rule_name` anywhere —
/// including nested inside a Group / Repeat / Not / Label. Used to detect
/// a nested self-ref in an LR suffix (the top-level case is
/// `element_is_self_ref`).
fn element_contains_self_ref(elem: &Element, rule_name: &String) -> bool {
    return match *elem {
        RuleRef(rr) => rr.name == *rule_name,
        Label(lab) => element_contains_self_ref(&lab.element, rule_name),
        Repeat(rep) => element_contains_self_ref(&rep.element, rule_name),
        Not(n) => element_contains_self_ref(&n.element, rule_name),
        Group(g) => {
            for let alt of &g.alternatives {
                for let inner of &alt.elements {
                    if element_contains_self_ref(inner, rule_name) {
                        return true;
                    }
                }
            }
            false;
        },
        _ => false,
    };
}

/// The `atn_call_site` id of a self-ref element (unwrapping labels), or -1.
fn self_ref_call_site(elem: &Element) -> i32 {
    return match *elem {
        RuleRef(rr) => rr.atn_call_site,
        Label(lab) => self_ref_call_site(&lab.element),
        _ => -1,
    };
}

/// A recursive self-ref `RuleRef` segment carrying `prec` (the raised
/// precedence floor for `expr[next_i]`). A self-ref always targets the
/// current rule, so the target is `rule_start[r]` directly.
fn self_ref_segment(b: &mut AtnBuilder, r: i32, prec: i32, call_site: i32) -> [i32, i32] {
    let from = b.new_state(ATN_BASIC, r);
    let to = b.new_state(ATN_BASIC, r);
    b.add_trans(from, AtnTransition { kind: ATN_TR_RULE, target: b.rule_start[r], label: r, follow: to, prec });
    b.record_call_site(call_site, to);
    return [from, to];
}

/// Build an alternation (rule body or a parenthesised group) and return
/// its `[entry, exit]` state pair. The entry is a `BlockStart`, marked as
/// a decision iff there is more than one alternative. Alternatives are
/// wired in source order so the simulator's min-alt conflict resolution
/// matches ANTLR4.
fn build_alternation(
    b: &mut AtnBuilder,
    alts: &List<Alternative>,
    rule: i32,
    rule_index: &TreeMap<String, i32>,
    site: i32,
) -> [i32, i32] {
    let start = b.new_state(ATN_BLOCK_START, rule);
    let end = b.new_state(ATN_BLOCK_END, rule);
    if alts.len() > 1 {
        b.mark_decision_for_site(start, site);
    }
    for let alt of alts {
        let seg = build_sequence(b, &alt.elements, rule, rule_index);
        b.add_eps(start, seg.0);
        b.add_eps(seg.1, end);
    }
    if alts.is_empty() {
        // Empty alternation (vacuously nullable) — connect directly.
        b.add_eps(start, end);
    }
    return [start, end];
}

/// Build a sequence of elements, threading each element's exit into the
/// next element's entry. Returns `[entry, exit]`.
fn build_sequence(
    b: &mut AtnBuilder,
    elements: &List<Element>,
    rule: i32,
    rule_index: &TreeMap<String, i32>,
) -> [i32, i32] {
    let entry = b.new_state(ATN_BASIC, rule);
    let mut cursor = entry;
    for let elem of elements {
        let seg = build_element(b, elem, rule, rule_index);
        b.add_eps(cursor, seg.0);
        cursor = seg.1;
    }
    return [entry, cursor];
}

/// Build a single element, returning its `[entry, exit]` state pair.
fn build_element(b: &mut AtnBuilder, elem: &Element, rule: i32, rule_index: &TreeMap<String, i32>) -> [i32, i32] {
    return match *elem {
        TokenRef(t) => atom_segment(b, b.kind_of(&`TK_${t.name}`), rule),
        Literal(l) => atom_segment(b, b.kind_of(&literal_const_name(&l.text)), rule),
        Wildcard(_) => {
            let from = b.new_state(ATN_BASIC, rule);
            let to = b.new_state(ATN_BASIC, rule);
            b.add_trans(from, AtnTransition { kind: ATN_TR_WILDCARD, target: to });
            [from, to];
        },
        RuleRef(rr) => {
            let from = b.new_state(ATN_BASIC, rule);
            let to = b.new_state(ATN_BASIC, rule);
            let ri = if let Some(idx) = rule_index.get(rr.name) {
                idx;
            } else {
                -1;
            };
            // `target` jumps to the invoked rule's start state; `label`
            // keeps the rule index for dump/debug; `follow` is the return.
            let tstart = if ri >= 0 { b.rule_start[ri] } else { -1 };
            b.add_trans(from, AtnTransition { kind: ATN_TR_RULE, target: tstart, label: ri, follow: to });
            b.record_call_site(rr.atn_call_site, to);
            [from, to];
        },
        Group(g) => build_alternation(b, &g.alternatives, rule, rule_index, g.atn_decision),
        Label(lab) => build_element(b, &lab.element, rule, rule_index),
        Not(n) => not_segment(b, &n.element, rule),
        Repeat(rep) => build_repeat(b, rep.kind, rep.non_greedy, &rep.element, rule, rule_index, rep.atn_decision),
    };
}

/// `entry --Atom(kind)--> exit`. A `kind` of -1 (unresolved token) still
/// produces a transition so the ATN stays structurally complete; the
/// simulator simply never matches it.
fn atom_segment(b: &mut AtnBuilder, kind: i32, rule: i32) -> [i32, i32] {
    let from = b.new_state(ATN_BASIC, rule);
    let to = b.new_state(ATN_BASIC, rule);
    b.add_trans(from, AtnTransition { kind: ATN_TR_ATOM, target: to, label: kind });
    return [from, to];
}

/// `~X`. Single-token inner becomes a `NotAtom`; anything richer falls
/// back to a wildcard (conservative — matches the broadest set). Parser
/// `~(...)` over multi-token sets is rare and tracked for later.
fn not_segment(b: &mut AtnBuilder, inner: &Element, rule: i32) -> [i32, i32] {
    let from = b.new_state(ATN_BASIC, rule);
    let to = b.new_state(ATN_BASIC, rule);
    let label = match *inner {
        TokenRef(t) => b.kind_of(&`TK_${t.name}`),
        Literal(l) => b.kind_of(&literal_const_name(&l.text)),
        _ => -1,
    };
    if label >= 0 {
        b.add_trans(from, AtnTransition { kind: ATN_TR_NOT_ATOM, target: to, label });
    } else {
        b.add_trans(from, AtnTransition { kind: ATN_TR_WILDCARD, target: to });
    }
    return [from, to];
}

/// Build an EBNF repeat. Greedy vs non-greedy is encoded purely by the
/// ORDER of the decision state's epsilon transitions: the simulator's
/// min-alt resolution prefers the earlier edge, so greedy puts
/// enter/loop first and non-greedy puts exit first. This is what makes
/// `(else stmt)??` bind the `else` to the outer rule.
fn build_repeat(
    b: &mut AtnBuilder,
    kind: RepeatKind,
    non_greedy: bool,
    inner: &Element,
    rule: i32,
    rule_index: &TreeMap<String, i32>,
    site: i32,
) -> [i32, i32] {
    return match kind {
        Optional => {
            let start = b.new_state(ATN_BLOCK_START, rule);
            let end = b.new_state(ATN_BLOCK_END, rule);
            b.mark_decision_for_site(start, site);
            let seg = build_element(b, inner, rule, rule_index);
            if non_greedy {
                b.add_eps(start, end);
                b.add_eps(start, seg.0);
            } else {
                b.add_eps(start, seg.0);
                b.add_eps(start, end);
            }
            b.add_eps(seg.1, end);
            [start, end];
        },
        Star => {
            let entry = b.new_state(ATN_STAR_LOOP_ENTRY, rule);
            let end = b.new_state(ATN_LOOP_END, rule);
            b.mark_decision_for_site(entry, site);
            let seg = build_element(b, inner, rule, rule_index);
            let back = b.new_state(ATN_STAR_LOOP_BACK, rule);
            if non_greedy {
                b.add_eps(entry, end);
                b.add_eps(entry, seg.0);
            } else {
                b.add_eps(entry, seg.0);
                b.add_eps(entry, end);
            }
            b.add_eps(seg.1, back);
            b.add_eps(back, entry);
            [entry, end];
        },
        Plus => {
            let seg = build_element(b, inner, rule, rule_index);
            let back = b.new_state(ATN_PLUS_LOOP_BACK, rule);
            let end = b.new_state(ATN_LOOP_END, rule);
            b.mark_decision_for_site(back, site);
            b.add_eps(seg.1, back);
            if non_greedy {
                b.add_eps(back, end);
                b.add_eps(back, seg.0);
            } else {
                b.add_eps(back, seg.0);
                b.add_eps(back, end);
            }
            [seg.0, end];
        },
    };
}

/// Asserts `v` fits `u8` (0..=255) so an overflow fails loudly at generation
/// time instead of truncating silently. Only the tiny state/transition kind
/// enums use this width.
fn push_u8(bytes: &mut ByteList, v: i32) {
    assert 0 <= v <= 255, `ATN blob: value ${v} exceeds u8 range`;
    bytes.push(v as u8);
}

/// Little-endian; same overflow assert as `push_u8`, widened to `u16`
/// (0..=65535). Every count and state/rule/token index uses this width.
fn push_u16(bytes: &mut ByteList, v: i32) {
    assert 0 <= v <= 65535, `ATN blob: value ${v} exceeds u16 range`;
    bytes.push((v & 0xff) as u8);
    bytes.push((v >> 8 & 0xff) as u8);
}

/// Little-endian; same as `push_u16` widened to `u24` (0..=16777215).
/// `label`/`follow` need this width, not `u16`: the *parser* ATN uses `label`
/// as a small token-kind index, but the *lexer* ATN (`latn.wado`) reuses the
/// same fields for a Unicode scalar range (`label` = low, `follow` = high,
/// up to `CHAR_MAX` = `0x10FFFF`) — one shared decoder, so the field must
/// fit its widest use.
fn push_u24(bytes: &mut ByteList, v: i32) {
    assert 0 <= v <= 16777215, `ATN blob: value ${v} exceeds u24 range`;
    bytes.push((v & 0xff) as u8);
    bytes.push((v >> 8 & 0xff) as u8);
    bytes.push((v >> 16 & 0xff) as u8);
}

/// Biases `target` by +1 so the sentinel -1 (unset) survives the unsigned
/// `u16` encoding; `atn_decode` reverses it with an unconditional `- 1`, no
/// branch needed. Only the lower bound is asserted — `push_u16` itself
/// catches `v + 1` overflowing `u16`.
fn push_u16_biased(bytes: &mut ByteList, v: i32) {
    assert v >= -1, `ATN blob: biased value ${v} below sentinel -1`;
    push_u16(bytes, v + 1);
}

/// `label`/`follow` counterpart to `push_u16_biased`; `push_u24` catches
/// `v + 1` overflow.
fn push_u24_biased(bytes: &mut ByteList, v: i32) {
    assert v >= -1, `ATN blob: biased value ${v} below sentinel -1`;
    push_u24(bytes, v + 1);
}

/// Serialize the ATN into the packed, column-oriented (SoA) byte blob the
/// generated parser embeds as a `b"..."` byte-string literal and
/// `atn_decode` reads back. Layout (all fields little-endian, listed in
/// wire order):
///
/// ```text
/// nrules: u16, ndec: u16, nstates: u16,
/// rule_start[nrules]: u16,
/// decision_state[ndec]: u16,
/// state_kind[nstates]: u8,
/// state_tr_count[nstates]: u16,
/// tr_kind[ntrans_total]: u8,
/// tr_target[ntrans_total]: u16 (+1 bias),
/// tr_label[ntrans_total]: u24 (+1 bias),
/// tr_follow[ntrans_total]: u24 (+1 bias),
/// tr_prec[ntrans_total]: u16,
/// ```
///
/// `ntrans_total` is not stored: it's the sum of `state_tr_count`, which
/// precedes the transition columns, so `atn_decode` derives it (and
/// `state_tr_start`, a running prefix sum) while reading that column.
/// `num_tokens`, per-state `rule`/`decision`, and `rule_stop` aren't in the
/// blob at all — see `AtnSim`'s doc comment in `runtime/atn.wado` for why.
/// One pass over `atn.states` (and each state's `transitions`) fills seven
/// per-column byte accumulators; a final handful of bulk `extend_from_slice`
/// calls assembles them into the wire order above, so no field is walked
/// more than once and no accumulator grows by repeated doubling.
pub fn atn_blob_bytes(atn: &Atn) -> ByteList {
    let nrules = atn.rule_start.len();
    let ndec = atn.decision_state.len();
    let nstates = atn.states.len();
    let mut ntrans_total = 0;
    for let st of &atn.states {
        ntrans_total += st.transitions.len();
    }

    let mut state_kind: ByteList = ByteList::with_capacity(nstates);
    let mut state_tr_count: ByteList = ByteList::with_capacity(nstates * 2);
    let mut tr_kind: ByteList = ByteList::with_capacity(ntrans_total);
    let mut tr_target: ByteList = ByteList::with_capacity(ntrans_total * 2);
    let mut tr_label: ByteList = ByteList::with_capacity(ntrans_total * 3);
    let mut tr_follow: ByteList = ByteList::with_capacity(ntrans_total * 3);
    let mut tr_prec: ByteList = ByteList::with_capacity(ntrans_total * 2);
    for let st of &atn.states {
        push_u8(&mut state_kind, st.kind);
        push_u16(&mut state_tr_count, st.transitions.len());
        for let t of &st.transitions {
            push_u8(&mut tr_kind, t.kind);
            push_u16_biased(&mut tr_target, t.target);
            push_u24_biased(&mut tr_label, t.label);
            push_u24_biased(&mut tr_follow, t.follow);
            push_u16(&mut tr_prec, t.prec);
        }
    }

    let total = 6 + nrules * 2 + ndec * 2 + state_kind.len() + state_tr_count.len() + tr_kind.len() + tr_target.len() + tr_label.len(
    ) + tr_follow.len() + tr_prec.len();
    let mut bytes: ByteList = ByteList::with_capacity(total);
    push_u16(&mut bytes, nrules);
    push_u16(&mut bytes, ndec);
    push_u16(&mut bytes, nstates);
    for let s of &atn.rule_start {
        push_u16(&mut bytes, *s);
    }
    for let d of &atn.decision_state {
        push_u16(&mut bytes, *d);
    }
    bytes.extend_from_slice(state_kind.as_slice());
    bytes.extend_from_slice(state_tr_count.as_slice());
    bytes.extend_from_slice(tr_kind.as_slice());
    bytes.extend_from_slice(tr_target.as_slice());
    bytes.extend_from_slice(tr_label.as_slice());
    bytes.extend_from_slice(tr_follow.as_slice());
    bytes.extend_from_slice(tr_prec.as_slice());
    return bytes;
}

fn state_kind_name(kind: i32) -> String {
    if kind == ATN_BASIC {
        return "Basic";
    }
    if kind == ATN_RULE_START {
        return "RuleStart";
    }
    if kind == ATN_RULE_STOP {
        return "RuleStop";
    }
    if kind == ATN_BLOCK_START {
        return "BlockStart";
    }
    if kind == ATN_BLOCK_END {
        return "BlockEnd";
    }
    if kind == ATN_STAR_LOOP_ENTRY {
        return "StarLoopEntry";
    }
    if kind == ATN_STAR_LOOP_BACK {
        return "StarLoopBack";
    }
    if kind == ATN_PLUS_LOOP_BACK {
        return "PlusLoopBack";
    }
    if kind == ATN_LOOP_END {
        return "LoopEnd";
    }
    return "Invalid";
}

fn trans_kind_name(kind: i32) -> String {
    if kind == ATN_TR_EPSILON {
        return "eps";
    }
    if kind == ATN_TR_ATOM {
        return "atom";
    }
    if kind == ATN_TR_NOT_ATOM {
        return "notatom";
    }
    if kind == ATN_TR_WILDCARD {
        return "wild";
    }
    if kind == ATN_TR_RULE {
        return "rule";
    }
    if kind == ATN_TR_PRECEDENCE {
        return "prec";
    }
    return "?";
}

/// Human-readable dump of the ATN, surfaced by `gale dump --atn`.
pub fn dump_atn(atn: &Atn, grammar: &Grammar) -> String {
    let mut out = String::with_capacity(1024);
    out.push_str(&`ATN: ${atn.states.len()} states, ${atn.decision_state.len()} decisions, ${atn.num_tokens} tokens\n`);
    for let mut r = 0; r < grammar.parser_rules.len(); r += 1 {
        out.push_str(
            &`rule ${r} '${grammar.parser_rules[r].name}': start=s${atn.rule_start[r]} stop=s${atn.rule_stop[r]}\n`,
        );
    }
    for let mut i = 0; i < atn.states.len(); i += 1 {
        let st = &atn.states[i];
        let dec = if st.decision >= 0 { ` decision=${st.decision}` } else { String::from("") };
        out.push_str(&`  s${i} ${state_kind_name(st.kind)} rule=${st.rule}${dec}\n`);
        for let t of &st.transitions {
            let mut detail = String::from("");
            if t.kind == ATN_TR_ATOM || t.kind == ATN_TR_NOT_ATOM {
                detail = ` tk=${t.label}`;
            } else if t.kind == ATN_TR_RULE {
                detail = ` rule=${t.label} follow=s${t.follow} prec=${t.prec}`;
            } else if t.kind == ATN_TR_PRECEDENCE {
                detail = ` prec=${t.prec}`;
            }
            out.push_str(&`    -${trans_kind_name(t.kind)}-> s${t.target}${detail}\n`);
        }
    }
    return out;
}
