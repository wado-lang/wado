//! What lowering reads and what it records. It reads the grammar's analysis,
//! the generation's settings and the rules' FOLLOW; it records the FOLLOW masks
//! its gates name, the diagnostics its decisions raise, and the marks
//! (`LowerMarks`) the parser plan is decided from.

use { Alternative, ParserRule } from "./ir.wado";
use { DiagnosticKind, DiagnosticOwner, Diagnostics, Rule } from "./gir.wado";
use { RuleOverlap, overlap_groups_of, overlap_routes, rule_overlap_groups } from "./rule_overlap.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { AtnMode, GenSettings } from "./gen_settings.wado";
use { RuleFollow } from "./follow_env.wado";
use { TableRegistry } from "./table_registry.wado";
use { PredicateSite, alt_has_gate, alt_scan_gate_conditions } from "./gate_conditions.wado";
use { rule_returns_vals } from "./action_translate.wado";

/// What lowering found out about the parser it lowered, per rule index where
/// a list. The parser plan is decided from these.
pub struct LowerMarks {
    /// Lowering built a tail-greedy `Repeat` that gates on the caller's FOLLOW
    /// continuation. While it stays false the grammar has no caller-FOLLOW
    /// repair at all, so emit skips the entire FOLLOW machinery (the `follow`
    /// parameter, its call-site arguments, and the `FOLLOW_MASK_<id>` globals).
    /// This keeps deep-recursion grammars — which never read `follow` — from
    /// paying an extra stack slot per recursive frame (the
    /// `Performance/ExpressionGrammar_2` stack-exhaustion regression).
    pub caller_follow_gate: bool = false,
    /// An ATN-class LR rule was lowered: `ATN_SIM` carries the LR tables.
    pub needs_lr_atn: bool = false,
    /// The rule runs a caller-FOLLOW gate or a probe, so it reads the slots
    /// itself; the seeds of `follow_rule_snakes`.
    pub rule_reads_follow: List<bool>,
    /// The callees a call in the rule hands its own continuation to. Such a
    /// call spells `follow0…` only where the callee declares the slots, which is
    /// what makes `follow_rule_snakes` a fixpoint rather than a local test.
    pub follow_forward_edges: List<List<String>>,
    /// The rule makes a decision the simulator decides.
    pub rule_asks_simulator: List<bool>,
    /// Under `atn: "verify"`, the simulator checks a pick the static path made.
    pub simulator_checks: bool = false,
    /// The rules whose functions carry the FOLLOW slots, by snake name: the
    /// closure of `rule_reads_follow` over `follow_forward_edges`, settled once
    /// every rule is lowered.
    pub follow_rule_snakes: List<String> = [],
}

impl LowerMarks {
    /// Nothing marked yet, for `rule_count` rules.
    pub fn new(rule_count: i32) -> LowerMarks {
        let flags = List::<bool>::filled(rule_count, false);
        return LowerMarks {
            rule_reads_follow: flags,
            follow_forward_edges: List::filled(rule_count, []),
            rule_asks_simulator: flags,
        };
    }

    /// Record a decision the simulator makes in rule `rule`.
    pub fn mark_asks_simulator(&mut self, rule: i32) {
        self.rule_asks_simulator[rule] = true;
    }

    /// Whether any decision routes to the runtime ATN simulator or is checked
    /// against it.
    pub fn needs_atn(&self) -> bool {
        return self.simulator_checks || self.rule_asks_simulator.contains(&true);
    }
}

/// The context lowering threads through its walk.
pub struct LowerContext {
    pub analysis: GrammarAnalysis,
    pub settings: GenSettings,
    pub follow: RuleFollow,
    pub tables: TableRegistry,
    pub diagnostics: Diagnostics,
    pub marks: LowerMarks,
    /// Index of the rule being lowered, or -1 between rules.
    current_rule_index: i32,
}

impl LowerContext {
    /// Lowering over `analysis`, between rules and with nothing marked.
    pub fn new(
        analysis: GrammarAnalysis,
        settings: GenSettings,
        follow: RuleFollow = RuleFollow::unknown(),
        diagnostics: Diagnostics = Diagnostics {},
    ) -> LowerContext {
        let marks = LowerMarks::new(analysis.parser_rules().len());
        return LowerContext {
            analysis,
            settings,
            follow,
            tables: TableRegistry::new(),
            diagnostics,
            marks,
            current_rule_index: -1,
        };
    }

    /// Make rule `idx` the one being lowered.
    pub fn set_current_rule_index(&mut self, idx: i32) {
        self.current_rule_index = idx;
    }

    /// Whether a rule is being lowered.
    pub fn has_current_rule(&self) -> bool {
        return self.current_rule_index >= 0;
    }

    /// The index of the rule being lowered.
    pub fn current_rule_index(&self) -> i32
        contract self.has_current_rule(), "lowering makes each rule current before walking its body"
    {
        return self.current_rule_index;
    }

    /// The rule being lowered.
    pub fn current_rule(&self) -> &ParserRule {
        return &self.analysis.parser_rules()[self.current_rule_index()];
    }

    /// The name of `current_rule`, which diagnostics raised from inside a rule
    /// use as their structured owner.
    pub fn current_rule_name(&self) -> String {
        return self.current_rule().name;
    }

    /// Record that lowering built a tail-greedy caller-FOLLOW gate.
    pub fn mark_caller_follow_gate(&mut self) {
        self.marks.caller_follow_gate = true;
    }

    /// Record a decision the simulator makes in the rule being lowered, `what`
    /// naming it. Under `atn: "never"` it is the refusal.
    pub fn mark_asks_simulator<S: AsStrSlice>(&mut self, what: S) {
        let idx = self.current_rule_index();
        self.marks.mark_asks_simulator(idx);
        if self.settings.atn matches { Never } {
            self.diagnostics.warn(
                &DiagnosticOwner::rule_dispatch(self.current_rule_name()),
                DiagnosticKind::SimulatorRequired,
                `${what} only the ATN simulator decides, and \`atn: "never"\` refuses it`,
            );
        }
    }

    /// Record a pick the static path makes and the simulator checks, which
    /// routes nothing and so leaves the rule's other decisions as `never` makes
    /// them.
    pub fn mark_checks_with_simulator(&mut self) {
        assert self.settings.atn.verifies(), "only `atn: \"verify\"` checks the static path's picks";
        self.marks.simulator_checks = true;
    }

    /// Record an ATN-class LR rule: its loop decision reads the LR tables.
    pub fn mark_needs_lr_atn<S: AsStrSlice>(&mut self, what: S) {
        self.marks.needs_lr_atn = true;
        self.mark_asks_simulator(what);
    }

    /// Record that the rule being lowered reads the continuation it was called
    /// with directly — a caller-FOLLOW gate or a probe.
    pub fn mark_rule_reads_follow(&mut self) {
        let idx = self.current_rule_index();
        self.marks.rule_reads_follow[idx] = true;
    }

    /// Record that the rule being lowered hands its own continuation to
    /// `target`, so it reads the slots exactly when `target` declares them.
    pub fn mark_rule_forwards_follow<S: AsStrSlice>(&mut self, target: S) {
        let idx = self.current_rule_index();
        if !self.marks.follow_forward_edges[idx].contains_str(target) {
            self.marks.follow_forward_edges[idx].push(target.to_string());
        }
    }

    /// Intern a runtime FOLLOW-continuation mask of kind ids per depth. The
    /// same canonical mask maps to a single `id`; `null` for one no depth
    /// constrains, where the caller passes `&EMPTY_FOLLOW`.
    pub fn intern_follow_mask(&mut self, mask: &List<List<i32>>) -> Option<i32> {
        let mut depths: List<List<i32>> = [];
        for let depth of mask {
            depths.push(self.analysis.canonical_ids(*depth));
        }
        return self.tables.intern_follow_mask(depths);
    }

    /// Where an alternative of the rule being lowered renders its predicates.
    /// No value struct or binding exists yet, so the rule's own declarations
    /// are all that can be in scope.
    fn predicate_site(&self) -> PredicateSite {
        let idx = self.current_rule_index();
        return PredicateSite {
            rule_index: idx,
            vals_in_scope: self.settings.emit_actions && rule_returns_vals(&self.analysis.parser_rules()[idx]),
        };
    }

    /// `gate_conditions::alt_has_gate` for an alternative of the rule being lowered.
    pub fn alt_has_gate(&self, alt: &Alternative) -> bool {
        return alt_has_gate(alt, &self.settings, &self.analysis, &self.predicate_site());
    }

    /// `gate_conditions::alt_scan_gate_conditions` for an alternative of the
    /// rule being lowered.
    pub fn alt_scan_gate_conditions(&self, alt: &Alternative) -> String {
        return alt_scan_gate_conditions(alt, &self.settings, &self.analysis, &self.predicate_site());
    }

    /// `rule_overlap::rule_overlap_groups` for the rule being lowered.
    pub fn rule_overlap(&mut self, rule: &ParserRule, lowered_rule: &Rule) -> RuleOverlap {
        let has_gate = |alt: &Alternative| self.alt_has_gate(alt);
        return rule_overlap_groups(rule, lowered_rule, &mut self.analysis, &self.follow, has_gate);
    }

    /// Whether the choice among the alternatives `alt_indices` of the rule
    /// being lowered reaches a decision the simulator makes. `multi_alt` is
    /// as for `rule_overlap::overlap_groups_of`. Under `atn: "verify"` it never
    /// does: the tournament makes it, and the simulator checks what `auto`
    /// would hand it.
    pub fn choice_routes(&mut self, rule: &ParserRule, alt_indices: List<i32>, multi_alt: bool) -> bool {
        let has_gate = |alt: &Alternative| self.alt_has_gate(alt);
        let overlap = overlap_groups_of(rule, alt_indices, multi_alt, &mut self.analysis, &self.follow, has_gate);
        if !self.settings.atn.verifies() {
            return overlap_routes(rule, &overlap, &mut self.analysis, &self.follow, self.settings.atn);
        }
        if overlap_routes(rule, &overlap, &mut self.analysis, &self.follow, AtnMode::Auto) {
            self.mark_checks_with_simulator();
        }
        return false;
    }
}
