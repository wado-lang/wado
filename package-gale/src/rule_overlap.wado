//! How a rule's non-LR alternatives group, and whether a group ends in a
//! conflict only the simulator decides. Lowering reads it to mark the rules
//! that ask the simulator and to decide each rule's choice.

use { Alternative, ParserRule } from "./ir.wado";
use { AltClass } from "./gir.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { RuleFollow } from "./follow_env.wado";
use { alt_classes, compute_overlap_groups_of } from "./alt_grouping.wado";
use { PredictionNode, build_group_prediction_tree } from "./prediction.wado";
use { dedup_append_arr } from "./list_util.wado";
use { rule_is_left_recursive } from "./lr_util.wado";

/// How a rule's non-LR alternatives group: the one answer the at-end conflict
/// detection and the rule's decision both read, so neither can drift.
pub struct RuleOverlap {
    pub non_lr_indices: List<i32>,
    pub first_sets: List<List<i32>>,
    pub groups: List<List<i32>>,
    /// The rule's exact FOLLOW, or empty where it is unknown, where an ended
    /// atom runs on into an LR suffix, or where a gate selects instead.
    pub end_follow: List<i32>,
}

/// How `rule`'s alternatives `non_lr_indices` group by what they start with.
/// `meets_gate` answers for the rule: prediction is predicate-blind, so a rule
/// whose alternative meets a predicate decides without its FOLLOW, in the
/// tournament or the simulator that weighs it. Only a rule that is
/// `multi_alt`, ending with the alternative, reads its FOLLOW: an LR atom runs
/// on into the suffix loop.
pub fn overlap_groups_of(
    rule: &ParserRule,
    non_lr_indices: List<i32>,
    multi_alt: bool,
    analysis: &mut GrammarAnalysis,
    follow: &RuleFollow,
    meets_gate: fn(&Alternative) -> bool,
) -> RuleOverlap {
    let mut first_sets: List<List<i32>> = [];
    for let idx of non_lr_indices {
        let mut visiting: List<String> = [];
        first_sets.push(analysis.first_of_alt(&rule.alternatives[idx], &mut visiting));
    }
    let mut classes = alt_classes(
        &non_lr_indices,
        &rule.alternatives,
        rule_is_left_recursive(rule),
        &first_sets,
        analysis,
    );
    let gated = non_lr_indices.iter_ref().any(|i| meets_gate(&rule.alternatives[*i]));
    let end_follow: List<i32> = if multi_alt && !gated { follow.exact_kinds(&rule.name) } else { [] };
    admit_rule_follow_into_nullable(&mut classes, &mut first_sets, &end_follow);
    let groups = compute_overlap_groups_of(&classes);
    return RuleOverlap { non_lr_indices, first_sets, groups, end_follow };
}

/// What follows the rule selects its nullable alternatives too, so one whose
/// FOLLOW meets a sibling's first set shares its group: `r : A? | B ;` on `b`.
fn admit_rule_follow_into_nullable(classes: &mut List<AltClass>, first_sets: &mut List<List<i32>>, follow: &List<i32>) {
    if follow.is_empty() {
        return;
    }
    for let mut i = 0; i < classes.len(); i += 1 {
        if let Nullable(tokens) = classes[i] {
            let mut admitted = tokens;
            dedup_append_arr(&mut admitted, follow);
            first_sets[i] = admitted;
            classes[i] = AltClass::Selects(admitted);
        }
    }
}

fn reaches_ambiguity(node: &PredictionNode) -> bool {
    return match node {
        Ambiguous(_) => true,
        Consume(c) => reaches_ambiguity(&c.child),
        Dispatch(d) => d.branches.iter_ref().any(|b| reaches_ambiguity(&b.child)),
        Leaf(_) => false,
    };
}

/// Whether a rule's prediction among its overlap groups `g` reaches an
/// ambiguity, which only the simulator decides as ANTLR4 does.
pub fn overlap_ambiguous(rule: &ParserRule, g: &RuleOverlap, analysis: &mut GrammarAnalysis) -> bool {
    for let group of &g.groups {
        if group.len() > 1 {
            let tree = build_group_prediction_tree(
                &rule.alternatives,
                group,
                &g.first_sets,
                &g.non_lr_indices,
                analysis,
                &g.end_follow,
            );
            if reaches_ambiguity(&tree) {
                return true;
            }
        }
    }
    return false;
}
