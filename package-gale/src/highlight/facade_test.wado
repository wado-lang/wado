//! `run_cli`, the batch highlighter every grammar's CLI shares: what it writes
//! where, and what it reports when an input or an output fails. The renderer is
//! a stand-in, since the facade never looks inside what it returns.

use { run_cli } from "./facade.wado";
use { Console } from "../../tests/support/console.wado";
use { scratch } from "../../tests/support/scratch.wado";
use fs from "core:fs";
use { Preopens } from "core:fs";
use { MonotonicClock } from "wasi:clocks";
use { Log } from "core:log";

global SUITE: String = "gale-facade-test";

fn write_input<S: AsStrSlice>(path: S, text: String) with Preopens {
    fs::create_dir_all(fs::parent(&path).unwrap()).unwrap();
    fs::write(&path, &text).unwrap();
}

fn bold(source: &String) -> String {
    return `<b>${*source}</b>`;
}

/// What `run_cli` printed and logged, rendering with `bold`.
fn highlight_cli(args: List<String>) -> Console with (Preopens, MonotonicClock, Log) {
    let mut console = Console {};
    with &mut console do {
        run_cli(bold, args);
    };
    return console;
}

test "each input is rendered to its own path under the output directory" {
    let dir = scratch(SUITE, "render");
    let first = `${dir}/src/a.txt`;
    let second = `${dir}/src/nested/b.txt`;
    write_input(&first, "one");
    write_input(&second, "two");
    let out = `${dir}/out`;
    let console = highlight_cli(["--output-dir", out, first, second]);
    assert fs::read_to_string(`${out}/${first}.html`).unwrap() == "<b>one</b>";
    assert fs::read_to_string(`${out}/${second}.html`).unwrap() == "<b>two</b>";
    assert console.stderr() == "";
    assert console.events == [];
}

test "an input that cannot be read is logged, and the rest still render" {
    let dir = scratch(SUITE, "missing-input");
    let present = `${dir}/present.txt`;
    write_input(&present, "here");
    let out = `${dir}/out`;
    let console = highlight_cli(["--output-dir", out, `${dir}/absent.txt`, present]);
    assert console.events == ["Error: cannot read input"];
    assert !fs::exists(`${out}/${dir}/absent.txt.html`);
    assert fs::read_to_string(`${out}/${present}.html`).unwrap() == "<b>here</b>";
}

test "an output directory that cannot be created is logged" {
    let dir = scratch(SUITE, "blocked-dir");
    let input = `${dir}/in.txt`;
    write_input(&input, "text");
    let out = `${dir}/out`;
    write_input(&out, "a file where the output directory would go");
    let console = highlight_cli(["--output-dir", out, input]);
    assert console.events == ["Error: cannot create output directory"];
}

test "an output that cannot be written is logged" {
    let dir = scratch(SUITE, "blocked-file");
    let input = `${dir}/in.txt`;
    write_input(&input, "text");
    let out = `${dir}/out`;
    fs::create_dir_all(`${out}/${input}.html`).unwrap();
    let console = highlight_cli(["--output-dir", out, input]);
    assert console.events == ["Error: cannot write output"];
}

test "no input files is an error" {
    let console = highlight_cli(["--output-dir", "out"]);
    assert console.stderr() == "error: no input files given\n";
}

test "arguments that do not parse are reported with the usage" {
    let console = highlight_cli(["in.txt"]);
    assert console.stderr() == "error: missing field: output_dir\nusage: <cmd> --output-dir <dir> <input> ...\n";
}
