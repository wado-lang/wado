//! The scaffolding every generated parser carries whatever the grammar:
//! the `Parser` struct and its recognizer API, the `parse` entries, trace,
//! fragment recovery. Varies over the feature switches and `@members`,
//! never over rules. Sibling of `src/runtime/*.wado`, a builder because
//! the switches select which fields and methods exist.

use { Grammar } from "./ir.wado";
use { DiagnosticKind, DiagnosticOwner, LoweredGrammar, Rule, rule_header } from "./gir.wado";
use { GenContext } from "./gen_context.wado";
use { join_kinds } from "./gen_util.wado";
use { CodeWriter, FnSpec, ImplSpec, StructSpec, Vis } from "./wadopoet.wado";
use { add_parser_super_effect, entry_emits_vals } from "./action_gen.wado";
use { MemberDecls } from "./java2wado/jmembers.wado";

struct RecoverFragmentEntry {
    call: String,
    first_names: List<String>,
}

pub fn compute_fragment_entries(grammar: &Grammar, ctx: &mut GenContext) -> List<RecoverFragmentEntry> {
    let names = *ctx.fragment_entries();
    let mut result: List<RecoverFragmentEntry> = [];
    let mut seen: List<String> = [];
    for let name of &names {
        if seen.contains(name) {
            continue;
        }
        seen.push(*name);
        let mut found = -1;
        for let mut i = 0; i < grammar.parser_rules.len(); i += 1 {
            if grammar.parser_rules[i].name == *name {
                found = i;
                break;
            }
        }
        if found < 0 {
            ctx.warn(
                &DiagnosticOwner::host(&"fragment_entries"),
                DiagnosticKind::FragmentEntry,
                `fragment_entries: unknown parser rule '${*name}'`,
            );
            continue;
        }
        let rule_name = grammar.parser_rules[found].name;
        let snake = grammar.parser_rules[found].snake_name;
        let emits_vals = entry_emits_vals(ctx, &rule_name);
        let mut visiting: List<String> = [];
        let first_ids = ctx.first_ids_of_rule(&rule_name, &mut visiting);
        let first_names = ctx.token_names_of(&first_ids);
        let call = if emits_vals { `let _ = _parse_${snake}(p);` } else { `_parse_${snake}(p);` };
        result.push(RecoverFragmentEntry { call, first_names });
    }
    return result;
}

pub fn gen_recover_helpers(w: &mut CodeWriter, entries: &List<RecoverFragmentEntry>, ctx: &GenContext) {
    for let mut i = 0; i < entries.len(); i += 1 {
        w.line(&`global _FRAGMENT_FIRST_${i}: List<i32> = [${join_kinds(&entries[i].first_names)}];`);
    }
    if !entries.is_empty() {
        w.blank();
    }

    let mut d = FnSpec::new(&"_recover_fragment");
    d.add_param(&"p", &"&mut Parser");
    add_parser_super_effect(&mut d, ctx);
    d.set_return_type(&"bool");
    d.emit_begin(w);
    if entries.is_empty() {
        w.line(&"return false;");
    } else {
        w.line(&"let _k = p.kinds[p.pos];");
        for let mut i = 0; i < entries.len(); i += 1 {
            w.begin(&`if p.in_set(_k, &_FRAGMENT_FIRST_${i})`);
            w.line(&entries[i].call);
            w.line(&"return true;");
            w.end();
        }
        w.line(&"return false;");
    }
    w.end();
    w.blank();

    let mut s = FnSpec::new(&"_recover_try_descend");
    s.add_param(&"p", &"&mut Parser");
    add_parser_super_effect(&mut s, ctx);
    s.emit_begin(w);
    w.line(&"let _before = p.pos;");
    w.line(&"let _was = p.recovering;");
    w.line(&"p.recovering = false;");
    w.line(&"let _did = _recover_fragment(p);");
    w.line(&"p.recovering = _was;");
    w.begin(&"if !_did || p.pos == _before");
    w.line(&"let _sk = p.advance();");
    w.line(&"p.tokens.mark_skipped(_sk);");
    w.line(&"p.b.skip(_sk);");
    w.end();
    w.end();
    w.blank();
}

/// The same clause in function-type position, for the rule entry
/// `_run_parse_entry` takes as a value.
fn parser_super_fn_clause(ctx: &GenContext) -> String {
    if ctx.has_parser_superclass() {
        return ` with ${*ctx.parser_superclass_name()}`;
    }
    return "";
}

/// The ` with Foo` clause a parse-entry fn carries: the lexer's base (it
/// tokenizes) and the parser's (its rules evaluate predicates).
fn superclass_clause(ctx: &GenContext) -> String {
    let mut bases: List<String> = [];
    if ctx.has_superclass() {
        bases.push(*ctx.superclass_name());
    }
    if ctx.has_parser_superclass() {
        bases.push(*ctx.parser_superclass_name());
    }
    return match bases.len() {
        0 => "",
        1 => ` with ${bases[0]}`,
        _ => ` with (${bases.join(", ")})`,
    };
}

/// Public `parse` entry under the emitter: tokenize, run the start
/// rule (which drives the builder), and return a `ParseResult`. The parser is
/// infallible; a failure leaves `p.recovering` set and the deepest error in
/// `p.pending`, surfaced as one diagnostic. The partial tree (open nodes folded
/// by each wrapper's `finish_node`) is still returned.
pub fn gen_parse_entry(w: &mut CodeWriter, lowered: &LoweredGrammar, ctx: &GenContext) {
    if lowered.parser_rules.len() == 0 {
        return;
    }
    // The tokenize → run-entry → fold-error body is identical for every rule, so
    // it lives in a single `_run_parse_entry` helper; each `parse_<rule>` is a thin
    // wrapper that hands it the rule's `_parse_<rule>` entry as a fn value.
    gen_run_parse_entry(w, ctx);
    w.blank();
    // `parse` is the start (first) rule. Per-rule `parse_<rule>` entries let a
    // caller parse from any rule (ANTLR4 lets you pick a start rule; the
    // ANTLR4-compat descriptors name one), mirroring the typed parser.
    let start = rule_header(&lowered.parser_rules[0]);
    w.begin(&`pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult${superclass_clause(ctx)}`);
    w.line(&`return parse_${start.snake_name}(input, max_errors);`);
    w.end();
    w.blank();
    for let rule of &lowered.parser_rules {
        gen_parse_rule_entry(w, rule, ctx);
    }
}

/// Emit the shared entry body once per generated module: tokenize, run the
/// supplied rule entry (`_parse_<rule>`, passed as a fn value so a follow-gated
/// or LR entry's defaulted `follow` / `min_prec` arguments fill in), fold the
/// partial tree, and on error push a single diagnostic (deepest of the
/// propagated error and `p.pending`).
fn gen_run_parse_entry(w: &mut CodeWriter, ctx: &GenContext) {
    w.begin(
        &`fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser)${parser_super_fn_clause(ctx)}) -> ParseResult${superclass_clause(
            ctx,
        )}`,
    );
    // `max_errors` caps recovery; 1 is the fail-fast minimum. 0 (or negative)
    // would suppress every diagnostic and let a broken parse report `ok()`, so
    // reject it up front.
    w.line(&"assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;");
    w.line(&"let tokens = tokenize(input);");
    w.line(&"let mut p = Parser::new(tokens);");
    if ctx.emit_actions() {
        // Lexer prints happen before any parser print, as they do on ANTLR4's
        // stdout: seed the sink with what tokenizing produced.
        w.line(&"p.output = p.tokens.output;");
    }
    w.line(&"p.max_errors = max_errors;");
    w.line(&"entry(&mut p);");
    // The parser is infallible: a failure leaves `p.recovering` set and the
    // deepest error in `p.pending`. Surface it as one diagnostic; the partial
    // tree (open nodes folded by each wrapper's `finish_node`) is still returned.
    w.begin(&"if p.recovering && p.diagnostics.len() < max_errors");
    w.begin(&"if let Some(e) = &p.pending");
    w.line(&"let lc = line_col(p.tokens.chars, e.span.start);");
    w.line(
        &"let mut d = Diagnostic::error(p.pending_code, e.full_message(), e.span, lc.0, lc.1);",
    );
    // Carry the active rule chain (innermost-first, as each rule wrapper pushed
    // it on the way up) so tooling can report the context that failed.
    w.line(&"d.rule_stack = e.rule_stack;");
    w.line(&"p.diagnostics.push(d);");
    w.end();
    w.end();
    if ctx.emit_actions() {
        w.line(
            &"return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.output };",
        );
    } else {
        w.line(&"return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };");
    }
    w.end();
}

/// Emit one `pub fn parse_<rule>(input) -> ParseResult` entry as a thin wrapper
/// over `_run_parse_entry`. The closure defers to `_parse_<rule>(p)` so a follow-gated
/// or LR entry's defaulted `follow` / `min_prec` arguments fill in.
fn gen_parse_rule_entry(w: &mut CodeWriter, rule: &Rule, ctx: &GenContext) {
    let header = rule_header(rule);
    w.begin(
        &`pub fn parse_${header.snake_name}(input: &String, max_errors: i32 = i32::MAX) -> ParseResult${superclass_clause(
            ctx,
        )}`,
    );
    let call = `_parse_${header.snake_name}(p)`;
    let entry = if entry_emits_vals(ctx, &header.name) {
        `|p: &mut Parser| \{ let _ = ${call}; \}`;
    } else {
        `|p: &mut Parser| ${call}`;
    };
    w.line(&`return _run_parse_entry(input, max_errors, ${entry});`);
    w.end();
    w.blank();
}

/// Emit the "matched — consume the current token and return its index" tail of
/// a Parser consuming method. The Parser appends the token to the builder
/// first; typed just advances.
fn emit_consume_return(w: &mut CodeWriter) {
    w.line(&"let _i = self.advance();");
    w.line(&"self.b.token(_i);");
    w.line(&"return _i;");
}

fn emit_consume_kind_return(w: &mut CodeWriter) {
    w.begin(&"if kind == TK_EOF");
    w.line(&"self.b.token(self.pos);");
    w.line(&"return self.pos;");
    w.end();
    emit_consume_return(w);
}

/// Shared prologue for the `report_*` diagnostic methods: drop the diagnostic
/// (and fold the parse) once `max_errors` is reached, otherwise resolve the
/// `line:col` for `span.start`.
fn emit_diag_prologue(w: &mut CodeWriter) {
    w.line(&"if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }");
    w.line(&"let lc = line_col(self.tokens.chars, span.start);");
}

pub fn gen_parser_struct(
    w: &mut CodeWriter,
    trace: bool,
    needs_atn: bool,
    emit_actions: bool,
    fragment_recovery: bool,
    members: &MemberDecls,
    parser_base: &String,
) {
    let base_api = !parser_base.is_empty();
    // A parser base handler names the recognizer in its operation signature.
    let mut s = StructSpec::new(&"Parser", if base_api { Vis::Pub } else { Vis::Private });
    s.add_field(&"tokens", &"TokenStream");
    // Token kinds as a bare `Array<i32>` — the hot scan/peek read. A flat
    // array (not the `List<i32>` wrapper) so reading `kinds[pos]` is a single
    // `array.get` with nothing for the optimizer to hoist into an extra local;
    // a `&List<i32>` would cost every deeply-recursive scan frame one more
    // slot, overflowing the wasm stack on pathological grammars.
    s.add_field(&"kinds", &"Array<i32>");
    s.add_field(&"pos", &"i32");
    // Deepest speculative failure seen (a scan-gated repetition re-parses a
    // malformed element to harvest a precise inner error). The input-entry
    // reports it over the shallow "expected <closer>" error when it reaches
    // at least as far into the token stream.
    s.add_field(&"pending", &"Option<ParseError>");
    // Error-recovery flag. The parser is infallible: a match method that cannot
    // consume its terminal records the failure (into `pending`) and sets this
    // instead of propagating a `Result`. While set, every match method and rule
    // wrapper short-circuits (returns without consuming) so the recursive
    // descent unwinds to the entry, where the partial tree is folded closed —
    // reproducing the old `?` early-return without a `Result` type. A
    // speculative re-parse saves and restores it so a probe never aborts the
    // real parse.
    s.add_field(&"recovering", &"bool");
    // Diagnostic code for the pending failure (`UnexpectedToken` for a plain
    // mismatch, `NoViableAlternative` when no alternative applied); the entry
    // surfaces it with `pending`.
    s.add_field(&"pending_code", &"DiagnosticCode");
    // Set while a speculative parse runs (a scan-gated repeat's recovery probe,
    // an LR alt save-and-rewind). Recovery edits are suppressed: a mismatch
    // fails (records the deepest error, sets `recovering`) instead of
    // inserting / deleting / skipping, so the caller can cleanly backtrack —
    // static scan cannot tell a malformed element from a valid one that belongs
    // to the caller's continuation, so committing edits here would steal tokens.
    s.add_field(&"speculating", &"bool");
    // Cap on collected diagnostics (the `max_errors` entry parameter). Once
    // reached, recovery stops recording and folds the tree closed by setting
    // `recovering`; `<= 1` is effectively fail-fast (one diagnostic, partial
    // tree). Defaults to `i32::MAX` — unbounded.
    s.add_field(&"max_errors", &"i32");
    // Current recursive-descent depth, used only to indent trace output.
    if trace {
        s.add_field(&"trace_depth", &"i32");
    }
    // Runtime ATN simulator state (only when a non-greedy / LR decision needs
    // it); the decoded ATN is shared via the module-level `ATN_SIM`.
    // `atn_stack` is the caller stack of ATN return states for full-context
    // prediction. `atn_ret_pending` passes a call site's return state to the
    // callee's entry wrapper, which pushes it and resets to -1 (an unstamped
    // call pushes -1 = unknown caller, handled as SLL).
    if needs_atn {
        s.add_field(&"atn_stack", &"List<i32>");
        s.add_field(&"atn_ret_pending", &"i32");
    }
    // the parser drives a `TreeBuilder` (`b`) — the matched
    // terminals / subtrees accrue there in source order — and collects
    // `Diagnostic`s. The struct otherwise mirrors the typed Parser, so the
    // shared prediction / scan / ATN emission and the runtime ATN calls work
    // against it unchanged.
    s.add_field(&"b", &"TreeBuilder");
    s.add_field(&"diagnostics", &"List<Diagnostic>");
    if emit_actions {
        s.add_field(&"output", &"String");
    }
    // `@members` fields: defaulted so `Parser::new`'s literal can omit them.
    for let mf of &members.fields {
        s.add_field_default(&mf.name, &mf.ty, &mf.init);
    }
    s.emit(w);
    w.blank();

    let mut kn = FnSpec::new(&"kind_names");
    kn.add_param(&"kinds", &"&List<i32>");
    kn.set_return_type(&"List<String>");
    kn.emit_begin(w);
    w.line(&"let mut out: List<String> = List::with_capacity(kinds.len());");
    w.begin(&"for let k of kinds");
    w.line(&"out.push(token_kind_name(*k));");
    w.end();
    w.line(&"return out;");
    w.end();
    w.blank();

    ImplSpec::new(&"Parser").emit_begin(w);

    let mut f = FnSpec::new(&"new");
    f.add_param(&"tokens", &"TokenStream");
    f.set_return_type(&"Parser");
    f.emit_begin(w);
    w.line(&"let kinds = tokens.kinds.to_array();");
    let mut init = String::from(
        "tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX",
    );
    if trace {
        init.push_str(&", trace_depth: 0");
    }
    if needs_atn {
        init.push_str(&", atn_stack: [], atn_ret_pending: -1");
    }
    init.push_str(&", b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: []");
    if emit_actions {
        init.push_str(&", output: \"\"");
    }
    w.line(&`return Parser \{ ${init} \};`);
    w.end();
    w.blank();

    if emit_actions {
        // A parser base handler lives in the user's module, so this
        // action-context API is the recognizer surface it reads — ANTLR's `this`.
        let api = if base_api { Vis::Pub } else { Vis::Private };
        let mut fem = FnSpec::new(&"emit", api);
        fem.set_receiver(&"&mut self");
        fem.add_param(&"s", &"String");
        fem.emit_begin(w);
        w.line(&"self.output.push_str(&s);");
        w.end();
        w.blank();

        let mut ftt = FnSpec::new(&"token_text", api);
        ftt.set_receiver(&"&self");
        ftt.add_param(&"i", &"i32");
        ftt.set_return_type(&"String");
        ftt.emit_begin(w);
        w.line(&"return self.tokens.token_text(i);");
        w.end();
        w.blank();

        let mut fk = FnSpec::new(&"token_kind", api);
        fk.set_receiver(&"&self");
        fk.add_param(&"i", &"i32");
        fk.set_return_type(&"i32");
        fk.emit_begin(w);
        w.line(&"return self.tokens.kind_at(i);");
        w.end();
        w.blank();

        // `$X.int` mirrors ANTLR's `Integer.parseInt`: a 32-bit value, so
        // `token_int` returns `i32` (matching a `returns [int v]` field, which
        // java2wado maps to `i32`).
        let mut fint = FnSpec::new(&"token_int", api);
        fint.set_receiver(&"&self");
        fint.add_param(&"i", &"i32");
        fint.set_return_type(&"i32");
        fint.emit_begin(w);
        w.line(&"let sp = self.tokens.span_at(i);");
        w.line(&"let mut acc: i32 = 0;");
        w.line(&"let mut neg = false;");
        w.line(&"let mut j = sp.start;");
        w.begin(&"if j < sp.end && self.tokens.chars[j] == '-'");
        w.line(&"neg = true;");
        w.line(&"j += 1;");
        w.end();
        w.begin(&"while j < sp.end");
        w.line(&"let c = self.tokens.chars[j];");
        w.begin(&"if c.is_ascii_digit()");
        w.line(&"acc = acc * 10 + (c as i32 - '0' as i32);");
        w.end();
        w.line(&"j += 1;");
        w.end();
        w.line(&"return if neg { -acc } else { acc };");
        w.end();
        w.blank();

        let mut fln = FnSpec::new(&"token_line", api);
        fln.set_receiver(&"&self");
        fln.add_param(&"i", &"i32");
        fln.set_return_type(&"i32");
        fln.emit_begin(w);
        w.line(&"return line_col(self.tokens.chars, self.tokens.span_at(i).start).0;");
        w.end();
        w.blank();

        let mut fcol = FnSpec::new(&"token_col", api);
        fcol.set_receiver(&"&self");
        fcol.add_param(&"i", &"i32");
        fcol.set_return_type(&"i32");
        fcol.emit_begin(w);
        w.line(&"return line_col(self.tokens.chars, self.tokens.span_at(i).start).1;");
        w.end();
        w.blank();

        // Byte offset where token `i` begins — backs `$text` (span from the
        // rule's first token) and `$start`-derived spans.
        let mut fts0 = FnSpec::new(&"token_start", api);
        fts0.set_receiver(&"&self");
        fts0.add_param(&"i", &"i32");
        fts0.set_return_type(&"i32");
        fts0.emit_begin(w);
        w.line(&"return self.tokens.starts[i];");
        w.end();
        w.blank();

        // `_input.LA(k)` — the token kind k positions ahead (k=1 is current).
        let mut fla = FnSpec::new(&"la", api);
        fla.set_receiver(&"&self");
        fla.add_param(&"k", &"i32");
        fla.set_return_type(&"i32");
        fla.emit_begin(w);
        w.line(&"return self.peek_at(k - 1);");
        w.end();
        w.blank();

        // `_input.LT(k)` — the stream index k positions ahead, clamped to the
        // final (EOF) token so a lookahead past end stays in bounds.
        let mut flt = FnSpec::new(&"lt", api);
        flt.set_receiver(&"&self");
        flt.add_param(&"k", &"i32");
        flt.set_return_type(&"i32");
        flt.emit_begin(w);
        w.line(&"let idx = self.pos + k - 1;");
        w.line(&"if idx >= self.kinds.len() { return self.kinds.len() - 1; }");
        w.line(&"if idx < 0 { return 0; }");
        w.line(&"return idx;");
        w.end();
        w.blank();

        // Source text of the half-open byte range `[start, end)` — backs `$text`
        // (the current rule's consumed input) and `_input.getText()`.
        let mut fts = FnSpec::new(&"text_span", api);
        fts.set_receiver(&"&self");
        fts.add_param(&"start", &"i32");
        fts.add_param(&"end", &"i32");
        fts.set_return_type(&"String");
        fts.emit_begin(w);
        w.line(&"let mut out = String::new();");
        w.line(&"let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };");
        w.begin(&"for let mut i = start; i < hi; i += 1");
        w.line(&"out.push(self.tokens.chars[i]);");
        w.end();
        w.line(&"return out;");
        w.end();
        w.blank();

        // `$text` — the input matched by the current rule so far. ANTLR
        // concatenates the parse-tree token texts (skipped tokens are absent
        // from the token stream), so a `-> skip` gap between tokens does NOT
        // appear; this differs from a raw source-span slice (`text_span`). The
        // range is the rule's first token (`start_tok`) through the last
        // consumed token (`self.pos - 1`).
        // `$<label>.text` — the text of one labeled rule call's own token range.
        let mut ftb = FnSpec::new(&"text_between", api);
        ftb.set_receiver(&"&self");
        ftb.add_param(&"lo", &"i32");
        ftb.add_param(&"hi", &"i32");
        ftb.set_return_type(&"String");
        ftb.emit_begin(w);
        w.line(&"return self.tokens.rule_text(lo, hi);");
        w.end();
        w.blank();

        let mut frt = FnSpec::new(&"rule_text", api);
        frt.set_receiver(&"&self");
        frt.add_param(&"start_tok", &"i32");
        frt.set_return_type(&"String");
        frt.emit_begin(w);
        w.line(&"return self.tokens.rule_text(start_tok, self.pos - 1);");
        w.end();
        w.blank();

        // `_input.getText()` — the entire input.
        let mut fit = FnSpec::new(&"input_text", api);
        fit.set_receiver(&"&self");
        fit.set_return_type(&"String");
        fit.emit_begin(w);
        w.line(&"return self.text_span(0, self.tokens.chars.len());");
        w.end();
        w.blank();

        // `$ctx.toStringTree()` — the S-expression of the rule currently under
        // construction. A non-LR rule's node is still open in `@after`
        // (`render_open`); a left-recursive rule's level is already folded shut
        // by then, so its `@after` reads the just-finished node
        // (`rule_string_tree_final` / `render_last_finished`).
        let mut frst = FnSpec::new(&"rule_string_tree", api);
        frst.set_receiver(&"&self");
        frst.set_return_type(&"String");
        frst.emit_begin(w);
        w.line(&"return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);");
        w.end();
        w.blank();

        let mut frstf = FnSpec::new(&"rule_string_tree_final", api);
        frstf.set_receiver(&"&self");
        frstf.set_return_type(&"String");
        frstf.emit_begin(w);
        w.line(&"return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);");
        w.end();
        w.blank();
    }

    // Build a ParseError at the current position, resolving `line:col` from the
    // source. `rule_stack` is filled by the rule-entry wrappers as it propagates.
    let mut fe = FnSpec::new(&"error");
    fe.set_receiver(&"&self");
    fe.add_param(&"message", &"String");
    fe.add_param(&"span", &"Span");
    fe.add_param(&"expected", &"&List<i32>");
    fe.set_return_type(&"ParseError");
    fe.emit_begin(w);
    w.line(&"let lc = line_col(self.tokens.chars, span.start);");
    w.line(&"return ParseError::at(message, span, kind_names(expected), lc.0, lc.1);");
    w.end();
    w.blank();

    // Record an unrecoverable match failure and enter recovery. Infallible
    // replacement for the old `return Result::Err(...)`: the deepest failure is
    // kept in `pending` (with its `code`) and `recovering` short-circuits the
    // rest of the descent until the entry surfaces it.
    let mut ff = FnSpec::new(&"fail");
    ff.set_receiver(&"&mut self");
    ff.add_param(&"message", &"String");
    ff.add_param(&"span", &"Span");
    ff.add_param(&"expected", &"&List<i32>");
    ff.add_param(&"code", &"DiagnosticCode");
    ff.emit_begin(w);
    // Decide from the span before building: a discarded error would otherwise
    // pay for one `token_kind_name` String per expected kind.
    w.line(&"let take = if let Some(cur) = &self.pending { span.start > cur.span.start } else { true };");
    w.begin(&"if take");
    w.line(&"self.pending = Option::Some(self.error(message, span, expected));");
    w.line(&"self.pending_code = code;");
    w.end();
    w.line(&"self.recovering = true;");
    w.end();
    w.blank();

    // Alternative dispatch found no viable alternative: record the failure with
    // the `NoViableAlternative` code and enter recovery (thin wrapper over
    // `fail`).
    let mut nv = FnSpec::new(&"no_viable");
    nv.set_receiver(&"&mut self");
    nv.add_param(&"message", &"String");
    nv.add_param(&"span", &"Span");
    nv.add_param(&"expected", &"&List<i32>");
    nv.emit_begin(w);
    w.line(&"self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);");
    w.end();
    w.blank();

    // Append a rule name to the pending error's rule stack as the descent
    // unwinds (each rule wrapper calls this on the way out when recovering),
    // so tooling can report the context that failed.
    let mut prs = FnSpec::new(&"push_rule_stack");
    prs.set_receiver(&"&mut self");
    prs.add_param(&"name", &"String");
    prs.emit_begin(w);
    w.begin(&"if let Some(e) = &mut self.pending");
    w.line(&"e.rule_stack.push(name);");
    w.end();
    w.end();
    w.blank();

    // `trace_fail` is its only caller.
    if trace {
        let mut pm = FnSpec::new(&"pending_message");
        pm.set_receiver(&"&self");
        pm.set_return_type(&"String");
        pm.emit_begin(w);
        w.line(&"if let Some(e) = &self.pending { return e.full_message(); }");
        w.line(&"return String::new();");
        w.end();
        w.blank();
    }

    // Membership test for a recovery sync set (the rule's FIRST-of-rest).
    let mut iset = FnSpec::new(&"in_set");
    iset.set_receiver(&"&self");
    iset.add_param(&"k", &"i32");
    iset.add_param(&"set", &"&List<i32>");
    iset.set_return_type(&"bool");
    iset.emit_begin(w);
    w.line(&"for let x of set { if *x == k { return true; } }");
    w.line(&"return false;");
    w.end();
    w.blank();

    // Record a local recovery edit as a diagnostic and keep parsing (no
    // `recovering`): a deleted spurious terminal (`ExtraToken`) or an inserted
    // required terminal (`MissingToken`).
    let mut rex = FnSpec::new(&"report_extra");
    rex.set_receiver(&"&mut self");
    rex.add_param(&"span", &"Span");
    rex.emit_begin(w);
    emit_diag_prologue(w);
    w.line(
        &"self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input \"${self.tokens.token_text(self.pos)}\"`, span, lc.0, lc.1));",
    );
    w.end();
    w.blank();

    let mut rmi = FnSpec::new(&"report_missing");
    rmi.set_receiver(&"&mut self");
    rmi.add_param(&"kind", &"i32");
    rmi.add_param(&"span", &"Span");
    rmi.emit_begin(w);
    emit_diag_prologue(w);
    w.line(&"let name = token_kind_name(kind);");
    w.line(
        &"self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));",
    );
    w.end();
    w.blank();

    // Record an unexpected-token error opening an `<error>` recovery region.
    let mut run = FnSpec::new(&"report_unexpected");
    run.set_receiver(&"&mut self");
    run.add_param(&"span", &"Span");
    run.emit_begin(w);
    emit_diag_prologue(w);
    w.line(
        &"self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input \"${self.tokens.token_text(self.pos)}\"`, span, lc.0, lc.1));",
    );
    w.end();
    w.blank();

    // A "token" handed to the rest of the parser is its `i32` index into the
    // stream; node fields store that index, not a Token aggregate.
    let mut f2 = FnSpec::new(&"peek_start");
    f2.set_receiver(&"&self");
    f2.set_return_type(&"i32");
    f2.emit_begin(w);
    w.line(&"return self.tokens.starts[self.pos];");
    w.end();
    w.blank();

    let mut f2b = FnSpec::new(&"peek_span");
    f2b.set_receiver(&"&self");
    f2b.set_return_type(&"Span");
    f2b.emit_begin(w);
    w.line(&"return self.tokens.span_at(self.pos);");
    w.end();
    w.blank();

    let mut f3 = FnSpec::new(&"peek_kind");
    f3.set_receiver(&"&self");
    f3.set_return_type(&"i32");
    f3.emit_begin(w);
    w.line(&"return self.kinds[self.pos];");
    w.end();
    w.blank();

    let mut f4 = FnSpec::new(&"peek_at");
    f4.set_receiver(&"&self");
    f4.add_param(&"offset", &"i32");
    f4.set_return_type(&"i32");
    f4.emit_begin(w);
    w.line(&"let idx = self.pos + offset;");
    w.line(&"if idx >= self.kinds.len() { return TK_EOF; }");
    w.line(&"return self.kinds[idx];");
    w.end();
    w.blank();

    let mut f5 = FnSpec::new(&"advance");
    f5.set_receiver(&"&mut self");
    f5.set_return_type(&"i32");
    f5.emit_begin(w);
    w.line(&"let i = self.pos;");
    w.line(&"self.pos += 1;");
    w.line(&"return i;");
    w.end();
    w.blank();

    let mut f6 = FnSpec::new(&"last_end");
    f6.set_receiver(&"&self");
    f6.set_return_type(&"i32");
    f6.emit_begin(w);
    w.line(&"if self.pos == 0 { return 0; }");
    w.line(&"return self.tokens.ends[self.pos - 1];");
    w.end();
    w.blank();

    // `p.expect(kind, sync)` matches a single token of the requested kind. EOF
    // is matched without advancing so consecutive `EOF` references see the same
    // sentinel (the stream holds one EOF; advancing past it reads out of
    // bounds). Mirrors ANTLR4's `matchedEOF`.
    //
    // On a mismatch it recovers in place (never propagating): a single spurious
    // token before the expected one is *deleted* (`<skip>`, `ExtraToken`); a
    // token that continues the rule (`sync` = the rule's FIRST-of-rest) means
    // the expected one is missing and is *inserted* (`<missing>`, `MissingToken`);
    // anything else is unrecoverable here, so it sets `recovering` and unwinds.
    // Delete and insert are local edits — they record a diagnostic but keep
    // parsing, so a clean tail still parses.
    let mut f7 = FnSpec::new(&"expect");
    f7.set_receiver(&"&mut self");
    f7.add_param(&"kind", &"i32");
    f7.add_param(&"sync", &"&List<i32>");
    f7.set_return_type(&"i32");
    // Fragment recovery descends into rule entries, so `expect` reaches the
    // parse fns and must carry the base effect they declare.
    if fragment_recovery && base_api {
        f7.add_effect(parser_base);
    }
    f7.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.begin(&"if self.kinds[self.pos] == kind");
    emit_consume_kind_return(w);
    w.end();
    // In a speculative parse, do not apply recovery edits — fail so the caller
    // backtracks (committing an edit here could steal tokens that belong to the
    // caller's continuation, which static scan cannot rule out).
    w.begin(&"if self.speculating");
    w.line(
        &"self.fail(`got \"${self.tokens.token_text(self.pos)}\"`, self.tokens.span_at(self.pos), &([kind] as List<i32>), DiagnosticCode::UnexpectedToken);",
    );
    w.line(&"return self.pos;");
    w.end();
    if fragment_recovery {
        w.begin(&"if kind == TK_EOF && self.kinds[self.pos] != TK_EOF");
        w.line(&"self.report_unexpected(self.tokens.span_at(self.pos));");
        w.line(&"self.b.start_error(self.tokens.span_at(self.pos).start);");
        w.begin(&"loop");
        w.line(&"if self.kinds[self.pos] == TK_EOF { break; }");
        w.line(&"_recover_try_descend(self);");
        w.end();
        w.line(&"self.b.finish_node(self.last_end());");
        emit_consume_kind_return(w);
        w.end();
    }
    // single-token deletion: the current token is spurious, the expected one
    // follows it.
    w.begin(&"if self.peek_at(1) == kind");
    w.line(&"self.report_extra(self.tokens.span_at(self.pos));");
    w.line(&"let _sk = self.advance();");
    w.line(&"self.tokens.mark_skipped(_sk);");
    w.line(&"self.b.skip(_sk);");
    emit_consume_kind_return(w);
    w.end();
    // single-token insertion: the current token continues the rule, so the
    // expected one is missing.
    w.begin(&"if self.in_set(self.kinds[self.pos], sync)");
    w.line(&"self.report_missing(kind, self.tokens.span_at(self.pos));");
    w.line(&"let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);");
    w.line(&"self.b.missing(_syn);");
    w.line(&"return _syn;");
    w.end();
    // Neither match nor a single-token edit fits. If the rule's FIRST-of-rest
    // (`sync`) is known, skip the offending run into a lossless `<error>`
    // region and resync to it, then continue; otherwise record the deepest
    // failure and unwind.
    w.begin(&"if !sync.is_empty()");
    w.line(&"self.report_unexpected(self.tokens.span_at(self.pos));");
    w.begin(&"if self.kinds[self.pos] != TK_EOF");
    w.line(&"self.b.start_error(self.tokens.span_at(self.pos).start);");
    w.begin(&"loop");
    w.line(&"let _k = self.kinds[self.pos];");
    w.line(&"if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }");
    w.line(&"let _sk = self.advance();");
    w.line(&"self.tokens.mark_skipped(_sk);");
    w.line(&"self.b.skip(_sk);");
    w.end();
    w.line(&"self.b.finish_node(self.last_end());");
    w.end();
    // resynced exactly onto the expected token: consume it.
    w.begin(&"if self.kinds[self.pos] == kind");
    emit_consume_kind_return(w);
    w.end();
    // resynced onto a follow token / EOF: the expected one is still missing.
    w.line(&"let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);");
    w.line(&"self.b.missing(_syn2);");
    w.line(&"return _syn2;");
    w.end();
    // no sync info: record the deepest failure and unwind.
    w.line(&"self.fail(");
    w.indent();
    w.line(&"`got \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"&([kind] as List<i32>),");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();
    w.blank();

    // `p.any()` — consumes one token of any kind (for `.` wildcard).
    // Fails at EOF.
    let mut f9 = FnSpec::new(&"any");
    f9.set_receiver(&"&mut self");
    f9.set_return_type(&"i32");
    f9.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.begin(&"if self.kinds[self.pos] != TK_EOF");
    emit_consume_return(w);
    w.end();
    w.line(&"self.fail(");
    w.indent();
    // `any` wants no particular kind, so it carries the wanted set in the
    // message instead of the (kind-id) `expected` list.
    w.line(&"`expected any token; got \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"&EMPTY_SYNC,");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();
    w.blank();

    // `p.expect_not([...])` — consumes one token whose kind is not in the
    // exclusion set (parser-side `~ X`). Fails at EOF or on an excluded kind.
    let mut f10 = FnSpec::new(&"expect_not");
    f10.set_receiver(&"&mut self");
    f10.add_param(&"excluded", &"&List<i32>");
    f10.set_return_type(&"i32");
    f10.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.line(&"let k = self.kinds[self.pos];");
    w.begin(&"if k != TK_EOF && !self.in_set(k, excluded)");
    emit_consume_return(w);
    w.end();
    w.line(&"self.fail(");
    w.indent();
    w.line(&"`unexpected token \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"&EMPTY_SYNC,");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();
    w.blank();

    // `p.expect_set([...])` — consumes one token whose kind is in the included
    // set (parser-side token-only groups like `('b' | 'c')`). Fails outside the
    // set (EOF included unless listed); a listed EOF matches without advancing.
    let mut f11 = FnSpec::new(&"expect_set");
    f11.set_receiver(&"&mut self");
    f11.add_param(&"included", &"&List<i32>");
    f11.set_return_type(&"i32");
    f11.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.line(&"let k = self.kinds[self.pos];");
    w.begin(&"if self.in_set(k, included)");
    w.begin(&"if k == TK_EOF");
    w.line(&"self.b.token(self.pos);");
    w.line(&"return self.pos;");
    w.end();
    emit_consume_return(w);
    w.end();
    w.line(&"self.fail(");
    w.indent();
    w.line(&"`got \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"included,");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();

    w.end();  // impl
    w.blank();
}

// For each alternative in an Ambiguous group that has a scannable prefix,
// generate a scan_<rule>_alt_<N> function. This function scans only the
// scannable prefix of the alternative, which is enough to distinguish it
// from other alternatives without full speculative parsing.

/// Emit the trace helpers (the `trace` option is on). The emit sites only
/// emit simple calls — `trace_enter`/`trace_ok`/`trace_fail` from the rule
/// wrappers, `trace_pick`/`trace_scan_alt`/`trace_try` from the multi-alt
/// bodies; these helpers do the indentation, lookahead-token rendering, and
/// `log_stderr` formatting so the emitter avoids nesting a generated template
/// inside its own template string.
pub fn gen_trace_helpers(w: &mut CodeWriter) {
    w.line(&"fn trace_pad(depth: i32) -> String {");
    w.indent();
    w.line(&"let mut s = String::with_capacity(depth * 2);");
    w.line(&"for let mut i = 0; i < depth; i += 1 { s.push_str(&\"  \"); }");
    w.line(&"return s;");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_tok(p: &Parser) -> String {");
    w.indent();
    w.line(&"if p.pos >= p.tokens.len() { return String::from(\"<eof>\"); }");
    w.line(&"if p.tokens.is_empty_text(p.pos) { return String::from(\"<eof>\"); }");
    w.line(&"return `'${p.tokens.token_text(p.pos)}'`;");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_enter(p: &Parser, rule: &String) {");
    w.indent();
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}enter ${*rule} @${p.pos} ${trace_tok(p)}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_ok(p: &Parser, rule: &String) {");
    w.indent();
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}ok ${*rule}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_fail(p: &Parser, rule: &String, msg: &String) {");
    w.indent();
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}FAIL ${*rule}: ${*msg}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    // Decision-point helpers: which alternative a multi-alt / tournament
    // rule committed to, the per-alt scan lengths a longest-match
    // tournament weighed, and the outcome of each speculative try.
    w.line(&"fn trace_pick(p: &Parser, rule: &String, alt: i32) {");
    w.indent();
    w.line(&"if alt < 0 { log_stderr(`${trace_pad(p.trace_depth)}  pick ${*rule}: no alt matched`); }");
    w.line(&"else { log_stderr(`${trace_pad(p.trace_depth)}  pick ${*rule} alt#${alt}`); }");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_scan_alt(p: &Parser, rule: &String, alt: i32, end: i32) {");
    w.indent();
    w.line(&"let r = if end < 0 { String::from(\"fail\") } else { `-> @${end}` };");
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}  scan ${*rule} alt#${alt}: ${r}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_try(p: &Parser, rule: &String, alt: i32, ok: bool) {");
    w.indent();
    w.line(&"let r = if ok { String::from(\"ok\") } else { String::from(\"rewind\") };");
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}  try ${*rule} alt#${alt}: ${r}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
}

/// Emit the ATN return-state bookkeeping a rule entry performs around its
/// inner call: consume the pending return state the call site stamped, reset
/// it, and push it onto the simulator's caller stack for full-context
/// prediction (popped via `p.atn_stack.pop()` on every exit). Only emitted for
/// grammars that need the ATN.
pub fn emit_atn_enter(w: &mut CodeWriter) {
    w.line(&"let _atn_ret = p.atn_ret_pending;");
    w.line(&"p.atn_ret_pending = -1;");
    w.line(&"p.atn_stack.push(_atn_ret);");
}
