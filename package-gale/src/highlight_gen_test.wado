//! Tests for `highlight_gen.wado`. The `defaults` capture table is indexed by
//! token kind at runtime (`defaults[kind]`), so its row order must match the
//! token numbering emitted by `gen_token_constants` — deferred `more` /
//! `type(...)` rules at the back, and no sentinel `TK_ERROR` row when a user
//! rule named `ERROR` claims the id. Captures and overrides come from the
//! highlight query.

use { Grammar } from "./ir.wado";
use { parse } from "./g4/parser.wado";
use { collect_literal_tokens } from "./lexer_gen.wado";
use { gen_highlight } from "./highlight_gen.wado";
use { parse_highlight_query } from "./highlight_query.wado";
use { GenContext } from "./gen_context.wado";
use { CodeWriter } from "./wadopoet.wado";

fn parse_grammar(input: String) -> Grammar {
    let mut g = parse(input).unwrap();
    g.source_files.push("(test)");
    return g;
}

fn highlight_output_q(input: String, query_src: String) -> String {
    let g = parse_grammar(input);
    let lits = collect_literal_tokens(&g.parser_rules);
    let query = parse_highlight_query(&query_src).unwrap();
    let mut ctx = GenContext::new(&g.parser_rules, &lits);
    let mut w = CodeWriter::new();
    gen_highlight(&mut w, &g, &lits, &query, &mut ctx);
    return w.to_string();
}

fn highlight_output(input: String) -> String {
    return highlight_output_q(input, "");
}

fn index_of(haystack: &String, needle: String) -> i32 {
    return match haystack.find(needle) {
        Some(idx) => idx,
        None => -1,
    };
}

fn count_occurrences(haystack: &String, needle: String) -> i32 {
    let needle_len = needle.len();
    if needle_len == 0 {
        return 0;
    }
    let mut count = 0;
    let mut remainder = *haystack;
    loop {
        match remainder.find(needle) {
            Some(idx) => {
                count += 1;
                remainder = remainder.substr_bytes(idx + needle_len, remainder.len());
            },
            None => {
                break;
            },
        }
    }
    return count;
}

test "highlight defaults: more rule rows are deferred like token numbering" {
    // `A -> more` gets a deferred (high) token id in gen_token_constants,
    // so its defaults row must also come after the non-deferred rules.
    let out = highlight_output("grammar T;
r : B ;
A : 'a' -> more ;
B : 'b' ;
WS : ' ' -> skip ;
");
    let a = index_of(&out, "// TK_A");
    let b = index_of(&out, "// TK_B");
    let ws = index_of(&out, "// TK_WS");
    assert a >= 0 && b >= 0 && ws >= 0, out;
    assert b < a, `TK_B row must precede deferred TK_A row: b={b} a={a}`;
    assert ws < a, `TK_WS row must precede deferred TK_A row: ws={ws} a={a}`;
}

test "highlight fn: lexer-only grammar is tokenize-only (no walk_ call)" {
    // A lexer-only grammar has no parser rules, so the generated module has
    // no `parse` / tree walk. The highlight fn must fall back to tokenizing
    // instead of emitting an invalid `highlight_walk(...)` call.
    let out = highlight_output("lexer grammar L;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert index_of(&out, "walk_(") == -1, out;
    assert index_of(&out, "tokenize(input)") >= 0, out;
}

test "highlight defaults: user ERROR rule suppresses the sentinel row" {
    // gen_token_constants emits no TK_ERROR sentinel when a user rule named
    // ERROR exists; the defaults table must not insert one either (every
    // later row would shift by one).
    let out = highlight_output("grammar T;
r : B ;
B : 'b' ;
ERROR : . ;
");
    let n = count_occurrences(&out, "// TK_ERROR");
    assert n == 1, `expected exactly one TK_ERROR row (the user rule), got {n}:\n{out}`;
}

test "query maps a token to its default capture" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(B) @keyword");
    assert index_of(&out, "\"keyword\",  // TK_B") >= 0, out;
}

test "query maps a literal token to its default capture" {
    let out = highlight_output_q("grammar T;
r : 'let' B ;
B : 'b' ;
", "\"let\" @keyword");
    assert index_of(&out, "\"keyword\",  // ") >= 0, out;
}

test "query override emits a HighlightOverride row" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)");
    assert index_of(&out, "HighlightOverride {") >= 0, out;
    assert index_of(&out, "rule_name: \"r\"") >= 0, out;
    assert index_of(&out, "capture: \"string\"") >= 0, out;
}

test "default on a literal-shadowed named token maps the shadowing literal kind" {
    // LP is `'('` and the parser also uses '(' inline, so the lexer emits the
    // literal token, not TK_LP. Mapping (LP) must still colour '(' by also
    // targeting the literal kind, otherwise the mapping is a silent no-op.
    let out = highlight_output_q("grammar T;
r : '(' B ')' ;
B : 'b' ;
LP : '(' ;
RP : ')' ;
", "(LP) @punctuation.bracket");
    assert index_of(&out, "\"punctuation.bracket\",  // TK_LIT") >= 0, out;
}

test "later override for the same rule and token wins (last-wins)" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)
(r (B) @keyword)");
    assert count_occurrences(&out, "HighlightOverride {") == 1, out;
    assert index_of(&out, "capture: \"keyword\"") >= 0, out;
    assert index_of(&out, "capture: \"string\"") == -1, out;
}

test "unknown token in query warns via ctx diagnostics" {
    let g = parse_grammar("grammar T;
r : B ;
B : 'b' ;
");
    let lits = collect_literal_tokens(&g.parser_rules);
    let query = parse_highlight_query(&"(NOPE) @keyword").unwrap();
    let mut ctx = GenContext::new(&g.parser_rules, &lits);
    let mut w = CodeWriter::new();
    gen_highlight(&mut w, &g, &lits, &query, &mut ctx);
    let diags = ctx.copy_diagnostics();
    assert diags.len() == 1, `expected one diagnostic, got {diags.len()}`;
    assert diags[0].message.contains("unknown token"), diags[0].message;
}

test "unknown parser rule in an override warns via ctx diagnostics" {
    let g = parse_grammar("grammar T;
r : B ;
B : 'b' ;
");
    let lits = collect_literal_tokens(&g.parser_rules);
    let query = parse_highlight_query(&"(nope (B) @string)").unwrap();
    let mut ctx = GenContext::new(&g.parser_rules, &lits);
    let mut w = CodeWriter::new();
    gen_highlight(&mut w, &g, &lits, &query, &mut ctx);
    let diags = ctx.copy_diagnostics();
    assert diags.len() == 1, `expected one diagnostic, got {diags.len()}`;
    assert diags[0].message.contains("unknown parser rule"), diags[0].message;
}
