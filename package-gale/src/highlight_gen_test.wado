//! Tests for `highlight_gen.wado`. The `default_ids` table is indexed by token
//! kind at runtime (`default_ids[kind]`), so its row order must match the
//! token numbering emitted by `gen_token_constants` — deferred `more` /
//! `type(...)` rules at the back, and no sentinel `TK_ERROR` row when a user
//! rule named `ERROR` claims the id. Captures and overrides come from the
//! highlight query.

use { Grammar, alias_parser_literals } from "./ir.wado";
use { parse } from "./g4/parser.wado";
use { collect_literal_tokens } from "./lexer_gen.wado";
use { gen_highlight } from "./highlight_gen.wado";
use { parse_highlight_query } from "./highlight_query.wado";
use { GenContext } from "./gen_context.wado";
use { Diagnostic } from "./gir.wado";
use { CodeWriter } from "lib:wadopoet";

fn parse_grammar<S: AsStrSlice>(input: S) -> Grammar {
    let mut g = parse(input).unwrap();
    g.source_files.push("(test)");
    return g;
}

/// The generated text and the diagnostics one query run produced.
fn highlight_run<S: AsStrSlice, S1: AsStrSlice>(input: S, query_src: S1) -> [String, List<Diagnostic>] {
    let mut g = parse_grammar(input);
    // Mirror `generate()`, whose `lit_tokens` never see an aliased text.
    alias_parser_literals(&mut g);
    let lits = collect_literal_tokens(&g.parser_rules);
    let query = parse_highlight_query(&query_src).unwrap();
    let mut ctx = GenContext::new(&g.parser_rules, &lits);
    let mut w = CodeWriter::new();
    gen_highlight(&mut w, &g, &lits, &query, &mut ctx);
    return [
        w.to_string(),
        ctx.copy_diagnostics(),
    ];
}

fn highlight_output_q<S: AsStrSlice, S1: AsStrSlice>(input: S, query_src: S1) -> String {
    return highlight_run(input, query_src).0;
}

fn highlight_output<S: AsStrSlice>(input: S) -> String {
    return highlight_output_q(input, "");
}

/// A rule capture the generator cannot expand: one warning, no overrides.
fn assert_capture_refused(run: &[String, List<Diagnostic>]) {
    assert run.1.len() == 1, `expected one diagnostic, got ${run.1.len()}`;
    assert run.1[0].message.contains("single token"), run.1[0].message;
    assert index_of(&run.0, "RuleCapture {") == -1, run.0;
}

fn index_of<S: AsStrSlice, S1: AsStrSlice>(haystack: S, needle: S1) -> i32 {
    return match haystack.find(needle) {
        Some(idx) => idx,
        None => -1,
    };
}

fn count_occurrences<S: AsStrSlice, S1: AsStrSlice>(haystack: S, needle: S1) -> i32 {
    let needle_len = needle.len();
    if needle_len == 0 {
        return 0;
    }
    let mut count = 0;
    let mut remainder = haystack.to_string();
    loop {
        match remainder.find(needle) {
            Some(idx) => {
                count += 1;
                remainder = remainder.substr_bytes(idx + needle_len, remainder.len());
            },
            None => {
                break;
            },
        }
    }
    return count;
}

test "highlight defaults: more rule rows are deferred like token numbering" {
    // `A -> more` gets a deferred (high) token id in gen_token_constants,
    // so its defaults row must also come after the non-deferred rules.
    let out = highlight_output("grammar T;
r : B ;
A : 'a' -> more ;
B : 'b' ;
WS : ' ' -> skip ;
");
    let a = index_of(&out, "// TK_A");
    let b = index_of(&out, "// TK_B");
    let ws = index_of(&out, "// TK_WS");
    assert a >= 0 && b >= 0 && ws >= 0, out;
    assert b < a, `TK_B row must precede deferred TK_A row: b=${b} a=${a}`;
    assert ws < a, `TK_WS row must precede deferred TK_A row: ws=${ws} a=${a}`;
}

test "highlight fn: lexer-only grammar is tokenize-only (no walk_ call)" {
    // A lexer-only grammar has no parser rules, so the generated module has
    // no `parse` / tree walk. The highlight fn must fall back to tokenizing
    // instead of emitting an invalid `highlight_walk(...)` call.
    let out = highlight_output("lexer grammar L;
B : 'b' ;
WS : ' ' -> skip ;
");
    assert index_of(&out, "walk_(") == -1, out;
    assert index_of(&out, "tokenize(input)") >= 0, out;
}

test "highlight defaults: user ERROR rule suppresses the sentinel row" {
    // gen_token_constants emits no TK_ERROR sentinel when a user rule named
    // ERROR exists; the defaults table must not insert one either (every
    // later row would shift by one).
    let out = highlight_output("grammar T;
r : B ;
B : 'b' ;
ERROR : . ;
");
    let n = count_occurrences(&out, "// TK_ERROR");
    assert n == 1, `expected exactly one TK_ERROR row (the user rule), got ${n}:\n${out}`;
}

test "query maps a token to its default capture" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(B) @keyword");
    assert index_of(&out, "0,  // TK_B @keyword") >= 0, out;
}

test "query maps a literal token to its default capture" {
    let out = highlight_output_q("grammar T;
r : 'let' B ;
B : 'b' ;
", "\"let\" @keyword");
    assert index_of(&out, " @keyword\n") >= 0, out;
}

test "highlight fn: a grammar with a parser walks the CST, query or not" {
    // The walk carries the rule stack a rule-context override reads. A query
    // with no override reaches the same captures without it, since an empty
    // override table never reads the stack, and is walked all the same, so the
    // highlight fn has one shape.
    let plain = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(B) @keyword");
    assert index_of(&plain, "highlight_walk(&mut visitor") >= 0, plain;
    assert index_of(&plain, "hl_cover_unvisited(") >= 0, plain;
    let contextual = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)");
    assert index_of(&contextual, "highlight_walk(&mut visitor") >= 0, contextual;
}

test "rule capture is one rule-level entry, not one per token" {
    // `(name) @variable` covers every token under `name`, so a contextual
    // keyword the rule accepts as a name is captured without the query naming
    // it, and no per-token table spells the set out.
    let out = highlight_output_q("grammar T;
r : name ;
name : IDENTIFIER | 'test' | 'task' ;
IDENTIFIER : [a-z]+ ;
", "(name) @variable");
    assert count_occurrences(&out, "RuleCapture {") == 1, out;
    assert index_of(&out, "rule_captures: [\n        RuleCapture { rule_id: RK_NAME as i32, capture_id: 0, order: 0 },") >= 0, out;
    assert index_of(&out, "overrides_by_kind: [],") >= 0, out;
}

test "the mapping is one global, resolved at generation time" {
    let out = highlight_output_q("grammar T;
r : name '(' ;
name : IDENTIFIER ;
IDENTIFIER : [a-z]+ ;
", "(name) @variable\n\"(\" @punctuation.bracket");
    assert index_of(&out, "pub global HIGHLIGHT_MAPPING: HighlightMapping = HighlightMapping {") >= 0, out;
    assert index_of(&out, "HighlightVisitor::new(&HIGHLIGHT_MAPPING)") >= 0, out;
    assert index_of(&out, "fn highlight_mapping") == -1, out;
    assert index_of(&out, "rule_names") == -1, out;
    assert index_of(&out, "capture_classes: [\n        \"punctuation bracket\",\n        \"variable\",\n    ],") >= 0, out;
}

test "the highlighter is a library: no CLI entry point, no imports" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(B) @keyword");
    assert index_of(&out, "fn run") == -1, out;
    assert index_of(&out, "use ") == -1, out;
}

test "a rule capture restates an earlier override on the same rule" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)\n(r) @keyword");
    assert index_of(&out, "string") == -1, out;
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_R as i32, capture_id: 0, order: 0 },  // @keyword") == 1, out;
}

test "an override on a kind a rule capture covers takes the capture's order" {
    let out = highlight_output_q("grammar T;
r : name ;
name : IDENTIFIER ;
IDENTIFIER : [a-z]+ ;
", "(name) @variable\n(name (IDENTIFIER) @type)");
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_NAME as i32, capture_id: 0, order: 0 },  // @type") == 1, out;
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_NAME as i32, capture_id: 1, order: 0 },  // @variable") == 1, out;
}

test "rule capture follows a rule that delegates to a naming rule" {
    // A grammar wraps a naming rule once per use site so a query can capture
    // that site alone (`fieldName : memberName` in `Wado.g4`). The wrapper
    // accepts what it delegates to, so the capture covers the same tokens.
    let out = highlight_output_q("grammar T;
r : field ;
field : name ;
name : IDENTIFIER | 'test' | 'task' ;
IDENTIFIER : [a-z]+ ;
", "(field) @property");
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_FIELD as i32") == 1, out;
}

test "rule capture follows a delegation chain as long as the grammar makes it" {
    let out = highlight_output_q("grammar T;
r : a ;
a : b ;
b : c ;
c : d ;
d : e ;
e : name ;
name : IDENTIFIER | 'test' ;
IDENTIFIER : [a-z]+ ;
", "(a) @property");
    assert count_occurrences(&out, "RuleCapture { rule_id: RK_A as i32") == 1, out;
}

test "rule capture on a delegation cycle warns instead of recurring forever" {
    assert_capture_refused(&highlight_run("grammar T;
r : a ;
a : b ;
b : a ;
IDENTIFIER : [a-z]+ ;
", "(a) @variable"));
}

test "rule capture on a multi-token rule warns instead of half-covering it" {
    assert_capture_refused(&highlight_run("grammar T;
r : pair ;
pair : IDENTIFIER IDENTIFIER ;
IDENTIFIER : [a-z]+ ;
", "(pair) @variable"));
}

test "query override emits a row under its token kind" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)");
    assert index_of(
        &out,
        "[  // TK_B\n            RuleCapture { rule_id: RK_R as i32, capture_id: 0, order: 0 },  // @string\n        ],",
    ) >= 0, out;
    assert index_of(&out, "rule_captures: [],") >= 0, out;
}

test "default on a named token the parser also writes inline maps that token" {
    let out = highlight_output_q("grammar T;
r : '(' B ')' ;
B : 'b' ;
LP : '(' ;
RP : ')' ;
", "(LP) @punctuation.bracket");
    assert index_of(&out, "0,  // TK_LP @punctuation.bracket") >= 0, out;
}

test "default on an action-bearing named token the parser also writes inline" {
    let out = highlight_output_q("grammar T;
options { language = Wado; }
r : '(' B ')' ;
B : 'b' ;
LP : '(' { lx.count += 1 } ;
RP : ')' ;
", "(LP) @punctuation.bracket");
    assert index_of(&out, "0,  // TK_LP @punctuation.bracket") >= 0, out;
    assert index_of(&out, "TK_LIT_LP") < 0, out;
}

test "later override for the same rule and token wins (last-wins)" {
    let out = highlight_output_q("grammar T;
r : B ;
B : 'b' ;
", "(r (B) @string)
(r (B) @keyword)");
    assert count_occurrences(&out, "RuleCapture {") == 1, out;
    assert index_of(&out, "// @keyword") >= 0, out;
    assert index_of(&out, "string") == -1, out;
}

test "unknown token in query warns via ctx diagnostics" {
    let g = parse_grammar("grammar T;
r : B ;
B : 'b' ;
");
    let lits = collect_literal_tokens(&g.parser_rules);
    let query = parse_highlight_query("(NOPE) @keyword").unwrap();
    let mut ctx = GenContext::new(&g.parser_rules, &lits);
    let mut w = CodeWriter::new();
    gen_highlight(&mut w, &g, &lits, &query, &mut ctx);
    let diags = ctx.copy_diagnostics();
    assert diags.len() == 1, `expected one diagnostic, got ${diags.len()}`;
    assert diags[0].message.contains("unknown token"), diags[0].message;
}

test "unknown parser rule in an override warns via ctx diagnostics" {
    let g = parse_grammar("grammar T;
r : B ;
B : 'b' ;
");
    let lits = collect_literal_tokens(&g.parser_rules);
    let query = parse_highlight_query("(nope (B) @string)").unwrap();
    let mut ctx = GenContext::new(&g.parser_rules, &lits);
    let mut w = CodeWriter::new();
    gen_highlight(&mut w, &g, &lits, &query, &mut ctx);
    let diags = ctx.copy_diagnostics();
    assert diags.len() == 1, `expected one diagnostic, got ${diags.len()}`;
    assert diags[0].message.contains("unknown parser rule"), diags[0].message;
}

test "capture_vocabulary lists the query's distinct capture classes, sorted" {
    let out = highlight_output_q(
        "grammar T; s : KW STR KW ; KW : 'if' ; STR : '\"' ~[\"]* '\"' ;",
        "(KW) @keyword\n(STR) @string\n",
    );
    assert index_of(&out, "capture_names: [\n        \"keyword\",\n        \"string\",\n    ],") >= 0, out;
    assert index_of(
        &out,
        "pub fn capture_vocabulary() -> List<String> {\n    return HIGHLIGHT_MAPPING.capture_names;\n}",
    ) >= 0, out;
}

test "capture_vocabulary lists a capture shared by two selectors once" {
    let out = highlight_output_q(
        "grammar T; s : KW ID ; KW : 'if' ; ID : [a-z]+ ;",
        "(KW) @keyword\n(ID) @keyword\n",
    );
    assert index_of(&out, "capture_names: [\n        \"keyword\",\n    ],") >= 0, out;
}

test "capture_vocabulary is empty without a highlight query" {
    let out = highlight_output("grammar T; s : KW ; KW : 'if' ;");
    assert index_of(&out, "capture_names: [],") >= 0, out;
}
