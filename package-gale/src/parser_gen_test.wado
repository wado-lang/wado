//! White-box tests for `parser_gen` emitters that are unreachable
//! through the public `generate()` API today but guard latent codegen
//! hazards.

use { gen_alt_scan_fn } from "./parser_gen.wado";
use { GenContext } from "./gen_context.wado";
use { Alternative, ParserRule, Visibility } from "./ir.wado";
use { CodeWriter } from "lib:wadopoet";
use { ScanBody, ScanElement, ScanTokenElement, ScanRuleCallElement, FollowArg } from "./gir.wado";

/// `r` is registered left-recursive: only then does `scan_r` take `min_prec`.
/// Its two alternatives keep its scan a call rather than an inlined token test.
fn lr_ctx() -> GenContext {
    let rules: List<ParserRule> = [
        ParserRule::new("r", Visibility::Default, [], [
            Alternative::new([]),
            Alternative::new([]),
        ]),
    ];
    let mut ctx = GenContext::new(&rules, &[]);
    ctx.set_lr_rule_snakes(&(["r"] as List<String>));
    return ctx;
}

fn self_ref_call(min_prec_arg: Option<i32>) -> ScanElement {
    return ScanElement::RuleCall(ScanRuleCallElement {
        target_snake: "r",
        follow_arg: FollowArg::NoFollow,
        min_prec_arg,
    });
}

// The alt scan reads the precedence lowering stamped and nothing else: a
// trailing self-ref is not special, so a prefix operand climbs exactly as
// far as its parse twin.
test "alt-scan passes a self-ref's stamped min_prec verbatim" {
    let mut ctx = lr_ctx();
    let mut w = CodeWriter::new();
    let elements: List<ScanElement> = [
        ScanElement::Token(ScanTokenElement { kind: "TK_X" }),
        self_ref_call(null),
        self_ref_call(Option::Some(15)),
    ];
    gen_alt_scan_fn(&mut w, "scan_r_alt_0", &ScanBody { elements }, 0, &mut ctx);
    let out = w.to_string();

    assert out.contains("scan_r(tokens, pos, 0)"), `an unstamped self-ref climbs from 0: ${out}`;
    assert out.contains("scan_r(tokens, pos, 15)"), `a stamped self-ref climbs from its stamp: ${out}`;
}
