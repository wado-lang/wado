//! java2wado — translate the Java subset in ANTLR action bodies to Wado, so
//! `language = Java` grammars execute their actions. Facade over the
//! `ActionLanguage` dispatcher; the Java front end lives in `java2wado/`. It
//! reuses the identity translator (`action_translate.wado`) for `$`-leaves. A
//! body outside the supported subset is a loud diagnostic, never a silent no-op.

use {
    ParserRule,
    Grammar,
    ActionLanguage,
    AttrDecl,
    LexerRule,
    LexerAlternative,
    LexerElement,
    LexerRepeatElement,
    LexerNotElement,
    AltAction,
    Alternative,
    Element,
    NamedAction,
    GrammarKind,
} from "./ir.wado";
use { map_java_type } from "./java2wado/jemit.wado";
use { translate_wado_action, LEXER_HANDLE, PARSER_HANDLE } from "./action_translate.wado";
use {
    translate_java_expr,
    translate_java_stmts,
    translate_java_lexer_expr,
    translate_java_lexer_stmts,
    JEnv,
} from "./java2wado/jemit.wado";
use { translate_java_members, java_member_method_names, MemberDecls } from "./java2wado/jmembers.wado";
use { translate_wado_members } from "./wado_members.wado";

/// Translate an action body to Wado: `Wado` routes to the identity translator,
/// `Java` to java2wado, any other language is a loud error. `grammar_name` and
/// `member_methods` let the Java front end resolve method calls / token constants.
pub fn translate_action(
    lang: &ActionLanguage,
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    grammar_name: &String,
    member_methods: &List<String>,
) -> Result<String, String> {
    return match lang {
        Wado => translate_wado_action(rule, rules, body, vals_in_scope, bindings),
        Java => {
            let env = JEnv { this_bind: PARSER_HANDLE, grammar: *grammar_name, methods: *member_methods };
            translate_java_stmts(rule, rules, body, vals_in_scope, bindings, &env);
        },
        Other(name) => Result::Err(`unsupported action language '${*name}' for action '${*body}'`),
    };
}

/// Translate a semantic-predicate body (`{ cond }?`) to a Wado boolean
/// expression, dispatching on the action language as `translate_action` does.
pub fn translate_predicate(
    lang: &ActionLanguage,
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
    grammar_name: &String,
    member_methods: &List<String>,
) -> Result<String, String> {
    return match lang {
        Wado => translate_wado_action(rule, rules, body, vals_in_scope, bindings),
        Java => {
            let env = JEnv { this_bind: PARSER_HANDLE, grammar: *grammar_name, methods: *member_methods };
            translate_java_expr(rule, rules, body, vals_in_scope, bindings, &env);
        },
        Other(name) => Result::Err(`unsupported action language '${*name}' for predicate '${*body}'`),
    };
}

/// Rewrite every `language = Java` lexer action / predicate body in place into
/// its Wado form, so `lexer_gen`'s identity translator emits it unchanged — the
/// same staging the superClass call rewrite uses, which keeps the emitters free
/// of an action-language parameter. A body outside the java2wado subset is
/// dropped (so codegen never emits Java text) and reported, never silently kept.
pub fn rewrite_lexer_java_bodies(
    grammar: &mut Grammar,
    member_methods: &List<String>,
    member_fields: &List<String>,
) -> List<String> {
    let mut errors: List<String> = [];
    let env = lexer_env(&grammar.name, member_methods, member_fields);
    for let rule of &mut grammar.lexer_rules {
        for let alt of &mut rule.body {
            rewrite_lexer_java_alt(alt, &env, &mut errors);
        }
    }
    return errors;
}

fn rewrite_lexer_java_alt(alt: &mut LexerAlternative, env: &JEnv, errors: &mut List<String>) {
    let mut kept: List<AltAction> = [];
    for let a of &alt.actions {
        let translated = if a.kind matches { Predicate } {
            translate_java_lexer_expr(&a.source.text, env);
        } else {
            translate_java_lexer_stmts(&a.source.text, env);
        };
        match translated {
            Ok(text) => {
                let mut kept_action = *a;
                kept_action.source.text = text;
                kept.push(kept_action);
            },
            Err(msg) => {
                errors.push(`{ ${a.source.text} }: ${msg}`);
            },
        }
    }
    alt.actions = kept;
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        alt.elements[i] = rewrite_lexer_java_elem(&alt.elements[i], env, errors);
    }
}

fn rewrite_lexer_java_elem(elem: &LexerElement, env: &JEnv, errors: &mut List<String>) -> LexerElement {
    return match elem {
        Group(alts) => {
            let mut new_alts: List<LexerAlternative> = [];
            for let alt of alts {
                let mut a = *alt;
                rewrite_lexer_java_alt(&mut a, env, errors);
                new_alts.push(a);
            }
            LexerElement::Group(new_alts);
        },
        Repeat(rep) => LexerElement::Repeat(LexerRepeatElement {
            kind: rep.kind,
            element: rewrite_lexer_java_elem(&rep.element, env, errors),
            non_greedy: rep.non_greedy,
        }),
        Not(nn) => LexerElement::Not(LexerNotElement { element: rewrite_lexer_java_elem(&nn.element, env, errors) }),
        _ => *elem,
    };
}

fn lexer_env(grammar_name: &String, member_methods: &List<String>, member_fields: &List<String>) -> JEnv {
    return JEnv {
        this_bind: LEXER_HANDLE,
        grammar: *grammar_name,
        methods: *member_methods,
        lexer: true,
        fields: *member_fields,
    };
}

/// The snake_cased method names the grammar's `@lexer::members` blocks declare,
/// so a lexer action / predicate can resolve `this.m()` and bare `m()` calls.
pub fn collect_lexer_member_method_names(grammar: &Grammar) -> List<String> {
    let mut names: List<String> = [];
    for let act of &grammar.named_actions {
        if !is_lexer_members(act, &grammar.kind) {
            continue;
        }
        for let n of &java_member_method_names(&act.body.text) {
            names.push(*n);
        }
    }
    return names;
}

pub fn translate_members(lang: &ActionLanguage, body: &String, grammar_name: &String) -> Result<MemberDecls, String> {
    return match lang {
        Java => translate_java_members(body, grammar_name),
        Wado => translate_wado_members(body),
        Other(name) => Result::Err(`unsupported action language '${*name}' for @members`),
    };
}

pub fn is_parser_members(act: &NamedAction, kind: &GrammarKind) -> bool {
    if act.name != "members" {
        return false;
    }
    return match &act.scope {
        Some(s) => *s == "parser",
        None => !kind matches { Lexer },
    };
}

pub fn is_lexer_members(act: &NamedAction, kind: &GrammarKind) -> bool {
    if act.name != "members" {
        return false;
    }
    return match &act.scope {
        Some(s) => *s == "lexer",
        None => kind matches { Lexer },
    };
}

/// The snake_cased method names the grammar's `@members` blocks declare, so
/// action / predicate bodies can resolve `this.m()` and bare `m()` calls against
/// real methods rather than snake_casing anything.
pub fn collect_member_method_names(grammar: &Grammar) -> List<String> {
    let mut names: List<String> = [];
    for let act of &grammar.named_actions {
        if !is_parser_members(act, &grammar.kind) {
            continue;
        }
        for let n of &java_member_method_names(&act.body.text) {
            names.push(*n);
        }
    }
    return names;
}

/// Whether the grammar declares `options { superClass = ... }`. Its actions call
/// a hand-written base class outside the `.g4` that Gale cannot see — Phase 4,
/// carved out of the Java emit-actions rollout. See `action.md`.
pub fn grammar_has_superclass(grammar: &Grammar) -> bool {
    for let o of &grammar.options {
        if o.name == "superClass" {
            return true;
        }
    }
    return false;
}

/// Whether java2wado can emit the grammar's non-superClass action bodies:
/// `Wado` always, `Java` unless the grammar declares `superClass`. A
/// superClass grammar's lexer `this.m()` calls lower to the base effect
/// interface independently (see `superclass.wado` and `emit_actions` in
/// codegen); its parser-side actions stay carved out here (parser superClass
/// is not wired yet). Other languages stay discarded.
pub fn action_language_is_emittable(grammar: &Grammar) -> bool {
    return grammar.action_language matches { Wado }
        || grammar.action_language matches { Java } && !grammar_has_superclass(grammar);
}

/// Whether the grammar carries any action content: a named action, a rule
/// prequel or value channel (args/returns/locals), or a per-alt action.
fn grammar_has_actions(grammar: &Grammar) -> bool {
    for let na of &grammar.named_actions {
        if na.body.text != "" {
            return true;
        }
    }
    for let r of &grammar.parser_rules {
        if r.init_action matches { Some(_) } || r.after_action matches { Some(_) } {
            return true;
        }
        if !r.args.is_empty() || !r.returns_decls.is_empty() || !r.locals_decls.is_empty() {
            return true;
        }
        for let alt of &r.alternatives {
            if alt_has_actions(alt) {
                return true;
            }
        }
    }
    for let lr of &grammar.lexer_rules {
        for let alt of &lr.body {
            if lexer_alt_has_actions(alt) {
                return true;
            }
        }
    }
    return false;
}

/// Whether an alternative carries any action / predicate, including ones nested
/// inside its group elements. A top-level-only check misses a grammar whose
/// only action sits in a group (`r : ( {p}? A | B )`), leaving `emit_actions`
/// off so the whole action pipeline — including the `warn_unhandled_actions`
/// safety net — never runs and the body vanishes with no diagnostic.
fn alt_has_actions(alt: &Alternative) -> bool {
    if !alt.actions.is_empty() {
        return true;
    }
    for let e of &alt.elements {
        if element_has_actions(e) {
            return true;
        }
    }
    return false;
}

fn element_has_actions(elem: &Element) -> bool {
    match *elem {
        Group(g) => {
            for let alt of &g.alternatives {
                if alt_has_actions(alt) {
                    return true;
                }
            }
        },
        Repeat(rep) => {
            return element_has_actions(&rep.element);
        },
        Label(lab) => {
            return element_has_actions(&lab.element);
        },
        Not(n) => {
            return element_has_actions(&n.element);
        },
        _ => {
        },
    }
    return false;
}

/// Lexer analog of `alt_has_actions`: a lexer predicate / action can sit inside
/// a group (`KW : ([a-z]+ {p}? | 'dog')`), so a top-level-only check misses it
/// and leaves `emit_actions` off, dropping the predicate silently.
fn lexer_alt_has_actions(alt: &LexerAlternative) -> bool {
    if !alt.actions.is_empty() {
        return true;
    }
    for let e of &alt.elements {
        if lexer_element_has_actions(e) {
            return true;
        }
    }
    return false;
}

fn lexer_element_has_actions(elem: &LexerElement) -> bool {
    match *elem {
        Group(alts) => {
            for let alt of &alts {
                if lexer_alt_has_actions(alt) {
                    return true;
                }
            }
        },
        Repeat(rep) => {
            return lexer_element_has_actions(&rep.element);
        },
        Not(n) => {
            return lexer_element_has_actions(&n.element);
        },
        _ => {
        },
    }
    return false;
}

/// Whether codegen emits the action machinery: the language is emittable AND the
/// grammar has action content. Gates `emit_actions` and the ctx-tree token table
/// so an actionless grammar stays byte-identical to before Stage C.
/// Translate `returns` / `locals` / arg attribute types from the host language
/// to Wado (`int` → `i32`, `boolean` → `bool`, …) so the value-channel vals
/// struct emits valid Wado field types and `wado_type_default` recognises them.
/// A no-op for non-Java grammars and for types already Wado (or unmapped, e.g.
/// `List<String>`), which pass through unchanged.
pub fn translate_attr_types(grammar: &mut Grammar) {
    if !grammar.action_language matches { Java } {
        return;
    }
    for let mut i = 0; i < grammar.parser_rules.len(); i += 1 {
        translate_decl_types(&mut grammar.parser_rules[i].args);
        translate_decl_types(&mut grammar.parser_rules[i].returns_decls);
        translate_decl_types(&mut grammar.parser_rules[i].locals_decls);
    }
}

fn translate_decl_types(decls: &mut List<AttrDecl>) {
    for let mut i = 0; i < decls.len(); i += 1 {
        if let Some(w) = map_java_type(&decls[i].type_text) {
            decls[i].type_text = w;
        }
    }
}

pub fn should_emit_actions(grammar: &Grammar) -> bool {
    return action_language_is_emittable(grammar) && grammar_has_actions(grammar);
}
