//! java2wado — translate the Java subset that appears in ANTLR action bodies
//! to Wado, so `language = Java` grammars execute their actions. Facade over
//! the `ActionLanguage` dispatcher; the Java front end (lexer / parser / emit)
//! lands in `java2wado/` per the staging in `java2wado.md`.
//!
//! The identity translator (`action_translate.wado`, `language = Wado`) already
//! resolves `$`-attributes and substitutes them over the value channel; Java
//! translation reuses that engine for the `$`-leaves and adds a Java host-code
//! front end around them (`java2wado/`). A body outside the supported subset is
//! a loud generation diagnostic, never a silent no-op.

use { ParserRule, Grammar, ActionLanguage } from "./ir.wado";
use { translate_wado_action, PARSER_HANDLE } from "./action_translate.wado";
use { translate_java_expr, translate_java_stmts } from "./java2wado/jemit.wado";
use { translate_java_members, MemberDecls } from "./java2wado/jmembers.wado";

/// Translate an action / predicate body to Wado under the grammar's action
/// language. `language = Wado` routes to the identity translator (verbatim host
/// text, `$`-refs substituted); `language = Java` routes to java2wado; any other
/// language is unsupported. A failure names the offending body — codegen turns
/// it into a diagnostic rather than emitting invalid code.
pub fn translate_action(
    lang: &ActionLanguage,
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
) -> Result<String, String> {
    return match lang {
        Wado => translate_wado_action(rule, rules, body, vals_in_scope, bindings),
        Java => translate_java_stmts(rule, rules, body, vals_in_scope, bindings, &PARSER_HANDLE),
        Other(name) => Result::Err(`unsupported action language '{*name}' for action '{*body}'`),
    };
}

/// Translate a semantic-predicate body (`{ cond }?`) to a Wado boolean
/// expression. `language = Wado` substitutes `$`-refs verbatim; `language =
/// Java` parses the Java expression and re-emits it (java2wado). A predicate is
/// a single expression, so this is the java2wado expression front end.
pub fn translate_predicate(
    lang: &ActionLanguage,
    rule: &ParserRule,
    rules: &List<ParserRule>,
    body: &String,
    vals_in_scope: bool,
    bindings: &List<[bool, String, String]>,
) -> Result<String, String> {
    return match lang {
        Wado => translate_wado_action(rule, rules, body, vals_in_scope, bindings),
        Java => translate_java_expr(rule, rules, body, vals_in_scope, bindings, &PARSER_HANDLE),
        Other(name) => Result::Err(`unsupported action language '{*name}' for predicate '{*body}'`),
    };
}

/// Translate a `@members` / `@parser::members` block to Wado struct fields +
/// methods. `language = Java` parses the class body (java2wado); Wado members
/// (module-level Wado) are a later item.
pub fn translate_members(lang: &ActionLanguage, body: &String) -> Result<MemberDecls, String> {
    return match lang {
        Java => translate_java_members(body),
        Wado => Result::Err("java2wado: Wado @members translation is not yet implemented"),
        Other(name) => Result::Err(`unsupported action language '{*name}' for @members`),
    };
}

/// Whether the grammar declares `options { superClass = ... }`. Such a grammar's
/// actions call a hand-written base class living outside the `.g4`, which Gale
/// cannot see — translating them is Phase 4 (the SuperClass trait), not
/// java2wado's subset. The Java emit-actions rollout carves these out. See
/// `java2wado.md`.
pub fn grammar_has_superclass(grammar: &Grammar) -> bool {
    for let o of &grammar.options {
        if o.name == "superClass" {
            return true;
        }
    }
    return false;
}

/// Whether Gale can emit the grammar's action bodies: the identity translator
/// handles `language = Wado`; java2wado handles `language = Java` unless the
/// grammar declares `superClass` (its actions call a hand-written base class
/// outside the `.g4` — Phase 4, the SuperClass trait). Other host languages
/// stay discarded. Codegen gates action emission and the ctx-tree token table
/// on this predicate.
pub fn action_language_is_emittable(grammar: &Grammar) -> bool {
    return grammar.action_language matches { Wado }
        || grammar.action_language matches { Java } && !grammar_has_superclass(grammar);
}
