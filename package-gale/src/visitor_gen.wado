use {
    Grammar,
    ParserRule,
    Alternative,
    Element,
    RepeatElement,
    LabelElement,
    RepeatKind,
} from "./ir.wado";
use { to_snake_case, to_pascal_case, to_lower, rule_type_name, literal_field_name, strip_suffix } from "./gen_util.wado";
use { group_can_store, group_alt_case_info } from "./generator.wado";
use { CodeWriter } from "./wadopoet.wado";

/// Generate Visitor walk functions and to_tree for a grammar.
pub fn gen_visitor(w: &mut CodeWriter, grammar: &Grammar) {
    for let rule of &grammar.parser_rules {
        gen_walk_fn(w, rule);
    }
    gen_to_tree_fn(w, grammar);
}

fn gen_walk_fn(w: &mut CodeWriter, rule: &ParserRule) {
    let type_name = rule_type_name(&rule.name);
    w.begin(&`pub fn walk_{rule.name}<V: Visitor>(v: &mut V, node: &{type_name})`);

    if rule.alternatives.len() == 1 {
        w.line(`v.enter_rule(&"{rule.name}", &node.span);`);
        gen_walk_alt_body(w, &rule.alternatives[0], "node");
        w.line(`v.exit_rule(&"{rule.name}", &node.span);`);
    } else {
        let all_labeled = all_alternatives_labeled(&rule.alternatives);
        w.begin("match node");
        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{i}` };
            w.begin(`{case_name}(n) =>`);
            w.line(`v.enter_rule(&"{rule.name}", &n.span);`);
            gen_walk_alt_body(w, alt, "n");
            w.line(`v.exit_rule(&"{rule.name}", &n.span);`);
            w.end();
        }
        w.end();  // match
    }

    w.end();  // fn
    w.blank();
}

fn gen_walk_alt_body(w: &mut CodeWriter, alt: &Alternative, var: &String) {
    let fields = collect_walk_fields(&alt.elements);
    for let field of &fields {
        gen_walk_field(w, field, var);
    }
}

fn gen_walk_field(w: &mut CodeWriter, field: &WalkField, var: &String) {
    let name = &field.name;
    match field.wrapper {
        Direct => {
            if let WalkGroup(alts) = &field.action {
                gen_walk_group_inline(w, &`&{var}.{name}`, alts);
            } else if let WalkRule(rule_name) = &field.action {
                w.line(`walk_{rule_name}(v, &{var}.{name});`);
            } else {
                w.line(`v.visit_token(&{var}.{name});`);
            }
        },
        ArrayWrap => {
            w.begin(`for let item of &{var}.{name}`);
            if let WalkGroup(alts) = &field.action {
                gen_walk_group_inline(w, &"item", alts);
            } else if let WalkRule(rule_name) = &field.action {
                w.line(`walk_{rule_name}(v, item);`);
            } else {
                w.line("v.visit_token(item);");
            }
            w.end();
        },
        OptionalWrap => {
            w.begin(`if let Some(item) = &{var}.{name}`);
            if let WalkGroup(alts) = &field.action {
                gen_walk_group_inline(w, &"item", alts);
            } else if let WalkRule(rule_name) = &field.action {
                w.line(`walk_{rule_name}(v, item);`);
            } else {
                w.line("v.visit_token(item);");
            }
            w.end();
        },
    }
}

fn gen_walk_group_inline(w: &mut CodeWriter, expr: &String, alts: &Array<Alternative>) {
    if alts.len() == 1 {
        w.line(`let grp_ref = {*expr};`);
        let fields = collect_walk_fields(&alts[0].elements);
        for let f of &fields {
            gen_walk_field(w, f, &"grp_ref");
        }
        return;
    }
    w.begin(`match {expr}`);
    for let mut i = 0; i < alts.len(); i += 1 {
        let ci = group_alt_case_info(&alts[i], i);
        w.begin(`{ci.0}(grp) =>`);
        // For single-RuleRef alts, grp IS the node — call walk directly
        if alts[i].elements.len() == 1 {
            if let RuleRef(rname) = alts[i].elements[0] {
                w.line(`walk_{rname}(v, grp);`);
            } else {
                w.line("v.visit_token(grp);");
            }
        } else {
            let fields = collect_walk_fields(&alts[i].elements);
            for let f of &fields {
                gen_walk_field(w, f, &"grp");
            }
        }
        w.end();
    }
    w.end();
}

fn gen_to_tree_fn(w: &mut CodeWriter, grammar: &Grammar) {
    if grammar.parser_rules.is_empty() { return; }
    let root_rule = &grammar.parser_rules[0];
    let root_type = rule_type_name(&root_rule.name);

    w.begin(&`pub fn to_tree(node: &{root_type}) -> CstNode`);
    w.line("let mut recorder = TreeRecorder::new();");
    w.line(`walk_{root_rule.name}(&mut recorder, node);`);
    w.line("return recorder.build();");
    w.end();
    w.blank();
}

variant WalkAction {
    VisitToken,
    WalkRule(String),
    WalkGroup(Array<Alternative>),
}

enum WalkWrapper {
    Direct,
    ArrayWrap,
    OptionalWrap,
}

struct WalkField {
    name: String,
    action: WalkAction,
    wrapper: WalkWrapper,
}

fn collect_walk_fields(elements: &Array<Element>) -> Array<WalkField> {
    let mut fields: Array<WalkField> = [];
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        if let Some(field) = element_to_walk_field(&elem) {
            let base_name = field.name;
            let count = get_name_count(&name_counts, &base_name);
            increment_name_count(&mut name_counts, &base_name);
            let final_name = if count > 0 { `{base_name}_{count + 1}` } else { base_name };
            fields.append(WalkField { name: final_name, action: field.action, wrapper: field.wrapper });
        }
    }
    return fields;
}

fn element_to_walk_field(elem: &Element) -> Option<WalkField> {
    if let RuleRef(name) = *elem {
        return Option::Some(WalkField {
            name: to_snake_case(&name),
            action: WalkAction::WalkRule(name),
            wrapper: WalkWrapper::Direct,
        });
    }
    if let TokenRef(name) = *elem {
        return Option::Some(WalkField {
            name: to_lower(&name),
            action: WalkAction::VisitToken,
            wrapper: WalkWrapper::Direct,
        });
    }
    if let Literal(text) = *elem {
        return Option::Some(WalkField {
            name: literal_field_name(&text),
            action: WalkAction::VisitToken,
            wrapper: WalkWrapper::Direct,
        });
    }
    if let Group(alts) = *elem {
        if group_can_store(&alts) {
            return Option::Some(WalkField {
                name: "group",
                action: WalkAction::WalkGroup(alts),
                wrapper: WalkWrapper::Direct,
            });
        }
        return null;
    }
    if let Repeat(rep) = *elem {
        if let Some(inner) = element_to_walk_field(&rep.element) {
            match rep.kind {
                Star | Plus => {
                    return Option::Some(WalkField {
                        name: `{inner.name}_list`,
                        action: inner.action,
                        wrapper: WalkWrapper::ArrayWrap,
                    });
                },
                Optional => {
                    return Option::Some(WalkField {
                        name: inner.name,
                        action: inner.action,
                        wrapper: WalkWrapper::OptionalWrap,
                    });
                },
            }
        }
        return null;
    }
    if let Label(lab) = *elem {
        if let Some(inner) = element_to_walk_field(&lab.element) {
            return Option::Some(WalkField {
                name: to_snake_case(&lab.name),
                action: inner.action,
                wrapper: inner.wrapper,
            });
        }
        return null;
    }
    return null;
}

fn get_name_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_name_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.append([*name, 1]);
}

fn all_alternatives_labeled(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}
