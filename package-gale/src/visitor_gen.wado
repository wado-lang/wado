use { Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement, RepeatKind } from "./ir.wado";
use {
    to_pascal_case,
    rule_type_name,
    literal_field_name,
    case_names_for_rule,
    is_simple_cst_group,
    is_token_only_group,
    is_single_alt_group,
    is_general_group,
    group_field_base_name,
    general_group_field_name,
    token_group_field_name,
    single_alt_group_field_name,
    count_element_groups,
    not_element_field_name,
} from "./gen_util.wado";
use { CodeWriter } from "./wadopoet.wado";

/// Generate Visitor walk functions and to_tree for a grammar.
pub fn gen_visitor(w: &mut CodeWriter, grammar: &Grammar) {
    for let rule of &grammar.parser_rules {
        gen_walk_fn(w, rule, &rule.name);
    }
    gen_to_tree_fn(w, grammar);
}

fn gen_walk_fn(w: &mut CodeWriter, rule: &ParserRule, rule_name: &String) {
    let type_name = rule_type_name(&rule.name);
    w.begin(&`pub fn walk_{rule.name}<V: Visitor>(v: &mut V, node: &{type_name})`);

    let mut group_counter: i32 = 0;
    if rule.alternatives.len() == 1 {
        w.line(`v.enter_rule(&"{rule.name}", &node.span);`);
        gen_walk_alt_body(w, &rule.alternatives[0], "node", rule_name, &mut group_counter);
        w.line(`v.exit_rule(&"{rule.name}", &node.span);`);
    } else {
        let case_names = case_names_for_rule(&rule.alternatives);
        w.begin("match node");
        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let alt = &rule.alternatives[i];
            w.begin(`{case_names[i]}(n) =>`);
            w.line(`v.enter_rule(&"{rule.name}", &n.span);`);
            gen_walk_alt_body(w, alt, "n", rule_name, &mut group_counter);
            w.line(`v.exit_rule(&"{rule.name}", &n.span);`);
            w.end();
        }
        w.end();  // match
    }

    w.end();  // fn
    w.blank();
}

fn gen_walk_alt_body(w: &mut CodeWriter, alt: &Alternative, var: &String, rule_name: &String, group_counter: &mut i32) {
    let fields = collect_walk_fields(&alt.elements, rule_name, group_counter);
    for let field of &fields {
        gen_walk_field(w, field, var);
    }
}

fn gen_walk_field(w: &mut CodeWriter, field: &WalkField, var: &String) {
    let name = &field.name;
    match field.wrapper {
        Direct => {
            gen_walk_action(w, &field.action, `&{var}.{name}`);
        },
        ArrayWrap => {
            w.begin(`for let item of &{var}.{name}`);
            gen_walk_action(w, &field.action, "item");
            w.end();
        },
        OptionalWrap => {
            w.begin(`if let Some(item) = &{var}.{name}`);
            gen_walk_action(w, &field.action, "item");
            w.end();
        },
    }
}

fn gen_walk_action(w: &mut CodeWriter, action: &WalkAction, expr: &String) {
    match action {
        VisitToken => w.line(`v.visit_token({expr});`),
        WalkRule(rule_name) => w.line(`walk_{rule_name}(v, {expr});`),
        WalkGroup(cases) => gen_walk_group_match(w, expr, cases),
        WalkStruct(fields) => {
            // Strip leading '&' from expr so child gen_walk_field calls
            // can add their own '&' without creating '&&'.
            let mut base = String::with_capacity(expr.len());
            let mut skip = true;
            for let c of expr.chars() {
                if skip && c == '&' {
                    skip = false;
                } else {
                    base.push(c);
                }
            }
            for let f of fields {
                gen_walk_field(w, f, &base);
            }
        },
        WalkGeneralGroup(cases) => gen_walk_general_group_match(w, expr, cases),
    }
}

fn repeat_inner_walk_field(elem: &Element, rule_name: &String, group_counter: &mut i32) -> Option<WalkField> {
    if let Group(g) = elem {
        let alts = &g.alternatives;
        if is_simple_cst_group(alts) {
            let mut cases: Array<GroupCaseInfo> = [];
            for let alt of alts {
                if let RuleRef(r) = &alt.elements[0] {
                    cases.push(GroupCaseInfo {
                        case_name: to_pascal_case(&r.name),
                        rule_name: r.name,
                    });
                }
            }
            return Option::Some(WalkField {
                name: group_field_base_name(alts),
                action: WalkAction::WalkGroup(cases),
                wrapper: WalkWrapper::Direct,
            });
        }
        if is_token_only_group(alts) {
            return Option::Some(WalkField {
                name: token_group_field_name(alts),
                action: WalkAction::VisitToken,
                wrapper: WalkWrapper::Direct,
            });
        }
        if is_single_alt_group(alts) {
            return Option::Some(WalkField {
                name: single_alt_group_field_name(&alts[0]),
                action: build_struct_walk_action(&alts[0], rule_name, group_counter),
                wrapper: WalkWrapper::Direct,
            });
        }
        if is_general_group(alts) {
            let idx = *group_counter;
            *group_counter += 1;
            return Option::Some(WalkField {
                name: general_group_field_name(idx),
                action: build_general_group_walk_action(alts, rule_name, group_counter),
                wrapper: WalkWrapper::Direct,
            });
        }
        // Non-storable group: advance counter for nested general groups
        *group_counter += count_element_groups(elem);
        return null;
    }
    return element_to_walk_field(elem, rule_name, group_counter);
}

fn gen_walk_group_match(w: &mut CodeWriter, expr: &String, cases: &Array<GroupCaseInfo>) {
    w.begin(`match {expr}`);
    for let c of cases {
        w.begin(`{c.case_name}(inner) =>`);
        w.line(`walk_{c.rule_name}(v, inner);`);
        w.end();
    }
    w.end();
}

fn gen_walk_general_group_match(w: &mut CodeWriter, expr: &String, cases: &Array<GeneralGroupCaseInfo>) {
    w.begin(`match {expr}`);
    for let c of cases {
        w.begin(`{c.case_name}(inner) =>`);
        for let f of &c.fields {
            gen_walk_field(w, f, "inner");
        }
        w.end();
    }
    w.end();
}

fn gen_to_tree_fn(w: &mut CodeWriter, grammar: &Grammar) {
    if grammar.parser_rules.is_empty() {
        return;
    }
    let root_rule = &grammar.parser_rules[0];
    let root_type = rule_type_name(&root_rule.name);

    w.begin(&`pub fn to_tree(node: &{root_type}) -> CstNode`);
    w.line("let mut recorder = TreeRecorder::new();");
    w.line(`walk_{root_rule.name}(&mut recorder, node);`);
    w.line("return recorder.build();");
    w.end();
    w.blank();
}

struct GroupCaseInfo {
    case_name: String,
    rule_name: String,
}

struct GeneralGroupCaseInfo {
    case_name: String,
    fields: Array<WalkField>,
}

variant WalkAction {
    VisitToken,
    WalkRule(String),
    WalkGroup(Array<GroupCaseInfo>),
    WalkStruct(Array<WalkField>),
    WalkGeneralGroup(Array<GeneralGroupCaseInfo>),
}

enum WalkWrapper {
    Direct,
    ArrayWrap,
    OptionalWrap,
}

struct WalkField {
    name: String,
    action: WalkAction,
    wrapper: WalkWrapper,
}

fn collect_walk_fields(elements: &Array<Element>, rule_name: &String, group_counter: &mut i32) -> Array<WalkField> {
    let mut fields: Array<WalkField> = [];
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        if let Some(field) = element_to_walk_field(elem, rule_name, group_counter) {
            let base_name = field.name;
            let count = get_name_count(&name_counts, &base_name);
            increment_name_count(&mut name_counts, &base_name);
            let final_name = if count > 0 { `{base_name}_{count + 1}` } else { base_name };
            fields.push(WalkField { name: final_name, action: field.action, wrapper: field.wrapper });
        }
    }
    return fields;
}

fn element_to_walk_field(elem: &Element, rule_name: &String, group_counter: &mut i32) -> Option<WalkField> {
    if let RuleRef(r) = elem {
        return Option::Some(WalkField {
            name: r.field_name,
            action: WalkAction::WalkRule(r.name),
            wrapper: WalkWrapper::Direct,
        });
    }
    if let TokenRef(t) = elem {
        return Option::Some(WalkField {
            name: t.field_name,
            action: WalkAction::VisitToken,
            wrapper: WalkWrapper::Direct,
        });
    }
    if let Literal(l) = elem {
        return Option::Some(WalkField {
            name: literal_field_name(&l.text),
            action: WalkAction::VisitToken,
            wrapper: WalkWrapper::Direct,
        });
    }
    if let Wildcard(_) = elem {
        return Option::Some(WalkField {
            name: "wildcard",
            action: WalkAction::VisitToken,
            wrapper: WalkWrapper::Direct,
        });
    }
    if let Not(ne) = elem {
        return Option::Some(WalkField {
            name: not_element_field_name(&ne.element),
            action: WalkAction::VisitToken,
            wrapper: WalkWrapper::Direct,
        });
    }
    if let Repeat(rep) = elem {
        if let Label(lab) = &rep.element {
            if lab.list {
                return element_to_walk_field(&rep.element, rule_name, group_counter);
            }
        }
        let inner_field = repeat_inner_walk_field(&rep.element, rule_name, group_counter);
        if let Some(inner) = inner_field {
            match rep.kind {
                Star | Plus => {
                    return Option::Some(WalkField {
                        name: `{inner.name}_list`,
                        action: inner.action,
                        wrapper: WalkWrapper::ArrayWrap,
                    });
                },
                Optional => {
                    return Option::Some(WalkField {
                        name: inner.name,
                        action: inner.action,
                        wrapper: WalkWrapper::OptionalWrap,
                    });
                },
            }
        }
        return null;
    }
    if let Label(lab) = elem {
        if let Some(inner) = element_to_walk_field(&lab.element, rule_name, group_counter) {
            let wrapper = if lab.list { WalkWrapper::ArrayWrap } else { inner.wrapper };
            return Option::Some(WalkField {
                name: lab.field_name,
                action: inner.action,
                wrapper,
            });
        }
        return null;
    }
    if let Group(g) = elem {
        let alts = &g.alternatives;
        if is_simple_cst_group(alts) {
            let mut cases: Array<GroupCaseInfo> = [];
            for let alt of alts {
                if let RuleRef(r) = &alt.elements[0] {
                    cases.push(GroupCaseInfo {
                        case_name: to_pascal_case(&r.name),
                        rule_name: r.name,
                    });
                }
            }
            return Option::Some(WalkField {
                name: group_field_base_name(alts),
                action: WalkAction::WalkGroup(cases),
                wrapper: WalkWrapper::OptionalWrap,
            });
        }
        if is_token_only_group(alts) {
            return Option::Some(WalkField {
                name: token_group_field_name(alts),
                action: WalkAction::VisitToken,
                wrapper: WalkWrapper::Direct,
            });
        }
        if is_single_alt_group(alts) {
            return Option::Some(WalkField {
                name: single_alt_group_field_name(&alts[0]),
                action: build_struct_walk_action(&alts[0], rule_name, group_counter),
                wrapper: WalkWrapper::Direct,
            });
        }
        if is_general_group(alts) {
            let idx = *group_counter;
            *group_counter += 1;
            return Option::Some(WalkField {
                name: general_group_field_name(idx),
                action: build_general_group_walk_action(alts, rule_name, group_counter),
                wrapper: WalkWrapper::OptionalWrap,
            });
        }
        // Non-storable group: advance counter for nested general groups
        *group_counter += count_element_groups(elem);
        return null;
    }
    return null;
}

fn build_struct_walk_action(alt: &Alternative, rule_name: &String, group_counter: &mut i32) -> WalkAction {
    let fields = collect_walk_fields(&alt.elements, rule_name, group_counter);
    return WalkAction::WalkStruct(fields);
}

fn build_general_group_walk_action(alts: &Array<Alternative>, rule_name: &String, group_counter: &mut i32) -> WalkAction {
    let gc_before = *group_counter;
    let mut gc_max = gc_before;
    let mut cases: Array<GeneralGroupCaseInfo> = [];
    for let mut i = 0; i < alts.len(); i += 1 {
        let mut gc = gc_before;
        let fields = collect_walk_fields(&alts[i].elements, rule_name, &mut gc);
        if gc > gc_max {
            gc_max = gc;
        }
        cases.push(GeneralGroupCaseInfo {
            case_name: `Alt{i}`,
            fields,
        });
    }
    *group_counter = gc_max;
    return WalkAction::WalkGeneralGroup(cases);
}

fn get_name_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_name_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.push([*name, 1]);
}
