use { Grammar, Alternative } from "./ir.wado";
use {
    LoweredGrammar,
    Rule,
    RuleHeader,
    MultiAltRule,
    LeftRecursiveRule,
    AltBody,
    Op,
    GroupOp,
    rule_header,
} from "./gir.wado";
use { all_alts_are_single_token } from "./gen_util.wado";
use { CodeWriter, FnSpec } from "./wadopoet.wado";

/// Generate Visitor walk functions and `to_tree` for a grammar.
///
/// Driven entirely by GIR (`LoweredGrammar`), the same pre-classified
/// source `gen_cst_types` reads: field names come from each `Op`'s
/// `field` / the `GroupShape`'s `field`, and group/variant case names
/// from `AltBody.case_name`. This keeps the walk in lockstep with the
/// emitted CST structs without a second surface-IR walk or an
/// independent group-counter (whose drift produced non-compiling field
/// names). `grammar` is needed only for the `all_alts_are_single_token`
/// screen, mirroring `gen_cst_types`.
pub fn gen_visitor(w: &mut CodeWriter, lowered: &LoweredGrammar, grammar: &Grammar) {
    for let mut i = 0; i < lowered.parser_rules.len(); i += 1 {
        gen_walk_fn(w, &lowered.parser_rules[i], &grammar.parser_rules[i].alternatives, i);
    }
    gen_to_tree_fn(w, lowered);
}

fn gen_walk_fn(w: &mut CodeWriter, rule: &Rule, surface_alts: &List<Alternative>, rule_id: i32) {
    let header = rule_header(rule);
    let mut f = FnSpec::new(&`walk_{header.name}`);
    f.set_pub();
    f.add_generic(&"V: Visitor");
    f.add_param(&"v", &"&mut V");
    f.add_param(&"node", &`&{header.type_name}`);
    f.emit_begin(w);

    match rule {
        Simple(s) => {
            w.line(&`v.enter_rule({rule_id}, &"{header.name}", &node.span);`);
            gen_walk_ops(w, &s.body.ops, &"node");
            w.line(&`v.exit_rule({rule_id}, &"{header.name}", &node.span);`);
        },
        MultiAlt(m) => gen_walk_multi_alt(w, m, surface_alts, rule_id, header),
        LeftRecursive(l) => gen_walk_lr(w, l, rule_id, header),
    }

    w.end();  // fn
    w.blank();
}

fn gen_walk_multi_alt(
    w: &mut CodeWriter,
    m: &MultiAltRule,
    surface_alts: &List<Alternative>,
    rule_id: i32,
    header: &RuleHeader,
) {
    if all_alts_are_single_token(surface_alts) {
        // Compact single-token node (`gen_multi_alt_cst` single-token path):
        // the node is a `{ span, token }` struct, so the walk visits its one
        // token directly instead of matching N variant arms.
        w.line(&`v.enter_rule({rule_id}, &"{header.name}", &node.span);`);
        w.line(&"v.visit_token(&node.token);");
        w.line(&`v.exit_rule({rule_id}, &"{header.name}", &node.span);`);
        return;
    }
    w.begin(&"match node");
    for let alt of &m.alts {
        w.begin(&`{alt.case_name}(n) =>`);
        w.line(&`v.enter_rule({rule_id}, &"{header.name}", &n.span);`);
        gen_walk_ops(w, &alt.ops, &"n");
        w.line(&`v.exit_rule({rule_id}, &"{header.name}", &n.span);`);
        w.end();
    }
    w.end();  // match
}

fn gen_walk_lr(w: &mut CodeWriter, l: &LeftRecursiveRule, rule_id: i32, header: &RuleHeader) {
    // The CST variant interleaves atom and LR alts by original alt index
    // (see `gen_lr_cst`). Walk them in the same order so the match arms
    // line up with the emitted variant cases.
    let total = l.atom.alts.len() + l.lr_alts.len();
    w.begin(&"match node");
    for let mut idx = 0; idx < total; idx += 1 {
        for let a of &l.atom.alts {
            if a.alt_index == idx {
                w.begin(&`{a.case_name}(n) =>`);
                w.line(&`v.enter_rule({rule_id}, &"{header.name}", &n.span);`);
                gen_walk_ops(w, &a.ops, &"n");
                w.line(&`v.exit_rule({rule_id}, &"{header.name}", &n.span);`);
                w.end();
            }
        }
        for let lr of &l.lr_alts {
            if lr.alt_index == idx {
                w.begin(&`{lr.case_name}(n) =>`);
                w.line(&`v.enter_rule({rule_id}, &"{header.name}", &n.span);`);
                // The LR rewrite stripped the leading self-reference from
                // `suffix.ops`; the CST struct still carries it as the left
                // operand (`prefix_self_ref`), walked via this rule.
                w.line(&`walk_{header.name}(v, &n.{lr.prefix_self_ref.name});`);
                gen_walk_ops(w, &lr.suffix.ops, &"n");
                w.line(&`v.exit_rule({rule_id}, &"{header.name}", &n.span);`);
                w.end();
            }
        }
    }
    w.end();  // match
}

fn gen_walk_ops(w: &mut CodeWriter, ops: &List<Op>, var: &String) {
    for let field of &collect_walk_fields(ops) {
        gen_walk_field(w, field, var);
    }
}

fn gen_walk_field(w: &mut CodeWriter, field: &WalkField, var: &String) {
    let name = &field.name;
    match field.wrapper {
        Direct => {
            gen_walk_action(w, &field.action, &`&{var}.{name}`);
        },
        ArrayWrap => {
            w.begin(&`for let item of &{var}.{name}`);
            gen_walk_action(w, &field.action, &"item");
            w.end();
        },
        OptionalWrap => {
            w.begin(&`if let Some(item) = &{var}.{name}`);
            gen_walk_action(w, &field.action, &"item");
            w.end();
        },
    }
}

fn gen_walk_action(w: &mut CodeWriter, action: &WalkAction, expr: &String) {
    match action {
        VisitToken => w.line(&`v.visit_token({expr});`),
        WalkRule(rule_name) => w.line(&`walk_{rule_name}(v, {expr});`),
        WalkGroup(cases) => gen_walk_group_match(w, expr, cases),
        WalkStruct(fields) => {
            // Strip leading '&' from expr so child gen_walk_field calls
            // can add their own '&' without creating '&&'.
            let mut base = String::with_capacity(expr.len());
            let mut skip = true;
            for let c of expr.chars() {
                if skip && c == '&' {
                    skip = false;
                } else {
                    base.push(c);
                }
            }
            for let f of fields {
                gen_walk_field(w, f, &base);
            }
        },
        WalkGeneralGroup(cases) => gen_walk_general_group_match(w, expr, cases),
    }
}

fn gen_walk_group_match(w: &mut CodeWriter, expr: &String, cases: &List<GroupCaseInfo>) {
    w.begin(&`match {expr}`);
    for let c of cases {
        w.begin(&`{c.case_name}(inner) =>`);
        w.line(&`walk_{c.rule_name}(v, inner);`);
        w.end();
    }
    w.end();
}

fn gen_walk_general_group_match(w: &mut CodeWriter, expr: &String, cases: &List<GeneralGroupCaseInfo>) {
    w.begin(&`match {expr}`);
    for let c of cases {
        w.begin(&`{c.case_name}(inner) =>`);
        for let f of &c.fields {
            gen_walk_field(w, f, &"inner");
        }
        w.end();
    }
    w.end();
}

fn gen_to_tree_fn(w: &mut CodeWriter, lowered: &LoweredGrammar) {
    if lowered.parser_rules.is_empty() {
        return;
    }
    let header = rule_header(&lowered.parser_rules[0]);

    let mut f = FnSpec::new("to_tree");
    f.set_pub();
    f.add_param(&"node", &`&{header.type_name}`);
    f.set_return_type(&"CstNode");
    f.emit_begin(w);
    w.line(&"let mut recorder = TreeRecorder::new();");
    w.line(&`walk_{header.name}(&mut recorder, node);`);
    w.line(&"return recorder.build();");
    w.end();
    w.blank();
}

struct GroupCaseInfo {
    case_name: String,
    rule_name: String,
}

struct GeneralGroupCaseInfo {
    case_name: String,
    fields: List<WalkField>,
}

variant WalkAction {
    VisitToken,
    WalkRule(String),
    WalkGroup(List<GroupCaseInfo>),
    WalkStruct(List<WalkField>),
    WalkGeneralGroup(List<GeneralGroupCaseInfo>),
}

enum WalkWrapper {
    Direct,
    ArrayWrap,
    OptionalWrap,
}

struct WalkField {
    name: String,
    action: WalkAction,
    wrapper: WalkWrapper,
}

/// Walk an op list and produce the visit fields, reading each field name
/// from the op / group shape. A `Transparent` group contributes no field
/// of its own — its single alt's ops inline into the surrounding list.
fn collect_walk_fields(ops: &List<Op>) -> List<WalkField> {
    let mut fields: List<WalkField> = [];
    for let op of ops {
        append_op_walk_fields(op, &mut fields);
    }
    return fields;
}

fn append_op_walk_fields(op: &Op, out: &mut List<WalkField>) {
    match *op {
        Token(t) => out.push(leaf_field(&t.field)),
        Literal(l) => out.push(leaf_field(&l.field)),
        Wildcard(wc) => out.push(leaf_field(&wc.field)),
        Excluded(e) => out.push(leaf_field(&e.field)),
        RuleCall(rc) => out.push(WalkField {
            name: rc.field,
            action: WalkAction::WalkRule(rc.target_name),
            wrapper: WalkWrapper::Direct,
        }),
        Repeat(rep) => {
            if rep.body_has_field {
                let wrapper = match rep.kind {
                    Star | Plus => WalkWrapper::ArrayWrap,
                    Optional => WalkWrapper::OptionalWrap,
                };
                out.push(WalkField { name: rep.field, action: op_walk_action(&rep.body), wrapper });
            }
        },
        ListLabel(ll) => out.push(WalkField {
            name: ll.field,
            action: op_walk_action(&ll.inner),
            wrapper: WalkWrapper::ArrayWrap,
        }),
        Group(g) => append_group_walk_fields(&g, out),
    }
}

fn append_group_walk_fields(g: &GroupOp, out: &mut List<WalkField>) {
    match &g.shape {
        Transparent => {
            if g.alts.len() > 0 {
                for let f of &collect_walk_fields(&g.alts[0].ops) {
                    out.push(*f);
                }
            }
        },
        TokenOnly(sh) => out.push(WalkField {
            name: sh.field,
            action: WalkAction::VisitToken,
            wrapper: WalkWrapper::Direct,
        }),
        SimpleCst(sh) => out.push(WalkField {
            name: sh.field,
            action: WalkAction::WalkGroup(simple_cst_cases(&g.alts)),
            wrapper: WalkWrapper::OptionalWrap,
        }),
        SingleAlt(sh) => out.push(WalkField {
            name: sh.field,
            action: WalkAction::WalkStruct(collect_walk_fields(&g.alts[0].ops)),
            wrapper: WalkWrapper::Direct,
        }),
        General(sh) => out.push(WalkField {
            name: sh.field,
            action: WalkAction::WalkGeneralGroup(general_group_cases(&g.alts)),
            wrapper: WalkWrapper::OptionalWrap,
        }),
    }
}

/// The visit action for an op used as a `Repeat` / `ListLabel` body —
/// the field-name + wrapper come from the enclosing op, so only the
/// inner action is needed here.
fn op_walk_action(op: &Op) -> WalkAction {
    return match *op {
        Token(_) | Literal(_) | Wildcard(_) | Excluded(_) => WalkAction::VisitToken,
        RuleCall(rc) => WalkAction::WalkRule(rc.target_name),
        Group(g) => match &g.shape {
            TokenOnly(_) => WalkAction::VisitToken,
            SimpleCst(_) => WalkAction::WalkGroup(simple_cst_cases(&g.alts)),
            SingleAlt(_) => WalkAction::WalkStruct(collect_walk_fields(&g.alts[0].ops)),
            General(_) => WalkAction::WalkGeneralGroup(general_group_cases(&g.alts)),
            Transparent => WalkAction::WalkStruct(collect_walk_fields(&g.alts[0].ops)),
        },
        Repeat(_) | ListLabel(_) => WalkAction::VisitToken,
    };
}

fn simple_cst_cases(alts: &List<AltBody>) -> List<GroupCaseInfo> {
    let mut cases: List<GroupCaseInfo> = [];
    for let alt of alts {
        // Each SimpleCst alt body is a single `RuleCall` (see
        // `gen_simple_cst_enum_if_new`); the case payload is that rule's CST.
        if let RuleCall(rc) = &alt.ops[0] {
            cases.push(GroupCaseInfo { case_name: alt.case_name, rule_name: rc.target_name });
        }
    }
    return cases;
}

fn general_group_cases(alts: &List<AltBody>) -> List<GeneralGroupCaseInfo> {
    let mut cases: List<GeneralGroupCaseInfo> = [];
    for let alt of alts {
        cases.push(GeneralGroupCaseInfo {
            case_name: alt.case_name,
            fields: collect_walk_fields(&alt.ops),
        });
    }
    return cases;
}

fn leaf_field(name: &String) -> WalkField {
    return WalkField {
        name: *name,
        action: WalkAction::VisitToken,
        wrapper: WalkWrapper::Direct,
    };
}
