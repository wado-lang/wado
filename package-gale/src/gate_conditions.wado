//! The dispatch gate an alt-initial predicate contributes, rendered for the
//! parser or for a scan. Lowering asks whether an alternative is gated to shape
//! its decision; emit renders the same conditions into the dispatch. Both read
//! one answer here, each from the site it stands at.

use { AltAction, Alternative } from "./ir.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { GenSettings } from "./gen_settings.wado";
use { AltBinding } from "./attr_resolve.wado";
use { find_attr_refs } from "./attr_scan.wado";
use { body_is_base_calls_only, body_names_this } from "./superclass.wado";
use { PARSER_HANDLE } from "./ident.wado";
use { and_operand } from "./gen_util.wado";
use { SCAN_GATE_HANDLE, reads_only_scan_gate_fields, scan_gate_condition } from "./scan_gate.wado";
use { translate_predicate } from "./java2wado.wado";

/// Where a predicate's condition is rendered: the rule whose environment it
/// translates in, whether that rule's value channel is in scope, and the
/// alternative's bindings.
///
/// Lowering asks before any value struct or binding exists, so it states a
/// value channel only where the rule declares one and no bindings; emit states
/// what it has emitted. The answer is the same wherever a body reads neither.
pub struct PredicateSite {
    pub rule_index: i32,
    pub vals_in_scope: bool,
    pub bindings: List<AltBinding> = [],
}

/// The dispatch-gate condition an alt-initial predicate contributes, or `null`
/// if it is not gateable. Gateable = `before_index == 0`, a `Predicate` (not an
/// action), and a body that translates in the site's rule: context-independent
/// (no `$` refs) bodies pass through verbatim; context-dependent ones ($local /
/// $ret / token members) translate over the value channel (`$v` → `vals.v`),
/// evaluated at the dispatch where `vals` is in scope. A body the translator
/// cannot emit is not gateable — it falls to the inline guard path. The
/// condition collector and the id-marking pass share this, so the gated set and
/// the emitted conditions cannot diverge.
pub fn gate_condition_for(
    a: &AltAction,
    settings: &GenSettings,
    analysis: &GrammarAnalysis,
    site: &PredicateSite,
    handle: &String = &PARSER_HANDLE,
) -> Option<String> {
    if a.before_index != 0 {
        return null;
    }
    if a.kind matches { Action } {
        return null;
    }
    if body_names_unwired_base(&a.source.text, settings) {
        return null;
    }
    if body_needs_no_translator(&a.source.text, settings) && *handle == PARSER_HANDLE {
        // Extracted to a standalone `pred_<id>(p)` fn (`gen_predicate_fns`), so
        // the dispatch calls it rather than inlining the condition. Only for the
        // parser: the fn takes one, and a scan has none. A scan asks for its own
        // handle and falls through to the translator, which renders against it.
        return Option::Some(`${pred_fn_name(analysis.predicate_fn_id(a.source.action_id))}(p)`);
    }
    let rules = analysis.parser_rules();
    return match translate_predicate(
        &settings.action_language,
        &rules[site.rule_index],
        rules,
        &a.source.text,
        site.vals_in_scope,
        &site.bindings,
        &settings.grammar_name,
        &settings.action_members,
        false,
        handle,
    ) {
        Ok(code) => Option::Some(code),
        Err(_) => null,
    };
}

/// Whether `alt` carries an alt-initial predicate that will reach its emitted
/// arm — for a caller deciding how to shape a dispatch, not emitting one.
///
/// "Will reach" is half the question and lives here rather than at each caller.
/// With actions retained but not emitted the condition renders nothing, so the
/// arm is unconditional and everything behind it dead; a caller that asked only
/// whether the IR carries a predicate would gate on a condition that is never
/// written.
pub fn alt_has_gate(alt: &Alternative, settings: &GenSettings, analysis: &GrammarAnalysis, site: &PredicateSite) -> bool {
    return settings.emit_actions
        && alt.actions.iter_ref().any(|a| gate_condition_for(a, settings, analysis, site) matches { Some(_) });
}

/// An alt's gate conditions rendered against the scan's copy of the members,
/// joined — or `""` when the scan cannot answer them.
///
/// A scan has no parser, so it can only evaluate a condition that reads nothing
/// but simulated fields — or nothing at all, which needs no scan gate. The
/// condition is the dispatch's own, rendered with the handle pointed at the
/// scan gate; whatever names something else — a method, an unsimulated field,
/// the parser — leaves the scan ungated.
pub fn alt_scan_gate_conditions(
    alt: &Alternative,
    settings: &GenSettings,
    analysis: &GrammarAnalysis,
    site: &PredicateSite,
) -> String {
    if !settings.emit_actions {
        return String::new();
    }
    let mut conds: List<String> = [];
    for let a of &alt.actions {
        if a.before_index != 0 || a.kind matches { Action } {
            continue;
        }
        let rendered = match gate_condition_for(a, settings, analysis, site, &SCAN_GATE_HANDLE) {
            Some(c) => c,
            None => {
                return String::new();
            },
        };
        let code = scan_gate_condition(&rendered, &settings.scan_gate_fields);
        if !reads_only_scan_gate_fields(&code, &settings.scan_gate_fields) {
            return String::new();
        }
        conds.push(code);
    }
    if conds.is_empty() {
        return String::new();
    }
    return join_gate_conds(&conds);
}

/// The name of a predicate's standalone fn (`pred_<action_id>`).
pub fn pred_fn_name(id: i32) -> String {
    return `pred_${id}`;
}

/// Whether a Wado body names `this` with no parser base wired to receive it.
/// A Java body's `this` is java2wado's, resolved over `@parser::members`.
pub fn body_names_unwired_base<S: AsStrSlice>(text: S, settings: &GenSettings) -> bool {
    return settings.action_language matches { Wado } && !settings.has_parser_superclass() && body_names_this(text);
}

/// Whether a body is already Wado — written in it, or turned into base calls by
/// the superClass rewrite — and so reads only `p` and constants.
pub fn body_needs_no_translator<S: AsStrSlice>(text: S, settings: &GenSettings) -> bool {
    if find_attr_refs(text).len() != 0 {
        return false;
    }
    return settings.action_language matches { Wado }
        || settings.has_parser_superclass() && body_is_base_calls_only(text, &settings.parser_superclass_name);
}

/// Join predicate conditions into one short-circuit `c0 && c1` guard, each
/// parenthesized only where `&&` would bind to part of it.
pub fn join_gate_conds(conds: &List<String>) -> String {
    return conds.iter_ref().map(|c| and_operand(c)).collect().join(" && ");
}
