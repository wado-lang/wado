use {
    Grammar,
    ParserRule,
    Alternative,
    Element,
    RepeatElement,
    LabelElement,
    RepeatKind,
    LexerRule,
    LexerAlt,
    merge_grammars,
} from "./ir.wado";
use { generate } from "./generator.wado";
use { parse } from "./g4/parser.wado";

test "generate header" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert output.len() > 0;
    let header = "#![generated]\n// Generated by Gale from Test.g4";
    for let mut i = 0; i < header.len(); i += 1 {
        assert output.get_byte(i) == header.get_byte(i);
    }
}

test "generate token kind" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [],
        lexer_rules: [
            LexerRule::new("NUMBER", false, false, []),
            LexerRule::new("DIGIT", true, false, []),
            LexerRule::new("WS", false, true, []),
        ],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "pub enum TokenKind {");
    assert str_contains(&output, "    NUMBER,");
    assert str_contains(&output, "    WS,");
    assert str_contains(&output, "    Eof,");
    assert str_contains(&output, "    Error,");
    assert !str_contains(&output, "    DIGIT,");
}

test "generate single-alt struct" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [
            ParserRule {
                name: "json",
                alternatives: [
                    Alternative {
                        label: null,
                        elements: [Element::RuleRef("value"), Element::TokenRef("EOF")],
                    },
                ],
            },
        ],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "pub struct JsonNode {");
    assert str_contains(&output, "    pub span: Span,");
    assert str_contains(&output, "    pub value: ValueNode,");
    assert str_contains(&output, "    pub eof: Token,");
}

test "generate multi-alt variant with labels" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [
            ParserRule {
                name: "expr",
                alternatives: [
                    Alternative {
                        label: Option::<String>::Some("BinOp"),
                        elements: [Element::RuleRef("expr"), Element::TokenRef("PLUS"), Element::RuleRef("term")],
                    },
                    Alternative {
                        label: Option::<String>::Some("Pass"),
                        elements: [Element::RuleRef("term")],
                    },
                ],
            },
        ],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "pub variant ExprNode {");
    assert str_contains(&output, "    BinOp(ExprBinOp),");
    assert str_contains(&output, "    Pass(ExprPass),");
    assert str_contains(&output, "pub struct ExprBinOp {");
    assert str_contains(&output, "    pub expr: ExprNode,");
    assert str_contains(&output, "    pub plus: Token,");
    assert str_contains(&output, "    pub term: TermNode,");
    assert str_contains(&output, "pub struct ExprPass {");
}

test "generate multi-alt variant without labels" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [
            ParserRule {
                name: "item",
                alternatives: [
                    Alternative {
                        label: null,
                        elements: [Element::RuleRef("atom")],
                    },
                    Alternative {
                        label: null,
                        elements: [Element::RuleRef("list")],
                    },
                ],
            },
        ],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "pub variant ItemNode {");
    assert str_contains(&output, "    Alt0(ItemAlt0),");
    assert str_contains(&output, "    Alt1(ItemAlt1),");
    assert str_contains(&output, "pub struct ItemAlt0 {");
    assert str_contains(&output, "pub struct ItemAlt1 {");
}

test "generate repeat fields" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [
            ParserRule {
                name: "list",
                alternatives: [
                    Alternative {
                        label: null,
                        elements: [
                            Element::Repeat(RepeatElement {
                                kind: RepeatKind::Star,
                                element: Element::RuleRef("item"),
                                non_greedy: false,
                            }),
                            Element::Repeat(RepeatElement {
                                kind: RepeatKind::Optional,
                                element: Element::TokenRef("COMMA"),
                                non_greedy: false,
                            }),
                        ],
                    },
                ],
            },
        ],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "    pub item_list: Array<ItemNode>,");
    assert str_contains(&output, "    pub comma: Option<Token>,");
}

test "generate duplicate field names" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [
            ParserRule {
                name: "pair",
                alternatives: [
                    Alternative {
                        label: null,
                        elements: [Element::RuleRef("item"), Element::Literal(","), Element::RuleRef("item")],
                    },
                ],
            },
        ],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "    pub item: ItemNode,");
    assert str_contains(&output, "    pub item_2: ItemNode,");
}

test "generate group variant type for repeated group" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [
            ParserRule {
                name: "parse",
                alternatives: [
                    Alternative {
                        label: null,
                        elements: [
                            Element::Repeat(RepeatElement {
                                kind: RepeatKind::Star,
                                element: Element::Group([
                                    Alternative { label: null, elements: [Element::RuleRef("stmt")] },
                                    Alternative { label: null, elements: [Element::RuleRef("error")] },
                                ]),
                                non_greedy: false,
                            }),
                            Element::TokenRef("EOF"),
                        ],
                    },
                ],
            },
        ],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "pub variant StmtOrErrorGroup {");
    assert str_contains(&output, "    Stmt(StmtNode),");
    assert str_contains(&output, "    Error(ErrorNode),");
    assert str_contains(&output, "    pub stmt_or_error_list: Array<StmtOrErrorGroup>,");
}

test "generate standalone group as optional field" {
    let grammar = Grammar {
        name: "Test",
        parser_rules: [
            ParserRule {
                name: "cmd",
                alternatives: [
                    Alternative {
                        label: null,
                        elements: [
                            Element::Group([
                                Alternative { label: null, elements: [Element::RuleRef("foo")] },
                                Alternative { label: null, elements: [Element::RuleRef("bar")] },
                            ]),
                            Element::TokenRef("EOF"),
                        ],
                    },
                ],
            },
        ],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
    };
    let output = generate(&grammar);
    assert str_contains(&output, "pub variant FooOrBarGroup {");
    assert str_contains(&output, "    Foo(FooNode),");
    assert str_contains(&output, "    Bar(BarNode),");
    assert str_contains(&output, "    pub foo_or_bar: Option<FooOrBarGroup>,");
}

fn parse_grammar(input: String) -> Grammar {
    return parse(input).unwrap();
}

test "generate html golden" {
    let lexer_g = parse_grammar(#include_str("../tests/grammars/HTMLLexer.g4"));
    let parser_g = parse_grammar(#include_str("../tests/grammars/HTMLParser.g4"));
    let grammar = merge_grammars([lexer_g, parser_g]);
    let output = generate(&grammar);
    let expected = #include_str("../tests/golden/html.wado");
    assert output == expected, "HTML golden mismatch";
}

