// Post-processing pass that deduplicates large
// `<lhs> matches { TK_X | TK_Y | ... }` token-kind set checks emitted
// by the parser code generator. Frequent / large sets get extracted
// into a single helper function `_gale_kind_set_<id>(k: i32) -> bool`,
// and inline call sites get rewritten to `_gale_kind_set_<id>(<lhs>)`.
//
// The pass is purely textual:
//   1. Scan the generated source for ` matches {` occurrences.
//   2. For each, parse the brace body. If every member is `TK_*`, this
//      is a token-kind set check (other `matches` uses, e.g. variant
//      patterns like `{ Some(_) }`, are skipped).
//   3. Walk backward from the keyword to recover the lhs expression
//      (paren/bracket-balanced; identifier / index / call shapes).
//   4. Aggregate by canonical (sorted) token list and pick a subset of
//      sets to extract by a size × frequency score.
//   5. Rebuild the source: replace extracted occurrences with
//      `_gale_kind_set_<id>(<lhs>)`, and append the helper definitions.
//
// Skipping is safe — a non-extracted occurrence stays as the original
// inline `matches { ... }` form, preserving behaviour exactly.

use { TreeMap } from "core:collections";

struct MatchHit {
    // Position of the first char of the lhs expression (inclusive).
    lhs_start: i32,
    // Position right after the last char of the lhs (i.e. position of
    // the space before "matches").
    lhs_end: i32,
    // Position of the closing `}` of the set body (inclusive).
    body_close: i32,
    // Canonical sorted token list, joined by `|`.
    canonical_key: String,
}

struct ExtractInfo {
    // Helper function id (used to form `_gale_kind_set_<id>`).
    id: i32,
    // Token list (in original first-seen order) for the helper body.
    tokens: Array<String>,
}

pub fn dedup_kind_set_matches(src: &String) -> String {
    let chars = src.chars().collect();
    let hits = scan_match_set_hits(&chars);
    if hits.is_empty() {
        return *src;
    }
    let [extract, helpers] = pick_extracted(&hits);
    if helpers.is_empty() {
        return *src;
    }
    return rebuild(&chars, &hits, &extract, &helpers);
}

/// Walk the source once and collect every `<lhs> matches { TK_X | ... }`
/// occurrence whose body is exclusively token-kind constants.
fn scan_match_set_hits(chars: &Array<char>) -> Array<MatchHit> {
    let mut hits: Array<MatchHit> = [];
    let n = chars.len();
    let mut i: i32 = 0;
    while i + 9 < n {
        if !match_keyword_at(chars, i) {
            i += 1;
            continue;
        }
        // chars[i..i+9] == ' matches {'
        let body_open = i + 9; // position of '{'
        let body_close_opt = find_set_body_close(chars, body_open + 1);
        if let Some(body_close) = body_close_opt {
            let parsed = parse_token_set(chars, body_open + 1, body_close);
            if let Some(tokens) = parsed {
                if let Some([lhs_start, lhs_end]) = scan_lhs_backward(chars, i) {
                    let key = canonical_key(&tokens);
                    hits.push(MatchHit {
                        lhs_start,
                        lhs_end,
                        body_close,
                        canonical_key: key,
                    });
                    i = body_close + 1;
                    continue;
                }
            }
        }
        i += 1;
    }
    return hits;
}

/// True when chars[at..at+9] equals " matches {".
fn match_keyword_at(chars: &Array<char>, at: i32) -> bool {
    if at + 9 > chars.len() {
        return false;
    }
    return chars[at] == ' '
        && chars[at + 1] == 'm'
        && chars[at + 2] == 'a'
        && chars[at + 3] == 't'
        && chars[at + 4] == 'c'
        && chars[at + 5] == 'h'
        && chars[at + 6] == 'e'
        && chars[at + 7] == 's'
        && chars[at + 8] == ' '
        && chars[at + 9] == '{';
}

/// Find the position of `}` that closes a token-kind set body.
/// Bodies of the form `{ TK_A | TK_B | ... }` contain no nested braces,
/// so the first `}` after `{` is the closer. Returns None on malformed
/// input or premature EOF.
fn find_set_body_close(chars: &Array<char>, after_open: i32) -> Option<i32> {
    let n = chars.len();
    let mut i = after_open;
    while i < n {
        let c = chars[i];
        if c == '}' {
            return Option::<i32>::Some(i);
        }
        if c == '{' {
            // Nested brace — not a token-kind set body.
            return null;
        }
        if c == '\n' {
            // Token-kind set bodies are emitted on a single line. A
            // newline inside means this is something else (e.g. a
            // multi-line variant match).
            return null;
        }
        i += 1;
    }
    return null;
}

/// Parse the inside of `{ ... }` at chars[start..end_excl] as a `TK_X | TK_Y | ...`
/// token list. Returns None if any member is not a `TK_`-prefixed identifier.
fn parse_token_set(chars: &Array<char>, start: i32, end_excl: i32) -> Option<Array<String>> {
    let mut tokens: Array<String> = [];
    let mut i = start;
    loop {
        // skip whitespace
        while i < end_excl && (chars[i] == ' ' || chars[i] == '\t') {
            i += 1;
        }
        if i >= end_excl {
            break;
        }
        // expect TK_*
        if !(chars[i] == 'T' && i + 1 < end_excl && chars[i + 1] == 'K' && i + 2 < end_excl && chars[i + 2] == '_') {
            return null;
        }
        let tok_start = i;
        while i < end_excl && is_ident_char(chars[i]) {
            i += 1;
        }
        let tok_end = i;
        if tok_end == tok_start {
            return null;
        }
        tokens.push(slice_to_string(chars, tok_start, tok_end));
        // skip whitespace
        while i < end_excl && (chars[i] == ' ' || chars[i] == '\t') {
            i += 1;
        }
        if i >= end_excl {
            break;
        }
        if chars[i] != '|' {
            return null;
        }
        i += 1;
    }
    if tokens.is_empty() {
        return null;
    }
    return Option::Some(tokens);
}

/// Walk backward from `space_pos` (the position of the space before
/// `matches`) to recover the lhs expression. The lhs is one of these
/// shapes (observed in the generated source): a bare identifier
/// (`kind`, `sgk_4`, ...), a field access (`tokens[pos].kind`,
/// `tokens[pos + 1].kind`), or a call (`p.peek_kind()`, `p.peek_at(1)`).
/// Returns [start, end_excl] (with end_excl == space_pos), or None when
/// the lhs cannot be parsed (e.g. preceded by `!` for the negated form
/// `!(p.peek_kind() matches { ... })` — we leave those alone).
fn scan_lhs_backward(chars: &Array<char>, space_pos: i32) -> Option<[i32, i32]> {
    let mut i = space_pos - 1;
    let lhs_end = space_pos;
    if i < 0 {
        return null;
    }
    let mut depth: i32 = 0;
    while i >= 0 {
        let c = chars[i];
        if c == ']' || c == ')' {
            depth += 1;
            i -= 1;
            continue;
        }
        if c == '[' || c == '(' {
            if depth == 0 {
                // We hit an opener at the outermost level — the lhs
                // starts after this char.
                break;
            }
            depth -= 1;
            i -= 1;
            continue;
        }
        if depth > 0 {
            // Inside brackets: any char is part of the lhs.
            i -= 1;
            continue;
        }
        // depth == 0
        if is_lhs_char(c) {
            i -= 1;
            continue;
        }
        // Non-lhs char at top level: stop.
        break;
    }
    let lhs_start = i + 1;
    if lhs_start >= lhs_end {
        return null;
    }
    // Reject cases where the lhs is preceded by `!` (negated match).
    // We can't simply rewrite `!<lhs> matches {...}` to `!fn(<lhs>)`
    // without introducing a syntactic ambiguity around precedence;
    // they're rare enough to skip.
    if lhs_start > 0 && chars[lhs_start - 1] == '!' {
        return null;
    }
    return Option::Some([lhs_start, lhs_end]);
}

fn is_ident_char(c: char) -> bool {
    return (c >= 'a' && c <= 'z')
        || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9')
        || c == '_';
}

/// Characters that may appear at top level (depth 0) inside an lhs:
/// identifier chars plus `.` for field access. Brackets/parens are
/// handled by the depth tracker in `scan_lhs_backward`.
fn is_lhs_char(c: char) -> bool {
    return is_ident_char(c) || c == '.';
}

fn slice_to_string(chars: &Array<char>, start: i32, end_excl: i32) -> String {
    let mut s = String::with_capacity(end_excl - start);
    for let mut i = start; i < end_excl; i += 1 {
        s.push(chars[i]);
    }
    return s;
}

/// Sort token names lexicographically and join with `|`. Two `matches`
/// expressions that test the same token set (in any order) collapse to
/// the same key.
fn canonical_key(tokens: &Array<String>) -> String {
    let mut sorted = *tokens;
    sorted.sort();
    let mut s = String::with_capacity(64);
    for let mut i = 0; i < sorted.len(); i += 1 {
        if i > 0 {
            s.push('|');
        }
        s.push_str(sorted[i]);
    }
    return s;
}

/// Decide which canonical sets to extract into helper functions.
/// Returns:
///   - extract: TreeMap<canonical_key, helper_id>
///   - helpers: Array<ExtractInfo> ordered by helper_id
fn pick_extracted(hits: &Array<MatchHit>) -> [TreeMap<String, i32>, Array<ExtractInfo>] {
    // Aggregate (count, first-seen tokens, first-seen index) per key.
    let mut counts: TreeMap<String, i32> = TreeMap::<String, i32>::new();
    let mut first_seen_idx: TreeMap<String, i32> = TreeMap::<String, i32>::new();
    let mut first_seen_tokens: TreeMap<String, Array<String>> = TreeMap::<String, Array<String>>::new();
    let mut sizes: TreeMap<String, i32> = TreeMap::<String, i32>::new();
    for let mut i = 0; i < hits.len(); i += 1 {
        let h = &hits[i];
        let key = h.canonical_key;
        if let Some(prev) = counts.get(key) {
            counts[key] = prev + 1;
        } else {
            counts[key] = 1;
            first_seen_idx[key] = i;
            // Reparse the body to recover the original (unsorted) token
            // list. The canonical key is sorted; helper bodies use the
            // sorted form too for determinism.
            let toks = key_to_tokens(&key);
            sizes[key] = toks.len();
            first_seen_tokens[key] = toks;
        }
    }
    // Score each key. We want to extract sets that save bytes:
    // savings ≈ (count - 1) * size * INLINE_BYTES_PER_TOKEN
    //          - HELPER_FN_OVERHEAD
    //          - count * CALL_SITE_OVERHEAD
    // Use a coarse heuristic: extract when size >= 4 AND count >= 2 AND
    // (size * count) >= 12. This catches the SQLite "any keyword"
    // 130×45 case decisively, picks up smaller repeated sets, and
    // skips one-offs / tiny sets.
    let mut extract: TreeMap<String, i32> = TreeMap::<String, i32>::new();
    // (first_seen_idx, key) — emitted in source order so helper IDs are
    // stable / deterministic across runs.
    let mut order: Array<[i32, String]> = [];
    let entries = counts.entries();
    for let entry of &entries {
        let key = entry.0;
        let count = entry.1;
        let size = sizes[key];
        if size >= 4 && count >= 2 && size * count >= 12 {
            order.push([first_seen_idx[key], key]);
        }
    }
    order.sort_by(|a: &[i32, String], b: &[i32, String]| {
        if a.0 < b.0 { return Ordering::Less; }
        if a.0 > b.0 { return Ordering::Greater; }
        return Ordering::Equal;
    });
    let mut helpers: Array<ExtractInfo> = [];
    for let mut i = 0; i < order.len(); i += 1 {
        let key = &order[i].1;
        extract[*key] = i;
        helpers.push(ExtractInfo {
            id: i,
            tokens: first_seen_tokens[*key],
        });
    }
    return [extract, helpers];
}

/// Split a canonical key (`TK_A|TK_B|TK_C`) back into its token list.
fn key_to_tokens(key: &String) -> Array<String> {
    let mut out: Array<String> = [];
    let mut cur = String::with_capacity(16);
    for let c of key.chars() {
        if c == '|' {
            out.push(cur);
            cur = String::with_capacity(16);
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    return out;
}

/// Emit the rewritten source. For each MatchHit, if its key is in
/// `extract`, replace `<lhs> matches { ... }` with
/// `_gale_kind_set_<id>(<lhs>)`. Otherwise copy the original span
/// verbatim. Append helper function definitions at the end.
fn rebuild(chars: &Array<char>, hits: &Array<MatchHit>, extract: &TreeMap<String, i32>, helpers: &Array<ExtractInfo>) -> String {
    let mut out = String::with_capacity(chars.len());
    let mut cursor: i32 = 0;
    for let h of hits {
        if let Some(id) = extract.get(h.canonical_key) {
            // Copy chars[cursor .. h.lhs_start] verbatim.
            for let mut i = cursor; i < h.lhs_start; i += 1 {
                out.push(chars[i]);
            }
            // Emit `_gale_kind_set_<id>(<lhs>)`.
            out.push_str(`_gale_kind_set_{id}(`);
            for let mut i = h.lhs_start; i < h.lhs_end; i += 1 {
                out.push(chars[i]);
            }
            out.push(')');
            // Skip past the original `<lhs> matches { ... }`.
            cursor = h.body_close + 1;
        }
        // Else: don't advance cursor; the original span gets copied
        // verbatim by the next extracted hit (or the trailing copy).
    }
    // Copy remaining tail.
    for let mut i = cursor; i < chars.len(); i += 1 {
        out.push(chars[i]);
    }
    // Append helper definitions.
    out.push('\n');
    for let h of helpers {
        emit_helper(&mut out, h);
    }
    return out;
}

fn emit_helper(out: &mut String, info: &ExtractInfo) {
    out.push_str(`fn _gale_kind_set_{info.id}(k: i32) -> bool \{\n`);
    out.push_str("    return k matches { ");
    for let mut i = 0; i < info.tokens.len(); i += 1 {
        if i > 0 {
            out.push_str(" | ");
        }
        out.push_str(info.tokens[i]);
    }
    out.push_str(" };\n}\n\n");
}
