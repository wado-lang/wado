//! Static call-graph FOLLOW analysis. `settle_rule_follow` settles it into the
//! `RuleFollow` lowering and emit read.
//!
//! The `rule_follow` fixed point represents each rule's FOLLOW set as a u64
//! bitset over token-kind ids (`Element::kind_id`): union is a word-wise OR
//! and equality a word compare. Every FIRST-derived contribution is fixed-point
//! invariant, so each `RuleRef` site is flattened once into a
//! [`Contribution`] — static bits plus an inherits-caller-FOLLOW flag — and
//! the loop itself is pure bitset propagation. The public `FollowSet` exposes
//! `kinds` as ascending kind ids, read off the bitset once per rule after the
//! fixed point converges.

use { ParserRule, Element } from "./ir.wado";
use { GrammarAnalysis } from "./grammar_analysis.wado";
use { bits_ids, bits_set, bits_union_into, sets_overlap } from "./token_kinds.wado";
use { HashMap } from "core:collections";

/// FOLLOW set for a parser rule, in the classical ANTLR4 sense:
/// the set of token kinds that may legally appear immediately after a
/// successful parse of the rule, accumulated across every call site
/// reachable from the start rule.
///
/// `closed` tracks whether the set is "closed under EOF": i.e. whether
/// the start rule (or any rule reachable from it through a strictly
/// nullable suffix chain) is known to be terminated by EOF.
pub struct FollowSet {
    /// Ascending kind ids.
    pub kinds: List<i32>,
    pub closed: bool,
    /// Whether a wildcard or a `~set`, whose kinds `kinds` cannot name, may
    /// follow, so `kinds` under-approximates.
    pub open: bool,
}

impl FollowSet {
    pub fn empty() -> FollowSet {
        return FollowSet { kinds: [], closed: false, open: false };
    }
}

/// Pure analysis output: the FOLLOW environment of a grammar.
///
/// Built once from the parser-rule IR via [`build`]. No codegen state,
/// no `CodeWriter`. Exposes two read-only views:
///
/// * `tail_greedy` — per-rule snapshot of
///   `GrammarAnalysis::tail_greedy_first_of_rule`, lifted out of the
///   codegen cache so callers that only want the analysis (e.g.
///   LSP / tooling that doesn't run lower) don't have to instantiate
///   the full lower pipeline.
/// * `rule_follow` — per-rule classical FOLLOW set, computed by
///   the worklist fixed point in [`compute_rule_follow`].
///
/// The continuation-site registry, from which codegen emits `FOLLOW_TABLES`,
/// is not populated here. Lower's element walks are the only walker that knows
/// every call site's `caller_follow`, and they mint registry entries directly
/// via `LowerContext::intern_follow_site`. One pass then both builds the IR and
/// registers sites. Populating it in `FollowEnv::build` would re-derive what
/// lower is about to compute, and would have to track lower's per-shape
/// handling.
pub struct FollowEnv {
    /// Token kinds the rule may *greedily* consume at tail position
    /// (Optional/Star/Plus elements with no required successor in the
    /// alt). Restricted to single-token-inner repeats: see
    /// `grammar_analysis::tail_greedy_first_of_element` for the soundness
    /// argument. Lifted into `FollowEnv` so subsequent Phase 1 steps
    /// can compute against a snapshot independent of the codegen-side
    /// cache.
    tail_greedy: HashMap<String, List<i32>>,
    /// Per-rule FOLLOW set, populated by [`build`]. The `closed` flag
    /// indicates the rule is reachable from the start rule by a chain
    /// whose ultimate suffix is EOF — i.e. EOF is in `kinds` because
    /// of EOF reachability rather than an explicit `EOF` token in
    /// some caller.
    rule_follow: HashMap<String, FollowSet>,
}

impl FollowEnv {
    /// Skeleton variant: the empty environment. Used in tests and as
    /// the starting point for incremental wiring.
    pub fn empty() -> FollowEnv {
        return FollowEnv {
            tail_greedy: HashMap::new(),
            rule_follow: HashMap::new(),
        };
    }

    /// Tail-greedy first set for `rule_name`. Returns the empty array
    /// for unknown rules, which is the safe choice: an unknown rule
    /// cannot collide with any caller's follow.
    pub fn tail_greedy<S: AsStrSlice>(&self, rule_name: S) -> List<i32> {
        if let Some(s) = self.tail_greedy.get_str(rule_name) {
            return s;
        }
        return [];
    }

    /// FOLLOW set for `rule_name`. Returns the empty/closed=false set
    /// for unknown rules.
    pub fn rule_follow<S: AsStrSlice>(&self, rule_name: S) -> FollowSet {
        if let Some(s) = self.rule_follow.get_str(rule_name) {
            return s;
        }
        return FollowSet::empty();
    }
}

/// What may follow each parser rule, as lowering and emit ask it.
pub struct RuleFollow {
    /// FOLLOW of each rule whose set is exact: no wildcard or `~set` may
    /// follow it.
    kinds: HashMap<String, List<i32>>,
    /// The rules an `EOF` the grammar writes may follow.
    before_eof_token: List<String>,
}

impl RuleFollow {
    /// Nothing known, for a grammar with no parser rules: each FOLLOW query
    /// answers conservatively.
    pub fn unknown() -> RuleFollow {
        return RuleFollow {
            kinds: HashMap::new(),
            before_eof_token: [],
        };
    }

    /// Whether `rule_name`'s FOLLOW is known exactly.
    pub fn is_exact<S: AsStrSlice>(&self, rule_name: S) -> bool {
        return self.kinds.contains_key_str(rule_name);
    }

    /// The rule's classical FOLLOW, for a probe whose scan ends at the
    /// rule's tail — there, "can the caller continue" is exactly membership
    /// in this set. Empty when the set is not exact, which keeps the
    /// probe on its previous answer. The set over-approximates (a union over
    /// every call site), so conjoining it can only move a verdict from
    /// "exit" to "iterate": a token it excludes cannot continue any caller.
    pub fn for_probe<S: AsStrSlice>(&self, rule_name: S) -> List<i32> {
        let Some(follow) = self.kinds.get_str(rule_name) else {
            return [];
        };
        return follow;
    }

    /// Whether a caller of `rule_name` may continue on one of `kinds`. True
    /// where FOLLOW is not known exactly.
    pub fn caller_may_continue_on<S: AsStrSlice>(&self, rule_name: S, kinds: &List<i32>) -> bool {
        let Some(follow) = self.kinds.get_ref_str(rule_name) else {
            return true;
        };
        return sets_overlap(kinds, follow);
    }

    /// Whether an `EOF` the grammar writes may follow `rule_name`. The FOLLOW
    /// above seeds the start rule with one the grammar need not write.
    pub fn precedes_eof_token<S: AsStrSlice>(&self, rule_name: S) -> bool {
        return self.before_eof_token.contains_str(rule_name);
    }
}

/// Settle what may follow each of `parser_rules`, the first being the start
/// rule. Lowering reads it, so it is settled before any rule is lowered.
pub fn settle_rule_follow(parser_rules: &List<ParserRule>, analysis: &mut GrammarAnalysis) -> RuleFollow {
    if parser_rules.is_empty() {
        return RuleFollow::unknown();
    }
    let fenv = build(parser_rules, analysis, &parser_rules[0].name);
    let mut kinds = HashMap::<String, List<i32>>::new();
    for let rule of parser_rules {
        let follow = fenv.rule_follow(&rule.name);
        if !follow.open {
            kinds[rule.name] = follow.kinds;
        }
    }
    // Unseeded, so EOF is in a rule's FOLLOW only where the grammar matches it.
    let written = build(parser_rules, analysis, "");
    let eof = analysis.eof_kind_id();
    let mut before_eof_token: List<String> = [];
    for let rule of parser_rules {
        if written.rule_follow(&rule.name).kinds.contains(&eof) {
            before_eof_token.push(rule.name);
        }
    }
    return RuleFollow { kinds, before_eof_token };
}

/// Build the FOLLOW environment for a grammar.
///
/// `start_rule` seeds `FOLLOW(start_rule) = {EOF, closed=true}`. When
/// `start_rule` is empty or unknown, no rule is seeded with EOF and the
/// resulting `rule_follow` reflects only call-graph contributions —
/// useful for sub-grammar analysis or tests that exercise propagation
/// without an EOF anchor.
pub fn build<S: AsStrSlice>(parser_rules: &List<ParserRule>, analysis: &mut GrammarAnalysis, start_rule: S) -> FollowEnv {
    let mut tail_greedy = HashMap::<String, List<i32>>::new();
    for let rule of parser_rules {
        let mut visiting: List<String> = [];
        let tg = analysis.tail_greedy_first_of_rule(&rule.name, &mut visiting);
        tail_greedy[rule.name] = tg;
    }
    let rule_follow = compute_rule_follow(parser_rules, analysis, start_rule);
    return FollowEnv { tail_greedy, rule_follow };
}

/// Compute the per-rule FOLLOW set as a worklist fixed point.
///
/// Initialisation: `FOLLOW(start_rule) = {EOF, closed=true}`; every
/// other rule starts with the empty/non-closed set. Each `RuleRef`
/// site contributes `local_follow = first(suffix) ∪ (suffix
/// deep-nullable → FOLLOW(enclosing context))` to `FOLLOW(callee)`.
/// The enclosing context is the rule's own FOLLOW for top-level alts,
/// and the surrounding group's effective follow for inner alts.
///
/// FIRST-derived bits are iteration-invariant: the element walk runs once
/// ([`plan_element`]) and seeds them before the loop, which then only
/// propagates caller FOLLOW through the deep-nullable sites
/// (`inherits_outer`).
///
/// Termination: every iteration that doesn't grow any rule's set is
/// the last; the algorithm terminates because each set is monotonic
/// in a finite token universe.
fn compute_rule_follow<S: AsStrSlice>(
    parser_rules: &List<ParserRule>,
    analysis: &mut GrammarAnalysis,
    start_rule: S,
) -> HashMap<String, FollowSet> {
    let mut plans: List<List<Contribution>> = [];
    for let rule of parser_rules {
        let mut plan: List<Contribution> = [];
        let outer = PlanFollow { bits: [], inherits: true, open: false };
        for let alt of &rule.alternatives {
            plan_elements(&alt.elements, analysis, &outer, &mut plan);
        }
        plans.push(plan);
    }

    let mut env: List<FollowBits> = [];
    for let mut ri = 0; ri < parser_rules.len(); ri += 1 {
        env.push(FollowBits { bits: [], closed: false, open: false });
    }
    if !start_rule.is_empty() {
        let si = analysis.rule_index_of(start_rule);
        if si >= 0 {
            let mut seed: List<u64> = [];
            bits_set(&mut seed, analysis.eof_kind_id());
            env[si] = FollowBits { bits: seed, closed: true, open: false };
        }
    }

    for let mut ri = 0; ri < plans.len(); ri += 1 {
        for let c of &plans[ri] {
            let callee = &mut env[c.callee];
            let _ = bits_union_into(&mut callee.bits, &c.bits);
            callee.open = callee.open || c.open;
        }
    }

    loop {
        let mut changed = false;
        for let mut ri = 0; ri < plans.len(); ri += 1 {
            // Snapshot, not a reference: a rule that calls itself must merge
            // against the pass-entry value.
            let caller_follow = env[ri];
            for let c of &plans[ri] {
                if !c.inherits_outer {
                    continue;
                }
                let callee = &mut env[c.callee];
                let new_closed = callee.closed || caller_follow.closed;
                let new_open = callee.open || caller_follow.open;
                let bits_changed = bits_union_into(&mut callee.bits, &caller_follow.bits);
                if bits_changed || new_closed != callee.closed || new_open != callee.open {
                    callee.closed = new_closed;
                    callee.open = new_open;
                    changed = true;
                }
            }
        }
        if !changed {
            break;
        }
    }

    let mut result = HashMap::<String, FollowSet>::new();
    for let mut ri = 0; ri < parser_rules.len(); ri += 1 {
        result[parser_rules[ri].name] = FollowSet {
            kinds: bits_ids(&env[ri].bits),
            closed: env[ri].closed,
            open: env[ri].open,
        };
    }
    return result;
}

/// One flattened `RuleRef` call site: the FIRST-derived (iteration-invariant)
/// bits of its local FOLLOW, plus whether the enclosing rule's own FOLLOW
/// reaches the site through a deep-nullable suffix chain.
struct Contribution {
    callee: i32,
    bits: List<u64>,
    inherits_outer: bool,
    open: bool,
}

/// Static effective-follow during plan building: FIRST-derived bits plus the
/// flag standing in for the dynamic "enclosing rule's FOLLOW" part. `open`
/// says a wildcard or `~set` the bits cannot name is in that FIRST.
struct PlanFollow {
    bits: List<u64>,
    inherits: bool,
    open: bool,
}

/// Walk an element list, computing the static per-position effective follow
/// and flattening `RuleRef` sites into `plan`. `outer` is the follow at the
/// position immediately after this element list. `Group` recurses with the
/// local follow at the group's position; `Repeat` recurses with
/// `first(inner) ∪ local_follow` so that the inner's siblings (after one
/// iteration) see the start-of-inner contributions plus the loop exit follow.
fn plan_elements(
    elements: &List<Element>,
    analysis: &mut GrammarAnalysis,
    outer: &PlanFollow,
    plan: &mut List<Contribution>,
) {
    for let mut i = 0; i < elements.len(); i += 1 {
        let local = plan_local_follow(elements, i, analysis, outer);
        plan_element(&elements[i], analysis, &local, plan);
    }
}

fn plan_element(elem: &Element, analysis: &mut GrammarAnalysis, local: &PlanFollow, plan: &mut List<Contribution>) {
    match elem {
        RuleRef(r) => {
            let callee = analysis.rule_index_of(&r.name);
            if callee >= 0 {
                plan.push(Contribution { callee, bits: local.bits, inherits_outer: local.inherits, open: local.open });
            }
        },
        Group(g) => {
            for let inner_alt of &g.alternatives {
                plan_elements(&inner_alt.elements, analysis, local, plan);
            }
        },
        Repeat(rep) => {
            let mut inner_outer = *local;
            // A `*` / `+` iteration can be followed by another, so the
            // inner also sees its own FIRST. An `?` cannot iterate.
            if !rep.kind matches { Optional } {
                accumulate_first_bits(analysis, &rep.element, &mut inner_outer.bits);
                let mut visiting: List<String> = [];
                inner_outer.open = inner_outer.open || analysis.element_reaches_open_end(&rep.element, &mut visiting);
            }
            plan_element(&rep.element, analysis, &inner_outer, plan);
        },
        Label(lab) => {
            plan_element(&lab.element, analysis, local, plan);
        },
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => {
        },
    }
}

/// Static effective follow at position `i` in `elements`:
/// `first(elements[i+1..]) ∪ (suffix deep-nullable → outer)`.
fn plan_local_follow(elements: &List<Element>, i: i32, analysis: &mut GrammarAnalysis, outer: &PlanFollow) -> PlanFollow {
    let mut bits: List<u64> = [];
    suffix_first_bits(analysis, elements, i + 1, &mut bits);
    let mut inherits = false;
    let mut open = analysis.elements_reach_open_end(elements, i + 1);
    if analysis.tail_is_nullable_deep(elements, i + 1) {
        bits_union_into(&mut bits, &outer.bits);
        inherits = outer.inherits;
        open = open || outer.open;
    }
    return PlanFollow { bits, inherits, open };
}

/// Internal FOLLOW set: a u64 bitset over token-kind ids plus the
/// EOF-reachability flag. Value semantics deep-copy the `bits` array, so a
/// snapshot (`env[ri]`) is independent of later in-place mutation.
struct FollowBits {
    bits: List<u64>,
    closed: bool,
    open: bool,
}

/// Set into `bits` the FIRST set of `elements[start..]`, computed directly as
/// a bitset. This is the deep first-of-suffix (`deep_first_of_elements_from`)
/// without its `dedup_append_arr` O(n²) merge: a bitset dedups by construction.
fn suffix_first_bits(analysis: &mut GrammarAnalysis, elements: &List<Element>, start: i32, bits: &mut List<u64>) {
    for let mut i = start; i < elements.len(); i += 1 {
        accumulate_first_bits(analysis, &elements[i], bits);
        let mut nv: List<String> = [];
        if !analysis.element_is_nullable_deep(&elements[i], &mut nv) {
            break;
        }
    }
}

/// OR the FIRST set of a single element into `bits` (kind-id positions).
fn accumulate_first_bits(analysis: &mut GrammarAnalysis, elem: &Element, bits: &mut List<u64>) {
    let mut fv: List<String> = [];
    let ids = analysis.first_of_element(elem, &mut fv);
    for let id of &ids {
        bits_set(bits, *id);
    }
}
