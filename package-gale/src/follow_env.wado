use { ParserRule, Alternative, Element, RepeatElement, GroupElement, LabelElement } from "./ir.wado";
use { GenContext } from "./gen_context.wado";
use { TreeMap, TreeSet } from "core:collections";

/// FOLLOW set for a parser rule, in the classical ANTLR4 sense:
/// the set of token kinds that may legally appear immediately after a
/// successful parse of the rule, accumulated across every call site
/// reachable from the start rule.
///
/// `closed` tracks whether the set is "closed under EOF": i.e. whether
/// the start rule (or any rule reachable from it through a strictly
/// nullable suffix chain) is known to be terminated by EOF.
///
/// Internally the fixed-point solver builds a transient `TreeSet<String>`
/// from `kinds` for membership queries during `follow_union` / `follow_eq`
/// so the asymptotic cost is `O(|b| log |a|)` instead of the naive
/// linear-scan `O(|a| × |b|)`. The public surface stays as
/// `Array<String>` so callers (and the kiln-generated parser) don't
/// have to consume `core:collections::TreeSet`.
pub struct FollowSet {
    pub kinds: Array<String>,
    pub closed: bool,
}

impl FollowSet {
    pub fn empty() -> FollowSet {
        return FollowSet { kinds: [], closed: false };
    }
}

/// Pure analysis output: the FOLLOW environment of a grammar.
///
/// Built once from the parser-rule IR via [`build`]. No codegen state,
/// no `CodeWriter`. Today this is **standalone analysis surface** —
/// the codegen path still computes the same information on the fly via
/// `GenContext::tail_greedy_first_of_rule` and the per-position
/// `compute_ruleref_call_follow` helper. `FollowEnv` exists as the
/// pre-computed snapshot a future refactor (see
/// `package-gale/TODO.md` "LL prediction — architecture cleanup")
/// would have codegen consult instead, replacing the in-walker
/// `intern_follow_variant` registration with a pure lookup. Until
/// that refactor lands, the analysis is exercised end-to-end only by
/// `follow_env_test.wado`.
pub struct FollowEnv {
    /// Token kinds the rule may *greedily* consume at tail position
    /// (Optional/Star/Plus elements with no required successor in the
    /// alt). Restricted to single-token-inner repeats: see
    /// `gen_context::tail_greedy_first_of_element` for the soundness
    /// argument. Lifted into `FollowEnv` so subsequent Phase 1 steps
    /// can compute against a snapshot independent of the codegen-side
    /// cache.
    tail_greedy: TreeMap<String, Array<String>>,
    /// Per-rule FOLLOW set, populated by [`build`]. The `closed` flag
    /// indicates the rule is reachable from the start rule by a chain
    /// whose ultimate suffix is EOF — i.e. EOF is in `kinds` because
    /// of EOF reachability rather than an explicit `EOF` token in
    /// some caller.
    rule_follow: TreeMap<String, FollowSet>,
}

impl FollowEnv {
    /// Skeleton variant: the empty environment. Used in tests and as
    /// the starting point for incremental wiring.
    pub fn empty() -> FollowEnv {
        return FollowEnv {
            tail_greedy: TreeMap::<String, Array<String>>::new(),
            rule_follow: TreeMap::<String, FollowSet>::new(),
        };
    }

    /// Tail-greedy first set for `rule_name`. Returns the empty array
    /// for unknown rules, which is the safe choice: an unknown rule
    /// cannot collide with any caller's follow.
    pub fn tail_greedy(&self, rule_name: &String) -> Array<String> {
        if let Some(s) = self.tail_greedy.get(*rule_name) {
            return s;
        }
        return [];
    }

    /// FOLLOW set for `rule_name`. Returns the empty/closed=false set
    /// for unknown rules.
    pub fn rule_follow(&self, rule_name: &String) -> FollowSet {
        if let Some(s) = self.rule_follow.get(*rule_name) {
            return s;
        }
        return FollowSet::empty();
    }
}

/// Build the FOLLOW environment for a grammar.
///
/// `start_rule` seeds `FOLLOW(start_rule) = {EOF, closed=true}`. When
/// `start_rule` is empty or unknown, no rule is seeded with EOF and the
/// resulting `rule_follow` reflects only call-graph contributions —
/// useful for sub-grammar analysis or tests that exercise propagation
/// without an EOF anchor.
pub fn build(parser_rules: &Array<ParserRule>, ctx: &mut GenContext, start_rule: &String) -> FollowEnv {
    let mut tail_greedy = TreeMap::<String, Array<String>>::new();
    for let rule of parser_rules {
        let mut visiting: Array<String> = [];
        let tg = ctx.tail_greedy_first_of_rule(&rule.name, &mut visiting);
        tail_greedy[rule.name] = tg;
    }
    let rule_follow = compute_rule_follow(parser_rules, ctx, start_rule);
    return FollowEnv { tail_greedy, rule_follow };
}

/// Compute the per-rule FOLLOW set as a worklist fixed point.
///
/// Initialisation: `FOLLOW(start_rule) = {EOF, closed=true}`; every
/// other rule starts with the empty/non-closed set. Each iteration
/// walks every rule's body and contributes `local_follow` to
/// `FOLLOW(callee)` at each `RuleRef(callee)` site, where
/// `local_follow = first(suffix) ∪ (suffix deep-nullable →
/// FOLLOW(enclosing context))`. The enclosing context is the rule's
/// own FOLLOW for top-level alts, and the surrounding group's
/// effective follow for inner alts (computed recursively via the same
/// formula as the walker descends).
///
/// Termination: every iteration that doesn't grow any rule's set is
/// the last; the algorithm terminates because each set is monotonic
/// in a finite token universe.
fn compute_rule_follow(parser_rules: &Array<ParserRule>, ctx: &mut GenContext, start_rule: &String) -> TreeMap<String, FollowSet> {
    let mut env = TreeMap::<String, FollowSet>::new();
    for let rule of parser_rules {
        env[rule.name] = FollowSet::empty();
    }
    if !start_rule.is_empty() {
        if env.contains_key(*start_rule) {
            env[*start_rule] = FollowSet { kinds: ["TK_EOF"], closed: true };
        }
    }

    loop {
        let mut changed = false;
        for let caller of parser_rules {
            let caller_follow = env[caller.name];
            for let alt of &caller.alternatives {
                walk_for_contributions(&alt.elements, ctx, &caller_follow, &mut env, &mut changed);
            }
        }
        if !changed {
            break;
        }
    }
    return env;
}

/// Walk an element list, computing per-position effective follow and
/// reporting `RuleRef` contributions into `env`. `outer_follow` is the
/// FOLLOW set at the position immediately after this element list
/// (i.e. either the enclosing rule's FOLLOW or the surrounding
/// group's effective follow). `Group` recurses with the local follow
/// at the group's position; `Repeat` recurses with `first(inner) ∪
/// local_follow` so that the inner's siblings (after one iteration)
/// see the start-of-inner contributions plus the loop exit follow.
fn walk_for_contributions(elements: &Array<Element>, ctx: &mut GenContext, outer_follow: &FollowSet, env: &mut TreeMap<String, FollowSet>, changed: &mut bool) {
    for let mut i = 0; i < elements.len(); i += 1 {
        let local = local_follow(elements, i, ctx, outer_follow);
        contribute_for_element(&elements[i], ctx, &local, env, changed);
    }
}

fn contribute_for_element(elem: &Element, ctx: &mut GenContext, local: &FollowSet, env: &mut TreeMap<String, FollowSet>, changed: &mut bool) {
    match elem {
        RuleRef(r) => {
            if env.contains_key(r.name) {
                let old = env[r.name];
                let merged = follow_union(&old, local);
                if !follow_eq(&old, &merged) {
                    env[r.name] = merged;
                    *changed = true;
                }
            }
        },
        Group(g) => {
            for let inner_alt of &g.alternatives {
                walk_for_contributions(&inner_alt.elements, ctx, local, env, changed);
            }
        },
        Repeat(rep) => {
            let mut fv: Array<String> = [];
            let inner_first = ctx.first_of_element(&rep.element, &mut fv);
            let inner_outer = follow_union(local, &FollowSet { kinds: inner_first, closed: false });
            contribute_for_element(&rep.element, ctx, &inner_outer, env, changed);
        },
        Label(lab) => {
            contribute_for_element(&lab.element, ctx, local, env, changed);
        },
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => {
        },
    }
}

/// Effective follow at position `i` in `elements`:
/// `first(elements[i+1..]) ∪ (suffix deep-nullable → outer_follow)`.
fn local_follow(elements: &Array<Element>, i: i32, ctx: &mut GenContext, outer_follow: &FollowSet) -> FollowSet {
    let suffix_first = ctx.first_of_elements_from(elements, i + 1);
    let mut kinds = suffix_first;
    let mut closed = false;
    if ctx.tail_is_nullable_deep(elements, i + 1) {
        let mut seen = str_set_of(&kinds);
        for let k of &outer_follow.kinds {
            if !seen.contains(*k) {
                seen.insert(*k);
                kinds.push(*k);
            }
        }
        closed = outer_follow.closed;
    }
    return FollowSet { kinds, closed };
}

/// O(|b| log |a|) union: build a `TreeSet` over `a.kinds` for
/// membership queries, then push each new element of `b.kinds` onto
/// the existing array. Replaces the naive `O(|a| × |b|)` linear scan.
fn follow_union(a: &FollowSet, b: &FollowSet) -> FollowSet {
    let mut kinds = a.kinds;
    let mut seen = str_set_of(&kinds);
    for let k of &b.kinds {
        if !seen.contains(*k) {
            seen.insert(*k);
            kinds.push(*k);
        }
    }
    return FollowSet { kinds, closed: a.closed || b.closed };
}

/// O(|a| log |b|) equality: build a `TreeSet` over the smaller
/// candidate (sizes already match by the early-out) and walk the
/// other for membership.
fn follow_eq(a: &FollowSet, b: &FollowSet) -> bool {
    if a.closed != b.closed {
        return false;
    }
    if a.kinds.len() != b.kinds.len() {
        return false;
    }
    let b_set = str_set_of(&b.kinds);
    for let k of &a.kinds {
        if !b_set.contains(*k) {
            return false;
        }
    }
    return true;
}

fn str_set_of(arr: &Array<String>) -> TreeSet<String> {
    let mut set = TreeSet::<String>::new();
    for let k of arr {
        set.insert(*k);
    }
    return set;
}
