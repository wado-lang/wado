//! Static call-graph FOLLOW analysis, consumed by `codegen::install_rule_follow`
//! (feeds `GenContext::at_end_conflict_routes`, which decides whether an
//! at-end multi-alt conflict must route through the ATN).
//!
//! The `rule_follow` fixed point represents each rule's FOLLOW set as a u64
//! bitset over interned terminal ids: union is a word-wise OR and equality a
//! word compare, so the worklist loop never touches a `TreeSet<String>`. The
//! public `FollowSet` still exposes `kinds` as a `TreeSet<String>`; the
//! bitsets are materialised to that form once per rule after the fixed point
//! converges (outside the hot loop).

use { ParserRule, Alternative, Element } from "./ir.wado";
use { GenContext } from "./gen_context.wado";
use { literal_const_name } from "./gen_util.wado";
use { TreeMap, TreeSet } from "core:collections";

/// FOLLOW set for a parser rule, in the classical ANTLR4 sense:
/// the set of token kinds that may legally appear immediately after a
/// successful parse of the rule, accumulated across every call site
/// reachable from the start rule.
///
/// `kinds` is a `TreeSet` so the fixed-point solver's repeated
/// `follow_union` / `follow_eq` calls run at `O(|b| log |a|)` instead
/// of the linear `List::contains` scan they would do on an `List`.
/// `closed` tracks whether the set is "closed under EOF": i.e. whether
/// the start rule (or any rule reachable from it through a strictly
/// nullable suffix chain) is known to be terminated by EOF.
pub struct FollowSet {
    pub kinds: TreeSet<String>,
    pub closed: bool,
}

impl FollowSet {
    pub fn empty() -> FollowSet {
        return FollowSet { kinds: TreeSet::<String>::new(), closed: false };
    }
}

/// Pure analysis output: the FOLLOW environment of a grammar.
///
/// Built once from the parser-rule IR via [`build`]. No codegen state,
/// no `CodeWriter`. Exposes two read-only views:
///
/// * `tail_greedy` — per-rule snapshot of
///   `GenContext::tail_greedy_first_of_rule`, lifted out of the
///   codegen cache so callers that only want the analysis (e.g.
///   LSP / tooling that doesn't run lower) don't have to instantiate
///   the full lower pipeline.
/// * `rule_follow` — per-rule classical FOLLOW set, computed by
///   the worklist fixed point in [`compute_rule_follow`].
///
/// The follow-mask registry — the distinct-mask table consumed by
/// codegen to emit the `FOLLOW_MASK_<id>` globals — is intentionally
/// NOT populated here. Lower's element walks (the only walker that
/// needs to know every site's per-call-site `caller_follow`) mint
/// registry entries directly via `GenContext::intern_follow_mask`, so
/// there is one authoritative element-walking pass that both builds
/// the IR and registers masks. Duplicating that walk in
/// `FollowEnv::build` to pre-populate the registry would only re-derive
/// what lower is already about to compute — and would have to be kept
/// in lock-step with lower's per-shape handling, which is the kind of
/// drift surface this project deliberately avoids.
pub struct FollowEnv {
    /// Token kinds the rule may *greedily* consume at tail position
    /// (Optional/Star/Plus elements with no required successor in the
    /// alt). Restricted to single-token-inner repeats: see
    /// `gen_context::tail_greedy_first_of_element` for the soundness
    /// argument. Lifted into `FollowEnv` so subsequent Phase 1 steps
    /// can compute against a snapshot independent of the codegen-side
    /// cache.
    tail_greedy: TreeMap<String, List<String>>,
    /// Per-rule FOLLOW set, populated by [`build`]. The `closed` flag
    /// indicates the rule is reachable from the start rule by a chain
    /// whose ultimate suffix is EOF — i.e. EOF is in `kinds` because
    /// of EOF reachability rather than an explicit `EOF` token in
    /// some caller.
    rule_follow: TreeMap<String, FollowSet>,
}

impl FollowEnv {
    /// Skeleton variant: the empty environment. Used in tests and as
    /// the starting point for incremental wiring.
    pub fn empty() -> FollowEnv {
        return FollowEnv {
            tail_greedy: TreeMap::<String, List<String>>::new(),
            rule_follow: TreeMap::<String, FollowSet>::new(),
        };
    }

    /// Tail-greedy first set for `rule_name`. Returns the empty array
    /// for unknown rules, which is the safe choice: an unknown rule
    /// cannot collide with any caller's follow.
    pub fn tail_greedy(&self, rule_name: &String) -> List<String> {
        if let Some(s) = self.tail_greedy.get(*rule_name) {
            return s;
        }
        return [];
    }

    /// FOLLOW set for `rule_name`. Returns the empty/closed=false set
    /// for unknown rules.
    pub fn rule_follow(&self, rule_name: &String) -> FollowSet {
        if let Some(s) = self.rule_follow.get(*rule_name) {
            return s;
        }
        return FollowSet::empty();
    }
}

/// Build the FOLLOW environment for a grammar.
///
/// `start_rule` seeds `FOLLOW(start_rule) = {EOF, closed=true}`. When
/// `start_rule` is empty or unknown, no rule is seeded with EOF and the
/// resulting `rule_follow` reflects only call-graph contributions —
/// useful for sub-grammar analysis or tests that exercise propagation
/// without an EOF anchor.
pub fn build(parser_rules: &List<ParserRule>, ctx: &mut GenContext, start_rule: &String) -> FollowEnv {
    let mut tail_greedy = TreeMap::<String, List<String>>::new();
    for let rule of parser_rules {
        let mut visiting: List<String> = [];
        let tg = ctx.tail_greedy_first_of_rule(&rule.name, &mut visiting);
        tail_greedy[rule.name] = tg;
    }
    let rule_follow = compute_rule_follow(parser_rules, ctx, start_rule);
    return FollowEnv { tail_greedy, rule_follow };
}

/// Compute the per-rule FOLLOW set as a worklist fixed point.
///
/// Initialisation: `FOLLOW(start_rule) = {EOF, closed=true}`; every
/// other rule starts with the empty/non-closed set. Each iteration
/// walks every rule's body and contributes `local_follow` to
/// `FOLLOW(callee)` at each `RuleRef(callee)` site, where
/// `local_follow = first(suffix) ∪ (suffix deep-nullable →
/// FOLLOW(enclosing context))`. The enclosing context is the rule's
/// own FOLLOW for top-level alts, and the surrounding group's
/// effective follow for inner alts (computed recursively via the same
/// formula as the walker descends).
///
/// Termination: every iteration that doesn't grow any rule's set is
/// the last; the algorithm terminates because each set is monotonic
/// in a finite token universe.
fn compute_rule_follow(
    parser_rules: &List<ParserRule>,
    ctx: &mut GenContext,
    start_rule: &String,
) -> TreeMap<String, FollowSet> {
    // Token universe: a FOLLOW set only ever holds terminals (a FIRST set is
    // built from `TokenRef` / `Literal` leaves) plus the `TK_EOF` seed, so
    // interning every terminal once gives a dense id space for the bitsets.
    let mut intern = TokenInterner { ids: TreeMap::<String, i32>::new(), names: [] };
    intern_token(&mut intern, &"TK_EOF");
    for let rule of parser_rules {
        for let alt of &rule.alternatives {
            collect_terminal_tokens(&alt.elements, &mut intern);
        }
    }

    let mut env = TreeMap::<String, FollowBits>::new();
    for let rule of parser_rules {
        env[rule.name] = FollowBits { bits: [], closed: false };
    }
    if !start_rule.is_empty() {
        if env.contains_key(*start_rule) {
            let mut seed: List<u64> = [];
            bits_set(&mut seed, intern_token(&mut intern, &"TK_EOF"));
            env[*start_rule] = FollowBits { bits: seed, closed: true };
        }
    }

    loop {
        let mut changed = false;
        for let caller of parser_rules {
            let caller_follow = env[caller.name];
            for let alt of &caller.alternatives {
                walk_for_contributions(&alt.elements, ctx, &caller_follow, &mut intern, &mut env, &mut changed);
            }
        }
        if !changed {
            break;
        }
    }

    // Materialise the bitsets to the public `TreeSet<String>` form once per
    // rule — outside the fixed point, so the string cost is paid once.
    let mut result = TreeMap::<String, FollowSet>::new();
    for let rule of parser_rules {
        let fb = env[rule.name];
        result[rule.name] = bits_to_follow_set(&fb, &intern);
    }
    return result;
}

/// Walk an element list, computing per-position effective follow and
/// reporting `RuleRef` contributions into `env`. `outer_follow` is the
/// FOLLOW set at the position immediately after this element list
/// (i.e. either the enclosing rule's FOLLOW or the surrounding
/// group's effective follow). `Group` recurses with the local follow
/// at the group's position; `Repeat` recurses with `first(inner) ∪
/// local_follow` so that the inner's siblings (after one iteration)
/// see the start-of-inner contributions plus the loop exit follow.
fn walk_for_contributions(
    elements: &List<Element>,
    ctx: &mut GenContext,
    outer_follow: &FollowBits,
    intern: &mut TokenInterner,
    env: &mut TreeMap<String, FollowBits>,
    changed: &mut bool,
) {
    for let mut i = 0; i < elements.len(); i += 1 {
        let local = local_follow(elements, i, ctx, outer_follow, intern);
        contribute_for_element(&elements[i], ctx, &local, intern, env, changed);
    }
}

fn contribute_for_element(
    elem: &Element,
    ctx: &mut GenContext,
    local: &FollowBits,
    intern: &mut TokenInterner,
    env: &mut TreeMap<String, FollowBits>,
    changed: &mut bool,
) {
    match elem {
        RuleRef(r) => {
            if env.contains_key(r.name) {
                let mut merged = env[r.name];
                let new_closed = merged.closed || local.closed;
                let bits_changed = bits_union_into(&mut merged.bits, &local.bits);
                if bits_changed || new_closed != merged.closed {
                    merged.closed = new_closed;
                    env[r.name] = merged;
                    *changed = true;
                }
            }
        },
        Group(g) => {
            for let inner_alt of &g.alternatives {
                walk_for_contributions(&inner_alt.elements, ctx, local, intern, env, changed);
            }
        },
        Repeat(rep) => {
            let mut inner_outer = *local;
            // A `*` / `+` iteration can be followed by another, so the
            // inner also sees its own FIRST. An `?` cannot iterate.
            if !(rep.kind matches { Optional }) {
                accumulate_first_bits(ctx, &rep.element, intern, &mut inner_outer.bits);
            }
            contribute_for_element(&rep.element, ctx, &inner_outer, intern, env, changed);
        },
        Label(lab) => {
            contribute_for_element(&lab.element, ctx, local, intern, env, changed);
        },
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => {
        },
    }
}

/// Effective follow at position `i` in `elements`:
/// `first(elements[i+1..]) ∪ (suffix deep-nullable → outer_follow)`.
fn local_follow(
    elements: &List<Element>,
    i: i32,
    ctx: &mut GenContext,
    outer_follow: &FollowBits,
    intern: &mut TokenInterner,
) -> FollowBits {
    let mut bits: List<u64> = [];
    suffix_first_bits(ctx, elements, i + 1, intern, &mut bits);
    let mut closed = false;
    if ctx.tail_is_nullable_deep(elements, i + 1) {
        bits_union_into(&mut bits, &outer_follow.bits);
        closed = outer_follow.closed;
    }
    return FollowBits { bits, closed };
}

/// Internal FOLLOW set: a u64 bitset over interned terminal ids plus the
/// EOF-reachability flag. Value semantics deep-copy the `bits` array, so a
/// snapshot (`env[name]`) is independent of later in-place mutation — unlike
/// the `TreeSet` this replaced, whose shallow field copy shared its nodes.
struct FollowBits {
    bits: List<u64>,
    closed: bool,
}

/// Maps a terminal name (`TK_*` / `TK_LIT_*`) to a dense id and back.
struct TokenInterner {
    ids: TreeMap<String, i32>,
    names: List<String>,
}

fn intern_token(intern: &mut TokenInterner, name: &String) -> i32 {
    if let Some(id) = intern.ids.get(*name) {
        return id;
    }
    let id = intern.names.len();
    intern.ids[*name] = id;
    intern.names.push(*name);
    return id;
}

/// Pre-intern every terminal reachable in an element list, so the fixed
/// point's bitsets are pre-sized and `intern_token` only ever hits.
fn collect_terminal_tokens(elements: &List<Element>, intern: &mut TokenInterner) {
    for let e of elements {
        collect_terminal_tokens_element(e, intern);
    }
}

fn collect_terminal_tokens_element(elem: &Element, intern: &mut TokenInterner) {
    match elem {
        TokenRef(t) => {
            intern_token(intern, &`TK_${t.name}`);
        },
        Literal(l) => {
            intern_token(intern, &literal_const_name(&l.text));
        },
        Repeat(rep) => collect_terminal_tokens_element(&rep.element, intern),
        Label(lab) => collect_terminal_tokens_element(&lab.element, intern),
        Group(g) => {
            for let alt of &g.alternatives {
                collect_terminal_tokens(&alt.elements, intern);
            }
        },
        RuleRef(_) | Wildcard(_) | Not(_) => {
        },
    }
}

/// Set into `bits` the FIRST set of `elements[start..]`, computed directly as
/// a bitset. This is the deep first-of-suffix (`deep_first_of_elements_from`)
/// without its `List<String>` + `dedup_append_arr` O(n²) merge: a bitset
/// dedups by construction.
fn suffix_first_bits(
    ctx: &mut GenContext,
    elements: &List<Element>,
    start: i32,
    intern: &mut TokenInterner,
    bits: &mut List<u64>,
) {
    for let mut i = start; i < elements.len(); i += 1 {
        accumulate_first_bits(ctx, &elements[i], intern, bits);
        let mut nv: List<String> = [];
        if !ctx.element_is_nullable_deep(&elements[i], &mut nv) {
            break;
        }
    }
}

/// OR the FIRST set of a single element into `bits`.
fn accumulate_first_bits(ctx: &mut GenContext, elem: &Element, intern: &mut TokenInterner, bits: &mut List<u64>) {
    let mut fv: List<String> = [];
    let ef = ctx.first_of_element(elem, &mut fv);
    for let k of &ef {
        bits_set(bits, intern_token(intern, k));
    }
}

fn bits_ensure(bits: &mut List<u64>, word: i32) {
    while bits.len() <= word {
        bits.push(0 as u64);
    }
}

fn bits_set(bits: &mut List<u64>, id: i32) {
    let word = id / 64;
    bits_ensure(bits, word);
    bits[word] = bits[word] | 1 as u64 << (id % 64) as u64;
}

/// OR `src` into `dst`, growing `dst` as needed. Returns whether `dst` grew.
fn bits_union_into(dst: &mut List<u64>, src: &List<u64>) -> bool {
    let mut changed = false;
    for let mut i = 0; i < src.len(); i += 1 {
        let sv = src[i];
        if sv == 0 as u64 {
            continue;
        }
        bits_ensure(dst, i);
        let merged = dst[i] | sv;
        if merged != dst[i] {
            dst[i] = merged;
            changed = true;
        }
    }
    return changed;
}

/// Materialise a bitset into the public `FollowSet` (a `TreeSet<String>`).
/// Called once per rule after convergence, so its string cost is off the
/// hot path.
fn bits_to_follow_set(fb: &FollowBits, intern: &TokenInterner) -> FollowSet {
    let mut kinds = TreeSet::<String>::new();
    for let mut w = 0; w < fb.bits.len(); w += 1 {
        let word = fb.bits[w];
        if word == 0 as u64 {
            continue;
        }
        for let mut b = 0; b < 64; b += 1 {
            if word & 1 as u64 << b as u64 != 0 as u64 {
                kinds.insert(intern.names[w * 64 + b]);
            }
        }
    }
    return FollowSet { kinds, closed: fb.closed };
}
