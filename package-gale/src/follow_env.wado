//! Static call-graph FOLLOW analysis, consumed by `codegen::install_rule_follow`
//! (feeds `GenContext::at_end_conflict_routes`, which decides whether an
//! at-end multi-alt conflict must route through the ATN).
//!
//! The `rule_follow` fixed point represents each rule's FOLLOW set as a u64
//! bitset over token-kind ids (`Element::kind_id`): union is a word-wise OR
//! and equality a word compare, so the worklist loop never touches a
//! `TreeSet<String>`. Every FIRST-derived contribution is fixed-point
//! invariant, so each `RuleRef` site is flattened once into a
//! [`Contribution`] — static bits plus an inherits-caller-FOLLOW flag — and
//! the loop itself is pure bitset propagation. The public `FollowSet` still
//! exposes `kinds` as a `TreeSet<String>`; the bitsets are materialised to
//! that form once per rule after the fixed point converges.

use { ParserRule, Element } from "./ir.wado";
use { GenContext } from "./gen_context.wado";
use { bits_set, bits_union_into } from "./token_kinds.wado";
use { TreeMap, TreeSet } from "core:collections";

/// FOLLOW set for a parser rule, in the classical ANTLR4 sense:
/// the set of token kinds that may legally appear immediately after a
/// successful parse of the rule, accumulated across every call site
/// reachable from the start rule.
///
/// `closed` tracks whether the set is "closed under EOF": i.e. whether
/// the start rule (or any rule reachable from it through a strictly
/// nullable suffix chain) is known to be terminated by EOF.
pub struct FollowSet {
    pub kinds: TreeSet<String>,
    pub closed: bool,
}

impl FollowSet {
    pub fn empty() -> FollowSet {
        return FollowSet { kinds: TreeSet::<String>::new(), closed: false };
    }
}

/// Pure analysis output: the FOLLOW environment of a grammar.
///
/// Built once from the parser-rule IR via [`build`]. No codegen state,
/// no `CodeWriter`. Exposes two read-only views:
///
/// * `tail_greedy` — per-rule snapshot of
///   `GenContext::tail_greedy_first_of_rule`, lifted out of the
///   codegen cache so callers that only want the analysis (e.g.
///   LSP / tooling that doesn't run lower) don't have to instantiate
///   the full lower pipeline.
/// * `rule_follow` — per-rule classical FOLLOW set, computed by
///   the worklist fixed point in [`compute_rule_follow`].
///
/// The follow-mask registry — the distinct-mask table consumed by
/// codegen to emit the `FOLLOW_MASK_<id>` globals — is intentionally
/// NOT populated here. Lower's element walks (the only walker that
/// needs to know every site's per-call-site `caller_follow`) mint
/// registry entries directly via `GenContext::intern_follow_mask`, so
/// there is one authoritative element-walking pass that both builds
/// the IR and registers masks. Duplicating that walk in
/// `FollowEnv::build` to pre-populate the registry would only re-derive
/// what lower is already about to compute — and would have to be kept
/// in lock-step with lower's per-shape handling, which is the kind of
/// drift surface this project deliberately avoids.
pub struct FollowEnv {
    /// Token kinds the rule may *greedily* consume at tail position
    /// (Optional/Star/Plus elements with no required successor in the
    /// alt). Restricted to single-token-inner repeats: see
    /// `gen_context::tail_greedy_first_of_element` for the soundness
    /// argument. Lifted into `FollowEnv` so subsequent Phase 1 steps
    /// can compute against a snapshot independent of the codegen-side
    /// cache.
    tail_greedy: TreeMap<String, List<String>>,
    /// Per-rule FOLLOW set, populated by [`build`]. The `closed` flag
    /// indicates the rule is reachable from the start rule by a chain
    /// whose ultimate suffix is EOF — i.e. EOF is in `kinds` because
    /// of EOF reachability rather than an explicit `EOF` token in
    /// some caller.
    rule_follow: TreeMap<String, FollowSet>,
}

impl FollowEnv {
    /// Skeleton variant: the empty environment. Used in tests and as
    /// the starting point for incremental wiring.
    pub fn empty() -> FollowEnv {
        return FollowEnv {
            tail_greedy: TreeMap::<String, List<String>>::new(),
            rule_follow: TreeMap::<String, FollowSet>::new(),
        };
    }

    /// Tail-greedy first set for `rule_name`. Returns the empty array
    /// for unknown rules, which is the safe choice: an unknown rule
    /// cannot collide with any caller's follow.
    pub fn tail_greedy(&self, rule_name: &String) -> List<String> {
        if let Some(s) = self.tail_greedy.get(*rule_name) {
            return s;
        }
        return [];
    }

    /// FOLLOW set for `rule_name`. Returns the empty/closed=false set
    /// for unknown rules.
    pub fn rule_follow(&self, rule_name: &String) -> FollowSet {
        if let Some(s) = self.rule_follow.get(*rule_name) {
            return s;
        }
        return FollowSet::empty();
    }
}

/// Build the FOLLOW environment for a grammar.
///
/// `start_rule` seeds `FOLLOW(start_rule) = {EOF, closed=true}`. When
/// `start_rule` is empty or unknown, no rule is seeded with EOF and the
/// resulting `rule_follow` reflects only call-graph contributions —
/// useful for sub-grammar analysis or tests that exercise propagation
/// without an EOF anchor.
pub fn build(parser_rules: &List<ParserRule>, ctx: &mut GenContext, start_rule: &String) -> FollowEnv {
    let mut tail_greedy = TreeMap::<String, List<String>>::new();
    for let rule of parser_rules {
        let mut visiting: List<String> = [];
        let tg = ctx.tail_greedy_first_of_rule(&rule.name, &mut visiting);
        tail_greedy[rule.name] = tg;
    }
    let rule_follow = compute_rule_follow(parser_rules, ctx, start_rule);
    return FollowEnv { tail_greedy, rule_follow };
}

/// Compute the per-rule FOLLOW set as a worklist fixed point.
///
/// Initialisation: `FOLLOW(start_rule) = {EOF, closed=true}`; every
/// other rule starts with the empty/non-closed set. Each `RuleRef`
/// site contributes `local_follow = first(suffix) ∪ (suffix
/// deep-nullable → FOLLOW(enclosing context))` to `FOLLOW(callee)`.
/// The enclosing context is the rule's own FOLLOW for top-level alts,
/// and the surrounding group's effective follow for inner alts.
///
/// The FIRST-derived half of every contribution never changes across
/// iterations, so the element walk runs once up front ([`plan_element`])
/// and its static bits are seeded before the loop; the loop then only
/// propagates each caller's own FOLLOW through the sites whose suffix
/// chain is deep-nullable (`inherits_outer`).
///
/// Termination: every iteration that doesn't grow any rule's set is
/// the last; the algorithm terminates because each set is monotonic
/// in a finite token universe.
fn compute_rule_follow(
    parser_rules: &List<ParserRule>,
    ctx: &mut GenContext,
    start_rule: &String,
) -> TreeMap<String, FollowSet> {
    let mut plans: List<List<Contribution>> = [];
    for let rule of parser_rules {
        let mut plan: List<Contribution> = [];
        let outer = PlanFollow { bits: [], inherits: true };
        for let alt of &rule.alternatives {
            plan_elements(&alt.elements, ctx, &outer, &mut plan);
        }
        plans.push(plan);
    }

    let mut env: List<FollowBits> = [];
    for let mut ri = 0; ri < parser_rules.len(); ri += 1 {
        env.push(FollowBits { bits: [], closed: false });
    }
    if !start_rule.is_empty() {
        let si = ctx.rule_index_of(start_rule);
        if si >= 0 {
            let mut seed: List<u64> = [];
            bits_set(&mut seed, ctx.eof_kind_id());
            env[si] = FollowBits { bits: seed, closed: true };
        }
    }

    for let mut ri = 0; ri < plans.len(); ri += 1 {
        for let c of &plans[ri] {
            let callee = &mut env[c.callee];
            let _ = bits_union_into(&mut callee.bits, &c.bits);
        }
    }

    loop {
        let mut changed = false;
        for let mut ri = 0; ri < plans.len(); ri += 1 {
            // Snapshot, not a reference: a rule that calls itself must merge
            // against the pass-entry value, and the copy is once per rule.
            let caller_follow = env[ri];
            for let c of &plans[ri] {
                if !c.inherits_outer {
                    continue;
                }
                let callee = &mut env[c.callee];
                let new_closed = callee.closed || caller_follow.closed;
                let bits_changed = bits_union_into(&mut callee.bits, &caller_follow.bits);
                if bits_changed || new_closed != callee.closed {
                    callee.closed = new_closed;
                    changed = true;
                }
            }
        }
        if !changed {
            break;
        }
    }

    // Materialise the bitsets to the public `TreeSet<String>` form once per
    // rule — outside the fixed point, so the string cost is paid once.
    let mut result = TreeMap::<String, FollowSet>::new();
    for let mut ri = 0; ri < parser_rules.len(); ri += 1 {
        result[parser_rules[ri].name] = bits_to_follow_set(&env[ri], ctx);
    }
    return result;
}

/// One flattened `RuleRef` call site: the FIRST-derived (iteration-invariant)
/// bits of its local FOLLOW, plus whether the enclosing rule's own FOLLOW
/// reaches the site through a deep-nullable suffix chain.
struct Contribution {
    callee: i32,
    bits: List<u64>,
    inherits_outer: bool,
}

/// Static effective-follow during plan building: FIRST-derived bits plus the
/// flag standing in for the dynamic "enclosing rule's FOLLOW" part.
struct PlanFollow {
    bits: List<u64>,
    inherits: bool,
}

/// Walk an element list, computing the static per-position effective follow
/// and flattening `RuleRef` sites into `plan`. `outer` is the follow at the
/// position immediately after this element list. `Group` recurses with the
/// local follow at the group's position; `Repeat` recurses with
/// `first(inner) ∪ local_follow` so that the inner's siblings (after one
/// iteration) see the start-of-inner contributions plus the loop exit follow.
fn plan_elements(
    elements: &List<Element>,
    ctx: &mut GenContext,
    outer: &PlanFollow,
    plan: &mut List<Contribution>,
) {
    for let mut i = 0; i < elements.len(); i += 1 {
        let local = plan_local_follow(elements, i, ctx, outer);
        plan_element(&elements[i], ctx, &local, plan);
    }
}

fn plan_element(
    elem: &Element,
    ctx: &mut GenContext,
    local: &PlanFollow,
    plan: &mut List<Contribution>,
) {
    match elem {
        RuleRef(r) => {
            let callee = ctx.rule_index_of(&r.name);
            if callee >= 0 {
                plan.push(Contribution { callee, bits: local.bits, inherits_outer: local.inherits });
            }
        },
        Group(g) => {
            for let inner_alt of &g.alternatives {
                plan_elements(&inner_alt.elements, ctx, local, plan);
            }
        },
        Repeat(rep) => {
            let mut inner_outer = *local;
            // A `*` / `+` iteration can be followed by another, so the
            // inner also sees its own FIRST. An `?` cannot iterate.
            if !rep.kind matches { Optional } {
                accumulate_first_bits(ctx, &rep.element, &mut inner_outer.bits);
            }
            plan_element(&rep.element, ctx, &inner_outer, plan);
        },
        Label(lab) => {
            plan_element(&lab.element, ctx, local, plan);
        },
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => {
        },
    }
}

/// Static effective follow at position `i` in `elements`:
/// `first(elements[i+1..]) ∪ (suffix deep-nullable → outer)`.
fn plan_local_follow(elements: &List<Element>, i: i32, ctx: &mut GenContext, outer: &PlanFollow) -> PlanFollow {
    let mut bits: List<u64> = [];
    suffix_first_bits(ctx, elements, i + 1, &mut bits);
    let mut inherits = false;
    if ctx.tail_is_nullable_deep(elements, i + 1) {
        bits_union_into(&mut bits, &outer.bits);
        inherits = outer.inherits;
    }
    return PlanFollow { bits, inherits };
}

/// Internal FOLLOW set: a u64 bitset over token-kind ids plus the
/// EOF-reachability flag. Value semantics deep-copy the `bits` array, so a
/// snapshot (`env[ri]`) is independent of later in-place mutation.
struct FollowBits {
    bits: List<u64>,
    closed: bool,
}

/// Set into `bits` the FIRST set of `elements[start..]`, computed directly as
/// a bitset. This is the deep first-of-suffix (`deep_first_of_elements_from`)
/// without its `List<String>` + `dedup_append_arr` O(n²) merge: a bitset
/// dedups by construction.
fn suffix_first_bits(
    ctx: &mut GenContext,
    elements: &List<Element>,
    start: i32,
    bits: &mut List<u64>,
) {
    for let mut i = start; i < elements.len(); i += 1 {
        accumulate_first_bits(ctx, &elements[i], bits);
        let mut nv: List<String> = [];
        if !ctx.element_is_nullable_deep(&elements[i], &mut nv) {
            break;
        }
    }
}

/// OR the FIRST set of a single element into `bits` (kind-id positions).
fn accumulate_first_bits(ctx: &mut GenContext, elem: &Element, bits: &mut List<u64>) {
    let mut fv: List<String> = [];
    let ids = ctx.first_ids_of_element(elem, &mut fv);
    for let id of &ids {
        bits_set(bits, *id);
    }
}

/// Materialise a bitset into the public `FollowSet` (a `TreeSet<String>`).
/// Called once per rule after convergence, so its string cost is off the
/// hot path.
fn bits_to_follow_set(fb: &FollowBits, ctx: &GenContext) -> FollowSet {
    let mut kinds = TreeSet::<String>::new();
    for let mut w = 0; w < fb.bits.len(); w += 1 {
        let word = fb.bits[w];
        if word == 0 as u64 {
            continue;
        }
        for let mut b = 0; b < 64; b += 1 {
            if word & 1 as u64 << b as u64 != 0 as u64 {
                kinds.insert(ctx.token_name(w * 64 + b));
            }
        }
    }
    return FollowSet { kinds, closed: fb.closed };
}
