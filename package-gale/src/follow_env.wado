use { ParserRule, Alternative, Element, RepeatElement, GroupElement, LabelElement } from "./ir.wado";
use { GenContext, FOLLOW_VARIANT_MAX_K, union_kind_arrays } from "./gen_context.wado";
use { is_simple_cst_group, is_token_only_group, is_general_group } from "./gen_util.wado";
use { TreeMap, TreeSet } from "core:collections";

/// FOLLOW set for a parser rule, in the classical ANTLR4 sense:
/// the set of token kinds that may legally appear immediately after a
/// successful parse of the rule, accumulated across every call site
/// reachable from the start rule.
///
/// `kinds` is a `TreeSet` so the fixed-point solver's repeated
/// `follow_union` / `follow_eq` calls run at `O(|b| log |a|)` instead
/// of the linear `Array::contains` scan they would do on an `Array`.
/// `closed` tracks whether the set is "closed under EOF": i.e. whether
/// the start rule (or any rule reachable from it through a strictly
/// nullable suffix chain) is known to be terminated by EOF.
pub struct FollowSet {
    pub kinds: TreeSet<String>,
    pub closed: bool,
}

impl FollowSet {
    pub fn empty() -> FollowSet {
        return FollowSet { kinds: TreeSet::<String>::new(), closed: false };
    }
}

/// Pure analysis output: the FOLLOW environment of a grammar.
///
/// Built once from the parser-rule IR via [`build`]. No codegen state,
/// no `CodeWriter`. The pre-computed snapshot is what `lower_with_ctx`
/// (via [`register_follow_variants`]) populates the follow-variant
/// registry from before lower's element walks consult it through
/// `GenContext::lookup_follow_variant_id`. The legacy on-the-fly path
/// (lower calling `intern_follow_variant` from its `RuleRef` arms) was
/// retired alongside the Phase 2 switch — the registry is now frozen
/// before lower's IR build and consumed read-only by everyone
/// downstream.
pub struct FollowEnv {
    /// Token kinds the rule may *greedily* consume at tail position
    /// (Optional/Star/Plus elements with no required successor in the
    /// alt). Restricted to single-token-inner repeats: see
    /// `gen_context::tail_greedy_first_of_element` for the soundness
    /// argument. Lifted into `FollowEnv` so subsequent Phase 1 steps
    /// can compute against a snapshot independent of the codegen-side
    /// cache.
    tail_greedy: TreeMap<String, Array<String>>,
    /// Per-rule FOLLOW set, populated by [`build`]. The `closed` flag
    /// indicates the rule is reachable from the start rule by a chain
    /// whose ultimate suffix is EOF — i.e. EOF is in `kinds` because
    /// of EOF reachability rather than an explicit `EOF` token in
    /// some caller.
    rule_follow: TreeMap<String, FollowSet>,
}

impl FollowEnv {
    /// Skeleton variant: the empty environment. Used in tests and as
    /// the starting point for incremental wiring.
    pub fn empty() -> FollowEnv {
        return FollowEnv {
            tail_greedy: TreeMap::<String, Array<String>>::new(),
            rule_follow: TreeMap::<String, FollowSet>::new(),
        };
    }

    /// Tail-greedy first set for `rule_name`. Returns the empty array
    /// for unknown rules, which is the safe choice: an unknown rule
    /// cannot collide with any caller's follow.
    pub fn tail_greedy(&self, rule_name: &String) -> Array<String> {
        if let Some(s) = self.tail_greedy.get(*rule_name) {
            return s;
        }
        return [];
    }

    /// FOLLOW set for `rule_name`. Returns the empty/closed=false set
    /// for unknown rules.
    pub fn rule_follow(&self, rule_name: &String) -> FollowSet {
        if let Some(s) = self.rule_follow.get(*rule_name) {
            return s;
        }
        return FollowSet::empty();
    }
}

/// Build the FOLLOW environment for a grammar.
///
/// `start_rule` seeds `FOLLOW(start_rule) = {EOF, closed=true}`. When
/// `start_rule` is empty or unknown, no rule is seeded with EOF and the
/// resulting `rule_follow` reflects only call-graph contributions —
/// useful for sub-grammar analysis or tests that exercise propagation
/// without an EOF anchor.
pub fn build(parser_rules: &Array<ParserRule>, ctx: &mut GenContext, start_rule: &String) -> FollowEnv {
    let mut tail_greedy = TreeMap::<String, Array<String>>::new();
    for let rule of parser_rules {
        let mut visiting: Array<String> = [];
        let tg = ctx.tail_greedy_first_of_rule(&rule.name, &mut visiting);
        tail_greedy[rule.name] = tg;
    }
    let rule_follow = compute_rule_follow(parser_rules, ctx, start_rule);
    register_follow_variants(parser_rules, ctx);
    return FollowEnv { tail_greedy, rule_follow };
}

/// Pre-pass: register every `(rule, mask, k_prefix_mask)` follow-variant
/// triple by walking each parser rule's body and calling
/// `ctx.intern_follow_variant` at every `RuleRef` call site.
///
/// The walk mirrors the lower-time element traversal: at each
/// element position we derive the call-site `outer_follow` /
/// `outer_k_prefix` via `compute_call_site_follow_and_mask` /
/// `compute_call_site_k_prefix_mask`, then recurse into compound
/// shapes (`Group`, `Repeat`, `Label`) so deeply-nested `RuleRef`s
/// also get registered. Each registered variant's body is walked
/// again with the variant's mask threaded (`variant_mask`,
/// `variant_k_prefix_mask`), to a fixed point — a variant's body
/// may discover further call sites that need their own variants.
///
/// The pre-pass mirrors lower's twin walk (parse-side via `lower_op`
/// and scan-side via `lower_scan_element`) so that every
/// `(rule, mask, k_prefix_mask)` triple lower would intern is already
/// present in the registry by the time lower's element walk runs.
/// Lower's two `RuleRef` arms consume the registry via
/// `lookup_follow_variant_id` (which panics on a missing key, so
/// drift between this walker and lower surfaces immediately).
///
/// Wired into `lower_with_ctx` as the very first step, so callers
/// don't have to remember to populate the registry separately. The
/// walk is idempotent — repeat invocations with the same parser
/// rules see the canonical keys already present and return the
/// cached ids without registering duplicates.
///
/// The two walks are intentionally separate. While most shapes
/// (`SingleAlt`, `General`, `Repeat`, `Label`) propagate identical
/// follow at corresponding positions, `SimpleCst` and `TokenOnly`
/// groups diverge:
/// * Parse side: `lower_simple_cst_alt_call` hardcodes `variant_id =
///   null` for the inner `RuleRef`, and `lower_token_only_leaf`
///   never reaches an intern call (leaves only). So neither shape
///   registers parse-side variants for inner elements.
/// * Scan side, inline (within `lower_simple_cst_group` /
///   `lower_token_only_group`): uses `&empty_follow` for the inline
///   scan body — empty intersection, no variant registered.
/// * Scan side, standalone (via `lower_simple_cst_scan_group` from
///   `lower_scan_group`): uses the propagated `outer_follow`, which
///   may register a variant.
///
/// LR alts skip the leading self-ref position to mirror
/// `lower_lr_alt_suffix` (which lowers `alt.elements[1..]`).
pub fn register_follow_variants(parser_rules: &Array<ParserRule>, ctx: &mut GenContext) {
    let empty_mask: Array<String> = [];
    let empty_k_mask: Array<Array<String>> = [];

    // Pass 1: walk every parser rule body, parse-side and scan-side.
    for let rule of parser_rules {
        walk_rule_alts(rule, ctx, &empty_mask, &empty_k_mask);
    }

    // Pass 2: walk each registered variant's body with the variant's
    // mask threaded, to a fixed point — a variant body may register
    // new variants whose bodies must also be walked.
    let mut walked = 0;
    loop {
        let entries = ctx.follow_variants();
        if entries.len() == walked {
            break;
        }
        for let mut i = walked; i < entries.len(); i += 1 {
            let entry = entries[i];
            let rule_opt = ctx.find_rule(&entry.rule_name);
            let rule = if let Some(r) = rule_opt {
                r;
            } else {
                continue;
            };
            walk_rule_alts(rule, ctx, &entry.mask, &entry.k_prefix_mask);
        }
        walked = entries.len();
    }
}

/// Walk every alt of a rule with LR awareness. For LR alts (those
/// beginning with a self-reference to the surrounding rule), the
/// leading self-ref is skipped so the walk mirrors
/// `lower_lr_alt_suffix` — lower never interns at position 0 of an
/// LR alt because the suffix lowering starts at index 1.
fn walk_rule_alts(rule: &ParserRule, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) {
    for let alternative of &rule.alternatives {
        let start = if alt_is_left_recursive(alternative, &rule.name) {
            1;
        } else {
            0;
        };
        walk_alt_range_parse(&alternative.elements, start, ctx, variant_mask, variant_k_prefix_mask);
        walk_alt_range_scan(&alternative.elements, start, ctx, variant_mask, variant_k_prefix_mask);
    }
}

/// Returns true when the alt's first element is a `RuleRef` (possibly
/// labelled) to `rule_name` — the same check `lower::alt_is_left_recursive`
/// uses. Replicated here so the pre-pass doesn't pull lower into the
/// analysis-layer import graph.
fn alt_is_left_recursive(alt: &Alternative, rule_name: &String) -> bool {
    if alt.elements.is_empty() {
        return false;
    }
    return element_is_self_ref(&alt.elements[0], rule_name);
}

fn element_is_self_ref(elem: &Element, rule_name: &String) -> bool {
    if let RuleRef(r) = elem {
        return r.name == *rule_name;
    }
    if let Label(lab) = elem {
        return element_is_self_ref(&lab.element, rule_name);
    }
    return false;
}

/// Parse-side walk of an alt's element list. Mirrors `lower_alt_body`
/// (and the inner walkers `lower_single_alt_group` / `lower_general_group`):
/// for each position `i`, compute `elem_follow` via
/// `compute_call_site_follow(elements, i, variant_mask)`, then descend
/// into the element with that follow.
fn walk_parse_alt(elements: &Array<Element>, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) {
    walk_alt_range_parse(elements, 0, ctx, variant_mask, variant_k_prefix_mask);
}

/// Scan-side walk of an alt's element list. Mirrors
/// `lower_alt_scan_element` (top-level scan body) plus the per-shape
/// scan-side group lowerings reached from `lower_scan_group`.
fn walk_scan_alt(elements: &Array<Element>, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) {
    walk_alt_range_scan(elements, 0, ctx, variant_mask, variant_k_prefix_mask);
}

/// Parse-side walk starting at element index `start`. The `start`
/// offset is `1` for LR alts (mirroring `lower_lr_alt_suffix`) and
/// `0` everywhere else.
fn walk_alt_range_parse(elements: &Array<Element>, start: i32, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) {
    for let mut i = start; i < elements.len(); i += 1 {
        let outer_follow = ctx.compute_call_site_follow(elements, i, variant_mask);
        let outer_k_prefix = ctx.compute_call_site_k_prefix_mask(elements, i, FOLLOW_VARIANT_MAX_K, variant_k_prefix_mask);
        intern_parse_for_element(&elements[i], ctx, &outer_follow, &outer_k_prefix, variant_mask, variant_k_prefix_mask);
    }
}

/// Scan-side walk starting at element index `start`. The `start`
/// offset is `1` for LR alts (mirroring `lower_lr_alt_scan_suffix`)
/// and `0` everywhere else.
fn walk_alt_range_scan(elements: &Array<Element>, start: i32, ctx: &mut GenContext, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) {
    for let mut i = start; i < elements.len(); i += 1 {
        let outer_follow = ctx.compute_call_site_follow(elements, i, variant_mask);
        let outer_k_prefix = ctx.compute_call_site_k_prefix_mask(elements, i, FOLLOW_VARIANT_MAX_K, variant_k_prefix_mask);
        intern_scan_for_element(&elements[i], ctx, &outer_follow, &outer_k_prefix, variant_mask, variant_k_prefix_mask);
    }
}

/// Parse-side element dispatch. Mirrors `lower_op`'s RuleRef arm and
/// the parse-side group lowerings (`lower_simple_cst_group`,
/// `lower_token_only_group`, `lower_single_alt_group`,
/// `lower_general_group`).
///
/// `SimpleCst` groups deliberately skip the inner intern — their
/// parse op is built by `lower_simple_cst_alt_call` which hardcodes
/// `variant_id = null`. `TokenOnly` groups have no inner `RuleRef`s.
fn intern_parse_for_element(elem: &Element, ctx: &mut GenContext, outer_follow: &Array<String>, outer_k_prefix: &Array<Array<String>>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) {
    if let RuleRef(r) = elem {
        // Mirrors `lower_op`'s RuleRef arm (lower.wado line 1891).
        ctx.intern_follow_variant(&r.name, outer_follow, outer_k_prefix, /*is_scan=*/ false);
        return;
    }
    if let Group(g) = elem {
        let alts = &g.alternatives;
        if alts.len() == 1 {
            // SingleAlt path: lower_single_alt_group walks alt
            // elements with `compute_call_site_follow(_, _, variant_mask)`.
            walk_parse_alt(&alts[0].elements, ctx, variant_mask, variant_k_prefix_mask);
            return;
        }
        if is_token_only_group(alts) || is_simple_cst_group(alts) {
            // Both shapes skip parse-side intern: token-only has no
            // RuleRefs at all; simple_cst's `lower_simple_cst_alt_call`
            // hardcodes `variant_id = null`.
            return;
        }
        if is_general_group(alts) {
            // General group: lower_general_group walks each inner
            // alt's elements with the same per-position follow shape
            // as a top-level alt.
            for let inner_alt of alts {
                walk_parse_alt(&inner_alt.elements, ctx, variant_mask, variant_k_prefix_mask);
            }
            return;
        }
        // Unrecognised group shape — lower would panic too; mirror the
        // silent skip so analysis stays terminating.
        return;
    }
    if let Repeat(rep) = elem {
        // Repeat inner sits at the iter position with
        // `iter_follow = first(inner) ∪ outer_follow`. K-prefix flips
        // to `[]`. Mirrors `lower_repeat_op` line ~2583.
        let mut visiting: Array<String> = [];
        let inner_first = ctx.first_of_element(&rep.element, &mut visiting);
        let iter_follow = union_kind_arrays(&inner_first, outer_follow);
        let empty_k_mask: Array<Array<String>> = [];
        intern_parse_for_element(&rep.element, ctx, &iter_follow, &empty_k_mask, variant_mask, variant_k_prefix_mask);
        return;
    }
    if let Label(lab) = elem {
        intern_parse_for_element(&lab.element, ctx, outer_follow, outer_k_prefix, variant_mask, variant_k_prefix_mask);
        return;
    }
    // `Not`, `TokenRef`, `Literal`, `Wildcard`: leaves with no RuleRef.
}

/// Scan-side element dispatch. Mirrors `lower_scan_element` and the
/// scan-side group lowerings reached from `lower_scan_group`.
///
/// Unlike the parse side, `SimpleCst` and `TokenOnly` groups DO walk
/// their inner elements on the scan path — `lower_simple_cst_scan_group`
/// passes `outer_follow` directly to `lower_scan_element` for each
/// alt's single `RuleRef`. `TokenOnly` inner elements are leaves so
/// the walk is a no-op for variant interning.
fn intern_scan_for_element(elem: &Element, ctx: &mut GenContext, outer_follow: &Array<String>, outer_k_prefix: &Array<Array<String>>, variant_mask: &Array<String>, variant_k_prefix_mask: &Array<Array<String>>) {
    if let RuleRef(r) = elem {
        // Mirrors `lower_scan_element`'s RuleRef arm (lower.wado line 1399).
        ctx.intern_follow_variant(&r.name, outer_follow, outer_k_prefix, /*is_scan=*/ true);
        return;
    }
    if let Group(g) = elem {
        let alts = &g.alternatives;
        if alts.len() == 1 {
            let alt = &alts[0];
            if alt.elements.len() == 1 {
                // Transparent (scan): lower_scan_group line 1426 —
                // single element of a single-alt Group inherits the
                // surrounding `outer_follow` directly.
                intern_scan_for_element(&alt.elements[0], ctx, outer_follow, outer_k_prefix, variant_mask, variant_k_prefix_mask);
                return;
            }
            // Single-alt with multiple elements (scan): lower_scan_group
            // walks each position via `lower_alt_scan_element`, which
            // computes per-position `elem_follow`.
            walk_scan_alt(&alt.elements, ctx, variant_mask, variant_k_prefix_mask);
            return;
        }
        if is_token_only_group(alts) {
            // lower_scan_group line 1448: each alt's single element is
            // TokenRef/Literal — no RuleRef to intern.
            return;
        }
        if is_simple_cst_group(alts) {
            // lower_simple_cst_scan_group line ~2338: for each alt's
            // single RuleRef element, intern with `outer_follow` (the
            // Group's surrounding follow).
            for let inner_alt of alts {
                if inner_alt.elements.len() == 1 {
                    intern_scan_for_element(&inner_alt.elements[0], ctx, outer_follow, outer_k_prefix, variant_mask, variant_k_prefix_mask);
                }
            }
            return;
        }
        if is_general_group(alts) {
            // lower_general_scan_group: walk each inner alt with the
            // standard per-position follow.
            for let inner_alt of alts {
                walk_scan_alt(&inner_alt.elements, ctx, variant_mask, variant_k_prefix_mask);
            }
            return;
        }
        return;
    }
    if let Repeat(rep) = elem {
        // lower_scan_repeat line 1526-1528: same iter_follow as parse
        // side.
        let mut visiting: Array<String> = [];
        let inner_first = ctx.first_of_element(&rep.element, &mut visiting);
        let iter_follow = union_kind_arrays(&inner_first, outer_follow);
        let empty_k_mask: Array<Array<String>> = [];
        intern_scan_for_element(&rep.element, ctx, &iter_follow, &empty_k_mask, variant_mask, variant_k_prefix_mask);
        return;
    }
    if let Label(lab) = elem {
        intern_scan_for_element(&lab.element, ctx, outer_follow, outer_k_prefix, variant_mask, variant_k_prefix_mask);
        return;
    }
    // `Not`, `TokenRef`, `Literal`, `Wildcard`: leaves with no RuleRef.
}

/// Compute the per-rule FOLLOW set as a worklist fixed point.
///
/// Initialisation: `FOLLOW(start_rule) = {EOF, closed=true}`; every
/// other rule starts with the empty/non-closed set. Each iteration
/// walks every rule's body and contributes `local_follow` to
/// `FOLLOW(callee)` at each `RuleRef(callee)` site, where
/// `local_follow = first(suffix) ∪ (suffix deep-nullable →
/// FOLLOW(enclosing context))`. The enclosing context is the rule's
/// own FOLLOW for top-level alts, and the surrounding group's
/// effective follow for inner alts (computed recursively via the same
/// formula as the walker descends).
///
/// Termination: every iteration that doesn't grow any rule's set is
/// the last; the algorithm terminates because each set is monotonic
/// in a finite token universe.
fn compute_rule_follow(parser_rules: &Array<ParserRule>, ctx: &mut GenContext, start_rule: &String) -> TreeMap<String, FollowSet> {
    let mut env = TreeMap::<String, FollowSet>::new();
    for let rule of parser_rules {
        env[rule.name] = FollowSet::empty();
    }
    if !start_rule.is_empty() {
        if env.contains_key(*start_rule) {
            let mut seed = TreeSet::<String>::new();
            seed.insert("TK_EOF");
            env[*start_rule] = FollowSet { kinds: seed, closed: true };
        }
    }

    loop {
        let mut changed = false;
        for let caller of parser_rules {
            let caller_follow = env[caller.name];
            for let alt of &caller.alternatives {
                walk_for_contributions(&alt.elements, ctx, &caller_follow, &mut env, &mut changed);
            }
        }
        if !changed {
            break;
        }
    }
    return env;
}

/// Walk an element list, computing per-position effective follow and
/// reporting `RuleRef` contributions into `env`. `outer_follow` is the
/// FOLLOW set at the position immediately after this element list
/// (i.e. either the enclosing rule's FOLLOW or the surrounding
/// group's effective follow). `Group` recurses with the local follow
/// at the group's position; `Repeat` recurses with `first(inner) ∪
/// local_follow` so that the inner's siblings (after one iteration)
/// see the start-of-inner contributions plus the loop exit follow.
fn walk_for_contributions(elements: &Array<Element>, ctx: &mut GenContext, outer_follow: &FollowSet, env: &mut TreeMap<String, FollowSet>, changed: &mut bool) {
    for let mut i = 0; i < elements.len(); i += 1 {
        let local = local_follow(elements, i, ctx, outer_follow);
        contribute_for_element(&elements[i], ctx, &local, env, changed);
    }
}

fn contribute_for_element(elem: &Element, ctx: &mut GenContext, local: &FollowSet, env: &mut TreeMap<String, FollowSet>, changed: &mut bool) {
    match elem {
        RuleRef(r) => {
            if env.contains_key(r.name) {
                let old = env[r.name];
                let merged = follow_union(&old, local);
                if !follow_eq(&old, &merged) {
                    env[r.name] = merged;
                    *changed = true;
                }
            }
        },
        Group(g) => {
            for let inner_alt of &g.alternatives {
                walk_for_contributions(&inner_alt.elements, ctx, local, env, changed);
            }
        },
        Repeat(rep) => {
            let mut fv: Array<String> = [];
            let inner_first = ctx.first_of_element(&rep.element, &mut fv);
            let inner_outer = follow_union(local, &follow_set_from_array(&inner_first, false));
            contribute_for_element(&rep.element, ctx, &inner_outer, env, changed);
        },
        Label(lab) => {
            contribute_for_element(&lab.element, ctx, local, env, changed);
        },
        TokenRef(_) | Literal(_) | Wildcard(_) | Not(_) => {
        },
    }
}

/// Effective follow at position `i` in `elements`:
/// `first(elements[i+1..]) ∪ (suffix deep-nullable → outer_follow)`.
fn local_follow(elements: &Array<Element>, i: i32, ctx: &mut GenContext, outer_follow: &FollowSet) -> FollowSet {
    let suffix_first = ctx.first_of_elements_from(elements, i + 1);
    let mut kinds = TreeSet::<String>::new();
    for let k of &suffix_first {
        kinds.insert(*k);
    }
    let mut closed = false;
    if ctx.tail_is_nullable_deep(elements, i + 1) {
        for let k of &outer_follow.kinds {
            kinds.insert(k);
        }
        closed = outer_follow.closed;
    }
    return FollowSet { kinds, closed };
}

/// Build a `FollowSet` from an `Array<String>` first-set. Used at the
/// boundary where `GenContext` returns an `Array<String>` and the
/// FollowEnv-internal representation is a `TreeSet<String>`.
fn follow_set_from_array(arr: &Array<String>, closed: bool) -> FollowSet {
    let mut kinds = TreeSet::<String>::new();
    for let k of arr {
        kinds.insert(*k);
    }
    return FollowSet { kinds, closed };
}

/// `O((|a|+|b|) log(|a|+|b|))` union into a fresh `TreeSet`.
///
/// We deliberately do **not** start from `a.kinds` and insert `b`'s
/// elements into it. `TreeSet`/`TreeMap` field copies are shallow —
/// the underlying tree nodes (`root: Option<&mut TreeMapNode>`) are
/// shared — so mutating a "copy" can also mutate the tree the caller
/// still holds via `env[name]`. The fixed-point loop relies on
/// `follow_eq(old, merged)` distinguishing the pre- and post-union
/// values, so building the result in a fresh set is the only sound
/// option until the underlying collection grows a deep clone or
/// persistent semantics.
fn follow_union(a: &FollowSet, b: &FollowSet) -> FollowSet {
    let mut kinds = TreeSet::<String>::new();
    for let k of &a.kinds {
        kinds.insert(k);
    }
    for let k of &b.kinds {
        kinds.insert(k);
    }
    return FollowSet { kinds, closed: a.closed || b.closed };
}

/// `O(|a| log |b|)` equality: cardinalities first, then membership of
/// every element of `a` in `b`.
fn follow_eq(a: &FollowSet, b: &FollowSet) -> bool {
    if a.closed != b.closed {
        return false;
    }
    if a.kinds.len() != b.kinds.len() {
        return false;
    }
    for let k of &a.kinds {
        if !b.kinds.contains(k) {
            return false;
        }
    }
    return true;
}
