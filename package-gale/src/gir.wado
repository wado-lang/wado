//! Gale IR (GIR) — the lowered IR consumed by parser code generation.
//!
//! The pipeline is:
//!
//! ```text
//! .g4 source ──parse──► Grammar (surface IR, ir.wado)
//!                ──lower──► LoweredGrammar (this module, gir.wado)
//!                ──emit──► Wado source
//! ```
//!
//! `Grammar` mirrors the .g4 syntax. `LoweredGrammar` is the form
//! parser emit consumes after every analysis decision (rule shape,
//! multi-alt dispatch, LR precedence, per-call-site FOLLOW args, group
//! shape, repeat strategy, field deduplication, scan/parse symmetry) is
//! committed at lower time. emit becomes a structural translation
//! that does not consult `Grammar`.
//!
//! Design constraints:
//!
//! * Self-contained surface — does **not** re-export `ir::Element`,
//!   `ir::ParserRule`, etc. `Element` here is the lowered element
//!   type. This is deliberate: the boundary exists so emit cannot
//!   reach back to surface IR for an ad-hoc decision. Modules that
//!   bridge (i.e. `lower.wado`) import the surface IR with `as`
//!   aliases.
//! * Pure data — no methods that perform analysis. Constructors that
//!   help with frequent shapes are allowed; they must not consult
//!   the original grammar.
//! * Stable across runs — every collection that influences generated
//!   identifiers (kind-set ids, follow-mask ids, group indices,
//!   field-name dedup counters) is laid out by `lower` in
//!   deterministic order.
//!
//! Reused from the surface IR: `Visibility`, `OptionValue`,
//! `GrammarOption`, `NamedAction`, `LexerRule`, `RepeatKind`. These
//! are pure markers or unmodified passthrough data; duplicating them
//! would invite drift without semantic benefit.

use { Visibility, OptionValue, GrammarOption, NamedAction, LexerRule, RepeatKind } from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";

// ==========================================================================
// Top-level
// ==========================================================================

/// The complete lowered grammar consumed by parser-side code
/// generation. Lexer / visitor / highlight emission still take
/// surface `Grammar` in v1; their data is included here so that a
/// future migration can drop the surface IR entirely.
///
/// Construction is the responsibility of `lower(Grammar)`; consumers
/// treat all fields as read-only. The struct is plain data so a
/// `LoweredGrammar` value can be borrowed across emit functions
/// without a `&mut` ceremony.
pub struct LoweredGrammar {
    /// Grammar name (`grammar Foo;`). Drives generated identifiers
    /// and the entry module filename.
    pub name: String,
    /// `.g4` source paths the grammar was assembled from. Round-tripped
    /// into the generated header's `#![generated(... sources = [...])]`.
    pub source_files: List<String>,
    /// Grammar-level options from `options { ... }` prequels. Only
    /// surfaced as a comment block by `gen_grammar_metadata`; carried
    /// for round-trip visibility.
    pub options: List<GrammarOption>,
    /// Grammar-level `@name { ... }` actions. Same comment-block
    /// passthrough as `options`.
    pub named_actions: List<NamedAction>,
    /// Lexer rules in source order. Lexer emission consumes these
    /// directly (no per-rule lowering performed in v1). The vector
    /// includes `is_virtual = true` entries from `tokens { }` blocks.
    pub lexer_rules: List<LexerRule>,
    /// Mode names indexed by `LexerRule.mode` / `set_mode` /
    /// `push_mode`. Index 0 is always `DEFAULT_MODE`.
    pub mode_names: List<String>,
    /// Channel registry from `channels { }` blocks plus the
    /// implicit defaults. Carried for lexer emission.
    pub channels: List<String>,
    /// Literal tokens (`'foo'` occurrences in parser rules) collected
    /// and assigned `LIT_<id>` constants. Computed once during
    /// lowering and reused by both lexer and parser emission.
    pub lit_tokens: List<LitToken>,
    /// Lowered parser rules in source order. `parser_rules[0]` is the
    /// start rule (per ANTLR4 convention) and seeds `gen_parse_entry`.
    pub parser_rules: List<Rule>,
    /// Interned multi-element token-kind sets. `lower` rewrites every
    /// `<expr> matches { TK_X | TK_Y | ... }` decision into a
    /// `_gale_kind_set_<id>(<expr>)` call; this list drives the
    /// helper-function emission.
    pub kind_sets: List<KindSet>,
    /// Prediction-strategy diagnostics raised while lowering picked a
    /// dispatch strategy. These are advisory warnings, not errors:
    /// lowering always produces a usable grammar, but a warning flags a
    /// spot where Gale could not decide an alternative cleanly (today:
    /// overlapping alts resolved by a scan tournament) so a grammar
    /// author can question their own grammar before blaming Gale.
    /// Surfaced on stderr by `gale gen` and inline by `gale dump`. In
    /// the order lowering raised them, deduped on `(rule, message)`.
    pub diagnostics: List<Diagnostic>,
}

/// A prediction-strategy diagnostic attached to a single decision site.
/// See `LoweredGrammar.diagnostics`. `rule` is the human-readable owner
/// label the lowering site used (`rule 'r'`, `LR rule 'expr' atom`,
/// `General group rGroup0`, `SimpleCst group`) — not a bare rule name,
/// which is why `dump.wado` re-associates by substring rather than
/// equality (a structured owner id is a tracked follow-up). `kind`
/// classifies the decision for tooling; `message` is the one-liner shown
/// to grammar authors.
pub struct Diagnostic {
    pub rule: String,
    pub kind: DiagnosticKind,
    pub message: String,
}

/// Classifies a prediction-strategy diagnostic. Each variant marks a
/// spot where static prediction could not decide an alternative by a
/// disjoint first-set / fixed lookahead alone and fell back to a
/// coarser strategy.
///
/// Only the strategy fallbacks Gale actually raises today are listed.
/// New kinds land here together with the lowering site that raises them
/// and a fixture — an `OptionalScanGuardFallback` (warn when an `e?`
/// resolves to `OptionalScanGuard`) is the obvious next one, deferred
/// until `pick_optional_specialised` threads the enclosing rule name
/// (tracked in TODO.md).
pub variant DiagnosticKind {
    /// Two or more alts share a leading token; the overlap is resolved
    /// by a scan-side longest-match tournament rather than a token-led
    /// `if/else` chain. Sound, but the author may have intended
    /// disjoint alts.
    OverlapTournament,
}

// ==========================================================================
// Rules
// ==========================================================================

/// A lowered parser rule. The variant captures the rule-level
/// dispatch shape; element-level lowering lives inside `Body` /
/// `AltBody`.
///
/// Surface-IR `ParserRule.alternatives` is split here based on the
/// rule's parse strategy:
///
/// * `Simple` — exactly one alternative, no dispatch needed.
/// * `MultiAlt` — two or more alternatives, none of which is
///   left-recursive.
/// * `LeftRecursive` — at least one alternative is directly
///   left-recursive (its first non-trivial element is a self-ref).
///   Non-LR alternatives become the `atom` body; LR alternatives
///   become `lr_alts`.
pub variant Rule {
    Simple(SimpleRule),
    MultiAlt(MultiAltRule),
    LeftRecursive(LeftRecursiveRule),
}

/// Information common to every rule shape, gathered into a single
/// header struct so the variant-payload structs don't repeat the
/// fields. Keeps `Rule` traversals uniform: `rule_header(&rule)`
/// returns this regardless of the variant.
pub struct RuleHeader {
    /// Rule name as it appears in the .g4 source (`expr`, `select_stmt`).
    pub name: String,
    /// `to_snake_case(name)` cached at lowering time. Drives
    /// `parse_<snake>` / `scan_<snake>` function names.
    pub snake_name: String,
    /// `escape_ident(snake_name)` cached at lowering time. Used as a
    /// standalone field name when the rule appears inside another
    /// struct.
    pub field_name: String,
    /// CST struct/variant type name (`ExprNode`).
    pub type_name: String,
    /// `pub` / `protected` / `private` / default. Only `Default` and
    /// `Public` affect generated visibility today; the rest are
    /// preserved for round-trip / future tooling.
    pub visibility: Visibility,
    /// Cached `case_names_for_rule(&rule.alternatives)`. Empty for
    /// `Simple`. Indexed by alt position in the original rule body.
    pub case_names: List<String>,
}

/// Single-alternative rule. The body is emitted directly inside
/// `parse_<snake>` / `scan_<snake>` with no dispatch.
pub struct SimpleRule {
    pub header: RuleHeader,
    pub body: AltBody,
    pub scan_body: ScanBody,
}

/// Multi-alternative rule (no left recursion). Each alt is emitted
/// either inline (when the alt is the only one in its overlap
/// group) or as a `parse_<snake>_bt_<idx>` helper plus a
/// dispatch entry.
pub struct MultiAltRule {
    pub header: RuleHeader,
    /// One per alternative in original source order. The vector
    /// runs parallel to the alt index; multi-alt dispatch refers to
    /// alts by their original index, not by the order of appearance
    /// in any group.
    pub alts: List<AltBody>,
    /// Scan-side counterpart of `alts`, again indexed by original
    /// alt index.
    pub scan_alts: List<ScanBody>,
    /// Parse-side dispatch shape between the alternatives.
    pub dispatch: MultiAltDispatch,
    /// Scan-side dispatch shape. Frequently differs from `dispatch`:
    /// scan side uses first-success-wins on
    /// `sort_group_by_element_count` ordering, parse side uses
    /// `sort_group_by_specificity`. Both decisions are made at lower
    /// time so emit doesn't reproduce the sort logic.
    pub scan_dispatch: MultiAltDispatch,
}

/// Direct left-recursive rule. The atom holds the non-LR alternatives
/// (potentially multi-alt itself); the LR alternatives are decomposed
/// into prefix-stripped suffixes plus the metadata required to
/// emit precedence-climbing dispatch.
pub struct LeftRecursiveRule {
    pub header: RuleHeader,
    /// Non-LR alternatives, lowered as a single multi-alt body. When
    /// only one non-LR alt exists, this is still a `MultiAltRule`
    /// with a `MultiAltDispatch::Direct` that has a single branch —
    /// emit treats both cases uniformly.
    pub atom: MultiAltRule,
    /// LR alternatives (those whose first non-trivial element is a
    /// self-ref to this rule), in original source order. Each carries
    /// its own precedence assignment, conflict bound, last self-ref
    /// position, and suffix first-set.
    pub lr_alts: List<LrAlt>,
    /// Precedence-aware dispatch metadata for the LR suffix loop.
    /// Captures the overlap groups between LR suffix first-sets and
    /// the second-token disambiguation needed when first-tokens
    /// collide.
    pub lr_dispatch: LrDispatchData,
}

/// One left-recursive alternative, with the prefix self-reference
/// stripped and replaced by precedence-climbing semantics.
pub struct LrAlt {
    /// Index of the alternative in the original rule body. Drives
    /// the `_lr_<idx>` suffix-helper function name.
    pub alt_index: i32,
    /// CST case name (e.g. `BinaryExpr`) for the alt. Mirrors the
    /// surface case_names entry for the same alt index.
    pub case_name: String,
    /// CST struct name for the alt's payload (e.g. `ExprBinaryExpr`).
    pub struct_name: String,
    /// Suffix elements (everything after the leading self-ref). The
    /// suffix's first element is what the prediction loop dispatches
    /// on; an LR alt with no suffix elements (`expr : expr`) is
    /// degenerate and not registered here.
    pub suffix: AltBody,
    /// Scan-side mirror of `suffix`.
    pub scan_suffix: ScanBody,
    /// Precedence assigned to this alt by ANTLR4's left-recursion
    /// rewrite. The LAST LR alt has the highest precedence; ties
    /// follow source order. Right-associative alts use this same
    /// value for the inner self-ref call (`min_prec = own_prec`),
    /// left-associative use `own_prec + 1`.
    pub own_prec: i32,
    /// Minimum precedence required for the loop to enter this alt.
    /// Equal to `own_prec` for left-associative and
    /// `own_prec + 1`-derived adjustments for right-associative; the
    /// exact recipe is fixed in `compute_lr_conflict_min_prec`.
    pub conflict_min: i32,
    /// Index (within the alt's elements) of the LAST self-reference
    /// to the enclosing rule. -1 if there is no internal self-ref
    /// beyond the leading-prefix one. Used by emit so the trailing
    /// self-ref drops back to the LR loop with the right precedence.
    pub last_self_ref_idx: i32,
    /// First set of the LR suffix (i.e. the tokens that begin
    /// `elements[1..]`). Drives the precedence-aware dispatch
    /// in the LR loop.
    pub suffix_first: List<String>,
    /// True for `<assoc=right>` alts (driven by the alt option
    /// block, not source order). Affects how `own_prec` is reused
    /// for the trailing self-ref.
    pub right_associative: bool,
    /// FieldDecl for the leading self-reference that the LR rewrite
    /// stripped from `suffix.ops`. The CST struct for this alt still
    /// surfaces the left operand as a field — `suffix.fields` carries
    /// only the right-hand side, so emit prepends this decl when
    /// laying out the struct.
    pub prefix_self_ref: FieldDecl,
}

/// LR suffix dispatch metadata. The fields mirror
/// `compute_lr_dispatch_data` in legacy `parser_gen.wado`, but
/// computed once and stored.
pub struct LrDispatchData {
    /// Indices into `LeftRecursiveRule.lr_alts` of the alternatives
    /// that have a non-empty suffix. The degenerate `expr : expr`
    /// case is filtered out.
    pub valid_lr_alts: List<i32>,
    /// Overlap groups between the suffix first-sets. Each inner
    /// array lists indices into `valid_lr_alts`.
    pub groups: List<List<i32>>,
}

// ==========================================================================
// Multi-alt dispatch
// ==========================================================================

/// How a multi-alternative rule (or rule atom) dispatches between its
/// alts at parse time. Lowering picks exactly one variant per multi-
/// alt body; emit pattern-matches the variant and translates each
/// shape into the corresponding `if` chain / scan tournament.
///
/// Only the two shapes below are emitted today. The variant set has
/// been narrowed deliberately:
///
/// * `PredictDispatch` (a full SLL prediction-tree dispatch akin to
///   ANTLR4's `ParserATNSimulator`) — never required by any
///   committed grammar; emit's prediction tree
///   (`prediction::PredictionNode`) is an emit-private SLL
///   intermediary that does not surface in GIR.
/// * `PartialScanDispatch` (some-alts-scannable + others-fall-through)
///   — would let mixed scannable / unscannable alt sets coexist;
///   currently `Tournament` requires every alt to be scannable, and
///   unscannable alt sets are rejected at codegen time as a hard
///   `panic!`.
/// * `SaveRewindDispatch` (per-alt save-and-rewind) — last-ditch
///   backtracking fallback; removed when the bt → scan-dispatch
///   migration completed (see `package-gale/CLAUDE.md`
///   "Migration status (2026-04)").
///
/// Re-introducing any of the three is a deliberate act: extend this
/// variant, extend lower's classifier, and add the emit translator
/// at the same time. Until then, every overlap case must fit into
/// `Tournament`.
pub variant MultiAltDispatch {
    /// Alts have disjoint first-sets — straight token-led `if/else if`
    /// chain followed by an error fallback. Used by the bulk of
    /// "normal" rules.
    Direct(DirectDispatch),
    /// All non-last alts have full scan helpers (cover the entire
    /// alternative). Emit runs every scan, picks the longest, parses
    /// the winner. Equivalent to ANTLR4's longest-match LL choice.
    Tournament(TournamentDispatch),
}

/// Token-led dispatch for non-overlapping alts.
pub struct DirectDispatch {
    /// One branch per alt, in the order emit should test them.
    /// `tokens` is the alt's first-set; `alt_index` is the original
    /// alt position. Branches with overlapping `tokens` are not
    /// permitted — those land in `Tournament` instead.
    pub branches: List<DispatchBranch>,
}

pub struct DispatchBranch {
    pub tokens: List<String>,
    pub alt_index: i32,
}

/// Scan tournament dispatch.
pub struct TournamentDispatch {
    /// Original alt indices in dispatch order
    /// (`sort_group_by_element_count`). The longest-match scan
    /// winner triggers the corresponding `parse_<rule>_bt_<idx>`.
    pub alts: List<i32>,
}

// ==========================================================================
// Body and elements
// ==========================================================================

/// One alt body — the lowered form of a surface `Alternative`.
///
/// `fields` is ordered for the CST struct emission; `elements` drives
/// the parse-time emission. Both are derived from the same surface
/// alt; emitting them in parallel keeps struct-field order in lockstep
/// with the order locals are bound, which is what
/// `gen_field_assignments` relies on.
pub struct AltBody {
    /// Index into the enclosing rule's `alts` vector. Stable across
    /// lowering / scan / parse / variant emission.
    pub alt_index: i32,
    /// CST case name (`Str`, `Number`, `Plus`). Empty for
    /// `Simple` rules where the rule body itself is the struct.
    pub case_name: String,
    /// CST struct name for this alt's payload (`ValueStr`,
    /// `ExprPlus`, etc.). Equal to the rule's struct name for
    /// `Simple` rules.
    pub struct_name: String,
    /// Lowered ops, in lexical order. `Repeat` strategies are
    /// already chosen; `Group` shapes are already chosen; `Label`
    /// nodes have been collapsed into the wrapped op's `field`
    /// attribute.
    pub ops: List<Op>,
    /// CST struct field declarations in struct order. Includes the
    /// `span: Span` field as the first entry.
    pub fields: List<FieldDecl>,
    /// `min_prec` to pass to a self-recursive `RuleCall` inside this
    /// body. 0 when the alt is not a prefix-LR alt; positive value
    /// when ANTLR4's left-recursion rewrite assigns a precedence to
    /// the prefix self-ref. Surfaced as a per-alt field rather than
    /// per-element so prefix alts in non-LR contexts (which today
    /// pass through `compute_prefix_self_ref_min_prec`) are decided
    /// once at lower time.
    pub prefix_self_ref_min_prec: i32,
}

/// One lowered op — the per-position unit of work in a parse-time
/// alt body. Named `Op` rather than `Element` to keep the GIR
/// variant disjoint from `ir::Element` (Wado's variant elaborator
/// hits a global table by variant name; reusing `Element` would
/// alias one case space onto the other).
///
/// The variant tag selects the emit shape; the payload struct
/// carries the resolved attributes (token kind, dedupped field name,
/// follow arg, min-prec arg, etc.) that emit needs. Case
/// names within `Op` are scoped under the variant so they do not
/// collide with `ir::Element` cases of the same spelling.
pub variant Op {
    /// Named token reference (`ID`, `INT`, ...). `kind` is the
    /// global `TK_<name>` constant; emit produces
    /// `let <field> = p.expect(<kind>)?;`.
    Token(TokenOp),
    /// Inline string literal (`'+'`, `'fn'`). `kind` is the
    /// `LIT_<id>` constant assigned by `lower`'s literal collection
    /// pass.
    Literal(LiteralOp),
    /// Call into another rule. Carries the per-call-site `FollowArg`,
    /// min-prec arg, and dedupped binding name so emit doesn't
    /// re-derive the FOLLOW continuation.
    RuleCall(RuleCallOp),
    /// `.` wildcard. Consumes one token of any kind (matches
    /// `match_any` at runtime).
    Wildcard(WildcardOp),
    /// `~ X` set complement. `kinds` is the resolved exclusion set;
    /// emit produces `p.match_not([...])` (or `match_not_via_X` if
    /// the inner is a single-token RuleRef rule, recovered via
    /// `not_match_call`'s lower-time analogue).
    Excluded(ExcludedOp),
    /// `e?` / `e*` / `e+`. `strategy` selects the loop shape; emit
    /// is structural.
    Repeat(RepeatOp),
    /// `(...)` grouping. The shape determines whether the group is
    /// a storable subtree, a token-only field, a single-alt struct,
    /// a general variant, or a transparent inlining.
    Group(GroupOp),
    /// `name+=elem` list-label that is NOT wrapped in a Repeat. The
    /// outer struct field surfaces as `List<inner_type>` even
    /// though a single `+=` only contributes once per execution;
    /// emit's runtime construction (still surface-IR-driven in
    /// parser_gen) pre-allocates the array and `push`es the matched
    /// value. The scalar `=` label is folded into the inner op via
    /// `rebind_op_field` and does NOT produce this variant.
    ListLabel(ListLabelOp),
}

pub struct TokenOp {
    /// Global `TK_<name>` token kind constant.
    pub kind: String,
    /// Dedupped field name in the enclosing alt's CST struct.
    /// Already includes the `_2` / `_3` suffix where needed.
    pub field: String,
    /// Pre-dedup base name (the surface element's `field_name`).
    /// Drives emit's per-leaf `dedup_name(&dedup_base, name_counts)`
    /// sync so siblings that still walk surface IR (e.g.
    /// `gen_lr_suffix_helpers`'s inline RuleRef paths and
    /// `gen_element` fallbacks) observe the same count `gen_element`
    /// would have produced. For non-rebound leaves it matches the
    /// surface element's base name (so `dedup_base == field` when the
    /// leaf was the first occurrence in its alt). For label-rebound
    /// leaves (`name = ID` lowered to `Op::Token { field: "name",
    /// dedup_base: "name" }`) it carries the rebound label's base —
    /// the inner element's original base is intentionally dropped
    /// because the rebind elides the inner binding from emit. See
    /// `lower::rebind_op_field` for the rebind contract.
    pub dedup_base: String,
}

pub struct LiteralOp {
    /// `LIT_<id>` constant assigned during literal collection.
    pub kind: String,
    /// Dedupped field name. `lower` derives the base name from
    /// `literal_field_name` and applies dedup.
    pub field: String,
    /// Pre-dedup base name (`literal_field_name(&l.text)`). See
    /// `TokenOp.dedup_base` for the role.
    pub dedup_base: String,
}

/// How a `RuleCall` supplies the runtime FOLLOW continuation to the
/// callee, replacing the per-(rule, mask) `__follow_<id>` variant
/// selection. Exactly one of four forms:
///
/// - `NoFollow` — non-repair call: emit passes nothing, the callee's
///   defaulted `&EMPTY_FOLLOW` disables its tail-greedy gate.
/// - `Mask(id)` — the caller's continuation past the callee is a
///   statically-known K-prefix; emit passes `&FOLLOW_MASK_<id>`.
/// - `Forward` — the callee sits at THIS rule's tail, so its
///   continuation is whatever the current rule was itself called with;
///   emit forwards the current function's `follow` argument unchanged.
/// - `Combined(id)` — the callee is at this rule's tail but a nullable
///   local suffix precedes it; emit prepends `FOLLOW_MASK_<id>` to the
///   forwarded `follow` (see the variant doc below).
pub variant FollowArg {
    NoFollow,
    Mask(i32),
    Forward,
    /// The callee sits at this rule's tail but a NULLABLE local suffix
    /// precedes the tail (e.g. `… callee X? <end>`): the continuation is
    /// the local prefix `FOLLOW_MASK_<id>` followed by whatever the
    /// current rule was called with. Emit passes
    /// `&follow_prepend(&FOLLOW_MASK_<id>, follow)`.
    Combined(i32),
}

pub struct RuleCallOp {
    /// Target rule name as it appears in `.g4`. Drives parser-rule
    /// lookup at lower time; emit uses `target_snake` for the
    /// generated function name.
    pub target_name: String,
    /// `to_snake_case(target_name)` cached at lowering.
    pub target_snake: String,
    /// Runtime FOLLOW continuation passed to the callee. See `FollowArg`.
    /// Replaces the `variant_id` / `__follow_<id>` mechanism: the mask is
    /// threaded as data at runtime rather than baked into a cloned callee.
    pub follow_arg: FollowArg,
    /// `Some(p)` when the call should pass `p` as the `min_prec`
    /// argument. Set for self-recursive calls inside prefix LR alts.
    /// `None` is the default and corresponds to
    /// `parse_<rule>(p)` / `scan_<rule>(tokens, pos)` (both signatures
    /// accept a defaulted `min_prec = 0`).
    pub min_prec_arg: Option<i32>,
    /// Dedupped field name in the enclosing alt's struct.
    pub field: String,
    /// Pre-dedup base name (the surface RuleRef's `field_name`).
    /// See `TokenOp.dedup_base` for the role.
    pub dedup_base: String,
}

pub struct WildcardOp {
    pub field: String,
    /// Pre-dedup base name (`"wildcard"`). See `TokenOp.dedup_base`
    /// for the role.
    pub dedup_base: String,
}

pub struct ExcludedOp {
    /// Exclusion set. emit renders this as a literal token-array
    /// passed to `p.match_not([...])`.
    pub kinds: List<String>,
    pub field: String,
    /// Pre-dedup base name (`not_element_field_name(&ne.element)`).
    /// See `TokenOp.dedup_base` for the role.
    pub dedup_base: String,
}

/// `name+=elem` outside of a Repeat. The outer CST struct lays out
/// the field as `List<inner_type>`; emit pushes the matched value
/// into a list even though a single `+=` only contributes once.
pub struct ListLabelOp {
    /// Inner op the label wraps. Carries the runtime match shape
    /// (Token / RuleCall / Group / …); the wrapper exists only to
    /// surface the `List<>` typing.
    pub inner: Op,
    /// Outer CST struct field name (the label's name, deduped).
    pub field: String,
    /// Pre-dedup base name (`lab.field_name`). Drives the outer-label
    /// half of `sync_name_counts_for_op_list_label`'s sibling-dedup
    /// sync; the inner half delegates to the wrapped op's own
    /// `dedup_base`.
    pub dedup_base: String,
}

pub struct RepeatOp {
    pub kind: RepeatKind,
    /// Inner op (recursive — single-element only). Wado allows
    /// the recursive type-reference; the variant boxes through the
    /// payload struct.
    pub body: Op,
    /// Scan-side mirror of `body`. Lower computes it alongside the
    /// parse-side op so emit's scan-guard helpers
    /// (`emit_rep_scan_guard`, `emit_scan_guard_with_prefix`) can
    /// drive an op-driven scan walker over the inner element without
    /// the surface `gen_scan_*` graph as fallback.
    pub scan_body: ScanElement,
    pub strategy: RepeatStrategy,
    /// Outer struct field name. For `e*` / `e+` this is
    /// `<inner_base>_list`; for `e?` it's the inner element's base
    /// name. Deduped against the surrounding alt's name table at
    /// lower time. Distinct from `body.field` (the per-iteration
    /// binding inside the loop, which lives in its own fresh scope).
    pub field: String,
    /// Caller-side FOLLOW first set: tokens that can immediately
    /// follow this Repeat in the surrounding alt body. Computed at
    /// lower time from the position the Repeat occupies. Consumed
    /// by emit's per-position decisions for `Optional + RuleRef`
    /// (subtract from inner first to gate the optional fire) and
    /// non-greedy (continue/exit disambiguation). Empty when the
    /// Repeat is at the alt's tail.
    pub caller_follow_first: List<String>,
    /// True iff the inner element is fully scannable (has a complete
    /// `scan_<rule>` / inline scan equivalent). Drives emit's choice
    /// between `loop` + scan-guard and `while` + first-check loop
    /// shapes. Precomputed so emit doesn't re-run
    /// `ctx.is_element_scannable` at each Repeat dispatch.
    pub body_scannable: bool,
    /// FIRST set of the inner element. Used by emit's per-shape
    /// dispatchers for the `while peek ∈ first` loop guard, the
    /// `subtract_sets(first, follow)` Optional+RuleCall gate, and
    /// `compute_iter_follow`'s iter-follow union. Precomputed so
    /// emit doesn't re-run `ctx.first_of_element` at each dispatch.
    pub body_first_set: List<String>,
    /// True iff the inner element is a single-alt `Group` — i.e.
    /// `compute_iter_follow` should union the body's first set with
    /// the outer follow rather than using outer alone. Mirrors the
    /// surface `if let Group(g) = inner && g.alternatives.len() == 1`
    /// check the iter-follow computation used to perform at emit time.
    pub body_is_single_alt_group: bool,
    /// True iff the inner element contributes a CST field — i.e.
    /// emit's Repeat surfaces a storable `Option<T>` (`Optional`) or
    /// `List<T>` (`Star` / `Plus`) field. False for `Transparent`
    /// groups and other non-storable shapes. Equal to
    /// `body_shape != TransparentGroup`; kept as a denormalised flag
    /// to avoid threading the enum through every call site that just
    /// asks "does this body produce storage?".
    pub body_has_field: bool,
    /// Lowered emit-shape classifier for the body op. Drives emit's
    /// dispatch in `gen_op_repeat_*` so the `op_is_leaf` /
    /// `op_is_rulecall` / `is Group(_)` × `body_has_field` predicates
    /// don't have to be re-checked at every dispatch site, and so the
    /// fall-through panics ("op-driven dispatch did not cover this
    /// body shape") become unreachable: every reachable body op has a
    /// named variant here, and lower asserts at construction time
    /// that no other shape leaks through.
    pub body_shape: RepeatBodyShape,
    /// Caller-side second-token set for non-greedy 2-token
    /// disambiguation. For a non-greedy Repeat at position `i` of a
    /// surface alt, this is the first set of the next element's
    /// second sub-position when the next element is itself a Repeat
    /// over a single-alt Group of ≥ 2 elements. Empty when 1-token
    /// follow suffices. Consumed by `gen_repeat_non_greedy`.
    pub caller_follow_second: List<String>,
    /// Inner second-position first set for non-greedy 2-token
    /// disambiguation. When the inner element is a single-alt `Group`
    /// of ≥ 2 elements (the `(',' x)*?` body shape), this is
    /// `first_of_elements_from(&inner.alternatives[0].elements, 1)`.
    /// Empty otherwise. Consumed by `gen_repeat_non_greedy`'s
    /// `peek_at(1)` disambiguation arm so emit doesn't re-walk the
    /// surface inner.
    pub body_second_position_first: List<String>,
    /// Emit a runtime caller-FOLLOW yield gate
    /// (`if follow_yields(&p.tokens, p.pos, follow, TK_EOF) { break }`)
    /// at this iteration's entry. Set by lower when the Repeat sits at a
    /// deep-nullable-suffix tail position — i.e. exactly where the
    /// caller's continuation can collide with another iteration. The
    /// gate is inert when the runtime `follow` is empty (non-repair
    /// callers), so it is sound to emit unconditionally at such
    /// positions; it subsumes BOTH the old 1-token follow subtraction
    /// and the K-prefix `__follow_<id>` variant gate. The actual mask is
    /// no longer baked here — it arrives at runtime via the `follow`
    /// argument the caller threads in.
    pub gate_caller_follow: bool,
}

pub struct GroupOp {
    pub shape: GroupShape,
    /// Alts inside the group, lowered in their own AltBody form.
    /// For `Transparent` shape there is exactly one alt and its body
    /// inlines into the surrounding sequence at emit.
    pub alts: List<AltBody>,
    /// Scan-side mirror.
    pub scan_alts: List<ScanBody>,
    /// Parse-time dispatch when the group has multiple alts. For
    /// single-alt groups this is `MultiAltDispatch::Direct` with one
    /// branch.
    pub dispatch: MultiAltDispatch,
    pub scan_dispatch: MultiAltDispatch,
}

/// Lower-side classification of a Repeat's body op shape. Drives
/// emit's `gen_op_repeat_*` dispatch — every reachable shape lower
/// produces has a named variant, so emit's per-Repeat dispatcher is
/// an exhaustive `match rep_op.body_shape { ... }` rather than a
/// cascade of `op_is_leaf` / `op_is_rulecall` / `let Group(_) = ...`
/// probes guarded by an "unhandled body shape" panic. Lower asserts
/// at construction time that the body op falls into one of the four
/// variants; ListLabel / Repeat shapes never reach `lower_repeat_op`.
pub variant RepeatBodyShape {
    /// `Op::RuleCall` body. Optional dispatch routes here for the
    /// caller-follow subtraction (`gen_op_repeat_optional_rulecall`),
    /// avoiding the next-sibling token greedy-eat issue.
    LeafRuleCall,
    /// `Op::Token` / `Op::Literal` / `Op::Wildcard` / `Op::Excluded`
    /// — leaf ops that do not need the RuleCall caller-follow
    /// subtraction. Optional dispatch routes here to
    /// `gen_op_repeat_optional_leaf`.
    LeafOther,
    /// `Op::Group` with shape `SingleAlt` / `TokenOnly` / `SimpleCst`
    /// / `General`. The group itself contributes a CST field; emit
    /// pushes the inner binding into the surrounding `Option<T>` /
    /// `List<T>` slot.
    StorableGroup,
    /// `Op::Group` with shape `Transparent`. The group has no own
    /// field; the inner alt's elements inline into the surrounding
    /// sequence (or the loop walks without a list, for Star / Plus /
    /// non-greedy).
    TransparentGroup,
}

/// How an `e?` / `e*` / `e+` repeat is emitted at parse time. The
/// strategy is decided once by `lower`, so emit doesn't reproduce the
/// "is the inner storable? does it have a follow? is it non-greedy?"
/// fan-out that legacy `gen_repeat_body` performs.
pub variant RepeatStrategy {
    /// Plain greedy loop. `while peek in first { ... }` for `*` /
    /// `+`; bare `if peek in first { ... }` for `?`. The tail-position
    /// caller-FOLLOW repair is threaded at runtime (`follow_yields`),
    /// so the loop guard itself stays the plain first-set check.
    Plain,
    /// Non-greedy `*?` / `+?` / `??`. Exit conditions are computed
    /// from the surrounding alt's follow at lower time.
    NonGreedy(NonGreedyStrategy),
    /// `?` whose inner has a fixed-token leading prefix of length ≥ 1.
    /// emit emits `if peek_at(0) ∈ sig[0] && peek_at(1) ∈ sig[1] && ...`.
    /// Storable callers wrap the inner parse in `Option::Some(...)`;
    /// transparent callers inline the inner alt.
    OptionalLookahead(OptionalLookaheadStrategy),
    /// `?` whose inner alt has nested Optionals — emit enumerates
    /// 2^n shapes (longest-first), each guarded by its per-position
    /// kind set. Lower bakes per-shape `positions` so emit knows
    /// which inner elements to dispatch vs. mark absent.
    OptionalShapeLookahead(OptionalShapeLookaheadStrategy),
    /// `?` whose inner can't be decided by lookahead but IS fully
    /// scannable — emit uses a save-scan-rewind guard.
    OptionalScanGuard,
}

pub struct NonGreedyStrategy {
    /// Tokens that may follow the loop. Drives the exit condition
    /// `peek_kind() ∉ exit_first ∨ further-lookahead`.
    pub exit_first: List<String>,
    /// Second-token disambiguation when `exit_first` overlaps with
    /// the inner's first. Empty when not needed.
    pub exit_second: List<String>,
}

pub struct OptionalLookaheadStrategy {
    /// Per-position kind sets that the inner's fixed-token prefix
    /// guarantees. `sig.len()` is the lookahead depth; `sig[i]` is
    /// the allowed kind set at `peek_at(i)`.
    pub sig: List<List<String>>,
}

pub struct OptionalShapeLookaheadStrategy {
    /// One entry per shape, longest-first (so the first matching
    /// shape is the longest match).
    pub shapes: List<OptionalLookaheadShape>,
}

pub struct OptionalLookaheadShape {
    /// Indices (within the inner alt's element list) of the elements
    /// present in this shape. Emit walks the inner element list; for
    /// each index in `positions` it dispatches the corresponding op,
    /// and for absent positions it emits the absent-Optional field
    /// declaration.
    pub positions: List<i32>,
    /// Per-virtual-position kind sets — feeds the lookahead guard.
    /// `sig[d]` is the kind set required at `peek_at(d)` for this
    /// shape.
    pub sig: List<List<String>>,
}

/// How a `(...)` group is realised in the CST and at parse time.
pub variant GroupShape {
    /// Multi-alt group whose every alt is a single `RuleRef` to a
    /// distinct rule (`(stmt | expr | decl)`). Emitted as a CST
    /// variant (`StmtOrExprOrDecl`).
    SimpleCst(SimpleCstShape),
    /// Multi-alt group whose every alt is a single `TokenRef` /
    /// `Literal`. Emitted as a single `Token` field.
    TokenOnly(TokenOnlyShape),
    /// Single-alt group whose body deserves its own struct
    /// (`(name=ID '=' expr)`). The struct is shared across rules
    /// when its shape is identical.
    SingleAlt(SingleAltShape),
    /// General multi-alt group not covered by `SimpleCst` /
    /// `TokenOnly` (`(stmt | 'go' expr)`). Emitted as a per-rule
    /// variant (`<RuleName>Group<idx>`).
    General(GeneralShape),
    /// Group whose alts are inlined directly into the surrounding
    /// alt body without a struct of their own. `(a b)` flattens to
    /// `a b`. The group still gates dispatch when the alts have
    /// distinct first-sets.
    Transparent,
}

pub struct SimpleCstShape {
    /// `<Variant>` type name shared across rules with identical
    /// alt-shape.
    pub type_name: String,
    pub field: String,
}

pub struct TokenOnlyShape {
    pub field: String,
}

pub struct SingleAltShape {
    pub struct_name: String,
    pub field: String,
    /// Rule that owns the struct's general-group sub-type names
    /// when the single-alt body contains nested general groups.
    /// Drives `general_group_type_name` resolution; mirrors the
    /// legacy `single_alt_owner` map.
    pub owner_rule: String,
}

pub struct GeneralShape {
    /// `<RuleName>Group<idx>` variant type name.
    pub variant_type: String,
    /// Per-alt struct names (`<RuleName>Group<idx>Alt<j>`).
    pub alt_struct_names: List<String>,
    pub field: String,
    /// Group counter id, stable across runs and matching the
    /// `gen_cst_types` enumeration order.
    pub group_index: i32,
}

// ==========================================================================
// Scan-side IR
// ==========================================================================

/// Scan-side body — the `scan_<rule>` predicate's lowered form. Scan
/// emission is structurally simpler than parse: no field bindings,
/// no struct construction, just a token-stream walk that returns a
/// new `pos` (or `-1` for failure). The IR is symmetric to the
/// parse side but drops the storage decisions.
pub struct ScanBody {
    pub elements: List<ScanElement>,
}

pub variant ScanElement {
    Token(ScanTokenElem),
    /// `RuleCall` mirror — resolved variant id and min-prec arg are
    /// already baked in.
    RuleCall(ScanRuleCallElem),
    Wildcard,
    Excluded(ScanExcludedElem),
    Repeat(ScanRepeatElem),
    Group(ScanGroupElem),
    /// `?`-over-group lowered with the same shape signature as the
    /// parse-side `OptionalLookaheadStrategy`. Exists in scan IR
    /// because scan-side has its own `gen_scan_optional_with_lookahead`.
    OptionalLookahead(ScanOptionalLookaheadElem),
}

pub struct ScanTokenElem {
    pub kind: String,
}

pub struct ScanRuleCallElem {
    pub target_snake: String,
    /// Scan-side mirror of `RuleCallOp.follow_arg`. See `FollowArg`.
    pub follow_arg: FollowArg,
    /// Scan-side mirror of `RuleCallOp.min_prec_arg`. `Some(p)` when
    /// the call should pass `p` as the `min_prec` argument — set by
    /// `stamp_lr_self_ref_min_prec` for self-recursive RuleCalls
    /// inside an LR suffix. `None` means "use the caller-supplied
    /// override" — `gen_scan_op_element` reads its `min_prec_override`
    /// parameter, which `gen_bt_scan_op_elements` raises to `i32::MAX`
    /// for the trailing self-ref and every other call site leaves at
    /// the default `0`.
    pub min_prec_arg: Option<i32>,
}

pub struct ScanExcludedElem {
    pub kinds: List<String>,
}

pub struct ScanRepeatElem {
    pub kind: RepeatKind,
    pub body: ScanElement,
    pub strategy: ScanRepeatStrategy,
    /// First set of `body` cached at lower time. emit's scan-side
    /// repeat emitter uses this for `while peek_kind ∈ inner_first`
    /// loop guards (Plain strategy) and for Plus's mandatory-first
    /// iteration condition.
    pub inner_first: List<String>,
    /// Scan-side mirror of `RepeatOp.caller_follow_first`. Default is
    /// the variant-aware `outer_follow` at construction time; alt-level
    /// scan walkers override it with `first_of_elements_from(elements,
    /// i + 1)` to match the parse-side post-pass. Consumed by op-driven
    /// emit's Optional+RuleRef-inner case to suppress the inner fire
    /// when the outer next-token is a caller-side follow token (the
    /// pre-Phase-2-F `gen_scan_repeat_optional_with_follow` contract).
    /// Empty when the Repeat is at the alt's tail.
    pub caller_follow_first: List<String>,
    /// Scan-side mirror of `RepeatOp.gate_caller_follow`: emit
    /// `if follow_yields(tokens, pos, follow, TK_EOF) { ... }` at iter
    /// entry so the longest-match tournament yields to the caller in
    /// lockstep with the parse side.
    pub gate_caller_follow: bool,
}

pub variant ScanRepeatStrategy {
    Plain,
}

pub struct ScanGroupElem {
    /// Multi-alt scan dispatch.
    pub alts: List<ScanBody>,
    pub dispatch: MultiAltDispatch,
    /// True for "lenient" groups whose dispatch may bail out
    /// without advancing on no match (used for `?`-over-group).
    pub lenient: bool,
    /// Per-alt first set (parallel to `alts`). Drives emit's
    /// ambiguity detection (`sets_overlap` between any two alts)
    /// and the lenient gate. Cached at lower time so emit's
    /// `gen_scan_op_group` doesn't re-call `ctx.first_of_alt`.
    pub alt_first_sets: List<List<String>>,
    /// Indices into `alts` of every wildcard-led alt (its first
    /// non-nullable element is `.`). A wildcard alt matches any
    /// non-EOF token, so the lenient first-set gate must be
    /// suppressed (otherwise scan-side dispatch would never try
    /// the wildcard alt on a lookahead that lies outside the
    /// explicit first set union — the `(assign | .)` pattern from
    /// the ANTLR4 `ParserExec/Wildcard` descriptor) AND the scan
    /// iteration order must visit wildcard alts last so a more
    /// specific concrete alt still wins when its full body
    /// matches.
    pub wildcard_alt_indices: List<i32>,
}

pub struct ScanOptionalLookaheadElem {
    /// Per-shape lookahead signature: `sigs[s][position]` is the
    /// kind set for position `position` of shape `s`. emit emits
    /// `if peek_match(sigs[0]) { /* shape 0 body */ } else if ...`.
    pub sigs: List<List<List<String>>>,
    /// Per-shape scan body: `bodies[s]` is the sequence of
    /// `ScanElement`s emit scans when shape `s`'s sig matches. Each
    /// shape selects a subset of the surface alt's elements (the
    /// optional sub-elements that are "on" in this shape).
    pub bodies: List<ScanBody>,
}

// ==========================================================================
// Fields and kind sets
// ==========================================================================

/// CST struct field decl for a lowered alt. emit lays these out as
/// `pub <name>: <type_str>` lines and the matching constructor
/// assignments.
pub struct FieldDecl {
    /// Final field name including dedup suffix (`x`, `x_2`, ...).
    pub name: String,
    /// Type string as it should appear in the emitted struct
    /// (`Token`, `Option<ExprNode>`, `List<StmtNode>`, etc.).
    pub type_str: String,
    /// Field role. `Plain` for required fields, `Optional` for
    /// `e?` / unstorable groups, `List` for `e*` / `e+` and `+=`
    /// labels, `Span` reserved for the leading `span: Span` field
    /// every alt struct carries.
    pub kind: FieldKind,
}

pub variant FieldKind {
    Plain,
    Optional,
    List,
    Span,
}

/// One interned token-kind set. emit drops a `_gale_kind_set_<id>(k)
/// -> bool` helper for each entry; multi-element `matches { ... }`
/// checks elsewhere route through the helper to share the body.
pub struct KindSet {
    pub id: i32,
    /// Canonical (sorted, unique) token kinds.
    pub tokens: List<String>,
}

// ==========================================================================
// Header-extraction helper
// ==========================================================================

/// Borrow the rule header regardless of variant, so traversals don't
/// repeat the match.
pub fn rule_header(rule: &Rule) -> &RuleHeader with stores[rule] {
    return match rule {
        Simple(s) => &s.header,
        MultiAlt(m) => &m.header,
        LeftRecursive(l) => &l.header,
    };
}

/// Look up the `AltBody` for a given surface-IR alt index inside the
/// lowered rule. For `Simple` rules `alt_idx` is always `0`; for
/// `MultiAlt` the lookup scans `alts` for the entry whose
/// `alt_index == alt_idx`; for `LeftRecursive` it searches the atom's
/// alts first and falls back to the LR-alt suffixes. Returns `null`
/// when the index is not present (e.g. looking for an LR alt's body
/// via this helper, where the caller should reach for
/// `LrAlt.suffix` directly).
pub fn rule_alt_body(rule: &Rule, alt_idx: i32) -> Option<&AltBody> with stores[rule] {
    return match rule {
        Simple(s) => if alt_idx == 0 { Option::<&AltBody>::Some(&s.body) } else { null },
        MultiAlt(m) => find_alt_body_in_array(&m.alts, alt_idx),
        LeftRecursive(l) => {
            if let Some(b) = find_alt_body_in_array(&l.atom.alts, alt_idx) {
                Option::<&AltBody>::Some(b);
            } else {
                let mut found: Option<&AltBody> = null;
                for let lr of &l.lr_alts {
                    if lr.alt_index == alt_idx {
                        found = Option::<&AltBody>::Some(&lr.suffix);
                        break;
                    }
                }
                found;
            }
        },
    };
}

fn find_alt_body_in_array(alts: &List<AltBody>, alt_idx: i32) -> Option<&AltBody> with stores[alts] {
    for let a of alts {
        if a.alt_index == alt_idx {
            return Option::<&AltBody>::Some(a);
        }
    }
    return null;
}

/// Scan-side counterpart of `rule_alt_body`. Returns the
/// `ScanBody` for the alt at the given index — `s.scan_body` for
/// `Simple` (alt_idx 0), or the parallel `scan_alts` entry for
/// `MultiAlt` / LR atom shapes, or `lr.scan_suffix` for LR alts.
pub fn rule_alt_scan_body(rule: &Rule, alt_idx: i32) -> Option<&ScanBody> with stores[rule] {
    return match rule {
        Simple(s) => if alt_idx == 0 { Option::<&ScanBody>::Some(&s.scan_body) } else { null },
        MultiAlt(m) => find_scan_body_in_array(&m.alts, &m.scan_alts, alt_idx),
        LeftRecursive(l) => {
            if let Some(b) = find_scan_body_in_array(&l.atom.alts, &l.atom.scan_alts, alt_idx) {
                Option::<&ScanBody>::Some(b);
            } else {
                let mut found: Option<&ScanBody> = null;
                for let lr of &l.lr_alts {
                    if lr.alt_index == alt_idx {
                        found = Option::<&ScanBody>::Some(&lr.scan_suffix);
                        break;
                    }
                }
                found;
            }
        },
    };
}

fn find_scan_body_in_array(alts: &List<AltBody>, scan_alts: &List<ScanBody>, alt_idx: i32) -> Option<&ScanBody> with stores[scan_alts] {
    for let mut i = 0; i < alts.len(); i += 1 {
        if alts[i].alt_index == alt_idx {
            return Option::<&ScanBody>::Some(&scan_alts[i]);
        }
    }
    return null;
}
