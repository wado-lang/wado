//! Char-range copies, shared by every scanner that carries a `List<char>`.

/// `chars[start..end]` as its own `String`.
pub fn collect_range(chars: &List<char>, start: i32, end: i32) -> String {
    let mut s = String::with_capacity(if end > start { end - start } else { 0 });
    push_range(&mut s, chars, start, end);
    return s;
}

/// Append `chars[start..end]` to `out`.
pub fn push_range(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    for let mut i = start; i < end; i += 1 {
        out.push(chars[i]);
    }
}
