pub struct GenerateOptions {
    /// Parsed highlight query. `Some` emits the highlighter (defaults +
    /// overrides tables compiled from the query); `None` (the default)
    /// keeps generated output byte-identical to a highlight-free build.
    /// Presence of a `.scm` query input is what turns highlighting on.
    pub highlight_query: Option<List<HighlightRule>> = null,
    /// Emit trace logging through `core:log` at `Trace` in the generated parser:
    /// rule enter/ok/fail frames plus the multi-alt scan/pick/try decisions.
    ///
    /// Off by default; `gale gen --trace` or the `trace: true` Kiln option turns
    /// it on. Such a build also exports `trace_to_stderr`, since `Trace` is below
    /// what `core:log` admits with no sink installed.
    pub trace: bool = false,
    /// Rule names a fragment is a sequence of, for tooling; empty is
    /// byte-identical.
    pub fragment_entries: List<String> = [],
}

/// Result of a codegen pass: the generated `.wado` source plus every
/// diagnostic the pass collected — both the prediction-strategy warnings
/// lowering raised and the emit-time safety-net warnings
/// (`warn_unhandled_actions`), which run after lowering. Read from the emit
/// context at the end so nothing added after the `LoweredGrammar` snapshot is
/// lost. Callers that want to surface warnings (`gale gen`) read
/// `diagnostics`; callers that only need the module text (the Kiln generator
/// entry, unit tests) read `source`.
pub struct GeneratedOutput {
    pub source: String,
    pub diagnostics: List<Diagnostic>,
}

/// Output-buffer pre-sizing heuristic (see `generate`): a base allocation
/// plus a per-rule estimate, tuned so a large grammar's generated source
/// fits within one `String::grow` doubling.
global GEN_BASE_CAPACITY: i32 = 4096;
global GEN_PER_RULE_CAPACITY: i32 = 4096;

/// The surface normalizations and id stamping every consumer of the analysis
/// runs before it builds a `GrammarAnalysis`. `generate`, `gale dump` and the ATN
/// builder all lower the same grammar, so a pass only one of them runs makes
/// the others describe a parser nobody emits.
pub fn canonicalize_for_analysis(grammar: &mut Grammar) -> TokenKinds {
    // Before `collect_literal_tokens`, which must not see an aliased text.
    alias_parser_literals(grammar);
    // Fill in `snake_name` / `field_name` caches on every name-bearing IR
    // node before any codegen pass touches the grammar. Production IR built
    // through `RuleRefElement::with_options` etc. already has these set —
    // `normalize_caches` is a one-time `is_empty()` sweep and a fallback
    // for IR constructed with struct-literal syntax (e.g. unit tests).
    // Fold `( | X)` / `(X | )` empty-alt groups onto the Optional path
    // before any structural pass (lowering, ATN build) sees them, so both
    // the emitter and `build_atn` agree on the canonical repeat shape.
    canonicalize_empty_alt_groups(grammar);
    splice_suffixed_alternations(grammar);
    // Canonicalization is done; everything downstream may assume its shape.
    assert_canonical_shape(grammar);
    // Number every surface `RuleRef` call site so `build_atn`'s
    // `call_site_returns` correspondence (read by codegen to push exact ATN
    // return states) is keyed consistently. Runs after canonicalization (the
    // numbered shape is the post-canonicalization one) and before lowering.
    assign_atn_call_sites(grammar);
    assign_atn_leaf_sites(grammar);
    // Must run after `assign_atn_call_sites` (its `Repeat` / `Group` rebuild
    // would otherwise reset the freshly stamped decision-site ids).
    assign_atn_decisions(grammar);
    assign_action_ids(grammar);
    translate_attr_types(grammar);
    normalize_caches(grammar);
    // Stamp each terminal element with its canonical token kind id
    // (`token_slot_order` position, == the emitted `TK_*` value) so FIRST-set
    // analysis can carry the integer instead of the `TK_*` name. Inert until
    // the analysis reads `kind_id`; names are recovered from the table at emit.
    let token_kinds = TokenKinds::build(grammar);
    resolve_kind_ids(grammar, &token_kinds);
    return token_kinds;
}

/// What wiring a grammar's actions settles: the settings every later phase
/// reads, and the lexer and parser members. The members come back rather than
/// being consumed here because staging and emit both need them, and `dump`
/// needs neither.
pub struct ActionContext {
    pub settings: GenSettings,
    pub lexer_members: MemberDecls,
    pub parser_members: MemberDecls,
}

/// Wire the action context lowering reads onto `options`.
///
/// `dump` runs this too, and has to. `alt_earns_group_follow` asks
/// `emit_actions`, so settings without it lower a different `AltClass` — and
/// the dump would then report a prediction shape no parser is built from, which
/// is the drift the prologue above exists to remove.
pub fn install_action_context(grammar: &mut Grammar, options: GenSettings, diagnostics: &mut Diagnostics) -> ActionContext {
    let mut settings = options;
    settings.action_language = grammar.action_language;
    settings.grammar_name = grammar.name;
    wire_superclasses(grammar, &mut settings, diagnostics);
    // A wired parser base's bodies are Wado once the rewrite has run, so they
    // execute even under a host language java2wado carves out.
    settings.emit_actions = should_emit_actions(grammar) || settings.has_parser_superclass();
    // Ahead of staging: a body resolves its bare names and `this.` calls against
    // these, so what it can resolve is exactly what reaches the struct — a block
    // the translation refuses declares nothing, and the refusal is the
    // diagnostic rather than an unknown field in the output.
    let lexer_members = collect_members(grammar, &settings, diagnostics, /*lexer=*/ true);
    let parser_members = collect_members(grammar, &settings, diagnostics, /*lexer=*/ false);
    settings.action_members = member_names(&parser_members);
    // After the members, never before: which fields a scan can simulate is the
    // action bodies' answer narrowed by what the block actually declares, and
    // only one of those is known here. The bodies are the translator's, so both
    // action languages name a member the one way the generated struct does.
    let gate_bodies = translate_gate_bodies(grammar, &settings);
    let declared = &settings.action_members.fields;
    settings.scan_gate_fields = scan_gate_fields(grammar, &gate_bodies)
        .iter_ref()
        .filter(|f| declared.contains(f))
        .map(|f| *f)
        .collect();
    settings.gate_bodies = gate_bodies;
    return ActionContext { settings, lexer_members, parser_members };
}

/// The analysis of a `canonicalize_for_analysis`-ed grammar whose actions are
/// wired, so it reads the bodies a `superClass` rewrite left.
pub fn analysis_of(grammar: &Grammar, lit_tokens: &List<LitToken>, token_kinds: TokenKinds) -> GrammarAnalysis {
    let vocab = vocab_display_names(&grammar.lexer_rules, lit_tokens, &token_kinds.names);
    return GrammarAnalysis::new(&grammar.parser_rules, token_kinds, vocab);
}

/// The context lowering runs in, primed with what lowering itself asks for.
///
/// Scannability is a fixpoint over the whole rule set: answered per query it
/// re-walks every cycle the query reaches, which on a grammar the size of
/// `RustParser.g4` is the whole cost of lowering. FOLLOW goes in before
/// lowering rather than during it: a tail-position viability probe stamps the
/// enclosing rule's FOLLOW onto its op, so the fixed point has to be complete
/// by then. It reads only the surface rules.
pub fn lower_context(
    grammar: &Grammar,
    lit_tokens: &List<LitToken>,
    token_kinds: TokenKinds,
    settings: GenSettings,
    diagnostics: Diagnostics,
) -> LowerContext {
    let mut analysis = analysis_of(grammar, lit_tokens, token_kinds);
    analysis.precompute_scannability();
    let follow = settle_rule_follow(&grammar.parser_rules, &mut analysis);
    return LowerContext::new(analysis, settings, follow, diagnostics);
}

/// `generate`'s prologue up to lowering, for a consumer that reports on the
/// lowering rather than emitting from it (`gale dump`): the lowered grammar and
/// the context it was lowered in.
pub fn lower_for_analysis(grammar: &mut Grammar, token_kinds: TokenKinds) -> [LoweredGrammar, LowerContext] {
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    let mut diagnostics = Diagnostics {};
    let settings = install_action_context(grammar, GenSettings {}, &mut diagnostics).settings;
    let mut ctx = lower_context(grammar, &lit_tokens, token_kinds, settings, diagnostics);
    let lowered = lower(grammar, &lit_tokens, &mut ctx);
    return [lowered, ctx];
}

/// The context the parser emits in: what lowering settled, planned against the
/// lowered grammar and its ATN.
fn emit_context(grammar: &Grammar, lowered: &LoweredGrammar, lctx: LowerContext, atn: &Atn) -> EmitContext {
    let LowerContext { analysis, settings, follow, tables, diagnostics, marks, .. } = lctx;
    let mut analysis = analysis;
    let plan = plan_parser(grammar, lowered, &mut analysis, &settings, &marks, atn);
    return EmitContext::new(analysis, settings, follow, tables, diagnostics, plan);
}

pub fn generate(grammar: &mut Grammar, options: &GenerateOptions) -> GeneratedOutput {
    let token_kinds = canonicalize_for_analysis(grammar);
    // Pre-size the output buffer from the grammar's rule count so the
    // bulk of `String::push_str` calls in `CodeWriter::line` don't
    // trigger `String::grow` doubling events. Empirical Rust*.g4 output
    // is ~1.3 MB across 197 parser + 130 lexer rules; the 4 KB +
    // 4 KB/rule heuristic matches that within one doubling.
    let estimated_size = GEN_BASE_CAPACITY + GEN_PER_RULE_CAPACITY * (grammar.parser_rules.len() + grammar.lexer_rules.len(
    ));
    let mut w = CodeWriter::with_capacity(estimated_size);
    // Lower up-front so CST emission can consume `AltBody.fields` /
    // `GroupShape` directly. The analysis caches and the tables lowering
    // interned pass on to the parser emit.
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    let mut diagnostics = Diagnostics {};
    let ActionContext { settings, lexer_members, parser_members } = install_action_context(
        grammar,
        GenSettings { trace: options.trace, fragment_entries: options.fragment_entries },
        &mut diagnostics,
    );
    // Read off the `.g4` bodies, which staging is about to translate away.
    let mode_use = lexer_mode_attr_use(grammar);
    // Stage the lexer bodies into Wado on exactly the grammars whose lexer
    // bodies `gen_lexer` emits (its `ea`), so the emitters splice ready text:
    // they hold no `Diagnostics`, so a failure reaching one could only panic.
    if lexer_grammar_executes_actions(grammar) || settings.has_superclass() {
        // The call rewrite already turned a body under a wired base into Wado,
        // so it stages through the identity translator whatever the grammar
        // declares — the carve-out `action_language_is_emittable` names.
        let lang = if action_language_is_emittable(grammar) { grammar.action_language } else { ActionLanguage::Wado };
        let msgs = stage_lexer_bodies(grammar, &lang, &member_names(&lexer_members));
        for let msg of &msgs {
            diagnostics.warn(&DiagnosticOwner::host("lexer action"), DiagnosticKind::UnsupportedAction, *msg);
        }
    }
    let mut lctx = lower_context(grammar, &lit_tokens, token_kinds, settings, diagnostics);
    let lowered = lower(grammar, &lit_tokens, &mut lctx);
    // Every grammar reads its recovery sets off the ATN; only the simulator's
    // grammars also embed it.
    let atn = build_atn_with(grammar, &lowered);
    let mut ctx = emit_context(grammar, &lowered, lctx, &atn);
    // Lexer ATN: built when a lexer rule's non-greedy body recurses into
    // itself (the nested-comment class static lexing cannot decide). The
    // `atn_class_map` carries each such rule's `name -> latn rule index`
    // so the lexer emit routes its `try_*` body to `latn_match`.
    let needs_latn = grammar_needs_latn(grammar);
    let mut latn = LatnResult {
        atn: empty_atn(),
        rule_index: HashMap::<String, i32>::with_seed(GALE_SEED),
        atn_class_rules: [],
    };
    let mut atn_class_map = HashMap::<String, i32>::with_seed(GALE_SEED);
    if needs_latn {
        latn = build_latn(grammar);
        for let name of &latn.atn_class_rules {
            if let Some(idx) = latn.rule_index.get(*name) {
                atn_class_map[*name] = idx;
            }
        }
    }
    let emit_follow = ctx.plan.emit_follow;
    let emit_highlight = options.highlight_query matches { Some(_) };
    gen_token_constants(&mut w, &grammar.lexer_rules, &lit_tokens);
    let has_members = members_present(&lexer_members);
    gen_lexer(
        &mut w,
        grammar,
        &lit_tokens,
        &atn_class_map,
        &lexer_members,
        has_members,
        &ctx.settings.superclass_name,
        &ctx.settings.superclass_ops,
        &mode_use,
    );
    gen_node_kinds(&mut w, &lowered.parser_rules);
    gen_alt_enums(&mut w, grammar);
    gen_parser(&mut w, grammar, &lowered, &parser_members, &mut ctx);
    warn_unhandled_lexer_actions(grammar, &ctx.settings, &mut ctx.diagnostics);
    warn_atn_class_lexer_predicates(grammar, &latn.atn_class_rules, &mut ctx.diagnostics);
    gen_string_tree_helper(&mut w, grammar, &lit_tokens);
    if let Some(query) = &options.highlight_query {
        gen_highlight(&mut w, grammar, &lit_tokens, query, &ctx.settings, &mut ctx.diagnostics);
    }
    for let name of ctx.cursor.take_root_refs().iter_value() {
        w.note(&name);
    }
    w.prune();
    // The tables go in after pruning, so only what kept code names is built.
    let used = w.references();
    gen_kind_set_helpers(&mut w, &ctx, &used);
    gen_sync_set_globals(&mut w, &ctx, &used);
    if emit_follow {
        gen_follow_mask_globals(&mut w, &ctx, &used);
    }
    if ctx.plan.needs_atn {
        gen_atn_data_global(&mut w, &atn, ctx.plan.needs_lr_atn);
    }
    // Serialized lexer ATN blob, decoded once into `LATN_SIM`, for the
    // runtime lexer simulator (`latn_match`).
    if needs_latn {
        gen_latn_data_global(&mut w, &latn.atn);
    }
    if ctx.settings.emit_scan_gate() {
        gen_scan_gate_type(&mut w, &ctx.settings.scan_gate_fields, &parser_members);
    }
    let body = w.to_string();
    let rt = gen_runtime(
        &RuntimeFeatures {
            emit_follow,
            atn_decode: ctx.plan.needs_atn || needs_latn,
            atn_predict: ctx.plan.needs_atn,
            atn_lr: ctx.plan.needs_lr_atn,
            latn: needs_latn,
            highlight: emit_highlight,
            superclass: ctx.settings.has_superclass(),
            scan_memo: ctx.plan.scan_memo,
        },
    );
    let mut head = CodeWriter::new();
    gen_header(&mut head, grammar);
    if options.trace {
        head.line("use { Level, Log, TextSink, enabled, log_level, set_log_level, trace } from \"core:log\";");
        head.blank();
    }
    for let std_use of &rt.imports {
        head.raw(std_use);
    }
    if !rt.imports.is_empty() {
        head.blank();
    }
    gen_grammar_metadata(&mut head, grammar);
    let head_text = head.to_string();
    let rt_text = rt.code.to_string();
    let mut source = String::with_capacity(head_text.len() + rt_text.len() + body.len());
    source.push_str(&head_text);
    source.push_str(&rt_text);
    source.push_str(&body);
    // Read the full diagnostic set from `ctx`, not `lowered.diagnostics`:
    // the latter is a lowering-time snapshot, and the emit walk's
    // `warn_unhandled_actions` safety net pushes to `ctx` afterwards.
    return GeneratedOutput { source, diagnostics: ctx.diagnostics.to_list() };
}

/// Wire each declared `superClass` base to its effect interface, or refuse it
/// with a diagnostic naming what Gale cannot represent.
fn wire_superclasses(grammar: &mut Grammar, settings: &mut GenSettings, diagnostics: &mut Diagnostics) {
    let mut lexer_refused = false;
    if let Some(sc) = lexer_superclass_name(grammar) {
        let ops = collect_lexer_super_ops(grammar);
        let refusal = lexer_super_refusal(&ops);
        if refusal.is_empty() {
            // Wired even with no ops: a base may override only a hook.
            settings.superclass_name = sc;
            settings.superclass_ops = ops;
            // Must follow op collection, which scans the original `this.` sites.
            rewrite_lexer_superclass_calls(grammar, &sc);
        } else {
            warn_superclass_refused(diagnostics, &sc, &refusal);
            lexer_refused = true;
        }
    }
    // A refusal already reported the cause; anything `this` left over has not.
    if !lexer_refused && lexer_bodies_name_unwired_base(grammar) {
        diagnostics.warn(
            &DiagnosticOwner::host("superClass"),
            DiagnosticKind::UnsupportedAction,
            "a lexer action or predicate names 'this' with nothing to receive it; only a `this.m()` call under a lexer superClass lowers to a base operation, and a combined grammar's superClass is the parser's",
        );
    }
    wire_parser_superclass(grammar, settings, diagnostics);
}

fn wire_parser_superclass(grammar: &mut Grammar, settings: &mut GenSettings, diagnostics: &mut Diagnostics) {
    if let Some(sc) = parser_superclass_name(grammar) {
        settings.parser_superclass_declared = true;
        let ops = collect_parser_super_ops(grammar);
        // The parser interface declares no lifecycle hook, so a base nothing
        // calls has no operation to wire.
        if ops.is_empty() {
            return;
        }
        let refusal = parser_super_refusal(&ops);
        if !refusal.is_empty() {
            warn_superclass_refused(diagnostics, &sc, &refusal);
        } else if !parser_bodies_execute(grammar, &sc) {
            // Wiring would demand a handler for operations no emitted body
            // calls, so refuse and say which translator is missing.
            warn_superclass_refused(
                diagnostics,
                &sc,
                "is called from a body carrying host code the grammar's action language has no translator for",
            );
        } else {
            settings.parser_superclass_name = sc;
            settings.parser_superclass_ops = ops;
            rewrite_parser_superclass_calls(grammar, &sc);
        }
    }
}

/// Whether codegen runs the grammar's parser action bodies: java2wado emits the
/// language, or every body is base calls, which the rewrite makes Wado.
///
/// A `superClass` does not take the language away here the way it does for the
/// lexer — the rewrite leaves `Base::m(p)` calls java2wado passes through, and a
/// body it cannot translate is reported and dropped on its own
/// (`UnsupportedAction`, warn-and-emit) rather than costing every other body the
/// base.
fn parser_bodies_execute<S: AsStrSlice>(grammar: &Grammar, base: S) -> bool {
    return parser_action_language_is_emittable(grammar) || parser_bodies_are_base_calls(grammar, base);
}

fn warn_superclass_refused<S: AsStrSlice, S1: AsStrSlice>(diagnostics: &mut Diagnostics, base: S, refusal: S1) {
    diagnostics.warn(
        &DiagnosticOwner::host("superClass"),
        DiagnosticKind::UnsupportedAction,
        `superClass '${base}' ${refusal}, so the base is not wired`,
    );
}

/// Loud safety net for lexer `{ ... }` actions codegen does not execute:
/// nested-in-group / mid-element actions, multi-alt-rule actions, actions in
/// a `mode` grammar, and fragment actions. Predicates never warn (they run at
/// every position). Without this a dropped lexer action vanished with no
/// diagnostic — silent, against the "loud, never silent" contract. Gated on
/// `emit_actions`, so a `language = Java` grammar warns nothing — except under
/// a `superClass`, whose base-call rewrite runs actions the host translator
/// never sees, leaving the rest to report.
fn warn_unhandled_lexer_actions(grammar: &Grammar, settings: &GenSettings, diagnostics: &mut Diagnostics) {
    if !settings.emit_actions && !settings.has_superclass() {
        return;
    }
    let run = lexer_grammar_run_action_ids(grammar);
    let grammar_executes = lexer_grammar_executes_actions(grammar);
    for let rule of &grammar.lexer_rules {
        let executes = lexer_rule_executes_actions(grammar_executes, rule);
        let reason = unhandled_lexer_action_reason(grammar_executes, rule);
        for let mut ai = 0; ai < rule.body.len(); ai += 1 {
            // Every alt's top-level actions run for an executing rule (the
            // winning alt is picked at replay); a nested action runs only where
            // the replay reaches it, so the rest warn.
            let mut ids: List<i32> = [];
            collect_unhandled_lexer_alt_action_ids(
                &rule.body[ai],
                executes,
                &grammar.lexer_rules,
                &mut ids,
            );
            for let id of &ids {
                if run.contains(id) {
                    continue;
                }
                diagnostics.warn(
                    &DiagnosticOwner { site: DiagnosticSite::LexerAction(*id) },
                    DiagnosticKind::UnsupportedAction,
                    `action ${*id} in lexer rule '${rule.name}' is not yet executed (${reason})`,
                );
            }
        }
    }
}

/// Why an unexecuted action in `rule` is unexecuted: a grammar whose lexer
/// actions do not run at all is a different failure from an action codegen
/// places nowhere.
fn unhandled_lexer_action_reason(grammar_executes: bool, rule: &LexerRule) -> String {
    if !grammar_executes {
        return "this grammar's lexer actions do not run at all: a superClass grammar runs one only when the base is wired and the body is nothing but base calls";
    }
    if rule.is_fragment || rule.is_virtual {
        return "its rule has no match of its own to replay; only a caller inlining it runs the action";
    }
    return "nested below an element the replay does not walk into (a `~`, or a recursive fragment the emit calls rather than inlines)";
}

/// Refuse a semantic predicate in an ATN-class lexer rule: the lexer ATN carries
/// no predicate transition, so the rule would match input its predicate rejects.
fn warn_atn_class_lexer_predicates(grammar: &Grammar, atn_class_rules: &List<String>, diagnostics: &mut Diagnostics) {
    // One predicate, one report: an ATN-class rule referencing another reaches
    // the same ids under a different rule name, which the diagnostic dedup misses.
    let mut reported: List<i32> = [];
    for let name of atn_class_rules {
        if let Some(rule) = find_lexer_rule(&grammar.lexer_rules, name) {
            let mut ids: List<i32> = [];
            collect_lexer_predicate_ids(rule, &grammar.lexer_rules, &mut ids);
            for let id of &ids {
                if reported.contains(id) {
                    continue;
                }
                reported.push(*id);
                diagnostics.warn(
                    &DiagnosticOwner { site: DiagnosticSite::LexerAction(*id) },
                    DiagnosticKind::UnsupportedAction,
                    `predicate ${*id} in lexer rule '${*name}' is not evaluated: the rule matches through the lexer ATN, which has no predicate transition`,
                );
            }
        }
    }
}

/// Emit the decoded `ATN_SIM` global: the serialized whole-grammar ATN the
/// inlined runtime decodes once, at construction, into the module-level sim.
fn gen_atn_data_global(w: &mut CodeWriter, atn: &Atn, lr_tables: bool) {
    emit_atn_blob_global(w, atn, "ATN_SIM", lr_tables);
    w.blank();
}

/// Emit the type of the scan's copy of the parser's gate members, which the
/// parser holds and every scan walks by reference. Its fields carry the
/// parser's own names, which is what lets one predicate text render for both
/// sides — see `scan_gate.wado`.
fn gen_scan_gate_type(w: &mut CodeWriter, fields: &List<String>, members: &MemberDecls) {
    w.begin(`struct ${SCAN_GATE_TYPE}`);
    for let f of fields {
        // The member's own declared type and initialiser, not `i32 = 0`. The
        // seed is `p.scan_gate.f = p.f;`, so a `long` member declared here as an
        // `i32` is a type error in the generated parser rather than anything
        // this side would notice.
        let [ty, init] = member_field(members, f);
        w.line(`${*f}: ${ty} = ${init},`);
    }
    w.end();
    w.blank();
}

/// A gate member's `[type, initialiser]`. `set_scan_gate_fields` keeps only what
/// the members block declares, so the miss below cannot be reached from here.
fn member_field<S: AsStrSlice>(members: &MemberDecls, name: S) -> [String, String] {
    for let mf of &members.fields {
        if mf.name == name.as_str_slice() {
            return [mf.ty, mf.init];
        }
    }
    panic(`gen_scan_gate_type: '${name}' is simulated but no member declares it`);
}

/// Emit the decoded `LATN_SIM` global for the runtime lexer simulator. Same
/// blob format and decoder as the parser ATN; only the atom semantics differ
/// (char ranges vs token kinds).
fn gen_latn_data_global(w: &mut CodeWriter, atn: &Atn) {
    emit_atn_blob_global(w, atn, "LATN_SIM", false);
    w.blank();
}

/// Emit `global <sim_name>: AtnSim = atn_decode(&b"...");`. The blob is a call
/// argument rather than a global of its own, a GC root, so it dies once decoded.
fn emit_atn_blob_global<S: AsStrSlice>(w: &mut CodeWriter, atn: &Atn, sim_name: S, lr_tables: bool) {
    let bytes = atn_blob_bytes(atn);
    let mut body = String::with_capacity(bytes.len() * 4);
    for let b of &bytes {
        push_hex_byte(&mut body, *b);
    }
    let decode = `atn_decode(&b"${body}")`;
    let init = if lr_tables { `atn_with_lr_tables(${decode})` } else { decode };
    w.line(`global ${sim_name}: AtnSim = ${init};`);
}

/// Append the `\xNN` byte escape (lowercase, zero-padded to two digits) for
/// byte `b` to `out`.
fn push_hex_byte(out: &mut String, b: u8) {
    out.push_str(`\\x${b:02x}`);
}

/// Append `s` as an attribute string literal's content: the reader unescapes
/// what it reads, so a quote or a backslash goes back escaped.
fn push_attr_escaped<S: AsStrSlice>(out: &mut String, s: S) {
    for let c of s.chars() {
        if c == '"' || c == '\\' {
            out.push('\\');
        }
        out.push(c);
    }
}

fn gen_header(w: &mut CodeWriter, grammar: &Grammar) {
    // With no recorded source file, `sources` stays empty rather than naming a
    // plausible `<GrammarName>.g4` that does not exist.
    let sources = &grammar.source_files;
    let mut parts = String::with_capacity(32);
    parts.push_str("#![generated(by = \"gale\", sources = [");
    for let mut i = 0; i < sources.len(); i += 1 {
        if i > 0 {
            parts.push_str(", ");
        }
        parts.push('"');
        push_attr_escaped(&mut parts, &sources[i]);
        parts.push('"');
    }
    parts.push_str("])]");
    w.line(&parts);
    w.blank();
}

/// Which runtime fragments a generated parser needs. Read after the parser is
/// emitted, so a gate can ask what the output calls.
struct RuntimeFeatures {
    emit_follow: bool,
    atn_decode: bool,
    atn_predict: bool,
    atn_lr: bool,
    latn: bool,
    highlight: bool,
    superclass: bool,
    scan_memo: bool,
}

/// The inlined runtime: its standard-library imports, hoisted to the top of
/// the generated file, and the fragment bodies.
struct InlinedRuntime {
    imports: List<String>,
    code: CodeWriter,
}

/// The fragments of `src/runtime/` a generated parser carries: `lex`, `diag`,
/// `tree` and `tools` always, each other one only when the parser calls it.
fn gen_runtime(f: &RuntimeFeatures) -> InlinedRuntime {
    let mut rt = InlinedRuntime { imports: [], code: CodeWriter::new() };
    gen_runtime_fragment(&mut rt, &#include_str("./runtime/lex.wado"));
    gen_runtime_fragment(&mut rt, &#include_str("./runtime/diag.wado"));
    gen_runtime_fragment(&mut rt, &#include_str("./runtime/tree.wado"));
    gen_runtime_fragment(&mut rt, &#include_str("./runtime/tools.wado"));
    if f.superclass {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/superclass.wado"));
    }
    if f.emit_follow {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/follow.wado"));
    }
    if f.scan_memo {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/scan_memo.wado"));
    }
    if f.atn_decode {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/atn.wado"));
    }
    if f.atn_predict {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/atn_predict.wado"));
    }
    if f.atn_lr {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/atn_lr.wado"));
    }
    if f.latn {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/latn.wado"));
    }
    if f.highlight {
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/highlight.wado"));
        gen_runtime_fragment(&mut rt, &#include_str("./runtime/highlight_walk.wado"));
    }
    return rt;
}

/// Append a runtime fragment. A sibling import (`from "./..."`) is dropped,
/// since the sibling is inlined too, and a standard-library one is hoisted.
/// A fragment's `#![allow(…)]` is dropped: an inner attribute must open its
/// module, and the generated module's own `#![generated]` already waives the
/// lints a fragment waives for the generator's build, where the parser that
/// calls it is absent. Any other inner attribute would change meaning when
/// dropped, so it is refused.
fn gen_runtime_fragment<S: AsStrSlice>(rt: &mut InlinedRuntime, src: S) {
    let mut block = String::new();
    let mut in_use = false;
    let mut after_attr = false;
    for let line of src.lines() {
        if line.starts_with("#![") || after_attr && line.is_empty() {
            after_attr = line.starts_with("#![");
            assert !after_attr || line.starts_with("#![allow("), `a runtime fragment's attribute would be lost: ${line}`;
            continue;
        }
        after_attr = false;
        if !in_use && !line.trim_start().starts_with("use ") {
            rt.code.raw(&line);
            rt.code.raw("\n");
            continue;
        }
        in_use = true;
        block.push_str(&line);
        block.push('\n');
        if line.contains(";") {
            if !block.contains("from \"./") && !rt.imports.contains(&block) {
                rt.imports.push(block);
            }
            block = String::new();
            in_use = false;
        }
    }
    assert !in_use, "a runtime fragment ends inside a `use`";
}

/// Surface grammar-level options and named actions from the .g4 prequel as
/// pass-through comments in the generated output. ANTLR4 stores these on the
/// IR (`Grammar.options`, `Grammar.named_actions`) but most values have no
/// semantic effect on Gale's Wado codegen (e.g. `language`, `superClass`,
/// `tokenVocab`, or `@header` bodies whose host-language code is discarded).
/// Emitting them as a comment block keeps the information observable for
/// downstream tooling and makes the .g4 prequel round-trip visible.
fn gen_grammar_metadata(w: &mut CodeWriter, grammar: &Grammar) {
    if grammar.options.is_empty() && grammar.named_actions.is_empty() {
        return;
    }
    w.line("// Grammar metadata from source .g4 prequels:");
    // Two bases do not fit one `options` list — read the resolved slots.
    if !grammar.lexer_superclass.is_empty() {
        w.line(`//   option superClass = ${grammar.lexer_superclass} (lexer)`);
    }
    if !grammar.parser_superclass.is_empty() {
        w.line(`//   option superClass = ${grammar.parser_superclass} (parser)`);
    }
    for let opt of &grammar.options {
        if opt.name == "superClass" {
            continue;
        }
        w.line(`//   option ${opt.name} = ${format_option_value(&opt.value)}`);
    }
    for let act of &grammar.named_actions {
        if let Some(scope) = &act.scope {
            w.line(`//   @${*scope}::${act.name}`);
        } else {
            w.line(`//   @${act.name}`);
        }
    }
    w.blank();
}

fn format_option_value(v: &OptionValue) -> String {
    return match *v {
        Ident(s) => s,
        Qualified(parts) => parts.join("."),
        Str(s) => `"${s}"`,
        Int(n) => `${n}`,
        Action(_) => "{ ... }",
    };
}
