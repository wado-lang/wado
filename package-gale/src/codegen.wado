use { Grammar, Alternative, OptionValue, LexerRule, normalize_caches, canonicalize_empty_alt_groups } from "./ir.wado";
use { rule_type_name, all_alts_are_single_token } from "./gen_util.wado";
use { collect_literal_tokens, gen_token_constants, gen_lexer } from "./lexer_gen.wado";
use { gen_parser, gen_kind_set_helpers, gen_follow_mask_globals } from "./parser_gen.wado";
use { gen_visitor } from "./visitor_gen.wado";
use { gen_highlight } from "./highlight_gen.wado";
use { GenContext } from "./gen_context.wado";
use { CodeWriter, StructSpec, VariantSpec, EnumSpec } from "./wadopoet.wado";
use { lower } from "./lower.wado";
use { build_atn_with, serialize_atn } from "./atn.wado";
use {
    LoweredGrammar,
    Diagnostic,
    Rule,
    SimpleRule,
    MultiAltRule,
    LeftRecursiveRule,
    LrAlt,
    AltBody,
    Op,
    GroupOp,
    GroupShape,
    SimpleCstShape,
    SingleAltShape,
    GeneralShape,
    FieldDecl,
} from "./gir.wado";

pub struct GenerateOptions {
    pub highlight: bool,
    /// Emit trace logging to stderr (via `log_stderr`) in the generated
    /// parser: rule enter/ok/fail frames plus the multi-alt scan/pick/try
    /// decisions. Off by default; enabled by `gale gen --trace` or the
    /// `trace: true` Kiln generator option.
    pub trace: bool = false,
}

/// Result of a codegen pass: the generated `.wado` source plus the
/// prediction-strategy diagnostics the single lowering raised. Codegen
/// always lowers exactly once, so the diagnostics ride out on the same
/// `LoweredGrammar` the emit walk consumes — callers that want to surface
/// warnings (`gale gen`) read `diagnostics`; callers that only need the
/// module text (the Kiln generator entry, unit tests) read `source`.
pub struct GeneratedOutput {
    pub source: String,
    pub diagnostics: List<Diagnostic>,
}

pub fn generate(grammar: &mut Grammar, options: &GenerateOptions) -> GeneratedOutput {
    // Fill in `snake_name` / `field_name` caches on every name-bearing IR
    // node before any codegen pass touches the grammar. Production IR built
    // through `RuleRefElement::with_options` etc. already has these set —
    // `normalize_caches` is a one-time `is_empty()` sweep and a fallback
    // for IR constructed with struct-literal syntax (e.g. unit tests).
    // Fold `( | X)` / `(X | )` empty-alt groups onto the Optional path
    // before any structural pass (lowering, ATN build) sees them, so both
    // the emitter and `build_atn` agree on the canonical repeat shape.
    canonicalize_empty_alt_groups(grammar);
    normalize_caches(grammar);
    // Pre-size the output buffer from the grammar's rule count so the
    // bulk of `String::push_str` calls in `CodeWriter::line` don't
    // trigger `String::grow` doubling events. Empirical Rust*.g4 output
    // is ~1.3 MB across 197 parser + 130 lexer rules; the 4 KB +
    // 4 KB/rule heuristic matches that within one doubling.
    let estimated_size = 4096 + 4096 * (grammar.parser_rules.len() + grammar.lexer_rules.len());
    let mut w = CodeWriter::with_capacity(estimated_size);
    // Lower up-front so CST emission can consume `AltBody.fields` /
    // `GroupShape` directly. Sharing the GenContext primes the
    // follow-mask / kind-set registries and the first / nullable
    // / scannable caches for the subsequent parser emit.
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    let mut ctx = GenContext::new(&grammar.parser_rules, &lit_tokens);
    ctx.set_trace(options.trace);
    let lowered = lower(grammar, &lit_tokens, &mut ctx);
    gen_header(&mut w, grammar);
    if options.trace {
        // Trace logging writes to stderr via the ambient logger.
        w.line(&"use { log_stderr } from \"core:internal\";");
        w.blank();
    }
    gen_grammar_metadata(&mut w, grammar);
    gen_runtime(&mut w, &ctx, options.highlight);
    gen_token_kind(&mut w, &grammar.lexer_rules);
    gen_cst_types(&mut w, &lowered, grammar);
    gen_token_constants(&mut w, &grammar.lexer_rules, &lit_tokens);
    gen_lexer(&mut w, grammar, &lit_tokens);
    gen_parser(&mut w, grammar, &lowered, &mut ctx);
    gen_visitor(&mut w, grammar);
    if options.highlight {
        gen_highlight(&mut w, grammar, &lit_tokens);
    }
    // Emit token-kind-set helpers last, after every `ctx.kind_check_str`
    // call across parser/scan/lookahead generation has had a chance to
    // intern its set. Visitor and highlight do not emit `matches { TK_* }`
    // checks so this ordering is safe.
    gen_kind_set_helpers(&mut w, &lowered, &ctx);
    // Runtime FOLLOW-mask globals (`FOLLOW_MASK_<id>`). Emitted after all
    // lowering/emit has had a chance to intern masks; nothing is emitted
    // until the runtime-follow conversion wires repair call sites.
    gen_follow_mask_globals(&mut w, &ctx);
    // Serialized ATN blob for the runtime simulator. Only emitted when
    // lowering saw a construct that needs it (a non-greedy repeat), so
    // gate-free grammars stay byte-identical.
    if ctx.needs_atn() {
        gen_atn_data_global(&mut w, grammar, &lowered);
    }
    return GeneratedOutput {
        source: w.to_string(),
        diagnostics: lowered.diagnostics,
    };
}

/// Emit `global GALE_ATN_DATA: List<i32> = [...]`: the serialized
/// whole-grammar ATN the inlined runtime decodes once per parser.
fn gen_atn_data_global(w: &mut CodeWriter, grammar: &Grammar, lowered: &LoweredGrammar) {
    let atn = build_atn_with(grammar, lowered);
    let blob = serialize_atn(&atn);
    let mut body = String::with_capacity(blob.len() * 6);
    for let mut i = 0; i < blob.len(); i += 1 {
        if i > 0 {
            body.push_str(&", ");
        }
        body.push_str(&`{blob[i]}`);
    }
    w.line(&`global GALE_ATN_DATA: List<i32> = [{body}];`);
    w.blank();
}

fn gen_header(w: &mut CodeWriter, grammar: &Grammar) {
    // Emit `#![generated(by = "gale", sources = ["a.g4", "b.g4"])]`. If the
    // grammar has no recorded source files (e.g. constructed directly in a
    // unit test), fall back to `{name}.g4` so existing tests still see a
    // sensible provenance entry.
    let mut sources: List<String> = [];
    if grammar.source_files.is_empty() {
        sources.push(`{grammar.name}.g4`);
    } else {
        for let sf of &grammar.source_files {
            sources.push(*sf);
        }
    }
    let mut parts = String::with_capacity(32);
    parts.push_str(&"#![generated(by = \"gale\", sources = [");
    for let mut i = 0; i < sources.len(); i += 1 {
        if i > 0 {
            parts.push_str(&", ");
        }
        parts.push('"');
        parts.push_str(&sources[i]);
        parts.push('"');
    }
    parts.push_str(&"])]");
    w.line(&parts);
    w.blank();
}

/// Emit the inlined runtime, split across `src/runtime/*.wado` and gated so
/// a generated parser carries only the fragments it actually needs:
///
/// - `lex` / `cst` / `tools` are always emitted (core vocabulary, the
///   generic tree + `Visitor`, and the consumer-facing tree/token utilities).
/// - `follow` only when lowering built a caller-FOLLOW gate (`emit_follow`).
/// - `highlight` only when the `highlight` generator option is on.
/// - `atn` only when lowering needs the runtime simulator (`needs_atn`).
///
/// Each fragment is a real module for dev/test, importing its siblings via
/// `use { ... } from "./lex.wado"` etc.; `emit_runtime_fragment` drops those
/// relative imports because every fragment is concatenated into the single
/// generated module (with `lex` first), where such imports are both
/// redundant and unresolvable.
fn gen_runtime(w: &mut CodeWriter, ctx: &GenContext, highlight: bool) {
    emit_runtime_fragment(w, &#include_str("./runtime/lex.wado"));
    emit_runtime_fragment(w, &#include_str("./runtime/cst.wado"));
    emit_runtime_fragment(w, &#include_str("./runtime/tools.wado"));
    if ctx.emit_follow() {
        emit_runtime_fragment(w, &#include_str("./runtime/follow.wado"));
    }
    if highlight {
        emit_runtime_fragment(w, &#include_str("./runtime/highlight.wado"));
    }
    if ctx.needs_atn() {
        emit_runtime_fragment(w, &#include_str("./runtime/atn.wado"));
    }
}

/// Append a runtime fragment, dropping only its sibling-runtime imports
/// (`from "./..."`) — those siblings are inlined too, so the import would be
/// redundant and unresolvable in the generated file. A `use` may span multiple
/// lines, so a sibling import is stripped from the `use` keyword through its
/// terminating `;` (semicolons are mandatory). Standard-library imports
/// (`core:` / `wasi:`) are kept verbatim and flow into the generated parser
/// (none are needed today, but they are permitted).
fn emit_runtime_fragment(w: &mut CodeWriter, src: &String) {
    // Lines of an open `use ...;` statement whose siblingness is not yet known.
    let mut block: List<String> = [];
    let mut in_use = false;
    for let line of src.lines() {
        if in_use {
            block.push(line);
            if line.contains(";") {
                flush_use_block(w, &block);
                block = [];
                in_use = false;
            }
        } else if line.trim_start().starts_with("use ") {
            block.push(line);
            if line.contains(";") {
                flush_use_block(w, &block);
                block = [];
            } else {
                in_use = true;
            }
        } else {
            w.raw(&line);
            w.raw(&"\n");
        }
    }
    // A well-formed fragment never ends mid-`use`; emit any stray buffer
    // verbatim rather than silently dropping it.
    for let l of &block {
        w.raw(l);
        w.raw(&"\n");
    }
}

/// Emit a complete (possibly multi-line) `use ...;` statement unless it is a
/// sibling import (`from "./..."`), which is dropped because the symbols are
/// already inlined ahead of this fragment.
fn flush_use_block(w: &mut CodeWriter, block: &List<String>) {
    for let l of block {
        if l.contains("from \"./") {
            return;
        }
    }
    for let l of block {
        w.raw(l);
        w.raw(&"\n");
    }
}

/// Surface grammar-level options and named actions from the .g4 prequel as
/// pass-through comments in the generated output. ANTLR4 stores these on the
/// IR (`Grammar.options`, `Grammar.named_actions`) but most values have no
/// semantic effect on Gale's Wado codegen (e.g. `language`, `superClass`,
/// `tokenVocab`, or `@header` bodies whose host-language code is discarded).
/// Emitting them as a comment block keeps the information observable for
/// downstream tooling and makes the .g4 prequel round-trip visible.
fn gen_grammar_metadata(w: &mut CodeWriter, grammar: &Grammar) {
    if grammar.options.is_empty() && grammar.named_actions.is_empty() {
        return;
    }
    w.line(&"// Grammar metadata from source .g4 prequels:");
    for let opt of &grammar.options {
        w.line(&`//   option {opt.name} = {format_option_value(&opt.value)}`);
    }
    for let act of &grammar.named_actions {
        if let Some(scope) = &act.scope {
            w.line(&`//   @{*scope}::{act.name}`);
        } else {
            w.line(&`//   @{act.name}`);
        }
    }
    w.blank();
}

fn format_option_value(v: &OptionValue) -> String {
    return match *v {
        Ident(s) => s,
        Qualified(parts) => {
            let mut out = String::with_capacity(16);
            for let mut i = 0; i < parts.len(); i += 1 {
                if i > 0 {
                    out.push('.');
                }
                out.push_str(&parts[i]);
            }
            out;
        },
        Str(s) => `"{s}"`,
        Int(n) => `{n}`,
        Action(_) => "{ ... }",
    };
}


fn gen_token_kind(w: &mut CodeWriter, lexer_rules: &List<LexerRule>) {
    let mut e = EnumSpec::new("TokenKind");
    e.set_pub();
    for let rule of lexer_rules {
        if !rule.is_fragment {
            if rule.is_virtual {
                e.add_member_with_comment(&rule.name, &"virtual");
            } else {
                e.add_member(&rule.name);
            }
        }
    }
    e.add_member(&"Eof");
    e.add_member(&"Error");
    e.emit(w);
    w.blank();
}


/// Emit every CST type for the grammar, driven entirely by GIR.
/// Each `Rule` lays out the struct / enum shapes via:
///
/// * `AltBody.fields` — `FieldDecl`s populated by lower's
///   `enumerate_alt_field_decls` / `enumerate_op_field_decls`.
/// * `Op::Group` + `GroupShape` — pre-classified nested types
///   (`Transparent` / `TokenOnly` / `SimpleCst` / `SingleAlt` /
///   `General`); each shape carries the struct / variant identifiers
///   the legacy emit recomputed at every traversal.
///
/// emit reads these decisions verbatim — no surface-IR walk, no
/// re-classification, no group-counter bookkeeping.
fn gen_cst_types(w: &mut CodeWriter, lowered: &LoweredGrammar, grammar: &Grammar) {
    let mut emitted: List<String> = [];
    // `lower_with_ctx` builds `lowered.parser_rules` one-for-one in source
    // order from `grammar.parser_rules`, so the surface alternatives line up
    // by index. The CST type generator needs them to apply the same
    // `all_alts_are_single_token` screen (which excludes labelled tokens) the
    // parse and walk generators use, keeping the three shapes in lockstep.
    for let mut i = 0; i < lowered.parser_rules.len(); i += 1 {
        gen_rule_cst_type(w, &lowered.parser_rules[i], &grammar.parser_rules[i].alternatives, &mut emitted);
    }
}

fn gen_rule_cst_type(w: &mut CodeWriter, rule: &Rule, surface_alts: &List<Alternative>, emitted: &mut List<String>) {
    return match *rule {
        Simple(s) => {
            gen_ops_nested_types(w, &s.body.ops, &s.header.name, emitted);
            emit_alt_struct(w, &s.body.struct_name, &s.body.fields);
        },
        MultiAlt(m) => gen_multi_alt_cst(w, &m.header.name, &m.header.type_name, &m.alts, surface_alts, emitted),
        LeftRecursive(l) => gen_lr_cst(w, &l.header.name, &l.header.type_name, &l.atom.alts, &l.lr_alts, emitted),
    };
}

fn gen_multi_alt_cst(w: &mut CodeWriter, rule_name: &String, type_name: &String, alts: &List<AltBody>, surface_alts: &List<Alternative>, emitted: &mut List<String>) {
    if all_alts_are_single_token(surface_alts) {
        // Compact single-token node: the token's `kind` already records
        // which alternative matched, so the N alt structs and the wrapping
        // variant collapse to one struct that `walk_<rule>` / `_parse_<rule>`
        // build and read as `.token`. (Detection screen: see `gen_cst_types`.)
        let mut s = StructSpec::new(type_name);
        s.set_pub();
        s.add_pub_field(&"span", &"Span");
        s.add_pub_field(&"token", &"Token");
        s.emit(w);
        w.blank();
        return;
    }
    let mut v = VariantSpec::new(type_name);
    v.set_pub();
    for let alt of alts {
        v.add_case_with_payload(&alt.case_name, &alt.struct_name);
    }
    v.emit(w);
    w.blank();
    for let alt of alts {
        gen_ops_nested_types(w, &alt.ops, rule_name, emitted);
        emit_alt_struct(w, &alt.struct_name, &alt.fields);
    }
}

fn gen_lr_cst(w: &mut CodeWriter, rule_name: &String, type_name: &String, atom_alts: &List<AltBody>, lr_alts: &List<LrAlt>, emitted: &mut List<String>) {
    // The variant cases follow original source order. Each
    // `AltBody.alt_index` / `LrAlt.alt_index` is the position of the
    // alt in the surface rule, so iterating `0..total` and looking
    // each one up reconstructs that order without sorting.
    let total: i32 = atom_alts.len() + lr_alts.len();
    let mut v = VariantSpec::new(type_name);
    v.set_pub();
    for let mut idx = 0; idx < total; idx += 1 {
        let pair = find_lr_alt_names(atom_alts, lr_alts, idx);
        v.add_case_with_payload(&pair.0, &pair.1);
    }
    v.emit(w);
    w.blank();
    for let mut idx = 0; idx < total; idx += 1 {
        emit_lr_alt_struct(w, atom_alts, lr_alts, idx, rule_name, emitted);
    }
}

fn find_lr_alt_names(atom_alts: &List<AltBody>, lr_alts: &List<LrAlt>, idx: i32) -> [String, String] {
    for let a of atom_alts {
        if a.alt_index == idx {
            return [a.case_name, a.struct_name];
        }
    }
    for let l of lr_alts {
        if l.alt_index == idx {
            return [l.case_name, l.struct_name];
        }
    }
    panic(`gen_lr_cst: no atom / lr alt has alt_index = {idx}`);
}

fn emit_lr_alt_struct(w: &mut CodeWriter, atom_alts: &List<AltBody>, lr_alts: &List<LrAlt>, idx: i32, rule_name: &String, emitted: &mut List<String>) {
    for let a of atom_alts {
        if a.alt_index == idx {
            gen_ops_nested_types(w, &a.ops, rule_name, emitted);
            emit_alt_struct(w, &a.struct_name, &a.fields);
            return;
        }
    }
    for let l of lr_alts {
        if l.alt_index == idx {
            gen_ops_nested_types(w, &l.suffix.ops, rule_name, emitted);
            // LR alts surface the stripped leading self-ref as a CST
            // field — `l.suffix.fields` only carries the right-hand
            // side, so prepend the prefix decl (preserving the
            // leading `span` entry).
            let mut combined: List<FieldDecl> = [];
            for let mut i = 0; i < l.suffix.fields.len(); i += 1 {
                combined.push(l.suffix.fields[i]);
                if i == 0 {
                    combined.push(l.prefix_self_ref);
                }
            }
            emit_alt_struct(w, &l.struct_name, &combined);
            return;
        }
    }
    panic(`emit_lr_alt_struct: no atom / lr alt has alt_index = {idx}`);
}

/// Emit a `pub struct <name> { <fields> }` from a `FieldDecl` list.
/// The leading `span: Span` field is part of the `FieldDecl` list
/// (`FieldKind::Span`) when the struct is a rule-level alt body;
/// nested SingleAlt / General-group alt structs omit it.
fn emit_alt_struct(w: &mut CodeWriter, type_name: &String, fields: &List<FieldDecl>) {
    let mut s = StructSpec::new(type_name);
    s.set_pub();
    for let f of fields {
        s.add_pub_field(&f.name, &f.type_str);
    }
    s.emit(w);
    w.blank();
}

fn gen_ops_nested_types(w: &mut CodeWriter, ops: &List<Op>, rule_name: &String, emitted: &mut List<String>) {
    for let op of ops {
        gen_op_nested_types(w, op, rule_name, emitted);
    }
}

fn gen_op_nested_types(w: &mut CodeWriter, op: &Op, rule_name: &String, emitted: &mut List<String>) {
    return match *op {
        Group(g) => gen_group_nested_types(w, &g, rule_name, emitted),
        Repeat(r) => gen_op_nested_types(w, &r.body, rule_name, emitted),
        ListLabel(ll) => gen_op_nested_types(w, &ll.inner, rule_name, emitted),
        Token(_) | Literal(_) | RuleCall(_) | Wildcard(_) | Excluded(_) => {
        },
    };
}

fn gen_group_nested_types(w: &mut CodeWriter, g: &GroupOp, rule_name: &String, emitted: &mut List<String>) {
    return match &g.shape {
        Transparent => {
            // Transparent groups have one alt with one inner op (the
            // group is purely syntactic). Recurse into the inner op
            // so nested storable groups land in the emit stream.
            if g.alts.len() > 0 {
                gen_ops_nested_types(w, &g.alts[0].ops, rule_name, emitted);
            }
        },
        TokenOnly(_) => {
        },
        SimpleCst(scst) => emit_simple_cst_enum_if_new(w, scst, &g.alts, emitted),
        SingleAlt(sa) => emit_single_alt_struct_if_new(w, sa, &g.alts, emitted),
        General(gen) => emit_general_group_types_if_new(w, gen, &g.alts, rule_name, emitted),
    };
}

fn emit_simple_cst_enum_if_new(w: &mut CodeWriter, scst: &SimpleCstShape, alts: &List<AltBody>, emitted: &mut List<String>) {
    if has_emitted(emitted, &scst.type_name) {
        return;
    }
    emitted.push(scst.type_name);
    let mut v = VariantSpec::new(&scst.type_name);
    v.set_pub();
    for let alt of alts {
        // Each SimpleCst alt body has exactly one op: an `Op::RuleCall`
        // resolved by `lower_simple_cst_alt_call`. The case name is the
        // alt's PascalCase form; the payload is the target rule's CST
        // type.
        if let RuleCall(rc) = &alt.ops[0] {
            v.add_case_with_payload(&alt.case_name, &rule_type_name(&rc.target_name));
        } else {
            panic(`gen_simple_cst: SimpleCst alt body must be a single RuleCall op`);
        }
    }
    v.emit(w);
    w.blank();
}

fn emit_single_alt_struct_if_new(w: &mut CodeWriter, sa: &SingleAltShape, alts: &List<AltBody>, emitted: &mut List<String>) {
    if has_emitted(emitted, &sa.struct_name) {
        return;
    }
    emitted.push(sa.struct_name);
    // Recurse into the inner body's ops first so nested storable
    // groups are declared before the SingleAlt struct that references
    // them. SingleAlt struct names use the surrounding `owner_rule`'s
    // monomorph table (per `single_alt_owner`) — nested groups inside
    // it follow the same key.
    gen_ops_nested_types(w, &alts[0].ops, &sa.owner_rule, emitted);
    emit_alt_struct(w, &sa.struct_name, &alts[0].fields);
}

fn emit_general_group_types_if_new(w: &mut CodeWriter, gen: &GeneralShape, alts: &List<AltBody>, rule_name: &String, emitted: &mut List<String>) {
    if has_emitted(emitted, &gen.variant_type) {
        return;
    }
    emitted.push(gen.variant_type);
    // Recurse into each alt's ops first so any nested storable groups
    // (which by construction have group indices > this one) are
    // declared before the enclosing variant.
    for let alt of alts {
        gen_ops_nested_types(w, &alt.ops, rule_name, emitted);
    }
    let mut v = VariantSpec::new(&gen.variant_type);
    v.set_pub();
    for let mut i = 0; i < alts.len(); i += 1 {
        v.add_case_with_payload(&alts[i].case_name, &gen.alt_struct_names[i]);
    }
    v.emit(w);
    w.blank();
    for let mut i = 0; i < alts.len(); i += 1 {
        emit_alt_struct(w, &gen.alt_struct_names[i], &alts[i].fields);
    }
}

fn has_emitted(emitted: &List<String>, name: &String) -> bool {
    for let e of emitted {
        if *e == *name {
            return true;
        }
    }
    return false;
}
