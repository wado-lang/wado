pub struct GenerateOptions {
    pub highlight: bool,
    /// Emit trace logging to stderr (via `log_stderr`) in the generated
    /// parser: rule enter/ok/fail frames plus the multi-alt scan/pick/try
    /// decisions. Off by default; enabled by `gale gen --trace` or the
    /// `trace: true` Kiln generator option.
    pub trace: bool = false,
}

/// Result of a codegen pass: the generated `.wado` source plus the
/// prediction-strategy diagnostics the single lowering raised. Codegen
/// always lowers exactly once, so the diagnostics ride out on the same
/// `LoweredGrammar` the emit walk consumes — callers that want to surface
/// warnings (`gale gen`) read `diagnostics`; callers that only need the
/// module text (the Kiln generator entry, unit tests) read `source`.
pub struct GeneratedOutput {
    pub source: String,
    pub diagnostics: List<Diagnostic>,
}

/// Output-buffer pre-sizing heuristic (see `generate`): a base allocation
/// plus a per-rule estimate, tuned so a large grammar's generated source
/// fits within one `String::grow` doubling.
global GEN_BASE_CAPACITY: i32 = 4096;
global GEN_PER_RULE_CAPACITY: i32 = 4096;

pub fn generate(grammar: &mut Grammar, options: &GenerateOptions) -> GeneratedOutput {
    // Fill in `snake_name` / `field_name` caches on every name-bearing IR
    // node before any codegen pass touches the grammar. Production IR built
    // through `RuleRefElement::with_options` etc. already has these set —
    // `normalize_caches` is a one-time `is_empty()` sweep and a fallback
    // for IR constructed with struct-literal syntax (e.g. unit tests).
    // Fold `( | X)` / `(X | )` empty-alt groups onto the Optional path
    // before any structural pass (lowering, ATN build) sees them, so both
    // the emitter and `build_atn` agree on the canonical repeat shape.
    canonicalize_empty_alt_groups(grammar);
    // Number every surface `RuleRef` call site so `build_atn`'s
    // `call_site_returns` correspondence (read by codegen to push exact ATN
    // return states) is keyed consistently. Runs after canonicalization (the
    // numbered shape is the post-canonicalization one) and before lowering.
    assign_atn_call_sites(grammar);
    // Must run after `assign_atn_call_sites` (its `Repeat` / `Group` rebuild
    // would otherwise reset the freshly stamped decision-site ids).
    assign_atn_decisions(grammar);
    assign_action_ids(grammar);
    normalize_caches(grammar);
    // Pre-size the output buffer from the grammar's rule count so the
    // bulk of `String::push_str` calls in `CodeWriter::line` don't
    // trigger `String::grow` doubling events. Empirical Rust*.g4 output
    // is ~1.3 MB across 197 parser + 130 lexer rules; the 4 KB +
    // 4 KB/rule heuristic matches that within one doubling.
    let estimated_size = GEN_BASE_CAPACITY + GEN_PER_RULE_CAPACITY * (grammar.parser_rules.len() + grammar.lexer_rules.len(
    ));
    let mut w = CodeWriter::with_capacity(estimated_size);
    // Lower up-front so CST emission can consume `AltBody.fields` /
    // `GroupShape` directly. Sharing the GenContext primes the
    // follow-mask / kind-set registries and the first / nullable
    // / scannable caches for the subsequent parser emit.
    let lit_tokens = collect_literal_tokens(&grammar.parser_rules);
    let mut ctx = GenContext::new(&grammar.parser_rules, &lit_tokens);
    ctx.set_trace(options.trace);
    ctx.set_emit_actions(action_language_is_emittable(grammar));
    let lowered = lower(grammar, &lit_tokens, &mut ctx);
    // Build the ATN up front when the grammar needs the simulator, so parser
    // emit can push each rule call's exact return state (`call_site_returns`)
    // and `gen_atn_data_global` can serialize the very same ATN. Gate-free
    // grammars skip this entirely.
    install_rule_follow(grammar, &mut ctx);
    if !ctx.needs_atn() && grammar_has_at_end_conflict(grammar, &lowered, &mut ctx) {
        ctx.mark_needs_atn();
    }
    let mut atn = empty_atn();
    if ctx.needs_atn() {
        atn = build_atn_with(grammar, &lowered);
        ctx.set_atn_call_site_returns(&atn.call_site_returns);
        ctx.set_atn_decision_sites(&atn.decision_sites);
        let mut lr_decs: List<i32> = [];
        let mut body_decs: List<i32> = [];
        for let mut r = 0; r < grammar.parser_rules.len(); r += 1 {
            let lr_dec = lr_loop_entry_decision(&atn, r);
            lr_decs.push(lr_dec);
            // -1 for LR rules: the atom-block decision's edge indices exclude the
            // LR alts, so they would not equal the grammar alt indices `_alt_N`
            // uses (AtEndConflict routing is non-LR only).
            body_decs.push(if lr_dec >= 0 { -1 } else { rule_body_decision(&atn, r) });
        }
        ctx.set_lr_loop_entry_decisions(&lr_decs);
        ctx.set_atn_rule_body_decisions(&body_decs);
    }
    // Lexer ATN: built when a lexer rule's non-greedy body recurses into
    // itself (the nested-comment class static lexing cannot decide). The
    // `atn_class_map` carries each such rule's `name -> latn rule index`
    // so the lexer emit routes its `try_*` body to `latn_match`.
    let needs_latn = grammar_needs_latn(grammar);
    let mut latn = LatnResult {
        atn: empty_atn(),
        rule_index: TreeMap::<String, i32>::new(),
        atn_class_rules: [],
    };
    let mut atn_class_map = TreeMap::<String, i32>::new();
    if needs_latn {
        latn = build_latn(grammar);
        for let name of &latn.atn_class_rules {
            if let Some(idx) = latn.rule_index.get(*name) {
                atn_class_map[*name] = idx;
            }
        }
    }
    gen_header(&mut w, grammar);
    if options.trace {
        // Trace logging writes to stderr via the ambient logger.
        w.line(&"use { log_stderr } from \"core:rt\";");
        w.blank();
    }
    gen_grammar_metadata(&mut w, grammar);
    // Scan functions (and their kind-set helpers) are emitted only when a rule
    // needs a longest-match tournament; the FOLLOW runtime / mask globals only
    // when lowering built a caller-FOLLOW gate (`emit_follow`).
    let ef = ctx.emit_follow();
    gen_runtime(&mut w, ef, ctx.needs_atn(), needs_latn, options.highlight);
    gen_token_kind(&mut w, &grammar.lexer_rules);
    gen_token_constants(&mut w, &grammar.lexer_rules, &lit_tokens);
    gen_lexer(&mut w, grammar, &lit_tokens, &atn_class_map);
    gen_node_kinds(&mut w, &lowered.parser_rules);
    gen_alt_enums(&mut w, grammar);
    gen_parser(&mut w, grammar, &lowered, &mut ctx);
    gen_string_tree_helper(&mut w, grammar, &lit_tokens);
    if options.highlight {
        gen_highlight(&mut w, grammar, &lit_tokens);
    }
    // The scan emission may intern kind-set helpers (`_kind_set_N`);
    // emit whatever was interned (a no-op when none).
    gen_kind_set_helpers(&mut w, &lowered, &ctx);
    gen_sync_set_globals(&mut w, &ctx);
    if ef {
        gen_follow_mask_globals(&mut w, &ctx);
    }
    // Serialized ATN blob for the runtime simulator. Only emitted when
    // lowering saw a construct that needs it (a non-greedy `??` or an
    // ATN-class LR rule).
    if ctx.needs_atn() {
        gen_atn_data_global(&mut w, &atn, ctx.needs_scan_atn());
    }
    // Serialized lexer ATN blob, decoded once into `LATN_SIM`, for the
    // runtime lexer simulator (`latn_match`).
    if needs_latn {
        gen_latn_data_global(&mut w, &latn.atn);
    }
    return GeneratedOutput {
        source: w.to_string(),
        diagnostics: lowered.diagnostics,
    };
}

/// Whether Gale can currently emit the grammar's action bodies: the identity
/// translator handles `language = Wado`. Java / other host languages are a
/// later phase and stay discarded until then.
fn action_language_is_emittable(grammar: &Grammar) -> bool {
    return grammar.action_language matches { Wado };
}

fn install_rule_follow(grammar: &Grammar, ctx: &mut GenContext) {
    if grammar.parser_rules.is_empty() {
        return;
    }
    let fenv = build_follow_env(&grammar.parser_rules, ctx, &grammar.parser_rules[0].name);
    let mut follow_kinds = TreeMap::<String, List<String>>::new();
    for let rule of &grammar.parser_rules {
        let fs = fenv.rule_follow(&rule.name);
        let mut kinds: List<String> = [];
        for let k of &fs.kinds {
            kinds.push(k);
        }
        follow_kinds[rule.name] = kinds;
    }
    ctx.set_rule_follow(follow_kinds, !grammar_has_open_first_element(&grammar.parser_rules));
}

fn grammar_has_open_first_element(parser_rules: &List<ParserRule>) -> bool {
    for let rule of parser_rules {
        for let alt of &rule.alternatives {
            for let e of &alt.elements {
                if element_has_open_first(e) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn element_has_open_first(e: &Element) -> bool {
    return match *e {
        Wildcard(_) => true,
        Not(_) => true,
        Label(l) => element_has_open_first(&l.element),
        Repeat(r) => element_has_open_first(&r.element),
        Group(g) => {
            for let alt of &g.alternatives {
                for let inner of &alt.elements {
                    if element_has_open_first(inner) {
                        return true;
                    }
                }
            }
            return false;
        },
        RuleRef(_) => false,
        TokenRef(_) => false,
        Literal(_) => false,
    };
}

/// Emit the decoded `ATN_SIM` global: the serialized whole-grammar ATN the
/// inlined runtime decodes once, at construction, into the module-level sim.
fn gen_atn_data_global(w: &mut CodeWriter, atn: &Atn, emit_scan_globals: bool) {
    let lr_tables = if emit_scan_globals { "true" } else { "false" };
    emit_atn_blob_global(w, atn, &"ATN_SIM", &`, {lr_tables}`);
    // The mutable scan caller stack. The scan emit pushes/pops it around
    // operand scans so an ATN-class LR rule's scan loop can route through
    // `atn_lr_loop_decision` exactly like the parse side. Only needed when an
    // ATN-class LR rule exists (a non-greedy-`??`-only grammar uses the
    // simulator but not the scan-side routing).
    if emit_scan_globals {
        w.line(&"global SCAN_STACK: List<i32> = [];");
    }
    w.blank();
}

/// Emit the decoded `LATN_SIM` global for the runtime lexer simulator. Same
/// blob format and decoder as the parser ATN; only the atom semantics differ
/// (char ranges vs token kinds).
fn gen_latn_data_global(w: &mut CodeWriter, atn: &Atn) {
    emit_atn_blob_global(w, atn, &"LATN_SIM", &"");
    w.blank();
}

/// Emit `global <sim_name>: AtnSim = atn_decode(&b"...packed blob...");`.
/// Shared by the parser (`ATN_SIM`) and lexer (`LATN_SIM`) — same wire format
/// and decoder; only the atom semantics differ.
///
/// The literal is a bare call argument, not bound to its own `global` first:
/// a `global` is a permanent GC root for the module's lifetime, so naming it
/// (`global ATN_DATA = b"...";`) would keep the raw blob reachable forever
/// even though `atn_decode` reads it once and never stores a reference. As
/// an argument it has no referrers left once `atn_decode` returns, so it's
/// collectible immediately — and this costs nothing at compile time:
/// `array.new_data` fires the same way whether the literal is a global's
/// initializer or a nested call argument.
fn emit_atn_blob_global(w: &mut CodeWriter, atn: &Atn, sim_name: &String, extra_args: &String) {
    let bytes = atn_blob_bytes(atn);
    let mut body = String::with_capacity(bytes.len() * 4);
    for let b of &bytes {
        push_hex_byte(&mut body, *b);
    }
    w.line(&`global {*sim_name}: AtnSim = atn_decode(&b"{body}"{*extra_args});`);
}

/// Append the `\xNN` byte escape (lowercase, zero-padded to two digits) for
/// byte `b` to `out`.
fn push_hex_byte(out: &mut String, b: u8) {
    out.push_str(&`\\x{b:02x}`);
}

fn gen_header(w: &mut CodeWriter, grammar: &Grammar) {
    // Emit `#![generated(by = "gale", sources = ["a.g4", "b.g4"])]`. If the
    // grammar has no recorded source files (e.g. constructed directly in a
    // unit test), fall back to `{name}.g4` so existing tests still see a
    // sensible provenance entry.
    let mut sources: List<String> = [];
    // `source_files` is set by both entry points (the Kiln generator from
    // `req.primary.path`, the CLI from the loaded file paths). When it is
    // genuinely unknown, emit an empty list rather than fabricating
    // `<GrammarName>.g4` — a plausible-looking name for a file that does
    // not exist.
    for let sf of &grammar.source_files {
        sources.push(*sf);
    }
    let mut parts = String::with_capacity(32);
    parts.push_str(&"#![generated(by = \"gale\", sources = [");
    for let mut i = 0; i < sources.len(); i += 1 {
        if i > 0 {
            parts.push_str(&", ");
        }
        parts.push('"');
        parts.push_str(&sources[i]);
        parts.push('"');
    }
    parts.push_str(&"])]");
    w.line(&parts);
    w.blank();
}

/// Emit the inlined runtime, split across `src/runtime/*.wado` and gated so
/// a generated parser carries only the fragments it actually needs:
///
/// - `lex` / `diag` / `tree` / `tools` are always emitted: the core lexing
///   vocabulary, the diagnostics types, the `CstNode` tree + `TreeBuilder`,
///   and the consumer-facing tree/token utilities (`normalize_tree`,
///   `to_lexer_string`).
/// - `follow` only when lowering built a caller-FOLLOW gate (`emit_follow`).
/// - `highlight` (`highlight` + `highlight_walk`) only when the `highlight`
///   generator option is on.
/// - `atn` only when lowering needs the runtime simulator (`needs_atn`).
///
/// Each fragment is a real module for dev/test, importing its siblings via
/// `use { ... } from "./lex.wado"` etc.; `gen_runtime_fragment` drops those
/// relative imports because every fragment is concatenated into the single
/// generated module (in dependency order — `lex` first, then `diag`, then
/// `tree`, which references both), where such imports are both redundant and
/// unresolvable.
fn gen_runtime(w: &mut CodeWriter, emit_follow: bool, needs_atn: bool, needs_latn: bool, highlight: bool) {
    gen_runtime_fragment(w, &#include_str("./runtime/lex.wado"));
    gen_runtime_fragment(w, &#include_str("./runtime/diag.wado"));
    gen_runtime_fragment(w, &#include_str("./runtime/tree.wado"));
    gen_runtime_fragment(w, &#include_str("./runtime/tools.wado"));
    // Scan functions reference `follow_yields` / `EMPTY_FOLLOW` when the
    // grammar has a caller-FOLLOW gate.
    if emit_follow {
        gen_runtime_fragment(w, &#include_str("./runtime/follow.wado"));
    }
    // The ATN runtime (`AtnSim`, `atn_decode`, the simulator) is shared by
    // both the parser prediction path (`needs_atn`) and the lexer simulator
    // (`needs_latn`, which decodes its own `LATN_SIM` with the same decoder).
    if needs_atn || needs_latn {
        gen_runtime_fragment(w, &#include_str("./runtime/atn.wado"));
    }
    // The lexer Pike-VM (`latn_match`) for ATN-class lexer rules.
    if needs_latn {
        gen_runtime_fragment(w, &#include_str("./runtime/latn.wado"));
    }
    if highlight {
        gen_runtime_fragment(w, &#include_str("./runtime/highlight.wado"));
        gen_runtime_fragment(w, &#include_str("./runtime/highlight_walk.wado"));
    }
}

/// Append a runtime fragment, dropping only its sibling-runtime imports
/// (`from "./..."`) — those siblings are inlined too, so the import would be
/// redundant and unresolvable in the generated file. A `use` may span multiple
/// lines, so a sibling import is stripped from the `use` keyword through its
/// terminating `;` (semicolons are mandatory). Standard-library imports
/// (`core:` / `wasi:`) are kept verbatim and flow into the generated parser
/// (none are needed today, but they are permitted).
fn gen_runtime_fragment(w: &mut CodeWriter, src: &String) {
    // Lines of an open `use ...;` statement whose siblingness is not yet known.
    let mut block: List<String> = [];
    let mut in_use = false;
    for let line of src.lines() {
        if in_use {
            block.push(line);
            if line.contains(";") {
                flush_use_block(w, &block);
                block = [];
                in_use = false;
            }
        } else if line.trim_start().starts_with("use ") {
            block.push(line);
            if line.contains(";") {
                flush_use_block(w, &block);
                block = [];
            } else {
                in_use = true;
            }
        } else {
            w.raw(&line);
            w.raw(&"\n");
        }
    }
    // A well-formed fragment never ends mid-`use`; emit any stray buffer
    // verbatim rather than silently dropping it.
    for let l of &block {
        w.raw(l);
        w.raw(&"\n");
    }
}

/// Emit a complete (possibly multi-line) `use ...;` statement unless it is a
/// sibling import (`from "./..."`), which is dropped because the symbols are
/// already inlined ahead of this fragment.
fn flush_use_block(w: &mut CodeWriter, block: &List<String>) {
    for let l of block {
        if l.contains("from \"./") {
            return;
        }
    }
    for let l of block {
        w.raw(l);
        w.raw(&"\n");
    }
}

/// Surface grammar-level options and named actions from the .g4 prequel as
/// pass-through comments in the generated output. ANTLR4 stores these on the
/// IR (`Grammar.options`, `Grammar.named_actions`) but most values have no
/// semantic effect on Gale's Wado codegen (e.g. `language`, `superClass`,
/// `tokenVocab`, or `@header` bodies whose host-language code is discarded).
/// Emitting them as a comment block keeps the information observable for
/// downstream tooling and makes the .g4 prequel round-trip visible.
fn gen_grammar_metadata(w: &mut CodeWriter, grammar: &Grammar) {
    if grammar.options.is_empty() && grammar.named_actions.is_empty() {
        return;
    }
    w.line(&"// Grammar metadata from source .g4 prequels:");
    for let opt of &grammar.options {
        w.line(&`//   option {opt.name} = {format_option_value(&opt.value)}`);
    }
    for let act of &grammar.named_actions {
        if let Some(scope) = &act.scope {
            w.line(&`//   @{*scope}::{act.name}`);
        } else {
            w.line(&`//   @{act.name}`);
        }
    }
    w.blank();
}

fn format_option_value(v: &OptionValue) -> String {
    return match *v {
        Ident(s) => s,
        Qualified(parts) => {
            let mut out = String::with_capacity(16);
            for let mut i = 0; i < parts.len(); i += 1 {
                if i > 0 {
                    out.push('.');
                }
                out.push_str(&parts[i]);
            }
            out;
        },
        Str(s) => `"{s}"`,
        Int(n) => `{n}`,
        Action(_) => "{ ... }",
    };
}


fn gen_token_kind(w: &mut CodeWriter, lexer_rules: &List<LexerRule>) {
    let mut e = EnumSpec::new("TokenKind", Vis::Pub);
    for let rule of lexer_rules {
        if !rule.is_fragment {
            if rule.is_virtual {
                e.add_member_with_comment(&rule.name, &"virtual");
            } else {
                e.add_member(&rule.name);
            }
        }
    }
    e.add_member(&"Eof");
    e.add_member(&"Error");
    e.emit(w);
    w.blank();
}
