//! A printed parse tree as a test compares it.

/// Collapse whitespace runs to single spaces and trim, so an expected tree can
/// be written indented across lines and compared with a generated parser's
/// `to_string_tree`. Whitespace inside double quotes is kept.
pub fn normalize_tree<S: AsStrSlice>(s: S) -> String {
    let mut out = String::with_capacity(s.len());
    let mut in_string = false;
    let mut space_pending = false;
    for let c of s.chars() {
        if in_string {
            out.push(c);
            if c == '"' {
                in_string = false;
            }
        } else if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            if out.len() > 0 {
                space_pending = true;
            }
        } else {
            if space_pending {
                out.push(' ');
                space_pending = false;
            }
            if c == '"' {
                in_string = true;
            }
            out.push(c);
        }
    }
    return out;
}
