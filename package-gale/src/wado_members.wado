use { MemberField, MemberDecls } from "./java2wado/jmembers.wado";

pub fn translate_wado_members(body: &String) -> Result<MemberDecls, String> {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut fields: List<MemberField> = [];
    let mut methods: List<String> = [];
    for let mut i = skip_ws_semi(&chars, 0, n); i < n; i = skip_ws_semi(&chars, i, n) {
        if is_method_start(&chars, i, n) {
            let close = capture_fn(&chars, i, n)?;
            methods.push(collect_range(&chars, i, close));
            i = close;
        } else {
            i = parse_field(&chars, i, n, &mut fields)?;
        }
    }
    return Result::Ok(MemberDecls { fields, methods });
}

fn skip_ws_semi(chars: &List<char>, start: i32, n: i32) -> i32 {
    let mut i = start;
    while i < n && (chars[i].is_ascii_whitespace() || chars[i] == ';') {
        i += 1;
    }
    return i;
}

fn skip_ws(chars: &List<char>, start: i32, n: i32) -> i32 {
    let mut i = start;
    while i < n && chars[i].is_ascii_whitespace() {
        i += 1;
    }
    return i;
}

fn is_ident_char(c: char) -> bool {
    return 'a' <= c <= 'z' || 'A' <= c <= 'Z' || '0' <= c <= '9' || c == '_';
}

fn word_at(chars: &List<char>, i: i32, n: i32, word: &String) -> bool {
    let wc: List<char> = word.chars().collect();
    if i + wc.len() > n {
        return false;
    }
    for let mut k = 0; k < wc.len(); k += 1 {
        if chars[i + k] != wc[k] {
            return false;
        }
    }
    let after = i + wc.len();
    return after >= n || !is_ident_char(chars[after]);
}

fn is_method_start(chars: &List<char>, i: i32, n: i32) -> bool {
    if word_at(chars, i, n, &"fn") {
        return true;
    }
    if word_at(chars, i, n, &"pub") {
        let j = skip_ws(chars, i + 3, n);
        return word_at(chars, j, n, &"fn");
    }
    return false;
}

fn capture_fn(chars: &List<char>, start: i32, n: i32) -> Result<i32, String> {
    let mut i = start;
    while i < n && chars[i] != '(' {
        i = skip_span(chars, i, n);
    }
    if i >= n {
        return Result::Err("gale: Wado @members: method parameter list '(' not found");
    }
    i = skip_balanced(chars, i, n, '(', ')')?;
    while i < n && chars[i] != '{' {
        i = skip_span(chars, i, n);
    }
    if i >= n {
        return Result::Err("gale: Wado @members: method body '{' not found");
    }
    return skip_balanced(chars, i, n, '{', '}');
}

fn skip_balanced(chars: &List<char>, open_idx: i32, n: i32, open: char, close: char) -> Result<i32, String> {
    let mut i = open_idx;
    let mut depth = 0;
    while i < n {
        let c = chars[i];
        if c == open {
            depth += 1;
            i += 1;
        } else if c == close {
            depth -= 1;
            i += 1;
            if depth == 0 {
                return Result::Ok(i);
            }
        } else {
            i = skip_span(chars, i, n);
        }
    }
    return Result::Err("gale: Wado @members: unterminated method definition");
}

fn parse_field(chars: &List<char>, start: i32, n: i32, fields: &mut List<MemberField>) -> Result<i32, String> {
    let mut i = skip_ws(chars, start, n);
    if word_at(chars, i, n, &"pub") {
        i = skip_ws(chars, i + 3, n);
    }
    let name_start = i;
    while i < n && is_ident_char(chars[i]) {
        i += 1;
    }
    if i == name_start {
        return Result::Err("gale: Wado @members: expected a field name");
    }
    let name = collect_range(chars, name_start, i);
    i = skip_ws(chars, i, n);
    if i >= n || chars[i] != ':' {
        return Result::Err(`gale: Wado @members: expected ':' after field '${name}'`);
    }
    i += 1;
    let ty_end = scan_to(chars, i, n, '=');
    if ty_end >= n {
        return Result::Err(`gale: Wado @members: field '${name}' needs an initializer ('= ...')`);
    }
    let ty = collect_range(chars, i, ty_end).trim();
    if ty.is_empty() {
        return Result::Err(`gale: Wado @members: field '${name}' has no type`);
    }
    let init_start = ty_end + 1;
    let init_end = scan_to(chars, init_start, n, ';');
    let init = collect_range(chars, init_start, init_end).trim();
    if init.is_empty() {
        return Result::Err(`gale: Wado @members: field '${name}' has an empty initializer`);
    }
    fields.push(MemberField { name, ty, init });
    return Result::Ok(if init_end < n { init_end + 1 } else { n });
}

fn scan_to(chars: &List<char>, start: i32, n: i32, target: char) -> i32 {
    let mut i = start;
    let mut depth = 0;
    while i < n {
        let c = chars[i];
        if c == target && depth == 0 {
            return i;
        }
        if c == '(' || c == '[' || c == '{' {
            depth += 1;
            i += 1;
        } else if c == ')' || c == ']' || c == '}' {
            if depth > 0 {
                depth -= 1;
            }
            i += 1;
        } else {
            i = skip_span(chars, i, n);
        }
    }
    return n;
}

fn skip_span(chars: &List<char>, i: i32, n: i32) -> i32 {
    let c = chars[i];
    if c == '"' || c == '\'' || c == '`' {
        return skip_quoted(chars, i, n, c);
    }
    if c == '/' && i + 1 < n && chars[i + 1] == '/' {
        let mut j = i + 2;
        while j < n && chars[j] != '\n' {
            j += 1;
        }
        return j;
    }
    if c == '/' && i + 1 < n && chars[i + 1] == '*' {
        let mut j = i + 2;
        while j + 1 < n && !(chars[j] == '*' && chars[j + 1] == '/') {
            j += 1;
        }
        return if j + 1 < n { j + 2 } else { n };
    }
    return i + 1;
}

fn skip_quoted(chars: &List<char>, open: i32, n: i32, quote: char) -> i32 {
    let mut i = open + 1;
    while i < n {
        if chars[i] == '\\' {
            i += 2;
            continue;
        }
        if chars[i] == quote {
            return i + 1;
        }
        i += 1;
    }
    return n;
}

fn collect_range(chars: &List<char>, start: i32, end: i32) -> String {
    let mut s = String::with_capacity(if end > start { end - start } else { 0 });
    for let mut i = start; i < end; i += 1 {
        s.push(chars[i]);
    }
    return s;
}
