use { MemberField, MemberMethod, MemberDecls } from "./java2wado/jmembers.wado";
use { collect_range, is_ident_char } from "./text.wado";

pub fn translate_wado_members<S: AsStrSlice>(body: S) -> Result<MemberDecls, String> {
    let chars: List<char> = body.chars().collect();
    let n = chars.len();
    let mut fields: List<MemberField> = [];
    let mut methods: List<MemberMethod> = [];
    let mut i = 0;
    loop {
        let [start, doc_start] = skip_ws_semi(&chars, i, n);
        if start >= n {
            break;
        }
        if is_method_start(&chars, start, n) {
            let spans = capture_fn(&chars, start, n)?;
            let head = method_head(&chars, start, spans.paren, n);
            methods.push(MemberMethod {
                name: head.0,
                mutates: head.1,
                returns: return_type(&chars, &spans),
                source: collect_range(&chars, doc_start, spans.end),
            });
            i = spans.end;
        } else {
            i = parse_field(&chars, start, n, &mut fields)?;
        }
    }
    return Result::Ok(MemberDecls { fields, methods });
}

/// A method's name, and whether it takes `&mut self` — the receiver a lexer
/// predicate cannot reach, since it holds `&Lexer`. A Wado member writes its own
/// receiver, so the source says which those are.
fn method_head(chars: &List<char>, start: i32, paren: i32, n: i32) -> [String, bool] {
    let mut i = skip_ws(chars, start, n);
    if word_at(chars, i, n, "pub") {
        i = skip_ws(chars, i + 3, n);
    }
    i = skip_ws(chars, i + 2, n);
    let name_start = i;
    while i < n && is_ident_char(chars[i]) {
        i += 1;
    }
    let name = collect_range(chars, name_start, i);
    let mut r = skip_ws(chars, paren + 1, n);
    if !word_at(chars, r, n, "&mut") {
        return [name, false];
    }
    r = skip_ws(chars, r + 4, n);
    return [name, word_at(chars, r, n, "self")];
}

/// Past what separates two members (whitespace, `;` and comments), and where
/// the `///` run documenting the next one starts: a method keeps its docs.
fn skip_ws_semi(chars: &List<char>, start: i32, n: i32) -> [i32, i32] {
    let mut i = start;
    let mut doc_start = -1;
    while i < n {
        if chars[i].is_ascii_whitespace() || chars[i] == ';' {
            i += 1;
        } else if chars[i] == '/' && i + 1 < n && chars[i + 1] matches { '/' | '*' } {
            if is_doc_comment(chars, i, n) {
                if doc_start < 0 {
                    doc_start = i;
                }
            } else {
                doc_start = -1;
            }
            i = skip_span(chars, i, n);
        } else {
            break;
        }
    }
    return [i, if doc_start < 0 { i } else { doc_start }];
}

/// `///` but not `////`, as Wado's own doc comments are told apart.
fn is_doc_comment(chars: &List<char>, i: i32, n: i32) -> bool {
    return i + 2 < n && chars[i + 1] == '/' && chars[i + 2] == '/' && !(i + 3 < n && chars[i + 3] == '/');
}

fn skip_ws(chars: &List<char>, start: i32, n: i32) -> i32 {
    let mut i = start;
    while i < n && chars[i].is_ascii_whitespace() {
        i += 1;
    }
    return i;
}

fn word_at<S: AsStrSlice>(chars: &List<char>, i: i32, n: i32, word: S) -> bool {
    let wc: List<char> = word.chars().collect();
    if i + wc.len() > n {
        return false;
    }
    for let mut k = 0; k < wc.len(); k += 1 {
        if chars[i + k] != wc[k] {
            return false;
        }
    }
    let after = i + wc.len();
    return after >= n || !is_ident_char(chars[after]);
}

fn is_method_start(chars: &List<char>, i: i32, n: i32) -> bool {
    if word_at(chars, i, n, "fn") {
        return true;
    }
    if word_at(chars, i, n, "pub") {
        let j = skip_ws(chars, i + 3, n);
        return word_at(chars, j, n, "fn");
    }
    return false;
}

/// Where a method's parts sit: its `(`, just past its `)`, its body's `{`,
/// and just past that body's `}`.
struct FnSpans {
    paren: i32,
    params_end: i32,
    brace: i32,
    end: i32,
}

/// The type written after `->`, empty when the method returns nothing.
fn return_type(chars: &List<char>, spans: &FnSpans) -> String {
    let head = collect_range(chars, spans.params_end, spans.brace).trim();
    return if head.starts_with("->") { head.substr_bytes(2, head.len()).trim().to_string() } else { "" };
}

fn capture_fn(chars: &List<char>, start: i32, n: i32) -> Result<FnSpans, String> {
    let mut paren = start;
    while paren < n && chars[paren] != '(' {
        paren = skip_span(chars, paren, n);
    }
    if paren >= n {
        return Result::Err("gale: Wado @members: method parameter list '(' not found");
    }
    let params_end = skip_balanced(chars, paren, n, '(', ')')?;
    let mut brace = params_end;
    while brace < n && chars[brace] != '{' {
        brace = skip_span(chars, brace, n);
    }
    if brace >= n {
        return Result::Err("gale: Wado @members: method body '{' not found");
    }
    return Result::Ok(FnSpans { paren, params_end, brace, end: skip_balanced(chars, brace, n, '{', '}')? });
}

fn skip_balanced(chars: &List<char>, open_idx: i32, n: i32, open: char, close: char) -> Result<i32, String> {
    let mut i = open_idx;
    let mut depth = 0;
    while i < n {
        let c = chars[i];
        if c == open {
            depth += 1;
            i += 1;
        } else if c == close {
            depth -= 1;
            i += 1;
            if depth == 0 {
                return Result::Ok(i);
            }
        } else {
            i = skip_span(chars, i, n);
        }
    }
    return Result::Err("gale: Wado @members: unterminated method definition");
}

fn parse_field(chars: &List<char>, start: i32, n: i32, fields: &mut List<MemberField>) -> Result<i32, String> {
    let mut i = skip_ws(chars, start, n);
    if word_at(chars, i, n, "pub") {
        i = skip_ws(chars, i + 3, n);
    }
    let name_start = i;
    while i < n && is_ident_char(chars[i]) {
        i += 1;
    }
    if i == name_start {
        return Result::Err("gale: Wado @members: expected a field name");
    }
    let name = collect_range(chars, name_start, i);
    i = skip_ws(chars, i, n);
    if i >= n || chars[i] != ':' {
        return Result::Err(`gale: Wado @members: expected ':' after field '${name}'`);
    }
    i += 1;
    let ty_end = scan_to(chars, i, n, '=');
    if ty_end >= n {
        return Result::Err(`gale: Wado @members: field '${name}' needs an initializer ('= ...')`);
    }
    let ty = collect_range(chars, i, ty_end).trim();
    if ty.is_empty() {
        return Result::Err(`gale: Wado @members: field '${name}' has no type`);
    }
    let init_start = ty_end + 1;
    let init_end = scan_to(chars, init_start, n, ';');
    let init = collect_range(chars, init_start, init_end).trim();
    if init.is_empty() {
        return Result::Err(`gale: Wado @members: field '${name}' has an empty initializer`);
    }
    fields.push(MemberField {
        name,
        ty: ty.to_string(),
        init: init.to_string(),
    });
    return Result::Ok(if init_end < n { init_end + 1 } else { n });
}

fn scan_to(chars: &List<char>, start: i32, n: i32, target: char) -> i32 {
    let mut i = start;
    let mut depth = 0;
    while i < n {
        let c = chars[i];
        if c == target && depth == 0 {
            return i;
        }
        if c == '(' || c == '[' || c == '{' {
            depth += 1;
            i += 1;
        } else if c == ')' || c == ']' || c == '}' {
            if depth > 0 {
                depth -= 1;
            }
            i += 1;
        } else {
            i = skip_span(chars, i, n);
        }
    }
    return n;
}

fn skip_span(chars: &List<char>, i: i32, n: i32) -> i32 {
    let c = chars[i];
    if c == '"' || c == '\'' || c == '`' {
        return skip_quoted(chars, i, n, c);
    }
    if c == '/' && i + 1 < n && chars[i + 1] == '/' {
        let mut j = i + 2;
        while j < n && chars[j] != '\n' {
            j += 1;
        }
        return j;
    }
    if c == '/' && i + 1 < n && chars[i + 1] == '*' {
        let mut j = i + 2;
        while j + 1 < n && !(chars[j] == '*' && chars[j + 1] == '/') {
            j += 1;
        }
        return if j + 1 < n { j + 2 } else { n };
    }
    return i + 1;
}

fn skip_quoted(chars: &List<char>, open: i32, n: i32, quote: char) -> i32 {
    let mut i = open + 1;
    while i < n {
        if chars[i] == '\\' {
            i += 2;
            continue;
        }
        if chars[i] == quote {
            return i + 1;
        }
        i += 1;
    }
    return n;
}
