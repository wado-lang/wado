fn first_contains(first: &Array<String>, token: &String) -> bool {
    for let item of first {
        if *item == *token {
            return true;
        }
    }
    return false;
}

fn dedup_append_arr(arr: &mut Array<String>, source: &Array<String>) {
    for let tk of source {
        if !first_contains(arr, tk) {
            arr.push(*tk);
        }
    }
}

// --- Prediction Engine ---

variant PredictionNode {
    Leaf(i32),
    Dispatch(PredictionDispatch),
    Consume(ConsumeNode),
    Ambiguous(Array<i32>),
}

struct ConsumeNode {
    element: Element,
    child: PredictionNode,
}

struct PredictionDispatch {
    depth: i32,
    branches: Array<PredictionBranch>,
}

struct PredictionBranch {
    tokens: Array<String>,
    child: PredictionNode,
}

/// Return the index of an existing branch whose child equals `child`, or -1
/// when no branch matches. Callers use this to fold a new (token, child) entry
/// into an existing branch instead of creating a duplicate.
fn find_merge_branch(branches: &Array<PredictionBranch>, child: &PredictionNode) -> i32 {
    for let mut b = 0; b < branches.len(); b += 1 {
        if prediction_node_eq(&branches[b].child, child) {
            return b;
        }
    }
    return -1;
}

fn build_prediction(alt_indices: &Array<i32>, first_sets: &Array<Array<String>>, alt_elements: &Array<Array<Element>>, depth: i32, max_depth: i32, ctx: &mut GenContext) -> PredictionNode {
    // Build initial SLL configs: one per alternative, at element position 0.
    let mut configs: Array<SllConfig> = [];
    for let mut i = 0; i < alt_indices.len(); i += 1 {
        configs.push(SllConfig {
            alt_index: alt_indices[i],
            elements: alt_elements[i],
            pos: 0,
            return_stack: [],
        });
    }
    let tree = build_sll_node(&configs, 0, max_depth, ctx);
    return strip_dead_consume(tree);
}

/// Strip Consume nodes whose child contains any Ambiguous — fall back to
/// Ambiguous from the original position rather than consuming then failing.
/// This handles both direct Consume → Ambiguous and indirect cases like
/// Consume → Dispatch → (Branch → Ambiguous).
fn strip_dead_consume(node: PredictionNode) -> PredictionNode {
    return match node {
        Consume(c) => {
            let child = strip_dead_consume(c.child);
            if prediction_contains_ambiguous(&child) {
                let mut indices: Array<i32> = [];
                prediction_collect_all_indices(&child, &mut indices);
                PredictionNode::Ambiguous(indices);
            } else {
                PredictionNode::Consume(ConsumeNode { element: c.element, child });
            }
        },
        Dispatch(d) => {
            let mut new_branches: Array<PredictionBranch> = [];
            for let b of d.branches {
                new_branches.push(PredictionBranch {
                    tokens: b.tokens,
                    child: strip_dead_consume(b.child),
                });
            }
            PredictionNode::Dispatch(PredictionDispatch { depth: d.depth, branches: new_branches });
        },
        _ => node,
    };
}

fn prediction_contains_ambiguous(node: &PredictionNode) -> bool {
    return match *node {
        Ambiguous(_) => true,
        Consume(c) => prediction_contains_ambiguous(&c.child),
        Dispatch(d) => {
            for let b of &d.branches {
                if prediction_contains_ambiguous(&b.child) {
                    return true;
                }
            }
            return false;
        },
        Leaf(_) => false,
    };
}

fn prediction_collect_all_indices(node: &PredictionNode, out: &mut Array<i32>) {
    match *node {
        Ambiguous(indices) => {
            for let i of &indices {
                if !out.iter().any(|x: i32| x == *i) {
                    out.push(*i);
                }
            }
        },
        Leaf(idx) => {
            if !out.iter().any(|x: i32| x == idx) {
                out.push(idx);
            }
        },
        Consume(c) => prediction_collect_all_indices(&c.child, out),
        Dispatch(d) => {
            for let b of &d.branches {
                prediction_collect_all_indices(&b.child, out);
            }
        },
    }
}


struct SllReturn {
    elements: Array<Element>,
    pos: i32,
}

struct SllConfig {
    alt_index: i32,
    elements: Array<Element>,
    pos: i32,
    return_stack: Array<SllReturn>,
}

fn sll_config_clone(c: &SllConfig) -> SllConfig {
    return SllConfig {
        alt_index: c.alt_index,
        elements: c.elements,
        pos: c.pos,
        return_stack: c.return_stack,
    };
}

fn push_return(stack: &Array<SllReturn>, elements: Array<Element>, pos: i32) -> Array<SllReturn> {
    let mut new_stack: Array<SllReturn> = [];
    for let s of stack {
        new_stack.push(*s);
    }
    new_stack.push(SllReturn { elements, pos });
    return new_stack;
}

fn pop_return(c: &SllConfig) -> SllConfig {
    let last_idx = c.return_stack.len() - 1;
    let ret = &c.return_stack[last_idx];
    let mut new_stack: Array<SllReturn> = [];
    for let mut i = 0; i < last_idx; i += 1 {
        new_stack.push(c.return_stack[i]);
    }
    return SllConfig {
        alt_index: c.alt_index,
        elements: ret.elements,
        pos: ret.pos,
        return_stack: new_stack,
    };
}


/// Identity closure — nullable handling is done in sll_config_first
/// (first_of_elements_from) and sll_advance (explicit skip logic).
fn sll_closure(configs: &Array<SllConfig>) -> Array<SllConfig> {
    return *configs;
}

/// True when the config has fully consumed its elements and has no return
/// frame to pop into — i.e. the alt's body is finished and any further token
/// belongs to the calling context. Opaque configs (`pos < 0`) are not at-end.
///
/// The check walks `return_stack` from the most-recently-pushed frame back
/// to the oldest, mirroring what a sequence of `pop_return` calls would
/// expose. Walking by index keeps this O(n); the previous recursive
/// implementation was O(n^2) because each `pop_return` rebuilt the entire
/// surviving prefix of `return_stack` into a fresh `Array`.
fn config_is_at_end(c: &SllConfig) -> bool {
    if c.pos < 0 {
        return false;
    }
    if c.pos < c.elements.len() {
        return false;
    }
    let mut i = c.return_stack.len();
    while i > 0 {
        i -= 1;
        let frame = &c.return_stack[i];
        if frame.pos < frame.elements.len() {
            return false;
        }
    }
    return true;
}


/// Compute FIRST set of the current position in a config.
/// Includes tokens from nullable elements that were skipped by closure.
/// When at end of elements with a return stack, pops and continues from caller.
fn sll_config_first(c: &SllConfig, ctx: &mut GenContext) -> Array<String> {
    if c.pos < 0 {
        return [];
    }
    if c.pos >= c.elements.len() {
        if c.return_stack.is_empty() {
            return [];
        }
        let popped = pop_return(c);
        return sll_config_first(&popped, ctx);
    }
    return ctx.first_of_elements_from(&c.elements, c.pos);
}

/// Advance a config by one token. For terminals, advance pos.
/// For RuleRef, expand into the rule's alternatives (entering the rule).
fn sll_advance(c: &SllConfig, token: &String, ctx: &mut GenContext, inline_depth: i32 = 0) -> Array<SllConfig> {
    // Limit inline expansion depth to prevent explosion from recursive rules.
    if inline_depth > 2 {
        return [];
    }
    if c.pos < 0 {
        return [];
    }
    // End of current elements: pop return stack if available.
    if c.pos >= c.elements.len() {
        if c.return_stack.is_empty() {
            return [];
        }
        let popped = pop_return(c);
        return sll_advance(&popped, token, ctx, inline_depth);
    }
    let elem = &c.elements[c.pos];

    // Nullable element (Optional, Star): either match its inner or skip it.
    if is_nullable(elem) {
        let mut results: Array<SllConfig> = [];
        let mut visiting: Array<String> = [];
        if first_contains(&ctx.first_of_element(elem, &mut visiting), token) {
            // Check if the inner element is a multi-token RuleRef.
            // If so, enter it via return stack instead of skipping to pos+1.
            let mut entered = false;
            if let Repeat(rep) = elem {
                if let RuleRef(rr) = rep.element {
                    let mut stv: Array<String> = [];
                    if !ctx.rule_is_single_token(&rr.name, &mut stv) && c.return_stack.len() < 1 {
                        let inner_rule = ctx.find_rule(&rr.name);
                        let inner_alt_count = if let Some(r) = inner_rule {
                            r.alternatives.len();
                        } else {
                            0;
                        };
                        if inner_alt_count <= 8 {
                            entered = true;
                            let new_stack = push_return(&c.return_stack, c.elements, c.pos + 1);
                            if let Some(inner_rule) = inner_rule {
                                for let alt of inner_rule.alternatives {
                                    let mut v2: Array<String> = [];
                                    if !first_contains(&ctx.first_of_alt(&alt, &mut v2), token) {
                                        continue;
                                    }
                                    let exp = SllConfig {
                                        alt_index: c.alt_index,
                                        elements: alt.elements,
                                        pos: 0,
                                        return_stack: new_stack,
                                    };
                                    let advanced = sll_advance(&exp, token, ctx, inline_depth + 1);
                                    for let a of advanced {
                                        results.push(a);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if !entered {
                results.push(SllConfig {
                    alt_index: c.alt_index,
                    elements: c.elements,
                    pos: c.pos + 1,
                    return_stack: c.return_stack,
                });
            }
        }
        // Also try skipping: advance past all consecutive nullables non-recursively.
        let mut skip_pos = c.pos + 1;
        while skip_pos < c.elements.len() && is_nullable(&c.elements[skip_pos]) {
            let mut v: Array<String> = [];
            if first_contains(&ctx.first_of_element(&c.elements[skip_pos], &mut v), token) {
                results.push(SllConfig {
                    alt_index: c.alt_index,
                    elements: c.elements,
                    pos: skip_pos + 1,
                    return_stack: c.return_stack,
                });
            }
            skip_pos += 1;
        }
        if skip_pos < c.elements.len() {
            let skipped_elem = &c.elements[skip_pos];
            if let TokenRef(t) = skipped_elem {
                if `TK_{t.name}` == *token {
                    results.push(SllConfig {
                        alt_index: c.alt_index,
                        elements: c.elements,
                        pos: skip_pos + 1,
                        return_stack: c.return_stack,
                    });
                }
            } else if let Literal(l) = skipped_elem {
                if literal_const_name(&l.text) == *token {
                    results.push(SllConfig {
                        alt_index: c.alt_index,
                        elements: c.elements,
                        pos: skip_pos + 1,
                        return_stack: c.return_stack,
                    });
                }
            } else if let RuleRef(r) = skipped_elem {
                let mut v: Array<String> = [];
                if first_contains(&ctx.first_of_rule(&r.name, &mut v), token) {
                    let mut stv: Array<String> = [];
                    if ctx.rule_is_single_token(&r.name, &mut stv) {
                        results.push(SllConfig {
                            alt_index: c.alt_index,
                            elements: c.elements,
                            pos: skip_pos + 1,
                            return_stack: c.return_stack,
                        });
                    } else {
                        results.push(SllConfig {
                            alt_index: c.alt_index,
                            elements: c.elements,
                            pos: -1,
                            return_stack: c.return_stack,
                        });
                    }
                }
            } else {
                let mut v: Array<String> = [];
                if first_contains(&ctx.first_of_element(skipped_elem, &mut v), token) {
                    results.push(SllConfig {
                        alt_index: c.alt_index,
                        elements: c.elements,
                        pos: skip_pos + 1,
                        return_stack: c.return_stack,
                    });
                }
            }
        }
        return results;
    }

    // Terminal: if token matches, advance past this element.
    if let TokenRef(t) = elem {
        if `TK_{t.name}` == *token {
            return [SllConfig {
                    alt_index: c.alt_index,
                    elements: c.elements,
                    pos: c.pos + 1,
                    return_stack: c.return_stack,
                }];
        }
        return [];
    }
    if let Literal(l) = elem {
        if literal_const_name(&l.text) == *token {
            return [SllConfig {
                    alt_index: c.alt_index,
                    elements: c.elements,
                    pos: c.pos + 1,
                    return_stack: c.return_stack,
                }];
        }
        return [];
    }

    // RuleRef: advance past only if the rule always consumes exactly one token.
    // Multi-token rules return opaque (pos=-1); expansion happens in build_sll_node
    // only when needed to resolve ambiguity.
    if let RuleRef(r) = elem {
        let mut visiting: Array<String> = [];
        let rule_first = ctx.first_of_rule(&r.name, &mut visiting);
        if !first_contains(&rule_first, token) {
            return [];
        }
        let mut st_visiting: Array<String> = [];
        if ctx.rule_is_single_token(&r.name, &mut st_visiting) {
            // Single-token rule: safe to advance, element position == token position.
            return [SllConfig {
                    alt_index: c.alt_index,
                    elements: c.elements,
                    pos: c.pos + 1,
                    return_stack: c.return_stack,
                }];
        }
        // Multi-token rule: token matches FIRST but we can't advance past it.
        // Return config with pos = -1 as a sentinel meaning "opaque match".
        return [SllConfig { alt_index: c.alt_index, elements: c.elements, pos: -1, return_stack: c.return_stack }];
    }

    // Group: treat as consuming one token if the token is in FIRST(group).
    if let Group(g) = elem {
        let mut group_first = TreeSet::<String>::new();
        for let alt of g.alternatives {
            let mut visiting: Array<String> = [];
            let af = ctx.first_of_alt(alt, &mut visiting);
            str_set_insert_all(&mut group_first, &af);
        }
        if group_first.contains(*token) {
            return [SllConfig {
                    alt_index: c.alt_index,
                    elements: c.elements,
                    pos: c.pos + 1,
                    return_stack: c.return_stack,
                }];
        }
        return [];
    }

    // Repeat: treat as consuming the inner element.
    if let Repeat(rep) = elem {
        let mut inner_first: Array<String> = [];
        let mut visiting: Array<String> = [];
        inner_first = ctx.first_of_element(&rep.element, &mut visiting);
        if first_contains(&inner_first, token) {
            // Advance past the repeat element (simplified: treat as consuming 1 token).
            return [SllConfig {
                    alt_index: c.alt_index,
                    elements: c.elements,
                    pos: c.pos + 1,
                    return_stack: c.return_stack,
                }];
        }
        return [];
    }

    // Label: unwrap.
    if let Label(lab) = elem {
        let unwrapped = SllConfig {
            alt_index: c.alt_index,
            elements: replace_element_at(&c.elements, c.pos, &lab.element),
            pos: c.pos,
            return_stack: c.return_stack,
        };
        return sll_advance(&unwrapped, token, ctx, inline_depth);
    }

    return [];
}

fn replace_element_at(elements: &Array<Element>, pos: i32, replacement: &Element) -> Array<Element> {
    let mut result: Array<Element> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if i == pos {
            result.push(*replacement);
        } else {
            result.push(elements[i]);
        }
    }
    return result;
}

/// Collect unique alt indices from configs.
fn sll_unique_alts(configs: &Array<SllConfig>) -> Array<i32> {
    let mut alts: Array<i32> = [];
    for let c of configs {
        if !array_contains_i32(&alts, c.alt_index) {
            alts.push(c.alt_index);
        }
    }
    return alts;
}

/// Deduplicate configs: merge configs with the same (alt_index) that reach
/// the same prediction outcome. For SLL, two configs with the same alt_index
/// are equivalent for prediction purposes.
fn sll_dedup_by_alt(configs: &Array<SllConfig>) -> Array<SllConfig> {
    let mut seen_alts: Array<i32> = [];
    let mut result: Array<SllConfig> = [];
    for let c of configs {
        if !array_contains_i32(&seen_alts, c.alt_index) {
            seen_alts.push(c.alt_index);
            result.push(sll_config_clone(c));
        }
    }
    return result;
}

fn build_sll_node(configs: &Array<SllConfig>, depth: i32, max_depth: i32, ctx: &mut GenContext) -> PredictionNode {
    let closed = sll_closure(configs);

    // Guard: if too many configs, fall back to Ambiguous (codegen scan-dispatches) to avoid explosion.
    if closed.len() > 200 {
        let alts = sll_unique_alts(&closed);
        return PredictionNode::Ambiguous(alts);
    }

    // Check unique alternatives.
    let alts = sll_unique_alts(&closed);
    if alts.len() == 1 {
        return PredictionNode::Leaf(alts[0]);
    }
    if alts.len() == 0 || depth >= max_depth {
        return PredictionNode::Ambiguous(alts);
    }

    // Check for common prefix: if all configs are at a terminal element
    // that is the same across all configs, emit Consume.
    let common = sll_find_common_terminal(&closed);
    if let Some(elem) = common {
        // Advance all configs past this shared terminal.
        let mut advanced: Array<SllConfig> = [];
        for let c of closed {
            advanced.push(SllConfig {
                alt_index: c.alt_index,
                elements: c.elements,
                pos: c.pos + 1,
                return_stack: c.return_stack,
            });
        }
        let child = build_sll_node(&advanced, depth, max_depth, ctx);
        return PredictionNode::Consume(ConsumeNode { element: elem, child });
    }

    // Compute FIRST set for each config.
    let mut all_tokens: Array<String> = [];
    let mut all_tokens_seen = TreeSet::<String>::new();
    let mut config_firsts: Array<Array<String>> = [];
    let mut config_first_sets: Array<TreeSet<String>> = [];
    for let c of closed {
        let first = sll_config_first(&c, ctx);
        config_first_sets.push(str_set_from(&first));
        config_firsts.push(first);
        for let tk of first {
            if !all_tokens_seen.contains(tk) {
                all_tokens_seen.insert(tk);
                all_tokens.push(tk);
            }
        }
    }

    // Build dispatch branches.
    let mut branches: Array<PredictionBranch> = [];

    for let mut t = 0; t < all_tokens.len(); t += 1 {
        let tk = &all_tokens[t];

        // Advance all configs that can match this token.
        let mut next_configs: Array<SllConfig> = [];
        let mut opaque_alts: Array<i32> = [];
        for let mut i = 0; i < closed.len(); i += 1 {
            if config_first_sets[i].contains(*tk) {
                let advanced = sll_advance(&closed[i], tk, ctx);
                for let a of advanced {
                    if a.pos == -1 {
                        // Opaque config: multi-token RuleRef, can't advance past.
                        if !array_contains_i32(&opaque_alts, a.alt_index) {
                            opaque_alts.push(a.alt_index);
                        }
                    } else {
                        next_configs.push(a);
                    }
                }
            }
        }

        if next_configs.len() == 0 && opaque_alts.len() == 0 {
            continue;
        }

        // Dedup: keep one config per alt (SLL ignores context).
        let deduped = sll_dedup_by_alt(&next_configs);
        let mut next_alts = sll_unique_alts(&deduped);
        // Add opaque alts (they survive regardless of further lookahead).
        for let oa of opaque_alts {
            if !array_contains_i32(&next_alts, oa) {
                next_alts.push(oa);
            }
        }

        let child = if next_alts.len() == 1 {
            // Resolved: this token uniquely identifies one alternative.
            PredictionNode::Leaf(next_alts[0]);
        } else if opaque_alts.len() > 0 {
            // Still ambiguous with opaque alts: try expansion before giving up.
            let expanded = try_expand_opaque(&closed, tk, &next_configs, opaque_alts, depth + 1, max_depth, ctx);
            if let Some(node) = expanded {
                node;
            } else {
                PredictionNode::Ambiguous(next_alts);
            }
        } else {
            // Still ambiguous: recurse with deeper lookahead.
            build_sll_node(&deduped, depth + 1, max_depth, ctx);
        };
        let idx = find_merge_branch(&branches, &child);
        if idx >= 0 {
            branches[idx].tokens.push(*tk);
        } else {
            branches.push(PredictionBranch { tokens: [*tk], child });
        }
    }

    // Detect at-end configs: their alts are fully consumed at this depth and
    // would simply return to the caller. They have empty FIRST sets, so the
    // per-token loop above silently dropped them — that left the dispatcher
    // missing a "default" path for tokens belonging to the calling context.
    //
    // Two cases:
    //  * No explicit branches but exactly one at-end alt → that alt is the
    //    only valid match at this point. Return Leaf so the caller commits.
    //  * Both explicit branches and at-end alts → ambiguous in general.
    //    A token-dispatch on the explicit branch is unsafe because the
    //    branch can fail at parse time (e.g. typespec `ID '[' ']'` matches
    //    the lookahead `[` but the body `[ ]` won't match `[ <e> ]`),
    //    leaving the at-end alt as the only correct choice. Fall back to
    //    Ambiguous so the codegen's longest-match scan dispatch picks the
    //    alt whose body actually parses (cf. ANTLR4's adaptive prediction).
    //  * Multiple at-end alts → true ambiguity → Ambiguous.
    let mut at_end_alts: Array<i32> = [];
    for let c of &closed {
        if config_is_at_end(c) && !array_contains_i32(&at_end_alts, c.alt_index) {
            at_end_alts.push(c.alt_index);
        }
    }

    if at_end_alts.len() >= 1 && branches.len() >= 1 {
        return PredictionNode::Ambiguous(alts);
    }

    if branches.len() == 0 {
        if at_end_alts.len() == 1 {
            return PredictionNode::Leaf(at_end_alts[0]);
        }
        return PredictionNode::Ambiguous(alts);
    }
    return PredictionNode::Dispatch(PredictionDispatch { depth, branches });
}

/// Try to resolve opaque configs by expanding their multi-token RuleRefs.
/// Uses ATN-style expansion: enter referenced rules, advance by one token,
/// then compute FIRST sets at the decision point's lookahead level.
/// Builds a flat Dispatch — never calls build_sll_node on expanded configs.
fn try_expand_opaque(original_configs: &Array<SllConfig>, token: &String, non_opaque_configs: &Array<SllConfig>, opaque_alts: Array<i32>, depth: i32, max_depth: i32, ctx: &mut GenContext) -> Option<PredictionNode> {
    if depth >= max_depth {
        return null;
    }
    // Rule diversity check: only expand when opaque configs reference different rules.
    let mut rule_refs = TreeSet::<String>::new();
    for let c of original_configs {
        if !array_contains_i32(&opaque_alts, c.alt_index) {
            continue;
        }
        if c.pos < 0 || c.pos >= c.elements.len() {
            continue;
        }
        if let RuleRef(r) = c.elements[c.pos] {
            rule_refs.insert(r.name);
        }
    }
    if rule_refs.len() <= 1 {
        return null;
    }
    // Expand opaque configs by entering their RuleRefs and advancing by token.
    let mut expanded_configs: Array<SllConfig> = [];
    for let c of original_configs {
        if !array_contains_i32(&opaque_alts, c.alt_index) {
            continue;
        }
        if c.pos < 0 || c.pos >= c.elements.len() {
            continue;
        }
        if let RuleRef(r) = c.elements[c.pos] {
            let found_rule = ctx.find_rule(&r.name);
            if let Some(found_rule) = found_rule {
                if found_rule.alternatives.len() > 8 {
                    continue;
                }
                let new_stack = push_return(&c.return_stack, c.elements, c.pos + 1);
                for let alt of found_rule.alternatives {
                    // Pre-filter: skip alternatives whose FIRST doesn't contain the token.
                    let mut v: Array<String> = [];
                    if !first_contains(&ctx.first_of_alt(&alt, &mut v), token) {
                        continue;
                    }
                    let exp = SllConfig {
                        alt_index: c.alt_index,
                        elements: alt.elements,
                        pos: 0,
                        return_stack: new_stack,
                    };
                    let advanced = sll_advance(&exp, token, ctx);
                    for let a of advanced {
                        if a.pos != -1 {
                            expanded_configs.push(a);
                        }
                    }
                }
            }
        }
    }
    if expanded_configs.is_empty() {
        return null;
    }
    // Combine non-opaque (already advanced) with expanded configs.
    // All configs have consumed the same number of input tokens (depth),
    // so their FIRST sets are all at the same lookahead level (depth).
    let mut all_configs: Array<SllConfig> = [];
    for let c of non_opaque_configs {
        all_configs.push(sll_config_clone(c));
    }
    for let ec of expanded_configs {
        all_configs.push(ec);
    }
    // Compute FIRST for each config at the decision point level.
    let mut all_tokens: Array<String> = [];
    let mut all_tokens_seen = TreeSet::<String>::new();
    let mut config_first_sets: Array<TreeSet<String>> = [];
    for let c of all_configs {
        let first = sll_config_first(&c, ctx);
        let first_set = str_set_from(&first);
        config_first_sets.push(first_set);
        for let tk of first {
            if !all_tokens_seen.contains(tk) {
                all_tokens_seen.insert(tk);
                all_tokens.push(tk);
            }
        }
    }
    // Build flat Dispatch: for each token, find which alt_indices match.
    let mut branches: Array<PredictionBranch> = [];
    let mut has_improvement = false;
    for let mut t = 0; t < all_tokens.len(); t += 1 {
        let tk = &all_tokens[t];
        let mut token_alts: Array<i32> = [];
        for let mut i = 0; i < all_configs.len(); i += 1 {
            if config_first_sets[i].contains(*tk) {
                if !array_contains_i32(&token_alts, all_configs[i].alt_index) {
                    token_alts.push(all_configs[i].alt_index);
                }
            }
        }
        let child = if token_alts.len() == 1 {
            has_improvement = true;
            PredictionNode::Leaf(token_alts[0]);
        } else {
            PredictionNode::Ambiguous(token_alts.sorted());
        };
        let idx = find_merge_branch(&branches, &child);
        if idx >= 0 {
            branches[idx].tokens.push(*tk);
        } else {
            branches.push(PredictionBranch { tokens: [*tk], child });
        }
    }
    if !has_improvement || branches.is_empty() {
        return null;
    }
    // Only use if ALL branches are Leaf — any Ambiguous branch means expansion
    // didn't fully resolve, and the code generator's Dispatch has no fallback
    // for unmatched tokens, which would silently drop valid inputs.
    for let b of branches {
        if let Ambiguous(_) = b.child {
            return null;
        }
    }
    // Safety: verify all original opaque alts appear in at least one branch.
    let mut covered_alts: Array<i32> = [];
    for let b of branches {
        if let Leaf(idx) = b.child {
            if !array_contains_i32(&covered_alts, idx) {
                covered_alts.push(idx);
            }
        }
    }
    for let oa of opaque_alts {
        if !array_contains_i32(&covered_alts, oa) {
            return null;
        }
    }
    return Option::<PredictionNode>::Some(PredictionNode::Dispatch(PredictionDispatch { depth, branches }));
}


/// Check if all configs are at the same terminal element (for Consume).
fn sll_find_common_terminal(configs: &Array<SllConfig>) -> Option<Element> {
    if configs.len() < 2 {
        return null;
    }
    for let c of configs {
        if c.pos >= c.elements.len() {
            return null;
        }
    }
    let first_elem = &configs[0].elements[configs[0].pos];
    if let TokenRef(t) = first_elem {
        for let mut i = 1; i < configs.len(); i += 1 {
            let elem = &configs[i].elements[configs[i].pos];
            if let TokenRef(other) = elem {
                if other.name != t.name {
                    return null;
                }
            } else {
                return null;
            }
        }
        return Option::<Element>::Some(*first_elem);
    }
    if let Literal(l) = first_elem {
        for let mut i = 1; i < configs.len(); i += 1 {
            let elem = &configs[i].elements[configs[i].pos];
            if let Literal(other) = elem {
                if other.text != l.text {
                    return null;
                }
            } else {
                return null;
            }
        }
        return Option::<Element>::Some(*first_elem);
    }
    return null;
}

/// Check if all alternatives start with the same element (TokenRef, Literal, or RuleRef).
fn find_common_prefix_element(alt_elements: &Array<Array<Element>>) -> Option<Element> {
    if alt_elements.len() < 2 {
        return null;
    }
    // All alternatives must be non-empty.
    for let elems of alt_elements {
        if elems.len() == 0 {
            return null;
        }
    }
    let first_elem = &alt_elements[0][0];
    if let TokenRef(t) = first_elem {
        for let mut i = 1; i < alt_elements.len(); i += 1 {
            if let TokenRef(other) = alt_elements[i][0] {
                if other.name != t.name {
                    return null;
                }
            } else {
                return null;
            }
        }
        return Option::<Element>::Some(*first_elem);
    }
    if let Literal(l) = first_elem {
        for let mut i = 1; i < alt_elements.len(); i += 1 {
            if let Literal(other) = alt_elements[i][0] {
                if other.text != l.text {
                    return null;
                }
            } else {
                return null;
            }
        }
        return Option::<Element>::Some(*first_elem);
    }
    if let RuleRef(r) = first_elem {
        for let mut i = 1; i < alt_elements.len(); i += 1 {
            if let RuleRef(other) = alt_elements[i][0] {
                if other.name != r.name {
                    return null;
                }
            } else {
                return null;
            }
        }
        return Option::<Element>::Some(*first_elem);
    }
    return null;
}

/// Return elements from index `start` onward.
fn elements_suffix(elements: &Array<Element>, start: i32) -> Array<Element> {
    let mut result: Array<Element> = [];
    for let mut i = start; i < elements.len(); i += 1 {
        result.push(elements[i]);
    }
    return result;
}

/// Compute first set of a sequence of elements.
fn first_of_elements(elements: &Array<Element>, ctx: &mut GenContext, visiting: &mut Array<String>) -> Array<String> {
    let mut result: Array<String> = [];
    let mut seen = TreeSet::<String>::new();
    for let elem of elements {
        let ef = ctx.first_of_element(elem, visiting);
        for let tk of ef {
            if !seen.contains(tk) {
                seen.insert(tk);
                result.push(tk);
            }
        }
        if !is_nullable(elem) {
            break;
        }
    }
    return result;
}

fn prediction_node_eq(a: &PredictionNode, b: &PredictionNode) -> bool {
    return match [*a, *b] {
        [Leaf(ai), Leaf(bi)] => ai == bi,
        [Ambiguous(aa), Ambiguous(ba)] => {
            if aa.len() != ba.len() {
                return false;
            }
            for let mut i = 0; i < aa.len(); i += 1 {
                if aa[i] != ba[i] {
                    return false;
                }
            }
            true;
        },
        // Consume nodes: check same element kind and recurse on child.
        [Consume(ca), Consume(cb)] => element_eq(&ca.element, &cb.element) && prediction_node_eq(&ca.child, &cb.child),
        _ => false,
    };
}

fn element_eq(a: &Element, b: &Element) -> bool {
    return match [*a, *b] {
        [TokenRef(na), TokenRef(nb)] => na.name == nb.name,
        [Literal(ta), Literal(tb)] => ta.text == tb.text,
        _ => false,
    };
}

fn compute_deeper_first(elements: &Array<Element>, depth: i32, ctx: &mut GenContext) -> Array<String> {
    let mut pos = 0;
    let mut remaining = depth;
    while pos < elements.len() && remaining > 0 {
        let elem = &elements[pos];
        if let TokenRef(_) | Literal(_) = elem {
            remaining -= 1;
            pos += 1;
            continue;
        }
        if is_nullable(elem) {
            pos += 1;
            continue;
        }
        // SLL advancement: single-token RuleRef consumes exactly 1 token,
        // so we can safely advance past it and look at the next element.
        if let RuleRef(r) = elem {
            let mut visiting: Array<String> = [];
            if ctx.rule_is_single_token(&r.name, &mut visiting) {
                remaining -= 1;
                pos += 1;
                continue;
            }
        }
        return [];
    }
    return ctx.first_of_elements_from(elements, pos);
}

fn array_contains_i32(arr: &Array<i32>, val: i32) -> bool {
    for let mut i = 0; i < arr.len(); i += 1 {
        if arr[i] == val {
            return true;
        }
    }
    return false;
}

pub fn gen_parser(w: &mut CodeWriter, grammar: &Grammar, lowered: &LoweredGrammar, ctx: &mut GenContext) {
    // Phase 3 — `lowered` mirrors `grammar.parser_rules` rule-for-rule
    // by name and order. emit still consumes surface IR for the body
    // of each rule (Phase 4 migrates those entry points); the
    // `LoweredGrammar` is threaded through so we can dispatch on
    // `Rule::Simple` / `MultiAlt` / `LeftRecursive` instead of
    // recomputing the classification at every emit site.
    gen_parser_struct(w);
    gen_scan_functions(w, grammar, ctx);
    for let mut i = 0; i < grammar.parser_rules.len(); i += 1 {
        let rule = &grammar.parser_rules[i];
        let lowered_rule = &lowered.parser_rules[i];
        gen_parse_fn(w, rule, lowered_rule, ctx);
    }
    // Phase 4 — variant emission consumes `lowered.variant_rules`
    // as its primary source. Every entry registered in the follow-
    // variant registry by emit-time `intern_follow_variant` calls
    // must already exist in `lowered.variant_rules` at the same
    // index: lower's pre-pass uses `ctx.compute_call_site_follow`,
    // the same single-source-of-truth helper emit consults, so the
    // two halves agree on every (rule, mask) tuple they intern. The
    // assertion below catches any future drift early — a stray
    // emit-time intern call that lower didn't run would otherwise
    // leak a dangling `__follow_<id>` function reference into the
    // generated source.
    let mut emitted_count = 0;
    loop {
        let entries = ctx.follow_variants();
        let cur = entries.len();
        if cur == emitted_count {
            break;
        }
        for let mut idx = emitted_count; idx < cur; idx += 1 {
            if idx >= lowered.variant_rules.len() {
                let entry = &entries[idx];
                panic(
                    `gen_parser: follow-variant entry #{idx} ({entry.rule_name} mask=[{join_kinds(&entry.mask)}]) was registered during emit but not by lower's pre-pass — lower and emit must agree via compute_call_site_follow`,
                );
            }
            emit_follow_variant_from_gir(w, &lowered.variant_rules[idx], ctx);
        }
        emitted_count = cur;
    }
    gen_parse_entry(w, lowered);
}

fn join_kinds(kinds: &Array<String>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < kinds.len(); i += 1 {
        if i > 0 {
            result.push_str(", ");
        }
        result.push_str(kinds[i]);
    }
    return result;
}

/// Emit one follow-aware rule variant from its lowered `Rule`. The
/// variant's `FollowVariant` lives on `header.variant_of` (attached
/// by `lower::attach_variant_header`); we extract it, look the base
/// surface `ParserRule` up by name, and call the same emit core used
/// for the regular rule body. ctx state is saved / restored across
/// the call so subsequent variants and the trailing
/// `gen_parse_entry` see clean state.
fn emit_follow_variant_from_gir(w: &mut CodeWriter, variant_rule: &Rule, ctx: &mut GenContext) {
    let entry_opt = match *variant_rule {
        Simple(s) => s.header.variant_of,
        MultiAlt(m) => m.header.variant_of,
        LeftRecursive(l) => l.header.variant_of,
    };
    let entry = if let Some(v) = entry_opt {
        v;
    } else {
        panic(
            "emit_follow_variant_from_gir: variant_rule.header.variant_of is null; lower must tag every variant body",
        );
    };
    let rule = if let Some(r) = ctx.find_rule(&entry.rule_name) {
        r;
    } else {
        panic(
            `emit_follow_variant_from_gir: rule '{entry.rule_name}' not found`,
        );
    };

    let saved_rule_name = ctx.current_rule_name;
    let saved_group_counter = ctx.group_counter;
    let saved_alt_gc_starts = ctx.alt_gc_starts;
    let saved_mask = ctx.current_follow_mask;
    let saved_outer = ctx.current_outer_follow;

    ctx.current_follow_mask = entry.mask;
    ctx.current_outer_follow = entry.mask;

    let scan_name = `scan_{rule.snake_name}__follow_{entry.id}`;
    let parse_name = `parse_{rule.snake_name}__follow_{entry.id}`;
    if entry.scan_used {
        gen_scan_function_named(w, rule, ctx, &scan_name, /*allow_lr_split=*/ true);
    }
    if entry.parse_used {
        gen_parse_fn_named(w, rule, variant_rule, ctx, &parse_name, &scan_name, /*emit_visibility=*/ false);
    }

    ctx.current_rule_name = saved_rule_name;
    ctx.group_counter = saved_group_counter;
    ctx.alt_gc_starts = saved_alt_gc_starts;
    ctx.current_follow_mask = saved_mask;
    ctx.current_outer_follow = saved_outer;
}

fn gen_parser_struct(w: &mut CodeWriter) {
    let mut s = StructSpec::new("Parser");
    s.add_field("tokens", "Array<Token>");
    s.add_field("pos", "i32");
    s.emit(w);
    w.blank();

    ImplSpec::new("Parser").emit_begin(w);

    let mut f = FnSpec::new("new");
    f.add_param("tokens", "Array<Token>");
    f.set_return_type("Parser");
    f.emit_begin(w);
    w.line("return Parser { tokens, pos: 0 };");
    w.end();
    w.blank();

    let mut f2 = FnSpec::new("peek");
    f2.set_receiver("&self");
    f2.set_return_type("&Token");
    f2.emit_begin(w);
    w.line("return &self.tokens[self.pos];");
    w.end();
    w.blank();

    let mut f3 = FnSpec::new("peek_kind");
    f3.set_receiver("&self");
    f3.set_return_type("i32");
    f3.emit_begin(w);
    w.line("return self.tokens[self.pos].kind;");
    w.end();
    w.blank();

    let mut f4 = FnSpec::new("peek_at");
    f4.set_receiver("&self");
    f4.add_param("offset", "i32");
    f4.set_return_type("i32");
    f4.emit_begin(w);
    w.line("let idx = self.pos + offset;");
    w.line("if idx >= self.tokens.len() { return TK_EOF; }");
    w.line("return self.tokens[idx].kind;");
    w.end();
    w.blank();

    let mut f5 = FnSpec::new("advance");
    f5.set_receiver("&mut self");
    f5.set_return_type("Token");
    f5.emit_begin(w);
    w.line("let tok = self.tokens[self.pos];");
    w.line("self.pos += 1;");
    w.line("return tok;");
    w.end();
    w.blank();

    let mut f6 = FnSpec::new("last_end");
    f6.set_receiver("&self");
    f6.set_return_type("i32");
    f6.emit_begin(w);
    w.line("if self.pos == 0 { return 0; }");
    w.line("return self.tokens[self.pos - 1].span.end;");
    w.end();
    w.blank();

    let mut f7 = FnSpec::new("expect");
    f7.set_receiver("&mut self");
    f7.add_param("kind", "i32");
    f7.set_return_type("Result<Token, ParseError>");
    f7.emit_begin(w);
    w.begin("if self.tokens[self.pos].kind == kind");
    w.line("return Result::<Token, ParseError>::Ok(self.advance());");
    w.end();
    w.line("let tok = &self.tokens[self.pos];");
    w.line("let name = token_kind_name(kind);");
    w.line("return Result::<Token, ParseError>::Err(ParseError::new(");
    w.indent();
    w.line("`expected {name}, got \"{tok.text}\"`,");
    w.line("tok.span,");
    w.line("[name],");
    w.dedent();
    w.line("));");
    w.end();
    w.blank();

    let mut f8 = FnSpec::new("fail");
    f8.set_receiver("&self");
    f8.add_param("name", "String");
    f8.set_return_type("Result<Token, ParseError>");
    f8.emit_begin(w);
    w.line("let tok = &self.tokens[self.pos];");
    w.line("return Result::<Token, ParseError>::Err(ParseError::new(");
    w.indent();
    w.line("`expected {name}, got \"{tok.text}\"`,");
    w.line("tok.span,");
    w.line("[name],");
    w.dedent();
    w.line("));");
    w.end();
    w.blank();

    // `p.match_any()` — consumes one token of any kind (for `.` wildcard).
    // Fails at EOF.
    let mut f9 = FnSpec::new("match_any");
    f9.set_receiver("&mut self");
    f9.set_return_type("Result<Token, ParseError>");
    f9.emit_begin(w);
    w.begin("if self.tokens[self.pos].kind != TK_EOF");
    w.line("return Result::<Token, ParseError>::Ok(self.advance());");
    w.end();
    w.line("let tok = &self.tokens[self.pos];");
    w.line("return Result::<Token, ParseError>::Err(ParseError::new(");
    w.indent();
    w.line("`expected any token, got \"{tok.text}\"`,");
    w.line("tok.span,");
    w.line("[\"any token\"],");
    w.dedent();
    w.line("));");
    w.end();
    w.blank();

    // `p.match_not([TK_A, TK_B, ...])` — consumes one token whose kind is
    // not in the exclusion set (for parser-side `~ X`). Fails at EOF or when
    // the current token is in the exclusion set. The exclusion set is passed
    // by value so the caller can use tuple-to-Array coercion on a literal.
    let mut f10 = FnSpec::new("match_not");
    f10.set_receiver("&mut self");
    f10.add_param("excluded", "Array<i32>");
    f10.set_return_type("Result<Token, ParseError>");
    f10.emit_begin(w);
    w.line("let k = self.tokens[self.pos].kind;");
    w.begin("if k != TK_EOF");
    w.line("let mut blocked = false;");
    w.begin("for let x of excluded");
    w.begin("if x == k");
    w.line("blocked = true;");
    w.line("break;");
    w.end();
    w.end();
    w.begin("if !blocked");
    w.line("return Result::<Token, ParseError>::Ok(self.advance());");
    w.end();
    w.end();
    w.line("let tok = &self.tokens[self.pos];");
    w.line("return Result::<Token, ParseError>::Err(ParseError::new(");
    w.indent();
    w.line("`unexpected token \"{tok.text}\"`,");
    w.line("tok.span,");
    w.line("[\"set complement\"],");
    w.dedent();
    w.line("));");
    w.end();

    w.end();  // impl
    w.blank();
}

// --- Alternative Scan Helpers ---
// For each alternative in an Ambiguous group that has a scannable prefix,
// generate a scan_<rule>_bt_<N> function. This function scans only the
// scannable prefix of the alternative, which is enough to distinguish it
// from other alternatives without full speculative parsing.

/// Returns the number of leading elements in the alternative that are scannable.
/// Stops at the first unscannable element (e.g., a RuleRef to `expr`).
fn scannable_prefix_len(elements: &Array<Element>, ctx: &mut GenContext) -> i32 {
    let mut count: i32 = 0;
    for let elem of elements {
        let mut visiting: Array<String> = [];
        if !ctx.is_element_scannable(elem, &mut visiting) {
            break;
        }
        count += 1;
    }
    return count;
}

/// Generate a scan function for a tournament alternative (`parse_X_bt_N` —
/// the `_bt_` infix is historical) if it has at least one scannable leading
/// element. The scan covers the scannable prefix only.
fn gen_bt_scan_if_possible(w: &mut CodeWriter, alt: &Alternative, fn_name: &String, alt_idx: i32, ctx: &mut GenContext) {
    let prefix_len = scannable_prefix_len(&alt.elements, ctx);
    if prefix_len == 0 {
        return;
    }

    let scan_name = `{*fn_name}_scan_{alt_idx}`;

    let mut f = FnSpec::new(&scan_name);
    f.add_param("tokens", "&Array<Token>");
    f.add_param("pos", "i32");
    f.set_return_type("i32");
    f.emit_begin(w);
    w.line("let mut pos = pos;");

    // bt-scan should treat the LAST element as atom-only when it is a
    // self-reference to the current rule — that is the prefix-alt case
    // (`op expr` etc.) where the OUTER LR loop will consume what follows
    // and including it here would over-match. Inner self-refs, by
    // contrast, are bounded by surrounding tokens (e.g. `K_WHEN expr
    // K_THEN expr` inside `case_expr`) and need a full scan.
    gen_bt_scan_elements(w, &alt.elements, 0, prefix_len, ctx);

    w.line("return pos;");
    w.end();
    w.blank();
}

/// Returns true if the alternative has a generated scan function (has scannable prefix).
fn alt_has_scan(elements: &Array<Element>, ctx: &mut GenContext) -> bool {
    return scannable_prefix_len(elements, ctx) > 0;
}

/// Returns true if the scan function covers the entire alternative (all elements are scannable).
/// When true, a scan success guarantees parse success so no fallthrough is needed.
fn alt_scan_is_full(elements: &Array<Element>, ctx: &mut GenContext) -> bool {
    return scannable_prefix_len(elements, ctx) == elements.len();
}

// --- Scan Function Generation ---
// Scan functions recognize parser rules by walking token kinds without building
// CST nodes or constructing error messages. They return the token position after
// successful recognition, or -1 on failure. Used to disambiguate Ambiguous
// alternatives without expensive speculative parsing.

fn gen_scan_functions(w: &mut CodeWriter, grammar: &Grammar, ctx: &mut GenContext) {
    for let rule of grammar.parser_rules {
        gen_scan_function(w, &rule, ctx);
    }
}

fn gen_scan_function(w: &mut CodeWriter, rule: &ParserRule, ctx: &mut GenContext) {
    gen_scan_function_named(w, rule, ctx, &`scan_{rule.snake_name}`, true);
}

/// Body emitter shared by `gen_scan_function` and the follow-aware
/// variant pass. `allow_lr_split` is `true` for the regular path (which
/// dispatches to `gen_scan_lr_functions` for left-recursive rules) and
/// `false` for variants — variants are only emitted for non-LR rules
/// today, so callers ensure the rule is non-LR before dispatching.
fn gen_scan_function_named(w: &mut CodeWriter, rule: &ParserRule, ctx: &mut GenContext, fn_name: &String, allow_lr_split: bool) {
    let mut lr_indices: Array<i32> = [];
    let mut non_lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if is_left_recursive(&rule.alternatives[i], &rule.name) {
            lr_indices.push(i);
        } else {
            non_lr_indices.push(i);
        }
    }

    if lr_indices.len() > 0 && allow_lr_split {
        gen_scan_lr_functions(w, rule, &lr_indices, &non_lr_indices, ctx, fn_name);
        return;
    }

    let mut f = FnSpec::new(fn_name);
    f.add_param("tokens", "&Array<Token>");
    f.add_param("pos", "i32");
    // Accept (and ignore) min_prec so call sites pass it uniformly
    // regardless of whether the target rule is left-recursive. See
    // `GenContext.scan_ruleref_min_prec` for the bt-scan use case.
    f.add_param_spec(ParamSpec {
        name: "min_prec",
        type_str: "i32",
        default_value: Option::<String>::Some("0"),
    });
    f.set_return_type("i32");
    f.emit_begin(w);

    if rule.alternatives.len() == 1 {
        w.line("let mut pos = pos;");
        let elems = &rule.alternatives[0].elements;
        gen_scan_elements(w, elems, 0, elems.len(), ctx);
        w.line("return pos;");
    } else if all_alts_are_single_token(&rule.alternatives) {
        // Compact form: every alt matches exactly one fixed token, so the
        // entire scan reduces to "is the next token in this set?". A naive
        // multi-alt expansion would emit one labelled partition per token
        // (~7 lines × N tokens) — for `keyword` in SQLite that is 122 alts
        // ≈ 1000 lines of source per scan invocation site. Collapsing to a
        // single `matches` cuts the per-rule scan code 100×+, which removes
        // most of the wasm bloat that LR-gate removal otherwise pays for
        // by making scan_X functions reachable. Behaviourally identical to
        // the longest-match tournament: every alt consumes exactly one
        // token, so longest-match and first-success-wins both pick whatever
        // alt's token equals `tokens[pos].kind`.
        let mut firsts: Array<String> = [];
        for let alt of &rule.alternatives {
            let t = single_token_first(&alt.elements[0]);
            if !first_contains(&firsts, &t) {
                firsts.push(t);
            }
        }
        let check = ctx.kind_check_str(&firsts, "tokens[pos].kind");
        w.begin(`if pos < tokens.len() && {check}`);
        w.line("return pos + 1;");
        w.end();
        w.line("return -1;");
    } else {
        gen_scan_multi_alt(w, &rule.alternatives, ctx);
    }

    w.end();
    w.blank();
}

/// Returns true if every alt in `alts` is a single TokenRef or Literal
/// element. Such rules collapse to a one-token kind check at scan time.
fn all_alts_are_single_token(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        let elem = &alt.elements[0];
        let is_token = match elem {
            TokenRef(_) | Literal(_) => true,
            _ => false,
        };
        if !is_token {
            return false;
        }
    }
    return true;
}

/// Return the matched token-kind constant for a single TokenRef/Literal
/// element. Caller is expected to have screened the element via
/// `all_alts_are_single_token`.
fn single_token_first(elem: &Element) -> String {
    return match elem {
        TokenRef(t) => `TK_{t.name}`,
        Literal(l) => literal_const_name(&l.text),
        _ => panic("single_token_first: unexpected element"),
    };
}

/// Generate scan functions for a left-recursive rule. Mirrors the parse-side
/// precedence-climbing infrastructure so that scan success/failure is a
/// faithful predicate for parse success/failure:
///
///   - scan_X_atom(tokens, pos): scans non-LR alternatives (first-match).
///   - scan_X_lr_N(tokens, pos): scans the suffix (elements[1..]) of the N-th
///     LR alternative, recursing into scan_X for self-refs with the same
///     precedence thresholds that parse_X_lr_N uses.
///   - scan_X(tokens, pos, min_prec = 0): atom + precedence-aware LR-suffix
///     loop with token-kind dispatch and second-token overlap resolution.
///     Callers without a precedence context omit min_prec and get 0.
fn gen_scan_lr_functions(w: &mut CodeWriter, rule: &ParserRule, lr_indices: &Array<i32>, non_lr_indices: &Array<i32>, ctx: &mut GenContext, fn_name: &String) {
    let atom_name = `{*fn_name}_atom`;

    // scan_X_atom: tries each non-LR alt (first-match, same shape as before).
    let mut fa = FnSpec::new(&atom_name);
    fa.add_param("tokens", "&Array<Token>");
    fa.add_param("pos", "i32");
    fa.set_return_type("i32");
    fa.emit_begin(w);
    let mut non_lr_alts: Array<Alternative> = [];
    for let idx of non_lr_indices {
        non_lr_alts.push(rule.alternatives[*idx]);
    }
    if non_lr_alts.len() == 0 {
        w.line("return -1;");
    } else if non_lr_alts.len() == 1 {
        w.line("let mut pos = pos;");
        let elems = &non_lr_alts[0].elements;
        gen_scan_elements(w, elems, 0, elems.len(), ctx);
        w.line("return pos;");
    } else {
        gen_scan_multi_alt(w, &non_lr_alts, ctx);
    }
    w.end();
    w.blank();

    // scan_X_lr_N for each valid LR alt (suffix helper, mirrors parse_X_lr_N).
    gen_scan_lr_suffix_helpers(w, rule, lr_indices, ctx, fn_name);

    // scan_X(tokens, pos, min_prec = 0): atom + precedence-aware dispatch loop.
    let mut f2 = FnSpec::new(fn_name);
    f2.add_param("tokens", "&Array<Token>");
    f2.add_param("pos", "i32");
    f2.add_param_spec(ParamSpec {
        name: "min_prec",
        type_str: "i32",
        default_value: Option::<String>::Some("0"),
    });
    f2.set_return_type("i32");
    f2.emit_begin(w);
    w.line(`let mut pos = {atom_name}(tokens, pos);`);
    w.line("if pos < 0 { return -1; }");
    gen_scan_lr_suffix_dispatch(w, rule, lr_indices, ctx, fn_name);
    w.line("return pos;");
    w.end();
    w.blank();
}

/// Scan-side twin of `gen_lr_suffix_helpers`. Emits `scan_X_lr_N(tokens, pos)`
/// for each valid LR alternative, scanning its suffix (elements[1..]). Self-
/// recursive calls compile to `scan_X(tokens, pos, prec)` with the same
/// precedence value the parse side uses (via `compute_lr_self_ref_prec`).
fn gen_scan_lr_suffix_helpers(w: &mut CodeWriter, rule: &ParserRule, lr_indices: &Array<i32>, ctx: &mut GenContext, fn_name: &String) {
    let total_lr = lr_indices.len();
    let lr_suffix_first_tokens = collect_lr_suffix_first_tokens(rule, lr_indices, ctx);

    let mut lr_pos = 0;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 {
            lr_pos += 1;
            continue;
        }
        let own_prec = total_lr - lr_pos;
        let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
        let inner_min_prec = compute_lr_conflict_min_prec(
            alt,
            own_prec,
            lr_indices,
            rule,
            ctx,
            total_lr,
        );
        let last_self_ref_idx = find_last_self_ref_idx(alt, &rule.name);

        let mut f = FnSpec::new(&suffix_fn);
        f.add_param("tokens", "&Array<Token>");
        f.add_param("pos", "i32");
        f.set_return_type("i32");
        f.emit_begin(w);
        w.line("let mut pos = pos;");

        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            let elem = &alt.elements[ei];
            if let RuleRef(r) = elem {
                if r.name == rule.name {
                    let prec = compute_lr_self_ref_prec(
                        alt,
                        ei,
                        last_self_ref_idx,
                        inner_min_prec,
                        &lr_suffix_first_tokens,
                    );
                    w.line(`pos = {*fn_name}(tokens, pos, {prec});`);
                    w.line("if pos < 0 { return -1; }");
                    continue;
                }
            }
            if let Repeat(rep) = elem {
                if let Optional = rep.kind {
                    if is_ruleref_optional(&rep.element) {
                        let follow = ctx.first_of_elements_from(&alt.elements, ei + 1);
                        gen_scan_repeat_optional_with_follow(w, rep, ctx, &follow);
                        continue;
                    }
                }
            }
            gen_scan_element(w, elem, ctx, &"return -1;");
        }
        w.line("return pos;");
        w.end();
        w.blank();
        lr_pos += 1;
    }
}

/// Scan-side twin of `gen_lr_suffix_dispatch`. Emits the precedence-aware
/// LR-suffix loop with first-token dispatch. Identical structure to the parse
/// side, with p.peek_kind() replaced by an inline bounds-checked read into
/// `suffix_kind` and `result = fn(p, ...)?` replaced by `pos = fn(tokens, pos);
/// if pos < 0 { return -1; }`.
fn gen_scan_lr_suffix_dispatch(w: &mut CodeWriter, rule: &ParserRule, lr_indices: &Array<i32>, ctx: &mut GenContext, fn_name: &String) {
    let d = compute_lr_dispatch_data(rule, lr_indices, ctx);

    w.begin("loop");
    w.line("let suffix_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };");

    let mut is_first = true;
    for let mut g = 0; g < d.groups.len(); g += 1 {
        let group = &d.groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &d.suffix_first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, "suffix_kind");
        if is_first {
            w.begin(`if {cond}`);
            is_first = false;
        } else {
            w.else_begin(`else if {cond}`);
        }

        if group.len() == 1 {
            let lr_idx = d.valid_lr_indices[group[0]];
            let prec = d.lr_precs[group[0]];
            let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
            gen_scan_lr_call_with_prec(w, &suffix_fn, prec);
        } else {
            gen_scan_lr_overlap_dispatch(
                w,
                fn_name,
                rule,
                group,
                &d.valid_lr_indices,
                &d.lr_precs,
                &d.suffix_first_sets,
                ctx,
            );
        }
    }

    if !is_first {
        w.else_begin("else");
        w.line("break;");
        w.end();
    } else {
        w.line("break;");
    }
    w.end();  // loop
}

fn gen_scan_lr_call_with_prec(w: &mut CodeWriter, suffix_fn: &String, prec: i32) {
    // The LR loop must always commit to the longest valid prefix it can
    // build. If the suffix scan fails (e.g. the suffix's first token matches
    // but a deeper element does not, as in `statement letterA 'b'` consuming
    // the trailing `letterA` then failing on `'b'`), we restore `pos` to the
    // last successful position and break out of the loop — never propagate
    // the failure as the whole scan failing. ANTLR4's LL(*) prediction
    // achieves the same result at decision time; Gale's first-token dispatch
    // makes the same decision lazily after attempting the suffix.
    w.begin(`if {prec} >= min_prec`);
    w.line(`let lr_saved_pos = pos;`);
    w.line(`pos = {*suffix_fn}(tokens, pos);`);
    w.line("if pos < 0 { pos = lr_saved_pos; break; }");
    w.else_begin("else");
    w.line("break;");
    w.end();
}

/// Scan-side twin of `gen_lr_overlap_dispatch`. For each shared-first-token
/// group, dispatches by first token then by second token (peek_at(1)) to the
/// correct LR alternative — exactly like the parse side, so scan and parse
/// agree on which alt applies at every position.
fn gen_scan_lr_overlap_dispatch(w: &mut CodeWriter, fn_name: &String, rule: &ParserRule, group: &Array<i32>, valid_lr_indices: &Array<i32>, lr_precs: &Array<i32>, suffix_first_sets: &Array<Array<String>>, ctx: &mut GenContext) {
    let mut suffix_sets: Array<TreeSet<String>> = [];
    for let sfs of suffix_first_sets {
        suffix_sets.push(str_set_from(sfs));
    }

    let mut emitted = TreeSet::<String>::new();
    let mut first_branch = true;

    // First pass: unique-token branches.
    for let mut k = 0; k < group.len(); k += 1 {
        let this_first = &suffix_first_sets[group[k]];
        for let mut t = 0; t < this_first.len(); t += 1 {
            let tk = &this_first[t];
            if emitted.contains(*tk) {
                continue;
            }
            let mut shared = false;
            for let mut j = 0; j < group.len(); j += 1 {
                if j == k {
                    continue;
                }
                if suffix_sets[group[j]].contains(*tk) {
                    shared = true;
                }
            }
            if !shared {
                let lr_idx = valid_lr_indices[group[k]];
                let prec = lr_precs[group[k]];
                let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
                if first_branch {
                    w.begin(`if suffix_kind == {*tk}`);
                    first_branch = false;
                } else {
                    w.else_begin(`else if suffix_kind == {*tk}`);
                }
                gen_scan_lr_call_with_prec(w, &suffix_fn, prec);
                emitted.insert(*tk);
            }
        }
    }

    // Second pass: shared-token branches with second-token sub-dispatch.
    let mut shared_tokens: Array<String> = [];
    let mut shared_seen = TreeSet::<String>::new();
    for let mut k = 0; k < group.len(); k += 1 {
        let sfs = &suffix_first_sets[group[k]];
        for let mut ti = 0; ti < sfs.len(); ti += 1 {
            let tk = &sfs[ti];
            if emitted.contains(*tk) {
                continue;
            }
            if !shared_seen.contains(*tk) {
                shared_seen.insert(*tk);
                shared_tokens.push(*tk);
            }
        }
    }
    for let mut st = 0; st < shared_tokens.len(); st += 1 {
        let shared_tk = &shared_tokens[st];
        if first_branch {
            w.begin(`if suffix_kind == {*shared_tk}`);
            first_branch = false;
        } else {
            w.else_begin(`else if suffix_kind == {*shared_tk}`);
        }
        w.line("let second_kind = if pos + 1 < tokens.len() { tokens[pos + 1].kind } else { TK_EOF };");
        let mut sub_first = true;
        let mut last_k = -1;
        for let mut k = 0; k < group.len(); k += 1 {
            if suffix_sets[group[k]].contains(*shared_tk) {
                last_k = k;
            }
        }
        for let mut k = 0; k < group.len(); k += 1 {
            if !suffix_sets[group[k]].contains(*shared_tk) {
                continue;
            }
            let lr_idx = valid_lr_indices[group[k]];
            let prec = lr_precs[group[k]];
            let alt = &rule.alternatives[lr_idx];
            let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
            if k == last_k {
                if sub_first {
                    gen_scan_lr_call_with_prec(w, &suffix_fn, prec);
                } else {
                    w.else_begin("else");
                    gen_scan_lr_call_with_prec(w, &suffix_fn, prec);
                    w.end();
                }
            } else {
                let second = compute_lr_second_token(shared_tk, &alt.elements, ctx);
                let sub_cond = ctx.kind_check_str(&second, "second_kind");
                if sub_first {
                    w.begin(`if {sub_cond}`);
                    sub_first = false;
                } else {
                    w.else_begin(`else if {sub_cond}`);
                }
                gen_scan_lr_call_with_prec(w, &suffix_fn, prec);
            }
        }
        emitted.insert(*shared_tk);
    }
    if !first_branch {
        w.end();
    }
}

/// Generate scan code for a multi-alt non-LR rule body (or LR atom body).
/// Mirrors the parse-side `gen_multi_alt_body` peek-dispatch so that an alt
/// is only attempted when its FIRST set matches `alt_kind` — this turns
/// rule-level alt selection from linear first-match into O(1) token dispatch.
///
/// Strategy: for each alt compute FIRST, then emit a per-alt `if` guard on
/// `alt_kind`. On inner failure (break `try_i`), fall through to the next
/// alt (which is itself peek-dispatched). If no alt's FIRST matches or every
/// try block fails, return -1. Alts with empty FIRST (e.g. starting with
/// Wildcard or a rule whose FIRST is unenumerable) are attempted
/// unconditionally as fallbacks.
fn gen_scan_multi_alt(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext) {
    let n = alts.len();
    let max_k = 5;
    let mut all_pos_sets: Array<Array<Array<String>>> = [];
    for let alt of alts {
        all_pos_sets.push(ctx.alt_position_first_sets(alt, max_k));
    }

    // Token-partitioned dispatch, mirroring parse-side `gen_multi_alt_body`
    // (see e.g. `parse_expr_atom` in the sqlite golden).
    //
    // For each depth-0 first token in the union of all alt guards, we
    // compute which alts claim it. Tokens claimed by the same set of
    // alts are folded into one partition. Each partition becomes one
    // dispatch branch:
    //   - 1 alt in partition → fast-path: commit on success, fail on miss.
    //   - 2+ alts in partition → mini-tournament over ONLY those alts
    //     (plus any unguarded alts), picking the longest match.
    //
    // This avoids the regression where sharing a single ambiguous pair
    // (e.g. `column_ref` and `function_call` both starting with an
    // IDENT-like token) forced every first-token dispatch through an
    // N-way tournament. Under partitioning:
    //   - `BIND_PARAMETER` → fast-path to the bind-param alt.
    //   - `LPAREN` → 3-way tournament among column_ref, function_call,
    //     paren_expr (the only alts whose depth-0 first-set contains
    //     LPAREN, via `any_name`'s `'(' any_name ')'` sub-alt).
    //   - `IDENT`/keyword → 2-way tournament among column_ref and
    //     function_call only.
    //
    // Unguarded alts (empty pos_sets — fully nullable or unpredictable)
    // ride along as tournament candidates in every partition and in the
    // fall-through default, matching the existing fallback semantics.

    let mut guarded_idx: Array<i32> = [];
    let mut unguarded_idx: Array<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        if all_pos_sets[i].len() >= 1 {
            guarded_idx.push(i);
        } else {
            unguarded_idx.push(i);
        }
    }

    let mut union_tokens: Array<String> = [];
    for let i of &guarded_idx {
        let depth0 = &all_pos_sets[*i][0];
        for let t of depth0 {
            if !first_contains(&union_tokens, t) {
                union_tokens.push(*t);
            }
        }
    }

    let mut groups_alts: Array<Array<i32>> = [];
    let mut groups_tokens: Array<Array<String>> = [];

    for let t of &union_tokens {
        let mut claiming: Array<i32> = [];
        for let i of &guarded_idx {
            if first_contains(&all_pos_sets[*i][0], t) {
                claiming.push(*i);
            }
        }
        let mut found: i32 = -1;
        for let mut g = 0; g < groups_alts.len(); g += 1 {
            if i32_arrays_equal(&groups_alts[g], &claiming) {
                found = g;
                break;
            }
        }
        if found >= 0 {
            groups_tokens[found].push(*t);
        } else {
            groups_alts.push(claiming);
            let mut seed: Array<String> = [];
            seed.push(*t);
            groups_tokens.push(seed);
        }
    }

    // Sort each partition (and the unguarded alts) longest-first via
    // `sort_group_by_element_count`. First-success-wins in
    // `emit_scan_partition_body` relies on this order: the most specific
    // (highest-priority, then most-elements) candidate is scanned first,
    // so committing on first success is correctness-equivalent to a
    // longest-match tournament when alts may share prefixes (e.g.
    // `expr`'s `column_ref` IDENT vs `function_call` IDENT '(' ... ')' ).
    for let mut g = 0; g < groups_alts.len(); g += 1 {
        sort_group_by_element_count(&mut groups_alts[g], alts);
    }
    sort_group_by_element_count(&mut unguarded_idx, alts);

    w.line("let start = pos;");
    w.line("let mut pos = pos;");
    w.line("let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };");

    w.begin("scan_alts:");

    let mut first_branch = true;
    for let mut g = 0; g < groups_alts.len(); g += 1 {
        let cond = ctx.kind_check_str(&groups_tokens[g], &"alt_kind");
        if first_branch {
            w.begin(`if {cond}`);
            first_branch = false;
        } else {
            w.else_begin(`else if {cond}`);
        }
        emit_scan_partition_body(w, &groups_alts[g], &unguarded_idx, alts, ctx);
    }

    if unguarded_idx.len() > 0 {
        let empty_alts: Array<i32> = [];
        if first_branch {
            emit_scan_partition_body(w, &empty_alts, &unguarded_idx, alts, ctx);
        } else {
            w.else_begin("else");
            emit_scan_partition_body(w, &empty_alts, &unguarded_idx, alts, ctx);
            w.end();
        }
    } else if !first_branch {
        w.else_begin("else");
        w.line("return -1;");
        w.end();
    } else {
        w.line("return -1;");
    }

    w.end();
    w.line("return pos;");
}

/// Emit the body of a single partition branch: try `guarded_alts` then
/// `unguarded_alts` in the order they were sorted (longest-first via
/// `sort_group_by_element_count` in `gen_scan_multi_alt`), committing to
/// the first alt whose scan succeeds via `break scan_alts`. On no match,
/// `return -1` so the caller falls through to the next partition (or the
/// rule-level fallback).
///
/// First-success-wins is correctness-equivalent to a longest-match
/// tournament given the longest-first sort: the highest-priority and
/// most-element candidate is tried first, so when two alts share a prefix
/// (e.g. `expr`'s `column_ref` matches `IDENT` and `function_call` matches
/// `IDENT '(' ... ')'`), the longer one is attempted first and only the
/// strictly-shorter alternative is reached when the longer scan fails.
/// Compared to the previous tournament, committing on first success skips
/// running the remaining candidates' full scans — a meaningful saving when
/// any alt's scan recurses through an LR rule.
fn emit_scan_partition_body(w: &mut CodeWriter, guarded_alts: &Array<i32>, unguarded_alts: &Array<i32>, alts: &Array<Alternative>, ctx: &mut GenContext) {
    let total = guarded_alts.len() + unguarded_alts.len();
    if total == 1 {
        let i = if guarded_alts.len() == 1 { guarded_alts[0] } else { unguarded_alts[0] };
        let label = `try_{i}`;
        w.line("pos = start;");
        w.begin(`{label}:`);
        gen_scan_elements_in_block(w, &alts[i].elements, 0, alts[i].elements.len(), ctx, &label);
        w.line("break scan_alts;");
        w.end();
        w.line("return -1;");
        return;
    }
    for let i of guarded_alts {
        let label = `try_{*i}`;
        w.line("pos = start;");
        w.begin(`{label}:`);
        gen_scan_elements_in_block(w, &alts[*i].elements, 0, alts[*i].elements.len(), ctx, &label);
        w.line("break scan_alts;");
        w.end();
    }
    for let i of unguarded_alts {
        let label = `try_{*i}`;
        w.line("pos = start;");
        w.begin(`{label}:`);
        gen_scan_elements_in_block(w, &alts[*i].elements, 0, alts[*i].elements.len(), ctx, &label);
        w.line("break scan_alts;");
        w.end();
    }
    w.line("return -1;");
}

fn i32_arrays_equal(a: &Array<i32>, b: &Array<i32>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for let mut i = 0; i < a.len(); i += 1 {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn build_scan_lookahead_condition(ctx: &mut GenContext, pos_sets: &Array<Array<String>>, depth: i32) -> String {
    let mut cond = String::with_capacity(128);
    for let mut d = 0; d < depth; d += 1 {
        if d > 0 {
            cond.push_str(" && ");
        }
        let tokens = &pos_sets[d];
        if d == 0 {
            cond.push_str(ctx.kind_check_str(tokens, &"alt_kind"));
        } else {
            cond.push_str(`pos + {d} < tokens.len() && `);
            let tok_expr = `tokens[pos + {d}].kind`;
            cond.push_str(ctx.kind_check_str(tokens, &tok_expr));
        }
    }
    return cond;
}

/// Scan-side twin of `gen_repeat_with_follow`. Subtracts `follow_first`
/// from the Optional inner's first-set so the Optional does not fire on
/// tokens that belong to the enclosing sequence's next element — the
/// same disambiguation the parse side applies to `RuleRef?` optionals.
/// If the pruned first-set is empty the Optional can never fire, so
/// nothing is emitted.
fn gen_scan_repeat_optional_with_follow(w: &mut CodeWriter, rep: &RepeatElement, ctx: &mut GenContext, follow_first: &Array<String>) {
    let inner = &rep.element;
    let mut visiting: Array<String> = [];
    let raw_first = ctx.first_of_element(inner, &mut visiting);
    let combined_follow = if ctx.current_follow_mask.is_empty() {
        *follow_first;
    } else {
        union_sets(follow_first, &ctx.current_follow_mask);
    };
    let first = subtract_sets(&raw_first, &combined_follow);

    if first.len() == 0 {
        return;
    }

    let check = ctx.kind_check_str(&first, &"tokens[pos].kind");
    w.begin(`if pos < tokens.len() && {check}`);
    w.line("let sp = pos;");
    gen_scan_element_assign(w, inner, ctx);
    w.line("if pos < 0 { pos = sp; }");
    w.end();
}

/// Iterate `elements[start..end]` in scan mode and emit each element's
/// scan code. For Optional(RuleRef) elements we compute a local
/// follow-set (first-set of elements after `i`) and apply follow-set
/// pruning — the scan-side twin of the parse-side
/// `gen_repeat_with_follow` branch in `gen_alt_elements`. All other
/// elements go through `gen_scan_element` (fail ⇒ `return -1;`).
fn gen_scan_elements(w: &mut CodeWriter, elements: &Array<Element>, start: i32, end: i32, ctx: &mut GenContext) {
    let saved_mask = ctx.current_follow_mask;
    let saved_call_follow = ctx.ruleref_call_follow;
    for let mut i = start; i < end; i += 1 {
        // Variant follow mask only propagates to tail-position elements
        // (those whose right siblings are deep-nullable). Non-tail
        // elements emit unchanged: e.g. `Y? Z` should not skip Y? when
        // Z is required next, even if the caller's follow contains Y.
        ctx.current_follow_mask = if ctx.tail_is_nullable_deep(elements, i + 1) { saved_mask } else { [] };
        // Caller-side FOLLOW for variant selection: only register a
        // follow-aware variant when the immediate next sibling is
        // strictly required. When the suffix is deep-nullable, its
        // first-set might or might not be claimed at runtime — applying
        // a follow mask there would incorrectly suppress greedy
        // consumption that the grammar relies on (CSS `ws (combinator
        // ...)*` is the canonical hazard: Space is in both `ws`'s
        // tail-greedy and combinator's first set, but `ws` should still
        // consume Space when there is no combinator to follow).
        ctx.ruleref_call_follow = compute_ruleref_call_follow(elements, i, ctx);
        let elem = &elements[i];
        if let Repeat(rep) = elem {
            if let Optional = rep.kind {
                if is_ruleref_optional(&rep.element) {
                    let follow = ctx.first_of_elements_from(elements, i + 1);
                    gen_scan_repeat_optional_with_follow(w, rep, ctx, &follow);
                    continue;
                }
            }
        }
        gen_scan_element(w, elem, ctx, &"return -1;");
        ctx.ruleref_call_follow = [];
    }
    ctx.current_follow_mask = saved_mask;
    ctx.ruleref_call_follow = saved_call_follow;
}

/// Specialisation of `gen_scan_elements` for bt-scan helpers. Raises
/// `ctx.scan_ruleref_min_prec` to `i32::MAX` for the LAST element only
/// when it is a self-reference to the current rule, so that
/// `gen_scan_element` emits `scan_<rule>(tokens, pos, i32::MAX)` for
/// that one position. The MAX guards short-circuit the LR suffix loop
/// inside the target rule's `scan_<rule>` — the prefix-alt scenario
/// where the outer LR loop will consume the trailing tokens.
fn gen_bt_scan_elements(w: &mut CodeWriter, elements: &Array<Element>, start: i32, end: i32, ctx: &mut GenContext) {
    for let mut i = start; i < end; i += 1 {
        let elem = &elements[i];
        let is_last_self_ref = i == end - 1 && is_self_ref_element(elem, &ctx.current_rule_name);
        let saved = ctx.scan_ruleref_min_prec;
        if is_last_self_ref {
            ctx.scan_ruleref_min_prec = i32::MAX;
        }
        if let Repeat(rep) = elem {
            if let Optional = rep.kind {
                if is_ruleref_optional(&rep.element) {
                    let follow = ctx.first_of_elements_from(elements, i + 1);
                    gen_scan_repeat_optional_with_follow(w, rep, ctx, &follow);
                    ctx.scan_ruleref_min_prec = saved;
                    continue;
                }
            }
        }
        gen_scan_element(w, elem, ctx, &"return -1;");
        ctx.scan_ruleref_min_prec = saved;
    }
}

/// `gen_scan_elements` variant that routes non-Optional failures through
/// `break {label};` so the sequence lives inside a labeled block.
fn gen_scan_elements_in_block(w: &mut CodeWriter, elements: &Array<Element>, start: i32, end: i32, ctx: &mut GenContext, label: &String) {
    let fail = `break {*label};`;
    let saved_mask = ctx.current_follow_mask;
    let saved_call_follow = ctx.ruleref_call_follow;
    for let mut i = start; i < end; i += 1 {
        ctx.current_follow_mask = if ctx.tail_is_nullable_deep(elements, i + 1) { saved_mask } else { [] };
        ctx.ruleref_call_follow = compute_ruleref_call_follow(elements, i, ctx);
        let elem = &elements[i];
        if let Repeat(rep) = elem {
            if let Optional = rep.kind {
                if is_ruleref_optional(&rep.element) {
                    let follow = ctx.first_of_elements_from(elements, i + 1);
                    gen_scan_repeat_optional_with_follow(w, rep, ctx, &follow);
                    continue;
                }
            }
        }
        gen_scan_element(w, elem, ctx, &fail);
        ctx.ruleref_call_follow = [];
    }
    ctx.current_follow_mask = saved_mask;
    ctx.ruleref_call_follow = saved_call_follow;
}

/// `fail_stmt` describes how to report failure to the caller when the
/// mandatory first iteration of `+` fails (Optional/Star never fail).
///
/// `ruleref_call_follow` is saved, cleared, and restored around the
/// emit body — the outer alt walker's value applies to the Repeat
/// element's own position, but the inner element's iteration follow
/// is different, so an inner `RuleRef` would otherwise inadvertently
/// target a variant computed from the wrong follow set.
fn gen_scan_repeat(w: &mut CodeWriter, rep: &RepeatElement, ctx: &mut GenContext, fail_stmt: &String) {
    let saved_call_follow = ctx.ruleref_call_follow;
    ctx.ruleref_call_follow = [];
    gen_scan_repeat_body(w, rep, ctx, fail_stmt);
    ctx.ruleref_call_follow = saved_call_follow;
}

fn gen_scan_repeat_body(w: &mut CodeWriter, rep: &RepeatElement, ctx: &mut GenContext, fail_stmt: &String) {
    let mut visiting: Array<String> = [];
    let inner_first = ctx.first_of_element(&rep.element, &mut visiting);

    // Follow-aware variant emission: subtract `current_follow_mask`
    // from the loop / optional-fire condition so tokens the caller
    // claims do not get greedily consumed here. For Plus the
    // mandatory first iteration is unaffected (Plus must consume ≥1).
    let loop_first = if ctx.current_follow_mask.is_empty() {
        inner_first;
    } else {
        subtract_sets(&inner_first, &ctx.current_follow_mask);
    };

    if let Optional = rep.kind {
        // If the optional's inner has nested optionals (e.g.
        // `( (schema '.')? table '.' )?`), plain first-set dispatch
        // is unsound: the inner optional may greedily fire and cause
        // the outer sequence to fail without trying the shorter shape.
        // Mirror the parse side's LL(k) shape dispatch.
        if has_nested_optionals(&rep.element) {
            if let Group(g) = &rep.element {
                gen_scan_optional_with_lookahead(w, &g.alternatives[0].elements, ctx);
                return;
            }
        }
        if loop_first.is_empty() {
            // Optional fully suppressed by follow mask.
            return;
        }
        let check = ctx.kind_check_str(&loop_first, "tokens[pos].kind");
        w.begin(`if pos < tokens.len() && {check}`);
        w.line("let sp = pos;");
        gen_scan_element_assign(w, &rep.element, ctx);
        w.line("if pos < 0 { pos = sp; }");
        w.end();
        return;
    }
    if let Star = rep.kind {
        if loop_first.is_empty() {
            return;
        }
        let check = ctx.kind_check_str(&loop_first, "tokens[pos].kind");
        w.begin(`while pos < tokens.len() && {check}`);
        w.line("let sp = pos;");
        gen_scan_element_assign(w, &rep.element, ctx);
        // Stop on failure or on 0-advance (lenient inner scan would loop).
        w.line("if pos < 0 { pos = sp; break; }");
        w.line("if pos == sp { break; }");
        w.end();
        return;
    }
    if let Plus = rep.kind {
        // First iteration is mandatory: its failure goes through fail_stmt.
        // The follow mask must NOT suppress it — Plus is `≥1`.
        gen_scan_element(w, &rep.element, ctx, fail_stmt);
        if loop_first.is_empty() {
            return;
        }
        let check = ctx.kind_check_str(&loop_first, "tokens[pos].kind");
        w.begin(`while pos < tokens.len() && {check}`);
        w.line("let sp = pos;");
        gen_scan_element_assign(w, &rep.element, ctx);
        w.line("if pos < 0 { pos = sp; break; }");
        w.line("if pos == sp { break; }");
        w.end();
        return;
    }
}

/// Scan-side twin of `gen_optional_with_lookahead`. Enumerates 2^n
/// shape combinations of the optional's inner elements (longest first)
/// and emits an if/else-if chain that picks the first shape whose
/// per-position lookahead matches.
///
/// Each shape body is wrapped in a labeled block so that an inner
/// element failure (`pos = -1`) short-circuits the shape instead of
/// executing later elements at a bogus `pos`.
fn gen_scan_optional_with_lookahead(w: &mut CodeWriter, group_elements: &Array<Element>, ctx: &mut GenContext) {
    let shapes = compute_shapes(group_elements);

    let mut is_first = true;
    for let mut si = 0; si < shapes.len(); si += 1 {
        let shape = &shapes[si];
        let sig = shape_lookahead_signature(shape, group_elements, ctx);
        if sig.len() == 0 {
            continue;
        }
        let cond = gen_scan_lookahead_condition(ctx, &sig);

        if is_first {
            w.begin(`if {cond}`);
            is_first = false;
        } else {
            w.else_begin(`else if {cond}`);
        }

        let gc = SCAN_GROUP_COUNTER;
        SCAN_GROUP_COUNTER += 1;
        let shape_label = `sol_{gc}`;
        let fail = `break {shape_label};`;
        w.begin(`{shape_label}:`);
        for let mut k = 0; k < shape.len(); k += 1 {
            let idx = shape[k];
            let elem = &group_elements[idx];
            let actual = unwrap_optional(elem);
            if let Group(g) = actual {
                if g.alternatives.len() == 1 {
                    for let mut j = 0; j < g.alternatives[0].elements.len(); j += 1 {
                        gen_scan_element(w, &g.alternatives[0].elements[j], ctx, &fail);
                    }
                } else {
                    gen_scan_element(w, actual, ctx, &fail);
                }
            } else {
                gen_scan_element(w, actual, ctx, &fail);
            }
        }
        w.end();
    }
    if !is_first {
        w.end();
    }
}

/// Scan-side twin of `gen_lookahead_condition`. Uses
/// `tokens[pos + d].kind` (guarded by `pos + d < tokens.len()`) instead
/// of `p.peek_at(d)`. Multi-token sets route through
/// `ctx.kind_check_str` so they collapse to a `_gale_kind_set_<id>(...)`
/// helper call; otherwise a 120-keyword set inlined at every dispatch
/// site bloats the generated wasm by hundreds of KB.
fn gen_scan_lookahead_condition(ctx: &mut GenContext, sig: &Array<Array<String>>) -> String {
    let mut parts: Array<String> = [];
    for let mut d = 0; d < sig.len(); d += 1 {
        let kinds = &sig[d];
        let idx_expr = if d == 0 { `pos` } else { `pos + {d}` };
        let check_expr = `tokens[{idx_expr}].kind`;
        let guard = `{idx_expr} < tokens.len()`;
        let check = ctx.kind_check_str(kinds, &check_expr);
        parts.push(`{guard} && {check}`);
    }
    let mut result = String::with_capacity(128);
    for let mut i = 0; i < parts.len(); i += 1 {
        if i > 0 {
            result.push_str(" && ");
        }
        result.push_str(parts[i]);
    }
    return result;
}

/// Generate scan code for a single element, emitting `fail_stmt` on failure.
/// Pass `&"return -1;"` for the top-level scan entry point, or
/// `&\`break {label};\`` inside a labeled block.
fn gen_scan_element(w: &mut CodeWriter, elem: &Element, ctx: &mut GenContext, fail_stmt: &String) {
    if let Label(lab) = elem {
        gen_scan_element(w, &lab.element, ctx, fail_stmt);
        return;
    }
    if let TokenRef(t) = elem {
        let const_name = `TK_{t.name}`;
        w.line(`if pos >= tokens.len() || tokens[pos].kind != {const_name} \{ {*fail_stmt} \}`);
        w.line("pos += 1;");
        return;
    }
    if let Literal(l) = elem {
        let const_name = literal_const_name(&l.text);
        w.line(`if pos >= tokens.len() || tokens[pos].kind != {const_name} \{ {*fail_stmt} \}`);
        w.line("pos += 1;");
        return;
    }
    if let RuleRef(r) = elem {
        // Always pass min_prec — non-LR `scan_<rule>` accept and ignore it.
        // bt-scan sets `ctx.scan_ruleref_min_prec` to `i32::MAX` so any LR
        // suffix loop in the target rule short-circuits.
        let follow = ctx.ruleref_call_follow;
        let variant_id = if follow.is_empty() { null } else { ctx.intern_follow_variant(&r.name, &follow, true) };
        let call = if let Some(id) = variant_id {
            `scan_{r.snake_name}__follow_{id}(tokens, pos, {ctx.scan_ruleref_min_prec})`;
        } else {
            `scan_{r.snake_name}(tokens, pos, {ctx.scan_ruleref_min_prec})`;
        };
        w.line(`pos = {call};`);
        w.line(`if pos < 0 \{ {*fail_stmt} \}`);
        return;
    }
    if let Wildcard(_) = elem {
        w.line(`if pos >= tokens.len() || tokens[pos].kind == TK_EOF \{ {*fail_stmt} \}`);
        w.line("pos += 1;");
        return;
    }
    if let Not(ne) = elem {
        let check = not_scan_check(&ne.element);
        w.line(`if pos >= tokens.len() || tokens[pos].kind == TK_EOF || {check} \{ {*fail_stmt} \}`);
        w.line("pos += 1;");
        return;
    }
    if let Repeat(rep) = elem {
        gen_scan_repeat(w, rep, ctx, fail_stmt);
        return;
    }
    if let Group(g) = elem {
        gen_scan_group(w, &g.alternatives, ctx, fail_stmt, is_lenient_group(&g.alternatives));
        return;
    }
}

/// Emit scan code for an element that assigns to `pos` (may set -1 on failure).
/// Used inside optional/repetition blocks where failure means "skip this
/// iteration / branch", not abort.
fn gen_scan_element_assign(w: &mut CodeWriter, elem: &Element, ctx: &mut GenContext) {
    if let Label(lab) = elem {
        gen_scan_element_assign(w, &lab.element, ctx);
        return;
    }
    if let TokenRef(t) = elem {
        let const_name = `TK_{t.name}`;
        w.line(`if pos >= tokens.len() || tokens[pos].kind != {const_name} \{ pos = -1; \} else \{ pos += 1; \}`);
        return;
    }
    if let Literal(l) = elem {
        let const_name = literal_const_name(&l.text);
        w.line(`if pos >= tokens.len() || tokens[pos].kind != {const_name} \{ pos = -1; \} else \{ pos += 1; \}`);
        return;
    }
    if let RuleRef(r) = elem {
        w.line(`pos = scan_{r.snake_name}(tokens, pos, {ctx.scan_ruleref_min_prec});`);
        return;
    }
    if let Wildcard(_) = elem {
        w.line("if pos >= tokens.len() || tokens[pos].kind == TK_EOF { pos = -1; } else { pos += 1; }");
        return;
    }
    if let Not(ne) = elem {
        let check = not_scan_check(&ne.element);
        w.line(`if pos >= tokens.len() || tokens[pos].kind == TK_EOF || {check} \{ pos = -1; \} else \{ pos += 1; \}`);
        return;
    }
    if let Group(g) = elem {
        // Rep body: must be strict so a 0-advance iteration doesn't infinite-loop.
        gen_scan_group(w, &g.alternatives, ctx, &"pos = -1;", false);
        return;
    }
    if let Repeat(rep) = elem {
        gen_scan_repeat(w, rep, ctx, &"pos = -1;");
        return;
    }
}

/// Build a scan-time check expression for `~ X`. Returns "tokens[pos].kind == TK_X"
/// or "(tokens[pos].kind == TK_A || tokens[pos].kind == TK_B)" for a set.
fn not_scan_check(inner: &Element) -> String {
    if let TokenRef(t) = inner {
        let const_name = `TK_{t.name}`;
        return `tokens[pos].kind == {const_name}`;
    }
    if let Literal(l) = inner {
        let const_name = literal_const_name(&l.text);
        return `tokens[pos].kind == {const_name}`;
    }
    if let Group(g) = inner {
        let mut kinds: Array<String> = [];
        if collect_not_set_tokens(&g.alternatives, &mut kinds) {
            let mut out = String::with_capacity(64);
            out.push('(');
            for let mut i = 0; i < kinds.len(); i += 1 {
                if i > 0 {
                    out.push_str(" || ");
                }
                out.push_str(`tokens[pos].kind == {kinds[i]}`);
            }
            out.push(')');
            return out;
        }
    }
    panic("not_scan_check: unsupported inner element for parser-side ~");
    return "";
}

global mut SCAN_GROUP_COUNTER: i32 = 0;

/// Generate scan code for a Group (choice of alternatives).
/// `fail_stmt` is emitted when the group exhausts all alternatives without a
/// match. Typical values:
///   - "return -1;"  → top-level scan context (abort whole scan fn)
///   - "break LBL;"  → nested inside a labeled try/alt block
///   - "pos = -1;"   → assign context (caller checks `pos < 0` afterward)
/// When `lenient` is true, the group succeeds with pos unchanged if no
/// alternative matches (mirrors the parse-side `Option<T> = null` fallback
/// emitted by `gen_consume_group_store_optional` / `gen_general_group_store_optional`).
/// Use lenient=true only in contexts that cannot infinite-loop on 0-advance
/// success (main alt body); use lenient=false inside repeat bodies and rep guards.
fn gen_scan_group(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext, fail_stmt: &String, lenient: bool) {
    if alts.len() == 1 {
        // Single alt: outer `done` wraps inner `body`.
        //   sg_N_done: { sg_N: { ...; break sg_N_done; } fail_stmt; }
        // Element failure → break sg_N, falls to fail_stmt.
        // Success → break sg_N_done, skips fail_stmt.
        let gc = SCAN_GROUP_COUNTER;
        SCAN_GROUP_COUNTER += 1;
        let body = `sg_{gc}`;
        let done = `sg_{gc}_done`;
        let save_var = `sg_{gc}_save`;
        if lenient {
            w.line(`let {save_var} = pos;`);
        }
        w.begin(`{done}:`);
        w.begin(`{body}:`);
        gen_scan_elements_in_block(w, &alts[0].elements, 0, alts[0].elements.len(), ctx, &body);
        w.line(`break {done};`);
        w.end();
        if lenient {
            w.line(`pos = {save_var};`);
        } else {
            w.line(*fail_stmt);
        }
        w.end();
        return;
    }
    // Multi-alternative group: try each alternative, fall through to fail.
    let gc = SCAN_GROUP_COUNTER;
    SCAN_GROUP_COUNTER += 1;
    let outer = `sg_{gc}`;
    let gp_var = `gp_{gc}`;
    let best_var = `sg_{gc}_best`;
    w.line(`let {gp_var} = pos;`);

    // Compute per-alt first-sets once for both the lenient gate and
    // ambiguity detection below.
    let n = alts.len();
    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    // Mirror the rule-level `gen_scan_multi_alt` longest-match dispatch:
    // when several alts share a first-token, the first-match winner may
    // advance a shorter distance than a later alt with the same prefix
    // (e.g. in `select_core` the FROM group `( table_or_subquery … | join_clause )`
    // both start with `table_or_subquery` but `join_clause` consumes further
    // when joins are present). Mark any alt that shares a first-token with
    // another as ambiguous; ambiguous alts record their advancement into
    // `best_var` and the group commits to the longest match at the end.
    // Non-ambiguous alts keep the cheap `break {outer}` fast path since
    // their first-token uniquely identifies them.
    let mut is_ambiguous: Array<bool> = [];
    for let mut i = 0; i < n; i += 1 {
        is_ambiguous.push(false);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = 0; j < n; j += 1 {
            if i == j {
                continue;
            }
            if sets_overlap(&first_sets[i], &first_sets[j]) {
                is_ambiguous[i] = true;
                is_ambiguous[j] = true;
            }
        }
    }
    let mut any_ambiguous = false;
    for let mut i = 0; i < n; i += 1 {
        if is_ambiguous[i] {
            any_ambiguous = true;
        }
    }

    // For lenient groups, mirror the parse-side first-set gate: if peek is not
    // in any alt's first set, skip the try-each-alt block without advancing.
    // This keeps scan_X consistent with parse_X (both 0-advance when no alt
    // fires), so rep-scan-guard's require_advance check can detect stalls.
    let mut union_first: Array<String> = [];
    if lenient {
        for let fs of &first_sets {
            dedup_append_arr(&mut union_first, fs);
        }
    }
    let gate_emitted = lenient && union_first.len() > 0;
    if gate_emitted {
        let sgk_var = `sgk_{gc}`;
        w.line(`let {sgk_var} = if pos < tokens.len() \{ tokens[pos].kind \} else \{ TK_EOF \};`);
        let gate = ctx.kind_check_str(&union_first, &sgk_var);
        w.begin(`if {gate}`);
    }

    if any_ambiguous {
        w.line(`let mut {best_var} = -1;`);
    }

    w.begin(`{outer}:`);
    for let mut i = 0; i < n; i += 1 {
        let alt = &alts[i];
        let inner = `sg_{gc}_{i}`;
        w.line(`pos = {gp_var};`);
        w.begin(`{inner}:`);
        gen_scan_elements_in_block(w, &alt.elements, 0, alt.elements.len(), ctx, &inner);
        if is_ambiguous[i] {
            w.line(`if pos > {best_var} \{ {best_var} = pos; \}`);
        } else {
            w.line(`break {outer};`);
        }
        w.end();
    }
    if any_ambiguous {
        w.line(`if {best_var} >= 0 \{ pos = {best_var}; break {outer}; \}`);
    }
    if lenient {
        w.line(`pos = {gp_var};`);
    } else {
        w.line(*fail_stmt);
    }
    w.end();  // close outer labeled block

    if gate_emitted {
        w.end();  // close the first-set gate
    }
}

/// True iff the parse side dispatches `Group(alts)` leniently (produces
/// `Option<T> = null` on no match rather than failing). Mirrors the if-chain
/// in `gen_element` at the Group branch: simple-cst and general groups use
/// the Option wrapper; token-only and single-alt groups do not.
fn is_lenient_group(alts: &Array<Alternative>) -> bool {
    return is_simple_cst_group(alts) || is_general_group(alts);
}

fn gen_parse_fn(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, ctx: &mut GenContext) {
    // Phase 4 — dispatch on the GIR `Rule` variant. Each shape gets
    // its own focused emit entry; the existing internal helpers
    // carry the body emission but no longer need to re-classify
    // the rule from surface IR.
    let fn_name = `parse_{rule.snake_name}`;
    let scan_fn_name = `scan_{rule.snake_name}`;
    match *lowered_rule {
        Simple(_) => gen_parse_fn_simple_named(w, rule, lowered_rule, ctx, &fn_name, /*emit_visibility=*/ true),
        MultiAlt(_) | LeftRecursive(_) => gen_parse_fn_named(w, rule, lowered_rule, ctx, &fn_name, &scan_fn_name, /*emit_visibility=*/ true),
    };
}

/// Body emitter for a single-alt rule, parameterised by function
/// name so the follow-aware variant pass can reuse it with
/// `parse_<rule>__follow_<id>`. No internal classification — the
/// caller already committed to the Simple shape.
///
/// `lowered_rule` is the corresponding `Rule::Simple` (or a
/// `Rule::MultiAlt` / `Rule::LeftRecursive` in the variant-emission
/// path where we still route through `gen_parse_fn_named` and the
/// alt-len-1 shortcut lands here). `rule_alt_body` resolves the
/// single AltBody whose `fields` drives the struct-literal field
/// assignments emitted after the alt body.
fn gen_parse_fn_simple_named(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, ctx: &mut GenContext, fn_name: &String, emit_visibility: bool) {
    ctx.current_rule_name = rule.name;
    ctx.group_counter = 0;
    let type_name = rule_type_name(&rule.name);
    if emit_visibility {
        gen_visibility_comment(w, &rule.visibility);
    }

    // Single-alt rules have exactly one alt, so the `alt_gc_starts`
    // entry is `[0]`. Keep the field set for compatibility with any
    // helpers that consult it.
    ctx.alt_gc_starts = [0];

    let mut f = FnSpec::new(fn_name);
    f.add_param("p", "&mut Parser");
    f.set_return_type(`Result<{type_name}, ParseError>`);
    f.emit_begin(w);
    w.line("let start = p.peek().span.start;");
    let body = rule_alt_body(lowered_rule, 0).unwrap();
    gen_alt_body(w, &type_name, null, null, &rule.alternatives[0], body, ctx);
    w.end();
    w.blank();
}


/// Body emitter shared by `gen_parse_fn` and the follow-aware variant
/// pass. The variant pass calls this with `fn_name = parse_<rule>__follow_<id>`
/// after setting `ctx.current_follow_mask` and `ctx.current_outer_follow`
/// to the variant's mask, so the regular emit path produces the variant's
/// body unmodified — the mask drives tail-greedy suppression in
/// `gen_*_repeat` and the outer follow drives variant selection at inner
/// `RuleRef` sites without any duplicate code.
///
/// `emit_visibility` is `false` for variant emission to suppress the
/// `pub`/`export` doc comment on the variant function (variants are
/// implementation details, not part of the rule's exposed surface).
fn gen_parse_fn_named(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, ctx: &mut GenContext, fn_name: &String, scan_fn_name: &String, emit_visibility: bool) {
    // Variant emission and the (legacy) single shared dispatch route
    // through here. Single-alt rules are handled by the dedicated
    // \`gen_parse_fn_simple_named\` so the heavy multi-alt + LR setup
    // below doesn't run for the trivial shape.
    if rule.alternatives.len() == 1 {
        gen_parse_fn_simple_named(w, rule, lowered_rule, ctx, fn_name, emit_visibility);
        return;
    }

    ctx.current_rule_name = rule.name;
    ctx.group_counter = 0;
    let type_name = rule_type_name(&rule.name);
    if emit_visibility {
        gen_visibility_comment(w, &rule.visibility);
    }

    // Precompute the starting group counter for each alternative.
    // This matches the type gen which processes alts in index order.
    let mut alt_gc_starts: Array<i32> = [];
    let mut gc_running: i32 = 0;
    for let alt of &rule.alternatives {
        alt_gc_starts.push(gc_running);
        gc_running += count_general_groups(&alt.elements);
    }
    ctx.alt_gc_starts = alt_gc_starts;

    let case_names = case_names_for_rule(&rule.alternatives);

    let mut non_lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if !is_left_recursive(&rule.alternatives[i], &rule.name) {
            non_lr_indices.push(i);
        }
    }

    let mut first_sets: Array<Array<String>> = [];
    for let idx of non_lr_indices {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(&rule.alternatives[idx], &mut visiting));
    }
    let mut groups = compute_overlap_groups(&first_sets);
    let has_overlaps = has_multi_alt_groups(&groups);

    if has_overlaps {
        for let mut g = 0; g < groups.len(); g += 1 {
            if groups[g].len() > 1 {
                sort_group_by_specificity(&mut groups[g], &first_sets);
                let mut mapped_alts: Array<Alternative> = [];
                for let gi of groups[g] {
                    mapped_alts.push(rule.alternatives[non_lr_indices[gi]]);
                }
                let mut local_indices: Array<i32> = [];
                for let mut i = 0; i < groups[g].len(); i += 1 {
                    local_indices.push(i);
                }
                sort_group_by_element_count(&mut local_indices, &mapped_alts);
                let mut reordered: Array<i32> = [];
                for let li of local_indices {
                    reordered.push(groups[g][li]);
                }
                groups[g] = reordered;
            }
        }
    }

    if has_overlaps {
        for let group of groups {
            if group.len() > 1 {
                for let gi of group {
                    let alt_idx = non_lr_indices[gi];
                    let alt = &rule.alternatives[alt_idx];
                    let sname = `{strip_suffix(&type_name, "Node")}{case_names[alt_idx]}`;
                    let helper_name = `{*fn_name}_bt_{alt_idx}`;

                    let mut f = FnSpec::new(&helper_name);
                    f.add_param("p", "&mut Parser");
                    f.set_return_type(`Result<{type_name}, ParseError>`);
                    f.emit_begin(w);
                    w.line("let start = p.peek().span.start;");
                    ctx.group_counter = ctx.alt_gc_starts[alt_idx];
                    let saved_prefix_prec = ctx.prefix_self_ref_min_prec;
                    ctx.prefix_self_ref_min_prec = compute_prefix_self_ref_min_prec(rule, alt_idx);
                    let body = rule_alt_body(lowered_rule, alt_idx).unwrap();
                    gen_alt_body(
                        w,
                        &type_name,
                        Option::<String>::Some(case_names[alt_idx]),
                        Option::<String>::Some(sname),
                        alt,
                        body,
                        ctx,
                    );
                    ctx.prefix_self_ref_min_prec = saved_prefix_prec;
                    w.end();
                    w.blank();

                    // Generate scan helper for this alternative if it has a
                    // scannable prefix (at least one scannable element before
                    // the first unscannable one).
                    gen_bt_scan_if_possible(w, alt, fn_name, alt_idx, ctx);
                }
            }
        }
    }

    let mut lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if is_left_recursive(&rule.alternatives[i], &rule.name) {
            lr_indices.push(i);
        }
    }
    let has_lr = lr_indices.len() > 0;

    if has_lr {
        let atom_name = `{*fn_name}_atom`;
        let mut f = FnSpec::new(&atom_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        if has_overlaps {
            gen_multi_alt_body_bt(w, rule, lowered_rule, &type_name, ctx, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(w, rule, lowered_rule, &type_name, ctx, &non_lr_indices);
        }
        w.end();
        w.blank();

        gen_lr_suffix_helpers(w, rule, &type_name, &lr_indices, ctx, fn_name);

        // Generate parse_rule(p, min_prec = 0) — precedence-aware parser.
        // Callers without a precedence context omit min_prec and get 0.
        let mut f2 = FnSpec::new(fn_name);
        f2.add_param("p", "&mut Parser");
        f2.add_param_spec(ParamSpec {
            name: "min_prec",
            type_str: "i32",
            default_value: Option::<String>::Some("0"),
        });
        f2.set_return_type(`Result<{type_name}, ParseError>`);
        f2.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        w.line(`let mut result = {*fn_name}_atom(p)?;`);
        gen_lr_suffix_dispatch(w, rule, &type_name, &lr_indices, ctx, true, fn_name, scan_fn_name);
        w.line(`return Result::<{type_name}, ParseError>::Ok(result);`);
        w.end();
        w.blank();
    } else {
        let mut f = FnSpec::new(fn_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        if has_overlaps {
            gen_multi_alt_body_bt(w, rule, lowered_rule, &type_name, ctx, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(w, rule, lowered_rule, &type_name, ctx, &non_lr_indices);
        }
        w.end();
        w.blank();
    }
}

/// Emit the `span:` field for a constructed AST node. The end is
/// clamped at `start` so a zero-token alt (every element nullable
/// and absent) doesn't synthesise a reversed span when `last_end()`
/// reflects the previous token. Used at every parse-side
/// rule/variant emit site.
fn emit_clamped_span_field(w: &mut CodeWriter) {
    w.line("span: Span::new(start, i32::max(start, p.last_end())),");
}

fn gen_alt_body(w: &mut CodeWriter, type_name: &String, variant_case: Option<String>, struct_name: Option<String>, alt: &Alternative, body: &AltBody, ctx: &mut GenContext) {
    let gc_start = ctx.group_counter;
    gen_alt_elements(w, &alt.elements, &body.ops, ctx);

    ctx.group_counter = gc_start;
    if let Some(case) = variant_case {
        let sname = struct_name.unwrap();
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case}({sname} \{`);
        w.indent();
        emit_clamped_span_field(w);
        emit_field_assignments_from_fields(w, &body.fields);
        w.dedent();
        w.line("}));");
    } else {
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name} \{`);
        w.indent();
        emit_clamped_span_field(w);
        emit_field_assignments_from_fields(w, &body.fields);
        w.dedent();
        w.line("});");
    }
}

/// Emit `{field.name},` for every entry in the alt body's
/// `FieldDecl` list, skipping the leading `Span` entry that
/// `emit_clamped_span_field` writes immediately before. `body.fields`
/// is lower's canonical struct shape (matches what
/// `codegen.wado::gen_cst_types` emits), so the struct literal stays
/// in lockstep with the type definition. Replaces the legacy surface-
/// IR walking `gen_field_assignments`.
fn emit_field_assignments_from_fields(w: &mut CodeWriter, fields: &Array<FieldDecl>) {
    for let mut i = 0; i < fields.len(); i += 1 {
        if let Span = &fields[i].kind {
            continue;
        }
        w.line(`{fields[i].name},`);
    }
}

fn gen_alt_body_skip(w: &mut CodeWriter, type_name: &String, variant_case: Option<String>, struct_name: Option<String>, alt: &Alternative, body: &AltBody, ctx: &mut GenContext, skip: i32) {
    let gc_start = ctx.group_counter;
    // Parse elements from `skip` onward (prefix already consumed).
    // Replay name counter for consumed elements so dedup_name stays in sync.
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < skip; i += 1 {
        replay_element_names(&alt.elements[i], &mut name_counts, ctx);
    }
    let saved_mask = ctx.current_follow_mask;
    let saved_call_follow = ctx.ruleref_call_follow;
    // `body.ops` skips the LR-stripped prefix self-ref, so its
    // indexing is offset from `alt.elements` by `skip` for LR suffix
    // bodies. For the BT (multi-alt prediction) path `skip > 0` is a
    // consumed-prefix offset rather than an LR strip — there the
    // surface alt and the lowered alt have 1:1 element correspondence
    // and `body.ops[i]` lines up with `alt.elements[i]`. Detect via
    // length: if `body.ops.len() == alt.elements.len()` the ops are
    // full-alt (BT path); otherwise they're a `lr_alts[k].suffix`
    // and `body.ops[k]` corresponds to `alt.elements[skip + k]`.
    let ops_offset = if body.ops.len() == alt.elements.len() { 0 } else { skip };
    for let mut i = skip; i < alt.elements.len(); i += 1 {
        // Same per-position threading as `gen_alt_elements`: the
        // variant mask flows down into a tail-position element only
        // when this position itself is the alt's tail (i.e. every
        // sibling after it is deep-nullable). Otherwise the mask is
        // cleared so a non-tail `Repeat` here does not accidentally
        // suppress on the variant's caller-follow.
        ctx.current_follow_mask = if ctx.tail_is_nullable_deep(&alt.elements, i + 1) {
            saved_mask
        } else {
            []
        };
        ctx.ruleref_call_follow = compute_ruleref_call_follow(&alt.elements, i, ctx);
        let elem = &alt.elements[i];
        let op = &body.ops[i - ops_offset];
        if let Repeat(rep) = elem {
            if let Optional = rep.kind {
                if is_ruleref_optional(&rep.element) {
                    let follow = ctx.first_of_elements_from(&alt.elements, i + 1);
                    gen_repeat_with_follow(w, rep, ctx, &follow, &mut name_counts);
                } else {
                    let follow = ctx.first_of_elements_from(&alt.elements, i + 1);
                    gen_repeat(w, rep, ctx, &mut name_counts, &follow);
                }
            } else if rep.non_greedy {
                let follow = ctx.first_of_elements_from(&alt.elements, i + 1);
                let follow_second = compute_follow_second(&alt.elements, i + 1, ctx);
                gen_repeat_non_greedy(w, rep, ctx, &follow, &follow_second, &mut name_counts);
            } else {
                let follow = ctx.first_of_elements_from(&alt.elements, i + 1);
                gen_repeat(w, rep, ctx, &mut name_counts, &follow);
            }
        } else if op_is_leaf(op) {
            gen_op_leaf(w, op, elem, ctx, &mut name_counts);
        } else if let ListLabel(ll) = op {
            gen_op_list_label(w, ll, elem, ctx, &mut name_counts);
        } else if let Group(g_op) = op {
            gen_op_group(w, g_op, elem, ctx, &mut name_counts);
        } else {
            gen_element(w, elem, ctx, &mut name_counts);
        }
        ctx.ruleref_call_follow = [];
    }
    ctx.current_follow_mask = saved_mask;
    ctx.ruleref_call_follow = saved_call_follow;

    ctx.group_counter = gc_start;
    if let Some(case) = variant_case {
        let sname = struct_name.unwrap();
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case}({sname} \{`);
        w.indent();
        emit_clamped_span_field(w);
        emit_field_assignments_from_fields(w, &body.fields);
        w.dedent();
        w.line("}));");
    } else {
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name} \{`);
        w.indent();
        emit_clamped_span_field(w);
        emit_field_assignments_from_fields(w, &body.fields);
        w.dedent();
        w.line("});");
    }
}

fn gen_multi_alt_body(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, type_name: &String, ctx: &mut GenContext, non_lr_indices: &Array<i32>) {
    let case_names = case_names_for_rule(&rule.alternatives);

    let max_k = 5;
    let mut all_pos_sets: Array<Array<Array<String>>> = [];
    for let idx of non_lr_indices {
        all_pos_sets.push(ctx.alt_position_first_sets(&rule.alternatives[*idx], max_k));
    }
    let depth = find_needed_depth(&all_pos_sets);

    w.line("let kind = p.peek_kind();");

    for let mut i = 0; i < non_lr_indices.len(); i += 1 {
        let alt_idx = non_lr_indices[i];
        let alt = &rule.alternatives[alt_idx];
        let sname = `{strip_suffix(type_name, "Node")}{case_names[alt_idx]}`;

        let pos_sets = &all_pos_sets[i];
        let cond_depth = if depth < pos_sets.len() { depth } else { pos_sets.len() };

        if cond_depth > 0 {
            let cond = build_lookahead_condition(ctx, pos_sets, cond_depth);
            w.begin(`if {cond}`);
        } else {
            w.begin("scope:");
        }

        ctx.group_counter = ctx.alt_gc_starts[alt_idx];
        let saved_prefix_prec = ctx.prefix_self_ref_min_prec;
        ctx.prefix_self_ref_min_prec = compute_prefix_self_ref_min_prec(rule, alt_idx);
        let body = rule_alt_body(lowered_rule, alt_idx).unwrap();
        gen_alt_body(
            w,
            type_name,
            Option::<String>::Some(case_names[alt_idx]),
            Option::<String>::Some(sname),
            alt,
            body,
            ctx,
        );
        ctx.prefix_self_ref_min_prec = saved_prefix_prec;
        w.end();
    }

    gen_error_fallback(w, rule, type_name, ctx);
}

fn gen_alt_elements(w: &mut CodeWriter, elements: &Array<Element>, ops: &Array<Op>, ctx: &mut GenContext) {
    let saved_mask = ctx.current_follow_mask;
    let saved_call_follow = ctx.ruleref_call_follow;
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        ctx.current_follow_mask = if ctx.tail_is_nullable_deep(elements, i + 1) { saved_mask } else { [] };
        ctx.ruleref_call_follow = compute_ruleref_call_follow(elements, i, ctx);
        let elem = &elements[i];
        let op = &ops[i];
        if let Repeat(rep) = elem {
            if let Optional = rep.kind {
                if is_ruleref_optional(&rep.element) {
                    let follow = ctx.first_of_elements_from(elements, i + 1);
                    gen_repeat_with_follow(w, rep, ctx, &follow, &mut name_counts);
                } else {
                    let follow = ctx.first_of_elements_from(elements, i + 1);
                    gen_repeat(w, rep, ctx, &mut name_counts, &follow);
                }
            } else if rep.non_greedy {
                let follow = ctx.first_of_elements_from(elements, i + 1);
                let follow_second = compute_follow_second(elements, i + 1, ctx);
                gen_repeat_non_greedy(w, rep, ctx, &follow, &follow_second, &mut name_counts);
            } else {
                let follow = ctx.first_of_elements_from(elements, i + 1);
                gen_repeat(w, rep, ctx, &mut name_counts, &follow);
            }
        } else if op_is_leaf(op) {
            // Lower has resolved every leaf op (field name, token kind,
            // variant id, min-prec) — emit reads them verbatim. The
            // surface `gen_element` is bypassed for leaves at this
            // top-level walker; group bodies and label / not cases still
            // route through `gen_element` in their unmigrated helpers.
            gen_op_leaf(w, op, elem, ctx, &mut name_counts);
        } else {
            gen_element(w, elem, ctx, &mut name_counts);
        }
        ctx.ruleref_call_follow = [];
    }
    ctx.current_follow_mask = saved_mask;
    ctx.ruleref_call_follow = saved_call_follow;
}

fn gen_elements_with_non_greedy(w: &mut CodeWriter, elements: &Array<Element>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, outer_follow: &Array<String>) {
    let saved_call_follow = ctx.ruleref_call_follow;
    for let mut i = 0; i < elements.len(); i += 1 {
        // Per-position threading. The exact policy (immediate suffix's
        // first set, or — for first-exact deep-nullable suffixes —
        // unioned with `current_outer_follow`) lives in
        // `compute_ruleref_call_follow`; see its doc-comment for the
        // soundness argument.
        ctx.ruleref_call_follow = compute_ruleref_call_follow(elements, i, ctx);
        let elem = &elements[i];
        if let Repeat(rep) = elem {
            if rep.non_greedy {
                // follow(e_i) = first(e_{i+1..}) ∪ (outer_follow if suffix nullable)
                let mut follow = ctx.first_of_elements_from(elements, i + 1);
                if ctx.tail_is_nullable_deep(elements, i + 1) {
                    follow = union_sets(&follow, outer_follow);
                }
                let follow_second = compute_follow_second(elements, i + 1, ctx);
                gen_repeat_non_greedy(w, rep, ctx, &follow, &follow_second, name_counts);
            } else {
                let mut rep_follow = ctx.first_of_elements_from(elements, i + 1);
                if ctx.tail_is_nullable_deep(elements, i + 1) {
                    rep_follow = union_sets(&rep_follow, outer_follow);
                }
                gen_repeat(w, rep, ctx, name_counts, &rep_follow);
            }
        } else {
            gen_element(w, elem, ctx, name_counts);
        }
        ctx.ruleref_call_follow = [];
    }
    ctx.ruleref_call_follow = saved_call_follow;
}

fn is_ruleref_optional(elem: &Element) -> bool {
    if let RuleRef(_) = elem {
        return true;
    }
    if let Label(lab) = elem {
        return is_ruleref_optional(&lab.element);
    }
    return false;
}

/// True when the lowered op is a leaf shape that emit can render
/// directly from `op.field` / `op.kind` / `op.target_snake` /
/// `op.variant_id` / `op.min_prec_arg` — i.e. lower has resolved
/// every decision and the emit body is a single `let … = …?;` line.
/// Repeat / Group / ListLabel ops still flow through the surface-IR
/// helpers in this slice and will migrate in later (2) slices.
fn op_is_leaf(op: &Op) -> bool {
    return match op {
        Token(_) | Literal(_) | RuleCall(_) | Wildcard(_) | Excluded(_) => true,
        _ => false,
    };
}

/// Emit a single leaf-op parse line, reading the deduped field name
/// and resolved token / variant / min-prec values straight from
/// `Op`. Lower's `lower_alt_body` / `lower_label_op` / etc. have
/// already baked in dedup, follow-variant interning, and the
/// LR-prefix `min_prec` argument — emit does not re-derive any of
/// it. Counterpart of the leaf arms of `gen_element` for the surface
/// IR walker; that walker is still in use inside group bodies and
/// Label / Not cases, but the top-level alt walkers
/// (`gen_alt_elements`, the body loop of `gen_alt_body_skip`)
/// dispatch leaves here instead.
///
/// `elem` is the matching surface element. We only consult it to
/// run `dedup_name` for its side effect — keeping `name_counts` in
/// sync with lower's dedup state so any sibling that still flows
/// through `gen_element` sees the correct count. The emitted field
/// name comes from `op` exclusively. The side effect goes away once
/// every emit path consumes `Op` (later (2) slices).
fn gen_op_leaf(w: &mut CodeWriter, op: &Op, elem: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    sync_name_counts_for_leaf(elem, name_counts);
    return match *op {
        Token(t) => w.line(`let {t.field} = p.expect({t.kind})?;`),
        Literal(l) => w.line(`let {l.field} = p.expect({l.kind})?;`),
        RuleCall(r) => {
            let fn_name = if let Some(id) = r.variant_id {
                `parse_{r.target_snake}__follow_{id}`;
            } else {
                `parse_{r.target_snake}`;
            };
            // The LR-atom prefix path (e.g. unary `'-' e` in
            // `e : e '+' e | '-' e | …`) needs a `min_prec` argument
            // on the inner self-ref so the LR loop climbs from the
            // unary's own precedence. lower's `lower_op` does not see
            // the LR context — `ctx.prefix_self_ref_min_prec` is set
            // by `gen_parse_fn_named` per alt — so emit reads it here
            // for self-recursive RuleCalls. `RuleCallOp.min_prec_arg`
            // remains the canonical override for non-LR call sites
            // that need an explicit `0` (today none of them do).
            let use_prec = ctx.prefix_self_ref_min_prec > 0 && r.target_name == ctx.current_rule_name;
            if use_prec {
                w.line(`let {r.field} = {fn_name}(p, {ctx.prefix_self_ref_min_prec})?;`);
            } else if let Some(min_prec) = r.min_prec_arg {
                w.line(`let {r.field} = {fn_name}(p, {min_prec})?;`);
            } else {
                w.line(`let {r.field} = {fn_name}(p)?;`);
            }
        },
        Wildcard(wop) => w.line(`let {wop.field} = p.match_any()?;`),
        Excluded(eop) => w.line(`let {eop.field} = {emit_op_excluded_call(eop)}?;`),
        _ => panic("gen_op_leaf: non-leaf op; check op_is_leaf before calling"),
    };
}

/// Bump `name_counts` for `elem` exactly the way `gen_element` would.
/// Used by `gen_op_leaf` so siblings that still route through the
/// surface walker see lower-consistent dedup state. Mirrors the
/// `dedup_name(&base, name_counts)` calls in the leaf arms of
/// `gen_element` and the surface-IR `Label` / `Not` recursions.
fn sync_name_counts_for_leaf(elem: &Element, name_counts: &mut Array<[String, i32]>) {
    if let TokenRef(t) = elem {
        let _ = dedup_name(&t.field_name, name_counts);
        return;
    }
    if let Literal(l) = elem {
        let _ = dedup_name(&literal_field_name(&l.text), name_counts);
        return;
    }
    if let RuleRef(r) = elem {
        let _ = dedup_name(&r.field_name, name_counts);
        return;
    }
    if let Wildcard(_) = elem {
        let _ = dedup_name(&"wildcard", name_counts);
        return;
    }
    if let Not(ne) = elem {
        let _ = dedup_name(&not_element_field_name(&ne.element), name_counts);
        return;
    }
    if let Label(lab) = elem {
        // Scalar label `name = elem` (list labels lower to
        // `Op::ListLabel` which is not a leaf and never reaches here).
        // Both the label's own binding and the inner emission update
        // the count, so mirror that here.
        let _ = dedup_name(&lab.field_name, name_counts);
        sync_name_counts_for_leaf(&lab.element, name_counts);
    }
}

/// Top-level dispatch for `Op::Group(g_op)`. Reads `g_op.shape` to
/// pick the matching emit shape; reads the deduped field name and
/// struct / variant type names straight from the shape payload
/// instead of recomputing via `single_alt_group_type_name` /
/// `token_group_field_name` / etc. Inner element emission still
/// flows through surface `gen_elements_with_non_greedy` for now —
/// `gen_consume_*_op` helpers consult `g_op.alts[k].fields` for the
/// final struct-literal field list (GIR-canonical) but parse the
/// alt body via the surface walker that hasn't migrated yet.
///
/// `elem` is the matching `Element::Group(g_surface)`; the surface
/// reference flows into `gen_elements_with_non_greedy` and surface
/// dedup so siblings continue to see lower-consistent state. The
/// surface fallback in `gen_element`'s Group arm remains until every
/// caller routes through `gen_op_group` (Phase 2-B follow-ups).
fn gen_op_group(w: &mut CodeWriter, g_op: &GroupOp, elem: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    if let Group(g_elem) = elem {
        return match &g_op.shape {
            TokenOnly(to) => gen_consume_token_group_op(w, to, &g_elem.alternatives, name_counts),
            SingleAlt(sa) => gen_consume_single_alt_group_op(w, sa, &g_op.alts[0], &g_elem.alternatives[0], ctx, name_counts, &([] as Array<String>)),
            _ => {
                // The remaining shapes still need their dedicated
                // `_op` helpers; until then dispatch back to the
                // surface walker so behaviour is unchanged.
                if is_simple_cst_group(&g_elem.alternatives) {
                    gen_consume_group_store_optional(w, &g_elem.alternatives, ctx, name_counts);
                } else if is_general_group(&g_elem.alternatives) {
                    gen_general_group_store_optional(w, &g_elem.alternatives, ctx, name_counts);
                } else {
                    gen_consume_group(w, &g_elem.alternatives, ctx, name_counts);
                }
            },
        };
    } else {
        panic("gen_op_group: Group op mapped to non-Group element");
    }
}

/// Token-only group emit (`(K_A | K_B | …)`): `lower` matched the
/// shape and assigned the outer field name in
/// `TokenOnlyShape.field`. `alts` is unused here aside from the
/// surface-side `dedup_name` side-effect.
fn gen_consume_token_group_op(w: &mut CodeWriter, to: &TokenOnlyShape, alts: &Array<Alternative>, name_counts: &mut Array<[String, i32]>) {
    let _ = dedup_name(&token_group_field_name(alts), name_counts);
    w.line(`let {to.field} = p.advance();`);
}

/// Single-alt group emit `(e1 e2 …)`: parses each inner element and
/// then constructs the SingleAlt's CST struct. The outer field name
/// (`sa.field`) and struct type name (`sa.struct_name`) come from the
/// `SingleAltShape` payload; the struct-literal field list comes from
/// `body.fields` (lower's canonical list — `gen_cst_types` emits the
/// same shape). Inner element parsing still walks surface IR via
/// `gen_elements_with_non_greedy` for now; that walker migrates to
/// consume `body.ops` in a later (2) slice.
fn gen_consume_single_alt_group_op(w: &mut CodeWriter, sa: &SingleAltShape, body: &AltBody, alt: &Alternative, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, outer_follow: &Array<String>) {
    let _ = dedup_name(&single_alt_group_field_name(alt), name_counts);
    let saved_rule_name = ctx.current_rule_name;
    ctx.current_rule_name = ctx.general_group_rule_name(&sa.struct_name);
    let gc_start = ctx.group_counter;
    gen_elements_with_non_greedy(w, &alt.elements, ctx, name_counts, outer_follow);
    w.line(`let {sa.field} = {sa.struct_name} \{`);
    w.indent();
    ctx.group_counter = gc_start;
    emit_field_assignments_from_fields(w, &body.fields);
    w.dedent();
    w.line("};");
    ctx.current_rule_name = saved_rule_name;
}

/// Emit `name+=elem` outside a Repeat: allocate the array, parse the
/// inner op once, push the resulting binding. Lower stores the label
/// name in `ll.field` and the inner op in `ll.inner` (carrying its
/// own `field` already deduped against the label's fresh inner scope).
/// `elem` is the matching surface `Label(lab)` with `lab.list == true`
/// — consulted only by `sync_name_counts_for_label` to keep the
/// outer scope's dedup counters consistent with surface emitters that
/// still inspect `name_counts`.
fn gen_op_list_label(w: &mut CodeWriter, ll: &ListLabelOp, elem: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    if let Label(lab) = elem {
        sync_name_counts_for_list_label(lab, name_counts);
    } else {
        panic("gen_op_list_label: ListLabel op mapped to non-Label element");
    }
    let inner_type = op_field_type(&ll.inner);
    w.line(`let mut {ll.field}: Array<{inner_type}> = [];`);
    let inner_field = op_field(&ll.inner);
    if op_is_leaf(&ll.inner) {
        if let Label(lab) = elem {
            gen_op_leaf(w, &ll.inner, &lab.element, ctx, name_counts);
        } else {
            panic("gen_op_list_label: surface element is not a Label");
        }
    } else {
        panic("gen_op_list_label: non-leaf list-label inner is not yet migrated (Phase 2-B)");
    }
    w.line(`{ll.field}.push({inner_field});`);
}

/// Mirror `gen_element`'s Label arm side-effects on `name_counts`:
/// bump for the label's own name and recurse into the inner leaf so
/// any sibling that still routes through the surface walker observes
/// lower-consistent dedup state.
fn sync_name_counts_for_list_label(lab: &LabelElement, name_counts: &mut Array<[String, i32]>) {
    let _ = dedup_name(&lab.field_name, name_counts);
    sync_name_counts_for_leaf(&lab.element, name_counts);
}

/// Read the deduped field name from any `Op`. Mirrors the
/// `<variant>.field` lookups inlined throughout the emit body.
fn op_field(op: &Op) -> String {
    return match op {
        Token(t) => t.field,
        Literal(l) => l.field,
        RuleCall(r) => r.field,
        Wildcard(w) => w.field,
        Excluded(e) => e.field,
        Repeat(r) => r.field,
        Group(g) => match &g.shape {
            Transparent => panic("op_field: Transparent group has no own field"),
            TokenOnly(to) => to.field,
            SimpleCst(scst) => scst.field,
            SingleAlt(sa) => sa.field,
            General(gen) => gen.field,
        },
        ListLabel(ll) => ll.field,
    };
}

/// Type string the op contributes to its containing struct field.
/// Mirrors `element_field_info`'s second return value for the matching
/// surface element. Today this is consulted by `gen_op_list_label`'s
/// `Array<…>` declaration; other call sites read the FieldDecl directly.
fn op_field_type(op: &Op) -> String {
    return match op {
        Token(_) | Literal(_) | Wildcard(_) | Excluded(_) => "Token",
        RuleCall(r) => rule_type_name(&r.target_name),
        Group(g) => match &g.shape {
            SimpleCst(scst) => scst.type_name,
            TokenOnly(_) => "Token",
            SingleAlt(sa) => sa.struct_name,
            General(gen) => gen.variant_type,
            Transparent => panic("op_field_type: Transparent groups have no own field type"),
        },
        Repeat(_) => panic("op_field_type: Repeat ops do not surface as a single typed field at this site"),
        ListLabel(ll) => `Array<{op_field_type(&ll.inner)}>`,
    };
}

/// Render the `p.match_not([…])` expression for an `Op::Excluded`.
/// Lower interns multi-element exclusion sets via
/// `ctx.intern_kind_set`; if a future slice routes those through the
/// generated `_gale_kind_set_<id>_match_not` helper this is the
/// single call site to update.
fn emit_op_excluded_call(e: &ExcludedOp) -> String {
    let mut list = String::with_capacity(32);
    for let mut i = 0; i < e.kinds.len(); i += 1 {
        if i > 0 {
            list.push_str(", ");
        }
        list.push_str(e.kinds[i]);
    }
    return `p.match_not([{list}])`;
}

fn gen_element(w: &mut CodeWriter, elem: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    if let TokenRef(t) = elem {
        let const_name = `TK_{t.name}`;
        let field_name = dedup_name(&t.field_name, name_counts);
        w.line(`let {field_name} = p.expect({const_name})?;`);
        return;
    }
    if let Literal(l) = elem {
        let const_name = literal_const_name(&l.text);
        let display = `'{l.text}'`;
        let field_name = dedup_name(&literal_field_name(&l.text), name_counts);
        w.line(`let {field_name} = p.expect({const_name})?;`);
        return;
    }
    if let RuleRef(r) = elem {
        let field_name = dedup_name(&r.field_name, name_counts);
        let follow = ctx.ruleref_call_follow;
        // `prefix_self_ref_min_prec > 0` paths drive the LR climb — they
        // don't go through follow-aware variants in v1, since variant
        // emission only handles non-LR rules.
        let use_prec = ctx.prefix_self_ref_min_prec > 0 && r.name == ctx.current_rule_name;
        let variant_id = if !use_prec && !follow.is_empty() {
            ctx.intern_follow_variant(&r.name, &follow, false);
        } else {
            null;
        };
        let fn_name = if let Some(id) = variant_id {
            `parse_{r.snake_name}__follow_{id}`;
        } else {
            `parse_{r.snake_name}`;
        };
        if use_prec {
            w.line(`let {field_name} = {fn_name}(p, {ctx.prefix_self_ref_min_prec})?;`);
        } else {
            w.line(`let {field_name} = {fn_name}(p)?;`);
        }
        return;
    }
    if let Wildcard(_) = elem {
        let field_name = dedup_name(&"wildcard", name_counts);
        w.line(`let {field_name} = p.match_any()?;`);
        return;
    }
    if let Not(ne) = elem {
        let field_name = dedup_name(&not_element_field_name(&ne.element), name_counts);
        let check = not_match_call(&ne.element);
        w.line(`let {field_name} = {check}?;`);
        return;
    }
    if let Repeat(rep) = elem {
        gen_repeat(w, rep, ctx, name_counts, &([] as Array<String>));
        return;
    }
    if let Group(g) = elem {
        if is_simple_cst_group(&g.alternatives) {
            gen_consume_group_store_optional(w, &g.alternatives, ctx, name_counts);
        } else if is_token_only_group(&g.alternatives) {
            gen_consume_token_group(w, &g.alternatives, ctx, name_counts);
        } else if is_single_alt_group(&g.alternatives) {
            gen_consume_single_alt_group(w, &g.alternatives[0], ctx, name_counts, &([] as Array<String>));
        } else if is_general_group(&g.alternatives) {
            gen_general_group_store_optional(w, &g.alternatives, ctx, name_counts);
        } else {
            gen_consume_group(w, &g.alternatives, ctx, name_counts);
        }
        return;
    }
    if let Label(lab) = elem {
        if lab.list {
            // Bare list label: allocate the array, parse the inner element
            // once, and push. Repeats wrap this via gen_repeat below.
            let inner_info = element_field_info(&lab.element, ctx);
            let lab_name = dedup_name(&lab.field_name, name_counts);
            w.line(`let mut {lab_name}: Array<{inner_info.1}> = [];`);
            let predicted_inner = peek_dedup_name(&inner_info.0, name_counts);
            gen_element(w, &lab.element, ctx, name_counts);
            w.line(`{lab_name}.push({predicted_inner});`);
            return;
        }
        // Scalar label `name = element`: parse the inner element with the
        // shared `name_counts` so its emitted binding dedups against the
        // outer alt's scope (otherwise `a=e ... b=e` would emit two
        // top-level `let e = parse_e(p)?;` and the second would fail
        // compilation with "cannot redeclare e"). Then re-bind under the
        // label name so the struct initializer resolves.
        //
        // We need to know the dedup'd inner name to write the alias; peek
        // the dedup result before calling `gen_element`, which performs
        // the actual increment with the same base name.
        let lab_name = dedup_name(&lab.field_name, name_counts);
        let inner_info = element_field_info(&lab.element, ctx);
        let predicted_inner = peek_dedup_name(&inner_info.0, name_counts);
        gen_element(w, &lab.element, ctx, name_counts);
        w.line(`let {lab_name} = {predicted_inner};`);
        return;
    }
}

/// Predict what `dedup_name(base, counts)` would return without
/// incrementing the count. Used by the `Label` case in `gen_element` to
/// alias the inner element's emitted binding under the label name —
/// the inner emission performs the actual `dedup_name` (which both
/// computes and increments), and we need to know the resulting name
/// before that to emit the alias.
fn peek_dedup_name(base: &String, counts: &Array<[String, i32]>) -> String {
    let count = get_count(counts, base);
    if count > 0 {
        return `{base}_{count + 1}`;
    }
    return *base;
}

/// `ruleref_call_follow` is saved, cleared, and restored around the
/// emit body — see `gen_scan_repeat` for the rationale (the outer
/// alt walker's value is for the Repeat element's own position, not
/// the inner element's iteration follow).
fn gen_repeat(w: &mut CodeWriter, rep: &RepeatElement, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, outer_follow: &Array<String>) {
    let saved_call_follow = ctx.ruleref_call_follow;
    ctx.ruleref_call_follow = [];
    gen_repeat_body(w, rep, ctx, name_counts, outer_follow);
    ctx.ruleref_call_follow = saved_call_follow;
}

fn gen_repeat_body(w: &mut CodeWriter, rep: &RepeatElement, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, outer_follow: &Array<String>) {
    let inner = &rep.element;
    let mut visiting: Array<String> = [];
    let first = ctx.first_of_element(inner, &mut visiting);
    let mut visiting_scan: Array<String> = [];
    let scannable = ctx.is_element_scannable(inner, &mut visiting_scan);

    // Follow-aware variant emission: subtract `current_follow_mask`
    // from the iteration / optional-fire condition so tokens the
    // caller claims do not get greedily consumed here. For Plus the
    // first iteration is mandatory; the mask only narrows the loop.
    let loop_first = if ctx.current_follow_mask.is_empty() {
        first;
    } else {
        subtract_sets(&first, &ctx.current_follow_mask);
    };
    let mask_active = !ctx.current_follow_mask.is_empty() && loop_first.len() != first.len();

    // For Plus/Star with a single-alt Group inner, the body's "end-of-iteration
    // follow" is: first(group) (next iteration can start here) ∪ outer_follow
    // (the repeat can also exit). Non-greedy repeats at the tail of the group
    // need this to stop before the next iteration's first token.
    let iter_follow = compute_iter_follow(inner, &first, outer_follow);

    // `(items+=item)*` / `items+=item+` / `items+=item?` — the list label
    // already implies Array, so use the label name directly and push the
    // inner element on each iteration.
    if is_list_label(inner) {
        if let Label(lab) = inner {
            let inner_info = element_field_info(&lab.element, ctx);
            let lab_name = dedup_name(&lab.field_name, name_counts);
            w.line(`let mut {lab_name}: Array<{inner_info.1}> = [];`);
            if let Star = rep.kind {
                if scannable {
                    w.begin("loop");
                    let scan_pos_var = emit_rep_scan_guard(w, inner, ctx, name_counts);
                    w.line(`if {scan_pos_var} < 0 \{ break; \}`);
                    let mut nc: Array<[String, i32]> = [];
                    gen_element(w, &lab.element, ctx, &mut nc);
                    w.line(`{lab_name}.push({inner_info.0});`);
                    w.end();
                } else {
                    w.begin(`while {ctx.first_check_str(&first)}`);
                    let mut nc: Array<[String, i32]> = [];
                    gen_element(w, &lab.element, ctx, &mut nc);
                    w.line(`{lab_name}.push({inner_info.0});`);
                    w.end();
                }
            }
            if let Plus = rep.kind {
                if scannable {
                    let plus_flag = dedup_name(&"_plus_first", name_counts);
                    w.line(`let mut {plus_flag} = true;`);
                    w.begin("loop");
                    w.begin(`if !{plus_flag}`);
                    let scan_pos_var = emit_rep_scan_guard(w, inner, ctx, name_counts);
                    w.line(`if {scan_pos_var} < 0 \{ break; \}`);
                    w.end();
                    w.line(`{plus_flag} = false;`);
                    let mut nc: Array<[String, i32]> = [];
                    gen_element(w, &lab.element, ctx, &mut nc);
                    w.line(`{lab_name}.push({inner_info.0});`);
                    w.end();
                } else {
                    let plus_flag = dedup_name(&"_plus_first", name_counts);
                    w.line(`let mut {plus_flag} = true;`);
                    w.begin(`while {plus_flag} || {ctx.first_check_str(&first)}`);
                    w.line(`{plus_flag} = false;`);
                    let mut nc: Array<[String, i32]> = [];
                    gen_element(w, &lab.element, ctx, &mut nc);
                    w.line(`{lab_name}.push({inner_info.0});`);
                    w.end();
                }
            }
            if let Optional = rep.kind {
                w.begin(`if {ctx.first_check_str(&first)}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, &lab.element, ctx, &mut nc);
                w.line(`{lab_name}.push({inner_info.0});`);
                w.end();
            }
            return;
        }
    }

    if has_field(inner) {
        // Save counter before element_field_info, which may increment it for
        // general groups. The generation functions (gen_group_store_any, etc.)
        // also increment the counter, so we restore before calling them to
        // avoid double-counting.
        let gc_before = ctx.group_counter;
        let field_info = element_field_info(inner, ctx);
        let is_group_store = is_group_with_store(inner);
        if let Star = rep.kind {
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [];`);
            if scannable {
                w.begin("loop");
                let scan_pos_var = emit_rep_scan_guard(w, inner, ctx, name_counts);
                w.line(`if {scan_pos_var} < 0 \{ break; \}`);
                let mut nc: Array<[String, i32]> = [];
                if is_group_store {
                    ctx.group_counter = gc_before;
                    gen_group_store_any(w, inner, ctx, &mut nc, &iter_follow);
                } else {
                    gen_element(w, inner, ctx, &mut nc);
                }
                w.line(`{list_name}.push({field_info.0});`);
                w.end();
            } else {
                w.begin(`while {ctx.first_check_str(&first)}`);
                let mut nc: Array<[String, i32]> = [];
                if is_group_store {
                    ctx.group_counter = gc_before;
                    gen_group_store_any(w, inner, ctx, &mut nc, &iter_follow);
                } else {
                    gen_element(w, inner, ctx, &mut nc);
                }
                w.line(`{list_name}.push({field_info.0});`);
                w.end();
            }
        }
        if let Plus = rep.kind {
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [];`);
            if scannable {
                let plus_flag = dedup_name(&"_plus_first", name_counts);
                w.line(`let mut {plus_flag} = true;`);
                w.begin("loop");
                w.begin(`if !{plus_flag}`);
                let scan_pos_var = emit_rep_scan_guard(w, inner, ctx, name_counts);
                w.line(`if {scan_pos_var} < 0 \{ break; \}`);
                w.end();
                w.line(`{plus_flag} = false;`);
                let mut nc: Array<[String, i32]> = [];
                if is_group_store {
                    ctx.group_counter = gc_before;
                    gen_group_store_any(w, inner, ctx, &mut nc, &iter_follow);
                } else {
                    gen_element(w, inner, ctx, &mut nc);
                }
                w.line(`{list_name}.push({field_info.0});`);
                w.end();
            } else {
                let plus_flag = dedup_name(&"_plus_first", name_counts);
                w.line(`let mut {plus_flag} = true;`);
                w.begin(`while {plus_flag} || {ctx.first_check_str(&first)}`);
                w.line(`{plus_flag} = false;`);
                let mut nc: Array<[String, i32]> = [];
                if is_group_store {
                    ctx.group_counter = gc_before;
                    gen_group_store_any(w, inner, ctx, &mut nc, &iter_follow);
                } else {
                    gen_element(w, inner, ctx, &mut nc);
                }
                w.line(`{list_name}.push({field_info.0});`);
                w.end();
            }
        }
        if let Optional = rep.kind {
            let type_str = field_info.1;
            let opt_name = dedup_name(&field_info.0, name_counts);
            if is_group_store {
                ctx.group_counter = gc_before;
                gen_storable_optional(w, inner, ctx, name_counts, &type_str, &opt_name, &field_info.0);
            } else if mask_active && loop_first.is_empty() {
                // Follow-aware variant: caller claims every token this
                // optional could fire on, so it never fires here.
                w.line(`let {opt_name}: Option<{type_str}> = null;`);
            } else {
                w.begin(`let {opt_name}: Option<{type_str}> = if {ctx.first_check_str(&loop_first)}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, inner, ctx, &mut nc);
                w.line(`Option::<{type_str}>::Some({field_info.0})`);
                w.else_begin("else");
                w.line("null");
                w.end_with(";");
            }
        }
    } else {
        if let Star = rep.kind {
            if scannable {
                w.begin("loop");
                let scan_pos_var = emit_rep_scan_guard(w, inner, ctx, name_counts);
                w.line(`if {scan_pos_var} < 0 \{ break; \}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, inner, ctx, &mut nc);
                w.end();
            } else {
                w.begin(`while {ctx.first_check_str(&first)}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, inner, ctx, &mut nc);
                w.end();
            }
        }
        if let Plus = rep.kind {
            if scannable {
                let plus_flag = dedup_name(&"_plus_first", name_counts);
                w.line(`let mut {plus_flag} = true;`);
                w.begin("loop");
                w.begin(`if !{plus_flag}`);
                let scan_pos_var = emit_rep_scan_guard(w, inner, ctx, name_counts);
                w.line(`if {scan_pos_var} < 0 \{ break; \}`);
                w.end();
                w.line(`{plus_flag} = false;`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, inner, ctx, &mut nc);
                w.end();
            } else {
                gen_element(w, inner, ctx, name_counts);
                w.begin(`while {ctx.first_check_str(&first)}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, inner, ctx, &mut nc);
                w.end();
            }
        }

        if let Optional = rep.kind {
            gen_optional_with_scan_guard(w, inner, ctx, name_counts);
        }
    }
}

fn compute_follow_second(elements: &Array<Element>, follow_start: i32, ctx: &mut GenContext) -> Array<String> {
    // Compute first set of the 2nd token of the follow element.
    // For patterns like (',' table_constraint)*, the follow's inner group is [',' table_constraint].
    // We want first(table_constraint), not first(',').
    if follow_start >= elements.len() {
        return [];
    }
    let follow_elem = &elements[follow_start];
    if let Repeat(rep) = follow_elem {
        if let Group(g) = rep.element {
            if g.alternatives.len() == 1 && g.alternatives[0].elements.len() >= 2 {
                return ctx.first_of_elements_from(&g.alternatives[0].elements, 1);
            }
        }
    }
    return [];
}

fn compute_iter_follow(inner: &Element, first_of_inner: &Array<String>, outer_follow: &Array<String>) -> Array<String> {
    // For a Plus/Star whose inner is a single-alt Group, each iteration can
    // be followed by either another iteration (first(inner)) or the exit
    // (outer_follow). For non-Group inners we use outer_follow alone — the
    // inner has no sub-structure that could host a nested non-greedy tail.
    if let Group(g) = inner {
        if g.alternatives.len() == 1 {
            return union_sets(first_of_inner, outer_follow);
        }
    }
    return *outer_follow;
}

fn wildcard_non_greedy_condition(ctx: &mut GenContext, follow_first: &Array<String>) -> String {
    // Continue while peek is not EOF and not in the follow set. `follow_first`
    // may already contain TK_EOF (e.g. when the follow is the final `EOF`
    // token). Dedup into a single exclusion set so we emit one check.
    let mut excluded: Array<String> = ["TK_EOF"];
    for let tk of follow_first {
        let mut seen = false;
        for let e of &excluded {
            if *e == *tk {
                seen = true;
                break;
            }
        }
        if !seen {
            excluded.push(*tk);
        }
    }
    return ctx.kind_negate_check_str(&excluded, &"p.peek_kind()");
}

fn compute_non_greedy_condition(inner: &Element, follow_first: &Array<String>, follow_second: &Array<String>, ctx: &mut GenContext) -> String {
    // Wildcard (`.*?`) and Not (`~TOK*?`) inner: `first_of_element` returns
    // `[]` because their match set is open-ended. Handle them explicitly:
    // keep looping while the current token is not EOF and not in the follow
    // set (i.e. the continuation can't yet fire).
    if let Wildcard(_) = inner {
        return wildcard_non_greedy_condition(ctx, follow_first);
    }
    if let Not(_) = inner {
        return wildcard_non_greedy_condition(ctx, follow_first);
    }

    let mut visiting: Array<String> = [];
    let raw_first = ctx.first_of_element(inner, &mut visiting);
    let continue_first = subtract_sets(&raw_first, follow_first);

    if continue_first.len() > 0 {
        // Check if the subtracted set is still very broad (inner matches almost anything).
        // For cases like `name+?` where name matches all keywords, lookahead can't
        // distinguish names from constraint keywords. Use minimum match (don't loop).
        let mut visiting2: Array<String> = [];
        let inner_first_full = ctx.first_of_element(inner, &mut visiting2);
        if continue_first.len() > 20 && inner_first_full.len() > 20 {
            // Very broad first set — match minimum (1 for +?, 0 for *?)
            return "false";
        }
        return ctx.first_check_str(&continue_first);
    }

    // First sets completely overlap (e.g. both start with ',').
    // Use 2-token lookahead with follow_second to disambiguate.
    // For (',' column_def)*? followed by (',' table_constraint)*:
    //   peek(0) == ',' for both, peek(1) distinguishes column_def from table_constraint.
    if let Group(g) = inner {
        if g.alternatives.len() == 1 && g.alternatives[0].elements.len() >= 2 && follow_second.len() > 0 {
            let inner_second_first = ctx.first_of_elements_from(&g.alternatives[0].elements, 1);
            let second_continue = subtract_sets(&inner_second_first, follow_second);
            if second_continue.len() > 0 {
                let peek0_cond = ctx.first_check_str(&raw_first);
                let peek1_cond = ctx.kind_check_str(&second_continue, "p.peek_at(1)");
                return `({peek0_cond}) && ({peek1_cond})`;
            }
        }
    }

    // Fallback: can't disambiguate, don't loop (match minimum)
    return "false";
}

fn gen_repeat_non_greedy(w: &mut CodeWriter, rep: &RepeatElement, ctx: &mut GenContext, follow_first: &Array<String>, follow_second: &Array<String>, name_counts: &mut Array<[String, i32]>) {
    let inner = &rep.element;
    let is_plus = if let Plus = rep.kind {
        true;
    } else {
        false;
    };
    let while_cond = compute_non_greedy_condition(inner, follow_first, follow_second, ctx);

    if has_field(inner) {
        let field_info = element_field_info(inner, ctx);
        if is_plus {
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, ctx, &mut nc);
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [{field_info.0}];`);
            if while_cond != "false" {
                w.begin(`while {while_cond}`);
                let mut nc2: Array<[String, i32]> = [];
                gen_element(w, inner, ctx, &mut nc2);
                w.line(`{list_name}.push({field_info.0});`);
                w.end();
            }
        } else {
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [];`);
            if while_cond != "false" {
                w.begin(`while {while_cond}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, inner, ctx, &mut nc);
                w.line(`{list_name}.push({field_info.0});`);
                w.end();
            }
        }
    } else {
        if is_plus {
            gen_element(w, inner, ctx, name_counts);
        }
        if while_cond != "false" {
            w.begin(`while {while_cond}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, ctx, &mut nc);
            w.end();
        }
    }
}

/// Per-position caller-side FOLLOW used by alt walkers to decide
/// whether to register a `__follow_<id>` variant for a `RuleRef` at
/// position `i` in `elements`.
///
/// - When the immediate suffix `elements[i+1..]` is strictly required
///   (not deep-nullable), use its `first` set verbatim.
/// - When the suffix is deep-nullable AND first-exact (every walked
///   element's first uniquely predicts that element matching, see
///   `GenContext::element_is_first_exact`), union the suffix's first
///   with the outer follow. This closes `ll_nullable_suffix`'s gap:
///   `b?` where `b : Y` is first-exact, so `Y` legitimately enters
///   the preceding `RuleRef`'s follow.
/// - When the suffix is deep-nullable but NOT first-exact (e.g. a
///   `Star` over a multi-element Group like CSS3 `(combinator sss
///   ws)*`), drop the suffix's first and propagate only the outer
///   follow. This is the "first-exact deep-nullable suffix"
///   soundness invariant from `antlr4-compatibility.md`'s
///   "LL prediction → Soundness invariants" section: `combinator`'s
///   first contains `Space` but `combinator` requires `Space sss`
///   together, so suppressing `Space` at the preceding `ws` would
///   leave the runtime stranded on a lone `Space`. See also
///   `package-gale/CLAUDE.md` "Failed Approaches" #3 for the
///   historical narrative of how this guard was narrowed back.
fn compute_ruleref_call_follow(elements: &Array<Element>, i: i32, ctx: &mut GenContext) -> Array<String> {
    return ctx.compute_call_site_follow(elements, i);
}

fn union_sets(a: &Array<String>, b: &Array<String>) -> Array<String> {
    let mut result: Array<String> = [];
    let mut seen = TreeSet::<String>::new();
    for let mut i = 0; i < a.len(); i += 1 {
        seen.insert(a[i]);
        result.push(a[i]);
    }
    for let mut i = 0; i < b.len(); i += 1 {
        if !seen.contains(b[i]) {
            seen.insert(b[i]);
            result.push(b[i]);
        }
    }
    return result;
}

fn subtract_sets(a: &Array<String>, b: &Array<String>) -> Array<String> {
    let b_set = str_set_from(b);
    let mut result: Array<String> = [];
    for let x of a {
        if !b_set.contains(*x) {
            result.push(*x);
        }
    }
    return result;
}

fn gen_repeat_with_follow(w: &mut CodeWriter, rep: &RepeatElement, ctx: &mut GenContext, follow_first: &Array<String>, name_counts: &mut Array<[String, i32]>) {
    let inner = &rep.element;
    let mut visiting: Array<String> = [];
    let raw_first = ctx.first_of_element(inner, &mut visiting);
    // Combine the caller-supplied local `follow_first` with the variant
    // mask so the subtracted set reflects both same-alt siblings and
    // outer-rule follow when emitting a follow-aware variant body.
    let combined_follow = if ctx.current_follow_mask.is_empty() {
        *follow_first;
    } else {
        union_sets(follow_first, &ctx.current_follow_mask);
    };
    let first = subtract_sets(&raw_first, &combined_follow);

    if first.len() == 0 {
        // All first tokens overlap with follow — always skip the optional.
        if has_field(inner) {
            let field_info = element_field_info(inner, ctx);
            let type_str = field_info.1;
            let opt_name = dedup_name(&field_info.0, name_counts);
            w.line(`let {opt_name}: Option<{type_str}> = null;`);
        }
        return;
    }

    if has_field(inner) {
        let field_info = element_field_info(inner, ctx);
        let type_str = field_info.1;
        let opt_name = dedup_name(&field_info.0, name_counts);
        w.begin(`let {opt_name}: Option<{type_str}> = if {ctx.first_check_str(&first)}`);
        let mut nc: Array<[String, i32]> = [];
        gen_element(w, inner, ctx, &mut nc);
        w.line(`Option::<{type_str}>::Some({field_info.0})`);
        w.else_begin("else");
        w.line("null");
        w.end_with(";");
    } else {
        gen_optional_with_scan_guard(w, inner, ctx, name_counts);
    }
}

fn is_optional_repeat(elem: &Element) -> bool {
    if let Repeat(rep) = elem {
        if let Optional = rep.kind {
            return true;
        }
    }
    if let Label(lab) = elem {
        return is_optional_repeat(&lab.element);
    }
    return false;
}

fn has_nested_optionals(inner: &Element) -> bool {
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return false;
        }
        for let mut i = 0; i < g.alternatives[0].elements.len(); i += 1 {
            let elem = &g.alternatives[0].elements[i];
            if is_optional_repeat(elem) {
                return true;
            }
        }
    }
    return false;
}

fn compute_shapes(elements: &Array<Element>) -> Array<Array<i32>> {
    let mut opt_indices: Array<i32> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if is_nullable(&elements[i]) {
            opt_indices.push(i);
        }
    }
    let n = opt_indices.len();
    let mut shapes: Array<Array<i32>> = [];
    // Enumerate 2^n combinations: bit mask from (2^n - 1) down to 0
    // Higher bits = more optionals included = longer shape = tried first
    let total = 1 << n;
    for let mut mask = total - 1; mask >= 0; mask -= 1 {
        let mut shape: Array<i32> = [];
        for let mut i = 0; i < elements.len(); i += 1 {
            let mut is_opt = false;
            let mut opt_bit = -1;
            for let mut j = 0; j < opt_indices.len(); j += 1 {
                if opt_indices[j] == i {
                    is_opt = true;
                    opt_bit = j;
                }
            }
            if is_opt {
                if mask >> opt_bit & 1 == 1 {
                    shape.push(i);
                }
            } else {
                shape.push(i);
            }
        }
        shapes.push(shape);
    }
    return shapes;
}

fn shape_lookahead_signature(shape: &Array<i32>, elements: &Array<Element>, ctx: &mut GenContext) -> Array<Array<String>> {
    let mut sig: Array<Array<String>> = [];
    for let mut si = 0; si < shape.len(); si += 1 {
        let idx = shape[si];
        let elem = &elements[idx];
        let actual = unwrap_optional(elem);
        // For a Group with single alt, compute token-by-token signature
        if let Group(g) = actual {
            if g.alternatives.len() == 1 {
                for let mut j = 0; j < g.alternatives[0].elements.len(); j += 1 {
                    let mut visiting: Array<String> = [];
                    sig.push(ctx.first_of_element(&g.alternatives[0].elements[j], &mut visiting));
                }
                continue;
            }
        }
        // For simple elements (RuleRef, TokenRef, Literal), one position
        let mut visiting: Array<String> = [];
        sig.push(ctx.first_of_element(actual, &mut visiting));
    }
    return sig;
}

fn gen_lookahead_condition(ctx: &mut GenContext, sig: &Array<Array<String>>) -> String {
    let mut parts: Array<String> = [];
    for let mut d = 0; d < sig.len(); d += 1 {
        let tokens = &sig[d];
        let check_expr = if d == 0 { `p.peek_kind()` } else { `p.peek_at({d})` };
        parts.push(ctx.kind_check_str(tokens, &check_expr));
    }
    let mut result = String::with_capacity(128);
    for let mut i = 0; i < parts.len(); i += 1 {
        if i > 0 {
            result.push_str(" && ");
        }
        result.push_str(parts[i]);
    }
    return result;
}

fn gen_optional_with_lookahead(w: &mut CodeWriter, group_elements: &Array<Element>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    let shapes = compute_shapes(group_elements);

    let mut is_first = true;
    for let mut si = 0; si < shapes.len(); si += 1 {
        let shape = &shapes[si];
        let sig = shape_lookahead_signature(shape, group_elements, ctx);
        if sig.len() == 0 {
            continue;
        }
        let cond = gen_lookahead_condition(ctx, &sig);

        if is_first {
            w.begin(`if {cond}`);
            is_first = false;
        } else {
            w.else_begin(`else if {cond}`);
        }

        // Generate parsing code for this shape's elements
        let mut nc: Array<[String, i32]> = [];
        for let mut k = 0; k < shape.len(); k += 1 {
            let idx = shape[k];
            let elem = &group_elements[idx];
            let actual = unwrap_optional(elem);
            if let Group(g) = actual {
                if g.alternatives.len() == 1 {
                    for let mut j = 0; j < g.alternatives[0].elements.len(); j += 1 {
                        gen_element(w, &g.alternatives[0].elements[j], ctx, &mut nc);
                    }
                } else {
                    gen_element(w, actual, ctx, &mut nc);
                }
            } else {
                gen_element(w, actual, ctx, &mut nc);
            }
        }
    }
    if !is_first {
        w.end();
    }
}

fn unwrap_optional(elem: &Element) -> &Element with stores[elem] {
    if let Repeat(rep) = elem {
        if let Optional = rep.kind {
            return &rep.element;
        }
    }
    if let Label(lab) = elem {
        return unwrap_optional(&lab.element);
    }
    return elem;
}

fn optional_lookahead_depth(inner: &Element) -> i32 {
    // Returns the number of leading fixed tokens that can be checked via lookahead.
    // 0 if the first element is not a fixed token.
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return 0;
        }
        let mut depth = 0;
        for let mut i = 0; i < g.alternatives[0].elements.len(); i += 1 {
            let elem = &g.alternatives[0].elements[i];
            if let TokenRef(_) | Literal(_) = elem {
                depth += 1;
            } else {
                break;
            }
        }
        return depth;
    }
    if let TokenRef(_) | Literal(_) = inner {
        return 1;
    }
    return 0;
}

fn optional_lookahead_tokens(inner: &Element, max_depth: i32) -> Array<String> {
    // Returns up to max_depth leading fixed token constants.
    let mut tokens: Array<String> = [];
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return [];
        }
        for let mut i = 0; i < g.alternatives[0].elements.len(); i += 1 {
            if tokens.len() >= max_depth {
                break;
            }
            let elem = &g.alternatives[0].elements[i];
            if let TokenRef(t) = elem {
                tokens.push(`TK_{t.name}`);
            } else if let Literal(l) = elem {
                tokens.push(literal_const_name(&l.text));
            } else {
                break;
            }
        }
    } else if let TokenRef(t) = inner {
        tokens.push(`TK_{t.name}`);
    } else if let Literal(l) = inner {
        tokens.push(literal_const_name(&l.text));
    }
    return tokens;
}

/// Emit an inline scan guard for an optional's inner element.
///
/// Emits code of the form:
/// ```
/// let mut opt_scan_pos_N: i32 = -1;
/// opt_scan_N: {
///     let tokens = &p.tokens;
///     let mut pos: i32 = p.pos;
///     /* inline scan of inner; on fail: break opt_scan_N; */
///     opt_scan_pos_N = pos;
/// }
/// ```
///
/// Returns the name of the outer pos variable (`-1` on scan failure, end-pos on success).
/// Caller emits `if {pos_var} >= 0 { /* commit parse */ }`.
fn emit_opt_scan_guard(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) -> String {
    return emit_scan_guard_with_prefix(w, inner, ctx, name_counts, &"opt_scan_pos", &"opt_scan", false);
}

/// Emit an inline scan guard for a repetition's inner element.
/// Same shape as emit_opt_scan_guard but uses `rep_scan_*` naming. Requires
/// the scan to advance at least one token; 0-advance is treated as failure
/// so lenient scans of LR rules (which can no-op at EOF) don't loop forever.
fn emit_rep_scan_guard(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) -> String {
    return emit_scan_guard_with_prefix(w, inner, ctx, name_counts, &"rep_scan_pos", &"rep_scan", true);
}

fn emit_scan_guard_with_prefix(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, pos_prefix: &String, label_prefix: &String, require_advance: bool) -> String {
    let scan_pos_var = dedup_name(pos_prefix, name_counts);
    let scan_label = dedup_name(label_prefix, name_counts);
    w.line(`let mut {scan_pos_var}: i32 = -1;`);
    w.begin(`{scan_label}:`);
    w.line("let tokens = &p.tokens;");
    w.line("let mut pos: i32 = p.pos;");
    let fail = `break {scan_label};`;
    if let Group(g) = inner {
        if g.alternatives.len() == 1 {
            gen_scan_elements_in_block(
                w,
                &g.alternatives[0].elements,
                0,
                g.alternatives[0].elements.len(),
                ctx,
                &scan_label,
            );
        } else {
            // Rep guard: must be strict so scan failure terminates the rep loop.
            gen_scan_group(w, &g.alternatives, ctx, &fail, false);
        }
    } else {
        gen_scan_element(w, inner, ctx, &fail);
    }
    if require_advance {
        w.line(`if pos <= p.pos \{ break {scan_label}; \}`);
    }
    w.line(`{scan_pos_var} = pos;`);
    w.end();
    return scan_pos_var;
}

fn gen_optional_with_scan_guard(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    if has_nested_optionals(inner) {
        if let Group(g) = inner {
            gen_optional_with_lookahead(w, &g.alternatives[0].elements, ctx, name_counts);
            return;
        }
    }

    // Use k-token lookahead when leading fixed tokens uniquely identify the optional.
    let la_depth = optional_lookahead_depth(inner);
    if la_depth >= 1 {
        let la_tokens = optional_lookahead_tokens(inner, la_depth);
        let mut cond_parts: Array<String> = [];
        for let mut d = 0; d < la_tokens.len(); d += 1 {
            let check = if d == 0 { "p.peek_kind()" } else { `p.peek_at({d})` };
            cond_parts.push(`{check} == {la_tokens[d]}`);
        }
        let mut cond = String::with_capacity(128);
        for let mut i = 0; i < cond_parts.len(); i += 1 {
            if i > 0 {
                cond.push_str(" && ");
            }
            cond.push_str(cond_parts[i]);
        }
        w.begin(`if {cond}`);
        let mut nc: Array<[String, i32]> = [];
        if let Group(g) = inner {
            for let mut i = 0; i < g.alternatives[0].elements.len(); i += 1 {
                gen_element(w, &g.alternatives[0].elements[i], ctx, &mut nc);
            }
        } else {
            gen_element(w, inner, ctx, &mut nc);
        }
        w.end();
        return;
    }

    // Scan-based guard: the inner must be fully scannable (no unresolved
    // RuleRefs). Backtracking has been removed; an unscannable inner is a
    // codegen-time error.
    let mut visiting: Array<String> = [];
    if !ctx.is_element_scannable(inner, &mut visiting) {
        panic(
            "gen_optional_with_scan_guard: inner element is not scannable; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')",
        );
    }
    let scan_pos_var = emit_opt_scan_guard(w, inner, ctx, name_counts);
    w.begin(`if {scan_pos_var} >= 0`);
    let mut nc: Array<[String, i32]> = [];
    if let Group(g) = inner {
        if g.alternatives.len() == 1 {
            for let elem of g.alternatives[0].elements {
                gen_element(w, &elem, ctx, &mut nc);
            }
        } else {
            gen_element(w, inner, ctx, &mut nc);
        }
    } else {
        gen_element(w, inner, ctx, &mut nc);
    }
    w.end();
}

/// Generate a storable optional group, picking the best available
/// disambiguation strategy:
///
/// - Multi-token lookahead when leading fixed tokens uniquely identify
///   the optional (e.g. `(K_IF K_NOT K_EXISTS)?`).
/// - Shape-based lookahead when nested optionals require it.
/// - Inline scan-guard otherwise (e.g. `(database_name '.')?`); the
///   inner must be fully scannable, since backtracking has been removed.
fn gen_storable_optional(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, type_str: &String, opt_name: &String, field_name: &String) {
    let la_depth = optional_lookahead_depth(inner);
    if la_depth >= 1 {
        // Multi-token lookahead: safe to use ? since tokens are confirmed
        let la_tokens = optional_lookahead_tokens(inner, la_depth);
        let mut cond_parts: Array<String> = [];
        for let mut d = 0; d < la_tokens.len(); d += 1 {
            let check = if d == 0 { "p.peek_kind()" } else { `p.peek_at({d})` };
            cond_parts.push(`{check} == {la_tokens[d]}`);
        }
        let mut cond = String::with_capacity(128);
        for let mut i = 0; i < cond_parts.len(); i += 1 {
            if i > 0 {
                cond.push_str(" && ");
            }
            cond.push_str(cond_parts[i]);
        }
        w.begin(`let {opt_name}: Option<{type_str}> = if {cond}`);
        let mut nc: Array<[String, i32]> = [];
        gen_group_store_any(w, inner, ctx, &mut nc, &([] as Array<String>));
        w.line(`Option::<{type_str}>::Some({field_name})`);
        w.else_begin("else");
        w.line("null");
        w.end_with(";");
    } else if has_nested_optionals(inner) {
        // Nested optionals: use shape-based lookahead dispatch with struct capture
        gen_storable_optional_with_lookahead(w, inner, ctx, name_counts, type_str, opt_name, field_name);
    } else {
        // Inline scan-guard: scan first, parse on success.
        gen_storable_optional_with_scan_guard(w, inner, ctx, name_counts, type_str, opt_name, field_name);
    }
}

/// Generate a storable optional with shape-based lookahead for groups containing
/// nested optional sub-groups (e.g. `((database_name '.')? table_name '.')?`).
///
/// Enumerates all shapes (combinations of present/absent optional sub-elements),
/// computes a lookahead signature for each, and generates an if/else-if chain.
/// Each branch parses the relevant elements and constructs the struct with
/// null for absent optional fields.
fn gen_storable_optional_with_lookahead(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, type_str: &String, opt_name: &String, field_name: &String) {
    if let Group(g) = inner {
        if g.alternatives.len() != 1 {
            return;
        }
        let alt = &g.alternatives[0];
        let elements = &alt.elements;
        let shapes = compute_shapes(elements);

        let struct_type_name = single_alt_group_type_name(alt);
        let struct_field_name = single_alt_group_field_name(alt);

        let gc_shapes_start = ctx.group_counter;
        let mut is_first = true;
        for let mut si = 0; si < shapes.len(); si += 1 {
            let shape = &shapes[si];
            let sig = shape_lookahead_signature(shape, elements, ctx);
            if sig.len() == 0 {
                continue;
            }
            let cond = gen_lookahead_condition(ctx, &sig);

            if is_first {
                w.begin(`let {opt_name}: Option<{type_str}> = if {cond}`);
                is_first = false;
            } else {
                w.else_begin(`else if {cond}`);
            }

            // Parse elements: present ones normally, absent optionals as null
            ctx.group_counter = gc_shapes_start;
            let mut nc: Array<[String, i32]> = [];
            let gc_shape = ctx.group_counter;
            for let mut i = 0; i < elements.len(); i += 1 {
                let mut in_shape = false;
                for let mut k = 0; k < shape.len(); k += 1 {
                    if shape[k] == i {
                        in_shape = true;
                    }
                }
                if in_shape {
                    gen_element(w, &elements[i], ctx, &mut nc);
                } else {
                    gen_absent_optional_field(w, &elements[i], &mut nc, ctx);
                }
            }

            // Construct the struct
            w.line(`let {struct_field_name} = {struct_type_name} \{`);
            w.indent();
            ctx.group_counter = gc_shape;
            let mut assign_nc: Array<[String, i32]> = [];
            for let elem of elements {
                gen_field_assignment(w, elem, &mut assign_nc, ctx);
            }
            w.dedent();
            w.line("};");
            w.line(`Option::<{type_str}>::Some({field_name})`);
        }

        if !is_first {
            w.else_begin("else");
            w.line("null");
            w.end_with(";");
        }
    }
}

/// Generate a default assignment for an absent element's struct field.
fn gen_absent_optional_field(w: &mut CodeWriter, elem: &Element, name_counts: &mut Array<[String, i32]>, ctx: &mut GenContext) {
    if let Repeat(rep) = elem {
        if has_field(&rep.element) {
            if is_list_label(&rep.element) {
                let info = element_field_info(&rep.element, ctx);
                let list_field = dedup_name(&info.0, name_counts);
                w.line(`let mut {list_field}: {info.1} = [];`);
                return;
            }
            let info = element_field_info(&rep.element, ctx);
            if let Optional = rep.kind {
                let opt_field = dedup_name(&info.0, name_counts);
                w.line(`let {opt_field}: Option<{info.1}> = null;`);
            }
            if let Star | Plus = rep.kind {
                let list_field = dedup_name(&`{info.0}_list`, name_counts);
                w.line(`let mut {list_field}: Array<{info.1}> = [];`);
            }
        }
        return;
    }
    if let Label(lab) = elem {
        if lab.list {
            let info = element_field_info(elem, ctx);
            let list_field = dedup_name(&info.0, name_counts);
            w.line(`let mut {list_field}: {info.1} = [];`);
            return;
        }
        gen_absent_optional_field(w, &lab.element, name_counts, ctx);
        return;
    }
}

/// Generate a storable optional with a scan-guard for struct capture.
///
/// Produces code like:
///   let opt: Option<Type> = if scan_pos >= 0 {
///       let foo = parse_foo(p);
///       let dot = p.expect(TK_DOT);
///       Option::<Type>::Some(Type { foo, dot })
///   } else { null };
fn gen_storable_optional_with_scan_guard(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, type_str: &String, opt_name: &String, field_name: &String) {
    // Scan-based guard: the inner must be fully scannable. Backtracking has
    // been removed; an unscannable inner is a codegen-time error.
    let mut visiting: Array<String> = [];
    if !ctx.is_element_scannable(inner, &mut visiting) {
        panic(
            "gen_storable_optional_with_scan_guard: inner element is not scannable; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')",
        );
    }
    let scan_pos_var = emit_opt_scan_guard(w, inner, ctx, name_counts);
    w.begin(`let {opt_name}: Option<{type_str}> = if {scan_pos_var} >= 0`);

    if let Group(g) = inner {
        if is_single_alt_group(&g.alternatives) {
            let alt = &g.alternatives[0];
            let mut elem_nc: Array<[String, i32]> = [];
            let gc_start = ctx.group_counter;
            for let elem of &alt.elements {
                gen_element(w, elem, ctx, &mut elem_nc);
            }
            let struct_type_name = single_alt_group_type_name(alt);
            let struct_field_name = single_alt_group_field_name(alt);
            w.line(`let {struct_field_name} = {struct_type_name} \{`);
            w.indent();
            ctx.group_counter = gc_start;
            let mut assign_nc: Array<[String, i32]> = [];
            for let elem of &alt.elements {
                gen_field_assignment(w, elem, &mut assign_nc, ctx);
            }
            w.dedent();
            w.line("};");
            w.line(`Option::<{type_str}>::Some({field_name})`);
        } else {
            let mut nc: Array<[String, i32]> = [];
            gen_group_store_any(w, inner, ctx, &mut nc, &([] as Array<String>));
            w.line(`Option::<{type_str}>::Some({field_name})`);
        }
    }

    w.else_begin("else");
    w.line("null");
    w.end_with(";");
}

/// Emit the Parser call expression for `~ X` (set complement). Returns a
/// `Result<Token, ParseError>` at runtime. The exclusion set is a tuple
/// literal that coerces to `Array<i32>` at the call site.
fn not_match_call(inner: &Element) -> String {
    if let TokenRef(t) = inner {
        let const_name = `TK_{t.name}`;
        return `p.match_not([{const_name}])`;
    }
    if let Literal(l) = inner {
        let const_name = literal_const_name(&l.text);
        return `p.match_not([{const_name}])`;
    }
    if let Group(g) = inner {
        let mut kinds: Array<String> = [];
        if collect_not_set_tokens(&g.alternatives, &mut kinds) {
            let mut list = String::with_capacity(32);
            for let mut i = 0; i < kinds.len(); i += 1 {
                if i > 0 {
                    list.push_str(", ");
                }
                list.push_str(kinds[i]);
            }
            return `p.match_not([{list}])`;
        }
    }
    panic("not_match_call: unsupported inner element for parser-side ~");
    return "";
}

/// Collect terminal token constants from a `~ ( ... )` group's alternatives.
/// Returns false if any alternative is not a simple terminal (unsupported).
fn collect_not_set_tokens(alts: &Array<Alternative>, out: &mut Array<String>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        let e = &alt.elements[0];
        if let TokenRef(t) = e {
            out.push(`TK_{t.name}`);
        } else if let Literal(l) = e {
            out.push(literal_const_name(&l.text));
        } else {
            return false;
        }
    }
    return true;
}

fn is_group_with_store(elem: &Element) -> bool {
    if let Group(g) = elem {
        return is_storable_group(&g.alternatives);
    }
    return false;
}

fn has_field(elem: &Element) -> bool {
    if let TokenRef(_) | Literal(_) | RuleRef(_) = elem {
        return true;
    }
    if let Wildcard(_) = elem {
        return true;
    }
    if let Not(_) = elem {
        return true;
    }
    if let Label(lab) = elem {
        return has_field(&lab.element);
    }
    if let Group(g) = elem {
        return is_storable_group(&g.alternatives);
    }
    return false;
}

/// Returns true if `elem` is a list-label (`items+=X`). List labels store
/// matches in an `Array<InnerType>` named by `lab.name`.
fn is_list_label(elem: &Element) -> bool {
    if let Label(lab) = elem {
        return lab.list;
    }
    return false;
}

/// For a list-label element, returns [label_field_name, array_type_str,
/// inner_type_str, inner_field_name]. Returns null for non-list-labels.
fn list_label_info(elem: &Element, ctx: &mut GenContext) -> Option<[String, String, String, String]> {
    if let Label(lab) = elem {
        if lab.list {
            let inner = element_field_info(&lab.element, ctx);
            return Option::<[String, String, String, String]>::Some([lab.field_name, `Array<{inner.1}>`, inner.1,
                inner.0]);
        }
    }
    return null;
}

fn element_field_info(elem: &Element, ctx: &mut GenContext) -> [String, String] {
    if let TokenRef(t) = elem {
        return [t.field_name, "Token"];
    }
    if let Literal(l) = elem {
        return [literal_field_name(&l.text), "Token"];
    }
    if let RuleRef(r) = elem {
        return [r.field_name, rule_type_name(&r.name)];
    }
    if let Wildcard(_) = elem {
        return ["wildcard", "Token"];
    }
    if let Not(ne) = elem {
        return [not_element_field_name(&ne.element), "Token"];
    }
    if let Label(lab) = elem {
        if lab.list {
            let inner = element_field_info(&lab.element, ctx);
            return [lab.field_name, `Array<{inner.1}>`];
        }
        return element_field_info(&lab.element, ctx);
    }
    if let Group(g) = elem {
        if is_simple_cst_group(&g.alternatives) {
            return [group_field_base_name(&g.alternatives), group_variant_type_name(&g.alternatives)];
        }
        if is_token_only_group(&g.alternatives) {
            return [token_group_field_name(&g.alternatives), "Token"];
        }
        if is_single_alt_group(&g.alternatives) {
            return [single_alt_group_field_name(&g.alternatives[0]), single_alt_group_type_name(&g.alternatives[0])];
        }
        if is_general_group(&g.alternatives) {
            let idx = ctx.group_counter;
            ctx.group_counter += 1;
            return [general_group_field_name(idx), general_group_type_name(&ctx.current_rule_name, idx)];
        }
        // Non-storable group: advance counter for nested general groups
        ctx.group_counter += count_element_groups(elem);
    }
    return ["_", "Token"];
}

fn gen_field_assignments(w: &mut CodeWriter, elements: &Array<Element>, ctx: &mut GenContext) {
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        gen_field_assignment(w, elem, &mut name_counts, ctx);
    }
}

fn gen_field_assignment(w: &mut CodeWriter, elem: &Element, name_counts: &mut Array<[String, i32]>, ctx: &mut GenContext) {
    if let TokenRef(t) = elem {
        let field_name = dedup_name(&t.field_name, name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Literal(l) = elem {
        let field_name = dedup_name(&literal_field_name(&l.text), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let RuleRef(r) = elem {
        let field_name = dedup_name(&r.field_name, name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Wildcard(_) = elem {
        let field_name = dedup_name(&"wildcard", name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Not(ne) = elem {
        let field_name = dedup_name(&not_element_field_name(&ne.element), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Repeat(rep) = elem {
        if has_field(&rep.element) {
            // A list label inside a repeat still uses the label name directly
            // (no `_list` suffix), because the label IS the array.
            if is_list_label(&rep.element) {
                let info = element_field_info(&rep.element, ctx);
                let field_name = dedup_name(&info.0, name_counts);
                w.line(`{field_name},`);
                return;
            }
            let info = element_field_info(&rep.element, ctx);
            if let Star | Plus = rep.kind {
                let field_name = dedup_name(&`{info.0}_list`, name_counts);
                w.line(`{field_name},`);
            }
            if let Optional = rep.kind {
                let field_name = dedup_name(&info.0, name_counts);
                w.line(`{field_name},`);
            }
        }
        return;
    }
    if let Label(lab) = elem {
        if has_field(&lab.element) {
            // Match `gen_element`'s Label dedup: when the same label name
            // appears twice (e.g. `a=expr '*' a=expr`) the struct field is
            // `a` then `a_2`, and the binding the parse body created is
            // `a` then `a_2` too — so the assignment must use the deduped
            // name, not the bare one.
            let field_name = dedup_name(&lab.field_name, name_counts);
            w.line(`{field_name},`);
        }
        return;
    }
    if let Group(g) = elem {
        if is_simple_cst_group(&g.alternatives) {
            let field_name = dedup_name(&group_field_base_name(&g.alternatives), name_counts);
            w.line(`{field_name},`);
        } else if is_token_only_group(&g.alternatives) {
            let field_name = dedup_name(&token_group_field_name(&g.alternatives), name_counts);
            w.line(`{field_name},`);
        } else if is_single_alt_group(&g.alternatives) {
            let field_name = dedup_name(&single_alt_group_field_name(&g.alternatives[0]), name_counts);
            w.line(`{field_name},`);
        } else if is_general_group(&g.alternatives) {
            let idx = ctx.group_counter;
            ctx.group_counter += 1;
            let field_name = dedup_name(&general_group_field_name(idx), name_counts);
            w.line(`{field_name},`);
        } else {
            // Non-storable group: advance counter for nested general groups
            ctx.group_counter += count_element_groups(elem);
        }
        return;
    }
}

/// Replay name counting for an element without emitting code.
/// This advances the dedup counter so subsequent elements get correct suffixes.
fn replay_element_names(elem: &Element, name_counts: &mut Array<[String, i32]>, ctx: &mut GenContext) {
    if let TokenRef(t) = elem {
        dedup_name(&t.field_name, name_counts);
        return;
    }
    if let Literal(l) = elem {
        dedup_name(&literal_field_name(&l.text), name_counts);
        return;
    }
    if let RuleRef(r) = elem {
        dedup_name(&r.field_name, name_counts);
        return;
    }
    if let Wildcard(_) = elem {
        dedup_name(&"wildcard", name_counts);
        return;
    }
    if let Not(ne) = elem {
        dedup_name(&not_element_field_name(&ne.element), name_counts);
        return;
    }
    if let Repeat(rep) = elem {
        if has_field(&rep.element) {
            if is_list_label(&rep.element) {
                let info = element_field_info(&rep.element, ctx);
                dedup_name(&info.0, name_counts);
                return;
            }
            let info = element_field_info(&rep.element, ctx);
            if let Star | Plus = rep.kind {
                dedup_name(&`{info.0}_list`, name_counts);
            }
            if let Optional = rep.kind {
                dedup_name(&info.0, name_counts);
            }
        }
        return;
    }
    if let Label(lab) = elem {
        if has_field(&lab.element) {
            dedup_name(&lab.field_name, name_counts);
        }
        return;
    }
    if let Group(g) = elem {
        if is_simple_cst_group(&g.alternatives) {
            dedup_name(&group_field_base_name(&g.alternatives), name_counts);
        } else if is_token_only_group(&g.alternatives) {
            dedup_name(&token_group_field_name(&g.alternatives), name_counts);
        } else if is_single_alt_group(&g.alternatives) {
            dedup_name(&single_alt_group_field_name(&g.alternatives[0]), name_counts);
        } else if is_general_group(&g.alternatives) {
            let idx = ctx.group_counter;
            ctx.group_counter += 1;
            dedup_name(&general_group_field_name(idx), name_counts);
        } else {
            // Non-storable group: advance counter for nested general groups
            ctx.group_counter += count_element_groups(elem);
        }
        return;
    }
}

fn gen_consume_group(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    if alts.len() == 0 {
        return;
    }
    if alts.len() == 1 {
        gen_elements_with_non_greedy(w, &alts[0].elements, ctx, name_counts, &([] as Array<String>));
        return;
    }

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }
    let groups = compute_overlap_groups(&first_sets);

    let grp_var = dedup_name(&"grp_kind", name_counts);
    w.line(`let {grp_var} = p.peek_kind();`);

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, &grp_var);
        if g == 0 {
            w.begin(`if {cond}`);
        } else {
            w.else_begin(`else if {cond}`);
        }

        if group.len() == 1 {
            let alt_idx = group[0];
            let mut nc: Array<[String, i32]> = [];
            gen_elements_with_non_greedy(w, &alts[alt_idx].elements, ctx, &mut nc, &([] as Array<String>));
        } else {
            let mut sorted_group = group.sorted();
            // LL-correct: longer alts first so first-success-wins picks
            // the longer match for prefix-overlap groups (rule-level
            // dispatch keeps the priority-based sort).
            sort_group_by_mandatory_count_desc(&mut sorted_group, alts, ctx);
            let mut nc: Array<[String, i32]> = [];
            gen_prediction_body(w, &sorted_group, alts, ctx, &mut nc);
        }
    }
    w.end();
}

fn gen_consume_group_store(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    let var_name = dedup_name(&group_field_base_name(alts), name_counts);
    let type_name = group_variant_type_name(alts);

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups(&first_sets);
    let has_overlaps = has_multi_alt_groups(&groups);

    if !has_overlaps {
        // Simple case: no overlapping FIRST sets
        for let mut i = 0; i < alts.len(); i += 1 {
            if let RuleRef(r) = &alts[i].elements[0] {
                let fn_name = `parse_{r.snake_name}`;
                let local_var = r.snake_name;
                let case_name = group_case_name(&alts[i]);

                if i == 0 {
                    w.begin(`let {var_name}: {type_name} = if {ctx.first_check_str(&first_sets[i])}`);
                } else if i < alts.len() - 1 {
                    w.else_begin(`else if {ctx.first_check_str(&first_sets[i])}`);
                } else {
                    w.else_begin("else");
                }

                w.line(`let {local_var} = {fn_name}(p)?;`);
                w.line(`{type_name}::{case_name}({local_var})`);
            }
        }
        w.end_with(";");
    } else {
        // Complex case: overlapping FIRST sets, use Option + scan dispatch
        let opt_var = dedup_name(&`{var_name}_opt`, name_counts);
        w.line(`let mut {opt_var}: Option<{type_name}> = null;`);

        let grp_var = dedup_name(&"grp_kind", name_counts);
        w.line(`let {grp_var} = p.peek_kind();`);

        for let mut g = 0; g < groups.len(); g += 1 {
            let group = &groups[g];

            let mut union_first: Array<String> = [];
            for let idx of group {
                dedup_append_arr(&mut union_first, &first_sets[*idx]);
            }

            let cond = ctx.kind_check_str(&union_first, &grp_var);
            if g == 0 {
                w.begin(`if {cond}`);
            } else {
                w.else_begin(`else if {cond}`);
            }

            if group.len() == 1 {
                let alt_idx = group[0];
                if let RuleRef(r) = &alts[alt_idx].elements[0] {
                    let fn_name = `parse_{r.snake_name}`;
                    let local_var = r.snake_name;
                    let case_name = group_case_name(&alts[alt_idx]);
                    w.line(`let {local_var} = {fn_name}(p)?;`);
                    w.line(`{opt_var} = Option::<{type_name}>::Some({type_name}::{case_name}({local_var}));`);
                }
            } else {
                let mut sorted_group = group.sorted();
                sort_group_by_mandatory_count_desc(&mut sorted_group, alts, ctx);

                if !rule_ref_group_all_scannable(&sorted_group, alts, ctx) {
                    panic(
                        "rule-ref group has unscannable alt; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')",
                    );
                }
                gen_rule_ref_group_scan_dispatch(w, &sorted_group, alts, &opt_var, type_name, ctx, name_counts);
            }
        }
        w.end();  // if/else if chain

        w.begin(`if let None = {opt_var}`);
        let first_alt_name = group_case_name(&alts[0]);
        w.line(`p.fail("{first_alt_name}")?;`);
        w.end();
        w.line(`let {var_name} = {opt_var}.unwrap();`);
    }
}

/// Returns true if every RuleRef in a group of single-RuleRef alts is scannable.
fn rule_ref_group_all_scannable(sorted_group: &Array<i32>, alts: &Array<Alternative>, ctx: &mut GenContext) -> bool {
    if sorted_group.len() < 2 {
        return false;
    }
    for let idx_ref of sorted_group {
        let alt = &alts[*idx_ref];
        if alt.elements.len() != 1 {
            return false;
        }
        if let RuleRef(r) = &alt.elements[0] {
            let mut visiting: Array<String> = [];
            if !ctx.is_rule_scannable(&r.name, &mut visiting) {
                return false;
            }
        } else {
            return false;
        }
    }
    return true;
}

/// First-success-wins scan dispatch for RuleRef-only group stores — scans
/// each alt's rule in `sort_group_by_element_count` (longest-first) order
/// and commits on first success. The matching alt is parsed once. This is
/// the dispatch that makes `parse_sql_stmt`'s WITH/SELECT/.../UPDATE
/// partition affordable when its alts transitively reference the LR rule
/// `expr` — committing on first success skips the remaining 8 deep LR
/// scans that a longest-match tournament would have run.
fn gen_rule_ref_group_scan_dispatch(w: &mut CodeWriter, sorted_group: &Array<i32>, alts: &Array<Alternative>, opt_var: &String, type_name: &String, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    let winner_var = dedup_name(&"gd_winner", name_counts);
    let dispatch_label = dedup_name(&"gd_dispatch", name_counts);
    w.line(`let mut {winner_var}: i32 = -1;`);
    w.begin(`{dispatch_label}:`);
    let last = sorted_group.len() - 1;
    for let mut k = 0; k < sorted_group.len(); k += 1 {
        if k == last {
            break;
        }
        let alt = &alts[sorted_group[k]];
        let scan_label = dedup_name(&"gd_scan", name_counts);
        w.begin(`{scan_label}:`);
        w.line("let tokens = &p.tokens;");
        w.line("let mut pos: i32 = p.pos;");
        gen_scan_elements_in_block(w, &alt.elements, 0, alt.elements.len(), ctx, &scan_label);
        w.line(`{winner_var} = {k};`);
        w.line(`break {dispatch_label};`);
        w.end();
    }
    w.end();

    for let mut k = 0; k < sorted_group.len(); k += 1 {
        let alt_idx = sorted_group[k];
        let is_last = k == last;
        if let RuleRef(r) = &alts[alt_idx].elements[0] {
            let fn_name = `parse_{r.snake_name}`;
            let case_name = group_case_name(&alts[alt_idx]);
            let local_var = r.snake_name;

            if k == 0 && !is_last {
                w.begin(`if {winner_var} == {k}`);
            } else if is_last {
                w.else_begin("else");
            } else {
                w.else_begin(`else if {winner_var} == {k}`);
            }
            w.line(`let {local_var} = {fn_name}(p)?;`);
            w.line(`{*opt_var} = Option::<{type_name}>::Some({type_name}::{case_name}({local_var}));`);
        }
    }
    w.end();
}

fn gen_consume_group_store_optional(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    let var_name = dedup_name(&group_field_base_name(alts), name_counts);
    let type_name = group_variant_type_name(alts);

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups(&first_sets);
    let has_overlaps = has_multi_alt_groups(&groups);

    // Use Option wrapper — None when no branch matches (standalone Group).
    let inner_var = dedup_name(&`{var_name}_inner`, name_counts);
    w.line(`let mut {inner_var}: Option<{type_name}> = null;`);

    let grp_var = dedup_name(&"grp_kind", name_counts);
    w.line(`let {grp_var} = p.peek_kind();`);

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, &grp_var);
        if g == 0 {
            w.begin(`if {cond}`);
        } else {
            w.else_begin(`else if {cond}`);
        }

        if group.len() == 1 {
            let alt_idx = group[0];
            if let RuleRef(r) = &alts[alt_idx].elements[0] {
                let fn_name = `parse_{r.snake_name}`;
                let local_var = r.snake_name;
                let case_name = group_case_name(&alts[alt_idx]);
                w.line(`let {local_var} = {fn_name}(p)?;`);
                w.line(`{inner_var} = Option::<{type_name}>::Some({type_name}::{case_name}({local_var}));`);
            }
        } else {
            let mut sorted_group = group.sorted();
            sort_group_by_mandatory_count_desc(&mut sorted_group, alts, ctx);

            if !rule_ref_group_all_scannable(&sorted_group, alts, ctx) {
                panic(
                    "rule-ref group has unscannable alt; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')",
                );
            }
            gen_rule_ref_group_scan_dispatch(w, &sorted_group, alts, &inner_var, type_name, ctx, name_counts);
        }
    }
    w.end();  // if/else if chain

    w.line(`let {var_name} = {inner_var};`);
}

fn gen_group_store_any(w: &mut CodeWriter, inner: &Element, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, outer_follow: &Array<String>) {
    if let Group(g) = inner {
        let alts = &g.alternatives;
        if is_simple_cst_group(alts) {
            gen_consume_group_store(w, alts, ctx, name_counts);
        } else if is_token_only_group(alts) {
            gen_consume_token_group(w, alts, ctx, name_counts);
        } else if is_single_alt_group(alts) {
            gen_consume_single_alt_group(w, &alts[0], ctx, name_counts, outer_follow);
        } else if is_general_group(alts) {
            gen_general_group_store(w, alts, ctx, name_counts);
        }
    }
}

fn gen_consume_token_group(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    let var_name = dedup_name(&token_group_field_name(alts), name_counts);
    w.line(`let {var_name} = p.advance();`);
}

fn gen_consume_single_alt_group(w: &mut CodeWriter, alt: &Alternative, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, outer_follow: &Array<String>) {
    let type_name = single_alt_group_type_name(alt);
    let field_name = dedup_name(&single_alt_group_field_name(alt), name_counts);
    // Use the owning rule's name for general group types inside shared single-alt groups
    let saved_rule_name = ctx.current_rule_name;
    ctx.current_rule_name = ctx.general_group_rule_name(&type_name);
    let nc_snapshot = *name_counts;
    let gc_start = ctx.group_counter;
    gen_elements_with_non_greedy(w, &alt.elements, ctx, name_counts, outer_follow);
    w.line(`let {field_name} = {type_name} \{`);
    w.indent();
    ctx.group_counter = gc_start;
    let mut assign_nc = nc_snapshot;
    for let elem of &alt.elements {
        gen_field_assignment(w, elem, &mut assign_nc, ctx);
    }
    w.dedent();
    w.line("};");
    ctx.current_rule_name = saved_rule_name;
}

/// Generate a general group store with Option wrapper (standalone Group in an alternative).
fn gen_general_group_store_optional(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    let group_index = ctx.group_counter;
    ctx.group_counter += 1;
    let gc_after_self = ctx.group_counter;
    let var_name = dedup_name(&general_group_field_name(group_index), name_counts);
    let type_name = general_group_type_name(&ctx.current_rule_name, group_index);

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups(&first_sets);

    let inner_var = dedup_name(&`{var_name}_inner`, name_counts);
    w.line(`let mut {inner_var}: Option<{type_name}> = null;`);

    let grp_var = dedup_name(&"grp_kind", name_counts);
    w.line(`let {grp_var} = p.peek_kind();`);

    let mut gc_max = gc_after_self;
    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, &grp_var);
        if g == 0 {
            w.begin(`if {cond}`);
        } else {
            w.else_begin(`else if {cond}`);
        }

        ctx.group_counter = gc_after_self;
        if group.len() == 1 {
            let alt_idx = group[0];
            gen_general_alt_parse_and_store(w, alts, alt_idx, &type_name, &inner_var, ctx, name_counts, group_index);
        } else {
            let mut sorted_group = group.sorted();
            sort_group_by_mandatory_count_desc(&mut sorted_group, alts, ctx);
            gen_general_group_dispatch(w, alts, &sorted_group, &type_name, &inner_var, ctx, name_counts, group_index);
        }
        if ctx.group_counter > gc_max {
            gc_max = ctx.group_counter;
        }
    }
    w.end();
    ctx.group_counter = gc_max;

    w.line(`let {var_name} = {inner_var};`);
}

/// Generate a general group store without Option wrapper (required, inside Repeat).
fn gen_general_group_store(w: &mut CodeWriter, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    let group_index = ctx.group_counter;
    ctx.group_counter += 1;
    let gc_after_self = ctx.group_counter;
    let var_name = dedup_name(&general_group_field_name(group_index), name_counts);
    let type_name = general_group_type_name(&ctx.current_rule_name, group_index);

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups(&first_sets);
    let has_overlaps = has_multi_alt_groups(&groups);

    if !has_overlaps {
        // Simple case: no overlapping FIRST sets — use if/else expression
        let mut gc_max = gc_after_self;
        for let mut g = 0; g < groups.len(); g += 1 {
            let alt_idx = groups[g][0];
            if g == 0 {
                w.begin(`let {var_name}: {type_name} = if {ctx.first_check_str(&first_sets[alt_idx])}`);
            } else if g < groups.len() - 1 {
                w.else_begin(`else if {ctx.first_check_str(&first_sets[alt_idx])}`);
            } else {
                w.else_begin("else");
            }
            ctx.group_counter = gc_after_self;
            gen_general_alt_construct(w, alts, alt_idx, &type_name, ctx, name_counts, group_index);
            if ctx.group_counter > gc_max {
                gc_max = ctx.group_counter;
            }
        }
        w.end_with(";");
        ctx.group_counter = gc_max;
    } else {
        // Overlapping FIRST sets — use Option + scan dispatch
        let opt_var = dedup_name(&`{var_name}_opt`, name_counts);
        w.line(`let mut {opt_var}: Option<{type_name}> = null;`);

        let grp_var = dedup_name(&"grp_kind", name_counts);
        w.line(`let {grp_var} = p.peek_kind();`);

        let mut gc_max = gc_after_self;
        for let mut g = 0; g < groups.len(); g += 1 {
            let group = &groups[g];

            let mut union_first: Array<String> = [];
            for let idx of group {
                dedup_append_arr(&mut union_first, &first_sets[*idx]);
            }

            let cond = ctx.kind_check_str(&union_first, &grp_var);
            if g == 0 {
                w.begin(`if {cond}`);
            } else {
                w.else_begin(`else if {cond}`);
            }

            ctx.group_counter = gc_after_self;
            if group.len() == 1 {
                let alt_idx = group[0];
                gen_general_alt_parse_and_store(w, alts, alt_idx, &type_name, &opt_var, ctx, name_counts, group_index);
            } else {
                let mut sorted_group = group.sorted();
                sort_group_by_mandatory_count_desc(&mut sorted_group, alts, ctx);
                gen_general_group_dispatch(w, alts, &sorted_group, &type_name, &opt_var, ctx, name_counts, group_index);
            }
            if ctx.group_counter > gc_max {
                gc_max = ctx.group_counter;
            }
        }
        w.end();
        ctx.group_counter = gc_max;

        w.begin(`if let None = {opt_var}`);
        w.line(`p.fail("group alternative")?;`);
        w.end();
        w.line(`let {var_name} = {opt_var}.unwrap();`);
    }
}

/// Parse one alt's elements and store into the variant Option variable.
fn gen_general_alt_parse_and_store(w: &mut CodeWriter, alts: &Array<Alternative>, alt_idx: i32, type_name: &String, inner_var: &String, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, group_index: i32) {
    let alt = &alts[alt_idx];
    let struct_name = general_group_alt_struct_name(&ctx.current_rule_name, group_index, alt_idx);

    let mut nc: Array<[String, i32]> = [];
    let gc_start = ctx.group_counter;
    gen_elements_with_non_greedy(w, &alt.elements, ctx, &mut nc, &([] as Array<String>));

    w.line(`{inner_var} = Option::<{type_name}>::Some({type_name}::Alt{alt_idx}({struct_name} \{`);
    w.indent();
    ctx.group_counter = gc_start;
    let mut assign_nc: Array<[String, i32]> = [];
    for let elem of &alt.elements {
        gen_field_assignment(w, elem, &mut assign_nc, ctx);
    }
    w.dedent();
    w.line("}));");
}

/// Parse one alt's elements and return as variant value (for if/else expression).
fn gen_general_alt_construct(w: &mut CodeWriter, alts: &Array<Alternative>, alt_idx: i32, type_name: &String, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, group_index: i32) {
    let alt = &alts[alt_idx];
    let struct_name = general_group_alt_struct_name(&ctx.current_rule_name, group_index, alt_idx);

    let mut nc: Array<[String, i32]> = [];
    let gc_start = ctx.group_counter;
    gen_elements_with_non_greedy(w, &alt.elements, ctx, &mut nc, &([] as Array<String>));

    w.line(`{type_name}::Alt{alt_idx}({struct_name} \{`);
    w.indent();
    ctx.group_counter = gc_start;
    let mut assign_nc: Array<[String, i32]> = [];
    for let elem of &alt.elements {
        gen_field_assignment(w, elem, &mut assign_nc, ctx);
    }
    w.dedent();
    w.line("})");
}

/// First-success-wins scan dispatch wrapper for overlapping general-group
/// alts. Asserts that every alt is fully scannable, then delegates to
/// `gen_general_group_scan_dispatch`. Backtracking has been removed; an
/// unscannable alt is a codegen-time error.
fn gen_general_group_dispatch(w: &mut CodeWriter, alts: &Array<Alternative>, sorted_group: &Array<i32>, type_name: &String, inner_var: &String, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, group_index: i32) {
    if !general_group_all_scannable(sorted_group, alts, ctx) {
        panic(
            "general group has unscannable alt; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')",
        );
    }
    gen_general_group_scan_dispatch(w, alts, sorted_group, type_name, inner_var, ctx, name_counts, group_index);
}

/// Returns true iff every alt in `sorted_group` has at least one element
/// and all its elements are scannable. Used as the precondition for
/// `gen_general_group_dispatch` (non-RuleRef-only overlapping groups).
fn general_group_all_scannable(sorted_group: &Array<i32>, alts: &Array<Alternative>, ctx: &mut GenContext) -> bool {
    if sorted_group.len() < 2 {
        return false;
    }
    for let mut k = 0; k < sorted_group.len(); k += 1 {
        let alt = &alts[sorted_group[k]];
        if alt.elements.len() == 0 {
            return false;
        }
        for let elem of &alt.elements {
            let mut visiting: Array<String> = [];
            if !ctx.is_element_scannable(elem, &mut visiting) {
                return false;
            }
        }
    }
    return true;
}

/// Returns true iff every alt's remaining suffix `[skip..]` is fully
/// scannable. Used as the precondition for the prediction-tree
/// `Ambiguous` branch to fall through to scan dispatch. An empty suffix
/// (`skip == alt.elements.len()`, i.e. an at-end alt produced by
/// `build_sll_node`'s `at_end_alts` path) is treated as scannable: its
/// scan trivially succeeds at the current position, and `sort_group_by_
/// element_count` sorts it last so it acts as the unconditional
/// fallback in `gen_group_scan_dispatch`.
fn ambiguous_node_all_scannable(sorted: &Array<i32>, alts: &Array<Alternative>, ctx: &mut GenContext, skip: i32) -> bool {
    if sorted.len() < 2 {
        return false;
    }
    for let mut k = 0; k < sorted.len(); k += 1 {
        let alt = &alts[sorted[k]];
        if skip > alt.elements.len() {
            return false;
        }
        for let mut i = skip; i < alt.elements.len(); i += 1 {
            let mut visiting: Array<String> = [];
            if !ctx.is_element_scannable(&alt.elements[i], &mut visiting) {
                return false;
            }
        }
    }
    return true;
}

/// First-success-wins scan dispatch for general groups (overlapping alts).
/// `sorted_group` is already in `sort_group_by_element_count` (longest-
/// first) order; we scan candidates in that order and commit to the first
/// match, then parse only the winner and store into `inner_var`. Same
/// rationale as `gen_group_scan_dispatch`: matches the longest-match
/// tournament's pick on the longest-first sort while skipping the remaining
/// scans, which matters when an alt's scan recurses through an LR rule.
fn gen_general_group_scan_dispatch(w: &mut CodeWriter, alts: &Array<Alternative>, sorted_group: &Array<i32>, type_name: &String, inner_var: &String, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, group_index: i32) {
    let winner_var = dedup_name(&"gd_winner", name_counts);
    let dispatch_label = dedup_name(&"gd_dispatch", name_counts);
    w.line(`let mut {winner_var}: i32 = -1;`);
    w.begin(`{dispatch_label}:`);
    let last = sorted_group.len() - 1;
    for let mut k = 0; k < sorted_group.len(); k += 1 {
        if k == last {
            break;
        }
        let alt = &alts[sorted_group[k]];
        let scan_label = dedup_name(&"gd_scan", name_counts);
        w.begin(`{scan_label}:`);
        w.line("let tokens = &p.tokens;");
        w.line("let mut pos: i32 = p.pos;");
        gen_scan_elements_in_block(w, &alt.elements, 0, alt.elements.len(), ctx, &scan_label);
        w.line(`{winner_var} = {k};`);
        w.line(`break {dispatch_label};`);
        w.end();
    }
    w.end();

    let gc_entry = ctx.group_counter;
    for let mut k = 0; k < sorted_group.len(); k += 1 {
        let alt_idx = sorted_group[k];
        let alt = &alts[alt_idx];
        let is_last = k == last;
        let struct_name = general_group_alt_struct_name(&ctx.current_rule_name, group_index, alt_idx);

        if k == 0 && !is_last {
            w.begin(`if {winner_var} == {k}`);
        } else if is_last {
            w.else_begin("else");
        } else {
            w.else_begin(`else if {winner_var} == {k}`);
        }

        ctx.group_counter = gc_entry;
        let mut nc: Array<[String, i32]> = [];
        let gc_alt = ctx.group_counter;
        gen_elements_with_non_greedy(w, &alt.elements, ctx, &mut nc, &([] as Array<String>));
        w.line(`{inner_var} = Option::<{type_name}>::Some({type_name}::Alt{alt_idx}({struct_name} \{`);
        w.indent();
        ctx.group_counter = gc_alt;
        let mut assign_nc: Array<[String, i32]> = [];
        for let elem of &alt.elements {
            gen_field_assignment(w, elem, &mut assign_nc, ctx);
        }
        w.dedent();
        w.line("}));");
    }
    w.end();
}

fn gen_prediction_body(w: &mut CodeWriter, group: &Array<i32>, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    // Build prediction tree for the group alternatives.
    let mut pred_indices: Array<i32> = [];
    let mut pred_firsts: Array<Array<String>> = [];
    let mut pred_elements: Array<Array<Element>> = [];
    for let mut k = 0; k < group.len(); k += 1 {
        let alt_idx = group[k];
        pred_indices.push(alt_idx);
        let mut visiting: Array<String> = [];
        pred_firsts.push(ctx.first_of_alt(&alts[alt_idx], &mut visiting));
        pred_elements.push(alts[alt_idx].elements);
    }
    let tree = build_prediction(&pred_indices, &pred_firsts, &pred_elements, 0, 5, ctx);
    gen_group_prediction_code(w, &tree, alts, ctx, name_counts);
}

fn gen_group_prediction_code(w: &mut CodeWriter, node: &PredictionNode, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>) {
    gen_group_prediction_code_skip(w, node, alts, ctx, name_counts, 0);
}

fn gen_group_prediction_code_skip(w: &mut CodeWriter, node: &PredictionNode, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, skip: i32) {
    if let Leaf(idx) = node {
        let elems = &alts[*idx].elements;
        for let mut i = skip; i < elems.len(); i += 1 {
            let elem = &elems[i];
            if let Repeat(rep) = elem {
                if rep.non_greedy {
                    let follow = ctx.first_of_elements_from(elems, i + 1);
                    let follow_second = compute_follow_second(elems, i + 1, ctx);
                    gen_repeat_non_greedy(w, rep, ctx, &follow, &follow_second, name_counts);
                    continue;
                }
            }
            gen_element(w, elem, ctx, name_counts);
        }
        return;
    }
    if let Consume(c) = node {
        gen_element(w, &c.element, ctx, name_counts);
        gen_group_prediction_code_skip(w, &c.child, alts, ctx, name_counts, skip + 1);
        return;
    }
    if let Ambiguous(indices) = node {
        let mut sorted = indices.sorted();
        // LL-correct ordering: longer alts first so first-success-wins
        // picks the longer match for prefix-overlap groups. The
        // priority-based `sort_group_by_element_count` is right for
        // rule-level dispatch (shorter alts are catch-alls) but wrong
        // here — see ANTLR4 LL prediction in
        // `vendor/antlr4/runtime/Java/src/org/antlr/v4/runtime/atn/
        // ParserATNSimulator.java`'s full-context fallback.
        sort_group_by_mandatory_count_desc(&mut sorted, alts, ctx);

        // Every alt's remaining elements must be fully scannable. Backtracking
        // has been removed; an unscannable suffix is a codegen-time error.
        if !ambiguous_node_all_scannable(&sorted, alts, ctx, skip) {
            panic(
                "prediction Ambiguous node has unscannable alt; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')",
            );
        }
        gen_group_scan_dispatch(w, &sorted, alts, ctx, name_counts, skip);
        return;
    }
    if let Dispatch(d) = node {
        let check_var = if d.depth == 0 { "p.peek_kind()" } else { `p.peek_at({d.depth})` };
        for let mut i = 0; i < d.branches.len(); i += 1 {
            let branch = &d.branches[i];
            let cond = ctx.kind_check_str(&branch.tokens, &check_var);
            if i == 0 {
                w.begin(`if {cond}`);
            } else {
                w.else_begin(`else if {cond}`);
            }
            gen_group_prediction_code_skip(w, &branch.child, alts, ctx, name_counts, skip);
        }
        w.end();
    }
}

/// First-success-wins scan dispatch for `gen_group_prediction_code`'s
/// `Ambiguous` node. The `sorted` parameter has already been ordered by
/// `sort_group_by_element_count` (longest-first), so scanning candidates
/// in that order and committing on first success matches what a
/// longest-match tournament would have picked while skipping the remaining
/// scans. Critical for performance when any alt's scan recurses through
/// an LR rule (`AGENTS.md` "Failed Approaches: Removing the LR Gate
/// ... 2026-04").
///
/// Each alt's remaining elements (from `skip`) are scanned inline. The
/// matching alt index is recorded in `gd_winner` and the winner is parsed
/// once via the trailing `if/else if/else` chain. The last alt is the
/// unconditional fallback so a real parse error surfaces when no scan
/// matched (or so an at-end empty-suffix alt acts as the epsilon
/// fallback — its scan trivially succeeds with zero tokens consumed).
fn gen_group_scan_dispatch(w: &mut CodeWriter, sorted: &Array<i32>, alts: &Array<Alternative>, ctx: &mut GenContext, name_counts: &mut Array<[String, i32]>, skip: i32) {
    let winner_var = dedup_name(&"gd_winner", name_counts);
    let dispatch_label = dedup_name(&"gd_dispatch", name_counts);
    w.line(`let mut {winner_var}: i32 = -1;`);
    w.begin(`{dispatch_label}:`);
    let last = sorted.len() - 1;
    for let mut k = 0; k < sorted.len(); k += 1 {
        // The last alt is the unconditional parse fallback — no scan needed.
        if k == last {
            break;
        }
        let alt = &alts[sorted[k]];
        let scan_label = dedup_name(&"gd_scan", name_counts);
        w.begin(`{scan_label}:`);
        w.line("let tokens = &p.tokens;");
        w.line("let mut pos: i32 = p.pos;");
        gen_scan_elements_in_block(w, &alt.elements, skip, alt.elements.len(), ctx, &scan_label);
        w.line(`{winner_var} = {k};`);
        w.line(`break {dispatch_label};`);
        w.end();
    }
    w.end();

    for let mut k = 0; k < sorted.len(); k += 1 {
        let alt = &alts[sorted[k]];
        let is_last = k == last;
        if k == 0 && !is_last {
            w.begin(`if {winner_var} == {k}`);
        } else if is_last {
            w.else_begin("else");
        } else {
            w.else_begin(`else if {winner_var} == {k}`);
        }
        let mut nc: Array<[String, i32]> = [];
        let saved_mask = ctx.current_follow_mask;
        let saved_call_follow = ctx.ruleref_call_follow;
        for let mut i = skip; i < alt.elements.len(); i += 1 {
            // Same per-position threading as `gen_alt_elements`. Mask
            // propagates only into tail-position elements; cleared
            // otherwise so a `Repeat` here does not accidentally
            // suppress on the variant's caller-follow. See
            // `compute_ruleref_call_follow` for the variant-selection
            // policy on the call-follow side.
            ctx.current_follow_mask = if ctx.tail_is_nullable_deep(&alt.elements, i + 1) {
                saved_mask
            } else {
                []
            };
            ctx.ruleref_call_follow = compute_ruleref_call_follow(&alt.elements, i, ctx);
            gen_element(w, &alt.elements[i], ctx, &mut nc);
            ctx.ruleref_call_follow = [];
        }
        ctx.current_follow_mask = saved_mask;
        ctx.ruleref_call_follow = saved_call_follow;
    }
    w.end();
}

/// True iff the alternative carries an `<assoc=right>` element option
/// (ANTLR4's only standardised associativity override at the alt level).
/// The option attaches to `Alternative.options` during parsing of
/// `| <assoc=right> ...` prefixes; see `vendor/antlr4/doc/options.md`.
fn is_right_associative(alt: &Alternative) -> bool {
    for let opt of &alt.options {
        if opt.name != "assoc" {
            continue;
        }
        if let Ident(v) = &opt.value {
            if *v == "right" {
                return true;
            }
        }
    }
    return false;
}

fn compute_lr_conflict_min_prec(alt: &Alternative, own_prec: i32, lr_indices: &Array<i32>, rule: &ParserRule, ctx: &mut GenContext, total_lr: i32) -> i32 {
    // Floor: left-associative alts reject same-precedence on the right
    // operand (min_prec = own_prec + 1); right-associative alts accept it
    // (min_prec = own_prec) so same-level operators nest rightward.
    // Conflict widening below still applies in either case.
    let mut min_prec = if is_right_associative(alt) { own_prec } else { own_prec + 1 };
    // Collect all fixed tokens in the suffix (elements after self-ref)
    let mut fixed_tokens: Array<String> = [];
    for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
        let elem = &alt.elements[ei];
        if let TokenRef(t) = elem {
            fixed_tokens.push(`TK_{t.name}`);
        }
        if let Literal(l) = elem {
            fixed_tokens.push(literal_const_name(&l.text));
        }
    }
    if fixed_tokens.len() == 0 {
        return min_prec;
    }

    // Widen min_prec only for STRICTLY higher-precedence alts whose suffix
    // claims one of our fixed tokens. Same/lower-prec conflicts are ours to
    // consume (left-assoc: own_prec+1 floor already blocks same-prec from
    // re-entering; right-assoc: same-prec on the right is the point). A
    // same-prec widen here would defeat right-associativity via self-
    // conflict (e.g. `| <assoc=right> x '**' y` has `**` in its own suffix).
    let mut lr_pos = 0;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let other = &rule.alternatives[lr_idx];
        if other.elements.len() <= 1 {
            lr_pos += 1;
            continue;
        }
        let other_prec = total_lr - lr_pos;
        if other_prec <= own_prec {
            lr_pos += 1;
            continue;
        }
        let suffix_first = ctx.first_of_elements_from(&other.elements, 1);
        for let ft of fixed_tokens {
            if first_contains(&suffix_first, &ft) {
                let candidate = other_prec + 1;
                if candidate > min_prec {
                    min_prec = candidate;
                }
            }
        }
        lr_pos += 1;
    }
    return min_prec;
}

/// Collect FIRST-of-suffix tokens across all LR alternatives. Used to detect
/// when a delimiter token following a non-final self-ref is also an LR binary
/// operator — in which case the self-ref must retain its inner min_prec to
/// avoid the delimiter being consumed as a binary op at the wrong precedence.
fn collect_lr_suffix_first_tokens(rule: &ParserRule, lr_indices: &Array<i32>, ctx: &mut GenContext) -> TreeSet<String> {
    let mut result = TreeSet::<String>::new();
    for let lr_i of lr_indices {
        let lr_alt = &rule.alternatives[*lr_i];
        if lr_alt.elements.len() > 1 {
            let sf = ctx.first_of_elements_from(&lr_alt.elements, 1);
            for let t of sf {
                result.insert(t);
            }
        }
    }
    return result;
}

/// Find the last self-recursive (RuleRef to rule itself) element index in the
/// given alternative's suffix (elements[1..]). Returns -1 if none.
fn find_last_self_ref_idx(alt: &Alternative, rule_name: &String) -> i32 {
    let mut last_self_ref_idx = -1;
    for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
        if let RuleRef(r) = &alt.elements[ei] {
            if r.name == *rule_name {
                last_self_ref_idx = ei;
            }
        }
    }
    return last_self_ref_idx;
}

/// Compute the min_prec value to use when emitting a self-recursive call at
/// position `ei` inside an LR suffix. The final self-ref (`ei == last_self_ref_idx`)
/// uses `inner_min_prec`. Non-final self-refs use 0, unless the next element is
/// a literal/token that also appears as an LR suffix-first token (e.g. AND in
/// BETWEEN…AND), in which case `inner_min_prec` is preserved.
fn compute_lr_self_ref_prec(alt: &Alternative, ei: i32, last_self_ref_idx: i32, inner_min_prec: i32, lr_suffix_first_tokens: &TreeSet<String>) -> i32 {
    let mut prec = inner_min_prec;
    if ei != last_self_ref_idx && ei + 1 < alt.elements.len() {
        let next_elem = &alt.elements[ei + 1];
        let mut next_is_lr_op = false;
        if let TokenRef(tr) = next_elem {
            if lr_suffix_first_tokens.contains(`TK_{tr.name}`) {
                next_is_lr_op = true;
            }
        }
        if let Literal(lit) = next_elem {
            if lr_suffix_first_tokens.contains(literal_const_name(&lit.text)) {
                next_is_lr_op = true;
            }
        }
        if !next_is_lr_op {
            prec = 0;
        }
    }
    return prec;
}

fn gen_lr_suffix_helpers(w: &mut CodeWriter, rule: &ParserRule, type_name: &String, lr_indices: &Array<i32>, ctx: &mut GenContext, fn_name: &String) {
    let case_names = case_names_for_rule(&rule.alternatives);
    let total_lr = lr_indices.len();
    let lr_suffix_first_tokens = collect_lr_suffix_first_tokens(rule, lr_indices, ctx);

    let mut lr_pos = 0;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 {
            lr_pos += 1;
            continue;
        }
        let own_prec = total_lr - lr_pos;

        let sname = `{strip_suffix(type_name, "Node")}{case_names[lr_idx]}`;
        let suffix_fn = `{*fn_name}_lr_{lr_idx}`;

        // Compute min_prec for self-recursive calls in this helper
        let inner_min_prec = compute_lr_conflict_min_prec(
            alt,
            own_prec,
            lr_indices,
            rule,
            ctx,
            total_lr,
        );

        let mut f = FnSpec::new(&suffix_fn);
        f.add_param("p", "&mut Parser");
        f.add_param("left", type_name);
        f.add_param("start", "i32");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);

        let mut name_counts: Array<[String, i32]> = [];
        // Reserve the binding the bt-side parse function uses for the
        // self-reference (the label name for `a=e`, the rule's own
        // field_name for the bare `e` form) so subsequent dedup matches.
        // `first_is_list_label` is true for ANTLR4's `+=` form, where the
        // resulting struct field has type `Array<T>` rather than `T` —
        // the helper must build `[left]` so the literal matches the field.
        let first_binding = if let Label(lab) = &alt.elements[0] {
            lab.field_name;
        } else {
            rule.field_name;
        };
        let first_is_list_label = if let Label(lab) = &alt.elements[0] {
            lab.list;
        } else {
            false;
        };
        dedup_name(&first_binding, &mut name_counts);

        ctx.group_counter = ctx.alt_gc_starts[lr_idx];
        let gc_lr = ctx.group_counter;

        let last_self_ref_idx = find_last_self_ref_idx(alt, &rule.name);

        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            let elem = &alt.elements[ei];
            if let RuleRef(rr) = elem {
                if rr.name == rule.name {
                    let field_name = dedup_name(&rr.field_name, &mut name_counts);
                    let prec = compute_lr_self_ref_prec(
                        alt,
                        ei,
                        last_self_ref_idx,
                        inner_min_prec,
                        &lr_suffix_first_tokens,
                    );
                    w.line(`let {field_name} = {*fn_name}(p, {prec})?;`);
                } else {
                    let elem_fn = `parse_{rr.snake_name}`;
                    let field_name = dedup_name(&rr.field_name, &mut name_counts);
                    w.line(`let {field_name} = {elem_fn}(p)?;`);
                }
            } else if let Label(lab) = elem {
                // Labeled self-recursive call: use precedence the same way
                // as the bare-RuleRef arm above, then re-bind to the label.
                // List labels (`+=`) declare an `Array<T>` field; wrap the
                // single per-iteration value to match the field type.
                if let RuleRef(rr) = &lab.element {
                    if rr.name == rule.name {
                        let lab_name = dedup_name(&lab.field_name, &mut name_counts);
                        let inner_name = dedup_name(&rr.field_name, &mut name_counts);
                        let prec = compute_lr_self_ref_prec(
                            alt,
                            ei,
                            last_self_ref_idx,
                            inner_min_prec,
                            &lr_suffix_first_tokens,
                        );
                        w.line(`let {inner_name} = {*fn_name}(p, {prec})?;`);
                        if lab.list {
                            // Type-annotate the local so `[inner]` parses as
                            // `Array<T>` rather than a 1-tuple `[T]`.
                            w.line(`let {lab_name}: Array<{type_name}> = [{inner_name}];`);
                        } else {
                            w.line(`let {lab_name} = {inner_name};`);
                        }
                        continue;
                    }
                }
                gen_element(w, elem, ctx, &mut name_counts);
            } else if let Group(grp) = elem {
                let alts = &grp.alternatives;
                if is_token_only_group(alts) {
                    gen_consume_token_group(w, alts, ctx, &mut name_counts);
                } else if is_simple_token_group(alts) {
                    let discard = dedup_name(&"op_tok", &mut name_counts);
                    w.line(`let {discard} = p.advance();`);
                } else {
                    gen_element(w, elem, ctx, &mut name_counts);
                }
            } else if let Repeat(rep) = elem {
                gen_repeat(w, rep, ctx, &mut name_counts, &([] as Array<String>));
            } else {
                gen_element(w, elem, ctx, &mut name_counts);
            }
        }

        let first_field = first_binding;
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case_names[lr_idx]}({sname} \{`);
        w.indent();
        emit_clamped_span_field(w);
        if first_is_list_label {
            // Cast so `[left]` matches the `Array<T>` field type rather
            // than the inferred 1-tuple `[T]`.
            w.line(`{first_field}: [left] as Array<{type_name}>,`);
        } else {
            w.line(`{first_field}: left,`);
        }
        ctx.group_counter = gc_lr;
        let mut field_counts: Array<[String, i32]> = [];
        // Reserve the field that `left` occupies so a repeat occurrence
        // (e.g. `a=e ... a=e`) deduplicates to `a_2` in the struct literal.
        dedup_name(&first_binding, &mut field_counts);
        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            gen_field_assignment(w, &alt.elements[ei], &mut field_counts, ctx);
        }
        w.dedent();
        w.line("}));");

        w.end();  // fn
        w.blank();
        lr_pos += 1;
    }
}

fn compute_lr_second_token(shared_token: &String, elements: &Array<Element>, ctx: &mut GenContext) -> Array<String> {
    // Find what token follows the shared_token in this alternative's suffix.
    // Walk suffix elements (starting at index 1) to find the shared token,
    // then return the first set of the next element.
    for let mut i = 1; i < elements.len(); i += 1 {
        let elem = &elements[i];
        // Check if this element contains the shared token
        let mut visiting: Array<String> = [];
        let elem_first = ctx.first_of_element(elem, &mut visiting);
        if !first_contains(&elem_first, shared_token) {
            continue;
        }

        // This element matches the shared token. Check if it's an Optional that wraps it.
        if is_nullable(elem) {
            // The shared token is inside an optional (e.g. K_NOT?).
            // The "second token" is the next element after the optional.
            if i + 1 < elements.len() {
                return ctx.first_of_elements_from(elements, i + 1);
            }
        }

        // The shared token is inside a Group (e.g. (K_ISNULL | K_NOTNULL | K_NOT K_NULL)).
        // Find the alternative within the group that starts with shared_token,
        // and return the first set of its second element.
        if let Group(g) = elem {
            let alts = &g.alternatives;
            for let mut a = 0; a < alts.len(); a += 1 {
                let alt = &alts[a];
                if alt.elements.len() < 1 {
                    continue;
                }
                let mut v2: Array<String> = [];
                let alt_first = ctx.first_of_element(&alt.elements[0], &mut v2);
                if first_contains(&alt_first, shared_token) && alt.elements.len() >= 2 {
                    return ctx.first_of_elements_from(&alt.elements, 1);
                }
            }
        }

        // Fallback: return next element's first set
        if i + 1 < elements.len() {
            return ctx.first_of_elements_from(elements, i + 1);
        }
    }
    return [];
}

fn gen_lr_call_with_prec(w: &mut CodeWriter, suffix_fn: &String, scan_suffix_fn: &String, prec: i32, use_prec: bool) {
    // First-token dispatch alone can mis-predict an LR continuation when the
    // suffix's first token is shared with the atom (e.g.
    // `statement: letterA | statement letterA 'b'`). In that case the suffix
    // can begin to match and then fail on a later element, leaving `p.pos`
    // mid-suffix and corrupting any enclosing repetition driver. Consult the
    // scan twin first — it has no side effects — and only commit to the
    // (mutating) parse when the scan confirms the suffix would succeed.
    if use_prec {
        w.begin(`if {prec} >= min_prec`);
        w.begin(`if {*scan_suffix_fn}(&p.tokens, p.pos) < 0`);
        w.line("break;");
        w.end();
        w.line(`result = {*suffix_fn}(p, result, start)?;`);
        w.else_begin("else");
        w.line("break;");
        w.end();
    } else {
        w.begin(`if {*scan_suffix_fn}(&p.tokens, p.pos) < 0`);
        w.line("break;");
        w.end();
        w.line(`result = {*suffix_fn}(p, result, start)?;`);
    }
}

fn gen_lr_overlap_dispatch(w: &mut CodeWriter, fn_name: &String, scan_fn_name: &String, rule: &ParserRule, group: &Array<i32>, valid_lr_indices: &Array<i32>, lr_precs: &Array<i32>, suffix_first_sets: &Array<Array<String>>, ctx: &mut GenContext, use_prec: bool) {
    // Pre-convert suffix_first_sets to TreeSets for efficient lookup.
    let mut suffix_sets: Array<TreeSet<String>> = [];
    for let sfs of suffix_first_sets {
        suffix_sets.push(str_set_from(sfs));
    }

    // For each token in the group, find which alternatives match it.
    // Unique token → dispatch directly. Shared token → sub-dispatch via peek_at(1).
    let mut emitted = TreeSet::<String>::new();
    let mut first_branch = true;

    // First pass: unique-token branches
    for let mut k = 0; k < group.len(); k += 1 {
        let this_first = &suffix_first_sets[group[k]];
        for let mut t = 0; t < this_first.len(); t += 1 {
            let tk = &this_first[t];
            if emitted.contains(*tk) {
                continue;
            }
            let mut shared = false;
            for let mut j = 0; j < group.len(); j += 1 {
                if j == k {
                    continue;
                }
                if suffix_sets[group[j]].contains(*tk) {
                    shared = true;
                }
            }
            if !shared {
                let lr_idx = valid_lr_indices[group[k]];
                let prec = lr_precs[group[k]];
                let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
                let scan_suffix_fn = `{*scan_fn_name}_lr_{lr_idx}`;
                if first_branch {
                    w.begin(`if suffix_kind == {*tk}`);
                    first_branch = false;
                } else {
                    w.else_begin(`else if suffix_kind == {*tk}`);
                }
                gen_lr_call_with_prec(w, &suffix_fn, &scan_suffix_fn, prec, use_prec);
                emitted.insert(*tk);
            }
        }
    }

    // Second pass: shared-token branches with peek_at(1) sub-dispatch
    let mut shared_tokens: Array<String> = [];
    let mut shared_seen = TreeSet::<String>::new();
    for let mut k = 0; k < group.len(); k += 1 {
        let sfs = &suffix_first_sets[group[k]];
        for let mut ti = 0; ti < sfs.len(); ti += 1 {
            let tk = &sfs[ti];
            if emitted.contains(*tk) {
                continue;
            }
            if !shared_seen.contains(*tk) {
                shared_seen.insert(*tk);
                shared_tokens.push(*tk);
            }
        }
    }
    for let mut st = 0; st < shared_tokens.len(); st += 1 {
        let shared_tk = &shared_tokens[st];
        if first_branch {
            w.begin(`if suffix_kind == {*shared_tk}`);
            first_branch = false;
        } else {
            w.else_begin(`else if suffix_kind == {*shared_tk}`);
        }
        let mut sub_first = true;
        let mut last_k = -1;
        for let mut k = 0; k < group.len(); k += 1 {
            if suffix_sets[group[k]].contains(*shared_tk) {
                last_k = k;
            }
        }
        for let mut k = 0; k < group.len(); k += 1 {
            if !suffix_sets[group[k]].contains(*shared_tk) {
                continue;
            }
            let lr_idx = valid_lr_indices[group[k]];
            let prec = lr_precs[group[k]];
            let alt = &rule.alternatives[lr_idx];
            let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
            let scan_suffix_fn = `{*scan_fn_name}_lr_{lr_idx}`;
            if k == last_k {
                if sub_first {
                    gen_lr_call_with_prec(w, &suffix_fn, &scan_suffix_fn, prec, use_prec);
                } else {
                    w.else_begin("else");
                    gen_lr_call_with_prec(w, &suffix_fn, &scan_suffix_fn, prec, use_prec);
                    w.end();
                }
            } else {
                let second = compute_lr_second_token(shared_tk, &alt.elements, ctx);
                let sub_cond = ctx.kind_check_str(&second, "p.peek_at(1)");
                if sub_first {
                    w.begin(`if {sub_cond}`);
                    sub_first = false;
                } else {
                    w.else_begin(`else if {sub_cond}`);
                }
                gen_lr_call_with_prec(w, &suffix_fn, &scan_suffix_fn, prec, use_prec);
            }
        }
        emitted.insert(*shared_tk);
    }
    if !first_branch {
        w.end();
    }
}

/// Precomputed per-LR-rule dispatch data shared between the parse-side and
/// scan-side suffix dispatchers. `valid_lr_indices` lists LR alternatives whose
/// suffix has a non-empty FIRST set (eligible for token-kind dispatch).
/// `suffix_first_sets[i]` is FIRST(elements[1..]) of the i-th valid alt.
/// `lr_precs[i]` is its precedence (first alt = highest = N, last = 1).
/// `groups` partitions the valid alts by FIRST-set overlap so that each group
/// becomes a single `if suffix_kind matches { ... }` branch; groups of size > 1
/// are resolved via a second-token (peek_at(1)) sub-dispatch.
struct LrDispatchData {
    valid_lr_indices: Array<i32>,
    suffix_first_sets: Array<Array<String>>,
    lr_precs: Array<i32>,
    groups: Array<Array<i32>>,
}

fn compute_lr_dispatch_data(rule: &ParserRule, lr_indices: &Array<i32>, ctx: &mut GenContext) -> LrDispatchData {
    let total_lr = lr_indices.len();

    let mut valid_lr_indices: Array<i32> = [];
    let mut suffix_first_sets: Array<Array<String>> = [];
    let mut lr_precs: Array<i32> = [];
    let mut lr_position = 0;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 {
            lr_position += 1;
            continue;
        }
        let suffix_first = ctx.first_of_elements_from(&alt.elements, 1);
        if suffix_first.len() == 0 {
            lr_position += 1;
            continue;
        }
        valid_lr_indices.push(lr_idx);
        suffix_first_sets.push(suffix_first);
        // Precedence: first LR alt = highest (N), last = 1
        lr_precs.push(total_lr - lr_position);
        lr_position += 1;
    }

    let groups = compute_overlap_groups(&suffix_first_sets);

    return LrDispatchData {
        valid_lr_indices,
        suffix_first_sets,
        lr_precs,
        groups,
    };
}

fn gen_lr_suffix_dispatch(w: &mut CodeWriter, rule: &ParserRule, type_name: &String, lr_indices: &Array<i32>, ctx: &mut GenContext, use_prec: bool, fn_name: &String, scan_fn_name: &String) {
    let d = compute_lr_dispatch_data(rule, lr_indices, ctx);

    w.begin("loop");
    w.line("let suffix_kind = p.peek_kind();");

    let mut is_first = true;
    for let mut g = 0; g < d.groups.len(); g += 1 {
        let group = &d.groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &d.suffix_first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, "suffix_kind");
        if is_first {
            w.begin(`if {cond}`);
            is_first = false;
        } else {
            w.else_begin(`else if {cond}`);
        }

        if group.len() == 1 {
            let lr_idx = d.valid_lr_indices[group[0]];
            let prec = d.lr_precs[group[0]];
            let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
            let scan_suffix_fn = `{*scan_fn_name}_lr_{lr_idx}`;
            gen_lr_call_with_prec(w, &suffix_fn, &scan_suffix_fn, prec, use_prec);
        } else {
            gen_lr_overlap_dispatch(
                w,
                fn_name,
                scan_fn_name,
                rule,
                group,
                &d.valid_lr_indices,
                &d.lr_precs,
                &d.suffix_first_sets,
                ctx,
                use_prec,
            );
        }
    }

    if !is_first {
        w.else_begin("else");
        w.line("break;");
        w.end();
    } else {
        w.line("break;");
    }
    w.end();  // loop
}

fn gen_prediction_code(w: &mut CodeWriter, node: &PredictionNode, fn_name: &String, alts: &Array<Alternative>, lowered_rule: &Rule, type_name: &String, ctx: &mut GenContext) {
    let mut nc: Array<[String, i32]> = [];
    gen_prediction_code_inner(w, node, fn_name, alts, lowered_rule, type_name, ctx, 0, &mut nc);
}

fn gen_prediction_code_inner(w: &mut CodeWriter, node: &PredictionNode, fn_name: &String, alts: &Array<Alternative>, lowered_rule: &Rule, type_name: &String, ctx: &mut GenContext, skip: i32, name_counts: &mut Array<[String, i32]>) {
    if let Leaf(idx) = node {
        if skip == 0 {
            w.line(`return {*fn_name}_bt_{idx}(p);`);
        } else {
            // Consumed prefix tokens already — inline the remaining alt body.
            let alt_case_names = case_names_for_rule(alts);
            let alt = &alts[*idx];
            let sname = `{strip_suffix(type_name, "Node")}{alt_case_names[*idx]}`;
            ctx.group_counter = ctx.alt_gc_starts[*idx];
            let saved_prefix_prec = ctx.prefix_self_ref_min_prec;
            if let Some(rule) = ctx.find_rule(&ctx.current_rule_name) {
                ctx.prefix_self_ref_min_prec = compute_prefix_self_ref_min_prec(rule, *idx);
            }
            let body = rule_alt_body(lowered_rule, *idx).unwrap();
            gen_alt_body_skip(
                w,
                type_name,
                Option::<String>::Some(alt_case_names[*idx]),
                Option::<String>::Some(sname),
                alt,
                body,
                ctx,
                skip,
            );
            ctx.prefix_self_ref_min_prec = saved_prefix_prec;
        }
        return;
    }
    if let Consume(c) = node {
        // Verify the consumed element matches the expected element at position skip.
        // If it doesn't (e.g. a RuleRef at position skip was expanded via Dispatch
        // and the Consume is actually for a later element), the skip count would be
        // wrong and the Leaf would generate incorrect code. In that case, don't
        // increment skip — the Leaf will fall back to the scan-tournament helper.
        let elem_matches = elements_match(&c.element, &alts[0].elements[skip]);
        if elem_matches {
            gen_element(w, &c.element, ctx, name_counts);
            gen_prediction_code_inner(w, &c.child, fn_name, alts, lowered_rule, type_name, ctx, skip + 1, name_counts);
        } else {
            // Element mismatch — prediction consumed a later element.
            // Don't emit the consume or increment skip; treat as skip=0 at the Leaf.
            gen_prediction_code_inner(w, &c.child, fn_name, alts, lowered_rule, type_name, ctx, 0, name_counts);
        }
        return;
    }
    if let Ambiguous(indices) = node {
        // Sort by element count for proper ordering (single RuleRef first, etc.)
        let mut sorted_indices = indices.sorted();
        sort_group_by_element_count(&mut sorted_indices, alts);
        if skip == 0 {
            // Check if any alternatives have scan functions available.
            // If ALL non-last alternatives have scans, we run a longest-match
            // scan tournament: scan each, parse the winner. If some have
            // scans and some don't, use a hybrid approach.
            let mut all_have_scans = true;
            for let mut i = 0; i < sorted_indices.len() - 1; i += 1 {
                let idx = sorted_indices[i];
                if !alt_has_scan(&alts[idx].elements, ctx) {
                    all_have_scans = false;
                    break;
                }
            }

            if all_have_scans && sorted_indices.len() >= 2 {
                // All non-last alternatives have scan functions.
                // Check if ALL scans are full (cover entire alternative) —
                // including the last alt, which we need to scan for
                // longest-match dispatch.
                let mut all_full = true;
                for let mut i = 0; i < sorted_indices.len(); i += 1 {
                    let idx = sorted_indices[i];
                    if !alt_has_scan(&alts[idx].elements, ctx) || !alt_scan_is_full(&alts[idx].elements, ctx) {
                        all_full = false;
                        break;
                    }
                }

                if all_full {
                    // All scans cover entire alternatives — scan success
                    // guarantees parse success. Use longest-match first-win
                    // (ANTLR4-compatible): scan each alt, pick the one
                    // advancing pos the furthest; ties go to the first alt
                    // in grammar order.
                    w.line("let _sd_tokens = &p.tokens;");
                    w.line("let _sd_pos = p.pos;");
                    for let mut i = 0; i < sorted_indices.len(); i += 1 {
                        let idx = sorted_indices[i];
                        w.line(`let _sd_p_{idx} = {*fn_name}_scan_{idx}(_sd_tokens, _sd_pos);`);
                    }
                    w.line("let mut _sd_best_i: i32 = -1;");
                    w.line("let mut _sd_best_p: i32 = -1;");
                    for let mut i = 0; i < sorted_indices.len(); i += 1 {
                        let idx = sorted_indices[i];
                        w.begin(`if _sd_p_{idx} > _sd_best_p`);
                        w.line(`_sd_best_p = _sd_p_{idx};`);
                        w.line(`_sd_best_i = {idx};`);
                        w.end();
                    }
                    for let mut i = 0; i < sorted_indices.len(); i += 1 {
                        let idx = sorted_indices[i];
                        w.begin(`if _sd_best_i == {idx}`);
                        w.line(`return {*fn_name}_bt_{idx}(p);`);
                        w.end();
                    }
                    // Fall through: no alt's scan succeeded. Emit error via
                    // the last alt's parse path (which produces a useful
                    // diagnostic).
                    let last_idx = sorted_indices[sorted_indices.len() - 1];
                    w.line(`return {*fn_name}_bt_{last_idx}(p);`);
                } else {
                    // Some scans are partial — scan success is a hint,
                    // not a guarantee. Use save/restore with scan guards.
                    w.line("let saved = p.pos;");
                    for let mut i = 0; i < sorted_indices.len(); i += 1 {
                        let idx = sorted_indices[i];
                        let is_last = i == sorted_indices.len() - 1;
                        if is_last {
                            w.line(`return {*fn_name}_bt_{idx}(p);`);
                        } else {
                            let has_scan = alt_has_scan(&alts[idx].elements, ctx);
                            let is_full = has_scan && alt_scan_is_full(&alts[idx].elements, ctx);
                            if is_full {
                                // Full scan: success guarantees parse success.
                                w.begin(`if {*fn_name}_scan_{idx}(&p.tokens, p.pos) >= 0`);
                                w.line(`return {*fn_name}_bt_{idx}(p);`);
                                w.end();
                            } else if has_scan {
                                // Partial scan: try parse, fall through on failure.
                                w.begin(`if {*fn_name}_scan_{idx}(&p.tokens, p.pos) >= 0`);
                                w.line(`let r_{idx} = {*fn_name}_bt_{idx}(p);`);
                                w.begin(`if let Err(_) = r_{idx}`);
                                w.line("p.pos = saved;");
                                w.else_begin("else");
                                w.line(`return r_{idx};`);
                                w.end();
                                w.end();
                            } else {
                                // No scan: save-and-rewind speculative parse.
                                w.line(`let r_{idx} = {*fn_name}_bt_{idx}(p);`);
                                w.begin(`if let Err(_) = r_{idx}`);
                                w.line("p.pos = saved;");
                                w.else_begin("else");
                                w.line(`return r_{idx};`);
                                w.end();
                            }
                        }
                    }
                }
            } else {
                // Fallback: save-and-rewind speculative parse pattern.
                w.line("let saved = p.pos;");
                for let mut i = 0; i < sorted_indices.len(); i += 1 {
                    let idx = sorted_indices[i];
                    let is_last = i == sorted_indices.len() - 1;
                    if is_last {
                        w.line(`return {*fn_name}_bt_{idx}(p);`);
                    } else {
                        w.line(`let r_{idx} = {*fn_name}_bt_{idx}(p);`);
                        w.begin(`if let Err(_) = r_{idx}`);
                        w.line("p.pos = saved;");
                        w.else_begin("else");
                        w.line(`return r_{idx};`);
                        w.end();
                    }
                }
            }
        } else {
            // Prefix already consumed — should not happen.
            // Consume nodes that lead to Ambiguous are stripped at build time.
            panic("unreachable: Consume leading to Ambiguous should have been stripped");
        }
        return;
    }
    if let Dispatch(d) = node {
        let check_var = if d.depth == 0 { "p.peek_kind()" } else { `p.peek_at({d.depth})` };
        for let mut i = 0; i < d.branches.len(); i += 1 {
            let branch = &d.branches[i];
            let cond = ctx.kind_check_str(&branch.tokens, &check_var);
            if i == 0 {
                w.begin(`if {cond}`);
            } else {
                w.else_begin(`else if {cond}`);
            }
            gen_prediction_code_inner(
                w,
                &branch.child,
                fn_name,
                alts,
                lowered_rule,
                type_name,
                ctx,
                skip,
                name_counts,
            );
        }
        w.end();
    }
}

/// Check if a consumed element matches the expected element at a given skip position.
/// Returns true only for exact terminal matches (TokenRef or Literal).
/// Unwraps Labels to compare inner elements.
fn elements_match(consumed: &Element, expected: &Element) -> bool {
    let exp = unwrap_label(expected);
    if let TokenRef(a) = consumed {
        if let TokenRef(b) = exp {
            return a.name == b.name;
        }
    }
    if let Literal(a) = consumed {
        if let Literal(b) = exp {
            return a.text == b.text;
        }
    }
    return false;
}

// `unwrap_label`, `is_left_recursive`, `is_prefix_alt`,
// `is_self_ref_element`, `compute_prefix_self_ref_min_prec`
// have moved to `lr_util.wado`.

fn gen_multi_alt_body_bt(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, type_name: &String, ctx: &mut GenContext, groups: &Array<Array<i32>>, first_sets: &Array<Array<String>>, non_lr_indices: &Array<i32>) {
    let case_names = case_names_for_rule(&rule.alternatives);
    let fn_name = `parse_{rule.snake_name}`;
    w.line("let kind = p.peek_kind();");

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];
        let mut union_first: Array<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, "kind");
        w.begin(`if {cond}`);

        if group.len() == 1 {
            let alt_idx = non_lr_indices[group[0]];
            let alt = &rule.alternatives[alt_idx];
            let sname = `{strip_suffix(type_name, "Node")}{case_names[alt_idx]}`;
            ctx.group_counter = ctx.alt_gc_starts[alt_idx];
            let saved_prefix_prec = ctx.prefix_self_ref_min_prec;
            ctx.prefix_self_ref_min_prec = compute_prefix_self_ref_min_prec(rule, alt_idx);
            let body = rule_alt_body(lowered_rule, alt_idx).unwrap();
            gen_alt_body(
                w,
                type_name,
                Option::<String>::Some(case_names[alt_idx]),
                Option::<String>::Some(sname),
                alt,
                body,
                ctx,
            );
            ctx.prefix_self_ref_min_prec = saved_prefix_prec;
        } else {
            // Sort group by specificity before building prediction tree.
            let mut sorted_group = group.sorted();
            sort_group_by_specificity(&mut sorted_group, first_sets);
            let mut pred_indices: Array<i32> = [];
            let mut pred_firsts: Array<Array<String>> = [];
            let mut pred_elements: Array<Array<Element>> = [];
            for let mut k = 0; k < sorted_group.len(); k += 1 {
                let idx = sorted_group[k];
                let real_idx = non_lr_indices[idx];
                pred_indices.push(real_idx);
                pred_firsts.push(first_sets[idx]);
                pred_elements.push(rule.alternatives[real_idx].elements);
            }
            let tree = build_prediction(&pred_indices, &pred_firsts, &pred_elements, 0, 5, ctx);
            gen_prediction_code(w, &tree, &fn_name, &rule.alternatives, lowered_rule, type_name, ctx);
        }

        w.end();
    }

    gen_error_fallback(w, rule, type_name, ctx);
}

/// Emit the public `parse(input)` entry function that dispatches
/// into the first rule's parser. Read entirely from
/// `lowered.parser_rules[0].header` — `RuleHeader` carries the
/// pre-computed `type_name` and `snake_name` so this fn doesn't
/// re-run `rule_type_name` or recompute the function name. A
/// mismatch between lower's header and emit's expectations would
/// surface here as a wrong fn name reference at the top of the
/// generated source.
fn gen_parse_entry(w: &mut CodeWriter, lowered: &LoweredGrammar) {
    if lowered.parser_rules.len() == 0 {
        return;
    }
    let header = rule_header(&lowered.parser_rules[0]);
    let fn_name = `parse_{header.snake_name}`;
    let mut f = FnSpec::new("parse");
    f.set_pub();
    f.add_param("input", "&String");
    f.set_return_type(`Result<{header.type_name}, ParseError>`);
    f.emit_begin(w);
    w.line("let tokens = tokenize(input);");
    w.line("let mut parser = Parser::new(tokens);");
    w.line(`return {fn_name}(&mut parser);`);
    w.end();
    w.blank();
}

/// Emit a `_gale_kind_set_<id>(k: i32) -> bool` function for every
/// multi-element token-kind set interned during parser codegen. The
/// `ctx.kind_check_str` and `ctx.kind_negate_check_str` methods rewrite
/// every multi-element `matches { ... }` check into a call into one of
/// these helpers, so duplicate sets share a single function body in
/// the generated wasm.
/// Emit `_gale_kind_set_<id>(k) -> bool` helpers. The id range
/// `0..lowered.kind_sets.len()` reads tokens directly from
/// `lowered.kind_sets` — that's lower's Phase 2.7 pre-interning
/// surfacing as actual generated code. Higher ids (sets emit-time
/// `kind_check_str` interned during walk) read from
/// `ctx.kind_sets()` as a salvage tail, same pattern as the
/// variant-emission split.
///
/// For the lower-registered prefix, the generated helper body is
/// the canonical proof that `lowered.kind_sets[i].tokens` matches
/// what emit subsequently calls — a mismatch would compile but
/// parse wrong (the helper body would not include the token emit
/// queries). Today the two registries converge by construction
/// because both intern through the same `ctx.intern_kind_set`
/// keyed by canonical token order.
pub fn gen_kind_set_helpers(w: &mut CodeWriter, lowered: &LoweredGrammar, ctx: &GenContext) {
    let entries = ctx.kind_sets();
    for let mut idx = 0; idx < entries.len(); idx += 1 {
        if idx < lowered.kind_sets.len() {
            let ks = &lowered.kind_sets[idx];
            gen_kind_set_helper_raw(w, ks.id, &ks.tokens);
        } else {
            let entry = &entries[idx];
            gen_kind_set_helper_raw(w, entry.id, &entry.tokens);
        }
    }
}

fn gen_kind_set_helper_raw(w: &mut CodeWriter, id: i32, tokens: &Array<String>) {
    let mut f = FnSpec::new(&`_gale_kind_set_{id}`);
    f.add_param("k", "i32");
    f.set_return_type("bool");
    f.emit_begin(w);
    let mut body = String::with_capacity(64);
    body.push_str("return k matches { ");
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            body.push_str(" | ");
        }
        body.push_str(tokens[i]);
    }
    body.push_str(" };");
    w.line(&body);
    w.end();
    w.blank();
}

fn build_lookahead_condition(ctx: &mut GenContext, pos_sets: &Array<Array<String>>, depth: i32) -> String {
    let mut cond = String::with_capacity(128);
    for let mut d = 0; d < depth; d += 1 {
        if d > 0 {
            cond.push_str(" && ");
        }
        let tokens = &pos_sets[d];
        let check_expr = if d == 0 { "kind" } else { `p.peek_at({d})` };
        cond.push_str(ctx.kind_check_str(tokens, &check_expr));
    }
    return cond;
}

fn gen_error_fallback(w: &mut CodeWriter, rule: &ParserRule, type_name: &String, ctx: &mut GenContext) {
    let mut expected: Array<String> = [];
    for let alt of rule.alternatives {
        let mut visiting: Array<String> = [];
        let first = ctx.first_of_alt(&alt, &mut visiting);
        dedup_append_arr(&mut expected, &first);
    }
    let msg = escape_string(&`expected {rule.name}`);
    w.line(`return Result::<{type_name}, ParseError>::Err(ParseError::new(`);
    w.indent();
    w.line(`{msg},`);
    w.line("p.peek().span,");
    w.write("[");
    for let mut i = 0; i < expected.len(); i += 1 {
        if i > 0 {
            w.write(", ");
        }
        let s = escape_string(&expected[i]);
        w.write(s);
    }
    w.write("],\n");
    w.dedent();
    w.line("));");
}

fn find_needed_depth(all_position_sets: &Array<Array<Array<String>>>) -> i32 {
    let max_k = 5;
    for let mut depth = 1; depth <= max_k; depth += 1 {
        let mut all_ok = true;
        for let mut i = 0; i < all_position_sets.len(); i += 1 {
            for let mut j = i + 1; j < all_position_sets.len(); j += 1 {
                let mut still_ambiguous = true;
                for let mut d = 0; d < depth; d += 1 {
                    if d >= all_position_sets[i].len() || d >= all_position_sets[j].len() {
                        still_ambiguous = false;
                        break;
                    }
                    if !sets_overlap(&all_position_sets[i][d], &all_position_sets[j][d]) {
                        still_ambiguous = false;
                        break;
                    }
                }
                if still_ambiguous {
                    all_ok = false;
                }
            }
        }
        if all_ok {
            return depth;
        }
    }
    return max_k;
}

fn dedup_name(base: &String, counts: &mut Array<[String, i32]>) -> String {
    let count = get_count(counts, base);
    increment_count(counts, base);
    if count > 0 {
        return `{base}_{count + 1}`;
    }
    return *base;
}

fn get_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.push([*name, 1]);
}

/// True iff the alternative is left-recursive: its first element references
/// the enclosing rule by name. ANTLR4 treats labeled self-references like
/// `a=e` at the start of an alt as left-recursive too (per
/// `vendor/antlr4/doc/left-recursion.md`), so `is_self_ref_element`
/// unwraps one `Label`.
// `is_left_recursive` / `is_prefix_alt` / `is_self_ref_element` /
// `compute_prefix_self_ref_min_prec` have moved to `lr_util.wado`.

fn compute_overlap_groups(first_sets: &Array<Array<String>>) -> Array<Array<i32>> {
    let n = first_sets.len();
    let mut group_ids: Array<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        group_ids.push(i);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = i + 1; j < n; j += 1 {
            if sets_overlap(&first_sets[i], &first_sets[j]) {
                let gi = group_ids[i];
                let gj = group_ids[j];
                if gi != gj {
                    for let mut k = 0; k < n; k += 1 {
                        if group_ids[k] == gj {
                            group_ids[k] = gi;
                        }
                    }
                }
            }
        }
    }
    let mut seen_ids: Array<i32> = [];
    let mut groups: Array<Array<i32>> = [];
    for let mut i = 0; i < n; i += 1 {
        let gid = group_ids[i];
        let mut found = -1;
        for let mut s = 0; s < seen_ids.len(); s += 1 {
            if seen_ids[s] == gid {
                found = s;
                break;
            }
        }
        if found >= 0 {
            groups[found].push(i);
        } else {
            seen_ids.push(gid);
            groups.push([i]);
        }
    }
    return groups;
}

fn has_multi_alt_groups(groups: &Array<Array<i32>>) -> bool {
    for let group of groups {
        if group.len() > 1 {
            return true;
        }
    }
    return false;
}

fn sort_group_by_specificity(group: &mut Array<i32>, first_sets: &Array<Array<String>>) {
    // Sort by first set size ascending: smaller first set = more specific = try first.
    // Ties broken by original order (stable-ish bubble sort).
    for let mut i = 0; i < group.len(); i += 1 {
        for let mut j = i + 1; j < group.len(); j += 1 {
            if first_sets[group[j]].len() < first_sets[group[i]].len() {
                let tmp = group[i];
                group[i] = group[j];
                group[j] = tmp;
            }
        }
    }
}

// Priority bands consumed by `alt_sort_priority` and friends. Higher
// = try first.
//
// `MultiTokenLed` (4) is most specific: a multi-element alt whose
// first non-nullable element is a fixed token (e.g. `K_CAST '(' expr
// K_AS type_name ')'`). The leading token uniquely identifies the
// alt, so committing on first match is safe.
//
// `BareRuleRef` (3) is the catch-all rank: a single-RuleRef alt
// whose body can match complex internal patterns (`join_clause`,
// `expr`). Tried before `MultiRuleRefLed` so single-RuleRef
// catch-alls win against multi-element-RuleRef siblings — this is
// what SQLite-style `(table_or_subquery (',' tor)* | join_clause)`
// dispatch relies on.
//
// `MultiRuleRefLed` (2) is a multi-element alt whose first non-
// nullable element is itself a RuleRef. Less specific than
// `BareRuleRef` because the RuleRef prefix is shared with the
// catch-all sibling.
//
// `BareToken` (1) is a single Token/Literal alt — the cheapest
// fallback (e.g. `K_INSERT` alone).
global ALT_PRIORITY_MULTI_TOKEN_LED: i32 = 4;
global ALT_PRIORITY_BARE_RULE_REF: i32 = 3;
global ALT_PRIORITY_MULTI_RULE_REF_LED: i32 = 2;
global ALT_PRIORITY_BARE_TOKEN: i32 = 1;

fn alt_sort_priority(alt: &Alternative) -> i32 {
    if alt.elements.len() == 1 {
        let elem = &alt.elements[0];
        if let RuleRef(_) = elem {
            return ALT_PRIORITY_BARE_RULE_REF;
        }
        return ALT_PRIORITY_BARE_TOKEN;
    }
    // Multi-element: check first non-nullable element.
    for let elem of alt.elements {
        if is_nullable(&elem) {
            continue;
        }
        if let TokenRef(_) | Literal(_) = elem {
            return ALT_PRIORITY_MULTI_TOKEN_LED;
        }
        break;
    }
    return ALT_PRIORITY_MULTI_RULE_REF_LED;
}

/// Sort `group` so the alt with the most MANDATORY (non-deeply-
/// nullable) elements comes first, breaking ties by `alt_sort_priority`
/// (single-RuleRef catch-alls win against multi-element-RuleRef
/// siblings) and finally source order. Used by the prediction tree's
/// `Ambiguous` case (and the matching parse-side group dispatches) to
/// pick the longer MANDATORY match between alts that share a prefix.
///
/// Counting mandatory elements only is the LL distinguisher:
/// `( a b | a )` (where `b` is mandatory) sorts the 2-elem alt first,
/// while `( a b? | a )` (where `b?` is optional) ties on mandatory
/// length and falls through to priority — which prefers the single-
/// RuleRef catch-all the way ANTLR4's full-context fallback does for
/// SQLite-style `( tor (',' tor)* | join_clause )` groupings.
fn sort_group_by_mandatory_count_desc(group: &mut Array<i32>, alts: &Array<Alternative>, ctx: &mut GenContext) {
    for let mut i = 0; i < group.len(); i += 1 {
        for let mut j = i + 1; j < group.len(); j += 1 {
            let li = ll_match_length(&alts[group[i]], ctx);
            let lj = ll_match_length(&alts[group[j]], ctx);
            let mut swap = false;
            if lj > li {
                swap = true;
            } else if lj == li {
                let pi = alt_sort_priority(&alts[group[i]]);
                let pj = alt_sort_priority(&alts[group[j]]);
                if pj > pi {
                    swap = true;
                } else if pj == pi {
                    if group[j] < group[i] {
                        swap = true;
                    }
                }
            }
            if swap {
                let tmp = group[i];
                group[i] = group[j];
                group[j] = tmp;
            }
        }
    }
}

/// LL-aware "match length" for `alt`, used to sort group alternatives so
/// the more specific LL alt wins on overlap-prefix ties. Counts every
/// mandatory top-level element plus every *trailing* deep-nullable
/// element that is first-exact (single-token-derived; see
/// `GenContext::element_is_first_exact`).
///
/// Why this is the right key: a first-exact nullable trailing element
/// like `b?` (where `b : Y`) is "1 token whose presence is decisive" —
/// when `Y` is in the input, alt 0 of `(a b? | a)` is the LL-correct
/// pick because `b?` will fire and consume `Y`. Counting it as a
/// pseudo-mandatory token sorts alt 0 ahead of the bare-RuleRef
/// catch-all alt 1, mirroring ANTLR4's full-context LL preference for
/// the longer meaningful match. Multi-element nullable structures
/// (SQLite's `(',' tor)*` Star) stay at the original count because
/// their first set is not first-exact, preserving the join-clause
/// catch-all behaviour their grammars depend on.
///
/// The `seen_mandatory` gate restricts the trailing-nullable bonus to
/// nullables that follow a committed token. A *leading* nullable like
/// `b?` in `( b? a c | a c )` cannot disambiguate length: the runtime
/// has not yet committed to either alt at that position, so claiming
/// "alt 0 has 3 tokens" is no better signal than "alt 1 has 2" —
/// either alt's `a c` will match. Counting only post-mandatory
/// nullables means the bonus fires exactly when it can shorten the
/// LL decision: after a shared prefix has committed, a tail-position
/// `b?` whose presence is decisive elects the longer alt.
fn ll_match_length(alt: &Alternative, ctx: &mut GenContext) -> i32 {
    let mut count: i32 = 0;
    let mut seen_mandatory: bool = false;
    for let elem of &alt.elements {
        let mut visiting: Array<String> = [];
        if !ctx.element_is_nullable_deep(elem, &mut visiting) {
            count += 1;
            seen_mandatory = true;
        } else if seen_mandatory && ctx.element_is_first_exact(elem) {
            count += 1;
        }
    }
    return count;
}

fn sort_group_by_element_count(group: &mut Array<i32>, alts: &Array<Alternative>) {
    for let mut i = 0; i < group.len(); i += 1 {
        for let mut j = i + 1; j < group.len(); j += 1 {
            let pi = alt_sort_priority(&alts[group[i]]);
            let pj = alt_sort_priority(&alts[group[j]]);
            let mut swap = false;
            if pj > pi {
                swap = true;
            } else if pj == pi {
                // Within same-priority tier: more elements = more specific = first
                if alts[group[j]].elements.len() > alts[group[i]].elements.len() {
                    swap = true;
                }
            }
            if swap {
                let tmp = group[i];
                group[i] = group[j];
                group[j] = tmp;
            }
        }
    }
}
