use {
    Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement,
    RepeatKind, LexerRule,
} from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use {
    to_lower, to_snake_case, to_pascal_case, rule_type_name, literal_field_name,
    strip_suffix, escape_string, literal_const_name, array_contains_str,
} from "./gen_util.wado";
use { CodeWriter, StructSpec, ImplSpec, FnSpec } from "./wadopoet.wado";
use { log_stderr } from "core:cli";

// --- Prediction Engine ---

variant PredictionNode {
    Leaf(i32),
    Dispatch(PredictionDispatch),
    Consume(ConsumeNode),
    Backtrack(Array<i32>),
}

struct ConsumeNode {
    element: Element,
    child: PredictionNode,
}

struct PredictionDispatch {
    depth: i32,
    branches: Array<PredictionBranch>,
}

struct PredictionBranch {
    tokens: Array<String>,
    child: PredictionNode,
}

fn build_prediction(
    alt_indices: &Array<i32>,
    first_sets: &Array<Array<String>>,
    alt_elements: &Array<Array<Element>>,
    depth: i32,
    max_depth: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> PredictionNode {
    // Build initial SLL configs: one per alternative, at element position 0.
    let mut configs: Array<SllConfig> = [];
    for let mut i = 0; i < alt_indices.len(); i += 1 {
        configs.append(SllConfig {
            alt_index: alt_indices[i],
            elements: alt_elements[i],
            pos: 0,
        });
    }
    let tree = build_sll_node(&configs, 0, max_depth, all_rules, lit_tokens);
    return strip_dead_consume(tree);
}

/// Strip Consume nodes whose child is a Backtrack — fall back to
/// Backtrack from the original position rather than consuming then failing.
fn strip_dead_consume(node: PredictionNode) -> PredictionNode {
    if let Consume(c) = node {
        let child = strip_dead_consume(c.child);
        if let Backtrack(_) = child {
            // Consuming prefix didn't help — return Backtrack with original alts.
            return child;
        }
        return PredictionNode::Consume(ConsumeNode { element: c.element, child });
    }
    if let Dispatch(d) = node {
        let mut new_branches: Array<PredictionBranch> = [];
        for let b of d.branches {
            new_branches.append(PredictionBranch {
                tokens: b.tokens,
                child: strip_dead_consume(b.child),
            });
        }
        return PredictionNode::Dispatch(PredictionDispatch { depth: d.depth, branches: new_branches });
    }
    return node;
}

struct SllConfig {
    alt_index: i32,
    elements: Array<Element>,
    pos: i32,
}

fn sll_config_clone(c: &SllConfig) -> SllConfig {
    return SllConfig {
        alt_index: c.alt_index,
        elements: c.elements,
        pos: c.pos,
    };
}

/// Identity closure — nullable handling is done in sll_config_first
/// (first_of_elements_from) and sll_advance_inner (explicit skip logic).
fn sll_closure(configs: &Array<SllConfig>) -> Array<SllConfig> {
    return *configs;
}

fn _sll_closure_unused(configs: &Array<SllConfig>) -> Array<SllConfig> {
    let mut result: Array<SllConfig> = [];
    for let c of configs {
        let mut cur = sll_config_clone(c);
        while cur.pos < cur.elements.len() && is_nullable(&cur.elements[cur.pos]) {
            cur.pos += 1;
        }
        result.append(cur);
    }
    return result;
}

/// Compute FIRST set of the current position in a config.
/// Includes tokens from nullable elements that were skipped by closure.
fn sll_config_first(
    c: &SllConfig,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<String> {
    if c.pos < 0 || c.pos >= c.elements.len() { return []; }
    return first_of_elements_from(&c.elements, c.pos, all_rules, lit_tokens);
}

/// Advance a config by one token. For terminals, advance pos.
/// For RuleRef, expand into the rule's alternatives (entering the rule).
fn sll_advance(
    c: &SllConfig,
    token: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<SllConfig> {
    return sll_advance_inner(c, token, all_rules, lit_tokens, 0);
}

fn sll_advance_inner(
    c: &SllConfig,
    token: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    inline_depth: i32,
) -> Array<SllConfig> {
    // Limit inline expansion depth to prevent explosion from recursive rules.
    if inline_depth > 2 { return []; }
    if c.pos < 0 || c.pos >= c.elements.len() { return []; }
    let elem = &c.elements[c.pos];

    // Nullable element (Optional, Star): either match its inner or skip it.
    if is_nullable(elem) {
        let mut results: Array<SllConfig> = [];
        let mut visiting: Array<String> = [];
        if array_contains_str(&first_of_element(elem, all_rules, lit_tokens, &mut visiting), token) {
            results.append(SllConfig { alt_index: c.alt_index, elements: c.elements, pos: c.pos + 1 });
        }
        // Also try skipping: advance past all consecutive nullables non-recursively.
        let mut skip_pos = c.pos + 1;
        while skip_pos < c.elements.len() && is_nullable(&c.elements[skip_pos]) {
            let mut v: Array<String> = [];
            if array_contains_str(&first_of_element(&c.elements[skip_pos], all_rules, lit_tokens, &mut v), token) {
                results.append(SllConfig { alt_index: c.alt_index, elements: c.elements, pos: skip_pos + 1 });
            }
            skip_pos += 1;
        }
        if skip_pos < c.elements.len() {
            let skipped_elem = &c.elements[skip_pos];
            if let TokenRef(name) = *skipped_elem {
                if `TK_{name}` == *token {
                    results.append(SllConfig { alt_index: c.alt_index, elements: c.elements, pos: skip_pos + 1 });
                }
            } else if let Literal(text) = *skipped_elem {
                if literal_const_name(&text) == *token {
                    results.append(SllConfig { alt_index: c.alt_index, elements: c.elements, pos: skip_pos + 1 });
                }
            } else if let RuleRef(name) = *skipped_elem {
                let mut v: Array<String> = [];
                if array_contains_str(&first_of_rule(&name, all_rules, lit_tokens, &mut v), token) {
                    let mut stv: Array<String> = [];
                    if rule_is_single_token(&name, all_rules, &mut stv) {
                        results.append(SllConfig { alt_index: c.alt_index, elements: c.elements, pos: skip_pos + 1 });
                    } else {
                        results.append(SllConfig { alt_index: c.alt_index, elements: c.elements, pos: -1 });
                    }
                }
            } else {
                let mut v: Array<String> = [];
                if array_contains_str(&first_of_element(skipped_elem, all_rules, lit_tokens, &mut v), token) {
                    results.append(SllConfig { alt_index: c.alt_index, elements: c.elements, pos: skip_pos + 1 });
                }
            }
        }
        return results;
    }

    // Terminal: if token matches, advance past this element.
    if let TokenRef(name) = *elem {
        if `TK_{name}` == *token {
            return [SllConfig { alt_index: c.alt_index, elements: c.elements, pos: c.pos + 1 }];
        }
        return [];
    }
    if let Literal(text) = *elem {
        if literal_const_name(&text) == *token {
            return [SllConfig { alt_index: c.alt_index, elements: c.elements, pos: c.pos + 1 }];
        }
        return [];
    }

    // RuleRef: advance past only if the rule always consumes exactly one token.
    // Multi-token rules can't be safely skipped because token position wouldn't
    // correspond to element position.
    if let RuleRef(name) = *elem {
        let mut visiting: Array<String> = [];
        let rule_first = first_of_rule(&name, all_rules, lit_tokens, &mut visiting);
        if !array_contains_str(&rule_first, token) {
            return [];
        }
        let mut st_visiting: Array<String> = [];
        if rule_is_single_token(&name, all_rules, &mut st_visiting) {
            // Single-token rule: safe to advance, element position == token position.
            return [SllConfig { alt_index: c.alt_index, elements: c.elements, pos: c.pos + 1 }];
        }
        // Multi-token rule: token matches FIRST but we can't advance past it.
        // Return config with pos = -1 as a sentinel meaning "opaque match".
        return [SllConfig { alt_index: c.alt_index, elements: c.elements, pos: -1 }];
    }

    // Group: treat as consuming one token if the token is in FIRST(group).
    if let Group(alts) = *elem {
        let mut group_first: Array<String> = [];
        for let alt of alts {
            let mut visiting: Array<String> = [];
            let af = first_of_alt(&alt, all_rules, lit_tokens, &mut visiting);
            for let tk of af {
                if !array_contains_str(&group_first, &tk) {
                    group_first.append(tk);
                }
            }
        }
        if array_contains_str(&group_first, token) {
            return [SllConfig { alt_index: c.alt_index, elements: c.elements, pos: c.pos + 1 }];
        }
        return [];
    }

    // Repeat: treat as consuming the inner element.
    if let Repeat(rep) = *elem {
        let mut inner_first: Array<String> = [];
        let mut visiting: Array<String> = [];
        inner_first = first_of_element(&rep.element, all_rules, lit_tokens, &mut visiting);
        if array_contains_str(&inner_first, token) {
            // Advance past the repeat element (simplified: treat as consuming 1 token).
            return [SllConfig { alt_index: c.alt_index, elements: c.elements, pos: c.pos + 1 }];
        }
        return [];
    }

    // Label: unwrap.
    if let Label(lab) = *elem {
        let unwrapped = SllConfig {
            alt_index: c.alt_index,
            elements: replace_element_at(&c.elements, c.pos, &lab.element),
            pos: c.pos,
        };
        return sll_advance_inner(&unwrapped, token, all_rules, lit_tokens, inline_depth);
    }

    return [];
}

fn replace_element_at(elements: &Array<Element>, pos: i32, replacement: &Element) -> Array<Element> {
    let mut result: Array<Element> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if i == pos {
            result.append(*replacement);
        } else {
            result.append(elements[i]);
        }
    }
    return result;
}

/// Collect unique alt indices from configs.
fn sll_unique_alts(configs: &Array<SllConfig>) -> Array<i32> {
    let mut alts: Array<i32> = [];
    for let c of configs {
        if !array_contains_i32(&alts, c.alt_index) {
            alts.append(c.alt_index);
        }
    }
    return alts;
}

/// Deduplicate configs: merge configs with the same (alt_index) that reach
/// the same prediction outcome. For SLL, two configs with the same alt_index
/// are equivalent for prediction purposes.
fn sll_dedup_by_alt(configs: &Array<SllConfig>) -> Array<SllConfig> {
    let mut seen_alts: Array<i32> = [];
    let mut result: Array<SllConfig> = [];
    for let c of configs {
        if !array_contains_i32(&seen_alts, c.alt_index) {
            seen_alts.append(c.alt_index);
            result.append(sll_config_clone(c));
        }
    }
    return result;
}

fn build_sll_node(
    configs: &Array<SllConfig>,
    depth: i32,
    max_depth: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> PredictionNode {
    let closed = sll_closure(configs);

    // Guard: if too many configs, fall back to backtracking to avoid explosion.
    if closed.len() > 200 {
        let alts = sll_unique_alts(&closed);
        return PredictionNode::Backtrack(alts);
    }

    // Check unique alternatives.
    let alts = sll_unique_alts(&closed);
    if alts.len() == 1 {
        return PredictionNode::Leaf(alts[0]);
    }
    if alts.len() == 0 || depth >= max_depth {
        return PredictionNode::Backtrack(alts);
    }

    // Check for common prefix: if all configs are at a terminal element
    // that is the same across all configs, emit Consume.
    let common = sll_find_common_terminal(&closed);
    if let Some(elem) = common {
        // Advance all configs past this shared terminal.
        let mut advanced: Array<SllConfig> = [];
        for let c of closed {
            advanced.append(SllConfig {
                alt_index: c.alt_index,
                elements: c.elements,
                pos: c.pos + 1,
            });
        }
        let child = build_sll_node(&advanced, depth, max_depth, all_rules, lit_tokens);
        return PredictionNode::Consume(ConsumeNode { element: elem, child });
    }

    // Compute FIRST set for each config.
    let mut all_tokens: Array<String> = [];
    let mut config_firsts: Array<Array<String>> = [];
    for let c of closed {
        let first = sll_config_first(&c, all_rules, lit_tokens);
        config_firsts.append(first);
        for let tk of first {
            if !array_contains_str(&all_tokens, &tk) {
                all_tokens.append(tk);
            }
        }
    }

    // Build dispatch branches.
    let mut branches: Array<PredictionBranch> = [];

    for let mut t = 0; t < all_tokens.len(); t += 1 {
        let tk = &all_tokens[t];

        // Advance all configs that can match this token.
        let mut next_configs: Array<SllConfig> = [];
        let mut opaque_alts: Array<i32> = [];
        for let mut i = 0; i < closed.len(); i += 1 {
            if array_contains_str(&config_firsts[i], tk) {
                let advanced = sll_advance(&closed[i], tk, all_rules, lit_tokens);
                for let a of advanced {
                    if a.pos == -1 {
                        // Opaque config: multi-token RuleRef, can't advance past.
                        if !array_contains_i32(&opaque_alts, a.alt_index) {
                            opaque_alts.append(a.alt_index);
                        }
                    } else {
                        next_configs.append(a);
                    }
                }
            }
        }

        if next_configs.len() == 0 && opaque_alts.len() == 0 { continue; }

        // Dedup: keep one config per alt (SLL ignores context).
        let deduped = sll_dedup_by_alt(&next_configs);
        let mut next_alts = sll_unique_alts(&deduped);
        // Add opaque alts (they survive regardless of further lookahead).
        for let oa of opaque_alts {
            if !array_contains_i32(&next_alts, oa) {
                next_alts.append(oa);
            }
        }

        if next_alts.len() == 1 {
            // Resolved: this token uniquely identifies one alternative.
            let mut merged = false;
            for let mut b = 0; b < branches.len(); b += 1 {
                if let Leaf(idx) = branches[b].child {
                    if idx == next_alts[0] {
                        branches[b].tokens.append(*tk);
                        merged = true;
                    }
                }
            }
            if !merged {
                branches.append(PredictionBranch {
                    tokens: [*tk],
                    child: PredictionNode::Leaf(next_alts[0]),
                });
            }
        } else {
            // Still ambiguous: recurse with deeper lookahead.
            // If opaque alts exist, they can't be resolved further — Backtrack.
            let child = if opaque_alts.len() > 0 {
                PredictionNode::Backtrack(next_alts)
            } else {
                build_sll_node(&deduped, depth + 1, max_depth, all_rules, lit_tokens)
            };
            let mut merged = false;
            for let mut b = 0; b < branches.len(); b += 1 {
                if prediction_node_eq(&branches[b].child, &child) {
                    branches[b].tokens.append(*tk);
                    merged = true;
                }
            }
            if !merged {
                branches.append(PredictionBranch {
                    tokens: [*tk],
                    child,
                });
            }
        }
    }

    if branches.len() == 0 {
        return PredictionNode::Backtrack(alts);
    }
    return PredictionNode::Dispatch(PredictionDispatch { depth, branches });
}

/// Check if all configs are at the same terminal element (for Consume).
fn sll_find_common_terminal(configs: &Array<SllConfig>) -> Option<Element> {
    if configs.len() < 2 { return null; }
    for let c of configs {
        if c.pos >= c.elements.len() { return null; }
    }
    let first_elem = &configs[0].elements[configs[0].pos];
    if let TokenRef(name) = *first_elem {
        for let mut i = 1; i < configs.len(); i += 1 {
            let elem = &configs[i].elements[configs[i].pos];
            if let TokenRef(other) = *elem {
                if other != name { return null; }
            } else { return null; }
        }
        return Option::<Element>::Some(*first_elem);
    }
    if let Literal(text) = *first_elem {
        for let mut i = 1; i < configs.len(); i += 1 {
            let elem = &configs[i].elements[configs[i].pos];
            if let Literal(other) = *elem {
                if other != text { return null; }
            } else { return null; }
        }
        return Option::<Element>::Some(*first_elem);
    }
    return null;
}

/// Check if all alternatives start with the same element (TokenRef, Literal, or RuleRef).
fn find_common_prefix_element(alt_elements: &Array<Array<Element>>) -> Option<Element> {
    if alt_elements.len() < 2 { return null; }
    // All alternatives must be non-empty.
    for let elems of alt_elements {
        if elems.len() == 0 { return null; }
    }
    let first_elem = &alt_elements[0][0];
    if let TokenRef(name) = *first_elem {
        for let mut i = 1; i < alt_elements.len(); i += 1 {
            if let TokenRef(other) = alt_elements[i][0] {
                if other != name { return null; }
            } else { return null; }
        }
        return Option::<Element>::Some(*first_elem);
    }
    if let Literal(text) = *first_elem {
        for let mut i = 1; i < alt_elements.len(); i += 1 {
            if let Literal(other) = alt_elements[i][0] {
                if other != text { return null; }
            } else { return null; }
        }
        return Option::<Element>::Some(*first_elem);
    }
    if let RuleRef(name) = *first_elem {
        for let mut i = 1; i < alt_elements.len(); i += 1 {
            if let RuleRef(other) = alt_elements[i][0] {
                if other != name { return null; }
            } else { return null; }
        }
        return Option::<Element>::Some(*first_elem);
    }
    return null;
}

/// Return elements from index `start` onward.
fn elements_suffix(elements: &Array<Element>, start: i32) -> Array<Element> {
    let mut result: Array<Element> = [];
    for let mut i = start; i < elements.len(); i += 1 {
        result.append(elements[i]);
    }
    return result;
}

/// Compute first set of a sequence of elements.
fn first_of_elements(
    elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    let mut result: Array<String> = [];
    for let elem of elements {
        let ef = first_of_element(&elem, all_rules, lit_tokens, visiting);
        for let tk of ef {
            if !array_contains_str(&result, &tk) {
                result.append(tk);
            }
        }
        if !is_nullable(&elem) { break; }
    }
    return result;
}

fn prediction_node_eq(a: &PredictionNode, b: &PredictionNode) -> bool {
    if let Leaf(ai) = *a {
        if let Leaf(bi) = *b { return ai == bi; }
    }
    if let Backtrack(aa) = *a {
        if let Backtrack(ba) = *b {
            if aa.len() != ba.len() { return false; }
            for let mut i = 0; i < aa.len(); i += 1 {
                if aa[i] != ba[i] { return false; }
            }
            return true;
        }
    }
    // Consume nodes: check same element kind and recurse on child.
    if let Consume(ca) = *a {
        if let Consume(cb) = *b {
            return element_eq(&ca.element, &cb.element)
                && prediction_node_eq(&ca.child, &cb.child);
        }
    }
    return false;
}

fn element_eq(a: &Element, b: &Element) -> bool {
    if let TokenRef(na) = *a {
        if let TokenRef(nb) = *b { return na == nb; }
    }
    if let Literal(ta) = *a {
        if let Literal(tb) = *b { return ta == tb; }
    }
    return false;
}

fn compute_deeper_first(
    elements: &Array<Element>,
    depth: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<String> {
    let mut pos = 0;
    let mut remaining = depth;
    while pos < elements.len() && remaining > 0 {
        let elem = &elements[pos];
        if let TokenRef(_) | Literal(_) = *elem { remaining -= 1; pos += 1; continue; }
        if is_nullable(elem) { pos += 1; continue; }
        // SLL advancement: single-token RuleRef consumes exactly 1 token,
        // so we can safely advance past it and look at the next element.
        if let RuleRef(name) = *elem {
            let mut visiting: Array<String> = [];
            if rule_is_single_token(&name, all_rules, &mut visiting) {
                remaining -= 1;
                pos += 1;
                continue;
            }
        }
        return [];
    }
    if pos >= elements.len() { return []; }
    return first_of_elements_from(elements, pos, all_rules, lit_tokens);
}

/// Check if a rule always consumes exactly one token.
/// True when every alternative has exactly one non-nullable element
/// that is either a terminal (TokenRef/Literal) or a single-token RuleRef.
fn rule_is_single_token(
    name: &String,
    all_rules: &Array<ParserRule>,
    visiting: &mut Array<String>,
) -> bool {
    if array_contains_str(visiting, name) { return false; }
    visiting.append(*name);

    let mut found = false;
    for let rule of all_rules {
        if rule.name != *name { continue; }
        found = true;
        for let alt of rule.alternatives {
            let mut non_nullable_count = 0;
            let mut single_ok = false;
            for let elem of alt.elements {
                if is_nullable(&elem) { continue; }
                non_nullable_count += 1;
                if non_nullable_count > 1 { break; }
                if let TokenRef(_) | Literal(_) = elem {
                    single_ok = true;
                } else if let RuleRef(r) = elem {
                    single_ok = rule_is_single_token(&r, all_rules, visiting);
                }
            }
            if non_nullable_count != 1 || !single_ok {
                remove_from_visiting(visiting, name);
                return false;
            }
        }
        break;
    }

    remove_from_visiting(visiting, name);
    return found;
}

fn remove_from_visiting(visiting: &mut Array<String>, name: &String) {
    let mut new_arr: Array<String> = [];
    for let v of visiting {
        if *v != *name { new_arr.append(*v); }
    }
    *visiting = new_arr;
}

fn array_contains_i32(arr: &Array<i32>, val: i32) -> bool {
    for let mut i = 0; i < arr.len(); i += 1 {
        if arr[i] == val { return true; }
    }
    return false;
}

fn count_backtrack_nodes(node: &PredictionNode) -> i32 {
    if let Backtrack(_) = *node { return 1; }
    if let Dispatch(d) = *node {
        let mut count = 0;
        for let mut i = 0; i < d.branches.len(); i += 1 {
            count += count_backtrack_nodes(&d.branches[i].child);
        }
        return count;
    }
    if let Consume(c) = *node { return count_backtrack_nodes(&c.child); }
    return 0;
}

fn count_leaf_nodes(node: &PredictionNode) -> i32 {
    if let Leaf(_) = *node { return 1; }
    if let Dispatch(d) = *node {
        let mut count = 0;
        for let mut i = 0; i < d.branches.len(); i += 1 {
            count += count_leaf_nodes(&d.branches[i].child);
        }
        return count;
    }
    if let Consume(c) = *node { return count_leaf_nodes(&c.child); }
    return 0;
}

pub fn gen_parser(w: &mut CodeWriter, grammar: &Grammar, lit_tokens: &Array<LitToken>) {
    gen_parser_struct(w);
    for let rule of grammar.parser_rules {
        gen_parse_fn(w, &rule, &grammar.parser_rules, lit_tokens);
    }
    gen_parse_entry(w, &grammar.parser_rules);
}

fn gen_parser_struct(w: &mut CodeWriter) {
    let mut s = StructSpec::new("Parser");
    s.add_field("tokens", "Array<Token>");
    s.add_field("pos", "i32");
    s.emit(w);
    w.blank();

    ImplSpec::new("Parser").emit_begin(w);

    let mut f = FnSpec::new("new");
    f.add_param("tokens", "Array<Token>");
    f.set_return_type("Parser");
    f.emit_begin(w);
    w.line("return Parser { tokens, pos: 0 };");
    w.end();
    w.blank();

    let mut f2 = FnSpec::new("peek");
    f2.set_receiver("&self");
    f2.set_return_type("&Token");
    f2.emit_begin(w);
    w.line("return &self.tokens[self.pos];");
    w.end();
    w.blank();

    let mut f3 = FnSpec::new("peek_kind");
    f3.set_receiver("&self");
    f3.set_return_type("i32");
    f3.emit_begin(w);
    w.line("return self.tokens[self.pos].kind;");
    w.end();
    w.blank();

    let mut f4 = FnSpec::new("peek_at");
    f4.set_receiver("&self");
    f4.add_param("offset", "i32");
    f4.set_return_type("i32");
    f4.emit_begin(w);
    w.line("let idx = self.pos + offset;");
    w.line("if idx >= self.tokens.len() { return TK_EOF; }");
    w.line("return self.tokens[idx].kind;");
    w.end();
    w.blank();

    let mut f5 = FnSpec::new("advance");
    f5.set_receiver("&mut self");
    f5.set_return_type("Token");
    f5.emit_begin(w);
    w.line("let tok = self.tokens[self.pos];");
    w.line("self.pos += 1;");
    w.line("return tok;");
    w.end();
    w.blank();

    let mut f6 = FnSpec::new("last_end");
    f6.set_receiver("&self");
    f6.set_return_type("i32");
    f6.emit_begin(w);
    w.line("if self.pos == 0 { return 0; }");
    w.line("return self.tokens[self.pos - 1].span.end;");
    w.end();
    w.blank();

    let mut f7 = FnSpec::new("expect");
    f7.set_receiver("&mut self");
    f7.add_param("kind", "i32");
    f7.add_param("name", "String");
    f7.set_return_type("Result<Token, ParseError>");
    f7.emit_begin(w);
    w.begin("if self.tokens[self.pos].kind == kind");
    w.line("return Result::<Token, ParseError>::Ok(self.advance());");
    w.end();
    w.line("let tok = &self.tokens[self.pos];");
    w.line("return Result::<Token, ParseError>::Err(ParseError::new(");
    w.indent();
    w.line("`expected {name}, got \"{tok.text}\"`,");
    w.line("tok.span,");
    w.line("[name],");
    w.dedent();
    w.line("));");
    w.end();

    w.end(); // impl
    w.blank();
}

fn gen_parse_fn(
    w: &mut CodeWriter,
    rule: &ParserRule,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let type_name = rule_type_name(&rule.name);
    let fn_name = `parse_{to_snake_case(&rule.name)}`;

    if rule.alternatives.len() == 1 {
        let mut f = FnSpec::new(&fn_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        gen_alt_body(w, &type_name, null, null, &rule.alternatives[0], all_rules, lit_tokens);
        w.end();
        w.blank();
        return;
    }

    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    let mut non_lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if !is_left_recursive(&rule.alternatives[i], &rule.name) {
            non_lr_indices.append(i);
        }
    }

    let mut first_sets: Array<Array<String>> = [];
    for let idx of non_lr_indices {
        let mut visiting: Array<String> = [];
        first_sets.append(first_of_alt(&rule.alternatives[idx], all_rules, lit_tokens, &mut visiting));
    }
    let mut groups = compute_overlap_groups(&first_sets);
    let needs_bt = has_multi_alt_groups(&groups);

    if needs_bt {
        for let mut g = 0; g < groups.len(); g += 1 {
            if groups[g].len() > 1 {
                sort_group_by_specificity(&mut groups[g], &first_sets);
                let mut mapped_alts: Array<Alternative> = [];
                for let gi of groups[g] {
                    mapped_alts.append(rule.alternatives[non_lr_indices[gi]]);
                }
                let mut local_indices: Array<i32> = [];
                for let mut i = 0; i < groups[g].len(); i += 1 {
                    local_indices.append(i);
                }
                sort_group_by_element_count(&mut local_indices, &mapped_alts);
                let mut reordered: Array<i32> = [];
                for let li of local_indices {
                    reordered.append(groups[g][li]);
                }
                groups[g] = reordered;
            }
        }
    }

    if needs_bt {
        for let group of groups {
            if group.len() > 1 {
                for let gi of group {
                    let alt_idx = non_lr_indices[gi];
                    let alt = &rule.alternatives[alt_idx];
                    let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{alt_idx}` };
                    let sname = `{strip_suffix(&type_name, "Node")}{case_name}`;
                    let helper_name = `{fn_name}_bt_{alt_idx}`;

                    let mut f = FnSpec::new(&helper_name);
                    f.add_param("p", "&mut Parser");
                    f.set_return_type(`Result<{type_name}, ParseError>`);
                    f.emit_begin(w);
                    w.line("let start = p.peek().span.start;");
                    gen_alt_body(w, &type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens);
                    w.end();
                    w.blank();
                }
            }
        }
    }

    let mut lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if is_left_recursive(&rule.alternatives[i], &rule.name) {
            lr_indices.append(i);
        }
    }
    let has_lr = lr_indices.len() > 0;

    if has_lr {
        let atom_name = `{fn_name}_atom`;
        let mut f = FnSpec::new(&atom_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        if needs_bt {
            gen_multi_alt_body_bt(w, rule, &type_name, all_rules, lit_tokens, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(w, rule, &type_name, all_rules, lit_tokens);
        }
        w.end();
        w.blank();

        gen_lr_suffix_helpers(w, rule, &type_name, &lr_indices, all_rules, lit_tokens);

        // Generate parse_rule_prec(p, min_prec) — the precedence-aware parser
        let prec_fn = `{fn_name}_prec`;
        let mut f2 = FnSpec::new(&prec_fn);
        f2.add_param("p", "&mut Parser");
        f2.add_param("min_prec", "i32");
        f2.set_return_type(`Result<{type_name}, ParseError>`);
        f2.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        w.line(`let mut result = {fn_name}_atom(p)?;`);
        gen_lr_suffix_dispatch(w, rule, &type_name, &lr_indices, all_rules, lit_tokens, true);
        w.line(`return Result::<{type_name}, ParseError>::Ok(result);`);
        w.end();
        w.blank();

        // Generate parse_rule(p) — wrapper that allows all precedences
        let mut f3 = FnSpec::new(&fn_name);
        f3.add_param("p", "&mut Parser");
        f3.set_return_type(`Result<{type_name}, ParseError>`);
        f3.emit_begin(w);
        w.line(`return {prec_fn}(p, 0);`);
        w.end();
        w.blank();
    } else {
        let mut f = FnSpec::new(&fn_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        if needs_bt {
            gen_multi_alt_body_bt(w, rule, &type_name, all_rules, lit_tokens, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(w, rule, &type_name, all_rules, lit_tokens);
        }
        w.end();
        w.blank();
    }
}

fn gen_alt_body(
    w: &mut CodeWriter,
    type_name: &String,
    variant_case: Option<String>,
    struct_name: Option<String>,
    alt: &Alternative,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    gen_alt_elements(w, &alt.elements, all_rules, lit_tokens);

    if let Some(case) = variant_case {
        let sname = struct_name.unwrap();
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case}({sname} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        gen_field_assignments(w, &alt.elements);
        w.dedent();
        w.line("}));");
    } else {
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        gen_field_assignments(w, &alt.elements);
        w.dedent();
        w.line("});");
    }
}

fn gen_alt_body_skip(
    w: &mut CodeWriter,
    type_name: &String,
    variant_case: Option<String>,
    struct_name: Option<String>,
    alt: &Alternative,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    skip: i32,
) {
    // Parse elements from `skip` onward (prefix already consumed).
    // Replay name counter for consumed elements so dedup_name stays in sync.
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < skip; i += 1 {
        replay_element_names(&alt.elements[i], &mut name_counts);
    }
    for let mut i = skip; i < alt.elements.len(); i += 1 {
        let elem = &alt.elements[i];
        if let Repeat(rep) = *elem {
            if let Optional = rep.kind {
                if is_ruleref_optional(&rep.element) {
                    let follow = first_of_elements_from(&alt.elements, i + 1, all_rules, lit_tokens);
                    gen_repeat_with_follow(w, &rep, all_rules, lit_tokens, &follow, &mut name_counts);
                } else {
                    gen_repeat(w, &rep, all_rules, lit_tokens, &mut name_counts);
                }
            } else if rep.non_greedy {
                let follow = first_of_elements_from(&alt.elements, i + 1, all_rules, lit_tokens);
                let follow_second = compute_follow_second(&alt.elements, i + 1, all_rules, lit_tokens);
                gen_repeat_non_greedy(w, &rep, all_rules, lit_tokens, &follow, &follow_second, &mut name_counts);
            } else {
                gen_repeat(w, &rep, all_rules, lit_tokens, &mut name_counts);
            }
        } else {
            gen_element(w, elem, all_rules, lit_tokens, true, &mut name_counts);
        }
    }

    if let Some(case) = variant_case {
        let sname = struct_name.unwrap();
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case}({sname} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        gen_field_assignments(w, &alt.elements);
        w.dedent();
        w.line("}));");
    } else {
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        gen_field_assignments(w, &alt.elements);
        w.dedent();
        w.line("});");
    }
}

fn gen_multi_alt_body(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    let max_k = 5;
    let mut all_pos_sets: Array<Array<Array<String>>> = [];
    for let alt of rule.alternatives {
        all_pos_sets.append(alt_position_first_sets(&alt, max_k, all_rules, lit_tokens));
    }
    let depth = find_needed_depth(&all_pos_sets);

    w.line("let kind = p.peek_kind();");

    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        let alt = &rule.alternatives[i];
        let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{i}` };
        let sname = `{strip_suffix(type_name, "Node")}{case_name}`;

        let pos_sets = &all_pos_sets[i];
        let cond_depth = if depth < pos_sets.len() { depth } else { pos_sets.len() };

        if cond_depth > 0 {
            let cond = build_lookahead_condition(pos_sets, cond_depth);
            w.begin(`if {cond}`);
        } else {
            w.begin("scope:");
        }

        gen_alt_body(w, type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens);
        w.end();
    }

    gen_error_fallback(w, rule, type_name, all_rules, lit_tokens);
}

fn gen_alt_elements(
    w: &mut CodeWriter,
    elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let mut name_counts: Array<[String, i32]> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        let elem = &elements[i];
        if let Repeat(rep) = *elem {
            if let Optional = rep.kind {
                if is_ruleref_optional(&rep.element) {
                    let follow = first_of_elements_from(elements, i + 1, all_rules, lit_tokens);
                    gen_repeat_with_follow(w, &rep, all_rules, lit_tokens, &follow, &mut name_counts);
                } else {
                    gen_repeat(w, &rep, all_rules, lit_tokens, &mut name_counts);
                }
            } else if rep.non_greedy {
                let follow = first_of_elements_from(elements, i + 1, all_rules, lit_tokens);
                let follow_second = compute_follow_second(elements, i + 1, all_rules, lit_tokens);
                gen_repeat_non_greedy(w, &rep, all_rules, lit_tokens, &follow, &follow_second, &mut name_counts);
            } else {
                gen_repeat(w, &rep, all_rules, lit_tokens, &mut name_counts);
            }
        } else {
            gen_element(w, elem, all_rules, lit_tokens, true, &mut name_counts);
        }
    }
}

fn gen_elements_with_non_greedy(
    w: &mut CodeWriter,
    elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    for let mut i = 0; i < elements.len(); i += 1 {
        let elem = &elements[i];
        if let Repeat(rep) = *elem {
            if rep.non_greedy {
                let follow = first_of_elements_from(elements, i + 1, all_rules, lit_tokens);
                let follow_second = compute_follow_second(elements, i + 1, all_rules, lit_tokens);
                gen_repeat_non_greedy(w, &rep, all_rules, lit_tokens, &follow, &follow_second, name_counts);
            } else {
                gen_element(w, elem, all_rules, lit_tokens, false, name_counts);
            }
        } else {
            gen_element(w, elem, all_rules, lit_tokens, false, name_counts);
        }
    }
}

fn is_ruleref_optional(elem: &Element) -> bool {
    if let RuleRef(_) = *elem { return true; }
    if let Label(lab) = *elem { return is_ruleref_optional(&lab.element); }
    return false;
}

fn gen_element(
    w: &mut CodeWriter,
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    store: bool,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let const_name = `TK_{name}`;
        if store {
            let field_name = dedup_name(&to_lower(&name), name_counts);
            w.line(`let {field_name} = p.expect({const_name}, {escape_string(&name)})?;`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            w.line(`let {discard} = p.expect({const_name}, {escape_string(&name)})?;`);
        }
        return;
    }
    if let Literal(text) = *elem {
        let const_name = literal_const_name(&text);
        let display = `'{text}'`;
        if store {
            let field_name = dedup_name(&literal_field_name(&text), name_counts);
            w.line(`let {field_name} = p.expect({const_name}, {escape_string(&display)})?;`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            w.line(`let {discard} = p.expect({const_name}, {escape_string(&display)})?;`);
        }
        return;
    }
    if let RuleRef(name) = *elem {
        let fn_name = `parse_{to_snake_case(&name)}`;
        if store {
            let field_name = dedup_name(&to_snake_case(&name), name_counts);
            w.line(`let {field_name} = {fn_name}(p)?;`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            w.line(`let {discard} = {fn_name}(p)?;`);
        }
        return;
    }
    if let Repeat(rep) = *elem {
        gen_repeat(w, &rep, all_rules, lit_tokens, name_counts);
        return;
    }
    if let Group(alts) = *elem {
        gen_consume_group(w, &alts, all_rules, lit_tokens, name_counts);
        return;
    }
    if let Label(lab) = *elem {
        gen_element(w, &lab.element, all_rules, lit_tokens, store, name_counts);
        return;
    }
}

fn gen_repeat(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    let inner = &rep.element;
    let mut visiting: Array<String> = [];
    let first = first_of_element(inner, all_rules, lit_tokens, &mut visiting);

    if has_field(inner) {
        let field_info = element_field_info(inner);
        if let Star = rep.kind {
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [];`);
            w.begin(`while {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
            w.line(`{list_name}.append({field_info.0});`);
            w.end();
        }
        if let Plus = rep.kind {
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [{field_info.0}];`);
            w.begin(`while {first_check_str(&first)}`);
            let mut nc2: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc2);
            w.line(`{list_name}.append({field_info.0});`);
            w.end();
        }
        if let Optional = rep.kind {
            let type_str = field_info.1;
            let opt_name = dedup_name(&field_info.0, name_counts);
            w.begin(`let {opt_name}: Option<{type_str}> = if {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
            w.line(`Option::<{type_str}>::Some({field_info.0})`);
            w.else_begin("else");
            w.line("null");
            w.end_with(";");
        }
    } else {
        if let Star = rep.kind {
            w.begin(`while {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, false, &mut nc);
            w.end();
        }
        if let Plus = rep.kind {
            gen_element(w, inner, all_rules, lit_tokens, false, name_counts);
            w.begin(`while {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, false, &mut nc);
            w.end();
        }
        if let Optional = rep.kind {
            gen_optional_with_backtrack(w, inner, all_rules, lit_tokens, &first, name_counts);
        }
    }
}

fn compute_follow_second(
    elements: &Array<Element>,
    follow_start: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<String> {
    // Compute first set of the 2nd token of the follow element.
    // For patterns like (',' table_constraint)*, the follow's inner group is [',' table_constraint].
    // We want first(table_constraint), not first(',').
    if follow_start >= elements.len() { return []; }
    let follow_elem = &elements[follow_start];
    if let Repeat(rep) = *follow_elem {
        if let Group(alts) = rep.element {
            if alts.len() == 1 && alts[0].elements.len() >= 2 {
                return first_of_elements_from(&alts[0].elements, 1, all_rules, lit_tokens);
            }
        }
    }
    return [];
}

fn compute_non_greedy_condition(
    inner: &Element,
    follow_first: &Array<String>,
    follow_second: &Array<String>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> String {
    let mut visiting: Array<String> = [];
    let raw_first = first_of_element(inner, all_rules, lit_tokens, &mut visiting);
    let continue_first = subtract_sets(&raw_first, follow_first);

    if continue_first.len() > 0 {
        // Check if the subtracted set is still very broad (inner matches almost anything).
        // For cases like `name+?` where name matches all keywords, lookahead can't
        // distinguish names from constraint keywords. Use minimum match (don't loop).
        let mut visiting2: Array<String> = [];
        let inner_first_full = first_of_element(inner, all_rules, lit_tokens, &mut visiting2);
        if continue_first.len() > 20 && inner_first_full.len() > 20 {
            // Very broad first set — match minimum (1 for +?, 0 for *?)
            return "false";
        }
        return first_check_str(&continue_first);
    }

    // First sets completely overlap (e.g. both start with ',').
    // Use 2-token lookahead with follow_second to disambiguate.
    // For (',' column_def)*? followed by (',' table_constraint)*:
    //   peek(0) == ',' for both, peek(1) distinguishes column_def from table_constraint.
    if let Group(alts) = *inner {
        if alts.len() == 1 && alts[0].elements.len() >= 2 && follow_second.len() > 0 {
            let inner_second_first = first_of_elements_from(&alts[0].elements, 1, all_rules, lit_tokens);
            let second_continue = subtract_sets(&inner_second_first, follow_second);
            if second_continue.len() > 0 {
                let peek0_cond = first_check_str(&raw_first);
                let peek1_cond = kind_check_str(&second_continue, "p.peek_at(1)");
                return `({peek0_cond}) && ({peek1_cond})`;
            }
        }
    }

    // Fallback: can't disambiguate, don't loop (match minimum)
    return "false";
}

fn gen_repeat_non_greedy(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    follow_first: &Array<String>,
    follow_second: &Array<String>,
    name_counts: &mut Array<[String, i32]>,
) {
    let inner = &rep.element;
    let is_plus = if let Plus = rep.kind { true } else { false };
    let while_cond = compute_non_greedy_condition(inner, follow_first, follow_second, all_rules, lit_tokens);

    if has_field(inner) {
        let field_info = element_field_info(inner);
        if is_plus {
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [{field_info.0}];`);
            if while_cond != "false" {
                w.begin(`while {while_cond}`);
                let mut nc2: Array<[String, i32]> = [];
                gen_element(w, inner, all_rules, lit_tokens, true, &mut nc2);
                w.line(`{list_name}.append({field_info.0});`);
                w.end();
            }
        } else {
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [];`);
            if while_cond != "false" {
                w.begin(`while {while_cond}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
                w.line(`{list_name}.append({field_info.0});`);
                w.end();
            }
        }
    } else {
        if is_plus {
            gen_element(w, inner, all_rules, lit_tokens, false, name_counts);
        }
        if while_cond != "false" {
            w.begin(`while {while_cond}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, false, &mut nc);
            w.end();
        }
    }
}

fn union_sets(a: &Array<String>, b: &Array<String>) -> Array<String> {
    let mut result: Array<String> = [];
    for let mut i = 0; i < a.len(); i += 1 {
        result.append(a[i]);
    }
    for let mut i = 0; i < b.len(); i += 1 {
        if !array_contains_str(&result, &b[i]) {
            result.append(b[i]);
        }
    }
    return result;
}

fn subtract_sets(a: &Array<String>, b: &Array<String>) -> Array<String> {
    let mut result: Array<String> = [];
    for let x of a {
        if !array_contains_str(b, x) {
            result.append(x);
        }
    }
    return result;
}

fn gen_repeat_with_follow(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    follow_first: &Array<String>,
    name_counts: &mut Array<[String, i32]>,
) {
    let inner = &rep.element;
    let mut visiting: Array<String> = [];
    let raw_first = first_of_element(inner, all_rules, lit_tokens, &mut visiting);
    let first = subtract_sets(&raw_first, follow_first);

    if first.len() == 0 {
        // All first tokens overlap with follow — always skip the optional.
        if has_field(inner) {
            let field_info = element_field_info(inner);
            let type_str = field_info.1;
            let opt_name = dedup_name(&field_info.0, name_counts);
            w.line(`let {opt_name}: Option<{type_str}> = null;`);
        }
        return;
    }

    if has_field(inner) {
        let field_info = element_field_info(inner);
        let type_str = field_info.1;
        let opt_name = dedup_name(&field_info.0, name_counts);
        w.begin(`let {opt_name}: Option<{type_str}> = if {first_check_str(&first)}`);
        let mut nc: Array<[String, i32]> = [];
        gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
        w.line(`Option::<{type_str}>::Some({field_info.0})`);
        w.else_begin("else");
        w.line("null");
        w.end_with(";");
    } else {
        gen_optional_with_backtrack(w, inner, all_rules, lit_tokens, &first, name_counts);
    }
}

fn is_optional_repeat(elem: &Element) -> bool {
    if let Repeat(rep) = *elem {
        if let Optional = rep.kind { return true; }
    }
    if let Label(lab) = *elem {
        return is_optional_repeat(&lab.element);
    }
    return false;
}

fn has_nested_optionals(inner: &Element) -> bool {
    if let Group(alts) = *inner {
        if alts.len() != 1 { return false; }
        for let mut i = 0; i < alts[0].elements.len(); i += 1 {
            let elem = &alts[0].elements[i];
            if is_optional_repeat(elem) { return true; }
        }
    }
    return false;
}

fn compute_shapes(elements: &Array<Element>) -> Array<Array<i32>> {
    let mut opt_indices: Array<i32> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if is_nullable(&elements[i]) {
            opt_indices.append(i);
        }
    }
    let n = opt_indices.len();
    let mut shapes: Array<Array<i32>> = [];
    // Enumerate 2^n combinations: bit mask from (2^n - 1) down to 0
    // Higher bits = more optionals included = longer shape = tried first
    let total = 1 << n;
    for let mut mask = total - 1; mask >= 0; mask -= 1 {
        let mut shape: Array<i32> = [];
        for let mut i = 0; i < elements.len(); i += 1 {
            let mut is_opt = false;
            let mut opt_bit = -1;
            for let mut j = 0; j < opt_indices.len(); j += 1 {
                if opt_indices[j] == i {
                    is_opt = true;
                    opt_bit = j;
                }
            }
            if is_opt {
                if (mask >> opt_bit) & 1 == 1 {
                    shape.append(i);
                }
            } else {
                shape.append(i);
            }
        }
        shapes.append(shape);
    }
    return shapes;
}

fn shape_lookahead_signature(
    shape: &Array<i32>,
    elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<Array<String>> {
    let mut sig: Array<Array<String>> = [];
    for let mut si = 0; si < shape.len(); si += 1 {
        let idx = shape[si];
        let elem = &elements[idx];
        let actual = unwrap_optional(elem);
        // For a Group with single alt, compute token-by-token signature
        if let Group(alts) = *actual {
            if alts.len() == 1 {
                for let mut j = 0; j < alts[0].elements.len(); j += 1 {
                    let mut visiting: Array<String> = [];
                    sig.append(first_of_element(&alts[0].elements[j], all_rules, lit_tokens, &mut visiting));
                }
                continue;
            }
        }
        // For simple elements (RuleRef, TokenRef, Literal), one position
        let mut visiting: Array<String> = [];
        sig.append(first_of_element(actual, all_rules, lit_tokens, &mut visiting));
    }
    return sig;
}

fn gen_lookahead_condition(sig: &Array<Array<String>>) -> String {
    let mut parts: Array<String> = [];
    for let mut d = 0; d < sig.len(); d += 1 {
        let tokens = &sig[d];
        let check_expr = if d == 0 { "p.peek_kind()" } else { `p.peek_at({d})` };
        if tokens.len() == 1 {
            parts.append(`{check_expr} == {tokens[0]}`);
        } else {
            let mut inner = String::with_capacity(64);
            inner.append("(");
            for let mut j = 0; j < tokens.len(); j += 1 {
                if j > 0 { inner.append(" || "); }
                inner.append(`{check_expr} == {tokens[j]}`);
            }
            inner.append(")");
            parts.append(inner);
        }
    }
    let mut result = String::with_capacity(128);
    for let mut i = 0; i < parts.len(); i += 1 {
        if i > 0 { result.append(" && "); }
        result.append(parts[i]);
    }
    return result;
}

fn gen_optional_with_lookahead(
    w: &mut CodeWriter,
    group_elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    let shapes = compute_shapes(group_elements);

    let mut is_first = true;
    for let mut si = 0; si < shapes.len(); si += 1 {
        let shape = &shapes[si];
        let sig = shape_lookahead_signature(shape, group_elements, all_rules, lit_tokens);
        if sig.len() == 0 { continue; }
        let cond = gen_lookahead_condition(&sig);

        if is_first {
            w.begin(`if {cond}`);
            is_first = false;
        } else {
            w.else_begin(`else if {cond}`);
        }

        // Generate parsing code for this shape's elements
        for let mut k = 0; k < shape.len(); k += 1 {
            let idx = shape[k];
            let elem = &group_elements[idx];
            let actual = unwrap_optional(elem);
            if let Group(alts) = *actual {
                if alts.len() == 1 {
                    for let mut j = 0; j < alts[0].elements.len(); j += 1 {
                        gen_element(w, &alts[0].elements[j], all_rules, lit_tokens, false, name_counts);
                    }
                } else {
                    gen_element(w, actual, all_rules, lit_tokens, false, name_counts);
                }
            } else {
                gen_element(w, actual, all_rules, lit_tokens, false, name_counts);
            }
        }
    }
    if !is_first {
        w.end();
    }
}

fn unwrap_optional(elem: &Element) -> &Element with stores[elem] {
    if let Repeat(rep) = *elem {
        if let Optional = rep.kind {
            return &rep.element;
        }
    }
    if let Label(lab) = *elem {
        return unwrap_optional(&lab.element);
    }
    return elem;
}

fn optional_lookahead_depth(inner: &Element) -> i32 {
    // Returns the number of leading fixed tokens that can be checked via lookahead.
    // 0 if the first element is not a fixed token.
    if let Group(alts) = *inner {
        if alts.len() != 1 { return 0; }
        let mut depth = 0;
        for let mut i = 0; i < alts[0].elements.len(); i += 1 {
            let elem = &alts[0].elements[i];
            if let TokenRef(_) | Literal(_) = *elem { depth += 1; }
            else { break; }
        }
        return depth;
    }
    if let TokenRef(_) | Literal(_) = *inner { return 1; }
    return 0;
}

fn optional_lookahead_tokens(inner: &Element, max_depth: i32) -> Array<String> {
    // Returns up to max_depth leading fixed token constants.
    let mut tokens: Array<String> = [];
    if let Group(alts) = *inner {
        if alts.len() != 1 { return []; }
        for let mut i = 0; i < alts[0].elements.len(); i += 1 {
            if tokens.len() >= max_depth { break; }
            let elem = &alts[0].elements[i];
            if let TokenRef(name) = *elem { tokens.append(`TK_{name}`); }
            else if let Literal(text) = *elem { tokens.append(literal_const_name(&text)); }
            else { break; }
        }
    } else {
        if let TokenRef(name) = *inner { tokens.append(`TK_{name}`); }
        else if let Literal(text) = *inner { tokens.append(literal_const_name(&text)); }
    }
    return tokens;
}

fn gen_optional_with_backtrack(
    w: &mut CodeWriter,
    inner: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    first: &Array<String>,
    name_counts: &mut Array<[String, i32]>,
) {
    if has_nested_optionals(inner) {
        if let Group(alts) = *inner {
            gen_optional_with_lookahead(w, &alts[0].elements, all_rules, lit_tokens, name_counts);
            return;
        }
    }

    // Use k-token lookahead when leading fixed tokens uniquely identify the optional.
    let la_depth = optional_lookahead_depth(inner);
    if la_depth >= 1 {
        let la_tokens = optional_lookahead_tokens(inner, la_depth);
        let mut cond_parts: Array<String> = [];
        for let mut d = 0; d < la_tokens.len(); d += 1 {
            let check = if d == 0 { "p.peek_kind()" } else { `p.peek_at({d})` };
            cond_parts.append(`{check} == {la_tokens[d]}`);
        }
        let mut cond = String::with_capacity(128);
        for let mut i = 0; i < cond_parts.len(); i += 1 {
            if i > 0 { cond.append(" && "); }
            cond.append(cond_parts[i]);
        }
        w.begin(`if {cond}`);
        if let Group(alts) = *inner {
            for let mut i = 0; i < alts[0].elements.len(); i += 1 {
                gen_element(w, &alts[0].elements[i], all_rules, lit_tokens, false, name_counts);
            }
        } else {
            gen_element(w, inner, all_rules, lit_tokens, false, name_counts);
        }
        w.end();
        return;
    }

    w.begin(`if {first_check_str(first)}`);

    let saved = dedup_name(&"opt_saved", name_counts);
    let label = dedup_name(&"opt_bt", name_counts);
    w.line(`let {saved} = p.pos;`);
    w.begin(`{label}:`);

    if let Group(alts) = *inner {
        if alts.len() == 1 {
            for let elem of alts[0].elements {
                gen_element_failable(w, &elem, all_rules, lit_tokens, &saved, &label, name_counts);
            }
        } else {
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, false, &mut nc);
        }
    } else {
        gen_element_failable(w, inner, all_rules, lit_tokens, &saved, &label, name_counts);
    }

    w.end(); // label
    w.end(); // if
}

fn gen_element_failable(
    w: &mut CodeWriter,
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    saved_var: &String,
    label: &String,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let const_name = `TK_{name}`;
        let r_var = dedup_name(&"opt_r", name_counts);
        w.line(`let {r_var} = p.expect({const_name}, {escape_string(&name)});`);
        w.line(`if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}`);
        return;
    }
    if let Literal(text) = *elem {
        let const_name = literal_const_name(&text);
        let display = `'{text}'`;
        let r_var = dedup_name(&"opt_r", name_counts);
        w.line(`let {r_var} = p.expect({const_name}, {escape_string(&display)});`);
        w.line(`if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}`);
        return;
    }
    if let RuleRef(name) = *elem {
        let fn_name = `parse_{to_snake_case(&name)}`;
        let r_var = dedup_name(&"opt_r", name_counts);
        w.line(`let {r_var} = {fn_name}(p);`);
        w.line(`if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}`);
        return;
    }
    if let Repeat(rep) = *elem {
        gen_repeat(w, &rep, all_rules, lit_tokens, name_counts);
        return;
    }
    if let Group(alts) = *elem {
        if alts.len() == 1 {
            for let inner_elem of alts[0].elements {
                gen_element_failable(w, &inner_elem, all_rules, lit_tokens, saved_var, label, name_counts);
            }
        } else {
            gen_consume_group(w, &alts, all_rules, lit_tokens, name_counts);
        }
        return;
    }
    if let Label(lab) = *elem {
        gen_element_failable(w, &lab.element, all_rules, lit_tokens, saved_var, label, name_counts);
        return;
    }
}

fn has_field(elem: &Element) -> bool {
    if let TokenRef(_) | Literal(_) | RuleRef(_) = *elem { return true; }
    if let Label(lab) = *elem { return has_field(&lab.element); }
    return false;
}

fn element_field_info(elem: &Element) -> [String, String] {
    if let TokenRef(name) = *elem {
        return [to_lower(&name), "Token"];
    }
    if let Literal(text) = *elem {
        return [literal_field_name(&text), "Token"];
    }
    if let RuleRef(name) = *elem {
        return [to_snake_case(&name), rule_type_name(&name)];
    }
    if let Label(lab) = *elem {
        return element_field_info(&lab.element);
    }
    return ["_", "Token"];
}

fn gen_field_assignments(w: &mut CodeWriter, elements: &Array<Element>) {
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        gen_field_assignment(w, &elem, &mut name_counts);
    }
}

fn gen_field_assignment(
    w: &mut CodeWriter,
    elem: &Element,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let field_name = dedup_name(&to_lower(&name), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Literal(text) = *elem {
        let field_name = dedup_name(&literal_field_name(&text), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let RuleRef(name) = *elem {
        let field_name = dedup_name(&to_snake_case(&name), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Repeat(rep) = *elem {
        if has_field(&rep.element) {
            let info = element_field_info(&rep.element);
            if let Star | Plus = rep.kind {
                let field_name = dedup_name(&`{info.0}_list`, name_counts);
                w.line(`{field_name},`);
            }
            if let Optional = rep.kind {
                let field_name = dedup_name(&info.0, name_counts);
                w.line(`{field_name},`);
            }
        }
        return;
    }
    if let Label(lab) = *elem {
        if has_field(&lab.element) {
            let field_name = to_snake_case(&lab.name);
            dedup_name(&field_name, name_counts);
            w.line(`{field_name},`);
        }
        return;
    }
}

/// Replay name counting for an element without emitting code.
/// This advances the dedup counter so subsequent elements get correct suffixes.
fn replay_element_names(elem: &Element, name_counts: &mut Array<[String, i32]>) {
    if let TokenRef(name) = *elem {
        dedup_name(&to_lower(&name), name_counts);
        return;
    }
    if let Literal(text) = *elem {
        dedup_name(&literal_field_name(&text), name_counts);
        return;
    }
    if let RuleRef(name) = *elem {
        dedup_name(&to_snake_case(&name), name_counts);
        return;
    }
    if let Repeat(rep) = *elem {
        if has_field(&rep.element) {
            let info = element_field_info(&rep.element);
            if let Star | Plus = rep.kind {
                dedup_name(&`{info.0}_list`, name_counts);
            }
            if let Optional = rep.kind {
                dedup_name(&info.0, name_counts);
            }
        }
        return;
    }
    if let Label(lab) = *elem {
        if has_field(&lab.element) {
            dedup_name(&to_snake_case(&lab.name), name_counts);
        }
        return;
    }
}

fn gen_consume_group(
    w: &mut CodeWriter,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    if alts.len() == 0 { return; }
    if alts.len() == 1 {
        gen_elements_with_non_greedy(w, &alts[0].elements, all_rules, lit_tokens, name_counts);
        return;
    }

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.append(first_of_alt(&alt, all_rules, lit_tokens, &mut visiting));
    }
    let groups = compute_overlap_groups(&first_sets);

    let grp_var = dedup_name(&"grp_kind", name_counts);
    w.line(`let {grp_var} = p.peek_kind();`);

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            for let tk of first_sets[*idx] {
                if !array_contains_str(&union_first, &tk) {
                    union_first.append(tk);
                }
            }
        }

        let cond = kind_check_str(&union_first, &grp_var);
        if g == 0 {
            w.begin(`if {cond}`);
        } else {
            w.else_begin(`else if {cond}`);
        }

        if group.len() == 1 {
            let alt_idx = group[0];
            gen_elements_with_non_greedy(w, &alts[alt_idx].elements, all_rules, lit_tokens, name_counts);
        } else {
            let mut sorted_group = group.sorted();
            sort_group_by_element_count(&mut sorted_group, alts);
            gen_backtracking_body(w, &sorted_group, alts, all_rules, lit_tokens, name_counts);
        }
    }
    w.end();
}

fn gen_backtracking_body(
    w: &mut CodeWriter,
    group: &Array<i32>,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    // Build prediction tree for the group alternatives.
    let mut pred_indices: Array<i32> = [];
    let mut pred_firsts: Array<Array<String>> = [];
    let mut pred_elements: Array<Array<Element>> = [];
    for let mut k = 0; k < group.len(); k += 1 {
        let alt_idx = group[k];
        pred_indices.append(alt_idx);
        let mut visiting: Array<String> = [];
        pred_firsts.append(first_of_alt(&alts[alt_idx], all_rules, lit_tokens, &mut visiting));
        pred_elements.append(alts[alt_idx].elements);
    }
    let tree = build_prediction(&pred_indices, &pred_firsts, &pred_elements,
        0, 5, all_rules, lit_tokens);
    gen_group_prediction_code(w, &tree, alts, all_rules, lit_tokens, name_counts);
}

fn gen_group_prediction_code(
    w: &mut CodeWriter,
    node: &PredictionNode,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    gen_group_prediction_code_skip(w, node, alts, all_rules, lit_tokens, name_counts, 0);
}

fn gen_group_prediction_code_skip(
    w: &mut CodeWriter,
    node: &PredictionNode,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
    skip: i32,
) {
    if let Leaf(idx) = *node {
        let elems = &alts[idx].elements;
        for let mut i = skip; i < elems.len(); i += 1 {
            let elem = &elems[i];
            if let Repeat(rep) = *elem {
                if rep.non_greedy {
                    let follow = first_of_elements_from(elems, i + 1, all_rules, lit_tokens);
                    let follow_second = compute_follow_second(elems, i + 1, all_rules, lit_tokens);
                    gen_repeat_non_greedy(w, &rep, all_rules, lit_tokens, &follow, &follow_second, name_counts);
                    continue;
                }
            }
            gen_element(w, &elem, all_rules, lit_tokens, false, name_counts);
        }
        return;
    }
    if let Consume(c) = *node {
        gen_element(w, &c.element, all_rules, lit_tokens, false, name_counts);
        gen_group_prediction_code_skip(w, &c.child, alts, all_rules, lit_tokens, name_counts, skip + 1);
        return;
    }
    if let Backtrack(indices) = *node {
        let mut sorted = indices.sorted();
        sort_group_by_element_count(&mut sorted, alts);
        let saved_var = dedup_name(&"saved_pos", name_counts);
        let done_var = dedup_name(&"bt_done", name_counts);
        w.line(`let {saved_var} = p.pos;`);
        w.line(`let mut {done_var} = false;`);
        for let mut k = 0; k < sorted.len(); k += 1 {
            let alt_idx = sorted[k];
            let is_last = k == sorted.len() - 1;
            let alt = &alts[alt_idx];
            if is_last {
                w.begin(`if !{done_var}`);
                let mut nc: Array<[String, i32]> = [];
                for let mut i = skip; i < alt.elements.len(); i += 1 {
                    gen_element(w, &alt.elements[i], all_rules, lit_tokens, false, &mut nc);
                }
                w.end();
            } else {
                let bt_label = dedup_name(&"bt_try", name_counts);
                w.begin(`if !{done_var}`);
                w.begin(`{bt_label}:`);
                let mut nc: Array<[String, i32]> = [];
                for let mut i = skip; i < alt.elements.len(); i += 1 {
                    gen_element_failable(w, &alt.elements[i], all_rules, lit_tokens, &saved_var, &bt_label, &mut nc);
                }
                w.line(`{done_var} = true;`);
                w.end(); // label
                w.end();
            }
        }
        return;
    }
    if let Dispatch(d) = *node {
        let check_var = if d.depth == 0 { "p.peek_kind()" } else { `p.peek_at({d.depth})` };
        for let mut i = 0; i < d.branches.len(); i += 1 {
            let branch = &d.branches[i];
            let cond = kind_check_str(&branch.tokens, &check_var);
            if i == 0 {
                w.begin(`if {cond}`);
            } else {
                w.else_begin(`else if {cond}`);
            }
            gen_group_prediction_code_skip(w, &branch.child, alts, all_rules, lit_tokens, name_counts, skip);
        }
        w.end();
    }
}

fn compute_lr_conflict_min_prec(
    alt: &Alternative,
    own_prec: i32,
    lr_indices: &Array<i32>,
    rule: &ParserRule,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    total_lr: i32,
) -> i32 {
    // Scan suffix for fixed tokens that are also LR suffix first tokens.
    // If found, compute min_prec = max(own_prec + 1, conflicting_alt_prec + 1).
    let mut min_prec = own_prec + 1;
    // Collect all fixed tokens in the suffix (elements after self-ref)
    let mut fixed_tokens: Array<String> = [];
    for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
        let elem = &alt.elements[ei];
        if let TokenRef(name) = *elem { fixed_tokens.append(`TK_{name}`); }
        if let Literal(text) = *elem { fixed_tokens.append(literal_const_name(&text)); }
    }
    if fixed_tokens.len() == 0 { return min_prec; }

    // Check each LR alt's suffix first set for conflicts
    let mut lr_pos = 0;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let other = &rule.alternatives[lr_idx];
        if other.elements.len() <= 1 { lr_pos += 1; continue; }
        let other_prec = total_lr - lr_pos;
        let suffix_first = first_of_elements_from(&other.elements, 1, all_rules, lit_tokens);
        for let ft of fixed_tokens {
            if array_contains_str(&suffix_first, &ft) {
                let candidate = other_prec + 1;
                if candidate > min_prec { min_prec = candidate; }
            }
        }
        lr_pos += 1;
    }
    return min_prec;
}

fn gen_lr_suffix_helpers(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    lr_indices: &Array<i32>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    let prec_fn = `{fn_name}_prec`;
    let all_labeled = all_alternatives_labeled(&rule.alternatives);
    let total_lr = lr_indices.len();

    let mut lr_pos = 0;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 { lr_pos += 1; continue; }
        let own_prec = total_lr - lr_pos;

        let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{lr_idx}` };
        let sname = `{strip_suffix(type_name, "Node")}{case_name}`;
        let suffix_fn = `{fn_name}_lr_{lr_idx}`;

        // Compute min_prec for self-recursive calls in this helper
        let inner_min_prec = compute_lr_conflict_min_prec(alt, own_prec, lr_indices, rule, all_rules, lit_tokens, total_lr);

        let mut f = FnSpec::new(&suffix_fn);
        f.add_param("p", "&mut Parser");
        f.add_param("left", type_name);
        f.add_param("start", "i32");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);

        let mut name_counts: Array<[String, i32]> = [];
        dedup_name(&to_snake_case(&rule.name), &mut name_counts);

        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            let elem = &alt.elements[ei];
            if let RuleRef(name) = *elem {
                if name == rule.name {
                    let field_name = dedup_name(&to_snake_case(&name), &mut name_counts);
                    w.line(`let {field_name} = {prec_fn}(p, {inner_min_prec})?;`);
                } else {
                    let elem_fn = `parse_{to_snake_case(&name)}`;
                    let field_name = dedup_name(&to_snake_case(&name), &mut name_counts);
                    w.line(`let {field_name} = {elem_fn}(p)?;`);
                }
            } else if let Group(alts) = *elem {
                if is_simple_token_group(&alts) {
                    let discard = dedup_name(&"op_tok", &mut name_counts);
                    w.line(`let {discard} = p.advance();`);
                } else {
                    gen_element(w, elem, all_rules, lit_tokens, false, &mut name_counts);
                }
            } else if let Repeat(rep) = *elem {
                gen_repeat(w, &rep, all_rules, lit_tokens, &mut name_counts);
            } else {
                gen_element(w, elem, all_rules, lit_tokens, true, &mut name_counts);
            }
        }

        let first_field = to_snake_case(&rule.name);
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case_name}({sname} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        w.line(`{first_field}: left,`);
        let mut field_counts: Array<[String, i32]> = [];
        dedup_name(&to_snake_case(&rule.name), &mut field_counts);
        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            gen_field_assignment(w, &alt.elements[ei], &mut field_counts);
        }
        w.dedent();
        w.line("}));");

        w.end(); // fn
        w.blank();
        lr_pos += 1;
    }
}

fn compute_lr_second_token(
    shared_token: &String,
    elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<String> {
    // Find what token follows the shared_token in this alternative's suffix.
    // Walk suffix elements (starting at index 1) to find the shared token,
    // then return the first set of the next element.
    for let mut i = 1; i < elements.len(); i += 1 {
        let elem = &elements[i];
        // Check if this element contains the shared token
        let mut visiting: Array<String> = [];
        let elem_first = first_of_element(elem, all_rules, lit_tokens, &mut visiting);
        if !array_contains_str(&elem_first, shared_token) { continue; }

        // This element matches the shared token. Check if it's an Optional that wraps it.
        if is_nullable(elem) {
            // The shared token is inside an optional (e.g. K_NOT?).
            // The "second token" is the next element after the optional.
            if i + 1 < elements.len() {
                return first_of_elements_from(elements, i + 1, all_rules, lit_tokens);
            }
        }

        // The shared token is inside a Group (e.g. (K_ISNULL | K_NOTNULL | K_NOT K_NULL)).
        // Find the alternative within the group that starts with shared_token,
        // and return the first set of its second element.
        if let Group(alts) = *elem {
            for let mut a = 0; a < alts.len(); a += 1 {
                let alt = &alts[a];
                if alt.elements.len() < 1 { continue; }
                let mut v2: Array<String> = [];
                let alt_first = first_of_element(&alt.elements[0], all_rules, lit_tokens, &mut v2);
                if array_contains_str(&alt_first, shared_token) && alt.elements.len() >= 2 {
                    return first_of_elements_from(&alt.elements, 1, all_rules, lit_tokens);
                }
            }
        }

        // Fallback: return next element's first set
        if i + 1 < elements.len() {
            return first_of_elements_from(elements, i + 1, all_rules, lit_tokens);
        }
    }
    return [];
}

fn gen_lr_call_with_prec(
    w: &mut CodeWriter,
    suffix_fn: &String,
    prec: i32,
    use_prec: bool,
) {
    if use_prec {
        w.begin(`if {prec} >= min_prec`);
        w.line(`result = {*suffix_fn}(p, result, start)?;`);
        w.else_begin("else");
        w.line("break;");
        w.end();
    } else {
        w.line(`result = {*suffix_fn}(p, result, start)?;`);
    }
}

fn gen_lr_overlap_dispatch(
    w: &mut CodeWriter,
    fn_name: &String,
    rule: &ParserRule,
    group: &Array<i32>,
    valid_lr_indices: &Array<i32>,
    lr_precs: &Array<i32>,
    suffix_first_sets: &Array<Array<String>>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    use_prec: bool,
) {
    // For each token in the group, find which alternatives match it.
    // Unique token → dispatch directly. Shared token → sub-dispatch via peek_at(1).
    let mut emitted: Array<String> = [];
    let mut first_branch = true;

    // First pass: unique-token branches
    for let mut k = 0; k < group.len(); k += 1 {
        let this_first = &suffix_first_sets[group[k]];
        for let mut t = 0; t < this_first.len(); t += 1 {
            let tk = &this_first[t];
            if array_contains_str(&emitted, tk) { continue; }
            let mut shared = false;
            for let mut j = 0; j < group.len(); j += 1 {
                if j == k { continue; }
                if array_contains_str(&suffix_first_sets[group[j]], tk) { shared = true; }
            }
            if !shared {
                let lr_idx = valid_lr_indices[group[k]];
                let prec = lr_precs[group[k]];
                let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
                if first_branch {
                    w.begin(`if suffix_kind == {*tk}`);
                    first_branch = false;
                } else {
                    w.else_begin(`else if suffix_kind == {*tk}`);
                }
                gen_lr_call_with_prec(w, &suffix_fn, prec, use_prec);
                emitted.append(*tk);
            }
        }
    }

    // Second pass: shared-token branches with peek_at(1) sub-dispatch
    let mut shared_tokens: Array<String> = [];
    for let mut k = 0; k < group.len(); k += 1 {
        for let tk of suffix_first_sets[group[k]] {
            if array_contains_str(&emitted, &tk) { continue; }
            if !array_contains_str(&shared_tokens, &tk) {
                shared_tokens.append(tk);
            }
        }
    }
    for let mut st = 0; st < shared_tokens.len(); st += 1 {
        let shared_tk = &shared_tokens[st];
        if first_branch {
            w.begin(`if suffix_kind == {*shared_tk}`);
            first_branch = false;
        } else {
            w.else_begin(`else if suffix_kind == {*shared_tk}`);
        }
        let mut sub_first = true;
        let mut last_k = -1;
        for let mut k = 0; k < group.len(); k += 1 {
            if array_contains_str(&suffix_first_sets[group[k]], shared_tk) {
                last_k = k;
            }
        }
        for let mut k = 0; k < group.len(); k += 1 {
            if !array_contains_str(&suffix_first_sets[group[k]], shared_tk) { continue; }
            let lr_idx = valid_lr_indices[group[k]];
            let prec = lr_precs[group[k]];
            let alt = &rule.alternatives[lr_idx];
            let suffix_fn = `{*fn_name}_lr_{lr_idx}`;
            if k == last_k {
                if sub_first {
                    gen_lr_call_with_prec(w, &suffix_fn, prec, use_prec);
                } else {
                    w.else_begin("else");
                    gen_lr_call_with_prec(w, &suffix_fn, prec, use_prec);
                    w.end();
                }
            } else {
                let second = compute_lr_second_token(shared_tk, &alt.elements, all_rules, lit_tokens);
                let sub_cond = kind_check_str(&second, "p.peek_at(1)");
                if sub_first {
                    w.begin(`if {sub_cond}`);
                    sub_first = false;
                } else {
                    w.else_begin(`else if {sub_cond}`);
                }
                gen_lr_call_with_prec(w, &suffix_fn, prec, use_prec);
            }
        }
        emitted.append(*shared_tk);
    }
    if !first_branch {
        w.end();
    }
}

fn gen_lr_suffix_dispatch(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    lr_indices: &Array<i32>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    use_prec: bool,
) {
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    let total_lr = lr_indices.len();

    let mut valid_lr_indices: Array<i32> = [];
    let mut suffix_first_sets: Array<Array<String>> = [];
    let mut lr_precs: Array<i32> = [];
    let mut lr_position = 0;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 { lr_position += 1; continue; }
        let suffix_first = first_of_elements_from(&alt.elements, 1, all_rules, lit_tokens);
        if suffix_first.len() == 0 { lr_position += 1; continue; }
        valid_lr_indices.append(lr_idx);
        suffix_first_sets.append(suffix_first);
        // Precedence: first LR alt = highest (N), last = 1
        lr_precs.append(total_lr - lr_position);
        lr_position += 1;
    }

    let groups = compute_overlap_groups(&suffix_first_sets);

    w.begin("loop");
    w.line("let suffix_kind = p.peek_kind();");

    let mut is_first = true;
    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            for let tk of suffix_first_sets[*idx] {
                if !array_contains_str(&union_first, &tk) {
                    union_first.append(tk);
                }
            }
        }

        let cond = kind_check_str(&union_first, "suffix_kind");
        if is_first {
            w.begin(`if {cond}`);
            is_first = false;
        } else {
            w.else_begin(`else if {cond}`);
        }

        if group.len() == 1 {
            let lr_idx = valid_lr_indices[group[0]];
            let prec = lr_precs[group[0]];
            let suffix_fn = `{fn_name}_lr_{lr_idx}`;
            if use_prec {
                w.begin(`if {prec} >= min_prec`);
                w.line(`result = {suffix_fn}(p, result, start)?;`);
                w.else_begin("else");
                w.line("break;");
                w.end();
            } else {
                w.line(`result = {suffix_fn}(p, result, start)?;`);
            }
        } else {
            gen_lr_overlap_dispatch(w, &fn_name, rule, group, &valid_lr_indices, &lr_precs,
                &suffix_first_sets, all_rules, lit_tokens, use_prec);
        }
    }

    if !is_first {
        w.else_begin("else");
        w.line("break;");
        w.end();
    } else {
        w.line("break;");
    }
    w.end(); // loop
}

fn gen_prediction_code(
    w: &mut CodeWriter,
    node: &PredictionNode,
    fn_name: &String,
    alts: &Array<Alternative>,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let mut nc: Array<[String, i32]> = [];
    gen_prediction_code_inner(w, node, fn_name, alts, type_name, all_rules, lit_tokens, 0, &mut nc);
}

fn gen_prediction_code_inner(
    w: &mut CodeWriter,
    node: &PredictionNode,
    fn_name: &String,
    alts: &Array<Alternative>,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    skip: i32,
    name_counts: &mut Array<[String, i32]>,
) {
    if let Leaf(idx) = *node {
        if skip == 0 {
            w.line(`return {*fn_name}_bt_{idx}(p);`);
        } else {
            // Consumed prefix tokens already — inline the remaining alt body.
            let all_labeled = all_alternatives_labeled(alts);
            let alt = &alts[idx];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{idx}` };
            let sname = `{strip_suffix(type_name, "Node")}{case_name}`;
            gen_alt_body_skip(w, type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens, skip);
        }
        return;
    }
    if let Consume(c) = *node {
        gen_element(w, &c.element, all_rules, lit_tokens, true, name_counts);
        gen_prediction_code_inner(w, &c.child, fn_name, alts, type_name, all_rules, lit_tokens, skip + 1, name_counts);
        return;
    }
    if let Backtrack(indices) = *node {
        // Sort by element count for proper ordering (single RuleRef first, etc.)
        let mut sorted_indices = indices.sorted();
        sort_group_by_element_count(&mut sorted_indices, alts);
        if skip == 0 {
            w.line("let saved = p.pos;");
            for let mut i = 0; i < sorted_indices.len(); i += 1 {
                let idx = sorted_indices[i];
                let is_last = i == sorted_indices.len() - 1;
                if is_last {
                    w.line(`return {*fn_name}_bt_{idx}(p);`);
                } else {
                    w.line(`let r_{idx} = {*fn_name}_bt_{idx}(p);`);
                    w.begin(`if let Err(_) = r_{idx}`);
                    w.line("p.pos = saved;");
                    w.else_begin("else");
                    w.line(`return r_{idx};`);
                    w.end();
                }
            }
        } else {
            // Prefix already consumed — should not happen.
            // Consume nodes that lead to Backtrack are stripped at build time.
            panic("unreachable: Consume leading to Backtrack should have been stripped");
        }
        return;
    }
    if let Dispatch(d) = *node {
        let check_var = if d.depth == 0 { "p.peek_kind()" } else { `p.peek_at({d.depth})` };
        for let mut i = 0; i < d.branches.len(); i += 1 {
            let branch = &d.branches[i];
            let cond = kind_check_str(&branch.tokens, &check_var);
            if i == 0 {
                w.begin(`if {cond}`);
            } else {
                w.else_begin(`else if {cond}`);
            }
            gen_prediction_code_inner(w, &branch.child, fn_name, alts, type_name, all_rules, lit_tokens, skip, name_counts);
        }
        w.end();
    }
}

fn gen_multi_alt_body_bt(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    groups: &Array<Array<i32>>,
    first_sets: &Array<Array<String>>,
    non_lr_indices: &Array<i32>,
) {
    let all_labeled = all_alternatives_labeled(&rule.alternatives);
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    w.line("let kind = p.peek_kind();");

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];
        let mut union_first: Array<String> = [];
        for let idx of group {
            for let tk of first_sets[*idx] {
                if !array_contains_str(&union_first, &tk) {
                    union_first.append(tk);
                }
            }
        }

        let cond = kind_check_str(&union_first, "kind");
        w.begin(`if {cond}`);

        if group.len() == 1 {
            let alt_idx = non_lr_indices[group[0]];
            let alt = &rule.alternatives[alt_idx];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{alt_idx}` };
            let sname = `{strip_suffix(type_name, "Node")}{case_name}`;
            gen_alt_body(w, type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens);
        } else {
            // Sort group by specificity before building prediction tree.
            let mut sorted_group = group.sorted();
            sort_group_by_specificity(&mut sorted_group, first_sets);
            let mut pred_indices: Array<i32> = [];
            let mut pred_firsts: Array<Array<String>> = [];
            let mut pred_elements: Array<Array<Element>> = [];
            for let mut k = 0; k < sorted_group.len(); k += 1 {
                let idx = sorted_group[k];
                let real_idx = non_lr_indices[idx];
                pred_indices.append(real_idx);
                pred_firsts.append(first_sets[idx]);
                pred_elements.append(rule.alternatives[real_idx].elements);
            }
            let tree = build_prediction(&pred_indices, &pred_firsts, &pred_elements,
                0, 5, all_rules, lit_tokens);
            let bt_count = count_backtrack_nodes(&tree);

            gen_prediction_code(w, &tree, &fn_name, &rule.alternatives, type_name, all_rules, lit_tokens);
        }

        w.end();
    }

    gen_error_fallback(w, rule, type_name, all_rules, lit_tokens);
}

fn gen_parse_entry(w: &mut CodeWriter, parser_rules: &Array<ParserRule>) {
    if parser_rules.len() == 0 { return; }
    let root = &parser_rules[0];
    let type_name = rule_type_name(&root.name);
    let fn_name = `parse_{to_snake_case(&root.name)}`;
    let mut f = FnSpec::new("parse");
    f.set_pub();
    f.add_param("input", "&String");
    f.set_return_type(`Result<{type_name}, ParseError>`);
    f.emit_begin(w);
    w.line("let tokens = tokenize(input);");
    w.line("let mut parser = Parser::new(tokens);");
    w.line(`return {fn_name}(&mut parser);`);
    w.end();
    w.blank();
}

fn first_check_str(first_set: &Array<String>) -> String {
    return kind_check_str(first_set, "p.peek_kind()");
}

fn kind_check_str(tokens: &Array<String>, expr: &String) -> String {
    if tokens.len() == 0 {
        return "true";
    }
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 { result.append(" || "); }
        result.append(`{expr} == {tokens[i]}`);
    }
    return result;
}

fn build_lookahead_condition(pos_sets: &Array<Array<String>>, depth: i32) -> String {
    let mut cond = String::with_capacity(128);
    for let mut d = 0; d < depth; d += 1 {
        if d > 0 { cond.append(" && "); }
        let tokens = &pos_sets[d];
        let check_expr = if d == 0 { "kind" } else { `p.peek_at({d})` };
        if tokens.len() == 1 {
            cond.append(`{check_expr} == {tokens[0]}`);
        } else {
            cond.append("(");
            for let mut j = 0; j < tokens.len(); j += 1 {
                if j > 0 { cond.append(" || "); }
                cond.append(`{check_expr} == {tokens[j]}`);
            }
            cond.append(")");
        }
    }
    return cond;
}

fn gen_error_fallback(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let mut expected: Array<String> = [];
    for let alt of rule.alternatives {
        let mut visiting: Array<String> = [];
        let first = first_of_alt(&alt, all_rules, lit_tokens, &mut visiting);
        for let tk of first {
            if !array_contains_str(&expected, &tk) {
                expected.append(tk);
            }
        }
    }
    let msg = escape_string(&`expected {rule.name}`);
    w.line(`return Result::<{type_name}, ParseError>::Err(ParseError::new(`);
    w.indent();
    w.line(`{msg},`);
    w.line("p.peek().span,");
    w.write("[");
    for let mut i = 0; i < expected.len(); i += 1 {
        if i > 0 { w.write(", "); }
        let s = escape_string(&expected[i]);
        w.write(s);
    }
    w.write("],\n");
    w.dedent();
    w.line("));");
}

fn first_of_alt(
    alt: &Alternative,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    let mut result: Array<String> = [];
    for let elem of alt.elements {
        let elem_first = first_of_element(&elem, all_rules, lit_tokens, visiting);
        for let tk of elem_first {
            if !array_contains_str(&result, &tk) {
                result.append(tk);
            }
        }
        if !is_nullable(&elem) {
            break;
        }
    }
    return result;
}

fn first_of_element(
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    if let TokenRef(name) = *elem {
        return [`TK_{name}`];
    }
    if let Literal(text) = *elem {
        return [literal_const_name(&text)];
    }
    if let RuleRef(name) = *elem {
        return first_of_rule(&name, all_rules, lit_tokens, visiting);
    }
    if let Group(alts) = *elem {
        let mut result: Array<String> = [];
        for let alt of alts {
            let af = first_of_alt(&alt, all_rules, lit_tokens, visiting);
            for let tk of af {
                if !array_contains_str(&result, &tk) {
                    result.append(tk);
                }
            }
        }
        return result;
    }
    if let Repeat(rep) = *elem {
        return first_of_element(&rep.element, all_rules, lit_tokens, visiting);
    }
    if let Label(lab) = *elem {
        return first_of_element(&lab.element, all_rules, lit_tokens, visiting);
    }
    return [];
}

fn first_of_rule(
    name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    if array_contains_str(visiting, name) {
        return [];
    }
    visiting.append(*name);

    let mut result: Array<String> = [];
    for let rule of all_rules {
        if rule.name == *name {
            for let alt of rule.alternatives {
                let af = first_of_alt(&alt, all_rules, lit_tokens, visiting);
                for let tk of af {
                    if !array_contains_str(&result, &tk) {
                        result.append(tk);
                    }
                }
            }
            break;
        }
    }

    let mut new_visiting: Array<String> = [];
    for let v of visiting {
        if *v != *name {
            new_visiting.append(*v);
        }
    }
    *visiting = new_visiting;

    return result;
}

fn is_simple_token_group(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 { return false; }
        let elem = &alt.elements[0];
        if let TokenRef(_) | Literal(_) = *elem { continue; }
        return false;
    }
    return true;
}

fn is_nullable(elem: &Element) -> bool {
    if let Repeat(rep) = *elem {
        if let Star | Optional = rep.kind { return true; }
    }
    return false;
}

fn alt_position_first_sets(
    alt: &Alternative,
    max_depth: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<Array<String>> {
    let mut result: Array<Array<String>> = [];
    let mut start = 0;
    while result.len() < max_depth && start < alt.elements.len() {
        if result.len() > 0 && is_nullable(&alt.elements[start]) { break; }

        let first = first_of_elements_from(&alt.elements, start, all_rules, lit_tokens);
        if first.len() == 0 { break; }
        result.append(first);
        let mut skipped_nullable = false;
        while start < alt.elements.len() {
            let was_nullable = is_nullable(&alt.elements[start]);
            if was_nullable { skipped_nullable = true; }
            start += 1;
            if !was_nullable { break; }
        }
        if skipped_nullable { break; }
    }
    return result;
}

fn first_of_elements_from(
    elements: &Array<Element>,
    start: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<String> {
    let mut result: Array<String> = [];
    for let mut i = start; i < elements.len(); i += 1 {
        let mut visiting: Array<String> = [];
        let elem_first = first_of_element(&elements[i], all_rules, lit_tokens, &mut visiting);
        for let tk of elem_first {
            if !array_contains_str(&result, &tk) {
                result.append(tk);
            }
        }
        if !is_nullable(&elements[i]) { break; }
    }
    return result;
}

fn sets_overlap(a: &Array<String>, b: &Array<String>) -> bool {
    for let x of a {
        if array_contains_str(b, x) { return true; }
    }
    return false;
}

fn find_needed_depth(all_position_sets: &Array<Array<Array<String>>>) -> i32 {
    let max_k = 5;
    for let mut depth = 1; depth <= max_k; depth += 1 {
        let mut all_ok = true;
        for let mut i = 0; i < all_position_sets.len(); i += 1 {
            for let mut j = i + 1; j < all_position_sets.len(); j += 1 {
                let mut still_ambiguous = true;
                for let mut d = 0; d < depth; d += 1 {
                    if d >= all_position_sets[i].len() || d >= all_position_sets[j].len() {
                        still_ambiguous = false;
                        break;
                    }
                    if !sets_overlap(&all_position_sets[i][d], &all_position_sets[j][d]) {
                        still_ambiguous = false;
                        break;
                    }
                }
                if still_ambiguous {
                    all_ok = false;
                }
            }
        }
        if all_ok { return depth; }
    }
    return max_k;
}

fn dedup_name(base: &String, counts: &mut Array<[String, i32]>) -> String {
    let count = get_count(counts, base);
    increment_count(counts, base);
    if count > 0 {
        return `{base}_{count + 1}`;
    }
    return *base;
}

fn get_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.append([*name, 1]);
}

fn all_alternatives_labeled(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}

fn is_left_recursive(alt: &Alternative, rule_name: &String) -> bool {
    if alt.elements.len() == 0 { return false; }
    let first = &alt.elements[0];
    if let RuleRef(name) = *first {
        return name == *rule_name;
    }
    return false;
}

fn compute_overlap_groups(first_sets: &Array<Array<String>>) -> Array<Array<i32>> {
    let n = first_sets.len();
    let mut group_ids: Array<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        group_ids.append(i);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = i + 1; j < n; j += 1 {
            if sets_overlap(&first_sets[i], &first_sets[j]) {
                let gi = group_ids[i];
                let gj = group_ids[j];
                if gi != gj {
                    for let mut k = 0; k < n; k += 1 {
                        if group_ids[k] == gj {
                            group_ids[k] = gi;
                        }
                    }
                }
            }
        }
    }
    let mut seen_ids: Array<i32> = [];
    let mut groups: Array<Array<i32>> = [];
    for let mut i = 0; i < n; i += 1 {
        let gid = group_ids[i];
        let mut found = -1;
        for let mut s = 0; s < seen_ids.len(); s += 1 {
            if seen_ids[s] == gid {
                found = s;
                break;
            }
        }
        if found >= 0 {
            groups[found].append(i);
        } else {
            seen_ids.append(gid);
            groups.append([i]);
        }
    }
    return groups;
}

fn has_multi_alt_groups(groups: &Array<Array<i32>>) -> bool {
    for let group of groups {
        if group.len() > 1 { return true; }
    }
    return false;
}

fn sort_group_by_specificity(
    group: &mut Array<i32>,
    first_sets: &Array<Array<String>>,
) {
    // Sort by first set size ascending: smaller first set = more specific = try first.
    // Ties broken by original order (stable-ish bubble sort).
    for let mut i = 0; i < group.len(); i += 1 {
        for let mut j = i + 1; j < group.len(); j += 1 {
            if first_sets[group[j]].len() < first_sets[group[i]].len() {
                let tmp = group[i]; group[i] = group[j]; group[j] = tmp;
            }
        }
    }
}

fn alt_sort_priority(alt: &Alternative) -> i32 {
    // Priority for sorting (higher = try first):
    // 4: Multi-element starting with fixed token — most specific explicit patterns
    //    (e.g. K_EXISTS '(' select_stmt ')', K_CAST '(' expr K_AS type_name ')')
    // 3: Single RuleRef — can match complex internal patterns (e.g. join_clause)
    // 2: Multi-element starting with RuleRef — less specific (e.g. function_name '(' ...)
    //    Within this tier, more elements = more specific
    // 1: Single Token/Literal — simple fallbacks (e.g. K_INSERT)
    if alt.elements.len() == 1 {
        let elem = &alt.elements[0];
        if let RuleRef(_) = *elem { return 3; }
        return 1;
    }
    // Multi-element: check first non-nullable element.
    for let elem of alt.elements {
        if is_nullable(&elem) { continue; }
        if let TokenRef(_) | Literal(_) = elem { return 4; }
        break;
    }
    return 2;
}

fn sort_group_by_element_count(
    group: &mut Array<i32>,
    alts: &Array<Alternative>,
) {
    for let mut i = 0; i < group.len(); i += 1 {
        for let mut j = i + 1; j < group.len(); j += 1 {
            let pi = alt_sort_priority(&alts[group[i]]);
            let pj = alt_sort_priority(&alts[group[j]]);
            let mut swap = false;
            if pj > pi {
                swap = true;
            } else if pj == pi && pi == 2 {
                // Within multi-element tier: more elements = more specific = first
                if alts[group[j]].elements.len() > alts[group[i]].elements.len() {
                    swap = true;
                }
            }
            if swap {
                let tmp = group[i]; group[i] = group[j]; group[j] = tmp;
            }
        }
    }
}
