/// Append the defaulted runtime FOLLOW-continuation argument to a
/// parse/scan/LR function signature, BEFORE any `min_prec` so a
/// non-precedence call site can pass `parse_X(p, follow)` uniformly.
/// Emitted only when the grammar has a caller-FOLLOW gate
/// (`ctx.emit_follow()`); guarded at every call site so grammars with
/// no FOLLOW repair pay no per-frame cost. Repair call sites pass a
/// `FOLLOW_MASK_<id>` constant or forward their own `follow`. See
/// `follow_yields` in `runtime/follow.wado`.
fn add_follow_param(f: &mut FnSpec) {
    f.add_param_spec(ParamSpec {
        name: "follow",
        type_str: "&List<List<i32>>",
        default_value: Option::Some("&EMPTY_FOLLOW"),
    });
}

/// The callee-local parameter name a rule argument binds to. `escape_ident`
/// keeps a keyword-named arg (`type`) a legal identifier; the value is stored
/// into the vals field under the raw arg name so `$arg` -> `vals.<name>` holds.
fn arg_param_name(name: &String) -> String {
    return escape_ident(&to_snake_case(name));
}

/// Append one defaulted parameter per rule argument (`escape(name): <type> =
/// <default>`), in declaration order, at the end of the signature. Defaulted so
/// the public entry and plain `a` call sites (no `a[...]`) fill them in. Only
/// emitted for rules whose args are threaded (`rule_threads_args`).
fn add_arg_params(f: &mut FnSpec, rule: &ParserRule, ctx: &GenContext) {
    if !ctx.emit_actions() || !rule_threads_args(rule) {
        return;
    }
    for let a of &rule.args {
        let def = wado_type_default(&a.type_text).expect("add_arg_params: rule_threads_args/wado_type_default disagree");
        f.add_param_spec(ParamSpec {
            name: arg_param_name(&a.name),
            type_str: a.type_text.trim(),
            default_value: Option::Some(def),
        });
    }
}

/// The `, n, m` a rule wrapper forwards to its inner body for threaded args.
fn wrapper_arg_forward(rule: &ParserRule, ctx: &GenContext) -> String {
    if !ctx.emit_actions() || !rule_threads_args(rule) {
        return String::new();
    }
    let mut s = String::new();
    for let a of &rule.args {
        s.push_str(&", ");
        s.push_str(&arg_param_name(&a.name));
    }
    return s;
}

/// Store each threaded rule argument into the rule's `vals` local, so `$arg`
/// (which resolves to `vals.<name>`) reads the passed-in value. Emitted right
/// after the `vals` local, before `@init`.
fn emit_arg_stores(w: &mut CodeWriter, rule: &ParserRule, ctx: &GenContext) {
    if !ctx.emit_actions() || !rule_threads_args(rule) {
        return;
    }
    for let a of &rule.args {
        w.line(&`vals.${a.name} = ${arg_param_name(&a.name)};`);
    }
}

/// The `, arg0, arg1` a caller passes for the callee's threaded arguments, or
/// `""`. `arg_action` (`a[$i, $j]`) is split on top-level commas and each
/// expression is translated against the *caller's* environment. A plain `a`
/// call passes nothing (the callee's defaulted params fill in).
fn call_arg_suffix(rc: &RuleCallOp, ctx: &mut GenContext) -> String {
    if !ctx.emit_actions() {
        return String::new();
    }
    let callee = match ctx.find_rule(&rc.target_name) {
        Some(r) => r,
        None => {
            return String::new();
        },
    };
    if !rule_threads_args(callee) {
        return String::new();
    }
    let src = match &rc.arg_action {
        Some(s) => s,
        None => {
            return String::new();
        },
    };
    let exprs = split_top_level_commas(&src.text);
    let mut out = String::new();
    for let e of &exprs {
        let code = match translate_caller_arg(e, ctx) {
            Some(c) => c,
            None => *e,
        };
        out.push_str(&", ");
        out.push_str(&code.trim());
    }
    return out;
}

/// Translate a single caller-side argument expression against the caller's
/// (current) rule environment, so `$i` resolves to the caller's channel. A
/// ref-free expression passes through; an untranslatable one is returned raw
/// (a later type error is clearer than a silent drop).
fn translate_caller_arg(expr: &String, ctx: &GenContext) -> Option<String> {
    if ctx.action_language() matches { Wado } && find_attr_refs(expr).len() == 0 {
        return Option::Some(*expr);
    }
    let ridx = ctx.current_rule_index();
    if ridx < 0 {
        return null;
    }
    let rule = &ctx.parser_rules()[ridx];
    let vals_in_scope = rule_emits_vals(ctx, rule);
    let lang = ctx.action_language();
    return match translate_predicate(
        &lang,
        rule,
        ctx.parser_rules(),
        expr,
        vals_in_scope,
        ctx.alt_bindings(),
        ctx.grammar_name(),
        ctx.action_member_methods(),
    ) {
        Ok(c) => Option::Some(c),
        Err(_) => null,
    };
}

/// Split an argument-action text on commas that are not nested inside
/// parentheses / brackets / braces / angle brackets, so `f(a, b), c` splits
/// into `f(a, b)` and `c`. String / char literals are skipped.
fn split_top_level_commas(text: &String) -> List<String> {
    let mut out: List<String> = [];
    let mut cur = String::new();
    let mut depth = 0;
    let chars: List<char> = text.chars().collect();
    let mut i = 0;
    while i < chars.len() {
        let c = chars[i];
        match c {
            '(' | '[' | '{' | '<' => {
                depth += 1;
                cur.push(c);
            },
            ')' | ']' | '}' | '>' => {
                if depth > 0 {
                    depth -= 1;
                }
                cur.push(c);
            },
            ',' && depth == 0 => {
                out.push(cur.trim());
                cur = String::new();
            },
            _ => cur.push(c),
        }
        i += 1;
    }
    if !cur.trim().is_empty() {
        out.push(cur.trim());
    }
    return out;
}

/// `", follow"` when the grammar emits FOLLOW machinery, else `""`.
/// Appended after a call's fixed arguments so the forwarded `follow`
/// is passed only when the callee actually declares the parameter
/// (`ctx.emit_follow()`). See `GenContext::emit_follow`.
fn follow_sep(emit_follow: bool) -> String {
    if emit_follow {
        return ", follow";
    }
    return "";
}

/// `", <FollowArg expr>"` (e.g. `, &FOLLOW_MASK_3`) when the grammar
/// emits FOLLOW machinery, else `""`.
fn follow_arg_sep(emit_follow: bool, arg: &FollowArg) -> String {
    if emit_follow {
        return `, ${follow_arg_expr(arg)}`;
    }
    return "";
}

pub fn gen_parser(w: &mut CodeWriter, grammar: &Grammar, lowered: &LoweredGrammar, ctx: &mut GenContext) {
    // Phase 3 — `lowered` mirrors `grammar.parser_rules` rule-for-rule
    // by name and order. emit still consumes surface IR for the body
    // of each rule (Phase 4 migrates those entry points); the
    // `LoweredGrammar` is threaded through so we can dispatch on
    // `Rule::Simple` / `MultiAlt` / `LeftRecursive` instead of
    // recomputing the classification at every emit site.
    let members = collect_parser_members(grammar, ctx);
    gen_parser_struct(
        w,
        ctx.is_trace(),
        ctx.needs_atn(),
        ctx.emit_actions(),
        !ctx.fragment_entries().is_empty(),
        &members,
    );
    gen_member_methods(w, &members);
    if ctx.emit_actions() {
        gen_vals_structs(w, grammar);
    }
    if ctx.is_trace() {
        gen_trace_helpers(w);
    }
    gen_scan_functions(w, grammar, lowered, ctx);
    for let mut i = 0; i < grammar.parser_rules.len(); i += 1 {
        let rule = &grammar.parser_rules[i];
        let lowered_rule = &lowered.parser_rules[i];
        gen_parse_fn(w, rule, lowered_rule, ctx);
    }
    // The runtime-FOLLOW redesign retired per-(rule, mask) variant
    // emission: each rule is emitted exactly once and threads the
    // caller's continuation at runtime via the `follow` argument (see
    // `follow_yields` / `FollowArg`). The follow-mask globals are
    // emitted by `gen_follow_mask_globals` at the end of codegen.
    gen_predicate_fns(w, ctx);
    if !ctx.fragment_entries().is_empty() {
        let entries = compute_fragment_entries(grammar, ctx);
        gen_recover_helpers(w, &entries);
    }
    gen_parse_entry(w, lowered, ctx);
    warn_unhandled_actions(grammar, ctx);
}

struct RecoverFragmentEntry {
    call: String,
    first_names: List<String>,
}

fn compute_fragment_entries(grammar: &Grammar, ctx: &mut GenContext) -> List<RecoverFragmentEntry> {
    let names = *ctx.fragment_entries();
    let mut result: List<RecoverFragmentEntry> = [];
    let mut seen: List<String> = [];
    for let name of &names {
        if seen.contains(name) {
            continue;
        }
        seen.push(*name);
        let mut found = -1;
        for let mut i = 0; i < grammar.parser_rules.len(); i += 1 {
            if grammar.parser_rules[i].name == *name {
                found = i;
                break;
            }
        }
        if found < 0 {
            ctx.warn(
                &"fragment_entries",
                DiagnosticKind::FragmentEntry,
                `fragment_entries: unknown parser rule '${*name}'`,
            );
            continue;
        }
        let rule_name = grammar.parser_rules[found].name;
        let snake = grammar.parser_rules[found].snake_name;
        let emits_vals = entry_emits_vals(ctx, &rule_name);
        let mut visiting: List<String> = [];
        let first_ids = ctx.first_ids_of_rule(&rule_name, &mut visiting);
        let first_names = ctx.token_names_of(&first_ids);
        let call = if emits_vals { `let _ = _parse_${snake}(p);` } else { `_parse_${snake}(p);` };
        result.push(RecoverFragmentEntry { call, first_names });
    }
    return result;
}

fn gen_recover_helpers(w: &mut CodeWriter, entries: &List<RecoverFragmentEntry>) {
    for let mut i = 0; i < entries.len(); i += 1 {
        w.line(&`global _FRAGMENT_FIRST_${i}: List<i32> = [${join_kinds(&entries[i].first_names)}];`);
    }
    if !entries.is_empty() {
        w.blank();
    }

    let mut d = FnSpec::new("_recover_fragment");
    d.add_param(&"p", &"&mut Parser");
    d.set_return_type(&"bool");
    d.emit_begin(w);
    if entries.is_empty() {
        w.line(&"return false;");
    } else {
        w.line(&"let _k = p.kinds[p.pos];");
        for let mut i = 0; i < entries.len(); i += 1 {
            w.begin(&`if p.in_set(_k, &_FRAGMENT_FIRST_${i})`);
            w.line(&entries[i].call);
            w.line(&"return true;");
            w.end();
        }
        w.line(&"return false;");
    }
    w.end();
    w.blank();

    let mut s = FnSpec::new("_recover_try_descend");
    s.add_param(&"p", &"&mut Parser");
    s.emit_begin(w);
    w.line(&"let _before = p.pos;");
    w.line(&"let _was = p.recovering;");
    w.line(&"p.recovering = false;");
    w.line(&"let _did = _recover_fragment(p);");
    w.line(&"p.recovering = _was;");
    w.begin(&"if !_did || p.pos == _before");
    w.line(&"let _sk = p.advance();");
    w.line(&"p.tokens.mark_skipped(_sk);");
    w.line(&"p.b.skip(_sk);");
    w.end();
    w.end();
    w.blank();
}

/// Emit each context-free gated predicate as a standalone effect-free fn
/// `fn pred_<id>(p: &Parser) -> bool { return <body>; }`. Registered during the
/// per-rule marking pass; a `&Parser` receiver keeps it read-only (the same fn
/// the ATN disabled-seed prune calls). No-op when none were registered.
fn gen_predicate_fns(w: &mut CodeWriter, ctx: &GenContext) {
    for let entry of ctx.predicate_fns() {
        let mut f = FnSpec::new(&pred_fn_name(entry.0));
        f.add_param(&"p", &"&Parser");
        f.set_return_type(&"bool");
        f.emit_begin(w);
        w.line(&`return ${entry.1};`);
        w.end();
        w.blank();
    }
}

fn warn_unhandled_actions(grammar: &Grammar, ctx: &mut GenContext) {
    if !ctx.emit_actions() {
        return;
    }
    for let rule of &grammar.parser_rules {
        let mut ids: List<i32> = [];
        collect_rule_action_ids(rule, &mut ids);
        for let id of &ids {
            if !ctx.action_was_seen(*id) {
                ctx.warn(
                    &`action ${*id}`,
                    DiagnosticKind::UnsupportedAction,
                    `action ${*id} in rule '${rule.name}' is on a code path that does not yet execute actions (nested group, LR suffix, single-token multi-alt, or multi-alt prequel)`,
                );
            }
        }
    }
}

/// Whether codegen will emit any action / predicate for this rule. Rules that
/// do are kept off the compact single-token fast path (which has no per-alt
/// body to host them).
fn rule_has_emittable_actions(rule: &ParserRule, ctx: &GenContext) -> bool {
    if !ctx.emit_actions() {
        return false;
    }
    let mut ids: List<i32> = [];
    collect_rule_action_ids(rule, &mut ids);
    return ids.len() > 0;
}

fn collect_rule_action_ids(rule: &ParserRule, out: &mut List<i32>) {
    if let Some(a) = &rule.init_action {
        out.push(a.action_id);
    }
    if let Some(a) = &rule.after_action {
        out.push(a.action_id);
    }
    for let alt of &rule.alternatives {
        collect_alt_action_ids(alt, out);
    }
}

fn collect_alt_action_ids(alt: &Alternative, out: &mut List<i32>) {
    for let a of &alt.actions {
        out.push(a.source.action_id);
    }
    for let e of &alt.elements {
        collect_element_action_ids(e, out);
    }
}

fn collect_element_action_ids(elem: &Element, out: &mut List<i32>) {
    match *elem {
        Group(g) => {
            for let alt of &g.alternatives {
                collect_alt_action_ids(alt, out);
            }
        },
        Repeat(rep) => collect_element_action_ids(&rep.element, out),
        Label(lab) => collect_element_action_ids(&lab.element, out),
        Not(n) => collect_element_action_ids(&n.element, out),
        _ => {
        },
    }
}

/// The ` with Foo` clause a parse-entry fn carries when the lexer declares a
/// `superClass` — the entry calls `tokenize` (which carries the base effect),
/// so it must propagate it. Empty when there is no superClass.
fn superclass_clause(ctx: &GenContext) -> String {
    if ctx.has_superclass() {
        return ` with ${*ctx.superclass_name()}`;
    }
    return "";
}

/// Public `parse` entry under the emitter: tokenize, run the start
/// rule (which drives the builder), and return a `ParseResult`. The parser is
/// infallible; a failure leaves `p.recovering` set and the deepest error in
/// `p.pending`, surfaced as one diagnostic. The partial tree (open nodes folded
/// by each wrapper's `finish_node`) is still returned.
fn gen_parse_entry(w: &mut CodeWriter, lowered: &LoweredGrammar, ctx: &GenContext) {
    if lowered.parser_rules.len() == 0 {
        return;
    }
    // The tokenize → run-entry → fold-error body is identical for every rule, so
    // it lives in a single `_run_parse_entry` helper; each `parse_<rule>` is a thin
    // wrapper that hands it the rule's `_parse_<rule>` entry as a fn value.
    gen_run_parse_entry(w, ctx);
    w.blank();
    // `parse` is the start (first) rule. Per-rule `parse_<rule>` entries let a
    // caller parse from any rule (ANTLR4 lets you pick a start rule; the
    // ANTLR4-compat descriptors name one), mirroring the typed parser.
    let start = rule_header(&lowered.parser_rules[0]);
    w.begin(&`pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult${superclass_clause(ctx)}`);
    w.line(&`return parse_${start.snake_name}(input, max_errors);`);
    w.end();
    w.blank();
    for let rule of &lowered.parser_rules {
        gen_parse_rule_entry(w, rule, ctx);
    }
}

/// Emit the shared entry body once per generated module: tokenize, run the
/// supplied rule entry (`_parse_<rule>`, passed as a fn value so a follow-gated
/// or LR entry's defaulted `follow` / `min_prec` arguments fill in), fold the
/// partial tree, and on error push a single diagnostic (deepest of the
/// propagated error and `p.pending`).
fn gen_run_parse_entry(w: &mut CodeWriter, ctx: &GenContext) {
    w.begin(
        &`fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult${superclass_clause(
            ctx,
        )}`,
    );
    // `max_errors` caps recovery; 1 is the fail-fast minimum. 0 (or negative)
    // would suppress every diagnostic and let a broken parse report `ok()`, so
    // reject it up front.
    w.line(&"assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;");
    w.line(&"let tokens = tokenize(input);");
    w.line(&"let mut p = Parser::new(tokens);");
    if ctx.emit_actions() {
        // Lexer prints happen before any parser print, as they do on ANTLR4's
        // stdout: seed the sink with what tokenizing produced.
        w.line(&"p.output = p.tokens.output;");
    }
    w.line(&"p.max_errors = max_errors;");
    w.line(&"entry(&mut p);");
    // The parser is infallible: a failure leaves `p.recovering` set and the
    // deepest error in `p.pending`. Surface it as one diagnostic; the partial
    // tree (open nodes folded by each wrapper's `finish_node`) is still returned.
    w.begin(&"if p.recovering && p.diagnostics.len() < max_errors");
    w.begin(&"if let Some(e) = &p.pending");
    w.line(&"let lc = line_col(p.tokens.chars, e.span.start);");
    w.line(
        &"let mut d = Diagnostic::error(p.pending_code, e.message, e.span, lc.0, lc.1);",
    );
    // Carry the active rule chain (innermost-first, as each rule wrapper pushed
    // it on the way up) so tooling can report the context that failed.
    w.line(&"d.rule_stack = e.rule_stack;");
    w.line(&"p.diagnostics.push(d);");
    w.end();
    w.end();
    if ctx.emit_actions() {
        w.line(
            &"return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.output };",
        );
    } else {
        w.line(&"return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };");
    }
    w.end();
}

/// Emit one `pub fn parse_<rule>(input) -> ParseResult` entry as a thin wrapper
/// over `_run_parse_entry`. The closure defers to `_parse_<rule>(p)` so a follow-gated
/// or LR entry's defaulted `follow` / `min_prec` arguments fill in.
fn gen_parse_rule_entry(w: &mut CodeWriter, rule: &Rule, ctx: &GenContext) {
    let header = rule_header(rule);
    w.begin(
        &`pub fn parse_${header.snake_name}(input: &String, max_errors: i32 = i32::MAX) -> ParseResult${superclass_clause(
            ctx,
        )}`,
    );
    let call = `_parse_${header.snake_name}(p)`;
    let entry = if entry_emits_vals(ctx, &header.name) {
        `|p: &mut Parser| \{ let _ = ${call}; \}`;
    } else {
        `|p: &mut Parser| ${call}`;
    };
    w.line(&`return _run_parse_entry(input, max_errors, ${entry});`);
    w.end();
    w.blank();
}

fn entry_emits_vals(ctx: &GenContext, rule_name: &String) -> bool {
    return match ctx.find_rule(rule_name) {
        Some(r) => rule_emits_vals(ctx, r),
        None => false,
    };
}

fn join_kinds(kinds: &List<String>) -> String {
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < kinds.len(); i += 1 {
        if i > 0 {
            result.push_str(&", ");
        }
        result.push_str(&kinds[i]);
    }
    return result;
}

/// Emit the "matched — consume the current token and return its index" tail of
/// a Parser consuming method. The Parser appends the token to the builder
/// first; typed just advances.
fn emit_consume_return(w: &mut CodeWriter) {
    w.line(&"let _i = self.advance();");
    w.line(&"self.b.token(_i);");
    w.line(&"return _i;");
}

/// Consume the matched `kind` and return its index: EOF matches in place (the
/// stream holds one EOF; advancing past it reads out of bounds, ANTLR4's
/// `matchedEOF`), everything else advances. Used by `expect`'s match / delete /
/// resync branches, which all consume `kind` the same way.
fn emit_consume_kind_return(w: &mut CodeWriter) {
    w.begin(&"if kind == TK_EOF");
    w.line(&"self.b.token(self.pos);");
    w.line(&"return self.pos;");
    w.end();
    emit_consume_return(w);
}

/// Shared prologue for the `report_*` diagnostic methods: drop the diagnostic
/// (and fold the parse) once `max_errors` is reached, otherwise resolve the
/// `line:col` for `span.start`.
fn emit_diag_prologue(w: &mut CodeWriter) {
    w.line(&"if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }");
    w.line(&"let lc = line_col(self.tokens.chars, span.start);");
}

/// Emit a `<Rule>Vals` struct per rule that exposes a value channel. Fields
/// are the rule's returns then locals, each with a defaulted Wado type, so
/// the rule function can default-construct `<Rule>Vals {}`.
fn gen_vals_structs(w: &mut CodeWriter, grammar: &Grammar) {
    for let rule of &grammar.parser_rules {
        if !rule_returns_vals(rule) {
            continue;
        }
        w.begin(&`struct ${vals_struct_name(rule)}`);
        if rule_threads_args(rule) {
            gen_vals_fields(w, &rule.args);
        }
        gen_vals_fields(w, &rule.returns_decls);
        gen_vals_fields(w, &rule.locals_decls);
        w.end();
        w.blank();
    }
}

fn gen_vals_fields(w: &mut CodeWriter, decls: &List<AttrDecl>) {
    for let d of decls {
        if !field_in_vals(d) {
            continue;
        }
        let def = wado_type_default(&d.type_text).expect("gen_vals_fields: field_in_vals/wado_type_default disagree");
        w.line(&`${d.name}: ${d.type_text} = ${def},`);
    }
}

/// Translate the grammar's `@parser::members` (and bare `@members`) blocks to
/// `Parser` struct fields + methods. Only when actions are emittable; an
/// untranslatable block is a loud diagnostic, not a silent drop.
fn collect_parser_members(grammar: &Grammar, ctx: &mut GenContext) -> MemberDecls {
    let mut fields: List<MemberField> = [];
    let mut methods: List<String> = [];
    if !ctx.emit_actions() {
        return MemberDecls { fields, methods };
    }
    let lang = ctx.action_language();
    for let act of &grammar.named_actions {
        if !is_parser_members(act, &grammar.kind) {
            continue;
        }
        match translate_members(&lang, &act.body.text, &grammar.name) {
            Ok(m) => {
                for let f of &m.fields {
                    fields.push(*f);
                }
                for let mm of &m.methods {
                    methods.push(*mm);
                }
            },
            Err(msg) => {
                ctx.warn(&"@members", DiagnosticKind::UnsupportedAction, msg);
            },
        }
    }
    return MemberDecls { fields, methods };
}

/// Emit `@members` method declarations as a separate `impl Parser` block. Each
/// method source is a ready-to-splice `fn ... { ... }` from `translate_members`.
fn gen_member_methods(w: &mut CodeWriter, members: &MemberDecls) {
    if members.methods.is_empty() {
        return;
    }
    ImplSpec::new("Parser").emit_begin(w);
    for let m of &members.methods {
        w.line(m);
    }
    w.end();
    w.blank();
}

fn gen_parser_struct(
    w: &mut CodeWriter,
    trace: bool,
    needs_atn: bool,
    emit_actions: bool,
    fragment_recovery: bool,
    members: &MemberDecls,
) {
    let mut s = StructSpec::new("Parser");
    s.add_field(&"tokens", &"TokenStream");
    // Token kinds as a bare `Array<i32>` — the hot scan/peek read. A flat
    // array (not the `List<i32>` wrapper) so reading `kinds[pos]` is a single
    // `array.get` with nothing for the optimizer to hoist into an extra local;
    // a `&List<i32>` would cost every deeply-recursive scan frame one more
    // slot, overflowing the wasm stack on pathological grammars.
    s.add_field(&"kinds", &"Array<i32>");
    s.add_field(&"pos", &"i32");
    // Deepest speculative failure seen (a scan-gated repetition re-parses a
    // malformed element to harvest a precise inner error). The input-entry
    // reports it over the shallow "expected <closer>" error when it reaches
    // at least as far into the token stream.
    s.add_field(&"pending", &"Option<ParseError>");
    // Error-recovery flag. The parser is infallible: a match method that cannot
    // consume its terminal records the failure (into `pending`) and sets this
    // instead of propagating a `Result`. While set, every match method and rule
    // wrapper short-circuits (returns without consuming) so the recursive
    // descent unwinds to the entry, where the partial tree is folded closed —
    // reproducing the old `?` early-return without a `Result` type. A
    // speculative re-parse saves and restores it so a probe never aborts the
    // real parse.
    s.add_field(&"recovering", &"bool");
    // Diagnostic code for the pending failure (`UnexpectedToken` for a plain
    // mismatch, `NoViableAlternative` when no alternative applied); the entry
    // surfaces it with `pending`.
    s.add_field(&"pending_code", &"DiagnosticCode");
    // Set while a speculative parse runs (a scan-gated repeat's recovery probe,
    // an LR alt save-and-rewind). Recovery edits are suppressed: a mismatch
    // fails (records the deepest error, sets `recovering`) instead of
    // inserting / deleting / skipping, so the caller can cleanly backtrack —
    // static scan cannot tell a malformed element from a valid one that belongs
    // to the caller's continuation, so committing edits here would steal tokens.
    s.add_field(&"speculating", &"bool");
    // Cap on collected diagnostics (the `max_errors` entry parameter). Once
    // reached, recovery stops recording and folds the tree closed by setting
    // `recovering`; `<= 1` is effectively fail-fast (one diagnostic, partial
    // tree). Defaults to `i32::MAX` — unbounded.
    s.add_field(&"max_errors", &"i32");
    // Current recursive-descent depth, used only to indent trace output.
    if trace {
        s.add_field(&"trace_depth", &"i32");
    }
    // Runtime ATN simulator state (only when a non-greedy / LR decision needs
    // it); the decoded ATN is shared via the module-level `ATN_SIM`.
    // `atn_stack` is the caller stack of ATN return states for full-context
    // prediction. `atn_ret_pending` passes a call site's return state to the
    // callee's entry wrapper, which pushes it and resets to -1 (an unstamped
    // call pushes -1 = unknown caller, handled as SLL).
    if needs_atn {
        s.add_field(&"atn_stack", &"List<i32>");
        s.add_field(&"atn_ret_pending", &"i32");
    }
    // the parser drives a `TreeBuilder` (`b`) — the matched
    // terminals / subtrees accrue there in source order — and collects
    // `Diagnostic`s. The struct otherwise mirrors the typed Parser, so the
    // shared prediction / scan / ATN emission and the runtime ATN calls work
    // against it unchanged.
    s.add_field(&"b", &"TreeBuilder");
    s.add_field(&"diagnostics", &"List<Diagnostic>");
    if emit_actions {
        s.add_field(&"output", &"String");
    }
    // `@members` fields: defaulted so `Parser::new`'s literal can omit them.
    for let mf of &members.fields {
        s.add_field_default(&mf.name, &mf.ty, &mf.init);
    }
    s.emit(w);
    w.blank();

    ImplSpec::new("Parser").emit_begin(w);

    let mut f = FnSpec::new("new");
    f.add_param(&"tokens", &"TokenStream");
    f.set_return_type(&"Parser");
    f.emit_begin(w);
    w.line(&"let kinds = tokens.kinds.to_array();");
    let mut init = String::from(
        "tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX",
    );
    if trace {
        init.push_str(&", trace_depth: 0");
    }
    if needs_atn {
        init.push_str(&", atn_stack: [], atn_ret_pending: -1");
    }
    init.push_str(&", b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: []");
    if emit_actions {
        init.push_str(&", output: \"\"");
    }
    w.line(&`return Parser \{ ${init} \};`);
    w.end();
    w.blank();

    if emit_actions {
        let mut fem = FnSpec::new("emit");
        fem.set_receiver(&"&mut self");
        fem.add_param(&"s", &"String");
        fem.emit_begin(w);
        w.line(&"self.output.push_str(&s);");
        w.end();
        w.blank();

        let mut ftt = FnSpec::new("token_text");
        ftt.set_receiver(&"&self");
        ftt.add_param(&"i", &"i32");
        ftt.set_return_type(&"String");
        ftt.emit_begin(w);
        w.line(&"return self.tokens.token_text(i);");
        w.end();
        w.blank();

        let mut fk = FnSpec::new("token_kind");
        fk.set_receiver(&"&self");
        fk.add_param(&"i", &"i32");
        fk.set_return_type(&"i32");
        fk.emit_begin(w);
        w.line(&"return self.tokens.kind_at(i);");
        w.end();
        w.blank();

        // `$X.int` mirrors ANTLR's `Integer.parseInt`: a 32-bit value, so
        // `token_int` returns `i32` (matching a `returns [int v]` field, which
        // java2wado maps to `i32`).
        let mut fint = FnSpec::new("token_int");
        fint.set_receiver(&"&self");
        fint.add_param(&"i", &"i32");
        fint.set_return_type(&"i32");
        fint.emit_begin(w);
        w.line(&"let sp = self.tokens.span_at(i);");
        w.line(&"let mut acc: i32 = 0;");
        w.line(&"let mut neg = false;");
        w.line(&"let mut j = sp.start;");
        w.begin(&"if j < sp.end && self.tokens.chars[j] == '-'");
        w.line(&"neg = true;");
        w.line(&"j += 1;");
        w.end();
        w.begin(&"while j < sp.end");
        w.line(&"let c = self.tokens.chars[j];");
        w.begin(&"if c >= '0' && c <= '9'");
        w.line(&"acc = acc * 10 + (c as i32 - '0' as i32);");
        w.end();
        w.line(&"j += 1;");
        w.end();
        w.line(&"return if neg { -acc } else { acc };");
        w.end();
        w.blank();

        let mut fln = FnSpec::new("token_line");
        fln.set_receiver(&"&self");
        fln.add_param(&"i", &"i32");
        fln.set_return_type(&"i32");
        fln.emit_begin(w);
        w.line(&"return line_col(self.tokens.chars, self.tokens.span_at(i).start).0;");
        w.end();
        w.blank();

        let mut fcol = FnSpec::new("token_col");
        fcol.set_receiver(&"&self");
        fcol.add_param(&"i", &"i32");
        fcol.set_return_type(&"i32");
        fcol.emit_begin(w);
        w.line(&"return line_col(self.tokens.chars, self.tokens.span_at(i).start).1;");
        w.end();
        w.blank();

        // Byte offset where token `i` begins — backs `$text` (span from the
        // rule's first token) and `$start`-derived spans.
        let mut fts0 = FnSpec::new("token_start");
        fts0.set_receiver(&"&self");
        fts0.add_param(&"i", &"i32");
        fts0.set_return_type(&"i32");
        fts0.emit_begin(w);
        w.line(&"return self.tokens.starts[i];");
        w.end();
        w.blank();

        // `_input.LA(k)` — the token kind k positions ahead (k=1 is current).
        let mut fla = FnSpec::new("la");
        fla.set_receiver(&"&self");
        fla.add_param(&"k", &"i32");
        fla.set_return_type(&"i32");
        fla.emit_begin(w);
        w.line(&"return self.peek_at(k - 1);");
        w.end();
        w.blank();

        // `_input.LT(k)` — the stream index k positions ahead, clamped to the
        // final (EOF) token so a lookahead past end stays in bounds.
        let mut flt = FnSpec::new("lt");
        flt.set_receiver(&"&self");
        flt.add_param(&"k", &"i32");
        flt.set_return_type(&"i32");
        flt.emit_begin(w);
        w.line(&"let idx = self.pos + k - 1;");
        w.line(&"if idx >= self.kinds.len() { return self.kinds.len() - 1; }");
        w.line(&"if idx < 0 { return 0; }");
        w.line(&"return idx;");
        w.end();
        w.blank();

        // Source text of the half-open byte range `[start, end)` — backs `$text`
        // (the current rule's consumed input) and `_input.getText()`.
        let mut fts = FnSpec::new("text_span");
        fts.set_receiver(&"&self");
        fts.add_param(&"start", &"i32");
        fts.add_param(&"end", &"i32");
        fts.set_return_type(&"String");
        fts.emit_begin(w);
        w.line(&"let mut out = String::new();");
        w.line(&"let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };");
        w.begin(&"for let mut i = start; i < hi; i += 1");
        w.line(&"out.push(self.tokens.chars[i]);");
        w.end();
        w.line(&"return out;");
        w.end();
        w.blank();

        // `$text` — the input matched by the current rule so far. ANTLR
        // concatenates the parse-tree token texts (skipped tokens are absent
        // from the token stream), so a `-> skip` gap between tokens does NOT
        // appear; this differs from a raw source-span slice (`text_span`). The
        // range is the rule's first token (`start_tok`) through the last
        // consumed token (`self.pos - 1`).
        // `$<label>.text` — the text of one labeled rule call's own token range.
        let mut ftb = FnSpec::new("text_between");
        ftb.set_receiver(&"&self");
        ftb.add_param(&"lo", &"i32");
        ftb.add_param(&"hi", &"i32");
        ftb.set_return_type(&"String");
        ftb.emit_begin(w);
        w.line(&"return self.tokens.rule_text(lo, hi);");
        w.end();
        w.blank();

        let mut frt = FnSpec::new("rule_text");
        frt.set_receiver(&"&self");
        frt.add_param(&"start_tok", &"i32");
        frt.set_return_type(&"String");
        frt.emit_begin(w);
        w.line(&"return self.tokens.rule_text(start_tok, self.pos - 1);");
        w.end();
        w.blank();

        // `_input.getText()` — the entire input.
        let mut fit = FnSpec::new("input_text");
        fit.set_receiver(&"&self");
        fit.set_return_type(&"String");
        fit.emit_begin(w);
        w.line(&"return self.text_span(0, self.tokens.chars.len());");
        w.end();
        w.blank();

        // `$ctx.toStringTree()` — the S-expression of the rule currently under
        // construction. A non-LR rule's node is still open in `@after`
        // (`render_open`); a left-recursive rule's level is already folded shut
        // by then, so its `@after` reads the just-finished node
        // (`rule_string_tree_final` / `render_last_finished`).
        let mut frst = FnSpec::new("rule_string_tree");
        frst.set_receiver(&"&self");
        frst.set_return_type(&"String");
        frst.emit_begin(w);
        w.line(&"return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);");
        w.end();
        w.blank();

        let mut frstf = FnSpec::new("rule_string_tree_final");
        frstf.set_receiver(&"&self");
        frstf.set_return_type(&"String");
        frstf.emit_begin(w);
        w.line(&"return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);");
        w.end();
        w.blank();
    }

    // Build a ParseError at the current position, resolving `line:col` from the
    // source. `rule_stack` is filled by the rule-entry wrappers as it propagates.
    let mut fe = FnSpec::new("error");
    fe.set_receiver(&"&self");
    fe.add_param(&"message", &"String");
    fe.add_param(&"span", &"Span");
    fe.add_param(&"expected", &"List<String>");
    fe.set_return_type(&"ParseError");
    fe.emit_begin(w);
    w.line(&"let lc = line_col(self.tokens.chars, span.start);");
    w.line(&"return ParseError::at(message, span, expected, lc.0, lc.1);");
    w.end();
    w.blank();

    // Record an unrecoverable match failure and enter recovery. Infallible
    // replacement for the old `return Result::Err(...)`: the deepest failure is
    // kept in `pending` (with its `code`) and `recovering` short-circuits the
    // rest of the descent until the entry surfaces it.
    let mut ff = FnSpec::new("fail");
    ff.set_receiver(&"&mut self");
    ff.add_param(&"message", &"String");
    ff.add_param(&"span", &"Span");
    ff.add_param(&"expected", &"List<String>");
    ff.add_param(&"code", &"DiagnosticCode");
    ff.emit_begin(w);
    w.line(&"let e = self.error(message, span, expected);");
    w.line(&"let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };");
    w.begin(&"if take");
    w.line(&"self.pending = Option::Some(e);");
    w.line(&"self.pending_code = code;");
    w.end();
    w.line(&"self.recovering = true;");
    w.end();
    w.blank();

    // Alternative dispatch found no viable alternative: record the failure with
    // the `NoViableAlternative` code and enter recovery (thin wrapper over
    // `fail`).
    let mut nv = FnSpec::new("no_viable");
    nv.set_receiver(&"&mut self");
    nv.add_param(&"message", &"String");
    nv.add_param(&"span", &"Span");
    nv.add_param(&"expected", &"List<String>");
    nv.emit_begin(w);
    w.line(&"self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);");
    w.end();
    w.blank();

    // Append a rule name to the pending error's rule stack as the descent
    // unwinds (each rule wrapper calls this on the way out when recovering),
    // so tooling can report the context that failed.
    let mut prs = FnSpec::new("push_rule_stack");
    prs.set_receiver(&"&mut self");
    prs.add_param(&"name", &"String");
    prs.emit_begin(w);
    w.begin(&"if let Some(e) = &mut self.pending");
    w.line(&"e.rule_stack.push(name);");
    w.end();
    w.end();
    w.blank();

    // Message of the deepest pending failure (for trace output); empty when
    // none has been recorded yet.
    let mut pm = FnSpec::new("pending_message");
    pm.set_receiver(&"&self");
    pm.set_return_type(&"String");
    pm.emit_begin(w);
    w.line(&"if let Some(e) = &self.pending { return e.message; }");
    w.line(&"return String::from(\"\");");
    w.end();
    w.blank();

    // Membership test for a recovery sync set (the rule's FIRST-of-rest).
    let mut iset = FnSpec::new("in_set");
    iset.set_receiver(&"&self");
    iset.add_param(&"k", &"i32");
    iset.add_param(&"set", &"&List<i32>");
    iset.set_return_type(&"bool");
    iset.emit_begin(w);
    w.line(&"for let x of set { if *x == k { return true; } }");
    w.line(&"return false;");
    w.end();
    w.blank();

    // Record a local recovery edit as a diagnostic and keep parsing (no
    // `recovering`): a deleted spurious terminal (`ExtraToken`) or an inserted
    // required terminal (`MissingToken`).
    let mut rex = FnSpec::new("report_extra");
    rex.set_receiver(&"&mut self");
    rex.add_param(&"span", &"Span");
    rex.emit_begin(w);
    emit_diag_prologue(w);
    w.line(
        &"self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input \"${self.tokens.token_text(self.pos)}\"`, span, lc.0, lc.1));",
    );
    w.end();
    w.blank();

    let mut rmi = FnSpec::new("report_missing");
    rmi.set_receiver(&"&mut self");
    rmi.add_param(&"kind", &"i32");
    rmi.add_param(&"span", &"Span");
    rmi.emit_begin(w);
    emit_diag_prologue(w);
    w.line(&"let name = token_kind_name(kind);");
    w.line(
        &"self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));",
    );
    w.end();
    w.blank();

    // Record an unexpected-token error opening an `<error>` recovery region.
    let mut run = FnSpec::new("report_unexpected");
    run.set_receiver(&"&mut self");
    run.add_param(&"span", &"Span");
    run.emit_begin(w);
    emit_diag_prologue(w);
    w.line(
        &"self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input \"${self.tokens.token_text(self.pos)}\"`, span, lc.0, lc.1));",
    );
    w.end();
    w.blank();


    // A "token" handed to the rest of the parser is its `i32` index into the
    // stream; node fields store that index, not a Token aggregate.
    let mut f2 = FnSpec::new("peek_start");
    f2.set_receiver(&"&self");
    f2.set_return_type(&"i32");
    f2.emit_begin(w);
    w.line(&"return self.tokens.starts[self.pos];");
    w.end();
    w.blank();

    let mut f2b = FnSpec::new("peek_span");
    f2b.set_receiver(&"&self");
    f2b.set_return_type(&"Span");
    f2b.emit_begin(w);
    w.line(&"return self.tokens.span_at(self.pos);");
    w.end();
    w.blank();

    let mut f3 = FnSpec::new("peek_kind");
    f3.set_receiver(&"&self");
    f3.set_return_type(&"i32");
    f3.emit_begin(w);
    w.line(&"return self.kinds[self.pos];");
    w.end();
    w.blank();

    let mut f4 = FnSpec::new("peek_at");
    f4.set_receiver(&"&self");
    f4.add_param(&"offset", &"i32");
    f4.set_return_type(&"i32");
    f4.emit_begin(w);
    w.line(&"let idx = self.pos + offset;");
    w.line(&"if idx >= self.kinds.len() { return TK_EOF; }");
    w.line(&"return self.kinds[idx];");
    w.end();
    w.blank();

    let mut f5 = FnSpec::new("advance");
    f5.set_receiver(&"&mut self");
    f5.set_return_type(&"i32");
    f5.emit_begin(w);
    w.line(&"let i = self.pos;");
    w.line(&"self.pos += 1;");
    w.line(&"return i;");
    w.end();
    w.blank();

    let mut f6 = FnSpec::new("last_end");
    f6.set_receiver(&"&self");
    f6.set_return_type(&"i32");
    f6.emit_begin(w);
    w.line(&"if self.pos == 0 { return 0; }");
    w.line(&"return self.tokens.ends[self.pos - 1];");
    w.end();
    w.blank();

    // `p.expect(kind, sync)` matches a single token of the requested kind. EOF
    // is matched without advancing so consecutive `EOF` references see the same
    // sentinel (the stream holds one EOF; advancing past it reads out of
    // bounds). Mirrors ANTLR4's `matchedEOF`.
    //
    // On a mismatch it recovers in place (never propagating): a single spurious
    // token before the expected one is *deleted* (`<skip>`, `ExtraToken`); a
    // token that continues the rule (`sync` = the rule's FIRST-of-rest) means
    // the expected one is missing and is *inserted* (`<missing>`, `MissingToken`);
    // anything else is unrecoverable here, so it sets `recovering` and unwinds.
    // Delete and insert are local edits — they record a diagnostic but keep
    // parsing, so a clean tail still parses.
    let mut f7 = FnSpec::new("expect");
    f7.set_receiver(&"&mut self");
    f7.add_param(&"kind", &"i32");
    f7.add_param(&"sync", &"&List<i32>");
    f7.set_return_type(&"i32");
    f7.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.begin(&"if self.kinds[self.pos] == kind");
    emit_consume_kind_return(w);
    w.end();
    // In a speculative parse, do not apply recovery edits — fail so the caller
    // backtracks (committing an edit here could steal tokens that belong to the
    // caller's continuation, which static scan cannot rule out).
    w.begin(&"if self.speculating");
    w.line(&"let name = token_kind_name(kind);");
    w.line(
        &"self.fail(`expected ${name}, got \"${self.tokens.token_text(self.pos)}\"`, self.tokens.span_at(self.pos), [name], DiagnosticCode::UnexpectedToken);",
    );
    w.line(&"return self.pos;");
    w.end();
    if fragment_recovery {
        w.begin(&"if kind == TK_EOF && self.kinds[self.pos] != TK_EOF");
        w.line(&"self.report_unexpected(self.tokens.span_at(self.pos));");
        w.line(&"self.b.start_error(self.tokens.span_at(self.pos).start);");
        w.begin(&"loop");
        w.line(&"if self.kinds[self.pos] == TK_EOF { break; }");
        w.line(&"_recover_try_descend(self);");
        w.end();
        w.line(&"self.b.finish_node(self.last_end());");
        emit_consume_kind_return(w);
        w.end();
    }
    // single-token deletion: the current token is spurious, the expected one
    // follows it.
    w.begin(&"if self.peek_at(1) == kind");
    w.line(&"self.report_extra(self.tokens.span_at(self.pos));");
    w.line(&"let _sk = self.advance();");
    w.line(&"self.tokens.mark_skipped(_sk);");
    w.line(&"self.b.skip(_sk);");
    emit_consume_kind_return(w);
    w.end();
    // single-token insertion: the current token continues the rule, so the
    // expected one is missing.
    w.begin(&"if self.in_set(self.kinds[self.pos], sync)");
    w.line(&"self.report_missing(kind, self.tokens.span_at(self.pos));");
    w.line(&"let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);");
    w.line(&"self.b.missing(_syn);");
    w.line(&"return _syn;");
    w.end();
    // Neither match nor a single-token edit fits. If the rule's FIRST-of-rest
    // (`sync`) is known, skip the offending run into a lossless `<error>`
    // region and resync to it, then continue; otherwise record the deepest
    // failure and unwind.
    w.begin(&"if !sync.is_empty()");
    w.line(&"self.report_unexpected(self.tokens.span_at(self.pos));");
    w.begin(&"if self.kinds[self.pos] != TK_EOF");
    w.line(&"self.b.start_error(self.tokens.span_at(self.pos).start);");
    w.begin(&"loop");
    w.line(&"let _k = self.kinds[self.pos];");
    w.line(&"if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }");
    w.line(&"let _sk = self.advance();");
    w.line(&"self.tokens.mark_skipped(_sk);");
    w.line(&"self.b.skip(_sk);");
    w.end();
    w.line(&"self.b.finish_node(self.last_end());");
    w.end();
    // resynced exactly onto the expected token: consume it.
    w.begin(&"if self.kinds[self.pos] == kind");
    emit_consume_kind_return(w);
    w.end();
    // resynced onto a follow token / EOF: the expected one is still missing.
    w.line(&"let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);");
    w.line(&"self.b.missing(_syn2);");
    w.line(&"return _syn2;");
    w.end();
    // no sync info: record the deepest failure and unwind.
    w.line(&"let name = token_kind_name(kind);");
    w.line(&"self.fail(");
    w.indent();
    w.line(&"`expected ${name}, got \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"[name],");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();
    w.blank();

    // `p.any()` — consumes one token of any kind (for `.` wildcard).
    // Fails at EOF.
    let mut f9 = FnSpec::new("any");
    f9.set_receiver(&"&mut self");
    f9.set_return_type(&"i32");
    f9.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.begin(&"if self.kinds[self.pos] != TK_EOF");
    emit_consume_return(w);
    w.end();
    w.line(&"self.fail(");
    w.indent();
    w.line(&"`expected any token, got \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"[\"any token\"],");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();
    w.blank();

    // `p.expect_not([...])` — consumes one token whose kind is not in the
    // exclusion set (parser-side `~ X`). Fails at EOF or on an excluded kind.
    let mut f10 = FnSpec::new("expect_not");
    f10.set_receiver(&"&mut self");
    f10.add_param(&"excluded", &"List<i32>");
    f10.set_return_type(&"i32");
    f10.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.line(&"let k = self.kinds[self.pos];");
    w.begin(&"if k != TK_EOF");
    w.line(&"let mut blocked = false;");
    w.begin(&"for let x of excluded");
    w.begin(&"if x == k");
    w.line(&"blocked = true;");
    w.line(&"break;");
    w.end();
    w.end();
    w.begin(&"if !blocked");
    emit_consume_return(w);
    w.end();
    w.end();
    w.line(&"self.fail(");
    w.indent();
    w.line(&"`unexpected token \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"[\"set complement\"],");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();
    w.blank();

    // `p.expect_set([...])` — consumes one token whose kind is in the included
    // set (parser-side token-only groups like `('b' | 'c')`). Fails outside the
    // set (EOF included unless listed); a listed EOF matches without advancing.
    let mut f11 = FnSpec::new("expect_set");
    f11.set_receiver(&"&mut self");
    f11.add_param(&"included", &"List<i32>");
    f11.set_return_type(&"i32");
    f11.emit_begin(w);
    w.line(&"if self.recovering { return self.pos; }");
    w.line(&"let k = self.kinds[self.pos];");
    w.begin(&"for let x of included");
    w.begin(&"if x == k");
    w.begin(&"if k == TK_EOF");
    w.line(&"self.b.token(self.pos);");
    w.line(&"return self.pos;");
    w.end();
    emit_consume_return(w);
    w.end();
    w.end();
    w.line(&"self.fail(");
    w.indent();
    w.line(&"`unexpected token \"${self.tokens.token_text(self.pos)}\"`,");
    w.line(&"self.tokens.span_at(self.pos),");
    w.line(&"[\"token set\"],");
    w.line(&"DiagnosticCode::UnexpectedToken,");
    w.dedent();
    w.line(&");");
    w.line(&"return self.pos;");
    w.end();

    w.end();  // impl
    w.blank();
}

// For each alternative in an Ambiguous group that has a scannable prefix,
// generate a scan_<rule>_alt_<N> function. This function scans only the
// scannable prefix of the alternative, which is enough to distinguish it
// from other alternatives without full speculative parsing.

/// Returns the number of leading elements in the alternative that are scannable.
/// Stops at the first unscannable element (e.g., a RuleRef to `expr`).
fn scannable_prefix_len(elements: &List<Element>, ctx: &mut GenContext) -> i32 {
    let mut count: i32 = 0;
    for let elem of elements {
        let mut visiting: List<String> = [];
        if !ctx.is_element_scannable(elem, &mut visiting) {
            break;
        }
        count += 1;
    }
    return count;
}

/// Generate a scan function for a tournament alternative (`parse_X_alt_N` —
/// the `_alt_` infix is historical) if it has at least one scannable leading
/// element. The scan covers the scannable prefix only.
pub fn gen_alt_scan_if_possible(
    w: &mut CodeWriter,
    alt: &Alternative,
    lowered_rule: &Rule,
    fn_name: &String,
    alt_index: i32,
    rule_name: &String,
    ctx: &mut GenContext,
) {
    let prefix_len = scannable_prefix_len(&alt.elements, ctx);
    if prefix_len == 0 {
        return;
    }

    let scan_body = if let Some(b) = rule_alt_scan_body(lowered_rule, alt_index) {
        b;
    } else {
        panic(`gen_alt_scan_if_possible: no scan body for alt ${alt_index}`);
    };

    let scan_name = `${*fn_name}_scan_${alt_index}`;

    let mut f = FnSpec::new(&scan_name);
    f.add_param(&"tokens", &"&Array<i32>");
    f.add_param(&"pos", &"i32");
    if ctx.emit_follow() {
        add_follow_param(&mut f);
    }
    f.set_return_type(&"i32");
    f.emit_begin(w);
    w.line(&"let mut pos = pos;");

    // alt-scan should treat the LAST element as atom-only when it is a
    // self-reference to the current rule — that is the prefix-alt case
    // (`op expr` etc.) where the OUTER LR loop will consume what follows
    // and including it here would over-match. Inner self-refs, by
    // contrast, are bounded by surrounding tokens (e.g. `K_WHEN expr
    // K_THEN expr` inside `case_expr`) and need a full scan.
    gen_alt_scan_op_elements(w, &scan_body.elements, prefix_len, rule_name, ctx);

    w.line(&"return pos;");
    w.end();
    w.blank();
}

/// Returns true if the alternative has a generated scan function (has scannable prefix).
fn alt_has_scan(elements: &List<Element>, ctx: &mut GenContext) -> bool {
    return scannable_prefix_len(elements, ctx) > 0;
}

/// Returns true if the scan function covers the entire alternative (all elements are scannable).
/// When true, a scan success guarantees parse success so no fallthrough is needed.
fn alt_scan_is_full(elements: &List<Element>, ctx: &mut GenContext) -> bool {
    return scannable_prefix_len(elements, ctx) == elements.len();
}

// Scan functions recognize parser rules by walking token kinds without building
// CST nodes or constructing error messages. They return the token position after
// successful recognition, or -1 on failure. Used to disambiguate Ambiguous
// alternatives without expensive speculative parsing.

pub fn gen_scan_functions(w: &mut CodeWriter, grammar: &Grammar, lowered: &LoweredGrammar, ctx: &mut GenContext) {
    for let mut i = 0; i < grammar.parser_rules.len(); i += 1 {
        gen_scan_function(w, &grammar.parser_rules[i], &lowered.parser_rules[i], ctx);
    }
}

fn gen_scan_function(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, ctx: &mut GenContext) {
    gen_scan_function_named(w, rule, lowered_rule, ctx, &`scan_${rule.snake_name}`);
}

/// Body emitter for a rule's scan function. Left-recursive rules
/// dispatch to `gen_scan_lr_functions`; every other shape emits a
/// single `scan_<rule>` body below.
/// Whether this scan body can run to its end at the position it started —
/// the only shape where the non-nullable post-condition can fire. A body
/// holding any element that must consume never reaches it, so emitting the
/// check there would be dead code in every generated scan.
fn scan_body_can_match_empty(elements: &List<ScanElement>) -> bool {
    for let e of elements {
        if !scan_element_can_match_empty(e) {
            return false;
        }
    }
    return true;
}

fn scan_element_can_match_empty(se: &ScanElement) -> bool {
    return match se {
        Token(_) | Wildcard | Excluded(_) => false,
        // Only the snake name reaches scan IR, so the callee's nullability is
        // out of reach here; assume it can be empty and let the body's other
        // elements decide.
        RuleCall(_) => true,
        Repeat(re) => if let Plus = re.kind {
            scan_element_can_match_empty(&re.body);
        } else {
            true;
        },
        Group(ge) => {
            if ge.lenient {
                true;
            } else {
                let mut any = false;
                for let alt of &ge.alts {
                    if scan_body_can_match_empty(&alt.elements) {
                        any = true;
                        break;
                    }
                }
                any;
            }
        },
        OptionalLookahead(_) => true,
    };
}

fn gen_scan_function_named(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lowered_rule: &Rule,
    ctx: &mut GenContext,
    fn_name: &String,
) {
    if let LeftRecursive(l) = lowered_rule {
        // LR rule: project the atom's alt indices into the
        // surface-rule numbering so `gen_scan_lr_functions` can
        // walk surface alts for the atom-side scan body.
        let mut non_lr_indices: List<i32> = [];
        for let alt of &l.atom.alts {
            non_lr_indices.push(alt.alt_index);
        }
        // ATN-class LR rule: route the scan loop through
        // `atn_lr_loop_decision` (the rule's ATN loop-entry); every scan
        // rule call brackets with the scan caller stack via
        // `gen_scan_op_element`.
        let atn_loop_dec = if l.atn_class && ctx.needs_atn() {
            ctx.lr_loop_entry_decision(ctx.rule_index_of(&rule.name));
        } else {
            -1;
        };
        gen_scan_lr_functions(
            w,
            rule,
            &l.lr_alts,
            &l.lr_dispatch,
            &non_lr_indices,
            &l.atom.scan_alts,
            ctx,
            fn_name,
            atn_loop_dec,
        );
        return;
    }

    let mut f = FnSpec::new(fn_name);
    f.add_param(&"tokens", &"&Array<i32>");
    f.add_param(&"pos", &"i32");
    // Accept (and ignore) min_prec so call sites pass it uniformly
    // regardless of whether the target rule is left-recursive. See
    // `GenContext.scan_ruleref_min_prec` for the alt-scan use case.
    if ctx.emit_follow() {
        add_follow_param(&mut f);
    }
    f.add_param_spec(ParamSpec {
        name: "min_prec",
        type_str: "i32",
        default_value: Option::Some("0"),
    });
    f.set_return_type(&"i32");
    f.emit_begin(w);

    if rule.alternatives.len() == 1 {
        // `lower_rule` maps every single-alt surface rule to
        // `Rule::Simple` — multi-alt and LR shapes require 2+ surface
        // alts. The pattern is therefore total over the shape we observe
        // here.
        let scan_body = if let Simple(s) = lowered_rule {
            &s.scan_body;
        } else {
            panic(
                "gen_scan_function_named: single-alt rule but lowered_rule is not Simple — lower_rule invariant violated",
            );
        };
        // A rule that cannot derive the empty string must not report a
        // zero-token match. Its body's mandatory group scans `lenient` by
        // default, so a gate miss rewinds to the entry position and the rule
        // would return "matched, consumed nothing" — which a caller's repeat
        // gate reads as a viable iteration (SQLite's `( ';'+ sql_stmt )*`
        // entering on a trailing `';'`). Leniency inside the body is kept:
        // only the whole-rule result is checked.
        let mut nullable_visiting: List<String> = [];
        let non_nullable = !ctx.rule_is_nullable(&rule.name, &mut nullable_visiting)
            && scan_body_can_match_empty(&scan_body.elements);
        if non_nullable {
            w.line(&"let scan_start = pos;");
        }
        w.line(&"let mut pos = pos;");
        gen_scan_op_elements(w, &scan_body.elements, 0, scan_body.elements.len(), ctx, &"return -1;");
        if non_nullable {
            w.line(&"if pos == scan_start { return -1; }");
        }
        w.line(&"return pos;");
    } else if all_alts_are_single_token(&rule.alternatives) {
        // Compact form: every alt matches exactly one fixed token, so the
        // entire scan reduces to "is the next token in this set?". A naive
        // multi-alt expansion would emit one labelled partition per token
        // (~7 lines × N tokens) — for `keyword` in SQLite that is 122 alts
        // ≈ 1000 lines of source per scan invocation site. Collapsing to a
        // single `matches` cuts the per-rule scan code 100×+, which removes
        // most of the wasm bloat that LR-gate removal otherwise pays for
        // by making scan_X functions reachable. Behaviourally identical to
        // the longest-match tournament: every alt consumes exactly one
        // token, so longest-match and first-success-wins both pick whatever
        // alt's token equals `tokens[pos]`.
        let mut firsts: List<String> = [];
        for let alt of &rule.alternatives {
            let t = single_token_first(&alt.elements[0]);
            if !first_contains(&firsts, &t) {
                firsts.push(t);
            }
        }
        let check = ctx.kind_check_str(&firsts, &"tokens[pos]");
        w.begin(&`if pos < tokens.len() && ${check}`);
        w.line(&"return pos + 1;");
        w.end();
        w.line(&"return -1;");
    } else {
        // `gen_scan_multi_alt` walks every alt body via the op-driven
        // `gen_scan_op_elements_in_block`. Fetch the `scan_alts` from
        // the matching `Rule` variant — multi-alt non-LR rules go
        // through `MultiAlt`; LR rules dispatch earlier via the
        // `LeftRecursive` branch above.
        let scan_alts = if let MultiAlt(m) = lowered_rule {
            &m.scan_alts;
        } else {
            panic(
                "gen_scan_function_named: multi-alt rule but lowered_rule is not MultiAlt — lower_rule invariant violated",
            );
        };
        gen_scan_multi_alt(w, &rule.alternatives, scan_alts, ctx);
    }

    w.end();
    w.blank();
}

/// Generate scan functions for a left-recursive rule. Mirrors the parse-side
/// precedence-climbing infrastructure so that scan success/failure is a
/// faithful predicate for parse success/failure:
///
///   - scan_X_atom(tokens, pos): scans non-LR alternatives (first-match).
///   - scan_X_lr_N(tokens, pos): scans the suffix (elements[1..]) of the N-th
///     LR alternative, recursing into scan_X for self-refs with the same
///     precedence thresholds that parse_X_lr_N uses.
///   - scan_X(tokens, pos, min_prec = 0): atom + precedence-aware LR-suffix
///     loop with token-kind dispatch and second-token overlap resolution.
///     Callers without a precedence context omit min_prec and get 0.
fn gen_scan_lr_functions(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lr_alts: &List<LrAlt>,
    lr_dispatch: &LrDispatchData,
    non_lr_indices: &List<i32>,
    atom_scan_alts: &List<ScanBody>,
    ctx: &mut GenContext,
    fn_name: &String,
    atn_loop_dec: i32,
) {
    let atom_name = `${*fn_name}_atom`;

    // scan_X_atom: tries each non-LR alt (first-match, same shape as before).
    let mut fa = FnSpec::new(&atom_name);
    fa.add_param(&"tokens", &"&Array<i32>");
    fa.add_param(&"pos", &"i32");
    if ctx.emit_follow() {
        add_follow_param(&mut fa);
    }
    fa.set_return_type(&"i32");
    fa.emit_begin(w);
    let mut non_lr_alts: List<Alternative> = [];
    for let idx of non_lr_indices {
        non_lr_alts.push(rule.alternatives[*idx]);
    }
    if non_lr_alts.len() == 0 {
        w.line(&"return -1;");
    } else if non_lr_alts.len() == 1 {
        w.line(&"let mut pos = pos;");
        let body = &atom_scan_alts[0];
        gen_scan_op_elements(w, &body.elements, 0, body.elements.len(), ctx, &"return -1;");
        w.line(&"return pos;");
    } else {
        gen_scan_multi_alt(w, &non_lr_alts, atom_scan_alts, ctx);
    }
    w.end();
    w.blank();

    // scan_X_lr_N for each valid LR alt (suffix helper, mirrors parse_X_lr_N).
    gen_scan_lr_suffix_helpers(w, lr_alts, &lr_dispatch.valid_lr_alts, ctx, fn_name);

    // scan_X(tokens, pos, min_prec = 0): atom + precedence-aware dispatch loop.
    let mut f2 = FnSpec::new(fn_name);
    f2.add_param(&"tokens", &"&Array<i32>");
    f2.add_param(&"pos", &"i32");
    if ctx.emit_follow() {
        add_follow_param(&mut f2);
    }
    f2.add_param_spec(ParamSpec {
        name: "min_prec",
        type_str: "i32",
        default_value: Option::Some("0"),
    });
    f2.set_return_type(&"i32");
    f2.emit_begin(w);
    w.line(&`let mut pos = ${atom_name}(tokens, pos${follow_sep(ctx.emit_follow())});`);
    w.line(&"if pos < 0 { return -1; }");
    let side = LrDispatchSide { scan: true, fn_name: *fn_name, scan_fn_name: "", use_prec: false };
    if atn_loop_dec >= 0 {
        gen_lr_suffix_dispatch_atn(w, &side, lr_alts, lr_dispatch, ctx, atn_loop_dec);
    } else {
        gen_lr_suffix_dispatch(w, &side, rule, lr_alts, lr_dispatch, ctx);
    }
    w.line(&"return pos;");
    w.end();
    w.blank();
}

/// Scan-side twin of the LR-suffix emit in `gen_lr_fn`. Emits `scan_X_lr_N(tokens, pos)`
/// for each valid LR alternative, scanning its suffix (elements[1..]). Self-
/// recursive calls compile to `scan_X(tokens, pos, prec)` with the same
/// precedence value the parse side uses; the precedence is baked onto
/// `ScanRuleCallElement.min_prec_arg` by `stamp_lr_self_ref_min_prec`.
fn gen_scan_lr_suffix_helpers(
    w: &mut CodeWriter,
    lr_alts: &List<LrAlt>,
    valid_lr_alts: &List<i32>,
    ctx: &mut GenContext,
    fn_name: &String,
) {
    // Emit a helper for EXACTLY the alts the dispatch references — iterate
    // `valid_lr_alts` directly rather than re-deriving the skip predicate, so
    // the helper set and the dispatch's reference set cannot drift and emit a
    // call to an undefined `scan_X_lr_N` (the static/ATN-class predicates for
    // `valid_lr_alts` differ; this stays correct for both).
    for let vi of valid_lr_alts {
        let lr_alt = &lr_alts[*vi];
        let lr_idx = lr_alt.alt_index;
        let suffix_fn = `${*fn_name}_lr_${lr_idx}`;

        let mut f = FnSpec::new(&suffix_fn);
        f.add_param(&"tokens", &"&Array<i32>");
        f.add_param(&"pos", &"i32");
        if ctx.emit_follow() {
            add_follow_param(&mut f);
        }
        f.set_return_type(&"i32");
        f.emit_begin(w);
        w.line(&"let mut pos = pos;");

        // Walk lr_alt.scan_suffix.elements (which runs in lockstep
        // with alt.elements[1..] and lr_alt.suffix.ops). Every
        // shape — including self-recursive RuleCalls and
        // Optional+RuleRef — is now driven by lower-baked data on
        // the `ScanElement`: `min_prec_arg` for self-refs (via
        // `stamp_lr_self_ref_min_prec`) and `caller_follow_first`
        // for Optionals (via the alt-walker's `lower_scan_*` post-
        // pass + `gen_scan_op_repeat`'s subtraction).
        for let scan_elem of &lr_alt.scan_suffix.elements {
            gen_scan_op_element(w, scan_elem, ctx, &"return -1;");
        }
        w.line(&"return pos;");
        w.end();
        w.blank();
    }
}

/// Scan-side twin of `gen_lr_suffix_dispatch`. Emits the precedence-aware
// No static scan gate is emitted: the simulator's decision is the commit.
fn gen_lr_suffix_dispatch_atn(
    w: &mut CodeWriter,
    side: &LrDispatchSide,
    lr_alts: &List<LrAlt>,
    lr_dispatch: &LrDispatchData,
    ctx: &mut GenContext,
    decision: i32,
) {
    let valid = &lr_dispatch.valid_lr_alts;
    let pos_expr = if side.scan { "pos" } else { "p.pos" };
    w.begin(&"loop");
    if side.scan {
        w.line(
            &`let _atn_alt = atn_lr_loop_decision(&ATN_SIM, &SCAN_STACK, ${decision}, tokens, pos, TK_EOF, min_prec);`,
        );
    } else {
        w.line(
            &`let _atn_alt = atn_lr_loop_decision(&ATN_SIM, &p.atn_stack, ${decision}, &p.kinds, p.pos, TK_EOF, min_prec);`,
        );
    }
    w.line(&`let _lr_pos0 = ${pos_expr};`);
    let mut is_first = true;
    for let mut i = 0; i < valid.len(); i += 1 {
        let lr_idx = lr_alts[valid[i]].alt_index;
        let suffix_fn = `${side.fn_name}_lr_${lr_idx}`;
        if is_first {
            w.begin(&`if _atn_alt == ${i}`);
            is_first = false;
        } else {
            w.else_begin(&`else if _atn_alt == ${i}`);
        }
        if side.scan {
            w.line(&`pos = ${suffix_fn}(tokens, pos${follow_sep(ctx.emit_follow())});`);
            w.line(&"if pos < 0 { return -1; }");
        } else {
            w.line(&`result = ${suffix_fn}(p, result, start${follow_sep(ctx.emit_follow())});`);
        }
    }
    if !is_first {
        w.else_begin(&"else");
        w.line(&"break;");
        w.end();
    } else {
        w.line(&"break;");
    }
    w.begin(&`if ${pos_expr} == _lr_pos0`);
    w.line(&"break;");
    w.end();
    w.end();  // loop
}

struct LrDispatchSide {
    scan: bool,
    fn_name: String,
    scan_fn_name: String,  // parse side only
    use_prec: bool,  // parse side only
}

fn gen_lr_branch_call(w: &mut CodeWriter, side: &LrDispatchSide, lr_idx: i32, prec: i32, emit_follow: bool) {
    let suffix_fn = `${side.fn_name}_lr_${lr_idx}`;
    if side.scan {
        gen_scan_lr_call_with_prec(w, &suffix_fn, prec, emit_follow);
    } else {
        let scan_suffix_fn = `${side.scan_fn_name}_lr_${lr_idx}`;
        gen_lr_call_with_prec(w, &suffix_fn, &scan_suffix_fn, prec, side.use_prec, emit_follow);
    }
}

fn gen_lr_suffix_dispatch(
    w: &mut CodeWriter,
    side: &LrDispatchSide,
    rule: &ParserRule,
    lr_alts: &List<LrAlt>,
    lr_dispatch: &LrDispatchData,
    ctx: &mut GenContext,
) {
    let projected = project_lr_dispatch(lr_alts, lr_dispatch);
    let valid_lr_indices = projected.0;
    let lr_precs = projected.1;
    let suffix_first_sets = projected.2;

    let pos_expr = if side.scan { "pos" } else { "p.pos" };
    w.begin(&"loop");
    if side.scan {
        w.line(&"let suffix_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };");
    } else {
        w.line(&"let suffix_kind = p.peek_kind();");
    }
    // No-progress guard, mirroring the ATN twins
    // (`gen_lr_suffix_dispatch_atn` / `gen_lr_fn_atn`): every valid LR
    // suffix begins with a mandatory operator token, so a committed
    // iteration always advances. The guard makes that termination
    // structural rather than relying on each suffix consuming input — a
    // suffix that yielded an empty `valid_lr_alts` member would otherwise
    // spin here.
    w.line(&`let _lr_pos0 = ${pos_expr};`);

    let mut is_first = true;
    for let mut g = 0; g < lr_dispatch.groups.len(); g += 1 {
        let group = &lr_dispatch.groups[g];

        let mut union_first: List<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &suffix_first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, &"suffix_kind");
        if is_first {
            w.begin(&`if ${cond}`);
            is_first = false;
        } else {
            w.else_begin(&`else if ${cond}`);
        }

        if group.len() == 1 {
            let lr_idx = valid_lr_indices[group[0]];
            let prec = lr_precs[group[0]];
            gen_lr_branch_call(w, side, lr_idx, prec, ctx.emit_follow());
        } else {
            gen_lr_overlap_dispatch(
                w,
                side,
                rule,
                group,
                &valid_lr_indices,
                &lr_precs,
                &suffix_first_sets,
                ctx,
            );
        }
    }

    if !is_first {
        w.else_begin(&"else");
        w.line(&"break;");
        w.end();
    } else {
        w.line(&"break;");
    }
    w.begin(&`if ${pos_expr} == _lr_pos0`);
    w.line(&"break;");
    w.end();
    w.end();  // loop
}

fn gen_scan_lr_call_with_prec(w: &mut CodeWriter, suffix_fn: &String, prec: i32, emit_follow: bool) {
    // The LR loop must always commit to the longest valid prefix it can
    // build. If the suffix scan fails (e.g. the suffix's first token matches
    // but a deeper element does not, as in `statement letterA 'b'` consuming
    // the trailing `letterA` then failing on `'b'`), we restore `pos` to the
    // last successful position and break out of the loop — never propagate
    // the failure as the whole scan failing. ANTLR4's LL(*) prediction
    // achieves the same result at decision time; Gale's first-token dispatch
    // makes the same decision lazily after attempting the suffix.
    w.begin(&`if ${prec} >= min_prec`);
    w.line(&`let lr_saved_pos = pos;`);
    w.line(&`pos = ${*suffix_fn}(tokens, pos${follow_sep(emit_follow)});`);
    w.line(&"if pos < 0 { pos = lr_saved_pos; break; }");
    w.else_begin(&"else");
    w.line(&"break;");
    w.end();
}

fn gen_lr_overlap_dispatch(
    w: &mut CodeWriter,
    side: &LrDispatchSide,
    rule: &ParserRule,
    group: &List<i32>,
    valid_lr_indices: &List<i32>,
    lr_precs: &List<i32>,
    suffix_first_sets: &List<List<String>>,
    ctx: &mut GenContext,
) {
    let mut emitted = TreeSet::<String>::new();
    let mut first_branch = true;

    // First pass: unique-token branches.
    for let mut k = 0; k < group.len(); k += 1 {
        let this_first = &suffix_first_sets[group[k]];
        for let mut t = 0; t < this_first.len(); t += 1 {
            let tk = &this_first[t];
            if emitted.contains(*tk) {
                continue;
            }
            let mut shared = false;
            for let mut j = 0; j < group.len(); j += 1 {
                if j == k {
                    continue;
                }
                if suffix_first_sets[group[j]].contains(tk) {
                    shared = true;
                }
            }
            if !shared {
                let lr_idx = valid_lr_indices[group[k]];
                let prec = lr_precs[group[k]];
                if first_branch {
                    w.begin(&`if suffix_kind == ${*tk}`);
                    first_branch = false;
                } else {
                    w.else_begin(&`else if suffix_kind == ${*tk}`);
                }
                gen_lr_branch_call(w, side, lr_idx, prec, ctx.emit_follow());
                emitted.insert(*tk);
            }
        }
    }

    // Second pass: shared-token branches with second-token sub-dispatch.
    let mut shared_tokens: List<String> = [];
    let mut shared_seen = TreeSet::<String>::new();
    for let mut k = 0; k < group.len(); k += 1 {
        let sfs = &suffix_first_sets[group[k]];
        for let mut ti = 0; ti < sfs.len(); ti += 1 {
            let tk = &sfs[ti];
            if emitted.contains(*tk) {
                continue;
            }
            if !shared_seen.contains(*tk) {
                shared_seen.insert(*tk);
                shared_tokens.push(*tk);
            }
        }
    }
    for let mut st = 0; st < shared_tokens.len(); st += 1 {
        let shared_tk = &shared_tokens[st];
        if first_branch {
            w.begin(&`if suffix_kind == ${*shared_tk}`);
            first_branch = false;
        } else {
            w.else_begin(&`else if suffix_kind == ${*shared_tk}`);
        }
        let second_accessor = if side.scan {
            w.line(&"let second_kind = if pos + 1 < tokens.len() { tokens[pos + 1] } else { TK_EOF };");
            "second_kind";
        } else {
            "p.peek_at(1)";
        };
        let mut sub_first = true;
        let mut last_k = -1;
        for let mut k = 0; k < group.len(); k += 1 {
            if suffix_first_sets[group[k]].contains(shared_tk) {
                last_k = k;
            }
        }
        for let mut k = 0; k < group.len(); k += 1 {
            if !suffix_first_sets[group[k]].contains(shared_tk) {
                continue;
            }
            let lr_idx = valid_lr_indices[group[k]];
            let prec = lr_precs[group[k]];
            let alt = &rule.alternatives[lr_idx];
            if k == last_k {
                if sub_first {
                    gen_lr_branch_call(w, side, lr_idx, prec, ctx.emit_follow());
                } else {
                    w.else_begin(&"else");
                    gen_lr_branch_call(w, side, lr_idx, prec, ctx.emit_follow());
                    w.end();
                }
            } else {
                let second = compute_lr_second_token(shared_tk, &alt.elements, ctx);
                let sub_cond = ctx.kind_check_str(&second, &second_accessor);
                if sub_first {
                    w.begin(&`if ${sub_cond}`);
                    sub_first = false;
                } else {
                    w.else_begin(&`else if ${sub_cond}`);
                }
                gen_lr_branch_call(w, side, lr_idx, prec, ctx.emit_follow());
            }
        }
        emitted.insert(*shared_tk);
    }
    if !first_branch {
        w.end();
    }
}

/// Generate scan code for a multi-alt non-LR rule body (or LR atom body).
/// Mirrors the parse-side `gen_multi_alt_body` peek-dispatch so that an alt
/// is only attempted when its FIRST set matches `alt_kind` — this turns
/// rule-level alt selection from linear first-match into O(1) token dispatch.
///
/// Strategy: for each alt compute FIRST, then emit a per-alt `if` guard on
/// `alt_kind`. On inner failure (break `try_i`), fall through to the next
/// alt (which is itself peek-dispatched). If no alt's FIRST matches or every
/// try block fails, return -1. Alts with empty FIRST (e.g. starting with
/// Wildcard or a rule whose FIRST is unenumerable) are attempted
/// unconditionally as fallbacks.
fn gen_scan_multi_alt(w: &mut CodeWriter, alts: &List<Alternative>, scan_alts: &List<ScanBody>, ctx: &mut GenContext) {
    let n = alts.len();
    let max_k = MAX_LOOKAHEAD_DEPTH;
    let mut all_pos_sets: List<List<List<String>>> = [];
    for let alt of alts {
        all_pos_sets.push(ctx.alt_position_first_sets(alt, max_k));
    }

    // Token-partitioned dispatch, mirroring parse-side `gen_multi_alt_body`
    // (see e.g. `parse_expr_atom` in the sqlite golden).
    //
    // For each depth-0 first token in the union of all alt guards, we
    // compute which alts claim it. Tokens claimed by the same set of
    // alts are folded into one partition. Each partition becomes one
    // dispatch branch:
    //   - 1 alt in partition → fast-path: commit on success, fail on miss.
    //   - 2+ alts in partition → mini-tournament over ONLY those alts
    //     (plus any unguarded alts), picking the longest match.
    //
    // This avoids the regression where sharing a single ambiguous pair
    // (e.g. `column_ref` and `function_call` both starting with an
    // IDENT-like token) forced every first-token dispatch through an
    // N-way tournament. Under partitioning:
    //   - `BIND_PARAMETER` → fast-path to the bind-param alt.
    //   - `LPAREN` → 3-way tournament among column_ref, function_call,
    //     paren_expr (the only alts whose depth-0 first-set contains
    //     LPAREN, via `any_name`'s `'(' any_name ')'` sub-alt).
    //   - `IDENT`/keyword → 2-way tournament among column_ref and
    //     function_call only.
    //
    // Unguarded alts (empty pos_sets — fully nullable or unpredictable)
    // ride along as tournament candidates in every partition and in the
    // fall-through default, matching the existing fallback semantics.

    let mut guarded_idx: List<i32> = [];
    let mut unguarded_idx: List<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        if all_pos_sets[i].len() >= 1 {
            guarded_idx.push(i);
        } else {
            unguarded_idx.push(i);
        }
    }

    let mut union_tokens: List<String> = [];
    for let i of &guarded_idx {
        let depth0 = &all_pos_sets[*i][0];
        for let t of depth0 {
            if !first_contains(&union_tokens, t) {
                union_tokens.push(*t);
            }
        }
    }

    let mut groups_alts: List<List<i32>> = [];
    let mut groups_tokens: List<List<String>> = [];

    for let t of &union_tokens {
        let mut claiming: List<i32> = [];
        for let i of &guarded_idx {
            if first_contains(&all_pos_sets[*i][0], t) {
                claiming.push(*i);
            }
        }
        let mut found: i32 = -1;
        for let mut g = 0; g < groups_alts.len(); g += 1 {
            if i32_arrays_equal(&groups_alts[g], &claiming) {
                found = g;
                break;
            }
        }
        if found >= 0 {
            groups_tokens[found].push(*t);
        } else {
            groups_alts.push(claiming);
            let mut seed: List<String> = [];
            seed.push(*t);
            groups_tokens.push(seed);
        }
    }

    // Sort each partition (and the unguarded alts) longest-first via
    // `sort_group_by_element_count`. `gen_scan_partition_body` runs a
    // real longest-match tournament per partition (keeping the greatest
    // successful end), so this order does not decide correctness — it only
    // breaks ties deterministically, preferring the most specific
    // (highest-priority, then most-elements) candidate when two alts scan
    // to the same end (e.g. `expr`'s `column_ref` IDENT vs
    // `function_call` IDENT '(' ... ')' ).
    for let mut g = 0; g < groups_alts.len(); g += 1 {
        sort_group_by_element_count(&mut groups_alts[g], alts);
    }
    sort_group_by_element_count(&mut unguarded_idx, alts);

    w.line(&"let start = pos;");
    w.line(&"let mut pos = pos;");
    w.line(&"let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };");

    w.begin(&"scan_alts:");

    let mut first_branch = true;
    for let mut g = 0; g < groups_alts.len(); g += 1 {
        let cond = ctx.kind_check_str(&groups_tokens[g], &"alt_kind");
        if first_branch {
            w.begin(&`if ${cond}`);
            first_branch = false;
        } else {
            w.else_begin(&`else if ${cond}`);
        }
        gen_scan_partition_body(w, &groups_alts[g], &unguarded_idx, scan_alts, ctx);
    }

    if unguarded_idx.len() > 0 {
        let empty_alts: List<i32> = [];
        if first_branch {
            gen_scan_partition_body(w, &empty_alts, &unguarded_idx, scan_alts, ctx);
        } else {
            w.else_begin(&"else");
            gen_scan_partition_body(w, &empty_alts, &unguarded_idx, scan_alts, ctx);
            w.end();
        }
    } else if !first_branch {
        w.else_begin(&"else");
        w.line(&"return -1;");
        w.end();
    } else {
        w.line(&"return -1;");
    }

    w.end();
    w.line(&"return pos;");
}

/// Emit the body of a single partition branch. The partition's alts were
/// sorted longest-first via `sort_group_by_element_count` in
/// `gen_scan_multi_alt`. On no match the branch `return -1`s so the caller
/// falls through to the next partition (or the rule-level fallback).
///
/// A single-alt partition commits on success (`break scan_alts`) — there is
/// no other candidate to compare against. A multi-alt partition runs a real
/// longest-match tournament: it tries every candidate from the same `start`
/// and commits to the greatest successful end.
///
/// First-success-wins (commit to the first alt that scans, trusting the
/// longest-first sort) is NOT used for the multi-alt case. It is unsound
/// when two alts share a prefix and tie on static length: `'mut'? IDENT`
/// vs `path '(' ... ')'` on input `N(n)` — the bare-IDENT alt scans
/// (consuming just `N`) but leaves `(n)` for the caller, while the correct
/// match is the longer `path '(' ... ')'`. The two are not
/// correctness-equivalent (the bug fixed in #1245), so the tournament
/// keeps the longest end rather than the first hit.
fn gen_scan_partition_body(
    w: &mut CodeWriter,
    guarded_alts: &List<i32>,
    unguarded_alts: &List<i32>,
    scan_alts: &List<ScanBody>,
    ctx: &mut GenContext,
) {
    let total = guarded_alts.len() + unguarded_alts.len();
    if total == 1 {
        let i = if guarded_alts.len() == 1 { guarded_alts[0] } else { unguarded_alts[0] };
        let label = `try_${i}`;
        w.line(&"pos = start;");
        w.begin(&`${label}:`);
        let body = &scan_alts[i];
        gen_scan_op_elements_in_block(w, &body.elements, 0, body.elements.len(), ctx, &label);
        w.line(&"break scan_alts;");
        w.end();
        w.line(&"return -1;");
        return;
    }
    // Longest-match tournament (see the function doc): try each from
    // `start`, keep the greatest successful end.
    w.line(&"let mut best: i32 = -1;");
    let mut all_idx: List<i32> = [];
    for let i of guarded_alts {
        all_idx.push(*i);
    }
    for let i of unguarded_alts {
        all_idx.push(*i);
    }
    for let i of &all_idx {
        let label = `try_${*i}`;
        w.line(&"pos = start;");
        w.begin(&`${label}:`);
        let body = &scan_alts[*i];
        gen_scan_op_elements_in_block(w, &body.elements, 0, body.elements.len(), ctx, &label);
        w.line(&"if pos > best { best = pos; }");
        w.end();
    }
    w.line(&"if best >= 0 { pos = best; break scan_alts; }");
    w.line(&"return -1;");
}

fn i32_arrays_equal(a: &List<i32>, b: &List<i32>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for let mut i = 0; i < a.len(); i += 1 {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

/// Op-driven alt-scan walker. Passes `i32::MAX` as the
/// `min_prec_override` for the LAST element when it is a self-
/// recursive `ScanRuleCall`, so the trailing self-ref short-
/// circuits the LR suffix loop inside the target rule's
/// `scan_<rule>` — the prefix-alt scenario where the OUTER LR
/// loop will consume the trailing tokens. Inner self-refs are
/// bounded by surrounding tokens (e.g. `K_WHEN expr K_THEN expr`
/// inside `case_expr`) and need a full scan.
///
/// The short-circuit only applies when `end == scan_elems.len()`,
/// i.e. the walk covers the whole alternative so `end - 1` is the
/// genuine alt tail. When `end` is a partial scannable prefix
/// (`end < scan_elems.len()`), the element at `end - 1` is followed
/// by more (unscannable) elements, so it is an inner self-ref bounded
/// by that continuation and must scan its full LR climb — short-
/// circuiting it would under-scan the tournament prefix.
pub fn gen_alt_scan_op_elements(
    w: &mut CodeWriter,
    scan_elems: &List<ScanElement>,
    end: i32,
    rule_name: &String,
    ctx: &mut GenContext,
) {
    let covers_whole_alt = end == scan_elems.len();
    for let mut i = 0; i < end; i += 1 {
        let se = &scan_elems[i];
        let is_last_self_ref = covers_whole_alt && i == end - 1 && is_self_ref_scan_call(se, rule_name);
        let min_prec_override = if is_last_self_ref { i32::MAX } else { 0 };
        gen_scan_op_element(w, se, ctx, &"return -1;", min_prec_override);
    }
}

/// True iff `se` is a top-level `ScanRuleCall` targeting `rule_name`.
/// Scan-side counterpart of `is_self_ref_element`. Used by the alt-scan
/// walker to bump `ctx.scan_ruleref_min_prec` for the trailing
/// self-ref. `target_snake` is the lowered call site's snake-cased
/// rule name; `rule_name` is the surrounding rule's surface name
/// threaded by the caller.
fn is_self_ref_scan_call(se: &ScanElement, rule_name: &String) -> bool {
    if let RuleCall(rc) = se {
        return rc.target_snake == to_snake_case(rule_name);
    }
    return false;
}

/// Scan-side twin of `gen_lookahead_condition`. Uses
/// `tokens[pos + d]` (guarded by `pos + d < tokens.len()`) instead
/// of `p.peek_at(d)`. Multi-token sets route through
/// `ctx.kind_check_str` so they collapse to a `_kind_set_<id>(...)`
/// helper call; otherwise a 120-keyword set inlined at every dispatch
/// site bloats the generated wasm by hundreds of KB.
fn gen_scan_lookahead_condition(ctx: &mut GenContext, sig: &List<List<String>>) -> String {
    return join_lookahead_condition(ctx, sig, sig.len(), LookaheadAccess::Scan);
}

/// Op-driven scan element emitter — dispatches on `ScanElement`
/// variant. Lower has already resolved kind constants, variant ids,
/// min-prec, repeat strategy / first sets, and group dispatch shape;
/// emit reads them verbatim.
fn gen_scan_op_element(
    w: &mut CodeWriter,
    se: &ScanElement,
    ctx: &mut GenContext,
    fail_stmt: &String,
    min_prec_override: i32 = 0,
) {
    match se {
        Token(t) => {
            w.line(&`if pos >= tokens.len() || tokens[pos] != ${t.kind} \{ ${*fail_stmt} \}`);
            w.line(&"pos += 1;");
        },
        RuleCall(rc) => {
            // Single scan callee + runtime FOLLOW arg.
            let fn_name = `scan_${rc.target_snake}`;
            let follow_arg_str = follow_arg_sep(ctx.emit_follow(), &rc.follow_arg);
            // `min_prec_arg`, when set, is the baked precedence for a
            // self-recursive call inside an LR suffix (stamped by
            // `stamp_lr_self_ref_min_prec`). Otherwise fall back to
            // `min_prec_override`: `gen_alt_scan_op_elements` passes
            // `i32::MAX` for the trailing self-ref to short-circuit
            // any LR climb in the target rule; every other call site
            // leaves it at the default `0`.
            let min_prec = if let Some(p) = rc.min_prec_arg {
                p;
            } else {
                min_prec_override;
            };
            // ATN-class scan: bracket every rule-call scan with the scan caller
            // stack so the callee's LR loop yields the caller's mandatory
            // continuation (e.g. `between`'s `'and'`), exactly as the parse side's
            // rule-entry wrapper does. Pop before the fail check so an early return
            // never leaks the frame.
            let push_ret = ctx.scan_atn_push_return(rc.atn_call_site);
            if push_ret >= 0 {
                w.line(&`SCAN_STACK.push(${push_ret});`);
                w.line(&`pos = ${fn_name}(tokens, pos${follow_arg_str}, ${min_prec});`);
                w.line(&"SCAN_STACK.pop();");
            } else {
                w.line(&`pos = ${fn_name}(tokens, pos${follow_arg_str}, ${min_prec});`);
            }
            w.line(&`if pos < 0 \{ ${*fail_stmt} \}`);
        },
        Wildcard => {
            w.line(&`if pos >= tokens.len() || tokens[pos] == TK_EOF \{ ${*fail_stmt} \}`);
            w.line(&"pos += 1;");
        },
        Excluded(e) => {
            let mut check_parts: List<String> = [];
            for let k of &e.kinds {
                check_parts.push(`tokens[pos] == ${*k}`);
            }
            let mut check = String::with_capacity(64);
            for let mut i = 0; i < check_parts.len(); i += 1 {
                if i > 0 {
                    check.push_str(&" || ");
                }
                check.push_str(&check_parts[i]);
            }
            w.line(&`if pos >= tokens.len() || tokens[pos] == TK_EOF || ${check} \{ ${*fail_stmt} \}`);
            w.line(&"pos += 1;");
        },
        Repeat(re) => gen_scan_op_repeat(w, re, ctx, fail_stmt),
        Group(ge) => gen_scan_op_group(w, ge, ctx, fail_stmt, ge.lenient),
        OptionalLookahead(ole) => gen_scan_op_optional_lookahead(w, ole, ctx),
    }
}

/// Op-driven scan emitter where failure sets `pos = -1` rather than
/// running `fail_stmt`. Used inside Optional/Repeat loops where a
/// failed iteration means "skip", not abort.
fn gen_scan_op_element_assign(w: &mut CodeWriter, se: &ScanElement, ctx: &mut GenContext) {
    match se {
        Token(t) => {
            w.line(&`if pos >= tokens.len() || tokens[pos] != ${t.kind} \{ pos = -1; \} else \{ pos += 1; \}`);
        },
        RuleCall(rc) => {
            let fn_name = `scan_${rc.target_snake}`;
            let follow_arg_str = follow_arg_sep(ctx.emit_follow(), &rc.follow_arg);
            // `_assign` only fires inside Repeat bodies — never reachable
            // from alt-scan's trailing-self-ref site, so `min_prec` here
            // is always the rule's default `0` (or whatever
            // `min_prec_arg` baked at lower time, e.g. LR self-refs).
            let min_prec = if let Some(p) = rc.min_prec_arg {
                p;
            } else {
                0;
            };
            w.line(&`pos = ${fn_name}(tokens, pos${follow_arg_str}, ${min_prec});`);
        },
        Wildcard => {
            w.line(&"if pos >= tokens.len() || tokens[pos] == TK_EOF { pos = -1; } else { pos += 1; }");
        },
        Excluded(e) => {
            let mut check_parts: List<String> = [];
            for let k of &e.kinds {
                check_parts.push(`tokens[pos] == ${*k}`);
            }
            let mut check = String::with_capacity(64);
            for let mut i = 0; i < check_parts.len(); i += 1 {
                if i > 0 {
                    check.push_str(&" || ");
                }
                check.push_str(&check_parts[i]);
            }
            w.line(&`if pos >= tokens.len() || tokens[pos] == TK_EOF || ${check} \{ pos = -1; \} else \{ pos += 1; \}`);
        },
        Group(ge) => {
            // Group inside a repeat body — emit strict scan so a
            // 0-advance iteration cannot infinite-loop.
            gen_scan_op_group(w, ge, ctx, &"pos = -1;", false);
        },
        Repeat(_) | OptionalLookahead(_) => {
            // Nested Repeat / OptionalLookahead within a Repeat's loop
            // body: emit through fail_stmt = "pos = -1;" so the outer
            // loop sees failure as "stop iterating".
            gen_scan_op_element(w, se, ctx, &"pos = -1;");
        },
    }
}

/// Scan a non-greedy wildcard repeat (`.*?` / `.+?`): advance past tokens
/// until the exit set (the repeat's follow) or EOF. Mirrors the parse-side
/// `compute_non_greedy_condition` so the longest-match scan tournament and
/// the parse stay in lockstep. With an empty exit set, skips to EOF.
fn gen_scan_non_greedy_skip(w: &mut CodeWriter, exit_first: &List<String>, ctx: &mut GenContext) {
    if exit_first.is_empty() {
        w.line(&"while pos < tokens.len() && tokens[pos] != TK_EOF { pos += 1; }");
        return;
    }
    let exit_check = ctx.kind_check_str(exit_first, &"tokens[pos]");
    w.line(&`while pos < tokens.len() && tokens[pos] != TK_EOF && !(${exit_check}) \{ pos += 1; \}`);
}

/// Scan mirror of `gen_optional_probe_entry`: try the body, then the
/// continuation from where it ended, then the caller's FOLLOW. The body is
/// kept only when all three hold, so the scan advances by exactly what the
/// parse will consume.
fn gen_scan_optional_probe(
    w: &mut CodeWriter,
    re: &ScanRepeatElement,
    ctx: &mut GenContext,
    caller_follow_gate: &String,
) {
    let check = ctx.kind_check_str(&re.inner_first, &"tokens[pos]");
    let guard = if caller_follow_gate.is_empty() {
        `pos < tokens.len() && ${check}`;
    } else {
        `pos < tokens.len() && ${check} && !(${*caller_follow_gate})`;
    };
    w.begin(&`if ${guard}`);
    w.line(&"let sp = pos;");
    gen_scan_op_element_assign(w, &re.body, ctx);
    w.begin(&"if pos < 0");
    w.line(&"pos = sp;");
    w.else_begin(&"else");
    w.line(&"let bp = pos;");
    w.line(&"let mut opt_ok: bool = false;");
    w.begin(&"opt_probe:");
    let fail = "break opt_probe;";
    for let se of &re.continuation_scan {
        gen_scan_op_element(w, se, ctx, &fail);
    }
    if ctx.emit_follow() {
        w.line(&"if follow.is_empty() || follow_yields(tokens, pos, follow, TK_EOF) { opt_ok = true; }");
    } else {
        w.line(&"opt_ok = true;");
    }
    w.end();
    w.line(&"pos = if opt_ok { bp } else { sp };");
    w.end();
    w.end();
}

fn gen_scan_op_repeat(w: &mut CodeWriter, re: &ScanRepeatElement, ctx: &mut GenContext, fail_stmt: &String) {
    let loop_first = re.inner_first;

    // Caller-FOLLOW yield gate: when the caller's continuation matches at
    // this scan position, the scan must stop (mirroring the parse-side
    // `gen_op_repeat_optional_*` / `gen_op_repeat_star_plus_storable`),
    // otherwise the scan tournament that picks the calling rule's alt
    // would over-count this Repeat and reject the alt that actually
    // matches. Reads the runtime FOLLOW continuation (`follow` param) via
    // `follow_yields`, exactly mirroring the parse side; inert when
    // `follow` is empty.
    let caller_follow_gate = if re.gate_caller_follow { "follow_yields(tokens, pos, follow, TK_EOF)" } else { "" };

    if let Optional = re.kind {
        // OptionalLookahead doesn't reach this path (it's a
        // ScanElement::OptionalLookahead, not a ScanElement::Repeat).
        if loop_first.is_empty() {
            return;
        }
        let body_is_rulecall = re.body matches { RuleCall(_) };
        if body_is_rulecall
            && probe_decides(&loop_first, &re.caller_follow_first, &re.continuation_scan, re.continuation_scannable, ctx)
        {
            gen_scan_optional_probe(w, re, ctx, &caller_follow_gate);
            return;
        }
        // Mirror the pre-Phase-2-F `gen_scan_repeat_optional_with_follow`
        // contract: when the Optional's body is a RuleCall, subtract
        // the caller-side follow first (the tokens that may appear
        // right after this Optional in the surrounding alt) so we
        // don't fire the Optional on a token that belongs to the
        // caller's next position. The `caller_follow_first` subtraction
        // matches the surface emitter's `combined_follow = follow_first`.
        let effective_first = if body_is_rulecall && !re.caller_follow_first.is_empty() {
            subtract_sets(&loop_first, &re.caller_follow_first);
        } else {
            loop_first;
        };
        if effective_first.is_empty() {
            return;
        }
        let check = ctx.kind_check_str(&effective_first, &"tokens[pos]");
        // Caller-FOLLOW gate wins: `if pos < len && peek matches first AND
        // NOT caller_follow_gate { try iter }`. When `caller_follow_gate` is
        // empty (no `follow`), the guard collapses to the regular shape.
        let guard = if caller_follow_gate.is_empty() {
            `pos < tokens.len() && ${check}`;
        } else {
            `pos < tokens.len() && ${check} && !(${caller_follow_gate})`;
        };
        w.begin(&`if ${guard}`);
        w.line(&"let sp = pos;");
        gen_scan_op_element_assign(w, &re.body, ctx);
        w.line(&"if pos < 0 { pos = sp; }");
        w.end();
        return;
    }
    if let Star = re.kind {
        if loop_first.is_empty() {
            // Non-greedy wildcard `.*?`: the body matches any token, so a
            // first-set guard can never fire. Skip tokens until the exit
            // set (the repeat's follow) or EOF, mirroring the parse-side
            // `compute_non_greedy_condition`.
            if re.non_greedy {
                gen_scan_non_greedy_skip(w, &re.caller_follow_first, ctx);
            }
            return;
        }
        let check = ctx.kind_check_str(&loop_first, &"tokens[pos]");
        let guard = if caller_follow_gate.is_empty() {
            `pos < tokens.len() && ${check}`;
        } else {
            `pos < tokens.len() && ${check} && !(${caller_follow_gate})`;
        };
        w.begin(&`while ${guard}`);
        w.line(&"let sp = pos;");
        gen_scan_op_element_assign(w, &re.body, ctx);
        w.line(&"if pos < 0 { pos = sp; break; }");
        w.line(&"if pos == sp { break; }");
        w.end();
        return;
    }
    if let Plus = re.kind {
        // First iteration is mandatory: failure goes through fail_stmt.
        gen_scan_op_element(w, &re.body, ctx, fail_stmt);
        if loop_first.is_empty() {
            // Non-greedy wildcard `.+?`: mandatory iter ran above; skip the
            // rest until the exit set or EOF (see the Star arm).
            if re.non_greedy {
                gen_scan_non_greedy_skip(w, &re.caller_follow_first, ctx);
            }
            return;
        }
        let check = ctx.kind_check_str(&loop_first, &"tokens[pos]");
        // Plus's subsequent iters get the K-prefix gate; the mandatory
        // first iter ran above.
        let guard = if caller_follow_gate.is_empty() {
            `pos < tokens.len() && ${check}`;
        } else {
            `pos < tokens.len() && ${check} && !(${caller_follow_gate})`;
        };
        w.begin(&`while ${guard}`);
        w.line(&"let sp = pos;");
        gen_scan_op_element_assign(w, &re.body, ctx);
        w.line(&"if pos < 0 { pos = sp; break; }");
        w.line(&"if pos == sp { break; }");
        w.end();
        return;
    }
}

/// Op-driven scan emitter for `ScanElement::Group`. Mirrors surface
/// `gen_scan_group` semantics: ambiguity detection (alts sharing a
/// first token enter longest-match commit), lenient gate, and the
/// `sg_<gc>_done` / `sg_<gc>` block structure.
fn is_wildcard_alt(indices: &List<i32>, alt_index: i32) -> bool {
    for let idx of indices {
        if *idx == alt_index {
            return true;
        }
    }
    return false;
}

fn gen_scan_op_group(w: &mut CodeWriter, ge: &ScanGroupElement, ctx: &mut GenContext, fail_stmt: &String, lenient: bool) {
    if ge.alts.len() == 1 {
        // Single alt: outer `done` wraps inner `body`.
        //   sg_N_done: { sg_N: { ...; break sg_N_done; } fail_stmt; }
        // Element failure → break sg_N, falls to fail_stmt.
        // Success → break sg_N_done, skips fail_stmt.
        let gc = ctx.next_scan_group();
        let body = `sg_${gc}`;
        let done = `sg_${gc}_done`;
        let save_var = `sg_${gc}_save`;
        if lenient {
            w.line(&`let ${save_var} = pos;`);
        }
        w.begin(&`${done}:`);
        w.begin(&`${body}:`);
        gen_scan_op_elements_in_block(w, &ge.alts[0].elements, 0, ge.alts[0].elements.len(), ctx, &body);
        w.line(&`break ${done};`);
        w.end();
        if lenient {
            w.line(&`pos = ${save_var};`);
        } else {
            w.line(fail_stmt);
        }
        w.end();
        return;
    }
    // Multi-alternative group: try each alternative, fall through to fail.
    let gc = ctx.next_scan_group();
    let outer = `sg_${gc}`;
    let gp_var = `gp_${gc}`;
    let best_var = `sg_${gc}_best`;
    w.line(&`let ${gp_var} = pos;`);

    let n = ge.alts.len();
    let first_sets = &ge.alt_first_sets;

    let mut is_ambiguous: List<bool> = [];
    for let mut i = 0; i < n; i += 1 {
        is_ambiguous.push(false);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = 0; j < n; j += 1 {
            if i == j {
                continue;
            }
            if sets_overlap(&first_sets[i], &first_sets[j]) {
                is_ambiguous[i] = true;
                is_ambiguous[j] = true;
            }
        }
    }
    let mut any_ambiguous = false;
    for let mut i = 0; i < n; i += 1 {
        if is_ambiguous[i] {
            any_ambiguous = true;
        }
    }

    // First-set gate, emitted unless a wildcard alt (which matches any token)
    // suppresses it. On a gate miss a lenient group matches zero and falls
    // through; a strict group fails, since a mandatory group must be started.
    let has_wildcard = !ge.wildcard_alt_indices.is_empty();
    let mut union_first: List<String> = [];
    if !has_wildcard {
        for let fs of first_sets {
            dedup_append_arr(&mut union_first, fs);
        }
    }
    let gate_emitted = !has_wildcard && union_first.len() > 0;
    if gate_emitted {
        let sgk_var = `sgk_${gc}`;
        w.line(&`let ${sgk_var} = if pos < tokens.len() \{ tokens[pos] \} else \{ TK_EOF \};`);
        let gate = ctx.kind_check_str(&union_first, &sgk_var);
        w.begin(&`if ${gate}`);
    }

    if any_ambiguous {
        w.line(&`let mut ${best_var} = -1;`);
    }

    // Iteration order: visit concrete alts before wildcard alts. A
    // wildcard alt matches any non-EOF token (its scan body is just
    // `pos += 1`), so trying it before a more specific concrete alt
    // would always commit to the wildcard and shadow the concrete
    // alt — independent of source order. Pushing wildcard alts to
    // the end mirrors `gen_general_group_dispatch`'s
    // `sort_group_by_mandatory_count_desc` ordering on the parse
    // side, so scan and parse agree on the winner.
    let mut iter_order: List<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        if !is_wildcard_alt(&ge.wildcard_alt_indices, i) {
            iter_order.push(i);
        }
    }
    for let mut i = 0; i < n; i += 1 {
        if is_wildcard_alt(&ge.wildcard_alt_indices, i) {
            iter_order.push(i);
        }
    }

    w.begin(&`${outer}:`);
    for let i of iter_order {
        let inner = `sg_${gc}_${i}`;
        w.line(&`pos = ${gp_var};`);
        w.begin(&`${inner}:`);
        gen_scan_op_elements_in_block(w, &ge.alts[i].elements, 0, ge.alts[i].elements.len(), ctx, &inner);
        if is_ambiguous[i] {
            w.line(&`if pos > ${best_var} \{ ${best_var} = pos; \}`);
        } else {
            w.line(&`break ${outer};`);
        }
        w.end();
    }
    if any_ambiguous {
        w.line(&`if ${best_var} >= 0 \{ pos = ${best_var}; break ${outer}; \}`);
    }
    if lenient {
        w.line(&`pos = ${gp_var};`);
    } else {
        w.line(fail_stmt);
    }
    w.end();  // close outer labeled block

    if gate_emitted {
        if lenient {
            w.end();
        } else {
            w.else_begin(&"else");
            w.line(fail_stmt);
            w.end();
        }
    }
}

/// Op-driven scan emitter for `ScanElement::OptionalLookahead` —
/// emits per-shape if/elseif chain using baked `sigs` + `bodies`.
fn gen_scan_op_optional_lookahead(w: &mut CodeWriter, ole: &ScanOptionalLookaheadElement, ctx: &mut GenContext) {
    let mut is_first = true;
    for let mut si = 0; si < ole.sigs.len(); si += 1 {
        let sig = &ole.sigs[si];
        if sig.is_empty() {
            continue;
        }
        let cond = gen_scan_lookahead_condition(ctx, sig);
        if is_first {
            w.begin(&`if ${cond}`);
            is_first = false;
        } else {
            w.else_begin(&`else if ${cond}`);
        }
        // A failed optional means "skip", so the position rewinds: leaving a
        // callee's `-1` in `pos` mis-scans the elements after it and traps
        // their `pos < tokens.len()` guard.
        let gc = ctx.next_scan_group();
        let body = `sol_${gc}`;
        let done = `sol_${gc}_done`;
        let save_var = `sol_${gc}_save`;
        let fail = `break ${body};`;
        w.line(&`let ${save_var} = pos;`);
        w.begin(&`${done}:`);
        w.begin(&`${body}:`);
        for let elem_se of &ole.bodies[si].elements {
            gen_scan_op_element(w, elem_se, ctx, &fail);
        }
        w.line(&`break ${done};`);
        w.end();
        w.line(&`pos = ${save_var};`);
        w.end();
    }
    if !is_first {
        w.end();
    }
}

/// Op-driven scan element walker — used by top-level scan entry
/// points (Simple rule scan_body, LR atom scan_alts, LR suffix
/// scan_suffix) once the corresponding `ScanBody` is in hand.
/// Failures route through `fail_stmt`.
fn gen_scan_op_elements(
    w: &mut CodeWriter,
    scan_elems: &List<ScanElement>,
    start: i32,
    end: i32,
    ctx: &mut GenContext,
    fail_stmt: &String,
) {
    for let mut i = start; i < end; i += 1 {
        gen_scan_op_element(w, &scan_elems[i], ctx, fail_stmt);
    }
}

/// `gen_scan_op_elements` variant that routes failures through a
/// labeled `break ${label};` so the sequence can be nested in a
/// labeled block.
fn gen_scan_op_elements_in_block(
    w: &mut CodeWriter,
    scan_elems: &List<ScanElement>,
    start: i32,
    end: i32,
    ctx: &mut GenContext,
    label: &String,
) {
    let fail = `break ${*label};`;
    for let mut i = start; i < end; i += 1 {
        gen_scan_op_element(w, &scan_elems[i], ctx, &fail);
    }
}

/// A rule's non-LR alt indices, their FIRST sets, and the overlap groups over
/// them — the shared front matter of both the AtEndConflict detection
/// (`rule_has_at_end_conflict`) and the multi-alt emit (`gen_parse_fn`), so the
/// two cannot drift on how a rule's alternatives are grouped.
fn rule_overlap_groups(
    rule: &ParserRule,
    lowered_rule: &Rule,
    ctx: &mut GenContext,
) -> [List<i32>, List<List<String>>, List<List<i32>>] {
    let mut non_lr_indices: List<i32> = [];
    match lowered_rule {
        Simple(_) => {
            non_lr_indices.push(0);
        },
        MultiAlt(m) => {
            for let alt of &m.alts {
                non_lr_indices.push(alt.alt_index);
            }
        },
        LeftRecursive(l) => {
            for let alt of &l.atom.alts {
                non_lr_indices.push(alt.alt_index);
            }
        },
    }
    let mut first_sets: List<List<String>> = [];
    for let idx of non_lr_indices {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.first_of_alt(&rule.alternatives[idx], &mut visiting));
    }
    let groups = compute_overlap_groups(&first_sets);
    return [non_lr_indices, first_sets, groups];
}

pub fn grammar_has_at_end_conflict(grammar: &Grammar, lowered: &LoweredGrammar, ctx: &mut GenContext) -> bool {
    for let mut r = 0; r < grammar.parser_rules.len(); r += 1 {
        if rule_has_at_end_conflict(&grammar.parser_rules[r], &lowered.parser_rules[r], ctx) {
            return true;
        }
    }
    return false;
}

fn rule_has_at_end_conflict(rule: &ParserRule, lowered_rule: &Rule, ctx: &mut GenContext) -> bool {
    if let MultiAlt(_) = lowered_rule {
    } else {
        return false;
    }
    let g = rule_overlap_groups(rule, lowered_rule, ctx);
    let non_lr_indices = g.0;
    let first_sets = g.1;
    let groups = g.2;
    for let group of &groups {
        if group.len() > 1 {
            let tree = build_group_prediction_tree(&rule.alternatives, group, &first_sets, &non_lr_indices, ctx);
            let mut conflicts: List<List<String>> = [];
            prediction_at_end_conflicts(&tree, &mut conflicts);
            for let tokens of &conflicts {
                if ctx.at_end_conflict_routes(&rule.name, tokens) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn gen_parse_fn(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, ctx: &mut GenContext) {
    ctx.set_current_rule_index(ctx.rule_index_of(&rule.name));
    // Phase 4 — dispatch on the GIR `Rule` variant. Each shape gets
    // its own focused emit entry; the existing internal helpers
    // carry the body emission but no longer need to re-classify
    // the rule from surface IR.
    // The canonical name every other rule (and the public input entry)
    // calls. We emit the rule body under `<canonical>__inner` and wrap it
    // with a thin entry that records the rule on the rule stack when its
    // body fails — see `gen_rule_entry_wrapper`.
    let canonical = `_parse_${rule.snake_name}`;
    let inner = `${canonical}__inner`;
    match *lowered_rule {
        Simple(_) => gen_parse_fn_simple_named(w, rule, lowered_rule, ctx, &inner),
        MultiAlt(_) | LeftRecursive(_) => gen_parse_fn_named(
            w,
            rule,
            lowered_rule,
            ctx,
            &inner,
        ),
    }
    gen_rule_entry_wrapper(
        w,
        &canonical,
        &inner,
        rule,
        rule_takes_min_prec(lowered_rule),
        ctx.emit_follow(),
        ctx.is_trace(),
        ctx.needs_atn(),
        &rule_result_type_for(rule, ctx),
        ctx,
    );
}

/// Return type of a rule's inner / alt parse function: `()` under the
/// emitter (the tree accrues in the `TreeBuilder`).
fn rule_result_type() -> String {
    return String::from("()");
}

/// Whether a rule's result type is a `<Rule>Vals` struct rather than the
/// value-less `()` — i.e. the rule exposes a value channel.
fn result_type_carries_vals(result_type: &String) -> bool {
    return *result_type != rule_result_type();
}

/// `RK_<UPPER>` node-kind constant name for a rule (matches `gen_node_kinds`).
fn rule_kind_const(name: &String) -> String {
    let mut out = String::with_capacity(name.len() + 3);
    out.push_str(&"RK_");
    for let c of name.chars() {
        out.push(c.to_ascii_uppercase());
    }
    return out;
}

/// Emit the trace helpers (the `trace` option is on). The emit sites only
/// emit simple calls — `trace_enter`/`trace_ok`/`trace_fail` from the rule
/// wrappers, `trace_pick`/`trace_scan_alt`/`trace_try` from the multi-alt
/// bodies; these helpers do the indentation, lookahead-token rendering, and
/// `log_stderr` formatting so the emitter avoids nesting a generated template
/// inside its own template string.
fn gen_trace_helpers(w: &mut CodeWriter) {
    w.line(&"fn trace_pad(depth: i32) -> String {");
    w.indent();
    w.line(&"let mut s = String::with_capacity(depth * 2);");
    w.line(&"for let mut i = 0; i < depth; i += 1 { s.push_str(&\"  \"); }");
    w.line(&"return s;");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_tok(p: &Parser) -> String {");
    w.indent();
    w.line(&"if p.pos >= p.tokens.len() { return String::from(\"<eof>\"); }");
    w.line(&"if p.tokens.is_empty_text(p.pos) { return String::from(\"<eof>\"); }");
    w.line(&"return `'${p.tokens.token_text(p.pos)}'`;");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_enter(p: &Parser, rule: &String) {");
    w.indent();
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}enter ${*rule} @${p.pos} ${trace_tok(p)}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_ok(p: &Parser, rule: &String) {");
    w.indent();
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}ok ${*rule}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_fail(p: &Parser, rule: &String, msg: &String) {");
    w.indent();
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}FAIL ${*rule}: ${*msg}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    // Decision-point helpers: which alternative a multi-alt / tournament
    // rule committed to, the per-alt scan lengths a longest-match
    // tournament weighed, and the outcome of each speculative try.
    w.line(&"fn trace_pick(p: &Parser, rule: &String, alt: i32) {");
    w.indent();
    w.line(&"if alt < 0 { log_stderr(`${trace_pad(p.trace_depth)}  pick ${*rule}: no alt matched`); }");
    w.line(&"else { log_stderr(`${trace_pad(p.trace_depth)}  pick ${*rule} alt#${alt}`); }");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_scan_alt(p: &Parser, rule: &String, alt: i32, end: i32) {");
    w.indent();
    w.line(&"let r = if end < 0 { String::from(\"fail\") } else { `-> @${end}` };");
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}  scan ${*rule} alt#${alt}: ${r}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
    w.line(&"fn trace_try(p: &Parser, rule: &String, alt: i32, ok: bool) {");
    w.indent();
    w.line(&"let r = if ok { String::from(\"ok\") } else { String::from(\"rewind\") };");
    w.line(&"log_stderr(`${trace_pad(p.trace_depth)}  try ${*rule} alt#${alt}: ${r}`);");
    w.dedent();
    w.line(&"}");
    w.blank();
}

/// Emit the ATN return-state bookkeeping a rule entry performs around its
/// inner call: consume the pending return state the call site stamped, reset
/// it, and push it onto the simulator's caller stack for full-context
/// prediction (popped via `p.atn_stack.pop()` on every exit). Only emitted for
/// grammars that need the ATN.
fn emit_atn_enter(w: &mut CodeWriter) {
    w.line(&"let _atn_ret = p.atn_ret_pending;");
    w.line(&"p.atn_ret_pending = -1;");
    w.line(&"p.atn_stack.push(_atn_ret);");
}

/// Emit a thin entry wrapper named `outer_name` that delegates to
/// `inner_name` and, on failure, records `rule_display` onto the
/// propagating `ParseError`'s rule stack. Every cross-rule call site and
/// the public input entry reference the canonical `_parse_<rule>` name, so
/// making that name the wrapper threads the whole call chain through it
/// without touching any call site.
///
/// The success path is a single not-taken branch, so the rule context is
/// paid for only when a parse actually fails. `rule_stack` is stored
/// innermost-first: the failing token's rule pushes first as the `Err`
/// unwinds, the start rule last.
///
/// `takes_min_prec` mirrors the wrapped function's signature. Left-recursive
/// rule entries carry a defaulted `min_prec` (callers pass it only at
/// precedence-aware self-ref sites), so the wrapper reproduces that default.
fn gen_rule_entry_wrapper(
    w: &mut CodeWriter,
    outer_name: &String,
    inner_name: &String,
    rule: &ParserRule,
    takes_min_prec: bool,
    emit_follow: bool,
    trace: bool,
    needs_atn: bool,
    result_type: &String,
    ctx: &GenContext,
) {
    let rule_display = &rule.name;
    let returns_vals = result_type_carries_vals(result_type);
    let mut f = FnSpec::new(outer_name);
    f.add_param(&"p", &"&mut Parser");
    // `follow` precedes `min_prec` so a non-precedence call site can pass
    // just `_parse_X(p, follow)` and let `min_prec` default — uniform for
    // LR and non-LR targets. Omitted entirely when the grammar has no
    // caller-FOLLOW gate (`emit_follow`).
    if emit_follow {
        add_follow_param(&mut f);
    }
    if takes_min_prec {
        f.add_param_spec(ParamSpec {
            name: "min_prec",
            type_str: "i32",
            default_value: Option::Some("0"),
        });
    }
    // Threaded rule arguments come last (defaulted), so the entry and plain
    // callers omit them. Only single-alt rules thread args, so `takes_min_prec`
    // is always false here for an arg-bearing rule.
    add_arg_params(&mut f, rule, ctx);
    f.set_return_type(result_type);
    f.emit_begin(w);
    let lit = str_lit(*rule_display);
    // Already unwinding from a deeper failure: no-op so the descent collapses
    // to the entry without opening spurious nodes (the infallible analogue of a
    // `?` that would have skipped this call entirely).
    if returns_vals {
        w.line(&`if p.recovering \{ return ${*result_type} \{\}; \}`);
    } else {
        w.line(&"if p.recovering { return; }");
    }
    // Forward `follow`/`min_prec` so the inner body's tail-greedy gate sees
    // the caller's continuation.
    let fsep = if emit_follow { ", follow" } else { "" };
    let argfwd = wrapper_arg_forward(rule, ctx);
    let call = if takes_min_prec {
        `${*inner_name}(p${fsep}, min_prec${argfwd})`;
    } else {
        `${*inner_name}(p${fsep}${argfwd})`;
    };
    // open this rule's `CstNode` before the body and close it after, so the
    // body's appended terminals / subtrees become its children. The body may
    // set `p.recovering`; `finish_node` still runs, folding the open node closed
    // as the descent unwinds.
    let rk = rule_kind_const(rule_display);
    if trace {
        w.line(&`trace_enter(p, &${lit});`);
        w.line(&"p.trace_depth += 1;");
    }
    if needs_atn {
        emit_atn_enter(w);
    }
    // LR rules manage their own nodes (precedence climbing wraps each
    // level via `start_node_at`), so the wrapper must NOT open an outer
    // node — it would nest one extra same-rule level. Non-LR rules get the
    // single `start_node` / `finish_node` pair here.
    if !takes_min_prec {
        w.line(&`let _start = p.peek_start();`);
        w.line(&`p.b.start_node(${rk}, _start);`);
    }
    if returns_vals {
        w.line(&`let __vals = ${call};`);
    } else {
        w.line(&`${call};`);
    }
    if !takes_min_prec {
        w.line(&"p.b.finish_node(p.last_end());");
    }
    if needs_atn {
        w.line(&"p.atn_stack.pop();");
    }
    if trace {
        w.line(&"p.trace_depth -= 1;");
    }
    w.begin(&"if p.recovering");
    w.line(&`p.push_rule_stack(${lit});`);
    if trace {
        w.line(&`trace_fail(p, &${lit}, &p.pending_message());`);
        w.else_begin(&"else");
        w.line(&`trace_ok(p, &${lit});`);
    }
    w.end();
    if returns_vals {
        w.line(&"return __vals;");
    }
    w.end();
    w.blank();
}

/// Body emitter for a single-alt rule, parameterised by function name.
/// No internal classification — the caller already committed to the
/// Simple shape.
///
/// `lowered_rule` is the corresponding `Rule::Simple` (or a
/// `Rule::MultiAlt` / `Rule::LeftRecursive` whose alt-len-1 shortcut in
/// `gen_parse_fn_named` lands here). `rule_alt_body` resolves the
/// single AltBody whose `fields` drives the struct-literal field
/// assignments emitted after the alt body.
fn gen_parse_fn_simple_named(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lowered_rule: &Rule,
    ctx: &mut GenContext,
    fn_name: &String,
) {
    let type_name = rule.type_name;
    gen_visibility_comment(w, &rule.visibility);

    let mut f = FnSpec::new(fn_name);
    f.add_param(&"p", &"&mut Parser");
    if ctx.emit_follow() {
        add_follow_param(&mut f);
    }
    add_arg_params(&mut f, rule, ctx);
    f.set_return_type(&rule_result_type_for(rule, ctx));
    f.emit_begin(w);
    w.line(&"let start = p.peek_start();");
    if rule_emits_vals(ctx, rule) {
        w.line(&`let mut vals = ${vals_struct_name(rule)} \{\};`);
    }
    emit_arg_stores(w, rule, ctx);
    emit_span_capture(w, rule, ctx);
    if ctx.emit_actions() {
        if let Some(a) = &rule.init_action {
            gen_action_body(w, a, ctx);
        }
    }
    let body = rule_alt_body(lowered_rule, 0).unwrap();
    gen_alt_body(
        w,
        &type_name,
        null,
        null,
        &rule.alternatives[0],
        body,
        0,
        rule_alts_labeled(&rule.alternatives),
        &rule.after_action,
        ctx,
    );
    w.end();
    w.blank();
}

/// A rule's inner / wrapper result type: `<Rule>Vals` when the rule exposes a
/// value channel (action execution on), else `()`.
fn rule_result_type_for(rule: &ParserRule, ctx: &GenContext) -> String {
    if rule_emits_vals(ctx, rule) {
        return vals_struct_name(rule);
    }
    return rule_result_type();
}

/// Whether `rule` gets a value channel emitted: action execution is on and the
/// rule exposes one. The single source of truth for the `vals` struct, local,
/// return type, and `$v` substitution.
fn rule_emits_vals(ctx: &GenContext, rule: &ParserRule) -> bool {
    return ctx.emit_actions() && rule_returns_vals(rule);
}

fn current_rule_emits_vals(ctx: &GenContext) -> bool {
    let ridx = ctx.current_rule_index();
    if ridx < 0 {
        return false;
    }
    return rule_emits_vals(ctx, &ctx.parser_rules()[ridx]);
}


/// Compact parser for an all-single-token multi-alt rule. The CST node
/// is a `{ span, token }` struct (`gen_multi_alt_cst` single-token path),
/// so parsing reduces to: confirm the lookahead is in the rule's first
/// set, consume the one token, and build the struct. The no-match path is
/// the shared `gen_error_fallback`, so the diagnostic matches the cascade's.
fn gen_parse_fn_single_token(w: &mut CodeWriter, rule: &ParserRule, ctx: &mut GenContext, fn_name: &String) {
    let type_name = rule.type_name;
    gen_visibility_comment(w, &rule.visibility);
    let mut f = FnSpec::new(fn_name);
    f.add_param(&"p", &"&mut Parser");
    if ctx.emit_follow() {
        add_follow_param(&mut f);
    }
    f.set_return_type(&rule_result_type());
    f.emit_begin(w);
    w.line(&"let start = p.peek_start();");
    w.line(&"let kind = p.peek_kind();");

    let mut firsts: List<String> = [];
    for let alt of &rule.alternatives {
        let t = single_token_first(&alt.elements[0]);
        if !first_contains(&firsts, &t) {
            firsts.push(t);
        }
    }
    if rule_alts_labeled(&rule.alternatives) {
        // Labeled rule: emit a per-alt cascade so the matched alternative's
        // index is stamped on the node (consumers dispatch via `<rule>_alt`).
        // Each alt is exactly one token; a shared token resolves to the first
        // alt (cascade order), matching ANTLR4.
        let mut first = true;
        for let mut i = 0; i < rule.alternatives.len(); i += 1 {
            let single: List<String> = [single_token_first(&rule.alternatives[i].elements[0])];
            let cond = ctx.kind_check_str(&single, &"kind");
            if first {
                w.begin(&`if ${cond}`);
                first = false;
            } else {
                w.else_begin(&`else if ${cond}`);
            }
            w.line(&`p.b.set_alt(${i});`);
            w.line(&"let _ = p.expect(kind, &EMPTY_SYNC);");
            w.line(&"return;");
        }
        w.end();
        gen_error_fallback(w, rule, &type_name, ctx);
        w.end();
        w.blank();
        return;
    }

    let check = ctx.kind_check_str(&firsts, &"kind");
    w.begin(&`if ${check}`);
    // The token is appended by `expect`; no struct to build.
    w.line(&"let _ = p.expect(kind, &EMPTY_SYNC);");
    w.line(&"return;");
    w.end();
    gen_error_fallback(w, rule, &type_name, ctx);
    w.end();
    w.blank();
}

/// Body emitter for multi-alt and left-recursive rules. The
/// tail-position caller-FOLLOW repair is threaded at runtime: each
/// `RuleRef` call site carries a `RuleCallOp.follow_arg` and each tail
/// Repeat a `RepeatOp.gate_caller_follow` flag, so the regular emit
/// path needs no per-(rule, mask) specialisation.
/// Whether a multi-alt rule body references `start`: only an inlined alt body
/// uses it — the non-overlap dispatch (`gen_multi_alt_body`) and a singleton
/// overlap group (`gen_multi_alt_body_alt`, `group.len() == 1`). A pure
/// prediction dispatch only calls `_alt_<n>` helpers (which capture their own).
fn rule_body_needs_start(has_overlaps: bool, groups: &List<List<i32>>) -> bool {
    if !has_overlaps {
        return true;
    }
    for let g of groups {
        if g.len() == 1 {
            return true;
        }
    }
    return false;
}

fn gen_parse_fn_named(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lowered_rule: &Rule,
    ctx: &mut GenContext,
    fn_name: &String,
) {
    // Single-alt rules are handled by the dedicated
    // \`gen_parse_fn_simple_named\` so the heavy multi-alt + LR setup
    // below doesn't run for the trivial shape.
    if rule.alternatives.len() == 1 {
        gen_parse_fn_simple_named(w, rule, lowered_rule, ctx, fn_name);
        return;
    }

    // Rules whose alts are all a single token (e.g. SQLite's 122-keyword
    // `keyword`) use a compact `{ span, token }` struct (see
    // `gen_multi_alt_cst`); the parser is a single first-set check plus one
    // construction instead of an N-way `if kind == TK_X` cascade. The scan
    // side already collapses these (`gen_scan_function_named`); the result is
    // far smaller and no slower than the cascade.
    if all_alts_are_single_token(&rule.alternatives)
        && !rule_has_emittable_actions(rule, ctx)
        && !rule_emits_vals(ctx, rule) {
        gen_parse_fn_single_token(w, rule, ctx, fn_name);
        return;
    }

    let type_name = rule.type_name;
    gen_visibility_comment(w, &rule.visibility);

    // Project the lowered rule's alt partition into surface alt
    // indices. For LR rules, atom alts are non-LR; for `Simple` /
    // `MultiAlt` rules every alt is non-LR.
    let og = rule_overlap_groups(rule, lowered_rule, ctx);
    let non_lr_indices = og.0;
    let first_sets = og.1;
    let mut groups = og.2;
    let has_overlaps = has_multi_alt_groups(&groups);

    if has_overlaps {
        for let mut g = 0; g < groups.len(); g += 1 {
            if groups[g].len() > 1 {
                sort_group_by_specificity(&mut groups[g], &first_sets);
                let mut mapped_alts: List<Alternative> = [];
                for let gi of groups[g] {
                    mapped_alts.push(rule.alternatives[non_lr_indices[gi]]);
                }
                let mut local_indices: List<i32> = [];
                for let mut i = 0; i < groups[g].len(); i += 1 {
                    local_indices.push(i);
                }
                sort_group_by_element_count(&mut local_indices, &mapped_alts);
                let mut reordered: List<i32> = [];
                for let li of local_indices {
                    reordered.push(groups[g][li]);
                }
                groups[g] = reordered;
            }
        }
    }

    mark_gated_predicates(rule, has_overlaps, &groups, &first_sets, &non_lr_indices, ctx);

    if has_overlaps {
        // Pre-compute which alts' scan helpers the dispatch will call so the
        // emission loop can skip the dead ones (see `collect_referenced_scan_alts`).
        let mut referenced_scans: List<i32> = [];
        for let group of &groups {
            if group.len() > 1 {
                let tree = build_group_prediction_tree(&rule.alternatives, group, &first_sets, &non_lr_indices, ctx);
                collect_referenced_scan_alts(&tree, &rule.alternatives, ctx, &mut referenced_scans);
            }
        }

        for let group of groups {
            if group.len() > 1 {
                for let gi of group {
                    let alt_index = non_lr_indices[gi];
                    let alt = &rule.alternatives[alt_index];
                    let helper_name = `${*fn_name}_alt_${alt_index}`;

                    let mut f = FnSpec::new(&helper_name);
                    f.add_param(&"p", &"&mut Parser");
                    if ctx.emit_follow() {
                        add_follow_param(&mut f);
                    }
                    // The seeded `vals` (rule args + `@init`) is threaded in from
                    // the inner fn so overlap-group dispatch keeps value
                    // continuity; the helper mutates its own copy and returns it.
                    if rule_emits_vals(ctx, rule) {
                        add_seeded_vals_param(&mut f, rule);
                    }
                    f.set_return_type(&rule_result_type_for(rule, ctx));
                    f.emit_begin(w);
                    w.line(&"let start = p.peek_start();");
                    if rule_emits_vals(ctx, rule) {
                        w.line(&"let mut vals = vals;");
                    }
                    emit_span_capture(w, rule, ctx);
                    let body = rule_alt_body(lowered_rule, alt_index).unwrap();
                    let after = rule_after_for(rule, lowered_rule, ctx);
                    gen_alt_body(
                        w,
                        &type_name,
                        Option::Some(body.case_name),
                        Option::Some(body.struct_name),
                        alt,
                        body,
                        alt_index,
                        rule_alts_labeled(&rule.alternatives),
                        &after,
                        ctx,
                    );
                    w.end();
                    w.blank();

                    // Emit the per-alt scan helper only when the dispatch
                    // actually calls it; a token-led group leaves it dead.
                    if referenced_scans.contains(&alt_index) {
                        gen_alt_scan_if_possible(w, alt, lowered_rule, fn_name, alt_index, &rule.name, ctx);
                    }
                }
            }
        }
    }

    let needs_start = rule_body_needs_start(has_overlaps, &groups);

    let has_lr = lowered_rule matches { LeftRecursive(_) };

    if has_lr {
        let atom_name = `${*fn_name}_atom`;
        let mut f = FnSpec::new(&atom_name);
        f.add_param(&"p", &"&mut Parser");
        if ctx.emit_follow() {
            add_follow_param(&mut f);
        }
        // The atom is the LR rule's primary alt body, so — like any alt body —
        // it receives the invocation's seeded `vals` (rule args + `@init`)
        // rather than minting its own, keeping value continuity into the
        // primary alt's action (`$v` sees the `@init` seed). Placed before the
        // defaulted `min_prec` so it stays a required positional argument.
        if rule_emits_vals(ctx, rule) {
            add_seeded_vals_param(&mut f, rule);
        }
        // The atom carries `min_prec` so a non-greedy `??` inside it predicts
        // against the rule's invocation precedence (`atn_optional_enter_cond`
        // reads it). Defaulted, so non-precedence call sites are unaffected.
        f.add_param_spec(ParamSpec {
            name: "min_prec",
            type_str: "i32",
            default_value: Option::Some("0"),
        });
        f.set_return_type(&rule_result_type_for(rule, ctx));
        f.emit_begin(w);
        if needs_start {
            w.line(&"let start = p.peek_start();");
        }
        if rule_emits_vals(ctx, rule) {
            w.line(&"let mut vals = vals;");
        }
        emit_span_capture(w, rule, ctx);
        if has_overlaps {
            gen_multi_alt_body_alt(
                w,
                rule,
                lowered_rule,
                &type_name,
                ctx,
                &groups,
                &first_sets,
                &non_lr_indices,
                fn_name,
            );
        } else {
            gen_multi_alt_body(w, rule, lowered_rule, &type_name, ctx, &non_lr_indices);
        }
        w.end();
        w.blank();

        let lr_data = if let LeftRecursive(l) = lowered_rule {
            [&l.lr_alts, &l.lr_dispatch];
        } else {
            panic("gen_parse_fn_named: has_lr but lowered_rule is not LeftRecursive");
        };
        let lr_alts = lr_data.0;
        let lr_dispatch = lr_data.1;
        let h_atn_class = if let LeftRecursive(l) = lowered_rule {
            l.atn_class;
        } else {
            false;
        };
        let h_loop_dec = if h_atn_class { ctx.lr_loop_entry_decision(ctx.rule_index_of(&rule.name)) } else { -1 };
        gen_lr_fn(w, rule, lr_alts, lr_dispatch, ctx, fn_name, h_atn_class, h_loop_dec);
        return;
    } else {
        let mut f = FnSpec::new(fn_name);
        f.add_param(&"p", &"&mut Parser");
        if ctx.emit_follow() {
            add_follow_param(&mut f);
        }
        add_arg_params(&mut f, rule, ctx);
        f.set_return_type(&rule_result_type_for(rule, ctx));
        f.emit_begin(w);
        if needs_start {
            w.line(&"let start = p.peek_start();");
        }
        if rule_emits_vals(ctx, rule) {
            w.line(&`let mut vals = ${vals_struct_name(rule)} \{\};`);
        }
        emit_arg_stores(w, rule, ctx);
        emit_span_capture(w, rule, ctx);
        // `@init` shares the inner fn's `vals`; the seed is threaded into the
        // `_alt_<n>` helpers (see `alt_vals_arg`), so overlap-group dispatch
        // preserves it.
        if ctx.emit_actions() {
            if let Some(a) = &rule.init_action {
                gen_action_body(w, a, ctx);
            }
        }
        if has_overlaps {
            gen_multi_alt_body_alt(
                w,
                rule,
                lowered_rule,
                &type_name,
                ctx,
                &groups,
                &first_sets,
                &non_lr_indices,
                fn_name,
            );
        } else {
            gen_multi_alt_body(w, rule, lowered_rule, &type_name, ctx, &non_lr_indices);
        }
        w.end();
        w.blank();
    }
}

/// The rule's `@after` prequel to run at the end of each alt body, or `null`.
/// Emitted for multi-alt non-LR rules (each alt ends with it, so it runs once
/// for the chosen alt); LR rules defer it (the atom's alt bodies must not carry
/// a whole-expression `@after`). Single-alt rules pass their own directly.
fn rule_after_for(rule: &ParserRule, lowered_rule: &Rule, ctx: &GenContext) -> Option<ActionSource> {
    if !ctx.emit_actions() {
        return null;
    }
    if let LeftRecursive(_) = lowered_rule {
        return null;
    }
    return rule.after_action;
}

fn gen_alt_body(
    w: &mut CodeWriter,
    type_name: &String,
    variant_case: Option<String>,
    struct_name: Option<String>,
    alt: &Alternative,
    body: &AltBody,
    alt_index: i32,
    rule_labeled: bool,
    after_action: &Option<ActionSource>,
    ctx: &mut GenContext,
) {
    let _ = type_name;
    let _ = variant_case;
    let _ = struct_name;
    // Stamp the matched labeled-alternative index on the open node so a
    // consumer can dispatch via `<rule>_alt`. This is the single rule-level
    // alt-body chokepoint (simple / overlap-helper / direct dispatch);
    // gated on the rule being labeled so unlabeled grammars stay
    // byte-identical.
    if rule_labeled {
        w.line(&`p.b.set_alt(${alt_index});`);
    }
    gen_alt_elements(w, &alt.elements, &body.ops, &alt.actions, ctx);

    if ctx.emit_actions() {
        if let Some(a) = after_action {
            gen_action_body(w, a, ctx);
        }
    }

    // the alt's terminals / subtrees already appended to the
    // builder via the Parser methods, so there is no struct to assemble — the
    // rule wrapper's `finish_node` closes the node.
    if current_rule_emits_vals(ctx) {
        w.line(&"return vals;");
    } else {
        w.line(&"return;");
    }
}

fn gen_multi_alt_body(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lowered_rule: &Rule,
    type_name: &String,
    ctx: &mut GenContext,
    non_lr_indices: &List<i32>,
) {

    let max_k = MAX_LOOKAHEAD_DEPTH;
    let mut all_pos_sets: List<List<List<String>>> = [];
    for let idx of non_lr_indices {
        all_pos_sets.push(ctx.alt_position_first_sets(&rule.alternatives[*idx], max_k));
    }
    let depth = find_needed_depth(&all_pos_sets);

    w.line(&"let kind = p.peek_kind();");

    for let mut i = 0; i < non_lr_indices.len(); i += 1 {
        let alt_index = non_lr_indices[i];
        let alt = &rule.alternatives[alt_index];

        let pos_sets = &all_pos_sets[i];
        let cond_depth = if depth < pos_sets.len() { depth } else { pos_sets.len() };

        let gate_conds: List<String> = if ctx.emit_actions() { alt_initial_gate_conditions(alt, ctx) } else { [] };
        if cond_depth > 0 {
            let cond = build_lookahead_condition(ctx, pos_sets, cond_depth);
            let gate = if gate_conds.is_empty() { String::new() } else { ` && ${join_gate_conds(&gate_conds)}` };
            w.begin(&`if ${cond}${gate}`);
        } else if gate_conds.is_empty() {
            w.begin(&"scope:");
        } else {
            w.begin(&`if ${join_gate_conds(&gate_conds)}`);
        }

        let body = rule_alt_body(lowered_rule, alt_index).unwrap();
        // Suppress the pick line for all-single-token rules: the chosen alt
        // is self-evident from the lookahead token already printed on the
        // `enter` line (e.g. `enter literal_value @9 '1'` makes
        // `pick literal_value alt#0` pure noise). Tournament / speculative
        // picks, and picks among alts that consume sub-structure, stay.
        if ctx.is_trace() && !all_alts_are_single_token(&rule.alternatives) {
            w.line(&`trace_pick(p, &${str_lit(rule.name)}, ${alt_index});`);
        }
        let after = rule_after_for(rule, lowered_rule, ctx);
        gen_alt_body(
            w,
            type_name,
            Option::Some(body.case_name),
            Option::Some(body.struct_name),
            alt,
            body,
            alt_index,
            rule_alts_labeled(&rule.alternatives),
            &after,
            ctx,
        );
        w.end();
    }

    gen_error_fallback(w, rule, type_name, ctx);
}

/// Peel scalar `Label(...)` wrappers off a surface element for op-dispatch.
///
/// Scalar `name=elem` is lowered by `rebind_op_field`: the inner element's
/// op flows up the lower walker as-is (just with `field` rebound to the
/// label's name), so an op's shape is independent of any enclosing scalar
/// Label. The op-driven walker dispatches on op shape, so it must see the
/// **inner** surface element shape to keep the op↔elem invariant.
///
/// `ListLabel` (`name+=elem`) is preserved as `Op::ListLabel`, so list
/// labels travel through `gen_op_list_label` with the surface Label still
/// attached — this peel only fires on the scalar form.
///
/// The `while` accommodates a theoretical future where lower stacks
/// multiple scalar labels (`a=b=expr`); the g4 parser does not produce
/// that today, but the loop is free defensive cost.
fn peel_scalar_label(elem: &Element) -> &Element with stores[elem] {
    let mut cur = elem;
    loop {
        if let Label(lab) = cur {
            if lab.list {
                break;
            }
            cur = &lab.element;
        } else {
            break;
        }
    }
    return cur;
}

/// Collect the actual post-dedup bindings of an alt's ops (`[is_token, base,
/// field]`), so the action translator resolves a `$ref` to its real local even
/// when a token / rule field-name collision deduped it (`e_2`). Top-level leaf
/// ops plus `Repeat` inners; nested-group refs fall back to `binding_name`.
fn collect_alt_bindings(ops: &List<Op>) -> List<[bool, String, String]> {
    let mut out: List<[bool, String, String]> = [];
    for let op of ops {
        collect_op_binding(op, &mut out);
    }
    return out;
}

fn collect_op_binding(op: &Op, out: &mut List<[bool, String, String]>) {
    match *op {
        Token(t) => out.push([true, t.dedup_base, t.field]),
        Literal(l) => out.push([true, l.dedup_base, l.field]),
        Excluded(e) => out.push([true, e.dedup_base, e.field]),
        Wildcard(wop) => out.push([true, wop.dedup_base, wop.field]),
        RuleCall(rc) => out.push([false, rc.dedup_base, rc.field]),
        Repeat(rep) => collect_op_binding(&rep.body, out),
        ListLabel(_) => {
        },
        Group(_) => {
        },
    }
}

fn gen_alt_elements(
    w: &mut CodeWriter,
    elements: &List<Element>,
    ops: &List<Op>,
    actions: &List<AltAction>,
    ctx: &mut GenContext,
) {
    // gen_alt_elements requires 1:1 correspondence between
    // `elements` and `ops` — full-alt bodies (Simple / MultiAlt /
    // LR atom). LR-suffix bodies strip the leading self-ref op and are
    // emitted by `gen_lr_fn`, not here. Wado's power-assert
    // surfaces the lengths automatically if a mismatched body reaches here.
    //
    // The element-side `if let Repeat(...)` and `gen_op_group` paths
    // require the inner shape, but a surface scalar `name=elem` wraps
    // the inner in `Label(...)` while lower's `rebind_op_field`
    // collapses the op back to the inner's shape. `gen_op_group`
    // peels internally; the Repeat arm here likewise dispatches on
    // the peeled element so `t=ID*` and friends route correctly
    // (today's g4 parser keeps the `*` outside the label, so this
    // arm is defensive — see `peel_scalar_label` for the contract).
    assert ops.len() == elements.len(), "gen_alt_elements: ops / elements length mismatch — LR-suffix bodies are emitted by gen_lr_fn";
    if ctx.emit_actions() {
        ctx.set_alt_bindings(collect_alt_bindings(ops));
        gen_rule_span_decls(w, ops, actions, ctx);
    }
    let mut name_counts: List<[String, i32]> = [];
    // The emitter walks the surface elements + lowered ops in parallel: the
    // leaves/groups/repeats append to the `TreeBuilder`. The surface elements
    // are required so group dispatch can reuse the shared prediction
    // (`build_prediction` / scan tournament).
    for let mut i = 0; i < elements.len(); i += 1 {
        gen_alt_actions_at(w, actions, i, ctx);
        let elem = &elements[i];
        let op = &ops[i];
        if let Repeat(rep) = peel_scalar_label(elem) {
            let rep_op = if let Repeat(r) = op {
                r;
            } else {
                panic("gen_alt_elements: Repeat element / op mismatch");
            };
            gen_op_repeat(w, rep, rep_op, ctx, &mut name_counts);
        } else if op_is_leaf(op) {
            // The rule's FIRST-of-rest at this position is the sync set `expect`
            // inserts a missing terminal against (a recovery-only edit; on valid
            // input the leaf matches and `sync` is never read).
            let sync = ctx.first_of_elements_from(elements, i + 1);
            let span_field = rule_call_span_field(op, actions, ctx);
            if let Some(f) = &span_field {
                w.line(&`${rule_span_lo_local(f)} = p.pos;`);
            }
            gen_op_leaf(w, op, ctx, &mut name_counts, &sync);
            if let Some(f) = &span_field {
                w.line(&`${rule_span_hi_local(f)} = p.pos - 1;`);
            }
        } else if let ListLabel(ll) = op {
            gen_op_list_label(w, ll, elem, ctx, &mut name_counts);
        } else if let Group(g_op) = op {
            gen_op_group(w, g_op, elem, ctx, &mut name_counts);
        } else {
            panic("gen_alt_elements: unreachable op shape — every Op variant is handled");
        }
    }
    gen_alt_actions_at(w, actions, elements.len(), ctx);
}

/// The binding field of a `RuleCall` op whose matched text one of `actions`
/// reads through `$<label>.text`, or null. Gates the token-range capture so a
/// grammar that never reads a rule label's text stays byte-identical. Predicate
/// bodies count: they resolve `$`-references through the same path.
fn rule_call_span_field(op: &Op, actions: &List<AltAction>, ctx: &GenContext) -> Option<String> {
    if !ctx.emit_actions() {
        return null;
    }
    let rc = match op {
        RuleCall(r) => *r,
        _ => {
            return null;
        },
    };
    for let a of actions {
        if action_reads_rule_span(&a.source.text, &rc.dedup_base) {
            return Option::Some(rc.field);
        }
    }
    return null;
}

/// Declare the token-range locals for every labeled rule call in this scope
/// whose text an action reads, before any of them is assigned. Declaring up
/// front rather than at the call keeps the read in scope wherever the action
/// sits — including before the call, where the label is not bound yet and the
/// empty range yields empty text (ANTLR's `$label` is null there).
fn gen_rule_span_decls(w: &mut CodeWriter, ops: &List<Op>, actions: &List<AltAction>, ctx: &GenContext) {
    for let op of ops {
        if let Some(f) = rule_call_span_field(op, actions, ctx) {
            w.line(&`let mut ${rule_span_lo_local(&f)} = 0;`);
            w.line(&`let mut ${rule_span_hi_local(&f)} = -1;`);
        }
    }
}

/// Emit every retained action / predicate whose position is `before` (it
/// runs after `elements[before - 1]` and before `elements[before]`). No-op
/// unless action execution is on. Predicates emit an inline runtime guard
/// (a false one fails the parse); prediction-time gating is Phase 2 proper.
fn gen_alt_actions_at(w: &mut CodeWriter, actions: &List<AltAction>, before: i32, ctx: &mut GenContext) {
    if !ctx.emit_actions() {
        return;
    }
    for let a of actions {
        if a.before_index != before {
            continue;
        }
        match a.kind {
            Action => gen_action_body(w, &a.source, ctx),
            Predicate => {
                if ctx.is_predicate_gated(a.source.action_id) {
                    ctx.mark_action_seen(a.source.action_id);
                } else if predicate_selects_alternative(before, ctx) {
                    warn_unsupported_prediction_predicate(&a.source, ctx);
                } else {
                    gen_predicate_guard(w, &a.source, ctx);
                }
            },
        }
    }
}

/// An alt-initial predicate in a multi-alt rule chooses which alternative the
/// prediction takes. Gale's prediction ignores predicates, so this shape is
/// not an inline guard but a prediction gate — surfaced loudly until
/// prediction-time gating lands (Phase 2).
fn predicate_selects_alternative(before: i32, ctx: &GenContext) -> bool {
    return before == 0 && current_rule_is_multi_alt(ctx);
}

fn warn_unsupported_prediction_predicate(src: &ActionSource, ctx: &mut GenContext) {
    ctx.mark_action_seen(src.action_id);
    ctx.warn(
        &`action ${src.action_id}`,
        DiagnosticKind::UnsupportedAction,
        `predicate ${src.action_id}: alt-initial predicates in a multi-alt rule need prediction-time gating (not yet supported)`,
    );
}

fn current_rule_is_multi_alt(ctx: &GenContext) -> bool {
    let ridx = ctx.current_rule_index();
    if ridx < 0 {
        return false;
    }
    return ctx.parser_rules()[ridx].alternatives.len() > 1;
}

/// The dispatch-gate condition an alt-initial predicate contributes, or `null`
/// if it is not gateable. Gateable = `before_index == 0`, a `Predicate` (not an
/// action), and a body that translates in the current rule's context:
/// context-independent (no `$` refs) bodies pass through verbatim;
/// context-dependent ones ($local / $ret / token members) translate over the
/// value channel (`$v` → `vals.v`), evaluated at the dispatch where `vals` is in
/// scope. A body the translator cannot emit is not gateable — it falls to the
/// inline guard path. The condition collector and the id-marking pass share
/// this, so the gated set and the emitted conditions cannot diverge.
fn gate_condition_for(a: &AltAction, ctx: &GenContext) -> Option<String> {
    if a.before_index != 0 {
        return null;
    }
    if a.kind matches { Action } {
        return null;
    }
    if predicate_body_is_context_free(&a.source.text, ctx) {
        // Extracted to a standalone `pred_<id>(p)` fn (`gen_predicate_fns`), so
        // the dispatch calls it rather than inlining the condition.
        return Option::Some(`${pred_fn_name(a.source.action_id)}(p)`);
    }
    let ridx = ctx.current_rule_index();
    if ridx < 0 {
        return null;
    }
    let rule = &ctx.parser_rules()[ridx];
    let vals_in_scope = rule_emits_vals(ctx, rule);
    let lang = ctx.action_language();
    return match translate_predicate(
        &lang,
        rule,
        ctx.parser_rules(),
        &a.source.text,
        vals_in_scope,
        ctx.alt_bindings(),
        ctx.grammar_name(),
        ctx.action_member_methods(),
    ) {
        Ok(code) => Option::Some(code),
        Err(_) => null,
    };
}

fn is_gateable_alt_initial_predicate(a: &AltAction, ctx: &GenContext) -> bool {
    return gate_condition_for(a, ctx) matches { Some(_) };
}

/// The name of a predicate's standalone fn (`pred_<action_id>`).
fn pred_fn_name(id: i32) -> String {
    return `pred_${id}`;
}

/// Whether a gateable alt-initial predicate's body is context-free — a
/// `language = Wado` body with no `$`-references, so it reads only `p` (and
/// constants) and extracts to a standalone `pred_<id>(p)` fn. Context-dependent
/// bodies (`$v` → `vals.v`) stay folded into the dispatch, where `vals` is in
/// scope.
fn predicate_body_is_context_free(text: &String, ctx: &GenContext) -> bool {
    return ctx.action_language() matches { Wado } && find_attr_refs(text).len() == 0;
}

/// Emit the `disabled_alts` seed for an ATN-routed decision: each gated alt is
/// pushed to `_atn_disabled` when its `gate_condition_for` condition is false,
/// so the simulator never seeds it (both `p` and the seeded `vals` the
/// condition may read are in scope here). Returns the `, &_atn_disabled`
/// argument suffix, or `""` when no alt is gated.
fn emit_atn_disabled_seed(
    w: &mut CodeWriter,
    amb_alts: &List<i32>,
    alts: &List<Alternative>,
    ctx: &GenContext,
) -> String {
    if !ctx.emit_actions() {
        return String::new();
    }
    let mut gates: List<[i32, String]> = [];
    for let idx of amb_alts {
        for let a of &alts[*idx].actions {
            if let Some(cond) = gate_condition_for(a, ctx) {
                gates.push([*idx, cond]);
            }
        }
    }
    if gates.is_empty() {
        return String::new();
    }
    w.line(&"let mut _atn_disabled: List<i32> = [];");
    for let g of &gates {
        w.line(&`if !(${g.1}) \{ _atn_disabled.push(${g.0}); \}`);
    }
    return String::from(", &_atn_disabled");
}

/// An alt's gateable alt-initial predicate conditions, translated, in grammar
/// order.
fn alt_initial_gate_conditions(alt: &Alternative, ctx: &GenContext) -> List<String> {
    let mut conds: List<String> = [];
    for let a of &alt.actions {
        if let Some(c) = gate_condition_for(a, ctx) {
            conds.push(c);
        }
    }
    return conds;
}

/// Whether any alt in an `Ambiguous` overlap group carries a gateable
/// alt-initial predicate.
fn ambiguous_group_has_gate(amb_alts: &List<i32>, alts: &List<Alternative>, ctx: &GenContext) -> bool {
    for let idx of amb_alts {
        if !alt_initial_gate_conditions(&alts[*idx], ctx).is_empty() {
            return true;
        }
    }
    return false;
}

/// Whether every alt in an overlap group matches the same terminal sequence, so
/// they genuinely tie. Only then is the grammar-order predicate chain sound: a
/// group whose alts differ in length or token must keep the length tournament,
/// which the chain would misroute. A non-terminal element (`elements_match`
/// compares only `TokenRef` / `Literal`) makes the group ineligible.
fn group_alts_interchangeable(amb_alts: &List<i32>, alts: &List<Alternative>) -> bool {
    if amb_alts.is_empty() {
        return false;
    }
    let first = &alts[amb_alts[0]].elements;
    for let idx of amb_alts {
        let els = &alts[*idx].elements;
        if els.len() != first.len() {
            return false;
        }
        for let mut i = 0; i < els.len(); i += 1 {
            if !elements_match(&els[i], &first[i]) {
                return false;
            }
        }
    }
    return true;
}

/// Whether an `Ambiguous` group is resolved by predicate-gated dispatch: it has
/// a gateable predicate and its alts are interchangeable. The marking pass and
/// every emit site key on this so the gated set and emitted conditions agree.
fn ambiguous_group_predicate_gated(amb_alts: &List<i32>, alts: &List<Alternative>, ctx: &GenContext) -> bool {
    return ambiguous_group_has_gate(amb_alts, alts, ctx) && group_alts_interchangeable(amb_alts, alts);
}

/// Collect the alts of every predicate-gated `Ambiguous` node in the tree.
/// Walks the whole tree, not just its root, to stay symmetric with emit (which
/// gates a node nested under a `Dispatch` too). A node is gated when it either
/// dispatches by the grammar-order predicate chain (interchangeable), or routes
/// through the runtime ATN — where a gate's alts are excluded from the seed set
/// (`disabled_alts`) instead.
fn collect_gated_ambiguous_alts(
    node: &PredictionNode,
    alts: &List<Alternative>,
    rule: &ParserRule,
    ctx: &GenContext,
    out: &mut List<i32>,
) {
    match *node {
        Leaf(_) => {
        },
        Consume(c) => collect_gated_ambiguous_alts(&c.child, alts, rule, ctx, out),
        Dispatch(d) => {
            for let branch of &d.branches {
                collect_gated_ambiguous_alts(&branch.child, alts, rule, ctx, out);
            }
        },
        Ambiguous(a) => {
            if ambiguous_group_predicate_gated(&a.alts, alts, ctx)
                || ambiguous_group_atn_predicate_gated(&a, alts, rule, ctx) {
                for let idx of &a.alts {
                    out.push(*idx);
                }
            }
        },
    }
}

/// Whether an `Ambiguous` node's decision is emitted as a runtime-ATN
/// prediction (`atn_predict_with_stack`). Shared by the marking pass and
/// `gen_prediction_code_inner`'s `route_via_atn` so the two cannot disagree
/// about which nodes take the ATN path.
fn ambiguous_node_routes_via_atn(a: &AmbiguousNode, rule_name: &String, ctx: &GenContext) -> bool {
    return a.reason matches { AtEndConflict }
        && ctx.emits_at_end_conflict_via_atn(ctx.current_rule_index(), rule_name, &a.branch_tokens);
}

/// Whether an `Ambiguous` node routes through the runtime ATN *and* carries a
/// gateable predicate — so its gate alts feed the simulator's `disabled_alts`
/// prune rather than an inline dispatch chain.
fn ambiguous_group_atn_predicate_gated(
    a: &AmbiguousNode,
    alts: &List<Alternative>,
    rule: &ParserRule,
    ctx: &GenContext,
) -> bool {
    return ambiguous_node_routes_via_atn(a, &rule.name, ctx) && ambiguous_group_has_gate(&a.alts, alts, ctx);
}

/// Record every alt-initial predicate a dispatch site will gate, so
/// `gen_alt_actions_at` suppresses its in-body copy. Covers the `Direct`
/// branch, the singleton overlap group, and interchangeable `Ambiguous`
/// groups; a deeper `Dispatch` / `Consume` group is left for the inline path.
fn mark_gated_predicates(
    rule: &ParserRule,
    has_overlaps: bool,
    groups: &List<List<i32>>,
    first_sets: &List<List<String>>,
    non_lr_indices: &List<i32>,
    ctx: &mut GenContext,
) {
    if !ctx.emit_actions() {
        return;
    }
    if !has_overlaps {
        for let idx of non_lr_indices {
            mark_alt_gate_predicates(&rule.alternatives[*idx], ctx);
        }
        return;
    }
    for let group of groups {
        if group.len() == 1 {
            mark_alt_gate_predicates(&rule.alternatives[non_lr_indices[group[0]]], ctx);
        } else {
            let tree = build_group_prediction_tree(&rule.alternatives, group, first_sets, non_lr_indices, ctx);
            let mut gated: List<i32> = [];
            collect_gated_ambiguous_alts(&tree, &rule.alternatives, rule, ctx, &mut gated);
            for let idx of &gated {
                mark_alt_gate_predicates(&rule.alternatives[*idx], ctx);
            }
        }
    }
}

fn mark_alt_gate_predicates(alt: &Alternative, ctx: &mut GenContext) {
    for let a of &alt.actions {
        if is_gateable_alt_initial_predicate(a, ctx) {
            ctx.mark_predicate_gated(a.source.action_id);
            if predicate_body_is_context_free(&a.source.text, ctx) {
                ctx.register_predicate_fn(a.source.action_id, &a.source.text);
            }
        }
    }
}

/// The ` && (pred)` suffix folding an alt's gateable predicates into a
/// token-led dispatch condition, or "" when off (keeping non-Wado grammars
/// byte-identical) or the alt has none.
fn alt_gate_and_suffix(alt: &Alternative, ctx: &GenContext) -> String {
    if !ctx.emit_actions() {
        return String::new();
    }
    let conds = alt_initial_gate_conditions(alt, ctx);
    if conds.is_empty() {
        return String::new();
    }
    return ` && ${join_gate_conds(&conds)}`;
}

/// Emit predicate-gated selection for an interchangeable `Ambiguous` group, in
/// grammar order: the first alt whose predicates hold wins, an unpredicated alt
/// is always viable and closes the chain, and all-false is no viable alternative.
fn gen_predicate_gated_dispatch(
    w: &mut CodeWriter,
    amb_alts: &List<i32>,
    alts: &List<Alternative>,
    fn_name: &String,
    ctx: &GenContext,
    rule_display: &String,
) {
    let order = amb_alts.sorted();
    let mut opened = false;
    for let idx of &order {
        let conds = alt_initial_gate_conditions(&alts[*idx], ctx);
        if conds.is_empty() {
            if !opened {
                emit_gated_pick(w, *idx, fn_name, ctx, rule_display);
                return;
            }
            w.else_begin(&"else");
            emit_gated_pick(w, *idx, fn_name, ctx, rule_display);
            w.end();
            return;
        }
        let cond = join_gate_conds(&conds);
        if !opened {
            w.begin(&`if ${cond}`);
            opened = true;
        } else {
            w.else_begin(&`else if ${cond}`);
        }
        emit_gated_pick(w, *idx, fn_name, ctx, rule_display);
    }
    w.else_begin(&"else");
    w.line(&`p.no_viable("no viable alternative", p.peek_span(), []);`);
    emit_no_viable_return(w, ctx);
    w.end();
}

/// The `, vals` a multi-alt dispatch forwards to an `_alt_<n>` helper so the
/// seeded value channel (rule args + `@init`) reaches the chosen alternative,
/// or `""` when the rule has no channel.
/// Add the seeded `vals` parameter with a default (`<Rule>Vals {}`). Callers
/// still pass it positionally; the default keeps the signature valid when a
/// defaulted `follow` parameter precedes it (non-default params cannot follow
/// default ones). The vals struct is default-constructible by construction (its
/// fields are all defaultable — that is the value-channel eligibility check).
fn add_seeded_vals_param(f: &mut FnSpec, rule: &ParserRule) {
    let vname = vals_struct_name(rule);
    f.add_param_spec(ParamSpec {
        name: "vals",
        type_str: vname,
        default_value: Option::Some(`${vname} \{\}`),
    });
}

fn alt_vals_arg(ctx: &GenContext) -> String {
    if current_rule_emits_vals(ctx) {
        return String::from(", vals");
    }
    return String::new();
}

/// Return statement after a `no_viable` in a rule body: `return vals;` when the
/// rule exposes a value channel (so a `Default`-init struct flows back), else
/// `return;`.
fn emit_no_viable_return(w: &mut CodeWriter, ctx: &GenContext) {
    if current_rule_emits_vals(ctx) {
        w.line(&"return vals;");
    } else {
        w.line(&"return;");
    }
}

/// Emit a gated branch body: the trace pick and the tail call into the alt.
fn emit_gated_pick(w: &mut CodeWriter, idx: i32, fn_name: &String, ctx: &GenContext, rule_display: &String) {
    if ctx.is_trace() {
        w.line(&`trace_pick(p, &${str_lit(*rule_display)}, ${idx});`);
    }
    w.line(&`return ${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)});`);
}

/// Join predicate conditions into one short-circuit `(c0) && (c1)` guard.
fn join_gate_conds(conds: &List<String>) -> String {
    let mut out = String::new();
    for let mut i = 0; i < conds.len(); i += 1 {
        if i > 0 {
            out.push_str(&" && ");
        }
        out.push('(');
        out.push_str(&conds[i]);
        out.push(')');
    }
    return out;
}

/// Emit one action body under the identity translator (`language = Wado`):
/// the host text is Wado, so it passes through verbatim inside a block,
/// with `p` in scope as the current `Parser`. Actions must not observably
/// run inside a speculative attempt, so the body is guarded on
/// `!p.speculating`. `$`-references are substituted against the current
/// rule's environment — its own `vals` local (`$v`) and child bindings
/// (`$a.v`). A reference the translator cannot emit yet is a loud
/// `UnsupportedAction` diagnostic rather than invalid `$x`.
fn gen_action_body(w: &mut CodeWriter, src: &ActionSource, ctx: &mut GenContext) {
    ctx.mark_action_seen(src.action_id);
    if let Some(code) = translate_action_or_warn(src, false, ctx) {
        emit_action_stmt(w, &code);
    }
}

/// Translate an action (`is_predicate = false`, a statement list) or a predicate
/// condition (`is_predicate = true`, an expression) to Wado, warning (loud) and
/// returning `null` on failure. A ref-free Wado body passes through verbatim.
fn translate_action_or_warn(src: &ActionSource, is_predicate: bool, ctx: &mut GenContext) -> Option<String> {
    if ctx.action_language() matches { Wado } && find_attr_refs(&src.text).len() == 0 {
        return Option::Some(src.text);
    }
    let ridx = ctx.current_rule_index();
    if ridx < 0 {
        ctx.warn(
            &`action ${src.action_id}`,
            DiagnosticKind::UnsupportedAction,
            `action ${src.action_id} references attributes outside a rule context`,
        );
        return null;
    }
    let vals_in_scope = rule_emits_vals(ctx, &ctx.parser_rules()[ridx]);
    let lang = ctx.action_language();
    let translated = if is_predicate {
        translate_predicate(
            &lang,
            &ctx.parser_rules()[ridx],
            ctx.parser_rules(),
            &src.text,
            vals_in_scope,
            ctx.alt_bindings(),
            ctx.grammar_name(),
            ctx.action_member_methods(),
        );
    } else {
        translate_action(
            &lang,
            &ctx.parser_rules()[ridx],
            ctx.parser_rules(),
            &src.text,
            vals_in_scope,
            ctx.alt_bindings(),
            ctx.grammar_name(),
            ctx.action_member_methods(),
        );
    };
    return match translated {
        Ok(code) => Option::Some(code),
        Err(msg) => {
            ctx.warn(&`action ${src.action_id}`, DiagnosticKind::UnsupportedAction, msg);
            null;
        },
    };
}

/// Whether codegen emits the `_rule_start_tok` capture for this rule — its
/// actions reference a rule-span special (`$text` / `$start` / `$stop`). The
/// translator keys their substitution on the same predicate, so the local they
/// read is always in scope, for every rule shape.
fn rule_captures_span(rule: &ParserRule, rules: &List<ParserRule>) -> bool {
    return rule_uses_rule_span(rule, rules);
}

/// Emit `let _rule_start_tok = p.pos;` at a rule-body entry (where `p.pos` is
/// the rule's first token), when the rule references `$text` / `$start` /
/// `$stop`. Placed at every shape's body entry (single-alt inner, multi-alt
/// inner, `_alt_<n>` helpers, LR inner/atom), so span specials resolve
/// uniformly regardless of dispatch.
fn emit_span_capture(w: &mut CodeWriter, rule: &ParserRule, ctx: &GenContext) {
    if ctx.emit_actions() && rule_captures_span(rule, ctx.parser_rules()) {
        w.line(&`let ${RULE_START_TOK_LOCAL} = p.pos;`);
    }
}

/// Emit a semantic predicate `{cond}?` as an inline runtime guard: when the
/// (translated) condition is false during a real (non-speculative) parse, the
/// rule fails into normal recovery. Prediction-time gating of which alt to
/// take is Phase 2 proper; this serves mid-alt predicates and single-alt-rule
/// gates, where a false predicate is a parse failure at that point.
fn gen_predicate_guard(w: &mut CodeWriter, src: &ActionSource, ctx: &mut GenContext) {
    ctx.mark_action_seen(src.action_id);
    let cond = match translate_action_or_warn(src, true, ctx) {
        Some(c) => c,
        None => {
            return;
        },
    };
    w.begin(&"if !p.speculating");
    w.begin(&`if !(${cond})`);
    w.line(&`p.no_viable("failed semantic predicate", p.peek_span(), []);`);
    if current_rule_emits_vals(ctx) {
        w.line(&"return vals;");
    } else {
        w.line(&"return;");
    }
    w.end();
    w.end();
}

fn emit_action_stmt(w: &mut CodeWriter, code: &String) {
    w.begin(&"if !p.speculating");
    w.line(code);
    w.end();
}

/// Group / single-alt-body internal walker. Mirrors `gen_alt_elements`
/// but accepts an `outer_follow` parameter so nested non-greedy /
/// follow-aware Repeats can union the outer iter-follow into their
/// effective continuation set. `ops` runs parallel to `elements` —
/// callers obtain it from the surrounding `AltBody.ops`. Leaf / Group /
/// ListLabel ops dispatch through `gen_op_leaf` / `gen_op_group` /
/// `gen_op_list_label`; Repeat / Label / Not still flow through the
/// surface `gen_repeat*` helpers (Phase 2-C migrates the Repeat arm).
fn gen_elements_with_non_greedy(
    w: &mut CodeWriter,
    elements: &List<Element>,
    ops: &List<Op>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    outer_follow: &List<String>,
    actions: &List<AltAction> = &NO_ACTIONS,
) {
    assert ops.len() == elements.len(), "gen_elements_with_non_greedy: ops / elements length mismatch";
    // An inlined body's labels bind to its own ops. Restored on the way out so a
    // nested group does not leave the outer scope pointing at its bindings.
    let outer_bindings = *ctx.alt_bindings();
    if ctx.emit_actions() && !actions.is_empty() {
        ctx.set_alt_bindings(collect_alt_bindings(ops));
        gen_rule_span_decls(w, ops, actions, ctx);
    }
    for let mut i = 0; i < elements.len(); i += 1 {
        gen_alt_actions_at(w, actions, i, ctx);
        let elem = &elements[i];
        let op = &ops[i];
        if let Repeat(rep) = peel_scalar_label(elem) {
            let rep_op = if let Repeat(r) = op {
                r;
            } else {
                panic("gen_elements_with_non_greedy: Repeat element / op mismatch");
            };
            let follow = inner_walker_follow_for_repeat(rep, rep_op, elements, i, outer_follow, ctx);
            gen_op_repeat_with_follow_override(w, rep, rep_op, ctx, name_counts, &follow);
        } else if op_is_leaf(op) {
            // Same FIRST-of-rest sync as `gen_alt_elements`, so a missing leaf
            // inside a group / single-alt body is inserted in place rather than
            // only deleted-or-unwound (recovery quality is uniform with the
            // top-level sequence).
            let sync = ctx.first_of_elements_from(elements, i + 1);
            let span_field = rule_call_span_field(op, actions, ctx);
            if let Some(f) = &span_field {
                w.line(&`${rule_span_lo_local(f)} = p.pos;`);
            }
            gen_op_leaf(w, op, ctx, name_counts, &sync);
            if let Some(f) = &span_field {
                w.line(&`${rule_span_hi_local(f)} = p.pos - 1;`);
            }
        } else if let ListLabel(ll) = op {
            gen_op_list_label(w, ll, elem, ctx, name_counts);
        } else if let Group(g_op) = op {
            gen_op_group(w, g_op, elem, ctx, name_counts);
        } else {
            panic("gen_elements_with_non_greedy: unreachable op shape — every Op variant is handled");
        }
    }
    gen_alt_actions_at(w, actions, elements.len(), ctx);
    if ctx.emit_actions() && !actions.is_empty() {
        ctx.set_alt_bindings(outer_bindings);
    }
}

/// No actions — the default for an inner body whose caller has none to place
/// (a group whose alternative carries no retained `{ ... }`).
global NO_ACTIONS: List<AltAction> = [];

/// Compute the `follow` to pass to `gen_op_repeat_with_follow_override`
/// when this Repeat is reached from the *inner* walker
/// (`gen_elements_with_non_greedy`) — i.e. nested inside another body
/// rather than at top-level alt position.
///
/// Greedy `?` Repeats get an empty follow here: lower's
/// `caller_follow_first` is the alt-level next-sibling FIRST set,
/// which the Optional + RuleCall arm of `gen_op_repeat_with_follow_override`
/// subtracts from the gate at top-level to keep the optional from
/// eating tokens that belong to the next sibling. The same subtraction
/// is wrong at inner positions: lower's `caller_follow_first` typically
/// overlaps the inner's first by design there (`(= typeParameters?
/// singleExpression)?` patterns), and applying it would empty the gate
/// and silently skip the optional. Clearing the follow at inner
/// positions leaves the tail-position caller-FOLLOW repair to the
/// runtime `gate_caller_follow` gate emitted by
/// `gen_op_repeat_optional_rulecall`.
///
/// Star / Plus and non-greedy still need the caller-side follow:
/// greedy Star / Plus reads it as the iter-follow for nested
/// non-greedy gates, and non-greedy uses it as the exit-first set.
/// For those we propagate the outer walker's `outer_follow` when the
/// remainder of the surrounding element list is nullable (so the
/// next-iteration FIRST union picks up tokens that would otherwise
/// exit the outer construct).
fn inner_walker_follow_for_repeat(
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    elements: &List<Element>,
    i: i32,
    outer_follow: &List<String>,
    ctx: &mut GenContext,
) -> List<String> {
    let is_greedy_optional = if let Optional = rep.kind {
        !rep.non_greedy;
    } else {
        false;
    };
    if is_greedy_optional {
        return [];
    }
    let mut follow = rep_op.caller_follow_first;
    if ctx.tail_is_nullable_deep(elements, i + 1) {
        follow = union_kind_arrays(&follow, outer_follow);
    }
    return follow;
}

/// True when the lowered op is a leaf shape that emit can render
/// directly from `op.field` / `op.kind` / `op.target_snake` /
/// `op.follow_arg` / `op.min_prec_arg` — i.e. lower has resolved
/// every decision and the emit body is a single `let … = …;` line.
/// Repeat / Group / ListLabel ops still flow through the surface-IR
/// helpers in this slice and will migrate in later (2) slices.
fn op_is_leaf(op: &Op) -> bool {
    return match op {
        Token(_) | Literal(_) | RuleCall(_) | Wildcard(_) | Excluded(_) => true,
        Repeat(_) | Group(_) | ListLabel(_) => false,
    };
}

/// Emit `p.atn_ret_pending = <state>;` immediately before a `_parse_X` call
/// so the callee's entry wrapper pushes the call's exact ATN return state
/// onto `p.atn_stack` (full-context prediction). No-op unless the grammar
/// needs the ATN and the call site has a known return state
/// (`Atn.call_site_returns`, keyed by `RuleCallOp.atn_call_site`). An
/// unstamped call leaves `atn_ret_pending` at -1, which the simulator reads
/// as an unknown caller (SLL-accept at that frame).
fn gen_atn_ret_pending(w: &mut CodeWriter, ctx: &GenContext, call_site: i32) {
    if !ctx.needs_atn() {
        return;
    }
    let ret = ctx.atn_call_site_return(call_site);
    if ret < 0 {
        return;
    }
    w.line(&`p.atn_ret_pending = ${ret};`);
}

/// Emit a single leaf-op parse line, reading the deduped field name
/// and resolved token / follow-arg / min-prec values straight from
/// `Op`. Lower's `lower_alt_body` / `lower_label_op` / etc. have
/// already baked in dedup, the per-call-site `FollowArg`, and the
/// LR-prefix `min_prec` argument — emit does not re-derive any of
/// it. Counterpart of the leaf arms of `gen_element` for the surface
/// IR walker; that walker is still in use inside group bodies and
/// Label / Not cases, but the top-level alt walker (`gen_alt_elements`)
/// dispatches leaves here instead.
///
/// The mirror `dedup_name(&op.dedup_base, name_counts)` keeps
/// `name_counts` in sync with what `gen_element`'s leaf arms would
/// have produced, so siblings that still walk surface IR (e.g.
/// `gen_lr_fn`'s inline `dedup_name(&rr.field_name, ...)`
/// paths and `gen_element` fallbacks) read a consistent count. The
/// emitted field name comes from `op.field` exclusively — `dedup_base`
/// is consulted only for the sync. The sync goes away entirely once
/// every emit path consumes `Op`.
global EMPTY_SYNC: List<String> = [];

/// Resolve a leaf's FIRST-of-rest to the by-reference `expect` sync argument:
/// `&SYNC_<id>` for a distinct non-empty set (interned into a `global` once,
/// never rebuilt per call), or `&EMPTY_SYNC` for the empty set. Mirrors the
/// `FOLLOW_MASK_<id>` interning so the hot path copies nothing.
fn sync_set_ref(ctx: &mut GenContext, sync: &List<String>) -> String {
    if let Some(id) = ctx.intern_sync_set(sync) {
        return `&SYNC_${id}`;
    }
    return String::from("&EMPTY_SYNC");
}

pub fn gen_op_leaf(
    w: &mut CodeWriter,
    op: &Op,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    sync: &List<String> = &EMPTY_SYNC,
) {
    // The Parser's `expect` / `match_*` append the matched token to the builder
    // and return the token index. `sync` is the rule's FIRST-of-rest at this
    // position — the set `expect` inserts a missing terminal against, passed by
    // reference as an interned `&SYNC_<id>` global (`&EMPTY_SYNC` when empty, the
    // default for callers outside a plain sequence — they only delete / panic).
    sync_name_counts_for_op_leaf(op, name_counts);
    return match *op {
        Token(t) => {
            let sync_ref = sync_set_ref(ctx, sync);
            w.line(&`let ${t.field} = p.expect(${t.kind}, ${sync_ref});`);
        },
        Literal(l) => {
            let sync_ref = sync_set_ref(ctx, sync);
            w.line(&`let ${l.field} = p.expect(${l.kind}, ${sync_ref});`);
        },
        RuleCall(r) => {
            // One callee per rule; the caller's continuation is
            // threaded at runtime via `follow_arg` rather than selecting a
            // cloned `__follow_<id>`.
            let fn_name = `_parse_${r.target_snake}`;
            let follow_arg_str = follow_arg_sep(ctx.emit_follow(), &r.follow_arg);
            // `RuleCallOp.min_prec_arg` carries the resolved precedence
            // for every self-recursive call that needs one — `lower_lr_alt_suffix`
            // stamps internal LR-suffix self-refs via
            // `stamp_lr_self_ref_min_prec`, and `lower_alt_body` stamps the
            // trailing self-ref of a prefix LR alt (e.g. `'-' e`) so emit
            // reads a single source.
            gen_atn_ret_pending(w, ctx, r.atn_call_site);
            let argsfx = call_arg_suffix(&r, ctx);
            if let Some(min_prec) = r.min_prec_arg {
                w.line(&`let ${r.field} = ${fn_name}(p${follow_arg_str}, ${min_prec}${argsfx});`);
            } else {
                w.line(&`let ${r.field} = ${fn_name}(p${follow_arg_str}${argsfx});`);
            }
        },
        Wildcard(wop) => w.line(&`let ${wop.field} = p.any();`),
        Excluded(eop) => w.line(&`let ${eop.field} = ${gen_op_excluded_call(&eop)};`),
        // Non-leaf ops (Repeat / Group / ListLabel) are routed to
        // their own dispatchers by the caller; reaching here means
        // the caller's `op_is_leaf` gate was bypassed.
        Repeat(_) | Group(_) | ListLabel(_) => panic("gen_op_leaf: non-leaf op; caller must guard with op_is_leaf"),
    };
}

// === GIR-op body emission ===
// Under the emitter the alt body is emitted from the lowered ops (no
// surface elements, no typed fields): leaves go through `gen_op_leaf` (the
// Parser appends), groups / repeats dispatch on their GIR shape and recurse.
// Mirrors `cst_gen`'s emitter but against the builder-appending Parser, whose
// match methods recover in place (infallible) instead of returning `Result`.

fn gen_ops(w: &mut CodeWriter, ops: &List<Op>, ctx: &mut GenContext, nc: &mut List<[String, i32]>) {
    for let op of ops {
        gen_op(w, op, ctx, nc);
    }
}

fn gen_op(w: &mut CodeWriter, op: &Op, ctx: &mut GenContext, nc: &mut List<[String, i32]>) {
    match *op {
        Repeat(r) => gen_repeat_body(w, &r, ctx, nc),
        Group(g) => gen_group_body(w, &g, ctx, nc),
        ListLabel(ll) => gen_op(w, &ll.inner, ctx, nc),
        _ => gen_op_leaf(w, op, ctx, nc),
    }
}

/// If every alt is a single terminal, the kind constants; else `None`.
fn group_token_only_kinds(alts: &List<AltBody>) -> Option<List<String>> {
    let mut kinds: List<String> = [];
    for let alt of alts {
        if alt.ops.len() != 1 {
            return null;
        }
        match &alt.ops[0] {
            Token(t) => kinds.push(t.kind),
            Literal(l) => kinds.push(l.kind),
            _ => {
                return null;
            },
        }
    }
    return Option::Some(kinds);
}

fn gen_group_body(w: &mut CodeWriter, g: &GroupOp, ctx: &mut GenContext, nc: &mut List<[String, i32]>) {
    if let Some(kinds) = group_token_only_kinds(&g.alts) {
        w.line(&`let _ = p.expect_set([${join_kinds(&kinds)}]);`);
        return;
    }
    if g.alts.len() == 1 {
        gen_ops(w, &g.alts[0].ops, ctx, nc);
        return;
    }
    gen_alt_dispatch(w, &g.alts, &g.scan_alts, &g.dispatch, ctx, nc);
}

fn alt_by_index(alts: &List<AltBody>, idx: i32) -> &AltBody with stores[alts] {
    for let a of alts {
        if a.alt_index == idx {
            return a;
        }
    }
    panic(`gen_group_body: no alt with index ${idx}`);
}

/// Group-alt dispatch under the GIR walker (used for LR-suffix
/// group bodies). `Direct` emits a token-led `if/else if` chain; `Tournament`
/// reuses the longest-match scan tournament (`gen_scan_winner_tournament`
/// over the group's `scan_alts`) and emits the winning alt's appending body.
fn gen_alt_dispatch(
    w: &mut CodeWriter,
    alts: &List<AltBody>,
    scan_alts: &List<ScanBody>,
    dispatch: &MultiAltDispatch,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
) {
    let dd = match *dispatch {
        Direct(d) => d,
        Tournament(td) => {
            let winner = gen_scan_winner_tournament(w, &td.alts, scan_alts, ctx, nc);
            let last = td.alts.len() - 1;
            for let mut k = 0; k < td.alts.len(); k += 1 {
                if k == 0 && k != last {
                    w.begin(&`if ${winner} == ${td.alts[k]}`);
                } else if k == last {
                    w.else_begin(&"else");
                } else {
                    w.else_begin(&`else if ${winner} == ${td.alts[k]}`);
                }
                gen_ops(w, &alt_by_index(alts, td.alts[k]).ops, ctx, nc);
            }
            w.end();
            return;
        },
    };
    w.line(&"let _gk = p.peek_kind();");
    let mut all_first: List<String> = [];
    for let mut i = 0; i < dd.branches.len(); i += 1 {
        let br = &dd.branches[i];
        for let t of &br.tokens {
            all_first.push(*t);
        }
        let cond = ctx.kind_check_str(&br.tokens, &"_gk");
        if i == 0 {
            w.begin(&`if ${cond}`);
        } else {
            w.else_begin(&`else if ${cond}`);
        }
        gen_ops(w, &alt_by_index(alts, br.alt_index).ops, ctx, nc);
    }
    w.else_begin(&"else");
    w.line(&`let _ = p.expect_set([${join_kinds(&all_first)}]);`);
    w.end();
}

/// Left-recursive rule under the emitter: precedence climbing via the
/// builder's `checkpoint` / `start_node_at` left-associative wrap (mirrors
/// cst_gen). The atom opens one rule node; each LR continuation wraps the tree
/// so far in a new same-rule node. Suffix ops append via `gen_ops`; a
/// self-ref carries its baked `min_prec`. Overlapping suffix groups (needing a
/// second-token sub-dispatch) reuse the typed dispatch in a later slice.
fn gen_lr_fn(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lr_alts: &List<LrAlt>,
    lr_dispatch: &LrDispatchData,
    ctx: &mut GenContext,
    fn_name: &String,
    atn_class: bool,
    loop_dec: i32,
) {
    let rk = rule_kind_const(&rule.name);
    let mut f = FnSpec::new(fn_name);
    f.add_param(&"p", &"&mut Parser");
    if ctx.emit_follow() {
        add_follow_param(&mut f);
    }
    f.add_param_spec(ParamSpec {
        name: "min_prec",
        type_str: "i32",
        default_value: Option::Some("0"),
    });
    f.set_return_type(&rule_result_type_for(rule, ctx));
    f.emit_begin(w);
    let emits_vals = rule_emits_vals(ctx, rule);
    let fsep = follow_sep(ctx.emit_follow());
    w.line(&"let _cp = p.b.checkpoint();");
    w.line(&"let _start = p.peek_start();");
    w.line(&`p.b.start_node(${rk}, _start);`);
    // Seed the invocation's `vals` at rule entry (rule args, then `@init`), as
    // ANTLR's `enterRecursionRule` seeds the primary context. The atom receives
    // it, so `@init`'s `$v` reaches the primary alt's action; each LR
    // continuation then opens a new context with its own fresh `vals`. `mut`
    // only when something in this fn writes it (`@init`, args, or the `@after`
    // reassignment); a plain value-channel LR rule just passes it through.
    if emits_vals {
        let entry_needs_mut = ctx.emit_actions()
            && (rule.init_action matches { Some(_) } || rule.after_action matches { Some(_) } || rule_threads_args(rule));
        let mut_kw = if entry_needs_mut { "mut " } else { "" };
        w.line(&`let ${mut_kw}vals = ${vals_struct_name(rule)} \{\};`);
    }
    emit_span_capture(w, rule, ctx);
    if ctx.emit_actions() {
        emit_arg_stores(w, rule, ctx);
        if let Some(a) = &rule.init_action {
            gen_action_body(w, a, ctx);
        }
    }
    // The atom seeds the accumulator (the left operand's value); each LR
    // continuation folds a right operand into it (`emit_lr_branch_body`).
    if emits_vals {
        w.line(&`let mut _lr_acc = ${*fn_name}_atom(p${fsep}, vals, min_prec);`);
    } else {
        w.line(&`${*fn_name}_atom(p${fsep}, min_prec);`);
    }
    w.line(&"p.b.finish_node(p.last_end());");
    // ATN-class LR: the suffix loop-entry can't be resolved by static
    // suffix-first tokens (a shared delimiter goes to the wrong alt), so the
    // runtime ATN simulator picks the continuation with full context, exactly
    // as the typed `gen_lr_suffix_dispatch_atn` does. The chosen suffix's body
    // appends to the builder; precedence is already accounted for by
    // `atn_lr_loop_decision`, so the per-branch precedence gate is dropped.
    if atn_class && loop_dec >= 0 {
        gen_lr_fn_atn(w, rule, lr_alts, lr_dispatch, ctx, &rk, loop_dec);
        emit_lr_after_return(w, rule, emits_vals, ctx);
        w.end();
        w.blank();
        return;
    }
    let scan_fn = `scan_${rule.snake_name}`;
    let labeled = rule_alts_labeled(&rule.alternatives);
    w.begin(&"loop");
    w.line(&"if p.recovering { break; }");
    w.line(&"let _sk = p.peek_kind();");
    let mut nc: List<[String, i32]> = [];
    let mut first = true;
    for let group of &lr_dispatch.groups {
        // Union of every member suffix's first set gates the group's arm.
        let mut union_first: List<String> = [];
        for let gi of group {
            for let tk of &lr_alts[lr_dispatch.valid_lr_alts[*gi]].suffix_first {
                if !union_first.contains(tk) {
                    union_first.push(*tk);
                }
            }
        }
        let cond = ctx.kind_check_str(&union_first, &"_sk");
        if first {
            w.begin(&`if ${cond}`);
            first = false;
        } else {
            w.else_begin(&`else if ${cond}`);
        }
        if group.len() == 1 {
            emit_lr_branch(w, &lr_alts[lr_dispatch.valid_lr_alts[group[0]]], rule, &rk, &scan_fn, labeled, ctx, &mut nc);
        } else {
            emit_lr_overlap(w, rule, lr_alts, lr_dispatch, group, &rk, &scan_fn, ctx, &mut nc);
        }
    }
    if first {
        w.line(&"break;");
    } else {
        w.else_begin(&"else");
        w.line(&"break;");
        w.end();
    }
    w.end();
    emit_lr_after_return(w, rule, emits_vals, ctx);
    w.end();
    w.blank();
}

/// Emit an LR rule's exit: bind the final accumulated `vals` (so `@after`'s
/// `$v` reads the whole expression's value), run `@after`, and return. ANTLR
/// runs `@after` once at `exitRule`, on the outermost (final) context. For a
/// channel-less rule this is just the `@after` side effect and a bare return.
fn emit_lr_after_return(w: &mut CodeWriter, rule: &ParserRule, emits_vals: bool, ctx: &mut GenContext) {
    let has_after = ctx.emit_actions() && rule.after_action matches { Some(_) };
    if emits_vals && has_after {
        // `@after` reads (and may write) the final value under the name `vals`.
        // The entry `vals` is still in scope (value semantics copied it into the
        // atom call), so reassign rather than redeclare.
        w.line(&"vals = _lr_acc;");
        if let Some(a) = &rule.after_action {
            gen_action_body(w, a, ctx);
        }
        w.line(&"return vals;");
    } else if emits_vals {
        w.line(&"return _lr_acc;");
    } else {
        if let Some(a) = &rule.after_action {
            if ctx.emit_actions() {
                gen_action_body(w, a, ctx);
            }
        }
        w.line(&"return;");
    }
}

/// ATN-class LR loop: the runtime simulator picks the suffix
/// continuation (`atn_lr_loop_decision`) with full context and the chosen
/// suffix's ops append to the builder, wrapping the tree so far in a new
/// same-rule node. Mirrors `gen_lr_suffix_dispatch_atn`. `min_prec` is
/// consumed by the simulator, so the per-branch
/// precedence gate is dropped.
fn gen_lr_fn_atn(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lr_alts: &List<LrAlt>,
    lr_dispatch: &LrDispatchData,
    ctx: &mut GenContext,
    rk: &String,
    decision: i32,
) {
    let valid = &lr_dispatch.valid_lr_alts;
    let labeled = rule_alts_labeled(&rule.alternatives);
    let mut nc: List<[String, i32]> = [];
    w.begin(&"loop");
    w.line(&"if p.recovering { break; }");
    w.line(
        &`let _atn_alt = atn_lr_loop_decision(&ATN_SIM, &p.atn_stack, ${decision}, &p.kinds, p.pos, TK_EOF, min_prec);`,
    );
    w.line(&"let _lr_pos0 = p.pos;");
    let mut is_first = true;
    for let mut i = 0; i < valid.len(); i += 1 {
        if is_first {
            w.begin(&`if _atn_alt == ${i}`);
            is_first = false;
        } else {
            w.else_begin(&`else if _atn_alt == ${i}`);
        }
        emit_lr_branch_body(w, &lr_alts[valid[i]], rule, rk, labeled, ctx, &mut nc);
    }
    if !is_first {
        w.else_begin(&"else");
        w.line(&"break;");
        w.end();
    } else {
        w.line(&"break;");
    }
    w.begin(&"if p.pos == _lr_pos0");
    w.line(&"break;");
    w.end();
    w.end();
}

/// One LR continuation: precedence gate, left-associative wrap,
/// suffix ops. Below `min_prec` the climb stops. First-token dispatch alone
/// can mis-predict an LR continuation when the suffix's first token is shared
/// with the atom (`statement: letterA | statement letterA 'b'` on `aa`): the
/// suffix begins to match then fails on a later element, corrupting the tree.
/// So consult the side-effect-free scan twin (`scan_<rule>_lr_<idx>`) and only
/// commit to the (mutating) suffix parse when the scan confirms it matches —
/// mirroring the typed `gen_lr_call_with_prec`.
fn emit_lr_branch(
    w: &mut CodeWriter,
    lr: &LrAlt,
    rule: &ParserRule,
    rk: &String,
    scan_fn: &String,
    labeled: bool,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
) {
    w.begin(&`if ${lr.own_prec} >= min_prec`);
    w.begin(&`if ${*scan_fn}_lr_${lr.alt_index}(&p.kinds, p.pos) < 0`);
    w.line(&"break;");
    w.end();
    emit_lr_branch_body(w, lr, rule, rk, labeled, ctx, nc);
    w.else_begin(&"else");
    w.line(&"break;");
    w.end();
}

/// The left-associative wrap + suffix ops shared by the static and ATN LR
/// loops: open a new same-rule node spanning the tree built so far, append
/// the suffix, close it.
fn emit_lr_branch_body(
    w: &mut CodeWriter,
    lr: &LrAlt,
    rule: &ParserRule,
    rk: &String,
    labeled: bool,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
) {
    w.line(&`p.b.start_node_at(_cp, ${*rk}, _start);`);
    // Stamp this continuation's labeled-alternative index on the wrap node
    // (gated on the rule being labeled, mirroring the atom path).
    if labeled {
        w.line(&`p.b.set_alt(${lr.alt_index});`);
    }
    // Value channel: bind the accumulated left operand under the stripped
    // leading self-ref's name (so `$l.v` reads it), and give this continuation a
    // fresh `vals` the suffix action writes (`$v`). The suffix's own right
    // operand is bound by its recursive call (`$r.v`). After the body, fold this
    // level's value back into the accumulator.
    let emits_vals = rule_emits_vals(ctx, rule);
    if emits_vals {
        w.line(&`let ${lr.prefix_self_ref.name} = _lr_acc;`);
        w.line(&`let mut vals = ${vals_struct_name(rule)} \{\};`);
    }
    // Interleave the alt's actions with the suffix ops. The LR rewrite strips
    // the leading self-ref (element 0), so an action at surface `before_index b`
    // runs before suffix op `b - 1`: pass the original `before` to
    // `gen_alt_actions_at` (before op `i` → `before == i + 1`, trailing →
    // `before == ops.len() + 1`). The alt-initial gate (`before == 0`) is never
    // reached here — it is an LR loop-entry decision, not a suffix action.
    let actions = &rule.alternatives[lr.alt_index].actions;
    let ops = &lr.suffix.ops;
    if ctx.emit_actions() {
        // The suffix ops give the right operand's binding; the stripped leading
        // self-ref (`$l`) falls back to `prefix_self_ref.name`, which is exactly
        // the `let {name} = _lr_acc;` bound above.
        ctx.set_alt_bindings(collect_alt_bindings(ops));
    }
    for let mut i = 0; i < ops.len(); i += 1 {
        gen_alt_actions_at(w, actions, i + 1, ctx);
        gen_op(w, &ops[i], ctx, nc);
    }
    gen_alt_actions_at(w, actions, ops.len() + 1, ctx);
    w.line(&"p.b.finish_node(p.last_end());");
    if emits_vals {
        w.line(&"_lr_acc = vals;");
    }
}

/// Overlap group (suffixes sharing a first token), unique first
/// tokens commit directly; a shared first token branches on `peek_at(1)` via
/// `compute_lr_second_token`, the last candidate falling through.
fn emit_lr_overlap(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lr_alts: &List<LrAlt>,
    lr_dispatch: &LrDispatchData,
    group: &List<i32>,
    rk: &String,
    scan_fn: &String,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
) {
    let labeled = rule_alts_labeled(&rule.alternatives);
    let mut first_sets: List<List<String>> = [];
    for let gi of group {
        first_sets.push(lr_alts[lr_dispatch.valid_lr_alts[*gi]].suffix_first);
    }
    let mut emitted: List<String> = [];
    let mut first_branch = true;
    for let mut k = 0; k < group.len(); k += 1 {
        for let tk of &first_sets[k] {
            if emitted.contains(tk) {
                continue;
            }
            let mut shared = false;
            for let mut j = 0; j < group.len(); j += 1 {
                if j != k && first_sets[j].contains(tk) {
                    shared = true;
                }
            }
            if !shared {
                if first_branch {
                    w.begin(&`if _sk == ${*tk}`);
                    first_branch = false;
                } else {
                    w.else_begin(&`else if _sk == ${*tk}`);
                }
                emit_lr_branch(w, &lr_alts[lr_dispatch.valid_lr_alts[group[k]]], rule, rk, scan_fn, labeled, ctx, nc);
                emitted.push(*tk);
            }
        }
    }
    let mut shared_tokens: List<String> = [];
    for let mut k = 0; k < group.len(); k += 1 {
        for let tk of &first_sets[k] {
            if emitted.contains(tk) || shared_tokens.contains(tk) {
                continue;
            }
            shared_tokens.push(*tk);
        }
    }
    for let shared_tk of &shared_tokens {
        if first_branch {
            w.begin(&`if _sk == ${*shared_tk}`);
            first_branch = false;
        } else {
            w.else_begin(&`else if _sk == ${*shared_tk}`);
        }
        let mut last_k = -1;
        for let mut k = 0; k < group.len(); k += 1 {
            if first_sets[k].contains(shared_tk) {
                last_k = k;
            }
        }
        let mut sub_first = true;
        for let mut k = 0; k < group.len(); k += 1 {
            if !first_sets[k].contains(shared_tk) {
                continue;
            }
            let lr = &lr_alts[lr_dispatch.valid_lr_alts[group[k]]];
            if k == last_k {
                if sub_first {
                    emit_lr_branch(w, lr, rule, rk, scan_fn, labeled, ctx, nc);
                } else {
                    w.else_begin(&"else");
                    emit_lr_branch(w, lr, rule, rk, scan_fn, labeled, ctx, nc);
                    w.end();
                }
            } else {
                let elements = &rule.alternatives[lr.alt_index].elements;
                let second = compute_lr_second_token(shared_tk, elements, ctx);
                let sub_cond = ctx.kind_check_str(&second, &"p.peek_at(1)");
                if sub_first {
                    w.begin(&`if ${sub_cond}`);
                    sub_first = false;
                } else {
                    w.else_begin(&`else if ${sub_cond}`);
                }
                emit_lr_branch(w, lr, rule, rk, scan_fn, labeled, ctx, nc);
            }
        }
        emitted.push(*shared_tk);
    }
    if !first_branch {
        w.end();
    }
}

/// Non-greedy `*?` / `+?` under the emitter: loop only while the
/// lowered static exit condition holds, so the inner yields the closing
/// delimiter to the continuation (the same gate cst_gen computes). `??` lowers
/// to `Plain` + `mark_needs_atn` and so never reaches here.
fn gen_repeat_non_greedy_body(w: &mut CodeWriter, r: &RepeatOp, ctx: &mut GenContext, nc: &mut List<[String, i32]>) {
    let cond = compute_non_greedy_condition(r, &r.caller_follow_first, &r.caller_follow_second, ctx);
    if cond == "false" && non_greedy_probe_decides(r, ctx) {
        if let Plus = r.kind {
            gen_op(w, &r.body, ctx, nc);
        }
        begin_non_greedy_probe_loop(w, r, ctx, nc);
        gen_op(w, &r.body, ctx, nc);
        w.end();
        return;
    }
    let loops = cond != "false";
    match r.kind {
        Plus => {
            gen_op(w, &r.body, ctx, nc);
            if loops {
                w.begin(&`while !p.recovering && (${cond})`);
                gen_op(w, &r.body, ctx, nc);
                w.end();
            }
        },
        Star => {
            if loops {
                w.begin(&`while !p.recovering && (${cond})`);
                gen_op(w, &r.body, ctx, nc);
                w.end();
            }
        },
        Optional => panic("gen_repeat_non_greedy_body: non-greedy `??` should be excluded by needs_atn"),
    }
}

/// Whether the exit probe can answer a loop whose static condition gave up
/// (`"false"` — the minimum match). Unlike the Optional the competing
/// readings are the loop's own, so `body_first_set` stands in for the
/// overlap; it also gates each iteration, hence non-empty.
fn non_greedy_probe_decides(r: &RepeatOp, ctx: &mut GenContext) -> bool {
    return r.kind matches { Star | Plus }
        && !r.body_first_set.is_empty()
        && probe_decides(&r.body_first_set, &r.body_first_set, &r.continuation_scan, r.continuation_scannable, ctx);
}

/// Open a non-greedy loop that exits only when exiting is viable. The caller
/// emits the body and closes the block, so both emit walkers share one
/// decision.
fn begin_non_greedy_probe_loop(
    w: &mut CodeWriter,
    r: &RepeatOp,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
) {
    w.begin(&"loop");
    w.line(&"if p.recovering { break; }");
    let verdict = dedup_name(&"ng_exit", nc);
    w.line(&`let mut ${verdict}: bool = false;`);
    gen_viability_probe(w, &r.continuation_scan, &verdict, &"ng_exit_scan", ctx, nc);
    w.line(&`if ${verdict} \{ break; \}`);
    w.line(&`if !(${ctx.first_check_str(&r.body_first_set)}) \{ break; \}`);
}

/// A labelled block that scans `continuation` from the parse position and,
/// when it matches, lets the caller's FOLLOW rule on everything past the
/// rule; `verdict` is the caller's already-declared `bool`. `prefix_scan`
/// runs first, for the entry probe's body.
fn gen_viability_probe(
    w: &mut CodeWriter,
    continuation: &List<ScanElement>,
    verdict: &String,
    label_base: &String,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
    prefix_scan: Option<ScanElement> = null,
) {
    let label = dedup_name(label_base, nc);
    w.begin(&`${label}:`);
    w.line(&"let tokens = &p.kinds;");
    w.line(&"let mut pos: i32 = p.pos;");
    let fail = `break ${label};`;
    if let Some(body) = prefix_scan {
        gen_scan_op_element(w, &body, ctx, &fail);
    }
    for let se of continuation {
        gen_scan_op_element(w, se, ctx, &fail);
    }
    if ctx.emit_follow() {
        w.line(&`if follow.is_empty() || follow_yields(tokens, pos, follow, TK_EOF) \{ ${*verdict} = true; \}`);
    } else {
        w.line(&`${*verdict} = true;`);
    }
    w.end();
}

/// Greedy `*` / `+` / `?` under the emitter: loop the body (which
/// appends), gated on the body's first set.
fn gen_repeat_body(w: &mut CodeWriter, r: &RepeatOp, ctx: &mut GenContext, nc: &mut List<[String, i32]>) {
    if let NonGreedy(_) = r.strategy {
        gen_repeat_non_greedy_body(w, r, ctx, nc);
        return;
    }
    // Scan-guarded `*` / `+`: when the body's first set overlaps the caller's
    // FOLLOW and the body is scannable, each iteration scans the whole body and
    // only commits on a match — so a trailing token a following `,?` wants is
    // yielded instead of greedily consumed (e.g. `(',' arm)* ','?`). `Optional`
    // never needs it.
    let overlaps_follow = sets_overlap(&r.body_first_set, &r.caller_follow_first);
    if r.body_scannable && overlaps_follow {
        let is_opt = if let Optional = r.kind {
            true;
        } else {
            false;
        };
        if !is_opt {
            if let Plus = r.kind {
                gen_op(w, &r.body, ctx, nc);
            }
            w.begin(&"loop");
            w.line(&"if p.recovering { break; }");
            if ctx.emit_follow() && r.gate_caller_follow {
                w.line(&"if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }");
            }
            let scan_pos = gen_rep_scan_guard(w, &r.scan_body, ctx, nc);
            w.line(&`if ${scan_pos} < 0 \{ break; \}`);
            gen_op(w, &r.body, ctx, nc);
            w.end();
            return;
        }
    }
    // A tail-greedy `Repeat` yields to the caller's continuation at runtime via
    // the FOLLOW gate (`follow` is threaded into the rule fn when emit_follow).
    let gate = if ctx.emit_follow() && r.gate_caller_follow {
        " && !follow_yields(&p.kinds, p.pos, follow, TK_EOF)";
    } else {
        "";
    };
    let cond = `${ctx.first_check_str(&r.body_first_set)}${gate}`;
    match r.kind {
        Optional => gen_op_optional(w, r, ctx, nc, &gate),
        Star => {
            w.begin(&`while !p.recovering && (${cond})`);
            gen_op(w, &r.body, ctx, nc);
            w.end();
        },
        Plus => {
            gen_op(w, &r.body, ctx, nc);
            w.begin(&`while !p.recovering && (${cond})`);
            gen_op(w, &r.body, ctx, nc);
            w.end();
        },
    }
}

/// `?` / `??` under the op-only walker (LR-suffix bodies and the group bodies
/// inside them), mirroring the surface-element walker's dispatch
/// (`gen_op_storable_optional` / `gen_op_transparent_optional`): a `??` asks the
/// runtime ATN, a shape lookahead branches per shape, and every other strategy
/// reduces to the single entry condition `gen_op_optional_entry_cond` builds.
/// `gate` is the walker's caller-FOLLOW yield suffix.
fn gen_op_optional(w: &mut CodeWriter, r: &RepeatOp, ctx: &mut GenContext, nc: &mut List<[String, i32]>, gate: &String) {
    if r.non_greedy && ctx.needs_atn() {
        w.begin(&`if ${atn_optional_enter_cond(ctx, r)}`);
        gen_op(w, &r.body, ctx, nc);
        w.end();
        return;
    }
    if let OptionalShapeLookahead(s) = &r.strategy {
        gen_op_optional_shape_lookahead(w, r, s, ctx, nc, gate);
        return;
    }
    let entry = `${gen_op_optional_entry_cond(w, r, ctx, nc)}${*gate}`;
    w.begin(&`if ${entry}`);
    gen_op(w, &r.body, ctx, nc);
    w.end();
}

/// Entry condition for an Optional strategy that reduces to one condition.
fn gen_op_optional_entry_cond(
    w: &mut CodeWriter,
    r: &RepeatOp,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
) -> String {
    return match &r.strategy {
        OptionalLookahead(s) => gen_lookahead_condition(ctx, &s.sig),
        OptionalScanGuard => {
            let scan_pos = gen_scan_guard_with_prefix(w, &r.scan_body, ctx, nc, &"opt_scan_pos", &"opt_scan", false);
            `${scan_pos} >= 0`;
        },
        Plain => ctx.first_check_str(&r.body_first_set),
        OptionalShapeLookahead(_) => panic(
            "gen_op_optional_entry_cond: shape lookahead has one condition per shape, not one for the optional",
        ),
        NonGreedy(_) => panic(
            "gen_op_optional_entry_cond: NonGreedy strategy reached the greedy-Optional arm — lower-side bug",
        ),
    };
}

/// Shape-lookahead Optional under the op-only walker: one branch per shape,
/// longest-first, each gated on that shape's own signature and emitting only the
/// positions the shape contains. The op-only analogue of
/// `gen_op_optional_with_shape_lookahead_transparent`, whose `unwrap_optional_op`
/// peel it shares — the shape already decided that a present nested optional
/// fires.
fn gen_op_optional_shape_lookahead(
    w: &mut CodeWriter,
    r: &RepeatOp,
    s: &OptionalShapeLookaheadStrategy,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
    gate: &String,
) {
    let body_ops = if let Group(g) = &r.body {
        g.alts[0].ops;
    } else {
        panic("gen_op_optional_shape_lookahead: shape lookahead is only valid on single-alt Group bodies");
    };
    let mut is_first = true;
    for let entry of &s.shapes {
        let cond = `${gen_lookahead_condition(ctx, &entry.sig)}${*gate}`;
        if is_first {
            w.begin(&`if ${cond}`);
            is_first = false;
        } else {
            w.else_begin(&`else if ${cond}`);
        }
        for let idx of &entry.positions {
            gen_op(w, unwrap_optional_op(&body_ops[*idx]), ctx, nc);
        }
    }
    if !is_first {
        w.end();
    }
}

/// Dispatch a `RepeatOp.body` whose shape is "storable" (a leaf op
/// or a `Group(SingleAlt | TokenOnly | SimpleCst | General)` op) to
/// the matching op-driven emit helper. Used by the Star / Plus and
/// non-greedy arms of `gen_op_repeat_with_follow_override` so the
/// loop body's per-iteration parse line can route through either
/// `gen_op_leaf` (leaves), the SingleAlt / TokenOnly op-driven
/// helpers, or the non-Option SimpleCst / General twins
/// (`gen_consume_group_store_op` / `gen_general_group_store_op`)
/// without duplicating the surrounding list / scan-guard / loop
/// scaffolding.
///
/// Dispatch is on `rep_op.body_shape`; lower asserts at construction
/// time that only the four reachable shapes appear, so emit's match
/// is exhaustive without a fall-through panic. `elem` is the surface
/// `Element` matching `op` — the Group arms thread it through the
/// per-shape `gen_consume_*_group_op` helpers for their
/// `&g_elem.alternatives` access. The leaf arm reads nothing from it
/// (sync now drives off `op.dedup_base`). `outer_follow` carries the
/// surrounding Repeat's iter-follow (`first(inner) ∪ outer_follow`)
/// so nested non-greedy Repeats inside a `SingleAlt` body can union
/// it onto their own `caller_follow_first`. `outer_follow` is unused
/// for the other group shapes today (their inner walkers consume the
/// baked `caller_follow_first` from lower).
///
/// The caller must have already verified storability —
/// `TransparentGroup` bodies are handled by
/// `gen_op_repeat_with_follow_override`'s non-storable Group arm.
fn gen_op_inner_for_storable_repeat(
    w: &mut CodeWriter,
    rep_op: &RepeatOp,
    elem: &Element,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    outer_follow: &List<String>,
) {
    let op = &rep_op.body;
    // `lower_repeat_op`'s list-label branch unwraps `Label(Group)` on
    // the body op; mirror the unwrap on the surface side so
    // `gen_op_storable_group_inner` sees a Group, not a Label.
    let unwrapped_elem = if let Label(lab) = elem {
        if lab.list {
            &lab.element;
        } else {
            elem;
        }
    } else {
        elem;
    };
    return match rep_op.body_shape {
        LeafRuleCall | LeafOther => gen_op_leaf(w, op, ctx, name_counts),
        StorableGroup => gen_op_storable_group_inner(w, op, unwrapped_elem, ctx, name_counts, outer_follow),
        TransparentGroup => panic(
            "gen_op_inner_for_storable_repeat: TransparentGroup body is not storable here — caller must dispatch via the non-storable arm",
        ),
    };
}

/// Inner dispatch for the `StorableGroup` arm of
/// `gen_op_inner_for_storable_repeat`. Splits on `GroupShape`; lower
/// guarantees the body op is `Op::Group(_)` with a non-Transparent
/// shape, so the match below is exhaustive over the storable shapes.
fn gen_op_storable_group_inner(
    w: &mut CodeWriter,
    op: &Op,
    elem: &Element,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    outer_follow: &List<String>,
) {
    let g_op = if let Group(g) = op {
        g;
    } else {
        panic("gen_op_storable_group_inner: lower marked StorableGroup but body is not Op::Group");
    };
    let g_elem = if let Group(g) = elem {
        g;
    } else {
        panic("gen_op_storable_group_inner: surface element is not Group");
    };
    return match &g_op.shape {
        TokenOnly(to) => gen_consume_token_group_op(w, to, &g_elem.alternatives, name_counts),
        SingleAlt(_) => gen_consume_single_alt_group_op(
            w,
            &g_op.alts[0],
            &g_elem.alternatives[0],
            ctx,
            name_counts,
            outer_follow,
        ),
        SimpleCst(scst) => gen_consume_group_store_op(
            w,
            scst,
            &g_op.alts,
            &g_op.scan_alts,
            &g_elem.alternatives,
            ctx,
            name_counts,
        ),
        General(gs) => gen_general_group_store_op(
            w,
            gs,
            &g_op.alts,
            &g_op.scan_alts,
            &g_elem.alternatives,
            ctx,
            name_counts,
        ),
        Transparent => panic("gen_op_storable_group_inner: lower marked StorableGroup but shape is Transparent"),
    };
}

/// Op-driven single-element dispatch. Routes a single `Op` + matching
/// surface `Element` to the right `gen_op_*` helper based on op kind.
/// Used by `gen_op_optional_with_shape_lookahead_*` so each shape's
/// per-element parse routes through op-driven helpers instead of the
/// surface `gen_element` graph.
fn gen_op_dispatch_element(
    w: &mut CodeWriter,
    op: &Op,
    elem: &Element,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    match op {
        Token(_) | Literal(_) | RuleCall(_) | Wildcard(_) | Excluded(_) => gen_op_leaf(w, op, ctx, name_counts),
        Repeat(rep_op) => {
            let rep = if let Repeat(r) = elem {
                r;
            } else {
                panic("gen_op_dispatch_element: Repeat op mapped to non-Repeat element");
            };
            gen_op_repeat(w, rep, rep_op, ctx, name_counts);
        },
        Group(g_op) => gen_op_group(w, g_op, elem, ctx, name_counts),
        ListLabel(ll) => gen_op_list_label(w, ll, elem, ctx, name_counts),
    }
}

/// Op-driven `unwrap_optional` analogue. Peels through an Optional
/// `Op::Repeat` wrapper to its inner op. Used by the Transparent
/// shape-lookahead walker so each present optional element is
/// dispatched at its unwrapped op (which carries the actual emit
/// shape) rather than through `gen_op_repeat`'s optional gate (the
/// shape already promised the element is present).
fn unwrap_optional_op(op: &Op) -> &Op with stores[op] {
    if let Repeat(rep_op) = op {
        if let Optional = rep_op.kind {
            return &rep_op.body;
        }
    }
    return op;
}

/// Op-driven scan-guard for a `Group`-shaped Optional inner. Mirrors
/// `gen_rep_scan_guard` but walks the scan side via op-driven
/// helpers (`gen_scan_op_elements_in_block` / `gen_scan_op_group`)
/// using `g_op.scan_alts` / `g_op.scan_dispatch` directly, instead
/// of the surface `gen_scan_elements_in_block` / `gen_scan_group`
/// graph. `g_elem` is the surface `Group` matching `g_op`; it is
/// consulted only to compute per-alt first sets for the multi-alt
/// dispatch (lower bakes these on `ScanGroupElement.alt_first_sets` but
/// the `GroupOp` itself does not surface them — recomputing matches
/// what `lower_scan_group` does).
fn gen_op_opt_scan_guard_for_group(
    w: &mut CodeWriter,
    g_op: &GroupOp,
    g_elem: &GroupElement,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) -> String {
    let scan_pos_var = dedup_name(&"opt_scan_pos", name_counts);
    let scan_label = dedup_name(&"opt_scan", name_counts);
    w.line(&`let mut ${scan_pos_var}: i32 = -1;`);
    w.begin(&`${scan_label}:`);
    w.line(&"let tokens = &p.kinds;");
    w.line(&"let mut pos: i32 = p.pos;");
    let fail = `break ${scan_label};`;
    if g_op.scan_alts.len() == 1 {
        let body = &g_op.scan_alts[0];
        gen_scan_op_elements_in_block(w, &body.elements, 0, body.elements.len(), ctx, &scan_label);
    } else {
        let mut alt_first_sets: List<List<String>> = [];
        let mut wildcard_indices: List<i32> = [];
        for let mut ai = 0; ai < g_elem.alternatives.len(); ai += 1 {
            let alt = &g_elem.alternatives[ai];
            let mut visiting: List<String> = [];
            alt_first_sets.push(ctx.first_of_alt(alt, &mut visiting));
            if alt_is_wildcard_led(alt) {
                wildcard_indices.push(ai);
            }
        }
        let scan_elem = ScanGroupElement {
            alts: g_op.scan_alts,
            dispatch: g_op.scan_dispatch,
            lenient: false,
            alt_first_sets,
            wildcard_alt_indices: wildcard_indices,
        };
        gen_scan_op_group(w, &scan_elem, ctx, &fail, false);
    }
    w.line(&`${scan_pos_var} = pos;`);
    w.end();
    return scan_pos_var;
}

/// Op-driven emit for Optional + storable Group. Dispatches on
/// `rep_op.strategy`. The Optional-specialised strategies
/// (`OptionalLookahead`, `OptionalShapeLookahead`, `OptionalScanGuard`)
/// are produced by lower's `pick_optional_specialised`; when none
/// applies, lower falls back to `Plain`. `NonGreedy` only fires for
/// `*?` / `+?` and is handled by `gen_op_repeat_non_greedy`, so this
/// `match` is exhaustive over the strategies a greedy `?` can carry.
///
/// In every case the inner parse routes through op-driven helpers
/// (`gen_op_inner_for_storable_repeat`, `gen_op_dispatch_element`).
fn gen_op_storable_optional(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    g_op: &GroupOp,
    g_elem: &GroupElement,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let opt_field = rep_op.field;
    let _ = dedup_name(&opt_field, name_counts);
    let inner_elem = &rep.element;

    // Non-greedy `??`: the enter/skip decision is taken at runtime by the
    // ATN simulator (full context), not by the static first-set check.
    if rep.non_greedy && ctx.needs_atn() {
        gen_op_storable_optional_with_first(
            w,
            rep_op,
            inner_elem,
            ctx,
            &atn_optional_enter_cond(ctx, rep_op),
        );
        return;
    }

    return match &rep_op.strategy {
        OptionalLookahead(s) => gen_op_storable_optional_with_first(
            w,
            rep_op,
            inner_elem,
            ctx,
            &gate_cond_with_caller_follow(&gen_lookahead_condition(ctx, &s.sig), rep_op.gate_caller_follow),
        ),
        OptionalShapeLookahead(s) => gen_op_optional_with_shape_lookahead_storable(
            w,
            g_op,
            g_elem,
            s,
            ctx,
            name_counts,
            rep_op.gate_caller_follow,
        ),
        OptionalScanGuard => {
            let scan_pos_var = gen_op_opt_scan_guard_for_group(w, g_op, g_elem, ctx, name_counts);
            gen_op_storable_optional_with_first(
                w,
                rep_op,
                inner_elem,
                ctx,
                &gate_cond_with_caller_follow(&`${scan_pos_var} >= 0`, rep_op.gate_caller_follow),
            );
        },
        // `pick_optional_specialised` returned `null`: gate on
        // `body_first_set` (`Plain`).
        Plain => gen_op_storable_optional_with_first(
            w,
            rep_op,
            inner_elem,
            ctx,
            &gate_cond_with_caller_follow(&ctx.first_check_str(&rep_op.body_first_set), rep_op.gate_caller_follow),
        ),
        // `NonGreedy` is caught upstream by `gen_op_repeat_non_greedy`;
        // reaching here is a lower-side bug.
        NonGreedy(_) => panic(
            "gen_op_storable_optional: NonGreedy strategy reached the greedy-Optional dispatcher — lower-side bug",
        ),
    };
}

/// Runtime entry condition for a non-greedy `??`: the ATN simulator decides
/// enter vs skip with full context. The exact ATN decision number is stamped
/// at compile time (`RepeatElement.atn_decision` -> `Atn.decision_sites`), so
/// each `??` predicts its own decision — several `??` in one rule no longer
/// collide on the retired "unique exit-first BlockStart" search. Non-greedy
/// optional edges are ordered `[exit=0, enter=1]`, so ENTER iff the simulator
/// returns alt 1.
fn atn_optional_enter_cond(ctx: &GenContext, rep_op: &RepeatOp) -> String {
    let rule = ctx.current_rule_index();
    let decision = ctx.atn_decision_site(rep_op.atn_decision);
    if decision < 0 {
        return "true";
    }
    // A non-greedy `??` predicts enter-vs-skip with the rule's live
    // precedence: inside a left-recursive rule the parser can be invoked with
    // a raised `min_prec`, so the prediction must prune LR enter edges below
    // it (otherwise it keeps an impossible suffix and wrongly SKIPs). The
    // `min_prec` variable is only in scope in a left-recursive rule's bodies
    // (atom, inlined suffix); a plain rule has no precedence climbing, so it is
    // always invoked at 0 and its fns carry no `min_prec` parameter — pass the
    // literal `0` there.
    let prec_arg = if ctx.lr_loop_entry_decision(rule) >= 0 { "min_prec" } else { "0" };
    return `atn_predict_with_stack(&ATN_SIM, ${decision}, &p.atn_stack, &p.kinds, p.pos, TK_EOF, ${prec_arg}) == 1`;
}

/// Wrap a raw Optional entry condition with the runtime caller-FOLLOW
/// yield gate: `!(follow_yields(...)) && (cond)` when the Repeat is
/// tail-position (`gate_caller_follow`), so the Optional fires only when
/// the caller's continuation does NOT claim the upcoming tokens; the
/// unchanged `cond` otherwise. The Group-bodied counterpart of
/// `gen_op_repeat_optional_{leaf,rulecall}`'s gate.
fn gate_cond_with_caller_follow(cond: &String, gate_caller_follow: bool) -> String {
    if gate_caller_follow {
        return `!(follow_yields(&p.kinds, p.pos, follow, TK_EOF)) && (${*cond})`;
    }
    return *cond;
}

/// Shared body of every storable-Optional + Group arm: emit a single
/// `let ${opt_field}: Option<T> = if ${cond} { parse; Some(...) } else
/// { null };`. Caller computes the gate condition (`gen_lookahead_condition`,
/// `body_first_set`, scan-pos check, etc.).
fn gen_op_storable_optional_with_first(
    w: &mut CodeWriter,
    rep_op: &RepeatOp,
    inner_elem: &Element,
    ctx: &mut GenContext,
    cond: &String,
) {
    // the inner body appends to the builder, so the
    // `Option<T>` wrapper collapses to a present/absent statement.
    w.begin(&`if ${*cond}`);
    let mut nch: List<[String, i32]> = [];
    gen_op_inner_for_storable_repeat(w, rep_op, inner_elem, ctx, &mut nch, &([] as List<String>));
    w.end();
}

/// Op-driven emit for Optional + non-storable (Transparent) Group.
/// Dispatches on `rep_op.strategy`. Strategy coverage mirrors
/// `gen_op_storable_optional` — Optional-specialised shapes from
/// `pick_optional_specialised` plus the `Plain` fallback. No outer
/// `Option<T>` wrapping; each branch inlines the inner alt directly.
fn gen_op_transparent_optional(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    g_op: &GroupOp,
    g_elem: &GroupElement,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let _ = dedup_name(&rep_op.field, name_counts);

    // Non-greedy `??`: runtime ATN decision (see gen_op_storable_optional).
    if rep.non_greedy && ctx.needs_atn() {
        gen_op_transparent_optional_with_cond(w, g_op, g_elem, ctx, &atn_optional_enter_cond(ctx, rep_op));
        return;
    }

    return match &rep_op.strategy {
        OptionalShapeLookahead(s) => gen_op_optional_with_shape_lookahead_transparent(
            w,
            g_op,
            g_elem,
            s,
            ctx,
            name_counts,
            rep_op.gate_caller_follow,
        ),
        OptionalLookahead(s) => gen_op_transparent_optional_with_cond(
            w,
            g_op,
            g_elem,
            ctx,
            &gate_cond_with_caller_follow(&gen_lookahead_condition(ctx, &s.sig), rep_op.gate_caller_follow),
        ),
        OptionalScanGuard => {
            let scan_pos_var = gen_op_opt_scan_guard_for_group(w, g_op, g_elem, ctx, name_counts);
            gen_op_transparent_optional_with_cond(w, g_op, g_elem, ctx, &gate_cond_with_caller_follow(
                &`${scan_pos_var} >= 0`,
                rep_op.gate_caller_follow,
            ));
        },
        Plain => gen_op_transparent_optional_with_cond(w, g_op, g_elem, ctx, &gate_cond_with_caller_follow(
            &ctx.first_check_str(&rep_op.body_first_set),
            rep_op.gate_caller_follow,
        )),
        NonGreedy(_) => panic(
            "gen_op_transparent_optional: NonGreedy strategy reached the greedy-Optional dispatcher — lower-side bug",
        ),
    };
}

/// Shared body of every transparent-Optional + Group arm: emit
/// `if ${cond} { /* inline inner alt's elements */ }`. Caller computes
/// the gate condition.
fn gen_op_transparent_optional_with_cond(
    w: &mut CodeWriter,
    g_op: &GroupOp,
    g_elem: &GroupElement,
    ctx: &mut GenContext,
    cond: &String,
) {
    w.begin(&`if ${*cond}`);
    let mut nc: List<[String, i32]> = [];
    let body = &g_op.alts[0];
    let alt = &g_elem.alternatives[0];
    for let mut i = 0; i < alt.elements.len(); i += 1 {
        gen_op_dispatch_element(w, &body.ops[i], &alt.elements[i], ctx, &mut nc);
    }
    w.end();
}

/// Op-driven shape-lookahead emit for the storable Optional + SingleAlt
/// case. Mirrors `gen_storable_optional_with_lookahead` exactly except
/// the inner per-element parse routes through op-driven dispatch
/// (`gen_op_dispatch_element`), and
/// the struct construction reads `body.fields` (lower's canonical
/// field list).
fn gen_op_optional_with_shape_lookahead_storable(
    w: &mut CodeWriter,
    g_op: &GroupOp,
    g_elem: &GroupElement,
    s: &OptionalShapeLookaheadStrategy,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    gate_caller_follow: bool,
) {
    if let SingleAlt(_) = &g_op.shape {
    } else {
        panic("gen_op_optional_with_shape_lookahead_storable: shape lookahead is only valid on SingleAlt Group inners");
    }
    let body = &g_op.alts[0];
    let alt = &g_elem.alternatives[0];
    let elements = &alt.elements;
    // the present elements append to the builder, so the
    // `Option<T>` shape selection collapses to a plain `if cond { … } else if
    // … ` statement — no struct, no absent-field decls, no `null` else.
    let mut is_first = true;
    for let entry of &s.shapes {
        // K-prefix gate: every shape's entry condition must yield to
        // the caller when the deterministic K-prefix matches, so wrap
        // each entry's condition with `!(K_match) && (cond)`.
        let cond = gate_cond_with_caller_follow(&gen_lookahead_condition(ctx, &entry.sig), gate_caller_follow);

        if is_first {
            w.begin(&`if ${cond}`);
            is_first = false;
        } else {
            w.else_begin(&`else if ${cond}`);
        }

        let mut nc: List<[String, i32]> = [];
        for let mut i = 0; i < elements.len(); i += 1 {
            let mut in_shape = false;
            for let mut k = 0; k < entry.positions.len(); k += 1 {
                if entry.positions[k] == i {
                    in_shape = true;
                }
            }
            if in_shape {
                gen_op_dispatch_element(w, &body.ops[i], &elements[i], ctx, &mut nc);
            }
        }
    }
    if !is_first {
        w.end();
    }
}

/// Op-driven shape-lookahead emit for the Transparent Optional case.
/// Mirrors `gen_optional_with_lookahead`: each shape branch walks
/// only the present-positions, peeling Optional Repeats via
/// `unwrap_optional` / `unwrap_optional_op` so the inner parse is
/// dispatched directly at the unwrapped op shape (the shape already
/// promised the optional fires). No struct construction.
fn gen_op_optional_with_shape_lookahead_transparent(
    w: &mut CodeWriter,
    g_op: &GroupOp,
    g_elem: &GroupElement,
    s: &OptionalShapeLookaheadStrategy,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    gate_caller_follow: bool,
) {
    let body = &g_op.alts[0];
    let alt = &g_elem.alternatives[0];
    let elements = &alt.elements;

    let mut is_first = true;
    for let entry of &s.shapes {
        // K-prefix gate: every shape entry's condition must yield to
        // the caller when the deterministic K-prefix matches, so wrap
        // each entry's condition with `!(K_match) && (cond)`.
        let cond = gate_cond_with_caller_follow(&gen_lookahead_condition(ctx, &entry.sig), gate_caller_follow);

        if is_first {
            w.begin(&`if ${cond}`);
            is_first = false;
        } else {
            w.else_begin(&`else if ${cond}`);
        }

        let mut nc: List<[String, i32]> = [];
        for let mut k = 0; k < entry.positions.len(); k += 1 {
            let idx = entry.positions[k];
            let elem = &elements[idx];
            let body_op = &body.ops[idx];
            let actual_elem = unwrap_optional(elem);
            let actual_op = unwrap_optional_op(body_op);
            if let Group(g) = actual_elem {
                if g.alternatives.len() == 1 {
                    if let Group(inner_g_op) = actual_op {
                        let inner_body = &inner_g_op.alts[0];
                        let inner_alt = &g.alternatives[0];
                        for let mut j = 0; j < inner_alt.elements.len(); j += 1 {
                            gen_op_dispatch_element(w, &inner_body.ops[j], &inner_alt.elements[j], ctx, &mut nc);
                        }
                    } else {
                        panic(
                            "gen_op_optional_with_shape_lookahead_transparent: single-alt Group surface but non-Group op",
                        );
                    }
                } else {
                    gen_op_dispatch_element(w, actual_op, actual_elem, ctx, &mut nc);
                }
            } else {
                gen_op_dispatch_element(w, actual_op, actual_elem, ctx, &mut nc);
            }
        }
    }
    if !is_first {
        w.end();
    }
}

/// Bump `name_counts` for a leaf `Op` exactly the way `gen_element`
/// would have, by reading the lower-baked `dedup_base`. Used by
/// `gen_op_leaf` so siblings that still route through the surface
/// walker see lower-consistent dedup state.
///
/// `dedup_base` is the base name lower bumped in the alt's outer
/// `name_counts` when it computed `op.field`: the surface
/// `field_name` / `literal_field_name(text)` / `"wildcard"` /
/// `not_element_field_name(...)` for non-rebound leaves. For the
/// scalar-label rebind (`name = elem`) the inner op's `dedup_base`
/// is replaced with `lab.field_name` (the rebound label's base) by
/// `lower_label_op`'s `rebind_op_field` call: the rebind elides the
/// inner element's binding from emit, so the only name that surfaces
/// is the label's, and bumping the inner base would drift from
/// what's actually in scope.
fn sync_name_counts_for_op_leaf(op: &Op, name_counts: &mut List<[String, i32]>) {
    let _ = dedup_name(&op_leaf_dedup_base(op), name_counts);
}

/// Read the `dedup_base` slot from any leaf op variant. Panics on
/// non-leaf ops because callers (`gen_op_leaf`, the list-label sync)
/// already gate with `op_is_leaf`.
fn op_leaf_dedup_base(op: &Op) -> String {
    return match op {
        Token(t) => t.dedup_base,
        Literal(l) => l.dedup_base,
        RuleCall(r) => r.dedup_base,
        Wildcard(w) => w.dedup_base,
        Excluded(e) => e.dedup_base,
        // Non-leaf ops have no `dedup_base` to read.
        Repeat(_) | Group(_) | ListLabel(_) => panic("op_leaf_dedup_base: caller must guard with op_is_leaf"),
    };
}

/// Top-level dispatch for `Op::Group(g_op)`. Reads `g_op.shape` to
/// pick the matching emit shape; reads the deduped field name and
/// struct / variant type names straight from the shape payload
/// instead of recomputing via `single_alt_group_type_name` /
/// `token_group_field_name` / etc. Inner element emission still
/// flows through surface `gen_elements_with_non_greedy` for now —
/// `gen_consume_*_op` helpers consult `g_op.alts[k].fields` for the
/// final struct-literal field list (GIR-canonical) but parse the
/// alt body via the surface walker that hasn't migrated yet.
///
/// `elem` is the matching `Element::Group(g_surface)`; the surface
/// reference flows into `gen_elements_with_non_greedy` and surface
/// dedup so siblings continue to see lower-consistent state. The
/// surface fallback in `gen_element`'s Group arm remains until every
/// caller routes through `gen_op_group` (Phase 2-B follow-ups).
fn gen_op_group(
    w: &mut CodeWriter,
    g_op: &GroupOp,
    elem: &Element,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    // Scalar `name=(a | b | …)` lowers via `rebind_op_field` so the
    // resulting op is `Op::Group` even though the surface element is
    // `Label(Group(...))`. Peel here — the single canonical site —
    // so every call path (walkers, Repeat-body helpers, LR helpers)
    // is safe without each caller having to remember to unwrap. The
    // `peel_scalar_label` helper handles theoretical multi-level
    // scalar Label nesting; lower does not produce that today, but
    // the loop costs nothing.
    if let Group(g_elem) = peel_scalar_label(elem) {
        return match &g_op.shape {
            TokenOnly(to) => gen_consume_token_group_op(w, to, &g_elem.alternatives, name_counts),
            SingleAlt(_) => gen_consume_single_alt_group_op(
                w,
                &g_op.alts[0],
                &g_elem.alternatives[0],
                ctx,
                name_counts,
                &([] as List<String>),
            ),
            SimpleCst(scst) => gen_consume_group_store_optional_op(
                w,
                scst,
                &g_op.alts,
                &g_op.scan_alts,
                &g_elem.alternatives,
                ctx,
                name_counts,
            ),
            General(gen_shape) => gen_general_group_store_optional_op(
                w,
                gen_shape,
                &g_op.alts,
                &g_op.scan_alts,
                &g_elem.alternatives,
                ctx,
                name_counts,
            ),
            Transparent => {
                // Transparent groups inline their inner alt; walk
                // `g_op.alts[0].ops` directly via the op-driven
                // element walker rather than constructing a CST
                // wrapper. Its actions are inlined with it, so inside a
                // Repeat they run once per iteration.
                let body = &g_op.alts[0];
                let alt = &g_elem.alternatives[0];
                gen_elements_with_non_greedy(
                    w,
                    &alt.elements,
                    &body.ops,
                    ctx,
                    name_counts,
                    &([] as List<String>),
                    &alt.actions,
                );
            },
        };
    } else {
        panic(
            "gen_op_group: Group op mapped to non-Group element (even after peel_scalar_label) — lower produced an Op::Group whose surface element is neither Group nor Label-of-Group",
        );
    }
}

/// Token-only group emit (`(K_A | K_B | …)`): `lower` matched the
/// shape and assigned the outer field name in `TokenOnlyShape.field`.
/// `alts` carries the token kinds of the alternatives — the emit gates
/// `p.advance()` on a `expect_set` check so a token outside the group
/// fails cleanly instead of being silently consumed. ANTLR4 reports a
/// `NoViableAltException` at the same site.
fn gen_consume_token_group_op(
    w: &mut CodeWriter,
    to: &TokenOnlyShape,
    alts: &List<Alternative>,
    name_counts: &mut List<[String, i32]>,
) {
    let _ = dedup_name(&token_group_field_name(alts), name_counts);
    let kinds = collect_token_only_kinds(alts);
    w.line(&`let ${to.field} = p.expect_set([${kinds}]);`);
}

/// Render the comma-separated list of token-kind constants for a
/// token-only group's alternatives. Each alt has exactly one element
/// (a `TokenRef` or `Literal`), guaranteed by `is_token_only_group`.
fn collect_token_only_kinds(alts: &List<Alternative>) -> String {
    let mut out = String::with_capacity(32);
    for let mut i = 0; i < alts.len(); i += 1 {
        if i > 0 {
            out.push_str(&", ");
        }
        let elem = &alts[i].elements[0];
        if let TokenRef(t) = elem {
            out.push_str(&`TK_${t.name}`);
        } else if let Literal(l) = elem {
            out.push_str(&literal_const_name(&l.text));
        } else {
            panic("collect_token_only_kinds: token-only group alt is not TokenRef or Literal");
        }
    }
    return out;
}

/// Single-alt group emit `(e1 e2 …)`: parse each inner element (each appends
/// its tokens / sub-nodes to the builder). Inner element parsing walks surface
/// IR via `gen_elements_with_non_greedy`.
fn gen_consume_single_alt_group_op(
    w: &mut CodeWriter,
    body: &AltBody,
    alt: &Alternative,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    outer_follow: &List<String>,
) {
    let _ = dedup_name(&single_alt_group_field_name(alt), name_counts);
    // Nested General-group emitters consume `GeneralShape.variant_type`
    // / `alt_struct_names` baked by `lower_single_alt_group` under
    // the SingleAlt's owner rule, so no walker-field swap is needed here.
    gen_elements_with_non_greedy(w, &alt.elements, &body.ops, ctx, name_counts, outer_follow);
    // the inner elements already appended; no struct.
}

/// Emit `name+=elem` outside a Repeat: allocate the array, parse the
/// inner op once, push the resulting binding. Lower stores the label
/// name in `ll.field` and the inner op in `ll.inner` (carrying its
/// own `field` already deduped against the label's fresh inner scope).
/// `elem` is the matching surface `Label(lab)` with `lab.list == true`
/// — consulted only by `sync_name_counts_for_label` to keep the
/// outer scope's dedup counters consistent with surface emitters that
/// still inspect `name_counts`.
fn gen_op_list_label(
    w: &mut CodeWriter,
    ll: &ListLabelOp,
    elem: &Element,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let lab = if let Label(l) = elem {
        l;
    } else {
        panic("gen_op_list_label: ListLabel op mapped to non-Label element");
    };
    if let Group(g_op) = &ll.inner {
        // Non-leaf inner of shape `Op::Group` (e.g.
        // `items += (a | b)` outside a Repeat). Allocate the array
        // ourselves, dispatch the inner Group via `gen_op_group`
        // (which emits `let <shape.field> = ...;`), then push.
        // Mirrors the leaf path's structure but routes inner emit
        // through GIR rather than surface `gen_element`.
        // the inner Group appends to the builder; drop
        // the `List<T>` container and its `.push`.
        sync_name_counts_for_op_list_label(ll, name_counts);
        gen_op_group(w, g_op, &lab.element, ctx, name_counts);
        return;
    }
    if !op_is_leaf(&ll.inner) {
        // Inner of shape `Op::Repeat` / nested `Op::ListLabel` —
        // rare; routes through the surface walker. Phase 2-C migrates
        // the Op::Repeat arm.
        gen_element(w, elem, ctx, name_counts);
        return;
    }
    sync_name_counts_for_op_list_label(ll, name_counts);
    // Non-Repeat list label emits both lines in the alt's outer
    // scope, so the per-iter binding must differ from the container.
    // When lower already chose the same name for both (e.g. `if+=IF`
    // after the keyword rename), suffix `_item` locally — perturbing
    // lower's `name_counts` here would desync the visitor's parallel
    // naming pipeline. The Repeat case is handled in `lower_repeat_op`
    // by pre-seeding `inner_counts`.
    let leaf = if op_field(&ll.inner) == ll.field {
        rebind_op_field(*&ll.inner, &`${ll.field}_item`, &op_leaf_dedup_base(&ll.inner));
    } else {
        *&ll.inner;
    };
    gen_op_leaf(w, &leaf, ctx, name_counts);
}

/// Mirror `gen_element`'s Label arm side-effects on `name_counts`:
/// bump for the label's own name (`ll.dedup_base`) and recurse into
/// the inner leaf so any sibling that still routes through the
/// surface walker observes lower-consistent dedup state.
fn sync_name_counts_for_op_list_label(ll: &ListLabelOp, name_counts: &mut List<[String, i32]>) {
    let _ = dedup_name(&ll.dedup_base, name_counts);
    if op_is_leaf(&ll.inner) {
        sync_name_counts_for_op_leaf(&ll.inner, name_counts);
    }
}

/// Read the deduped field name from any `Op`. Mirrors the
/// `<variant>.field` lookups inlined throughout the emit body.
fn op_field(op: &Op) -> String {
    return match op {
        Token(t) => t.field,
        Literal(l) => l.field,
        RuleCall(r) => r.field,
        Wildcard(w) => w.field,
        Excluded(e) => e.field,
        Repeat(r) => r.field,
        Group(g) => match &g.shape {
            Transparent => panic("op_field: Transparent group has no own field"),
            TokenOnly(to) => to.field,
            SimpleCst(scst) => scst.field,
            SingleAlt(sa) => sa.field,
            General(gen) => gen.field,
        },
        ListLabel(ll) => ll.field,
    };
}

/// Render the `p.expect_not([…])` expression for an `Op::Excluded`.
/// Lower interns multi-element exclusion sets via
/// `ctx.intern_kind_set`; if a future slice routes those through the
/// generated `_kind_set_<id>_expect_not` helper this is the
/// single call site to update.
fn gen_op_excluded_call(e: &ExcludedOp) -> String {
    let mut list = String::with_capacity(32);
    for let mut i = 0; i < e.kinds.len(); i += 1 {
        if i > 0 {
            list.push_str(&", ");
        }
        list.push_str(&e.kinds[i]);
    }
    return `p.expect_not([${list}])`;
}

fn gen_element(w: &mut CodeWriter, elem: &Element, ctx: &mut GenContext, name_counts: &mut List<[String, i32]>) {
    match elem {
        TokenRef(t) => {
            let field_name = dedup_name(&t.field_name, name_counts);
            w.line(&`let ${field_name} = p.expect(TK_${t.name}, &EMPTY_SYNC);`);
        },
        Literal(l) => {
            let const_name = literal_const_name(&l.text);
            let field_name = dedup_name(&literal_field_name(&l.text), name_counts);
            w.line(&`let ${field_name} = p.expect(${const_name}, &EMPTY_SYNC);`);
        },
        // Per-call-site FOLLOW args are baked on `RuleCallOp.follow_arg`
        // by lower and consumed by the op-driven walkers; this surface arm
        // only fires for legacy paths (Label inner / LR-suffix fallback /
        // Consume node) where the call needs no follow argument and so
        // passes the defaulted `&EMPTY_FOLLOW`. Prefix LR alts' trailing
        // self-ref is reached via `gen_op_leaf` on `RuleCallOp.min_prec_arg`,
        // so precedence is never threaded here either.
        RuleRef(r) => {
            let field_name = dedup_name(&r.field_name, name_counts);
            gen_atn_ret_pending(w, ctx, r.atn_call_site);
            w.line(&`let ${field_name} = _parse_${r.snake_name}(p);`);
        },
        Wildcard(_) => {
            let field_name = dedup_name(&"wildcard", name_counts);
            w.line(&`let ${field_name} = p.any();`);
        },
        Not(ne) => {
            let field_name = dedup_name(&not_element_field_name(&ne.element), name_counts);
            let check = not_match_call(&ne.element);
            w.line(&`let ${field_name} = ${check};`);
        },
        // After the Phase 2-G op-driven migration, only token-only groups
        // reach this surface walker — every other Group classification
        // (SimpleCst, SingleAlt, General) is handled by op-driven walkers
        // before `gen_element` is invoked.
        Group(g) => {
            assert is_token_only_group(&g.alternatives), "gen_element: only token-only groups reach the surface walker; other classifications must be handled op-driven before gen_element is invoked";
            gen_consume_token_group(w, &g.alternatives, ctx, name_counts);
        },
        Label(lab) => {
            if lab.list {
                // Bare list label: allocate the array, parse the inner element
                // once, and push. Repeats wrap this via gen_repeat below.
                let inner_info = element_field_info(&lab.element);
                let lab_name = dedup_name(&lab.field_name, name_counts);
                w.line(&`let mut ${lab_name}: List<${inner_info.1}> = [];`);
                let predicted_inner = peek_dedup_name(&inner_info.0, name_counts);
                gen_element(w, &lab.element, ctx, name_counts);
                w.line(&`${lab_name}.push(${predicted_inner});`);
            } else {
                // Scalar label `name = element`: parse the inner element with
                // the shared `name_counts` so its emitted binding dedups
                // against the outer alt's scope (otherwise `a=e ... b=e` would
                // emit two top-level `let e = _parse_e(p);` and the second
                // would fail compilation with "cannot redeclare e"). Then
                // re-bind under the label name so the struct initializer
                // resolves. Peek the dedup'd inner name before calling
                // `gen_element`, which performs the actual increment.
                let lab_name = dedup_name(&lab.field_name, name_counts);
                let inner_info = element_field_info(&lab.element);
                let predicted_inner = peek_dedup_name(&inner_info.0, name_counts);
                gen_element(w, &lab.element, ctx, name_counts);
                w.line(&`let ${lab_name} = ${predicted_inner};`);
            }
        },
        // Every op-driven Repeat dispatch flows through
        // `gen_op_repeat_with_follow_override` against the lowered
        // `RepeatOp` directly. The remaining surface callers (Label /
        // scan-side fallbacks) never see a Repeat here because lower
        // replaces them with op-driven walkers before this point. Probe
        // with a panic so a future regression is surfaced.
        Repeat(_) => panic(
            "gen_element: Repeat element reached the retired surface walker — route through op-driven `gen_op_repeat_with_follow_override`",
        ),
    }
}

/// Op-driven top-level Repeat dispatcher. Walkers reach this with
/// `rep` (surface) and `rep_op` (lowered, carrying baked follow /
/// strategy / scannable / has-field). Internally routes to the
/// existing emit helpers using the baked data.
fn gen_op_repeat(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    gen_op_repeat_with_follow_override(w, rep, rep_op, ctx, name_counts, &rep_op.caller_follow_first);
}

/// Twin of `gen_op_repeat` with an explicit `follow` override. Used by
/// `gen_elements_with_non_greedy` to union the surrounding Repeat's
/// iter_follow on top of lower's per-position `caller_follow_first`
/// — that propagation isn't expressible through lower's per-alt-body
/// `caller_follow_first` computation alone (lower doesn't see the
/// outer iter_follow at group-alt time).
fn gen_op_repeat_with_follow_override(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    follow: &List<String>,
) {
    if rep.non_greedy {
        // `??` routes through the greedy Optional emitter because lower
        // already picked a greedy strategy for it (see `lower_repeat_op`).
        // `*?` / `+?` keep the dedicated non-greedy emit path.
        if let Optional = rep.kind {
            gen_op_repeat_optional_greedy(w, rep, rep_op, ctx, name_counts, follow);
            return;
        }
        gen_op_repeat_non_greedy(w, rep, rep_op, ctx, name_counts, follow);
        return;
    }
    if let Optional = rep.kind {
        gen_op_repeat_optional_greedy(w, rep, rep_op, ctx, name_counts, follow);
        return;
    }
    // Star / Plus, greedy.
    gen_op_repeat_star_plus_greedy(w, rep, rep_op, ctx, name_counts, follow);
}

/// Non-greedy `*?` / `+?`. Dispatches on `rep_op.body_shape`:
/// leaf and `StorableGroup` bodies push every iteration's binding
/// into a list; `TransparentGroup` walks the loop without a list
/// (each iteration inlines the inner alt), since the group itself
/// contributes no CST field. `compute_non_greedy_condition` is op-
/// driven now: Wildcard / Not detection reads the body op shape, and
/// the inner second-position first set is baked on
/// `rep_op.body_second_position_first`.
fn gen_op_repeat_non_greedy(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    follow: &List<String>,
) {
    let follow_second = &rep_op.caller_follow_second;
    let while_cond = compute_non_greedy_condition(rep_op, follow, follow_second, ctx);
    return match rep_op.body_shape {
        LeafRuleCall | LeafOther | StorableGroup => gen_op_repeat_non_greedy_storable(
            w,
            rep,
            rep_op,
            ctx,
            name_counts,
            &while_cond,
        ),
        TransparentGroup => gen_op_repeat_non_greedy_transparent(w, rep, rep_op, ctx, name_counts, &while_cond),
    };
}

/// Storable-body arm of `gen_op_repeat_non_greedy`. The body
/// produces a per-iteration value bound to `op.field`; we collect
/// those into a list field of the surrounding alt's CST struct.
fn gen_op_repeat_non_greedy_storable(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    while_cond: &String,
) {
    let inner = &rep.element;
    let is_plus = if let Plus = rep.kind {
        true;
    } else {
        false;
    };
    let empty_iter_follow = [] as List<String>;
    let list_field = rep_op.field;
    let _ = dedup_name(&list_field, name_counts);
    // The body appends to the builder, so there is no `List<T>` to accumulate.
    if is_plus {
        let mut nc: List<[String, i32]> = [];
        gen_op_inner_for_storable_repeat(w, rep_op, inner, ctx, &mut nc, &empty_iter_follow);
    }
    if *while_cond == "false" && non_greedy_probe_decides(rep_op, ctx) {
        begin_non_greedy_probe_loop(w, rep_op, ctx, name_counts);
        let mut nc: List<[String, i32]> = [];
        gen_op_inner_for_storable_repeat(w, rep_op, inner, ctx, &mut nc, &empty_iter_follow);
        w.end();
        return;
    }
    if *while_cond != "false" {
        let guard = if is_plus { `!p.recovering && (${*while_cond})` } else { *while_cond };
        w.begin(&`while ${guard}`);
        let mut nc: List<[String, i32]> = [];
        gen_op_inner_for_storable_repeat(w, rep_op, inner, ctx, &mut nc, &empty_iter_follow);
        w.end();
    }
}

/// Non-greedy arm for a `TransparentGroup` body — the group has no
/// own CST field, so each iteration inlines the inner alt without a
/// surrounding list. Symmetric to
/// `gen_op_repeat_star_plus_non_storable_group` but with the non-
/// greedy `while` guard. Reachable for grammars like `(.)*?` or
/// `(~';')*?` whose inner is a single-element Group that
/// `lower_transparent_group` collapses to `Op::Group(Transparent)`;
/// no committed grammar exercises it today, but encoding the case
/// here makes the dispatch exhaustive on `RepeatBodyShape` and keeps
/// emit a structural translation of the lowered classifier rather
/// than relying on lower never producing the shape.
fn gen_op_repeat_non_greedy_transparent(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    while_cond: &String,
) {
    let g_op = if let Group(g) = &rep_op.body {
        g;
    } else {
        panic("gen_op_repeat_non_greedy_transparent: lower marked TransparentGroup but body op is not Op::Group");
    };
    let inner = &rep.element;
    let is_plus = if let Plus = rep.kind {
        true;
    } else {
        false;
    };
    let _ = dedup_name(&rep_op.field, name_counts);
    if is_plus {
        let mut nc: List<[String, i32]> = [];
        gen_op_group(w, g_op, inner, ctx, &mut nc);
    }
    if *while_cond == "false" && non_greedy_probe_decides(rep_op, ctx) {
        begin_non_greedy_probe_loop(w, rep_op, ctx, name_counts);
        let mut nc: List<[String, i32]> = [];
        gen_op_group(w, g_op, inner, ctx, &mut nc);
        w.end();
        return;
    }
    if *while_cond != "false" {
        w.begin(&`while ${*while_cond}`);
        let mut nc: List<[String, i32]> = [];
        gen_op_group(w, g_op, inner, ctx, &mut nc);
        w.end();
    }
}

/// Greedy `?` Repeat. Dispatches on `rep_op.body_shape`: RuleCall
/// uses caller-follow subtraction (the "next-sibling first"
/// disambiguation); Group delegates to `gen_op_storable_optional` /
/// `gen_op_transparent_optional` which consume the baked strategy
/// variants; other leaves (Token / Literal / Wildcard / Excluded) use
/// `inner_first` directly. The `match` is exhaustive — lower asserts
/// at construction time that no other body shape reaches here.
fn gen_op_repeat_optional_greedy(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    follow: &List<String>,
) {
    return match rep_op.body_shape {
        LeafRuleCall => gen_op_repeat_optional_rulecall(w, rep, rep_op, ctx, name_counts, follow),
        LeafOther => gen_op_repeat_optional_leaf(w, rep, rep_op, ctx, name_counts),
        StorableGroup | TransparentGroup => gen_op_repeat_optional_group(w, rep, rep_op, ctx, name_counts),
    };
}

/// Greedy `?` Repeat with a `Group`-shaped body. Splits on
/// `body_shape` (Storable vs Transparent) to pick the storable /
/// transparent emitter. The body op is `Op::Group(_)` and the
/// surface element is `Element::Group(_)` by lower's invariant; the
/// match destructures both with explicit error markers in case a
/// future lower regression desynchronises them.
fn gen_op_repeat_optional_group(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let g_op = if let Group(g) = &rep_op.body {
        g;
    } else {
        panic("gen_op_repeat_optional_group: lower marked a Group body_shape but body op is not Op::Group");
    };
    let g_elem = if let Group(g) = &rep.element {
        g;
    } else {
        panic("gen_op_repeat_optional_group: surface element is not Element::Group");
    };
    return match rep_op.body_shape {
        StorableGroup => gen_op_storable_optional(w, rep, rep_op, g_op, g_elem, ctx, name_counts),
        TransparentGroup => gen_op_transparent_optional(w, rep, rep_op, g_op, g_elem, ctx, name_counts),
        // Caller (`gen_op_repeat_optional_greedy`) routes only Group
        // shapes here; the leaf shapes have their own arms upstream.
        LeafRuleCall | LeafOther => panic(
            "gen_op_repeat_optional_group: leaf body_shape reached the Group dispatcher — caller-side bug",
        ),
    };
}

/// Greedy Optional whose body is a `RuleCall`. The caller-side follow
/// is subtracted from the inner's first so a Repeat at e.g.
/// `selector : simpleSelectorSequence ws (combinator ws)*` doesn't
/// greedily eat the `Space` that belongs to the next iteration's
/// `combinator`. The tail-position caller-FOLLOW repair is emitted
/// separately as the runtime `gate_caller_follow` gate, so
/// `inner_walker_follow_for_repeat` can legitimately clear `follow` to
/// `[]` for inner greedy Optionals where the next sibling's first
/// overlaps the inner's first by design (e.g. `accessibilityModifier?`
/// inside `optionalParameter`).
fn gen_op_repeat_optional_rulecall(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    follow: &List<String>,
) {
    let raw_first = rep_op.body_first_set;
    let first = subtract_sets(&raw_first, follow);
    let opt_field = rep_op.field;
    let _ = dedup_name(&opt_field, name_counts);

    // Ambiguous entry: the subtraction below would hand every shared token
    // to the continuation, but ANTLR4 resolves the ambiguity by entering
    // whenever entering leaves a viable parse. Ask the probe instead.
    if optional_probe_decides(rep_op, follow, ctx) {
        gen_optional_probe_entry(w, rep_op, &raw_first, ctx, name_counts);
        return;
    }

    if first.is_empty() {
        // RuleCall always has a field — `body_shape == LeafRuleCall`
        // implies `body_has_field == true`. The optional can
        // never match, so emit nothing.
        return;
    }

    // Caller-FOLLOW yield gate: when the caller's continuation matches at
    // this position, yield to the caller (null) so the Optional body
    // doesn't swallow tokens the caller needs. Empty (`follow` absent)
    // falls through to the regular `first_check` shape.
    let caller_follow_gate = if rep_op.gate_caller_follow {
        "follow_yields(&p.kinds, p.pos, follow, TK_EOF)";
    } else {
        "";
    };
    // The if-expression collapses to a present/absent
    // statement — the body appends when taken, nothing otherwise.
    gen_optional_present(w, &rep_op.body, &caller_follow_gate, &ctx.first_check_str(&first), ctx);
}

fn optional_probe_decides(r: &RepeatOp, follow: &List<String>, ctx: &mut GenContext) -> bool {
    return r.body_scannable && probe_decides(&r.body_first_set, follow, &r.continuation_scan, r.continuation_scannable, ctx);
}

/// Whether a probe can decide this Repeat, from the parts the parse-side
/// `RepeatOp` and the scan-side `ScanRepeatElement` both carry — the two must
/// answer identically or the tournament measures a length the parse will not
/// consume. It takes a lowered continuation, a competing reading to rule on,
/// and something to ask: with nothing after the body and no runtime FOLLOW
/// the probe would reduce to "the body scans, so enter".
fn probe_decides(
    body_first: &List<String>,
    follow: &List<String>,
    continuation: &List<ScanElement>,
    continuation_scannable: bool,
    ctx: &mut GenContext,
) -> bool {
    return continuation_scannable
        && sets_overlap(body_first, follow)
        && (!continuation.is_empty() || ctx.emit_follow());
}

/// Greedy Optional that enters when entering stays viable. The cheap
/// first-set check stays in front so a token that cannot start the body
/// never pays for a scan, and the caller-FOLLOW yield gate still wins —
/// where the repair already decided to yield the probe does not rule.
fn gen_optional_probe_entry(
    w: &mut CodeWriter,
    r: &RepeatOp,
    raw_first: &List<String>,
    ctx: &mut GenContext,
    nc: &mut List<[String, i32]>,
) {
    let verdict = dedup_name(&"opt_enter", nc);
    let entry_gate = if ctx.emit_follow() && r.gate_caller_follow {
        `!(follow_yields(&p.kinds, p.pos, follow, TK_EOF)) && `;
    } else {
        "";
    };
    w.line(&`let mut ${verdict}: bool = false;`);
    w.begin(&`if ${entry_gate}${ctx.first_check_str(raw_first)}`);
    gen_viability_probe(w, &r.continuation_scan, &verdict, &"opt_enter_scan", ctx, nc, Option::Some(r.scan_body));
    w.end();
    w.begin(&`if ${verdict}`);
    let mut body_nc: List<[String, i32]> = [];
    gen_op_leaf(w, &r.body, ctx, &mut body_nc);
    w.end();
}

/// Greedy-Optional leaf body: `if [!gate &&] cond { <body> }`.
/// The body appends to the builder when present; an absent optional emits
/// nothing. `gate_expr` is the caller-FOLLOW yield check (empty = none).
fn gen_optional_present(w: &mut CodeWriter, body: &Op, gate_expr: &String, cond: &String, ctx: &mut GenContext) {
    let guard = if gate_expr.is_empty() { *cond } else { `!(${*gate_expr}) && (${*cond})` };
    w.begin(&`if ${guard}`);
    let mut nc: List<[String, i32]> = [];
    gen_op_leaf(w, body, ctx, &mut nc);
    w.end();
}

/// Greedy Optional whose body is a non-RuleCall leaf (Token / Literal /
/// Wildcard / Excluded). The tail-position caller-FOLLOW repair is
/// threaded at runtime (`gate_caller_follow` → `follow_yields`), so the
/// loop guard is the plain `body_first_set` check.
fn gen_op_repeat_optional_leaf(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let loop_first = rep_op.body_first_set;
    let opt_field = rep_op.field;
    let _ = dedup_name(&opt_field, name_counts);

    // Same K-prefix gate as the RuleCall arm — see
    // `gen_op_repeat_optional_rulecall` for the rationale.
    let caller_follow_gate = if rep_op.gate_caller_follow {
        "follow_yields(&p.kinds, p.pos, follow, TK_EOF)";
    } else {
        "";
    };
    gen_optional_present(w, &rep_op.body, &caller_follow_gate, &ctx.first_check_str(&loop_first), ctx);
}

/// Runtime caller-FOLLOW yield gate at a tail-greedy Repeat's
/// iteration entry. The mask is not compiled into the body; it arrives
/// at runtime through the function's `follow` argument. Inert when
/// `follow` is empty (`&EMPTY_FOLLOW`), so non-repair callers see no
/// behaviour change; a repair caller that threaded in a
/// `FOLLOW_MASK_<id>` makes the loop yield its caller's continuation.
/// Emitted only when lower marked the Repeat tail-position
/// (`gate_caller_follow`).
fn gen_caller_follow_gate(w: &mut CodeWriter, rep_op: &RepeatOp) {
    if rep_op.gate_caller_follow {
        w.line(&"if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }");
    }
}

/// Render the runtime FOLLOW argument expression for a
/// `RuleCall` per its `FollowArg`. Passed as the callee's `follow`
/// parameter (parse and scan share the spelling — both bind `follow`).
pub fn follow_arg_expr(arg: &FollowArg) -> String {
    return match arg {
        NoFollow => "&EMPTY_FOLLOW",
        Mask(id) => `&FOLLOW_MASK_${id}`,
        Forward => "follow",
        Combined(id) => `&follow_prepend(&FOLLOW_MASK_${id}, follow)`,
    };
}

/// Greedy `*` / `+` Repeat dispatcher. Splits on `body_shape`:
/// `TransparentGroup` walks the loop without a list (each iteration
/// inlines the inner alt); the storable shapes (`LeafRuleCall`,
/// `LeafOther`, `StorableGroup`) push every iteration's inner
/// binding into a list field. Match is exhaustive.
fn gen_op_repeat_star_plus_greedy(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    follow: &List<String>,
) {
    return match rep_op.body_shape {
        TransparentGroup => {
            let g_op = if let Group(g) = &rep_op.body {
                g;
            } else {
                panic("gen_op_repeat_star_plus_greedy: lower marked TransparentGroup but body op is not Op::Group");
            };
            gen_op_repeat_star_plus_non_storable_group(w, rep, rep_op, g_op, ctx, name_counts);
        },
        LeafRuleCall | LeafOther | StorableGroup => gen_op_repeat_star_plus_storable(
            w,
            rep,
            rep_op,
            ctx,
            name_counts,
            follow,
        ),
    };
}

/// Star / Plus + non-storable `Op::Group` body (Transparent groups,
/// `body_has_field == false`). Walks the loop without a list — each
/// iteration's inner emit discards its binding (Transparent groups
/// inline the single alt's elements). `rep_op.field` was deduped at
/// lower time; bump emit's `name_counts` to stay in sync.
fn gen_op_repeat_star_plus_non_storable_group(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    g_op: &GroupOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let inner = &rep.element;
    let inner_first = rep_op.body_first_set;
    let loop_first = inner_first;
    let _ = dedup_name(&rep_op.field, name_counts);

    if let Star = rep.kind {
        if rep_op.body_scannable {
            w.begin(&"loop");
            w.line(&"if p.recovering { break; }");
            // Mirror `gen_op_repeat_star_plus_storable`'s Star arm: yield
            // to the caller on K-prefix match before the scan guard.
            // No-op for empty mask.
            gen_caller_follow_gate(w, rep_op);
            let scan_pos = gen_rep_scan_guard(w, &rep_op.scan_body, ctx, name_counts);
            w.line(&`if ${scan_pos} < 0 \{ break; \}`);
            let mut nc: List<[String, i32]> = [];
            gen_op_group(w, g_op, inner, ctx, &mut nc);
            w.end();
        } else {
            w.begin(&`while !p.recovering && (${ctx.first_check_str(&loop_first)})`);
            gen_caller_follow_gate(w, rep_op);
            let mut nc: List<[String, i32]> = [];
            gen_op_group(w, g_op, inner, ctx, &mut nc);
            w.end();
        }
        return;
    }
    if let Plus = rep.kind {
        if rep_op.body_scannable {
            let plus_flag = dedup_name(&"_plus_first", name_counts);
            w.line(&`let mut ${plus_flag} = true;`);
            w.begin(&"loop");
            w.line(&"if p.recovering { break; }");
            w.begin(&`if !${plus_flag}`);
            // Mandatory first iter is unconditional; subsequent iters
            // get the K-prefix yield gate before the scan guard.
            gen_caller_follow_gate(w, rep_op);
            let scan_pos = gen_rep_scan_guard(w, &rep_op.scan_body, ctx, name_counts);
            w.line(&`if ${scan_pos} < 0 \{ break; \}`);
            w.end();
            w.line(&`${plus_flag} = false;`);
            let mut nc: List<[String, i32]> = [];
            gen_op_group(w, g_op, inner, ctx, &mut nc);
            w.end();
        } else {
            // Plus + non-scannable + no-field: emit the first iteration
            // explicitly (no `_plus_first` flag) and then a `while first`
            // loop. The K-prefix gate goes inside the while loop (after
            // the mandatory first iter ran above).
            gen_op_group(w, g_op, inner, ctx, name_counts);
            w.begin(&`while !p.recovering && (${ctx.first_check_str(&inner_first)})`);
            gen_caller_follow_gate(w, rep_op);
            let mut nc: List<[String, i32]> = [];
            gen_op_group(w, g_op, inner, ctx, &mut nc);
            w.end();
        }
    }
}

/// Star / Plus + storable body (every leaf, every storable
/// `Op::Group` shape). Emits a `let <field>: List<T> = [];` then a
/// scan-guarded `loop { … }` (when the body is scannable) or a
/// `while peek ∈ loop_first { … }` (otherwise). The Plus first-
/// iteration uses a `_plus_first` flag or, for the non-scannable case,
/// folds the mandatory iteration into the while condition via
/// `while plus_first || …`.
/// When a scan-gated repetition over a single RuleRef exits because the scan
/// failed, the next token may still legitimately start the inner rule but be
/// malformed deeper in. Returns the call expression (`_parse_R(p)` /
/// `_parse_R(p, mp)`) used to re-parse it for a precise error, or `null` when
/// the repeated element is not a single RuleRef (no standalone parse fn).
fn rep_recovery_expr(rep_op: &RepeatOp, emit_follow: bool) -> Option<String> {
    if let LeafRuleCall = rep_op.body_shape {
        if let RuleCall(r) = &rep_op.body {
            let fn_name = `_parse_${r.target_snake}`;
            let follow_arg_str = follow_arg_sep(emit_follow, &r.follow_arg);
            let call = if let Some(min_prec) = r.min_prec_arg {
                `${fn_name}(p${follow_arg_str}, ${min_prec})`;
            } else {
                `${fn_name}(p${follow_arg_str})`;
            };
            return Option::Some(call);
        }
    }
    return null;
}

/// Emit the `if ${scan_pos} < 0 { break; }` loop-exit, augmented with
/// error-path recovery for RuleRef inners: when the lookahead is in the
/// inner's FIRST set (so an element plausibly starts here) but the scan
/// failed, re-parse the inner for real. The result is kept only if it actually
/// recovered (a diagnostic was recorded or `recovering` was set), so a broken
/// element lands in the tree; a clean re-parse is undone and the loop breaks,
/// preserving valid-input behaviour where the scan merely under-approximated.
fn gen_rep_break_with_recovery(
    w: &mut CodeWriter,
    scan_pos: &String,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    loop_first: &List<String>,
) {
    let recovery = rep_recovery_expr(rep_op, ctx.emit_follow());
    if let Some(call) = recovery {
        if loop_first.is_empty() {
            // No FIRST tokens to gate the speculative re-parse on. An empty
            // set makes `first_check_str` emit the constant `true`, so the
            // recovery would fire on *any* lookahead and could record a
            // spurious deeper error that hijacks the reported position. Fall
            // back to the plain break. (Not reachable today: recovery is only
            // emitted for a `body_scannable` `LeafRuleCall`, and a scannable
            // RuleRef has a non-empty FIRST — this guards the invariant.)
            w.line(&`if ${scan_pos} < 0 \{ break; \}`);
            return;
        }
        w.begin(&`if ${scan_pos} < 0`);
        // The scan failed but the lookahead is in the body's FIRST set, so a
        // malformed element *plausibly* starts here. Parse it for real and keep
        // the result only if it actually recovered (recorded a diagnostic or set
        // `recovering`): then its repair edits stay in the tree and the cursor
        // advances past the broken element. If instead it parsed cleanly, the
        // scan merely under-approximated a valid element that belongs to the
        // caller's continuation — undo the speculative parse and break, the
        // behaviour-preserving loop exit. (Without this guard, stealing such an
        // element from the caller mis-parses valid input.)
        w.begin(&`if ${ctx.first_check_str(loop_first)}`);
        // Speculative, diagnostic-only re-parse: the lookahead is in the body's
        // FIRST set, so an element *plausibly* starts here, but the scan failed.
        // Static scan cannot tell a malformed element (recover, keep) from a
        // valid one that belongs to the caller's continuation (yield, drop) — a
        // trailing `expression?` after `statement*` looks identical to a
        // malformed statement. Committing edits would steal the caller's tokens,
        // so run the probe under `speculating` (no edits), keep only the deepest
        // error it records in `pending` (surfaced if the overall parse fails),
        // restore the cursor / tree / flags, and exit the loop.
        w.line(&"let _rec_pos = p.pos;");
        w.line(&"let _rec_cp = p.b.checkpoint();");
        w.line(&"let _rec_sav = p.recovering;");
        w.line(&"let _rec_spec = p.speculating;");
        w.line(&"p.speculating = true;");
        // Stamp the call's exact ATN return state, just as a normal parse call
        // does, so a context-sensitive callee (`??` / ATN-class LR) sees the
        // right caller frame.
        if let RuleCall(r) = &rep_op.body {
            gen_atn_ret_pending(w, ctx, r.atn_call_site);
        }
        w.line(&`${call};`);
        w.line(&"p.speculating = _rec_spec;");
        w.line(&"p.recovering = _rec_sav;");
        w.line(&"p.pos = _rec_pos;");
        w.line(&"p.b.truncate(_rec_cp);");
        w.end();
        w.line(&"break;");
        w.end();
    } else {
        w.line(&`if ${scan_pos} < 0 \{ break; \}`);
    }
}

fn gen_op_repeat_star_plus_storable(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    follow: &List<String>,
) {
    let inner = &rep.element;
    let inner_first = rep_op.body_first_set;
    let loop_first = inner_first;
    // Per-iteration follow propagated into a nested non-greedy Repeat
    // inside a SingleAlt body — `first(inner) ∪ outer_follow`.
    let iter_follow = if rep_op.body_is_single_alt_group { union_kind_arrays(&inner_first, follow) } else { *follow };
    let list_field = rep_op.field;
    let _ = dedup_name(&list_field, name_counts);
    // The iteration body appends to the builder, so there is no `List<T>` to
    // accumulate (no list decl, no per-iteration `.push`); the loop keeps the
    // scan-guard / caller-FOLLOW gate.

    if let Star = rep.kind {
        if rep_op.body_scannable {
            w.begin(&"loop");
            w.line(&"if p.recovering { break; }");
            // Caller-FOLLOW yield gate: when the upcoming tokens match
            // the caller's continuation at iter entry, exit the loop so
            // the caller can consume them. Inert when the runtime
            // `follow` is empty.
            gen_caller_follow_gate(w, rep_op);
            let scan_pos = gen_rep_scan_guard(w, &rep_op.scan_body, ctx, name_counts);
            gen_rep_break(w, &scan_pos, rep_op, ctx, &loop_first);
            let mut nc: List<[String, i32]> = [];
            gen_op_inner_for_storable_repeat(w, rep_op, inner, ctx, &mut nc, &iter_follow);
            w.end();
        } else {
            w.begin(&`while !p.recovering && (${ctx.first_check_str(&loop_first)})`);
            // Same caller-FOLLOW gate for the non-scannable while loop.
            gen_caller_follow_gate(w, rep_op);
            let mut nc: List<[String, i32]> = [];
            gen_op_inner_for_storable_repeat(w, rep_op, inner, ctx, &mut nc, &iter_follow);
            w.end();
        }
        return;
    }

    if let Plus = rep.kind {
        if rep_op.body_scannable {
            let plus_flag = dedup_name(&"_plus_first", name_counts);
            w.line(&`let mut ${plus_flag} = true;`);
            w.begin(&"loop");
            w.line(&"if p.recovering { break; }");
            w.begin(&`if !${plus_flag}`);
            // Yield to the caller when the upcoming tokens match its
            // continuation. Inert when the runtime `follow` is empty.
            gen_caller_follow_gate(w, rep_op);
            let scan_pos = gen_rep_scan_guard(w, &rep_op.scan_body, ctx, name_counts);
            gen_rep_break(w, &scan_pos, rep_op, ctx, &loop_first);
            w.end();
            w.line(&`${plus_flag} = false;`);
            let mut nc: List<[String, i32]> = [];
            gen_op_inner_for_storable_repeat(w, rep_op, inner, ctx, &mut nc, &iter_follow);
            w.end();
        } else {
            let plus_flag = dedup_name(&"_plus_first", name_counts);
            w.line(&`let mut ${plus_flag} = true;`);
            w.begin(&`while !p.recovering && (${plus_flag} || ${ctx.first_check_str(&inner_first)})`);
            // K-prefix yield gate fires AFTER the mandatory first iter:
            // skip emission while `plus_flag` is still true so the
            // mandatory iter cannot be suppressed. Empty mask emits
            // nothing (the if-block is dead-stripped at codegen).
            if rep_op.gate_caller_follow {
                w.begin(&`if !${plus_flag}`);
                gen_caller_follow_gate(w, rep_op);
                w.end();
            }
            w.line(&`${plus_flag} = false;`);
            let mut nc: List<[String, i32]> = [];
            gen_op_inner_for_storable_repeat(w, rep_op, inner, ctx, &mut nc, &iter_follow);
            w.end();
        }
    }
}

/// Loop-exit guard for a scan-gated Repeat. Augments the plain
/// `if scan_pos < 0 { break }` with a speculative re-parse of a RuleRef inner
/// that records the precise deep error (`gen_rep_break_with_recovery`); the
/// emitter brackets the speculative parse with a builder
/// checkpoint/truncate (the speculation drives the real `TreeBuilder`, so the
/// throwaway subtree is rolled back along with the cursor — only the recorded
/// deep error survives).
fn gen_rep_break(
    w: &mut CodeWriter,
    scan_pos: &String,
    rep_op: &RepeatOp,
    ctx: &mut GenContext,
    loop_first: &List<String>,
) {
    gen_rep_break_with_recovery(w, scan_pos, rep_op, ctx, loop_first);
}


fn wildcard_non_greedy_condition(ctx: &mut GenContext, follow_first: &List<String>) -> String {
    // Continue while peek is not EOF and not in the follow set. `follow_first`
    // may already contain TK_EOF (e.g. when the follow is the final `EOF`
    // token). Dedup into a single exclusion set so we emit one check.
    let mut excluded: List<String> = ["TK_EOF"];
    for let tk of follow_first {
        let mut seen = false;
        for let e of &excluded {
            if *e == *tk {
                seen = true;
                break;
            }
        }
        if !seen {
            excluded.push(*tk);
        }
    }
    return ctx.kind_negate_check_str(&excluded, &"p.peek_kind()");
}

/// A first set larger than this is treated as "matches almost anything"
/// (e.g. `name+?` where `name` covers every keyword): single-token
/// lookahead can't distinguish the inner from the continuation, so the
/// non-greedy loop falls back to the minimum match instead of gating.
global BROAD_FIRST_SET_THRESHOLD: i32 = 20;

pub fn compute_non_greedy_condition(
    rep_op: &RepeatOp,
    follow_first: &List<String>,
    follow_second: &List<String>,
    ctx: &mut GenContext,
) -> String {
    let raw_first = &rep_op.body_first_set;

    // Wildcard (`.*?`) and Not (`~TOK*?`) inner: their match set is
    // open-ended, so `body_first_set` lowers to `[]`. The same is true
    // for `(.)*?` / `(~TOK)*?` whose body op is `Op::Group(Transparent)`
    // wrapping the open-ended leaf. Detecting the open-ended case via
    // the empty first set covers both shapes uniformly: keep looping
    // while the current token is not EOF and not in the follow set
    // (i.e. the continuation can't yet fire).
    if raw_first.is_empty() {
        return wildcard_non_greedy_condition(ctx, follow_first);
    }

    let continue_first = subtract_sets(raw_first, follow_first);

    if continue_first.len() > 0 {
        // Check if the subtracted set is still very broad (inner matches almost anything).
        // For cases like `name+?` where name matches all keywords, lookahead can't
        // distinguish names from constraint keywords. Use minimum match (don't loop).
        if continue_first.len() > BROAD_FIRST_SET_THRESHOLD && raw_first.len() > BROAD_FIRST_SET_THRESHOLD {
            // Very broad first set — match minimum (1 for +?, 0 for *?)
            return "false";
        }
        return ctx.first_check_str(&continue_first);
    }

    // First sets completely overlap (e.g. both start with ',').
    // Use 2-token lookahead with follow_second to disambiguate.
    // For (',' column_def)*? followed by (',' table_constraint)*:
    //   peek(0) == ',' for both, peek(1) distinguishes column_def from table_constraint.
    let inner_second_first = &rep_op.body_second_position_first;
    if inner_second_first.len() > 0 && follow_second.len() > 0 {
        let second_continue = subtract_sets(inner_second_first, follow_second);
        if second_continue.len() > 0 {
            let peek0_cond = ctx.first_check_str(raw_first);
            let peek1_cond = ctx.kind_check_str(&second_continue, &"p.peek_at(1)");
            return `(${peek0_cond}) && (${peek1_cond})`;
        }
    }

    // Fallback: can't disambiguate, don't loop (match minimum)
    return "false";
}


enum LookaheadAccess {
    Scan,
    Parse,
    ParseKind,
}

fn join_lookahead_condition(
    ctx: &mut GenContext,
    sig: &List<List<String>>,
    depth: i32,
    access: LookaheadAccess,
) -> String {
    let mut result = String::with_capacity(128);
    for let mut d = 0; d < depth; d += 1 {
        if d > 0 {
            result.push_str(&" && ");
        }
        let part = match access {
            Scan => {
                let idx_expr = if d == 0 { `pos` } else { `pos + ${d}` };
                let check = ctx.kind_check_str(&sig[d], &`tokens[${idx_expr}]`);
                `${idx_expr} < tokens.len() && ${check}`;
            },
            Parse => {
                let check_expr = if d == 0 { `p.peek_kind()` } else { `p.peek_at(${d})` };
                ctx.kind_check_str(&sig[d], &check_expr);
            },
            ParseKind => {
                let check_expr = if d == 0 { `kind` } else { `p.peek_at(${d})` };
                ctx.kind_check_str(&sig[d], &check_expr);
            },
        };
        result.push_str(&part);
    }
    return result;
}

fn gen_lookahead_condition(ctx: &mut GenContext, sig: &List<List<String>>) -> String {
    return join_lookahead_condition(ctx, sig, sig.len(), LookaheadAccess::Parse);
}

fn unwrap_optional(elem: &Element) -> &Element with stores[elem] {
    return match elem {
        Repeat(rep) => if rep.kind matches { Optional } { &rep.element } else { elem },
        Label(lab) => unwrap_optional(&lab.element),
        Group(_) | TokenRef(_) | Literal(_) | RuleRef(_) | Wildcard(_) | Not(_) => elem,
    };
}

/// Emit an inline scan guard for an optional's inner element.
///
/// Emits code of the form:
/// ```
/// let mut opt_scan_pos_N: i32 = -1;
/// opt_scan_N: {
///     let tokens = &p.kinds;
///     let mut pos: i32 = p.pos;
///     /* inline scan of inner; on fail: break opt_scan_N; */
///     opt_scan_pos_N = pos;
/// }
/// ```
///
/// Returns the name of the outer pos variable (`-1` on scan failure, end-pos on success).
/// Caller emits `if ${pos_var} >= 0 { /* commit parse */ }`.
/// Emit an inline scan guard for a repetition's inner element.
/// Same shape as gen_rep_scan_guard but uses `rep_scan_*` naming. Requires
/// the scan to advance at least one token; 0-advance is treated as failure
/// so lenient scans of LR rules (which can no-op at EOF) don't loop forever.
pub fn gen_rep_scan_guard(
    w: &mut CodeWriter,
    scan_inner: &ScanElement,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) -> String {
    return gen_scan_guard_with_prefix(w, scan_inner, ctx, name_counts, &"rep_scan_pos", &"rep_scan", true);
}

fn gen_scan_guard_with_prefix(
    w: &mut CodeWriter,
    scan_inner: &ScanElement,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
    pos_prefix: &String,
    label_prefix: &String,
    require_advance: bool,
) -> String {
    let scan_pos_var = dedup_name(pos_prefix, name_counts);
    let scan_label = dedup_name(label_prefix, name_counts);
    w.line(&`let mut ${scan_pos_var}: i32 = -1;`);
    w.begin(&`${scan_label}:`);
    w.line(&"let tokens = &p.kinds;");
    w.line(&"let mut pos: i32 = p.pos;");
    let fail = `break ${scan_label};`;
    gen_scan_op_element(w, scan_inner, ctx, &fail);
    if require_advance {
        w.line(&`if pos <= p.pos \{ break ${scan_label}; \}`);
    }
    w.line(&`${scan_pos_var} = pos;`);
    w.end();
    return scan_pos_var;
}

/// literal that coerces to `List<i32>` at the call site.
fn not_match_call(inner: &Element) -> String {
    let unsupported = "not_match_call: unsupported inner element for parser-side ~";
    return match inner {
        TokenRef(t) => `p.expect_not([TK_${t.name}])`,
        Literal(l) => `p.expect_not([${literal_const_name(&l.text)}])`,
        Group(g) => {
            let mut kinds: List<String> = [];
            if !collect_not_set_tokens(&g.alternatives, &mut kinds) {
                panic(unsupported);
            }
            let mut list = String::with_capacity(32);
            for let mut i = 0; i < kinds.len(); i += 1 {
                if i > 0 {
                    list.push_str(&", ");
                }
                list.push_str(&kinds[i]);
            }
            `p.expect_not([${list}])`;
        },
        RuleRef(_) | Label(_) | Repeat(_) | Wildcard(_) | Not(_) => panic(unsupported),
    };
}

/// Collect terminal token constants from a `~ ( ... )` group's alternatives.
/// Returns false if any alternative is not a simple terminal (unsupported).
fn collect_not_set_tokens(alts: &List<Alternative>, out: &mut List<String>) -> bool {
    for let alt of alts {
        if alt.elements.len() != 1 {
            return false;
        }
        let e = &alt.elements[0];
        if let TokenRef(t) = e {
            out.push(`TK_${t.name}`);
        } else if let Literal(l) = e {
            out.push(literal_const_name(&l.text));
        } else {
            return false;
        }
    }
    return true;
}

fn rule_ref_group_all_scannable(sorted_group: &List<i32>, alts: &List<Alternative>, ctx: &mut GenContext) -> bool {
    if sorted_group.len() < 2 {
        return false;
    }
    for let idx_ref of sorted_group {
        let alt = &alts[*idx_ref];
        if alt.elements.len() != 1 {
            return false;
        }
        if let RuleRef(r) = &alt.elements[0] {
            let mut visiting: List<String> = [];
            if !ctx.is_rule_scannable(&r.name, &mut visiting) {
                return false;
            }
        } else {
            return false;
        }
    }
    return true;
}

/// Emit the strict-`>` argmax update that resolves ties to the first
/// grammar alternative: `if ${end_expr} > ${best_var} { best = end; winner =
/// value }`. Both scan-winner sites call this while iterating candidates in
/// ASCENDING alt-index order, so the first (lowest-index) candidate to reach
/// the running max keeps it — ANTLR4's ambiguity resolution.
fn emit_argmax_update(w: &mut CodeWriter, best_var: &String, winner_var: &String, end_expr: &String, winner_value: i32) {
    w.begin(&`if ${*end_expr} > ${*best_var}`);
    w.line(&`${*best_var} = ${*end_expr};`);
    w.line(&`${*winner_var} = ${winner_value};`);
    w.end();
}

/// Longest-match scan tournament over `sorted_group`: each alt scans from
/// `p.pos`, the greatest end wins, and ties resolve to the LOWEST grammar
/// alt index (ANTLR4's ambiguity resolution). Iterating in grammar order
/// (`sorted_group.sorted()`) with `emit_argmax_update`'s strict `>` gives
/// that tie-break; a match consuming to the end of the token stream cannot
/// be beaten, so the loop exits early once `best` reaches `p.kinds.len()`.
///
/// Returns the winner variable holding the winning ALT INDEX (`-1` when no
/// scan matched — callers route that to their last branch).
///
/// `scan_alts` drives the scan via the op-driven walker against the
/// lowered `ScanBody`.
fn gen_scan_winner_tournament(
    w: &mut CodeWriter,
    sorted_group: &List<i32>,
    scan_alts: &List<ScanBody>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) -> String {
    let winner_var = dedup_name(&"gd_winner", name_counts);
    let best_var = dedup_name(&"gd_best", name_counts);
    w.line(&`let mut ${winner_var}: i32 = -1;`);
    w.line(&`let mut ${best_var}: i32 = -1;`);
    let tourney_label = dedup_name(&"gd_tourney", name_counts);
    w.begin(&`${tourney_label}:`);
    for let ai of sorted_group.sorted() {
        let sb = &scan_alts[ai];
        if sb.elements.is_empty() {
            let epsilon = "p.pos";
            emit_argmax_update(w, &best_var, &winner_var, &epsilon, ai);
        } else {
            let end_var = dedup_name(&"gd_end", name_counts);
            w.line(&`let mut ${end_var}: i32 = -1;`);
            let scan_label = dedup_name(&"gd_scan", name_counts);
            w.begin(&`${scan_label}:`);
            w.line(&"let tokens = &p.kinds;");
            w.line(&"let mut pos: i32 = p.pos;");
            gen_scan_op_elements_in_block(w, &sb.elements, 0, sb.elements.len(), ctx, &scan_label);
            w.line(&`${end_var} = pos;`);
            w.end();
            emit_argmax_update(w, &best_var, &winner_var, &end_var, ai);
        }
        w.begin(&`if ${best_var} >= p.kinds.len()`);
        w.line(&`break ${tourney_label};`);
        w.end();
    }
    w.end();
    return winner_var;
}

fn gen_simplecst_rulecall_value(w: &mut CodeWriter, op: &Op, ctx: &mut GenContext) {
    let rc = if let RuleCall(rc) = op {
        rc;
    } else {
        panic("SimpleCst group alt op is not RuleCall");
    };
    let fn_name = `_parse_${rc.target_snake}`;
    let local_var = rc.target_snake;
    let call_args = if let Some(min_prec) = rc.min_prec_arg {
        `p${follow_arg_sep(ctx.emit_follow(), &rc.follow_arg)}, ${min_prec}`;
    } else {
        `p${follow_arg_sep(ctx.emit_follow(), &rc.follow_arg)}`;
    };
    gen_atn_ret_pending(w, ctx, rc.atn_call_site);
    w.line(&`let ${local_var} = ${fn_name}(${call_args});`);
}

fn gen_rule_ref_group_scan_dispatch(
    w: &mut CodeWriter,
    sorted_group: &List<i32>,
    alts: &List<Alternative>,
    g_op_alts: &List<AltBody>,
    scan_alts: &List<ScanBody>,
    opt_var: &String,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let winner_var = gen_scan_winner_tournament(w, sorted_group, scan_alts, ctx, name_counts);
    let last = sorted_group.len() - 1;

    for let mut k = 0; k < sorted_group.len(); k += 1 {
        let alt_index = sorted_group[k];
        let is_last = k == last;

        if k == 0 && !is_last {
            w.begin(&`if ${winner_var} == ${alt_index}`);
        } else if is_last {
            w.else_begin(&"else");
        } else {
            w.else_begin(&`else if ${winner_var} == ${alt_index}`);
        }
        let _ = opt_var;
        gen_simplecst_rulecall_value(w, &g_op_alts[alt_index].ops[0], ctx);
    }
    w.end();
}

// Caller pre-dedups `acc_var`; its declaration is emitted here so the
// dedup/grp_kind/loop name-counter order is preserved.
fn gen_simplecst_overlap_loop(
    w: &mut CodeWriter,
    acc_var: &String,
    groups: &List<List<i32>>,
    first_sets: &List<List<String>>,
    alts: &List<Alternative>,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    // each alt's RuleRef appends, so no accumulator and no
    // fail on no-match — the dispatch simply takes no arm (matching the typed
    // standalone-group path, which yields `null` rather than erroring).
    let grp_var = dedup_name(&"grp_kind", name_counts);
    w.line(&`let ${grp_var} = p.peek_kind();`);

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        let mut union_first: List<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &first_sets[*idx]);
        }

        let cond = ctx.kind_check_str(&union_first, &grp_var);
        if g == 0 {
            w.begin(&`if ${cond}`);
        } else {
            w.else_begin(&`else if ${cond}`);
        }

        if group.len() == 1 {
            let alt_index = group[0];
            let body = &g_op_alts[alt_index];
            gen_simplecst_rulecall_value(w, &body.ops[0], ctx);
        } else {
            let mut sorted_group = group.sorted();
            sort_group_by_mandatory_count_desc(&mut sorted_group, alts, ctx);

            assert rule_ref_group_all_scannable(&sorted_group, alts, ctx), "rule-ref group has unscannable alt; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')";
            gen_rule_ref_group_scan_dispatch(
                w,
                &sorted_group,
                alts,
                g_op_alts,
                g_op_scan_alts,
                acc_var,
                ctx,
                name_counts,
            );
        }
    }
    w.end();
}

fn gen_consume_group_store_op(
    w: &mut CodeWriter,
    scst: &SimpleCstShape,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    alts: &List<Alternative>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let _ = dedup_name(&group_field_base_name(alts), name_counts);
    let var_name = scst.field;

    let mut first_sets: List<List<String>> = [];
    for let alt of alts {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups(&first_sets);
    let has_overlaps = has_multi_alt_groups(&groups);
    // each alt is a single RuleRef whose `_parse_X`
    // appends its subtree, so the `let {var}: {type} = if … ` binding
    // collapses to a plain `if … ` statement (the RuleRef parse line is
    // emitted by `gen_simplecst_rulecall_value`; the returned variant
    // value is discarded).
    if !has_overlaps {
        for let mut g = 0; g < groups.len(); g += 1 {
            let alt_index = groups[g][0];
            if g == 0 {
                w.begin(&`if ${ctx.first_check_str(&first_sets[alt_index])}`);
            } else if g < groups.len() - 1 {
                w.else_begin(&`else if ${ctx.first_check_str(&first_sets[alt_index])}`);
            } else {
                w.else_begin(&"else");
            }
            let body = &g_op_alts[alt_index];
            gen_simplecst_rulecall_value(w, &body.ops[0], ctx);
        }
        w.end();
    } else {
        let opt_var = dedup_name(&`${var_name}_opt`, name_counts);
        gen_simplecst_overlap_loop(
            w,
            &opt_var,
            &groups,
            &first_sets,
            alts,
            g_op_alts,
            g_op_scan_alts,
            ctx,
            name_counts,
        );
    }
}

/// Op-driven SimpleCst-group emitter. Reads the outer field name and
/// variant type from the lowered `SimpleCstShape`, and dispatches each
/// alt through the lowered `Op::RuleCall` data (variant id, dedupped
/// field). The retired surface-IR fallback (when `scst`/`g_op_alts`
/// were `null`) flowed from `gen_element`'s Group arm — that path no
/// longer exists post Phase 2-G.
fn gen_consume_group_store_optional_op(
    w: &mut CodeWriter,
    scst: &SimpleCstShape,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    alts: &List<Alternative>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let _ = dedup_name(&group_field_base_name(alts), name_counts);
    let var_name = scst.field;

    let mut first_sets: List<List<String>> = [];
    for let alt of alts {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups(&first_sets);

    // Use Option wrapper — None when no branch matches (standalone Group).
    let inner_var = dedup_name(&`${var_name}_inner`, name_counts);
    gen_simplecst_overlap_loop(
        w,
        &inner_var,
        &groups,
        &first_sets,
        alts,
        g_op_alts,
        g_op_scan_alts,
        ctx,
        name_counts,
    );
}


fn gen_consume_token_group(
    w: &mut CodeWriter,
    alts: &List<Alternative>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let var_name = dedup_name(&token_group_field_name(alts), name_counts);
    let kinds = collect_token_only_kinds(alts);
    w.line(&`let ${var_name} = p.expect_set([${kinds}]);`);
}

// Caller pre-dedups `acc_var`; its declaration is emitted here so the
// name-counter order is preserved.
fn gen_general_overlap_loop(
    w: &mut CodeWriter,
    acc_var: &String,
    type_name: &String,
    alt_struct_names: &List<String>,
    groups: &List<List<i32>>,
    first_sets: &List<List<String>>,
    alts: &List<Alternative>,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    // the chosen alt appends to the builder, so there is
    // no `Option<type>` accumulator. A no-match leaves the dispatch with no
    // arm taken and appends nothing — matching the typed standalone-group
    // (`_optional_op`) path, which yields `null` rather than failing. (The
    // required `store_op` caller adds its own post-loop check on the typed
    // side; the repeat-guard already verified a match before
    // entry, so no fail is emitted here.)
    let grp_var = dedup_name(&"grp_kind", name_counts);
    w.line(&`let ${grp_var} = p.peek_kind();`);

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        // A group containing a wildcard alt matches any non-EOF
        // lookahead (its first set is the universal token set even
        // though `first_of_element` returns `[]`). Emitting a kind-check
        // against the union of explicit first sets would skip the
        // dispatch on any token outside that union, leaving the wildcard
        // alt unreachable. Force the group's outer condition to `true`
        // so the scan-based dispatch inside has the final say.
        let mut group_has_wildcard = false;
        for let idx of group {
            if alt_is_wildcard_led(&alts[*idx]) {
                group_has_wildcard = true;
                break;
            }
        }

        let mut union_first: List<String> = [];
        if !group_has_wildcard {
            for let idx of group {
                dedup_append_arr(&mut union_first, &first_sets[*idx]);
            }
        }

        let cond = ctx.kind_check_str(&union_first, &grp_var);
        if g == 0 {
            w.begin(&`if ${cond}`);
        } else {
            w.else_begin(&`else if ${cond}`);
        }

        if group.len() == 1 {
            let alt_index = group[0];
            gen_general_alt_parse_and_store(
                w,
                alts,
                &g_op_alts[alt_index],
                alt_index,
                ctx,
                name_counts,
            );
        } else {
            let mut sorted_group = group.sorted();
            sort_group_by_mandatory_count_desc(&mut sorted_group, alts, ctx);
            gen_general_group_dispatch(
                w,
                alts,
                g_op_alts,
                g_op_scan_alts,
                &sorted_group,
                type_name,
                alt_struct_names,
                acc_var,
                ctx,
                name_counts,
            );
        }
    }
    w.end();
}

fn gen_general_group_store_op(
    w: &mut CodeWriter,
    gs: &GeneralShape,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    alts: &List<Alternative>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let group_index = gs.group_index;
    let _ = dedup_name(&general_group_field_name(group_index), name_counts);
    let var_name = gs.field;
    // `lower_single_alt_group` bakes `gs.variant_type` using the
    // SingleAlt's canonical owner (resolved via `single_alt_owner`),
    // matching CST emit's monomorph key. For Generals outside any
    // SingleAlt body, `gs.variant_type` uses the surrounding rule's
    // name directly. Either way, consuming the baked name keeps emit
    // in lock-step with CST type emit.
    let type_name = gs.variant_type;

    let mut first_sets: List<List<String>> = [];
    for let alt of alts {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups_with_wildcard(alts, &first_sets);
    let has_overlaps = has_multi_alt_groups(&groups);
    // the chosen alt's elements append to the builder, so
    // the `let {var}: {type} = if … ` value-binding collapses to a plain
    // `if … ` statement and the overlap loop needs no accumulator.
    if !has_overlaps {
        for let mut g = 0; g < groups.len(); g += 1 {
            let alt_index = groups[g][0];
            if g == 0 {
                w.begin(&`if ${ctx.first_check_str(&first_sets[alt_index])}`);
            } else if g < groups.len() - 1 {
                w.else_begin(&`else if ${ctx.first_check_str(&first_sets[alt_index])}`);
            } else {
                w.else_begin(&"else");
            }
            gen_general_alt_parse_and_store(
                w,
                alts,
                &g_op_alts[alt_index],
                alt_index,
                ctx,
                name_counts,
            );
        }
        w.end();
    } else {
        let opt_var = dedup_name(&`${var_name}_opt`, name_counts);
        gen_general_overlap_loop(
            w,
            &opt_var,
            &type_name,
            &gs.alt_struct_names,
            &groups,
            &first_sets,
            alts,
            g_op_alts,
            g_op_scan_alts,
            ctx,
            name_counts,
        );
    }
}

/// Op-driven General-group emitter. Reads the outer field name, group
/// index, and scan bodies from the lowered `GeneralShape`/`AltBody`
/// graph. The retired surface-IR fallback (when `gs`/`g_op_alts` were
/// `null`) flowed from `gen_element`'s Group arm — that path no longer
/// exists post Phase 2-G.
fn gen_general_group_store_optional_op(
    w: &mut CodeWriter,
    gs: &GeneralShape,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    alts: &List<Alternative>,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let group_index = gs.group_index;
    let _ = dedup_name(&general_group_field_name(group_index), name_counts);
    let var_name = gs.field;
    // See `gen_general_group_store_op` — `gs.variant_type` is baked
    // by lower under the canonical (`single_alt_owner`-resolved)
    // name so emit and CST type emit agree on the General type.
    let type_name = gs.variant_type;

    let mut first_sets: List<List<String>> = [];
    for let alt of alts {
        let mut visiting: List<String> = [];
        first_sets.push(ctx.first_of_alt(alt, &mut visiting));
    }

    let groups = compute_overlap_groups_with_wildcard(alts, &first_sets);

    let inner_var = dedup_name(&`${var_name}_inner`, name_counts);
    gen_general_overlap_loop(
        w,
        &inner_var,
        &type_name,
        &gs.alt_struct_names,
        &groups,
        &first_sets,
        alts,
        g_op_alts,
        g_op_scan_alts,
        ctx,
        name_counts,
    );
    // no accumulator to forward — the optional group's
    // alt (if any matched) already appended.
}

/// Parse one alt's elements; the chosen alt's elements append to the
/// builder, so there is no variant value to store. Used both inside a
/// Repeat (required group store) and as a plain `if`/`else` arm body.
fn gen_general_alt_parse_and_store(
    w: &mut CodeWriter,
    alts: &List<Alternative>,
    body: &AltBody,
    alt_index: i32,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let alt = &alts[alt_index];

    let mut nc: List<[String, i32]> = [];
    gen_elements_with_non_greedy(w, &alt.elements, &body.ops, ctx, &mut nc, &([] as List<String>));
}

/// First-success-wins scan dispatch wrapper for overlapping general-group
/// alts. Asserts that every alt is fully scannable, then delegates to
/// `gen_general_group_scan_dispatch`. Backtracking has been removed; an
/// unscannable alt is a codegen-time error.
fn gen_general_group_dispatch(
    w: &mut CodeWriter,
    alts: &List<Alternative>,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    sorted_group: &List<i32>,
    type_name: &String,
    alt_struct_names: &List<String>,
    inner_var: &String,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    assert general_group_all_scannable(sorted_group, alts, ctx), "general group has unscannable alt; backtracking has been removed (see AGENTS.md 'Generated Parser Rules')";
    gen_general_group_scan_dispatch(
        w,
        alts,
        g_op_alts,
        g_op_scan_alts,
        sorted_group,
        type_name,
        alt_struct_names,
        inner_var,
        ctx,
        name_counts,
    );
}

/// Returns true iff every alt in `sorted_group` has at least one element
/// and all its elements are scannable. Used as the precondition for
/// `gen_general_group_dispatch` (non-RuleRef-only overlapping groups).
fn general_group_all_scannable(sorted_group: &List<i32>, alts: &List<Alternative>, ctx: &mut GenContext) -> bool {
    if sorted_group.len() < 2 {
        return false;
    }
    for let mut k = 0; k < sorted_group.len(); k += 1 {
        let alt = &alts[sorted_group[k]];
        if alt.elements.len() == 0 {
            return false;
        }
        for let elem of &alt.elements {
            let mut visiting: List<String> = [];
            if !ctx.is_element_scannable(elem, &mut visiting) {
                return false;
            }
        }
    }
    return true;
}

/// Longest-match scan dispatch for general groups (overlapping alts):
/// `gen_scan_winner_tournament` scans every candidate and picks the
/// furthest end (ties to the first grammar alt), then only the winner is
/// parsed and stored into `inner_var`.
fn gen_general_group_scan_dispatch(
    w: &mut CodeWriter,
    alts: &List<Alternative>,
    g_op_alts: &List<AltBody>,
    g_op_scan_alts: &List<ScanBody>,
    sorted_group: &List<i32>,
    type_name: &String,
    alt_struct_names: &List<String>,
    inner_var: &String,
    ctx: &mut GenContext,
    name_counts: &mut List<[String, i32]>,
) {
    let winner_var = gen_scan_winner_tournament(w, sorted_group, g_op_scan_alts, ctx, name_counts);
    let last = sorted_group.len() - 1;

    // Each alt's parse emits `let inner_var = ::Alt_i(StructName { ... })`;
    // delegate to `gen_general_alt_parse_and_store` so the parse-side
    // emit (element walk + struct construction) stays in a single place.
    for let mut k = 0; k < sorted_group.len(); k += 1 {
        let alt_index = sorted_group[k];
        let is_last = k == last;

        if k == 0 && !is_last {
            w.begin(&`if ${winner_var} == ${alt_index}`);
        } else if is_last {
            w.else_begin(&"else");
        } else {
            w.else_begin(&`else if ${winner_var} == ${alt_index}`);
        }

        gen_general_alt_parse_and_store(
            w,
            alts,
            &g_op_alts[alt_index],
            alt_index,
            ctx,
            name_counts,
        );
    }
    w.end();
}

pub fn compute_lr_second_token(shared_token: &String, elements: &List<Element>, ctx: &mut GenContext) -> List<String> {
    // Find what token follows the shared_token in this alternative's suffix.
    // Walk suffix elements (starting at index 1) to find the shared token,
    // then return the first set of the next element.
    for let mut i = 1; i < elements.len(); i += 1 {
        let elem = &elements[i];
        // Check if this element contains the shared token
        let mut visiting: List<String> = [];
        let elem_first = ctx.first_of_element(elem, &mut visiting);
        if !first_contains(&elem_first, shared_token) {
            continue;
        }

        // This element matches the shared token. Check if it's an Optional that wraps it.
        if is_nullable(elem) {
            // The shared token is inside an optional (e.g. K_NOT?).
            // The "second token" is the next element after the optional.
            if i + 1 < elements.len() {
                return ctx.first_of_elements_from(elements, i + 1);
            }
        }

        // The shared token is inside a Group (e.g. (K_ISNULL | K_NOTNULL | K_NOT K_NULL)).
        // Find the alternative within the group that starts with shared_token,
        // and return the first set of its second element.
        if let Group(g) = elem {
            let alts = &g.alternatives;
            for let mut a = 0; a < alts.len(); a += 1 {
                let alt = &alts[a];
                if alt.elements.len() < 1 {
                    continue;
                }
                let mut v2: List<String> = [];
                let alt_first = ctx.first_of_element(&alt.elements[0], &mut v2);
                if first_contains(&alt_first, shared_token) && alt.elements.len() >= 2 {
                    return ctx.first_of_elements_from(&alt.elements, 1);
                }
            }
        }

        // Fallback: return next element's first set
        if i + 1 < elements.len() {
            return ctx.first_of_elements_from(elements, i + 1);
        }
    }
    return [];
}

fn gen_lr_call_with_prec(
    w: &mut CodeWriter,
    suffix_fn: &String,
    scan_suffix_fn: &String,
    prec: i32,
    use_prec: bool,
    emit_follow: bool,
) {
    // First-token dispatch alone can mis-predict an LR continuation when the
    // suffix's first token is shared with the atom (e.g.
    // `statement: letterA | statement letterA 'b'`). In that case the suffix
    // can begin to match and then fail on a later element, leaving `p.pos`
    // mid-suffix and corrupting any enclosing repetition driver. Consult the
    // scan twin first — it has no side effects — and only commit to the
    // (mutating) parse when the scan confirms the suffix would succeed.
    if use_prec {
        w.begin(&`if ${prec} >= min_prec`);
        w.begin(&`if ${*scan_suffix_fn}(&p.kinds, p.pos) < 0`);
        w.line(&"break;");
        w.end();
        w.line(&`result = ${*suffix_fn}(p, result, start${follow_sep(emit_follow)});`);
        w.else_begin(&"else");
        w.line(&"break;");
        w.end();
    } else {
        w.begin(&`if ${*scan_suffix_fn}(&p.kinds, p.pos) < 0`);
        w.line(&"break;");
        w.end();
        w.line(&`result = ${*suffix_fn}(p, result, start${follow_sep(emit_follow)});`);
    }
}

/// Project lower's `LrDispatchData` (which indexes into `lr_alts`)
/// into emit's per-alt arrays — alt indices in `rule.alternatives`,
/// per-alt precedence, per-alt suffix first set. Used by the suffix-
/// dispatch and overlap-dispatch helpers that still reference alt
/// indices directly.
fn project_lr_dispatch(
    lr_alts: &List<LrAlt>,
    lr_dispatch: &LrDispatchData,
) -> [List<i32>, List<i32>, List<List<String>>] {
    let mut valid_lr_indices: List<i32> = [];
    let mut lr_precs: List<i32> = [];
    let mut suffix_first_sets: List<List<String>> = [];
    for let v of &lr_dispatch.valid_lr_alts {
        let lr = &lr_alts[*v];
        valid_lr_indices.push(lr.alt_index);
        lr_precs.push(lr.own_prec);
        suffix_first_sets.push(lr.suffix_first);
    }
    return [valid_lr_indices, lr_precs, suffix_first_sets];
}

fn gen_prediction_code(
    w: &mut CodeWriter,
    node: &PredictionNode,
    fn_name: &String,
    alts: &List<Alternative>,
    lowered_rule: &Rule,
    type_name: &String,
    ctx: &mut GenContext,
    rule_display: &String,
) {
    gen_prediction_code_inner(w, node, fn_name, alts, lowered_rule, type_name, ctx, 0, rule_display);
}

/// Emit the per-decision preamble for a save-and-rewind speculative alt
/// dispatch: snapshot the cursor, the builder, and the pending error so a
/// rejected alt can be rolled back completely.
fn emit_spec_alt_preamble(w: &mut CodeWriter) {
    w.line(&"let saved = p.pos;");
    w.line(&"let _spec_cp = p.b.checkpoint();");
    w.line(&"let _spec_pend = p.pending;");
    w.line(&"let _spec_code = p.pending_code;");
}

/// Emit the per-alt index dispatch shared by the longest-match tournament
/// (`var` = `_sd_best_i`) and the AtEndConflict ATN route (`var` = `_atn_alt`):
/// a single `trace_pick`, one `if ${var} == ${idx} { return _alt_${idx} }` per
/// alt, then an unconditional fallthrough to the last alt (its parse path
/// surfaces a useful diagnostic when `var` matched nothing).
fn emit_index_pick_dispatch(
    w: &mut CodeWriter,
    var: &String,
    sorted_indices: &List<i32>,
    fn_name: &String,
    rule_display: &String,
    ctx: &GenContext,
) {
    if ctx.is_trace() {
        w.line(&`trace_pick(p, &${str_lit(*rule_display)}, ${*var});`);
    }
    for let mut i = 0; i < sorted_indices.len(); i += 1 {
        let idx = sorted_indices[i];
        w.begin(&`if ${*var} == ${idx}`);
        w.line(&`return ${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)});`);
        w.end();
    }
    let last_idx = sorted_indices[sorted_indices.len() - 1];
    w.line(&`return ${*fn_name}_alt_${last_idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)});`);
}

/// Emit one speculative alt attempt. The alt runs under `speculating` so a
/// deeper mismatch records no recovery edits and only sets `recovering`; on
/// failure the cursor, builder, and pending error are rolled back to the
/// `emit_spec_alt_preamble` snapshot and the next alt is tried, on success the
/// rule returns. Mirrors the repeat probe in `gen_rep_break_with_recovery`.
fn emit_spec_alt_try(w: &mut CodeWriter, call: &String, idx: i32, ctx: &GenContext, rule_display: &String) {
    w.line(&"let _ss = p.speculating;");
    w.line(&"p.speculating = true;");
    w.line(&`${*call};`);
    w.line(&"p.speculating = _ss;");
    w.begin(&"if p.recovering");
    if ctx.is_trace() {
        w.line(&`trace_try(p, &${str_lit(*rule_display)}, ${idx}, false);`);
    }
    w.line(&"p.pos = saved;");
    w.line(&"p.b.truncate(_spec_cp);");
    w.line(&"p.pending = _spec_pend;");
    w.line(&"p.pending_code = _spec_code;");
    w.line(&"p.recovering = false;");
    w.else_begin(&"else");
    if ctx.is_trace() {
        w.line(&`trace_try(p, &${str_lit(*rule_display)}, ${idx}, true);`);
    }
    emit_no_viable_return(w, ctx);
    w.end();
}

fn gen_prediction_code_inner(
    w: &mut CodeWriter,
    node: &PredictionNode,
    fn_name: &String,
    alts: &List<Alternative>,
    lowered_rule: &Rule,
    type_name: &String,
    ctx: &mut GenContext,
    skip: i32,
    rule_display: &String,
) {
    match node {
        Leaf(idx) => {
            // Consume advanced `p.pos` past `skip` shared tokens without building a
            // node; rewind so `_alt_<idx>` re-parses the alt from its start.
            if skip > 0 {
                w.line(&`p.pos -= ${skip};`);
            }
            w.line(&`return ${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)});`);
        },
        Consume(c) => {
            // Shared-prefix terminal: advance past it (the chosen `_alt_<idx>`
            // re-parses it) and descend to the disambiguating dispatch. It must
            // match every alt below (the group need not contain alt 0; regression:
            // ll_consume_group.g4); on a mismatch leave `p.pos`/`skip` so the Leaf
            // rewinds exactly what was advanced.
            let mut node_alts: List<i32> = [];
            prediction_collect_all_indices(&c.child, &mut node_alts);
            let mut elem_matches = !node_alts.is_empty();
            for let a of &node_alts {
                if skip >= alts[*a].elements.len() || !elements_match(&c.element, &alts[*a].elements[skip]) {
                    elem_matches = false;
                    break;
                }
            }
            if elem_matches {
                w.line(&"p.pos += 1;");
                gen_prediction_code_inner(
                    w,
                    &c.child,
                    fn_name,
                    alts,
                    lowered_rule,
                    type_name,
                    ctx,
                    skip + 1,
                    rule_display,
                );
            } else {
                gen_prediction_code_inner(w, &c.child, fn_name, alts, lowered_rule, type_name, ctx, skip, rule_display);
            }
        },
        Ambiguous(a) => {
            // Sort by element count for proper ordering (single RuleRef first, etc.)
            let mut sorted_indices = a.alts.sorted();
            sort_group_by_element_count(&mut sorted_indices, alts);
            if skip == 0 {
                if ctx.emit_actions() && ambiguous_group_predicate_gated(&a.alts, alts, ctx) {
                    gen_predicate_gated_dispatch(w, &a.alts, alts, fn_name, ctx, rule_display);
                    return;
                }
                let amb_rule = ctx.current_rule_index();
                let route_via_atn = ambiguous_node_routes_via_atn(a, rule_display, ctx);
                if route_via_atn {
                    let dec = ctx.atn_rule_body_decision(amb_rule);
                    let disabled_arg = emit_atn_disabled_seed(w, &a.alts, alts, ctx);
                    w.line(
                        &`let _atn_alt = atn_predict_with_stack(&ATN_SIM, ${dec}, &p.atn_stack, &p.kinds, p.pos, TK_EOF, 0${disabled_arg});`,
                    );
                    // A seed can exclude every alt (`_atn_alt == -1`), which the
                    // index dispatch would otherwise route to its last alt.
                    if !disabled_arg.is_empty() {
                        w.begin(&"if _atn_alt < 0");
                        w.line(&`p.no_viable("no viable alternative", p.peek_span(), []);`);
                        emit_no_viable_return(w, ctx);
                        w.end();
                    }
                    emit_index_pick_dispatch(w, &"_atn_alt", &sorted_indices, fn_name, rule_display, ctx);
                    return;
                }
                // Check if any alternatives have scan functions available.
                // If ALL non-last alternatives have scans, we run a longest-match
                // scan tournament: scan each, parse the winner. If some have
                // scans and some don't, use a hybrid approach.
                let mut all_have_scans = true;
                for let mut i = 0; i < sorted_indices.len() - 1; i += 1 {
                    let idx = sorted_indices[i];
                    if !alt_has_scan(&alts[idx].elements, ctx) {
                        all_have_scans = false;
                        break;
                    }
                }

                if all_have_scans && sorted_indices.len() >= 2 {
                    // All non-last alternatives have scan functions.
                    // Check if ALL scans are full (cover entire alternative) —
                    // including the last alt, which we need to scan for
                    // longest-match dispatch.
                    let mut all_full = true;
                    for let mut i = 0; i < sorted_indices.len(); i += 1 {
                        let idx = sorted_indices[i];
                        if !alt_has_scan(&alts[idx].elements, ctx) || !alt_scan_is_full(&alts[idx].elements, ctx) {
                            all_full = false;
                            break;
                        }
                    }

                    if all_full {
                        // All scans cover entire alternatives — scan success
                        // guarantees parse success. Use longest-match first-win
                        // (ANTLR4-compatible): scan each alt, pick the one
                        // advancing pos the furthest; ties go to the first alt
                        // in grammar order.
                        w.line(&"let _sd_tokens = &p.kinds;");
                        w.line(&"let _sd_pos = p.pos;");
                        for let mut i = 0; i < sorted_indices.len(); i += 1 {
                            let idx = sorted_indices[i];
                            w.line(&`let _sd_p_${idx} = ${*fn_name}_scan_${idx}(_sd_tokens, _sd_pos);`);
                        }
                        if ctx.is_trace() {
                            let rlit = str_lit(*rule_display);
                            for let mut i = 0; i < sorted_indices.len(); i += 1 {
                                let idx = sorted_indices[i];
                                w.line(&`trace_scan_alt(p, &${rlit}, ${idx}, _sd_p_${idx});`);
                            }
                        }
                        w.line(&"let mut _sd_best_i: i32 = -1;");
                        w.line(&"let mut _sd_best_p: i32 = -1;");
                        // Iterate in ascending alt-index order so a scan-length
                        // tie resolves to the first grammar alternative (ANTLR4's
                        // ambiguity resolution), not to the sort's front-runner.
                        let best_i = "_sd_best_i";
                        let best_p = "_sd_best_p";
                        for let idx of sorted_indices.sorted() {
                            let end_expr = `_sd_p_${idx}`;
                            emit_argmax_update(w, &best_p, &best_i, &end_expr, idx);
                        }
                        emit_index_pick_dispatch(w, &"_sd_best_i", &sorted_indices, fn_name, rule_display, ctx);
                    } else {
                        // Some scans are partial — scan success is a hint,
                        // not a guarantee. Use save/restore with scan guards.
                        emit_spec_alt_preamble(w);
                        for let mut i = 0; i < sorted_indices.len(); i += 1 {
                            let idx = sorted_indices[i];
                            let is_last = i == sorted_indices.len() - 1;
                            if is_last {
                                if ctx.is_trace() {
                                    w.line(&`trace_pick(p, &${str_lit(*rule_display)}, ${idx});`);
                                }
                                w.line(
                                    &`return ${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)});`,
                                );
                            } else {
                                let has_scan = alt_has_scan(&alts[idx].elements, ctx);
                                let is_full = has_scan && alt_scan_is_full(&alts[idx].elements, ctx);
                                if is_full {
                                    // Full scan: success guarantees parse success.
                                    w.begin(&`if ${*fn_name}_scan_${idx}(&p.kinds, p.pos) >= 0`);
                                    if ctx.is_trace() {
                                        w.line(&`trace_pick(p, &${str_lit(*rule_display)}, ${idx});`);
                                    }
                                    w.line(
                                        &`return ${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(
                                            ctx,
                                        )});`,
                                    );
                                    w.end();
                                } else if has_scan {
                                    // Partial scan: try parse, fall through on failure.
                                    w.begin(&`if ${*fn_name}_scan_${idx}(&p.kinds, p.pos) >= 0`);
                                    emit_spec_alt_try(
                                        w,
                                        &`${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)})`,
                                        idx,
                                        ctx,
                                        rule_display,
                                    );
                                    w.end();
                                } else {
                                    // No scan: save-and-rewind speculative parse.
                                    emit_spec_alt_try(
                                        w,
                                        &`${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)})`,
                                        idx,
                                        ctx,
                                        rule_display,
                                    );
                                }
                            }
                        }
                    }
                } else {
                    // Fallback: save-and-rewind speculative parse pattern.
                    emit_spec_alt_preamble(w);
                    for let mut i = 0; i < sorted_indices.len(); i += 1 {
                        let idx = sorted_indices[i];
                        let is_last = i == sorted_indices.len() - 1;
                        if is_last {
                            if ctx.is_trace() {
                                w.line(&`trace_pick(p, &${str_lit(*rule_display)}, ${idx});`);
                            }
                            w.line(
                                &`return ${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)});`,
                            );
                        } else {
                            emit_spec_alt_try(
                                w,
                                &`${*fn_name}_alt_${idx}(p${follow_sep(ctx.emit_follow())}${alt_vals_arg(ctx)})`,
                                idx,
                                ctx,
                                rule_display,
                            );
                        }
                    }
                }
            } else {
                // Prefix already consumed — should not happen.
                // Consume nodes that lead to Ambiguous are stripped at build time.
                panic("unreachable: Consume leading to Ambiguous should have been stripped");
            }
        },
        Dispatch(d) => {
            let check_var = if d.depth == 0 { "p.peek_kind()" } else { `p.peek_at(${d.depth})` };
            for let mut i = 0; i < d.branches.len(); i += 1 {
                let branch = &d.branches[i];
                let cond = ctx.kind_check_str(&branch.tokens, &check_var);
                if i == 0 {
                    w.begin(&`if ${cond}`);
                } else {
                    w.else_begin(&`else if ${cond}`);
                }
                gen_prediction_code_inner(
                    w,
                    &branch.child,
                    fn_name,
                    alts,
                    lowered_rule,
                    type_name,
                    ctx,
                    skip,
                    rule_display,
                );
            }
            w.end();
        },
    }
}

/// Check if a consumed element matches the expected element at a given skip position.
/// Returns true only for exact terminal matches (TokenRef or Literal).
/// Unwraps Labels to compare inner elements.
fn elements_match(consumed: &Element, expected: &Element) -> bool {
    let exp = unwrap_label(expected);
    return match consumed {
        TokenRef(a) => *exp matches { TokenRef(b) && b.name == a.name },
        Literal(a) => *exp matches { Literal(b) && b.text == a.text },
        RuleRef(_) | Group(_) | Repeat(_) | Label(_) | Wildcard(_) | Not(_) => false,
    };
}

/// Collect the alt indices whose per-alt `_scan_<n>` helper the dispatch
/// actually calls. Must mirror the `Ambiguous` arm of
/// `gen_prediction_code_inner`: only an `Ambiguous` node (the longest-match
/// tournament / hybrid path) references a scan helper, so a token-led
/// `Dispatch`/`Leaf` tree leaves every per-alt helper dead.
fn collect_referenced_scan_alts(
    node: &PredictionNode,
    alts: &List<Alternative>,
    ctx: &mut GenContext,
    out: &mut List<i32>,
) {
    match *node {
        Leaf(_) => {
        },
        Consume(c) => collect_referenced_scan_alts(&c.child, alts, ctx, out),
        Dispatch(d) => {
            for let branch of &d.branches {
                collect_referenced_scan_alts(&branch.child, alts, ctx, out);
            }
        },
        Ambiguous(a) => {
            if ctx.emit_actions() && ambiguous_group_predicate_gated(&a.alts, alts, ctx) {
                return;
            }
            let mut sorted_indices = a.alts.sorted();
            sort_group_by_element_count(&mut sorted_indices, alts);
            let mut all_have_scans = true;
            for let mut i = 0; i < sorted_indices.len() - 1; i += 1 {
                if !alt_has_scan(&alts[sorted_indices[i]].elements, ctx) {
                    all_have_scans = false;
                    break;
                }
            }
            if !(all_have_scans && sorted_indices.len() >= 2) {
                return;
            }
            // `all_full` ⇒ longest-match tournament scans every alt; otherwise
            // the hybrid path scans only the non-last alts that have a scan.
            let mut all_full = true;
            for let mut i = 0; i < sorted_indices.len(); i += 1 {
                let idx = sorted_indices[i];
                if !alt_has_scan(&alts[idx].elements, ctx) || !alt_scan_is_full(&alts[idx].elements, ctx) {
                    all_full = false;
                    break;
                }
            }
            if all_full {
                for let idx of &sorted_indices {
                    if !out.contains(idx) {
                        out.push(*idx);
                    }
                }
            } else {
                for let mut i = 0; i < sorted_indices.len() - 1; i += 1 {
                    let idx = sorted_indices[i];
                    if alt_has_scan(&alts[idx].elements, ctx) && !out.contains(&idx) {
                        out.push(idx);
                    }
                }
            }
        },
    }
}

/// Emit the body of a multi-alt rule whose alts have overlapping
/// FIRST sets — the prediction codepath. `fn_name` is the name of
/// the surrounding emit function (`parse_<rule>`); it's threaded into
/// `gen_prediction_code` so the dispatcher references this rule's own
/// `_alt_<n>` / `_scan_<n>` helpers.
fn gen_multi_alt_body_alt(
    w: &mut CodeWriter,
    rule: &ParserRule,
    lowered_rule: &Rule,
    type_name: &String,
    ctx: &mut GenContext,
    groups: &List<List<i32>>,
    first_sets: &List<List<String>>,
    non_lr_indices: &List<i32>,
    fn_name: &String,
) {
    w.line(&"let kind = p.peek_kind();");

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];
        let mut union_first: List<String> = [];
        for let idx of group {
            dedup_append_arr(&mut union_first, &first_sets[*idx]);
        }

        let gate = if group.len() == 1 {
            alt_gate_and_suffix(&rule.alternatives[non_lr_indices[group[0]]], ctx);
        } else {
            String::new();
        };
        let cond = ctx.kind_check_str(&union_first, &"kind");
        w.begin(&`if ${cond}${gate}`);

        if group.len() == 1 {
            let alt_index = non_lr_indices[group[0]];
            let alt = &rule.alternatives[alt_index];
            let body = rule_alt_body(lowered_rule, alt_index).unwrap();
            // Match the direct-dispatch path: suppress the pick line for
            // all-single-token rules (the chosen alt is obvious from the
            // lookahead token on the `enter` line).
            if ctx.is_trace() && !all_alts_are_single_token(&rule.alternatives) {
                w.line(&`trace_pick(p, &${str_lit(rule.name)}, ${alt_index});`);
            }
            let after = rule_after_for(rule, lowered_rule, ctx);
            gen_alt_body(
                w,
                type_name,
                Option::Some(body.case_name),
                Option::Some(body.struct_name),
                alt,
                body,
                alt_index,
                rule_alts_labeled(&rule.alternatives),
                &after,
                ctx,
            );
        } else {
            let tree = build_group_prediction_tree(&rule.alternatives, group, first_sets, non_lr_indices, ctx);
            gen_prediction_code(w, &tree, fn_name, &rule.alternatives, lowered_rule, type_name, ctx, &rule.name);
        }

        w.end();
    }

    gen_error_fallback(w, rule, type_name, ctx);
}

/// `_parse_<rule>` for a left-recursive rule whose surface body
/// carries at least one LR-alt takes a trailing `min_prec: i32`
/// argument (see `lr_util.compute_prefix_self_ref_min_prec`). The
/// public input-entry must match that signature.
fn rule_takes_min_prec(rule: &Rule) -> bool {
    return match *rule {
        LeftRecursive(_) => true,
        Simple(_) | MultiAlt(_) => false,
    };
}

/// Emit a `_kind_set_<id>(k: i32) -> bool` function for every
/// multi-element token-kind set interned during parser codegen. The
/// `ctx.kind_check_str` and `ctx.kind_negate_check_str` methods rewrite
/// every multi-element `matches { ... }` check into a call into one of
/// these helpers, so duplicate sets share a single function body in
/// the generated wasm.
/// Emit `_kind_set_<id>(k) -> bool` helpers. The id range
/// `0..lowered.kind_sets.len()` reads tokens directly from
/// `lowered.kind_sets` — that's lower's Phase 2.7 pre-interning
/// surfacing as actual generated code. Higher ids (sets emit-time
/// `kind_check_str` interned during walk) read from
/// `ctx.kind_sets()` as a salvage tail, same pattern as the
/// variant-emission split.
///
/// For the lower-registered prefix, the generated helper body is
/// the canonical proof that `lowered.kind_sets[i].tokens` matches
/// what emit subsequently calls — a mismatch would compile but
/// parse wrong (the helper body would not include the token emit
/// queries). Today the two registries converge by construction
/// because both intern through the same `ctx.intern_kind_set`
/// keyed by canonical token order.
pub fn gen_kind_set_helpers(w: &mut CodeWriter, lowered: &LoweredGrammar, ctx: &GenContext) {
    let entries = ctx.kind_sets();
    for let mut idx = 0; idx < entries.len(); idx += 1 {
        if idx < lowered.kind_sets.len() {
            let ks = &lowered.kind_sets[idx];
            gen_kind_set_helper_raw(w, ks.id, &ctx.token_names_of(&ks.tokens));
        } else {
            let entry = &entries[idx];
            gen_kind_set_helper_raw(w, entry.id, &ctx.token_names_of(&entry.tokens));
        }
    }
}

/// Emit `global FOLLOW_MASK_<id>: List<List<i32>> = [[TK_X], …]` for
/// every interned runtime FOLLOW mask, in `FollowMaskEntry` id order.
/// Repair call sites pass `&FOLLOW_MASK_<id>` to `follow_yields`. Emits
/// nothing while the registry is empty (the common case until the
/// runtime-follow conversion wires call sites).
pub fn gen_follow_mask_globals(w: &mut CodeWriter, ctx: &GenContext) {
    // No caller-FOLLOW gate anywhere ⇒ no call site references a mask,
    // so emitting the globals would leave them unused. Skip entirely.
    if !ctx.emit_follow() {
        return;
    }
    let entries = ctx.follow_masks();
    for let entry of &entries {
        let mut depths: List<String> = [];
        for let depth_set of &entry.mask {
            depths.push(`[${join_kinds(&ctx.token_names_of(depth_set))}]`);
        }
        w.line(&`global FOLLOW_MASK_${entry.id}: List<List<i32>> = [${join_kinds(&depths)}];`);
    }
    if !entries.is_empty() {
        w.blank();
    }
}

/// Emit the recovery sync-set globals: `EMPTY_SYNC` (the empty default) plus
/// one `SYNC_<id>: List<i32>` per interned non-empty set. `expect` takes its
/// `sync` by reference to one of these, so a terminal on the valid hot path
/// neither rebuilds nor copies the set.
pub fn gen_sync_set_globals(w: &mut CodeWriter, ctx: &GenContext) {
    if ctx.parser_rules.is_empty() {
        return;
    }
    w.line(&"global EMPTY_SYNC: List<i32> = [];");
    for let entry of &ctx.sync_sets() {
        w.line(&`global SYNC_${entry.id}: List<i32> = [${join_kinds(&ctx.token_names_of(&entry.tokens))}];`);
    }
    w.blank();
}

fn gen_kind_set_helper_raw(w: &mut CodeWriter, id: i32, tokens: &List<String>) {
    let mut f = FnSpec::new(&`_kind_set_${id}`);
    f.add_param(&"k", &"i32");
    f.set_return_type(&"bool");
    f.emit_begin(w);
    let mut body = String::with_capacity(64);
    body.push_str(&"return k matches { ");
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            body.push_str(&" | ");
        }
        body.push_str(&tokens[i]);
    }
    body.push_str(&" };");
    w.line(&body);
    w.end();
    w.blank();
}

fn build_lookahead_condition(ctx: &mut GenContext, pos_sets: &List<List<String>>, depth: i32) -> String {
    return join_lookahead_condition(ctx, pos_sets, depth, LookaheadAccess::ParseKind);
}

fn gen_error_fallback(w: &mut CodeWriter, rule: &ParserRule, type_name: &String, ctx: &mut GenContext) {
    let mut expected: List<String> = [];
    for let alt of rule.alternatives {
        let mut visiting: List<String> = [];
        let first = ctx.first_of_alt(&alt, &mut visiting);
        dedup_append_arr(&mut expected, &first);
    }
    let msg = str_lit(`expected ${rule.name}`);
    w.line(&`p.no_viable(`);
    w.indent();
    w.line(&`${msg},`);
    w.line(&"p.peek_span(),");
    w.write(&"[");
    for let mut i = 0; i < expected.len(); i += 1 {
        if i > 0 {
            w.write(&", ");
        }
        w.write(&`${str_lit(expected[i])}`);
    }
    w.write(&"],\n");
    w.dedent();
    w.line(&");");
    if current_rule_emits_vals(ctx) {
        w.line(&"return vals;");
    } else {
        w.line(&"return;");
    }
}

fn find_needed_depth(all_position_sets: &List<List<List<String>>>) -> i32 {
    let max_k = MAX_LOOKAHEAD_DEPTH;
    for let mut depth = 1; depth <= max_k; depth += 1 {
        let mut all_ok = true;
        for let mut i = 0; i < all_position_sets.len(); i += 1 {
            for let mut j = i + 1; j < all_position_sets.len(); j += 1 {
                let mut still_ambiguous = true;
                for let mut d = 0; d < depth; d += 1 {
                    if d >= all_position_sets[i].len() || d >= all_position_sets[j].len() {
                        still_ambiguous = false;
                        break;
                    }
                    if !sets_overlap(&all_position_sets[i][d], &all_position_sets[j][d]) {
                        still_ambiguous = false;
                        break;
                    }
                }
                if still_ambiguous {
                    all_ok = false;
                }
            }
        }
        if all_ok {
            return depth;
        }
    }
    return max_k;
}
