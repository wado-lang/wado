use {
    Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement,
    RepeatKind, LexerRule,
} from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use {
    to_lower, to_snake_case, to_pascal_case, rule_type_name, literal_field_name,
    strip_suffix, escape_string, literal_const_name, array_contains_str,
} from "./gen_util.wado";

pub fn gen_parser(out: &mut String, grammar: &Grammar, lit_tokens: &Array<LitToken>) {
    gen_parser_struct(out);
    for let rule of grammar.parser_rules {
        gen_parse_fn(out, &rule, &grammar.parser_rules, lit_tokens);
    }
    gen_parse_entry(out, &grammar.parser_rules);
}

fn gen_parser_struct(out: &mut String) {
    out.append("struct Parser {\n");
    out.append("    tokens: Array<Token>,\n");
    out.append("    pos: i32,\n");
    out.append("}\n\n");
    out.append("impl Parser {\n");
    out.append("    fn new(tokens: Array<Token>) -> Parser {\n");
    out.append("        return Parser { tokens, pos: 0 };\n");
    out.append("    }\n\n");
    out.append("    fn peek(&self) -> &Token {\n");
    out.append("        return &self.tokens[self.pos];\n");
    out.append("    }\n\n");
    out.append("    fn peek_kind(&self) -> i32 {\n");
    out.append("        return self.tokens[self.pos].kind;\n");
    out.append("    }\n\n");
    out.append("    fn peek_at(&self, offset: i32) -> i32 {\n");
    out.append("        let idx = self.pos + offset;\n");
    out.append("        if idx >= self.tokens.len() { return TK_EOF; }\n");
    out.append("        return self.tokens[idx].kind;\n");
    out.append("    }\n\n");
    out.append("    fn advance(&mut self) -> Token {\n");
    out.append("        let tok = self.tokens[self.pos];\n");
    out.append("        self.pos += 1;\n");
    out.append("        return tok;\n");
    out.append("    }\n\n");
    out.append("    fn last_end(&self) -> i32 {\n");
    out.append("        if self.pos == 0 { return 0; }\n");
    out.append("        return self.tokens[self.pos - 1].span.end;\n");
    out.append("    }\n\n");
    out.append("    fn expect(&mut self, kind: i32, name: String) -> Result<Token, ParseError> {\n");
    out.append("        if self.tokens[self.pos].kind == kind {\n");
    out.append("            return Result::<Token, ParseError>::Ok(self.advance());\n");
    out.append("        }\n");
    out.append("        let tok = &self.tokens[self.pos];\n");
    out.append("        return Result::<Token, ParseError>::Err(ParseError::new(\n");
    out.append("            `expected {name}, got \"{tok.text}\"`,\n");
    out.append("            tok.span,\n");
    out.append("            [name],\n");
    out.append("        ));\n");
    out.append("    }\n");
    out.append("}\n\n");
}

fn gen_parse_fn(
    out: &mut String,
    rule: &ParserRule,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let type_name = rule_type_name(&rule.name);
    let fn_name = `parse_{to_snake_case(&rule.name)}`;

    if rule.alternatives.len() == 1 {
        out.append(`fn {fn_name}(p: &mut Parser) -> Result<{type_name}, ParseError> \{\n`);
        out.append("    let start = p.peek().span.start;\n");
        gen_alt_body(out, &type_name, null, null, &rule.alternatives[0], all_rules, lit_tokens, "    ");
        out.append("}\n\n");
        return;
    }

    // Multi-alt: filter out left-recursive alternatives and check for overlapping FIRST sets
    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    // Identify non-left-recursive alternatives
    let mut non_lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if !is_left_recursive(&rule.alternatives[i], &rule.name) {
            non_lr_indices.append(i);
        }
    }

    let mut first_sets: Array<Array<String>> = [];
    for let idx of non_lr_indices {
        let mut visiting: Array<String> = [];
        first_sets.append(first_of_alt(&rule.alternatives[idx], all_rules, lit_tokens, &mut visiting));
    }
    let mut groups = compute_overlap_groups(&first_sets);
    let needs_bt = has_multi_alt_groups(&groups);

    // Sort each backtracking group: more specific alternatives (deeper LL(k)) first
    if needs_bt {
        for let mut g = 0; g < groups.len(); g += 1 {
            if groups[g].len() > 1 {
                sort_group_by_specificity(&mut groups[g], &non_lr_indices, &rule.alternatives, all_rules, lit_tokens);
            }
        }
    }

    if needs_bt {
        // Emit helper functions for backtracking alternatives
        for let group of groups {
            if group.len() > 1 {
                for let gi of group {
                    let alt_idx = non_lr_indices[gi];
                    let alt = &rule.alternatives[alt_idx];
                    let case_name = if all_labeled {
                        alt.label.unwrap()
                    } else {
                        `Alt{alt_idx}`
                    };
                    let sname = `{strip_suffix(&type_name, "Node")}{case_name}`;
                    let helper_name = `{fn_name}_bt_{alt_idx}`;

                    out.append(`fn {helper_name}(p: &mut Parser) -> Result<{type_name}, ParseError> \{\n`);
                    out.append("    let start = p.peek().span.start;\n");
                    gen_alt_body(out, &type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens, "    ");
                    out.append("}\n\n");
                }
            }
        }
    }

    // Check for left-recursive alternatives
    let mut lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if is_left_recursive(&rule.alternatives[i], &rule.name) {
            lr_indices.append(i);
        }
    }
    let has_lr = lr_indices.len() > 0;

    if has_lr {
        // Emit atom function (base expression parser)
        out.append(`fn {fn_name}_atom(p: &mut Parser) -> Result<{type_name}, ParseError> \{\n`);
        out.append("    let start = p.peek().span.start;\n");
        if needs_bt {
            gen_multi_alt_body_bt(out, rule, &type_name, all_rules, lit_tokens, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(out, rule, &type_name, all_rules, lit_tokens);
        }
        out.append("}\n\n");

        // Emit LR suffix handler functions
        gen_lr_suffix_helpers(out, rule, &type_name, &lr_indices, all_rules, lit_tokens);

        // Emit main parse function with suffix loop
        out.append(`fn {fn_name}(p: &mut Parser) -> Result<{type_name}, ParseError> \{\n`);
        out.append("    let start = p.peek().span.start;\n");
        out.append(`    let mut result = {fn_name}_atom(p)?;\n`);
        gen_lr_suffix_dispatch(out, rule, &type_name, &lr_indices, all_rules, lit_tokens);
        out.append(`    return Result::<{type_name}, ParseError>::Ok(result);\n`);
        out.append("}\n\n");
    } else {
        // No left recursion: emit directly
        out.append(`fn {fn_name}(p: &mut Parser) -> Result<{type_name}, ParseError> \{\n`);
        out.append("    let start = p.peek().span.start;\n");
        if needs_bt {
            gen_multi_alt_body_bt(out, rule, &type_name, all_rules, lit_tokens, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(out, rule, &type_name, all_rules, lit_tokens);
        }
        out.append("}\n\n");
    }
}

fn gen_alt_body(
    out: &mut String,
    type_name: &String,
    variant_case: Option<String>,
    struct_name: Option<String>,
    alt: &Alternative,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
) {
    gen_alt_elements(out, &alt.elements, all_rules, lit_tokens, indent);

    let end_expr = "p.last_end()";
    if let Some(case) = variant_case {
        let sname = struct_name.unwrap();
        out.append(`{indent}return Result::<{type_name}, ParseError>::Ok({type_name}::{case}({sname} \{\n`);
        out.append(`{indent}    span: Span::new(start, {end_expr}),\n`);
        gen_field_assignments(out, &alt.elements, `{indent}    `);
        out.append(`{indent}\}));\n`);
    } else {
        out.append(`{indent}return Result::<{type_name}, ParseError>::Ok({type_name} \{\n`);
        out.append(`{indent}    span: Span::new(start, {end_expr}),\n`);
        gen_field_assignments(out, &alt.elements, `{indent}    `);
        out.append(`{indent}\});\n`);
    }
}

fn gen_multi_alt_body(
    out: &mut String,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    // Compute LL(k) lookahead info
    let max_k = 5;
    let mut all_pos_sets: Array<Array<Array<String>>> = [];
    for let alt of rule.alternatives {
        all_pos_sets.append(alt_position_first_sets(&alt, max_k, all_rules, lit_tokens));
    }
    let depth = find_needed_depth(&all_pos_sets);

    out.append("    let kind = p.peek_kind();\n");

    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        let alt = &rule.alternatives[i];
        let case_name = if all_labeled {
            alt.label.unwrap()
        } else {
            `Alt{i}`
        };
        let sname = `{strip_suffix(type_name, "Node")}{case_name}`;

        let pos_sets = &all_pos_sets[i];
        let cond_depth = if depth < pos_sets.len() { depth } else { pos_sets.len() };

        if cond_depth > 0 {
            out.append("    if ");
            for let mut d = 0; d < cond_depth; d += 1 {
                if d > 0 { out.append(" && "); }
                let tokens = &pos_sets[d];
                let check_expr = if d == 0 { "kind" } else { `p.peek_at({d})` };
                if tokens.len() == 1 {
                    out.append(`{check_expr} == {tokens[0]}`);
                } else {
                    out.append("(");
                    for let mut j = 0; j < tokens.len(); j += 1 {
                        if j > 0 { out.append(" || "); }
                        out.append(`{check_expr} == {tokens[j]}`);
                    }
                    out.append(")");
                }
            }
            out.append(" {\n");
        } else {
            out.append("    {\n");
        }

        gen_alt_body(out, type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens, "        ");
        out.append("    }\n");
    }

    // Error fallback
    let mut expected: Array<String> = [];
    for let alt of rule.alternatives {
        let mut visiting2: Array<String> = [];
        let first = first_of_alt(&alt, all_rules, lit_tokens, &mut visiting2);
        for let tk of first {
            if !array_contains_str(&expected, &tk) {
                expected.append(tk);
            }
        }
    }
    out.append(`    return Result::<{type_name}, ParseError>::Err(ParseError::new(\n`);
    out.append(`        `);
    out.append(escape_string(&`expected {rule.name}`));
    out.append(",\n");
    out.append("        p.peek().span,\n");
    out.append("        [");
    for let mut i = 0; i < expected.len(); i += 1 {
        if i > 0 { out.append(", "); }
        out.append(escape_string(&expected[i]));
    }
    out.append("],\n");
    out.append("    ));\n");
}

fn gen_alt_elements(
    out: &mut String,
    elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
) {
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        gen_element(out, &elem, all_rules, lit_tokens, indent, true, &mut name_counts);
    }
}

fn gen_element(
    out: &mut String,
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
    store: bool,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let const_name = `TK_{name}`;
        if store {
            let field_name = dedup_name(&to_lower(&name), name_counts);
            out.append(`{indent}let {field_name} = p.expect({const_name}, {escape_string(&name)})?;\n`);
        } else {
            // Always bind result to ensure &mut self mutation persists
            let discard = dedup_name(&"tok", name_counts);
            out.append(`{indent}let {discard} = p.expect({const_name}, {escape_string(&name)})?;\n`);
        }
        return;
    }
    if let Literal(text) = *elem {
        let const_name = literal_const_name(&text);
        let display = `'{text}'`;
        if store {
            let field_name = dedup_name(&literal_field_name(&text), name_counts);
            out.append(`{indent}let {field_name} = p.expect({const_name}, {escape_string(&display)})?;\n`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            out.append(`{indent}let {discard} = p.expect({const_name}, {escape_string(&display)})?;\n`);
        }
        return;
    }
    if let RuleRef(name) = *elem {
        let fn_name = `parse_{to_snake_case(&name)}`;
        if store {
            let field_name = dedup_name(&to_snake_case(&name), name_counts);
            out.append(`{indent}let {field_name} = {fn_name}(p)?;\n`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            out.append(`{indent}let {discard} = {fn_name}(p)?;\n`);
        }
        return;
    }
    if let Repeat(rep) = *elem {
        gen_repeat(out, &rep, all_rules, lit_tokens, indent, name_counts);
        return;
    }
    if let Group(alts) = *elem {
        gen_consume_group(out, &alts, all_rules, lit_tokens, indent, name_counts);
        return;
    }
    if let Label(lab) = *elem {
        gen_element(out, &lab.element, all_rules, lit_tokens, indent, store, name_counts);
        return;
    }
}

fn gen_repeat(
    out: &mut String,
    rep: &RepeatElement,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
    name_counts: &mut Array<[String, i32]>,
) {
    let inner = &rep.element;
    let mut visiting: Array<String> = [];
    let first = first_of_element(inner, all_rules, lit_tokens, &mut visiting);
    let inner_indent = `{indent}    `;

    if has_field(inner) {
        let field_info = element_field_info(inner);
        if let Star = rep.kind {
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            out.append(`{indent}let mut {list_name}: Array<{field_info.1}> = [];\n`);
            out.append(`{indent}while `);
            gen_first_check(out, &first);
            out.append(" {\n");
            let mut nc: Array<[String, i32]> = [];
            gen_element(out, inner, all_rules, lit_tokens, &inner_indent, true, &mut nc);
            out.append(`{inner_indent}{list_name}.append({field_info.0});\n`);
            out.append(`{indent}\}\n`);
        }
        if let Plus = rep.kind {
            let mut nc: Array<[String, i32]> = [];
            gen_element(out, inner, all_rules, lit_tokens, indent, true, &mut nc);
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            out.append(`{indent}let mut {list_name}: Array<{field_info.1}> = [{field_info.0}];\n`);
            out.append(`{indent}while `);
            gen_first_check(out, &first);
            out.append(" {\n");
            let mut nc2: Array<[String, i32]> = [];
            gen_element(out, inner, all_rules, lit_tokens, &inner_indent, true, &mut nc2);
            out.append(`{inner_indent}{list_name}.append({field_info.0});\n`);
            out.append(`{indent}\}\n`);
        }
        if let Optional = rep.kind {
            let type_str = field_info.1;
            let opt_name = dedup_name(&field_info.0, name_counts);
            out.append(`{indent}let {opt_name}: Option<{type_str}> = if `);
            gen_first_check(out, &first);
            out.append(" {\n");
            let mut nc: Array<[String, i32]> = [];
            gen_element(out, inner, all_rules, lit_tokens, &inner_indent, true, &mut nc);
            out.append(`{inner_indent}Option::<{type_str}>::Some({field_info.0})\n`);
            out.append(`{indent}\} else \{ null \};\n`);
        }
    } else {
        if let Star = rep.kind {
            out.append(`{indent}while `);
            gen_first_check(out, &first);
            out.append(" {\n");
            let mut nc: Array<[String, i32]> = [];
            gen_element(out, inner, all_rules, lit_tokens, &inner_indent, false, &mut nc);
            out.append(`{indent}\}\n`);
        }
        if let Plus = rep.kind {
            gen_element(out, inner, all_rules, lit_tokens, indent, false, name_counts);
            out.append(`{indent}while `);
            gen_first_check(out, &first);
            out.append(" {\n");
            let mut nc: Array<[String, i32]> = [];
            gen_element(out, inner, all_rules, lit_tokens, &inner_indent, false, &mut nc);
            out.append(`{indent}\}\n`);
        }
        if let Optional = rep.kind {
            gen_optional_with_backtrack(out, inner, all_rules, lit_tokens, indent, &first, name_counts);
        }
    }
}

fn gen_optional_with_backtrack(
    out: &mut String,
    inner: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
    first: &Array<String>,
    name_counts: &mut Array<[String, i32]>,
) {
    let inner_indent = `{indent}    `;
    out.append(`{indent}if `);
    gen_first_check(out, first);
    out.append(" {\n");

    let saved = dedup_name(&"opt_saved", name_counts);
    let label = dedup_name(&"opt_bt", name_counts);
    out.append(`{inner_indent}let {saved} = p.pos;\n`);
    out.append(`{inner_indent}{label}: \{\n`);
    let bt_indent = `{inner_indent}    `;

    // Emit inner elements with failable error checking (break on error)
    if let Group(alts) = *inner {
        if alts.len() == 1 {
            for let elem of alts[0].elements {
                gen_element_failable(out, &elem, all_rules, lit_tokens, &bt_indent, &saved, &label, name_counts);
            }
        } else {
            // Multi-alt group: just use normal gen_element (may not backtrack inner errors)
            let mut nc: Array<[String, i32]> = [];
            gen_element(out, inner, all_rules, lit_tokens, &bt_indent, false, &mut nc);
        }
    } else {
        gen_element_failable(out, inner, all_rules, lit_tokens, &bt_indent, &saved, &label, name_counts);
    }

    out.append(`{inner_indent}\}\n`);
    out.append(`{indent}\}\n`);
}

fn gen_element_failable(
    out: &mut String,
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
    saved_var: &String,
    label: &String,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let const_name = `TK_{name}`;
        let r_var = dedup_name(&"opt_r", name_counts);
        out.append(`{indent}let {r_var} = p.expect({const_name}, {escape_string(&name)});\n`);
        out.append(`{indent}if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}\n`);
        return;
    }
    if let Literal(text) = *elem {
        let const_name = literal_const_name(&text);
        let display = `'{text}'`;
        let r_var = dedup_name(&"opt_r", name_counts);
        out.append(`{indent}let {r_var} = p.expect({const_name}, {escape_string(&display)});\n`);
        out.append(`{indent}if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}\n`);
        return;
    }
    if let RuleRef(name) = *elem {
        let fn_name = `parse_{to_snake_case(&name)}`;
        let r_var = dedup_name(&"opt_r", name_counts);
        out.append(`{indent}let {r_var} = {fn_name}(p);\n`);
        out.append(`{indent}if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}\n`);
        return;
    }
    if let Repeat(rep) = *elem {
        // Nested repeats within failable context: use normal gen_repeat
        // The inner Optional will generate its own backtracking
        gen_repeat(out, &rep, all_rules, lit_tokens, indent, name_counts);
        return;
    }
    if let Group(alts) = *elem {
        if alts.len() == 1 {
            for let inner_elem of alts[0].elements {
                gen_element_failable(out, &inner_elem, all_rules, lit_tokens, indent, saved_var, label, name_counts);
            }
        } else {
            gen_consume_group(out, &alts, all_rules, lit_tokens, indent, name_counts);
        }
        return;
    }
    if let Label(lab) = *elem {
        gen_element_failable(out, &lab.element, all_rules, lit_tokens, indent, saved_var, label, name_counts);
        return;
    }
}

fn has_field(elem: &Element) -> bool {
    if let TokenRef(_) = *elem { return true; }
    if let Literal(_) = *elem { return true; }
    if let RuleRef(_) = *elem { return true; }
    if let Label(lab) = *elem { return has_field(&lab.element); }
    return false;
}

fn element_field_info(elem: &Element) -> [String, String] {
    if let TokenRef(name) = *elem {
        return [to_lower(&name), "Token"];
    }
    if let Literal(text) = *elem {
        return [literal_field_name(&text), "Token"];
    }
    if let RuleRef(name) = *elem {
        return [to_snake_case(&name), rule_type_name(&name)];
    }
    if let Label(lab) = *elem {
        return element_field_info(&lab.element);
    }
    return ["_", "Token"];
}

fn gen_field_assignments(
    out: &mut String,
    elements: &Array<Element>,
    indent: String,
) {
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        gen_field_assignment(out, &elem, &mut name_counts, &indent);
    }
}

fn gen_field_assignment(
    out: &mut String,
    elem: &Element,
    name_counts: &mut Array<[String, i32]>,
    indent: &String,
) {
    if let TokenRef(name) = *elem {
        let field_name = dedup_name(&to_lower(&name), name_counts);
        out.append(`{indent}{field_name},\n`);
        return;
    }
    if let Literal(text) = *elem {
        let field_name = dedup_name(&literal_field_name(&text), name_counts);
        out.append(`{indent}{field_name},\n`);
        return;
    }
    if let RuleRef(name) = *elem {
        let field_name = dedup_name(&to_snake_case(&name), name_counts);
        out.append(`{indent}{field_name},\n`);
        return;
    }
    if let Repeat(rep) = *elem {
        if has_field(&rep.element) {
            let info = element_field_info(&rep.element);
            if let Star = rep.kind {
                let field_name = dedup_name(&`{info.0}_list`, name_counts);
                out.append(`{indent}{field_name},\n`);
            }
            if let Plus = rep.kind {
                let field_name = dedup_name(&`{info.0}_list`, name_counts);
                out.append(`{indent}{field_name},\n`);
            }
            if let Optional = rep.kind {
                let field_name = dedup_name(&info.0, name_counts);
                out.append(`{indent}{field_name},\n`);
            }
        }
        return;
    }
    if let Label(lab) = *elem {
        if has_field(&lab.element) {
            let field_name = to_snake_case(&lab.name);
            dedup_name(&field_name, name_counts);
            out.append(`{indent}{field_name},\n`);
        }
        return;
    }
}

fn gen_consume_group(
    out: &mut String,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
    name_counts: &mut Array<[String, i32]>,
) {
    if alts.len() == 0 { return; }
    if alts.len() == 1 {
        for let elem of alts[0].elements {
            gen_element(out, &elem, all_rules, lit_tokens, indent, false, name_counts);
        }
        return;
    }

    // Compute FIRST sets and group overlapping alternatives
    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.append(first_of_alt(&alt, all_rules, lit_tokens, &mut visiting));
    }
    let groups = compute_overlap_groups(&first_sets);

    // Generate dispatch code
    let grp_var = dedup_name(&"grp_kind", name_counts);
    out.append(`{indent}let {grp_var} = p.peek_kind();\n`);

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        // Compute union FIRST for the group
        let mut union_first: Array<String> = [];
        for let idx of group {
            for let tk of first_sets[*idx] {
                if !array_contains_str(&union_first, &tk) {
                    union_first.append(tk);
                }
            }
        }

        if g == 0 {
            out.append(`{indent}if `);
        } else {
            out.append(` else if `);
        }
        for let mut j = 0; j < union_first.len(); j += 1 {
            if j > 0 { out.append(" || "); }
            out.append(`{grp_var} == {union_first[j]}`);
        }
        out.append(" {\n");

        let inner = `{indent}    `;

        if group.len() == 1 {
            let alt_idx = group[0];
            let mut nc: Array<[String, i32]> = [];
            for let elem of alts[alt_idx].elements {
                gen_element(out, &elem, all_rules, lit_tokens, &inner, false, &mut nc);
            }
        } else {
            gen_backtracking_body(out, group, alts, all_rules, lit_tokens, &inner, name_counts);
        }

        out.append(`{indent}\}`);
    }
    out.append("\n");
}

fn gen_backtracking_body(
    out: &mut String,
    group: &Array<i32>,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    indent: &String,
    name_counts: &mut Array<[String, i32]>,
) {
    let saved_var = dedup_name(&"saved_pos", name_counts);
    let done_var = dedup_name(&"bt_done", name_counts);
    out.append(`{indent}let {saved_var} = p.pos;\n`);
    out.append(`{indent}let mut {done_var} = false;\n`);

    for let mut k = 0; k < group.len(); k += 1 {
        let alt_idx = group[k];
        let is_last = k == group.len() - 1;
        let alt = &alts[alt_idx];
        let body_indent = `{indent}    `;

        if is_last {
            out.append(`{indent}if !{done_var} \{\n`);
            let mut nc: Array<[String, i32]> = [];
            for let elem of alt.elements {
                gen_element(out, &elem, all_rules, lit_tokens, &body_indent, false, &mut nc);
            }
            out.append(`{indent}\}\n`);
        } else if alt.elements.len() == 1 {
            let el = &alt.elements[0];
            if let RuleRef(rule_name) = *el {
                let fn_name = `parse_{to_snake_case(&rule_name)}`;
                let r_var = dedup_name(&"r", name_counts);
                out.append(`{indent}if !{done_var} \{\n`);
                out.append(`{body_indent}let {r_var} = {fn_name}(p);\n`);
                out.append(`{body_indent}if let Err(_) = {r_var} \{\n`);
                out.append(`{body_indent}    p.pos = {saved_var};\n`);
                out.append(`{body_indent}\} else \{\n`);
                out.append(`{body_indent}    {done_var} = true;\n`);
                out.append(`{body_indent}\}\n`);
                out.append(`{indent}\}\n`);
            } else {
                out.append(`{indent}if !{done_var} \{\n`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(out, el, all_rules, lit_tokens, &body_indent, false, &mut nc);
                out.append(`{body_indent}{done_var} = true;\n`);
                out.append(`{indent}\}\n`);
            }
        } else {
            out.append(`{indent}if !{done_var} \{\n`);
            let mut nc: Array<[String, i32]> = [];
            for let elem of alt.elements {
                gen_element(out, &elem, all_rules, lit_tokens, &body_indent, false, &mut nc);
            }
            out.append(`{body_indent}{done_var} = true;\n`);
            out.append(`{indent}\}\n`);
        }
    }
}

fn gen_first_check(out: &mut String, first_set: &Array<String>) {
    if first_set.len() == 0 {
        out.append("true");
        return;
    }
    for let mut i = 0; i < first_set.len(); i += 1 {
        if i > 0 { out.append(" || "); }
        out.append(`p.peek_kind() == {first_set[i]}`);
    }
}

fn first_of_alt(
    alt: &Alternative,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    let mut result: Array<String> = [];
    for let elem of alt.elements {
        let elem_first = first_of_element(&elem, all_rules, lit_tokens, visiting);
        for let tk of elem_first {
            if !array_contains_str(&result, &tk) {
                result.append(tk);
            }
        }
        if !is_nullable(&elem) {
            break;
        }
    }
    return result;
}

fn first_of_element(
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    if let TokenRef(name) = *elem {
        return [`TK_{name}`];
    }
    if let Literal(text) = *elem {
        return [literal_const_name(&text)];
    }
    if let RuleRef(name) = *elem {
        return first_of_rule(&name, all_rules, lit_tokens, visiting);
    }
    if let Group(alts) = *elem {
        let mut result: Array<String> = [];
        for let alt of alts {
            let af = first_of_alt(&alt, all_rules, lit_tokens, visiting);
            for let tk of af {
                if !array_contains_str(&result, &tk) {
                    result.append(tk);
                }
            }
        }
        return result;
    }
    if let Repeat(rep) = *elem {
        return first_of_element(&rep.element, all_rules, lit_tokens, visiting);
    }
    if let Label(lab) = *elem {
        return first_of_element(&lab.element, all_rules, lit_tokens, visiting);
    }
    return [];
}

fn first_of_rule(
    name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    // Cycle detection: if we're already computing this rule's first set, return empty
    if array_contains_str(visiting, name) {
        return [];
    }
    visiting.append(*name);

    let mut result: Array<String> = [];
    for let rule of all_rules {
        if rule.name == *name {
            for let alt of rule.alternatives {
                let af = first_of_alt(&alt, all_rules, lit_tokens, visiting);
                for let tk of af {
                    if !array_contains_str(&result, &tk) {
                        result.append(tk);
                    }
                }
            }
            break;
        }
    }

    // Remove from visiting
    let mut new_visiting: Array<String> = [];
    for let v of visiting {
        if *v != *name {
            new_visiting.append(*v);
        }
    }
    *visiting = new_visiting;

    return result;
}


fn is_nullable(elem: &Element) -> bool {
    if let Repeat(rep) = *elem {
        if let Star = rep.kind { return true; }
        if let Optional = rep.kind { return true; }
    }
    return false;
}

/// Compute FIRST sets at each non-nullable element position for an alternative.
/// Position 0 uses the full first_of_alt logic (handles nullable prefixes).
/// Subsequent positions advance past elements that contributed to earlier positions.
fn alt_position_first_sets(
    alt: &Alternative,
    max_depth: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<Array<String>> {
    let mut result: Array<Array<String>> = [];
    let mut start = 0;
    while result.len() < max_depth && start < alt.elements.len() {
        // If the element at start is nullable and we already have positions,
        // its tokens are optional — can't use for hard LL(k) disambiguation
        if result.len() > 0 && is_nullable(&alt.elements[start]) { break; }

        let first = first_of_elements_from(&alt.elements, start, all_rules, lit_tokens);
        if first.len() == 0 { break; }
        result.append(first);
        // Advance past nullable elements and the first non-nullable element
        let mut skipped_nullable = false;
        while start < alt.elements.len() {
            let was_nullable = is_nullable(&alt.elements[start]);
            if was_nullable { skipped_nullable = true; }
            start += 1;
            if !was_nullable { break; }
        }
        // If we skipped nullable elements, subsequent raw-token positions
        // are unreliable for LL(k) lookahead
        if skipped_nullable { break; }
    }
    return result;
}

/// Like first_of_alt but starts from a given element index.
fn first_of_elements_from(
    elements: &Array<Element>,
    start: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<String> {
    let mut result: Array<String> = [];
    for let mut i = start; i < elements.len(); i += 1 {
        let mut visiting: Array<String> = [];
        let elem_first = first_of_element(&elements[i], all_rules, lit_tokens, &mut visiting);
        for let tk of elem_first {
            if !array_contains_str(&result, &tk) {
                result.append(tk);
            }
        }
        if !is_nullable(&elements[i]) { break; }
    }
    return result;
}

fn sets_overlap(a: &Array<String>, b: &Array<String>) -> bool {
    for let x of a {
        if array_contains_str(b, x) { return true; }
    }
    return false;
}

/// Find the minimum lookahead depth needed to disambiguate all alternatives.
fn find_needed_depth(all_position_sets: &Array<Array<Array<String>>>) -> i32 {
    let max_k = 5;
    for let mut depth = 1; depth <= max_k; depth += 1 {
        let mut all_ok = true;
        for let mut i = 0; i < all_position_sets.len(); i += 1 {
            for let mut j = i + 1; j < all_position_sets.len(); j += 1 {
                let mut still_ambiguous = true;
                for let mut d = 0; d < depth; d += 1 {
                    if d >= all_position_sets[i].len() || d >= all_position_sets[j].len() {
                        still_ambiguous = false;
                        break;
                    }
                    if !sets_overlap(&all_position_sets[i][d], &all_position_sets[j][d]) {
                        still_ambiguous = false;
                        break;
                    }
                }
                if still_ambiguous {
                    all_ok = false;
                }
            }
        }
        if all_ok { return depth; }
    }
    return max_k;
}

fn dedup_name(base: &String, counts: &mut Array<[String, i32]>) -> String {
    let count = get_count(counts, base);
    increment_count(counts, base);
    if count > 0 {
        return `{base}_{count + 1}`;
    }
    return *base;
}

fn get_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.append([*name, 1]);
}

fn all_alternatives_labeled(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}

fn gen_lr_suffix_helpers(
    out: &mut String,
    rule: &ParserRule,
    type_name: &String,
    lr_indices: &Array<i32>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    // Emit suffix handler functions (one per LR alternative)
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 { continue; }

        let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{lr_idx}` };
        let sname = `{strip_suffix(type_name, "Node")}{case_name}`;
        let suffix_fn = `{fn_name}_lr_{lr_idx}`;

        out.append(`fn {suffix_fn}(p: &mut Parser, left: {type_name}, start: i32) -> Result<{type_name}, ParseError> \{\n`);

        let indent = "    ";
        let mut name_counts: Array<[String, i32]> = [];
        dedup_name(&to_snake_case(&rule.name), &mut name_counts);

        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            let elem = &alt.elements[ei];
            if let RuleRef(name) = *elem {
                if name == rule.name {
                    let field_name = dedup_name(&to_snake_case(&name), &mut name_counts);
                    out.append(`{indent}let {field_name} = {fn_name}(p)?;\n`);
                } else {
                    let elem_fn = `parse_{to_snake_case(&name)}`;
                    let field_name = dedup_name(&to_snake_case(&name), &mut name_counts);
                    out.append(`{indent}let {field_name} = {elem_fn}(p)?;\n`);
                }
            } else if let Group(_) = *elem {
                let discard = dedup_name(&"op_tok", &mut name_counts);
                out.append(`{indent}let {discard} = p.advance();\n`);
            } else if let Repeat(rep) = *elem {
                gen_repeat(out, &rep, all_rules, lit_tokens, indent, &mut name_counts);
            } else {
                gen_element(out, elem, all_rules, lit_tokens, indent, true, &mut name_counts);
            }
        }

        out.append(`{indent}return Result::<{type_name}, ParseError>::Ok({type_name}::{case_name}({sname} \{\n`);
        out.append(`{indent}    span: Span::new(start, p.last_end()),\n`);
        let first_field = to_snake_case(&rule.name);
        out.append(`{indent}    {first_field}: left,\n`);
        let mut field_counts: Array<[String, i32]> = [];
        dedup_name(&to_snake_case(&rule.name), &mut field_counts);
        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            gen_field_assignment(out, &alt.elements[ei], &mut field_counts, indent);
        }
        out.append(`{indent}\}));\n`);
        out.append("}\n\n");
    }

}

fn gen_lr_suffix_dispatch(
    out: &mut String,
    rule: &ParserRule,
    type_name: &String,
    lr_indices: &Array<i32>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    out.append("    loop {\n");
    out.append("        let suffix_kind = p.peek_kind();\n");

    let mut is_first = true;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 { continue; }

        let mut suffix_first: Array<String> = [];
        let mut visiting: Array<String> = [];
        suffix_first = first_of_element(&alt.elements[1], all_rules, lit_tokens, &mut visiting);
        if suffix_first.len() == 0 { continue; }

        let suffix_fn = `{fn_name}_lr_{lr_idx}`;

        if is_first {
            out.append("        if ");
            is_first = false;
        } else {
            out.append(" else if ");
        }
        for let mut j = 0; j < suffix_first.len(); j += 1 {
            if j > 0 { out.append(" || "); }
            out.append(`suffix_kind == {suffix_first[j]}`);
        }
        out.append(" {\n");
        out.append(`            result = {suffix_fn}(p, result, start)?;\n`);
        out.append("        }");
    }

    if !is_first {
        out.append(" else {\n");
        out.append("            break;\n");
        out.append("        }\n");
    } else {
        out.append("        break;\n");
    }
    out.append("    }\n");
}

fn sort_group_by_specificity(
    group: &mut Array<i32>,
    non_lr_indices: &Array<i32>,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    // Compute LL(k) depth for each member (more positions = more specific)
    let mut depths: Array<i32> = [];
    for let gi of group {
        let alt_idx = non_lr_indices[*gi];
        let pos_sets = alt_position_first_sets(&alts[alt_idx], 5, all_rules, lit_tokens);
        depths.append(pos_sets.len());
    }
    // Bubble sort: deeper (more specific) alternatives first
    for let mut i = 0; i < group.len(); i += 1 {
        for let mut j = i + 1; j < group.len(); j += 1 {
            if depths[j] > depths[i] {
                let tmp = group[i]; group[i] = group[j]; group[j] = tmp;
                let tmp_d = depths[i]; depths[i] = depths[j]; depths[j] = tmp_d;
            }
        }
    }
}

fn is_left_recursive(alt: &Alternative, rule_name: &String) -> bool {
    if alt.elements.len() == 0 { return false; }
    let first = &alt.elements[0];
    if let RuleRef(name) = *first {
        return name == *rule_name;
    }
    return false;
}

fn compute_overlap_groups(first_sets: &Array<Array<String>>) -> Array<Array<i32>> {
    let n = first_sets.len();
    let mut group_ids: Array<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        group_ids.append(i);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = i + 1; j < n; j += 1 {
            if sets_overlap(&first_sets[i], &first_sets[j]) {
                let gi = group_ids[i];
                let gj = group_ids[j];
                if gi != gj {
                    for let mut k = 0; k < n; k += 1 {
                        if group_ids[k] == gj {
                            group_ids[k] = gi;
                        }
                    }
                }
            }
        }
    }
    let mut seen_ids: Array<i32> = [];
    let mut groups: Array<Array<i32>> = [];
    for let mut i = 0; i < n; i += 1 {
        let gid = group_ids[i];
        let mut found = -1;
        for let mut s = 0; s < seen_ids.len(); s += 1 {
            if seen_ids[s] == gid {
                found = s;
                break;
            }
        }
        if found >= 0 {
            groups[found].append(i);
        } else {
            seen_ids.append(gid);
            groups.append([i]);
        }
    }
    return groups;
}

fn has_multi_alt_groups(groups: &Array<Array<i32>>) -> bool {
    for let group of groups {
        if group.len() > 1 { return true; }
    }
    return false;
}

fn gen_multi_alt_body_bt(
    out: &mut String,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    groups: &Array<Array<i32>>,
    first_sets: &Array<Array<String>>,
    non_lr_indices: &Array<i32>,
) {
    let all_labeled = all_alternatives_labeled(&rule.alternatives);
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    out.append("    let kind = p.peek_kind();\n");

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];
        let mut union_first: Array<String> = [];
        for let idx of group {
            for let tk of first_sets[*idx] {
                if !array_contains_str(&union_first, &tk) {
                    union_first.append(tk);
                }
            }
        }

        out.append("    if ");
        for let mut j = 0; j < union_first.len(); j += 1 {
            if j > 0 { out.append(" || "); }
            out.append(`kind == {union_first[j]}`);
        }
        out.append(" {\n");

        if group.len() == 1 {
            let alt_idx = non_lr_indices[group[0]];
            let alt = &rule.alternatives[alt_idx];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{alt_idx}` };
            let sname = `{strip_suffix(type_name, "Node")}{case_name}`;
            gen_alt_body(out, type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens, "        ");
        } else {
            out.append("        let saved = p.pos;\n");
            for let mut k = 0; k < group.len(); k += 1 {
                let alt_idx = non_lr_indices[group[k]];
                let helper_name = `{fn_name}_bt_{alt_idx}`;
                let is_last = k == group.len() - 1;
                if is_last {
                    out.append(`        return {helper_name}(p);\n`);
                } else {
                    let r_var = `r_{alt_idx}`;
                    out.append(`        let {r_var} = {helper_name}(p);\n`);
                    out.append(`        if let Err(_) = {r_var} \{\n`);
                    out.append("            p.pos = saved;\n");
                    out.append("        } else {\n");
                    out.append(`            return {r_var};\n`);
                    out.append("        }\n");
                }
            }
        }

        out.append("    }\n");
    }

    // Error fallback
    let mut expected: Array<String> = [];
    for let alt of rule.alternatives {
        let mut visiting: Array<String> = [];
        let first = first_of_alt(&alt, all_rules, lit_tokens, &mut visiting);
        for let tk of first {
            if !array_contains_str(&expected, &tk) {
                expected.append(tk);
            }
        }
    }
    out.append(`    return Result::<{type_name}, ParseError>::Err(ParseError::new(\n`);
    out.append("        ");
    out.append(escape_string(&`expected {rule.name}`));
    out.append(",\n");
    out.append("        p.peek().span,\n");
    out.append("        [");
    for let mut i = 0; i < expected.len(); i += 1 {
        if i > 0 { out.append(", "); }
        out.append(escape_string(&expected[i]));
    }
    out.append("],\n");
    out.append("    ));\n");
}

fn gen_parse_entry(out: &mut String, parser_rules: &Array<ParserRule>) {
    if parser_rules.len() == 0 { return; }
    let root = &parser_rules[0];
    let type_name = rule_type_name(&root.name);
    let fn_name = `parse_{to_snake_case(&root.name)}`;
    out.append(`pub fn parse(input: &String) -> Result<{type_name}, ParseError> \{\n`);
    out.append("    let tokens = tokenize(input);\n");
    out.append("    let mut parser = Parser::new(tokens);\n");
    out.append(`    return {fn_name}(&mut parser);\n`);
    out.append("}\n\n");
}
