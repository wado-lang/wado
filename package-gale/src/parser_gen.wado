use {
    Grammar, ParserRule, Alternative, Element, RepeatElement, LabelElement,
    RepeatKind, LexerRule,
} from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use {
    to_lower, to_snake_case, to_pascal_case, rule_type_name, literal_field_name,
    strip_suffix, escape_string, literal_const_name, array_contains_str,
} from "./gen_util.wado";
use { CodeWriter, StructSpec, ImplSpec, FnSpec } from "./wadopoet.wado";

pub fn gen_parser(w: &mut CodeWriter, grammar: &Grammar, lit_tokens: &Array<LitToken>) {
    gen_parser_struct(w);
    for let rule of grammar.parser_rules {
        gen_parse_fn(w, &rule, &grammar.parser_rules, lit_tokens);
    }
    gen_parse_entry(w, &grammar.parser_rules);
}

fn gen_parser_struct(w: &mut CodeWriter) {
    let mut s = StructSpec::new("Parser");
    s.add_field("tokens", "Array<Token>");
    s.add_field("pos", "i32");
    s.emit(w);
    w.blank();

    ImplSpec::new("Parser").emit_begin(w);

    let mut f = FnSpec::new("new");
    f.add_param("tokens", "Array<Token>");
    f.set_return_type("Parser");
    f.emit_begin(w);
    w.line("return Parser { tokens, pos: 0 };");
    w.end();
    w.blank();

    let mut f2 = FnSpec::new("peek");
    f2.set_receiver("&self");
    f2.set_return_type("&Token");
    f2.emit_begin(w);
    w.line("return &self.tokens[self.pos];");
    w.end();
    w.blank();

    let mut f3 = FnSpec::new("peek_kind");
    f3.set_receiver("&self");
    f3.set_return_type("i32");
    f3.emit_begin(w);
    w.line("return self.tokens[self.pos].kind;");
    w.end();
    w.blank();

    let mut f4 = FnSpec::new("peek_at");
    f4.set_receiver("&self");
    f4.add_param("offset", "i32");
    f4.set_return_type("i32");
    f4.emit_begin(w);
    w.line("let idx = self.pos + offset;");
    w.line("if idx >= self.tokens.len() { return TK_EOF; }");
    w.line("return self.tokens[idx].kind;");
    w.end();
    w.blank();

    let mut f5 = FnSpec::new("advance");
    f5.set_receiver("&mut self");
    f5.set_return_type("Token");
    f5.emit_begin(w);
    w.line("let tok = self.tokens[self.pos];");
    w.line("self.pos += 1;");
    w.line("return tok;");
    w.end();
    w.blank();

    let mut f6 = FnSpec::new("last_end");
    f6.set_receiver("&self");
    f6.set_return_type("i32");
    f6.emit_begin(w);
    w.line("if self.pos == 0 { return 0; }");
    w.line("return self.tokens[self.pos - 1].span.end;");
    w.end();
    w.blank();

    let mut f7 = FnSpec::new("expect");
    f7.set_receiver("&mut self");
    f7.add_param("kind", "i32");
    f7.add_param("name", "String");
    f7.set_return_type("Result<Token, ParseError>");
    f7.emit_begin(w);
    w.begin("if self.tokens[self.pos].kind == kind");
    w.line("return Result::<Token, ParseError>::Ok(self.advance());");
    w.end();
    w.line("let tok = &self.tokens[self.pos];");
    w.line("return Result::<Token, ParseError>::Err(ParseError::new(");
    w.indent();
    w.line("`expected {name}, got \"{tok.text}\"`,");
    w.line("tok.span,");
    w.line("[name],");
    w.dedent();
    w.line("));");
    w.end();

    w.end(); // impl
    w.blank();
}

fn gen_parse_fn(
    w: &mut CodeWriter,
    rule: &ParserRule,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let type_name = rule_type_name(&rule.name);
    let fn_name = `parse_{to_snake_case(&rule.name)}`;

    if rule.alternatives.len() == 1 {
        let mut f = FnSpec::new(&fn_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        gen_alt_body(w, &type_name, null, null, &rule.alternatives[0], all_rules, lit_tokens);
        w.end();
        w.blank();
        return;
    }

    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    let mut non_lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if !is_left_recursive(&rule.alternatives[i], &rule.name) {
            non_lr_indices.append(i);
        }
    }

    let mut first_sets: Array<Array<String>> = [];
    for let idx of non_lr_indices {
        let mut visiting: Array<String> = [];
        first_sets.append(first_of_alt(&rule.alternatives[idx], all_rules, lit_tokens, &mut visiting));
    }
    let mut groups = compute_overlap_groups(&first_sets);
    let needs_bt = has_multi_alt_groups(&groups);

    if needs_bt {
        for let mut g = 0; g < groups.len(); g += 1 {
            if groups[g].len() > 1 {
                sort_group_by_specificity(&mut groups[g], &non_lr_indices, &rule.alternatives, all_rules, lit_tokens);
            }
        }
    }

    if needs_bt {
        for let group of groups {
            if group.len() > 1 {
                for let gi of group {
                    let alt_idx = non_lr_indices[gi];
                    let alt = &rule.alternatives[alt_idx];
                    let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{alt_idx}` };
                    let sname = `{strip_suffix(&type_name, "Node")}{case_name}`;
                    let helper_name = `{fn_name}_bt_{alt_idx}`;

                    let mut f = FnSpec::new(&helper_name);
                    f.add_param("p", "&mut Parser");
                    f.set_return_type(`Result<{type_name}, ParseError>`);
                    f.emit_begin(w);
                    w.line("let start = p.peek().span.start;");
                    gen_alt_body(w, &type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens);
                    w.end();
                    w.blank();
                }
            }
        }
    }

    let mut lr_indices: Array<i32> = [];
    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        if is_left_recursive(&rule.alternatives[i], &rule.name) {
            lr_indices.append(i);
        }
    }
    let has_lr = lr_indices.len() > 0;

    if has_lr {
        let atom_name = `{fn_name}_atom`;
        let mut f = FnSpec::new(&atom_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        if needs_bt {
            gen_multi_alt_body_bt(w, rule, &type_name, all_rules, lit_tokens, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(w, rule, &type_name, all_rules, lit_tokens);
        }
        w.end();
        w.blank();

        gen_lr_suffix_helpers(w, rule, &type_name, &lr_indices, all_rules, lit_tokens);

        let mut f2 = FnSpec::new(&fn_name);
        f2.add_param("p", "&mut Parser");
        f2.set_return_type(`Result<{type_name}, ParseError>`);
        f2.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        w.line(`let mut result = {fn_name}_atom(p)?;`);
        gen_lr_suffix_dispatch(w, rule, &type_name, &lr_indices, all_rules, lit_tokens);
        w.line(`return Result::<{type_name}, ParseError>::Ok(result);`);
        w.end();
        w.blank();
    } else {
        let mut f = FnSpec::new(&fn_name);
        f.add_param("p", "&mut Parser");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);
        w.line("let start = p.peek().span.start;");
        if needs_bt {
            gen_multi_alt_body_bt(w, rule, &type_name, all_rules, lit_tokens, &groups, &first_sets, &non_lr_indices);
        } else {
            gen_multi_alt_body(w, rule, &type_name, all_rules, lit_tokens);
        }
        w.end();
        w.blank();
    }
}

fn gen_alt_body(
    w: &mut CodeWriter,
    type_name: &String,
    variant_case: Option<String>,
    struct_name: Option<String>,
    alt: &Alternative,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    gen_alt_elements(w, &alt.elements, all_rules, lit_tokens);

    if let Some(case) = variant_case {
        let sname = struct_name.unwrap();
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case}({sname} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        gen_field_assignments(w, &alt.elements);
        w.dedent();
        w.line("}));");
    } else {
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        gen_field_assignments(w, &alt.elements);
        w.dedent();
        w.line("});");
    }
}

fn gen_multi_alt_body(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    let max_k = 5;
    let mut all_pos_sets: Array<Array<Array<String>>> = [];
    for let alt of rule.alternatives {
        all_pos_sets.append(alt_position_first_sets(&alt, max_k, all_rules, lit_tokens));
    }
    let depth = find_needed_depth(&all_pos_sets);

    w.line("let kind = p.peek_kind();");

    for let mut i = 0; i < rule.alternatives.len(); i += 1 {
        let alt = &rule.alternatives[i];
        let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{i}` };
        let sname = `{strip_suffix(type_name, "Node")}{case_name}`;

        let pos_sets = &all_pos_sets[i];
        let cond_depth = if depth < pos_sets.len() { depth } else { pos_sets.len() };

        if cond_depth > 0 {
            let cond = build_lookahead_condition(pos_sets, cond_depth);
            w.begin(`if {cond}`);
        } else {
            w.begin("scope:");
        }

        gen_alt_body(w, type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens);
        w.end();
    }

    gen_error_fallback(w, rule, type_name, all_rules, lit_tokens);
}

fn gen_alt_elements(
    w: &mut CodeWriter,
    elements: &Array<Element>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        gen_element(w, &elem, all_rules, lit_tokens, true, &mut name_counts);
    }
}

fn gen_element(
    w: &mut CodeWriter,
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    store: bool,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let const_name = `TK_{name}`;
        if store {
            let field_name = dedup_name(&to_lower(&name), name_counts);
            w.line(`let {field_name} = p.expect({const_name}, {escape_string(&name)})?;`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            w.line(`let {discard} = p.expect({const_name}, {escape_string(&name)})?;`);
        }
        return;
    }
    if let Literal(text) = *elem {
        let const_name = literal_const_name(&text);
        let display = `'{text}'`;
        if store {
            let field_name = dedup_name(&literal_field_name(&text), name_counts);
            w.line(`let {field_name} = p.expect({const_name}, {escape_string(&display)})?;`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            w.line(`let {discard} = p.expect({const_name}, {escape_string(&display)})?;`);
        }
        return;
    }
    if let RuleRef(name) = *elem {
        let fn_name = `parse_{to_snake_case(&name)}`;
        if store {
            let field_name = dedup_name(&to_snake_case(&name), name_counts);
            w.line(`let {field_name} = {fn_name}(p)?;`);
        } else {
            let discard = dedup_name(&"tok", name_counts);
            w.line(`let {discard} = {fn_name}(p)?;`);
        }
        return;
    }
    if let Repeat(rep) = *elem {
        gen_repeat(w, &rep, all_rules, lit_tokens, name_counts);
        return;
    }
    if let Group(alts) = *elem {
        gen_consume_group(w, &alts, all_rules, lit_tokens, name_counts);
        return;
    }
    if let Label(lab) = *elem {
        gen_element(w, &lab.element, all_rules, lit_tokens, store, name_counts);
        return;
    }
}

fn gen_repeat(
    w: &mut CodeWriter,
    rep: &RepeatElement,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    let inner = &rep.element;
    let mut visiting: Array<String> = [];
    let first = first_of_element(inner, all_rules, lit_tokens, &mut visiting);

    if has_field(inner) {
        let field_info = element_field_info(inner);
        if let Star = rep.kind {
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [];`);
            w.begin(`while {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
            w.line(`{list_name}.append({field_info.0});`);
            w.end();
        }
        if let Plus = rep.kind {
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
            let list_name = dedup_name(&`{field_info.0}_list`, name_counts);
            w.line(`let mut {list_name}: Array<{field_info.1}> = [{field_info.0}];`);
            w.begin(`while {first_check_str(&first)}`);
            let mut nc2: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc2);
            w.line(`{list_name}.append({field_info.0});`);
            w.end();
        }
        if let Optional = rep.kind {
            let type_str = field_info.1;
            let opt_name = dedup_name(&field_info.0, name_counts);
            w.begin(`let {opt_name}: Option<{type_str}> = if {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, true, &mut nc);
            w.line(`Option::<{type_str}>::Some({field_info.0})`);
            w.else_begin("else");
            w.line("null");
            w.end_with(";");
        }
    } else {
        if let Star = rep.kind {
            w.begin(`while {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, false, &mut nc);
            w.end();
        }
        if let Plus = rep.kind {
            gen_element(w, inner, all_rules, lit_tokens, false, name_counts);
            w.begin(`while {first_check_str(&first)}`);
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, false, &mut nc);
            w.end();
        }
        if let Optional = rep.kind {
            gen_optional_with_backtrack(w, inner, all_rules, lit_tokens, &first, name_counts);
        }
    }
}

fn gen_optional_with_backtrack(
    w: &mut CodeWriter,
    inner: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    first: &Array<String>,
    name_counts: &mut Array<[String, i32]>,
) {
    w.begin(`if {first_check_str(first)}`);

    let saved = dedup_name(&"opt_saved", name_counts);
    let label = dedup_name(&"opt_bt", name_counts);
    w.line(`let {saved} = p.pos;`);
    w.begin(`{label}:`);

    if let Group(alts) = *inner {
        if alts.len() == 1 {
            for let elem of alts[0].elements {
                gen_element_failable(w, &elem, all_rules, lit_tokens, &saved, &label, name_counts);
            }
        } else {
            let mut nc: Array<[String, i32]> = [];
            gen_element(w, inner, all_rules, lit_tokens, false, &mut nc);
        }
    } else {
        gen_element_failable(w, inner, all_rules, lit_tokens, &saved, &label, name_counts);
    }

    w.end(); // label
    w.end(); // if
}

fn gen_element_failable(
    w: &mut CodeWriter,
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    saved_var: &String,
    label: &String,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let const_name = `TK_{name}`;
        let r_var = dedup_name(&"opt_r", name_counts);
        w.line(`let {r_var} = p.expect({const_name}, {escape_string(&name)});`);
        w.line(`if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}`);
        return;
    }
    if let Literal(text) = *elem {
        let const_name = literal_const_name(&text);
        let display = `'{text}'`;
        let r_var = dedup_name(&"opt_r", name_counts);
        w.line(`let {r_var} = p.expect({const_name}, {escape_string(&display)});`);
        w.line(`if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}`);
        return;
    }
    if let RuleRef(name) = *elem {
        let fn_name = `parse_{to_snake_case(&name)}`;
        let r_var = dedup_name(&"opt_r", name_counts);
        w.line(`let {r_var} = {fn_name}(p);`);
        w.line(`if let Err(_) = {r_var} \{ p.pos = {saved_var}; break {label}; \}`);
        return;
    }
    if let Repeat(rep) = *elem {
        gen_repeat(w, &rep, all_rules, lit_tokens, name_counts);
        return;
    }
    if let Group(alts) = *elem {
        if alts.len() == 1 {
            for let inner_elem of alts[0].elements {
                gen_element_failable(w, &inner_elem, all_rules, lit_tokens, saved_var, label, name_counts);
            }
        } else {
            gen_consume_group(w, &alts, all_rules, lit_tokens, name_counts);
        }
        return;
    }
    if let Label(lab) = *elem {
        gen_element_failable(w, &lab.element, all_rules, lit_tokens, saved_var, label, name_counts);
        return;
    }
}

fn has_field(elem: &Element) -> bool {
    if let TokenRef(_) = *elem { return true; }
    if let Literal(_) = *elem { return true; }
    if let RuleRef(_) = *elem { return true; }
    if let Label(lab) = *elem { return has_field(&lab.element); }
    return false;
}

fn element_field_info(elem: &Element) -> [String, String] {
    if let TokenRef(name) = *elem {
        return [to_lower(&name), "Token"];
    }
    if let Literal(text) = *elem {
        return [literal_field_name(&text), "Token"];
    }
    if let RuleRef(name) = *elem {
        return [to_snake_case(&name), rule_type_name(&name)];
    }
    if let Label(lab) = *elem {
        return element_field_info(&lab.element);
    }
    return ["_", "Token"];
}

fn gen_field_assignments(w: &mut CodeWriter, elements: &Array<Element>) {
    let mut name_counts: Array<[String, i32]> = [];
    for let elem of elements {
        gen_field_assignment(w, &elem, &mut name_counts);
    }
}

fn gen_field_assignment(
    w: &mut CodeWriter,
    elem: &Element,
    name_counts: &mut Array<[String, i32]>,
) {
    if let TokenRef(name) = *elem {
        let field_name = dedup_name(&to_lower(&name), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Literal(text) = *elem {
        let field_name = dedup_name(&literal_field_name(&text), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let RuleRef(name) = *elem {
        let field_name = dedup_name(&to_snake_case(&name), name_counts);
        w.line(`{field_name},`);
        return;
    }
    if let Repeat(rep) = *elem {
        if has_field(&rep.element) {
            let info = element_field_info(&rep.element);
            if let Star = rep.kind {
                let field_name = dedup_name(&`{info.0}_list`, name_counts);
                w.line(`{field_name},`);
            }
            if let Plus = rep.kind {
                let field_name = dedup_name(&`{info.0}_list`, name_counts);
                w.line(`{field_name},`);
            }
            if let Optional = rep.kind {
                let field_name = dedup_name(&info.0, name_counts);
                w.line(`{field_name},`);
            }
        }
        return;
    }
    if let Label(lab) = *elem {
        if has_field(&lab.element) {
            let field_name = to_snake_case(&lab.name);
            dedup_name(&field_name, name_counts);
            w.line(`{field_name},`);
        }
        return;
    }
}

fn gen_consume_group(
    w: &mut CodeWriter,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    if alts.len() == 0 { return; }
    if alts.len() == 1 {
        for let elem of alts[0].elements {
            gen_element(w, &elem, all_rules, lit_tokens, false, name_counts);
        }
        return;
    }

    let mut first_sets: Array<Array<String>> = [];
    for let alt of alts {
        let mut visiting: Array<String> = [];
        first_sets.append(first_of_alt(&alt, all_rules, lit_tokens, &mut visiting));
    }
    let groups = compute_overlap_groups(&first_sets);

    let grp_var = dedup_name(&"grp_kind", name_counts);
    w.line(`let {grp_var} = p.peek_kind();`);

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];

        let mut union_first: Array<String> = [];
        for let idx of group {
            for let tk of first_sets[*idx] {
                if !array_contains_str(&union_first, &tk) {
                    union_first.append(tk);
                }
            }
        }

        let cond = kind_check_str(&union_first, &grp_var);
        if g == 0 {
            w.begin(`if {cond}`);
        } else {
            w.else_begin(`else if {cond}`);
        }

        if group.len() == 1 {
            let alt_idx = group[0];
            let mut nc: Array<[String, i32]> = [];
            for let elem of alts[alt_idx].elements {
                gen_element(w, &elem, all_rules, lit_tokens, false, &mut nc);
            }
        } else {
            gen_backtracking_body(w, group, alts, all_rules, lit_tokens, name_counts);
        }
    }
    w.end();
}

fn gen_backtracking_body(
    w: &mut CodeWriter,
    group: &Array<i32>,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    name_counts: &mut Array<[String, i32]>,
) {
    let saved_var = dedup_name(&"saved_pos", name_counts);
    let done_var = dedup_name(&"bt_done", name_counts);
    w.line(`let {saved_var} = p.pos;`);
    w.line(`let mut {done_var} = false;`);

    for let mut k = 0; k < group.len(); k += 1 {
        let alt_idx = group[k];
        let is_last = k == group.len() - 1;
        let alt = &alts[alt_idx];

        if is_last {
            w.begin(`if !{done_var}`);
            let mut nc: Array<[String, i32]> = [];
            for let elem of alt.elements {
                gen_element(w, &elem, all_rules, lit_tokens, false, &mut nc);
            }
            w.end();
        } else if alt.elements.len() == 1 {
            let el = &alt.elements[0];
            if let RuleRef(rule_name) = *el {
                let fn_name = `parse_{to_snake_case(&rule_name)}`;
                let r_var = dedup_name(&"r", name_counts);
                w.begin(`if !{done_var}`);
                w.line(`let {r_var} = {fn_name}(p);`);
                w.begin(`if let Err(_) = {r_var}`);
                w.line(`p.pos = {saved_var};`);
                w.else_begin("else");
                w.line(`{done_var} = true;`);
                w.end();
                w.end();
            } else {
                w.begin(`if !{done_var}`);
                let mut nc: Array<[String, i32]> = [];
                gen_element(w, el, all_rules, lit_tokens, false, &mut nc);
                w.line(`{done_var} = true;`);
                w.end();
            }
        } else {
            w.begin(`if !{done_var}`);
            let mut nc: Array<[String, i32]> = [];
            for let elem of alt.elements {
                gen_element(w, &elem, all_rules, lit_tokens, false, &mut nc);
            }
            w.line(`{done_var} = true;`);
            w.end();
        }
    }
}

fn gen_lr_suffix_helpers(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    lr_indices: &Array<i32>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    let all_labeled = all_alternatives_labeled(&rule.alternatives);

    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 { continue; }

        let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{lr_idx}` };
        let sname = `{strip_suffix(type_name, "Node")}{case_name}`;
        let suffix_fn = `{fn_name}_lr_{lr_idx}`;

        let mut f = FnSpec::new(&suffix_fn);
        f.add_param("p", "&mut Parser");
        f.add_param("left", type_name);
        f.add_param("start", "i32");
        f.set_return_type(`Result<{type_name}, ParseError>`);
        f.emit_begin(w);

        let mut name_counts: Array<[String, i32]> = [];
        dedup_name(&to_snake_case(&rule.name), &mut name_counts);

        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            let elem = &alt.elements[ei];
            if let RuleRef(name) = *elem {
                if name == rule.name {
                    let field_name = dedup_name(&to_snake_case(&name), &mut name_counts);
                    w.line(`let {field_name} = {fn_name}(p)?;`);
                } else {
                    let elem_fn = `parse_{to_snake_case(&name)}`;
                    let field_name = dedup_name(&to_snake_case(&name), &mut name_counts);
                    w.line(`let {field_name} = {elem_fn}(p)?;`);
                }
            } else if let Group(_) = *elem {
                let discard = dedup_name(&"op_tok", &mut name_counts);
                w.line(`let {discard} = p.advance();`);
            } else if let Repeat(rep) = *elem {
                gen_repeat(w, &rep, all_rules, lit_tokens, &mut name_counts);
            } else {
                gen_element(w, elem, all_rules, lit_tokens, true, &mut name_counts);
            }
        }

        let first_field = to_snake_case(&rule.name);
        w.line(`return Result::<{type_name}, ParseError>::Ok({type_name}::{case_name}({sname} \{`);
        w.indent();
        w.line("span: Span::new(start, p.last_end()),");
        w.line(`{first_field}: left,`);
        let mut field_counts: Array<[String, i32]> = [];
        dedup_name(&to_snake_case(&rule.name), &mut field_counts);
        for let mut ei = 1; ei < alt.elements.len(); ei += 1 {
            gen_field_assignment(w, &alt.elements[ei], &mut field_counts);
        }
        w.dedent();
        w.line("}));");

        w.end(); // fn
        w.blank();
    }
}

fn gen_lr_suffix_dispatch(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    lr_indices: &Array<i32>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    w.begin("loop");
    w.line("let suffix_kind = p.peek_kind();");

    let mut is_first = true;
    for let lr_idx_ref of lr_indices {
        let lr_idx = *lr_idx_ref;
        let alt = &rule.alternatives[lr_idx];
        if alt.elements.len() <= 1 { continue; }

        let mut suffix_first: Array<String> = [];
        let mut visiting: Array<String> = [];
        suffix_first = first_of_element(&alt.elements[1], all_rules, lit_tokens, &mut visiting);
        if suffix_first.len() == 0 { continue; }

        let suffix_fn = `{fn_name}_lr_{lr_idx}`;
        let cond = kind_check_str(&suffix_first, "suffix_kind");

        if is_first {
            w.begin(`if {cond}`);
            is_first = false;
        } else {
            w.else_begin(`else if {cond}`);
        }
        w.line(`result = {suffix_fn}(p, result, start)?;`);
    }

    if !is_first {
        w.else_begin("else");
        w.line("break;");
        w.end();
    } else {
        w.line("break;");
    }
    w.end(); // loop
}

fn gen_multi_alt_body_bt(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    groups: &Array<Array<i32>>,
    first_sets: &Array<Array<String>>,
    non_lr_indices: &Array<i32>,
) {
    let all_labeled = all_alternatives_labeled(&rule.alternatives);
    let fn_name = `parse_{to_snake_case(&rule.name)}`;
    w.line("let kind = p.peek_kind();");

    for let mut g = 0; g < groups.len(); g += 1 {
        let group = &groups[g];
        let mut union_first: Array<String> = [];
        for let idx of group {
            for let tk of first_sets[*idx] {
                if !array_contains_str(&union_first, &tk) {
                    union_first.append(tk);
                }
            }
        }

        let cond = kind_check_str(&union_first, "kind");
        w.begin(`if {cond}`);

        if group.len() == 1 {
            let alt_idx = non_lr_indices[group[0]];
            let alt = &rule.alternatives[alt_idx];
            let case_name = if all_labeled { alt.label.unwrap() } else { `Alt{alt_idx}` };
            let sname = `{strip_suffix(type_name, "Node")}{case_name}`;
            gen_alt_body(w, type_name, Option::<String>::Some(case_name), Option::<String>::Some(sname), alt, all_rules, lit_tokens);
        } else {
            w.line("let saved = p.pos;");
            for let mut k = 0; k < group.len(); k += 1 {
                let alt_idx = non_lr_indices[group[k]];
                let helper_name = `{fn_name}_bt_{alt_idx}`;
                let is_last = k == group.len() - 1;
                if is_last {
                    w.line(`return {helper_name}(p);`);
                } else {
                    let r_var = `r_{alt_idx}`;
                    w.line(`let {r_var} = {helper_name}(p);`);
                    w.begin(`if let Err(_) = {r_var}`);
                    w.line("p.pos = saved;");
                    w.else_begin("else");
                    w.line(`return {r_var};`);
                    w.end();
                }
            }
        }

        w.end();
    }

    gen_error_fallback(w, rule, type_name, all_rules, lit_tokens);
}

fn gen_parse_entry(w: &mut CodeWriter, parser_rules: &Array<ParserRule>) {
    if parser_rules.len() == 0 { return; }
    let root = &parser_rules[0];
    let type_name = rule_type_name(&root.name);
    let fn_name = `parse_{to_snake_case(&root.name)}`;
    let mut f = FnSpec::new("parse");
    f.set_pub();
    f.add_param("input", "&String");
    f.set_return_type(`Result<{type_name}, ParseError>`);
    f.emit_begin(w);
    w.line("let tokens = tokenize(input);");
    w.line("let mut parser = Parser::new(tokens);");
    w.line(`return {fn_name}(&mut parser);`);
    w.end();
    w.blank();
}

fn first_check_str(first_set: &Array<String>) -> String {
    return kind_check_str(first_set, "p.peek_kind()");
}

fn kind_check_str(tokens: &Array<String>, expr: &String) -> String {
    if tokens.len() == 0 {
        return "true";
    }
    let mut result = String::with_capacity(64);
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 { result.append(" || "); }
        result.append(`{expr} == {tokens[i]}`);
    }
    return result;
}

fn build_lookahead_condition(pos_sets: &Array<Array<String>>, depth: i32) -> String {
    let mut cond = String::with_capacity(128);
    for let mut d = 0; d < depth; d += 1 {
        if d > 0 { cond.append(" && "); }
        let tokens = &pos_sets[d];
        let check_expr = if d == 0 { "kind" } else { `p.peek_at({d})` };
        if tokens.len() == 1 {
            cond.append(`{check_expr} == {tokens[0]}`);
        } else {
            cond.append("(");
            for let mut j = 0; j < tokens.len(); j += 1 {
                if j > 0 { cond.append(" || "); }
                cond.append(`{check_expr} == {tokens[j]}`);
            }
            cond.append(")");
        }
    }
    return cond;
}

fn gen_error_fallback(
    w: &mut CodeWriter,
    rule: &ParserRule,
    type_name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let mut expected: Array<String> = [];
    for let alt of rule.alternatives {
        let mut visiting: Array<String> = [];
        let first = first_of_alt(&alt, all_rules, lit_tokens, &mut visiting);
        for let tk of first {
            if !array_contains_str(&expected, &tk) {
                expected.append(tk);
            }
        }
    }
    let msg = escape_string(&`expected {rule.name}`);
    w.line(`return Result::<{type_name}, ParseError>::Err(ParseError::new(`);
    w.indent();
    w.line(`{msg},`);
    w.line("p.peek().span,");
    w.write("[");
    for let mut i = 0; i < expected.len(); i += 1 {
        if i > 0 { w.write(", "); }
        let s = escape_string(&expected[i]);
        w.write(s);
    }
    w.write("],\n");
    w.dedent();
    w.line("));");
}

fn first_of_alt(
    alt: &Alternative,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    let mut result: Array<String> = [];
    for let elem of alt.elements {
        let elem_first = first_of_element(&elem, all_rules, lit_tokens, visiting);
        for let tk of elem_first {
            if !array_contains_str(&result, &tk) {
                result.append(tk);
            }
        }
        if !is_nullable(&elem) {
            break;
        }
    }
    return result;
}

fn first_of_element(
    elem: &Element,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    if let TokenRef(name) = *elem {
        return [`TK_{name}`];
    }
    if let Literal(text) = *elem {
        return [literal_const_name(&text)];
    }
    if let RuleRef(name) = *elem {
        return first_of_rule(&name, all_rules, lit_tokens, visiting);
    }
    if let Group(alts) = *elem {
        let mut result: Array<String> = [];
        for let alt of alts {
            let af = first_of_alt(&alt, all_rules, lit_tokens, visiting);
            for let tk of af {
                if !array_contains_str(&result, &tk) {
                    result.append(tk);
                }
            }
        }
        return result;
    }
    if let Repeat(rep) = *elem {
        return first_of_element(&rep.element, all_rules, lit_tokens, visiting);
    }
    if let Label(lab) = *elem {
        return first_of_element(&lab.element, all_rules, lit_tokens, visiting);
    }
    return [];
}

fn first_of_rule(
    name: &String,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
    visiting: &mut Array<String>,
) -> Array<String> {
    if array_contains_str(visiting, name) {
        return [];
    }
    visiting.append(*name);

    let mut result: Array<String> = [];
    for let rule of all_rules {
        if rule.name == *name {
            for let alt of rule.alternatives {
                let af = first_of_alt(&alt, all_rules, lit_tokens, visiting);
                for let tk of af {
                    if !array_contains_str(&result, &tk) {
                        result.append(tk);
                    }
                }
            }
            break;
        }
    }

    let mut new_visiting: Array<String> = [];
    for let v of visiting {
        if *v != *name {
            new_visiting.append(*v);
        }
    }
    *visiting = new_visiting;

    return result;
}

fn is_nullable(elem: &Element) -> bool {
    if let Repeat(rep) = *elem {
        if let Star = rep.kind { return true; }
        if let Optional = rep.kind { return true; }
    }
    return false;
}

fn alt_position_first_sets(
    alt: &Alternative,
    max_depth: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<Array<String>> {
    let mut result: Array<Array<String>> = [];
    let mut start = 0;
    while result.len() < max_depth && start < alt.elements.len() {
        if result.len() > 0 && is_nullable(&alt.elements[start]) { break; }

        let first = first_of_elements_from(&alt.elements, start, all_rules, lit_tokens);
        if first.len() == 0 { break; }
        result.append(first);
        let mut skipped_nullable = false;
        while start < alt.elements.len() {
            let was_nullable = is_nullable(&alt.elements[start]);
            if was_nullable { skipped_nullable = true; }
            start += 1;
            if !was_nullable { break; }
        }
        if skipped_nullable { break; }
    }
    return result;
}

fn first_of_elements_from(
    elements: &Array<Element>,
    start: i32,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) -> Array<String> {
    let mut result: Array<String> = [];
    for let mut i = start; i < elements.len(); i += 1 {
        let mut visiting: Array<String> = [];
        let elem_first = first_of_element(&elements[i], all_rules, lit_tokens, &mut visiting);
        for let tk of elem_first {
            if !array_contains_str(&result, &tk) {
                result.append(tk);
            }
        }
        if !is_nullable(&elements[i]) { break; }
    }
    return result;
}

fn sets_overlap(a: &Array<String>, b: &Array<String>) -> bool {
    for let x of a {
        if array_contains_str(b, x) { return true; }
    }
    return false;
}

fn find_needed_depth(all_position_sets: &Array<Array<Array<String>>>) -> i32 {
    let max_k = 5;
    for let mut depth = 1; depth <= max_k; depth += 1 {
        let mut all_ok = true;
        for let mut i = 0; i < all_position_sets.len(); i += 1 {
            for let mut j = i + 1; j < all_position_sets.len(); j += 1 {
                let mut still_ambiguous = true;
                for let mut d = 0; d < depth; d += 1 {
                    if d >= all_position_sets[i].len() || d >= all_position_sets[j].len() {
                        still_ambiguous = false;
                        break;
                    }
                    if !sets_overlap(&all_position_sets[i][d], &all_position_sets[j][d]) {
                        still_ambiguous = false;
                        break;
                    }
                }
                if still_ambiguous {
                    all_ok = false;
                }
            }
        }
        if all_ok { return depth; }
    }
    return max_k;
}

fn dedup_name(base: &String, counts: &mut Array<[String, i32]>) -> String {
    let count = get_count(counts, base);
    increment_count(counts, base);
    if count > 0 {
        return `{base}_{count + 1}`;
    }
    return *base;
}

fn get_count(counts: &Array<[String, i32]>, name: &String) -> i32 {
    for let entry of counts {
        if entry.0 == *name {
            return entry.1;
        }
    }
    return 0;
}

fn increment_count(counts: &mut Array<[String, i32]>, name: &String) {
    for let mut i = 0; i < counts.len(); i += 1 {
        if counts[i].0 == *name {
            let prev = counts[i].1;
            counts[i] = [*name, prev + 1];
            return;
        }
    }
    counts.append([*name, 1]);
}

fn all_alternatives_labeled(alts: &Array<Alternative>) -> bool {
    for let alt of alts {
        if let None = alt.label {
            return false;
        }
    }
    return true;
}

fn is_left_recursive(alt: &Alternative, rule_name: &String) -> bool {
    if alt.elements.len() == 0 { return false; }
    let first = &alt.elements[0];
    if let RuleRef(name) = *first {
        return name == *rule_name;
    }
    return false;
}

fn compute_overlap_groups(first_sets: &Array<Array<String>>) -> Array<Array<i32>> {
    let n = first_sets.len();
    let mut group_ids: Array<i32> = [];
    for let mut i = 0; i < n; i += 1 {
        group_ids.append(i);
    }
    for let mut i = 0; i < n; i += 1 {
        for let mut j = i + 1; j < n; j += 1 {
            if sets_overlap(&first_sets[i], &first_sets[j]) {
                let gi = group_ids[i];
                let gj = group_ids[j];
                if gi != gj {
                    for let mut k = 0; k < n; k += 1 {
                        if group_ids[k] == gj {
                            group_ids[k] = gi;
                        }
                    }
                }
            }
        }
    }
    let mut seen_ids: Array<i32> = [];
    let mut groups: Array<Array<i32>> = [];
    for let mut i = 0; i < n; i += 1 {
        let gid = group_ids[i];
        let mut found = -1;
        for let mut s = 0; s < seen_ids.len(); s += 1 {
            if seen_ids[s] == gid {
                found = s;
                break;
            }
        }
        if found >= 0 {
            groups[found].append(i);
        } else {
            seen_ids.append(gid);
            groups.append([i]);
        }
    }
    return groups;
}

fn has_multi_alt_groups(groups: &Array<Array<i32>>) -> bool {
    for let group of groups {
        if group.len() > 1 { return true; }
    }
    return false;
}

fn sort_group_by_specificity(
    group: &mut Array<i32>,
    non_lr_indices: &Array<i32>,
    alts: &Array<Alternative>,
    all_rules: &Array<ParserRule>,
    lit_tokens: &Array<LitToken>,
) {
    let mut depths: Array<i32> = [];
    for let gi of group {
        let alt_idx = non_lr_indices[*gi];
        let pos_sets = alt_position_first_sets(&alts[alt_idx], 5, all_rules, lit_tokens);
        depths.append(pos_sets.len());
    }
    for let mut i = 0; i < group.len(); i += 1 {
        for let mut j = i + 1; j < group.len(); j += 1 {
            if depths[j] > depths[i] {
                let tmp = group[i]; group[i] = group[j]; group[j] = tmp;
                let tmp_d = depths[i]; depths[i] = depths[j]; depths[j] = tmp_d;
            }
        }
    }
}
