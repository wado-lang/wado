//! Identifier-name transforms shared by the IR (which caches the names at
//! construction) and the codegen layer. No IR dependencies: `ir.wado` imports it.

use { is_reserved } from "lib:wadopoet";

/// The recognizer handle in emitted context-API calls (`p.token_text(...)`):
/// `p` in a parse / predicate body, `self` in a `@members` method body.
pub global PARSER_HANDLE: String = "p";

/// The lexer handle in emitted lexer-action calls (`lx.emit(...)`): the
/// `&mut Lexer` parameter of the generated `apply_<rule>_actions`.
pub global LEXER_HANDLE: String = "lx";

/// The value-struct local every rule that emits a value channel binds.
pub global VALS_LOCAL: String = "vals";

/// A left-recursive rule's precedence parameter, which `$_p` reads.
pub global MIN_PREC_LOCAL: String = "min_prec";

/// The lookahead a multi-alt rule's dispatch reads before choosing.
pub global DISPATCH_KIND_LOCAL: String = "kind";

/// The caller-FOLLOW mask parameter, threaded when `emit_follow` is on.
pub global FOLLOW_PARAM: String = "follow";

/// The generated names a `.g4` identifier can also reach; a binding named after
/// one would shadow it with the matched value. The emitters spell them from the
/// globals above, so this is the set in the generated code.
///
/// Add underscore-led names from here on, as `_rule_start_tok` and `_lr_acc`
/// are: ANTLR's `NameStartChar` admits no underscore, so such a name is
/// unreachable from a grammar and needs no entry.
global GENERATED_LOCALS: List<String> = [
    PARSER_HANDLE, LEXER_HANDLE, VALS_LOCAL, MIN_PREC_LOCAL, DISPATCH_KIND_LOCAL, FOLLOW_PARAM,
];

/// Escape an identifier that would collide with the Wado vocabulary or a
/// generated local by appending '_'.
pub fn escape_ident<S: AsStrSlice>(name: S) -> String {
    if is_reserved(name) || GENERATED_LOCALS.contains_str(name) {
        return `${name}_`;
    }
    return name.to_string();
}

pub fn to_pascal_case<S: AsStrSlice>(name: S) -> String {
    let mut result = String::with_capacity(name.len());
    let mut capitalize_next = true;
    for let c of name.chars() {
        if c == '_' {
            capitalize_next = true;
        } else if capitalize_next {
            result.push(c.to_ascii_uppercase());
            capitalize_next = false;
        } else {
            result.push(c);
        }
    }
    return result;
}

pub fn to_snake_case<S: AsStrSlice>(name: S) -> String {
    let mut result = String::with_capacity(name.len() + 4);
    let mut prev_lower = false;
    for let c of name.chars() {
        if c.is_ascii_uppercase() {
            if prev_lower {
                result.push('_');
            }
            result.push(c.to_ascii_lowercase());
            prev_lower = false;
        } else {
            result.push(c);
            prev_lower = c.is_ascii_lowercase();
        }
    }
    return result;
}

pub fn to_lower<S: AsStrSlice>(name: S) -> String {
    return name.to_ascii_lowercase();
}

pub fn symbol_char_names(c: char) -> Option<[String, String]> {
    return match c {
        '+' => Option::Some(["plus", "PLUS"]),
        '-' => Option::Some(["minus", "MINUS"]),
        '*' => Option::Some(["star", "STAR"]),
        '/' => Option::Some(["slash", "SLASH"]),
        '%' => Option::Some(["percent", "PERCENT"]),
        '=' => Option::Some(["eq", "EQ"]),
        '!' => Option::Some(["bang", "BANG"]),
        '<' => Option::Some(["lt", "LT"]),
        '>' => Option::Some(["gt", "GT"]),
        '&' => Option::Some(["amp", "AMP"]),
        '|' => Option::Some(["pipe", "PIPE"]),
        '^' => Option::Some(["caret", "CARET"]),
        '~' => Option::Some(["tilde", "TILDE"]),
        '.' => Option::Some(["dot", "DOT"]),
        ',' => Option::Some(["comma", "COMMA"]),
        ':' => Option::Some(["colon", "COLON"]),
        ';' => Option::Some(["semicolon", "SEMI"]),
        '(' => Option::Some(["lparen", "LPAREN"]),
        ')' => Option::Some(["rparen", "RPAREN"]),
        '{' => Option::Some(["lbrace", "LBRACE"]),
        '}' => Option::Some(["rbrace", "RBRACE"]),
        '[' => Option::Some(["lbracket", "LBRACKET"]),
        ']' => Option::Some(["rbracket", "RBRACKET"]),
        '?' => Option::Some(["question", "QUESTION"]),
        '@' => Option::Some(["at", "AT"]),
        '#' => Option::Some(["hash", "HASH"]),
        '$' => Option::Some(["dollar", "DOLLAR"]),
        '\\' => Option::Some(["backslash", "BSLASH"]),
        '`' => Option::Some(["backtick", "BTICK"]),
        '"' => Option::Some(["dquote", "DQUOTE"]),
        '\'' => Option::Some(["squote", "SQUOTE"]),
        _ => null,
    };
}

/// Lowercase hex representation of `c`'s Unicode scalar value, used as a
/// collision-free fallback when a character has no entry in
/// [`symbol_char_names`].  For ASCII this is two digits (e.g. `?` → `3f`).
pub fn char_hex_name(c: char) -> String {
    let code = c as i32;
    let mut result = String::with_capacity(6);
    let mut started = false;
    for let mut shift = 28; shift >= 0; shift -= 4 {
        let nibble = code >> shift & 0xf;
        if nibble != 0 || started || shift == 0 {
            started = true;
            if nibble < 10 {
                result.push(char::from_u32_unchecked(('0' as i32 + nibble) as u32));
            } else {
                result.push(char::from_u32_unchecked(('a' as i32 + nibble - 10) as u32));
            }
        }
    }
    return result;
}

/// A literal's base `TK_LIT_*` name. It folds case, so it is not unique:
/// `collect_literal_tokens` suffixes the collisions.
pub fn literal_const_name<S: AsStrSlice>(text: S) -> String {
    let mut result = String::with_capacity(text.len() + 8);
    result.push_str("TK_LIT_");
    for let c of text.chars() {
        if c.is_ascii_lowercase() {
            result.push(c.to_ascii_uppercase());
        } else if c.is_ascii_uppercase() || '0' <= c <= '9' {
            result.push(c);
        } else if let Some(names) = symbol_char_names(c) {
            result.push_str(&names.1);
        } else {
            result.push_str("U");
            result.push_str(&char_hex_name(c));
        }
    }
    return result;
}
