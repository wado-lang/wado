/// Pure identifier-name transforms used by both the IR (to populate
/// per-element name caches at construction time) and the codegen layer.
/// This module deliberately has no IR dependencies — `ir.wado` imports it.
///
/// Length-first dispatch: the outer switch on `name.len()` short-circuits
/// most identifiers without any string comparison.
///
/// Inclusion policy: a deliberate **superset** of the Wado lexer keyword set
/// (`wado-compiler/src/syntax.rs`), plus builtin type names and intrinsics
/// (`panic` / `unreachable`), so a grammar rule/token cannot shadow them in
/// the generated module. Over-inclusion is harmless (a spurious `_`);
/// under-inclusion emits code that fails to compile — when in doubt, escape.
fn is_wado_reserved<S: AsStrSlice>(name: S) -> bool {
    return match name.len() {
        2 => match name.to_string() {
            "Fn" | "as" | "fn" | "i8" | "if" | "in" | "of" | "u8" => true,
            _ => false,
        },
        3 => match name.to_string() {
            "f32" | "f64" | "for" | "i16" | "i32" | "i64" | "let" | "mut" | "pub" | "u16" | "u32" | "u64" | "use" => true,
            _ => false,
        },
        4 => match name.to_string() {
            "bool" | "char" | "else" | "enum" | "from" | "impl" | "loop" | "move" | "null" | "self" | "task" | "test" | "true" | "type" | "with" => true,
            _ => false,
        },
        5 => match name.to_string() {
            "List" | "async" | "break" | "const" | "false" | "flags" | "match" | "panic" | "scope" | "trait" | "while" | "world" => true,
            _ => false,
        },
        6 => match name.to_string() {
            "Option" | "Result" | "String" | "assert" | "effect" | "export" | "global" | "import" | "return" | "stores" | "struct" | "unique" => true,
            _ => false,
        },
        7 => match name.to_string() {
            "handler" | "matches" | "variant" => true,
            _ => false,
        },
        8 => match name.to_string() {
            "continue" | "reactive" | "resource" => true,
            _ => false,
        },
        9 => name.eq_str("interface"),
        11 => name.eq_str("unreachable"),
        _ => false,
    };
}

/// The recognizer handle in emitted context-API calls (`p.token_text(...)`):
/// `p` in a parse / predicate body, `self` in a `@members` method body.
pub global PARSER_HANDLE: String = "p";

/// The lexer handle in emitted lexer-action calls (`lx.emit(...)`): the
/// `&mut Lexer` parameter of the generated `apply_<rule>_actions`.
pub global LEXER_HANDLE: String = "lx";

/// The value-struct local every rule that emits a value channel binds.
pub global VALS_LOCAL: String = "vals";

/// A left-recursive rule's precedence parameter, which `$_p` reads.
pub global MIN_PREC_LOCAL: String = "min_prec";

/// The lookahead a multi-alt rule's dispatch reads before choosing.
pub global DISPATCH_KIND_LOCAL: String = "kind";

/// The caller-FOLLOW mask parameter, threaded when `emit_follow` is on.
pub global FOLLOW_PARAM: String = "follow";

/// The generated names a `.g4` identifier can also reach; a binding named after
/// one would shadow it with the matched value. The emitters spell them from the
/// globals above, so this is the set in the generated code.
///
/// Add underscore-led names from here on, as `_rule_start_tok` and `_lr_acc`
/// are: ANTLR's `NameStartChar` admits no underscore, so such a name is
/// unreachable from a grammar and needs no entry.
global GENERATED_LOCALS: List<String> = [
    PARSER_HANDLE, LEXER_HANDLE, VALS_LOCAL, MIN_PREC_LOCAL, DISPATCH_KIND_LOCAL, FOLLOW_PARAM,
];

/// Escape an identifier that would collide with a Wado reserved word or a
/// generated local by appending '_'.
pub fn escape_ident<S: AsStrSlice>(name: S) -> String {
    if is_wado_reserved(name) || GENERATED_LOCALS.contains(&name.to_string()) {
        return `${name}_`;
    }
    return name.to_string();
}

pub fn to_pascal_case<S: AsStrSlice>(name: S) -> String {
    let mut result = String::with_capacity(name.len());
    let mut capitalize_next = true;
    for let c of name.chars() {
        if c == '_' {
            capitalize_next = true;
        } else if capitalize_next {
            result.push(c.to_ascii_uppercase());
            capitalize_next = false;
        } else {
            result.push(c);
        }
    }
    return result;
}

pub fn to_snake_case<S: AsStrSlice>(name: S) -> String {
    let mut result = String::with_capacity(name.len() + 4);
    let mut prev_lower = false;
    for let c of name.chars() {
        if c.is_ascii_uppercase() {
            if prev_lower {
                result.push('_');
            }
            result.push(c.to_ascii_lowercase());
            prev_lower = false;
        } else {
            result.push(c);
            prev_lower = c.is_ascii_lowercase();
        }
    }
    return result;
}

pub fn to_lower<S: AsStrSlice>(name: S) -> String {
    return name.to_ascii_lowercase();
}
