/// Pure identifier-name transforms used by both the IR (to populate
/// per-element name caches at construction time) and the codegen layer.
/// This module deliberately has no IR dependencies — `ir.wado` imports it.
///
/// Length-first dispatch: most non-reserved identifiers are either too
/// short or too long to match any reserved word, so the outer length
/// switch short-circuits without any string comparison. The inner
/// `match *name` for each length only walks the (much smaller) set of
/// reserved words sharing that length.
fn is_wado_reserved(name: &String) -> bool {
    return match name.len() {
        2 => match *name {
            "Fn" | "as" | "fn" | "i8" | "if" | "in" | "of" | "u8" => true,
            _ => false,
        },
        3 => match *name {
            "f32" | "f64" | "for" | "i16" | "i32" | "i64" | "let" | "mut" | "pub" | "u16" | "u32" | "u64" | "use" => true,
            _ => false,
        },
        4 => match *name {
            "bool" | "char" | "else" | "enum" | "from" | "impl" | "loop" | "move" | "null" | "self" | "task" | "test" | "true" | "type" | "with" => true,
            _ => false,
        },
        5 => match *name {
            "Array" | "async" | "break" | "const" | "false" | "flags" | "match" | "panic" | "scope" | "trait" | "while" | "world" => true,
            _ => false,
        },
        6 => match *name {
            "Option" | "Result" | "String" | "assert" | "effect" | "export" | "global" | "import" | "return" | "stores" | "struct" | "unique" => true,
            _ => false,
        },
        7 => match *name {
            "handler" | "matches" | "variant" => true,
            _ => false,
        },
        8 => match *name {
            "continue" | "reactive" | "resource" => true,
            _ => false,
        },
        9 => *name == "interface",
        11 => *name == "unreachable",
        _ => false,
    };
}

/// Escape an identifier that would collide with a Wado reserved word by appending '_'.
pub fn escape_ident(name: &String) -> String {
    if is_wado_reserved(name) {
        return `{*name}_`;
    }
    return *name;
}

pub fn to_pascal_case(name: &String) -> String {
    let mut result = String::with_capacity(name.len());
    let mut capitalize_next = true;
    for let c of name.chars() {
        if c == '_' {
            capitalize_next = true;
        } else if capitalize_next {
            result.push(c.to_ascii_uppercase());
            capitalize_next = false;
        } else {
            result.push(c);
        }
    }
    return result;
}

pub fn to_snake_case(name: &String) -> String {
    let mut result = String::with_capacity(name.len() + 4);
    let mut prev_lower = false;
    for let c of name.chars() {
        if c.is_ascii_uppercase() {
            if prev_lower {
                result.push('_');
            }
            result.push(c.to_ascii_lowercase());
            prev_lower = false;
        } else {
            result.push(c);
            prev_lower = c.is_ascii_lowercase();
        }
    }
    return result;
}

pub fn to_lower(name: &String) -> String {
    return name.to_ascii_lowercase();
}
