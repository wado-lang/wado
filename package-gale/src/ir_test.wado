use {
    Grammar,
    GrammarKind,
    ParserRule,
    Alternative,
    Element,
    RepeatElement,
    LabelElement,
    RepeatKind,
    LexerRule,
    LexerAlt,
    LexerElement,
    CharClass,
    CharRange,
    Visibility,
} from "./ir.wado";

test "Grammar construction" {
    let g = Grammar {
        name: "JSON",
        kind: GrammarKind::Combined,
        parser_rules: [],
        lexer_rules: [],
        mode_names: ["DEFAULT_MODE"],
        channels: [],
        options: [],
        named_actions: [],
        pending_refs: [],
        source_files: [],
    };
    assert g.name == "JSON";
    assert g.parser_rules.is_empty();
    assert g.lexer_rules.is_empty();
    assert g.mode_names.len() == 1;
    assert g.channels.is_empty();
    assert g.options.is_empty();
    assert g.named_actions.is_empty();
    assert g.source_files.is_empty();
}

test "ParserRule with alternatives" {
    let rule = ParserRule::new(
        "value",
        Visibility::Default,
        [],
        [
            Alternative { label: Option::<String>::Some("Str"), options: [], elements: [
                Element::TokenRef(TokenRefElement::new("STRING")),
            ] },
            Alternative { label: Option::<String>::Some("Num"), options: [], elements: [
                Element::TokenRef(TokenRefElement::new("NUMBER")),
            ] },
            Alternative { label: null, options: [], elements: [Element::Literal(LiteralElement::new("true"))] },
        ],
    );
    assert rule.name == "value";
    assert rule.alternatives.len() == 3;
    if let Some(label) = rule.alternatives[0].label {
        assert label == "Str";
    } else {
        panic("expected label");
    }
}

test "Element variants" {
    let rule_ref = Element::RuleRef(RuleRefElement::new("expr"));
    let token_ref = Element::TokenRef(TokenRefElement::new("INT"));
    let literal = Element::Literal(LiteralElement::new("+"));
    let repeat = Element::Repeat(RepeatElement {
        kind: RepeatKind::Star,
        element: Element::TokenRef(TokenRefElement::new("INT")),
        non_greedy: false,
    });
    let label = Element::Label(LabelElement::new(
        "op",
        false,
        Element::Literal(LiteralElement::new("+")),
    ));

    if let RuleRef(r) = rule_ref {
        assert r.name == "expr";
    } else {
        panic("expected RuleRef");
    }

    if let Repeat(r) = repeat {
        if let TokenRef(t) = r.element {
            assert t.name == "INT";
        } else {
            panic("expected TokenRef inside Repeat");
        }
    } else {
        panic("expected Repeat");
    }
}

test "LexerRule construction" {
    let rule = LexerRule {
        name: "WS",
        visibility: Visibility::Default,
        is_fragment: false,
        skip: true,
        more: false,
        type_override: null,
        channel: 0,
        mode: 0,
        set_mode: -1,
        push_mode: -1,
        pop_mode: false,
        is_virtual: false,
        options: [],
        body: [
            LexerAlt {
                elements: [
                    LexerElement::CharClass(CharClass {
                        ranges: [
                            CharRange::single(' '),
                            CharRange::single('\t'),
                            CharRange::single('\n'),
                            CharRange::single('\r'),
                        ],
                        negated: false,
                    }),
                ],
            },
        ],
    };
    assert rule.name == "WS";
    assert rule.skip == true;
    assert rule.is_fragment == false;
}

test "CharRange helpers" {
    let single = CharRange::single('a');
    assert single.start == 'a';
    assert single.end == 'a';

    let range = CharRange::range('0', '9');
    assert range.start == '0';
    assert range.end == '9';
}
