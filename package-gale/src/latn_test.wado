use { parse } from "./g4/parser.wado";
use { build_latn } from "./latn.wado";
use { serialize_atn } from "./atn.wado";
use { atn_decode } from "./runtime/atn.wado";
use { latn_match } from "./runtime/latn.wado";

// Build the nested-comment lexer ATN, round-trip it through the blob, and
// match a rule against an input string. Returns the end position of the
// `CMT` match (or -1). Expectations are the published-ANTLR4 oracle's
// behaviour, characterized as a black box (see runtime/latn.wado).
fn cmt_match(grammar_src: String, input: String) -> i32 {
    let g = parse(grammar_src).unwrap();
    let built = build_latn(&g);
    let blob = serialize_atn(&built.atn);
    let sim = atn_decode(&blob);
    let idx = built.rule_index.get("CMT").unwrap();
    let chars: List<char> = input.chars().collect();
    return latn_match(&sim, idx, &chars, 0);
}

global PLUS_G: String = "lexer grammar L;
CMT : '/*' (CMT | .)+? '*' '/' ;
WS : (' '|'\\n')+;
";

test "latn: simple comment" {
    assert cmt_match(PLUS_G, "/* */") == 5;
}

test "latn: one nested, no trailing — stays flat" {
    // The inner `/*` is wildcard text; the outer closes at the first `*/`.
    assert cmt_match(PLUS_G, "/* /* */") == 8;
}

test "latn: one nested, trailing close — recurses" {
    // The higher-priority recursion completes, so it wins over the flat 0:8.
    assert cmt_match(PLUS_G, "/* /* */ */") == 11;
}

test "latn: recursion vs flat decided by what follows" {
    assert cmt_match(PLUS_G, "/* /* */ x */") == 13;
}

test "latn: tight nesting" {
    assert cmt_match(PLUS_G, "/*/**/*/") == 6;
}

test "latn: two nested then close" {
    assert cmt_match(PLUS_G, "/* /* */ /* */ */") == 17;
}

test "latn: no match" {
    assert cmt_match(PLUS_G, "xyz") == -1;
}

test "latn: cross-line nested (descriptor input)" {
    // The first `/*` on line 2 swallows line 3, closing at the final `*/`.
    let input = "/* /* */\n/* /*nested*/ */";
    assert cmt_match(PLUS_G, input) == 25;
}
