//! Static lookahead simulator and prediction tree.
//!
//! This module is the analysis half of multi-alternative dispatch: it
//! takes a set of alternatives (with their FIRST sets and elements) and
//! returns a `PredictionNode` describing how to dispatch on lookahead
//! tokens. It contains an SLL-style ATN simulator (`SllConfig`,
//! `sll_advance`, `build_sll_node`, `try_expand_opaque`)
//! and the resulting `PredictionNode` tree that the codegen consumes.
//!
//! This module is concern-pure: it never touches `CodeWriter`. The
//! translation from `PredictionNode` to source lives in
//! `parser_gen.wado` (`gen_prediction_code_inner`).

use { Element, RepeatElement, Alternative } from "./ir.wado";
use { GenContext, is_nullable } from "./gen_context.wado";
use { bits_set, bits_test } from "./token_kinds.wado";
use { sort_group_by_specificity } from "./alt_grouping.wado";
use { TreeSet } from "core:collections";

pub variant PredictionNode {
    Leaf(i32),
    Dispatch(PredictionDispatch),
    Consume(ConsumeNode),
    Ambiguous(AmbiguousNode),
}

/// Why static prediction could not isolate a single alternative at an
/// `Ambiguous` leaf. Surfaced by `gale dump` so an ATN-class gap can be
/// triaged without re-deriving the halt condition by hand. The codegen
/// ignores it — every reason lowers to the same longest-match scan
/// tournament — but the label tells a human which edge of the static
/// path was hit.
pub enum AmbiguityReason {
    /// Lookahead reached the static depth ceiling (k = max_depth) without
    /// isolating one alt: genuinely ATN-class, needs unbounded lookahead.
    MaxDepth,
    /// The SLL config set exceeded the explosion guard (>200 configs), so
    /// the simulator bailed before resolving.
    ConfigExplosion,
    /// A multi-token `RuleRef` prefix shared by the alts could not be
    /// expanded statically — the disambiguating tokens are hidden inside
    /// the sub-rule (the `DropLoopEntryBranchInLRRule_4` shape).
    OpaqueRuleRef,
    /// One alt ends (returns to the caller) while another continues past
    /// the same lookahead. A token-led branch is unsafe because the
    /// continuing alt's body may still fail; ANTLR4 resolves it with
    /// adaptive prediction.
    AtEndConflict,
    /// Two or more alts end simultaneously at this position — true
    /// ambiguity with no remaining input to separate them.
    MultiAtEnd,
    /// No alternative survived to this position (degenerate fall-through).
    NoViableAlt,
}

pub struct AmbiguousNode {
    pub alts: List<i32>,
    pub reason: AmbiguityReason,
    pub branch_tokens: List<String> = [],
}

/// Build an `Ambiguous` node carrying its halt reason. Keeps the many
/// construction sites in `build_sll_node` terse and uniform.
fn ambiguous(alts: List<i32>, reason: AmbiguityReason) -> PredictionNode {
    return PredictionNode::Ambiguous(AmbiguousNode { alts, reason });
}

pub struct ConsumeNode {
    pub element: Element,
    pub child: PredictionNode,
}

pub struct PredictionDispatch {
    pub depth: i32,
    pub branches: List<PredictionBranch>,
}

pub struct PredictionBranch {
    pub tokens: List<String>,
    pub child: PredictionNode,
}

/// Return the index of an existing branch whose child equals `child`, or -1
/// when no branch matches. Callers use this to fold a new (token, child) entry
/// into an existing branch instead of creating a duplicate.
fn find_merge_branch(branches: &List<PredictionBranch>, child: &PredictionNode) -> i32 {
    for let mut b = 0; b < branches.len(); b += 1 {
        if prediction_node_eq(&branches[b].child, child) {
            return b;
        }
    }
    return -1;
}

/// Fill `tokens` with the union of every config's FIRST tokens (in
/// first-seen order) and `config_firsts` with each config's own FIRST
/// list (index-aligned to `configs`). The shared front half of both SLL
/// dispatch builders (`build_sll_node`, `try_expand_opaque`); written
/// through `&mut` out-params so the (hot-path) collections are never
/// copied back out.
fn collect_config_first_tokens(
    configs: &List<SllConfig>,
    ctx: &mut GenContext,
    tokens: &mut List<i32>,
    config_firsts: &mut List<List<i32>>,
) {
    let mut seen: List<u64> = [];
    for let c of configs {
        let first = sll_config_first(c, ctx);
        for let tk of &first {
            if !bits_test(&seen, *tk) {
                bits_set(&mut seen, *tk);
                tokens.push(*tk);
            }
        }
        config_firsts.push(first);
    }
}

/// Shared lookahead ceiling `k` for static prediction. In
/// `build_prediction` it counts *branching* decisions (`Dispatch`
/// levels), not raw tokens; exceeding it yields
/// `AmbiguityReason::MaxDepth`. The scan builders and `find_needed_depth`
/// use the same `k` as their probe depth.
pub global MAX_LOOKAHEAD_DEPTH: i32 = 5;

/// Config-set explosion guard: above this many live SLL configs the
/// predictor bails to `AmbiguityReason::ConfigExplosion` (codegen then
/// scan-dispatches) rather than keep growing the set.
global MAX_CONFIG_SET: i32 = 200;

pub fn build_prediction(
    alt_indices: &List<i32>,
    alt_elements: &List<List<Element>>,
    max_depth: i32,
    ctx: &mut GenContext,
) -> PredictionNode {
    let mut configs: List<SllConfig> = [];
    for let mut i = 0; i < alt_indices.len(); i += 1 {
        configs.push(SllConfig {
            alt_index: alt_indices[i],
            elements: alt_elements[i],
            pos: 0,
            return_stack: [],
        });
    }
    let tree = build_sll_node(&configs, 0, max_depth, ctx);
    return strip_dead_consume(tree);
}

/// Project an overlap `group` (indices into `non_lr_indices`) to surface
/// alt indices in the canonical prediction order: numeric, then by
/// specificity (FIRST-set size). Both the prediction tree
/// (`build_group_prediction_tree`) and any rendering of the group must
/// use this order so they agree on which alt sits where.
pub fn group_prediction_order(
    group: &List<i32>,
    first_sets: &List<List<String>>,
    non_lr_indices: &List<i32>,
) -> List<i32> {
    let mut sorted_group = group.sorted();
    sort_group_by_specificity(&mut sorted_group, first_sets);
    return sorted_group.iter().map(|gi: &i32| non_lr_indices[*gi]).collect();
}

/// Build the prediction tree for an overlap group already projected to
/// surface alt indices in canonical order (`group_prediction_order`).
/// Lets a caller that needs the order anyway (e.g. `gale dump`, for its
/// header) reuse it instead of re-sorting.
pub fn build_group_prediction_tree_from_order(
    alts: &List<Alternative>,
    real_indices: &List<i32>,
    ctx: &mut GenContext,
) -> PredictionNode {
    let pred_elements: List<List<Element>> = real_indices.iter().map(|ri: &i32| alts[*ri].elements).collect();
    return build_prediction(real_indices, &pred_elements, MAX_LOOKAHEAD_DEPTH, ctx);
}

/// `build_group_prediction_tree_from_order` with the ordering done for
/// the caller. Codegen's entry point (`gen_multi_alt_body_alt`, the
/// scan-helper gate); `gale dump` orders once itself and calls the
/// `_from_order` form, so both build the same tree.
pub fn build_group_prediction_tree(
    alts: &List<Alternative>,
    group: &List<i32>,
    first_sets: &List<List<String>>,
    non_lr_indices: &List<i32>,
    ctx: &mut GenContext,
) -> PredictionNode {
    let real_indices = group_prediction_order(group, first_sets, non_lr_indices);
    return build_group_prediction_tree_from_order(alts, &real_indices, ctx);
}

/// Strip Consume nodes whose child contains any Ambiguous — fall back to
/// Ambiguous from the original position rather than consuming then failing.
/// This handles both direct Consume → Ambiguous and indirect cases like
/// Consume → Dispatch → (Branch → Ambiguous).
fn strip_dead_consume(node: PredictionNode) -> PredictionNode {
    return match node {
        Consume(c) => {
            let child = strip_dead_consume(c.child);
            if prediction_contains_ambiguous(&child) {
                let mut indices: List<i32> = [];
                prediction_collect_all_indices(&child, &mut indices);
                PredictionNode::Ambiguous(AmbiguousNode {
                    alts: indices,
                    reason: prediction_first_ambiguous_reason(&child),
                    branch_tokens: collect_at_end_branch_tokens(&child),
                });
            } else {
                PredictionNode::Consume(ConsumeNode { element: c.element, child });
            }
        },
        Dispatch(d) => {
            let new_branches: List<PredictionBranch> = d.branches.iter().map(|b: &PredictionBranch| PredictionBranch {
                tokens: b.tokens,
                child: strip_dead_consume(b.child),
            }).collect();
            PredictionNode::Dispatch(PredictionDispatch { depth: d.depth, branches: new_branches });
        },
        _ => node,
    };
}

fn prediction_contains_ambiguous(node: &PredictionNode) -> bool {
    return match *node {
        Ambiguous(_) => true,
        Consume(c) => prediction_contains_ambiguous(&c.child),
        Dispatch(d) => {
            for let b of &d.branches {
                if prediction_contains_ambiguous(&b.child) {
                    return true;
                }
            }
            return false;
        },
        Leaf(_) => false,
    };
}

pub fn prediction_at_end_conflicts(node: &PredictionNode, out: &mut List<List<String>>) {
    match *node {
        Ambiguous(a) => {
            if let AtEndConflict = a.reason {
                out.push(a.branch_tokens);
            }
        },
        Consume(c) => prediction_at_end_conflicts(&c.child, out),
        Dispatch(d) => {
            for let b of &d.branches {
                prediction_at_end_conflicts(&b.child, out);
            }
        },
        Leaf(_) => {
        },
    }
}

fn collect_at_end_branch_tokens(node: &PredictionNode) -> List<String> {
    let mut sites: List<List<String>> = [];
    prediction_at_end_conflicts(node, &mut sites);
    let mut tokens: List<String> = [];
    for let site of &sites {
        for let t of site {
            if !tokens.contains(t) {
                tokens.push(*t);
            }
        }
    }
    return tokens;
}

pub fn prediction_collect_all_indices(node: &PredictionNode, out: &mut List<i32>) {
    match *node {
        Ambiguous(a) => {
            for let i of &a.alts {
                if !out.iter().any(|x: &i32| *x == *i) {
                    out.push(*i);
                }
            }
        },
        Leaf(idx) => {
            if !out.iter().any(|x: &i32| *x == idx) {
                out.push(idx);
            }
        },
        Consume(c) => prediction_collect_all_indices(&c.child, out),
        Dispatch(d) => {
            for let b of &d.branches {
                prediction_collect_all_indices(&b.child, out);
            }
        },
    }
}

/// First `AmbiguityReason` found in a pre-order walk. Used when a
/// Consume → Ambiguous chain is collapsed: the cause is the deepest
/// Ambiguous, not the consume that fed it. Falls back to `NoViableAlt`
/// only if there is no Ambiguous at all (the caller has already checked
/// `prediction_contains_ambiguous`, so that branch is unreachable in
/// practice).
fn prediction_first_ambiguous_reason(node: &PredictionNode) -> AmbiguityReason {
    return match *node {
        Ambiguous(a) => a.reason,
        Consume(c) => prediction_first_ambiguous_reason(&c.child),
        Dispatch(d) => {
            for let b of &d.branches {
                if prediction_contains_ambiguous(&b.child) {
                    return prediction_first_ambiguous_reason(&b.child);
                }
            }
            AmbiguityReason::NoViableAlt;
        },
        Leaf(_) => AmbiguityReason::NoViableAlt,
    };
}


struct SllReturn {
    elements: List<Element>,
    pos: i32,
}

/// Sentinel `pos` marking an *opaque* config — one produced by an
/// unexpanded multi-token rule-ref, where the element position carries
/// no usable lookahead. Distinct from any real element index (≥ 0).
global SLL_POS_OPAQUE: i32 = -1;

struct SllConfig {
    alt_index: i32,
    elements: List<Element>,
    /// Element index into `elements`, or `SLL_POS_OPAQUE` for an opaque config.
    pos: i32,
    return_stack: List<SllReturn>,
}

fn push_return(stack: &List<SllReturn>, elements: List<Element>, pos: i32) -> List<SllReturn> {
    // Value semantics deep-copies the list; just append the new frame.
    let mut new_stack = *stack;
    new_stack.push(SllReturn { elements, pos });
    return new_stack;
}

fn pop_return(c: &SllConfig) -> SllConfig {
    let last_idx = c.return_stack.len() - 1;
    let ret = &c.return_stack[last_idx];
    let mut new_stack: List<SllReturn> = [];
    for let mut i = 0; i < last_idx; i += 1 {
        new_stack.push(c.return_stack[i]);
    }
    return SllConfig {
        alt_index: c.alt_index,
        elements: ret.elements,
        pos: ret.pos,
        return_stack: new_stack,
    };
}


/// True when the config has fully consumed its elements and has no return
/// frame to pop into — i.e. the alt's body is finished and any further token
/// belongs to the calling context. Opaque configs (`pos == SLL_POS_OPAQUE`) are not at-end.
///
/// The check walks `return_stack` from the most-recently-pushed frame back
/// to the oldest, mirroring what a sequence of `pop_return` calls would
/// expose. Walking by index keeps this O(n); the previous recursive
/// implementation was O(n^2) because each `pop_return` rebuilt the entire
/// surviving prefix of `return_stack` into a fresh `List`.
fn config_is_at_end(c: &SllConfig) -> bool {
    if c.pos == SLL_POS_OPAQUE {
        return false;
    }
    if c.pos < c.elements.len() {
        return false;
    }
    let mut i = c.return_stack.len();
    while i > 0 {
        i -= 1;
        let frame = &c.return_stack[i];
        if frame.pos < frame.elements.len() {
            return false;
        }
    }
    return true;
}


/// Compute FIRST set of the current position in a config.
/// Includes tokens from nullable elements that were skipped by closure.
/// When at end of elements with a return stack, pops and continues from caller.
fn sll_config_first(c: &SllConfig, ctx: &mut GenContext) -> List<i32> {
    if c.pos == SLL_POS_OPAQUE {
        return [];
    }
    if c.pos >= c.elements.len() {
        if c.return_stack.is_empty() {
            return [];
        }
        let popped = pop_return(c);
        return sll_config_first(&popped, ctx);
    }
    return ctx.first_ids_of_elements_from(&c.elements, c.pos);
}

/// Advance a config by one token, expanding RuleRefs into the rule's alternatives.
fn sll_advance(c: &SllConfig, token: i32, ctx: &mut GenContext, inline_depth: i32 = 0) -> List<SllConfig> {
    // Limit inline expansion depth to prevent explosion from recursive rules.
    if inline_depth > 2 {
        return [];
    }
    if c.pos == SLL_POS_OPAQUE {
        return [];
    }
    // End of current elements: pop return stack if available.
    if c.pos >= c.elements.len() {
        if c.return_stack.is_empty() {
            return [];
        }
        let popped = pop_return(c);
        return sll_advance(&popped, token, ctx, inline_depth);
    }
    let elem = &c.elements[c.pos];

    if is_nullable(elem) {
        let mut results: List<SllConfig> = [];
        let mut visiting: List<String> = [];
        if ctx.first_ids_of_element(elem, &mut visiting).contains(&token) {
            // A multi-token RuleRef inner is entered via the return stack rather than skipped to pos+1.
            let mut entered = false;
            if let Repeat(rep) = elem {
                if let RuleRef(rr) = rep.element {
                    let mut stv: List<String> = [];
                    if !ctx.rule_is_single_token(&rr.name, &mut stv) && c.return_stack.len() < 1 {
                        let inner_rule = ctx.find_rule(&rr.name);
                        let inner_alt_count = if let Some(r) = inner_rule {
                            r.alternatives.len();
                        } else {
                            0;
                        };
                        if inner_alt_count <= 8 {
                            entered = true;
                            let new_stack = push_return(&c.return_stack, c.elements, c.pos + 1);
                            if let Some(inner_rule) = inner_rule {
                                for let alt of inner_rule.alternatives {
                                    let mut v2: List<String> = [];
                                    if !ctx.first_ids_of_alt(&alt, &mut v2).contains(&token) {
                                        continue;
                                    }
                                    let exp = SllConfig {
                                        ..*c,
                                        elements: alt.elements,
                                        pos: 0,
                                        return_stack: new_stack,
                                    };
                                    let advanced = sll_advance(&exp, token, ctx, inline_depth + 1);
                                    for let a of advanced {
                                        results.push(a);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if !entered {
                results.push(SllConfig { ..*c, pos: c.pos + 1 });
            }
        }
        // Also try skipping: advance past all consecutive nullables non-recursively.
        let mut skip_pos = c.pos + 1;
        while skip_pos < c.elements.len() && is_nullable(&c.elements[skip_pos]) {
            let mut v: List<String> = [];
            if ctx.first_ids_of_element(&c.elements[skip_pos], &mut v).contains(&token) {
                results.push(SllConfig { ..*c, pos: skip_pos + 1 });
            }
            skip_pos += 1;
        }
        if skip_pos < c.elements.len() {
            let skipped_elem = &c.elements[skip_pos];
            match skipped_elem {
                TokenRef(t) => {
                    if ctx.token_ref_id(&t.name, t.kind_id) == token {
                        results.push(SllConfig { ..*c, pos: skip_pos + 1 });
                    }
                },
                Literal(l) => {
                    if ctx.literal_id(&l.text, l.kind_id) == token {
                        results.push(SllConfig { ..*c, pos: skip_pos + 1 });
                    }
                },
                RuleRef(r) => {
                    let mut v: List<String> = [];
                    if ctx.first_ids_of_rule(&r.name, &mut v).contains(&token) {
                        let mut stv: List<String> = [];
                        if ctx.rule_is_single_token(&r.name, &mut stv) {
                            results.push(SllConfig { ..*c, pos: skip_pos + 1 });
                        } else {
                            results.push(SllConfig { ..*c, pos: SLL_POS_OPAQUE });
                        }
                    }
                },
                _ => {
                    let mut v: List<String> = [];
                    if ctx.first_ids_of_element(skipped_elem, &mut v).contains(&token) {
                        results.push(SllConfig { ..*c, pos: skip_pos + 1 });
                    }
                },
            }
        }
        return results;
    }

    if let TokenRef(t) = elem {
        if ctx.token_ref_id(&t.name, t.kind_id) == token {
            return [
                SllConfig { ..*c, pos: c.pos + 1 },
            ];
        }
        return [];
    }
    if let Literal(l) = elem {
        if ctx.literal_id(&l.text, l.kind_id) == token {
            return [
                SllConfig { ..*c, pos: c.pos + 1 },
            ];
        }
        return [];
    }

    // RuleRef: advance past only if the rule always consumes exactly one token.
    // Multi-token rules return opaque (pos=-1); expansion happens in build_sll_node
    // only when needed to resolve ambiguity.
    if let RuleRef(r) = elem {
        let mut visiting: List<String> = [];
        let rule_first = ctx.first_ids_of_rule(&r.name, &mut visiting);
        if !rule_first.contains(&token) {
            return [];
        }
        let mut st_visiting: List<String> = [];
        if ctx.rule_is_single_token(&r.name, &mut st_visiting) {
            // Single-token rule: safe to advance, element position == token position.
            return [
                SllConfig { ..*c, pos: c.pos + 1 },
            ];
        }
        // Multi-token rule: token matches FIRST but we can't advance past it.
        // Return config with pos = -1 as a sentinel meaning "opaque match".
        return [
            SllConfig { ..*c, pos: SLL_POS_OPAQUE },
        ];
    }

    // Group: consume one token if it is in FIRST(group).
    if let Group(g) = elem {
        for let alt of g.alternatives {
            let mut visiting: List<String> = [];
            if ctx.first_ids_of_alt(&alt, &mut visiting).contains(&token) {
                return [
                    SllConfig { ..*c, pos: c.pos + 1 },
                ];
            }
        }
        return [];
    }

    if let Repeat(rep) = elem {
        let mut visiting: List<String> = [];
        let inner_first = ctx.first_ids_of_element(&rep.element, &mut visiting);
        if inner_first.contains(&token) {
            // Advance past the repeat element (simplified: treat as consuming 1 token).
            return [
                SllConfig { ..*c, pos: c.pos + 1 },
            ];
        }
        return [];
    }

    if let Label(lab) = elem {
        let unwrapped = SllConfig { ..*c, elements: replace_element_at(&c.elements, c.pos, &lab.element) };
        return sll_advance(&unwrapped, token, ctx, inline_depth);
    }

    return [];
}

fn replace_element_at(elements: &List<Element>, pos: i32, replacement: &Element) -> List<Element> {
    let mut result: List<Element> = [];
    for let mut i = 0; i < elements.len(); i += 1 {
        if i == pos {
            result.push(*replacement);
        } else {
            result.push(elements[i]);
        }
    }
    return result;
}

fn sll_unique_alts(configs: &List<SllConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt_index) {
            alts.push(c.alt_index);
        }
    }
    return alts;
}

/// Deduplicate configs: merge configs with the same (alt_index) that reach
/// the same prediction outcome. For SLL, two configs with the same alt_index
/// are equivalent for prediction purposes.
fn sll_dedup_by_alt(configs: &List<SllConfig>) -> List<SllConfig> {
    let mut seen_alts: List<i32> = [];
    let mut result: List<SllConfig> = [];
    for let c of configs {
        if !seen_alts.contains(&c.alt_index) {
            seen_alts.push(c.alt_index);
            result.push(*c);
        }
    }
    return result;
}

fn build_sll_node(configs: &List<SllConfig>, depth: i32, max_depth: i32, ctx: &mut GenContext) -> PredictionNode {
    // No explicit closure step: nullable handling is done in
    // `sll_config_first` (`first_of_elements_from`) and `sll_advance`
    // (explicit skip logic), so the config set is used as-is.
    let closed = *configs;

    // Guard: if too many configs, fall back to Ambiguous (codegen scan-dispatches) to avoid explosion.
    if closed.len() > MAX_CONFIG_SET {
        let alts = sll_unique_alts(&closed);
        return ambiguous(alts, AmbiguityReason::ConfigExplosion);
    }

    // Check unique alternatives.
    let alts = sll_unique_alts(&closed);
    if alts.len() == 1 {
        return PredictionNode::Leaf(alts[0]);
    }
    if alts.len() == 0 {
        return ambiguous(alts, AmbiguityReason::NoViableAlt);
    }
    if depth >= max_depth {
        return ambiguous(alts, AmbiguityReason::MaxDepth);
    }

    // Check for common prefix: if all configs are at a terminal element
    // that is the same across all configs, emit Consume.
    let common = sll_find_common_terminal(&closed);
    if let Some(elem) = common {
        // Advance all configs past this shared terminal.
        let advanced: List<SllConfig> = closed.iter().map(|c: &SllConfig| SllConfig { ..*c, pos: c.pos + 1 }).collect();
        let child = build_sll_node(&advanced, depth, max_depth, ctx);
        return PredictionNode::Consume(ConsumeNode { element: elem, child });
    }

    let mut all_tokens: List<i32> = [];
    let mut config_firsts: List<List<i32>> = [];
    collect_config_first_tokens(&closed, ctx, &mut all_tokens, &mut config_firsts);

    let mut branches: List<PredictionBranch> = [];

    for let mut t = 0; t < all_tokens.len(); t += 1 {
        let tk = all_tokens[t];

        let mut next_configs: List<SllConfig> = [];
        let mut opaque_alts: List<i32> = [];
        for let mut i = 0; i < closed.len(); i += 1 {
            if config_firsts[i].contains(&tk) {
                let advanced = sll_advance(&closed[i], tk, ctx);
                for let a of advanced {
                    if a.pos == -1 {
                        // Opaque config: multi-token RuleRef, can't advance past.
                        if !opaque_alts.contains(&a.alt_index) {
                            opaque_alts.push(a.alt_index);
                        }
                    } else {
                        next_configs.push(a);
                    }
                }
            }
        }

        if next_configs.len() == 0 && opaque_alts.len() == 0 {
            continue;
        }

        // Dedup: keep one config per alt (SLL ignores context).
        let deduped = sll_dedup_by_alt(&next_configs);
        let mut next_alts = sll_unique_alts(&deduped);
        // Add opaque alts (they survive regardless of further lookahead).
        for let oa of opaque_alts {
            if !next_alts.contains(&oa) {
                next_alts.push(oa);
            }
        }

        let child = if next_alts.len() == 1 {
            // Resolved: this token uniquely identifies one alternative.
            PredictionNode::Leaf(next_alts[0]);
        } else if opaque_alts.len() > 0 {
            // Still ambiguous with opaque alts: try expansion before giving up.
            let expanded = try_expand_opaque(&closed, tk, &next_configs, opaque_alts, depth + 1, max_depth, ctx);
            if let Some(node) = expanded {
                node;
            } else {
                ambiguous(next_alts, AmbiguityReason::OpaqueRuleRef);
            }
        } else {
            // Still ambiguous: recurse with deeper lookahead.
            build_sll_node(&deduped, depth + 1, max_depth, ctx);
        };
        let idx = find_merge_branch(&branches, &child);
        let tk_name = ctx.token_name(tk);
        if idx >= 0 {
            branches[idx].tokens.push(tk_name);
        } else {
            branches.push(PredictionBranch {
                tokens: [tk_name],
                child,
            });
        }
    }

    // Detect at-end configs: their alts are fully consumed at this depth and
    // would simply return to the caller. They have empty FIRST sets, so the
    // per-token loop above silently dropped them — that left the dispatcher
    // missing a "default" path for tokens belonging to the calling context.
    //
    // Two cases:
    //  * No explicit branches but exactly one at-end alt → that alt is the
    //    only valid match at this point. Return Leaf so the caller commits.
    //  * Both explicit branches and at-end alts → ambiguous in general.
    //    A token-dispatch on the explicit branch is unsafe because the
    //    branch can fail at parse time (e.g. typespec `ID '[' ']'` matches
    //    the lookahead `[` but the body `[ ]` won't match `[ <e> ]`),
    //    leaving the at-end alt as the only correct choice. Fall back to
    //    Ambiguous so the codegen's longest-match scan dispatch picks the
    //    alt whose body actually parses (cf. ANTLR4's adaptive prediction).
    //  * Multiple at-end alts → true ambiguity → Ambiguous.
    let mut at_end_alts: List<i32> = [];
    for let c of &closed {
        if config_is_at_end(c) && !at_end_alts.contains(&c.alt_index) {
            at_end_alts.push(c.alt_index);
        }
    }

    if at_end_alts.len() >= 1 && branches.len() >= 1 {
        let mut branch_tokens: List<String> = [];
        for let b of &branches {
            for let t of &b.tokens {
                if !branch_tokens.contains(t) {
                    branch_tokens.push(*t);
                }
            }
        }
        return PredictionNode::Ambiguous(AmbiguousNode {
            alts,
            reason: AmbiguityReason::AtEndConflict,
            branch_tokens,
        });
    }

    if branches.len() == 0 {
        if at_end_alts.len() == 1 {
            return PredictionNode::Leaf(at_end_alts[0]);
        }
        let reason = if at_end_alts.len() >= 2 { AmbiguityReason::MultiAtEnd } else { AmbiguityReason::NoViableAlt };
        return ambiguous(alts, reason);
    }
    return PredictionNode::Dispatch(PredictionDispatch { depth, branches });
}

/// Try to resolve opaque configs by expanding their multi-token RuleRefs.
/// Uses ATN-style expansion: enter referenced rules, advance by one token,
/// then compute FIRST sets at the decision point's lookahead level.
/// Builds a flat Dispatch — never calls build_sll_node on expanded configs.
fn try_expand_opaque(
    original_configs: &List<SllConfig>,
    token: i32,
    non_opaque_configs: &List<SllConfig>,
    opaque_alts: List<i32>,
    depth: i32,
    max_depth: i32,
    ctx: &mut GenContext,
) -> Option<PredictionNode> {
    if depth >= max_depth {
        return null;
    }
    // Rule diversity check: only expand when opaque configs reference different rules.
    let mut rule_refs = TreeSet::<String>::new();
    for let c of original_configs {
        if !opaque_alts.contains(&c.alt_index) {
            continue;
        }
        if c.pos < 0 || c.pos >= c.elements.len() {
            continue;
        }
        if let RuleRef(r) = c.elements[c.pos] {
            rule_refs.insert(r.name);
        }
    }
    if rule_refs.len() <= 1 {
        return null;
    }
    let mut expanded_configs: List<SllConfig> = [];
    for let c of original_configs {
        if !opaque_alts.contains(&c.alt_index) {
            continue;
        }
        if c.pos < 0 || c.pos >= c.elements.len() {
            continue;
        }
        if let RuleRef(r) = c.elements[c.pos] {
            let found_rule = ctx.find_rule(&r.name);
            if let Some(found_rule) = found_rule {
                if found_rule.alternatives.len() > 8 {
                    continue;
                }
                let new_stack = push_return(&c.return_stack, c.elements, c.pos + 1);
                for let alt of found_rule.alternatives {
                    let mut v: List<String> = [];
                    if !ctx.first_ids_of_alt(&alt, &mut v).contains(&token) {
                        continue;
                    }
                    let exp = SllConfig {
                        alt_index: c.alt_index,
                        elements: alt.elements,
                        pos: 0,
                        return_stack: new_stack,
                    };
                    let advanced = sll_advance(&exp, token, ctx);
                    for let a of advanced {
                        if a.pos != -1 {
                            expanded_configs.push(a);
                        }
                    }
                }
            }
        }
    }
    if expanded_configs.is_empty() {
        return null;
    }
    // Combine non-opaque (already advanced) with expanded configs.
    // All configs have consumed the same number of input tokens (depth),
    // so their FIRST sets are all at the same lookahead level (depth).
    let mut all_configs: List<SllConfig> = [];
    for let c of non_opaque_configs {
        all_configs.push(*c);
    }
    for let ec of expanded_configs {
        all_configs.push(ec);
    }
    let mut all_tokens: List<i32> = [];
    let mut config_firsts: List<List<i32>> = [];
    collect_config_first_tokens(&all_configs, ctx, &mut all_tokens, &mut config_firsts);
    let mut branches: List<PredictionBranch> = [];
    let mut has_improvement = false;
    for let mut t = 0; t < all_tokens.len(); t += 1 {
        let tk = all_tokens[t];
        let mut token_alts: List<i32> = [];
        for let mut i = 0; i < all_configs.len(); i += 1 {
            if config_firsts[i].contains(&tk) {
                if !token_alts.contains(&all_configs[i].alt_index) {
                    token_alts.push(all_configs[i].alt_index);
                }
            }
        }
        let child = if token_alts.len() == 1 {
            has_improvement = true;
            PredictionNode::Leaf(token_alts[0]);
        } else {
            ambiguous(token_alts.sorted(), AmbiguityReason::OpaqueRuleRef);
        };
        let idx = find_merge_branch(&branches, &child);
        let tk_name = ctx.token_name(tk);
        if idx >= 0 {
            branches[idx].tokens.push(tk_name);
        } else {
            branches.push(PredictionBranch {
                tokens: [tk_name],
                child,
            });
        }
    }
    if !has_improvement || branches.is_empty() {
        return null;
    }
    // Only use if ALL branches are Leaf — any Ambiguous branch means expansion
    // didn't fully resolve, and the code generator's Dispatch has no fallback
    // for unmatched tokens, which would silently drop valid inputs.
    for let b of branches {
        if let Ambiguous(_) = b.child {
            return null;
        }
    }
    // Safety: verify all original opaque alts appear in at least one branch.
    let mut covered_alts: List<i32> = [];
    for let b of branches {
        if let Leaf(idx) = b.child {
            if !covered_alts.contains(&idx) {
                covered_alts.push(idx);
            }
        }
    }
    for let oa of opaque_alts {
        if !covered_alts.contains(&oa) {
            return null;
        }
    }
    return Option::<PredictionNode>::Some(PredictionNode::Dispatch(PredictionDispatch { depth, branches }));
}


/// Check if all configs are at the same terminal element (for Consume).
fn sll_find_common_terminal(configs: &List<SllConfig>) -> Option<Element> {
    if configs.len() < 2 {
        return null;
    }
    for let c of configs {
        if c.pos >= c.elements.len() {
            return null;
        }
    }
    let first_elem = &configs[0].elements[configs[0].pos];
    if let TokenRef(t) = first_elem {
        for let mut i = 1; i < configs.len(); i += 1 {
            let elem = &configs[i].elements[configs[i].pos];
            if let TokenRef(other) = elem {
                if other.name != t.name {
                    return null;
                }
            } else {
                return null;
            }
        }
        return Option::<Element>::Some(*first_elem);
    }
    if let Literal(l) = first_elem {
        for let mut i = 1; i < configs.len(); i += 1 {
            let elem = &configs[i].elements[configs[i].pos];
            if let Literal(other) = elem {
                if other.text != l.text {
                    return null;
                }
            } else {
                return null;
            }
        }
        return Option::<Element>::Some(*first_elem);
    }
    return null;
}

fn prediction_node_eq(a: &PredictionNode, b: &PredictionNode) -> bool {
    return match [*a, *b] {
        [Leaf(ai), Leaf(bi)] => ai == bi,
        [Ambiguous(aa), Ambiguous(ba)] => {
            // Compare only the alt set, not the halt reason: dispatch
            // branch merging (`find_merge_branch`) must keep folding
            // same-alt Ambiguous children together regardless of which
            // edge produced them, or the tree shape — and the codegen
            // that reads it — would change.
            if aa.alts.len() != ba.alts.len() {
                return false;
            }
            for let mut i = 0; i < aa.alts.len(); i += 1 {
                if aa.alts[i] != ba.alts[i] {
                    return false;
                }
            }
            true;
        },
        [Consume(ca), Consume(cb)] => element_eq(&ca.element, &cb.element) && prediction_node_eq(&ca.child, &cb.child),
        _ => false,
    };
}

fn element_eq(a: &Element, b: &Element) -> bool {
    return match [*a, *b] {
        [TokenRef(na), TokenRef(nb)] => na.name == nb.name,
        [Literal(ta), Literal(tb)] => ta.text == tb.text,
        _ => false,
    };
}
