//! Homogeneous-tree parser emission (the resilient-parser model).
//!
//! Emits an infallible recursive-descent parser that builds the single
//! homogeneous `CstNode` tree directly via `TreeBuilder` — no typed structs,
//! no `walk_*`/`to_tree`, no `Result`/`?`. One tree node per parser rule;
//! groups, alternatives, and repetitions are control flow only. Diagnostics
//! accumulate on the `Parser`; `parse` returns a `ParseResult`.
//!
//! Covered: LL(1) `Direct` dispatch (tokens, literals, rule refs, sequences,
//! `*`/`+`/`?`, transparent/token-only groups, wildcard, set complement), left
//! recursion (precedence climbing via the builder's `checkpoint`/`start_node_at`
//! wrap, including overlapping LR suffixes resolved by a second-token
//! sub-dispatch), and longest-match tournament dispatch (reusing `parser_gen`'s
//! scan functions). Non-greedy `*?` / `+?` loop on the lowered static exit
//! condition. On the first mismatch the parser fails soft — records one
//! diagnostic and folds the tree closed (no recovery yet; that is Stage 3).
//! Grammars needing the runtime ATN simulator (non-greedy `??`, ATN-class
//! prediction) are rejected up front so the scope boundary is caught loudly.

use { Grammar, ParserRule, LexerRule, Element } from "./ir.wado";
use { LitToken } from "./lexer_gen.wado";
use {
    LoweredGrammar,
    Rule,
    LeftRecursiveRule,
    LrAlt,
    LrDispatchData,
    AltBody,
    Op,
    RepeatOp,
    GroupOp,
    MultiAltDispatch,
    DirectDispatch,
    DispatchBranch,
    TournamentDispatch,
    FollowArg,
} from "./gir.wado";
use { CodeWriter } from "./wadopoet.wado";
use { GenContext, sets_overlap } from "./gen_context.wado";
use {
    gen_scan_functions,
    gen_alt_scan_if_possible,
    follow_arg_expr,
    compute_lr_second_token,
    compute_non_greedy_condition,
    gen_rep_scan_guard,
} from "./parser_gen.wado";

/// The defaulted `follow` parameter every `_parse_*` carries when the grammar
/// has a caller-FOLLOW gate, else nothing. Threaded to a tail-greedy `Repeat`'s
/// `follow_yields` gate; passed down at each `RuleCall` per its `FollowArg`.
fn follow_param(ef: bool) -> String {
    if ef {
        return ", follow: &List<List<i32>> = &EMPTY_FOLLOW";
    }
    return "";
}

/// `, <FollowArg expr>` at a `RuleCall` site (e.g. `, &FOLLOW_MASK_3`), or "".
fn follow_arg(ef: bool, arg: &FollowArg) -> String {
    if ef {
        return `, {follow_arg_expr(arg)}`;
    }
    return "";
}

/// ` && !follow_yields(...)` appended to a tail-greedy `Repeat`'s loop / option
/// condition: the loop yields the matching token to the caller's continuation.
fn repeat_gate(r: &RepeatOp, ef: bool) -> String {
    if ef && r.gate_caller_follow {
        return " && !follow_yields(&p.kinds, p.pos, follow, TK_EOF)";
    }
    return "";
}

/// Number of distinct token kinds: one per non-fragment lexer rule, the two
/// synthetic kinds (`Eof`, `Error`), and one per collected literal — matching
/// the contiguous `0..n` numbering `gen_token_constants` assigns.
fn num_token_kinds(lexer_rules: &List<LexerRule>, lit_tokens: &List<LitToken>) -> i32 {
    let mut n = 0;
    for let r of lexer_rules {
        if !r.is_fragment {
            n += 1;
        }
    }
    return n + 2 + lit_tokens.len();
}

/// Build an inline disjunction `(expr == TK_A || expr == TK_B || ...)`.
/// Empty set renders `false`.
fn kinds_or(tokens: &List<String>, expr: &String) -> String {
    if tokens.is_empty() {
        return String::from("false");
    }
    let mut out = String::with_capacity(tokens.len() * 16);
    out.push('(');
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            out.push_str(&" || ");
        }
        out.push_str(&`{*expr} == {tokens[i]}`);
    }
    out.push(')');
    return out;
}

/// Render a `List<i32>` literal of token-kind constants for a diagnostic's
/// `expected` field.
fn kinds_list(tokens: &List<String>) -> String {
    let mut out = String::with_capacity(tokens.len() * 12);
    out.push('[');
    for let mut i = 0; i < tokens.len(); i += 1 {
        if i > 0 {
            out.push_str(&", ");
        }
        out.push_str(&tokens[i]);
    }
    out.push(']');
    return out;
}

pub fn gen_cst_parser(
    w: &mut CodeWriter,
    grammar: &Grammar,
    lowered: &LoweredGrammar,
    lit_tokens: &List<LitToken>,
    ctx: &mut GenContext,
    needs_scan: bool,
) {
    // Grammars whose prediction needs the runtime ATN simulator — a non-greedy
    // `??` (lowered as `Plain` + `mark_needs_atn`) or any ATN-class LR / scan
    // decision — are outside the homogeneous emitter's scope: the simulator is
    // not wired into the infallible `Parser` yet. Reject loudly rather than
    // emit a silently-wrong static dispatch.
    if ctx.needs_atn() {
        panic("cst_gen: grammars needing the runtime ATN simulator (non-greedy `??`, ATN-class prediction) are outside Stage 2 scope");
    }
    let ef = ctx.emit_follow();
    // The Parser's `kinds` snapshot feeds both the tournament scans and a
    // tail-greedy `Repeat`'s `follow_yields` gate.
    let needs_kinds = needs_scan || ef;
    gen_node_kinds(w, &lowered.parser_rules);
    gen_parser_runtime(w, needs_kinds);
    // Whole-rule scan functions (lookahead-only; Parser-independent free
    // functions) plus per-alt scans for tournament rules — reused verbatim
    // from the typed emitter, then driven by the homogeneous tournament
    // dispatch below. Only a grammar with a tournament needs them.
    if needs_scan {
        gen_scan_functions(w, grammar, lowered, ctx);
        for let mut i = 0; i < lowered.parser_rules.len(); i += 1 {
            gen_tournament_alt_scans(w, &grammar.parser_rules[i], &lowered.parser_rules[i], ctx);
        }
    }
    for let mut i = 0; i < lowered.parser_rules.len(); i += 1 {
        gen_rule_fn(w, &lowered.parser_rules[i], &grammar.parser_rules[i], i, ctx, ef);
    }
    gen_parse_entry(w, lowered, ef);
    gen_string_tree_helper(w, grammar, lit_tokens);
}

/// Emit per-alt scan helpers (`_parse_<rule>_scan_<idx>`) for a tournament
/// rule, so the longest-match dispatch can weigh each alternative.
fn gen_tournament_alt_scans(w: &mut CodeWriter, rule: &ParserRule, lowered_rule: &Rule, ctx: &mut GenContext) {
    if let MultiAlt(m) = lowered_rule {
        if let Tournament(_) = &m.dispatch {
            let fn_name = `_parse_{m.header.snake_name}`;
            for let alt of &m.alts {
                gen_alt_scan_if_possible(
                    w,
                    &rule.alternatives[alt.alt_index],
                    lowered_rule,
                    &fn_name,
                    alt.alt_index,
                    &rule.name,
                    ctx,
                );
            }
        }
    }
}

/// Emit the per-rule `RK_<RULE>` node-kind constants and the `GALE_RULE_NAMES`
/// table (rule-index order). `NodeKind`'s name-aware `Display`/`Inspect` are a
/// later stage; for now the name table drives `to_string_tree`.
fn gen_node_kinds(w: &mut CodeWriter, rules: &List<Rule>) {
    for let mut i = 0; i < rules.len(); i += 1 {
        w.line(&`global RK_{rule_const(&rule_name(&rules[i]))}: NodeKind = {i};`);
    }
    w.blank();
    let mut names = String::with_capacity(rules.len() * 12);
    names.push('[');
    for let mut i = 0; i < rules.len(); i += 1 {
        if i > 0 {
            names.push_str(&", ");
        }
        names.push('"');
        names.push_str(&rule_name(&rules[i]));
        names.push('"');
    }
    names.push(']');
    w.line(&`global GALE_RULE_NAMES: List<String> = {names};`);
    w.blank();
}

fn rule_name(rule: &Rule) -> String {
    return match *rule {
        Simple(s) => s.header.name,
        MultiAlt(m) => m.header.name,
        LeftRecursive(l) => l.header.name,
    };
}

fn rule_snake(rule: &Rule) -> String {
    return match *rule {
        Simple(s) => s.header.snake_name,
        MultiAlt(m) => m.header.snake_name,
        LeftRecursive(l) => l.header.snake_name,
    };
}

/// Uppercase the rule name for the `RK_` constant suffix.
fn rule_const(name: &String) -> String {
    let mut out = String::with_capacity(name.len());
    for let c of name.chars() {
        out.push(c.to_ascii_uppercase());
    }
    return out;
}

/// Emit the infallible `Parser` and its helpers.
fn gen_parser_runtime(w: &mut CodeWriter, needs_scan: bool) {
    // `toks` is owned by value (not a reference): the parse path holds no
    // references, so the result `tokens` and tree (`i32` indices) carry none
    // either. (A `&TokenStream` field tripped a WIR-lowering ICE when the
    // owning local was moved into the returned `ParseResult`.)
    w.line(&"struct Parser {");
    w.indent();
    w.line(&"toks: TokenStream,");
    if needs_scan {
        // `kinds` is an `Array<i32>` snapshot of `toks.kinds` for the scan
        // functions (longest-match tournament lookahead), which take
        // `&Array<i32>`. Only carried when a tournament needs them.
        w.line(&"kinds: Array<i32>,");
    }
    w.line(&"pos: i32,");
    w.line(&"b: TreeBuilder,");
    w.line(&"diagnostics: List<Diagnostic>,");
    w.line(&"max_errors: i32,");
    w.line(&"bailed: bool,");
    w.dedent();
    w.line(&"}");
    w.blank();

    w.line(&"impl Parser {");
    w.indent();

    w.line(&"fn new(toks: TokenStream, max_errors: i32) -> Parser {");
    w.indent();
    if needs_scan {
        w.line(&"let kinds = toks.kinds.to_array();");
        w.line(
            &"return Parser { toks, kinds, pos: 0, b: TreeBuilder::new(), diagnostics: [], max_errors, bailed: false };",
        );
    } else {
        w.line(&"return Parser { toks, pos: 0, b: TreeBuilder::new(), diagnostics: [], max_errors, bailed: false };");
    }
    w.dedent();
    w.line(&"}");
    w.blank();

    w.line(&"fn peek_kind(&self) -> i32 {");
    w.indent();
    w.line(&"if self.pos < self.toks.len() { return self.toks.kinds[self.pos]; }");
    w.line(&"return TK_EOF;");
    w.dedent();
    w.line(&"}");
    w.blank();

    // Lookahead `offset` tokens past the cursor (overlapping-LR second-token
    // dispatch); past the end reads `TK_EOF`.
    w.line(&"fn peek_at(&self, offset: i32) -> i32 {");
    w.indent();
    w.line(&"let idx = self.pos + offset;");
    w.line(&"if idx >= self.toks.len() { return TK_EOF; }");
    w.line(&"return self.toks.kinds[idx];");
    w.dedent();
    w.line(&"}");
    w.blank();

    w.line(&"fn peek_start(&self) -> i32 {");
    w.indent();
    w.line(&"if self.pos < self.toks.len() { return self.toks.starts[self.pos]; }");
    w.line(&"if self.toks.len() > 0 { return self.toks.ends[self.toks.len() - 1]; }");
    w.line(&"return 0;");
    w.dedent();
    w.line(&"}");
    w.blank();

    w.line(&"fn last_end(&self) -> i32 {");
    w.indent();
    w.line(&"if self.pos > 0 { return self.toks.ends[self.pos - 1]; }");
    w.line(&"return self.peek_start();");
    w.dedent();
    w.line(&"}");
    w.blank();

    w.line(&"fn advance(&mut self) -> i32 {");
    w.indent();
    w.line(&"let i = self.pos;");
    w.line(&"if self.pos < self.toks.len() { self.pos += 1; }");
    w.line(&"return i;");
    w.dedent();
    w.line(&"}");
    w.blank();

    // Consume a terminal of `kind`, adding it to the open node. EOF is added
    // without advancing (it is the trailing sentinel). A mismatch fails soft.
    w.line(&"fn expect_token(&mut self, kind: i32) {");
    w.indent();
    w.line(&"if self.bailed { return; }");
    w.line(&"if self.peek_kind() == kind {");
    w.indent();
    w.line(&"if kind == TK_EOF { self.b.token(self.pos); return; }");
    w.line(&"self.b.token(self.advance());");
    w.line(&"return;");
    w.dedent();
    w.line(&"}");
    w.line(&"self.fail([kind]);");
    w.dedent();
    w.line(&"}");
    w.blank();

    // Consume the current token if its kind is in `kinds` (a token-only group
    // such as `('+' | '-')`), else fail soft.
    w.line(&"fn expect_one_of(&mut self, kinds: List<i32>) {");
    w.indent();
    w.line(&"if self.bailed { return; }");
    w.line(&"let k = self.peek_kind();");
    w.line(&"for let e of &kinds { if *e == k { self.b.token(self.advance()); return; } }");
    w.line(&"self.fail(kinds);");
    w.dedent();
    w.line(&"}");
    w.blank();

    // `.` wildcard: consume any non-EOF token.
    w.line(&"fn expect_any(&mut self) {");
    w.indent();
    w.line(&"if self.bailed { return; }");
    w.line(&"if self.peek_kind() != TK_EOF { self.b.token(self.advance()); return; }");
    w.line(&"self.fail([]);");
    w.dedent();
    w.line(&"}");
    w.blank();

    // `~(...)` set complement: consume any token not in `excluded`.
    w.line(&"fn expect_not(&mut self, excluded: List<i32>) {");
    w.indent();
    w.line(&"if self.bailed { return; }");
    w.line(&"let k = self.peek_kind();");
    w.line(&"if k != TK_EOF {");
    w.indent();
    w.line(&"for let e of &excluded { if *e == k { self.fail(excluded); return; } }");
    w.line(&"self.b.token(self.advance());");
    w.line(&"return;");
    w.dedent();
    w.line(&"}");
    w.line(&"self.fail(excluded);");
    w.dedent();
    w.line(&"}");
    w.blank();

    // Record one diagnostic and fold the tree closed (Stage 2 fail-soft).
    w.line(&"fn fail(&mut self, expected: List<i32>) {");
    w.indent();
    w.line(&"if self.bailed { return; }");
    w.line(&"let found = self.peek_kind();");
    w.line(
        &"let span = if self.pos < self.toks.len() { self.toks.span_at(self.pos) } else { Span::new(self.last_end(), self.last_end()) };",
    );
    w.line(&"let lc = line_col(self.toks.chars, span.start);");
    w.line(&"let mut msg = String::with_capacity(32);");
    w.line(&"msg.push_str(&\"expected \");");
    w.line(&"msg.push_str(&expected_names(&expected));");
    w.line(&"msg.push_str(&\", found \");");
    w.line(&"msg.push_str(&token_kind_name(found));");
    w.line(&"let mut d = Diagnostic::error(DiagnosticCode::UnexpectedToken, msg, span, lc.0, lc.1);");
    w.line(&"d.expected = expected;");
    w.line(&"d.found = found;");
    w.line(&"self.diagnostics.push(d);");
    w.line(&"self.bailed = true;");
    w.dedent();
    w.line(&"}");

    w.dedent();
    w.line(&"}");
    w.blank();

    // Render an `expected` kind list as `A or B or ...` for a message.
    w.line(&"fn expected_names(kinds: &List<i32>) -> String {");
    w.indent();
    w.line(&"if kinds.is_empty() { return String::from(\"a token\"); }");
    w.line(&"let mut out = String::with_capacity(kinds.len() * 8);");
    w.line(&"for let mut i = 0; i < kinds.len(); i += 1 {");
    w.indent();
    w.line(&"if i > 0 { out.push_str(&\" or \"); }");
    w.line(&"out.push_str(&token_kind_name(kinds[i]));");
    w.dedent();
    w.line(&"}");
    w.line(&"return out;");
    w.dedent();
    w.line(&"}");
    w.blank();
}

/// Emit `fn _parse_<rule>(p: &mut Parser)` for one rule. `ef` threads the
/// caller-FOLLOW machinery (the `follow` parameter and its uses).
fn gen_rule_fn(w: &mut CodeWriter, rule: &Rule, ast_rule: &ParserRule, rule_index: i32, ctx: &mut GenContext, ef: bool) {
    let snake = rule_snake(rule);
    let rk = `RK_{rule_const(&rule_name(rule))}`;
    if let LeftRecursive(l) = rule {
        gen_lr_rule_fn(w, l, ast_rule, &rk, &snake, ctx, ef);
        return;
    }
    w.begin(&`fn _parse_{snake}(p: &mut Parser{follow_param(ef)})`);
    w.line(&"if p.bailed { return; }");
    w.line(&"let start = p.peek_start();");
    w.line(&`p.b.start_node({rk}, start);`);
    // Per-function name table for scan-guard label dedup (`gen_rep_scan_guard`).
    let mut nc: List<[String, i32]> = [];
    match *rule {
        Simple(s) => emit_ops(w, &s.body.ops, ctx, ef, &mut nc),
        MultiAlt(m) => {
            if let Tournament(td) = &m.dispatch {
                emit_tournament(w, &m.alts, td, &snake, ctx, ef, &mut nc);
            } else {
                emit_alt_dispatch(w, &m.alts, &m.dispatch, ctx, ef, &mut nc);
            }
        },
        LeftRecursive(_) => panic("cst_gen: unreachable"),
    }
    w.line(&"p.b.finish_node(p.last_end());");
    w.end();
    w.blank();
}

/// Emit a longest-match tournament: scan every alternative, pick the one that
/// advances furthest, and emit its ops (builder mode). Mirrors the typed
/// emitter's ANTLR4-compatible first-success-on-ties longest-match. Requires
/// every alt to have a full scan (`gen_tournament_alt_scans`); partial-scan
/// tournaments are out of scope.
fn emit_tournament(w: &mut CodeWriter, alts: &List<AltBody>, td: &TournamentDispatch, snake: &String, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    w.line(&"let _sd_pos = p.pos;");
    for let idx of &td.alts {
        w.line(&`let _sd_p_{*idx} = _parse_{*snake}_scan_{*idx}(&p.kinds, _sd_pos);`);
    }
    w.line(&"let mut _sd_best_i: i32 = -1;");
    w.line(&"let mut _sd_best_p: i32 = -1;");
    for let idx of &td.alts {
        w.begin(&`if _sd_p_{*idx} > _sd_best_p`);
        w.line(&`_sd_best_p = _sd_p_{*idx};`);
        w.line(&`_sd_best_i = {*idx};`);
        w.end();
    }
    let mut first = true;
    for let idx of &td.alts {
        if first {
            w.begin(&`if _sd_best_i == {*idx}`);
            first = false;
        } else {
            w.else_begin(&`else if _sd_best_i == {*idx}`);
        }
        emit_ops(w, &alt_by_index(alts, *idx).ops, ctx, ef, nc);
    }
    w.else_begin(&"else");
    w.line(&"p.fail([]);");
    w.end();
}

/// Emit a left-recursive rule as a precedence-climbing parser. The atom (the
/// non-recursive alternatives) opens one rule node; the LR loop wraps it
/// left-associatively via `start_node_at` at a fixed checkpoint. A self-ref
/// `RuleCall` in a suffix carries its `min_prec_arg` (baked by lowering), so
/// the right operand recurses at the correct precedence. Suffixes that share
/// their first token are an overlap group, disambiguated by a second-token
/// sub-dispatch (the same projection the typed emitter uses).
fn gen_lr_rule_fn(
    w: &mut CodeWriter,
    l: &LeftRecursiveRule,
    ast_rule: &ParserRule,
    rk: &String,
    snake: &String,
    ctx: &mut GenContext,
    ef: bool,
) {
    // `follow` precedes `min_prec` (uniform with the typed emitter's signature).
    w.begin(&`fn _parse_{snake}(p: &mut Parser{follow_param(ef)}, min_prec: i32 = 0)`);
    w.line(&"if p.bailed { return; }");
    w.line(&"let cp = p.b.checkpoint();");
    w.line(&"let start = p.peek_start();");
    w.line(&`p.b.start_node({*rk}, start);`);
    let mut nc: List<[String, i32]> = [];
    if l.atom.alts.len() == 1 {
        emit_ops(w, &l.atom.alts[0].ops, ctx, ef, &mut nc);
    } else {
        emit_alt_dispatch(w, &l.atom.alts, &l.atom.dispatch, ctx, ef, &mut nc);
    }
    w.line(&"p.b.finish_node(p.last_end());");
    gen_lr_loop(w, l, ast_rule, rk, ctx, ef, &mut nc);
    w.end();
    w.blank();
}

fn gen_lr_loop(w: &mut CodeWriter, l: &LeftRecursiveRule, ast_rule: &ParserRule, rk: &String, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    w.begin(&"loop");
    w.line(&"if p.bailed { break; }");
    w.line(&"let suffix_kind = p.peek_kind();");
    let mut first = true;
    for let group of &l.lr_dispatch.groups {
        // Union of every member suffix's first set gates the group's outer arm.
        let mut union_first: List<String> = [];
        for let gi of group {
            for let tk of &l.lr_alts[l.lr_dispatch.valid_lr_alts[*gi]].suffix_first {
                if !union_first.contains(tk) {
                    union_first.push(*tk);
                }
            }
        }
        let cond = kinds_or(&union_first, &"suffix_kind");
        if first {
            w.begin(&`if {cond}`);
            first = false;
        } else {
            w.else_begin(&`else if {cond}`);
        }
        if group.len() == 1 {
            let lr = &l.lr_alts[l.lr_dispatch.valid_lr_alts[group[0]]];
            emit_lr_branch(w, lr, rk, ctx, ef, nc);
        } else {
            emit_lr_overlap(w, l, ast_rule, group, rk, ctx, ef, nc);
        }
    }
    if first {
        w.line(&"break;");
    } else {
        w.else_begin(&"else");
        w.line(&"break;");
        w.end();
    }
    w.end();
}

/// Emit one LR continuation: gate on precedence, wrap the in-progress tree
/// left-associatively, and emit the suffix ops. Below `min_prec` the loop
/// stops climbing.
fn emit_lr_branch(w: &mut CodeWriter, lr: &LrAlt, rk: &String, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    w.begin(&`if {lr.own_prec} >= min_prec`);
    w.line(&`p.b.start_node_at(cp, {*rk}, start);`);
    emit_ops(w, &lr.suffix.ops, ctx, ef, nc);
    w.line(&"p.b.finish_node(p.last_end());");
    w.else_begin(&"else");
    w.line(&"break;");
    w.end();
}

/// Disambiguate an overlap group (suffixes sharing a first token) by a
/// second-token sub-dispatch, mirroring the typed emitter's
/// `gen_lr_overlap_dispatch`: unique first tokens commit directly; a shared
/// first token branches on `peek_at(1)`, the last candidate falling through.
fn emit_lr_overlap(
    w: &mut CodeWriter,
    l: &LeftRecursiveRule,
    ast_rule: &ParserRule,
    group: &List<i32>,
    rk: &String,
    ctx: &mut GenContext,
    ef: bool,
    nc: &mut List<[String, i32]>,
) {
    let mut first_sets: List<List<String>> = [];
    for let gi of group {
        first_sets.push(l.lr_alts[l.lr_dispatch.valid_lr_alts[*gi]].suffix_first);
    }
    let mut emitted: List<String> = [];
    let mut first_branch = true;

    // First pass: tokens owned by exactly one member commit to that member.
    for let mut k = 0; k < group.len(); k += 1 {
        for let tk of &first_sets[k] {
            if emitted.contains(tk) {
                continue;
            }
            let mut shared = false;
            for let mut j = 0; j < group.len(); j += 1 {
                if j != k && first_sets[j].contains(tk) {
                    shared = true;
                }
            }
            if !shared {
                if first_branch {
                    w.begin(&`if suffix_kind == {*tk}`);
                    first_branch = false;
                } else {
                    w.else_begin(&`else if suffix_kind == {*tk}`);
                }
                emit_lr_branch(w, &l.lr_alts[l.lr_dispatch.valid_lr_alts[group[k]]], rk, ctx, ef, nc);
                emitted.push(*tk);
            }
        }
    }

    // Second pass: shared tokens resolved by the following token.
    let mut shared_tokens: List<String> = [];
    for let mut k = 0; k < group.len(); k += 1 {
        for let tk of &first_sets[k] {
            if emitted.contains(tk) || shared_tokens.contains(tk) {
                continue;
            }
            shared_tokens.push(*tk);
        }
    }
    for let shared_tk of &shared_tokens {
        if first_branch {
            w.begin(&`if suffix_kind == {*shared_tk}`);
            first_branch = false;
        } else {
            w.else_begin(&`else if suffix_kind == {*shared_tk}`);
        }
        let mut last_k = -1;
        for let mut k = 0; k < group.len(); k += 1 {
            if first_sets[k].contains(shared_tk) {
                last_k = k;
            }
        }
        let mut sub_first = true;
        for let mut k = 0; k < group.len(); k += 1 {
            if !first_sets[k].contains(shared_tk) {
                continue;
            }
            let lr = &l.lr_alts[l.lr_dispatch.valid_lr_alts[group[k]]];
            if k == last_k {
                if sub_first {
                    emit_lr_branch(w, lr, rk, ctx, ef, nc);
                } else {
                    w.else_begin(&"else");
                    emit_lr_branch(w, lr, rk, ctx, ef, nc);
                    w.end();
                }
            } else {
                let elements = &ast_rule.alternatives[lr.alt_index].elements;
                let second = compute_lr_second_token(shared_tk, elements, ctx);
                let sub_cond = kinds_or(&second, &"p.peek_at(1)");
                if sub_first {
                    w.begin(&`if {sub_cond}`);
                    sub_first = false;
                } else {
                    w.else_begin(&`else if {sub_cond}`);
                }
                emit_lr_branch(w, lr, rk, ctx, ef, nc);
            }
        }
        emitted.push(*shared_tk);
    }
    if !first_branch {
        w.end();
    }
}

/// Emit token-led dispatch over a rule's / group's alternatives.
fn emit_alt_dispatch(w: &mut CodeWriter, alts: &List<AltBody>, dispatch: &MultiAltDispatch, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    let dd = match *dispatch {
        Direct(d) => d,
        Tournament(_) => panic("cst_gen: tournament dispatch is outside Stage 2 scope"),
    };
    w.line(&"let kind = p.peek_kind();");
    let mut all_first: List<String> = [];
    for let mut i = 0; i < dd.branches.len(); i += 1 {
        let br = &dd.branches[i];
        for let t of &br.tokens {
            all_first.push(*t);
        }
        let cond = kinds_or(&br.tokens, &"kind");
        if i == 0 {
            w.begin(&`if {cond}`);
        } else {
            w.else_begin(&`else if {cond}`);
        }
        emit_ops(w, &alt_by_index(alts, br.alt_index).ops, ctx, ef, nc);
    }
    w.else_begin(&"else");
    w.line(&`p.fail({kinds_list(&all_first)});`);
    w.end();
}

fn alt_by_index(alts: &List<AltBody>, idx: i32) -> &AltBody with stores[alts] {
    for let a of alts {
        if a.alt_index == idx {
            return a;
        }
    }
    panic(`cst_gen: no alt with index {idx}`);
}

fn emit_ops(w: &mut CodeWriter, ops: &List<Op>, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    for let op of ops {
        emit_op(w, op, ctx, ef, nc);
    }
}

fn emit_op(w: &mut CodeWriter, op: &Op, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    match *op {
        Token(t) => w.line(&`p.expect_token({t.kind});`),
        Literal(l) => w.line(&`p.expect_token({l.kind});`),
        RuleCall(rc) => {
            // `follow` (caller continuation) precedes `min_prec` (LR self-ref).
            let mp = if let Some(prec) = rc.min_prec_arg {
                `, {prec}`;
            } else {
                String::from("");
            };
            w.line(&`_parse_{rc.target_snake}(p{follow_arg(ef, &rc.follow_arg)}{mp});`);
        },
        Wildcard(_) => w.line(&"p.expect_any();"),
        Excluded(e) => w.line(&`p.expect_not({kinds_list(&e.kinds)});`),
        ListLabel(ll) => emit_op(w, &ll.inner, ctx, ef, nc),
        Repeat(r) => emit_repeat(w, &r, ctx, ef, nc),
        Group(g) => emit_group(w, &g, ctx, ef, nc),
    }
}

fn emit_repeat(w: &mut CodeWriter, r: &RepeatOp, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    // Non-greedy `*?` / `+?`: lower bakes a `NonGreedy` strategy whose exit
    // condition is the negation of a static continue-while gate (the inner's
    // first set minus the caller's continuation, or a 2-token disambiguation).
    // (`??` lowers to a `Plain` strategy that needs the runtime ATN simulator
    // and is rejected up front by the `needs_atn` boundary in `gen_cst_parser`.)
    if let NonGreedy(_) = r.strategy {
        emit_repeat_non_greedy(w, r, ctx, ef, nc);
        return;
    }
    // A `Star` / `Plus` whose body first set overlaps its static caller-FOLLOW
    // uses a scan-guarded loop when the body is scannable: each iteration first
    // scans the whole body and only commits if it matches. This is what lets
    // `(',' arm)*` yield a trailing `','` to the following `','?` instead of
    // greedily consuming it and failing on the absent `arm`. When the body
    // first and follow are disjoint the plain first-set guard already
    // distinguishes "iterate" from "exit", so it is kept — both because it is
    // correct and because it does not depend on the body's scan being exact
    // (a body with an inner non-greedy `.*?` is not). Reuses the typed
    // emitter's `gen_rep_scan_guard`. `Optional` never needs it.
    let overlaps_follow = sets_overlap(&r.body_first_set, &r.caller_follow_first);
    if r.body_scannable && overlaps_follow {
        if let Optional = r.kind {
            // fall through to the plain first-set form below
        } else {
            emit_repeat_scan_guarded(w, r, ctx, ef, nc);
            return;
        }
    }
    let cond = kinds_or(&r.body_first_set, &"p.peek_kind()");
    let gate = repeat_gate(r, ef);
    match r.kind {
        Optional => {
            w.begin(&`if !p.bailed && {cond}{gate}`);
            emit_op(w, &r.body, ctx, ef, nc);
            w.end();
        },
        Star => {
            w.begin(&`while !p.bailed && {cond}{gate}`);
            emit_op(w, &r.body, ctx, ef, nc);
            w.end();
        },
        Plus => {
            // One mandatory iteration, then the same first-set-gated loop.
            emit_op(w, &r.body, ctx, ef, nc);
            w.begin(&`while !p.bailed && {cond}{gate}`);
            emit_op(w, &r.body, ctx, ef, nc);
            w.end();
        },
    }
}

/// Scan-guarded `Star` / `Plus`: `loop { [caller-FOLLOW gate]; scan body; if it
/// fails, break; else parse body }`. The scan (`gen_rep_scan_guard` over the
/// lowered `scan_body`) requires the whole iteration to match before the parse
/// commits, so the loop never over-consumes a token its continuation needs.
fn emit_repeat_scan_guarded(w: &mut CodeWriter, r: &RepeatOp, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    if let Plus = r.kind {
        // `+`: one mandatory iteration up front (the body must match once).
        emit_op(w, &r.body, ctx, ef, nc);
    }
    w.begin(&"loop");
    w.line(&"if p.bailed { break; }");
    if ef && r.gate_caller_follow {
        w.line(&"if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }");
    }
    let scan_pos = gen_rep_scan_guard(w, &r.scan_body, ctx, nc);
    w.line(&`if {scan_pos} < 0 \{ break; \}`);
    emit_op(w, &r.body, ctx, ef, nc);
    w.end();
}

/// Non-greedy `*?` / `+?`: loop only while the static continue gate holds, so
/// the loop stops as soon as the caller's continuation can fire. The gate is
/// `compute_non_greedy_condition` over the lowered per-position follow sets —
/// the same condition the typed emitter computes — referencing `peek_kind()` /
/// `peek_at(1)`. A `"false"` gate means "match the minimum" (never loop).
fn emit_repeat_non_greedy(w: &mut CodeWriter, r: &RepeatOp, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    let cond = compute_non_greedy_condition(r, &r.caller_follow_first, &r.caller_follow_second, ctx);
    let loops = cond != "false";
    match r.kind {
        Plus => {
            // `+?`: one mandatory iteration, then loop while the gate holds.
            emit_op(w, &r.body, ctx, ef, nc);
            if loops {
                w.begin(&`while !p.bailed && ({cond})`);
                emit_op(w, &r.body, ctx, ef, nc);
                w.end();
            }
        },
        Star => {
            if loops {
                w.begin(&`while !p.bailed && ({cond})`);
                emit_op(w, &r.body, ctx, ef, nc);
                w.end();
            }
        },
        Optional => panic("cst_gen: non-greedy `??` should be excluded by the needs_atn boundary"),
    }
}

/// A group contributes no tree node (it is transparent); only its control
/// flow matters. A token-only group (`('+' | '-')`) consumes one of its
/// tokens directly; a single-alt group inlines its ops; a general multi-alt
/// group dispatches like a rule.
fn emit_group(w: &mut CodeWriter, g: &GroupOp, ctx: &mut GenContext, ef: bool, nc: &mut List<[String, i32]>) {
    if let Some(kinds) = group_token_only_kinds(&g.alts) {
        w.line(&`p.expect_one_of({kinds_list(&kinds)});`);
        return;
    }
    if g.alts.len() == 1 {
        emit_ops(w, &g.alts[0].ops, ctx, ef, nc);
        return;
    }
    emit_alt_dispatch(w, &g.alts, &g.dispatch, ctx, ef, nc);
}

/// If every alt is a single terminal (`Token` or `Literal`), return the list
/// of their kind constants; otherwise `None`. Lets a token-only group consume
/// one token without relying on the group's dispatch table.
fn group_token_only_kinds(alts: &List<AltBody>) -> Option<List<String>> {
    let mut kinds: List<String> = [];
    for let alt of alts {
        if alt.ops.len() != 1 {
            return null;
        }
        match &alt.ops[0] {
            Token(t) => kinds.push(t.kind),
            Literal(l) => kinds.push(l.kind),
            _ => {
                return null;
            },
        }
    }
    return Option::Some(kinds);
}

/// Emit the public `parse` entry plus the `_parse_<start>` driver.
fn gen_parse_entry(w: &mut CodeWriter, lowered: &LoweredGrammar, ef: bool) {
    if lowered.parser_rules.is_empty() {
        panic("cst_gen: grammar has no parser rules");
    }
    let start = rule_snake(&lowered.parser_rules[0]);
    let start_follow = if ef { ", &EMPTY_FOLLOW" } else { "" };
    // `max_errors` caps how many diagnostics the parser collects before it
    // stops recovering and folds the tree closed (`<= 1` ≈ fail-fast).
    // Defaulted, so the common call is just `parse(input)`.
    w.begin(&"pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult");
    w.line(&"let tokens = tokenize(input);");
    w.line(&"let mut p = Parser::new(tokens, max_errors);");
    w.line(&`_parse_{start}(&mut p{start_follow});`);
    // The parser owns the stream; hand it back in the result. The tree holds
    // only `i32` indices, so the returned `ParseResult` carries no references.
    w.line(&"return ParseResult { root: p.b.finish(), tokens: p.toks, diagnostics: p.diagnostics };");
    w.end();
    w.blank();
}

/// Emit a `to_string_tree(node)` convenience that supplies the grammar's name
/// tables (rules from `GALE_RULE_NAMES`, tokens via the generated
/// `token_kind_name`). Used by driver tests; never called by the parser.
fn gen_string_tree_helper(w: &mut CodeWriter, grammar: &Grammar, lit_tokens: &List<LitToken>) {
    let n = num_token_kinds(&grammar.lexer_rules, lit_tokens);
    w.begin(&"pub fn to_string_tree(result: &ParseResult) -> String");
    w.line(&`let mut token_names: List<String> = List::with_capacity({n});`);
    w.begin(&`for let mut k = 0; k < {n}; k += 1`);
    w.line(&"token_names.push(token_kind_name(k));");
    w.end();
    w.line(&"return result.root.to_string_tree(&result.tokens, &GALE_RULE_NAMES, &token_names);");
    w.end();
    w.blank();
}
