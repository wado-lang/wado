//! Stage C: predicate-gated prediction on an all-single-token multi-alt rule.
//! The compact single-token fast path runs no actions/predicates, so a rule
//! carrying them must take the general path. Alts 0 and 1 tie on `A`; their
//! alt-initial predicates pick alt 1.

use ps from "./grammars/wado_pred_single.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/action_pred_single" },
    };

test "an alt-initial predicate selects a single-token alternative" {
    let result = ps::parse_item("a");
    assert result.ok(), "clean parse under a true predicate";
    assert result.output == "alt1", `output: '${result.output}'`;
}

// The jar gives `(pick a x)`: a context-independent predicate in the called rule
// excludes it. Gale's scan evaluates no predicate it cannot read off the scan gate.
#[TODO]
test "a scan honours a called rule's predicate" {
    let rejected = ps::parse_pick("a x");
    assert rejected.ok(), `${rejected.diagnostics[0]}`;
    assert ps::to_string_tree(&rejected) == "(pick a x)";
    let accepted = ps::parse_pick("b x");
    assert ps::to_string_tree(&accepted) == "(pick (gated b) x)";
}

test "a distinct single-token alt stays a plain branch" {
    let result = ps::parse_item("b");
    assert result.ok(), "clean parse of the distinct-token alt";
    assert result.output == "alt2", `output: '${result.output}'`;
}
