//! Stage 3 down-payment on the emitter: a diagnostic carries a
//! 1-based line / 0-based column and the active rule chain (innermost-first).
//! Driven through JSON so the chain (json > value > obj > pair > value) is
//! predictable. The parser's diagnostic currency is `Diagnostic`
//! (in `result.diagnostics`), not a `ParseError`.
use json from "./grammars/JSON.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_diagnostics" },
    };

test "diagnostic carries a 1-based line and 0-based column" {
    // `{"a": }` — after the colon a value is required but `}` is at column 6.
    let r = json::parse("{\"a\": }");
    assert !r.ok(), "expected a diagnostic";
    let d = &r.diagnostics[0];
    assert d.line == 1, `line ${d.line}`;
    assert d.col == 6, `col ${d.col}`;
}

test "diagnostic reports the active rule chain" {
    let r = json::parse("{\"a\": }");
    let d = &r.diagnostics[0];
    assert !d.rule_stack.is_empty(), "rule_stack empty";
    // Innermost rule first, start rule last.
    assert d.rule_stack[d.rule_stack.len() - 1] == "json", `outer ${d.rule_stack[d.rule_stack.len() - 1]}`;
    assert d.rule_stack[0] == "value", `inner ${d.rule_stack[0]}`;
}

test "diagnostic Display includes position and message" {
    let r = json::parse("{\"a\": }");
    let text = `${r.diagnostics[0]}`;
    assert text.contains("at 1:6:"), text;
}

test "line and column advance across newlines" {
    let r = json::parse("{\n  \"a\":\n}");
    let d = &r.diagnostics[0];
    assert d.line == 3, `line ${d.line}`;
    assert d.col == 0, `col ${d.col}`;
}

test "a valid parse reports no diagnostics" {
    let r = json::parse("{\"a\": 1}");
    assert r.ok(), "unexpected diagnostics";
}

test "a character no lexer rule matches is a LexError diagnostic" {
    let r = json::parse("{\"a\": 1 #}");
    let d = &r.diagnostics[0];
    assert d.code matches { LexError }, `code ${d.code.name()}`;
    assert d.message == "token recognition error at: '#'", d.message;
    assert d.line == 1 && d.col == 8, `at ${d.line}:${d.col}`;
    let mut flagged = 0;
    for let mut i = 0; i < r.tokens.len(); i += 1 {
        if r.tokens.is_lex_error(i) {
            flagged += 1;
        }
    }
    assert flagged == 1;
}

test "input ending inside a construct is an unterminated construct" {
    let r = json::parse("[1, 2");
    let d = &r.diagnostics[r.diagnostics.len() - 1];
    assert d.code matches { UnterminatedConstruct }, `${d}`;
    assert d.found == json::TK_EOF, `${d}`;
    assert d.expected.len() == 1, `${d}`;
}

test "no viable alternative carries the NoViableAlternative code" {
    // `}` starts no `value` alternative, so the dispatch falls through to the
    // no-viable fallback.
    let r = json::parse("{\"a\": }");
    assert r.diagnostics[0].code matches { NoViableAlternative }, `code ${r.diagnostics[0].code.name()}`;
}
