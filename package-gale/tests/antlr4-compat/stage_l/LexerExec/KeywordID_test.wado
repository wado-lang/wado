test "stage_l: LexerExec/KeywordID" {
    let input = "end eend ending a";
    let expected = "[@0,0:2='end',<1>,1:0]
[@1,3:3=' ',<3>,1:3]
[@2,4:7='eend',<2>,1:4]
[@3,8:8=' ',<3>,1:8]
[@4,9:14='ending',<2>,1:9]
[@5,15:15=' ',<3>,1:15]
[@6,16:16='a',<2>,1:16]
[@7,17:16='<EOF>',<-1>,1:17]
";
    let tokens = t::tokenize(&input);
    let actual = t::to_lexer_string(&tokens, &input, TK_EOF);
    assert actual == expected, `actual:\n{actual}\nexpected:\n{expected}`;
}
