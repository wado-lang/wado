use calc from "./golden/calculator.wado";
use { normalize_tree } from "./golden/calculator.wado";

fn assert_tree(input: &String, expected: &String) {
    let root = calc::parse(input).unwrap();
    let tree = calc::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

test "tokenize expression" {
    let tokens = calc::tokenize(&"1 + 2");
    assert tokens.len() >= 3, `expected at least 3 tokens, got {tokens.len()}`;
}

test "parse simple equation" {
    let result = calc::parse(&"1 + 2 = 3");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse multiplication" {
    let result = calc::parse(&"2 * 3 = 6");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "tree: addition" {
    assert_tree(&"1 + 2 = 3", &"
        (equation
          (expression
            (multiplyingExpression (powExpression (signedAtom (atom (scientific 1)))))
            + (multiplyingExpression (powExpression (signedAtom (atom (scientific 2))))))
          (relop =)
          (expression
            (multiplyingExpression (powExpression (signedAtom (atom (scientific 3)))))))
    ");
}

test "tree: multiplication" {
    assert_tree(&"2 * 3 = 6", &"
        (equation
          (expression
            (multiplyingExpression
              (powExpression (signedAtom (atom (scientific 2))))
              * (powExpression (signedAtom (atom (scientific 3))))))
          (relop =)
          (expression
            (multiplyingExpression (powExpression (signedAtom (atom (scientific 6)))))))
    ");
}
