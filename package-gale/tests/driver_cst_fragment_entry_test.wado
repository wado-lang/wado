//! The `fragment_entries` generator option. The grammar is generated twice —
//! with the option and without — so clean inputs must parse to the same tree
//! (the rejection guarantee).

use fe_on from "./grammars/fragment_entry.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            output_dir: "./generated/cst_fragment_entry_on",
            options: {
                fragment_entries: ["stmt"],
            },
        },
    };

use fe_off from "./grammars/fragment_entry_off.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_fragment_entry_off" },
    };

fn assert_clean_identical<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let on = fe_on::to_string_tree(&fe_on::parse(input));
    let off = fe_off::to_string_tree(&fe_off::parse(input));
    assert on == expected.to_string(), `on:\n  expected: ${expected}\n  actual:   ${on}`;
    assert on == off, `option changed a clean parse:\n  on:  ${on}\n  off: ${off}`;
    assert fe_on::parse(input).ok(), `clean input should parse cleanly: ${input}`;
}

test "clean parse unchanged: bare item" {
    assert_clean_identical("set a ;", "(prog (item set a ;))");
}

test "clean parse unchanged: main block with statements" {
    assert_clean_identical("main { do x ; do y ; }", "(prog (item (main main { (stmt do x ;) (stmt do y ;) })))");
}

test "fragment recovers a statement sequence under root" {
    let r = fe_on::parse("do x ; do y ;");
    assert !r.ok(), "fragment should report a diagnostic";
    let tree = fe_on::to_string_tree(&r);
    assert tree == "(prog (<error> (stmt do x ;) (stmt do y ;)))", `unexpected tree: ${tree}`;
}

test "fragment without the option builds no subtree" {
    let r = fe_off::parse("do x ; do y ;");
    assert !r.ok(), "fragment should report a diagnostic";
    let tree = fe_off::to_string_tree(&r);
    assert tree == "(prog <skip do> <skip x> <skip ;> <skip do> <skip y> <skip ;>)", `unexpected tree: ${tree}`;
}

test "fragment with trailing junk terminates" {
    let r = fe_on::parse("do x ; zzz");
    assert !r.ok(), "fragment should report a diagnostic";
    let tree = fe_on::to_string_tree(&r);
    assert tree.contains("(stmt do x ;)"), `island missing: ${tree}`;
}

test "truncated trailing entry does not trap" {
    let r = fe_on::parse("do x ; do");
    assert !r.ok(), "fragment should report a diagnostic";
    let tree = fe_on::to_string_tree(&r);
    assert tree.contains("(stmt do x ;)"), `first island missing: ${tree}`;
}

// A fragment is what the start rule cannot derive, so the option acts only
// where recovery is back at the root: an error a nested rule recovers from
// reads the same with and without it, diagnostics included.
fn assert_nested_recovery_unchanged<S: AsStrSlice>(input: S) {
    let on = fe_on::parse(input);
    let off = fe_off::parse(input);
    let on_tree = fe_on::to_string_tree(&on);
    let off_tree = fe_off::to_string_tree(&off);
    assert on_tree == off_tree, `option changed a nested recovery:\n  on:  ${on_tree}\n  off: ${off_tree}`;
    let on_diags = `${on.diagnostics:?}`;
    let off_diags = `${off.diagnostics:?}`;
    assert on_diags == off_diags, `option changed a nested diagnostic:\n  on:  ${on_diags}\n  off: ${off_diags}`;
}

test "a nested recovery is the same with the option" {
    assert_nested_recovery_unchanged("main { do do ; }");
    assert_nested_recovery_unchanged("main { do x do y ; }");
    assert_nested_recovery_unchanged("main { set }");
    assert_nested_recovery_unchanged("main { do ; }");
}

fn assert_balanced<S: AsStrSlice>(input: S) {
    let r = fe_on::parse(input);
    let mut depth = 0;
    let mut min_depth = 0;
    for let mut i = 0; i < r.cst.tag.len(); i += 1 {
        match r.cst.tag[i] {
            Open => depth += 1,
            Close => depth -= 1,
            _ => {
            },
        }
        if depth < min_depth {
            min_depth = depth;
        }
    }
    assert depth == 0, `unbalanced (Open-Close=${depth}) for: ${input}`;
    assert min_depth >= 0, `Close before Open for: ${input}`;
}

test "recovered fragments keep a balanced CST" {
    assert_balanced("do x ; do");
    assert_balanced("main { do x");
    assert_balanced("main {");
    assert_balanced("main { do x ; do y");
    assert_balanced("do } zzz");
}
