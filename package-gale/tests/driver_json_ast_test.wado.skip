use json from "./golden/json.wado";
use {
    Span, Token, JsonNode, ValueNode, ValueAlt0, ValueAlt1, ValueAlt2,
    ValueAlt3, ValueAlt4, ValueAlt5, ValueAlt6,
    ObjNode, ObjAlt0, ObjAlt1, PairNode,
    ArrNode, ArrAlt0, ArrAlt1,
    TK_STRING, TK_NUMBER, TK_WS, TK_EOF,
    TK_LIT_LBRACE, TK_LIT_RBRACE, TK_LIT_COLON,
    TK_LIT_LBRACKET, TK_LIT_RBRACKET, TK_LIT_COMMA,
    TK_LIT_TRUE, TK_LIT_FALSE, TK_LIT_NULL,
} from "./golden/json.wado";

fn tok(kind: i32, text: String, start: i32, end: i32) -> Token {
    return Token { kind, text, span: Span { start, end }, leading_trivia: [] };
}

fn s(start: i32, end: i32) -> Span {
    return Span { start, end };
}

test "parse number" {
    // "42"
    let result = json::parse(&"42");
    let tree = result.unwrap();
    let expected = JsonNode {
        span: s(0, 2),
        value: ValueNode::Alt1(ValueAlt1 {
            span: s(0, 2),
            number: tok(TK_NUMBER, "42", 0, 2),
        }),
        eof: tok(TK_EOF, "", 2, 2),
    };
    assert tree == expected, `AST mismatch for "42"`;
}

test "parse true literal" {
    // "true"
    let result = json::parse(&"true");
    let tree = result.unwrap();
    let expected = JsonNode {
        span: s(0, 4),
        value: ValueNode::Alt4(ValueAlt4 {
            span: s(0, 4),
            lit_true: tok(TK_LIT_TRUE, "true", 0, 4),
        }),
        eof: tok(TK_EOF, "", 4, 4),
    };
    assert tree == expected, `AST mismatch for "true"`;
}

test "parse object with key-value" {
    // {"key": "value"}
    let input = "{\"key\": \"value\"}";
    let result = json::parse(&input);
    let tree = result.unwrap();
    let expected = JsonNode {
        span: s(0, 16),
        value: ValueNode::Alt2(ValueAlt2 {
            span: s(0, 16),
            obj: ObjNode::Alt0(ObjAlt0 {
                span: s(0, 16),
                lbrace: tok(TK_LIT_LBRACE, "{", 0, 1),
                pair: PairNode {
                    span: s(1, 15),
                    string: tok(TK_STRING, "\"key\"", 1, 6),
                    colon: tok(TK_LIT_COLON, ":", 6, 7),
                    value: ValueNode::Alt0(ValueAlt0 {
                        span: s(8, 15),
                        string: tok(TK_STRING, "\"value\"", 8, 15),
                    }),
                },
                rbrace: tok(TK_LIT_RBRACE, "}", 15, 16),
            }),
        }),
        eof: tok(TK_EOF, "", 16, 16),
    };
    assert tree == expected, `AST mismatch for object`;
}
