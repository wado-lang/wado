//! A rule whose non-greedy repeat sits behind a reference to another token
//! rule. `A : ('a' | 'ab')+ B ;` is ATN-class for its overlapping arms, and
//! `B : 'x'+? ;` decides that `A` ends at its first accept.

use g from "./grammars/lexer_ref_rule_non_greedy.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_lexer_ref_rule_non_greedy" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}: ${result.diagnostics:?}`;
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "the referenced rule's non-greedy repeat ends the token at its first accept" {
    assert_tree(&"axx", &"(start ax x)");
}
