//! Stage 2b: the ANTLRv4 grammar generates + runs on the homogeneous sink.
//! (Full parse needs semantic predicates, so a parse may carry diagnostics;
//! this verifies the homogeneous parser compiles, tokenizes, and runs.)
use antlr4 from "./grammars/ANTLRv4Lexer.g4"
    with { generator: { module: "../src/generator.wado",
        inputs: ["./grammars/ANTLRv4Parser.g4"],
        options: { highlight: false, homogeneous: true },
        output_dir: "tests/generated/cst_antlr4" } };

test "antlr4: tokenizes a grammar declaration" {
    let tokens = antlr4::tokenize(&"grammar Foo;");
    assert tokens.len() >= 3, `expected >= 3 tokens, got {tokens.len()}`;
}
test "antlr4: parse returns a tree without panicking" {
    let r = antlr4::parse(&"grammar Foo;");
    let s = antlr4::to_string_tree(&r);
    assert s.len() > 0, `empty tree`;
}
