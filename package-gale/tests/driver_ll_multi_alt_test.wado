use g from "./grammars/ll_multi_alt.g4" with { generator: { module: "../src/generator.wado", options: { highlight: false }, output_dir: "tests/generated/ll_multi_alt" } };
use { normalize_tree } from "./grammars/ll_multi_alt.g4";

fn assert_tree(input: &String, expected: &String) {
    let root = g::parse(input).unwrap();
    let tree = g::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

test "tree: X Y picks (a b) when a is multi-alt" {
    assert_tree(&"X Y", &"
        (r (a X) (b Y))
    ");
}

// `a`'s second alt should still work: input "Z" parses through alt 1.
test "tree: Z picks a's second alt" {
    assert_tree(&"Z", &"
        (r (a Z))
    ");
}
