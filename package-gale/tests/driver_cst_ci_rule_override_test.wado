//! Stage 2b migration probe: ci_rule_override.
use ci from "./grammars/ci_rule_override.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ci_rule_override" },
    };
use callee from "./grammars/ci_rule_callee.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ci_rule_callee" },
    };
fn ok<S: AsStrSlice>(input: S) {
    assert ci::parse(input).ok(), `unexpected diagnostics for ${input}`;
}
test "ci-override: lowercase" {
    ok("if foo");
}
test "ci-override: uppercase" {
    ok("IF foo");
}
test "ci-callee: an exact rule calling a folding one matches each case the callee does" {
    let r = callee::parse("qRx");
    assert r.ok(), "unexpected diagnostics for qRx";
    let tree = callee::to_string_tree(&r);
    assert tree == "(s qRx)", tree;
}
