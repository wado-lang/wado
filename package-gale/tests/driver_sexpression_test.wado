use sexpression from "./golden/sexpression.wado";
use { normalize_tree } from "./golden/sexpression.wado";

fn assert_tree(input: &String, expected: &String) {
    let root = sexpression::parse(input).unwrap();
    let tree = sexpression::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

test "tokenize simple atom" {
    let tokens = sexpression::tokenize(&"hello");
    assert tokens.len() >= 1, `expected at least 1 token, got {tokens.len()}`;
}

test "parse single atom" {
    let result = sexpression::parse(&"hello");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse nested list" {
    let result = sexpression::parse(&"(a b c)");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse nested sexpression" {
    let result = sexpression::parse(&"(define (square x) (* x x))");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "tree: single atom" {
    assert_tree(&"hello", &"(sexpr (item (atom hello)))");
}

test "tree: simple list" {
    assert_tree(&"(a b c)", &"
        (sexpr
          (item
            (list_ ( (item (atom a)) (item (atom b)) (item (atom c)) ))))
    ");
}

test "tree: nested lists" {
    assert_tree(&"(define (square x) (* x x))", &"
        (sexpr
          (item
            (list_ (
              (item (atom define))
              (item (list_ ( (item (atom square)) (item (atom x)) )))
              (item (list_ ( (item (atom *)) (item (atom x)) (item (atom x)) )))
            ))))
    ");
}

test "tree: empty sexpr" {
    assert_tree(&"", &"(sexpr)");
}

test "tree: empty list" {
    assert_tree(&"()", &"(sexpr (item (list_ ( ))))");
}

test "tree: deeply nested 5 levels" {
    assert_tree(&"(((((a)))))", &"
        (sexpr
          (item (list_ (
            (item (list_ (
              (item (list_ (
                (item (list_ (
                  (item (list_ (
                    (item (atom a))
                  )))
                )))
              )))
            )))
          ))))
    ");
}

test "tree: multiple top-level mixed atoms" {
    assert_tree(&"hello 42 \"world\" 3.14", &"
        (sexpr
          (item (atom hello))
          (item (atom 42))
          (item (atom \"world\"))
          (item (atom 3.14)))
    ");
}

test "tree: let binding with nested lists" {
    assert_tree(&"(let ((x 1) (y 2)) (+ x y))", &"
        (sexpr
          (item
            (list_ (
              (item (atom let))
              (item
                (list_ (
                  (item (list_ ( (item (atom x)) (item (atom 1)) )))
                  (item (list_ ( (item (atom y)) (item (atom 2)) )))
                )))
              (item
                (list_ (
                  (item (atom +))
                  (item (atom x))
                  (item (atom y))
                )))
            ))))
    ");
}

test "tree: sibling lists" {
    assert_tree(&"((a b) (c d) (e f))", &"
        (sexpr
          (item
            (list_ (
              (item (list_ ( (item (atom a)) (item (atom b)) )))
              (item (list_ ( (item (atom c)) (item (atom d)) )))
              (item (list_ ( (item (atom e)) (item (atom f)) )))
            ))))
    ");
}

test "tree: interleaved atoms and lists" {
    assert_tree(&"a (b c) d (e (f g) h)", &"
        (sexpr
          (item (atom a))
          (item (list_ ( (item (atom b)) (item (atom c)) )))
          (item (atom d))
          (item
            (list_ (
              (item (atom e))
              (item (list_ ( (item (atom f)) (item (atom g)) )))
              (item (atom h))
            ))))
    ");
}

test "tree: nested function application" {
    assert_tree(&"(+ 1 2 (* 3 4))", &"
        (sexpr
          (item
            (list_ (
              (item (atom +))
              (item (atom 1))
              (item (atom 2))
              (item
                (list_ (
                  (item (atom *))
                  (item (atom 3))
                  (item (atom 4))
                )))
            ))))
    ");
}

test "tree: deeply nested lambda" {
    assert_tree(&"(lambda (x y) (+ (* x x) (* y y)))", &"
        (sexpr
          (item
            (list_ (
              (item (atom lambda))
              (item (list_ ( (item (atom x)) (item (atom y)) )))
              (item
                (list_ (
                  (item (atom +))
                  (item (list_ ( (item (atom *)) (item (atom x)) (item (atom x)) )))
                  (item (list_ ( (item (atom *)) (item (atom y)) (item (atom y)) )))
                )))
            ))))
    ");
}

test "tree: cond with nested calls" {
    assert_tree(&"(cond ((gt x 0) (+ x 1)) ((lt x 0) (- x 1)) (else x))", &"
        (sexpr
          (item
            (list_ (
              (item (atom cond))
              (item
                (list_ (
                  (item (list_ ( (item (atom gt)) (item (atom x)) (item (atom 0)) )))
                  (item (list_ ( (item (atom +)) (item (atom x)) (item (atom 1)) )))
                )))
              (item
                (list_ (
                  (item (list_ ( (item (atom lt)) (item (atom x)) (item (atom 0)) )))
                  (item (list_ ( (item (atom -)) (item (atom x)) (item (atom 1)) )))
                )))
              (item
                (list_ (
                  (item (atom else))
                  (item (atom x))
                )))
            ))))
    ");
}
