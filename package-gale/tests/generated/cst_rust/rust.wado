pub interface RustLexerBase {
    fn sof(view: LexerView) -> bool;
    fn float_literal_possible(view: LexerView) -> bool;
    fn float_dot_possible(view: LexerView) -> bool;
    /// Called with the span, type and channel of each token the lexer
    /// commits — not a skipped or `more`d match, and not the EOF
    /// sentinel. Returns the type to emit.
    fn emit(view: LexerView, ty: i32, channel: i32) -> i32 {
        return ty;
    }
}

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }
}

fn try_KW_STATICLIFETIME(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\'' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 's' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 't' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'a' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 't' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'i' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'c' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_UNDERLINELIFETIME(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\'' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '_' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_DOLLARCRATE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '$' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'c' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'r' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'a' { return -1; }
    pos += 1;
