struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_KW_AS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'a' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 's' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_BREAK(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'b' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'r' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'e' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'a' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'k' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_CONST(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'c' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'o' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'n' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 's' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 't' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_CONTINUE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'c' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'o' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'n' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 't' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'i' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'n' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'u' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'e' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_CRATE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'c' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'r' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'a' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 't' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'e' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_ELSE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'e' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'l' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 's' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'e' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_ENUM(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'e' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'n' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'u' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'm' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_EXTERN(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
