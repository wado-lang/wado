sion", "letChainTail", "matchExpression", "matchArms", "matchArmExpression", "matchArm", "matchArmGuard", "pattern", "patternNoTopAlt", "patternWithoutRange", "literalPattern", "identifierPattern", "wildcardPattern", "restPattern", "rangePattern", "rangePatternBound", "referencePattern", "structPattern", "structPatternElements", "structPatternFields", "structPatternField", "structPatternEtCetera", "tupleStructPattern", "tupleStructItems", "tuplePattern", "tuplePatternItems", "groupedPattern", "slicePattern", "slicePatternItems", "pathPattern", "type_", "typeNoBounds", "parenthesizedType", "neverType", "tupleType", "arrayType", "sliceType", "referenceType", "rawPointerType", "bareFunctionType", "functionTypeQualifiers", "bareFunctionReturnType", "functionParametersMaybeNamedVariadic", "maybeNamedFunctionParameters", "maybeNamedParam", "maybeNamedFunctionParametersVariadic", "traitObjectType", "traitObjectTypeOneBound", "implTraitType", "implTraitTypeOneBound", "inferredType", "typeParamBounds", "typeParamBound", "traitBound", "lifetimeBounds", "lifetime", "simplePath", "simplePathSegment", "pathInExpression", "pathExprSegment", "pathIdentSegment", "genericArgs", "genericArg", "genericArgsConst", "genericArgsLifetimes", "genericArgsTypes", "genericArgsBindings", "genericArgsBinding", "qualifiedPathInExpression", "qualifiedPathType", "qualifiedPathInType", "typePath", "typePathSegment", "typePathFn", "typePathInputs", "visibility", "identifier", "keyword", "macroIdentifierLikeToken", "macroLiteralToken", "macroPunctuationToken", "shl", "shr"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

pub enum ExpressionAlt {
    AttributedExpression,
    LiteralExpression_,
    PathExpression_,
    MethodCallExpression,
    FieldExpression,
    TupleIndexingExpression,
    AwaitExpression,
    CallExpression,
    IndexExpression,
    ErrorPropagationExpression,
    RawBorrowExpression,
    BorrowExpression,
    DereferenceExpression,
    NegationExpression,
    TypeCastExpression,
    ArithmeticOrLogicalExpression,
    ComparisonExpression,
    LazyBooleanExpression,
    RangeExpression,
    AssignmentExpression,
    CompoundAssignmentExpression,
    ContinueExpression,
    BreakExpression,
    ReturnExpression,
    GroupedExpression,
    ArrayExpression,
    TupleExpression,
    StructExpression_,
    EnumerationVariantExpression_,
    ClosureExpression_,
    ExpressionWithBlock_,
    MacroInvocationAsExpression,
}

impl CstStore {
    pub fn expression_alt(&self, node: i32) -> Option<ExpressionAlt> {
        return match self.alt(node) {
            0 => Option::Some(ExpressionAlt::AttributedExpression),
            1 => Option::Some(ExpressionAlt::LiteralExpression_),
            2 => Option::Some(ExpressionAlt::PathExpression_),
            3 => Option::Some(ExpressionAlt::MethodCallExpression),
            4 => Option::Some(ExpressionAlt::FieldExpression),
            5 => Option::Some(ExpressionAlt::TupleIndexingExpression),
            6 => Option::Some(ExpressionAlt::AwaitExpression),
            7 => Option::Some(ExpressionAlt::CallExpression),
            8 => Option::Some(ExpressionAlt::IndexExpression),
            9 => Option::Some(ExpressionAlt::ErrorPropagationExpression),
            10 => Option::Some(ExpressionAlt::RawBorrowExpression),
            11 => Option::Some(ExpressionAlt::BorrowExpression),
            12 => Option::Some(ExpressionAlt::DereferenceExpression),
            13 => Option::Some(ExpressionAlt::NegationExpression),
            14 => Option::Some(ExpressionAlt::TypeCastExpression),
            15 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            16 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            17 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            18 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            19 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            20 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            21 => Option::Some(ExpressionAlt::ComparisonExpression),
            22 => Option::Some(ExpressionAlt::LazyBooleanExpression),
            23 => Option::Some(ExpressionAlt::LazyBooleanExpression),
            24 => Option::Some(ExpressionAlt::RangeExpression),
            25 => Option::Some(ExpressionAlt::RangeExpression),
            26 => Option::Some(ExpressionAlt::RangeExpression),
            27 => Option::Some(ExpressionAlt::RangeExpression),
            28 => Option::Some(ExpressionAlt::AssignmentExpression),
            29 => Option::Some(ExpressionAlt::CompoundAssignmentExpression),
            30 => Option::Some(ExpressionAlt::ContinueExpression),
            31 => Option::Some(ExpressionAlt::BreakExpression),
            32 => Option::Some(ExpressionAlt::ReturnExpression),
            33 => Option::Some(ExpressionAlt::GroupedExpression),
            34 => Option::Some(ExpressionAlt::ArrayExpression),
            35 => Option::Some(ExpressionAlt::TupleExpression),
            36 => Option::Some(ExpressionAlt::StructExpression_),
            37 => Option::Some(ExpressionAlt::EnumerationVariantExpression_),
            38 => Option::Some(ExpressionAlt::ClosureExpression_),
            39 => Option::Some(ExpressionAlt::ExpressionWithBlock_),
            40 => Option::Some(ExpressionAlt::MacroInvocationAsExpression),
            _ => null,
        };
    }
}

pub enum RangePatternAlt {
    InclusiveRangePattern,
    HalfOpenRangePattern,
    ObsoleteRangePattern,
}

impl CstStore {
    pub fn range_pattern_alt(&self, node: i32) -> Option<RangePatternAlt> {
        return match self.alt(node) {
            0 => Option::Some(RangePatternAlt::InclusiveRangePattern),
            1 => Option::Some(RangePatternAlt::HalfOpenRangePattern),
            2 => Option::Some(RangePatternAlt::ObsoleteRangePattern),
            _ => null,
        };
    }
}

pub interface RustParserBase {
    fn next_lt(p: &Parser) -> bool;
    fn next_gt(p: &Parser) -> bool;
}

pub struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    line_starts: List<i32>,
    no_struct: i32 = 0,
    scan_gate: ScanGate = ScanGate {},
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], line_starts: line_starts(tokens.chars) };
    }

    pub fn emit(&mut self, s: String) {
        self.tokens.output.push_str(&s);
    }

    pub fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    pub fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    pub fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.chars[j] == '-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.chars[j];
            if c.is_ascii_digit() {
                acc = acc * 10 + (c as i32 - '0' as i32);
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    pub fn token_line(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).0;
    }

    pub fn token_col(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).1;
    }

    pub fn token_start(&self, i: i32) -> i32 {
        return self.tokens.starts[i];
    }

    pub fn la(&self, k: i32) -> i32 {
        return self.peek_at(k - 1);
    }

    pub fn lt(&self, k: i32) -> i32 {
        let idx = self.pos + k - 1;
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    pub fn text_span(&self, start: i32, end: i32) -> String {
        let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };
        return chars_text(self.tokens.chars, start, hi);
    }

    pub fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    pub fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    pub fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.chars.len());
    }

    pub fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    pub fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    pub fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    pub fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.recovering = true;
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
        }
        self.recovering = true;
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            let code = if self.kinds[self.pos] == TK_EOF { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
            self.fail_on_token("got", &([kind] as List<i32>), code);
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::Deleted));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let found = self.kinds[self.pos];
        let at_eof = found == TK_EOF;
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.diagnostics.push(Diagnostic::error(code, `missing ${token_kind_name(kind)}`, self.tokens.span_at(self.pos), [kind], found, recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(kind);
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind);
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(kind);
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        let kind = self.kinds[self.pos];
        if kind == TK_EOF {
            self.b.token(self.pos);
            return self.pos;
        }
        let _i = self.advance();
        self.b.token(_i);
        return _i;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("expected any token; got", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !self.in_set(k, excluded) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("unexpected token", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if self.in_set(k, included) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("got", included, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

struct ArrayElementsVals {
    sv: i32 = 0,
}

struct TupleElementsVals {
    sv: i32 = 0,
}

struct CallParamsVals {
    sv: i32 = 0,
}

fn scan_macro_invocation(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate) -> i32 {
    let mut pos = pos;
    pos = scan_simple_path(tokens, pos, gate, FOLLOW_MASK_1);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_NOT { return -1; }
    pos += 1;
    pos = scan_delim_token_tree(tokens, pos, gate);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_delim_token_tree(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate) -> i32 {
    let start = pos;
    let start_gate = *gate;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LPAREN {
            pos = start + 1;
            try_0: {
                while pos < tokens.len() && _kind_set_1(tokens[pos]) {
                    let sp = pos;
                    let sp_gate = *gate;
                    pos = scan_token_tree(tokens, pos, gate, 0);
                    if pos < 0 {
                        pos = sp;
                        *gate = sp_gate;
                        break;
                    }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos] != TK_RPAREN { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LSQUAREBRACKET {
            pos = start + 1;
            try_1: {
                while pos < tokens.len() && _kind_set_1(tokens[pos]) {
                    let sp = pos;
                    let sp_gate = *gate;
                    pos = scan_token_tree(tokens, pos, gate, 0);
                    if pos < 0 {
                        pos = sp;
                        *gate = sp_gate;
                        break;
                    }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos] != TK_RSQUAREBRACKET { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LCURLYBRACE {
            pos = start + 1;
            try_2: {
                while pos < tokens.len() && _kind_set_1(tokens[pos]) {
                    let sp = pos;
                    let sp_gate = *gate;
                    pos = scan_token_tree(tokens, pos, gate, 0);
                    if pos < 0 {
                        pos = sp;
                        *gate = sp_gate;
                        break;
                    }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos] != TK_RCURLYBRACE { break try_2; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_token_tree(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate, follow: i64 = 0) -> i32 {
    let start = pos;
    let start_gate = *gate;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_2(alt_kind) {
            try_0: {
                pos = scan_token_tree_token(tokens, pos, gate);
                if pos < 0 { break try_0; }
                while pos < tokens.len() && _kind_set_2(tokens[pos]) && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
                    let sp = pos;
                    let sp_gate = *gate;
                    pos = scan_token_tree_token(tokens, pos, gate);
                    if pos < 0 {
                        pos = sp;
                        *gate = sp_gate;
                        break;
                    }
                    if pos == sp { break; }
                }
                break scan_alts;
            }
            return -1;
        } else if _kind_set_3(alt_kind) {
            try_1: {
                pos = scan_delim_token_tree(tokens, pos, gate);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_token_tree_token_alt_0(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate) -> i32 {
    let mut pos = pos;
    pos = scan_macro_identifier_like_token(tokens, pos, gate);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_token_tree_token_alt_1(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || !_kind_set_51(tokens[pos]) { return -1; }
    pos += 1;
    return pos;
}

fn scan_token_tree_token(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate) -> i32 {
    let start = pos;
    let start_gate = *gate;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_52(alt_kind) {
            pos = scan_token_tree_token_alt_0(tokens, start, gate);
            if pos >= 0 { break scan_alts; }
            return -1;
        } else if _kind_set_53(alt_kind) {
            let mut best: i32 = -1;
            let mut best_gate = *gate;
            let try_0_end = scan_token_tree_token_alt_0(tokens, start, gate);
            if try_0_end > best { best = try_0_end; best_gate = *gate; }
            *gate = start_gate;
            let try_1_end = scan_token_tree_token_alt_1(tokens, start, gate);
            if try_1_end > best { best = try_1_end; best_gate = *gate; }
            if best >= 0 {
                pos = best;
                *gate = best_gate;
                break scan_alts;
            }
            return -1;
        } else if _kind_set_54(alt_kind) {
            pos = scan_token_tree_token_alt_1(tokens, start, gate);
            if pos >= 0 { break scan_alts; }
            return -1;
        } else if _kind_set_55(alt_kind) {
            pos = start + 1;
            break scan_alts;
        } else if _kind_set_56(alt_kind) {
            pos = start + 1;
