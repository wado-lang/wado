fn _parse_crate__inner(p: &mut Parser) -> () with RustParserBase {
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            p.scan_gate.no_struct = p.no_struct;
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_inner_attribute(tokens, pos, &mut p.scan_gate, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            let rep_body_end_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
            if !(rep_body_end_kind == TK_POUND) {
                let rep_body_end = pos;
                let rep_body_end_gate = p.scan_gate;
                let mut rep_body_end_ok = false;
                rep_body_end_scan: {
                    while pos < tokens.len() && _kind_set_0(tokens[pos]) {
                        let sp = pos;
                        let sp_gate = p.scan_gate;
                        pos = scan_item(tokens, pos, &mut p.scan_gate);
                        if pos < 0 {
                            pos = sp;
                            p.scan_gate = sp_gate;
                            break;
                        }
                        if pos == sp { break; }
                    }
                    if pos >= tokens.len() || tokens[pos] != TK_EOF { break rep_body_end_scan; }
                    pos += 1;
                    rep_body_end_ok = true;
                }
                pos = rep_body_end;
                p.scan_gate = rep_body_end_gate;
                if !rep_body_end_ok { break rep_scan; }
            }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 {
            if p.peek_kind() == TK_POUND {
                let _rec_pos = p.pos;
                let _rec_cp = p.b.checkpoint();
                let _rec_sav = p.recovering;
                let _rec_spec = p.speculating;
                p.speculating = true;
                _parse_inner_attribute(p, 0);
                p.speculating = _rec_spec;
                p.recovering = _rec_sav;
                p.pos = _rec_pos;
                p.b.truncate(_rec_cp);
            }
            break;
        }
        _parse_inner_attribute(p, 0);
    }
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos_2: i32 = -1;
        rep_scan_2: {
            p.scan_gate.no_struct = p.no_struct;
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_item(tokens, pos, &mut p.scan_gate);
            if pos < 0 { break rep_scan_2; }
            if pos <= p.pos { break rep_scan_2; }
            rep_scan_pos_2 = pos;
        }
        if rep_scan_pos_2 < 0 {
            if _kind_set_0(p.peek_kind()) {
                let _rec_pos = p.pos;
                let _rec_cp = p.b.checkpoint();
                let _rec_sav = p.recovering;
                let _rec_spec = p.speculating;
                p.speculating = true;
                _parse_item(p);
                p.speculating = _rec_spec;
                p.recovering = _rec_sav;
                p.pos = _rec_pos;
                p.b.truncate(_rec_cp);
            }
            break;
        }
        _parse_item(p);
    }
    p.expect(TK_EOF, &EMPTY_SYNC);
    return;
}

fn _parse_crate(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_CRATE, _start);
    _parse_crate__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("crate");
    }
}

