                                        }
                                    },
                                    _ => {},
                                };
                            }
                        },
                        _ => {},
                    };
                }
            },
            _ => {},
        };
    }
    return atn_predict_once(&ATN_SIM, 9, atn, tokens, pos, TK_EOF, min_prec);
}

