fn _parse_macro_identifier_like_token__inner(p: &mut Parser) -> () with RustParserBase {
    if !kind_set_has(&SYNC_170, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_170, &EXPECTED_170); }
    let kind = p.peek_kind();
    if _kind_set_171(kind) {
        if _kind_set_172(kind) {
            p.site = 577;
            p.atn_ret_pending = 3715;
            return _parse_identifier(p);
        } else if kind == TK_KW_UNION {
            let _atn_alt = atn_decide_377(&mut p.atn, &p.kinds, p.pos, 0);
            if _atn_alt == 0 {
                p.site = 576;
