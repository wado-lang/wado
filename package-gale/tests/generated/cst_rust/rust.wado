fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser) with RustParserBase) -> ParseResult with (RustLexerBase, RustParserBase) {
    assert max_errors >= 1;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, &p.tokens.src);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.tokens.output };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult with (RustLexerBase, RustParserBase) {
    return parse_crate(input, max_errors);
}

pub fn parse_crate<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult with (RustLexerBase, RustParserBase) {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_crate(p));
}

