            if end > best_end { best_end = end; best_kind = TK_INTEGER_LITERAL; best_channel = 0; }
            end = try_FLOAT_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_FLOAT_LITERAL; best_channel = 0; }
        } else if 'ᛮ' <= first_char <= 'ᛰ' {
            end = try_NON_KEYWORD_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
            end = try_BLOCK_COMMENT_OR_DOC(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOCK_COMMENT_OR_DOC; best_channel = 1; }
            end = try_INTEGER_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INTEGER_LITERAL; best_channel = 0; }
            end = try_FLOAT_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_FLOAT_LITERAL; best_channel = 0; }
        } else if 'ᢅ' <= first_char <= 'ᢆ' {
            end = try_NON_KEYWORD_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
            end = try_BLOCK_COMMENT_OR_DOC(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOCK_COMMENT_OR_DOC; best_channel = 1; }
            end = try_INTEGER_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INTEGER_LITERAL; best_channel = 0; }
            end = try_FLOAT_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_FLOAT_LITERAL; best_channel = 0; }
        } else if '゛' <= first_char <= '゜' {
            end = try_NON_KEYWORD_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
            end = try_BLOCK_COMMENT_OR_DOC(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOCK_COMMENT_OR_DOC; best_channel = 1; }
            end = try_INTEGER_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INTEGER_LITERAL; best_channel = 0; }
            end = try_FLOAT_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_FLOAT_LITERAL; best_channel = 0; }
        } else if ' ' <= first_char <= ' ' {
            end = try_BLOCK_COMMENT_OR_DOC(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOCK_COMMENT_OR_DOC; best_channel = 1; }
            end = try_WHITESPACE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WHITESPACE; best_channel = 1; }
            end = try_INTEGER_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INTEGER_LITERAL; best_channel = 0; }
            end = try_FLOAT_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_FLOAT_LITERAL; best_channel = 0; }
        } else if '0' <= first_char <= '9' {
            end = try_BLOCK_COMMENT_OR_DOC(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOCK_COMMENT_OR_DOC; best_channel = 1; }
            end = try_INTEGER_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INTEGER_LITERAL; best_channel = 0; }
            end = try_DEC_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DEC_LITERAL; best_channel = 0; }
            end = try_FLOAT_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_FLOAT_LITERAL; best_channel = 0; }
        } else {
            end = try_NON_KEYWORD_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
            end = try_BLOCK_COMMENT_OR_DOC(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOCK_COMMENT_OR_DOC; best_channel = 1; }
            end = try_WHITESPACE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WHITESPACE; best_channel = 1; }
            end = try_INTEGER_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INTEGER_LITERAL; best_channel = 0; }
            end = try_DEC_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DEC_LITERAL; best_channel = 0; }
            end = try_FLOAT_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_FLOAT_LITERAL; best_channel = 0; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = false;
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_KW_AS => "KW_AS",
        TK_KW_BREAK => "KW_BREAK",
        TK_KW_CONST => "KW_CONST",
        TK_KW_CONTINUE => "KW_CONTINUE",
        TK_KW_CRATE => "KW_CRATE",
        TK_KW_ELSE => "KW_ELSE",
        TK_KW_ENUM => "KW_ENUM",
        TK_KW_EXTERN => "KW_EXTERN",
        TK_KW_FALSE => "KW_FALSE",
        TK_KW_FN => "KW_FN",
        TK_KW_FOR => "KW_FOR",
        TK_KW_IF => "KW_IF",
        TK_KW_IMPL => "KW_IMPL",
        TK_KW_IN => "KW_IN",
        TK_KW_LET => "KW_LET",
        TK_KW_LOOP => "KW_LOOP",
        TK_KW_MATCH => "KW_MATCH",
        TK_KW_MOD => "KW_MOD",
        TK_KW_MOVE => "KW_MOVE",
        TK_KW_MUT => "KW_MUT",
        TK_KW_PUB => "KW_PUB",
        TK_KW_REF => "KW_REF",
        TK_KW_RETURN => "KW_RETURN",
        TK_KW_SELFVALUE => "KW_SELFVALUE",
        TK_KW_SELFTYPE => "KW_SELFTYPE",
        TK_KW_STATIC => "KW_STATIC",
        TK_KW_STRUCT => "KW_STRUCT",
        TK_KW_SUPER => "KW_SUPER",
        TK_KW_TRAIT => "KW_TRAIT",
        TK_KW_TRUE => "KW_TRUE",
        TK_KW_TYPE => "KW_TYPE",
        TK_KW_UNSAFE => "KW_UNSAFE",
        TK_KW_USE => "KW_USE",
