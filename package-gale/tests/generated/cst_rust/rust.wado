        TK_KW_DYN => "KW_DYN",
        TK_KW_ABSTRACT => "KW_ABSTRACT",
        TK_KW_BECOME => "KW_BECOME",
        TK_KW_BOX => "KW_BOX",
        TK_KW_DO => "KW_DO",
