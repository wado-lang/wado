    if kind == TK_KW_UNDERLINELIFETIME {
        p.take();
        return;
    }
    if kind == TK_KW_DOLLARCRATE {
        p.take();
        return;
    }
    if kind == TK_LIFETIME_OR_LABEL {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of macroIdentifierLikeToken matches",
        p.peek_span(),
        &EXPECTED_170,
    );
    return;
}

