fn try_RAW_IDENTIFIER(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'r' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '#' { return -1; }
    pos += 1;
    pos = try_NON_KEYWORD_IDENTIFIER(chars, pos);
    if pos < 0 { return -1; }
    return pos;
}

