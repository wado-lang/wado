    _parse_keyword__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("keyword");
    }
}

fn _parse_macro_identifier_like_token__inner_alt_1(p: &mut Parser) -> () with RustParserBase {
    _parse_identifier(p);
    return;
}

fn _parse_macro_identifier_like_token__inner_alt_0(p: &mut Parser) -> () with RustParserBase {
    _parse_keyword(p);
    return;
}

fn _parse_macro_identifier_like_token__inner_alt_2(p: &mut Parser) -> () with RustParserBase {
    p.expect(TK_KW_MACRORULES, &EMPTY_SYNC);
    return;
}

fn _parse_macro_identifier_like_token__inner_scan_2(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_KW_MACRORULES { return -1; }
    pos += 1;
    return pos;
}

fn _parse_macro_identifier_like_token__inner(p: &mut Parser) -> () with RustParserBase {
    let kind = p.peek_kind();
    if _kind_set_112(kind) {
        if kind == TK_KW_MACRORULES {
            let _sd_tokens = &p.kinds;
            let _sd_pos = p.pos;
            p.scan_gate.no_struct = p.no_struct;
            let _sd_p_1 = scan_macro_identifier_like_token_alt_1(_sd_tokens, _sd_pos, &mut p.scan_gate);
            p.scan_gate.no_struct = p.no_struct;
            let _sd_p_2 = _parse_macro_identifier_like_token__inner_scan_2(_sd_tokens, _sd_pos, &mut p.scan_gate);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_p_2 > _sd_best_p {
                _sd_best_p = _sd_p_2;
                _sd_best_i = 2;
            }
            if _sd_best_i == 1 {
                return _parse_macro_identifier_like_token__inner_alt_1(p);
            }
            return _parse_macro_identifier_like_token__inner_alt_2(p);
        } else if _kind_set_100(kind) {
            return _parse_macro_identifier_like_token__inner_alt_1(p);
        } else if kind == TK_KW_UNION {
            let _sd_tokens = &p.kinds;
            let _sd_pos = p.pos;
            p.scan_gate.no_struct = p.no_struct;
            let _sd_p_0 = scan_macro_identifier_like_token_alt_0(_sd_tokens, _sd_pos, &mut p.scan_gate);
            p.scan_gate.no_struct = p.no_struct;
            let _sd_p_1 = scan_macro_identifier_like_token_alt_1(_sd_tokens, _sd_pos, &mut p.scan_gate);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_0 > _sd_best_p {
                _sd_best_p = _sd_p_0;
                _sd_best_i = 0;
            }
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_best_i == 0 {
                return _parse_macro_identifier_like_token__inner_alt_0(p);
            }
            return _parse_macro_identifier_like_token__inner_alt_1(p);
        } else if _kind_set_99(kind) {
            return _parse_macro_identifier_like_token__inner_alt_0(p);
        }
    }
    if kind == TK_KW_UNDERLINELIFETIME {
        p.take();
        return;
    }
    if kind == TK_KW_DOLLARCRATE {
        p.take();
        return;
    }
    if kind == TK_LIFETIME_OR_LABEL {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of macroIdentifierLikeToken matches",
        p.peek_span(),
        &SYNC_113,
    );
    return;
}

fn _parse_macro_identifier_like_token(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_MACRO_IDENTIFIER_LIKE_TOKEN, _start);
    _parse_macro_identifier_like_token__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("macroIdentifierLikeToken");
