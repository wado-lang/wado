pub interface RustLexerBase {
    fn sof(view: LexerView) -> bool;
    fn float_literal_possible(view: LexerView) -> bool;
    fn float_dot_possible(view: LexerView) -> bool;
    /// Called with the span, type and channel of each token the lexer
    /// commits — not a skipped or `more`d match, and not the EOF
    /// sentinel. Returns the type to emit.
    fn emit(view: LexerView, ty: i32, channel: i32) -> i32 {
        return ty;
    }
}

struct Lexer {
    src: StrSlice,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { src: input.as_str_slice(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.src.len();
    }
}

fn try_KW_STATICLIFETIME(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'\'' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b's' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b't' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'a' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b't' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'i' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'c' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_UNDERLINELIFETIME(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'\'' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'_' { return -1; }
    pos += 1;
    return pos;
}

fn try_KW_DOLLARCRATE(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'$' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'c' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'r' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'a' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b't' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'e' { return -1; }
    pos += 1;
    return pos;
}

fn try_NON_KEYWORD_IDENTIFIER(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_0 = pos;
    alts_done_0: {
        alts_0_0: {
            pos = alts_saved_0;
            if pos >= src.len() { break alts_0_0; }
            if !in_char_set_0(char_at(src, pos)) { break alts_0_0; }
            pos = src.ceil_char_boundary(pos + 1);
            loop {
                rep_1: {
                    if pos >= src.len() { break rep_1; }
                    if !in_char_set_1(char_at(src, pos)) { break rep_1; }
                    pos = src.ceil_char_boundary(pos + 1);
                    continue;
                }
                break;
            }
            break alts_done_0;
        }
        alts_0_1: {
            pos = alts_saved_0;
            if pos >= src.len() || unchecked src.byte_at(pos) != b'_' { break alts_0_1; }
            pos += 1;
            if pos >= src.len() { break alts_0_1; }
            if !in_char_set_1(char_at(src, pos)) { break alts_0_1; }
            pos = src.ceil_char_boundary(pos + 1);
            loop {
                rep_2: {
                    if pos >= src.len() { break rep_2; }
                    if !in_char_set_1(char_at(src, pos)) { break rep_2; }
                    pos = src.ceil_char_boundary(pos + 1);
                    continue;
                }
                break;
            }
            break alts_done_0;
        }
        return -1;
    }
    return pos;
}

fn try_RAW_IDENTIFIER(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'r' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'#' { return -1; }
    pos += 1;
    pos = try_NON_KEYWORD_IDENTIFIER(src, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn try_LINE_COMMENT(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_4 = pos;
    let mut alts_best_4 = -1;
    alts_4_0: {
        pos = alts_saved_4;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { break alts_4_0; }
        pos += 1;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { break alts_4_0; }
        pos += 1;
        let alts_saved_5 = pos;
        alts_done_5: {
            alts_5_0: {
                pos = alts_saved_5;
                if pos >= src.len() { break alts_5_0; }
                if (unchecked src.byte_at(pos) matches { b'/' | b'!' | b'\x0d' | b'\x0a' }) { break alts_5_0; }
                pos = src.ceil_char_boundary(pos + 1);
                break alts_done_5;
            }
            alts_5_1: {
                pos = alts_saved_5;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { break alts_5_1; }
                pos += 1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { break alts_5_1; }
                pos += 1;
                break alts_done_5;
            }
            break alts_4_0;
        }
        loop {
            rep_6: {
                if pos >= src.len() { break rep_6; }
                if (unchecked src.byte_at(pos) matches { b'\x0d' | b'\x0a' }) { break rep_6; }
                pos = src.ceil_char_boundary(pos + 1);
                continue;
            }
            break;
        }
        if pos > alts_best_4 { alts_best_4 = pos; }
    }
    alts_4_1: {
        pos = alts_saved_4;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { break alts_4_1; }
        pos += 1;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { break alts_4_1; }
        pos += 1;
        if pos > alts_best_4 { alts_best_4 = pos; }
    }
    if alts_best_4 < 0 { return -1; }
    pos = alts_best_4;
    return pos;
}

fn try_BLOCK_COMMENT(src: &StrSlice, start: i32) -> i32 {
    return latn_match(&LATN_SIM, 0, src, start, false);
}

fn try_INNER_LINE_DOC(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'!' { return -1; }
    pos += 1;
    loop {
        rep_7: {
            if pos >= src.len() { break rep_7; }
            if (unchecked src.byte_at(pos) matches { b'\x0a' | b'\x0d' }) { break rep_7; }
            pos = src.ceil_char_boundary(pos + 1);
            continue;
        }
        break;
    }
    return pos;
}

fn try_INNER_BLOCK_DOC(src: &StrSlice, start: i32) -> i32 {
    return latn_match(&LATN_SIM, 2, src, start, false);
}

fn try_OUTER_LINE_DOC(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    let opt_saved_8 = pos;
    let mut opt_ok_8 = false;
    opt_8: {
        if pos >= src.len() { break opt_8; }
        if (unchecked src.byte_at(pos) matches { b'/' | b'\x0d' | b'\x0a' }) { break opt_8; }
        pos = src.ceil_char_boundary(pos + 1);
        loop {
            rep_9: {
                if pos >= src.len() { break rep_9; }
                if (unchecked src.byte_at(pos) matches { b'\x0a' | b'\x0d' }) { break rep_9; }
                pos = src.ceil_char_boundary(pos + 1);
                continue;
            }
            break;
        }
        opt_ok_8 = true;
    }
    if !opt_ok_8 { pos = opt_saved_8; }
    return pos;
}

fn try_OUTER_BLOCK_DOC(src: &StrSlice, start: i32) -> i32 {
