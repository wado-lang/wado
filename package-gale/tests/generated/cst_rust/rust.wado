                end = try_NON_KEYWORD_IDENTIFIER(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
            },
            '[' => {
                end = try_LSQUAREBRACKET(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_LSQUAREBRACKET; best_channel = 0; }
            },
            ']' => {
                end = try_RSQUAREBRACKET(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_RSQUAREBRACKET; best_channel = 0; }
            },
            '^' => {
                end = try_CARET(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_CARET; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '=' => {
                        end = try_CARETEQ(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_CARETEQ; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '_' => {
                end = try_NON_KEYWORD_IDENTIFIER(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
                end = try_UNDERSCORE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_UNDERSCORE; best_channel = 0; }
            },
            'b' => {
                end = try_NON_KEYWORD_IDENTIFIER(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '"' => {
                        end = try_BYTE_STRING_LITERAL(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_BYTE_STRING_LITERAL; best_channel = 0; }
                    },
                    '\'' => {
                        end = try_BYTE_LITERAL(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_BYTE_LITERAL; best_channel = 0; }
                    },
                    'r' => {
                        end = try_RAW_BYTE_STRING_LITERAL(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_RAW_BYTE_STRING_LITERAL; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            'r' => {
                end = try_NON_KEYWORD_IDENTIFIER(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_NON_KEYWORD_IDENTIFIER; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '"' => {
                        end = try_RAW_STRING_LITERAL(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_RAW_STRING_LITERAL; best_channel = 0; }
                    },
                    '#' => {
                        end = try_RAW_IDENTIFIER(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_RAW_IDENTIFIER; best_channel = 0; }
                        end = try_RAW_STRING_LITERAL(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_RAW_STRING_LITERAL; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '{' => {
                end = try_LCURLYBRACE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_LCURLYBRACE; best_channel = 0; }
            },
            '|' => {
                end = try_OR(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_OR; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '=' => {
                        end = try_OREQ(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_OREQ; best_channel = 0; }
                    },
                    '|' => {
                        end = try_OROR(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_OROR; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '}' => {
                end = try_RCURLYBRACE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_RCURLYBRACE; best_channel = 0; }
            },
            '\u{feff}' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '!' | '#' => {
                        end = try_SHEBANG(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_SHEBANG; best_channel = 1; }
                    },
                    _ => {
                    },
                }
            },
            _ => {},
        }
        if best_end <= start {
            let error_end = lexer.src.ceil_char_boundary(start + 1);
            let _ = ts.push_token_flagged(TK_ERROR, start, error_end, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = error_end;
        } else {
            if best_kind == TK_NON_KEYWORD_IDENTIFIER {
                let kw_kind = classify_keyword(&lexer.src, start, best_end);
                if kw_kind >= 0 { best_kind = kw_kind; best_channel = 0; }
            }
            let tok_start = start;
            best_kind = RustLexerBase::emit(LexerView { src: &lexer.src, start: tok_start, pos: best_end }, best_kind, best_channel);
            if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_KW_AS => "KW_AS",
        TK_KW_BREAK => "KW_BREAK",
        TK_KW_CONST => "KW_CONST",
        TK_KW_CONTINUE => "KW_CONTINUE",
        TK_KW_CRATE => "KW_CRATE",
        TK_KW_ELSE => "KW_ELSE",
        TK_KW_ENUM => "KW_ENUM",
        TK_KW_EXTERN => "KW_EXTERN",
        TK_KW_FALSE => "KW_FALSE",
        TK_KW_FN => "KW_FN",
        TK_KW_FOR => "KW_FOR",
        TK_KW_IF => "KW_IF",
        TK_KW_IMPL => "KW_IMPL",
        TK_KW_IN => "KW_IN",
        TK_KW_LET => "KW_LET",
        TK_KW_LOOP => "KW_LOOP",
        TK_KW_MATCH => "KW_MATCH",
        TK_KW_MOD => "KW_MOD",
        TK_KW_MOVE => "KW_MOVE",
        TK_KW_MUT => "KW_MUT",
        TK_KW_PUB => "KW_PUB",
        TK_KW_REF => "KW_REF",
        TK_KW_RETURN => "KW_RETURN",
        TK_KW_SELFVALUE => "KW_SELFVALUE",
        TK_KW_SELFTYPE => "KW_SELFTYPE",
        TK_KW_STATIC => "KW_STATIC",
        TK_KW_STRUCT => "KW_STRUCT",
        TK_KW_SUPER => "KW_SUPER",
        TK_KW_TRAIT => "KW_TRAIT",
        TK_KW_TRUE => "KW_TRUE",
        TK_KW_TYPE => "KW_TYPE",
        TK_KW_UNSAFE => "KW_UNSAFE",
        TK_KW_USE => "KW_USE",
        TK_KW_WHERE => "KW_WHERE",
        TK_KW_WHILE => "KW_WHILE",
        TK_KW_ASYNC => "KW_ASYNC",
