fn atn_decide_8(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            TK_CHAR_LITERAL | TK_STRING_LITERAL | TK_RAW_STRING_LITERAL | TK_BYTE_LITERAL | TK_BYTE_STRING_LITERAL | TK_RAW_BYTE_STRING_LITERAL | TK_INTEGER_LITERAL | TK_FLOAT_LITERAL => {
                return 1;
            },
            TK_PLUS | TK_STAR | TK_QUESTION => {
                return 3;
            },
            TK_MINUS | TK_SLASH | TK_PERCENT | TK_CARET | TK_NOT | TK_AND | TK_OR | TK_ANDAND | TK_OROR | TK_PLUSEQ | TK_MINUSEQ | TK_STAREQ | TK_SLASHEQ | TK_PERCENTEQ | TK_CARETEQ | TK_ANDEQ | TK_OREQ | TK_SHLEQ | TK_SHREQ | TK_EQ | TK_EQEQ | TK_NE | TK_GT | TK_LT | TK_GE | TK_LE | TK_AT | TK_UNDERSCORE | TK_DOT | TK_DOTDOT | TK_DOTDOTDOT | TK_DOTDOTEQ | TK_COMMA | TK_SEMI | TK_COLON | TK_PATHSEP | TK_RARROW | TK_FATARROW | TK_POUND => {
                return 2;
            },
            TK_DOLLAR => {
                return 4;
            },
            TK_LINE_COMMENT | TK_BLOCK_COMMENT | TK_INNER_LINE_DOC | TK_INNER_BLOCK_DOC | TK_OUTER_LINE_DOC | TK_OUTER_BLOCK_DOC | TK_BLOCK_COMMENT_OR_DOC | TK_SHEBANG | TK_WHITESPACE | TK_NEWLINE | TK_DEC_LITERAL | TK_HEX_LITERAL | TK_OCT_LITERAL | TK_BIN_LITERAL | TK_LCURLYBRACE | TK_RCURLYBRACE | TK_LSQUAREBRACKET | TK_RSQUAREBRACKET | TK_LPAREN | TK_RPAREN | TK_EOF | TK_ERROR => {},
            _ => {
                return 0;
            },
        };
    }
    return atn_predict_once(&ATN_SIM, 8, atn, tokens, pos, TK_EOF, min_prec);
}

fn atn_decide_9(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
