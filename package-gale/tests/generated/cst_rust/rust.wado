}

fn classify_keyword(src: &StrSlice, start: i32, end: i32) -> i32 {
    match end - start {
        2 => {
            match unchecked src.byte_at(start) {
                b'a' => { if unchecked src.byte_at(start + 1) == b's' { return TK_KW_AS; } },
                b'd' => { if unchecked src.byte_at(start + 1) == b'o' { return TK_KW_DO; } },
                b'f' => { if unchecked src.byte_at(start + 1) == b'n' { return TK_KW_FN; } },
                b'i' => {
                    match unchecked src.byte_at(start + 1) {
                        b'f' => { return TK_KW_IF; },
                        b'n' => { return TK_KW_IN; },
                        _ => {},
                    }
                },
                _ => {},
            }
        },
        3 => {
            match unchecked src.byte_at(start) {
                b'b' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'x' { return TK_KW_BOX; } },
                b'd' => { if unchecked src.byte_at(start + 1) == b'y' && unchecked src.byte_at(start + 2) == b'n' { return TK_KW_DYN; } },
                b'f' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'r' { return TK_KW_FOR; } },
                b'l' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b't' { return TK_KW_LET; } },
                b'm' => {
                    match unchecked src.byte_at(start + 1) {
                        b'o' => { if unchecked src.byte_at(start + 2) == b'd' { return TK_KW_MOD; } },
                        b'u' => { if unchecked src.byte_at(start + 2) == b't' { return TK_KW_MUT; } },
                        _ => {},
                    }
                },
                b'p' => { if unchecked src.byte_at(start + 1) == b'u' && unchecked src.byte_at(start + 2) == b'b' { return TK_KW_PUB; } },
                b'r' => {
                    match unchecked src.byte_at(start + 1) {
                        b'a' => { if unchecked src.byte_at(start + 2) == b'w' { return TK_KW_RAW; } },
                        b'e' => { if unchecked src.byte_at(start + 2) == b'f' { return TK_KW_REF; } },
                        _ => {},
                    }
                },
                b't' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'y' { return TK_KW_TRY; } },
                b'u' => { if unchecked src.byte_at(start + 1) == b's' && unchecked src.byte_at(start + 2) == b'e' { return TK_KW_USE; } },
                _ => {},
            }
        },
        4 => {
            match unchecked src.byte_at(start) {
                b'S' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'l' && unchecked src.byte_at(start + 3) == b'f' { return TK_KW_SELFTYPE; } },
                b'e' => {
                    match unchecked src.byte_at(start + 1) {
                        b'l' => { if unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b'e' { return TK_KW_ELSE; } },
                        b'n' => { if unchecked src.byte_at(start + 2) == b'u' && unchecked src.byte_at(start + 3) == b'm' { return TK_KW_ENUM; } },
                        _ => {},
                    }
                },
                b'i' => { if unchecked src.byte_at(start + 1) == b'm' && unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'l' { return TK_KW_IMPL; } },
                b'l' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'o' && unchecked src.byte_at(start + 3) == b'p' { return TK_KW_LOOP; } },
                b'm' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'v' && unchecked src.byte_at(start + 3) == b'e' { return TK_KW_MOVE; } },
                b'p' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b'v' { return TK_KW_PRIV; } },
                b's' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'l' && unchecked src.byte_at(start + 3) == b'f' { return TK_KW_SELFVALUE; } },
                b't' => {
                    match unchecked src.byte_at(start + 1) {
                        b'r' => { if unchecked src.byte_at(start + 2) == b'u' && unchecked src.byte_at(start + 3) == b'e' { return TK_KW_TRUE; } },
                        b'y' => { if unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'e' { return TK_KW_TYPE; } },
                        _ => {},
                    }
                },
                _ => {},
            }
        },
        5 => {
            match unchecked src.byte_at(start) {
                b'a' => {
                    match unchecked src.byte_at(start + 1) {
                        b's' => { if unchecked src.byte_at(start + 2) == b'y' && unchecked src.byte_at(start + 3) == b'n' && unchecked src.byte_at(start + 4) == b'c' { return TK_KW_ASYNC; } },
                        b'w' => { if unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b'i' && unchecked src.byte_at(start + 4) == b't' { return TK_KW_AWAIT; } },
                        _ => {},
                    }
                },
                b'b' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'e' && unchecked src.byte_at(start + 3) == b'a' && unchecked src.byte_at(start + 4) == b'k' { return TK_KW_BREAK; } },
                b'c' => {
                    match unchecked src.byte_at(start + 1) {
                        b'o' => { if unchecked src.byte_at(start + 2) == b'n' && unchecked src.byte_at(start + 3) == b's' && unchecked src.byte_at(start + 4) == b't' { return TK_KW_CONST; } },
                        b'r' => { if unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'e' { return TK_KW_CRATE; } },
                        _ => {},
                    }
                },
                b'f' => {
                    match unchecked src.byte_at(start + 1) {
                        b'a' => { if unchecked src.byte_at(start + 2) == b'l' && unchecked src.byte_at(start + 3) == b's' && unchecked src.byte_at(start + 4) == b'e' { return TK_KW_FALSE; } },
                        b'i' => { if unchecked src.byte_at(start + 2) == b'n' && unchecked src.byte_at(start + 3) == b'a' && unchecked src.byte_at(start + 4) == b'l' { return TK_KW_FINAL; } },
                        _ => {},
                    }
                },
                b'm' => {
                    if unchecked src.byte_at(start + 1) == b'a' {
                        match unchecked src.byte_at(start + 2) {
                            b'c' => { if unchecked src.byte_at(start + 3) == b'r' && unchecked src.byte_at(start + 4) == b'o' { return TK_KW_MACRO; } },
                            b't' => { if unchecked src.byte_at(start + 3) == b'c' && unchecked src.byte_at(start + 4) == b'h' { return TK_KW_MATCH; } },
                            _ => {},
                        }
                    }
                },
                b's' => { if unchecked src.byte_at(start + 1) == b'u' && unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'r' { return TK_KW_SUPER; } },
                b't' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b'i' && unchecked src.byte_at(start + 4) == b't' { return TK_KW_TRAIT; } },
                b'u' => { if unchecked src.byte_at(start + 1) == b'n' && unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b'o' && unchecked src.byte_at(start + 4) == b'n' { return TK_KW_UNION; } },
                b'w' => {
                    if unchecked src.byte_at(start + 1) == b'h' {
                        match unchecked src.byte_at(start + 2) {
                            b'e' => { if unchecked src.byte_at(start + 3) == b'r' && unchecked src.byte_at(start + 4) == b'e' { return TK_KW_WHERE; } },
                            b'i' => { if unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'e' { return TK_KW_WHILE; } },
                            _ => {},
                        }
                    }
                },
                b'y' => { if unchecked src.byte_at(start + 1) == b'i' && unchecked src.byte_at(start + 2) == b'e' && unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'd' { return TK_KW_YIELD; } },
                _ => {},
            }
        },
        6 => {
            match unchecked src.byte_at(start) {
                b'b' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'c' && unchecked src.byte_at(start + 3) == b'o' && unchecked src.byte_at(start + 4) == b'm' && unchecked src.byte_at(start + 5) == b'e' { return TK_KW_BECOME; } },
                b'e' => { if unchecked src.byte_at(start + 1) == b'x' && unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'n' { return TK_KW_EXTERN; } },
                b'r' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'u' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'n' { return TK_KW_RETURN; } },
                b's' => {
                    if unchecked src.byte_at(start + 1) == b't' {
                        match unchecked src.byte_at(start + 2) {
                            b'a' => { if unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'i' && unchecked src.byte_at(start + 5) == b'c' { return TK_KW_STATIC; } },
                            b'r' => { if unchecked src.byte_at(start + 3) == b'u' && unchecked src.byte_at(start + 4) == b'c' && unchecked src.byte_at(start + 5) == b't' { return TK_KW_STRUCT; } },
                            _ => {},
                        }
                    }
                },
                b't' => { if unchecked src.byte_at(start + 1) == b'y' && unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'o' && unchecked src.byte_at(start + 5) == b'f' { return TK_KW_TYPEOF; } },
                b'u' => { if unchecked src.byte_at(start + 1) == b'n' && unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b'a' && unchecked src.byte_at(start + 4) == b'f' && unchecked src.byte_at(start + 5) == b'e' { return TK_KW_UNSAFE; } },
                _ => {},
            }
        },
        7 => {
            match unchecked src.byte_at(start) {
                b'u' => { if unchecked src.byte_at(start + 1) == b'n' && unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b'i' && unchecked src.byte_at(start + 4) == b'z' && unchecked src.byte_at(start + 5) == b'e' && unchecked src.byte_at(start + 6) == b'd' { return TK_KW_UNSIZED; } },
                b'v' => { if unchecked src.byte_at(start + 1) == b'i' && unchecked src.byte_at(start + 2) == b'r' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'u' && unchecked src.byte_at(start + 5) == b'a' && unchecked src.byte_at(start + 6) == b'l' { return TK_KW_VIRTUAL; } },
                _ => {},
            }
        },
        8 => {
            match unchecked src.byte_at(start) {
                b'a' => { if unchecked src.byte_at(start + 1) == b'b' && unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'a' && unchecked src.byte_at(start + 6) == b'c' && unchecked src.byte_at(start + 7) == b't' { return TK_KW_ABSTRACT; } },
                b'c' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'n' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'i' && unchecked src.byte_at(start + 5) == b'n' && unchecked src.byte_at(start + 6) == b'u' && unchecked src.byte_at(start + 7) == b'e' { return TK_KW_CONTINUE; } },
                b'o' => { if unchecked src.byte_at(start + 1) == b'v' && unchecked src.byte_at(start + 2) == b'e' && unchecked src.byte_at(start + 3) == b'r' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'i' && unchecked src.byte_at(start + 6) == b'd' && unchecked src.byte_at(start + 7) == b'e' { return TK_KW_OVERRIDE; } },
                _ => {},
            }
        },
        11 => { if unchecked src.byte_at(start) == b'm' && unchecked src.byte_at(start + 1) == b'a' && unchecked src.byte_at(start + 2) == b'c' && unchecked src.byte_at(start + 3) == b'r' && unchecked src.byte_at(start + 4) == b'o' && unchecked src.byte_at(start + 5) == b'_' && unchecked src.byte_at(start + 6) == b'r' && unchecked src.byte_at(start + 7) == b'u' && unchecked src.byte_at(start + 8) == b'l' && unchecked src.byte_at(start + 9) == b'e' && unchecked src.byte_at(start + 10) == b's' { return TK_KW_MACRORULES; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream with RustLexerBase {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(lexer.src);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = char_at(&lexer.src, start);
        let mut best_channel: i32 = 0;
        match first_char {
            '\n' | '\r' => {
                end = try_NEWLINE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_NEWLINE; best_channel = 1; }
            },
            ' ' | '\u{a0}' | '\u{1680}' | '\u{2000}'..='\u{200a}' | '\u{202f}' | '\u{205f}' | '\u{3000}' => {
                end = try_WHITESPACE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_WHITESPACE; best_channel = 1; }
            },
            '!' => {
                end = try_NOT(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_NOT; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '=' => {
                        end = try_NE(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_NE; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '"' => {
                end = try_STRING_LITERAL(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_STRING_LITERAL; best_channel = 0; }
            },
            '#' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '!' | '#' => {
                        end = try_SHEBANG(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_SHEBANG; best_channel = 1; }
                    },
                    _ => {
                    },
                }
                end = try_POUND(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_POUND; best_channel = 0; }
            },
            '$' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    'c' => {
                        end = try_KW_DOLLARCRATE(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_KW_DOLLARCRATE; best_channel = 0; }
                    },
                    _ => {
                    },
                }
                end = try_DOLLAR(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_DOLLAR; best_channel = 0; }
            },
            '%' => {
                end = try_PERCENT(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_PERCENT; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '=' => {
                        end = try_PERCENTEQ(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_PERCENTEQ; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '&' => {
                end = try_AND(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_AND; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '&' => {
                        end = try_ANDAND(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_ANDAND; best_channel = 0; }
                    },
                    '=' => {
                        end = try_ANDEQ(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_ANDEQ; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '\'' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
