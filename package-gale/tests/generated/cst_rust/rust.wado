global RULE_NAMES: List<String> = ["crate", "macroInvocation", "delimTokenTree", "tokenTree", "tokenTreeToken", "macroInvocationSemi", "macroRulesDefinition", "macroRulesDef", "macroRules", "macroRule", "macroMatcher", "macroMatch", "macroMatchToken", "macroFragSpec", "macroRepSep", "macroRepOp", "macroTranscriber", "item", "visItem", "macroItem", "module", "externCrate", "crateRef", "asClause", "useDeclaration", "useTree", "function_", "functionQualifiers", "abi", "functionParameters", "selfParam", "shorthandSelf", "typedSelf", "functionParam", "functionParamPattern", "functionReturnType", "typeAlias", "struct_", "structStruct", "tupleStruct", "structFields", "structField", "tupleFields", "tupleField", "enumeration", "enumItems", "enumItem", "enumItemTuple", "enumItemStruct", "enumItemDiscriminant", "union_", "constantItem", "staticItem", "trait_", "implementation", "inherentImpl", "traitImpl", "externBlock", "externalItem", "genericParams", "genericParam", "lifetimeParam", "typeParam", "constParam", "whereClause", "whereClauseItem", "lifetimeWhereClauseItem", "typeBoundWhereClauseItem", "forLifetimes", "associatedItem", "innerAttribute", "outerAttribute", "attr", "attrInput", "statement", "letStatement", "expressionStatement", "expression", "comparisonOperator", "compoundAssignOperator", "expressionWithBlock", "literalExpression", "pathExpression", "blockExpression", "statements", "asyncBlockExpression", "unsafeBlockExpression", "arrayElements", "tupleElements", "tupleIndex", "structExpression", "structExprStruct", "structExprFields", "structExprField", "structBase", "structExprTuple", "structExprUnit", "enumerationVariantExpression", "enumExprStruct", "enumExprFields", "enumExprField", "enumExprTuple", "enumExprFieldless", "callParams", "closureExpression", "closureParameters", "closureParam", "loopExpression", "infiniteLoopExpression", "predicateLoopExpression", "predicatePatternLoopExpression", "iteratorLoopExpression", "loopLabel", "ifExpression", "ifLetExpression", "letChainTail", "matchExpression", "matchArms", "matchArmExpression", "matchArm", "matchArmGuard", "pattern", "patternNoTopAlt", "patternWithoutRange", "literalPattern", "identifierPattern", "wildcardPattern", "restPattern", "rangePattern", "rangePatternBound", "referencePattern", "structPattern", "structPatternElements", "structPatternFields", "structPatternField", "structPatternEtCetera", "tupleStructPattern", "tupleStructItems", "tuplePattern", "tuplePatternItems", "groupedPattern", "slicePattern", "slicePatternItems", "pathPattern", "type_", "typeNoBounds", "parenthesizedType", "neverType", "tupleType", "arrayType", "sliceType", "referenceType", "rawPointerType", "bareFunctionType", "functionTypeQualifiers", "bareFunctionReturnType", "functionParametersMaybeNamedVariadic", "maybeNamedFunctionParameters", "maybeNamedParam", "maybeNamedFunctionParametersVariadic", "traitObjectType", "traitObjectTypeOneBound", "implTraitType", "implTraitTypeOneBound", "inferredType", "typeParamBounds", "typeParamBound", "useBound", "useBoundGenericArg", "traitBound", "lifetimeBounds", "lifetime", "simplePath", "simplePathSegment", "pathInExpression", "pathExprSegment", "pathIdentSegment", "genericArgs", "genericArg", "genericArgsConst", "genericArgsLifetimes", "genericArgsTypes", "genericArgsBindings", "genericArgsBinding", "qualifiedPathInExpression", "qualifiedPathType", "qualifiedPathInType", "typePath", "typePathSegment", "typePathFn", "typePathInputs", "visibility", "identifier", "keyword", "macroIdentifierLikeToken", "macroLiteralToken", "macroPunctuationToken", "shl", "shr"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

pub enum ExpressionAlt {
    AttributedExpression,
    LiteralExpression_,
    PathExpression_,
    MethodCallExpression,
    FieldExpression,
    TupleIndexingExpression,
    AwaitExpression,
    CallExpression,
    IndexExpression,
    ErrorPropagationExpression,
    RawBorrowExpression,
    BorrowExpression,
    DereferenceExpression,
    NegationExpression,
    TypeCastExpression,
    ArithmeticOrLogicalExpression,
    ComparisonExpression,
    LazyBooleanExpression,
    RangeExpression,
    AssignmentExpression,
    CompoundAssignmentExpression,
    ContinueExpression,
    BreakExpression,
    ReturnExpression,
    GroupedExpression,
    ArrayExpression,
    TupleExpression,
    StructExpression_,
    EnumerationVariantExpression_,
    ClosureExpression_,
    ExpressionWithBlock_,
    MacroInvocationAsExpression,
}

impl CstStore {
    pub fn expression_alt(&self, node: i32) -> Option<ExpressionAlt> {
        return match self.alt(node) {
            0 => Option::Some(ExpressionAlt::AttributedExpression),
            1 => Option::Some(ExpressionAlt::LiteralExpression_),
            2 => Option::Some(ExpressionAlt::PathExpression_),
            3 => Option::Some(ExpressionAlt::MethodCallExpression),
            4 => Option::Some(ExpressionAlt::FieldExpression),
            5 => Option::Some(ExpressionAlt::TupleIndexingExpression),
            6 => Option::Some(ExpressionAlt::AwaitExpression),
            7 => Option::Some(ExpressionAlt::CallExpression),
            8 => Option::Some(ExpressionAlt::IndexExpression),
            9 => Option::Some(ExpressionAlt::ErrorPropagationExpression),
            10 => Option::Some(ExpressionAlt::RawBorrowExpression),
            11 => Option::Some(ExpressionAlt::BorrowExpression),
            12 => Option::Some(ExpressionAlt::DereferenceExpression),
            13 => Option::Some(ExpressionAlt::NegationExpression),
            14 => Option::Some(ExpressionAlt::TypeCastExpression),
            15 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            16 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            17 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            18 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            19 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            20 => Option::Some(ExpressionAlt::ArithmeticOrLogicalExpression),
            21 => Option::Some(ExpressionAlt::ComparisonExpression),
            22 => Option::Some(ExpressionAlt::LazyBooleanExpression),
            23 => Option::Some(ExpressionAlt::LazyBooleanExpression),
            24 => Option::Some(ExpressionAlt::RangeExpression),
            25 => Option::Some(ExpressionAlt::RangeExpression),
            26 => Option::Some(ExpressionAlt::RangeExpression),
            27 => Option::Some(ExpressionAlt::RangeExpression),
            28 => Option::Some(ExpressionAlt::AssignmentExpression),
            29 => Option::Some(ExpressionAlt::CompoundAssignmentExpression),
            30 => Option::Some(ExpressionAlt::ContinueExpression),
            31 => Option::Some(ExpressionAlt::BreakExpression),
            32 => Option::Some(ExpressionAlt::ReturnExpression),
            33 => Option::Some(ExpressionAlt::GroupedExpression),
            34 => Option::Some(ExpressionAlt::ArrayExpression),
            35 => Option::Some(ExpressionAlt::TupleExpression),
            36 => Option::Some(ExpressionAlt::StructExpression_),
            37 => Option::Some(ExpressionAlt::EnumerationVariantExpression_),
            38 => Option::Some(ExpressionAlt::ClosureExpression_),
            39 => Option::Some(ExpressionAlt::ExpressionWithBlock_),
            40 => Option::Some(ExpressionAlt::MacroInvocationAsExpression),
            _ => null,
        };
    }
}

pub enum RangePatternAlt {
    InclusiveRangePattern,
    HalfOpenRangePattern,
    ObsoleteRangePattern,
}

impl CstStore {
    pub fn range_pattern_alt(&self, node: i32) -> Option<RangePatternAlt> {
        return match self.alt(node) {
            0 => Option::Some(RangePatternAlt::InclusiveRangePattern),
            1 => Option::Some(RangePatternAlt::HalfOpenRangePattern),
            2 => Option::Some(RangePatternAlt::ObsoleteRangePattern),
            _ => null,
        };
    }
}

pub interface RustParserBase {
    fn next_lt(p: &Parser) -> bool;
    fn next_gt(p: &Parser) -> bool;
}

pub struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    site: i32,
    sites: List<i32>,
    failed_expected: List<i32>,
    recovery_pos: i32,
    recovered_failures: List<[NodeKind, List<i32>]>,
    atn: AtnPredictor,
    atn_ret_pending: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    line_starts: List<i32>,
    no_struct: i32 = 0,
    scan_gate: ScanGate = ScanGate {},
    memo: ScanMemo<ScanGate>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(TOKEN_NAMES[*k]);
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, site: -1, sites: [], failed_expected: [], recovery_pos: -1, recovered_failures: [], atn: AtnPredictor::new(), atn_ret_pending: -1, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], line_starts: line_starts(&tokens.src), memo: ScanMemo::new(kinds.len()) };
    }

    pub fn emit(&mut self, s: String) {
        self.tokens.output.push_str(&s);
    }

    pub fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    pub fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    pub fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.src.byte_at(j) == b'-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.src.byte_at(j);
            if c.is_ascii_digit() {
                acc = acc * 10 + (c - b'0') as i32;
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    pub fn token_line(&self, i: i32) -> i32 {
        return line_at(&self.line_starts, self.tokens.starts[i]);
    }

    pub fn token_col(&self, i: i32) -> i32 {
        return line_col_at(&self.tokens.src, &self.line_starts, self.tokens.starts[i]).1;
    }

    pub fn token_start(&self, i: i32) -> i32 {
        return self.tokens.starts[i];
    }

    pub fn lt(&self, k: i32) -> i32 {
        let idx = if k > 0 { self.pos + k - 1 } else { self.pos + k };
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    pub fn la(&self, k: i32) -> i32 {
        return self.kinds[self.lt(k)];
    }

    pub fn text_span(&self, start: i32, end: i32) -> String {
        return span_text(&self.tokens.src, start, end);
    }

    pub fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    pub fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    pub fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.src.len());
    }

    pub fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }

    pub fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }

    pub fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    pub fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.enter_recovery(expected);
    }

    fn enter_recovery(&mut self, expected: &List<i32>) {
        self.recovering = true;
        if !self.speculating { self.failed_expected = *expected; }
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
            return;
        }
        self.enter_recovery(expected);
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.speculating && !self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.recovering = true;
            return;
        }
        self.fail_expecting(&([kind] as List<i32>));
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn recover_rule(&mut self, rule: NodeKind, name: String, row: i32) -> bool {
        if self.speculating || self.diagnostics.len() >= self.max_errors {
            self.push_rule_stack(name);
            return false;
        }
        let node = if row < 0 { self.b.innermost_open() } else { row };
        self.b.resume_node(node, self.last_end());
        assert self.b.node_kind(node) == rule, "recover_rule: the resumed node is the failed rule's";
        if !self.b.in_error_mode() { self.recovered_failures.clear(); }
        self.commit_pending();
        self.recovering = false;
        let failure = [rule, self.failed_expected];
        if self.pos == self.recovery_pos && self.recovered_failures.contains(&failure) && self.kinds[self.pos] != TK_EOF {
            self.skip_one();
        }
        self.recovery_pos = self.pos;
        self.recovered_failures.push(failure);
        self.skip_until(&self.resync_set(&[]));
        return true;
    }

    fn commit_pending(&mut self) {
        let Some(d) = self.pending else { return; };
        self.pending = null;
        let mut diag = d;
        self.b.push_open_rule_names(&RULE_NAMES, &mut diag.rule_stack);
        self.report(diag);
    }

    fn report(&mut self, diag: Diagnostic) {
        if self.b.in_error_mode() { return; }
        self.diagnostics.push(diag);
        self.b.mark_error();
    }

    fn resync_set(&self, base: &List<i32>) -> List<i32> {
        let mut set = *base;
        for let s of &self.sites {
            if *s < 0 { continue; }
            let f = &CALL_FOLLOW_SETS[CALL_FOLLOW[*s]];
            while set.len() < f.len() { set.push(0); }
            for let mut i = 0; i < f.len(); i += 1 { set[i] = set[i] | f[i]; }
        }
        return set;
    }

    fn follows_rules_under_way(&self, k: i32) -> bool {
        for let mut i = self.sites.len() - 1; i >= 0; i -= 1 {
            let s = self.sites[i];
            if s < 0 { return i == 0 && k == TK_EOF; }
            if kind_set_has(&CALL_FOLLOW_SETS[CALL_FOLLOW[s]], k) { return true; }
            if !CALL_FOLLOW_ENDS[s] { return false; }
        }
        return k == TK_EOF;
    }

    fn skip_until(&mut self, set: &List<i32>) {
        loop {
            let k = self.kinds[self.pos];
            if k == TK_EOF || kind_set_has(set, k) { break; }
            self.skip_one();
        }
    }

    fn skip_one(&mut self) {
        let _sk = self.advance();
        self.tokens.mark_skipped(_sk);
        self.b.skip(_sk);
    }

    fn sync_delete(&mut self, sync: &List<i32>, expected: &List<i32>) -> bool {
        if self.speculating || self.kinds[self.pos] == TK_EOF || !kind_set_has(sync, self.peek_at(1)) {
            return false;
        }
        self.report_extraneous(expected, RecoveryAction::Deleted);
        self.skip_one();
        return true;
    }

    fn sync_enter(&mut self, sync: &List<i32>, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.fail_expecting(expected);
        }
    }

    fn sync_alts(&mut self, sync: &List<i32>, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.no_viable("no viable alternative", self.peek_span(), expected);
        }
    }

    fn sync_back(&mut self, sync: &List<i32>, expected: &List<i32>) {
        if self.recovering || self.kinds[self.pos] == TK_EOF { return; }
        if self.speculating {
            self.fail_expecting(expected);
            return;
        }
        self.report_extraneous(expected, RecoveryAction::SkippedTo);
        self.skip_until(&self.resync_set(sync));
    }

    fn fail_expecting(&mut self, expected: &List<i32>) {
        let code = if self.kinds[self.pos] == TK_EOF { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
        self.fail_on_token("got", expected, code);
    }

    fn report_extraneous(&mut self, expected: &List<i32>, recovery: RecoveryAction) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), *expected, self.kinds[self.pos], recovery));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let found = self.kinds[self.pos];
        let at_eof = found == TK_EOF;
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.report(Diagnostic::error(code, `missing ${TOKEN_NAMES[kind]}`, self.tokens.span_at(self.pos), [kind], found, recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>, may_end_rule: bool) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extraneous(&[kind], RecoveryAction::Deleted);
            self.skip_one();
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if kind_set_has(sync, self.kinds[self.pos]) || may_end_rule && self.follows_rules_under_way(self.kinds[self.pos]) {
            self.report_missing(kind);
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            if !may_end_rule && self.kinds[self.pos] == TK_EOF {
                self.fail_on_kind(kind);
                return self.pos;
            }
            self.report_unexpected(kind);
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || kind_set_has(sync, _k) { break; }
                    self.skip_one();
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        let kind = self.kinds[self.pos];
        if kind == TK_EOF {
            self.b.token(self.pos);
            return self.pos;
        }
        let _i = self.advance();
        self.b.token(_i);
        return _i;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("expected any token; got", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !kind_set_has(excluded, k) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("unexpected token", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>, expected: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if kind_set_has(included, k) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("got", expected, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

struct ArrayElementsVals {
    sv: i32 = 0,
}

struct TupleElementsVals {
    sv: i32 = 0,
}

struct CallParamsVals {
    sv: i32 = 0,
}

fn scan_macro_invocation(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate, atn: &mut AtnPredictor, memo: &mut ScanMemo<ScanGate>, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_simple_path(tokens, pos, gate, atn, memo, FOLLOW_MASK_2);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_NOT { return -1; }
    pos += 1;
    atn.stack.push(419);
    pos = scan_delim_token_tree(tokens, pos, gate, atn, memo, follow);
    atn.stack.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_delim_token_tree(tokens: &Array<i32>, pos: i32, gate: &mut ScanGate, atn: &mut AtnPredictor, memo: &mut ScanMemo<ScanGate>, follow: i64 = 0) -> i32 {
    let start = pos;
    let start_gate = *gate;
    let mut pos = pos;
    let kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if kind == TK_LPAREN {
        pos = start + 1;
        try_0: {
            while pos < tokens.len() && _kind_set_1(tokens[pos]) {
                let sp = pos;
