    p.b.finish_node(p.last_end());
    p.atn_stack.pop();
    if p.recovering {
        p.push_rule_stack("identifier");
    }
}

fn _parse_keyword__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _kind_set_109(kind) {
        let _ = p.expect(kind, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "expected keyword",
        p.peek_span(),
        ["TK_KW_AS", "TK_KW_BREAK", "TK_KW_CONST", "TK_KW_CONTINUE", "TK_KW_CRATE", "TK_KW_ELSE", "TK_KW_ENUM", "TK_KW_EXTERN", "TK_KW_FALSE", "TK_KW_FN", "TK_KW_FOR", "TK_KW_IF", "TK_KW_IMPL", "TK_KW_IN", "TK_KW_LET", "TK_KW_LOOP", "TK_KW_MATCH", "TK_KW_MOD", "TK_KW_MOVE", "TK_KW_MUT", "TK_KW_PUB", "TK_KW_REF", "TK_KW_RETURN", "TK_KW_SELFVALUE", "TK_KW_SELFTYPE", "TK_KW_STATIC", "TK_KW_STRUCT", "TK_KW_SUPER", "TK_KW_TRAIT", "TK_KW_TRUE", "TK_KW_TYPE", "TK_KW_UNSAFE", "TK_KW_USE", "TK_KW_WHERE", "TK_KW_WHILE", "TK_KW_ASYNC", "TK_KW_AWAIT", "TK_KW_DYN", "TK_KW_ABSTRACT", "TK_KW_BECOME", "TK_KW_BOX", "TK_KW_DO", "TK_KW_FINAL", "TK_KW_MACRO", "TK_KW_OVERRIDE", "TK_KW_PRIV", "TK_KW_TYPEOF", "TK_KW_UNSIZED", "TK_KW_VIRTUAL", "TK_KW_YIELD", "TK_KW_TRY", "TK_KW_UNION", "TK_KW_STATICLIFETIME"],
    );
    return;
}

fn _parse_keyword(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    let _start = p.peek_start();
    p.b.start_node(RK_KEYWORD, _start);
    _parse_keyword__inner(p, follow);
    p.b.finish_node(p.last_end());
    p.atn_stack.pop();
    if p.recovering {
        p.push_rule_stack("keyword");
    }
}

fn _parse_macro_identifier_like_token__inner_alt_1(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    p.atn_ret_pending = 4337;
    let identifier = _parse_identifier(p, follow);
    return;
}

fn _parse_macro_identifier_like_token__inner_scan_1(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_identifier(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn _parse_macro_identifier_like_token__inner_alt_2(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kw_macrorules = p.expect(TK_KW_MACRORULES, &EMPTY_SYNC);
    return;
}

fn _parse_macro_identifier_like_token__inner_scan_2(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_KW_MACRORULES { return -1; }
    pos += 1;
    return pos;
}

fn _parse_macro_identifier_like_token__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _kind_set_109(kind) {
        p.atn_ret_pending = 4334;
        let keyword = _parse_keyword(p, follow);
        return;
    }
    if _kind_set_4(kind) {
        if p.peek_kind() == TK_KW_MACRORULES {
            let _sd_tokens = &p.kinds;
            let _sd_pos = p.pos;
            let _sd_p_1 = _parse_macro_identifier_like_token__inner_scan_1(_sd_tokens, _sd_pos);
            let _sd_p_2 = _parse_macro_identifier_like_token__inner_scan_2(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_p_2 > _sd_best_p {
                _sd_best_p = _sd_p_2;
                _sd_best_i = 2;
            }
            if _sd_best_i == 1 {
                return _parse_macro_identifier_like_token__inner_alt_1(p, follow);
            }
            if _sd_best_i == 2 {
                return _parse_macro_identifier_like_token__inner_alt_2(p, follow);
            }
            return _parse_macro_identifier_like_token__inner_alt_2(p, follow);
        } else if _kind_set_110(p.peek_kind()) {
            return _parse_macro_identifier_like_token__inner_alt_1(p, follow);
        }
    }
    if kind == TK_KW_UNDERLINELIFETIME {
        let kw_underlinelifetime = p.expect(TK_KW_UNDERLINELIFETIME, &EMPTY_SYNC);
        return;
    }
    if kind == TK_KW_DOLLARCRATE {
        let kw_dollarcrate = p.expect(TK_KW_DOLLARCRATE, &EMPTY_SYNC);
        return;
    }
    if kind == TK_LIFETIME_OR_LABEL {
        let lifetime_or_label = p.expect(TK_LIFETIME_OR_LABEL, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "expected macroIdentifierLikeToken",
        p.peek_span(),
        ["TK_KW_AS", "TK_KW_BREAK", "TK_KW_CONST", "TK_KW_CONTINUE", "TK_KW_CRATE", "TK_KW_ELSE", "TK_KW_ENUM", "TK_KW_EXTERN", "TK_KW_FALSE", "TK_KW_FN", "TK_KW_FOR", "TK_KW_IF", "TK_KW_IMPL", "TK_KW_IN", "TK_KW_LET", "TK_KW_LOOP", "TK_KW_MATCH", "TK_KW_MOD", "TK_KW_MOVE", "TK_KW_MUT", "TK_KW_PUB", "TK_KW_REF", "TK_KW_RETURN", "TK_KW_SELFVALUE", "TK_KW_SELFTYPE", "TK_KW_STATIC", "TK_KW_STRUCT", "TK_KW_SUPER", "TK_KW_TRAIT", "TK_KW_TRUE", "TK_KW_TYPE", "TK_KW_UNSAFE", "TK_KW_USE", "TK_KW_WHERE", "TK_KW_WHILE", "TK_KW_ASYNC", "TK_KW_AWAIT", "TK_KW_DYN", "TK_KW_ABSTRACT", "TK_KW_BECOME", "TK_KW_BOX", "TK_KW_DO", "TK_KW_FINAL", "TK_KW_MACRO", "TK_KW_OVERRIDE", "TK_KW_PRIV", "TK_KW_TYPEOF", "TK_KW_UNSIZED", "TK_KW_VIRTUAL", "TK_KW_YIELD", "TK_KW_TRY", "TK_KW_UNION", "TK_KW_STATICLIFETIME", "TK_NON_KEYWORD_IDENTIFIER", "TK_RAW_IDENTIFIER", "TK_KW_MACRORULES", "TK_KW_UNDERLINELIFETIME", "TK_KW_DOLLARCRATE", "TK_LIFETIME_OR_LABEL"],
    );
    return;
}

fn _parse_macro_identifier_like_token(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
