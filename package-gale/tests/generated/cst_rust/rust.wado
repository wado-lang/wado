fn _parse_macro_literal_token(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_MACROLITERALTOKEN, _start);
    _parse_macro_literal_token__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("macroLiteralToken");
    }
}

fn _parse_macro_punctuation_token__inner(p: &mut Parser) -> () with RustParserBase {
    let kind = p.peek_kind();
    if _kind_set_54(kind) {
        let _ = p.expect(kind, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of macroPunctuationToken matches",
        p.peek_span(),
        &SYNC_114,
    );
    return;
}

fn _parse_macro_punctuation_token(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_MACROPUNCTUATIONTOKEN, _start);
    _parse_macro_punctuation_token__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("macroPunctuationToken");
    }
}

fn _parse_shl__inner(p: &mut Parser) -> () with RustParserBase {
    let lt = p.expect(TK_LT, &SYNC_54);
    if !p.speculating {
        if !(RustParserBase::next_lt(p)) {
            p.no_viable("failed semantic predicate", p.peek_span(), &EMPTY_SYNC);
            return;
        }
    }
    let lt_2 = p.expect(TK_LT, &EMPTY_SYNC);
    return;
}

fn _parse_shl(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_SHL, _start);
    _parse_shl__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("shl");
    }
}

fn _parse_shr__inner(p: &mut Parser) -> () with RustParserBase {
    let gt = p.expect(TK_GT, &SYNC_109);
    if !p.speculating {
        if !(RustParserBase::next_gt(p)) {
            p.no_viable("failed semantic predicate", p.peek_span(), &EMPTY_SYNC);
            return;
        }
    }
    let gt_2 = p.expect(TK_GT, &EMPTY_SYNC);
    return;
}

fn _parse_shr(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_SHR, _start);
    _parse_shr__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("shr");
    }
}

fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser) with RustParserBase) -> ParseResult with (RustLexerBase, RustParserBase) {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.output = p.tokens.output;
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(e) = &p.pending {
            let lc = line_col(p.tokens.chars, e.span.start);
            let mut d = Diagnostic::error(p.pending_code, e.full_message(), e.span, lc.0, lc.1);
            d.rule_stack = e.rule_stack;
            p.diagnostics.push(d);
        }
    }
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.output };
}

pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult with (RustLexerBase, RustParserBase) {
    return parse_crate(input, max_errors);
}

pub fn parse_crate(input: &String, max_errors: i32 = i32::MAX) -> ParseResult with (RustLexerBase, RustParserBase) {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_crate(p));
}

