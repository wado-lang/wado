    p.no_viable(
        "no alternative of identifier matches",
        p.peek_span(),
        &SYNC_12,
    );
    return;
}

fn _parse_identifier(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_IDENTIFIER, _start);
    _parse_identifier__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("identifier");
    }
}

fn _parse_keyword__inner(p: &mut Parser) -> () with RustParserBase {
    let kind = p.peek_kind();
    if _kind_set_98(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of keyword matches",
        p.peek_span(),
        &SYNC_112,
    );
    return;
}

fn _parse_keyword(p: &mut Parser) -> () with RustParserBase {
    if p.recovering { return; }
    let _start = p.peek_start();
