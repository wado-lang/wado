        TK_KW_MACRORULES => "KW_MACRORULES",
        TK_KW_UNDERLINELIFETIME => "KW_UNDERLINELIFETIME",
        TK_KW_DOLLARCRATE => "KW_DOLLARCRATE",
        TK_NON_KEYWORD_IDENTIFIER => "NON_KEYWORD_IDENTIFIER",
        TK_RAW_IDENTIFIER => "RAW_IDENTIFIER",
        TK_LINE_COMMENT => "LINE_COMMENT",
