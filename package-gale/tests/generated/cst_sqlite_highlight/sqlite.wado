                        if pos < tokens.len() && tokens[pos] == TK_K_COLUMN {
                            let sp = pos;
                            pos += 1;
                            if pos < 0 {
                                pos = sp;
                            } else {
                                let mut opt_ok: bool = false;
                                opt_probe: {
                                    pos = scan_column_def(tokens, pos, &mut p.memo, follow);
                                    if pos < 0 { break opt_probe; }
                                    opt_ok = true;
                                }
                                if opt_ok {
                                    cont_done_0 = true;
                                } else {
                                    pos = sp;
                                }
                            }
                        }
                        if !cont_done_0 {
                            pos = scan_column_def(tokens, pos, &mut p.memo, follow);
                            if pos < 0 { break sg_2_1; }
                        }
                        break sg_2_done;
                    }
                }
                pos = gp_2;
            }
            let probe_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
            if _kind_set_2(probe_kind) && (follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) { opt_enter = true; }
        }
    }
    if opt_enter {
        p.site = 34;
        _parse_database_name(p);
        p.expect(TK_DOT, &SYNC_0, false);
    }
