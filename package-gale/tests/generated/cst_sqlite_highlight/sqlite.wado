fn _parse_alter_table_stmt__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.expect(TK_K_ALTER, &SYNC_3, false);
    p.expect(TK_K_TABLE, &SYNC_0, false);
    if !kind_set_has(&SYNC_0, p.kinds[p.pos]) { builtin::cold_path(); p.sync_enter(&SYNC_0, &EXPECTED_0); }
    let mut opt_enter: bool = false;
    if _kind_set_6(p.peek_kind()) {
        opt_enter_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_1_done: {
                sg_1: {
                    pos = scan_any_name(tokens, pos, &mut p.memo);
                    if pos < 0 { break sg_1; }
                    if pos >= tokens.len() || tokens[pos] != TK_DOT { break sg_1; }
                    pos += 1;
                    break sg_1_done;
                }
                break opt_enter_scan;
            }
            pos = scan_any_name(tokens, pos, &mut p.memo);
            if pos < 0 { break opt_enter_scan; }
            let gp_2 = pos;
            sg_2_done: {
                let sgk_2 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                if sgk_2 == TK_K_RENAME {
                    sg_2_0: {
                        pos += 1;
                        if pos >= tokens.len() || tokens[pos] != TK_K_TO { break sg_2_0; }
                        pos += 1;
