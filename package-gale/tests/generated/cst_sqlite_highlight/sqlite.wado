    let overrides: List<HighlightOverride> = [];
    return HighlightMapping { defaults, rule_names, overrides };
}

pub fn highlight(input: &String) -> String {
    let mapping = highlight_mapping();
    let mut visitor = HighlightVisitor::new(mapping);
    let result = parse(input);
    if result.diagnostics.is_empty() {
        highlight_walk(&mut visitor, &result.tokens, &result.root);
    } else {
        for let mut _i = 0; _i < result.tokens.len(); _i += 1 {
            visitor.hl_visit_token(&result.tokens, _i);
        }
    }
    return highlight_html(input, &visitor.captures);
}

use { args, print, eprintln, Stdout, Stderr, Environment } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";

export fn run() with Stdout, Stderr, Environment, Preopens {
    let arguments = args();
    if arguments.len() < 1 {
        eprintln("Usage: <highlighter> <input-file>");
        return;
    }
    let path = arguments[0];
    let dirs = Preopens::get_directories();
    let root = dirs[0].0;
    let file = root.open_at(PathFlags::none(), path, OpenFlags::none(), DescriptorFlags::Read).wait().unwrap();
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let mut bytes: List<u8> = [];
    loop {
        let chunk = read_stream.read(65536);
        if chunk.len() == 0 {
            break;
        }
        for let b of chunk {
            bytes.push(b);
        }
    }
    read_stream.drop();
    let input = String::from_utf8_unchecked(bytes);
    print(highlight(&input));
}

