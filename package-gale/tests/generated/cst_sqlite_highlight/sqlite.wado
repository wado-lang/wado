                    }
                },
                'T' | 't' => { if chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'g') && chars[start + 4].eq_ignore_ascii_case(&'g') && chars[start + 5].eq_ignore_ascii_case(&'e') && chars[start + 6].eq_ignore_ascii_case(&'r') { return TK_K_TRIGGER; } },
                'V' | 'v' => { if chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'u') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'l') { return TK_K_VIRTUAL; } },
                'W' | 'w' => { if chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'h') && chars[start + 4].eq_ignore_ascii_case(&'o') && chars[start + 5].eq_ignore_ascii_case(&'u') && chars[start + 6].eq_ignore_ascii_case(&'t') { return TK_K_WITHOUT; } },
                _ => {},
            }
        },
        8 => {
            match chars[start] {
                'C' | 'c' => { if chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'n') && chars[start + 3].eq_ignore_ascii_case(&'f') && chars[start + 4].eq_ignore_ascii_case(&'l') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_CONFLICT; } },
                'D' | 'd' => {
                    match chars[start + 1] {
                        'A' | 'a' => { if chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'a') && chars[start + 4].eq_ignore_ascii_case(&'b') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'s') && chars[start + 7].eq_ignore_ascii_case(&'e') { return TK_K_DATABASE; } },
                        'E' | 'e' => { if chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'e') && chars[start + 7].eq_ignore_ascii_case(&'d') { return TK_K_DEFERRED; } },
                        'I' | 'i' => { if chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_DISTINCT; } },
                        _ => {},
                    }
                },
                'R' | 'r' => {
                    match chars[start + 1] {
                        'E' | 'e' => { if chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_RESTRICT; } },
                        'O' | 'o' => { if chars[start + 2].eq_ignore_ascii_case(&'l') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'b') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'k') { return TK_K_ROLLBACK; } },
                        _ => {},
                    }
                },
                _ => {},
            }
        },
        9 => {
            match chars[start] {
                'E' | 'e' => { if chars[start + 1].eq_ignore_ascii_case(&'x') && chars[start + 2].eq_ignore_ascii_case(&'c') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'u') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'v') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_EXCLUSIVE; } },
                'I' | 'i' => {
                    match chars[start + 1] {
                        'M' | 'm' => { if chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'d') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'t') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_IMMEDIATE; } },
                        'N' | 'n' => {
                            match chars[start + 2] {
                                'I' | 'i' => { if chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'l') && chars[start + 7].eq_ignore_ascii_case(&'l') && chars[start + 8].eq_ignore_ascii_case(&'y') { return TK_K_INITIALLY; } },
                                'T' | 't' => { if chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'e') && chars[start + 7].eq_ignore_ascii_case(&'c') && chars[start + 8].eq_ignore_ascii_case(&'t') { return TK_K_INTERSECT; } },
                                _ => {},
                            }
                        },
                        _ => {},
                    }
                },
                'R' | 'r' => { if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'c') && chars[start + 3].eq_ignore_ascii_case(&'u') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'v') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_RECURSIVE; } },
                'S' | 's' => { if chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'v') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'p') && chars[start + 5].eq_ignore_ascii_case(&'o') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'n') && chars[start + 8].eq_ignore_ascii_case(&'t') { return TK_K_SAVEPOINT; } },
                'T' | 't' => { if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'p') && chars[start + 4].eq_ignore_ascii_case(&'o') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'r') && chars[start + 8].eq_ignore_ascii_case(&'y') { return TK_K_TEMPORARY; } },
                _ => {},
            }
        },
        10 => {
            match chars[start] {
                'C' | 'c' => { if chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'n') && chars[start + 3].eq_ignore_ascii_case(&'s') && chars[start + 4].eq_ignore_ascii_case(&'t') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'i') && chars[start + 8].eq_ignore_ascii_case(&'n') && chars[start + 9].eq_ignore_ascii_case(&'t') { return TK_K_CONSTRAINT; } },
                'D' | 'd' => { if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'b') && chars[start + 8].eq_ignore_ascii_case(&'l') && chars[start + 9].eq_ignore_ascii_case(&'e') { return TK_K_DEFERRABLE; } },
                'R' | 'r' => { if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'e') && chars[start + 6].eq_ignore_ascii_case(&'n') && chars[start + 7].eq_ignore_ascii_case(&'c') && chars[start + 8].eq_ignore_ascii_case(&'e') && chars[start + 9].eq_ignore_ascii_case(&'s') { return TK_K_REFERENCES; } },
                _ => {},
            }
        },
        11 => { if chars[start].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'a') && chars[start + 3].eq_ignore_ascii_case(&'n') && chars[start + 4].eq_ignore_ascii_case(&'s') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') && chars[start + 8].eq_ignore_ascii_case(&'i') && chars[start + 9].eq_ignore_ascii_case(&'o') && chars[start + 10].eq_ignore_ascii_case(&'n') { return TK_K_TRANSACTION; } },
        12 => {
            if chars[start].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' {
                match chars[start + 8] {
                    'D' | 'd' => { if chars[start + 9].eq_ignore_ascii_case(&'a') && chars[start + 10].eq_ignore_ascii_case(&'t') && chars[start + 11].eq_ignore_ascii_case(&'e') { return TK_K_CURRENT_DATE; } },
                    'T' | 't' => { if chars[start + 9].eq_ignore_ascii_case(&'i') && chars[start + 10].eq_ignore_ascii_case(&'m') && chars[start + 11].eq_ignore_ascii_case(&'e') { return TK_K_CURRENT_TIME; } },
                    _ => {},
                }
            }
        },
        13 => { if chars[start].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'o') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'r') && chars[start + 8].eq_ignore_ascii_case(&'e') && chars[start + 9].eq_ignore_ascii_case(&'m') && chars[start + 10].eq_ignore_ascii_case(&'e') && chars[start + 11].eq_ignore_ascii_case(&'n') && chars[start + 12].eq_ignore_ascii_case(&'t') { return TK_K_AUTOINCREMENT; } },
        17 => { if chars[start].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' && chars[start + 8].eq_ignore_ascii_case(&'t') && chars[start + 9].eq_ignore_ascii_case(&'i') && chars[start + 10].eq_ignore_ascii_case(&'m') && chars[start + 11].eq_ignore_ascii_case(&'e') && chars[start + 12].eq_ignore_ascii_case(&'s') && chars[start + 13].eq_ignore_ascii_case(&'t') && chars[start + 14].eq_ignore_ascii_case(&'a') && chars[start + 15].eq_ignore_ascii_case(&'m') && chars[start + 16].eq_ignore_ascii_case(&'p') { return TK_K_CURRENT_TIMESTAMP; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        let mut best_channel: i32 = 0;
        match first_char {
            '\t' | '\n' | '\u{b}' | '\r' | ' ' => {
                end = try_SPACES(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_SPACES; best_channel = 1; }
            },
            '!' => {
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '=' => {
                        end = try_NOT_EQ1(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_NOT_EQ1; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '"' | 'A'..='W' | 'Y'..='Z' | '[' | '_' | '`' | 'a'..='w' | 'y'..='z' => {
                end = try_IDENTIFIER(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
            },
            '$' | ':' | '?' | '@' => {
                end = try_BIND_PARAMETER(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_BIND_PARAMETER; best_channel = 0; }
            },
            '%' => {
                end = try_MOD(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_MOD; best_channel = 0; }
            },
            '&' => {
                end = try_AMP(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_AMP; best_channel = 0; }
            },
            '\'' => {
                end = try_STRING_LITERAL(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_STRING_LITERAL; best_channel = 0; }
            },
            '(' => {
                end = try_OPEN_PAR(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_OPEN_PAR; best_channel = 0; }
            },
            ')' => {
                end = try_CLOSE_PAR(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_CLOSE_PAR; best_channel = 0; }
            },
            '*' => {
                end = try_STAR(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_STAR; best_channel = 0; }
            },
            '+' => {
                end = try_PLUS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_PLUS; best_channel = 0; }
            },
            ',' => {
                end = try_COMMA(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_COMMA; best_channel = 0; }
            },
            '-' => {
                end = try_MINUS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_MINUS; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '-' => {
                        end = try_SINGLE_LINE_COMMENT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_SINGLE_LINE_COMMENT; best_channel = 1; }
                    },
                    _ => {
                    },
                }
            },
            '.' => {
                end = try_DOT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_DOT; best_channel = 0; }
                end = try_NUMERIC_LITERAL(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
            },
            '/' => {
                end = try_DIV(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_DIV; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '*' => {
                        end = try_MULTILINE_COMMENT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_MULTILINE_COMMENT; best_channel = 1; }
                    },
                    _ => {
                    },
                }
            },
            '0'..='9' => {
                end = try_NUMERIC_LITERAL(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
            },
            ';' => {
                end = try_SCOL(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_SCOL; best_channel = 0; }
            },
            '<' => {
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '<' => {
                        end = try_LT2(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_LT2; best_channel = 0; }
                        end = try_LT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_LT; best_channel = 0; }
                    },
                    '=' => {
                        end = try_LT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_LT; best_channel = 0; }
                        end = try_LT_EQ(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_LT_EQ; best_channel = 0; }
                    },
                    '>' => {
                        end = try_LT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_LT; best_channel = 0; }
                        end = try_NOT_EQ2(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_NOT_EQ2; best_channel = 0; }
                    },
                    _ => {
                        end = try_LT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_LT; best_channel = 0; }
                    },
                }
            },
            '=' => {
                end = try_ASSIGN(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_ASSIGN; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '=' => {
                        end = try_EQ(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_EQ; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '>' => {
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '=' => {
                        end = try_GT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_GT; best_channel = 0; }
                        end = try_GT_EQ(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_GT_EQ; best_channel = 0; }
                    },
                    '>' => {
                        end = try_GT2(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_GT2; best_channel = 0; }
                        end = try_GT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_GT; best_channel = 0; }
                    },
                    _ => {
                        end = try_GT(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_GT; best_channel = 0; }
                    },
                }
            },
            'X' | 'x' => {
                end = try_IDENTIFIER(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\'' => {
                        end = try_BLOB_LITERAL(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_BLOB_LITERAL; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '|' => {
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '|' => {
                        end = try_PIPE2(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_PIPE2; best_channel = 0; }
                    },
                    _ => {
                    },
                }
                end = try_PIPE(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_PIPE; best_channel = 0; }
            },
            '~' => {
                end = try_TILDE(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_TILDE; best_channel = 0; }
            },
            _ => {},
        }
        if best_end <= start {
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        }
        if best_end <= start {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            if best_kind == TK_IDENTIFIER {
                let kw_kind = classify_keyword(&lexer.chars, start, best_end);
                if kw_kind >= 0 { best_kind = kw_kind; best_channel = 0; }
            }
            let tok_start = start;
            if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_SCOL => "SCOL",
        TK_DOT => "DOT",
        TK_OPEN_PAR => "OPEN_PAR",
        TK_CLOSE_PAR => "CLOSE_PAR",
        TK_COMMA => "COMMA",
        TK_ASSIGN => "ASSIGN",
        TK_STAR => "STAR",
        TK_PLUS => "PLUS",
        TK_MINUS => "MINUS",
        TK_TILDE => "TILDE",
        TK_PIPE2 => "PIPE2",
        TK_DIV => "DIV",
        TK_MOD => "MOD",
        TK_LT2 => "LT2",
        TK_GT2 => "GT2",
        TK_AMP => "AMP",
        TK_PIPE => "PIPE",
        TK_LT => "LT",
        TK_LT_EQ => "LT_EQ",
        TK_GT => "GT",
        TK_GT_EQ => "GT_EQ",
        TK_EQ => "EQ",
        TK_NOT_EQ1 => "NOT_EQ1",
        TK_NOT_EQ2 => "NOT_EQ2",
        TK_K_ABORT => "K_ABORT",
        TK_K_ACTION => "K_ACTION",
        TK_K_ADD => "K_ADD",
        TK_K_AFTER => "K_AFTER",
        TK_K_ALL => "K_ALL",
        TK_K_ALTER => "K_ALTER",
        TK_K_ANALYZE => "K_ANALYZE",
