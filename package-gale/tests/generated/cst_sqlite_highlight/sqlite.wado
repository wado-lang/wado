        TK_K_FOREIGN => "K_FOREIGN",
        TK_K_FROM => "K_FROM",
        TK_K_FULL => "K_FULL",
        TK_K_GLOB => "K_GLOB",
        TK_K_GROUP => "K_GROUP",
        TK_K_HAVING => "K_HAVING",
        TK_K_IF => "K_IF",
        TK_K_IGNORE => "K_IGNORE",
        TK_K_IMMEDIATE => "K_IMMEDIATE",
        TK_K_IN => "K_IN",
        TK_K_INDEX => "K_INDEX",
        TK_K_INDEXED => "K_INDEXED",
        TK_K_INITIALLY => "K_INITIALLY",
        TK_K_INNER => "K_INNER",
        TK_K_INSERT => "K_INSERT",
        TK_K_INSTEAD => "K_INSTEAD",
