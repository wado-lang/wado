}

fn try_SINGLE_LINE_COMMENT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '-' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '-' { return -1; }
    pos += 1;
    loop {
        let rep_saved_28 = pos;
        rep_28: {
            if pos >= chars.len() { break rep_28; }
            if chars[pos] == '\r' || chars[pos] == '\n' { break rep_28; }
            pos += 1;
            continue;
        }
        pos = rep_saved_28;
        break;
    }
    return pos;
}

fn try_MULTILINE_COMMENT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '*' { return -1; }
    pos += 1;
    loop {
        let ng_saved_29 = pos;
        let mut ng_exit_29 = false;
        ng_29: {
            let alts_saved_30 = pos;
            let mut alts_ok_30 = false;
            alts_30_0: {
                pos = alts_saved_30;
                if pos >= chars.len() || chars[pos] != '*' { break alts_30_0; }
                pos += 1;
                if pos >= chars.len() || chars[pos] != '/' { break alts_30_0; }
                pos += 1;
                alts_ok_30 = true;
            }
            if !alts_ok_30 {
                alts_30_1: {
                    pos = alts_saved_30;
                    if pos < chars.len() { break alts_30_1; }
                    alts_ok_30 = true;
                }
            }
            if !alts_ok_30 { break ng_29; }
            ng_exit_29 = true;
        }
        if ng_exit_29 {
            break;
        }
        pos = ng_saved_29;
        if pos >= chars.len() { return -1; }
        pos += 1;
    }
    return pos;
}

fn try_SPACES(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] == ' ' || chars[pos] == '\u{b}' || chars[pos] == '\t' || chars[pos] == '\r' || chars[pos] == '\n') { return -1; }
    pos += 1;
    return pos;
}

