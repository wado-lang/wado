pub fn capture_vocabulary() -> List<String> {
    return HIGHLIGHT_MAPPING.capture_names;
}

pub fn highlight_result<S: AsStrSlice>(result: &ParseResult, input: S) -> String {
    let mut visitor = HighlightVisitor::new(&HIGHLIGHT_MAPPING);
    highlight_walk(&mut visitor, &result.tokens, &result.cst);
    visitor.hl_cover_unvisited(&result.tokens);
    return highlight_html(input, &visitor.captures, &HIGHLIGHT_MAPPING.capture_classes);
}

pub fn highlight<S: AsStrSlice>(input: S) -> String {
    let result = parse(input);
    return highlight_result(&result, input);
}

