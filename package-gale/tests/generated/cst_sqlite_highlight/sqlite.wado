fn classify_keyword(chars: &List<char>, start: i32, end: i32) -> i32 {
    match end - start {
        2 => {
            match chars[start] {
                'A' | 'a' => { if chars[start + 1].eq_ignore_ascii_case(&'s') { return TK_K_AS; } },
                'B' | 'b' => { if chars[start + 1].eq_ignore_ascii_case(&'y') { return TK_K_BY; } },
                'I' | 'i' => {
                    match chars[start + 1] {
                        'F' | 'f' => { return TK_K_IF; },
                        'N' | 'n' => { return TK_K_IN; },
                        'S' | 's' => { return TK_K_IS; },
                        _ => {},
                    }
                },
                'N' | 'n' => { if chars[start + 1].eq_ignore_ascii_case(&'o') { return TK_K_NO; } },
                'O' | 'o' => {
                    match chars[start + 1] {
                        'F' | 'f' => { return TK_K_OF; },
                        'N' | 'n' => { return TK_K_ON; },
                        'R' | 'r' => { return TK_K_OR; },
                        _ => {},
                    }
                },
                'T' | 't' => { if chars[start + 1].eq_ignore_ascii_case(&'o') { return TK_K_TO; } },
                _ => {},
            }
        },
        3 => {
            match chars[start] {
                'A' | 'a' => {
                    match chars[start + 1] {
                        'D' | 'd' => { if chars[start + 2].eq_ignore_ascii_case(&'d') { return TK_K_ADD; } },
                        'L' | 'l' => { if chars[start + 2].eq_ignore_ascii_case(&'l') { return TK_K_ALL; } },
                        'N' | 'n' => { if chars[start + 2].eq_ignore_ascii_case(&'d') { return TK_K_AND; } },
                        'S' | 's' => { if chars[start + 2].eq_ignore_ascii_case(&'c') { return TK_K_ASC; } },
                        _ => {},
                    }
                },
                'E' | 'e' => { if chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'d') { return TK_K_END; } },
                'F' | 'f' => { if chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'r') { return TK_K_FOR; } },
                'K' | 'k' => { if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'y') { return TK_K_KEY; } },
                'N' | 'n' => { if chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'t') { return TK_K_NOT; } },
                'R' | 'r' => { if chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'w') { return TK_K_ROW; } },
                'S' | 's' => { if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'t') { return TK_K_SET; } },
                _ => {},
            }
        },
        4 => {
            match chars[start] {
                'C' | 'c' => {
