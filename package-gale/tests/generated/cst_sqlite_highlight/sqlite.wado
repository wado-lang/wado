struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, b: TreeBuilder::new(), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
        }
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32) -> Result<i32, ParseError> {
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return Result::Ok(self.pos);
            }
            let _i = self.advance();
            self.b.token(_i);
            return Result::Ok(_i);
        }
        let name = token_kind_name(kind);
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<i32, ParseError> {
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<i32, ParseError> {
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return Result::Ok(_i);
        }
        return Result::Err(self.error(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                let _i = self.advance();
                self.b.token(_i);
                return Result::Ok(_i);
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    self.b.token(self.pos);
                    return Result::Ok(self.pos);
                }
                let _i = self.advance();
                self.b.token(_i);
                return Result::Ok(_i);
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["token set"],
        ));
    }
}

fn scan_parse(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && _gale_kind_set_1(tokens[pos]) {
        let sp = pos;
        let gp_0 = pos;
        sg_0: {
            pos = gp_0;
            sg_0_0: {
                pos = scan_sql_stmt_list(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break sg_0_0; }
                break sg_0;
            }
            pos = gp_0;
            sg_0_1: {
                pos = scan_error(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break sg_0_1; }
                break sg_0;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_error(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_UNEXPECTED_CHAR { return -1; }
    pos += 1;
    return pos;
}

fn scan_sql_stmt_list(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && tokens[pos] == TK_LIT_SEMI {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos] != TK_LIT_SEMI { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    pos = scan_sql_stmt(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_LIT_SEMI && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_1_done: {
            sg_1: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_SEMI { break sg_1; }
                pos += 1;
                while pos < tokens.len() && tokens[pos] == TK_LIT_SEMI {
                    let sp = pos;
                    if pos >= tokens.len() || tokens[pos] != TK_LIT_SEMI { pos = -1; } else { pos += 1; }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                pos = scan_sql_stmt(tokens, pos, follow, 0);
                if pos < 0 { break sg_1; }
                break sg_1_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    while pos < tokens.len() && tokens[pos] == TK_LIT_SEMI && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos] != TK_LIT_SEMI { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

