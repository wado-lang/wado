        TK_K_EXCEPT => "K_EXCEPT",
        TK_K_EXCLUSIVE => "K_EXCLUSIVE",
        TK_K_EXISTS => "K_EXISTS",
        TK_K_EXPLAIN => "K_EXPLAIN",
        TK_K_FAIL => "K_FAIL",
