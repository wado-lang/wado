fn parse_expr_lr_10(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
        let k_not = p.expect(TK_K_NOT)?;
        Option::<Token>::Some(k_not)
    } else {
        null
    };
    let k_in = p.expect(TK_K_IN)?;
    let mut group_0_inner: Option<ExprGroup0> = null;
    let grp_kind = p.peek_kind();
    if _gale_kind_set_2(grp_kind) {
        let mut gd_winner: i32 = -1;
        gd_dispatch: {
            gd_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { break gd_scan; }
                pos += 1;
                if pos < tokens.len() && _gale_kind_set_6(tokens[pos].kind) {
                    let sp = pos;
                    let gp_312 = pos;
                    let mut sg_312_best = -1;
                    sg_312: {
                        pos = gp_312;
                        sg_312_0: {
                            pos = scan_select_stmt(tokens, pos);
                            if pos < 0 { break sg_312_0; }
                            if pos > sg_312_best { sg_312_best = pos; }
                        }
                        pos = gp_312;
                        sg_312_1: {
                            pos = scan_expr(tokens, pos);
                            if pos < 0 { break sg_312_1; }
                            while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
                                let sp = pos;
                                sg_313_done: {
                                    sg_313: {
                                        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_313; }
                                        pos += 1;
                                        pos = scan_expr(tokens, pos);
                                        if pos < 0 { break sg_313; }
                                        break sg_313_done;
                                    }
                                    pos = -1;
                                }
                                if pos < 0 { pos = sp; break; }
                                if pos == sp { break; }
                            }
                            if pos > sg_312_best { sg_312_best = pos; }
                        }
                        if sg_312_best >= 0 { pos = sg_312_best; break sg_312; }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; }
                }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RPAREN { break gd_scan; }
                pos += 1;
                gd_winner = 0;
                break gd_dispatch;
            }
        }
        if gd_winner == 0 {
            let lparen = p.expect(TK_LIT_LPAREN)?;
            let mut opt_scan_pos: i32 = -1;
            opt_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                let gp_314 = pos;
                let mut sg_314_best = -1;
                sg_314: {
                    pos = gp_314;
                    sg_314_0: {
                        pos = scan_select_stmt(tokens, pos);
                        if pos < 0 { break sg_314_0; }
                        if pos > sg_314_best { sg_314_best = pos; }
                    }
                    pos = gp_314;
                    sg_314_1: {
                        pos = scan_expr(tokens, pos);
                        if pos < 0 { break sg_314_1; }
                        while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
                            let sp = pos;
                            sg_315_done: {
                                sg_315: {
                                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_315; }
                                    pos += 1;
                                    pos = scan_expr(tokens, pos);
                                    if pos < 0 { break sg_315; }
                                    break sg_315_done;
                                }
                                pos = -1;
                            }
                            if pos < 0 { pos = sp; break; }
                            if pos == sp { break; }
                        }
                        if pos > sg_314_best { sg_314_best = pos; }
                    }
                    if sg_314_best >= 0 { pos = sg_314_best; break sg_314; }
                    break opt_scan;
                }
                opt_scan_pos = pos;
            }
            let group_1: Option<ExprGroup1> = if opt_scan_pos >= 0 {
                let mut group_1_opt: Option<ExprGroup1> = null;
                let grp_kind = p.peek_kind();
                if _gale_kind_set_6(grp_kind) {
                    let mut gd_winner: i32 = -1;
                    gd_dispatch: {
                        gd_scan: {
                            let tokens = &p.tokens;
                            let mut pos: i32 = p.pos;
                            pos = scan_select_stmt(tokens, pos);
                            if pos < 0 { break gd_scan; }
                            gd_winner = 0;
                            break gd_dispatch;
                        }
                    }
                    if gd_winner == 0 {
                        let select_stmt = parse_select_stmt(p)?;
                        group_1_opt = Option::<ExprGroup1>::Some(ExprGroup1::Alt0(ExprGroup1Alt0 {
                            select_stmt,
                        }));
                    } else {
                        let expr = parse_expr(p)?;
                        let mut comma_expr_list: Array<CommaExprItem> = [];
                        loop {
                            let mut rep_scan_pos: i32 = -1;
                            rep_scan: {
                                let tokens = &p.tokens;
                                let mut pos: i32 = p.pos;
                                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                                pos += 1;
                                pos = scan_expr(tokens, pos);
                                if pos < 0 { break rep_scan; }
                                if pos <= p.pos { break rep_scan; }
                                rep_scan_pos = pos;
                            }
                            if rep_scan_pos < 0 { break; }
                            let comma = p.expect(TK_LIT_COMMA)?;
                            let expr = parse_expr(p)?;
                            let comma_expr = CommaExprItem {
                                comma,
                                expr,
                            };
                            comma_expr_list.push(comma_expr);
                        }
                        group_1_opt = Option::<ExprGroup1>::Some(ExprGroup1::Alt1(ExprGroup1Alt1 {
                            expr,
                            comma_expr_list,
                        }));
                    }
                }
                if let None = group_1_opt {
                    p.fail("group alternative")?;
                }
                let group_1 = group_1_opt.unwrap();
                Option::<ExprGroup1>::Some(group_1)
            } else {
                null
            };
            let rparen = p.expect(TK_LIT_RPAREN)?;
            group_0_inner = Option::<ExprGroup0>::Some(ExprGroup0::Alt0(ExprGroup0Alt0 {
                lparen,
                group_1,
                rparen,
            }));
        } else {
            let mut opt_scan_pos: i32 = -1;
            opt_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                pos = scan_database_name(tokens, pos);
                if pos < 0 { break opt_scan; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break opt_scan; }
                pos += 1;
                opt_scan_pos = pos;
            }
            let database_name_dot: Option<DatabaseNameDotItem> = if opt_scan_pos >= 0 {
                let database_name = parse_database_name(p)?;
                let dot = p.expect(TK_LIT_DOT)?;
                let database_name_dot = DatabaseNameDotItem {
                    database_name,
                    dot,
                };
                Option::<DatabaseNameDotItem>::Some(database_name_dot)
            } else {
                null
            };
            let table_name = parse_table_name(p)?;
            group_0_inner = Option::<ExprGroup0>::Some(ExprGroup0::Alt1(ExprGroup0Alt1 {
                database_name_dot,
                table_name,
            }));
        }
    }
    let group_0 = group_0_inner;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt10(ExprAlt10 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_not,
        k_in,
        group_0,
    }));
}

