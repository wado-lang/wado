fn parse_raise_function(p: &mut Parser) -> Result<RaiseFunctionNode, ParseError> {
    let start = p.peek().span.start;
    let k_raise = p.expect(TK_K_RAISE)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let mut group_0_inner: Option<RaiseFunctionGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_IGNORE {
        let k_ignore = p.expect(TK_K_IGNORE)?;
        group_0_inner = Option::<RaiseFunctionGroup0>::Some(RaiseFunctionGroup0::Alt0(RaiseFunctionGroup0Alt0 {
            k_ignore,
        }));
    } else if _gale_kind_set_67(grp_kind) {
        let k_rollback_or_k_abort_or_k_fail = p.advance();
        let comma = p.expect(TK_LIT_COMMA)?;
        let error_message = parse_error_message(p)?;
        group_0_inner = Option::<RaiseFunctionGroup0>::Some(RaiseFunctionGroup0::Alt1(RaiseFunctionGroup0Alt1 {
            k_rollback_or_k_abort_or_k_fail,
            comma,
            error_message,
        }));
    }
    let group_0 = group_0_inner;
    let rparen = p.expect(TK_LIT_RPAREN)?;
    return Result::<RaiseFunctionNode, ParseError>::Ok(RaiseFunctionNode {
        span: Span::new(start, p.last_end()),
        k_raise,
        lparen,
        group_0,
        rparen,
    });
}

fn parse_indexed_column(p: &mut Parser) -> Result<IndexedColumnNode, ParseError> {
    let start = p.peek().span.start;
    let column_name = parse_column_name(p)?;
    let k_collate_collation_name: Option<KCollateCollationNameItem> = if p.peek_kind() == TK_K_COLLATE {
        let k_collate = p.expect(TK_K_COLLATE)?;
        let collation_name = parse_collation_name(p)?;
        let k_collate_collation_name = KCollateCollationNameItem {
            k_collate,
            collation_name,
        };
        Option::<KCollateCollationNameItem>::Some(k_collate_collation_name)
    } else {
        null
    };
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        let gp_321 = pos;
        sg_321: {
            pos = gp_321;
            sg_321_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_ASC { break sg_321_0; }
                pos += 1;
                break sg_321;
            }
            pos = gp_321;
            sg_321_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_DESC { break sg_321_1; }
                pos += 1;
                break sg_321;
            }
            break opt_scan;
        }
        opt_scan_pos = pos;
    }
    let k_asc_or_k_desc: Option<Token> = if opt_scan_pos >= 0 {
        let k_asc_or_k_desc = p.advance();
        Option::<Token>::Some(k_asc_or_k_desc)
    } else {
        null
    };
    return Result::<IndexedColumnNode, ParseError>::Ok(IndexedColumnNode {
        span: Span::new(start, p.last_end()),
        column_name,
        k_collate_collation_name,
        k_asc_or_k_desc,
    });
}

fn parse_table_constraint(p: &mut Parser) -> Result<TableConstraintNode, ParseError> {
    let start = p.peek().span.start;
    let k_constraint_name: Option<KConstraintNameItem> = if p.peek_kind() == TK_K_CONSTRAINT {
        let k_constraint = p.expect(TK_K_CONSTRAINT)?;
        let name = parse_name(p)?;
        let k_constraint_name = KConstraintNameItem {
            k_constraint,
            name,
        };
        Option::<KConstraintNameItem>::Some(k_constraint_name)
    } else {
        null
    };
    let mut group_0_inner: Option<TableConstraintGroup0> = null;
    let grp_kind = p.peek_kind();
    if _gale_kind_set_43(grp_kind) {
        let mut group_1_inner: Option<TableConstraintGroup1> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_K_PRIMARY {
            let k_primary = p.expect(TK_K_PRIMARY)?;
            let k_key = p.expect(TK_K_KEY)?;
            group_1_inner = Option::<TableConstraintGroup1>::Some(TableConstraintGroup1::Alt0(TableConstraintGroup1Alt0 {
                k_primary,
                k_key,
            }));
        } else if grp_kind == TK_K_UNIQUE {
            let k_unique = p.expect(TK_K_UNIQUE)?;
            group_1_inner = Option::<TableConstraintGroup1>::Some(TableConstraintGroup1::Alt1(TableConstraintGroup1Alt1 {
                k_unique,
            }));
        }
        let group_1 = group_1_inner;
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let indexed_column = parse_indexed_column(p)?;
        let mut comma_indexed_column_list: Array<CommaIndexedColumnItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                pos += 1;
                pos = scan_indexed_column(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let comma = p.expect(TK_LIT_COMMA)?;
            let indexed_column = parse_indexed_column(p)?;
