            let group_1 = group_1_inner;
            group_0_inner = Option::<ForeignKeyClauseGroup0>::Some(ForeignKeyClauseGroup0::Alt0(ForeignKeyClauseGroup0Alt0 {
                k_on,
                k_delete_or_k_update,
                group_1,
            }));
        } else if grp_kind == TK_K_MATCH {
            let k_match = p.expect(TK_K_MATCH)?;
            let name = parse_name(p)?;
            group_0_inner = Option::<ForeignKeyClauseGroup0>::Some(ForeignKeyClauseGroup0::Alt1(ForeignKeyClauseGroup0Alt1 {
                k_match,
                name,
            }));
        }
        let group_0 = group_0_inner;
    }
    let k_not_k_deferrable_item: Option<KNotOptKDeferrableItemOptItem> = if p.peek_kind() == TK_K_NOT && p.peek_at(1) == TK_K_DEFERRABLE && p.peek_at(2) == TK_K_INITIALLY {
        let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
            let k_not = p.expect(TK_K_NOT)?;
            Option::<Token>::Some(k_not)
        } else {
            null
        };
        let k_deferrable = p.expect(TK_K_DEFERRABLE)?;
        let mut opt_scan_pos: i32 = -1;
        opt_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_319 = pos;
            let mut sg_319_best = -1;
            sg_319: {
                pos = gp_319;
                sg_319_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_INITIALLY { break sg_319_0; }
                    pos += 1;
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_DEFERRED { break sg_319_0; }
                    pos += 1;
                    if pos > sg_319_best { sg_319_best = pos; }
                }
                pos = gp_319;
                sg_319_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_INITIALLY { break sg_319_1; }
                    pos += 1;
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_IMMEDIATE { break sg_319_1; }
                    pos += 1;
                    if pos > sg_319_best { sg_319_best = pos; }
                }
                if sg_319_best >= 0 { pos = sg_319_best; break sg_319; }
                break opt_scan;
            }
            opt_scan_pos = pos;
        }
        let group_2: Option<ForeignKeyClauseGroup2> = if opt_scan_pos >= 0 {
            let mut group_2_opt: Option<ForeignKeyClauseGroup2> = null;
            let grp_kind = p.peek_kind();
            if grp_kind == TK_K_INITIALLY {
                let mut gd_winner: i32 = -1;
                gd_dispatch: {
                    gd_scan: {
                        let tokens = &p.tokens;
                        let mut pos: i32 = p.pos;
                        if pos >= tokens.len() || tokens[pos].kind != TK_K_INITIALLY { break gd_scan; }
                        pos += 1;
                        if pos >= tokens.len() || tokens[pos].kind != TK_K_DEFERRED { break gd_scan; }
                        pos += 1;
                        gd_winner = 0;
