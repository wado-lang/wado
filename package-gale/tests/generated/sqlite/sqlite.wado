fn parse_result_column(p: &mut Parser) -> Result<ResultColumnNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_STAR {
        let star = p.expect(TK_LIT_STAR)?;
