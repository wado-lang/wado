        TK_LIT_LTGT => "TK_LIT_LTGT",
        TK_LIT_TILDE => "TK_LIT_TILDE",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: Array<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }
}

fn scan_parse(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos].kind) {
        let sp = pos;
        let gp_0 = pos;
        sg_0: {
            pos = gp_0;
            sg_0_0: {
                pos = scan_sql_stmt_list(tokens, pos);
                if pos < 0 { break sg_0_0; }
                break sg_0;
            }
            pos = gp_0;
            sg_0_1: {
                pos = scan_error(tokens, pos);
                if pos < 0 { break sg_0_1; }
                break sg_0;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_error(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_UNEXPECTED_CHAR { return -1; }
    pos += 1;
    return pos;
}

fn scan_sql_stmt_list(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && tokens[pos].kind == TK_LIT_SEMI {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SEMI { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    pos = scan_sql_stmt(tokens, pos);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_LIT_SEMI {
        let sp = pos;
        sg_1_done: {
            sg_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SEMI { break sg_1; }
                pos += 1;
                while pos < tokens.len() && tokens[pos].kind == TK_LIT_SEMI {
                    let sp = pos;
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SEMI { pos = -1; } else { pos += 1; }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                pos = scan_sql_stmt(tokens, pos);
                if pos < 0 { break sg_1; }
                break sg_1_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    while pos < tokens.len() && tokens[pos].kind == TK_LIT_SEMI {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SEMI { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_sql_stmt(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && tokens[pos].kind == TK_K_EXPLAIN && pos + 1 < tokens.len() && tokens[pos + 1].kind == TK_K_QUERY && pos + 2 < tokens.len() && tokens[pos + 2].kind == TK_K_PLAN {
        sol_2: {
            if pos >= tokens.len() || tokens[pos].kind != TK_K_EXPLAIN { break sol_2; }
            pos += 1;
            if pos >= tokens.len() || tokens[pos].kind != TK_K_QUERY { break sol_2; }
            pos += 1;
            if pos >= tokens.len() || tokens[pos].kind != TK_K_PLAN { break sol_2; }
            pos += 1;
        }
    } else if pos < tokens.len() && tokens[pos].kind == TK_K_EXPLAIN {
        sol_3: {
            if pos >= tokens.len() || tokens[pos].kind != TK_K_EXPLAIN { break sol_3; }
            pos += 1;
        }
    }
    let gp_4 = pos;
    let sgk_4 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    if _gale_kind_set_1(sgk_4) {
        let mut sg_4_best = -1;
        sg_4: {
            pos = gp_4;
            sg_4_0: {
                pos = scan_alter_table_stmt(tokens, pos);
                if pos < 0 { break sg_4_0; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_1: {
                pos = scan_analyze_stmt(tokens, pos);
                if pos < 0 { break sg_4_1; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_2: {
                pos = scan_attach_stmt(tokens, pos);
                if pos < 0 { break sg_4_2; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_3: {
                pos = scan_begin_stmt(tokens, pos);
                if pos < 0 { break sg_4_3; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_4: {
                pos = scan_commit_stmt(tokens, pos);
                if pos < 0 { break sg_4_4; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_5: {
                pos = scan_compound_select_stmt(tokens, pos);
                if pos < 0 { break sg_4_5; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_6: {
                pos = scan_create_index_stmt(tokens, pos);
                if pos < 0 { break sg_4_6; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_7: {
                pos = scan_create_table_stmt(tokens, pos);
                if pos < 0 { break sg_4_7; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_8: {
                pos = scan_create_trigger_stmt(tokens, pos);
                if pos < 0 { break sg_4_8; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_9: {
                pos = scan_create_view_stmt(tokens, pos);
                if pos < 0 { break sg_4_9; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_10: {
                pos = scan_create_virtual_table_stmt(tokens, pos);
                if pos < 0 { break sg_4_10; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_11: {
                pos = scan_delete_stmt(tokens, pos);
                if pos < 0 { break sg_4_11; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_12: {
                pos = scan_delete_stmt_limited(tokens, pos);
                if pos < 0 { break sg_4_12; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_13: {
                pos = scan_detach_stmt(tokens, pos);
                if pos < 0 { break sg_4_13; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_14: {
                pos = scan_drop_index_stmt(tokens, pos);
                if pos < 0 { break sg_4_14; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_15: {
                pos = scan_drop_table_stmt(tokens, pos);
                if pos < 0 { break sg_4_15; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_16: {
                pos = scan_drop_trigger_stmt(tokens, pos);
                if pos < 0 { break sg_4_16; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_17: {
                pos = scan_drop_view_stmt(tokens, pos);
                if pos < 0 { break sg_4_17; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_18: {
                pos = scan_factored_select_stmt(tokens, pos);
                if pos < 0 { break sg_4_18; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_19: {
                pos = scan_insert_stmt(tokens, pos);
                if pos < 0 { break sg_4_19; }
                if pos > sg_4_best { sg_4_best = pos; }
            }
            pos = gp_4;
            sg_4_20: {
                pos = scan_pragma_stmt(tokens, pos);
                if pos < 0 { break sg_4_20; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_21: {
                pos = scan_reindex_stmt(tokens, pos);
                if pos < 0 { break sg_4_21; }
                break sg_4;
            }
            pos = gp_4;
            sg_4_22: {
