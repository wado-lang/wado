    });
}

fn parse_reindex_stmt(p: &mut Parser) -> Result<ReindexStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_reindex = p.expect(TK_K_REINDEX)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        let gp_288 = pos;
        let mut sg_288_best = -1;
        sg_288: {
            pos = gp_288;
            sg_288_0: {
                pos = scan_collation_name(tokens, pos);
                if pos < 0 { break sg_288_0; }
                if pos > sg_288_best { sg_288_best = pos; }
            }
            pos = gp_288;
            sg_288_1: {
                if pos < tokens.len() && _gale_kind_set_2(tokens[pos].kind) {
                    let sp = pos;
                    sg_289_done: {
                        sg_289: {
                            pos = scan_database_name(tokens, pos);
                            if pos < 0 { break sg_289; }
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break sg_289; }
                            pos += 1;
                            break sg_289_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; }
                }
                let gp_290 = pos;
                let sgk_290 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
                if _gale_kind_set_2(sgk_290) {
                    let mut sg_290_best = -1;
                    sg_290: {
                        pos = gp_290;
                        sg_290_0: {
                            pos = scan_table_name(tokens, pos);
                            if pos < 0 { break sg_290_0; }
                            if pos > sg_290_best { sg_290_best = pos; }
                        }
                        pos = gp_290;
                        sg_290_1: {
                            pos = scan_index_name(tokens, pos);
                            if pos < 0 { break sg_290_1; }
                            if pos > sg_290_best { sg_290_best = pos; }
                        }
                        if sg_290_best >= 0 { pos = sg_290_best; break sg_290; }
                        pos = gp_290;
                    }
                }
                if pos > sg_288_best { sg_288_best = pos; }
            }
            if sg_288_best >= 0 { pos = sg_288_best; break sg_288; }
            break opt_scan;
        }
        opt_scan_pos = pos;
    }
    let group_0: Option<ReindexStmtGroup0> = if opt_scan_pos >= 0 {
        let mut group_0_opt: Option<ReindexStmtGroup0> = null;
        let grp_kind = p.peek_kind();
        if _gale_kind_set_2(grp_kind) {
            let mut gd_winner: i32 = -1;
            gd_dispatch: {
                gd_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    pos = scan_collation_name(tokens, pos);
                    if pos < 0 { break gd_scan; }
                    gd_winner = 0;
                    break gd_dispatch;
                }
            }
            if gd_winner == 0 {
                let collation_name = parse_collation_name(p)?;
                group_0_opt = Option::<ReindexStmtGroup0>::Some(ReindexStmtGroup0::Alt0(ReindexStmtGroup0Alt0 {
                    collation_name,
                }));
            } else {
                let mut opt_scan_pos: i32 = -1;
                opt_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    pos = scan_database_name(tokens, pos);
                    if pos < 0 { break opt_scan; }
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break opt_scan; }
                    pos += 1;
                    opt_scan_pos = pos;
                }
                let database_name_dot: Option<DatabaseNameDotItem> = if opt_scan_pos >= 0 {
                    let database_name = parse_database_name(p)?;
                    let dot = p.expect(TK_LIT_DOT)?;
                    let database_name_dot = DatabaseNameDotItem {
                        database_name,
                        dot,
                    };
                    Option::<DatabaseNameDotItem>::Some(database_name_dot)
                } else {
                    null
                };
                let mut table_name_or_index_name_inner: Option<TableNameOrIndexNameGroup> = null;
                let grp_kind = p.peek_kind();
                if _gale_kind_set_2(grp_kind) {
                    let mut gd_winner: i32 = -1;
                    gd_dispatch: {
                        gd_scan: {
                            let tokens = &p.tokens;
                            let mut pos: i32 = p.pos;
                            pos = scan_table_name(tokens, pos);
                            if pos < 0 { break gd_scan; }
                            gd_winner = 0;
                            break gd_dispatch;
                        }
                    }
                    if gd_winner == 0 {
                        let table_name = parse_table_name(p)?;
                        table_name_or_index_name_inner = Option::<TableNameOrIndexNameGroup>::Some(TableNameOrIndexNameGroup::TableName(table_name));
                    } else {
                        let index_name = parse_index_name(p)?;
                        table_name_or_index_name_inner = Option::<TableNameOrIndexNameGroup>::Some(TableNameOrIndexNameGroup::IndexName(index_name));
                    }
                }
                let table_name_or_index_name = table_name_or_index_name_inner;
                group_0_opt = Option::<ReindexStmtGroup0>::Some(ReindexStmtGroup0::Alt1(ReindexStmtGroup0Alt1 {
                    database_name_dot,
                    table_name_or_index_name,
                }));
            }
        }
        if let None = group_0_opt {
            p.fail("group alternative")?;
        }
        let group_0 = group_0_opt.unwrap();
        Option::<ReindexStmtGroup0>::Some(group_0)
    } else {
        null
    };
    return Result::<ReindexStmtNode, ParseError>::Ok(ReindexStmtNode {
        span: Span::new(start, p.last_end()),
        k_reindex,
        group_0,
    });
}

fn parse_release_stmt(p: &mut Parser) -> Result<ReleaseStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_release = p.expect(TK_K_RELEASE)?;
    let k_savepoint: Option<Token> = if p.peek_kind() == TK_K_SAVEPOINT {
        let k_savepoint = p.expect(TK_K_SAVEPOINT)?;
        Option::<Token>::Some(k_savepoint)
    } else {
        null
    };
    let savepoint_name = parse_savepoint_name(p)?;
    return Result::<ReleaseStmtNode, ParseError>::Ok(ReleaseStmtNode {
        span: Span::new(start, p.last_end()),
        k_release,
        k_savepoint,
        savepoint_name,
    });
}

fn parse_rollback_stmt(p: &mut Parser) -> Result<RollbackStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_rollback = p.expect(TK_K_ROLLBACK)?;
    let k_transaction_transaction_name: Option<KTransactionTransactionNameOptItem> = if p.peek_kind() == TK_K_TRANSACTION {
        let k_transaction = p.expect(TK_K_TRANSACTION)?;
        let transaction_name: Option<TransactionNameNode> = if _gale_kind_set_2(p.peek_kind()) {
            let transaction_name = parse_transaction_name(p)?;
            Option::<TransactionNameNode>::Some(transaction_name)
        } else {
            null
        };
        let k_transaction_transaction_name = KTransactionTransactionNameOptItem {
            k_transaction,
            transaction_name,
        };
        Option::<KTransactionTransactionNameOptItem>::Some(k_transaction_transaction_name)
    } else {
        null
    };
    let k_to_k_savepoint_savepoint_name: Option<KToKSavepointOptSavepointNameItem> = if p.peek_kind() == TK_K_TO {
        let k_to = p.expect(TK_K_TO)?;
        let k_savepoint: Option<Token> = if p.peek_kind() == TK_K_SAVEPOINT {
            let k_savepoint = p.expect(TK_K_SAVEPOINT)?;
            Option::<Token>::Some(k_savepoint)
        } else {
            null
        };
        let savepoint_name = parse_savepoint_name(p)?;
        let k_to_k_savepoint_savepoint_name = KToKSavepointOptSavepointNameItem {
            k_to,
            k_savepoint,
            savepoint_name,
        };
        Option::<KToKSavepointOptSavepointNameItem>::Some(k_to_k_savepoint_savepoint_name)
    } else {
        null
    };
    return Result::<RollbackStmtNode, ParseError>::Ok(RollbackStmtNode {
        span: Span::new(start, p.last_end()),
        k_rollback,
        k_transaction_transaction_name,
        k_to_k_savepoint_savepoint_name,
    });
}

fn parse_savepoint_stmt(p: &mut Parser) -> Result<SavepointStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_savepoint = p.expect(TK_K_SAVEPOINT)?;
    let savepoint_name = parse_savepoint_name(p)?;
    return Result::<SavepointStmtNode, ParseError>::Ok(SavepointStmtNode {
        span: Span::new(start, p.last_end()),
        k_savepoint,
        savepoint_name,
    });
}

fn parse_simple_select_stmt(p: &mut Parser) -> Result<SimpleSelectStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let select_core = parse_select_core(p)?;
    let k_order_k_by_ordering_term_item: Option<KOrderKByOrderingTermItemListItem> = if p.peek_kind() == TK_K_ORDER && p.peek_at(1) == TK_K_BY {
        let k_order = p.expect(TK_K_ORDER)?;
        let k_by = p.expect(TK_K_BY)?;
        let ordering_term = parse_ordering_term(p)?;
        let mut comma_ordering_term_list: Array<CommaOrderingTermItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                pos += 1;
                pos = scan_ordering_term(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let comma = p.expect(TK_LIT_COMMA)?;
            let ordering_term = parse_ordering_term(p)?;
            let comma_ordering_term = CommaOrderingTermItem {
                comma,
                ordering_term,
            };
            comma_ordering_term_list.push(comma_ordering_term);
        }
        let k_order_k_by_ordering_term_item = KOrderKByOrderingTermItemListItem {
            k_order,
            k_by,
            ordering_term,
            comma_ordering_term_list,
        };
        Option::<KOrderKByOrderingTermItemListItem>::Some(k_order_k_by_ordering_term_item)
    } else {
        null
    };
    let k_limit_expr_item: Option<KLimitExprItemOptItem> = if p.peek_kind() == TK_K_LIMIT {
        let k_limit = p.expect(TK_K_LIMIT)?;
        let expr = parse_expr(p)?;
        let mut opt_scan_pos: i32 = -1;
        opt_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_291 = pos;
            sg_291: {
                pos = gp_291;
                sg_291_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_OFFSET { break sg_291_0; }
                    pos += 1;
                    break sg_291;
                }
                pos = gp_291;
                sg_291_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_291_1; }
                    pos += 1;
                    break sg_291;
                }
                break opt_scan;
            }
            pos = scan_expr(tokens, pos);
            if pos < 0 { break opt_scan; }
            opt_scan_pos = pos;
        }
        let item_expr: Option<ItemExprItem> = if opt_scan_pos >= 0 {
            let k_offset_or_comma = p.advance();
            let expr = parse_expr(p)?;
            let item_expr = ItemExprItem {
                k_offset_or_comma,
                expr,
            };
            Option::<ItemExprItem>::Some(item_expr)
        } else {
            null
        };
        let k_limit_expr_item = KLimitExprItemOptItem {
            k_limit,
            expr,
            item_expr,
        };
        Option::<KLimitExprItemOptItem>::Some(k_limit_expr_item)
    } else {
        null
    };
    return Result::<SimpleSelectStmtNode, ParseError>::Ok(SimpleSelectStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        select_core,
        k_order_k_by_ordering_term_item,
        k_limit_expr_item,
    });
}

fn parse_select_stmt(p: &mut Parser) -> Result<SelectStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let select_or_values = parse_select_or_values(p)?;
    let mut compound_operator_select_or_values_list: Array<CompoundOperatorSelectOrValuesItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_compound_operator(tokens, pos);
            if pos < 0 { break rep_scan; }
            pos = scan_select_or_values(tokens, pos);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let compound_operator = parse_compound_operator(p)?;
        let select_or_values = parse_select_or_values(p)?;
        let compound_operator_select_or_values = CompoundOperatorSelectOrValuesItem {
            compound_operator,
            select_or_values,
        };
        compound_operator_select_or_values_list.push(compound_operator_select_or_values);
    }
    let k_order_k_by_ordering_term_item: Option<KOrderKByOrderingTermItemListItem> = if p.peek_kind() == TK_K_ORDER && p.peek_at(1) == TK_K_BY {
        let k_order = p.expect(TK_K_ORDER)?;
        let k_by = p.expect(TK_K_BY)?;
        let ordering_term = parse_ordering_term(p)?;
        let mut comma_ordering_term_list: Array<CommaOrderingTermItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                pos += 1;
                pos = scan_ordering_term(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let comma = p.expect(TK_LIT_COMMA)?;
            let ordering_term = parse_ordering_term(p)?;
            let comma_ordering_term = CommaOrderingTermItem {
                comma,
                ordering_term,
            };
            comma_ordering_term_list.push(comma_ordering_term);
        }
        let k_order_k_by_ordering_term_item = KOrderKByOrderingTermItemListItem {
            k_order,
            k_by,
            ordering_term,
            comma_ordering_term_list,
        };
        Option::<KOrderKByOrderingTermItemListItem>::Some(k_order_k_by_ordering_term_item)
    } else {
        null
    };
    let k_limit_expr_item: Option<KLimitExprItemOptItem> = if p.peek_kind() == TK_K_LIMIT {
        let k_limit = p.expect(TK_K_LIMIT)?;
        let expr = parse_expr(p)?;
        let mut opt_scan_pos: i32 = -1;
        opt_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_292 = pos;
            sg_292: {
                pos = gp_292;
                sg_292_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_OFFSET { break sg_292_0; }
                    pos += 1;
                    break sg_292;
                }
                pos = gp_292;
                sg_292_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_292_1; }
                    pos += 1;
                    break sg_292;
                }
                break opt_scan;
            }
            pos = scan_expr(tokens, pos);
            if pos < 0 { break opt_scan; }
            opt_scan_pos = pos;
        }
        let item_expr: Option<ItemExprItem> = if opt_scan_pos >= 0 {
            let k_offset_or_comma = p.advance();
            let expr = parse_expr(p)?;
            let item_expr = ItemExprItem {
                k_offset_or_comma,
                expr,
            };
            Option::<ItemExprItem>::Some(item_expr)
        } else {
            null
        };
        let k_limit_expr_item = KLimitExprItemOptItem {
            k_limit,
            expr,
            item_expr,
        };
        Option::<KLimitExprItemOptItem>::Some(k_limit_expr_item)
    } else {
        null
    };
    return Result::<SelectStmtNode, ParseError>::Ok(SelectStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        select_or_values,
        compound_operator_select_or_values_list,
        k_order_k_by_ordering_term_item,
        k_limit_expr_item,
    });
}

fn parse_select_or_values(p: &mut Parser) -> Result<SelectOrValuesNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_K_SELECT {
        let k_select = p.expect(TK_K_SELECT)?;
        let mut opt_scan_pos: i32 = -1;
        opt_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_293 = pos;
            sg_293: {
                pos = gp_293;
                sg_293_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_DISTINCT { break sg_293_0; }
                    pos += 1;
                    break sg_293;
                }
                pos = gp_293;
                sg_293_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_ALL { break sg_293_1; }
                    pos += 1;
                    break sg_293;
                }
                break opt_scan;
            }
            opt_scan_pos = pos;
        }
        let k_distinct_or_k_all: Option<Token> = if opt_scan_pos >= 0 {
            let k_distinct_or_k_all = p.advance();
            Option::<Token>::Some(k_distinct_or_k_all)
        } else {
            null
        };
        let result_column = parse_result_column(p)?;
        let mut comma_result_column_list: Array<CommaResultColumnItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                pos += 1;
                pos = scan_result_column(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let comma = p.expect(TK_LIT_COMMA)?;
            let result_column = parse_result_column(p)?;
            let comma_result_column = CommaResultColumnItem {
                comma,
                result_column,
            };
            comma_result_column_list.push(comma_result_column);
        }
        let k_from_item: Option<KFromItemItem> = if p.peek_kind() == TK_K_FROM {
            let k_from = p.expect(TK_K_FROM)?;
            let mut group_0_inner: Option<SelectOrValuesGroup0> = null;
            let grp_kind = p.peek_kind();
            if _gale_kind_set_2(grp_kind) {
                let mut gd_winner: i32 = -1;
                gd_dispatch: {
                    gd_scan: {
                        let tokens = &p.tokens;
                        let mut pos: i32 = p.pos;
                        pos = scan_join_clause(tokens, pos);
                        if pos < 0 { break gd_scan; }
                        gd_winner = 0;
                        break gd_dispatch;
                    }
                }
                if gd_winner == 0 {
                    let join_clause = parse_join_clause(p)?;
                    group_0_inner = Option::<SelectOrValuesGroup0>::Some(SelectOrValuesGroup0::Alt1(SelectOrValuesGroup0Alt1 {
                        join_clause,
                    }));
                } else {
                    let table_or_subquery = parse_table_or_subquery(p)?;
                    let mut comma_table_or_subquery_list: Array<CommaTableOrSubqueryItem> = [];
                    loop {
                        let mut rep_scan_pos: i32 = -1;
                        rep_scan: {
                            let tokens = &p.tokens;
                            let mut pos: i32 = p.pos;
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                            pos += 1;
                            pos = scan_table_or_subquery(tokens, pos);
                            if pos < 0 { break rep_scan; }
                            if pos <= p.pos { break rep_scan; }
                            rep_scan_pos = pos;
                        }
                        if rep_scan_pos < 0 { break; }
                        let comma = p.expect(TK_LIT_COMMA)?;
                        let table_or_subquery = parse_table_or_subquery(p)?;
                        let comma_table_or_subquery = CommaTableOrSubqueryItem {
                            comma,
                            table_or_subquery,
                        };
                        comma_table_or_subquery_list.push(comma_table_or_subquery);
                    }
                    group_0_inner = Option::<SelectOrValuesGroup0>::Some(SelectOrValuesGroup0::Alt0(SelectOrValuesGroup0Alt0 {
                        table_or_subquery,
                        comma_table_or_subquery_list,
                    }));
                }
            }
            let group_0 = group_0_inner;
            let k_from_item = KFromItemItem {
                k_from,
                group_0,
            };
            Option::<KFromItemItem>::Some(k_from_item)
        } else {
            null
        };
        let k_where_expr: Option<KWhereExprItem> = if p.peek_kind() == TK_K_WHERE {
            let k_where = p.expect(TK_K_WHERE)?;
            let expr = parse_expr(p)?;
            let k_where_expr = KWhereExprItem {
                k_where,
                expr,
            };
            Option::<KWhereExprItem>::Some(k_where_expr)
        } else {
            null
        };
        let k_group_k_by_expr_item_item: Option<KGroupKByExprItemListItemOptItem> = if p.peek_kind() == TK_K_GROUP && p.peek_at(1) == TK_K_BY {
            let k_group = p.expect(TK_K_GROUP)?;
            let k_by = p.expect(TK_K_BY)?;
            let expr = parse_expr(p)?;
            let mut comma_expr_list: Array<CommaExprItem> = [];
            loop {
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                    pos += 1;
                    pos = scan_expr(tokens, pos);
                    if pos < 0 { break rep_scan; }
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
                let comma = p.expect(TK_LIT_COMMA)?;
                let expr = parse_expr(p)?;
                let comma_expr = CommaExprItem {
                    comma,
                    expr,
                };
                comma_expr_list.push(comma_expr);
            }
            let k_having_expr: Option<KHavingExprItem> = if p.peek_kind() == TK_K_HAVING {
                let k_having = p.expect(TK_K_HAVING)?;
                let expr = parse_expr(p)?;
                let k_having_expr = KHavingExprItem {
                    k_having,
                    expr,
                };
                Option::<KHavingExprItem>::Some(k_having_expr)
            } else {
                null
            };
            let k_group_k_by_expr_item_item = KGroupKByExprItemListItemOptItem {
                k_group,
                k_by,
                expr,
                comma_expr_list,
                k_having_expr,
            };
            Option::<KGroupKByExprItemListItemOptItem>::Some(k_group_k_by_expr_item_item)
        } else {
            null
        };
        return Result::<SelectOrValuesNode, ParseError>::Ok(SelectOrValuesNode::Alt0(SelectOrValuesAlt0 {
            span: Span::new(start, p.last_end()),
            k_select,
            k_distinct_or_k_all,
            result_column,
