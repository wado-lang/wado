fn parse_common_table_expression(p: &mut Parser) -> Result<CommonTableExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let table_name = parse_table_name(p)?;
    let lparen_column_name_item_rparen: Option<LparenColumnNameItemListRparenItem> = if p.peek_kind() == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let column_name = parse_column_name(p)?;
        let mut comma_column_name_list: Array<CommaColumnNameItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                pos += 1;
                pos = scan_column_name(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let comma = p.expect(TK_LIT_COMMA)?;
            let column_name = parse_column_name(p)?;
            let comma_column_name = CommaColumnNameItem {
                comma,
                column_name,
            };
            comma_column_name_list.push(comma_column_name);
        }
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let lparen_column_name_item_rparen = LparenColumnNameItemListRparenItem {
            lparen,
            column_name,
            comma_column_name_list,
            rparen,
        };
        Option::<LparenColumnNameItemListRparenItem>::Some(lparen_column_name_item_rparen)
    } else {
        null
    };
    let k_as = p.expect(TK_K_AS)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let select_stmt = parse_select_stmt(p)?;
    let rparen = p.expect(TK_LIT_RPAREN)?;
    return Result::<CommonTableExpressionNode, ParseError>::Ok(CommonTableExpressionNode {
        span: Span::new(start, p.last_end()),
        table_name,
        lparen_column_name_item_rparen,
        k_as,
        lparen,
        select_stmt,
        rparen,
    });
}

