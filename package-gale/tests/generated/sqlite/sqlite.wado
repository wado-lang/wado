fn parse_create_virtual_table_stmt(p: &mut Parser) -> Result<CreateVirtualTableStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_create = p.expect(TK_K_CREATE)?;
    let k_virtual = p.expect(TK_K_VIRTUAL)?;
    let k_table = p.expect(TK_K_TABLE)?;
    let k_if_k_not_k_exists: Option<KIfKNotKExistsItem> = if p.peek_kind() == TK_K_IF && p.peek_at(1) == TK_K_NOT && p.peek_at(2) == TK_K_EXISTS {
        let k_if = p.expect(TK_K_IF)?;
        let k_not = p.expect(TK_K_NOT)?;
        let k_exists = p.expect(TK_K_EXISTS)?;
        let k_if_k_not_k_exists = KIfKNotKExistsItem {
            k_if,
            k_not,
            k_exists,
        };
        Option::<KIfKNotKExistsItem>::Some(k_if_k_not_k_exists)
    } else {
        null
    };
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        pos = scan_database_name(tokens, pos);
        if pos < 0 { break opt_scan; }
        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break opt_scan; }
        pos += 1;
        opt_scan_pos = pos;
    }
    let database_name_dot: Option<DatabaseNameDotItem> = if opt_scan_pos >= 0 {
        let database_name = parse_database_name(p)?;
        let dot = p.expect(TK_LIT_DOT)?;
        let database_name_dot = DatabaseNameDotItem {
            database_name,
            dot,
        };
        Option::<DatabaseNameDotItem>::Some(database_name_dot)
    } else {
        null
    };
    let table_name = parse_table_name(p)?;
    let k_using = p.expect(TK_K_USING)?;
    let module_name = parse_module_name(p)?;
    let lparen_module_argument_item_rparen: Option<LparenModuleArgumentItemListRparenItem> = if p.peek_kind() == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let module_argument = parse_module_argument(p)?;
        let mut comma_module_argument_list: Array<CommaModuleArgumentItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                pos += 1;
                pos = scan_module_argument(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let comma = p.expect(TK_LIT_COMMA)?;
            let module_argument = parse_module_argument(p)?;
            let comma_module_argument = CommaModuleArgumentItem {
                comma,
                module_argument,
            };
            comma_module_argument_list.push(comma_module_argument);
        }
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let lparen_module_argument_item_rparen = LparenModuleArgumentItemListRparenItem {
            lparen,
            module_argument,
            comma_module_argument_list,
            rparen,
        };
        Option::<LparenModuleArgumentItemListRparenItem>::Some(lparen_module_argument_item_rparen)
    } else {
        null
    };
    return Result::<CreateVirtualTableStmtNode, ParseError>::Ok(CreateVirtualTableStmtNode {
        span: Span::new(start, p.last_end()),
        k_create,
        k_virtual,
        k_table,
        k_if_k_not_k_exists,
        database_name_dot,
        table_name,
        k_using,
        module_name,
        lparen_module_argument_item_rparen,
    });
