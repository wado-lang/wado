            let k_not = p.expect(TK_K_NOT)?;
            let k_indexed = p.expect(TK_K_INDEXED)?;
            QualifiedTableNameGroup0::Alt1(QualifiedTableNameGroup0Alt1 {
                k_not,
                k_indexed,
            })
