fn parse_alter_table_stmt(p: &mut Parser) -> Result<AlterTableStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_alter = p.expect(TK_K_ALTER)?;
    let k_table = p.expect(TK_K_TABLE)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        pos = scan_database_name(tokens, pos);
        if pos < 0 { break opt_scan; }
        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break opt_scan; }
        pos += 1;
        opt_scan_pos = pos;
    }
    let database_name_dot: Option<DatabaseNameDotItem> = if opt_scan_pos >= 0 {
        let database_name = parse_database_name(p)?;
        let dot = p.expect(TK_LIT_DOT)?;
        let database_name_dot = DatabaseNameDotItem {
            database_name,
            dot,
        };
        Option::<DatabaseNameDotItem>::Some(database_name_dot)
    } else {
        null
    };
    let table_name = parse_table_name(p)?;
    let mut group_0_inner: Option<AlterTableStmtGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_RENAME {
        let k_rename = p.expect(TK_K_RENAME)?;
        let k_to = p.expect(TK_K_TO)?;
        let new_table_name = parse_new_table_name(p)?;
        group_0_inner = Option::<AlterTableStmtGroup0>::Some(AlterTableStmtGroup0::Alt0(AlterTableStmtGroup0Alt0 {
            k_rename,
            k_to,
            new_table_name,
        }));
    } else if grp_kind == TK_K_ADD {
        let k_add = p.expect(TK_K_ADD)?;
        let k_column: Option<Token> = if p.peek_kind() == TK_K_COLUMN {
            let k_column = p.expect(TK_K_COLUMN)?;
            Option::<Token>::Some(k_column)
        } else {
            null
        };
        let column_def = parse_column_def(p)?;
        group_0_inner = Option::<AlterTableStmtGroup0>::Some(AlterTableStmtGroup0::Alt1(AlterTableStmtGroup0Alt1 {
            k_add,
            k_column,
            column_def,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<AlterTableStmtNode, ParseError>::Ok(AlterTableStmtNode {
        span: Span::new(start, p.last_end()),
        k_alter,
        k_table,
        database_name_dot,
        table_name,
        group_0,
    });
}

fn parse_analyze_stmt(p: &mut Parser) -> Result<AnalyzeStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_analyze = p.expect(TK_K_ANALYZE)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        let gp_271 = pos;
        let mut sg_271_best = -1;
        sg_271: {
            pos = gp_271;
            sg_271_0: {
                pos = scan_database_name(tokens, pos);
                if pos < 0 { break sg_271_0; }
                if pos > sg_271_best { sg_271_best = pos; }
            }
            pos = gp_271;
            sg_271_1: {
                pos = scan_table_or_index_name(tokens, pos);
                if pos < 0 { break sg_271_1; }
                if pos > sg_271_best { sg_271_best = pos; }
            }
            pos = gp_271;
            sg_271_2: {
                pos = scan_database_name(tokens, pos);
                if pos < 0 { break sg_271_2; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break sg_271_2; }
                pos += 1;
                pos = scan_table_or_index_name(tokens, pos);
                if pos < 0 { break sg_271_2; }
                if pos > sg_271_best { sg_271_best = pos; }
            }
            if sg_271_best >= 0 { pos = sg_271_best; break sg_271; }
            break opt_scan;
        }
        opt_scan_pos = pos;
    }
    let group_0: Option<AnalyzeStmtGroup0> = if opt_scan_pos >= 0 {
        let mut group_0_opt: Option<AnalyzeStmtGroup0> = null;
        let grp_kind = p.peek_kind();
        if _gale_kind_set_2(grp_kind) {
            let mut gd_winner: i32 = -1;
            gd_dispatch: {
                gd_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    pos = scan_database_name(tokens, pos);
                    if pos < 0 { break gd_scan; }
                    gd_winner = 0;
                    break gd_dispatch;
                }
                gd_scan_2: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    pos = scan_table_or_index_name(tokens, pos);
                    if pos < 0 { break gd_scan_2; }
                    gd_winner = 1;
                    break gd_dispatch;
                }
            }
            if gd_winner == 0 {
                let database_name = parse_database_name(p)?;
                group_0_opt = Option::<AnalyzeStmtGroup0>::Some(AnalyzeStmtGroup0::Alt0(AnalyzeStmtGroup0Alt0 {
                    database_name,
                }));
            } else if gd_winner == 1 {
                let table_or_index_name = parse_table_or_index_name(p)?;
                group_0_opt = Option::<AnalyzeStmtGroup0>::Some(AnalyzeStmtGroup0::Alt1(AnalyzeStmtGroup0Alt1 {
                    table_or_index_name,
                }));
            } else {
                let database_name = parse_database_name(p)?;
                let dot = p.expect(TK_LIT_DOT)?;
                let table_or_index_name = parse_table_or_index_name(p)?;
                group_0_opt = Option::<AnalyzeStmtGroup0>::Some(AnalyzeStmtGroup0::Alt2(AnalyzeStmtGroup0Alt2 {
                    database_name,
                    dot,
                    table_or_index_name,
                }));
            }
        }
        if let None = group_0_opt {
            p.fail("group alternative")?;
        }
        let group_0 = group_0_opt.unwrap();
        Option::<AnalyzeStmtGroup0>::Some(group_0)
    } else {
        null
    };
    return Result::<AnalyzeStmtNode, ParseError>::Ok(AnalyzeStmtNode {
        span: Span::new(start, p.last_end()),
        k_analyze,
        group_0,
    });
}

fn parse_attach_stmt(p: &mut Parser) -> Result<AttachStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_attach = p.expect(TK_K_ATTACH)?;
    let k_database: Option<Token> = if p.peek_kind() == TK_K_DATABASE {
        let k_database = p.expect(TK_K_DATABASE)?;
        Option::<Token>::Some(k_database)
    } else {
        null
    };
    let expr = parse_expr(p)?;
    let k_as = p.expect(TK_K_AS)?;
    let database_name = parse_database_name(p)?;
    return Result::<AttachStmtNode, ParseError>::Ok(AttachStmtNode {
        span: Span::new(start, p.last_end()),
        k_attach,
        k_database,
        expr,
        k_as,
        database_name,
    });
}

fn parse_begin_stmt(p: &mut Parser) -> Result<BeginStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_begin = p.expect(TK_K_BEGIN)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        let gp_272 = pos;
        sg_272: {
            pos = gp_272;
            sg_272_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_DEFERRED { break sg_272_0; }
                pos += 1;
                break sg_272;
            }
            pos = gp_272;
            sg_272_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_IMMEDIATE { break sg_272_1; }
                pos += 1;
                break sg_272;
            }
            pos = gp_272;
            sg_272_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_EXCLUSIVE { break sg_272_2; }
                pos += 1;
                break sg_272;
            }
            break opt_scan;
        }
        opt_scan_pos = pos;
    }
    let k_deferred_or_k_immediate_or_k_exclusive: Option<Token> = if opt_scan_pos >= 0 {
        let k_deferred_or_k_immediate_or_k_exclusive = p.advance();
        Option::<Token>::Some(k_deferred_or_k_immediate_or_k_exclusive)
    } else {
        null
    };
    let k_transaction_transaction_name: Option<KTransactionTransactionNameOptItem> = if p.peek_kind() == TK_K_TRANSACTION {
        let k_transaction = p.expect(TK_K_TRANSACTION)?;
        let transaction_name: Option<TransactionNameNode> = if _gale_kind_set_2(p.peek_kind()) {
            let transaction_name = parse_transaction_name(p)?;
            Option::<TransactionNameNode>::Some(transaction_name)
        } else {
            null
        };
        let k_transaction_transaction_name = KTransactionTransactionNameOptItem {
            k_transaction,
            transaction_name,
        };
        Option::<KTransactionTransactionNameOptItem>::Some(k_transaction_transaction_name)
    } else {
        null
    };
    return Result::<BeginStmtNode, ParseError>::Ok(BeginStmtNode {
        span: Span::new(start, p.last_end()),
        k_begin,
        k_deferred_or_k_immediate_or_k_exclusive,
        k_transaction_transaction_name,
    });
}

fn parse_commit_stmt(p: &mut Parser) -> Result<CommitStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_commit_or_k_end = p.advance();
    let k_transaction_transaction_name: Option<KTransactionTransactionNameOptItem> = if p.peek_kind() == TK_K_TRANSACTION {
        let k_transaction = p.expect(TK_K_TRANSACTION)?;
        let transaction_name: Option<TransactionNameNode> = if _gale_kind_set_2(p.peek_kind()) {
            let transaction_name = parse_transaction_name(p)?;
            Option::<TransactionNameNode>::Some(transaction_name)
        } else {
            null
        };
        let k_transaction_transaction_name = KTransactionTransactionNameOptItem {
            k_transaction,
            transaction_name,
        };
        Option::<KTransactionTransactionNameOptItem>::Some(k_transaction_transaction_name)
    } else {
        null
    };
    return Result::<CommitStmtNode, ParseError>::Ok(CommitStmtNode {
        span: Span::new(start, p.last_end()),
        k_commit_or_k_end,
        k_transaction_transaction_name,
    });
}

fn parse_compound_select_stmt(p: &mut Parser) -> Result<CompoundSelectStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let select_core = parse_select_core(p)?;
    let mut item_select_core_list: Array<ItemSelectCoreItem> = [];
    let mut _plus_first = true;
    loop {
        if !_plus_first {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                let gp_273 = pos;
                let sgk_273 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
                if _gale_kind_set_5(sgk_273) {
                    sg_273: {
                        pos = gp_273;
                        sg_273_0: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_K_UNION { break sg_273_0; }
                            pos += 1;
                            if pos < tokens.len() && tokens[pos].kind == TK_K_ALL {
                                let sp = pos;
                                if pos >= tokens.len() || tokens[pos].kind != TK_K_ALL { pos = -1; } else { pos += 1; }
                                if pos < 0 { pos = sp; }
                            }
                            break sg_273;
                        }
                        pos = gp_273;
                        sg_273_1: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_K_INTERSECT { break sg_273_1; }
                            pos += 1;
                            break sg_273;
                        }
                        pos = gp_273;
                        sg_273_2: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_K_EXCEPT { break sg_273_2; }
                            pos += 1;
                            break sg_273;
                        }
                        pos = gp_273;
                    }
                }
                pos = scan_select_core(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
        }
        _plus_first = false;
        let mut group_0_inner: Option<CompoundSelectStmtGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_K_UNION {
            let k_union = p.expect(TK_K_UNION)?;
            let k_all: Option<Token> = if p.peek_kind() == TK_K_ALL {
                let k_all = p.expect(TK_K_ALL)?;
                Option::<Token>::Some(k_all)
            } else {
                null
            };
            group_0_inner = Option::<CompoundSelectStmtGroup0>::Some(CompoundSelectStmtGroup0::Alt0(CompoundSelectStmtGroup0Alt0 {
                k_union,
                k_all,
            }));
        } else if grp_kind == TK_K_INTERSECT {
            let k_intersect = p.expect(TK_K_INTERSECT)?;
            group_0_inner = Option::<CompoundSelectStmtGroup0>::Some(CompoundSelectStmtGroup0::Alt1(CompoundSelectStmtGroup0Alt1 {
                k_intersect,
            }));
        } else if grp_kind == TK_K_EXCEPT {
            let k_except = p.expect(TK_K_EXCEPT)?;
            group_0_inner = Option::<CompoundSelectStmtGroup0>::Some(CompoundSelectStmtGroup0::Alt2(CompoundSelectStmtGroup0Alt2 {
                k_except,
            }));
        }
        let group_0 = group_0_inner;
        let select_core = parse_select_core(p)?;
        let item_select_core = ItemSelectCoreItem {
            group_0,
            select_core,
        };
        item_select_core_list.push(item_select_core);
    }
    let k_order_k_by_ordering_term_item: Option<KOrderKByOrderingTermItemListItem> = if p.peek_kind() == TK_K_ORDER && p.peek_at(1) == TK_K_BY {
        let k_order = p.expect(TK_K_ORDER)?;
        let k_by = p.expect(TK_K_BY)?;
        let ordering_term = parse_ordering_term(p)?;
        let mut comma_ordering_term_list: Array<CommaOrderingTermItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                pos += 1;
                pos = scan_ordering_term(tokens, pos);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let comma = p.expect(TK_LIT_COMMA)?;
            let ordering_term = parse_ordering_term(p)?;
            let comma_ordering_term = CommaOrderingTermItem {
                comma,
                ordering_term,
            };
            comma_ordering_term_list.push(comma_ordering_term);
        }
        let k_order_k_by_ordering_term_item = KOrderKByOrderingTermItemListItem {
            k_order,
            k_by,
            ordering_term,
            comma_ordering_term_list,
        };
        Option::<KOrderKByOrderingTermItemListItem>::Some(k_order_k_by_ordering_term_item)
    } else {
        null
    };
    let k_limit_expr_item: Option<KLimitExprItemOptItem> = if p.peek_kind() == TK_K_LIMIT {
        let k_limit = p.expect(TK_K_LIMIT)?;
        let expr = parse_expr(p)?;
        let mut opt_scan_pos: i32 = -1;
        opt_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_274 = pos;
            sg_274: {
                pos = gp_274;
                sg_274_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_OFFSET { break sg_274_0; }
                    pos += 1;
                    break sg_274;
                }
                pos = gp_274;
                sg_274_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_274_1; }
                    pos += 1;
                    break sg_274;
                }
                break opt_scan;
            }
            pos = scan_expr(tokens, pos);
            if pos < 0 { break opt_scan; }
            opt_scan_pos = pos;
        }
        let item_expr: Option<ItemExprItem> = if opt_scan_pos >= 0 {
            let k_offset_or_comma = p.advance();
            let expr = parse_expr(p)?;
            let item_expr = ItemExprItem {
                k_offset_or_comma,
                expr,
            };
            Option::<ItemExprItem>::Some(item_expr)
        } else {
            null
        };
        let k_limit_expr_item = KLimitExprItemOptItem {
            k_limit,
            expr,
            item_expr,
        };
        Option::<KLimitExprItemOptItem>::Some(k_limit_expr_item)
    } else {
        null
    };
    return Result::<CompoundSelectStmtNode, ParseError>::Ok(CompoundSelectStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        select_core,
        item_select_core_list,
        k_order_k_by_ordering_term_item,
        k_limit_expr_item,
    });
}

fn parse_create_index_stmt(p: &mut Parser) -> Result<CreateIndexStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_create = p.expect(TK_K_CREATE)?;
    let k_unique: Option<Token> = if p.peek_kind() == TK_K_UNIQUE {
        let k_unique = p.expect(TK_K_UNIQUE)?;
        Option::<Token>::Some(k_unique)
    } else {
        null
    };
    let k_index = p.expect(TK_K_INDEX)?;
    let k_if_k_not_k_exists: Option<KIfKNotKExistsItem> = if p.peek_kind() == TK_K_IF && p.peek_at(1) == TK_K_NOT && p.peek_at(2) == TK_K_EXISTS {
        let k_if = p.expect(TK_K_IF)?;
        let k_not = p.expect(TK_K_NOT)?;
        let k_exists = p.expect(TK_K_EXISTS)?;
        let k_if_k_not_k_exists = KIfKNotKExistsItem {
            k_if,
            k_not,
            k_exists,
        };
        Option::<KIfKNotKExistsItem>::Some(k_if_k_not_k_exists)
    } else {
        null
    };
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        pos = scan_database_name(tokens, pos);
        if pos < 0 { break opt_scan; }
