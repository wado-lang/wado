        } else {
            null
        };
        let mut opt_scan_pos: i32 = -1;
        opt_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_341 = pos;
            sg_341: {
                pos = gp_341;
                sg_341_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_LEFT { break sg_341_0; }
                    pos += 1;
                    if pos < tokens.len() && tokens[pos].kind == TK_K_OUTER {
                        let sp = pos;
                        if pos >= tokens.len() || tokens[pos].kind != TK_K_OUTER { pos = -1; } else { pos += 1; }
                        if pos < 0 { pos = sp; }
                    }
                    break sg_341;
                }
                pos = gp_341;
                sg_341_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_INNER { break sg_341_1; }
                    pos += 1;
                    break sg_341;
                }
                pos = gp_341;
                sg_341_2: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_K_CROSS { break sg_341_2; }
                    pos += 1;
                    break sg_341;
                }
                break opt_scan;
            }
            opt_scan_pos = pos;
        }
        let group_0: Option<JoinOperatorGroup0> = if opt_scan_pos >= 0 {
            let group_0: JoinOperatorGroup0 = if p.peek_kind() == TK_K_LEFT {
                let k_left = p.expect(TK_K_LEFT)?;
                let k_outer: Option<Token> = if p.peek_kind() == TK_K_OUTER {
                    let k_outer = p.expect(TK_K_OUTER)?;
                    Option::<Token>::Some(k_outer)
                } else {
                    null
                };
                JoinOperatorGroup0::Alt0(JoinOperatorGroup0Alt0 {
                    k_left,
                    k_outer,
                })
            } else if p.peek_kind() == TK_K_INNER {
                let k_inner = p.expect(TK_K_INNER)?;
                JoinOperatorGroup0::Alt1(JoinOperatorGroup0Alt1 {
                    k_inner,
                })
            } else {
                let k_cross = p.expect(TK_K_CROSS)?;
                JoinOperatorGroup0::Alt2(JoinOperatorGroup0Alt2 {
                    k_cross,
                })
            };
            Option::<JoinOperatorGroup0>::Some(group_0)
        } else {
            null
        };
        let k_join = p.expect(TK_K_JOIN)?;
        return Result::<JoinOperatorNode, ParseError>::Ok(JoinOperatorNode::Alt1(JoinOperatorAlt1 {
            span: Span::new(start, p.last_end()),
            k_natural,
            group_0,
            k_join,
        }));
    }
    return Result::<JoinOperatorNode, ParseError>::Err(ParseError::new(
        "expected join_operator",
        p.peek().span,
        ["TK_LIT_COMMA", "TK_K_NATURAL", "TK_K_LEFT", "TK_K_INNER", "TK_K_CROSS", "TK_K_JOIN"],
    ));
}

