            if chars[start + 0].eq_ignore_ascii_case(&'d') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'a') && chars[start + 4].eq_ignore_ascii_case(&'u') && chars[start + 5].eq_ignore_ascii_case(&'l') && chars[start + 6].eq_ignore_ascii_case(&'t') { return TK_K_DEFAULT; }
        } else if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 0].eq_ignore_ascii_case(&'e') && chars[start + 1].eq_ignore_ascii_case(&'x') && chars[start + 2].eq_ignore_ascii_case(&'p') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'a') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'n') { return TK_K_EXPLAIN; }
        } else if chars[start].eq_ignore_ascii_case(&'f') {
            if chars[start + 0].eq_ignore_ascii_case(&'f') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'g') && chars[start + 6].eq_ignore_ascii_case(&'n') { return TK_K_FOREIGN; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'d') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'x') && chars[start + 5].eq_ignore_ascii_case(&'e') && chars[start + 6].eq_ignore_ascii_case(&'d') { return TK_K_INDEXED; }
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'d') { return TK_K_INSTEAD; }
        } else if chars[start].eq_ignore_ascii_case(&'n') {
            if chars[start + 0].eq_ignore_ascii_case(&'n') && chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'u') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'l') { return TK_K_NATURAL; }
            if chars[start + 0].eq_ignore_ascii_case(&'n') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'n') && chars[start + 4].eq_ignore_ascii_case(&'u') && chars[start + 5].eq_ignore_ascii_case(&'l') && chars[start + 6].eq_ignore_ascii_case(&'l') { return TK_K_NOTNULL; }
        } else if chars[start].eq_ignore_ascii_case(&'p') {
            if chars[start + 0].eq_ignore_ascii_case(&'p') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'m') && chars[start + 4].eq_ignore_ascii_case(&'a') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'y') { return TK_K_PRIMARY; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'n') && chars[start + 4].eq_ignore_ascii_case(&'d') && chars[start + 5].eq_ignore_ascii_case(&'e') && chars[start + 6].eq_ignore_ascii_case(&'x') { return TK_K_REINDEX; }
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'l') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'a') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'e') { return TK_K_RELEASE; }
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'p') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'a') && chars[start + 5].eq_ignore_ascii_case(&'c') && chars[start + 6].eq_ignore_ascii_case(&'e') { return TK_K_REPLACE; }
        } else if chars[start].eq_ignore_ascii_case(&'t') {
            if chars[start + 0].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'g') && chars[start + 4].eq_ignore_ascii_case(&'g') && chars[start + 5].eq_ignore_ascii_case(&'e') && chars[start + 6].eq_ignore_ascii_case(&'r') { return TK_K_TRIGGER; }
        } else if chars[start].eq_ignore_ascii_case(&'v') {
            if chars[start + 0].eq_ignore_ascii_case(&'v') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'u') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'l') { return TK_K_VIRTUAL; }
        } else if chars[start].eq_ignore_ascii_case(&'w') {
            if chars[start + 0].eq_ignore_ascii_case(&'w') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'h') && chars[start + 4].eq_ignore_ascii_case(&'o') && chars[start + 5].eq_ignore_ascii_case(&'u') && chars[start + 6].eq_ignore_ascii_case(&'t') { return TK_K_WITHOUT; }
        }
    } else if len == 8 {
        if chars[start].eq_ignore_ascii_case(&'c') {
            if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'n') && chars[start + 3].eq_ignore_ascii_case(&'f') && chars[start + 4].eq_ignore_ascii_case(&'l') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_CONFLICT; }
        } else if chars[start].eq_ignore_ascii_case(&'d') {
            if chars[start + 0].eq_ignore_ascii_case(&'d') && chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'a') && chars[start + 4].eq_ignore_ascii_case(&'b') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'s') && chars[start + 7].eq_ignore_ascii_case(&'e') { return TK_K_DATABASE; }
            if chars[start + 0].eq_ignore_ascii_case(&'d') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'e') && chars[start + 7].eq_ignore_ascii_case(&'d') { return TK_K_DEFERRED; }
            if chars[start + 0].eq_ignore_ascii_case(&'d') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_DISTINCT; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_RESTRICT; }
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'l') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'b') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'k') { return TK_K_ROLLBACK; }
        }
    } else if len == 9 {
        if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 0].eq_ignore_ascii_case(&'e') && chars[start + 1].eq_ignore_ascii_case(&'x') && chars[start + 2].eq_ignore_ascii_case(&'c') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'u') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'v') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_EXCLUSIVE; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'m') && chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'d') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'t') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_IMMEDIATE; }
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'l') && chars[start + 7].eq_ignore_ascii_case(&'l') && chars[start + 8].eq_ignore_ascii_case(&'y') { return TK_K_INITIALLY; }
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'e') && chars[start + 7].eq_ignore_ascii_case(&'c') && chars[start + 8].eq_ignore_ascii_case(&'t') { return TK_K_INTERSECT; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'c') && chars[start + 3].eq_ignore_ascii_case(&'u') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'v') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_RECURSIVE; }
        } else if chars[start].eq_ignore_ascii_case(&'s') {
            if chars[start + 0].eq_ignore_ascii_case(&'s') && chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'v') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'p') && chars[start + 5].eq_ignore_ascii_case(&'o') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'n') && chars[start + 8].eq_ignore_ascii_case(&'t') { return TK_K_SAVEPOINT; }
        } else if chars[start].eq_ignore_ascii_case(&'t') {
            if chars[start + 0].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'p') && chars[start + 4].eq_ignore_ascii_case(&'o') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'r') && chars[start + 8].eq_ignore_ascii_case(&'y') { return TK_K_TEMPORARY; }
        }
    } else if len == 10 {
        if chars[start].eq_ignore_ascii_case(&'c') {
            if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'n') && chars[start + 3].eq_ignore_ascii_case(&'s') && chars[start + 4].eq_ignore_ascii_case(&'t') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'i') && chars[start + 8].eq_ignore_ascii_case(&'n') && chars[start + 9].eq_ignore_ascii_case(&'t') { return TK_K_CONSTRAINT; }
        } else if chars[start].eq_ignore_ascii_case(&'d') {
            if chars[start + 0].eq_ignore_ascii_case(&'d') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'b') && chars[start + 8].eq_ignore_ascii_case(&'l') && chars[start + 9].eq_ignore_ascii_case(&'e') { return TK_K_DEFERRABLE; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'e') && chars[start + 6].eq_ignore_ascii_case(&'n') && chars[start + 7].eq_ignore_ascii_case(&'c') && chars[start + 8].eq_ignore_ascii_case(&'e') && chars[start + 9].eq_ignore_ascii_case(&'s') { return TK_K_REFERENCES; }
        }
    } else if len == 11 {
        if chars[start + 0].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'a') && chars[start + 3].eq_ignore_ascii_case(&'n') && chars[start + 4].eq_ignore_ascii_case(&'s') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') && chars[start + 8].eq_ignore_ascii_case(&'i') && chars[start + 9].eq_ignore_ascii_case(&'o') && chars[start + 10].eq_ignore_ascii_case(&'n') { return TK_K_TRANSACTION; }
    } else if len == 12 {
        if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' && chars[start + 8].eq_ignore_ascii_case(&'d') && chars[start + 9].eq_ignore_ascii_case(&'a') && chars[start + 10].eq_ignore_ascii_case(&'t') && chars[start + 11].eq_ignore_ascii_case(&'e') { return TK_K_CURRENT_DATE; }
        if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' && chars[start + 8].eq_ignore_ascii_case(&'t') && chars[start + 9].eq_ignore_ascii_case(&'i') && chars[start + 10].eq_ignore_ascii_case(&'m') && chars[start + 11].eq_ignore_ascii_case(&'e') { return TK_K_CURRENT_TIME; }
    } else if len == 13 {
        if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'o') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'r') && chars[start + 8].eq_ignore_ascii_case(&'e') && chars[start + 9].eq_ignore_ascii_case(&'m') && chars[start + 10].eq_ignore_ascii_case(&'e') && chars[start + 11].eq_ignore_ascii_case(&'n') && chars[start + 12].eq_ignore_ascii_case(&'t') { return TK_K_AUTOINCREMENT; }
    } else if len == 17 {
        if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' && chars[start + 8].eq_ignore_ascii_case(&'t') && chars[start + 9].eq_ignore_ascii_case(&'i') && chars[start + 10].eq_ignore_ascii_case(&'m') && chars[start + 11].eq_ignore_ascii_case(&'e') && chars[start + 12].eq_ignore_ascii_case(&'s') && chars[start + 13].eq_ignore_ascii_case(&'t') && chars[start + 14].eq_ignore_ascii_case(&'a') && chars[start + 15].eq_ignore_ascii_case(&'m') && chars[start + 16].eq_ignore_ascii_case(&'p') { return TK_K_CURRENT_TIMESTAMP; }
    }
    return -1;
}

pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = [];
    let mut trivia: Array<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        let mut best_channel: i32 = 0;
        if first_char == '\t' || first_char == '\n' || first_char == '\u{b}' || first_char == '\r' || first_char == ' ' {
            end = try_spaces(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SPACES; best_channel = 1; }
        } else if first_char == '!' {
            end = try_lit_bangeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANGEQ; best_channel = 0; }
        } else if first_char == '"' || first_char == '[' || first_char == '_' || first_char == '`' {
            end = try_identifier(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
        } else if first_char == '$' || first_char == ':' || first_char == '?' || first_char == '@' {
            end = try_bind_parameter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BIND_PARAMETER; best_channel = 0; }
        } else if first_char == '%' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_PERCENT; best_channel = 0; }
        } else if first_char == '&' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_AMP; best_channel = 0; }
        } else if first_char == '\'' {
            end = try_string_literal(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STRING_LITERAL; best_channel = 0; }
        } else if first_char == '(' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LPAREN; best_channel = 0; }
        } else if first_char == ')' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_RPAREN; best_channel = 0; }
        } else if first_char == '*' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_STAR; best_channel = 0; }
        } else if first_char == '+' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_PLUS; best_channel = 0; }
        } else if first_char == ',' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_COMMA; best_channel = 0; }
        } else if first_char == '-' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_MINUS; best_channel = 0; }
            end = try_single_line_comment(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SINGLE_LINE_COMMENT; best_channel = 1; }
        } else if first_char == '.' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_DOT; best_channel = 0; }
            end = try_numeric_literal(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
        } else if first_char == '/' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_SLASH; best_channel = 0; }
            end = try_multiline_comment(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MULTILINE_COMMENT; best_channel = 1; }
        } else if first_char == ';' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_SEMI; best_channel = 0; }
        } else if first_char == '<' {
            end = try_lit_ltlt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTLT; best_channel = 0; }
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LT; best_channel = 0; }
            end = try_lit_lteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTEQ; best_channel = 0; }
            end = try_lit_ltgt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTGT; best_channel = 0; }
        } else if first_char == '=' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_EQ; best_channel = 0; }
            end = try_lit_eqeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_EQEQ; best_channel = 0; }
        } else if first_char == '>' {
            end = try_lit_gtgt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTGT; best_channel = 0; }
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_GT; best_channel = 0; }
            end = try_lit_gteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTEQ; best_channel = 0; }
        } else if first_char == 'X' || first_char == 'x' {
            end = try_identifier(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
            end = try_blob_literal(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOB_LITERAL; best_channel = 0; }
        } else if first_char == '|' {
            end = try_lit_pipepipe(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PIPEPIPE; best_channel = 0; }
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_PIPE; best_channel = 0; }
        } else if first_char == '~' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_TILDE; best_channel = 0; }
        } else if 'a' <= first_char <= 'z' {
            end = try_identifier(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_identifier(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
        } else if '0' <= first_char <= '9' {
            end = try_numeric_literal(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
        } else {
            end = try_identifier(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
            end = try_numeric_literal(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
            end = try_unexpected_char(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        }
        if best_end > start {
            let kw_kind = classify_keyword(&lexer.chars, start, best_end);
            if kw_kind >= 0 { best_kind = kw_kind; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = false;
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else if best_channel != 0 {
                trivia.push(Token::with_channel(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), [], best_channel));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

