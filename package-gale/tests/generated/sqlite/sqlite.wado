        }
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let lparen_column_name_item_rparen = LparenColumnNameItemListRparenItem {
            lparen,
            column_name,
            comma_column_name_list,
            rparen,
        };
        Option::<LparenColumnNameItemListRparenItem>::Some(lparen_column_name_item_rparen)
    } else {
        null
    };
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_316 = pos;
            let sgk_316 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
            if _gale_kind_set_38(sgk_316) {
                sg_316: {
                    pos = gp_316;
                    sg_316_0: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_K_ON { break sg_316_0; }
                        pos += 1;
                        let gp_317 = pos;
                        sg_317: {
                            pos = gp_317;
                            sg_317_0: {
                                if pos >= tokens.len() || tokens[pos].kind != TK_K_DELETE { break sg_317_0; }
                                pos += 1;
                                break sg_317;
                            }
                            pos = gp_317;
                            sg_317_1: {
                                if pos >= tokens.len() || tokens[pos].kind != TK_K_UPDATE { break sg_317_1; }
                                pos += 1;
                                break sg_317;
                            }
