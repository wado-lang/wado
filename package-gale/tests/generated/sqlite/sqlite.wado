fn parse_table_alias(p: &mut Parser) -> Result<TableAliasNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        let identifier = p.expect(TK_IDENTIFIER)?;
        return Result::<TableAliasNode, ParseError>::Ok(TableAliasNode::Alt0(TableAliasAlt0 {
            span: Span::new(start, p.last_end()),
            identifier,
        }));
    }
    if kind == TK_STRING_LITERAL {
        let string_literal = p.expect(TK_STRING_LITERAL)?;
        return Result::<TableAliasNode, ParseError>::Ok(TableAliasNode::Alt1(TableAliasAlt1 {
            span: Span::new(start, p.last_end()),
            string_literal,
        }));
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let table_alias = parse_table_alias(p)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::<TableAliasNode, ParseError>::Ok(TableAliasNode::Alt2(TableAliasAlt2 {
            span: Span::new(start, p.last_end()),
            lparen,
            table_alias,
            rparen,
        }));
    }
    return Result::<TableAliasNode, ParseError>::Err(ParseError::new(
        "expected table_alias",
        p.peek().span,
        ["TK_IDENTIFIER", "TK_STRING_LITERAL", "TK_LIT_LPAREN"],
    ));
}

