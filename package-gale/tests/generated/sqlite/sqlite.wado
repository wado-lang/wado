fn classify_keyword(chars: &Array<char>, start: i32, end: i32) -> i32 {
    let len = end - start;
    if len == 2 {
        if chars[start].eq_ignore_ascii_case(&'a') {
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'s') { return TK_K_AS; }
        } else if chars[start].eq_ignore_ascii_case(&'b') {
            if chars[start + 0].eq_ignore_ascii_case(&'b') && chars[start + 1].eq_ignore_ascii_case(&'y') { return TK_K_BY; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'f') { return TK_K_IF; }
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'n') { return TK_K_IN; }
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'s') { return TK_K_IS; }
        } else if chars[start].eq_ignore_ascii_case(&'n') {
            if chars[start + 0].eq_ignore_ascii_case(&'n') && chars[start + 1].eq_ignore_ascii_case(&'o') { return TK_K_NO; }
        } else if chars[start].eq_ignore_ascii_case(&'o') {
            if chars[start + 0].eq_ignore_ascii_case(&'o') && chars[start + 1].eq_ignore_ascii_case(&'f') { return TK_K_OF; }
            if chars[start + 0].eq_ignore_ascii_case(&'o') && chars[start + 1].eq_ignore_ascii_case(&'n') { return TK_K_ON; }
            if chars[start + 0].eq_ignore_ascii_case(&'o') && chars[start + 1].eq_ignore_ascii_case(&'r') { return TK_K_OR; }
        } else if chars[start].eq_ignore_ascii_case(&'t') {
            if chars[start + 0].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'o') { return TK_K_TO; }
        }
    } else if len == 3 {
        if chars[start].eq_ignore_ascii_case(&'a') {
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'d') && chars[start + 2].eq_ignore_ascii_case(&'d') { return TK_K_ADD; }
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'l') && chars[start + 2].eq_ignore_ascii_case(&'l') { return TK_K_ALL; }
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'d') { return TK_K_AND; }
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'s') && chars[start + 2].eq_ignore_ascii_case(&'c') { return TK_K_ASC; }
        } else if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 0].eq_ignore_ascii_case(&'e') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'d') { return TK_K_END; }
        } else if chars[start].eq_ignore_ascii_case(&'f') {
            if chars[start + 0].eq_ignore_ascii_case(&'f') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'r') { return TK_K_FOR; }
        } else if chars[start].eq_ignore_ascii_case(&'k') {
            if chars[start + 0].eq_ignore_ascii_case(&'k') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'y') { return TK_K_KEY; }
        } else if chars[start].eq_ignore_ascii_case(&'n') {
            if chars[start + 0].eq_ignore_ascii_case(&'n') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'t') { return TK_K_NOT; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'w') { return TK_K_ROW; }
        } else if chars[start].eq_ignore_ascii_case(&'s') {
            if chars[start + 0].eq_ignore_ascii_case(&'s') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'t') { return TK_K_SET; }
        }
    } else if len == 4 {
        if chars[start].eq_ignore_ascii_case(&'c') {
            if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'e') { return TK_K_CASE; }
