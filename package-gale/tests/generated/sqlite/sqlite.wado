                pos += 1;
                pos = scan_index_name(tokens, pos);
                if pos < 0 { break sg_322_0; }
                break sg_322;
            }
            pos = gp_322;
            sg_322_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_NOT { break sg_322_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_K_INDEXED { break sg_322_1; }
                pos += 1;
                break sg_322;
            }
            break opt_scan_2;
        }
        opt_scan_pos_2 = pos;
    }
    let group_0: Option<QualifiedTableNameGroup0> = if opt_scan_pos_2 >= 0 {
        let group_0: QualifiedTableNameGroup0 = if p.peek_kind() == TK_K_INDEXED {
            let k_indexed = p.expect(TK_K_INDEXED)?;
            let k_by = p.expect(TK_K_BY)?;
            let index_name = parse_index_name(p)?;
            QualifiedTableNameGroup0::Alt0(QualifiedTableNameGroup0Alt0 {
                k_indexed,
                k_by,
                index_name,
