                        }
                        let gp_318 = pos;
                        let sgk_318 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
                        if _gale_kind_set_39(sgk_318) {
                            let mut sg_318_best = -1;
                            sg_318: {
                                pos = gp_318;
                                sg_318_0: {
                                    if pos >= tokens.len() || tokens[pos].kind != TK_K_SET { break sg_318_0; }
                                    pos += 1;
                                    if pos >= tokens.len() || tokens[pos].kind != TK_K_NULL { break sg_318_0; }
                                    pos += 1;
                                    if pos > sg_318_best { sg_318_best = pos; }
                                }
                                pos = gp_318;
                                sg_318_1: {
                                    if pos >= tokens.len() || tokens[pos].kind != TK_K_SET { break sg_318_1; }
                                    pos += 1;
                                    if pos >= tokens.len() || tokens[pos].kind != TK_K_DEFAULT { break sg_318_1; }
                                    pos += 1;
                                    if pos > sg_318_best { sg_318_best = pos; }
                                }
                                pos = gp_318;
                                sg_318_2: {
