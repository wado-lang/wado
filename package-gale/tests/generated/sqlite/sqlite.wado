                                    pos += 1;
                                    break sg_318;
                                }
                                pos = gp_318;
                                sg_318_4: {
                                    if pos >= tokens.len() || tokens[pos].kind != TK_K_NO { break sg_318_4; }
                                    pos += 1;
                                    if pos >= tokens.len() || tokens[pos].kind != TK_K_ACTION { break sg_318_4; }
                                    pos += 1;
                                    break sg_318;
                                }
                                if sg_318_best >= 0 { pos = sg_318_best; break sg_318; }
                                pos = gp_318;
                            }
                        }
                        break sg_316;
                    }
                    pos = gp_316;
                    sg_316_1: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_K_MATCH { break sg_316_1; }
                        pos += 1;
                        pos = scan_name(tokens, pos);
                        if pos < 0 { break sg_316_1; }
                        break sg_316;
                    }
                    pos = gp_316;
                }
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let mut group_0_inner: Option<ForeignKeyClauseGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_K_ON {
            let k_on = p.expect(TK_K_ON)?;
            let k_delete_or_k_update = p.advance();
            let mut group_1_inner: Option<ForeignKeyClauseGroup1> = null;
            let grp_kind = p.peek_kind();
            if grp_kind == TK_K_SET {
                let mut gd_winner: i32 = -1;
