    let kind = p.peek_kind();
    if kind == TK_ID {
        let _sd_tokens = &p.kinds;
        let _sd_pos = p.pos;
        let _sd_p_1 = _parse_typespec__inner_scan_1(_sd_tokens, _sd_pos);
        let _sd_p_0 = _parse_typespec__inner_scan_0(_sd_tokens, _sd_pos);
        let mut _sd_best_i: i32 = -1;
        let mut _sd_best_p: i32 = -1;
        if _sd_p_1 > _sd_best_p {
            _sd_best_p = _sd_p_1;
            _sd_best_i = 1;
        }
        if _sd_p_0 > _sd_best_p {
            _sd_best_p = _sd_p_0;
            _sd_best_i = 0;
        }
        if _sd_best_i == 1 {
            return _parse_typespec__inner_alt_1(p, follow);
        }
        if _sd_best_i == 0 {
            return _parse_typespec__inner_alt_0(p, follow);
        }
        return _parse_typespec__inner_alt_0(p, follow);
    }
    if kind == TK_LIT_INT {
        let _sd_tokens = &p.kinds;
        let _sd_pos = p.pos;
        let _sd_p_3 = _parse_typespec__inner_scan_3(_sd_tokens, _sd_pos);
        let _sd_p_2 = _parse_typespec__inner_scan_2(_sd_tokens, _sd_pos);
        let mut _sd_best_i: i32 = -1;
        let mut _sd_best_p: i32 = -1;
        if _sd_p_3 > _sd_best_p {
            _sd_best_p = _sd_p_3;
            _sd_best_i = 3;
        }
        if _sd_p_2 > _sd_best_p {
            _sd_best_p = _sd_p_2;
            _sd_best_i = 2;
        }
        if _sd_best_i == 3 {
            return _parse_typespec__inner_alt_3(p, follow);
        }
        if _sd_best_i == 2 {
            return _parse_typespec__inner_alt_2(p, follow);
        }
        return _parse_typespec__inner_alt_2(p, follow);
    }
    return Result::Err(p.error(
        "expected typespec",
        p.peek_span(),
        ["TK_ID", "TK_LIT_INT"],
    ));
}

fn _parse_typespec(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<TypespecNode, ParseError> {
    return _gale_rule(_parse_typespec__inner(p, follow), "typespec");
}

fn _gale_rule<T>(r: Result<T, ParseError>, rule: String) -> Result<T, ParseError> {
    if let Err(mut e) = r {
        e.rule_stack.push(rule);
        return Result::Err(e);
    }
    return r;
}

fn _gale_run<T>(input: &String, run: fn(&mut Parser) -> Result<T, ParseError>) -> Result<ParseResult<T>, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = run(&mut parser);
    if let Err(_e) = _result {
        return Result::Err(_gale_pick_error(&parser, _e));
    }
    if let Ok(_root) = _result {
        return Result::Ok(ParseResult { root: _root, tokens: parser.tokens });
    }
    unreachable();
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    return Parser::new(tokens);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_s(input: &String) -> Result<ParseResult<SNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_s(p));
}

pub fn parse_expression_list(input: &String) -> Result<ParseResult<ExpressionListNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_expression_list(p));
}

pub fn parse_e(input: &String) -> Result<ParseResult<ENode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_e(p));
}

pub fn parse_typespec(input: &String) -> Result<ParseResult<TypespecNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_typespec(p));
}

pub fn parse(input: &String) -> Result<ParseResult<SNode>, ParseError> {
    return parse_s(input);
}

pub fn walk_s<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SNode) {
    v.enter_rule(0, &"s", &node.span);
    walk_e(v, toks, &node.e);
    v.visit_token(toks, *(&node.eof));
    v.exit_rule(0, &"s", &node.span);
}

pub fn walk_expressionList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExpressionListNode) {
    v.enter_rule(1, &"expressionList", &node.span);
    walk_e(v, toks, &node.e);
    for let item of &node.comma_e_list {
        v.visit_token(toks, *(&item.comma));
        walk_e(v, toks, &item.e);
    }
    v.exit_rule(1, &"expressionList", &node.span);
}

pub fn walk_e<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ENode) {
    match node {
        Alt0(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.lit_this));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.lit_super));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.int));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.id));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_typespec(v, toks, &n.typespec);
            v.visit_token(toks, *(&n.dot));
            v.visit_token(toks, *(&n.lit_class));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.dot));
            v.visit_token(toks, *(&n.id));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.dot));
            v.visit_token(toks, *(&n.lit_this));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.dot));
            v.visit_token(toks, *(&n.lit_super));
            v.visit_token(toks, *(&n.lparen));
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, toks, item);
            }
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.dot));
            v.visit_token(toks, *(&n.lit_new));
            v.visit_token(toks, *(&n.id));
            v.visit_token(toks, *(&n.lparen));
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, toks, item);
            }
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.lit_new));
            walk_typespec(v, toks, &n.typespec);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(toks, *(&inner.lparen));
                        if let Some(item) = &inner.expression_list {
                            walk_expressionList(v, toks, item);
                        }
                        v.visit_token(toks, *(&inner.rparen));
                    }
                    Alt1(inner) => {
                        for let item of &inner.lbracket_e_rbracket_list {
                            v.visit_token(toks, *(&item.lbracket));
                            walk_e(v, toks, &item.e);
                            v.visit_token(toks, *(&item.rbracket));
                        }
                    }
                }
            }
            v.exit_rule(2, &"e", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lbracket));
            walk_e(v, toks, &n.e_2);
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_typespec(v, toks, &n.typespec);
            v.visit_token(toks, *(&n.rparen));
            walk_e(v, toks, &n.e);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lit_plusplus_or_lit_minusminus));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt14(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lparen));
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, toks, item);
            }
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(2, &"e", &n.span);
        }
        Alt15(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.plus_or_minus_or_lit_plusplus_or_lit_minusminus));
            walk_e(v, toks, &n.e);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt16(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(toks, *(&n.tilde_or_bang));
            walk_e(v, toks, &n.e);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt17(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.star_or_slash_or_percent));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt18(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.plus_or_minus));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt19(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lit_ltlt_or_lit_gtgtgt_or_lit_gtgt));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt20(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lit_lteq_or_lit_gteq_or_gt_or_lt));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt21(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lit_instanceof));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt22(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lit_eqeq_or_lit_bangeq));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt23(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.amp));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt24(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.caret));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt25(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.pipe));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt26(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lit_ampamp));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt27(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.lit_pipepipe));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt28(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.question));
            walk_e(v, toks, &n.e_2);
            v.visit_token(toks, *(&n.colon));
            walk_e(v, toks, &n.e_3);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt29(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, toks, &n.e);
            v.visit_token(toks, *(&n.eq_or_lit_pluseq_or_lit_minuseq_or_lit_stareq_or_lit_slasheq_or_lit_ampeq_or_lit_pipeeq_or_lit_careteq_or_lit_gtgteq_or_lit_gtgtgteq_or_lit_ltlteq_or_lit_percenteq));
            walk_e(v, toks, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
    }
}

pub fn walk_typespec<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypespecNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(toks, *(&n.id));
            v.exit_rule(3, &"typespec", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(toks, *(&n.id));
            v.visit_token(toks, *(&n.lbracket));
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(3, &"typespec", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(toks, *(&n.lit_int));
            v.exit_rule(3, &"typespec", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(toks, *(&n.lit_int));
            v.visit_token(toks, *(&n.lbracket));
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(3, &"typespec", &n.span);
        }
    }
}

pub fn to_tree(result: &ParseResult<SNode>) -> CstNode {
    let mut recorder = TreeRecorder::new(&result.tokens);
    walk_s(&mut recorder, &result.tokens, &result.root);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_ID | TK_INT | TK_LIT_BANG | TK_LIT_INT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_NEW | TK_LIT_PLUS | TK_LIT_PLUSPLUS | TK_LIT_SUPER | TK_LIT_THIS | TK_LIT_TILDE };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_LIT_LBRACKET | TK_LIT_LPAREN };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_PLUSPLUS };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_LIT_BANG | TK_LIT_TILDE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_LIT_MINUSMINUS | TK_LIT_PLUSPLUS };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_LIT_PERCENT | TK_LIT_SLASH | TK_LIT_STAR };
}

fn _gale_kind_set_6(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_PLUS };
}

fn _gale_kind_set_7(k: i32) -> bool {
    return k matches { TK_LIT_GTGT | TK_LIT_GTGTGT | TK_LIT_LTLT };
}

fn _gale_kind_set_8(k: i32) -> bool {
    return k matches { TK_LIT_GT | TK_LIT_GTEQ | TK_LIT_LT | TK_LIT_LTEQ };
}

fn _gale_kind_set_9(k: i32) -> bool {
    return k matches { TK_LIT_BANGEQ | TK_LIT_EQEQ };
}

fn _gale_kind_set_10(k: i32) -> bool {
    return k matches { TK_LIT_AMPEQ | TK_LIT_CARETEQ | TK_LIT_EQ | TK_LIT_GTGTEQ | TK_LIT_GTGTGTEQ | TK_LIT_LTLTEQ | TK_LIT_MINUSEQ | TK_LIT_PERCENTEQ | TK_LIT_PIPEEQ | TK_LIT_PLUSEQ | TK_LIT_SLASHEQ | TK_LIT_STAREQ };
}

fn _gale_kind_set_11(k: i32) -> bool {
    return k matches { TK_ID | TK_LIT_INT };
}

global FOLLOW_MASK_0: List<List<i32>> = [[TK_EOF]];
global FOLLOW_MASK_1: List<List<i32>> = [[TK_LIT_RPAREN]];
global FOLLOW_MASK_2: List<List<i32>> = [[TK_LIT_DOT], [TK_LIT_CLASS]];
global FOLLOW_MASK_3: List<List<i32>> = [[TK_LIT_LBRACKET, TK_LIT_LPAREN]];
global FOLLOW_MASK_4: List<List<i32>> = [[TK_LIT_RBRACKET]];
global FOLLOW_MASK_5: List<List<i32>> = [[TK_LIT_COLON]];

