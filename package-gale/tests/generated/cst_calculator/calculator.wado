fn _parse_signed_atom__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_PLUS {
        let plus = p.expect(TK_PLUS, &SYNC_0);
        let signed_atom = _parse_signed_atom(p, follow);
        return;
    }
    if kind == TK_MINUS {
        let minus = p.expect(TK_MINUS, &SYNC_0);
        let signed_atom = _parse_signed_atom(p, follow);
        return;
    }
    if _kind_set_2(kind) {
        let func_ = _parse_func_(p, follow);
        return;
    }
    if _kind_set_3(kind) {
        let atom = _parse_atom(p, follow);
        return;
    }
    p.no_viable(
        "expected signedAtom",
        p.peek_span(),
        ["TK_PLUS", "TK_MINUS", "TK_COS", "TK_TAN", "TK_SIN", "TK_ACOS", "TK_ATAN", "TK_ASIN", "TK_LOG", "TK_LN", "TK_SQRT", "TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    );
    return;
}

fn _parse_signed_atom(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
