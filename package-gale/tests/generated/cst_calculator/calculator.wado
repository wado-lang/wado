    let alts_saved_0 = pos;
    let mut alts_ok_0 = false;
    alts_0_0: {
        pos = alts_saved_0;
        if pos >= chars.len() || !(chars[pos] matches { 'a'..='z' }) { break alts_0_0; }
        pos += 1;
        alts_ok_0 = true;
    }
    if !alts_ok_0 {
        alts_0_1: {
            pos = alts_saved_0;
            if pos >= chars.len() || !(chars[pos] matches { 'A'..='Z' }) { break alts_0_1; }
            pos += 1;
            alts_ok_0 = true;
        }
        if !alts_ok_0 {
            alts_0_2: {
                pos = alts_saved_0;
                if pos >= chars.len() || chars[pos] != '_' { break alts_0_2; }
                pos += 1;
