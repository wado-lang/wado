            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_COMMA, &SYNC_0);
        let expression = _parse_expression(p, follow);
    }
    let rparen = p.expect(TK_RPAREN, &EMPTY_SYNC);
    return;
