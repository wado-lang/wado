}

fn try_SQRT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 's' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'q' { return -1; }
