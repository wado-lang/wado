fn try_GT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '>' { return -1; }
    pos += 1;
    return pos;
}

fn try_LT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '<' { return -1; }
    pos += 1;
    return pos;
}

fn try_EQ(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '=' { return -1; }
    pos += 1;
    return pos;
}

fn try_COMMA(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ',' { return -1; }
    pos += 1;
    return pos;
}

fn try_POINT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '.' { return -1; }
    pos += 1;
    return pos;
}

fn try_POW(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '^' { return -1; }
    pos += 1;
    return pos;
}

fn try_PI(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'p' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'i' { return -1; }
    pos += 1;
    return pos;
}

fn try_VARIABLE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_0 = pos;
    let mut alts_ok_0 = false;
    alts_0_0: {
        pos = alts_saved_0;
        if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_0_0; }
        pos += 1;
        alts_ok_0 = true;
    }
    if !alts_ok_0 {
        alts_0_1: {
            pos = alts_saved_0;
            if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_0_1; }
            pos += 1;
            alts_ok_0 = true;
        }
        if !alts_ok_0 {
            alts_0_2: {
                pos = alts_saved_0;
                if pos >= chars.len() || chars[pos] != '_' { break alts_0_2; }
                pos += 1;
                alts_ok_0 = true;
            }
        }
    }
    if !alts_ok_0 { return -1; }
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            let alts_saved_2 = pos;
            let mut alts_ok_2 = false;
            alts_2_0: {
                pos = alts_saved_2;
                let alts_saved_3 = pos;
                let mut alts_ok_3 = false;
                alts_3_0: {
                    pos = alts_saved_3;
                    if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_3_0; }
                    pos += 1;
                    alts_ok_3 = true;
                }
                if !alts_ok_3 {
                    alts_3_1: {
                        pos = alts_saved_3;
                        if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_3_1; }
                        pos += 1;
                        alts_ok_3 = true;
                    }
                    if !alts_ok_3 {
                        alts_3_2: {
                            pos = alts_saved_3;
                            if pos >= chars.len() || chars[pos] != '_' { break alts_3_2; }
                            pos += 1;
                            alts_ok_3 = true;
                        }
                    }
                }
                if !alts_ok_3 { break alts_2_0; }
                alts_ok_2 = true;
            }
            if !alts_ok_2 {
                alts_2_1: {
                    pos = alts_saved_2;
                    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break alts_2_1; }
                    pos += 1;
                    alts_ok_2 = true;
                }
            }
            if !alts_ok_2 { break rep_1; }
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_SCIENTIFIC_NUMBER(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { return -1; }
    pos += 1;
    loop {
        let rep_saved_4 = pos;
        rep_4: {
            if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_4; }
            pos += 1;
            continue;
        }
        pos = rep_saved_4;
        break;
    }
    let opt_saved_5 = pos;
    let mut opt_ok_5 = false;
    rep_5: {
        if pos >= chars.len() || chars[pos] != '.' { break rep_5; }
        pos += 1;
        if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_5; }
        pos += 1;
        loop {
            let rep_saved_6 = pos;
            rep_6: {
                if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_6; }
                pos += 1;
                continue;
            }
            pos = rep_saved_6;
            break;
        }
        opt_ok_5 = true;
    }
    if !opt_ok_5 { pos = opt_saved_5; }
    let opt_saved_7 = pos;
    let mut opt_ok_7 = false;
    rep_7: {
        let alts_saved_8 = pos;
        let mut alts_ok_8 = false;
        alts_8_0: {
            pos = alts_saved_8;
            if pos >= chars.len() || chars[pos] != 'E' { break alts_8_0; }
            pos += 1;
            alts_ok_8 = true;
        }
        if !alts_ok_8 {
            alts_8_1: {
                pos = alts_saved_8;
                if pos >= chars.len() || chars[pos] != 'e' { break alts_8_1; }
                pos += 1;
                alts_ok_8 = true;
            }
        }
        if !alts_ok_8 { break rep_7; }
        let opt_saved_9 = pos;
        let mut opt_ok_9 = false;
        rep_9: {
            let alts_saved_10 = pos;
            let mut alts_ok_10 = false;
            alts_10_0: {
                pos = alts_saved_10;
                if pos >= chars.len() || chars[pos] != '+' { break alts_10_0; }
                pos += 1;
                alts_ok_10 = true;
            }
            if !alts_ok_10 {
                alts_10_1: {
                    pos = alts_saved_10;
                    if pos >= chars.len() || chars[pos] != '-' { break alts_10_1; }
                    pos += 1;
                    alts_ok_10 = true;
                }
            }
            if !alts_ok_10 { break rep_9; }
            opt_ok_9 = true;
        }
        if !opt_ok_9 { pos = opt_saved_9; }
        if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_7; }
        pos += 1;
        loop {
            let rep_saved_11 = pos;
            rep_11: {
                if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_11; }
                pos += 1;
                continue;
            }
            pos = rep_saved_11;
            break;
        }
        let opt_saved_12 = pos;
        let mut opt_ok_12 = false;
        rep_12: {
            if pos >= chars.len() || chars[pos] != '.' { break rep_12; }
            pos += 1;
            if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_12; }
            pos += 1;
            loop {
                let rep_saved_13 = pos;
                rep_13: {
                    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_13; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_13;
                break;
            }
            opt_ok_12 = true;
        }
        if !opt_ok_12 { pos = opt_saved_12; }
        opt_ok_7 = true;
    }
    if !opt_ok_7 { pos = opt_saved_7; }
    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { return -1; }
    pos += 1;
    loop {
        let rep_saved_14 = pos;
        rep_14: {
            if pos >= chars.len() { break rep_14; }
            if !(chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { break rep_14; }
            pos += 1;
            continue;
        }
        pos = rep_saved_14;
        break;
    }
    return pos;
}

fn classify_keyword(chars: &List<char>, start: i32, end: i32) -> i32 {
    let len = end - start;
    if len == 1 {
        if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 0] == 'e' { return TK_EULER; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0] == 'i' { return TK_I; }
        }
    }
    return -1;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '(' {
            end = try_LPAREN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LPAREN; }
        } else if first_char == ')' {
            end = try_RPAREN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_RPAREN; }
        } else if first_char == '*' {
            end = try_TIMES(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TIMES; }
        } else if first_char == '+' {
            end = try_PLUS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PLUS; }
        } else if first_char == ',' {
            end = try_COMMA(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMA; }
        } else if first_char == '-' {
            end = try_MINUS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MINUS; }
        } else if first_char == '.' {
            end = try_POINT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POINT; }
        } else if first_char == '/' {
            end = try_DIV(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DIV; }
        } else if first_char == '<' {
            end = try_LT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LT; }
        } else if first_char == '=' {
            end = try_EQ(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_EQ; }
        } else if first_char == '>' {
            end = try_GT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_GT; }
        } else if first_char == '^' {
            end = try_POW(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POW; }
        } else if first_char == '_' {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'a' {
            end = try_ACOS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ACOS; }
            end = try_ASIN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ASIN; }
            end = try_ATAN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ATAN; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'c' {
            end = try_COS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COS; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'l' {
            end = try_LN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LN; }
            end = try_LOG(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LOG; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'p' {
            end = try_PI(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PI; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 's' {
            end = try_SIN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SIN; }
            end = try_SQRT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SQRT; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 't' {
            end = try_TAN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAN; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'a' <= first_char <= 'z' {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if '0' <= first_char <= '9' {
            end = try_SCIENTIFIC_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        } else {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
            end = try_SCIENTIFIC_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        }
        if best_end > start {
            let kw_kind = classify_keyword(&lexer.chars, start, best_end);
            if kw_kind >= 0 { best_kind = kw_kind; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_COS => "COS",
        TK_SIN => "SIN",
        TK_TAN => "TAN",
        TK_ACOS => "ACOS",
        TK_ASIN => "ASIN",
        TK_ATAN => "ATAN",
        TK_LN => "LN",
        TK_LOG => "LOG",
        TK_SQRT => "SQRT",
        TK_LPAREN => "LPAREN",
        TK_RPAREN => "RPAREN",
        TK_PLUS => "PLUS",
        TK_MINUS => "MINUS",
        TK_TIMES => "TIMES",
        TK_DIV => "DIV",
        TK_GT => "GT",
        TK_LT => "LT",
        TK_EQ => "EQ",
        TK_COMMA => "COMMA",
        TK_POINT => "POINT",
        TK_POW => "POW",
        TK_PI => "PI",
        TK_EULER => "EULER",
        TK_I => "I",
        TK_VARIABLE => "VARIABLE",
        TK_SCIENTIFIC_NUMBER => "SCIENTIFIC_NUMBER",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

pub global RK_EQUATION: NodeKind = 0;
pub global RK_EXPRESSION: NodeKind = 1;
pub global RK_MULTIPLYINGEXPRESSION: NodeKind = 2;
pub global RK_POWEXPRESSION: NodeKind = 3;
pub global RK_SIGNEDATOM: NodeKind = 4;
pub global RK_ATOM: NodeKind = 5;
pub global RK_SCIENTIFIC: NodeKind = 6;
pub global RK_CONSTANT: NodeKind = 7;
pub global RK_VARIABLE: NodeKind = 8;
pub global RK_FUNC_: NodeKind = 9;
pub global RK_FUNCNAME: NodeKind = 10;
pub global RK_RELOP: NodeKind = 11;

global RULE_NAMES: List<String> = ["equation", "expression", "multiplyingExpression", "powExpression", "signedAtom", "atom", "scientific", "constant", "variable", "func_", "funcname", "relop"];

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, b: TreeBuilder::new(), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
        }
    }

    fn fail(&mut self, message: String, span: Span, expected: List<String>) {
        let e = self.error(message, span, expected);
        self.record_deeper(e);
        self.recovering = true;
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn pending_message(&self) -> String {
        if let Some(e) = &self.pending { return e.message; }
        return String::from("");
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        let name = token_kind_name(kind);
        self.fail(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        );
        return self.pos;
    }

    fn match_any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
        );
        return self.pos;
    }

    fn match_not(&mut self, excluded: List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
        }
        self.fail(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["set complement"],
        );
        return self.pos;
    }

    fn match_set(&mut self, included: List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
        }
        self.fail(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["token set"],
        );
        return self.pos;
    }
}

fn scan_equation(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_expression(tokens, pos, &FOLLOW_MASK_0, 0);
    if pos < 0 { return -1; }
    pos = scan_relop(tokens, pos, &FOLLOW_MASK_1, 0);
    if pos < 0 { return -1; }
    pos = scan_expression(tokens, pos, &FOLLOW_MASK_2, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_multiplying_expression(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _kind_set_0(tokens[pos]) && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                let gp_1 = pos;
                sg_1: {
                    pos = gp_1;
                    sg_1_0: {
                        if pos >= tokens.len() || tokens[pos] != TK_PLUS { break sg_1_0; }
                        pos += 1;
                        break sg_1;
                    }
                    pos = gp_1;
                    sg_1_1: {
                        if pos >= tokens.len() || tokens[pos] != TK_MINUS { break sg_1_1; }
                        pos += 1;
                        break sg_1;
                    }
                    break sg_0;
                }
                pos = scan_multiplying_expression(tokens, pos, follow, 0);
                if pos < 0 { break sg_0; }
