fn _parse_expression__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let multiplying_expression = _parse_multiplying_expression(p, follow);
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_6_done: {
                sg_6: {
                    let gp_7 = pos;
                    let sgk_7 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                    if _kind_set_0(sgk_7) {
                        sg_7: {
                            pos = gp_7;
                            sg_7_0: {
                                if pos >= tokens.len() || tokens[pos] != TK_PLUS { break sg_7_0; }
                                pos += 1;
                                break sg_7;
                            }
                            pos = gp_7;
                            sg_7_1: {
