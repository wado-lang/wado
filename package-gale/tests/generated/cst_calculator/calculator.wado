pub fn to_string_tree(result: &ParseResult) -> String {
    let mut token_names: List<String> = List::with_capacity(29);
    for let mut k = 0; k < 29; k += 1 {
        token_names.push(token_kind_name(k));
    }
    return result.root.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut token_names: List<String> = List::with_capacity(29);
    for let mut k = 0; k < 29; k += 1 {
        token_names.push(token_kind_name(k));
    }
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if let Some(sub) = result.root.find_child(_kind as NodeKind) {
        return sub.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_MINUS | TK_PLUS };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_DIV | TK_TIMES };
}

fn _kind_set_2(k: i32) -> bool {
    return k matches { TK_ACOS | TK_ASIN | TK_ATAN | TK_COS | TK_LN | TK_LOG | TK_SIN | TK_SQRT | TK_TAN };
}

fn _kind_set_3(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_LPAREN | TK_PI | TK_SCIENTIFIC_NUMBER | TK_VARIABLE };
}

fn _kind_set_4(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_PI };
}

fn _kind_set_5(k: i32) -> bool {
    return k matches { TK_EQ | TK_GT | TK_LT };
}

global FOLLOW_MASK_0: List<List<i32>> = [[TK_EQ, TK_GT, TK_LT]];
global FOLLOW_MASK_1: List<List<i32>> = [[TK_ACOS, TK_ASIN, TK_ATAN, TK_COS, TK_EULER, TK_I, TK_LN, TK_LOG, TK_LPAREN, TK_MINUS, TK_PI, TK_PLUS, TK_SCIENTIFIC_NUMBER, TK_SIN, TK_SQRT, TK_TAN, TK_VARIABLE]];
global FOLLOW_MASK_2: List<List<i32>> = [[TK_EOF]];
global FOLLOW_MASK_3: List<List<i32>> = [[TK_RPAREN]];
global FOLLOW_MASK_4: List<List<i32>> = [[TK_LPAREN]];
global FOLLOW_MASK_5: List<List<i32>> = [[TK_COMMA, TK_RPAREN]];

