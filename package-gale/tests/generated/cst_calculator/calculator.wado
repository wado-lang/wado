    let _start = p.peek_start();
    p.b.start_node(RK_SIGNEDATOM, _start);
    _parse_signed_atom__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("signedAtom");
    }
}

fn _parse_atom__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_SCIENTIFIC_NUMBER {
        let scientific = _parse_scientific(p, follow);
        return;
    }
    if kind == TK_VARIABLE {
        let variable = _parse_variable(p, follow);
        return;
    }
    if _kind_set_4(kind) {
        let constant = _parse_constant(p, follow);
        return;
    }
    if kind == TK_LPAREN {
        let lparen = p.expect(TK_LPAREN, &SYNC_0);
        let expression = _parse_expression(p, &FOLLOW_MASK_3);
        let rparen = p.expect(TK_RPAREN, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "expected atom",
        p.peek_span(),
        ["TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    );
    return;
}

