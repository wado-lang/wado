    if !alts_ok_0 { return -1; }
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            let alts_saved_2 = pos;
            let mut alts_ok_2 = false;
            alts_2_0: {
                pos = alts_saved_2;
                let alts_saved_3 = pos;
                let mut alts_ok_3 = false;
                alts_3_0: {
                    pos = alts_saved_3;
                    if pos >= chars.len() || !(chars[pos] matches { 'a'..='z' }) { break alts_3_0; }
                    pos += 1;
                    alts_ok_3 = true;
                }
                if !alts_ok_3 {
                    alts_3_1: {
                        pos = alts_saved_3;
                        if pos >= chars.len() || !(chars[pos] matches { 'A'..='Z' }) { break alts_3_1; }
                        pos += 1;
                        alts_ok_3 = true;
