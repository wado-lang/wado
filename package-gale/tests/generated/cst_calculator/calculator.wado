            if !alts_ok_2 {
                alts_2_1: {
                    pos = alts_saved_2;
                    if pos >= chars.len() || !(chars[pos] matches { '0'..='9' }) { break alts_2_1; }
                    pos += 1;
                    alts_ok_2 = true;
                }
            }
            if !alts_ok_2 { break rep_1; }
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

