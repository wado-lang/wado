| '\u{1193e}' | '\u{11943}' | '\u{119d4}'..='\u{119d7}' | '\u{119da}'..='\u{119db}' | '\u{119e0}' | '\u{11a01}'..='\u{11a0a}' | '\u{11a33}'..='\u{11a38}' | '\u{11a3b}'..='\u{11a3e}' | '\u{11a47}' | '\u{11a51}'..='\u{11a56}' | '\u{11a59}'..='\u{11a5b}' | '\u{11a8a}'..='\u{11a96}' | '\u{11a98}'..='\u{11a99}' | '\u{11b60}' | '\u{11b62}'..='\u{11b64}' | '\u{11b66}' | '\u{11c30}'..='\u{11c36}' | '\u{11c38}'..='\u{11c3d}' | '\u{11c3f}' | '\u{11c92}'..='\u{11ca7}' | '\u{11caa}'..='\u{11cb0}' | '\u{11cb2}'..='\u{11cb3}' | '\u{11cb5}'..='\u{11cb6}' | '\u{11d31}'..='\u{11d36}' | '\u{11d3a}' | '\u{11d3c}'..='\u{11d3d}' | '\u{11d3f}'..='\u{11d45}' | '\u{11d47}' | '\u{11d90}'..='\u{11d91}' | '\u{11d95}' | '\u{11d97}' | '\u{11ef3}'..='\u{11ef4}' | '\u{11f00}'..='\u{11f01}' | '\u{11f36}'..='\u{11f3a}' | '\u{11f40}' | '\u{11f42}' | '\u{11f5a}' | '\u{13440}' | '\u{13447}'..='\u{13455}' | '\u{1611e}'..='\u{16129}' | '\u{1612d}'..='\u{1612f}' | '\u{16af0}'..='\u{16af4}' | '\u{16b30}'..='\u{16b36}' | '\u{16f4f}' | '\u{16f8f}'..='\u{16f92}' | '\u{1bc9d}'..='\u{1bc9e}' | '\u{1cf00}'..='\u{1cf2d}' | '\u{1cf30}'..='\u{1cf46}' | '\u{1d167}'..='\u{1d169}' | '\u{1d17b}'..='\u{1d182}' | '\u{1d185}'..='\u{1d18b}' | '\u{1d1aa}'..='\u{1d1ad}' | '\u{1da00}'..='\u{1da36}' | '\u{1da3b}'..='\u{1da6c}' | '\u{1da75}' | '\u{1da84}' | '\u{1da9b}'..='\u{1da9f}' | '\u{1daa1}'..='\u{1daaf}' | '\u{1e000}'..='\u{1e006}' | '\u{1e008}'..='\u{1e018}' | '\u{1e01b}'..='\u{1e021}' | '\u{1e023}'..='\u{1e024}' | '\u{1e026}'..='\u{1e02a}' | '\u{1e08f}' | '\u{1e130}'..='\u{1e136}' | '\u{1e2ae}' | '\u{1e2ec}'..='\u{1e2ef}' | '\u{1e4ec}'..='\u{1e4ef}' | '\u{1e5ee}'..='\u{1e5ef}' | '\u{1e6e3}' | '\u{1e6e6}' | '\u{1e6ee}'..='\u{1e6ef}' | '\u{1e6f5}' | '\u{1e8d0}'..='\u{1e8d6}' | '\u{1e944}'..='\u{1e94a}' | '\u{e0100}'..='\u{e01ef}' => {
                end = try_GREEKMARK(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_GREEKMARK; }
            },
            'Ͱ'..='ͳ' | '͵'..='ͷ' | 'ͺ'..='ͽ' | 'Ϳ' | '΄' | 'Ά' | 'Έ'..='Ί' | 'Ό' | 'Ύ'..='Ρ' | 'Σ'..='ϡ' | 'ϰ'..='Ͽ' | 'ᴦ'..='ᴪ' | 'ᵝ'..='ᵡ' | 'ᵦ'..='ᵪ' | 'ᶿ' | 'ἀ'..='ἕ' | 'Ἐ'..='Ἕ' | 'ἠ'..='ὅ' | 'Ὀ'..='Ὅ' | 'ὐ'..='ὗ' | 'Ὑ' | 'Ὓ' | 'Ὕ' | 'Ὗ'..='ώ' | 'ᾀ'..='ᾴ' | 'ᾶ'..='ῄ' | 'ῆ'..='ΐ' | 'ῖ'..='Ί' | '῝'..='`' | 'ῲ'..='ῴ' | 'ῶ'..='῾' | 'Ω' | 'ꭥ' | '𐅀'..='𐆎' | '𐆠' | '𝈀'..='𝉁' | '𝉅' => {
                end = try_GREEK(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_GREEK; }
            },
            'ᄀ'..='ᅟ' | '⺀'..='⺙' | '⺛'..='⻳' | '⼀'..='⿕' | '⿰'..='⿿' | '〄'..='〇' | '〡'..='〩' | '\u{302e}'..='\u{302f}' | '〱'..='〾' | 'ぁ'..='ゖ' | '゛'..='ヿ' | 'ㄅ'..='ㄯ' | 'ㄱ'..='ㆎ' | '㆐'..='㇥' | '㇯'..='㈞' | '㈠'..='㉇' | '㉐'..='ꒌ' | '꒐'..='꓆' | 'ꥠ'..='ꥼ' | '가'..='힣' | '豈'..='\u{faff}' | '︐'..='︙' | '︰'..='﹄' | '﹇'..='﹒' | '﹔'..='﹦' | '﹨'..='﹫' | '𖿠'..='𖿣' | '\u{16ff0}'..='𖿶' | '𗀀'..='𘳕' | '𘳿'..='𘴞' | '𘶀'..='𘷲' | '𚿰'..='𚿳' | '𚿵'..='𚿻' | '𚿽'..='𚿾' | '𛀀'..='𛄢' | '𛄲' | '𛅐'..='𛅒' | '𛅕' | '𛅤'..='𛅧' | '𛅰'..='𛋻' | '𝌀'..='𝍖' | '𝍠'..='𝍶' | '🀄' | '🃏' | '🆎' | '🆑'..='🆚' | '🈀'..='🈂' | '🈐'..='🈻' | '🉀'..='🉈' | '🉐'..='🉑' | '🉠'..='🉥' | '🌀'..='🌠' | '🌭'..='🌵' | '🌷'..='🍼' | '🍾'..='🎓' | '🎠'..='🏊' | '🏏'..='🏓' | '🏠'..='🏰' | '🏴' | '🏸'..='🐾' | '👀' | '👂'..='📼' | '📿'..='🔽' | '🕋'..='🕎' | '🕐'..='🕧' | '🕺' | '🖕'..='🖖' | '🖤' | '🗻'..='🙏' | '🚀'..='🛅' | '🛌' | '🛐'..='🛒' | '🛕'..='🛘' | '🛜'..='🛟' | '🛫'..='🛬' | '🛴'..='🛼' | '🟠'..='🟫' | '🟰' | '🤌'..='🤺' | '🤼'..='🥅' | '🥇'..='🧿' | '🩰'..='🩼' | '🪀'..='🪊' | '🪎'..='🫆' | '🫈' | '🫍'..='🫜' | '🫟'..='🫪' | '🫯'..='🫸' | '𠀀'..='\u{2fffd}' | '𰀀'..='\u{3fffd}' => {
                end = try_WIDE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_WIDE; }
            },
            '⌚'..='⌛' | '〈'..='〉' | '⏩'..='⏬' | '⏰' | '⏳' | '◽'..='◾' | '☔'..='☕' | '☰'..='☷' | '♈'..='♓' | '♿' | '⚊'..='⚏' | '⚓' | '⚡' | '⚪'..='⚫' | '⚽'..='⚾' | '⛄'..='⛅' | '⛎' | '⛔' | '⛪' | '⛲'..='⛳' | '⛵' | '⛺' | '⛽' | '✅' | '✊'..='✋' | '✨' | '❌' | '❎' | '❓'..='❕' | '❗' | '➕'..='➗' | '➰' | '➿' | '⬛'..='⬜' | '⭐' | '⭕' | '、'..='〃' | '〈'..='〠' | '〰' | '﹅'..='﹆' => {
                end = try_PATSYN(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_PATSYN; }
                end = try_WIDE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_WIDE; }
            },
            '\u{302a}'..='\u{302d}' | '\u{3099}'..='\u{309a}' | '\u{16fe4}' => {
                end = try_GREEKMARK(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_GREEKMARK; }
                end = try_WIDE(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_WIDE; }
            },
            '\u{1d242}'..='\u{1d244}' => {
                end = try_GREEK(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_GREEK; }
                end = try_GREEKMARK(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_GREEKMARK; }
            },
            _ => {},
        }
        if best_end <= start {
            end = try_OTHER(&lexer.src, start);
            if end > best_end { best_end = end; best_kind = TK_OTHER; }
        }
        if best_end <= start {
            let error_end = lexer.src.ceil_char_boundary(start + 1);
            let _ = ts.push_token_flagged(TK_ERROR, start, error_end, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = error_end;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { == TK_WSP };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        == TK_GREEK => "GREEK",
        == TK_GREEKMARK => "GREEKMARK",
        == TK_PATSYN => "PATSYN",
        == TK_WIDE => "WIDE",
        == TK_WSP => "WSP",
        == TK_OTHER => "OTHER",
        == TK_EOF => "Eof",
        == TK_ERROR => "Error",
        _ => "Unknown",
    };
}


global RULE_NAMES: List<String> = [];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(node_name(&RULE_NAMES, *self));
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    site: i32,
    sites: List<i32>,
    failed_expected: List<i32>,
    recovery_pos: i32,
    recovered_failures: List<[NodeKind, List<i32>]>,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(TOKEN_NAMES[*k]);
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, site: -1, sites: [], failed_expected: [], recovery_pos: -1, recovered_failures: [], b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.peek_kind(), RecoveryAction::None));
        }
        self.enter_recovery(expected);
    }

    fn enter_recovery(&mut self, expected: &List<i32>) {
        self.recovering = true;
        if !self.speculating { self.failed_expected = *expected; }
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.peek_start()) {
            self.fail(`${what} "${self.peek_text()}"`, self.peek_span(), expected, code);
            return;
        }
        self.enter_recovery(expected);
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.speculating && !self.supersedes_pending(self.peek_start()) {
            self.recovering = true;
            return;
        }
        self.fail_expecting(&([kind] as List<i32>));
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn recover_rule(&mut self, rule: NodeKind, name: String, row: i32) -> bool {
        if self.speculating || self.diagnostics.len() >= self.max_errors {
            self.push_rule_stack(name);
            return false;
        }
        let node = if row < 0 { self.b.innermost_open() } else { row };
        self.b.resume_node(node, self.last_end());
        assert self.b.node_kind(node) == rule, "recover_rule: the resumed node is the failed rule's";
        if !self.b.in_error_mode() { self.recovered_failures.clear(); }
        self.commit_pending();
        self.recovering = false;
        let failure = [rule, self.failed_expected];
        if self.pos == self.recovery_pos && self.recovered_failures.contains(&failure) && !self.at_eof() {
            self.skip_one();
        }
        self.recovery_pos = self.pos;
        self.recovered_failures.push(failure);
        self.skip_until(&self.resync_set(&EMPTY_SYNC));
        return true;
    }

    fn commit_pending(&mut self) {
        let Some(d) = self.pending else { return; };
        self.pending = null;
        let mut diag = d;
        self.b.push_open_rule_names(&RULE_NAMES, &mut diag.rule_stack);
        self.report(diag);
    }

    fn report(&mut self, diag: Diagnostic) {
        if self.b.in_error_mode() { return; }
        self.diagnostics.push(diag);
        self.b.mark_error();
    }

    fn resync_set(&self, base: &KindSet) -> KindSet {
        let mut set = *base;
        for let s of &self.sites {
            if *s >= 0 { set.union_with(&CALL_FOLLOW_SETS[CALL_FOLLOW[*s]]); }
        }
        return set;
    }

    fn follows_rules_under_way(&self, k: i32) -> bool {
        for let mut i = self.sites.len() - 1; i >= 0; i -= 1 {
            let s = self.sites[i];
            if s < 0 { return i == 0 && k == TK_EOF; }
            if CALL_FOLLOW_SETS[CALL_FOLLOW[s]].has(k) { return true; }
            if !CALL_FOLLOW_ENDS[s] { return false; }
        }
        return k == TK_EOF;
    }

    fn skip_until(&mut self, set: &KindSet) {
        while !self.at_eof() && !set.has(self.peek_kind()) {
            self.skip_one();
        }
    }

    fn skip_one(&mut self) {
        let _sk = self.advance();
        self.tokens.mark_skipped(_sk);
        self.b.skip(_sk);
    }

    fn sync_delete(&mut self, sync: &KindSet, expected: &List<i32>) -> bool {
        if self.speculating || self.at_eof() || !sync.has(self.peek_at(1)) {
            return false;
        }
        self.report_extraneous(expected, RecoveryAction::Deleted);
        self.skip_one();
        return true;
    }

    fn sync_enter(&mut self, sync: &KindSet, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.fail_expecting(expected);
        }
    }

    fn sync_alts(&mut self, sync: &KindSet, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.no_viable("no viable alternative", self.peek_span(), expected);
        }
    }

    fn sync_back(&mut self, sync: &KindSet, expected: &List<i32>) {
        if self.recovering || self.at_eof() { return; }
        if self.speculating {
            self.fail_expecting(expected);
            return;
        }
        self.report_extraneous(expected, RecoveryAction::SkippedTo);
        self.skip_until(&self.resync_set(sync));
    }

    fn fail_expecting(&mut self, expected: &List<i32>) {
        let code = if self.at_eof() { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
        self.fail_on_token("got", expected, code);
    }

    fn report_extraneous(&mut self, expected: &List<i32>, recovery: RecoveryAction) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.peek_text()}"`, self.peek_span(), *expected, self.peek_kind(), recovery));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let at_eof = self.at_eof();
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.report(Diagnostic::error(code, `missing ${TOKEN_NAMES[kind]}`, self.peek_span(), [kind], self.peek_kind(), recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.peek_text()}"`, self.peek_span(), [kind], self.peek_kind(), RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.start_at(self.pos);
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_text(&self) -> String {
        return self.tokens.token_text(self.pos);
    }

    fn at_eof(&self) -> bool {
        return self.peek_kind() == TK_EOF;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.end_at(self.pos - 1);
    }

    fn enter_rule(&mut self) -> bool {
        if self.recovering { return false; }
        self.sites.push(self.site);
        return true;
    }

    fn leave_rule(&mut self) {
        self.sites.pop();
    }

    fn open_rule(&mut self, kind: NodeKind) -> bool {
        if !self.enter_rule() { return false; }
        self.b.start_node(kind, self.peek_start());
        return true;
    }

    fn close_rule(&mut self, kind: NodeKind, name: String) {
        if self.recovering { let _ = self.recover_rule(kind, name, -1); }
        self.b.finish_node(self.last_end());
        self.leave_rule();
    }

    fn close_lr_rule(&mut self, kind: NodeKind, name: String, row: i32) {
        if self.recovering && self.recover_rule(kind, name, row) { self.b.finish_node(self.last_end()); }
        self.leave_rule();
    }

    fn consume(&mut self) -> i32 {
        let i = self.pos;
        if !self.at_eof() { self.pos += 1; }
        self.b.token(i);
        return i;
    }

    fn insert_missing(&mut self, kind: i32) -> i32 {
        let i = self.tokens.push_synthetic(kind, self.peek_start());
        self.b.missing(i);
        return i;
    }

    fn expect(&mut self, kind: i32, sync: &KindSet, may_end_rule: bool) -> i32 {
        if self.recovering { return self.pos; }
        if self.peek_kind() == kind { return self.consume(); }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extraneous(&[kind], RecoveryAction::Deleted);
            self.skip_one();
            return self.consume();
        }
        if sync.has(self.peek_kind()) || may_end_rule && self.follows_rules_under_way(self.peek_kind()) {
            self.report_missing(kind);
            return self.insert_missing(kind);
        }
        if !sync.is_empty() {
            if !may_end_rule && self.at_eof() {
                self.fail_on_kind(kind);
                return self.pos;
            }
            self.report_unexpected(kind);
            if !self.at_eof() {
                self.b.start_error(self.peek_start());
                while !self.at_eof() && self.peek_kind() != kind && !sync.has(self.peek_kind()) {
                    self.skip_one();
                }
                self.b.finish_node(self.last_end());
            }
            if self.peek_kind() == kind { return self.consume(); }
            return self.insert_missing(kind);
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        return self.consume();
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if !self.at_eof() { return self.consume(); }
        self.fail_on_token("expected any token; got", &NO_EXPECTED, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &KindSet) -> i32 {
        if self.recovering { return self.pos; }
        if !self.at_eof() && !excluded.has(self.peek_kind()) { return self.consume(); }
        self.fail_on_token("unexpected token", &NO_EXPECTED, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &KindSet, expected: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if included.has(self.peek_kind()) { return self.consume(); }
        self.fail_on_token("got", expected, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

global CALL_FOLLOW_SETS: List<KindSet> = [];
global CALL_FOLLOW: List<i32> = [];
global CALL_FOLLOW_ENDS: List<bool> = [];

global TOKEN_NAMES: List<String> = ["GREEK", "GREEKMARK", "PATSYN", "WIDE", "WSP", "OTHER", "Eof", "Error"];

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let Some(kind) = RULE_NAMES.position(|name| rule == name) else { return ""; };
    let sub = result.cst.find_child(0, kind as NodeKind);
    if sub < 0 { return ""; }
    return result.cst.to_string_tree(sub, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

global EMPTY_SYNC: KindSet = [];
global NO_EXPECTED: List<i32> = [];

