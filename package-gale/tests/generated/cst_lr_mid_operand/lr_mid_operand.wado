}

impl DiagnosticCode {
    pub fn name(&self) -> String {
        return match *self {
            _::UnexpectedToken => "unexpected-token",
            _::MissingToken => "missing-token",
            _::ExtraToken => "extra-token",
            _::NoViableAlternative => "no-viable-alternative",
            _::UnterminatedConstruct => "unterminated-construct",
