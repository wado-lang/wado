    pub constant: ConstantNode,
    pub wildcard_list: Array<Token>,
}

pub struct FileNode {
    pub span: Span,
    pub wildcard_list: Array<Token>,
    pub constant_item_list: Array<ConstantItemListItem>,
    pub eof: Token,
}

pub struct ConstantNode {
