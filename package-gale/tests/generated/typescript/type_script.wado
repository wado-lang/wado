fn _parse_try_statement__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<TryStatementNode, ParseError> {
    let start = p.peek_start();
    let try = p.expect(TK_Try)?;
    let block = _parse_block(p, &FOLLOW_MASK_28)?;
    let mut group_0_inner: Option<TryStatementGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_Catch {
        let catch_production = _parse_catch_production(p, follow)?;
        let finally_production: Option<FinallyProductionNode> = if follow_yields(&p.kinds, p.pos, follow, TK_EOF) {
            null
        } else if p.peek_kind() == TK_Finally {
            let finally_production = _parse_finally_production(p, &EMPTY_FOLLOW)?;
            Option::Some(finally_production)
        } else {
            null
        };
        group_0_inner = Option::Some(TryStatementGroup0::Alt0(TryStatementGroup0Alt0 {
            catch_production,
            finally_production,
        }));
    } else if grp_kind == TK_Finally {
        let finally_production = _parse_finally_production(p, follow)?;
        group_0_inner = Option::Some(TryStatementGroup0::Alt1(TryStatementGroup0Alt1 {
            finally_production,
        }));
    }
    let group_0 = group_0_inner;
    return Result::Ok(TryStatementNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        try,
        block,
        group_0,
    });
}

