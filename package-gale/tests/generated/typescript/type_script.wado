fn _parse_decorator__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<DecoratorNode, ParseError> {
    let start = p.peek_start();
    let at = p.expect(TK_LIT_AT)?;
    let mut decorator_member_expression_or_decorator_call_expression_inner: Option<DecoratorMemberExpressionOrDecoratorCallExpressionGroup> = null;
    let grp_kind = p.peek_kind();
    if _gale_kind_set_19(grp_kind) {
        let mut gd_winner: i32 = -1;
        gd_dispatch: {
            gd_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                pos = scan_decorator_member_expression(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break gd_scan; }
                gd_winner = 0;
                break gd_dispatch;
            }
        }
        if gd_winner == 0 {
            let decorator_member_expression = _parse_decorator_member_expression(p, &EMPTY_FOLLOW)?;
            decorator_member_expression_or_decorator_call_expression_inner = Option::Some(DecoratorMemberExpressionOrDecoratorCallExpressionGroup::DecoratorMemberExpression(decorator_member_expression));
        } else {
            let decorator_call_expression = _parse_decorator_call_expression(p, &EMPTY_FOLLOW)?;
            decorator_member_expression_or_decorator_call_expression_inner = Option::Some(DecoratorMemberExpressionOrDecoratorCallExpressionGroup::DecoratorCallExpression(decorator_call_expression));
        }
    }
    let decorator_member_expression_or_decorator_call_expression = decorator_member_expression_or_decorator_call_expression_inner;
    return Result::Ok(DecoratorNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        at,
        decorator_member_expression_or_decorator_call_expression,
    });
}

