                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos] != TK_LIT_DOT { break rep_scan; }
                    pos += 1;
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
