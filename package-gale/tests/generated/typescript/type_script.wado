}

fn _parse_case_clauses__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<CaseClausesNode, ParseError> {
    let start = p.peek_start();
    let mut case_clause_list: List<CaseClauseNode> = [];
    let mut _plus_first = true;
    loop {
        if !_plus_first {
            if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                pos = scan_case_clause(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 {
                if p.peek_kind() == TK_Case {
                    let _rec_pos = p.pos;
                    if let Err(_rec_e) = _parse_case_clause(p, &EMPTY_FOLLOW) { p.record_deeper(_rec_e); }
                    p.pos = _rec_pos;
                }
                break;
            }
        }
        _plus_first = false;
        let case_clause = _parse_case_clause(p, &EMPTY_FOLLOW)?;
        case_clause_list.push(case_clause);
    }
    return Result::Ok(CaseClausesNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        case_clause_list,
    });
}

fn _parse_case_clauses(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<CaseClausesNode, ParseError> {
    return _gale_rule(_parse_case_clauses__inner(p, follow), "caseClauses");
}

fn _parse_case_clause__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<CaseClauseNode, ParseError> {
    let start = p.peek_start();
    let case = p.expect(TK_Case)?;
    let expression_sequence = _parse_expression_sequence(p, &FOLLOW_MASK_9)?;
    let colon = p.expect(TK_LIT_COLON)?;
    let statement_list: Option<StatementListNode> = if follow_yields(&p.kinds, p.pos, follow, TK_EOF) {
        null
    } else if _gale_kind_set_18(p.peek_kind()) {
        let statement_list = _parse_statement_list(p, &EMPTY_FOLLOW)?;
        Option::Some(statement_list)
    } else {
        null
    };
    return Result::Ok(CaseClauseNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        case,
        expression_sequence,
        colon,
        statement_list,
    });
}

