        let lparen = p.expect(TK_LIT_LPAREN)?;
        let expression_sequence = _parse_expression_sequence(p, &FOLLOW_MASK_1)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let eos = _parse_eos(p, follow)?;
        return Result::Ok(IterationStatementNode::DoStatement(IterationStatementDoStatement {
            span: Span::new(start, i32::max(start, p.last_end())),
            do,
            statement,
            while_,
            lparen,
            expression_sequence,
            rparen,
            eos,
        }));
    }
    if kind == TK_While {
        let while_ = p.expect(TK_While)?;
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let expression_sequence = _parse_expression_sequence(p, &FOLLOW_MASK_1)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let statement = _parse_statement(p, follow)?;
        return Result::Ok(IterationStatementNode::WhileStatement(IterationStatementWhileStatement {
            span: Span::new(start, i32::max(start, p.last_end())),
            while_,
            lparen,
            expression_sequence,
            rparen,
            statement,
        }));
    }
    if kind == TK_For {
        let _sd_tokens = &p.kinds;
        let _sd_pos = p.pos;
        let _sd_p_3 = _parse_iteration_statement__inner_scan_3(_sd_tokens, _sd_pos);
        let _sd_p_7 = _parse_iteration_statement__inner_scan_7(_sd_tokens, _sd_pos);
        let _sd_p_2 = _parse_iteration_statement__inner_scan_2(_sd_tokens, _sd_pos);
        let _sd_p_6 = _parse_iteration_statement__inner_scan_6(_sd_tokens, _sd_pos);
        let _sd_p_5 = _parse_iteration_statement__inner_scan_5(_sd_tokens, _sd_pos);
        let _sd_p_4 = _parse_iteration_statement__inner_scan_4(_sd_tokens, _sd_pos);
        let mut _sd_best_i: i32 = -1;
        let mut _sd_best_p: i32 = -1;
        if _sd_p_3 > _sd_best_p {
            _sd_best_p = _sd_p_3;
            _sd_best_i = 3;
        }
        if _sd_p_7 > _sd_best_p {
            _sd_best_p = _sd_p_7;
            _sd_best_i = 7;
        }
        if _sd_p_2 > _sd_best_p {
            _sd_best_p = _sd_p_2;
            _sd_best_i = 2;
        }
        if _sd_p_6 > _sd_best_p {
            _sd_best_p = _sd_p_6;
            _sd_best_i = 6;
        }
        if _sd_p_5 > _sd_best_p {
            _sd_best_p = _sd_p_5;
            _sd_best_i = 5;
        }
        if _sd_p_4 > _sd_best_p {
            _sd_best_p = _sd_p_4;
            _sd_best_i = 4;
        }
        if _sd_best_i == 3 {
            return _parse_iteration_statement__inner_alt_3(p, follow);
        }
        if _sd_best_i == 7 {
            return _parse_iteration_statement__inner_alt_7(p, follow);
        }
        if _sd_best_i == 2 {
            return _parse_iteration_statement__inner_alt_2(p, follow);
        }
        if _sd_best_i == 6 {
            return _parse_iteration_statement__inner_alt_6(p, follow);
        }
        if _sd_best_i == 5 {
            return _parse_iteration_statement__inner_alt_5(p, follow);
        }
        if _sd_best_i == 4 {
            return _parse_iteration_statement__inner_alt_4(p, follow);
        }
        return _parse_iteration_statement__inner_alt_4(p, follow);
    }
    return Result::Err(p.error(
        "expected iterationStatement",
        p.peek_span(),
        ["TK_Do", "TK_While", "TK_For"],
    ));
}

