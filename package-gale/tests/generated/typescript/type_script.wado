fn _parse_decorator_member_expression__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> Result<DecoratorMemberExpressionNode, ParseError> {
    let start = p.peek_start();
    let mut result = _parse_decorator_member_expression__inner_atom(p, follow)?;
    loop {
        let suffix_kind = p.peek_kind();
        if suffix_kind == TK_LIT_DOT {
            if 1 >= min_prec {
                if scan_decorator_member_expression_lr_1(&p.kinds, p.pos) < 0 {
                    break;
                }
                result = _parse_decorator_member_expression__inner_lr_1(p, result, start, follow)?;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return Result::Ok(result);
}

