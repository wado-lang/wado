    return _gale_run(input, |p: &mut Parser| _parse_reserved_word(p));
}

pub fn parse_keyword(input: &String) -> Result<ParseResult<KeywordNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_keyword(p));
}

pub fn parse_eos(input: &String) -> Result<ParseResult<EosNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_eos(p));
}

pub fn parse(input: &String) -> Result<ParseResult<InitializerNode>, ParseError> {
    return parse_initializer(input);
}

pub fn walk_initializer<V: Visitor>(v: &mut V, toks: &TokenStream, node: &InitializerNode) {
    v.enter_rule(0, &"initializer", &node.span);
    v.visit_token(toks, *(&node.eq));
    walk_singleExpression(v, toks, &node.single_expression);
    v.exit_rule(0, &"initializer", &node.span);
}

pub fn walk_bindingPattern<V: Visitor>(v: &mut V, toks: &TokenStream, node: &BindingPatternNode) {
    v.enter_rule(1, &"bindingPattern", &node.span);
    if let Some(item) = &node.array_literal_or_object_literal {
        match item {
            ArrayLiteral(inner) => {
                walk_arrayLiteral(v, toks, inner);
            }
            ObjectLiteral(inner) => {
                walk_objectLiteral(v, toks, inner);
            }
        }
    }
    v.exit_rule(1, &"bindingPattern", &node.span);
}

pub fn walk_typeParameters<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeParametersNode) {
    v.enter_rule(2, &"typeParameters", &node.span);
    v.visit_token(toks, *(&node.lt));
    if let Some(item) = &node.type_parameter_list {
        walk_typeParameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.gt));
    v.exit_rule(2, &"typeParameters", &node.span);
}

pub fn walk_typeParameterList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeParameterListNode) {
    v.enter_rule(3, &"typeParameterList", &node.span);
    walk_typeParameter(v, toks, &node.type_parameter);
    for let item of &node.comma_type_parameter_list {
        v.visit_token(toks, *(&item.comma));
        walk_typeParameter(v, toks, &item.type_parameter);
    }
    v.exit_rule(3, &"typeParameterList", &node.span);
}

pub fn walk_typeParameter<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeParameterNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(4, &"typeParameter", &n.span);
            walk_identifier(v, toks, &n.identifier);
            if let Some(item) = &n.constraint {
                walk_constraint(v, toks, item);
            }
            v.exit_rule(4, &"typeParameter", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(4, &"typeParameter", &n.span);
            walk_identifier(v, toks, &n.identifier);
            v.visit_token(toks, *(&n.eq));
            walk_typeArgument(v, toks, &n.type_argument);
            v.exit_rule(4, &"typeParameter", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(4, &"typeParameter", &n.span);
            walk_typeParameters(v, toks, &n.type_parameters);
            v.exit_rule(4, &"typeParameter", &n.span);
        }
    }
}

pub fn walk_constraint<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ConstraintNode) {
    v.enter_rule(5, &"constraint", &node.span);
    v.visit_token(toks, *(&node.lit_extends));
    walk_type_(v, toks, &node.type_);
    v.exit_rule(5, &"constraint", &node.span);
}

pub fn walk_typeArguments<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeArgumentsNode) {
    v.enter_rule(6, &"typeArguments", &node.span);
    v.visit_token(toks, *(&node.lt));
    if let Some(item) = &node.type_argument_list {
        walk_typeArgumentList(v, toks, item);
    }
    v.visit_token(toks, *(&node.gt));
    v.exit_rule(6, &"typeArguments", &node.span);
}

pub fn walk_typeArgumentList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeArgumentListNode) {
    v.enter_rule(7, &"typeArgumentList", &node.span);
    walk_typeArgument(v, toks, &node.type_argument);
    for let item of &node.comma_type_argument_list {
        v.visit_token(toks, *(&item.comma));
        walk_typeArgument(v, toks, &item.type_argument);
    }
    v.exit_rule(7, &"typeArgumentList", &node.span);
}

pub fn walk_typeArgument<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeArgumentNode) {
    v.enter_rule(8, &"typeArgument", &node.span);
    walk_type_(v, toks, &node.type_);
    v.exit_rule(8, &"typeArgument", &node.span);
}

pub fn walk_type_<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(9, &"type_", &n.span);
            if let Some(item) = &n.pipe_or_amp {
                v.visit_token(toks, *(item));
            }
            walk_unionOrIntersectionOrPrimaryType(v, toks, &n.union_or_intersection_or_primary_type);
            v.exit_rule(9, &"type_", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(9, &"type_", &n.span);
            walk_functionType(v, toks, &n.function_type);
            v.exit_rule(9, &"type_", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(9, &"type_", &n.span);
            walk_constructorType(v, toks, &n.constructor_type);
            v.exit_rule(9, &"type_", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(9, &"type_", &n.span);
            walk_typeGeneric(v, toks, &n.type_generic);
            v.exit_rule(9, &"type_", &n.span);
        }
    }
}

pub fn walk_unionOrIntersectionOrPrimaryType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &UnionOrIntersectionOrPrimaryTypeNode) {
    match node {
        Union(n) => {
            v.enter_rule(10, &"unionOrIntersectionOrPrimaryType", &n.span);
            walk_unionOrIntersectionOrPrimaryType(v, toks, &n.union_or_intersection_or_primary_type);
            v.visit_token(toks, *(&n.pipe));
            walk_unionOrIntersectionOrPrimaryType(v, toks, &n.union_or_intersection_or_primary_type_2);
            v.exit_rule(10, &"unionOrIntersectionOrPrimaryType", &n.span);
        }
        Intersection(n) => {
            v.enter_rule(10, &"unionOrIntersectionOrPrimaryType", &n.span);
            walk_unionOrIntersectionOrPrimaryType(v, toks, &n.union_or_intersection_or_primary_type);
            v.visit_token(toks, *(&n.amp));
            walk_unionOrIntersectionOrPrimaryType(v, toks, &n.union_or_intersection_or_primary_type_2);
            v.exit_rule(10, &"unionOrIntersectionOrPrimaryType", &n.span);
        }
        Primary(n) => {
            v.enter_rule(10, &"unionOrIntersectionOrPrimaryType", &n.span);
            walk_primaryType(v, toks, &n.primary_type);
            v.exit_rule(10, &"unionOrIntersectionOrPrimaryType", &n.span);
        }
    }
}

pub fn walk_primaryType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PrimaryTypeNode) {
    match node {
        ParenthesizedPrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_type_(v, toks, &n.type_);
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(11, &"primaryType", &n.span);
        }
        PredefinedPrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            walk_predefinedType(v, toks, &n.predefined_type);
            v.exit_rule(11, &"primaryType", &n.span);
        }
        ReferencePrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            walk_typeReference(v, toks, &n.type_reference);
            v.exit_rule(11, &"primaryType", &n.span);
        }
        ObjectPrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            walk_objectType(v, toks, &n.object_type);
            v.exit_rule(11, &"primaryType", &n.span);
        }
        ArrayPrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            walk_primaryType(v, toks, &n.primary_type);
            v.visit_token(toks, *(&n.lbracket));
            if let Some(item) = &n.primary_type_2 {
                walk_primaryType(v, toks, item);
            }
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(11, &"primaryType", &n.span);
        }
        TuplePrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            v.visit_token(toks, *(&n.lbracket));
            walk_tupleElementTypes(v, toks, &n.tuple_element_types);
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(11, &"primaryType", &n.span);
        }
        QueryPrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            walk_typeQuery(v, toks, &n.type_query);
            v.exit_rule(11, &"primaryType", &n.span);
        }
        ThisPrimType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            v.visit_token(toks, *(&n.this));
            v.exit_rule(11, &"primaryType", &n.span);
        }
        RedefinitionOfType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            walk_typeReference(v, toks, &n.type_reference);
            v.visit_token(toks, *(&n.is));
            walk_primaryType(v, toks, &n.primary_type);
            v.exit_rule(11, &"primaryType", &n.span);
        }
        KeyOfType(n) => {
            v.enter_rule(11, &"primaryType", &n.span);
            v.visit_token(toks, *(&n.keyof));
            walk_primaryType(v, toks, &n.primary_type);
            v.exit_rule(11, &"primaryType", &n.span);
        }
    }
}

pub fn walk_predefinedType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PredefinedTypeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.any));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.nullliteral));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.number));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.decimalliteral));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.boolean));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.booleanliteral));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.string));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.stringliteral));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            if let Some(item) = &n.unique_ {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.symbol));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.never));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.undefined));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.object));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(12, &"predefinedType", &n.span);
            v.visit_token(toks, *(&n.void));
            v.exit_rule(12, &"predefinedType", &n.span);
        }
    }
}

pub fn walk_typeReference<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeReferenceNode) {
    v.enter_rule(13, &"typeReference", &node.span);
    walk_typeName(v, toks, &node.type_name);
    if let Some(item) = &node.type_generic {
        walk_typeGeneric(v, toks, item);
    }
    v.exit_rule(13, &"typeReference", &node.span);
}

pub fn walk_typeGeneric<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeGenericNode) {
    v.enter_rule(14, &"typeGeneric", &node.span);
    v.visit_token(toks, *(&node.lt));
    walk_typeArgumentList(v, toks, &node.type_argument_list);
    if let Some(item) = &node.type_generic {
        walk_typeGeneric(v, toks, item);
    }
    v.visit_token(toks, *(&node.gt));
    v.exit_rule(14, &"typeGeneric", &node.span);
}

pub fn walk_typeName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(15, &"typeName", &n.span);
            walk_identifier(v, toks, &n.identifier);
            v.exit_rule(15, &"typeName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(15, &"typeName", &n.span);
            walk_namespaceName(v, toks, &n.namespace_name);
            v.exit_rule(15, &"typeName", &n.span);
        }
    }
}

pub fn walk_objectType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ObjectTypeNode) {
    v.enter_rule(16, &"objectType", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    if let Some(item) = &node.type_body {
        walk_typeBody(v, toks, item);
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(16, &"objectType", &node.span);
}

pub fn walk_typeBody<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeBodyNode) {
    v.enter_rule(17, &"typeBody", &node.span);
    walk_typeMemberList(v, toks, &node.type_member_list);
    if let Some(item) = &node.semicolon_or_comma {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(17, &"typeBody", &node.span);
}

pub fn walk_typeMemberList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeMemberListNode) {
    v.enter_rule(18, &"typeMemberList", &node.span);
    walk_typeMember(v, toks, &node.type_member);
    for let item of &node.item_type_member_list {
        v.visit_token(toks, *(&item.semicolon_or_comma));
        walk_typeMember(v, toks, &item.type_member);
    }
    v.exit_rule(18, &"typeMemberList", &node.span);
}

pub fn walk_typeMember<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeMemberNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(19, &"typeMember", &n.span);
            walk_propertySignatur(v, toks, &n.property_signatur);
            v.exit_rule(19, &"typeMember", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(19, &"typeMember", &n.span);
            walk_callSignature(v, toks, &n.call_signature);
            v.exit_rule(19, &"typeMember", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(19, &"typeMember", &n.span);
            walk_constructSignature(v, toks, &n.construct_signature);
            v.exit_rule(19, &"typeMember", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(19, &"typeMember", &n.span);
            walk_indexSignature(v, toks, &n.index_signature);
            v.exit_rule(19, &"typeMember", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(19, &"typeMember", &n.span);
            walk_methodSignature(v, toks, &n.method_signature);
            if let Some(item) = &n.lit_eqgt_type_ {
                v.visit_token(toks, *(&item.lit_eqgt));
                walk_type_(v, toks, &item.type_);
            }
            v.exit_rule(19, &"typeMember", &n.span);
        }
    }
}

pub fn walk_arrayType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArrayTypeNode) {
    v.enter_rule(20, &"arrayType", &node.span);
    walk_primaryType(v, toks, &node.primary_type);
    v.visit_token(toks, *(&node.lbracket));
    v.visit_token(toks, *(&node.rbracket));
    v.exit_rule(20, &"arrayType", &node.span);
}

pub fn walk_tupleType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TupleTypeNode) {
    v.enter_rule(21, &"tupleType", &node.span);
    v.visit_token(toks, *(&node.lbracket));
    walk_tupleElementTypes(v, toks, &node.tuple_element_types);
    v.visit_token(toks, *(&node.rbracket));
    v.exit_rule(21, &"tupleType", &node.span);
}

pub fn walk_tupleElementTypes<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TupleElementTypesNode) {
    v.enter_rule(22, &"tupleElementTypes", &node.span);
    walk_type_(v, toks, &node.type_);
    for let item of &node.comma_type__list {
        v.visit_token(toks, *(&item.comma));
        walk_type_(v, toks, &item.type_);
    }
    if let Some(item) = &node.comma {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(22, &"tupleElementTypes", &node.span);
}

pub fn walk_functionType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FunctionTypeNode) {
    v.enter_rule(23, &"functionType", &node.span);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, toks, item);
    }
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    v.visit_token(toks, *(&node.lit_eqgt));
    walk_type_(v, toks, &node.type_);
    v.exit_rule(23, &"functionType", &node.span);
}

pub fn walk_constructorType<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ConstructorTypeNode) {
    v.enter_rule(24, &"constructorType", &node.span);
    v.visit_token(toks, *(&node.lit_new));
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, toks, item);
    }
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    v.visit_token(toks, *(&node.lit_eqgt));
    walk_type_(v, toks, &node.type_);
    v.exit_rule(24, &"constructorType", &node.span);
}

pub fn walk_typeQuery<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeQueryNode) {
    v.enter_rule(25, &"typeQuery", &node.span);
    v.visit_token(toks, *(&node.lit_typeof));
    walk_typeQueryExpression(v, toks, &node.type_query_expression);
    v.exit_rule(25, &"typeQuery", &node.span);
}

pub fn walk_typeQueryExpression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeQueryExpressionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(26, &"typeQueryExpression", &n.span);
            walk_identifier(v, toks, &n.identifier);
            v.exit_rule(26, &"typeQueryExpression", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(26, &"typeQueryExpression", &n.span);
            for let item of &n.identifier_name_dot_list {
                walk_identifierName(v, toks, &item.identifier_name);
                v.visit_token(toks, *(&item.dot));
            }
            walk_identifierName(v, toks, &n.identifier_name);
            v.exit_rule(26, &"typeQueryExpression", &n.span);
        }
    }
}

pub fn walk_propertySignatur<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PropertySignaturNode) {
    v.enter_rule(27, &"propertySignatur", &node.span);
    if let Some(item) = &node.readonly {
        v.visit_token(toks, *(item));
    }
    walk_propertyName(v, toks, &node.property_name);
    if let Some(item) = &node.question {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    if let Some(item) = &node.lit_eqgt_type_ {
        v.visit_token(toks, *(&item.lit_eqgt));
        walk_type_(v, toks, &item.type_);
    }
    v.exit_rule(27, &"propertySignatur", &node.span);
}

pub fn walk_typeAnnotation<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeAnnotationNode) {
    v.enter_rule(28, &"typeAnnotation", &node.span);
    v.visit_token(toks, *(&node.colon));
    walk_type_(v, toks, &node.type_);
    v.exit_rule(28, &"typeAnnotation", &node.span);
}

pub fn walk_callSignature<V: Visitor>(v: &mut V, toks: &TokenStream, node: &CallSignatureNode) {
    v.enter_rule(29, &"callSignature", &node.span);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, toks, item);
    }
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    v.exit_rule(29, &"callSignature", &node.span);
}

pub fn walk_parameterList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ParameterListNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(30, &"parameterList", &n.span);
            walk_restParameter(v, toks, &n.rest_parameter);
            v.exit_rule(30, &"parameterList", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(30, &"parameterList", &n.span);
            walk_parameter(v, toks, &n.parameter);
            for let item of &n.comma_parameter_list {
                v.visit_token(toks, *(&item.comma));
                walk_parameter(v, toks, &item.parameter);
            }
            if let Some(item) = &n.comma_rest_parameter {
                v.visit_token(toks, *(&item.comma));
                walk_restParameter(v, toks, &item.rest_parameter);
            }
            if let Some(item) = &n.comma {
                v.visit_token(toks, *(item));
            }
            v.exit_rule(30, &"parameterList", &n.span);
        }
    }
}

pub fn walk_requiredParameterList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &RequiredParameterListNode) {
    v.enter_rule(31, &"requiredParameterList", &node.span);
    walk_requiredParameter(v, toks, &node.required_parameter);
    for let item of &node.comma_required_parameter_list {
        v.visit_token(toks, *(&item.comma));
        walk_requiredParameter(v, toks, &item.required_parameter);
    }
    v.exit_rule(31, &"requiredParameterList", &node.span);
}

pub fn walk_parameter<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ParameterNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(32, &"parameter", &n.span);
            walk_requiredParameter(v, toks, &n.required_parameter);
            v.exit_rule(32, &"parameter", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(32, &"parameter", &n.span);
            walk_optionalParameter(v, toks, &n.optional_parameter);
            v.exit_rule(32, &"parameter", &n.span);
        }
    }
}

pub fn walk_optionalParameter<V: Visitor>(v: &mut V, toks: &TokenStream, node: &OptionalParameterNode) {
    v.enter_rule(33, &"optionalParameter", &node.span);
    if let Some(item) = &node.decorator_list {
        walk_decoratorList(v, toks, item);
    }
    if let Some(item) = &node.accessibility_modifier_identifier_or_pattern_item.accessibility_modifier {
        walk_accessibilityModifier(v, toks, item);
    }
    walk_identifierOrPattern(v, toks, &node.accessibility_modifier_identifier_or_pattern_item.identifier_or_pattern);
    if let Some(item) = &node.accessibility_modifier_identifier_or_pattern_item.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(toks, *(&inner.question));
                if let Some(item) = &inner.type_annotation {
                    walk_typeAnnotation(v, toks, item);
                }
            }
            Alt1(inner) => {
                if let Some(item) = &inner.type_annotation {
                    walk_typeAnnotation(v, toks, item);
                }
                walk_initializer(v, toks, &inner.initializer);
            }
        }
    }
    v.exit_rule(33, &"optionalParameter", &node.span);
}

pub fn walk_restParameter<V: Visitor>(v: &mut V, toks: &TokenStream, node: &RestParameterNode) {
    v.enter_rule(34, &"restParameter", &node.span);
    v.visit_token(toks, *(&node.lit_dotdotdot));
    walk_singleExpression(v, toks, &node.single_expression);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    v.exit_rule(34, &"restParameter", &node.span);
}

pub fn walk_requiredParameter<V: Visitor>(v: &mut V, toks: &TokenStream, node: &RequiredParameterNode) {
    v.enter_rule(35, &"requiredParameter", &node.span);
    if let Some(item) = &node.decorator_list {
        walk_decoratorList(v, toks, item);
    }
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, toks, item);
    }
    walk_identifierOrPattern(v, toks, &node.identifier_or_pattern);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    v.exit_rule(35, &"requiredParameter", &node.span);
}

pub fn walk_accessibilityModifier<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AccessibilityModifierNode) {
    v.enter_rule(36, &"accessibilityModifier", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(36, &"accessibilityModifier", &node.span);
}

pub fn walk_identifierOrPattern<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IdentifierOrPatternNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(37, &"identifierOrPattern", &n.span);
            walk_identifierName(v, toks, &n.identifier_name);
            v.exit_rule(37, &"identifierOrPattern", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(37, &"identifierOrPattern", &n.span);
            walk_bindingPattern(v, toks, &n.binding_pattern);
            v.exit_rule(37, &"identifierOrPattern", &n.span);
        }
    }
}

pub fn walk_constructSignature<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ConstructSignatureNode) {
    v.enter_rule(38, &"constructSignature", &node.span);
    v.visit_token(toks, *(&node.lit_new));
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, toks, item);
    }
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    v.exit_rule(38, &"constructSignature", &node.span);
}

pub fn walk_indexSignature<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IndexSignatureNode) {
    v.enter_rule(39, &"indexSignature", &node.span);
    v.visit_token(toks, *(&node.lbracket));
    walk_identifier(v, toks, &node.identifier);
    v.visit_token(toks, *(&node.colon));
    v.visit_token(toks, *(&node.number_or_string));
    v.visit_token(toks, *(&node.rbracket));
    walk_typeAnnotation(v, toks, &node.type_annotation);
    v.exit_rule(39, &"indexSignature", &node.span);
}

pub fn walk_methodSignature<V: Visitor>(v: &mut V, toks: &TokenStream, node: &MethodSignatureNode) {
    v.enter_rule(40, &"methodSignature", &node.span);
    walk_propertyName(v, toks, &node.property_name);
    if let Some(item) = &node.question {
        v.visit_token(toks, *(item));
    }
    walk_callSignature(v, toks, &node.call_signature);
    v.exit_rule(40, &"methodSignature", &node.span);
}

pub fn walk_typeAliasDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TypeAliasDeclarationNode) {
    v.enter_rule(41, &"typeAliasDeclaration", &node.span);
    if let Some(item) = &node.export_ {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.lit_type));
    walk_identifier(v, toks, &node.identifier);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, toks, item);
    }
    v.visit_token(toks, *(&node.eq));
    walk_type_(v, toks, &node.type_);
    walk_eos(v, toks, &node.eos);
    v.exit_rule(41, &"typeAliasDeclaration", &node.span);
}

pub fn walk_constructorDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ConstructorDeclarationNode) {
    v.enter_rule(42, &"constructorDeclaration", &node.span);
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, toks, item);
    }
    v.visit_token(toks, *(&node.constructor));
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(toks, *(&inner.lbrace_function_body_rbrace.lbrace));
                walk_functionBody(v, toks, &inner.lbrace_function_body_rbrace.function_body);
                v.visit_token(toks, *(&inner.lbrace_function_body_rbrace.rbrace));
            }
            Alt1(inner) => {
                v.visit_token(toks, *(&inner.semicolon));
            }
        }
    }
    v.exit_rule(42, &"constructorDeclaration", &node.span);
}

pub fn walk_interfaceDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &InterfaceDeclarationNode) {
    v.enter_rule(43, &"interfaceDeclaration", &node.span);
    if let Some(item) = &node.export_ {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.declare {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.interface_));
    walk_identifier(v, toks, &node.identifier);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, toks, item);
    }
    if let Some(item) = &node.interface_extends_clause {
        walk_interfaceExtendsClause(v, toks, item);
    }
    walk_objectType(v, toks, &node.object_type);
    if let Some(item) = &node.semicolon {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(43, &"interfaceDeclaration", &node.span);
}

pub fn walk_interfaceExtendsClause<V: Visitor>(v: &mut V, toks: &TokenStream, node: &InterfaceExtendsClauseNode) {
    v.enter_rule(44, &"interfaceExtendsClause", &node.span);
    v.visit_token(toks, *(&node.extends));
    walk_classOrInterfaceTypeList(v, toks, &node.class_or_interface_type_list);
    v.exit_rule(44, &"interfaceExtendsClause", &node.span);
}

pub fn walk_classOrInterfaceTypeList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ClassOrInterfaceTypeListNode) {
    v.enter_rule(45, &"classOrInterfaceTypeList", &node.span);
    walk_typeReference(v, toks, &node.type_reference);
    for let item of &node.comma_type_reference_list {
        v.visit_token(toks, *(&item.comma));
        walk_typeReference(v, toks, &item.type_reference);
    }
    v.exit_rule(45, &"classOrInterfaceTypeList", &node.span);
}

pub fn walk_enumDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &EnumDeclarationNode) {
    v.enter_rule(46, &"enumDeclaration", &node.span);
    if let Some(item) = &node.const_ {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.enum_));
    walk_identifier(v, toks, &node.identifier);
    v.visit_token(toks, *(&node.lbrace));
    if let Some(item) = &node.enum_body {
        walk_enumBody(v, toks, item);
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(46, &"enumDeclaration", &node.span);
}

pub fn walk_enumBody<V: Visitor>(v: &mut V, toks: &TokenStream, node: &EnumBodyNode) {
    v.enter_rule(47, &"enumBody", &node.span);
    walk_enumMemberList(v, toks, &node.enum_member_list);
    if let Some(item) = &node.comma {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(47, &"enumBody", &node.span);
}

pub fn walk_enumMemberList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &EnumMemberListNode) {
    v.enter_rule(48, &"enumMemberList", &node.span);
    walk_enumMember(v, toks, &node.enum_member);
    for let item of &node.comma_enum_member_list {
        v.visit_token(toks, *(&item.comma));
        walk_enumMember(v, toks, &item.enum_member);
    }
    v.exit_rule(48, &"enumMemberList", &node.span);
}

pub fn walk_enumMember<V: Visitor>(v: &mut V, toks: &TokenStream, node: &EnumMemberNode) {
    v.enter_rule(49, &"enumMember", &node.span);
    walk_propertyName(v, toks, &node.property_name);
    if let Some(item) = &node.eq_single_expression {
        v.visit_token(toks, *(&item.eq));
        walk_singleExpression(v, toks, &item.single_expression);
    }
    v.exit_rule(49, &"enumMember", &node.span);
}

pub fn walk_namespaceDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &NamespaceDeclarationNode) {
    v.enter_rule(50, &"namespaceDeclaration", &node.span);
    if let Some(item) = &node.declare {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.namespace));
    walk_namespaceName(v, toks, &node.namespace_name);
    v.visit_token(toks, *(&node.lbrace));
    if let Some(item) = &node.statement_list {
        walk_statementList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(50, &"namespaceDeclaration", &node.span);
}

pub fn walk_namespaceName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &NamespaceNameNode) {
    v.enter_rule(51, &"namespaceName", &node.span);
    walk_identifier(v, toks, &node.identifier);
    for let item of &node.dot_identifier_list {
        for let item of &item.dot_list {
            v.visit_token(toks, *(item));
        }
        walk_identifier(v, toks, &item.identifier);
    }
    v.exit_rule(51, &"namespaceName", &node.span);
}

pub fn walk_importAliasDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportAliasDeclarationNode) {
    v.enter_rule(52, &"importAliasDeclaration", &node.span);
    walk_identifier(v, toks, &node.identifier);
    v.visit_token(toks, *(&node.eq));
    walk_namespaceName(v, toks, &node.namespace_name);
    v.visit_token(toks, *(&node.semicolon));
    v.exit_rule(52, &"importAliasDeclaration", &node.span);
}

pub fn walk_decoratorList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &DecoratorListNode) {
    v.enter_rule(53, &"decoratorList", &node.span);
    for let item of &node.decorator_list {
        walk_decorator(v, toks, item);
    }
    v.exit_rule(53, &"decoratorList", &node.span);
}

pub fn walk_decorator<V: Visitor>(v: &mut V, toks: &TokenStream, node: &DecoratorNode) {
    v.enter_rule(54, &"decorator", &node.span);
    v.visit_token(toks, *(&node.at));
    if let Some(item) = &node.decorator_member_expression_or_decorator_call_expression {
        match item {
            DecoratorMemberExpression(inner) => {
                walk_decoratorMemberExpression(v, toks, inner);
            }
            DecoratorCallExpression(inner) => {
                walk_decoratorCallExpression(v, toks, inner);
            }
        }
    }
    v.exit_rule(54, &"decorator", &node.span);
}

pub fn walk_decoratorMemberExpression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &DecoratorMemberExpressionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(55, &"decoratorMemberExpression", &n.span);
            walk_identifier(v, toks, &n.identifier);
            v.exit_rule(55, &"decoratorMemberExpression", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(55, &"decoratorMemberExpression", &n.span);
            walk_decoratorMemberExpression(v, toks, &n.decorator_member_expression);
            v.visit_token(toks, *(&n.dot));
            walk_identifierName(v, toks, &n.identifier_name);
            v.exit_rule(55, &"decoratorMemberExpression", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(55, &"decoratorMemberExpression", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(55, &"decoratorMemberExpression", &n.span);
        }
    }
}

pub fn walk_decoratorCallExpression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &DecoratorCallExpressionNode) {
    v.enter_rule(56, &"decoratorCallExpression", &node.span);
    walk_decoratorMemberExpression(v, toks, &node.decorator_member_expression);
    walk_arguments(v, toks, &node.arguments);
    v.exit_rule(56, &"decoratorCallExpression", &node.span);
}

pub fn walk_program<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ProgramNode) {
    v.enter_rule(57, &"program", &node.span);
    if let Some(item) = &node.source_elements {
        walk_sourceElements(v, toks, item);
    }
    v.visit_token(toks, *(&node.eof));
    v.exit_rule(57, &"program", &node.span);
}

pub fn walk_sourceElement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SourceElementNode) {
    v.enter_rule(58, &"sourceElement", &node.span);
    if let Some(item) = &node.export_ {
        v.visit_token(toks, *(item));
    }
    walk_statement(v, toks, &node.statement);
    v.exit_rule(58, &"sourceElement", &node.span);
}

pub fn walk_statement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &StatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_block(v, toks, &n.block);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_variableStatement(v, toks, &n.variable_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_importStatement(v, toks, &n.import_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_exportStatement(v, toks, &n.export_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_emptyStatement_(v, toks, &n.empty_statement_);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_abstractDeclaration(v, toks, &n.abstract_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_classDeclaration(v, toks, &n.class_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_functionDeclaration(v, toks, &n.function_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_expressionStatement(v, toks, &n.expression_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_interfaceDeclaration(v, toks, &n.interface_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_namespaceDeclaration(v, toks, &n.namespace_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_ifStatement(v, toks, &n.if_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_iterationStatement(v, toks, &n.iteration_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_continueStatement(v, toks, &n.continue_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt14(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_breakStatement(v, toks, &n.break_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt15(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_returnStatement(v, toks, &n.return_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt16(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_yieldStatement(v, toks, &n.yield_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt17(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_withStatement(v, toks, &n.with_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt18(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_labelledStatement(v, toks, &n.labelled_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt19(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_switchStatement(v, toks, &n.switch_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt20(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_throwStatement(v, toks, &n.throw_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt21(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_tryStatement(v, toks, &n.try_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt22(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_debuggerStatement(v, toks, &n.debugger_statement);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt23(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_arrowFunctionDeclaration(v, toks, &n.arrow_function_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt24(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_generatorFunctionDeclaration(v, toks, &n.generator_function_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt25(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_typeAliasDeclaration(v, toks, &n.type_alias_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt26(n) => {
            v.enter_rule(59, &"statement", &n.span);
            walk_enumDeclaration(v, toks, &n.enum_declaration);
            v.exit_rule(59, &"statement", &n.span);
        }
        Alt27(n) => {
            v.enter_rule(59, &"statement", &n.span);
            v.visit_token(toks, *(&n.export_));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(59, &"statement", &n.span);
        }
    }
}

pub fn walk_block<V: Visitor>(v: &mut V, toks: &TokenStream, node: &BlockNode) {
    v.enter_rule(60, &"block", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    if let Some(item) = &node.statement_list {
        walk_statementList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(60, &"block", &node.span);
}

pub fn walk_statementList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &StatementListNode) {
    v.enter_rule(61, &"statementList", &node.span);
    for let item of &node.statement_list {
        walk_statement(v, toks, item);
    }
    v.exit_rule(61, &"statementList", &node.span);
}

pub fn walk_abstractDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AbstractDeclarationNode) {
    v.enter_rule(62, &"abstractDeclaration", &node.span);
    v.visit_token(toks, *(&node.abstract));
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_identifier(v, toks, &inner.identifier);
                walk_callSignature(v, toks, &inner.call_signature);
            }
            Alt1(inner) => {
                walk_variableStatement(v, toks, &inner.variable_statement);
            }
        }
    }
    walk_eos(v, toks, &node.eos);
    v.exit_rule(62, &"abstractDeclaration", &node.span);
}

pub fn walk_importStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportStatementNode) {
    v.enter_rule(63, &"importStatement", &node.span);
    v.visit_token(toks, *(&node.import_));
    walk_importFromBlock(v, toks, &node.import_from_block);
    v.exit_rule(63, &"importStatement", &node.span);
}

pub fn walk_importFromBlock<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportFromBlockNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(64, &"importFromBlock", &n.span);
            if let Some(item) = &n.import_default {
                walk_importDefault(v, toks, item);
            }
            if let Some(item) = &n.import_namespace_or_import_module_items {
                match item {
                    ImportNamespace(inner) => {
                        walk_importNamespace(v, toks, inner);
                    }
                    ImportModuleItems(inner) => {
                        walk_importModuleItems(v, toks, inner);
                    }
                }
            }
            walk_importFrom(v, toks, &n.import_from);
            walk_eos(v, toks, &n.eos);
            v.exit_rule(64, &"importFromBlock", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(64, &"importFromBlock", &n.span);
            v.visit_token(toks, *(&n.stringliteral));
            walk_eos(v, toks, &n.eos);
            v.exit_rule(64, &"importFromBlock", &n.span);
        }
    }
}

pub fn walk_importModuleItems<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportModuleItemsNode) {
    v.enter_rule(65, &"importModuleItems", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    for let item of &node.import_alias_name_comma_list {
        walk_importAliasName(v, toks, &item.import_alias_name);
        v.visit_token(toks, *(&item.comma));
    }
    if let Some(item) = &node.import_alias_name_comma {
        walk_importAliasName(v, toks, &item.import_alias_name);
        if let Some(item) = &item.comma {
            v.visit_token(toks, *(item));
        }
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(65, &"importModuleItems", &node.span);
}

pub fn walk_importAliasName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportAliasNameNode) {
    v.enter_rule(66, &"importAliasName", &node.span);
    walk_moduleExportName(v, toks, &node.module_export_name);
    if let Some(item) = &node.as__imported_binding {
        v.visit_token(toks, *(&item.as_));
        walk_importedBinding(v, toks, &item.imported_binding);
    }
    v.exit_rule(66, &"importAliasName", &node.span);
}

pub fn walk_moduleExportName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ModuleExportNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(67, &"moduleExportName", &n.span);
            walk_identifierName(v, toks, &n.identifier_name);
            v.exit_rule(67, &"moduleExportName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(67, &"moduleExportName", &n.span);
            v.visit_token(toks, *(&n.stringliteral));
            v.exit_rule(67, &"moduleExportName", &n.span);
        }
    }
}

pub fn walk_importedBinding<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportedBindingNode) {
    v.enter_rule(68, &"importedBinding", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(68, &"importedBinding", &node.span);
}

pub fn walk_importDefault<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportDefaultNode) {
    v.enter_rule(69, &"importDefault", &node.span);
    walk_aliasName(v, toks, &node.alias_name);
    v.visit_token(toks, *(&node.comma));
    v.exit_rule(69, &"importDefault", &node.span);
}

pub fn walk_importNamespace<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportNamespaceNode) {
    v.enter_rule(70, &"importNamespace", &node.span);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(toks, *(&inner.star));
            }
            Alt1(inner) => {
                walk_identifierName(v, toks, &inner.identifier_name);
            }
        }
    }
    if let Some(item) = &node.as__identifier_name {
        v.visit_token(toks, *(&item.as_));
        walk_identifierName(v, toks, &item.identifier_name);
    }
    v.exit_rule(70, &"importNamespace", &node.span);
}

pub fn walk_importFrom<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImportFromNode) {
    v.enter_rule(71, &"importFrom", &node.span);
    v.visit_token(toks, *(&node.from_));
    v.visit_token(toks, *(&node.stringliteral));
    v.exit_rule(71, &"importFrom", &node.span);
}

pub fn walk_aliasName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AliasNameNode) {
    v.enter_rule(72, &"aliasName", &node.span);
    walk_identifierName(v, toks, &node.identifier_name);
    if let Some(item) = &node.as__identifier_name {
        v.visit_token(toks, *(&item.as_));
        walk_identifierName(v, toks, &item.identifier_name);
    }
    v.exit_rule(72, &"aliasName", &node.span);
}

pub fn walk_exportStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExportStatementNode) {
    match node {
        ExportDeclaration(n) => {
            v.enter_rule(73, &"exportStatement", &n.span);
            v.visit_token(toks, *(&n.export_));
            if let Some(item) = &n.default {
                v.visit_token(toks, *(item));
            }
            if let Some(item) = &n.export_from_block_or_declaration {
                match item {
                    ExportFromBlock(inner) => {
                        walk_exportFromBlock(v, toks, inner);
                    }
                    Declaration(inner) => {
                        walk_declaration(v, toks, inner);
                    }
                }
            }
            walk_eos(v, toks, &n.eos);
            v.exit_rule(73, &"exportStatement", &n.span);
        }
        ExportDefaultDeclaration(n) => {
            v.enter_rule(73, &"exportStatement", &n.span);
            v.visit_token(toks, *(&n.export_));
            v.visit_token(toks, *(&n.default));
            walk_singleExpression(v, toks, &n.single_expression);
            walk_eos(v, toks, &n.eos);
            v.exit_rule(73, &"exportStatement", &n.span);
        }
    }
}

pub fn walk_exportFromBlock<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExportFromBlockNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(74, &"exportFromBlock", &n.span);
            walk_importNamespace(v, toks, &n.import_namespace);
            walk_importFrom(v, toks, &n.import_from);
            walk_eos(v, toks, &n.eos);
            v.exit_rule(74, &"exportFromBlock", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(74, &"exportFromBlock", &n.span);
            walk_exportModuleItems(v, toks, &n.export_module_items);
            if let Some(item) = &n.import_from {
                walk_importFrom(v, toks, item);
            }
            walk_eos(v, toks, &n.eos);
            v.exit_rule(74, &"exportFromBlock", &n.span);
        }
    }
}

pub fn walk_exportModuleItems<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExportModuleItemsNode) {
    v.enter_rule(75, &"exportModuleItems", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    for let item of &node.export_alias_name_comma_list {
        walk_exportAliasName(v, toks, &item.export_alias_name);
        v.visit_token(toks, *(&item.comma));
    }
    if let Some(item) = &node.export_alias_name_comma {
        walk_exportAliasName(v, toks, &item.export_alias_name);
        if let Some(item) = &item.comma {
            v.visit_token(toks, *(item));
        }
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(75, &"exportModuleItems", &node.span);
}

pub fn walk_exportAliasName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExportAliasNameNode) {
    v.enter_rule(76, &"exportAliasName", &node.span);
    walk_moduleExportName(v, toks, &node.module_export_name);
    if let Some(item) = &node.as__module_export_name {
        v.visit_token(toks, *(&item.as_));
        walk_moduleExportName(v, toks, &item.module_export_name);
    }
    v.exit_rule(76, &"exportAliasName", &node.span);
}

pub fn walk_declaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &DeclarationNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(77, &"declaration", &n.span);
            walk_variableStatement(v, toks, &n.variable_statement);
            v.exit_rule(77, &"declaration", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(77, &"declaration", &n.span);
            walk_classDeclaration(v, toks, &n.class_declaration);
            v.exit_rule(77, &"declaration", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(77, &"declaration", &n.span);
            walk_functionDeclaration(v, toks, &n.function_declaration);
            v.exit_rule(77, &"declaration", &n.span);
        }
    }
}

pub fn walk_variableStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &VariableStatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(78, &"variableStatement", &n.span);
            walk_bindingPattern(v, toks, &n.binding_pattern);
            if let Some(item) = &n.type_annotation {
                walk_typeAnnotation(v, toks, item);
            }
            walk_initializer(v, toks, &n.initializer);
            if let Some(item) = &n.semicolon {
                v.visit_token(toks, *(item));
            }
            v.exit_rule(78, &"variableStatement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(78, &"variableStatement", &n.span);
            if let Some(item) = &n.accessibility_modifier {
                walk_accessibilityModifier(v, toks, item);
            }
            if let Some(item) = &n.var_modifier {
                walk_varModifier(v, toks, item);
            }
            if let Some(item) = &n.readonly {
                v.visit_token(toks, *(item));
            }
            walk_variableDeclarationList(v, toks, &n.variable_declaration_list);
            if let Some(item) = &n.semicolon {
                v.visit_token(toks, *(item));
            }
            v.exit_rule(78, &"variableStatement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(78, &"variableStatement", &n.span);
            v.visit_token(toks, *(&n.declare));
            if let Some(item) = &n.var_modifier {
                walk_varModifier(v, toks, item);
            }
            walk_variableDeclarationList(v, toks, &n.variable_declaration_list);
            if let Some(item) = &n.semicolon {
                v.visit_token(toks, *(item));
            }
            v.exit_rule(78, &"variableStatement", &n.span);
        }
    }
}

pub fn walk_variableDeclarationList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &VariableDeclarationListNode) {
    v.enter_rule(79, &"variableDeclarationList", &node.span);
    walk_variableDeclaration(v, toks, &node.variable_declaration);
    for let item of &node.comma_variable_declaration_list {
        v.visit_token(toks, *(&item.comma));
        walk_variableDeclaration(v, toks, &item.variable_declaration);
    }
    v.exit_rule(79, &"variableDeclarationList", &node.span);
}

pub fn walk_variableDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &VariableDeclarationNode) {
    v.enter_rule(80, &"variableDeclaration", &node.span);
    if let Some(item) = &node.identifier_or_key_word_or_array_literal_or_object_literal {
        match item {
            IdentifierOrKeyWord(inner) => {
                walk_identifierOrKeyWord(v, toks, inner);
            }
            ArrayLiteral(inner) => {
                walk_arrayLiteral(v, toks, inner);
            }
            ObjectLiteral(inner) => {
                walk_objectLiteral(v, toks, inner);
            }
        }
    }
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    if let Some(item) = &node.single_expression {
        walk_singleExpression(v, toks, item);
    }
    if let Some(item) = &node.eq_type_parameters_single_expression {
        v.visit_token(toks, *(&item.eq));
        if let Some(item) = &item.type_parameters {
            walk_typeParameters(v, toks, item);
        }
        walk_singleExpression(v, toks, &item.single_expression);
    }
    v.exit_rule(80, &"variableDeclaration", &node.span);
}

pub fn walk_emptyStatement_<V: Visitor>(v: &mut V, toks: &TokenStream, node: &EmptyStatementNode) {
    v.enter_rule(81, &"emptyStatement_", &node.span);
    v.visit_token(toks, *(&node.semicolon));
    v.exit_rule(81, &"emptyStatement_", &node.span);
}

pub fn walk_expressionStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExpressionStatementNode) {
    v.enter_rule(82, &"expressionStatement", &node.span);
    walk_expressionSequence(v, toks, &node.expression_sequence);
    if let Some(item) = &node.semicolon {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(82, &"expressionStatement", &node.span);
}

pub fn walk_ifStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IfStatementNode) {
    v.enter_rule(83, &"ifStatement", &node.span);
    v.visit_token(toks, *(&node.if_));
    v.visit_token(toks, *(&node.lparen));
    walk_expressionSequence(v, toks, &node.expression_sequence);
    v.visit_token(toks, *(&node.rparen));
    walk_statement(v, toks, &node.statement);
    if let Some(item) = &node.else__statement {
        v.visit_token(toks, *(&item.else_));
        walk_statement(v, toks, &item.statement);
    }
    v.exit_rule(83, &"ifStatement", &node.span);
}

pub fn walk_iterationStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IterationStatementNode) {
    match node {
        DoStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.do));
            walk_statement(v, toks, &n.statement);
            v.visit_token(toks, *(&n.while_));
            v.visit_token(toks, *(&n.lparen));
            walk_expressionSequence(v, toks, &n.expression_sequence);
            v.visit_token(toks, *(&n.rparen));
            walk_eos(v, toks, &n.eos);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
        WhileStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.while_));
            v.visit_token(toks, *(&n.lparen));
            walk_expressionSequence(v, toks, &n.expression_sequence);
            v.visit_token(toks, *(&n.rparen));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
        ForStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.for_));
            v.visit_token(toks, *(&n.lparen));
            if let Some(item) = &n.expression_sequence {
                walk_expressionSequence(v, toks, item);
            }
            v.visit_token(toks, *(&n.semicolon));
            if let Some(item) = &n.expression_sequence_2 {
                walk_expressionSequence(v, toks, item);
            }
            v.visit_token(toks, *(&n.semicolon_2));
            if let Some(item) = &n.expression_sequence_3 {
                walk_expressionSequence(v, toks, item);
            }
            v.visit_token(toks, *(&n.rparen));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
        ForVarStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.for_));
            v.visit_token(toks, *(&n.lparen));
            walk_varModifier(v, toks, &n.var_modifier);
            walk_variableDeclarationList(v, toks, &n.variable_declaration_list);
            v.visit_token(toks, *(&n.semicolon));
            if let Some(item) = &n.expression_sequence {
                walk_expressionSequence(v, toks, item);
            }
            v.visit_token(toks, *(&n.semicolon_2));
            if let Some(item) = &n.expression_sequence_2 {
                walk_expressionSequence(v, toks, item);
            }
            v.visit_token(toks, *(&n.rparen));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
        ForInStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.for_));
            v.visit_token(toks, *(&n.lparen));
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.in_));
            walk_expressionSequence(v, toks, &n.expression_sequence);
            v.visit_token(toks, *(&n.rparen));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
        ForVarInStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.for_));
            v.visit_token(toks, *(&n.lparen));
            walk_varModifier(v, toks, &n.var_modifier);
            walk_variableDeclaration(v, toks, &n.variable_declaration);
            v.visit_token(toks, *(&n.in_));
            walk_expressionSequence(v, toks, &n.expression_sequence);
            v.visit_token(toks, *(&n.rparen));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
        ForOfStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.for_));
            if let Some(item) = &n.await {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.lparen));
            walk_singleExpression(v, toks, &n.single_expression);
            walk_identifier(v, toks, &n.identifier);
            walk_expressionSequence(v, toks, &n.expression_sequence);
            if let Some(item) = &n.as__type_ {
                v.visit_token(toks, *(&item.as_));
                walk_type_(v, toks, &item.type_);
            }
            v.visit_token(toks, *(&n.rparen));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
        ForVarOfStatement(n) => {
            v.enter_rule(84, &"iterationStatement", &n.span);
            v.visit_token(toks, *(&n.for_));
            if let Some(item) = &n.await {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.lparen));
            walk_varModifier(v, toks, &n.var_modifier);
            walk_variableDeclaration(v, toks, &n.variable_declaration);
            walk_identifier(v, toks, &n.identifier);
            walk_expressionSequence(v, toks, &n.expression_sequence);
            if let Some(item) = &n.as__type_ {
                v.visit_token(toks, *(&item.as_));
                walk_type_(v, toks, &item.type_);
            }
            v.visit_token(toks, *(&n.rparen));
            walk_statement(v, toks, &n.statement);
            v.exit_rule(84, &"iterationStatement", &n.span);
        }
    }
}

pub fn walk_varModifier<V: Visitor>(v: &mut V, toks: &TokenStream, node: &VarModifierNode) {
    v.enter_rule(85, &"varModifier", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(85, &"varModifier", &node.span);
}

pub fn walk_continueStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ContinueStatementNode) {
    v.enter_rule(86, &"continueStatement", &node.span);
    v.visit_token(toks, *(&node.continue_));
    walk_eos(v, toks, &node.eos);
    v.exit_rule(86, &"continueStatement", &node.span);
}

pub fn walk_breakStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &BreakStatementNode) {
    v.enter_rule(87, &"breakStatement", &node.span);
    v.visit_token(toks, *(&node.break_));
    walk_eos(v, toks, &node.eos);
    v.exit_rule(87, &"breakStatement", &node.span);
}

pub fn walk_returnStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ReturnStatementNode) {
    v.enter_rule(88, &"returnStatement", &node.span);
    v.visit_token(toks, *(&node.return_));
    walk_eos(v, toks, &node.eos);
    v.exit_rule(88, &"returnStatement", &node.span);
}

pub fn walk_yieldStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &YieldStatementNode) {
    v.enter_rule(89, &"yieldStatement", &node.span);
    v.visit_token(toks, *(&node.yield_or_yieldstar));
    walk_eos(v, toks, &node.eos);
    v.exit_rule(89, &"yieldStatement", &node.span);
}

pub fn walk_withStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &WithStatementNode) {
    v.enter_rule(90, &"withStatement", &node.span);
    v.visit_token(toks, *(&node.with_));
    v.visit_token(toks, *(&node.lparen));
    walk_expressionSequence(v, toks, &node.expression_sequence);
    v.visit_token(toks, *(&node.rparen));
    walk_statement(v, toks, &node.statement);
    v.exit_rule(90, &"withStatement", &node.span);
}

pub fn walk_switchStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SwitchStatementNode) {
    v.enter_rule(91, &"switchStatement", &node.span);
    v.visit_token(toks, *(&node.switch));
    v.visit_token(toks, *(&node.lparen));
    walk_expressionSequence(v, toks, &node.expression_sequence);
    v.visit_token(toks, *(&node.rparen));
    walk_caseBlock(v, toks, &node.case_block);
    v.exit_rule(91, &"switchStatement", &node.span);
}

pub fn walk_caseBlock<V: Visitor>(v: &mut V, toks: &TokenStream, node: &CaseBlockNode) {
    v.enter_rule(92, &"caseBlock", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    if let Some(item) = &node.case_clauses {
        walk_caseClauses(v, toks, item);
    }
    if let Some(item) = &node.default_clause_case_clauses {
        walk_defaultClause(v, toks, &item.default_clause);
        if let Some(item) = &item.case_clauses {
            walk_caseClauses(v, toks, item);
        }
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(92, &"caseBlock", &node.span);
}

pub fn walk_caseClauses<V: Visitor>(v: &mut V, toks: &TokenStream, node: &CaseClausesNode) {
    v.enter_rule(93, &"caseClauses", &node.span);
    for let item of &node.case_clause_list {
        walk_caseClause(v, toks, item);
    }
    v.exit_rule(93, &"caseClauses", &node.span);
}

pub fn walk_caseClause<V: Visitor>(v: &mut V, toks: &TokenStream, node: &CaseClauseNode) {
    v.enter_rule(94, &"caseClause", &node.span);
    v.visit_token(toks, *(&node.case));
    walk_expressionSequence(v, toks, &node.expression_sequence);
    v.visit_token(toks, *(&node.colon));
    if let Some(item) = &node.statement_list {
        walk_statementList(v, toks, item);
    }
    v.exit_rule(94, &"caseClause", &node.span);
}

pub fn walk_defaultClause<V: Visitor>(v: &mut V, toks: &TokenStream, node: &DefaultClauseNode) {
    v.enter_rule(95, &"defaultClause", &node.span);
    v.visit_token(toks, *(&node.default));
    v.visit_token(toks, *(&node.colon));
    if let Some(item) = &node.statement_list {
        walk_statementList(v, toks, item);
    }
    v.exit_rule(95, &"defaultClause", &node.span);
}

pub fn walk_labelledStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &LabelledStatementNode) {
    v.enter_rule(96, &"labelledStatement", &node.span);
    walk_identifier(v, toks, &node.identifier);
    v.visit_token(toks, *(&node.colon));
    walk_statement(v, toks, &node.statement);
    v.exit_rule(96, &"labelledStatement", &node.span);
}

pub fn walk_throwStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ThrowStatementNode) {
    v.enter_rule(97, &"throwStatement", &node.span);
    v.visit_token(toks, *(&node.throw));
    walk_expressionSequence(v, toks, &node.expression_sequence);
    walk_eos(v, toks, &node.eos);
    v.exit_rule(97, &"throwStatement", &node.span);
}

pub fn walk_tryStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TryStatementNode) {
    v.enter_rule(98, &"tryStatement", &node.span);
    v.visit_token(toks, *(&node.try));
    walk_block(v, toks, &node.block);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_catchProduction(v, toks, &inner.catch_production);
                if let Some(item) = &inner.finally_production {
                    walk_finallyProduction(v, toks, item);
                }
            }
            Alt1(inner) => {
                walk_finallyProduction(v, toks, &inner.finally_production);
            }
        }
    }
    v.exit_rule(98, &"tryStatement", &node.span);
}

pub fn walk_catchProduction<V: Visitor>(v: &mut V, toks: &TokenStream, node: &CatchProductionNode) {
    v.enter_rule(99, &"catchProduction", &node.span);
    v.visit_token(toks, *(&node.catch));
    if let Some(item) = &node.lparen_identifier_type_annotation_rparen {
        v.visit_token(toks, *(&item.lparen));
        walk_identifier(v, toks, &item.identifier);
        if let Some(item) = &item.type_annotation {
            walk_typeAnnotation(v, toks, item);
        }
        v.visit_token(toks, *(&item.rparen));
    }
    walk_block(v, toks, &node.block);
    v.exit_rule(99, &"catchProduction", &node.span);
}

pub fn walk_finallyProduction<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FinallyProductionNode) {
    v.enter_rule(100, &"finallyProduction", &node.span);
    v.visit_token(toks, *(&node.finally));
    walk_block(v, toks, &node.block);
    v.exit_rule(100, &"finallyProduction", &node.span);
}

pub fn walk_debuggerStatement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &DebuggerStatementNode) {
    v.enter_rule(101, &"debuggerStatement", &node.span);
    v.visit_token(toks, *(&node.debugger));
    walk_eos(v, toks, &node.eos);
    v.exit_rule(101, &"debuggerStatement", &node.span);
}

pub fn walk_functionDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FunctionDeclarationNode) {
    v.enter_rule(102, &"functionDeclaration", &node.span);
    if let Some(item) = &node.async_ {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.function_));
    if let Some(item) = &node.star {
        v.visit_token(toks, *(item));
    }
    walk_identifier(v, toks, &node.identifier);
    walk_callSignature(v, toks, &node.call_signature);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(toks, *(&inner.lbrace_function_body_rbrace.lbrace));
                walk_functionBody(v, toks, &inner.lbrace_function_body_rbrace.function_body);
                v.visit_token(toks, *(&inner.lbrace_function_body_rbrace.rbrace));
            }
            Alt1(inner) => {
                v.visit_token(toks, *(&inner.semicolon));
            }
        }
    }
    v.exit_rule(102, &"functionDeclaration", &node.span);
}

pub fn walk_classDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ClassDeclarationNode) {
    v.enter_rule(103, &"classDeclaration", &node.span);
    if let Some(item) = &node.decorator_list {
        walk_decoratorList(v, toks, item);
    }
    if let Some(item) = &node.export__default {
        v.visit_token(toks, *(&item.export_));
        if let Some(item) = &item.default {
            v.visit_token(toks, *(item));
        }
    }
    if let Some(item) = &node.abstract {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.class));
    walk_identifier(v, toks, &node.identifier);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, toks, item);
    }
    walk_classHeritage(v, toks, &node.class_heritage);
    walk_classTail(v, toks, &node.class_tail);
    v.exit_rule(103, &"classDeclaration", &node.span);
}

pub fn walk_classHeritage<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ClassHeritageNode) {
    v.enter_rule(104, &"classHeritage", &node.span);
    if let Some(item) = &node.class_extends_clause {
        walk_classExtendsClause(v, toks, item);
    }
    if let Some(item) = &node.implements_clause {
        walk_implementsClause(v, toks, item);
    }
    v.exit_rule(104, &"classHeritage", &node.span);
}

pub fn walk_classTail<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ClassTailNode) {
    v.enter_rule(105, &"classTail", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    for let item of &node.class_element_list {
        walk_classElement(v, toks, item);
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(105, &"classTail", &node.span);
}

pub fn walk_classExtendsClause<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ClassExtendsClauseNode) {
    v.enter_rule(106, &"classExtendsClause", &node.span);
    v.visit_token(toks, *(&node.extends));
    walk_typeReference(v, toks, &node.type_reference);
    v.exit_rule(106, &"classExtendsClause", &node.span);
}

pub fn walk_implementsClause<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ImplementsClauseNode) {
    v.enter_rule(107, &"implementsClause", &node.span);
    v.visit_token(toks, *(&node.implements));
    walk_classOrInterfaceTypeList(v, toks, &node.class_or_interface_type_list);
    v.exit_rule(107, &"implementsClause", &node.span);
}

pub fn walk_classElement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ClassElementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(108, &"classElement", &n.span);
            walk_constructorDeclaration(v, toks, &n.constructor_declaration);
            v.exit_rule(108, &"classElement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(108, &"classElement", &n.span);
            if let Some(item) = &n.decorator_list {
                walk_decoratorList(v, toks, item);
            }
            walk_propertyMemberDeclaration(v, toks, &n.property_member_declaration);
            v.exit_rule(108, &"classElement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(108, &"classElement", &n.span);
            walk_indexMemberDeclaration(v, toks, &n.index_member_declaration);
            v.exit_rule(108, &"classElement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(108, &"classElement", &n.span);
            walk_statement(v, toks, &n.statement);
            v.exit_rule(108, &"classElement", &n.span);
        }
    }
}

pub fn walk_propertyMemberDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PropertyMemberDeclarationNode) {
    match node {
        PropertyDeclarationExpression(n) => {
            v.enter_rule(109, &"propertyMemberDeclaration", &n.span);
            walk_propertyMemberBase(v, toks, &n.property_member_base);
            walk_propertyName(v, toks, &n.property_name);
            if let Some(item) = &n.question {
                v.visit_token(toks, *(item));
            }
            if let Some(item) = &n.type_annotation {
                walk_typeAnnotation(v, toks, item);
            }
            if let Some(item) = &n.initializer {
                walk_initializer(v, toks, item);
            }
            v.visit_token(toks, *(&n.semicolon));
            v.exit_rule(109, &"propertyMemberDeclaration", &n.span);
        }
        MethodDeclarationExpression(n) => {
            v.enter_rule(109, &"propertyMemberDeclaration", &n.span);
            walk_propertyMemberBase(v, toks, &n.property_member_base);
            walk_propertyName(v, toks, &n.property_name);
            walk_callSignature(v, toks, &n.call_signature);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(toks, *(&inner.lbrace_function_body_rbrace.lbrace));
                        walk_functionBody(v, toks, &inner.lbrace_function_body_rbrace.function_body);
                        v.visit_token(toks, *(&inner.lbrace_function_body_rbrace.rbrace));
                    }
                    Alt1(inner) => {
                        v.visit_token(toks, *(&inner.semicolon));
                    }
                }
            }
            v.exit_rule(109, &"propertyMemberDeclaration", &n.span);
        }
        GetterSetterDeclarationExpression(n) => {
            v.enter_rule(109, &"propertyMemberDeclaration", &n.span);
            walk_propertyMemberBase(v, toks, &n.property_member_base);
            if let Some(item) = &n.get_accessor_or_set_accessor {
                match item {
                    GetAccessor(inner) => {
                        walk_getAccessor(v, toks, inner);
                    }
                    SetAccessor(inner) => {
                        walk_setAccessor(v, toks, inner);
                    }
                }
            }
            v.exit_rule(109, &"propertyMemberDeclaration", &n.span);
        }
        AbstractMemberDeclaration(n) => {
            v.enter_rule(109, &"propertyMemberDeclaration", &n.span);
            walk_abstractDeclaration(v, toks, &n.abstract_declaration);
            v.exit_rule(109, &"propertyMemberDeclaration", &n.span);
        }
    }
}

pub fn walk_propertyMemberBase<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PropertyMemberBaseNode) {
    v.enter_rule(110, &"propertyMemberBase", &node.span);
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, toks, item);
    }
    if let Some(item) = &node.async_ {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.static {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.readonly {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(110, &"propertyMemberBase", &node.span);
}

pub fn walk_indexMemberDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IndexMemberDeclarationNode) {
    v.enter_rule(111, &"indexMemberDeclaration", &node.span);
    walk_indexSignature(v, toks, &node.index_signature);
    v.visit_token(toks, *(&node.semicolon));
    v.exit_rule(111, &"indexMemberDeclaration", &node.span);
}

pub fn walk_generatorMethod<V: Visitor>(v: &mut V, toks: &TokenStream, node: &GeneratorMethodNode) {
    v.enter_rule(112, &"generatorMethod", &node.span);
    if let Some(item) = &node.star {
        v.visit_token(toks, *(item));
    }
    walk_propertyName(v, toks, &node.property_name);
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    v.visit_token(toks, *(&node.lbrace));
    walk_functionBody(v, toks, &node.function_body);
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(112, &"generatorMethod", &node.span);
}

pub fn walk_generatorFunctionDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &GeneratorFunctionDeclarationNode) {
    v.enter_rule(113, &"generatorFunctionDeclaration", &node.span);
    if let Some(item) = &node.async_ {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.function_));
    v.visit_token(toks, *(&node.star));
    if let Some(item) = &node.identifier {
        walk_identifier(v, toks, item);
    }
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    v.visit_token(toks, *(&node.lbrace));
    walk_functionBody(v, toks, &node.function_body);
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(113, &"generatorFunctionDeclaration", &node.span);
}

pub fn walk_generatorBlock<V: Visitor>(v: &mut V, toks: &TokenStream, node: &GeneratorBlockNode) {
    v.enter_rule(114, &"generatorBlock", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    walk_generatorDefinition(v, toks, &node.generator_definition);
    for let item of &node.comma_generator_definition_list {
        v.visit_token(toks, *(&item.comma));
        walk_generatorDefinition(v, toks, &item.generator_definition);
    }
    if let Some(item) = &node.comma {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(114, &"generatorBlock", &node.span);
}

pub fn walk_generatorDefinition<V: Visitor>(v: &mut V, toks: &TokenStream, node: &GeneratorDefinitionNode) {
    v.enter_rule(115, &"generatorDefinition", &node.span);
    v.visit_token(toks, *(&node.star));
    walk_iteratorDefinition(v, toks, &node.iterator_definition);
    v.exit_rule(115, &"generatorDefinition", &node.span);
}

pub fn walk_iteratorBlock<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IteratorBlockNode) {
    v.enter_rule(116, &"iteratorBlock", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    walk_iteratorDefinition(v, toks, &node.iterator_definition);
    for let item of &node.comma_iterator_definition_list {
        v.visit_token(toks, *(&item.comma));
        walk_iteratorDefinition(v, toks, &item.iterator_definition);
    }
    if let Some(item) = &node.comma {
        v.visit_token(toks, *(item));
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(116, &"iteratorBlock", &node.span);
}

pub fn walk_iteratorDefinition<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IteratorDefinitionNode) {
    v.enter_rule(117, &"iteratorDefinition", &node.span);
    v.visit_token(toks, *(&node.lbracket));
    walk_singleExpression(v, toks, &node.single_expression);
    v.visit_token(toks, *(&node.rbracket));
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    v.visit_token(toks, *(&node.lbrace));
    walk_functionBody(v, toks, &node.function_body);
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(117, &"iteratorDefinition", &node.span);
}

pub fn walk_classElementName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ClassElementNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(118, &"classElementName", &n.span);
            walk_propertyName(v, toks, &n.property_name);
            v.exit_rule(118, &"classElementName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(118, &"classElementName", &n.span);
            walk_privateIdentifier(v, toks, &n.private_identifier);
            v.exit_rule(118, &"classElementName", &n.span);
        }
    }
}

pub fn walk_privateIdentifier<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PrivateIdentifierNode) {
    v.enter_rule(119, &"privateIdentifier", &node.span);
    v.visit_token(toks, *(&node.hash));
    walk_identifierName(v, toks, &node.identifier_name);
    v.exit_rule(119, &"privateIdentifier", &node.span);
}

pub fn walk_formalParameterList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FormalParameterListNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(120, &"formalParameterList", &n.span);
            walk_formalParameterArg(v, toks, &n.formal_parameter_arg);
            for let item of &n.comma_formal_parameter_arg_list {
                v.visit_token(toks, *(&item.comma));
                walk_formalParameterArg(v, toks, &item.formal_parameter_arg);
            }
            if let Some(item) = &n.comma_last_formal_parameter_arg {
                v.visit_token(toks, *(&item.comma));
                walk_lastFormalParameterArg(v, toks, &item.last_formal_parameter_arg);
            }
            if let Some(item) = &n.comma {
                v.visit_token(toks, *(item));
            }
            v.exit_rule(120, &"formalParameterList", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(120, &"formalParameterList", &n.span);
            walk_lastFormalParameterArg(v, toks, &n.last_formal_parameter_arg);
            v.exit_rule(120, &"formalParameterList", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(120, &"formalParameterList", &n.span);
            walk_arrayLiteral(v, toks, &n.array_literal);
            v.exit_rule(120, &"formalParameterList", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(120, &"formalParameterList", &n.span);
            walk_objectLiteral(v, toks, &n.object_literal);
            if let Some(item) = &n.colon_formal_parameter_list {
                v.visit_token(toks, *(&item.colon));
                walk_formalParameterList(v, toks, &item.formal_parameter_list);
            }
            v.exit_rule(120, &"formalParameterList", &n.span);
        }
    }
}

pub fn walk_formalParameterArg<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FormalParameterArgNode) {
    v.enter_rule(121, &"formalParameterArg", &node.span);
    if let Some(item) = &node.decorator {
        walk_decorator(v, toks, item);
    }
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, toks, item);
    }
    walk_assignable(v, toks, &node.assignable);
    if let Some(item) = &node.question {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    if let Some(item) = &node.eq_single_expression {
        v.visit_token(toks, *(&item.eq));
        walk_singleExpression(v, toks, &item.single_expression);
    }
    v.exit_rule(121, &"formalParameterArg", &node.span);
}

pub fn walk_lastFormalParameterArg<V: Visitor>(v: &mut V, toks: &TokenStream, node: &LastFormalParameterArgNode) {
    v.enter_rule(122, &"lastFormalParameterArg", &node.span);
    v.visit_token(toks, *(&node.ellipsis));
    walk_identifier(v, toks, &node.identifier);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    v.exit_rule(122, &"lastFormalParameterArg", &node.span);
}

pub fn walk_functionBody<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FunctionBodyNode) {
    v.enter_rule(123, &"functionBody", &node.span);
    if let Some(item) = &node.source_elements {
        walk_sourceElements(v, toks, item);
    }
    v.exit_rule(123, &"functionBody", &node.span);
}

pub fn walk_sourceElements<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SourceElementsNode) {
    v.enter_rule(124, &"sourceElements", &node.span);
    for let item of &node.source_element_list {
        walk_sourceElement(v, toks, item);
    }
    v.exit_rule(124, &"sourceElements", &node.span);
}

pub fn walk_arrayLiteral<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArrayLiteralNode) {
    v.enter_rule(125, &"arrayLiteral", &node.span);
    v.visit_token(toks, *(&node.lbracket_element_list_rbracket.lbracket));
    walk_elementList(v, toks, &node.lbracket_element_list_rbracket.element_list);
    v.visit_token(toks, *(&node.lbracket_element_list_rbracket.rbracket));
    v.exit_rule(125, &"arrayLiteral", &node.span);
}

pub fn walk_elementList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ElementListNode) {
    v.enter_rule(126, &"elementList", &node.span);
    for let item of &node.comma_list {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.array_element {
        walk_arrayElement(v, toks, item);
    }
    for let item of &node.comma_array_element_list {
        for let item of &item.comma_list {
            v.visit_token(toks, *(item));
        }
        walk_arrayElement(v, toks, &item.array_element);
    }
    for let item of &node.comma_list_2 {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(126, &"elementList", &node.span);
}

pub fn walk_arrayElement<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArrayElementNode) {
    v.enter_rule(127, &"arrayElement", &node.span);
    if let Some(item) = &node.ellipsis {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.single_expression_or_identifier {
        match item {
            SingleExpression(inner) => {
                walk_singleExpression(v, toks, inner);
            }
            Identifier(inner) => {
                walk_identifier(v, toks, inner);
            }
        }
    }
    if let Some(item) = &node.comma {
        v.visit_token(toks, *(item));
    }
    v.exit_rule(127, &"arrayElement", &node.span);
}

pub fn walk_objectLiteral<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ObjectLiteralNode) {
    v.enter_rule(128, &"objectLiteral", &node.span);
    v.visit_token(toks, *(&node.lbrace));
    if let Some(item) = &node.property_assignment_item_comma {
        walk_propertyAssignment(v, toks, &item.property_assignment);
        for let item of &item.comma_property_assignment_list {
            v.visit_token(toks, *(&item.comma));
            walk_propertyAssignment(v, toks, &item.property_assignment);
        }
        if let Some(item) = &item.comma {
            v.visit_token(toks, *(item));
        }
    }
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(128, &"objectLiteral", &node.span);
}

pub fn walk_propertyAssignment<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PropertyAssignmentNode) {
    match node {
        PropertyExpressionAssignment(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            walk_propertyName(v, toks, &n.property_name);
            v.visit_token(toks, *(&n.colon_or_eq));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
        ComputedPropertyExpressionAssignment(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            v.visit_token(toks, *(&n.lbracket));
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.rbracket));
            v.visit_token(toks, *(&n.colon));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
        PropertyGetter(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            walk_getAccessor(v, toks, &n.get_accessor);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
        PropertySetter(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            walk_setAccessor(v, toks, &n.set_accessor);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
        MethodProperty(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            walk_generatorMethod(v, toks, &n.generator_method);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
        PropertyShorthand(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            walk_identifierOrKeyWord(v, toks, &n.identifier_or_key_word);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
        SpreadOperator(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            if let Some(item) = &n.ellipsis {
                v.visit_token(toks, *(item));
            }
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
        RestParameterInObject(n) => {
            v.enter_rule(129, &"propertyAssignment", &n.span);
            walk_restParameter(v, toks, &n.rest_parameter);
            v.exit_rule(129, &"propertyAssignment", &n.span);
        }
    }
}

pub fn walk_getAccessor<V: Visitor>(v: &mut V, toks: &TokenStream, node: &GetAccessorNode) {
    v.enter_rule(130, &"getAccessor", &node.span);
    walk_getter(v, toks, &node.getter);
    v.visit_token(toks, *(&node.lparen));
    v.visit_token(toks, *(&node.rparen));
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    v.visit_token(toks, *(&node.lbrace));
    walk_functionBody(v, toks, &node.function_body);
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(130, &"getAccessor", &node.span);
}

pub fn walk_setAccessor<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SetAccessorNode) {
    v.enter_rule(131, &"setAccessor", &node.span);
    walk_setter(v, toks, &node.setter);
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    v.visit_token(toks, *(&node.lbrace));
    walk_functionBody(v, toks, &node.function_body);
    v.visit_token(toks, *(&node.rbrace));
    v.exit_rule(131, &"setAccessor", &node.span);
}

pub fn walk_propertyName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PropertyNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(132, &"propertyName", &n.span);
            walk_identifierName(v, toks, &n.identifier_name);
            v.exit_rule(132, &"propertyName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(132, &"propertyName", &n.span);
            v.visit_token(toks, *(&n.stringliteral));
            v.exit_rule(132, &"propertyName", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(132, &"propertyName", &n.span);
            walk_numericLiteral(v, toks, &n.numeric_literal);
            v.exit_rule(132, &"propertyName", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(132, &"propertyName", &n.span);
            v.visit_token(toks, *(&n.lbracket));
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(132, &"propertyName", &n.span);
        }
    }
}

pub fn walk_arguments<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArgumentsNode) {
    v.enter_rule(133, &"arguments", &node.span);
    v.visit_token(toks, *(&node.lparen));
    if let Some(item) = &node.argument_list_comma {
        walk_argumentList(v, toks, &item.argument_list);
        if let Some(item) = &item.comma {
            v.visit_token(toks, *(item));
        }
    }
    v.visit_token(toks, *(&node.rparen));
    v.exit_rule(133, &"arguments", &node.span);
}

pub fn walk_argumentList<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArgumentListNode) {
    v.enter_rule(134, &"argumentList", &node.span);
    walk_argument(v, toks, &node.argument);
    for let item of &node.comma_argument_list {
        v.visit_token(toks, *(&item.comma));
        walk_argument(v, toks, &item.argument);
    }
    v.exit_rule(134, &"argumentList", &node.span);
}

pub fn walk_argument<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArgumentNode) {
    v.enter_rule(135, &"argument", &node.span);
    if let Some(item) = &node.ellipsis {
        v.visit_token(toks, *(item));
    }
    if let Some(item) = &node.single_expression_or_identifier {
        match item {
            SingleExpression(inner) => {
                walk_singleExpression(v, toks, inner);
            }
            Identifier(inner) => {
                walk_identifier(v, toks, inner);
            }
        }
    }
    v.exit_rule(135, &"argument", &node.span);
}

pub fn walk_expressionSequence<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExpressionSequenceNode) {
    v.enter_rule(136, &"expressionSequence", &node.span);
    walk_singleExpression(v, toks, &node.single_expression);
    for let item of &node.comma_single_expression_list {
        v.visit_token(toks, *(&item.comma));
        walk_singleExpression(v, toks, &item.single_expression);
    }
    v.exit_rule(136, &"expressionSequence", &node.span);
}

pub fn walk_singleExpression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SingleExpressionNode) {
    match node {
        FunctionExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_anonymousFunction(v, toks, &n.anonymous_function);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        ClassExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.class));
            if let Some(item) = &n.identifier {
                walk_identifier(v, toks, item);
            }
            if let Some(item) = &n.type_parameters {
                walk_typeParameters(v, toks, item);
            }
            walk_classHeritage(v, toks, &n.class_heritage);
            walk_classTail(v, toks, &n.class_tail);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        MemberIndexExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            if let Some(item) = &n.lit_questiondot {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.lbracket));
            walk_expressionSequence(v, toks, &n.expression_sequence);
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        OptionalChainExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_questiondot));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        MemberDotExpression0(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            if let Some(item) = &n.bang {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.dot));
            if let Some(item) = &n.hash {
                v.visit_token(toks, *(item));
            }
            walk_identifierName(v, toks, &n.identifier_name);
            if let Some(item) = &n.type_generic {
                walk_typeGeneric(v, toks, item);
            }
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        MemberDotExpression1(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            if let Some(item) = &n.question {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.dot));
            if let Some(item) = &n.hash {
                v.visit_token(toks, *(item));
            }
            walk_identifierName(v, toks, &n.identifier_name);
            if let Some(item) = &n.type_generic {
                walk_typeGeneric(v, toks, item);
            }
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        NewExpression0(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.new));
            walk_singleExpression(v, toks, &n.single_expression);
            if let Some(item) = &n.type_arguments {
                walk_typeArguments(v, toks, item);
            }
            walk_arguments(v, toks, &n.arguments);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        NewExpression1(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.new));
            walk_singleExpression(v, toks, &n.single_expression);
            if let Some(item) = &n.type_arguments {
                walk_typeArguments(v, toks, item);
            }
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        ArgumentsExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            walk_arguments(v, toks, &n.arguments);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        PostIncrementExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_plusplus));
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        PostDecreaseExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_minusminus));
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        DeleteExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.delete));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        VoidExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.void));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        TypeofExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.typeof));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        PreIncrementExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.lit_plusplus));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        PreDecreaseExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.lit_minusminus));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        UnaryPlusExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.plus));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        UnaryMinusExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.minus));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        BitNotExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.tilde));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        NotExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.bang));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        AwaitExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.await));
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        PowerExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_starstar));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        MultiplicativeExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.star_or_slash_or_percent));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        AdditiveExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.plus_or_minus));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        CoalesceExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_questionquestion));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        BitShiftExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(toks, *(&inner.lit_ltlt));
                    }
                    Alt1(inner) => {
                        v.visit_token(toks, *(&inner.gt));
                        v.visit_token(toks, *(&inner.gt_2));
                    }
                    Alt2(inner) => {
                        v.visit_token(toks, *(&inner.gt));
                        v.visit_token(toks, *(&inner.gt_2));
                        v.visit_token(toks, *(&inner.gt_3));
                    }
                }
            }
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        RelationalExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lt_or_gt_or_lit_lteq_or_lit_gteq));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        InstanceofExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.instanceof));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        InExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.in_));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        EqualityExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_eqeq_or_lit_bangeq_or_lit_eqeqeq_or_lit_bangeqeq));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        BitAndExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.amp));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        BitXOrExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.caret));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        BitOrExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.pipe));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        LogicalAndExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_ampamp));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        LogicalOrExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.lit_pipepipe));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        TernaryExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.question));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.visit_token(toks, *(&n.colon));
            walk_singleExpression(v, toks, &n.single_expression_3);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        AssignmentExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.eq));
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        AssignmentOperatorExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            walk_assignmentOperator(v, toks, &n.assignment_operator);
            walk_singleExpression(v, toks, &n.single_expression_2);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        TemplateStringExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            walk_templateStringLiteral(v, toks, &n.template_string_literal);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        IteratorsExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_iteratorBlock(v, toks, &n.iterator_block);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        GeneratorsExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_generatorBlock(v, toks, &n.generator_block);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        GeneratorsFunctionExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_generatorFunctionDeclaration(v, toks, &n.generator_function_declaration);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        YieldExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_yieldStatement(v, toks, &n.yield_statement);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        ThisExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.this));
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        IdentifierExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_identifierName(v, toks, &n.identifier_name);
            if let Some(item) = &n.single_expression {
                walk_singleExpression(v, toks, item);
            }
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        SuperExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.super));
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        LiteralExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_literal(v, toks, &n.literal);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        ArrayLiteralExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_arrayLiteral(v, toks, &n.array_literal);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        ObjectLiteralExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_objectLiteral(v, toks, &n.object_literal);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        ParenthesizedExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_expressionSequence(v, toks, &n.expression_sequence);
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        GenericTypes(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_typeArguments(v, toks, &n.type_arguments);
            if let Some(item) = &n.expression_sequence {
                walk_expressionSequence(v, toks, item);
            }
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        CastAsExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.as_));
            walk_asExpression(v, toks, &n.as_expression);
            v.exit_rule(137, &"singleExpression", &n.span);
        }
        NonNullAssertionExpression(n) => {
            v.enter_rule(137, &"singleExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.bang));
            v.exit_rule(137, &"singleExpression", &n.span);
        }
    }
}

pub fn walk_asExpression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AsExpressionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(138, &"asExpression", &n.span);
            walk_predefinedType(v, toks, &n.predefined_type);
            if let Some(item) = &n.lbracket_rbracket {
                v.visit_token(toks, *(&item.lbracket));
                v.visit_token(toks, *(&item.rbracket));
            }
            v.exit_rule(138, &"asExpression", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(138, &"asExpression", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(138, &"asExpression", &n.span);
        }
    }
}

pub fn walk_assignable<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AssignableNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(139, &"assignable", &n.span);
            walk_identifier(v, toks, &n.identifier);
            v.exit_rule(139, &"assignable", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(139, &"assignable", &n.span);
            walk_keyword(v, toks, &n.keyword);
            v.exit_rule(139, &"assignable", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(139, &"assignable", &n.span);
            walk_arrayLiteral(v, toks, &n.array_literal);
            v.exit_rule(139, &"assignable", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(139, &"assignable", &n.span);
            walk_objectLiteral(v, toks, &n.object_literal);
            v.exit_rule(139, &"assignable", &n.span);
        }
    }
}

pub fn walk_anonymousFunction<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AnonymousFunctionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(140, &"anonymousFunction", &n.span);
            walk_functionDeclaration(v, toks, &n.function_declaration);
            v.exit_rule(140, &"anonymousFunction", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(140, &"anonymousFunction", &n.span);
            if let Some(item) = &n.async_ {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.function_));
            if let Some(item) = &n.star {
                v.visit_token(toks, *(item));
            }
            v.visit_token(toks, *(&n.lparen));
            if let Some(item) = &n.formal_parameter_list {
                walk_formalParameterList(v, toks, item);
            }
            v.visit_token(toks, *(&n.rparen));
            if let Some(item) = &n.type_annotation {
                walk_typeAnnotation(v, toks, item);
            }
            v.visit_token(toks, *(&n.lbrace));
            walk_functionBody(v, toks, &n.function_body);
            v.visit_token(toks, *(&n.rbrace));
            v.exit_rule(140, &"anonymousFunction", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(140, &"anonymousFunction", &n.span);
            walk_arrowFunctionDeclaration(v, toks, &n.arrow_function_declaration);
            v.exit_rule(140, &"anonymousFunction", &n.span);
        }
    }
}

pub fn walk_arrowFunctionDeclaration<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArrowFunctionDeclarationNode) {
    v.enter_rule(141, &"arrowFunctionDeclaration", &node.span);
    if let Some(item) = &node.async_ {
        v.visit_token(toks, *(item));
    }
    walk_arrowFunctionParameters(v, toks, &node.arrow_function_parameters);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, toks, item);
    }
    v.visit_token(toks, *(&node.lit_eqgt));
    walk_arrowFunctionBody(v, toks, &node.arrow_function_body);
    v.exit_rule(141, &"arrowFunctionDeclaration", &node.span);
}

pub fn walk_arrowFunctionParameters<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArrowFunctionParametersNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(142, &"arrowFunctionParameters", &n.span);
            walk_propertyName(v, toks, &n.property_name);
            v.exit_rule(142, &"arrowFunctionParameters", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(142, &"arrowFunctionParameters", &n.span);
            v.visit_token(toks, *(&n.lparen));
            if let Some(item) = &n.formal_parameter_list {
                walk_formalParameterList(v, toks, item);
            }
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(142, &"arrowFunctionParameters", &n.span);
        }
    }
}

pub fn walk_arrowFunctionBody<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ArrowFunctionBodyNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(143, &"arrowFunctionBody", &n.span);
            walk_singleExpression(v, toks, &n.single_expression);
            v.exit_rule(143, &"arrowFunctionBody", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(143, &"arrowFunctionBody", &n.span);
            v.visit_token(toks, *(&n.lbrace));
            walk_functionBody(v, toks, &n.function_body);
            v.visit_token(toks, *(&n.rbrace));
            v.exit_rule(143, &"arrowFunctionBody", &n.span);
        }
    }
}

pub fn walk_assignmentOperator<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AssignmentOperatorNode) {
    v.enter_rule(144, &"assignmentOperator", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(144, &"assignmentOperator", &node.span);
}

pub fn walk_literal<V: Visitor>(v: &mut V, toks: &TokenStream, node: &LiteralNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(145, &"literal", &n.span);
            v.visit_token(toks, *(&n.nullliteral));
            v.exit_rule(145, &"literal", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(145, &"literal", &n.span);
            v.visit_token(toks, *(&n.booleanliteral));
            v.exit_rule(145, &"literal", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(145, &"literal", &n.span);
            v.visit_token(toks, *(&n.stringliteral));
            v.exit_rule(145, &"literal", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(145, &"literal", &n.span);
            walk_templateStringLiteral(v, toks, &n.template_string_literal);
            v.exit_rule(145, &"literal", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(145, &"literal", &n.span);
            v.visit_token(toks, *(&n.regularexpressionliteral));
            v.exit_rule(145, &"literal", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(145, &"literal", &n.span);
            walk_numericLiteral(v, toks, &n.numeric_literal);
            v.exit_rule(145, &"literal", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(145, &"literal", &n.span);
            walk_bigintLiteral(v, toks, &n.bigint_literal);
            v.exit_rule(145, &"literal", &n.span);
        }
    }
}

pub fn walk_templateStringLiteral<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TemplateStringLiteralNode) {
    v.enter_rule(146, &"templateStringLiteral", &node.span);
    v.visit_token(toks, *(&node.backtick));
    for let item of &node.template_string_atom_list {
        walk_templateStringAtom(v, toks, item);
    }
    v.visit_token(toks, *(&node.backtick_2));
    v.exit_rule(146, &"templateStringLiteral", &node.span);
}

pub fn walk_templateStringAtom<V: Visitor>(v: &mut V, toks: &TokenStream, node: &TemplateStringAtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(147, &"templateStringAtom", &n.span);
            v.visit_token(toks, *(&n.templatestringatom));
            v.exit_rule(147, &"templateStringAtom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(147, &"templateStringAtom", &n.span);
            v.visit_token(toks, *(&n.templatestringstartexpression));
            walk_singleExpression(v, toks, &n.single_expression);
            v.visit_token(toks, *(&n.templateclosebrace));
            v.exit_rule(147, &"templateStringAtom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(147, &"templateStringAtom", &n.span);
            v.visit_token(toks, *(&n.templatestringescapeatom));
            v.exit_rule(147, &"templateStringAtom", &n.span);
        }
    }
}

pub fn walk_numericLiteral<V: Visitor>(v: &mut V, toks: &TokenStream, node: &NumericLiteralNode) {
    v.enter_rule(148, &"numericLiteral", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(148, &"numericLiteral", &node.span);
}

