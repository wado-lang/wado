        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        let type_parameter = _parse_type_parameter(p, follow)?;
        let comma_type_parameter = CommaTypeParameterItem {
            comma,
            type_parameter,
