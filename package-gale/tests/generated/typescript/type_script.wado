                        let sp = pos;
                        if pos >= tokens.len() || tokens[pos] != TK_LIT_DOT { pos = -1; } else { pos += 1; }
                        if pos < 0 { pos = sp; break; }
                        if pos == sp { break; }
                    }
                    pos = scan_identifier(tokens, pos, follow, 0);
                    if pos < 0 { break sg_116; }
                    break sg_116_done;
                }
                break rep_scan;
