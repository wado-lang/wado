            single_expression_or_identifier_inner = Option::Some(SingleExpressionOrIdentifierGroup::Identifier(identifier));
        }
    }
    let single_expression_or_identifier = single_expression_or_identifier_inner;
    return Result::Ok(ArgumentNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        ellipsis,
