    let start = p.peek_start();
    let type_parameter = _parse_type_parameter(p, follow)?;
    let mut comma_type_parameter_list: List<CommaTypeParameterItem> = [];
    loop {
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
