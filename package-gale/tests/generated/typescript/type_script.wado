            let comma = p.expect(TK_LIT_COMMA)?;
            Option::Some(comma)
        } else {
            null
        };
        let argument_list_comma = ArgumentListCommaOptItem {
            argument_list,
            comma,
        };
        Option::Some(argument_list_comma)
