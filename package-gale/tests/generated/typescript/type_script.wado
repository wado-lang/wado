fn _parse_argument_list__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ArgumentListNode, ParseError> {
    let start = p.peek_start();
    let argument = _parse_argument(p, follow)?;
    let mut comma_argument_list: List<CommaArgumentItem> = [];
    loop {
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_136_done: {
                sg_136: {
                    if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_136; }
                    pos += 1;
                    pos = scan_argument(tokens, pos, follow, 0);
                    if pos < 0 { break sg_136; }
                    break sg_136_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        let argument = _parse_argument(p, follow)?;
        let comma_argument = CommaArgumentItem {
            comma,
            argument,
        };
        comma_argument_list.push(comma_argument);
    }
    return Result::Ok(ArgumentListNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        argument,
        comma_argument_list,
    });
