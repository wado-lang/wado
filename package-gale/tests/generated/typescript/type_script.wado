        class_element_list.push(class_element);
    }
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::Ok(ClassTailNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lbrace,
        class_element_list,
        rbrace,
    });
