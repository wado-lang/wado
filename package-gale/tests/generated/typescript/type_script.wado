        let comma_rest_parameter: Option<CommaRestParameterItem> = if !(follow_yields(&p.kinds, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_LIT_COMMA) {
            let comma = p.expect(TK_LIT_COMMA)?;
            let rest_parameter = _parse_rest_parameter(p, follow)?;
            let comma_rest_parameter = CommaRestParameterItem {
                comma,
                rest_parameter,
            };
            Option::Some(comma_rest_parameter)
        } else {
            null
        };
        let comma: Option<i32> = if follow_yields(&p.kinds, p.pos, follow, TK_EOF) {
            null
        } else if p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            Option::Some(comma)
        } else {
            null
        };
        return Result::Ok(ParameterListNode::Alt1(ParameterListAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            parameter,
            comma_parameter_list,
            comma_rest_parameter,
            comma,
