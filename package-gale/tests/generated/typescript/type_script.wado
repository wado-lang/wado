fn _parse_parameter_list__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ParameterListNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_LIT_DOTDOTDOT {
        let rest_parameter = _parse_rest_parameter(p, follow)?;
        return Result::Ok(ParameterListNode::Alt0(ParameterListAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            rest_parameter,
        }));
    }
    if _gale_kind_set_10(kind) {
        let parameter = _parse_parameter(p, follow)?;
        let mut comma_parameter_list: List<CommaParameterItem> = [];
        loop {
            if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.kinds;
