        } else {
            null
        };
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let lparen_identifier_type_annotation_rparen = LparenIdentifierTypeAnnotationOptRparenItem {
            lparen,
            identifier,
            type_annotation,
            rparen,
        };
        Option::Some(lparen_identifier_type_annotation_rparen)
    } else {
        null
    };
    let block = _parse_block(p, follow)?;
    return Result::Ok(CatchProductionNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        catch,
        lparen_identifier_type_annotation_rparen,
        block,
    });
}

