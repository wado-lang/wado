fn _parse_case_block__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<CaseBlockNode, ParseError> {
    let start = p.peek_start();
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let case_clauses: Option<CaseClausesNode> = if p.peek_kind() == TK_Case {
        let case_clauses = _parse_case_clauses(p, &EMPTY_FOLLOW)?;
        Option::Some(case_clauses)
    } else {
        null
    };
    let default_clause_case_clauses: Option<DefaultClauseCaseClausesOptItem> = if p.peek_kind() == TK_Default && p.peek_at(1) == TK_Case {
        let default_clause = _parse_default_clause(p, follow)?;
        let case_clauses: Option<CaseClausesNode> = if follow_yields(&p.kinds, p.pos, follow, TK_EOF) {
            null
        } else if p.peek_kind() == TK_Case {
            let case_clauses = _parse_case_clauses(p, &EMPTY_FOLLOW)?;
            Option::Some(case_clauses)
        } else {
            null
        };
        let default_clause_case_clauses = DefaultClauseCaseClausesOptItem {
            default_clause,
            case_clauses,
        };
        Option::Some(default_clause_case_clauses)
    } else if p.peek_kind() == TK_Default {
        let default_clause = _parse_default_clause(p, follow)?;
        let case_clauses: Option<CaseClausesNode> = null;
        let default_clause_case_clauses = DefaultClauseCaseClausesOptItem {
            default_clause,
            case_clauses,
        };
        Option::Some(default_clause_case_clauses)
    } else {
        null
    };
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::Ok(CaseBlockNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lbrace,
        case_clauses,
        default_clause_case_clauses,
        rbrace,
    });
}

