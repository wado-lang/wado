    v.enter_rule(149, &"bigintLiteral", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(149, &"bigintLiteral", &node.span);
}

pub fn walk_getter<V: Visitor>(v: &mut V, toks: &TokenStream, node: &GetterNode) {
    v.enter_rule(150, &"getter", &node.span);
    walk_identifier(v, toks, &node.identifier);
    walk_classElementName(v, toks, &node.class_element_name);
    v.exit_rule(150, &"getter", &node.span);
}

pub fn walk_setter<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SetterNode) {
    v.enter_rule(151, &"setter", &node.span);
