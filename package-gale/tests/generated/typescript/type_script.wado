fn _parse_function_declaration__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<FunctionDeclarationNode, ParseError> {
    let start = p.peek_start();
    let async_: Option<i32> = if p.peek_kind() == TK_Async {
        let async_ = p.expect(TK_Async)?;
        Option::Some(async_)
    } else {
        null
    };
    let function_ = p.expect(TK_Function_)?;
    let star: Option<i32> = if p.peek_kind() == TK_LIT_STAR {
