fn _parse_catch_production__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<CatchProductionNode, ParseError> {
    let start = p.peek_start();
    let catch = p.expect(TK_Catch)?;
    let lparen_identifier_type_annotation_rparen: Option<LparenIdentifierTypeAnnotationOptRparenItem> = if p.peek_kind() == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let identifier = _parse_identifier(p, &FOLLOW_MASK_29)?;
        let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
            let type_annotation = _parse_type_annotation(p, &EMPTY_FOLLOW)?;
