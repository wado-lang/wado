}

fn _parse_decorator_member_expression__inner_atom(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<DecoratorMemberExpressionNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _gale_kind_set_20(kind) {
        let identifier = _parse_identifier(p, follow)?;
        return Result::Ok(DecoratorMemberExpressionNode::Alt0(DecoratorMemberExpressionAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            identifier,
        }));
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let single_expression = _parse_single_expression(p, &FOLLOW_MASK_1)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::Ok(DecoratorMemberExpressionNode::Alt2(DecoratorMemberExpressionAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lparen,
            single_expression,
            rparen,
        }));
    }
    return Result::Err(p.error(
        "expected decoratorMemberExpression",
        p.peek_span(),
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_LIT_LPAREN"],
    ));
}

