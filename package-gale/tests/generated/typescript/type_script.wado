}

pub fn walk_identifierName<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IdentifierNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(152, &"identifierName", &n.span);
            walk_identifier(v, toks, &n.identifier);
            v.exit_rule(152, &"identifierName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(152, &"identifierName", &n.span);
            walk_reservedWord(v, toks, &n.reserved_word);
            v.exit_rule(152, &"identifierName", &n.span);
        }
    }
}

pub fn walk_identifier<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IdentifierNode) {
    v.enter_rule(153, &"identifier", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(153, &"identifier", &node.span);
}

pub fn walk_identifierOrKeyWord<V: Visitor>(v: &mut V, toks: &TokenStream, node: &IdentifierOrKeyWordNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(154, &"identifierOrKeyWord", &n.span);
            walk_identifier(v, toks, &n.identifier);
            v.exit_rule(154, &"identifierOrKeyWord", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(154, &"identifierOrKeyWord", &n.span);
            v.visit_token(toks, *(&n.typealias));
            v.exit_rule(154, &"identifierOrKeyWord", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(154, &"identifierOrKeyWord", &n.span);
            v.visit_token(toks, *(&n.require));
            v.exit_rule(154, &"identifierOrKeyWord", &n.span);
        }
    }
}

pub fn walk_reservedWord<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ReservedWordNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(155, &"reservedWord", &n.span);
            walk_keyword(v, toks, &n.keyword);
            v.exit_rule(155, &"reservedWord", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(155, &"reservedWord", &n.span);
            v.visit_token(toks, *(&n.nullliteral));
            v.exit_rule(155, &"reservedWord", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(155, &"reservedWord", &n.span);
            v.visit_token(toks, *(&n.booleanliteral));
            v.exit_rule(155, &"reservedWord", &n.span);
        }
    }
}

pub fn walk_keyword<V: Visitor>(v: &mut V, toks: &TokenStream, node: &KeywordNode) {
    v.enter_rule(156, &"keyword", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(156, &"keyword", &node.span);
}

pub fn walk_eos<V: Visitor>(v: &mut V, toks: &TokenStream, node: &EosNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(157, &"eos", &n.span);
            v.visit_token(toks, *(&n.semicolon));
            v.exit_rule(157, &"eos", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(157, &"eos", &n.span);
            v.visit_token(toks, *(&n.eof));
            v.exit_rule(157, &"eos", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(157, &"eos", &n.span);
            v.exit_rule(157, &"eos", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(157, &"eos", &n.span);
            v.exit_rule(157, &"eos", &n.span);
        }
    }
}

pub fn to_tree(result: &ParseResult<InitializerNode>) -> CstNode {
    let mut recorder = TreeRecorder::new(&result.tokens);
    walk_initializer(&mut recorder, &result.tokens, &result.root);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_LBRACE | TK_LIT_LBRACKET };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_Abstract | TK_Any | TK_As | TK_Async | TK_Boolean | TK_Constructor | TK_From | TK_Identifier | TK_KeyOf | TK_LIT_LT | TK_Namespace | TK_Never | TK_Number | TK_Object | TK_Of | TK_String | TK_Symbol | TK_TypeAlias | TK_Undefined | TK_Unique | TK_Yield };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_Abstract | TK_Any | TK_As | TK_Async | TK_Boolean | TK_BooleanLiteral | TK_Constructor | TK_DecimalLiteral | TK_From | TK_Identifier | TK_KeyOf | TK_LIT_AMP | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_LT | TK_LIT_NEW | TK_LIT_PIPE | TK_LIT_TYPEOF | TK_Namespace | TK_Never | TK_NullLiteral | TK_Number | TK_Object | TK_Of | TK_String | TK_StringLiteral | TK_Symbol | TK_This | TK_TypeAlias | TK_Undefined | TK_Unique | TK_Void | TK_Yield };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_LIT_AMP | TK_LIT_PIPE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_Abstract | TK_Any | TK_As | TK_Async | TK_Boolean | TK_BooleanLiteral | TK_Constructor | TK_DecimalLiteral | TK_From | TK_Identifier | TK_KeyOf | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_TYPEOF | TK_Namespace | TK_Never | TK_NullLiteral | TK_Number | TK_Object | TK_Of | TK_String | TK_StringLiteral | TK_Symbol | TK_This | TK_TypeAlias | TK_Undefined | TK_Unique | TK_Void | TK_Yield };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_Symbol | TK_Unique };
}

fn _gale_kind_set_6(k: i32) -> bool {
    return k matches { TK_Abstract | TK_Any | TK_As | TK_Async | TK_Await | TK_BinaryIntegerLiteral | TK_Boolean | TK_BooleanLiteral | TK_Break | TK_Case | TK_Catch | TK_Class | TK_Const | TK_Constructor | TK_Continue | TK_Debugger | TK_DecimalLiteral | TK_Default | TK_Delete | TK_Do | TK_Else | TK_Enum | TK_Export | TK_Extends | TK_Finally | TK_For | TK_From | TK_Function_ | TK_HexIntegerLiteral | TK_Identifier | TK_If | TK_Implements | TK_Import | TK_In | TK_Instanceof | TK_Interface | TK_KeyOf | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_LT | TK_LIT_NEW | TK_Let | TK_Module | TK_Namespace | TK_Never | TK_New | TK_NullLiteral | TK_Number | TK_Object | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_Of | TK_Package | TK_Private | TK_Protected | TK_Public | TK_ReadOnly | TK_Require | TK_Return | TK_Static | TK_String | TK_StringLiteral | TK_Super | TK_Switch | TK_Symbol | TK_This | TK_Throw | TK_Try | TK_TypeAlias | TK_Typeof | TK_Undefined | TK_Unique | TK_Var | TK_Void | TK_While | TK_With | TK_Yield };
}

fn _gale_kind_set_7(k: i32) -> bool {
    return k matches { TK_LIT_COMMA | TK_SemiColon };
}

fn _gale_kind_set_8(k: i32) -> bool {
    return k matches { TK_Abstract | TK_Any | TK_As | TK_Async | TK_Await | TK_Boolean | TK_BooleanLiteral | TK_Break | TK_Case | TK_Catch | TK_Class | TK_Const | TK_Constructor | TK_Continue | TK_Debugger | TK_Default | TK_Delete | TK_Do | TK_Else | TK_Enum | TK_Export | TK_Extends | TK_Finally | TK_For | TK_From | TK_Function_ | TK_Identifier | TK_If | TK_Implements | TK_Import | TK_In | TK_Instanceof | TK_Interface | TK_KeyOf | TK_LIT_AT | TK_LIT_DOTDOTDOT | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Let | TK_Module | TK_Namespace | TK_Never | TK_New | TK_NullLiteral | TK_Number | TK_Object | TK_Of | TK_Package | TK_Private | TK_Protected | TK_Public | TK_ReadOnly | TK_Require | TK_Return | TK_Static | TK_String | TK_Super | TK_Switch | TK_Symbol | TK_This | TK_Throw | TK_Try | TK_TypeAlias | TK_Typeof | TK_Undefined | TK_Unique | TK_Var | TK_Void | TK_While | TK_With | TK_Yield };
