fn _parse_eos__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<EosNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_SemiColon {
        let semicolon = p.expect(TK_SemiColon)?;
        return Result::Ok(EosNode::Alt0(EosAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            semicolon,
        }));
    }
    if kind == TK_EOF {
        let eof = p.expect(TK_EOF)?;
        return Result::Ok(EosNode::Alt1(EosAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            eof,
        }));
    }
    scope: {
        return Result::Ok(EosNode::Alt2(EosAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
        }));
    }
    scope: {
        return Result::Ok(EosNode::Alt3(EosAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
        }));
    }
    return Result::Err(p.error(
        "expected eos",
        p.peek_span(),
        ["TK_SemiColon", "TK_EOF"],
    ));
