fn _parse_arguments__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ArgumentsNode, ParseError> {
    let start = p.peek_start();
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let argument_list_comma: Option<ArgumentListCommaOptItem> = if _gale_kind_set_32(p.peek_kind()) && p.peek_at(1) == TK_LIT_COMMA {
