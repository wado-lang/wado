}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
        }
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32) -> Result<i32, ParseError> {
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                return Result::Ok(self.pos);
            }
            return Result::Ok(self.advance());
        }
        let name = token_kind_name(kind);
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<i32, ParseError> {
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<i32, ParseError> {
        if self.kinds[self.pos] != TK_EOF {
            return Result::Ok(self.advance());
        }
        return Result::Err(self.error(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::Ok(self.pos);
                }
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["token set"],
        ));
    }
}

fn scan_initializer(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_EQ { return -1; }
    pos += 1;
    pos = scan_single_expression(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_binding_pattern(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    let gp_0 = pos;
    let sgk_0 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if _gale_kind_set_0(sgk_0) {
        sg_0: {
            pos = gp_0;
            sg_0_0: {
                pos = scan_array_literal(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break sg_0_0; }
                break sg_0;
            }
            pos = gp_0;
            sg_0_1: {
                pos = scan_object_literal(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break sg_0_1; }
                break sg_0;
            }
            pos = gp_0;
        }
    }
    return pos;
}

fn scan_type_parameters(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LT { return -1; }
    pos += 1;
    if pos < tokens.len() && _gale_kind_set_1(tokens[pos]) {
        let sp = pos;
        pos = scan_type_parameter_list(tokens, pos, &EMPTY_FOLLOW, 0);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_GT { return -1; }
    pos += 1;
    return pos;
}

fn scan_type_parameter_list(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_type_parameter(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_1_done: {
            sg_1: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_1; }
                pos += 1;
                pos = scan_type_parameter(tokens, pos, follow, 0);
                if pos < 0 { break sg_1; }
                break sg_1_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_type_parameter(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _gale_kind_set_20(alt_kind) {
            let mut best: i32 = -1;
            pos = start;
            try_1: {
                pos = scan_identifier(tokens, pos, &FOLLOW_MASK_0, 0);
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_EQ { break try_1; }
                pos += 1;
                pos = scan_type_argument(tokens, pos, follow, 0);
                if pos < 0 { break try_1; }
                if pos > best { best = pos; }
            }
            pos = start;
            try_0: {
                pos = scan_identifier(tokens, pos, follow, 0);
                if pos < 0 { break try_0; }
                if pos < tokens.len() && tokens[pos] == TK_LIT_EXTENDS && !(follow_yields(tokens, pos, follow, TK_EOF)) {
