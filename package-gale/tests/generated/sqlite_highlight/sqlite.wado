    v.exit_rule(77, &"module_name", &node.span);
}

pub fn walk_pragma_name<V: Visitor>(v: &mut V, node: &PragmaNameNode) {
    v.enter_rule(78, &"pragma_name", &node.span);
    walk_any_name(v, &node.any_name);
    v.exit_rule(78, &"pragma_name", &node.span);
}

pub fn walk_savepoint_name<V: Visitor>(v: &mut V, node: &SavepointNameNode) {
    v.enter_rule(79, &"savepoint_name", &node.span);
    walk_any_name(v, &node.any_name);
    v.exit_rule(79, &"savepoint_name", &node.span);
}

pub fn walk_table_alias<V: Visitor>(v: &mut V, node: &TableAliasNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(80, &"table_alias", &n.span);
            v.visit_token(&n.identifier);
            v.exit_rule(80, &"table_alias", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(80, &"table_alias", &n.span);
            v.visit_token(&n.string_literal);
            v.exit_rule(80, &"table_alias", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(80, &"table_alias", &n.span);
            v.visit_token(&n.lparen);
            walk_table_alias(v, &n.table_alias);
            v.visit_token(&n.rparen);
            v.exit_rule(80, &"table_alias", &n.span);
        }
    }
}

pub fn walk_transaction_name<V: Visitor>(v: &mut V, node: &TransactionNameNode) {
    v.enter_rule(81, &"transaction_name", &node.span);
    walk_any_name(v, &node.any_name);
    v.exit_rule(81, &"transaction_name", &node.span);
}

pub fn walk_any_name<V: Visitor>(v: &mut V, node: &AnyNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(82, &"any_name", &n.span);
            v.visit_token(&n.identifier);
            v.exit_rule(82, &"any_name", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(82, &"any_name", &n.span);
            walk_keyword(v, &n.keyword);
            v.exit_rule(82, &"any_name", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(82, &"any_name", &n.span);
            v.visit_token(&n.string_literal);
            v.exit_rule(82, &"any_name", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(82, &"any_name", &n.span);
            v.visit_token(&n.lparen);
            walk_any_name(v, &n.any_name);
            v.visit_token(&n.rparen);
            v.exit_rule(82, &"any_name", &n.span);
        }
    }
}

pub fn to_tree(node: &ParseNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_parse(&mut recorder, node);
    return recorder.build();
}

