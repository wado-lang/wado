fn _parse_table_alias__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<TableAliasNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        let identifier = p.expect(TK_IDENTIFIER)?;
        return Result::<TableAliasNode, ParseError>::Ok(TableAliasNode::Alt0(TableAliasAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            identifier,
        }));
    }
    if kind == TK_STRING_LITERAL {
        let string_literal = p.expect(TK_STRING_LITERAL)?;
        return Result::<TableAliasNode, ParseError>::Ok(TableAliasNode::Alt1(TableAliasAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            string_literal,
        }));
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let table_alias = _parse_table_alias(p, &FOLLOW_MASK_23)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::<TableAliasNode, ParseError>::Ok(TableAliasNode::Alt2(TableAliasAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lparen,
            table_alias,
            rparen,
        }));
    }
    return Result::<TableAliasNode, ParseError>::Err(p.error(
        "expected table_alias",
        p.peek().span,
        ["TK_IDENTIFIER", "TK_STRING_LITERAL", "TK_LIT_LPAREN"],
    ));
}

fn _parse_table_alias(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<TableAliasNode, ParseError> {
    let r = _parse_table_alias__inner(p, follow);
    if let Err(mut e) = r {
        e.rule_stack.push("table_alias");
        return Result::<TableAliasNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_transaction_name__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<TransactionNameNode, ParseError> {
    let start = p.peek().span.start;
    let any_name = _parse_any_name(p, follow)?;
    return Result::<TransactionNameNode, ParseError>::Ok(TransactionNameNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        any_name,
    });
}

fn _parse_transaction_name(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<TransactionNameNode, ParseError> {
    let r = _parse_transaction_name__inner(p, follow);
    if let Err(mut e) = r {
