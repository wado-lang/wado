            pos = rep_saved_1;
            break;
        }
        if pos >= chars.len() || chars[pos] != '"' { break alts_0_0; }
        pos += 1;
        alts_ok_0 = true;
    }
    if !alts_ok_0 {
        alts_0_1: {
            pos = alts_saved_0;
