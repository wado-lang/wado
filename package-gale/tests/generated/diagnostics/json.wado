fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    return Parser::new(tokens, chars);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_json(input: &String) -> Result<JsonNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_json(&mut parser);
    if let Err(_e) = _result {
        return Result::<JsonNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_obj(input: &String) -> Result<ObjNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_obj(&mut parser);
    if let Err(_e) = _result {
        return Result::<ObjNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_pair(input: &String) -> Result<PairNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_pair(&mut parser);
    if let Err(_e) = _result {
        return Result::<PairNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_arr(input: &String) -> Result<ArrNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_arr(&mut parser);
    if let Err(_e) = _result {
        return Result::<ArrNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_value(input: &String) -> Result<ValueNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_value(&mut parser);
    if let Err(_e) = _result {
        return Result::<ValueNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse(input: &String) -> Result<JsonNode, ParseError> {
    return parse_json(input);
}

pub fn walk_json<V: Visitor>(v: &mut V, node: &JsonNode) {
    v.enter_rule(0, &"json", &node.span);
    walk_value(v, &node.value);
    v.visit_token(&node.eof);
    v.exit_rule(0, &"json", &node.span);
}

pub fn walk_obj<V: Visitor>(v: &mut V, node: &ObjNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(1, &"obj", &n.span);
            v.visit_token(&n.lbrace);
            walk_pair(v, &n.pair);
            for let item of &n.comma_pair_list {
                v.visit_token(&item.comma);
                walk_pair(v, &item.pair);
            }
            v.visit_token(&n.rbrace);
            v.exit_rule(1, &"obj", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(1, &"obj", &n.span);
            v.visit_token(&n.lbrace);
            v.visit_token(&n.rbrace);
            v.exit_rule(1, &"obj", &n.span);
        }
    }
}

pub fn walk_pair<V: Visitor>(v: &mut V, node: &PairNode) {
    v.enter_rule(2, &"pair", &node.span);
    v.visit_token(&node.string);
    v.visit_token(&node.colon);
    walk_value(v, &node.value);
    v.exit_rule(2, &"pair", &node.span);
}

pub fn walk_arr<V: Visitor>(v: &mut V, node: &ArrNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(3, &"arr", &n.span);
            v.visit_token(&n.lbracket);
            walk_value(v, &n.value);
            for let item of &n.comma_value_list {
                v.visit_token(&item.comma);
                walk_value(v, &item.value);
            }
            v.visit_token(&n.rbracket);
            v.exit_rule(3, &"arr", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(3, &"arr", &n.span);
            v.visit_token(&n.lbracket);
            v.visit_token(&n.rbracket);
            v.exit_rule(3, &"arr", &n.span);
        }
    }
}

pub fn walk_value<V: Visitor>(v: &mut V, node: &ValueNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(4, &"value", &n.span);
            v.visit_token(&n.string);
            v.exit_rule(4, &"value", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(4, &"value", &n.span);
            v.visit_token(&n.number);
            v.exit_rule(4, &"value", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(4, &"value", &n.span);
            walk_obj(v, &n.obj);
            v.exit_rule(4, &"value", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(4, &"value", &n.span);
            walk_arr(v, &n.arr);
            v.exit_rule(4, &"value", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(4, &"value", &n.span);
            v.visit_token(&n.lit_true);
            v.exit_rule(4, &"value", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(4, &"value", &n.span);
            v.visit_token(&n.lit_false);
            v.exit_rule(4, &"value", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(4, &"value", &n.span);
            v.visit_token(&n.lit_null);
            v.exit_rule(4, &"value", &n.span);
        }
    }
}

pub fn to_tree(node: &JsonNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_json(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_FALSE | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_NULL | TK_LIT_TRUE | TK_NUMBER | TK_STRING };
}

