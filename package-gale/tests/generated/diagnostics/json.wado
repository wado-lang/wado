struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_string(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '"' { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            let alts_saved_1 = pos;
            let mut alts_ok_1 = false;
            alts_1_0: {
                pos = alts_saved_1;
                if pos >= chars.len() || chars[pos] != '\\' { break alts_1_0; }
                pos += 1;
                let alts_saved_2 = pos;
                let mut alts_ok_2 = false;
                alts_2_0: {
                    pos = alts_saved_2;
                    if pos >= chars.len() { break alts_2_0; }
                    if !(false || chars[pos] == '"' || chars[pos] == '\\' || chars[pos] == '/' || chars[pos] == 'b' || chars[pos] == 'f' || chars[pos] == 'n' || chars[pos] == 'r' || chars[pos] == 't') { break alts_2_0; }
                    pos += 1;
                    alts_ok_2 = true;
                }
                if !alts_ok_2 {
                    alts_2_1: {
                        pos = alts_saved_2;
                        if pos >= chars.len() || chars[pos] != 'u' { break alts_2_1; }
                        pos += 1;
                        if pos >= chars.len() { break alts_2_1; }
                        if !(false || '0' <= chars[pos] <= '9' || 'a' <= chars[pos] <= 'f' || 'A' <= chars[pos] <= 'F') { break alts_2_1; }
                        pos += 1;
                        if pos >= chars.len() { break alts_2_1; }
                        if !(false || '0' <= chars[pos] <= '9' || 'a' <= chars[pos] <= 'f' || 'A' <= chars[pos] <= 'F') { break alts_2_1; }
                        pos += 1;
                        if pos >= chars.len() { break alts_2_1; }
                        if !(false || '0' <= chars[pos] <= '9' || 'a' <= chars[pos] <= 'f' || 'A' <= chars[pos] <= 'F') { break alts_2_1; }
                        pos += 1;
                        if pos >= chars.len() { break alts_2_1; }
                        if !(false || '0' <= chars[pos] <= '9' || 'a' <= chars[pos] <= 'f' || 'A' <= chars[pos] <= 'F') { break alts_2_1; }
                        pos += 1;
                        alts_ok_2 = true;
                    }
                }
                if !alts_ok_2 { break alts_1_0; }
                alts_ok_1 = true;
            }
            if !alts_ok_1 {
                alts_1_1: {
                    pos = alts_saved_1;
                    if pos >= chars.len() { break alts_1_1; }
                    if false || chars[pos] == '"' || chars[pos] == '\\' || '\u{0}' <= chars[pos] <= '\u{1f}' { break alts_1_1; }
                    pos += 1;
                    alts_ok_1 = true;
                }
            }
            if !alts_ok_1 { break rep_0; }
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    if pos >= chars.len() || chars[pos] != '"' { return -1; }
    pos += 1;
    return pos;
}

fn try_number(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let opt_saved_3 = pos;
    let mut opt_ok_3 = false;
    rep_3: {
        if pos >= chars.len() || chars[pos] != '-' { break rep_3; }
        pos += 1;
        opt_ok_3 = true;
    }
    if !opt_ok_3 { pos = opt_saved_3; }
    let alts_saved_4 = pos;
    let mut alts_ok_4 = false;
    alts_4_0: {
