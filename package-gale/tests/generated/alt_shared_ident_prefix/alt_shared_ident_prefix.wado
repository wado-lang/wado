            }
            opt_scan_pos = pos;
        }
        let pattern_item: Option<PatternItemListItem> = if opt_scan_pos >= 0 {
            let pattern = _parse_pattern(p, follow)?;
            let mut comma_pattern_list: List<CommaPatternItem> = [];
            loop {
