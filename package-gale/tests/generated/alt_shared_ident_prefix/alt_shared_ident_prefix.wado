                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    sg_11_done: {
                        sg_11: {
                            if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COMMA { break sg_11; }
                            pos += 1;
                            pos = scan_pattern(tokens, pos, follow, 0);
                            if pos < 0 { break sg_11; }
                            break sg_11_done;
                        }
                        break rep_scan;
                    }
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
                let comma = p.expect(TK_LIT_COMMA)?;
                let pattern = _parse_pattern(p, follow)?;
                let comma_pattern = CommaPatternItem {
                    comma,
                    pattern,
                };
                comma_pattern_list.push(comma_pattern);
            }
            let pattern_item = PatternItemListItem {
                pattern,
                comma_pattern_list,
