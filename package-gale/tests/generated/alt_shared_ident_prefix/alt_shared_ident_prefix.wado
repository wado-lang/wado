}

fn _parse_pattern__inner_alt_1(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PatternNode, ParseError> {
    let start = p.peek_start();
    let lit_mut: Option<Tok> = if p.peek_kind() == TK_LIT_MUT {
        let lit_mut = p.expect(TK_LIT_MUT)?;
        Option::Some(lit_mut)
    } else {
        null
    };
    let ident = p.expect(TK_IDENT)?;
    return Result::Ok(PatternNode::Alt1(PatternAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        lit_mut,
        ident,
    }));
}

fn _parse_pattern__inner_scan_1(tokens: &TokenStream, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && tokens.kinds[pos] == TK_LIT_MUT {
        let sp = pos;
        if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_MUT { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens.kinds[pos] != TK_IDENT { return -1; }
    pos += 1;
    return pos;
}

fn _parse_pattern__inner_alt_2(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PatternNode, ParseError> {
    let start = p.peek_start();
    let path = _parse_path(p, follow)?;
    let lparen_item_rparen: Option<LparenItemOptRparenItem> = if !(follow_yields(&p.tokens, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_LIT_LPAREN) {
        let lparen = p.expect(TK_LIT_LPAREN)?;
