        Option::Some(lparen_item_rparen)
    } else {
        null
    };
    return Result::Ok(PatternNode::Alt2(PatternAlt2 {
        span: Span::new(start, i32::max(start, p.last_end())),
        path,
        lparen_item_rparen,
    }));
}

fn _parse_pattern__inner_scan_2(tokens: &TokenStream, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_path(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    if pos < tokens.len() && tokens.kinds[pos] == TK_LIT_LPAREN && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_12_done: {
            sg_12: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_LPAREN { break sg_12; }
                pos += 1;
                if pos < tokens.len() && _gale_kind_set_0(tokens.kinds[pos]) {
                    let sp = pos;
                    sg_13_done: {
                        sg_13: {
                            pos = scan_pattern(tokens, pos, follow, 0);
                            if pos < 0 { break sg_13; }
                            while pos < tokens.len() && tokens.kinds[pos] == TK_LIT_COMMA && !(follow_yields(tokens, pos, follow, TK_EOF)) {
                                let sp = pos;
                                sg_14_done: {
                                    sg_14: {
                                        if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COMMA { break sg_14; }
                                        pos += 1;
                                        pos = scan_pattern(tokens, pos, follow, 0);
                                        if pos < 0 { break sg_14; }
                                        break sg_14_done;
                                    }
                                    pos = -1;
                                }
                                if pos < 0 { pos = sp; break; }
                                if pos == sp { break; }
