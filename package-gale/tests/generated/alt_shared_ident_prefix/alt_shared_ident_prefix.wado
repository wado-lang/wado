fn _parse_pattern__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PatternNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_LIT_U5f {
        let lit_u5f = p.expect(TK_LIT_U5f)?;
        return Result::Ok(PatternNode::Alt0(PatternAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lit_u5f,
        }));
    }
    if _gale_kind_set_1(kind) {
        if p.peek_kind() == TK_IDENT {
            let _sd_tokens = &p.tokens;
            let _sd_pos = p.pos;
            let _sd_p_1 = _parse_pattern__inner_scan_1(_sd_tokens, _sd_pos);
            let _sd_p_2 = _parse_pattern__inner_scan_2(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_p_2 > _sd_best_p {
                _sd_best_p = _sd_p_2;
                _sd_best_i = 2;
            }
            if _sd_best_i == 1 {
                return _parse_pattern__inner_alt_1(p, follow);
            }
            if _sd_best_i == 2 {
                return _parse_pattern__inner_alt_2(p, follow);
            }
            return _parse_pattern__inner_alt_2(p, follow);
        } else if p.peek_kind() == TK_LIT_MUT {
            return _parse_pattern__inner_alt_1(p, follow);
        }
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let mut opt_scan_pos: i32 = -1;
        opt_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_pattern(tokens, pos, follow, 0);
            if pos < 0 { break opt_scan; }
            while pos < tokens.len() && tokens.kinds[pos] == TK_LIT_COMMA && !(follow_yields(tokens, pos, follow, TK_EOF)) {
                let sp = pos;
                sg_15_done: {
                    sg_15: {
                        if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COMMA { break sg_15; }
                        pos += 1;
                        pos = scan_pattern(tokens, pos, follow, 0);
                        if pos < 0 { break sg_15; }
                        break sg_15_done;
                    }
                    pos = -1;
                }
                if pos < 0 { pos = sp; break; }
                if pos == sp { break; }
            }
            opt_scan_pos = pos;
        }
        let pattern_item: Option<PatternItemListItem> = if opt_scan_pos >= 0 {
            let pattern = _parse_pattern(p, follow)?;
            let mut comma_pattern_list: List<CommaPatternItem> = [];
            loop {
                if follow_yields(&p.tokens, p.pos, follow, TK_EOF) { break; }
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    sg_16_done: {
                        sg_16: {
                            if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COMMA { break sg_16; }
                            pos += 1;
                            pos = scan_pattern(tokens, pos, follow, 0);
                            if pos < 0 { break sg_16; }
                            break sg_16_done;
                        }
                        break rep_scan;
                    }
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
                let comma = p.expect(TK_LIT_COMMA)?;
                let pattern = _parse_pattern(p, follow)?;
                let comma_pattern = CommaPatternItem {
                    comma,
                    pattern,
                };
                comma_pattern_list.push(comma_pattern);
            }
            let pattern_item = PatternItemListItem {
                pattern,
                comma_pattern_list,
            };
            Option::Some(pattern_item)
        } else {
            null
        };
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::Ok(PatternNode::Alt3(PatternAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lparen,
            pattern_item,
            rparen,
        }));
    }
    return Result::Err(p.error(
        "expected pattern",
        p.peek_span(),
        ["TK_LIT_U5f", "TK_LIT_MUT", "TK_IDENT", "TK_LIT_LPAREN"],
    ));
}

fn _parse_pattern(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PatternNode, ParseError> {
    return _gale_rule(_parse_pattern__inner(p, follow), "pattern");
}

fn _parse_path__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PathNode, ParseError> {
    let start = p.peek_start();
    let ident = p.expect(TK_IDENT)?;
    let mut lit_coloncolon_ident_list: List<LitColoncolonIdentItem> = [];
    loop {
        if follow_yields(&p.tokens, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            sg_17_done: {
                sg_17: {
                    if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COLONCOLON { break sg_17; }
                    pos += 1;
                    if pos >= tokens.len() || tokens.kinds[pos] != TK_IDENT { break sg_17; }
                    pos += 1;
                    break sg_17_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let lit_coloncolon = p.expect(TK_LIT_COLONCOLON)?;
        let ident = p.expect(TK_IDENT)?;
        let lit_coloncolon_ident = LitColoncolonIdentItem {
            lit_coloncolon,
            ident,
        };
        lit_coloncolon_ident_list.push(lit_coloncolon_ident);
    }
    return Result::Ok(PathNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        ident,
        lit_coloncolon_ident_list,
    });
}

fn _parse_path(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PathNode, ParseError> {
    return _gale_rule(_parse_path__inner(p, follow), "path");
}

fn _gale_rule<T>(r: Result<T, ParseError>, rule: String) -> Result<T, ParseError> {
    if let Err(mut e) = r {
        e.rule_stack.push(rule);
        return Result::Err(e);
    }
    return r;
}

fn _gale_run<T>(input: &String, run: fn(&mut Parser) -> Result<T, ParseError>) -> Result<T, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = run(&mut parser);
    if let Err(_e) = _result {
        return Result::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    return Parser::new(tokens);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_prog(input: &String) -> Result<ProgNode, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_prog(p));
}

pub fn parse_match_expr(input: &String) -> Result<MatchExprNode, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_match_expr(p));
}

pub fn parse_arm(input: &String) -> Result<ArmNode, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_arm(p));
}

pub fn parse_pattern(input: &String) -> Result<PatternNode, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_pattern(p));
}

pub fn parse_path(input: &String) -> Result<PathNode, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_path(p));
}

pub fn parse(input: &String) -> Result<ProgNode, ParseError> {
    return parse_prog(input);
}

pub fn walk_prog<V: Visitor>(v: &mut V, node: &ProgNode) {
    v.enter_rule(0, &"prog", &node.span);
    walk_matchExpr(v, &node.match_expr);
    v.visit_token(&node.eof);
    v.exit_rule(0, &"prog", &node.span);
}

pub fn walk_matchExpr<V: Visitor>(v: &mut V, node: &MatchExprNode) {
    v.enter_rule(1, &"matchExpr", &node.span);
    v.visit_token(&node.lit_match);
    v.visit_token(&node.ident);
    v.visit_token(&node.lbrace);
    if let Some(item) = &node.arm_item_comma {
        walk_arm(v, &item.arm);
        for let item of &item.comma_arm_list {
            v.visit_token(&item.comma);
            walk_arm(v, &item.arm);
        }
        if let Some(item) = &item.comma {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(1, &"matchExpr", &node.span);
}

pub fn walk_arm<V: Visitor>(v: &mut V, node: &ArmNode) {
    v.enter_rule(2, &"arm", &node.span);
    walk_pattern(v, &node.pattern);
    v.visit_token(&node.lit_eqgt);
    v.visit_token(&node.ident);
    v.exit_rule(2, &"arm", &node.span);
}

pub fn walk_pattern<V: Visitor>(v: &mut V, node: &PatternNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(3, &"pattern", &n.span);
            v.visit_token(&n.lit_u5f);
            v.exit_rule(3, &"pattern", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(3, &"pattern", &n.span);
            if let Some(item) = &n.lit_mut {
                v.visit_token(item);
            }
            v.visit_token(&n.ident);
            v.exit_rule(3, &"pattern", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(3, &"pattern", &n.span);
            walk_path(v, &n.path);
            if let Some(item) = &n.lparen_item_rparen {
                v.visit_token(&item.lparen);
                if let Some(item) = &item.pattern_item {
                    walk_pattern(v, &item.pattern);
                    for let item of &item.comma_pattern_list {
                        v.visit_token(&item.comma);
                        walk_pattern(v, &item.pattern);
                    }
                }
                v.visit_token(&item.rparen);
            }
            v.exit_rule(3, &"pattern", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(3, &"pattern", &n.span);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.pattern_item {
                walk_pattern(v, &item.pattern);
                for let item of &item.comma_pattern_list {
                    v.visit_token(&item.comma);
                    walk_pattern(v, &item.pattern);
                }
            }
            v.visit_token(&n.rparen);
            v.exit_rule(3, &"pattern", &n.span);
        }
    }
}

pub fn walk_path<V: Visitor>(v: &mut V, node: &PathNode) {
    v.enter_rule(4, &"path", &node.span);
    v.visit_token(&node.ident);
    for let item of &node.lit_coloncolon_ident_list {
        v.visit_token(&item.lit_coloncolon);
        v.visit_token(&item.ident);
    }
    v.exit_rule(4, &"path", &node.span);
}

pub fn to_tree(node: &ProgNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_prog(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_IDENT | TK_LIT_LPAREN | TK_LIT_MUT | TK_LIT_U5f };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_IDENT | TK_LIT_MUT };
}

global FOLLOW_MASK_0: List<List<i32>> = [[TK_EOF]];
global FOLLOW_MASK_1: List<List<i32>> = [[TK_LIT_EQGT], [TK_IDENT]];

