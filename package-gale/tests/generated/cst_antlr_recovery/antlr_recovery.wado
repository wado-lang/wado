fn _parse_one__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_4, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_4, &EXPECTED_4); }
    let kind = p.peek_kind();
    if _kind_set_1(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of one matches",
        p.peek_span(),
        &EXPECTED_4,
    );
    return;
}

