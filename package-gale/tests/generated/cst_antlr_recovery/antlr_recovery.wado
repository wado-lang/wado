fn _parse_multi__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_3, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_3, &EXPECTED_3); }
    let kind = p.peek_kind();
    if kind == TK_LIT_y {
        p.site = 4;
        _parse_my(p);
        return;
    } else if kind == TK_LIT_w {
        p.site = 5;
        _parse_mw(p);
        return;
    }
    p.no_viable(
        "no alternative of multi matches",
        p.peek_span(),
        &EXPECTED_2,
    );
    return;
}

