fn _parse_twice__inner(p: &mut Parser) -> () {
    p.site = 1;
    _parse_one(p);
    p.expect(TK_LIT_y, &SYNC_3, false);
    p.site = 2;
    _parse_one(p);
    p.expect(TK_LIT_w, &EMPTY_SYNC, true);
    return;
}

