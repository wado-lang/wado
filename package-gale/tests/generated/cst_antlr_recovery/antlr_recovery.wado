fn _parse_plus__inner(p: &mut Parser) -> () {
    p.expect(TK_LIT_x, &SYNC_1, false);
    if !kind_set_has(&SYNC_1, p.kinds[p.pos]) { builtin::cold_path(); p.sync_enter(&SYNC_1, &EXPECTED_1); }
    let mut _plus_first = true;
    while !p.recovering && (_plus_first || p.peek_kind() == TK_LIT_y) {
        _plus_first = false;
        p.expect(TK_LIT_y, &SYNC_0, false);
        if !kind_set_has(&SYNC_0, p.kinds[p.pos]) { builtin::cold_path(); p.sync_back(&SYNC_0, &EXPECTED_0); }
    }
    p.expect(TK_LIT_BANG, &EMPTY_SYNC, true);
    return;
}

