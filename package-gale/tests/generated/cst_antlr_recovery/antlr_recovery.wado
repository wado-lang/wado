fn _parse_e__inner_atom(p: &mut Parser, min_prec: i32 = 0) -> () {
    if !kind_set_has(&SYNC_5, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_5, &EXPECTED_5); }
    let kind = p.peek_kind();
    if kind == TK_INT {
        p.take();
        return;
    } else if kind == TK_LIT_LPAREN {
        p.take();
        p.site = 9;
        _parse_e(p);
        p.expect(TK_LIT_RPAREN, &SYNC_6, true);
        return;
    }
    p.no_viable(
        "no alternative of e matches",
        p.peek_span(),
        &EXPECTED_5,
    );
    return;
}

fn _parse_e__inner(p: &mut Parser, min_prec: i32 = 0) -> () {
    let _cp = p.b.checkpoint();
    let _start = p.peek_start();
    p.b.start_node(RK_E, _start);
    _parse_e__inner_atom(p, min_prec);
    p.b.finish_node(p.last_end());
    loop {
        if p.recovering { break; }
        let _sk = p.peek_kind();
        if _sk == TK_LIT_PLUS {
            if 1 >= min_prec {
                if scan_e_lr_0(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_E, _start);
                p.take();
                p.site = 8;
                _parse_e(p, 2);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return;
}

fn _parse_e(p: &mut Parser, min_prec: i32 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _row = p.b.checkpoint();
    _parse_e__inner(p, min_prec);
    if p.recovering && p.recover_rule(RK_E, "e", _row) { p.b.finish_node(p.last_end()); }
    p.sites.pop();
}

