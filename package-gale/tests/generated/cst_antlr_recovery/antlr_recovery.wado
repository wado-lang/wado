global CALL_FOLLOW_SETS: List<List<i32>> = [[128], [64], [256], [32], [], [1024], [4096], [8192], [16384]];
global CALL_FOLLOW: List<i32> = [0, 1, 2, 3, 4, 4, 4, 4, 5, 6, 7, 8, 7];
global CALL_FOLLOW_ENDS: List<bool> = [false, false, false, false, true, true, true, false, true, false, false, false, false];

global TOKEN_NAMES: List<String> = ["INT", "'z'", "' '", "Eof", "Error", "'x'", "'y'", "'!'", "'w'", "'q'", "'+'", "'('", "')'", "'end'", "';'", "'a'", "'b'", "'v'"];

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }
    return String::new();
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_LIT_q | TK_LIT_x };
}

