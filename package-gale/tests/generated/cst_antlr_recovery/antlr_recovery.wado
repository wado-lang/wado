fn _parse_tailed__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.expect(TK_LIT_x, &SYNC_1, true);
    while !p.recovering && (p.peek_kind() == TK_LIT_y) {
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        p.take();
    }
    return;
}

fn _parse_tailed(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
