fn _parse_grpend__inner(p: &mut Parser) -> () {
    p.expect(TK_LIT_x, &SYNC_2, false);
    if !kind_set_has(&SYNC_2, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_2, &EXPECTED_2); }
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_y {
        p.take();
        p.expect(TK_LIT_v, &EMPTY_SYNC, true);
    } else if grp_kind == TK_LIT_w {
        p.take();
    } else {
        p.no_viable("no viable alternative", p.peek_span(), &EXPECTED_2);
    }
    return;
}

fn _parse_grpend(p: &mut Parser) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_GRPEND, _start);
    _parse_grpend__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_GRPEND, "grpend", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_loop(input, max_errors);
}

pub fn parse_loop<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_loop(p));
}

pub fn parse_tail<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_tail(p));
}

