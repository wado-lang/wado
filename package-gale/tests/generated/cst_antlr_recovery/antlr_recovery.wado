pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }
}

pub fn push_chars(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    let mut bytes = 0;
    for let mut i = start; i < end; i += 1 {
        bytes += chars[i].len_utf8();
    }
    out.reserve(bytes);
    for let mut i = start; i < end; i += 1 {
        out.push(chars[i]);
    }
}

pub fn chars_text(chars: &List<char>, start: i32, end: i32) -> String {
    let mut s = String::new();
    push_chars(&mut s, chars, start, end);
    return s;
}

pub fn push_chars_escaped(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    for let mut i = start; i < end; i += 1 {
        match chars[i] {
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            c => out.push(c),
        }
    }
}

pub fn kind_set_has(set: &List<i32>, kind: i32) -> bool {
    let w = kind >> 5;
    if w >= set.len() {
        return false;
    }
    return set[w] >> (kind & 31) & 1 == 1;
}

pub fn with_expected<S: AsStrSlice>(message: S, expected: &List<String>) -> String {
    let n = expected.len();
    if n == 0 {
        return message.to_string();
    }
    let mut out = String::with_capacity(n * 8 + message.len() + 11);
    out.push_str("expected ");
    for let mut i = 0; i < n; i += 1 {
        if i > 0 {
            out.push_str(&if i == n - 1 { " or " } else { ", " });
        }
        out.push_str(&expected[i]);
    }
    out.push_str("; ");
    out.push_str(message);
    return out;
}

pub fn char_pos_in_line(chars: &List<char>, i: i32) -> i32 {
    let mut j = if i < chars.len() { i } else { chars.len() };
    let mut col = 0;
    while j > 0 && chars[j - 1] != '\n' {
        col += 1;
        j -= 1;
    }
    return col;
}

pub fn line_starts(chars: &List<char>) -> List<i32> {
    let mut starts: List<i32> = [0];
    for let mut i = 0; i < chars.len(); i += 1 {
        if chars[i] == '\n' {
            starts.push(i + 1);
        }
    }
    return starts;
}

pub fn line_col_at(starts: &List<i32>, pos: i32) -> [i32, i32] {
    let mut lo = 0;
    let mut hi = starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return [lo + 1, pos - starts[lo]];
}

pub flags TokenFlags {
    Synthetic,
    Skipped,
    LexError,
}

pub struct TokenStream {
    pub kinds: List<i32>,
    pub starts: List<i32>,
    pub ends: List<i32>,
    pub triv_lo: List<i32>,
    pub triv_hi: List<i32>,
    pub chars: &List<char>,
    pub triv_kinds: List<i32>,
    pub triv_starts: List<i32>,
    pub triv_ends: List<i32>,
    pub triv_chans: List<i32>,
    pub flags: List<TokenFlags>,
    pub output: String = "",
}

impl TokenStream {
    pub fn new(chars: &List<char>) -> TokenStream {
        let cap = chars.len() / 4 + 1;
        return TokenStream {
            kinds: List::with_capacity(cap),
            starts: List::with_capacity(cap),
            ends: List::with_capacity(cap),
            triv_lo: List::with_capacity(cap),
            triv_hi: List::with_capacity(cap),
            chars,
            triv_kinds: List::with_capacity(cap),
            triv_starts: List::with_capacity(cap),
            triv_ends: List::with_capacity(cap),
            triv_chans: List::with_capacity(cap),
            flags: List::with_capacity(cap),
        };
    }

    pub fn len(&self) -> i32 {
        return self.kinds.len();
    }

    pub fn trivia_mark(&self) -> i32 {
        return self.triv_kinds.len();
    }

    pub fn push_trivia(&mut self, kind: i32, start: i32, end: i32, channel: i32) {
        if self.triv_kinds.len() >= self.triv_kinds.capacity() {
            builtin::cold_path();
            self.triv_kinds.grow();
            self.triv_starts.grow();
            self.triv_ends.grow();
            self.triv_chans.grow();
            assert self.triv_starts.capacity() == self.triv_kinds.capacity()
                && self.triv_ends.capacity() == self.triv_kinds.capacity()
                && self.triv_chans.capacity() == self.triv_kinds.capacity(), "TokenStream trivia columns must grow in lockstep";
        }
        self.triv_kinds.push_within_capacity(kind);
        self.triv_starts.push_within_capacity(start);
        self.triv_ends.push_within_capacity(end);
        self.triv_chans.push_within_capacity(channel);
    }

    pub fn push_token(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32) {
        self.push_token_flagged(kind, start, end, triv_lo, triv_hi, TokenFlags::none());
    }

    pub fn push_token_flagged(
        &mut self,
        kind: i32,
        start: i32,
        end: i32,
        triv_lo: i32,
        triv_hi: i32,
        flags: TokenFlags,
    ) -> i32 {
        let idx = self.kinds.len();
        if idx >= self.kinds.capacity() {
            builtin::cold_path();
            self.kinds.grow();
            self.starts.grow();
            self.ends.grow();
            self.triv_lo.grow();
            self.triv_hi.grow();
            self.flags.grow();
            assert self.starts.capacity() == self.kinds.capacity()
                && self.ends.capacity() == self.kinds.capacity()
                && self.triv_lo.capacity() == self.kinds.capacity()
                && self.triv_hi.capacity() == self.kinds.capacity()
                && self.flags.capacity() == self.kinds.capacity(), "TokenStream token columns must grow in lockstep";
        }
        self.kinds.push_within_capacity(kind);
        self.starts.push_within_capacity(start);
        self.ends.push_within_capacity(end);
        self.triv_lo.push_within_capacity(triv_lo);
        self.triv_hi.push_within_capacity(triv_hi);
        self.flags.push_within_capacity(flags);
        return idx;
    }

    pub fn push_synthetic(&mut self, expected_kind: i32, at: i32) -> i32 {
        let m = self.trivia_mark();
        return self.push_token_flagged(expected_kind, at, at, m, m, TokenFlags::Synthetic);
    }

    pub fn flags_at(&self, i: i32) -> TokenFlags {
        return self.flags[i];
    }

    pub fn set_flag(&mut self, i: i32, flag: TokenFlags) {
        self.flags[i] = self.flags[i] | flag;
    }

    pub fn mark_skipped(&mut self, i: i32) {
        self.set_flag(i, TokenFlags::Skipped);
    }

    pub fn is_synthetic(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Synthetic != TokenFlags::none();
    }

    pub fn is_skipped(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Skipped != TokenFlags::none();
    }

    pub fn is_lex_error(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::LexError != TokenFlags::none();
    }

    pub fn kind_at(&self, i: i32) -> i32 {
        return self.kinds[i];
    }

    pub fn span_at(&self, i: i32) -> Span {
        return Span::new(self.starts[i], self.ends[i]);
    }

    pub fn is_empty_text(&self, i: i32) -> bool {
        return self.starts[i] >= self.ends[i];
    }

    pub fn token_text(&self, i: i32) -> String {
        return chars_text(self.chars, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text(&self, out: &mut String, i: i32) {
        push_chars(out, self.chars, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text_escaped(&self, out: &mut String, i: i32) {
        push_chars_escaped(out, self.chars, self.starts[i], self.ends[i]);
    }

    pub fn rule_text(&self, start_tok: i32, end_tok: i32) -> String {
        let mut out = String::new();
        for let mut i = start_tok; i <= end_tok; i += 1 {
            if i > start_tok {
                for let mut j = self.triv_lo[i]; j < self.triv_hi[i]; j += 1 {
                    if self.triv_chans[j] != 0 {
                        push_chars(&mut out, self.chars, self.triv_starts[j], self.triv_ends[j]);
                    }
                }
            }
            self.push_token_text(&mut out, i);
        }
        return out;
    }
}

pub enum Severity {
    Error,
}

impl Severity {
    pub fn label(&self) -> String {
        return match *self { Error => "error" };
    }
}

pub enum DiagnosticCode {
    UnexpectedToken,
    MissingToken,
    ExtraToken,
    NoViableAlternative,
    UnterminatedConstruct,
    LexError,
}

impl DiagnosticCode {
    pub fn name(&self) -> String {
        return match *self {
            UnexpectedToken => "unexpected-token",
            MissingToken => "missing-token",
            ExtraToken => "extra-token",
            NoViableAlternative => "no-viable-alternative",
            UnterminatedConstruct => "unterminated-construct",
            LexError => "lex-error",
        };
    }
}

pub enum RecoveryAction {
    Inserted,
    Deleted,
    SkippedTo,
    FilledMissing,
    None,
}

pub struct Diagnostic {
    pub severity: Severity = Severity::Error,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub expected: List<i32> = [],
    pub found: i32 = -1,
    pub rule_stack: List<String> = [],
    pub recovery: RecoveryAction = RecoveryAction::None,
}

impl Diagnostic {
    pub fn error<S: AsStrSlice>(
        code: DiagnosticCode,
        message: S,
        span: Span,
        expected: List<i32>,
        found: i32,
        recovery: RecoveryAction,
    ) -> Diagnostic {
        return Diagnostic { code, message: message.to_string(), span, expected, found, recovery };
    }

    pub fn is_error(&self) -> bool {
        return self.severity matches { Error };
    }

    pub fn rule_path(&self) -> String {
        let stack = &self.rule_stack;
        let mut out = String::with_capacity(stack.len() * 8);
        let n = stack.len();
        for let mut i = 0; i < n; i += 1 {
            let name = &stack[n - 1 - i];
            if i > 0 {
                if *name == stack[n - i] {
                    continue;
                }
                out.push_str(" > ");
            }
            out.push_str(name);
        }
        return out;
    }
}

impl Display for Diagnostic {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.severity.label()}[${self.code.name()}] at ${self.line}:${self.col}: ${self.message}`);
    }
}

fn lex_error_at(tokens: &TokenStream, i: i32) -> Diagnostic {
    let mut message = String::from("token recognition error at: '");
    push_chars_escaped(&mut message, tokens.chars, tokens.starts[i], tokens.ends[i]);
    message.push('\'');
    return Diagnostic::error(
        DiagnosticCode::LexError,
        message,
        tokens.span_at(i),
        [],
        tokens.kinds[i],
        RecoveryAction::None,
    );
}

pub fn merge_lex_errors(tokens: &TokenStream, diagnostics: &mut List<Diagnostic>, max_errors: i32) {
    let mut merged: List<Diagnostic> = [];
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.is_lex_error(i) {
            merged.push(lex_error_at(tokens, i));
        }
    }
    merged.extend(diagnostics);
    merged.sort_by(|a: &Diagnostic, b: &Diagnostic| a.span.start.cmp(&b.span.start));
    merged.truncate(max_errors);
    *diagnostics = merged;
}

pub fn resolve_positions(diagnostics: &mut List<Diagnostic>, chars: &List<char>) {
    if diagnostics.is_empty() {
        return;
    }
    let starts = line_starts(chars);
    for let mut i = 0; i < diagnostics.len(); i += 1 {
        let lc = line_col_at(&starts, diagnostics[i].span.start);
        diagnostics[i].line = lc.0;
        diagnostics[i].col = lc.1;
    }
}

pub type NodeKind = i32;

pub global K_ERROR: NodeKind = -1;

pub flags NodeFlags {
    Error,
    Incomplete,
}

pub enum EventTag {
    Open,
    Close,
    Tok,
    Miss,
    Skip,
}

pub struct CstStore {
    pub tag: List<EventTag>,
    pub id: List<i32>,
    pub offset: List<i32>,
    alt: List<i32>,
    end: List<i32>,
    flags: List<NodeFlags>,
    next: List<i32>,
}

pub enum ChildKind {
    Node,
    Token,
    Missing,
    Skipped,
}

impl CstStore {
    pub fn row_count(&self) -> i32 {
        return self.tag.len();
    }

    pub fn kind(&self, i: i32) -> NodeKind {
        return self.id[i] as NodeKind;
    }

    pub fn span(&self, i: i32) -> Span {
        return Span::new(self.offset[i], self.end[i]);
    }

    pub fn alt(&self, i: i32) -> i32 {
        return self.alt[i];
    }

    pub fn is_error(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Error != NodeFlags::none();
    }

    pub fn is_incomplete(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Incomplete != NodeFlags::none();
    }

    pub fn is_node(&self, i: i32) -> bool {
        return self.tag[i] matches { Open };
    }

    pub fn is_token(&self, i: i32) -> bool {
        return self.tag[i] matches { Tok | Miss | Skip };
    }

    pub fn child_kind(&self, i: i32) -> ChildKind {
        return match self.tag[i] {
            Open => ChildKind::Node,
            Miss => ChildKind::Missing,
            Skip => ChildKind::Skipped,
            Tok => ChildKind::Token,
            Close => panic("CstStore::child_kind: Close is not a child row"),
        };
    }

    pub fn token_index(&self, i: i32) -> i32 {
        return self.id[i];
    }

    pub fn first_child(&self, i: i32) -> i32 {
        let c = i + 1;
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn next_sibling(&self, child: i32) -> i32 {
        let c = if self.tag[child] matches { Open } { self.next[child] } else { child + 1 };
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn find_child(&self, i: i32, kind: NodeKind) -> i32 {
        let k = kind as i32;
        for let mut c = self.first_child(i); c >= 0; c = self.next_sibling(c) {
            if self.tag[c] matches { Open } && self.kind(c) as i32 == k {
                return c;
            }
        }
        return -1;
    }

    pub fn to_string_tree(
        &self,
        i: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(256);
        let _ = render_node(&mut out, &self.tag, &self.id, i, toks, rule_names, token_names);
        return out;
    }
}

pub struct ParseResult {
    pub cst: CstStore,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
    pub output: String = "",
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        return self.diagnostics.iter_ref().any(|d| d.is_error());
    }

    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

fn bubble_to_parent(stack: &List<i32>, end: &mut List<i32>, flags: &mut List<NodeFlags>, child: i32) {
    if stack.len() > 0 {
        let parent = stack[stack.len() - 1];
        if end[child] > end[parent] {
            end[parent] = end[child];
        }
        flags[parent] = flags[parent] | flags[child] & NodeFlags::Error;
    }
}

pub struct TreeBuilder {
    tag: List<EventTag>,
    id: List<i32>,
    offset: List<i32>,
    alt: List<i32>,
    open: List<i32>,
    last_finished: i32,
    error_row: i32,
}

impl TreeBuilder {
    pub fn with_capacity(rows: i32) -> TreeBuilder {
        return TreeBuilder {
            tag: List::with_capacity(rows),
            id: List::with_capacity(rows),
            offset: List::with_capacity(rows),
            alt: List::with_capacity(rows),
            open: [],
            last_finished: -1,
            error_row: -1,
        };
    }

    fn push_row(&mut self, tag: EventTag, id: i32, offset: i32) {
        if self.tag.len() >= self.tag.capacity() {
            builtin::cold_path();
            self.tag.grow();
            self.id.grow();
            self.offset.grow();
            self.alt.grow();
            assert self.id.capacity() == self.tag.capacity()
                && self.offset.capacity() == self.tag.capacity()
                && self.alt.capacity() == self.tag.capacity(), "TreeBuilder event columns must grow in lockstep";
        }
        self.tag.push_within_capacity(tag);
        self.id.push_within_capacity(id);
        self.offset.push_within_capacity(offset);
        self.alt.push_within_capacity(-1);
    }

    pub fn start_node(&mut self, kind: NodeKind, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, kind as i32, start);
        self.open.push(row);
    }

    pub fn start_error(&mut self, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, K_ERROR as i32, start);
        self.open.push(row);
    }

    pub fn set_alt(&mut self, alt: i32) {
        self.alt[self.open[self.open.len() - 1]] = alt;
    }

    pub fn checkpoint(&self) -> i32 {
        return self.tag.len();
    }

    pub fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32) {
        assert self.innermost_open() < checkpoint, "a node wraps only rows finished before it";
        self.tag.insert(checkpoint, EventTag::Open);
        self.id.insert(checkpoint, kind as i32);
        self.offset.insert(checkpoint, start);
        self.alt.insert(checkpoint, -1);
        self.open.push(checkpoint);
        if self.last_finished >= checkpoint {
            self.last_finished += 1;
        }
        if self.error_row >= checkpoint {
            self.error_row += 1;
        }
    }

    pub fn truncate(&mut self, checkpoint: i32) {
        self.tag.truncate(checkpoint);
        self.id.truncate(checkpoint);
        self.offset.truncate(checkpoint);
        self.alt.truncate(checkpoint);
        while self.open.len() > 0 && self.open[self.open.len() - 1] >= checkpoint {
            let _ = self.open.pop();
        }
        if self.last_finished >= checkpoint {
            self.last_finished = -1;
        }
        if self.error_row > checkpoint {
            self.error_row = checkpoint;
        }
    }

    pub fn finish_node(&mut self, end: i32) {
        let row = self.open[self.open.len() - 1];
        self.push_row(EventTag::Close, self.id[row], end);
        self.last_finished = row;
        let _ = self.open.pop();
    }

    pub fn innermost_open(&self) -> i32 {
        if self.open.is_empty() {
            return -1;
        }
        return self.open[self.open.len() - 1];
    }

    pub fn node_kind(&self, row: i32) -> NodeKind {
        return self.id[row] as NodeKind;
    }

    pub fn resume_node(&mut self, row: i32, end: i32) {
        while self.innermost_open() > row {
            self.finish_node(end);
        }
        if self.innermost_open() == row {
            return;
        }
        assert self.last_finished == row && self.tag[self.tag.len() - 1] matches { Close }, "resume_node: a node no longer open is the last one closed";
        self.truncate(self.tag.len() - 1);
        self.open.push(row);
    }

    pub fn mark_error(&mut self) {
        self.error_row = self.tag.len();
    }

    pub fn in_error_mode(&self) -> bool {
        if self.error_row < 0 {
            return false;
        }
        for let mut r = self.error_row; r < self.tag.len(); r += 1 {
            if self.tag[r] matches { Tok } {
                return false;
            }
        }
        return true;
    }

    pub fn push_open_rule_names(&self, rule_names: &List<String>, out: &mut List<String>) {
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            let kind = self.id[self.open[i]];
            if kind != K_ERROR as i32 {
                out.push(rule_names[kind]);
            }
        }
    }

    pub fn token(&mut self, idx: i32) {
        self.push_row(EventTag::Tok, idx, 0);
    }

    pub fn missing(&mut self, syn_idx: i32) {
        self.push_row(EventTag::Miss, syn_idx, 0);
    }

    pub fn skip(&mut self, idx: i32) {
        self.push_row(EventTag::Skip, idx, 0);
    }

    pub fn finish(&self) -> CstStore {
        let n = self.tag.len();
        let mut end = List::filled(n, 0);
        let mut flags = List::filled(n, NodeFlags::none());
        let mut next = List::filled(n, 0);
        let mut stack: List<i32> = [];
        for let mut r = 0; r < n; r += 1 {
            match self.tag[r] {
                Open => {
                    if self.id[r] == K_ERROR as i32 {
                        flags[r] = NodeFlags::Error;
                    }
                    end[r] = self.offset[r];
                    stack.push(r);
                },
                Miss => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Incomplete | NodeFlags::Error;
                },
                Skip => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Error;
                },
                Close => {
                    let oi = stack[stack.len() - 1];
                    let _ = stack.pop();
                    if self.offset[r] > end[oi] {
                        end[oi] = self.offset[r];
                    }
                    next[oi] = r + 1;
                    bubble_to_parent(&stack, &mut end, &mut flags, oi);
                },
                Tok => {
                },
            }
        }
        while stack.len() > 0 {
            let oi = stack[stack.len() - 1];
            let _ = stack.pop();
            next[oi] = n;
            bubble_to_parent(&stack, &mut end, &mut flags, oi);
        }
        return CstStore { tag: self.tag, id: self.id, offset: self.offset, alt: self.alt, end, flags, next };
    }

    pub fn render_open(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if self.open.len() == 0 {
            return String::new();
        }
        return self.render_from(self.open[self.open.len() - 1], toks, rule_names, token_names);
    }

    pub fn render_at(
        &self,
        row: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if row < 0 || row >= self.tag.len() || !self.tag[row] matches { Open } {
            return String::new();
        }
        return self.render_from(row, toks, rule_names, token_names);
    }

    pub fn open_rule_names(&self, rule_names: &List<String>) -> String {
        let mut out = String::from("[");
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            if i < self.open.len() - 1 {
                out.push_str(", ");
            }
            let kind = self.id[self.open[i]];
            let name = if kind == K_ERROR as i32 { "<error>" } else { rule_names[kind] };
            out.push_str(&name);
        }
        out.push_str("]");
        return out;
    }

    pub fn render_last_finished(
        &self,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if self.last_finished < 0 {
            return String::new();
        }
        return self.render_from(self.last_finished, toks, rule_names, token_names);
    }

    fn render_from(
        &self,
        root: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(128);
        let _ = render_node(&mut out, &self.tag, &self.id, root, toks, rule_names, token_names);
        return out;
    }
}

fn render_node(
    out: &mut String,
    tag: &List<EventTag>,
    id: &List<i32>,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) -> i32 {
    let name = if id[i] == K_ERROR as i32 { "<error>" } else { rule_names[id[i]] };
    if i + 1 >= tag.len() || tag[i + 1] matches { Close } {
        out.push_str(&name);
        if i + 1 < tag.len() {
            return i + 2;
        }
        return i + 1;
    }
    out.push_str("(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < tag.len() {
        match tag[c] {
            Open => {
                out.push_str(" ");
                c = render_node(out, tag, id, c, toks, rule_names, token_names);
            },
            Close => {
                out.push_str(")");
                return c + 1;
            },
            Tok => {
                if !toks.is_empty_text(id[c]) {
                    out.push_str(" ");
                    toks.push_token_text_escaped(out, id[c]);
                }
                c += 1;
            },
            Miss => {
                out.push_str(` <missing ${token_names[toks.kind_at(id[c])]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(" <skip ");
                toks.push_token_text_escaped(out, id[c]);
                out.push_str(">");
                c += 1;
            },
        }
    }
    out.push_str(")");
    return c;
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let starts = line_starts(tokens.chars);
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &starts,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &starts,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    starts: &List<i32>,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let type_id = if is_eof { -1 } else { kind + 1 };
    let lc = line_col_at(starts, start);
    out.push_str(`[@${index},${start}:${end - 1}='`);
    if is_eof {
        out.push_str("<EOF>");
    } else {
        push_chars_escaped(out, tokens.chars, start, end);
    }
    out.push_str(`',<${type_id}>,`);
    if channel != 0 {
        out.push_str(`channel=${channel},`);
    }
    out.push_str(`${lc.0}:${lc.1}]\n`);
}

pub global FOLLOW_MAX_DEPTH: i32 = 4;

pub global FOLLOW_SLOT_BITS: i64 = 8;

pub global FOLLOW_ID_MASK: i64 = 127;

pub global FOLLOW_OPENS_BIT: i64 = 128;

pub global FOLLOW_CONT_MASK: i64 = 0x00FF_FFFF_FFFF_FFFF;

pub global FOLLOW_SEQUENCED: i64 = 0x007F_7F7F_7F7F_7F7F;

pub fn follow_yields(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    let mut c = cont;
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    while c & FOLLOW_ID_MASK != 0 {
        if c & FOLLOW_OPENS_BIT != 0 {
            if alive && constrained {
                return true;
            }
            depth = 0;
            alive = true;
            constrained = false;
        }
        if depth < FOLLOW_MAX_DEPTH {
            constrained = true;
            if alive {
                let set = &sets[((c & FOLLOW_ID_MASK) - 1) as i32];
                if !set.is_empty() {
                    let idx = pos + depth;
                    let kind = if idx < tokens.len() { tokens[idx] } else { eof_kind };
                    if !kind_set_has(set, kind) {
                        alive = false;
                    }
                }
            }
            depth += 1;
        }
        c = c >> FOLLOW_SLOT_BITS;
    }
    return alive && constrained;
}
pub global TK_INT: i32 = 0;
pub global TK_Z: i32 = 1;
pub global TK_WS: i32 = 2;
pub global TK_EOF: i32 = 3;
pub global TK_ERROR: i32 = 4;
pub global TK_LIT_x: i32 = 5;
pub global TK_LIT_y: i32 = 6;
pub global TK_LIT_BANG: i32 = 7;
pub global TK_LIT_w: i32 = 8;
pub global TK_LIT_q: i32 = 9;
pub global TK_LIT_PLUS: i32 = 10;
pub global TK_LIT_LPAREN: i32 = 11;
pub global TK_LIT_RPAREN: i32 = 12;
pub global TK_LIT_end: i32 = 13;
pub global TK_LIT_SEMI: i32 = 14;
pub global TK_LIT_a: i32 = 15;
pub global TK_LIT_b: i32 = 16;
pub global TK_LIT_v: i32 = 17;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }
}

fn try_INT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { '0'..='9' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !((chars[pos] matches { '0'..='9' })) { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_Z(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'z' { return -1; }
    pos += 1;
    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ' ' { return -1; }
    pos += 1;
    return pos;
}

fn try_lit_x(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'x' { return -1; }
    return pos + 1;
}

fn try_lit_y(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'y' { return -1; }
    return pos + 1;
}

fn try_lit_BANG(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '!' { return -1; }
    return pos + 1;
}

fn try_lit_w(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'w' { return -1; }
    return pos + 1;
}

fn try_lit_q(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'q' { return -1; }
    return pos + 1;
}

fn try_lit_PLUS(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '+' { return -1; }
    return pos + 1;
}

fn try_lit_LPAREN(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '(' { return -1; }
    return pos + 1;
}

fn try_lit_RPAREN(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ')' { return -1; }
    return pos + 1;
}

fn try_lit_end(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'e' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'n' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'd' { return -1; }
    return pos + 3;
}

fn try_lit_SEMI(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ';' { return -1; }
    return pos + 1;
}

fn try_lit_a(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'a' { return -1; }
    return pos + 1;
}

fn try_lit_b(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'b' { return -1; }
    return pos + 1;
}

fn try_lit_v(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'v' { return -1; }
    return pos + 1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        match first_char {
            ' ' => {
                end = try_WS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_WS; }
            },
            '!' => {
                end = try_lit_BANG(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_BANG; }
            },
            '(' => {
                end = try_lit_LPAREN(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_LPAREN; }
            },
            ')' => {
                end = try_lit_RPAREN(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_RPAREN; }
            },
            '+' => {
                end = try_lit_PLUS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PLUS; }
            },
            '0'..='9' => {
                end = try_INT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_INT; }
            },
            ';' => {
                end = try_lit_SEMI(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_SEMI; }
            },
            'a' => {
                end = try_lit_a(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_a; }
            },
            'b' => {
                end = try_lit_b(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_b; }
            },
            'e' => {
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    'n' => {
                        end = try_lit_end(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_LIT_end; }
                    },
                    _ => {
                    },
                }
            },
            'q' => {
                end = try_lit_q(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_q; }
            },
            'v' => {
                end = try_lit_v(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_v; }
            },
            'w' => {
                end = try_lit_w(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_w; }
            },
            'x' => {
                end = try_lit_x(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_x; }
            },
            'y' => {
                end = try_lit_y(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_y; }
            },
            'z' => {
                end = try_Z(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Z; }
            },
            _ => {},
        }
        if best_end <= start {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_INT => "INT",
        TK_Z => "Z",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_x => "'x'",
        TK_LIT_y => "'y'",
        TK_LIT_BANG => "'!'",
        TK_LIT_w => "'w'",
        TK_LIT_q => "'q'",
        TK_LIT_PLUS => "'+'",
        TK_LIT_LPAREN => "'('",
        TK_LIT_RPAREN => "')'",
        TK_LIT_end => "'end'",
        TK_LIT_SEMI => "';'",
        TK_LIT_a => "'a'",
        TK_LIT_b => "'b'",
        TK_LIT_v => "'v'",
        _ => "Unknown",
    };
}

pub global RK_LOOP: NodeKind = 0;
pub global RK_TAIL: NodeKind = 1;
pub global RK_TAILED: NodeKind = 2;
pub global RK_OPT: NodeKind = 3;
pub global RK_GRP: NodeKind = 4;
pub global RK_PLUS: NodeKind = 5;
pub global RK_TWICE: NodeKind = 6;
pub global RK_ONE: NodeKind = 7;
pub global RK_SINGLE: NodeKind = 8;
pub global RK_INNER: NodeKind = 9;
pub global RK_MULTI: NodeKind = 10;
pub global RK_MY: NodeKind = 11;
pub global RK_MW: NodeKind = 12;
pub global RK_EXPR: NodeKind = 13;
pub global RK_E: NodeKind = 14;
pub global RK_QUIET: NodeKind = 15;
pub global RK_MID: NodeKind = 16;
pub global RK_PAIR: NodeKind = 17;
pub global RK_TRAIL: NodeKind = 18;
pub global RK_GRPEND: NodeKind = 19;

global RULE_NAMES: List<String> = ["loop", "tail", "tailed", "opt", "grp", "plus", "twice", "one", "single", "inner", "multi", "my", "mw", "expr", "e", "quiet", "mid", "pair", "trail", "grpend"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    site: i32,
    sites: List<i32>,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, site: -1, sites: [], b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.recovering = true;
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
        }
        self.recovering = true;
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail_expecting(&([kind] as List<i32>));
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn recover_rule(&mut self, rule: NodeKind, name: String, row: i32) -> bool {
        if self.speculating || self.diagnostics.len() >= self.max_errors {
            self.push_rule_stack(name);
            return false;
        }
        let node = if row < 0 { self.b.innermost_open() } else { row };
        self.b.resume_node(node, self.last_end());
        assert self.b.node_kind(node) == rule, "recover_rule: the resumed node is the failed rule's";
        self.commit_pending();
        self.recovering = false;
        self.skip_until(&self.resync_set(&[]));
        return true;
    }

    fn commit_pending(&mut self) {
        let Some(d) = self.pending else { return; };
        self.pending = null;
        let mut diag = d;
        self.b.push_open_rule_names(&RULE_NAMES, &mut diag.rule_stack);
        self.report(diag);
    }

    fn report(&mut self, diag: Diagnostic) {
        if self.b.in_error_mode() { return; }
        self.diagnostics.push(diag);
        self.b.mark_error();
    }

    fn resync_set(&self, base: &List<i32>) -> List<i32> {
        let mut set = *base;
        for let s of &self.sites {
            if *s < 0 { continue; }
            let f = &CALL_FOLLOW_SETS[CALL_FOLLOW[*s]];
            while set.len() < f.len() { set.push(0); }
            for let mut i = 0; i < f.len(); i += 1 { set[i] = set[i] | f[i]; }
        }
        return set;
    }

    fn follows_rules_under_way(&self, k: i32) -> bool {
        for let mut i = self.sites.len() - 1; i >= 0; i -= 1 {
            let s = self.sites[i];
            if s < 0 { return i == 0 && k == TK_EOF; }
            if kind_set_has(&CALL_FOLLOW_SETS[CALL_FOLLOW[s]], k) { return true; }
            if !CALL_FOLLOW_ENDS[s] { return false; }
        }
        return k == TK_EOF;
    }

    fn skip_until(&mut self, set: &List<i32>) {
        loop {
            let k = self.kinds[self.pos];
            if k == TK_EOF || kind_set_has(set, k) { break; }
            self.skip_one();
        }
    }

    fn skip_one(&mut self) {
        let _sk = self.advance();
        self.tokens.mark_skipped(_sk);
        self.b.skip(_sk);
    }

    fn sync_delete(&mut self, sync: &List<i32>, expected: &List<i32>) -> bool {
        if self.speculating || self.kinds[self.pos] == TK_EOF || !kind_set_has(sync, self.peek_at(1)) {
            return false;
        }
        self.report_extraneous(expected, RecoveryAction::Deleted);
        self.skip_one();
        return true;
    }

    fn sync_enter(&mut self, sync: &List<i32>, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.fail_expecting(expected);
        }
    }

    fn sync_alts(&mut self, sync: &List<i32>, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.no_viable("no viable alternative", self.peek_span(), expected);
        }
    }

    fn sync_back(&mut self, sync: &List<i32>, expected: &List<i32>) {
        if self.recovering || self.kinds[self.pos] == TK_EOF { return; }
        if self.speculating {
            self.fail_expecting(expected);
            return;
        }
        self.report_extraneous(expected, RecoveryAction::SkippedTo);
        self.skip_until(&self.resync_set(sync));
    }

    fn fail_expecting(&mut self, expected: &List<i32>) {
        let code = if self.kinds[self.pos] == TK_EOF { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
        self.fail_on_token("got", expected, code);
    }

    fn report_extraneous(&mut self, expected: &List<i32>, recovery: RecoveryAction) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), *expected, self.kinds[self.pos], recovery));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let found = self.kinds[self.pos];
        let at_eof = found == TK_EOF;
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.report(Diagnostic::error(code, `missing ${TOKEN_NAMES[kind]}`, self.tokens.span_at(self.pos), [kind], found, recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>, may_end_rule: bool) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extraneous(&[kind], RecoveryAction::Deleted);
            self.skip_one();
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if kind_set_has(sync, self.kinds[self.pos]) || may_end_rule && self.follows_rules_under_way(self.kinds[self.pos]) {
            self.report_missing(kind);
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            if !may_end_rule && self.kinds[self.pos] == TK_EOF {
                self.fail_on_kind(kind);
                return self.pos;
            }
            self.report_unexpected(kind);
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || kind_set_has(sync, _k) { break; }
                    self.skip_one();
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        let kind = self.kinds[self.pos];
        if kind == TK_EOF {
            self.b.token(self.pos);
            return self.pos;
        }
        let _i = self.advance();
        self.b.token(_i);
        return _i;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("expected any token; got", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !kind_set_has(excluded, k) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("unexpected token", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>, expected: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if kind_set_has(included, k) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("got", expected, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

fn scan_e_atom(tokens: &Array<i32>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if kind == TK_INT {
        pos = start + 1;
        return pos;
    } else if kind == TK_LIT_LPAREN {
        pos = start + 1;
        try_2: {
            pos = scan_e(tokens, pos, 0);
            if pos < 0 { break try_2; }
            if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_2; }
            pos += 1;
            return pos;
        }
        return -1;
    }
    return -1;
}

fn scan_e_lr_0(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_PLUS { return -1; }
    pos += 1;
    pos = scan_e(tokens, pos, 2);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_e(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_e_atom(tokens, pos);
    if pos < 0 { return -1; }
    loop {
        let suffix_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        if suffix_kind == TK_LIT_PLUS {
            if 1 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_e_lr_0(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return pos;
}

fn _parse_loop__inner(p: &mut Parser) -> () {
    p.expect(TK_LIT_x, &SYNC_0, false);
    if !kind_set_has(&SYNC_0, p.kinds[p.pos]) { builtin::cold_path(); p.sync_enter(&SYNC_0, &EXPECTED_0); }
    while !p.recovering && (p.peek_kind() == TK_LIT_y) {
        p.take();
        if !kind_set_has(&SYNC_0, p.kinds[p.pos]) { builtin::cold_path(); p.sync_back(&SYNC_0, &EXPECTED_0); }
    }
    p.expect(TK_LIT_BANG, &EMPTY_SYNC, true);
    return;
}

fn _parse_loop(p: &mut Parser) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_LOOP, _start);
    _parse_loop__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_LOOP, "loop", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_tail__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.site = 0;
    _parse_tailed(p, (FOLLOW_MASK_0 | (follow & FOLLOW_SEQUENCED) << 8) & FOLLOW_CONT_MASK);
    p.expect(TK_LIT_BANG, &EMPTY_SYNC, true);
    return;
}

