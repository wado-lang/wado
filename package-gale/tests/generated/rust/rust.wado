pub fn parse(input: &String) -> Result<CrateNode, ParseError> {
    return parse_crate(input);
}

pub fn walk_crate<V: Visitor>(v: &mut V, node: &CrateNode) {
    v.enter_rule(0, &"crate", &node.span);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    for let item of &node.item_list {
        walk_item(v, item);
    }
    v.visit_token(&node.eof);
    v.exit_rule(0, &"crate", &node.span);
}

pub fn walk_macroInvocation<V: Visitor>(v: &mut V, node: &MacroInvocationNode) {
    v.enter_rule(1, &"macroInvocation", &node.span);
    walk_simplePath(v, &node.simple_path);
    v.visit_token(&node.not);
    walk_delimTokenTree(v, &node.delim_token_tree);
    v.exit_rule(1, &"macroInvocation", &node.span);
}

pub fn walk_delimTokenTree<V: Visitor>(v: &mut V, node: &DelimTokenTreeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(2, &"delimTokenTree", &n.span);
            v.visit_token(&n.lparen);
            for let item of &n.token_tree_list {
                walk_tokenTree(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(2, &"delimTokenTree", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(2, &"delimTokenTree", &n.span);
            v.visit_token(&n.lsquarebracket);
            for let item of &n.token_tree_list {
                walk_tokenTree(v, item);
            }
            v.visit_token(&n.rsquarebracket);
            v.exit_rule(2, &"delimTokenTree", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(2, &"delimTokenTree", &n.span);
            v.visit_token(&n.lcurlybrace);
            for let item of &n.token_tree_list {
                walk_tokenTree(v, item);
            }
            v.visit_token(&n.rcurlybrace);
            v.exit_rule(2, &"delimTokenTree", &n.span);
        }
    }
}

pub fn walk_tokenTree<V: Visitor>(v: &mut V, node: &TokenTreeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(3, &"tokenTree", &n.span);
            for let item of &n.token_tree_token_list {
                walk_tokenTreeToken(v, item);
            }
            v.exit_rule(3, &"tokenTree", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(3, &"tokenTree", &n.span);
            walk_delimTokenTree(v, &n.delim_token_tree);
            v.exit_rule(3, &"tokenTree", &n.span);
        }
    }
}

pub fn walk_tokenTreeToken<V: Visitor>(v: &mut V, node: &TokenTreeTokenNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(4, &"tokenTreeToken", &n.span);
            walk_macroIdentifierLikeToken(v, &n.macro_identifier_like_token);
            v.exit_rule(4, &"tokenTreeToken", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(4, &"tokenTreeToken", &n.span);
            walk_macroLiteralToken(v, &n.macro_literal_token);
            v.exit_rule(4, &"tokenTreeToken", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(4, &"tokenTreeToken", &n.span);
            walk_macroPunctuationToken(v, &n.macro_punctuation_token);
            v.exit_rule(4, &"tokenTreeToken", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(4, &"tokenTreeToken", &n.span);
            walk_macroRepOp(v, &n.macro_rep_op);
            v.exit_rule(4, &"tokenTreeToken", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(4, &"tokenTreeToken", &n.span);
            v.visit_token(&n.dollar);
            v.exit_rule(4, &"tokenTreeToken", &n.span);
        }
    }
}

pub fn walk_macroInvocationSemi<V: Visitor>(v: &mut V, node: &MacroInvocationSemiNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(5, &"macroInvocationSemi", &n.span);
            walk_simplePath(v, &n.simple_path);
            v.visit_token(&n.not);
            v.visit_token(&n.lparen);
            for let item of &n.token_tree_list {
                walk_tokenTree(v, item);
            }
            v.visit_token(&n.rparen);
            v.visit_token(&n.semi);
            v.exit_rule(5, &"macroInvocationSemi", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(5, &"macroInvocationSemi", &n.span);
            walk_simplePath(v, &n.simple_path);
            v.visit_token(&n.not);
            v.visit_token(&n.lsquarebracket);
            for let item of &n.token_tree_list {
                walk_tokenTree(v, item);
            }
            v.visit_token(&n.rsquarebracket);
            v.visit_token(&n.semi);
            v.exit_rule(5, &"macroInvocationSemi", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(5, &"macroInvocationSemi", &n.span);
            walk_simplePath(v, &n.simple_path);
            v.visit_token(&n.not);
            v.visit_token(&n.lcurlybrace);
            for let item of &n.token_tree_list {
                walk_tokenTree(v, item);
            }
            v.visit_token(&n.rcurlybrace);
            v.exit_rule(5, &"macroInvocationSemi", &n.span);
        }
    }
}

pub fn walk_macroRulesDefinition<V: Visitor>(v: &mut V, node: &MacroRulesDefinitionNode) {
    v.enter_rule(6, &"macroRulesDefinition", &node.span);
    v.visit_token(&node.kw_macrorules);
    v.visit_token(&node.not);
    walk_identifier(v, &node.identifier);
    walk_macroRulesDef(v, &node.macro_rules_def);
    v.exit_rule(6, &"macroRulesDefinition", &node.span);
