            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_traitObjectTypeOneBound(v, &n.trait_object_type_one_bound);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_typePath(v, &n.type_path);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_tupleType(v, &n.tuple_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_neverType(v, &n.never_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_rawPointerType(v, &n.raw_pointer_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_referenceType(v, &n.reference_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_arrayType(v, &n.array_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_sliceType(v, &n.slice_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_inferredType(v, &n.inferred_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_qualifiedPathInType(v, &n.qualified_path_in_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_bareFunctionType(v, &n.bare_function_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_macroInvocation(v, &n.macro_invocation);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
    }
}

