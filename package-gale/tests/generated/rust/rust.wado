            walk_maybeNamedFunctionParameters(v, &n.maybe_named_function_parameters);
            v.exit_rule(155, &"functionParametersMaybeNamedVariadic", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(155, &"functionParametersMaybeNamedVariadic", &n.span);
            walk_maybeNamedFunctionParametersVariadic(v, &n.maybe_named_function_parameters_variadic);
            v.exit_rule(155, &"functionParametersMaybeNamedVariadic", &n.span);
        }
    }
}

pub fn walk_maybeNamedFunctionParameters<V: Visitor>(v: &mut V, node: &MaybeNamedFunctionParametersNode) {
    v.enter_rule(156, &"maybeNamedFunctionParameters", &node.span);
    walk_maybeNamedParam(v, &node.maybe_named_param);
    for let item of &node.comma_maybe_named_param_list {
        v.visit_token(&item.comma);
        walk_maybeNamedParam(v, &item.maybe_named_param);
    }
    if let Some(item) = &node.comma {
