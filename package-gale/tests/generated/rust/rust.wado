        }
        let item = _parse_item(p, &EMPTY_FOLLOW)?;
        item_list.push(item);
    }
    let eof = p.expect(TK_EOF)?;
    return Result::<CrateNode, ParseError>::Ok(CrateNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        inner_attribute_list,
