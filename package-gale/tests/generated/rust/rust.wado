fn _parse_visibility__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<VisibilityNode, ParseError> {
    let start = p.peek().span.start;
    let kw_pub = p.expect(TK_KW_PUB)?;
    let lparen_item_rparen: Option<LparenItemRparenItem> = if !(follow_yields(&p.tokens, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_LPAREN) {
        let lparen = p.expect(TK_LPAREN)?;
        let mut group_0_inner: Option<VisibilityGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_KW_CRATE {
            let kw_crate = p.expect(TK_KW_CRATE)?;
            group_0_inner = Option::<VisibilityGroup0>::Some(VisibilityGroup0::Alt0(VisibilityGroup0Alt0 {
                kw_crate,
            }));
        } else if grp_kind == TK_KW_SELFVALUE {
            let kw_selfvalue = p.expect(TK_KW_SELFVALUE)?;
            group_0_inner = Option::<VisibilityGroup0>::Some(VisibilityGroup0::Alt1(VisibilityGroup0Alt1 {
                kw_selfvalue,
            }));
        } else if grp_kind == TK_KW_SUPER {
            let kw_super = p.expect(TK_KW_SUPER)?;
            group_0_inner = Option::<VisibilityGroup0>::Some(VisibilityGroup0::Alt2(VisibilityGroup0Alt2 {
                kw_super,
            }));
        } else if grp_kind == TK_KW_IN {
            let kw_in = p.expect(TK_KW_IN)?;
            let simple_path = _parse_simple_path(p, follow)?;
            group_0_inner = Option::<VisibilityGroup0>::Some(VisibilityGroup0::Alt3(VisibilityGroup0Alt3 {
                kw_in,
                simple_path,
            }));
        }
        let group_0 = group_0_inner;
        let rparen = p.expect(TK_RPAREN)?;
        let lparen_item_rparen = LparenItemRparenItem {
            lparen,
            group_0,
            rparen,
        };
        Option::<LparenItemRparenItem>::Some(lparen_item_rparen)
    } else {
        null
    };
    return Result::<VisibilityNode, ParseError>::Ok(VisibilityNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        kw_pub,
        lparen_item_rparen,
    });
}

