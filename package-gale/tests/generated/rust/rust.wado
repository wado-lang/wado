        inner_attribute_list.push(inner_attribute);
    }
    let mut item_list: List<ItemNode> = [];
    loop {
        let mut rep_scan_pos_2: i32 = -1;
        rep_scan_2: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_item(tokens, pos, &EMPTY_FOLLOW, 0);
            if pos < 0 { break rep_scan_2; }
            if pos <= p.pos { break rep_scan_2; }
            rep_scan_pos_2 = pos;
        }
        if rep_scan_pos_2 < 0 {
            if _gale_kind_set_0(p.peek_kind()) {
                let _rec_pos = p.pos;
                if let Err(_rec_e) = _parse_item(p, &EMPTY_FOLLOW) { p.record_deeper(_rec_e); }
                p.pos = _rec_pos;
