pub fn walk_macroRules<V: Visitor>(v: &mut V, node: &MacroRulesNode) {
    v.enter_rule(8, &"macroRules", &node.span);
    walk_macroRule(v, &node.macro_rule);
    for let item of &node.semi_macro_rule_list {
        v.visit_token(&item.semi);
        walk_macroRule(v, &item.macro_rule);
    }
    if let Some(item) = &node.semi {
        v.visit_token(item);
    }
    v.exit_rule(8, &"macroRules", &node.span);
}

pub fn walk_macroRule<V: Visitor>(v: &mut V, node: &MacroRuleNode) {
    v.enter_rule(9, &"macroRule", &node.span);
    walk_macroMatcher(v, &node.macro_matcher);
    v.visit_token(&node.fatarrow);
    walk_macroTranscriber(v, &node.macro_transcriber);
    v.exit_rule(9, &"macroRule", &node.span);
}

pub fn walk_macroMatcher<V: Visitor>(v: &mut V, node: &MacroMatcherNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(10, &"macroMatcher", &n.span);
            v.visit_token(&n.lparen);
            for let item of &n.macro_match_list {
                walk_macroMatch(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(10, &"macroMatcher", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(10, &"macroMatcher", &n.span);
            v.visit_token(&n.lsquarebracket);
            for let item of &n.macro_match_list {
                walk_macroMatch(v, item);
            }
            v.visit_token(&n.rsquarebracket);
            v.exit_rule(10, &"macroMatcher", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(10, &"macroMatcher", &n.span);
            v.visit_token(&n.lcurlybrace);
            for let item of &n.macro_match_list {
                walk_macroMatch(v, item);
            }
            v.visit_token(&n.rcurlybrace);
            v.exit_rule(10, &"macroMatcher", &n.span);
        }
    }
}

pub fn walk_macroMatch<V: Visitor>(v: &mut V, node: &MacroMatchNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(11, &"macroMatch", &n.span);
            for let item of &n.macro_match_token_list {
                walk_macroMatchToken(v, item);
            }
            v.exit_rule(11, &"macroMatch", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(11, &"macroMatch", &n.span);
            walk_macroMatcher(v, &n.macro_matcher);
            v.exit_rule(11, &"macroMatch", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(11, &"macroMatch", &n.span);
            v.visit_token(&n.dollar);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        walk_identifier(v, &inner.identifier);
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.kw_selfvalue);
                    }
                }
            }
            v.visit_token(&n.colon);
            walk_macroFragSpec(v, &n.macro_frag_spec);
            v.exit_rule(11, &"macroMatch", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(11, &"macroMatch", &n.span);
            v.visit_token(&n.dollar);
            v.visit_token(&n.lparen);
            for let item of &n.macro_match_list {
                walk_macroMatch(v, item);
            }
            v.visit_token(&n.rparen);
            if let Some(item) = &n.macro_rep_sep {
                walk_macroRepSep(v, item);
            }
            walk_macroRepOp(v, &n.macro_rep_op);
            v.exit_rule(11, &"macroMatch", &n.span);
        }
    }
}

pub fn walk_macroMatchToken<V: Visitor>(v: &mut V, node: &MacroMatchTokenNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(12, &"macroMatchToken", &n.span);
            walk_macroIdentifierLikeToken(v, &n.macro_identifier_like_token);
            v.exit_rule(12, &"macroMatchToken", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(12, &"macroMatchToken", &n.span);
            walk_macroLiteralToken(v, &n.macro_literal_token);
            v.exit_rule(12, &"macroMatchToken", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(12, &"macroMatchToken", &n.span);
            walk_macroPunctuationToken(v, &n.macro_punctuation_token);
            v.exit_rule(12, &"macroMatchToken", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(12, &"macroMatchToken", &n.span);
            walk_macroRepOp(v, &n.macro_rep_op);
            v.exit_rule(12, &"macroMatchToken", &n.span);
        }
    }
}

