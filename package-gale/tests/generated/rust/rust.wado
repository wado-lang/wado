    if kind == TK_KW_UNSAFE {
        let unsafe_block_expression = _parse_unsafe_block_expression(p, follow)?;
        return Result::<ExpressionWithBlockNode, ParseError>::Ok(ExpressionWithBlockNode::Alt3(ExpressionWithBlockAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            unsafe_block_expression,
