fn _parse_keyword(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<KeywordNode, ParseError> {
    let r = _parse_keyword__inner(p, follow);
    if let Err(mut e) = r {
        e.rule_stack.push("keyword");
        return Result::<KeywordNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_macro_identifier_like_token__inner_bt_1(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<MacroIdentifierLikeTokenNode, ParseError> {
    let start = p.peek().span.start;
    let identifier = _parse_identifier(p, follow)?;
    return Result::<MacroIdentifierLikeTokenNode, ParseError>::Ok(MacroIdentifierLikeTokenNode::Alt1(MacroIdentifierLikeTokenAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        identifier,
    }));
}

fn _parse_macro_identifier_like_token__inner_scan_1(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_identifier(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn _parse_macro_identifier_like_token__inner_bt_2(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<MacroIdentifierLikeTokenNode, ParseError> {
    let start = p.peek().span.start;
    let kw_macrorules = p.expect(TK_KW_MACRORULES)?;
    return Result::<MacroIdentifierLikeTokenNode, ParseError>::Ok(MacroIdentifierLikeTokenNode::Alt2(MacroIdentifierLikeTokenAlt2 {
        span: Span::new(start, i32::max(start, p.last_end())),
        kw_macrorules,
    }));
}

fn _parse_macro_identifier_like_token__inner_scan_2(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_KW_MACRORULES { return -1; }
    pos += 1;
    return pos;
}

fn _parse_macro_identifier_like_token__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<MacroIdentifierLikeTokenNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if _gale_kind_set_109(kind) {
        let keyword = _parse_keyword(p, follow)?;
        return Result::<MacroIdentifierLikeTokenNode, ParseError>::Ok(MacroIdentifierLikeTokenNode::Alt0(MacroIdentifierLikeTokenAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            keyword,
        }));
    }
    if _gale_kind_set_4(kind) {
        if p.peek_kind() == TK_KW_MACRORULES {
            let _sd_tokens = &p.tokens;
            let _sd_pos = p.pos;
            let _sd_p_1 = _parse_macro_identifier_like_token__inner_scan_1(_sd_tokens, _sd_pos);
            let _sd_p_2 = _parse_macro_identifier_like_token__inner_scan_2(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_p_2 > _sd_best_p {
                _sd_best_p = _sd_p_2;
                _sd_best_i = 2;
            }
            if _sd_best_i == 1 {
                return _parse_macro_identifier_like_token__inner_bt_1(p, follow);
            }
            if _sd_best_i == 2 {
                return _parse_macro_identifier_like_token__inner_bt_2(p, follow);
            }
            return _parse_macro_identifier_like_token__inner_bt_2(p, follow);
        } else if _gale_kind_set_110(p.peek_kind()) {
            return _parse_macro_identifier_like_token__inner_bt_1(p, follow);
        }
    }
    if kind == TK_KW_UNDERLINELIFETIME {
        let kw_underlinelifetime = p.expect(TK_KW_UNDERLINELIFETIME)?;
        return Result::<MacroIdentifierLikeTokenNode, ParseError>::Ok(MacroIdentifierLikeTokenNode::Alt3(MacroIdentifierLikeTokenAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            kw_underlinelifetime,
        }));
    }
    if kind == TK_KW_DOLLARCRATE {
        let kw_dollarcrate = p.expect(TK_KW_DOLLARCRATE)?;
        return Result::<MacroIdentifierLikeTokenNode, ParseError>::Ok(MacroIdentifierLikeTokenNode::Alt4(MacroIdentifierLikeTokenAlt4 {
            span: Span::new(start, i32::max(start, p.last_end())),
            kw_dollarcrate,
        }));
    }
    if kind == TK_LIFETIME_OR_LABEL {
        let lifetime_or_label = p.expect(TK_LIFETIME_OR_LABEL)?;
        return Result::<MacroIdentifierLikeTokenNode, ParseError>::Ok(MacroIdentifierLikeTokenNode::Alt5(MacroIdentifierLikeTokenAlt5 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lifetime_or_label,
        }));
    }
    return Result::<MacroIdentifierLikeTokenNode, ParseError>::Err(p.error(
        "expected macroIdentifierLikeToken",
        p.peek().span,
