        let async_block_expression = _parse_async_block_expression(p, follow)?;
        return Result::<ExpressionWithBlockNode, ParseError>::Ok(ExpressionWithBlockNode::Alt2(ExpressionWithBlockAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            async_block_expression,
        }));
