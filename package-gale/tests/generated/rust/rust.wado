pub fn walk_typePath<V: Visitor>(v: &mut V, node: &TypePathNode) {
    v.enter_rule(184, &"typePath", &node.span);
    if let Some(item) = &node.pathsep {
        v.visit_token(item);
    }
    walk_typePathSegment(v, &node.type_path_segment);
    for let item of &node.pathsep_type_path_segment_list {
        v.visit_token(&item.pathsep);
        walk_typePathSegment(v, &item.type_path_segment);
    }
    v.exit_rule(184, &"typePath", &node.span);
}

pub fn walk_typePathSegment<V: Visitor>(v: &mut V, node: &TypePathSegmentNode) {
    v.enter_rule(185, &"typePathSegment", &node.span);
    walk_pathIdentSegment(v, &node.path_ident_segment);
    if let Some(item) = &node.pathsep {
        v.visit_token(item);
    }
    if let Some(item) = &node.generic_args_or_type_path_fn {
        match item {
            GenericArgs(inner) => {
                walk_genericArgs(v, inner);
            }
            TypePathFn(inner) => {
                walk_typePathFn(v, inner);
            }
        }
    }
    v.exit_rule(185, &"typePathSegment", &node.span);
}

pub fn walk_typePathFn<V: Visitor>(v: &mut V, node: &TypePathFnNode) {
    v.enter_rule(186, &"typePathFn", &node.span);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.type_path_inputs {
        walk_typePathInputs(v, item);
    }
    v.visit_token(&node.rparen);
    if let Some(item) = &node.rarrow_type_ {
        v.visit_token(&item.rarrow);
        walk_type_(v, &item.type_);
    }
    v.exit_rule(186, &"typePathFn", &node.span);
}

pub fn walk_typePathInputs<V: Visitor>(v: &mut V, node: &TypePathInputsNode) {
    v.enter_rule(187, &"typePathInputs", &node.span);
    walk_type_(v, &node.type_);
    for let item of &node.comma_type__list {
        v.visit_token(&item.comma);
        walk_type_(v, &item.type_);
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(187, &"typePathInputs", &node.span);
}

pub fn walk_visibility<V: Visitor>(v: &mut V, node: &VisibilityNode) {
    v.enter_rule(188, &"visibility", &node.span);
    v.visit_token(&node.kw_pub);
    if let Some(item) = &node.lparen_item_rparen {
        v.visit_token(&item.lparen);
        if let Some(item) = &item.group_0 {
            match item {
                Alt0(inner) => {
                    v.visit_token(&inner.kw_crate);
                }
                Alt1(inner) => {
                    v.visit_token(&inner.kw_selfvalue);
                }
                Alt2(inner) => {
                    v.visit_token(&inner.kw_super);
                }
                Alt3(inner) => {
                    v.visit_token(&inner.kw_in);
                    walk_simplePath(v, &inner.simple_path);
                }
            }
        }
        v.visit_token(&item.rparen);
    }
    v.exit_rule(188, &"visibility", &node.span);
}

