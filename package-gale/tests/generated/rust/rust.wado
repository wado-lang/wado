pub fn walk_simplePath<V: Visitor>(v: &mut V, node: &SimplePathNode) {
    v.enter_rule(169, &"simplePath", &node.span);
    if let Some(item) = &node.pathsep {
        v.visit_token(item);
    }
    walk_simplePathSegment(v, &node.simple_path_segment);
    for let item of &node.pathsep_simple_path_segment_list {
