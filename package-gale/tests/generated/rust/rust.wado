pub fn walk_macroRepSep<V: Visitor>(v: &mut V, node: &MacroRepSepNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(14, &"macroRepSep", &n.span);
            walk_macroIdentifierLikeToken(v, &n.macro_identifier_like_token);
            v.exit_rule(14, &"macroRepSep", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(14, &"macroRepSep", &n.span);
            walk_macroLiteralToken(v, &n.macro_literal_token);
            v.exit_rule(14, &"macroRepSep", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(14, &"macroRepSep", &n.span);
            walk_macroPunctuationToken(v, &n.macro_punctuation_token);
            v.exit_rule(14, &"macroRepSep", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(14, &"macroRepSep", &n.span);
            v.visit_token(&n.dollar);
            v.exit_rule(14, &"macroRepSep", &n.span);
        }
    }
}

pub fn walk_macroRepOp<V: Visitor>(v: &mut V, node: &MacroRepOpNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(15, &"macroRepOp", &n.span);
            v.visit_token(&n.star);
            v.exit_rule(15, &"macroRepOp", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(15, &"macroRepOp", &n.span);
            v.visit_token(&n.plus);
            v.exit_rule(15, &"macroRepOp", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(15, &"macroRepOp", &n.span);
            v.visit_token(&n.question);
            v.exit_rule(15, &"macroRepOp", &n.span);
        }
    }
}

pub fn walk_macroTranscriber<V: Visitor>(v: &mut V, node: &MacroTranscriberNode) {
    v.enter_rule(16, &"macroTranscriber", &node.span);
    walk_delimTokenTree(v, &node.delim_token_tree);
    v.exit_rule(16, &"macroTranscriber", &node.span);
}

pub fn walk_item<V: Visitor>(v: &mut V, node: &ItemNode) {
    v.enter_rule(17, &"item", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.vis_item_or_macro_item {
        match item {
            VisItem(inner) => {
                walk_visItem(v, inner);
            }
            MacroItem(inner) => {
                walk_macroItem(v, inner);
            }
        }
    }
    v.exit_rule(17, &"item", &node.span);
}

pub fn walk_visItem<V: Visitor>(v: &mut V, node: &VisItemNode) {
    v.enter_rule(18, &"visItem", &node.span);
    if let Some(item) = &node.visibility {
        walk_visibility(v, item);
    }
    if let Some(item) = &node.module_or_extern_crate_or_use_declaration_or_function__or_type_alias_or_struct__or_enumeration_or_union__or_constant_item_or_static_item_or_trait__or_implementation_or_extern_block {
        match item {
            Module(inner) => {
                walk_module(v, inner);
            }
            ExternCrate(inner) => {
                walk_externCrate(v, inner);
            }
            UseDeclaration(inner) => {
                walk_useDeclaration(v, inner);
            }
            Function(inner) => {
                walk_function_(v, inner);
            }
            TypeAlias(inner) => {
                walk_typeAlias(v, inner);
            }
            Struct(inner) => {
                walk_struct_(v, inner);
            }
            Enumeration(inner) => {
                walk_enumeration(v, inner);
            }
            Union(inner) => {
                walk_union_(v, inner);
            }
            ConstantItem(inner) => {
                walk_constantItem(v, inner);
            }
            StaticItem(inner) => {
                walk_staticItem(v, inner);
            }
            Trait(inner) => {
                walk_trait_(v, inner);
            }
            Implementation(inner) => {
                walk_implementation(v, inner);
            }
            ExternBlock(inner) => {
                walk_externBlock(v, inner);
            }
        }
    }
    v.exit_rule(18, &"visItem", &node.span);
}

pub fn walk_macroItem<V: Visitor>(v: &mut V, node: &MacroItemNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(19, &"macroItem", &n.span);
            walk_macroInvocationSemi(v, &n.macro_invocation_semi);
            v.exit_rule(19, &"macroItem", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(19, &"macroItem", &n.span);
            walk_macroRulesDefinition(v, &n.macro_rules_definition);
            v.exit_rule(19, &"macroItem", &n.span);
        }
    }
}

pub fn walk_module<V: Visitor>(v: &mut V, node: &ModuleNode) {
    v.enter_rule(20, &"module", &node.span);
    if let Some(item) = &node.kw_unsafe {
        v.visit_token(item);
    }
    v.visit_token(&node.kw_mod);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.semi);
            }
            Alt1(inner) => {
                v.visit_token(&inner.lcurlybrace);
                for let item of &inner.inner_attribute_list {
                    walk_innerAttribute(v, item);
                }
                for let item of &inner.item_list {
                    walk_item(v, item);
                }
                v.visit_token(&inner.rcurlybrace);
            }
        }
    }
    v.exit_rule(20, &"module", &node.span);
}

pub fn walk_externCrate<V: Visitor>(v: &mut V, node: &ExternCrateNode) {
    v.enter_rule(21, &"externCrate", &node.span);
    v.visit_token(&node.kw_extern);
    v.visit_token(&node.kw_crate);
    walk_crateRef(v, &node.crate_ref);
    if let Some(item) = &node.as_clause {
        walk_asClause(v, item);
    }
    v.visit_token(&node.semi);
    v.exit_rule(21, &"externCrate", &node.span);
}

pub fn walk_crateRef<V: Visitor>(v: &mut V, node: &CrateRefNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(22, &"crateRef", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(22, &"crateRef", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(22, &"crateRef", &n.span);
            v.visit_token(&n.kw_selfvalue);
            v.exit_rule(22, &"crateRef", &n.span);
        }
    }
}

pub fn walk_asClause<V: Visitor>(v: &mut V, node: &AsClauseNode) {
    v.enter_rule(23, &"asClause", &node.span);
    v.visit_token(&node.kw_as);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_identifier(v, &inner.identifier);
            }
            Alt1(inner) => {
                v.visit_token(&inner.underscore);
            }
        }
    }
    v.exit_rule(23, &"asClause", &node.span);
}

pub fn walk_useDeclaration<V: Visitor>(v: &mut V, node: &UseDeclarationNode) {
    v.enter_rule(24, &"useDeclaration", &node.span);
    v.visit_token(&node.kw_use);
    walk_useTree(v, &node.use_tree);
    v.visit_token(&node.semi);
    v.exit_rule(24, &"useDeclaration", &node.span);
}

pub fn walk_useTree<V: Visitor>(v: &mut V, node: &UseTreeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(25, &"useTree", &n.span);
            if let Some(item) = &n.simple_path_pathsep {
                if let Some(item) = &item.simple_path {
                    walk_simplePath(v, item);
                }
                v.visit_token(&item.pathsep);
            }
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.star);
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.lcurlybrace);
                        if let Some(item) = &inner.use_tree_item_comma {
                            walk_useTree(v, &item.use_tree);
                            for let item of &item.comma_use_tree_list {
                                v.visit_token(&item.comma);
                                walk_useTree(v, &item.use_tree);
                            }
                            if let Some(item) = &item.comma {
                                v.visit_token(item);
                            }
                        }
                        v.visit_token(&inner.rcurlybrace);
                    }
                }
            }
            v.exit_rule(25, &"useTree", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(25, &"useTree", &n.span);
            walk_simplePath(v, &n.simple_path);
            if let Some(item) = &n.kw_as_item {
                v.visit_token(&item.kw_as);
                if let Some(item) = &item.group_1 {
                    match item {
                        Alt0(inner) => {
                            walk_identifier(v, &inner.identifier);
                        }
                        Alt1(inner) => {
                            v.visit_token(&inner.underscore);
                        }
                    }
                }
            }
            v.exit_rule(25, &"useTree", &n.span);
        }
    }
}

pub fn walk_function_<V: Visitor>(v: &mut V, node: &FunctionNode) {
    v.enter_rule(26, &"function_", &node.span);
    walk_functionQualifiers(v, &node.function_qualifiers);
    v.visit_token(&node.kw_fn);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.generic_params {
        walk_genericParams(v, item);
    }
    v.visit_token(&node.lparen);
    if let Some(item) = &node.function_parameters {
        walk_functionParameters(v, item);
    }
    v.visit_token(&node.rparen);
    if let Some(item) = &node.function_return_type {
        walk_functionReturnType(v, item);
    }
    if let Some(item) = &node.where_clause {
        walk_whereClause(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_blockExpression(v, &inner.block_expression);
            }
            Alt1(inner) => {
                v.visit_token(&inner.semi);
            }
        }
    }
    v.exit_rule(26, &"function_", &node.span);
}

pub fn walk_functionQualifiers<V: Visitor>(v: &mut V, node: &FunctionQualifiersNode) {
    v.enter_rule(27, &"functionQualifiers", &node.span);
    if let Some(item) = &node.kw_const {
        v.visit_token(item);
    }
    if let Some(item) = &node.kw_async {
        v.visit_token(item);
    }
    if let Some(item) = &node.kw_unsafe {
        v.visit_token(item);
    }
    if let Some(item) = &node.kw_extern_abi {
        v.visit_token(&item.kw_extern);
        if let Some(item) = &item.abi {
            walk_abi(v, item);
        }
    }
    v.exit_rule(27, &"functionQualifiers", &node.span);
}

pub fn walk_abi<V: Visitor>(v: &mut V, node: &AbiNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(28, &"abi", &n.span);
            v.visit_token(&n.string_literal);
            v.exit_rule(28, &"abi", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(28, &"abi", &n.span);
            v.visit_token(&n.raw_string_literal);
            v.exit_rule(28, &"abi", &n.span);
        }
    }
}

pub fn walk_functionParameters<V: Visitor>(v: &mut V, node: &FunctionParametersNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(29, &"functionParameters", &n.span);
            walk_selfParam(v, &n.self_param);
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.exit_rule(29, &"functionParameters", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(29, &"functionParameters", &n.span);
            if let Some(item) = &n.self_param_comma {
                walk_selfParam(v, &item.self_param);
                v.visit_token(&item.comma);
            }
            walk_functionParam(v, &n.function_param);
            for let item of &n.comma_function_param_list {
                v.visit_token(&item.comma);
                walk_functionParam(v, &item.function_param);
            }
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.exit_rule(29, &"functionParameters", &n.span);
        }
    }
}

pub fn walk_selfParam<V: Visitor>(v: &mut V, node: &SelfParamNode) {
    v.enter_rule(30, &"selfParam", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.shorthand_self_or_typed_self {
        match item {
            ShorthandSelf(inner) => {
                walk_shorthandSelf(v, inner);
            }
            TypedSelf(inner) => {
                walk_typedSelf(v, inner);
            }
        }
    }
    v.exit_rule(30, &"selfParam", &node.span);
}

pub fn walk_shorthandSelf<V: Visitor>(v: &mut V, node: &ShorthandSelfNode) {
    v.enter_rule(31, &"shorthandSelf", &node.span);
    if let Some(item) = &node.and_lifetime {
        v.visit_token(&item.and);
        if let Some(item) = &item.lifetime {
            walk_lifetime(v, item);
        }
    }
    if let Some(item) = &node.kw_mut {
        v.visit_token(item);
    }
    v.visit_token(&node.kw_selfvalue);
    v.exit_rule(31, &"shorthandSelf", &node.span);
}

pub fn walk_typedSelf<V: Visitor>(v: &mut V, node: &TypedSelfNode) {
    v.enter_rule(32, &"typedSelf", &node.span);
    if let Some(item) = &node.kw_mut {
        v.visit_token(item);
    }
    v.visit_token(&node.kw_selfvalue);
    v.visit_token(&node.colon);
    walk_type_(v, &node.type_);
    v.exit_rule(32, &"typedSelf", &node.span);
}

pub fn walk_functionParam<V: Visitor>(v: &mut V, node: &FunctionParamNode) {
    v.enter_rule(33, &"functionParam", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_functionParamPattern(v, &inner.function_param_pattern);
            }
            Alt1(inner) => {
                v.visit_token(&inner.dotdotdot);
            }
            Alt2(inner) => {
                walk_type_(v, &inner.type_);
            }
        }
    }
    v.exit_rule(33, &"functionParam", &node.span);
}

pub fn walk_functionParamPattern<V: Visitor>(v: &mut V, node: &FunctionParamPatternNode) {
    v.enter_rule(34, &"functionParamPattern", &node.span);
    walk_pattern(v, &node.pattern);
    v.visit_token(&node.colon);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_type_(v, &inner.type_);
            }
            Alt1(inner) => {
                v.visit_token(&inner.dotdotdot);
            }
        }
    }
    v.exit_rule(34, &"functionParamPattern", &node.span);
}

pub fn walk_functionReturnType<V: Visitor>(v: &mut V, node: &FunctionReturnTypeNode) {
    v.enter_rule(35, &"functionReturnType", &node.span);
    v.visit_token(&node.rarrow);
    walk_type_(v, &node.type_);
    v.exit_rule(35, &"functionReturnType", &node.span);
}

pub fn walk_typeAlias<V: Visitor>(v: &mut V, node: &TypeAliasNode) {
    v.enter_rule(36, &"typeAlias", &node.span);
    v.visit_token(&node.kw_type);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.generic_params {
        walk_genericParams(v, item);
    }
    if let Some(item) = &node.where_clause {
        walk_whereClause(v, item);
    }
    if let Some(item) = &node.eq_type_ {
        v.visit_token(&item.eq);
        walk_type_(v, &item.type_);
    }
    v.visit_token(&node.semi);
    v.exit_rule(36, &"typeAlias", &node.span);
}

pub fn walk_struct_<V: Visitor>(v: &mut V, node: &StructNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(37, &"struct_", &n.span);
            walk_structStruct(v, &n.struct_struct);
            v.exit_rule(37, &"struct_", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(37, &"struct_", &n.span);
            walk_tupleStruct(v, &n.tuple_struct);
            v.exit_rule(37, &"struct_", &n.span);
        }
    }
}

pub fn walk_structStruct<V: Visitor>(v: &mut V, node: &StructStructNode) {
    v.enter_rule(38, &"structStruct", &node.span);
    v.visit_token(&node.kw_struct);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.generic_params {
