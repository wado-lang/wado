    v.enter_rule(151, &"rawPointerType", &node.span);
    v.visit_token(&node.star);
    v.visit_token(&node.kw_mut_or_kw_const);
    walk_typeNoBounds(v, &node.type_no_bounds);
    v.exit_rule(151, &"rawPointerType", &node.span);
}

pub fn walk_bareFunctionType<V: Visitor>(v: &mut V, node: &BareFunctionTypeNode) {
    v.enter_rule(152, &"bareFunctionType", &node.span);
    if let Some(item) = &node.for_lifetimes {
        walk_forLifetimes(v, item);
    }
    walk_functionTypeQualifiers(v, &node.function_type_qualifiers);
    v.visit_token(&node.kw_fn);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.function_parameters_maybe_named_variadic {
        walk_functionParametersMaybeNamedVariadic(v, item);
    }
    v.visit_token(&node.rparen);
    if let Some(item) = &node.bare_function_return_type {
        walk_bareFunctionReturnType(v, item);
    }
    v.exit_rule(152, &"bareFunctionType", &node.span);
}

pub fn walk_functionTypeQualifiers<V: Visitor>(v: &mut V, node: &FunctionTypeQualifiersNode) {
    v.enter_rule(153, &"functionTypeQualifiers", &node.span);
    if let Some(item) = &node.kw_unsafe {
        v.visit_token(item);
    }
    if let Some(item) = &node.kw_extern_abi {
        v.visit_token(&item.kw_extern);
        if let Some(item) = &item.abi {
            walk_abi(v, item);
        }
    }
    v.exit_rule(153, &"functionTypeQualifiers", &node.span);
}

