pub fn walk_enumExprFields<V: Visitor>(v: &mut V, node: &EnumExprFieldsNode) {
    v.enter_rule(99, &"enumExprFields", &node.span);
    walk_enumExprField(v, &node.enum_expr_field);
    for let item of &node.comma_enum_expr_field_list {
        v.visit_token(&item.comma);
        walk_enumExprField(v, &item.enum_expr_field);
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(99, &"enumExprFields", &node.span);
}

pub fn walk_enumExprField<V: Visitor>(v: &mut V, node: &EnumExprFieldNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(100, &"enumExprField", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(100, &"enumExprField", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(100, &"enumExprField", &n.span);
            if let Some(item) = &n.identifier_or_tuple_index {
                match item {
                    Identifier(inner) => {
                        walk_identifier(v, inner);
                    }
                    TupleIndex(inner) => {
                        walk_tupleIndex(v, inner);
                    }
                }
            }
            v.visit_token(&n.colon);
            walk_expression(v, &n.expression);
            v.exit_rule(100, &"enumExprField", &n.span);
        }
    }
}

pub fn walk_enumExprTuple<V: Visitor>(v: &mut V, node: &EnumExprTupleNode) {
    v.enter_rule(101, &"enumExprTuple", &node.span);
    walk_pathInExpression(v, &node.path_in_expression);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.expression_item_comma {
        walk_expression(v, &item.expression);
        for let item of &item.comma_expression_list {
            v.visit_token(&item.comma);
            walk_expression(v, &item.expression);
        }
        if let Some(item) = &item.comma {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.rparen);
    v.exit_rule(101, &"enumExprTuple", &node.span);
}

pub fn walk_enumExprFieldless<V: Visitor>(v: &mut V, node: &EnumExprFieldlessNode) {
    v.enter_rule(102, &"enumExprFieldless", &node.span);
    walk_pathInExpression(v, &node.path_in_expression);
    v.exit_rule(102, &"enumExprFieldless", &node.span);
}

pub fn walk_callParams<V: Visitor>(v: &mut V, node: &CallParamsNode) {
    v.enter_rule(103, &"callParams", &node.span);
    walk_expression(v, &node.expression);
    for let item of &node.comma_expression_list {
        v.visit_token(&item.comma);
        walk_expression(v, &item.expression);
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(103, &"callParams", &node.span);
}

pub fn walk_closureExpression<V: Visitor>(v: &mut V, node: &ClosureExpressionNode) {
    v.enter_rule(104, &"closureExpression", &node.span);
    if let Some(item) = &node.kw_move {
        v.visit_token(item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.oror);
            }
            Alt1(inner) => {
                v.visit_token(&inner.or);
                if let Some(item) = &inner.closure_parameters {
                    walk_closureParameters(v, item);
                }
                v.visit_token(&inner.or_2);
            }
        }
    }
    if let Some(item) = &node.group_1 {
        match item {
            Alt0(inner) => {
                walk_expression(v, &inner.expression);
            }
            Alt1(inner) => {
                v.visit_token(&inner.rarrow);
                walk_typeNoBounds(v, &inner.type_no_bounds);
                walk_blockExpression(v, &inner.block_expression);
            }
        }
    }
    v.exit_rule(104, &"closureExpression", &node.span);
}

pub fn walk_closureParameters<V: Visitor>(v: &mut V, node: &ClosureParametersNode) {
    v.enter_rule(105, &"closureParameters", &node.span);
    walk_closureParam(v, &node.closure_param);
    for let item of &node.comma_closure_param_list {
        v.visit_token(&item.comma);
        walk_closureParam(v, &item.closure_param);
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(105, &"closureParameters", &node.span);
}

pub fn walk_closureParam<V: Visitor>(v: &mut V, node: &ClosureParamNode) {
    v.enter_rule(106, &"closureParam", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    walk_pattern(v, &node.pattern);
    if let Some(item) = &node.colon_type_ {
        v.visit_token(&item.colon);
        walk_type_(v, &item.type_);
    }
    v.exit_rule(106, &"closureParam", &node.span);
}

pub fn walk_loopExpression<V: Visitor>(v: &mut V, node: &LoopExpressionNode) {
    v.enter_rule(107, &"loopExpression", &node.span);
    if let Some(item) = &node.loop_label {
        walk_loopLabel(v, item);
    }
    if let Some(item) = &node.infinite_loop_expression_or_predicate_loop_expression_or_predicate_pattern_loop_expression_or_iterator_loop_expression {
        match item {
            InfiniteLoopExpression(inner) => {
                walk_infiniteLoopExpression(v, inner);
            }
            PredicateLoopExpression(inner) => {
                walk_predicateLoopExpression(v, inner);
            }
            PredicatePatternLoopExpression(inner) => {
                walk_predicatePatternLoopExpression(v, inner);
            }
            IteratorLoopExpression(inner) => {
                walk_iteratorLoopExpression(v, inner);
            }
        }
    }
    v.exit_rule(107, &"loopExpression", &node.span);
}

pub fn walk_infiniteLoopExpression<V: Visitor>(v: &mut V, node: &InfiniteLoopExpressionNode) {
    v.enter_rule(108, &"infiniteLoopExpression", &node.span);
    v.visit_token(&node.kw_loop);
    walk_blockExpression(v, &node.block_expression);
    v.exit_rule(108, &"infiniteLoopExpression", &node.span);
}

pub fn walk_predicateLoopExpression<V: Visitor>(v: &mut V, node: &PredicateLoopExpressionNode) {
    v.enter_rule(109, &"predicateLoopExpression", &node.span);
    v.visit_token(&node.kw_while);
    walk_expression(v, &node.expression);
    walk_blockExpression(v, &node.block_expression);
    v.exit_rule(109, &"predicateLoopExpression", &node.span);
}

pub fn walk_predicatePatternLoopExpression<V: Visitor>(v: &mut V, node: &PredicatePatternLoopExpressionNode) {
    v.enter_rule(110, &"predicatePatternLoopExpression", &node.span);
    v.visit_token(&node.kw_while);
    v.visit_token(&node.kw_let);
    walk_pattern(v, &node.pattern);
    v.visit_token(&node.eq);
    walk_expression(v, &node.expression);
    walk_blockExpression(v, &node.block_expression);
    v.exit_rule(110, &"predicatePatternLoopExpression", &node.span);
}

pub fn walk_iteratorLoopExpression<V: Visitor>(v: &mut V, node: &IteratorLoopExpressionNode) {
    v.enter_rule(111, &"iteratorLoopExpression", &node.span);
    v.visit_token(&node.kw_for);
    walk_pattern(v, &node.pattern);
    v.visit_token(&node.kw_in);
    walk_expression(v, &node.expression);
    walk_blockExpression(v, &node.block_expression);
    v.exit_rule(111, &"iteratorLoopExpression", &node.span);
}

pub fn walk_loopLabel<V: Visitor>(v: &mut V, node: &LoopLabelNode) {
    v.enter_rule(112, &"loopLabel", &node.span);
    v.visit_token(&node.lifetime_or_label);
    v.visit_token(&node.colon);
    v.exit_rule(112, &"loopLabel", &node.span);
}

pub fn walk_ifExpression<V: Visitor>(v: &mut V, node: &IfExpressionNode) {
    v.enter_rule(113, &"ifExpression", &node.span);
    v.visit_token(&node.kw_if);
    walk_expression(v, &node.expression);
    walk_blockExpression(v, &node.block_expression);
    if let Some(item) = &node.kw_else_item {
        v.visit_token(&item.kw_else);
        if let Some(item) = &item.block_expression_or_if_expression_or_if_let_expression {
            match item {
                BlockExpression(inner) => {
                    walk_blockExpression(v, inner);
                }
                IfExpression(inner) => {
                    walk_ifExpression(v, inner);
                }
                IfLetExpression(inner) => {
                    walk_ifLetExpression(v, inner);
                }
            }
        }
    }
    v.exit_rule(113, &"ifExpression", &node.span);
}

pub fn walk_ifLetExpression<V: Visitor>(v: &mut V, node: &IfLetExpressionNode) {
    v.enter_rule(114, &"ifLetExpression", &node.span);
    v.visit_token(&node.kw_if);
    v.visit_token(&node.kw_let);
    walk_pattern(v, &node.pattern);
    v.visit_token(&node.eq);
    walk_expression(v, &node.expression);
    walk_blockExpression(v, &node.block_expression);
    if let Some(item) = &node.kw_else_item {
        v.visit_token(&item.kw_else);
        if let Some(item) = &item.block_expression_or_if_expression_or_if_let_expression {
            match item {
                BlockExpression(inner) => {
                    walk_blockExpression(v, inner);
                }
                IfExpression(inner) => {
                    walk_ifExpression(v, inner);
                }
                IfLetExpression(inner) => {
                    walk_ifLetExpression(v, inner);
                }
            }
        }
    }
    v.exit_rule(114, &"ifLetExpression", &node.span);
}

pub fn walk_matchExpression<V: Visitor>(v: &mut V, node: &MatchExpressionNode) {
    v.enter_rule(115, &"matchExpression", &node.span);
    v.visit_token(&node.kw_match);
    walk_expression(v, &node.expression);
    v.visit_token(&node.lcurlybrace);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    if let Some(item) = &node.match_arms {
        walk_matchArms(v, item);
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(115, &"matchExpression", &node.span);
}

pub fn walk_matchArms<V: Visitor>(v: &mut V, node: &MatchArmsNode) {
    v.enter_rule(116, &"matchArms", &node.span);
    for let item of &node.match_arm_fatarrow_match_arm_expression_list {
        walk_matchArm(v, &item.match_arm);
        v.visit_token(&item.fatarrow);
        walk_matchArmExpression(v, &item.match_arm_expression);
    }
    walk_matchArm(v, &node.match_arm);
    v.visit_token(&node.fatarrow);
    walk_expression(v, &node.expression);
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(116, &"matchArms", &node.span);
}

pub fn walk_matchArmExpression<V: Visitor>(v: &mut V, node: &MatchArmExpressionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(117, &"matchArmExpression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.comma);
            v.exit_rule(117, &"matchArmExpression", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(117, &"matchArmExpression", &n.span);
            walk_expressionWithBlock(v, &n.expression_with_block);
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.exit_rule(117, &"matchArmExpression", &n.span);
        }
    }
}

pub fn walk_matchArm<V: Visitor>(v: &mut V, node: &MatchArmNode) {
    v.enter_rule(118, &"matchArm", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    walk_pattern(v, &node.pattern);
    if let Some(item) = &node.match_arm_guard {
        walk_matchArmGuard(v, item);
    }
    v.exit_rule(118, &"matchArm", &node.span);
}

pub fn walk_matchArmGuard<V: Visitor>(v: &mut V, node: &MatchArmGuardNode) {
    v.enter_rule(119, &"matchArmGuard", &node.span);
    v.visit_token(&node.kw_if);
    walk_expression(v, &node.expression);
    v.exit_rule(119, &"matchArmGuard", &node.span);
}

pub fn walk_pattern<V: Visitor>(v: &mut V, node: &PatternNode) {
    v.enter_rule(120, &"pattern", &node.span);
    if let Some(item) = &node.or {
        v.visit_token(item);
    }
    walk_patternNoTopAlt(v, &node.pattern_no_top_alt);
    for let item of &node.or_pattern_no_top_alt_list {
        v.visit_token(&item.or);
        walk_patternNoTopAlt(v, &item.pattern_no_top_alt);
    }
    v.exit_rule(120, &"pattern", &node.span);
}

pub fn walk_patternNoTopAlt<V: Visitor>(v: &mut V, node: &PatternNoTopAltNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(121, &"patternNoTopAlt", &n.span);
            walk_patternWithoutRange(v, &n.pattern_without_range);
            v.exit_rule(121, &"patternNoTopAlt", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(121, &"patternNoTopAlt", &n.span);
            walk_rangePattern(v, &n.range_pattern);
            v.exit_rule(121, &"patternNoTopAlt", &n.span);
        }
    }
}

pub fn walk_patternWithoutRange<V: Visitor>(v: &mut V, node: &PatternWithoutRangeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_literalPattern(v, &n.literal_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_identifierPattern(v, &n.identifier_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_wildcardPattern(v, &n.wildcard_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_restPattern(v, &n.rest_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_referencePattern(v, &n.reference_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_structPattern(v, &n.struct_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_tupleStructPattern(v, &n.tuple_struct_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_tuplePattern(v, &n.tuple_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_groupedPattern(v, &n.grouped_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_slicePattern(v, &n.slice_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_pathPattern(v, &n.path_pattern);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(122, &"patternWithoutRange", &n.span);
            walk_macroInvocation(v, &n.macro_invocation);
            v.exit_rule(122, &"patternWithoutRange", &n.span);
        }
    }
}

pub fn walk_literalPattern<V: Visitor>(v: &mut V, node: &LiteralPatternNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.kw_true);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.kw_false);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.char_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.byte_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.string_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.raw_string_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.byte_string_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            v.visit_token(&n.raw_byte_string_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            if let Some(item) = &n.minus {
                v.visit_token(item);
            }
            v.visit_token(&n.integer_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(123, &"literalPattern", &n.span);
            if let Some(item) = &n.minus {
                v.visit_token(item);
            }
            v.visit_token(&n.float_literal);
            v.exit_rule(123, &"literalPattern", &n.span);
        }
    }
}

pub fn walk_identifierPattern<V: Visitor>(v: &mut V, node: &IdentifierPatternNode) {
    v.enter_rule(124, &"identifierPattern", &node.span);
    if let Some(item) = &node.kw_ref {
        v.visit_token(item);
    }
    if let Some(item) = &node.kw_mut {
        v.visit_token(item);
    }
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.at_pattern {
        v.visit_token(&item.at);
        walk_pattern(v, &item.pattern);
    }
    v.exit_rule(124, &"identifierPattern", &node.span);
}

pub fn walk_wildcardPattern<V: Visitor>(v: &mut V, node: &WildcardPatternNode) {
    v.enter_rule(125, &"wildcardPattern", &node.span);
    v.visit_token(&node.underscore);
    v.exit_rule(125, &"wildcardPattern", &node.span);
}

pub fn walk_restPattern<V: Visitor>(v: &mut V, node: &RestPatternNode) {
    v.enter_rule(126, &"restPattern", &node.span);
    v.visit_token(&node.dotdot);
    v.exit_rule(126, &"restPattern", &node.span);
}

pub fn walk_rangePattern<V: Visitor>(v: &mut V, node: &RangePatternNode) {
    match node {
        InclusiveRangePattern(n) => {
            v.enter_rule(127, &"rangePattern", &n.span);
            walk_rangePatternBound(v, &n.range_pattern_bound);
            v.visit_token(&n.dotdoteq);
            walk_rangePatternBound(v, &n.range_pattern_bound_2);
            v.exit_rule(127, &"rangePattern", &n.span);
        }
        HalfOpenRangePattern(n) => {
            v.enter_rule(127, &"rangePattern", &n.span);
            walk_rangePatternBound(v, &n.range_pattern_bound);
            v.visit_token(&n.dotdot);
            v.exit_rule(127, &"rangePattern", &n.span);
        }
        ObsoleteRangePattern(n) => {
            v.enter_rule(127, &"rangePattern", &n.span);
            walk_rangePatternBound(v, &n.range_pattern_bound);
            v.visit_token(&n.dotdotdot);
            walk_rangePatternBound(v, &n.range_pattern_bound_2);
            v.exit_rule(127, &"rangePattern", &n.span);
        }
    }
}

pub fn walk_rangePatternBound<V: Visitor>(v: &mut V, node: &RangePatternBoundNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(128, &"rangePatternBound", &n.span);
            v.visit_token(&n.char_literal);
            v.exit_rule(128, &"rangePatternBound", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(128, &"rangePatternBound", &n.span);
            v.visit_token(&n.byte_literal);
            v.exit_rule(128, &"rangePatternBound", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(128, &"rangePatternBound", &n.span);
            if let Some(item) = &n.minus {
                v.visit_token(item);
            }
            v.visit_token(&n.integer_literal);
            v.exit_rule(128, &"rangePatternBound", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(128, &"rangePatternBound", &n.span);
            if let Some(item) = &n.minus {
                v.visit_token(item);
            }
            v.visit_token(&n.float_literal);
            v.exit_rule(128, &"rangePatternBound", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(128, &"rangePatternBound", &n.span);
            walk_pathPattern(v, &n.path_pattern);
            v.exit_rule(128, &"rangePatternBound", &n.span);
        }
    }
}

pub fn walk_referencePattern<V: Visitor>(v: &mut V, node: &ReferencePatternNode) {
    v.enter_rule(129, &"referencePattern", &node.span);
    v.visit_token(&node.and_or_andand);
    if let Some(item) = &node.kw_mut {
        v.visit_token(item);
    }
    walk_patternWithoutRange(v, &node.pattern_without_range);
    v.exit_rule(129, &"referencePattern", &node.span);
}

pub fn walk_structPattern<V: Visitor>(v: &mut V, node: &StructPatternNode) {
    v.enter_rule(130, &"structPattern", &node.span);
    walk_pathInExpression(v, &node.path_in_expression);
    v.visit_token(&node.lcurlybrace);
    if let Some(item) = &node.struct_pattern_elements {
        walk_structPatternElements(v, item);
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(130, &"structPattern", &node.span);
}

pub fn walk_structPatternElements<V: Visitor>(v: &mut V, node: &StructPatternElementsNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(131, &"structPatternElements", &n.span);
            walk_structPatternFields(v, &n.struct_pattern_fields);
            if let Some(item) = &n.comma_struct_pattern_et_cetera {
                v.visit_token(&item.comma);
                if let Some(item) = &item.struct_pattern_et_cetera {
                    walk_structPatternEtCetera(v, item);
                }
            }
            v.exit_rule(131, &"structPatternElements", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(131, &"structPatternElements", &n.span);
            walk_structPatternEtCetera(v, &n.struct_pattern_et_cetera);
            v.exit_rule(131, &"structPatternElements", &n.span);
        }
    }
}

pub fn walk_structPatternFields<V: Visitor>(v: &mut V, node: &StructPatternFieldsNode) {
    v.enter_rule(132, &"structPatternFields", &node.span);
    walk_structPatternField(v, &node.struct_pattern_field);
    for let item of &node.comma_struct_pattern_field_list {
        v.visit_token(&item.comma);
        walk_structPatternField(v, &item.struct_pattern_field);
    }
    v.exit_rule(132, &"structPatternFields", &node.span);
}

pub fn walk_structPatternField<V: Visitor>(v: &mut V, node: &StructPatternFieldNode) {
    v.enter_rule(133, &"structPatternField", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_tupleIndex(v, &inner.tuple_index);
                v.visit_token(&inner.colon);
                walk_pattern(v, &inner.pattern);
            }
            Alt1(inner) => {
                walk_identifier(v, &inner.identifier);
                v.visit_token(&inner.colon);
                walk_pattern(v, &inner.pattern);
            }
            Alt2(inner) => {
                if let Some(item) = &inner.kw_ref {
                    v.visit_token(item);
                }
                if let Some(item) = &inner.kw_mut {
                    v.visit_token(item);
                }
                walk_identifier(v, &inner.identifier);
            }
        }
    }
    v.exit_rule(133, &"structPatternField", &node.span);
}

