            let mut best: i32 = -1;
            pos = start;
            try_1: {
                pos = scan_identifier(tokens, pos, follow, 0);
                if pos < 0 { break try_1; }
                if pos > best { best = pos; }
            }
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_KW_MACRORULES { break try_2; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_KW_UNDERLINELIFETIME {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos].kind != TK_KW_UNDERLINELIFETIME { break try_3; }
