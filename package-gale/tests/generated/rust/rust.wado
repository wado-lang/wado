    v.enter_rule(164, &"typeParamBounds", &node.span);
    walk_typeParamBound(v, &node.type_param_bound);
    for let item of &node.plus_type_param_bound_list {
        v.visit_token(&item.plus);
        walk_typeParamBound(v, &item.type_param_bound);
    }
    if let Some(item) = &node.plus {
