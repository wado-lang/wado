pub fn walk_tupleType<V: Visitor>(v: &mut V, node: &TupleTypeNode) {
    v.enter_rule(147, &"tupleType", &node.span);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.item_type_ {
        for let item of &item.type__comma_list {
            walk_type_(v, &item.type_);
            v.visit_token(&item.comma);
        }
        if let Some(item) = &item.type_ {
            walk_type_(v, item);
        }
    }
    v.visit_token(&node.rparen);
    v.exit_rule(147, &"tupleType", &node.span);
}

pub fn walk_arrayType<V: Visitor>(v: &mut V, node: &ArrayTypeNode) {
    v.enter_rule(148, &"arrayType", &node.span);
    v.visit_token(&node.lsquarebracket);
    walk_type_(v, &node.type_);
    v.visit_token(&node.semi);
    walk_expression(v, &node.expression);
    v.visit_token(&node.rsquarebracket);
    v.exit_rule(148, &"arrayType", &node.span);
}

pub fn walk_sliceType<V: Visitor>(v: &mut V, node: &SliceTypeNode) {
