    if kind == TK_LE {
        let le = p.expect(TK_LE)?;
        return Result::<ComparisonOperatorNode, ParseError>::Ok(ComparisonOperatorNode::Alt5(ComparisonOperatorAlt5 {
            span: Span::new(start, i32::max(start, p.last_end())),
            le,
        }));
    }
    return Result::<ComparisonOperatorNode, ParseError>::Err(p.error(
        "expected comparisonOperator",
        p.peek().span,
        ["TK_EQEQ", "TK_NE", "TK_GT", "TK_LT", "TK_GE", "TK_LE"],
