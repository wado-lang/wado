pub fn parse_crate(input: &String) -> Result<CrateNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_crate(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<CrateNode, ParseError>::Err(_d);
            }
        }
        return Result::<CrateNode, ParseError>::Err(_e);
    }
    return _result;
}

