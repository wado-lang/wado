    if kind == TK_GE {
        let ge = p.expect(TK_GE)?;
        return Result::<ComparisonOperatorNode, ParseError>::Ok(ComparisonOperatorNode::Alt4(ComparisonOperatorAlt4 {
            span: Span::new(start, i32::max(start, p.last_end())),
