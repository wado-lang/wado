        let lt = p.expect(TK_LT)?;
        return Result::<ComparisonOperatorNode, ParseError>::Ok(ComparisonOperatorNode::Alt3(ComparisonOperatorAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
