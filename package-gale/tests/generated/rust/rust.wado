pub fn walk_union_<V: Visitor>(v: &mut V, node: &UnionNode) {
    v.enter_rule(50, &"union_", &node.span);
    v.visit_token(&node.kw_union);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.generic_params {
