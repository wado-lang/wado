pub fn walk_simplePathSegment<V: Visitor>(v: &mut V, node: &SimplePathSegmentNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(170, &"simplePathSegment", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(170, &"simplePathSegment", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(170, &"simplePathSegment", &n.span);
            v.visit_token(&n.kw_super);
            v.exit_rule(170, &"simplePathSegment", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(170, &"simplePathSegment", &n.span);
            v.visit_token(&n.kw_selfvalue);
            v.exit_rule(170, &"simplePathSegment", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(170, &"simplePathSegment", &n.span);
            v.visit_token(&n.kw_crate);
            v.exit_rule(170, &"simplePathSegment", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(170, &"simplePathSegment", &n.span);
