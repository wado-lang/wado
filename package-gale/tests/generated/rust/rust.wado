pub fn walk_structExprStruct<V: Visitor>(v: &mut V, node: &StructExprStructNode) {
    v.enter_rule(91, &"structExprStruct", &node.span);
    walk_pathInExpression(v, &node.path_in_expression);
    v.visit_token(&node.lcurlybrace);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    if let Some(item) = &node.struct_expr_fields_or_struct_base {
        match item {
            StructExprFields(inner) => {
                walk_structExprFields(v, inner);
            }
            StructBase(inner) => {
                walk_structBase(v, inner);
            }
        }
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(91, &"structExprStruct", &node.span);
}

pub fn walk_structExprFields<V: Visitor>(v: &mut V, node: &StructExprFieldsNode) {
    v.enter_rule(92, &"structExprFields", &node.span);
    walk_structExprField(v, &node.struct_expr_field);
    for let item of &node.comma_struct_expr_field_list {
        v.visit_token(&item.comma);
        walk_structExprField(v, &item.struct_expr_field);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.comma);
                walk_structBase(v, &inner.struct_base);
            }
            Alt1(inner) => {
                if let Some(item) = &inner.comma {
                    v.visit_token(item);
                }
            }
        }
    }
    v.exit_rule(92, &"structExprFields", &node.span);
}

pub fn walk_structExprField<V: Visitor>(v: &mut V, node: &StructExprFieldNode) {
    v.enter_rule(93, &"structExprField", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_identifier(v, &inner.identifier);
            }
            Alt1(inner) => {
                if let Some(item) = &inner.identifier_or_tuple_index {
                    match item {
                        Identifier(inner) => {
                            walk_identifier(v, inner);
                        }
                        TupleIndex(inner) => {
                            walk_tupleIndex(v, inner);
                        }
                    }
                }
                v.visit_token(&inner.colon);
                walk_expression(v, &inner.expression);
            }
        }
    }
    v.exit_rule(93, &"structExprField", &node.span);
}

pub fn walk_structBase<V: Visitor>(v: &mut V, node: &StructBaseNode) {
