    v.enter_rule(150, &"referenceType", &node.span);
    v.visit_token(&node.and);
    if let Some(item) = &node.lifetime {
        walk_lifetime(v, item);
    }
    if let Some(item) = &node.kw_mut {
        v.visit_token(item);
    }
    walk_typeNoBounds(v, &node.type_no_bounds);
    v.exit_rule(150, &"referenceType", &node.span);
}

