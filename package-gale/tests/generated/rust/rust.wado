}

pub fn walk_pathInExpression<V: Visitor>(v: &mut V, node: &PathInExpressionNode) {
    v.enter_rule(171, &"pathInExpression", &node.span);
    if let Some(item) = &node.pathsep {
        v.visit_token(item);
    }
    walk_pathExprSegment(v, &node.path_expr_segment);
    for let item of &node.pathsep_path_expr_segment_list {
        v.visit_token(&item.pathsep);
        walk_pathExprSegment(v, &item.path_expr_segment);
    }
    v.exit_rule(171, &"pathInExpression", &node.span);
}

pub fn walk_pathExprSegment<V: Visitor>(v: &mut V, node: &PathExprSegmentNode) {
    v.enter_rule(172, &"pathExprSegment", &node.span);
    walk_pathIdentSegment(v, &node.path_ident_segment);
    if let Some(item) = &node.pathsep_generic_args {
        v.visit_token(&item.pathsep);
        walk_genericArgs(v, &item.generic_args);
