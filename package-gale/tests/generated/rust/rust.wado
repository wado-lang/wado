pub fn walk_genericArgs<V: Visitor>(v: &mut V, node: &GenericArgsNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(174, &"genericArgs", &n.span);
            v.visit_token(&n.lt);
            v.visit_token(&n.gt);
            v.exit_rule(174, &"genericArgs", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(174, &"genericArgs", &n.span);
            v.visit_token(&n.lt);
            walk_genericArgsLifetimes(v, &n.generic_args_lifetimes);
            if let Some(item) = &n.comma_generic_args_types {
                v.visit_token(&item.comma);
                walk_genericArgsTypes(v, &item.generic_args_types);
            }
            if let Some(item) = &n.comma_generic_args_bindings {
                v.visit_token(&item.comma);
                walk_genericArgsBindings(v, &item.generic_args_bindings);
            }
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.visit_token(&n.gt);
            v.exit_rule(174, &"genericArgs", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(174, &"genericArgs", &n.span);
            v.visit_token(&n.lt);
            walk_genericArgsTypes(v, &n.generic_args_types);
            if let Some(item) = &n.comma_generic_args_bindings {
                v.visit_token(&item.comma);
                walk_genericArgsBindings(v, &item.generic_args_bindings);
            }
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.visit_token(&n.gt);
            v.exit_rule(174, &"genericArgs", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(174, &"genericArgs", &n.span);
            v.visit_token(&n.lt);
            for let item of &n.generic_arg_comma_list {
                walk_genericArg(v, &item.generic_arg);
                v.visit_token(&item.comma);
            }
            walk_genericArg(v, &n.generic_arg);
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.visit_token(&n.gt);
            v.exit_rule(174, &"genericArgs", &n.span);
        }
    }
}

pub fn walk_genericArg<V: Visitor>(v: &mut V, node: &GenericArgNode) {
    match node {
