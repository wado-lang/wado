fn _parse_identifier__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<IdentifierNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_NON_KEYWORD_IDENTIFIER {
        let non_keyword_identifier = p.expect(TK_NON_KEYWORD_IDENTIFIER)?;
        return Result::<IdentifierNode, ParseError>::Ok(IdentifierNode::Alt0(IdentifierAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            non_keyword_identifier,
        }));
    }
    if kind == TK_RAW_IDENTIFIER {
        let raw_identifier = p.expect(TK_RAW_IDENTIFIER)?;
        return Result::<IdentifierNode, ParseError>::Ok(IdentifierNode::Alt1(IdentifierAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            raw_identifier,
        }));
    }
    if kind == TK_KW_MACRORULES {
        let kw_macrorules = p.expect(TK_KW_MACRORULES)?;
        return Result::<IdentifierNode, ParseError>::Ok(IdentifierNode::Alt2(IdentifierAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            kw_macrorules,
        }));
    }
    return Result::<IdentifierNode, ParseError>::Err(p.error(
        "expected identifier",
        p.peek().span,
        ["TK_NON_KEYWORD_IDENTIFIER", "TK_RAW_IDENTIFIER", "TK_KW_MACRORULES"],
    ));
}

