pub fn walk_shl<V: Visitor>(v: &mut V, node: &ShlNode) {
    v.enter_rule(194, &"shl", &node.span);
    v.visit_token(&node.lt);
    v.visit_token(&node.lt_2);
    v.exit_rule(194, &"shl", &node.span);
}

pub fn walk_shr<V: Visitor>(v: &mut V, node: &ShrNode) {
    v.enter_rule(195, &"shr", &node.span);
    v.visit_token(&node.gt);
    v.visit_token(&node.gt_2);
    v.exit_rule(195, &"shr", &node.span);
}

pub fn to_tree(node: &CrateNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_crate(&mut recorder, node);
    return recorder.build();
}

