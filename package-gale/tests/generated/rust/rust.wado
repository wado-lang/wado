pub fn walk_macroRulesDef<V: Visitor>(v: &mut V, node: &MacroRulesDefNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(7, &"macroRulesDef", &n.span);
            v.visit_token(&n.lparen);
            walk_macroRules(v, &n.macro_rules);
            v.visit_token(&n.rparen);
            v.visit_token(&n.semi);
            v.exit_rule(7, &"macroRulesDef", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(7, &"macroRulesDef", &n.span);
            v.visit_token(&n.lsquarebracket);
            walk_macroRules(v, &n.macro_rules);
            v.visit_token(&n.rsquarebracket);
            v.visit_token(&n.semi);
            v.exit_rule(7, &"macroRulesDef", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(7, &"macroRulesDef", &n.span);
