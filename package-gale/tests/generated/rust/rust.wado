pub fn walk_typeNoBounds<V: Visitor>(v: &mut V, node: &TypeNoBoundsNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
            walk_parenthesizedType(v, &n.parenthesized_type);
            v.exit_rule(144, &"typeNoBounds", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(144, &"typeNoBounds", &n.span);
