fn try_eqeq(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '=' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '=' { return -1; }
    pos += 1;
    return pos;
}

fn try_ne(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '!' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '=' { return -1; }
    pos += 1;
    return pos;
}

fn try_gt(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '>' { return -1; }
