pub fn walk_macroIdentifierLikeToken<V: Visitor>(v: &mut V, node: &MacroIdentifierLikeTokenNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(191, &"macroIdentifierLikeToken", &n.span);
            walk_keyword(v, &n.keyword);
            v.exit_rule(191, &"macroIdentifierLikeToken", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(191, &"macroIdentifierLikeToken", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(191, &"macroIdentifierLikeToken", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(191, &"macroIdentifierLikeToken", &n.span);
            v.visit_token(&n.kw_macrorules);
            v.exit_rule(191, &"macroIdentifierLikeToken", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(191, &"macroIdentifierLikeToken", &n.span);
            v.visit_token(&n.kw_underlinelifetime);
            v.exit_rule(191, &"macroIdentifierLikeToken", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(191, &"macroIdentifierLikeToken", &n.span);
            v.visit_token(&n.kw_dollarcrate);
            v.exit_rule(191, &"macroIdentifierLikeToken", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(191, &"macroIdentifierLikeToken", &n.span);
            v.visit_token(&n.lifetime_or_label);
            v.exit_rule(191, &"macroIdentifierLikeToken", &n.span);
        }
    }
}

pub fn walk_macroLiteralToken<V: Visitor>(v: &mut V, node: &MacroLiteralTokenNode) {
    v.enter_rule(192, &"macroLiteralToken", &node.span);
    walk_literalExpression(v, &node.literal_expression);
    v.exit_rule(192, &"macroLiteralToken", &node.span);
}

