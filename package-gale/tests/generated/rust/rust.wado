pub fn walk_traitBound<V: Visitor>(v: &mut V, node: &TraitBoundNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(166, &"traitBound", &n.span);
            if let Some(item) = &n.question {
                v.visit_token(item);
            }
            if let Some(item) = &n.for_lifetimes {
                walk_forLifetimes(v, item);
            }
            walk_typePath(v, &n.type_path);
            v.exit_rule(166, &"traitBound", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(166, &"traitBound", &n.span);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.question {
                v.visit_token(item);
            }
            if let Some(item) = &n.for_lifetimes {
                walk_forLifetimes(v, item);
            }
            walk_typePath(v, &n.type_path);
            v.visit_token(&n.rparen);
            v.exit_rule(166, &"traitBound", &n.span);
        }
    }
}

