    v.exit_rule(156, &"maybeNamedFunctionParameters", &node.span);
}

pub fn walk_maybeNamedParam<V: Visitor>(v: &mut V, node: &MaybeNamedParamNode) {
    v.enter_rule(157, &"maybeNamedParam", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.item_colon {
        if let Some(item) = &item.group_0 {
            match item {
                Alt0(inner) => {
                    walk_identifier(v, &inner.identifier);
                }
                Alt1(inner) => {
                    v.visit_token(&inner.underscore);
                }
            }
        }
        v.visit_token(&item.colon);
    }
    walk_type_(v, &node.type_);
    v.exit_rule(157, &"maybeNamedParam", &node.span);
}

pub fn walk_maybeNamedFunctionParametersVariadic<V: Visitor>(v: &mut V, node: &MaybeNamedFunctionParametersVariadicNode) {
    v.enter_rule(158, &"maybeNamedFunctionParametersVariadic", &node.span);
    for let item of &node.maybe_named_param_comma_list {
        walk_maybeNamedParam(v, &item.maybe_named_param);
        v.visit_token(&item.comma);
    }
    walk_maybeNamedParam(v, &node.maybe_named_param);
    v.visit_token(&node.comma);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    v.visit_token(&node.dotdotdot);
    v.exit_rule(158, &"maybeNamedFunctionParametersVariadic", &node.span);
}

