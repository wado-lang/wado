    }
    if let Some(item) = &node.where_clause {
        walk_whereClause(v, item);
    }
    v.visit_token(&node.lcurlybrace);
    walk_structFields(v, &node.struct_fields);
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(50, &"union_", &node.span);
}

pub fn walk_constantItem<V: Visitor>(v: &mut V, node: &ConstantItemNode) {
    v.enter_rule(51, &"constantItem", &node.span);
    v.visit_token(&node.kw_const);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_identifier(v, &inner.identifier);
            }
            Alt1(inner) => {
                v.visit_token(&inner.underscore);
            }
        }
    }
    v.visit_token(&node.colon);
    walk_type_(v, &node.type_);
    if let Some(item) = &node.eq_expression {
        v.visit_token(&item.eq);
        walk_expression(v, &item.expression);
    }
    v.visit_token(&node.semi);
    v.exit_rule(51, &"constantItem", &node.span);
}

pub fn walk_staticItem<V: Visitor>(v: &mut V, node: &StaticItemNode) {
    v.enter_rule(52, &"staticItem", &node.span);
    v.visit_token(&node.kw_static);
    if let Some(item) = &node.kw_mut {
        v.visit_token(item);
    }
    walk_identifier(v, &node.identifier);
    v.visit_token(&node.colon);
    walk_type_(v, &node.type_);
    if let Some(item) = &node.eq_expression {
        v.visit_token(&item.eq);
        walk_expression(v, &item.expression);
    }
    v.visit_token(&node.semi);
    v.exit_rule(52, &"staticItem", &node.span);
}

pub fn walk_trait_<V: Visitor>(v: &mut V, node: &TraitNode) {
    v.enter_rule(53, &"trait_", &node.span);
    if let Some(item) = &node.kw_unsafe {
        v.visit_token(item);
    }
    v.visit_token(&node.kw_trait);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.generic_params {
        walk_genericParams(v, item);
    }
    if let Some(item) = &node.colon_type_param_bounds {
        v.visit_token(&item.colon);
        if let Some(item) = &item.type_param_bounds {
            walk_typeParamBounds(v, item);
        }
    }
    if let Some(item) = &node.where_clause {
        walk_whereClause(v, item);
    }
    v.visit_token(&node.lcurlybrace);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    for let item of &node.associated_item_list {
        walk_associatedItem(v, item);
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(53, &"trait_", &node.span);
}

pub fn walk_implementation<V: Visitor>(v: &mut V, node: &ImplementationNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(54, &"implementation", &n.span);
            walk_inherentImpl(v, &n.inherent_impl);
            v.exit_rule(54, &"implementation", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(54, &"implementation", &n.span);
            walk_traitImpl(v, &n.trait_impl);
            v.exit_rule(54, &"implementation", &n.span);
        }
    }
}

pub fn walk_inherentImpl<V: Visitor>(v: &mut V, node: &InherentImplNode) {
    v.enter_rule(55, &"inherentImpl", &node.span);
    v.visit_token(&node.kw_impl);
    if let Some(item) = &node.generic_params {
        walk_genericParams(v, item);
    }
    walk_type_(v, &node.type_);
    if let Some(item) = &node.where_clause {
        walk_whereClause(v, item);
    }
    v.visit_token(&node.lcurlybrace);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    for let item of &node.associated_item_list {
        walk_associatedItem(v, item);
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(55, &"inherentImpl", &node.span);
}

pub fn walk_traitImpl<V: Visitor>(v: &mut V, node: &TraitImplNode) {
    v.enter_rule(56, &"traitImpl", &node.span);
    if let Some(item) = &node.kw_unsafe {
        v.visit_token(item);
    }
    v.visit_token(&node.kw_impl);
    if let Some(item) = &node.generic_params {
        walk_genericParams(v, item);
    }
    if let Some(item) = &node.not {
        v.visit_token(item);
    }
    walk_typePath(v, &node.type_path);
    v.visit_token(&node.kw_for);
    walk_type_(v, &node.type_);
    if let Some(item) = &node.where_clause {
        walk_whereClause(v, item);
    }
    v.visit_token(&node.lcurlybrace);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    for let item of &node.associated_item_list {
        walk_associatedItem(v, item);
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(56, &"traitImpl", &node.span);
}

pub fn walk_externBlock<V: Visitor>(v: &mut V, node: &ExternBlockNode) {
    v.enter_rule(57, &"externBlock", &node.span);
    if let Some(item) = &node.kw_unsafe {
        v.visit_token(item);
    }
    v.visit_token(&node.kw_extern);
    if let Some(item) = &node.abi {
        walk_abi(v, item);
    }
    v.visit_token(&node.lcurlybrace);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    for let item of &node.external_item_list {
        walk_externalItem(v, item);
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(57, &"externBlock", &node.span);
}

pub fn walk_externalItem<V: Visitor>(v: &mut V, node: &ExternalItemNode) {
    v.enter_rule(58, &"externalItem", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_macroInvocationSemi(v, &inner.macro_invocation_semi);
            }
            Alt1(inner) => {
                if let Some(item) = &inner.visibility {
                    walk_visibility(v, item);
                }
                if let Some(item) = &inner.static_item_or_function_ {
                    match item {
                        StaticItem(inner) => {
                            walk_staticItem(v, inner);
                        }
                        Function(inner) => {
                            walk_function_(v, inner);
                        }
                    }
                }
            }
        }
    }
    v.exit_rule(58, &"externalItem", &node.span);
}

pub fn walk_genericParams<V: Visitor>(v: &mut V, node: &GenericParamsNode) {
    v.enter_rule(59, &"genericParams", &node.span);
    v.visit_token(&node.lt);
    if let Some(item) = &node.item_generic_param_comma {
        for let item of &item.generic_param_comma_list {
            walk_genericParam(v, &item.generic_param);
            v.visit_token(&item.comma);
        }
        walk_genericParam(v, &item.generic_param);
        if let Some(item) = &item.comma {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.gt);
    v.exit_rule(59, &"genericParams", &node.span);
}

pub fn walk_genericParam<V: Visitor>(v: &mut V, node: &GenericParamNode) {
    v.enter_rule(60, &"genericParam", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.lifetime_param_or_type_param_or_const_param {
        match item {
            LifetimeParam(inner) => {
                walk_lifetimeParam(v, inner);
            }
            TypeParam(inner) => {
                walk_typeParam(v, inner);
            }
            ConstParam(inner) => {
                walk_constParam(v, inner);
            }
        }
    }
    v.exit_rule(60, &"genericParam", &node.span);
}

pub fn walk_lifetimeParam<V: Visitor>(v: &mut V, node: &LifetimeParamNode) {
    v.enter_rule(61, &"lifetimeParam", &node.span);
    if let Some(item) = &node.outer_attribute {
        walk_outerAttribute(v, item);
    }
    v.visit_token(&node.lifetime_or_label);
    if let Some(item) = &node.colon_lifetime_bounds {
        v.visit_token(&item.colon);
        walk_lifetimeBounds(v, &item.lifetime_bounds);
    }
    v.exit_rule(61, &"lifetimeParam", &node.span);
}

pub fn walk_typeParam<V: Visitor>(v: &mut V, node: &TypeParamNode) {
    v.enter_rule(62, &"typeParam", &node.span);
    if let Some(item) = &node.outer_attribute {
        walk_outerAttribute(v, item);
    }
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.colon_type_param_bounds {
        v.visit_token(&item.colon);
        if let Some(item) = &item.type_param_bounds {
            walk_typeParamBounds(v, item);
        }
    }
    if let Some(item) = &node.eq_type_ {
        v.visit_token(&item.eq);
        walk_type_(v, &item.type_);
    }
    v.exit_rule(62, &"typeParam", &node.span);
}

pub fn walk_constParam<V: Visitor>(v: &mut V, node: &ConstParamNode) {
    v.enter_rule(63, &"constParam", &node.span);
    v.visit_token(&node.kw_const);
    walk_identifier(v, &node.identifier);
    v.visit_token(&node.colon);
    walk_type_(v, &node.type_);
    v.exit_rule(63, &"constParam", &node.span);
}

pub fn walk_whereClause<V: Visitor>(v: &mut V, node: &WhereClauseNode) {
    v.enter_rule(64, &"whereClause", &node.span);
    v.visit_token(&node.kw_where);
    for let item of &node.where_clause_item_comma_list {
        walk_whereClauseItem(v, &item.where_clause_item);
        v.visit_token(&item.comma);
    }
    if let Some(item) = &node.where_clause_item {
        walk_whereClauseItem(v, item);
    }
    v.exit_rule(64, &"whereClause", &node.span);
}

pub fn walk_whereClauseItem<V: Visitor>(v: &mut V, node: &WhereClauseItemNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(65, &"whereClauseItem", &n.span);
            walk_lifetimeWhereClauseItem(v, &n.lifetime_where_clause_item);
            v.exit_rule(65, &"whereClauseItem", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(65, &"whereClauseItem", &n.span);
            walk_typeBoundWhereClauseItem(v, &n.type_bound_where_clause_item);
            v.exit_rule(65, &"whereClauseItem", &n.span);
        }
    }
}

pub fn walk_lifetimeWhereClauseItem<V: Visitor>(v: &mut V, node: &LifetimeWhereClauseItemNode) {
    v.enter_rule(66, &"lifetimeWhereClauseItem", &node.span);
    walk_lifetime(v, &node.lifetime);
    v.visit_token(&node.colon);
    walk_lifetimeBounds(v, &node.lifetime_bounds);
    v.exit_rule(66, &"lifetimeWhereClauseItem", &node.span);
}

pub fn walk_typeBoundWhereClauseItem<V: Visitor>(v: &mut V, node: &TypeBoundWhereClauseItemNode) {
    v.enter_rule(67, &"typeBoundWhereClauseItem", &node.span);
    if let Some(item) = &node.for_lifetimes {
        walk_forLifetimes(v, item);
    }
    walk_type_(v, &node.type_);
    v.visit_token(&node.colon);
    if let Some(item) = &node.type_param_bounds {
        walk_typeParamBounds(v, item);
    }
    v.exit_rule(67, &"typeBoundWhereClauseItem", &node.span);
}

pub fn walk_forLifetimes<V: Visitor>(v: &mut V, node: &ForLifetimesNode) {
    v.enter_rule(68, &"forLifetimes", &node.span);
    v.visit_token(&node.kw_for);
    walk_genericParams(v, &node.generic_params);
    v.exit_rule(68, &"forLifetimes", &node.span);
}

pub fn walk_associatedItem<V: Visitor>(v: &mut V, node: &AssociatedItemNode) {
    v.enter_rule(69, &"associatedItem", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_macroInvocationSemi(v, &inner.macro_invocation_semi);
            }
            Alt1(inner) => {
                if let Some(item) = &inner.visibility {
                    walk_visibility(v, item);
                }
                if let Some(item) = &inner.type_alias_or_constant_item_or_function_ {
                    match item {
                        TypeAlias(inner) => {
                            walk_typeAlias(v, inner);
                        }
                        ConstantItem(inner) => {
                            walk_constantItem(v, inner);
                        }
                        Function(inner) => {
                            walk_function_(v, inner);
                        }
                    }
                }
            }
        }
    }
    v.exit_rule(69, &"associatedItem", &node.span);
}

pub fn walk_innerAttribute<V: Visitor>(v: &mut V, node: &InnerAttributeNode) {
    v.enter_rule(70, &"innerAttribute", &node.span);
    v.visit_token(&node.pound);
    v.visit_token(&node.not);
    v.visit_token(&node.lsquarebracket);
    walk_attr(v, &node.attr);
    v.visit_token(&node.rsquarebracket);
    v.exit_rule(70, &"innerAttribute", &node.span);
}

pub fn walk_outerAttribute<V: Visitor>(v: &mut V, node: &OuterAttributeNode) {
    v.enter_rule(71, &"outerAttribute", &node.span);
    v.visit_token(&node.pound);
    v.visit_token(&node.lsquarebracket);
    walk_attr(v, &node.attr);
    v.visit_token(&node.rsquarebracket);
    v.exit_rule(71, &"outerAttribute", &node.span);
}

pub fn walk_attr<V: Visitor>(v: &mut V, node: &AttrNode) {
    v.enter_rule(72, &"attr", &node.span);
    walk_simplePath(v, &node.simple_path);
    if let Some(item) = &node.attr_input {
        walk_attrInput(v, item);
    }
    v.exit_rule(72, &"attr", &node.span);
}

pub fn walk_attrInput<V: Visitor>(v: &mut V, node: &AttrInputNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(73, &"attrInput", &n.span);
            walk_delimTokenTree(v, &n.delim_token_tree);
            v.exit_rule(73, &"attrInput", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(73, &"attrInput", &n.span);
            v.visit_token(&n.eq);
            walk_literalExpression(v, &n.literal_expression);
            v.exit_rule(73, &"attrInput", &n.span);
        }
    }
}

pub fn walk_statement<V: Visitor>(v: &mut V, node: &StatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(74, &"statement", &n.span);
            v.visit_token(&n.semi);
            v.exit_rule(74, &"statement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(74, &"statement", &n.span);
            walk_item(v, &n.item);
            v.exit_rule(74, &"statement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(74, &"statement", &n.span);
            walk_letStatement(v, &n.let_statement);
            v.exit_rule(74, &"statement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(74, &"statement", &n.span);
            walk_expressionStatement(v, &n.expression_statement);
            v.exit_rule(74, &"statement", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(74, &"statement", &n.span);
            walk_macroInvocationSemi(v, &n.macro_invocation_semi);
            v.exit_rule(74, &"statement", &n.span);
        }
    }
}

pub fn walk_letStatement<V: Visitor>(v: &mut V, node: &LetStatementNode) {
    v.enter_rule(75, &"letStatement", &node.span);
    for let item of &node.outer_attribute_list {
        walk_outerAttribute(v, item);
    }
    v.visit_token(&node.kw_let);
    walk_patternNoTopAlt(v, &node.pattern_no_top_alt);
    if let Some(item) = &node.colon_type_ {
        v.visit_token(&item.colon);
        walk_type_(v, &item.type_);
    }
    if let Some(item) = &node.eq_expression {
        v.visit_token(&item.eq);
        walk_expression(v, &item.expression);
    }
    v.visit_token(&node.semi);
    v.exit_rule(75, &"letStatement", &node.span);
}

pub fn walk_expressionStatement<V: Visitor>(v: &mut V, node: &ExpressionStatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(76, &"expressionStatement", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.semi);
            v.exit_rule(76, &"expressionStatement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(76, &"expressionStatement", &n.span);
            walk_expressionWithBlock(v, &n.expression_with_block);
            if let Some(item) = &n.semi {
                v.visit_token(item);
            }
            v.exit_rule(76, &"expressionStatement", &n.span);
        }
    }
}

pub fn walk_expression<V: Visitor>(v: &mut V, node: &ExpressionNode) {
    match node {
        AttributedExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            for let item of &n.outer_attribute_list {
                walk_outerAttribute(v, item);
            }
            walk_expression(v, &n.expression);
            v.exit_rule(77, &"expression", &n.span);
        }
        LiteralExpression_(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_literalExpression(v, &n.literal_expression);
            v.exit_rule(77, &"expression", &n.span);
        }
        PathExpression_(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_pathExpression(v, &n.path_expression);
            v.exit_rule(77, &"expression", &n.span);
        }
        MethodCallExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.dot);
            walk_pathExprSegment(v, &n.path_expr_segment);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.call_params {
                walk_callParams(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(77, &"expression", &n.span);
        }
        FieldExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.dot);
            walk_identifier(v, &n.identifier);
            v.exit_rule(77, &"expression", &n.span);
        }
        TupleIndexingExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.dot);
            walk_tupleIndex(v, &n.tuple_index);
            v.exit_rule(77, &"expression", &n.span);
        }
        AwaitExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.dot);
            v.visit_token(&n.kw_await);
            v.exit_rule(77, &"expression", &n.span);
        }
        CallExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.call_params {
                walk_callParams(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(77, &"expression", &n.span);
        }
        IndexExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.lsquarebracket);
            walk_expression(v, &n.expression_2);
            v.visit_token(&n.rsquarebracket);
            v.exit_rule(77, &"expression", &n.span);
        }
        ErrorPropagationExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.question);
            v.exit_rule(77, &"expression", &n.span);
        }
        BorrowExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            v.visit_token(&n.and_or_andand);
            if let Some(item) = &n.kw_mut {
                v.visit_token(item);
            }
            walk_expression(v, &n.expression);
            v.exit_rule(77, &"expression", &n.span);
        }
        DereferenceExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            v.visit_token(&n.star);
            walk_expression(v, &n.expression);
            v.exit_rule(77, &"expression", &n.span);
        }
        NegationExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            v.visit_token(&n.minus_or_not);
            walk_expression(v, &n.expression);
            v.exit_rule(77, &"expression", &n.span);
        }
        TypeCastExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.kw_as);
            walk_typeNoBounds(v, &n.type_no_bounds);
            v.exit_rule(77, &"expression", &n.span);
        }
        ArithmeticOrLogicalExpression0(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.star_or_slash_or_percent);
            walk_expression(v, &n.expression_2);
            v.exit_rule(77, &"expression", &n.span);
        }
        ArithmeticOrLogicalExpression1(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.plus_or_minus);
            walk_expression(v, &n.expression_2);
            v.exit_rule(77, &"expression", &n.span);
        }
        ArithmeticOrLogicalExpression2(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            if let Some(item) = &n.shl_or_shr {
                match item {
                    Shl(inner) => {
                        walk_shl(v, inner);
                    }
                    Shr(inner) => {
                        walk_shr(v, inner);
                    }
                }
            }
            walk_expression(v, &n.expression_2);
            v.exit_rule(77, &"expression", &n.span);
        }
        ArithmeticOrLogicalExpression3(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.and);
            walk_expression(v, &n.expression_2);
            v.exit_rule(77, &"expression", &n.span);
        }
        ArithmeticOrLogicalExpression4(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.caret);
            walk_expression(v, &n.expression_2);
            v.exit_rule(77, &"expression", &n.span);
        }
        ArithmeticOrLogicalExpression5(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.or);
            walk_expression(v, &n.expression_2);
            v.exit_rule(77, &"expression", &n.span);
        }
        ComparisonExpression(n) => {
            v.enter_rule(77, &"expression", &n.span);
            walk_expression(v, &n.expression);
            walk_comparisonOperator(v, &n.comparison_operator);
            walk_expression(v, &n.expression_2);
            v.exit_rule(77, &"expression", &n.span);
        }
        LazyBooleanExpression0(n) => {
