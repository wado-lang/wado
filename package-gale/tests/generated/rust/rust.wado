pub fn walk_blockExpression<V: Visitor>(v: &mut V, node: &BlockExpressionNode) {
    v.enter_rule(83, &"blockExpression", &node.span);
    v.visit_token(&node.lcurlybrace);
    for let item of &node.inner_attribute_list {
        walk_innerAttribute(v, item);
    }
    if let Some(item) = &node.statements {
        walk_statements(v, item);
    }
    v.visit_token(&node.rcurlybrace);
    v.exit_rule(83, &"blockExpression", &node.span);
}

pub fn walk_statements<V: Visitor>(v: &mut V, node: &StatementsNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(84, &"statements", &n.span);
            for let item of &n.statement_list {
                walk_statement(v, item);
            }
            if let Some(item) = &n.expression {
                walk_expression(v, item);
            }
            v.exit_rule(84, &"statements", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(84, &"statements", &n.span);
            walk_expression(v, &n.expression);
            v.exit_rule(84, &"statements", &n.span);
        }
    }
}

