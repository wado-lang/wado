fn _parse_scanned__inner_alt_0(p: &mut Parser) -> () {
    p.site = 5;
    p.atn_ret_pending = 133;
    _parse_xg(p);
    if !kind_set_has(&SYNC_3, p.kinds[p.pos]) { p.sync_enter(&SYNC_3, &EXPECTED_3); }
    if p.peek_kind() == TK_LIT_c {
        p.take();
    }
    if !kind_set_has(&SYNC_4, p.kinds[p.pos]) { p.sync_enter(&SYNC_4, &EXPECTED_4); }
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos] != TK_LIT_k { break rep_scan; }
            pos += 1;
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.expect(TK_LIT_k, &SYNC_4, false);
        if !kind_set_has(&SYNC_4, p.kinds[p.pos]) { p.sync_back(&SYNC_4, &EXPECTED_4); }
    }
    p.expect(TK_LIT_x, &EMPTY_SYNC, true);
    if !p.speculating {
         p.emit("x"); 
    }
    return;
}

fn _parse_scanned__inner_alt_1(p: &mut Parser) -> () {
    p.site = 6;
    p.atn_ret_pending = 147;
    _parse_xg(p);
    if !kind_set_has(&SYNC_5, p.kinds[p.pos]) { p.sync_enter(&SYNC_5, &EXPECTED_5); }
    if p.peek_kind() == TK_LIT_c {
