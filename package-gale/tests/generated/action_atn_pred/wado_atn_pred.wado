pub fn parse_ck<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| { let _ = _parse_ck(p); });
}

pub fn parse_ctxdrop<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
