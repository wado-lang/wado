global CALL_FOLLOW_SETS: List<List<i32>> = [[8], [200], [328]];
global CALL_FOLLOW: List<i32> = [0, 0, 0, 0, 0, 1, 2];
global CALL_FOLLOW_ENDS: List<bool> = [false, false, false, false, false, false, false];

fn token_display_name(kind: i32) -> String {
    return match kind {
        TK_WS => "' '",
        _ => token_kind_name(kind),
    };
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(9);
    for let mut k = 0; k < 9; k += 1 {
        v.push(token_display_name(k));
    }
    return v;
}

global CTX_TOKEN_NAMES: List<String> = _token_names();

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }
    return String::new();
}

