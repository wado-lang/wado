        if !(pred_16(p)) { _atn_disabled.push(1); }
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 4, &p.atn.stack, &p.kinds, p.pos, TK_EOF, 0, &_atn_disabled);
