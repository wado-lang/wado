        if _atn_alt < 0 {
            p.no_viable("no viable alternative", p.peek_span(), &EMPTY_SYNC);
            return vals;
        }
        if _atn_alt == 1 {
            return _parse_ck__inner_alt_1(p, vals);
        }
        return _parse_ck__inner_alt_0(p, vals);
    }
    p.no_viable(
        "no alternative of ck matches",
        p.peek_span(),
        &EXPECTED_2,
    );
