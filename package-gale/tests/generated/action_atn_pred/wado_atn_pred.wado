fn _parse_xt__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_2, p.kinds[p.pos]) { p.sync_alts(&SYNC_2, &EXPECTED_2); }
    let kind = p.peek_kind();
    if kind == TK_LIT_a {
        let mut _atn_disabled: List<i32> = [];
        if !(pred_1(p)) { _atn_disabled.push(1); }
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 0, &p.atn.stack, &p.kinds, p.pos, TK_EOF, 0, &_atn_disabled);
        if _atn_alt < 0 {
            p.no_viable("no viable alternative", p.peek_span(), &EMPTY_SYNC);
            return;
        }
        if _atn_alt == 1 {
            return _parse_xt__inner_alt_1(p);
        }
        return _parse_xt__inner_alt_0(p);
    }
    p.no_viable(
        "no alternative of xt matches",
        p.peek_span(),
        &EXPECTED_2,
    );
    return;
}

