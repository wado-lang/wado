fn _parse_cd__inner(p: &mut Parser) -> CdVals {
    let mut vals = CdVals {};
    if !p.speculating {
         vals.mode = 1; 
    }
    if !kind_set_has(&SYNC_2, p.kinds[p.pos]) { p.sync_alts(&SYNC_2, &EXPECTED_2); }
    let kind = p.peek_kind();
    if kind == TK_LIT_a {
        let mut _atn_disabled: List<i32> = [];
        if !( vals.mode == 0 ) { _atn_disabled.push(1); }
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 3, &p.atn.stack, &p.kinds, p.pos, TK_EOF, 0, &_atn_disabled);
        if _atn_alt < 0 {
            p.no_viable("no viable alternative", p.peek_span(), &EMPTY_SYNC);
            return vals;
        }
        if _atn_alt == 1 {
            return _parse_cd__inner_alt_1(p, vals);
        }
        return _parse_cd__inner_alt_0(p, vals);
    }
    p.no_viable(
        "no alternative of cd matches",
        p.peek_span(),
        &EXPECTED_2,
    );
    return vals;
}

