            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.expect(TK_LIT_k, &SYNC_6, false);
        if !kind_set_has(&SYNC_6, p.kinds[p.pos]) { p.sync_back(&SYNC_6, &EXPECTED_6); }
    }
    p.expect(TK_LIT_y, &EMPTY_SYNC, true);
    if !p.speculating {
