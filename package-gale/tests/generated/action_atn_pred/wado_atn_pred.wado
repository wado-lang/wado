#![generated(by = "gale", sources = ["tests/grammars/wado_atn_pred.g4"])]

// Grammar metadata from source .g4 prequels:
//   option language = Wado

pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }
}

pub fn push_chars(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    let mut bytes = 0;
    for let mut i = start; i < end; i += 1 {
        bytes += chars[i].len_utf8();
    }
    out.reserve(bytes);
    for let mut i = start; i < end; i += 1 {
        out.push(chars[i]);
    }
}

pub fn chars_text(chars: &List<char>, start: i32, end: i32) -> String {
    let mut s = String::new();
    push_chars(&mut s, chars, start, end);
    return s;
}

pub fn push_chars_escaped(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    for let mut i = start; i < end; i += 1 {
        match chars[i] {
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            c => out.push(c),
        }
    }
}

pub fn kind_set_has(set: &List<i32>, kind: i32) -> bool {
    let w = kind >> 5;
    if w >= set.len() {
        return false;
    }
    return set[w] >> (kind & 31) & 1 == 1;
}

pub fn with_expected<S: AsStrSlice>(message: S, expected: &List<String>) -> String {
    let n = expected.len();
    if n == 0 {
        return message.to_string();
    }
    let mut out = String::with_capacity(n * 8 + message.len() + 11);
    out.push_str("expected ");
    for let mut i = 0; i < n; i += 1 {
        if i > 0 {
            out.push_str(&if i == n - 1 { " or " } else { ", " });
        }
        out.push_str(&expected[i]);
    }
    out.push_str("; ");
    out.push_str(message);
    return out;
}

pub fn char_pos_in_line(chars: &List<char>, i: i32) -> i32 {
    let mut j = if i < chars.len() { i } else { chars.len() };
    let mut col = 0;
    while j > 0 && chars[j - 1] != '\n' {
        col += 1;
        j -= 1;
    }
    return col;
}

pub fn line_starts(chars: &List<char>) -> List<i32> {
    let mut starts: List<i32> = [0];
    for let mut i = 0; i < chars.len(); i += 1 {
        if chars[i] == '\n' {
            starts.push(i + 1);
        }
    }
    return starts;
}

pub fn line_col_at(starts: &List<i32>, pos: i32) -> [i32, i32] {
    let mut lo = 0;
    let mut hi = starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return [lo + 1, pos - starts[lo]];
}

pub flags TokenFlags {
    Synthetic,
    Skipped,
    LexError,
}

pub struct TokenStream {
    pub kinds: List<i32>,
    pub starts: List<i32>,
    pub ends: List<i32>,
    pub triv_lo: List<i32>,
    pub triv_hi: List<i32>,
    pub chars: &List<char>,
    pub triv_kinds: List<i32>,
    pub triv_starts: List<i32>,
    pub triv_ends: List<i32>,
    pub triv_chans: List<i32>,
    pub flags: List<TokenFlags>,
    pub output: String = "",
}

impl TokenStream {
    pub fn new(chars: &List<char>) -> TokenStream {
        let cap = chars.len() / 4 + 1;
        return TokenStream {
            kinds: List::with_capacity(cap),
            starts: List::with_capacity(cap),
            ends: List::with_capacity(cap),
            triv_lo: List::with_capacity(cap),
            triv_hi: List::with_capacity(cap),
            chars,
            triv_kinds: List::with_capacity(cap),
            triv_starts: List::with_capacity(cap),
            triv_ends: List::with_capacity(cap),
            triv_chans: List::with_capacity(cap),
            flags: List::with_capacity(cap),
        };
    }

    pub fn len(&self) -> i32 {
        return self.kinds.len();
    }

    pub fn trivia_mark(&self) -> i32 {
        return self.triv_kinds.len();
    }

    pub fn push_trivia(&mut self, kind: i32, start: i32, end: i32, channel: i32) {
        if self.triv_kinds.len() >= self.triv_kinds.capacity() {
            builtin::cold_path();
            self.triv_kinds.grow();
            self.triv_starts.grow();
            self.triv_ends.grow();
            self.triv_chans.grow();
            assert self.triv_starts.capacity() == self.triv_kinds.capacity()
                && self.triv_ends.capacity() == self.triv_kinds.capacity()
                && self.triv_chans.capacity() == self.triv_kinds.capacity(), "TokenStream trivia columns must grow in lockstep";
        }
        self.triv_kinds.push_within_capacity(kind);
        self.triv_starts.push_within_capacity(start);
        self.triv_ends.push_within_capacity(end);
        self.triv_chans.push_within_capacity(channel);
    }

    pub fn push_token(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32) {
        self.push_token_flagged(kind, start, end, triv_lo, triv_hi, TokenFlags::none());
    }

    pub fn push_token_flagged(
        &mut self,
        kind: i32,
        start: i32,
        end: i32,
        triv_lo: i32,
        triv_hi: i32,
        flags: TokenFlags,
    ) -> i32 {
        let idx = self.kinds.len();
        if idx >= self.kinds.capacity() {
            builtin::cold_path();
            self.kinds.grow();
            self.starts.grow();
            self.ends.grow();
            self.triv_lo.grow();
            self.triv_hi.grow();
            self.flags.grow();
            assert self.starts.capacity() == self.kinds.capacity()
                && self.ends.capacity() == self.kinds.capacity()
                && self.triv_lo.capacity() == self.kinds.capacity()
                && self.triv_hi.capacity() == self.kinds.capacity()
                && self.flags.capacity() == self.kinds.capacity(), "TokenStream token columns must grow in lockstep";
        }
        self.kinds.push_within_capacity(kind);
        self.starts.push_within_capacity(start);
        self.ends.push_within_capacity(end);
        self.triv_lo.push_within_capacity(triv_lo);
        self.triv_hi.push_within_capacity(triv_hi);
        self.flags.push_within_capacity(flags);
        return idx;
    }

    pub fn push_synthetic(&mut self, expected_kind: i32, at: i32) -> i32 {
        let m = self.trivia_mark();
        return self.push_token_flagged(expected_kind, at, at, m, m, TokenFlags::Synthetic);
    }

    pub fn flags_at(&self, i: i32) -> TokenFlags {
        return self.flags[i];
    }

    pub fn set_flag(&mut self, i: i32, flag: TokenFlags) {
        self.flags[i] = self.flags[i] | flag;
    }

    pub fn mark_skipped(&mut self, i: i32) {
        self.set_flag(i, TokenFlags::Skipped);
    }

    pub fn is_synthetic(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Synthetic != TokenFlags::none();
    }

    pub fn is_skipped(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Skipped != TokenFlags::none();
    }

    pub fn is_lex_error(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::LexError != TokenFlags::none();
    }

    pub fn kind_at(&self, i: i32) -> i32 {
        return self.kinds[i];
    }

    pub fn span_at(&self, i: i32) -> Span {
        return Span::new(self.starts[i], self.ends[i]);
    }

    pub fn is_empty_text(&self, i: i32) -> bool {
        return self.starts[i] >= self.ends[i];
    }

    pub fn token_text(&self, i: i32) -> String {
        return chars_text(self.chars, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text(&self, out: &mut String, i: i32) {
        push_chars(out, self.chars, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text_escaped(&self, out: &mut String, i: i32) {
        push_chars_escaped(out, self.chars, self.starts[i], self.ends[i]);
    }

    pub fn rule_text(&self, start_tok: i32, end_tok: i32) -> String {
        let mut out = String::new();
        for let mut i = start_tok; i <= end_tok; i += 1 {
            if i > start_tok {
                for let mut j = self.triv_lo[i]; j < self.triv_hi[i]; j += 1 {
                    if self.triv_chans[j] != 0 {
                        push_chars(&mut out, self.chars, self.triv_starts[j], self.triv_ends[j]);
                    }
                }
            }
            self.push_token_text(&mut out, i);
        }
        return out;
    }
}

pub enum Severity {
    Error,
}

impl Severity {
    pub fn label(&self) -> String {
        return match *self { Error => "error" };
    }
}

pub enum DiagnosticCode {
    UnexpectedToken,
    MissingToken,
    ExtraToken,
    NoViableAlternative,
    UnterminatedConstruct,
    LexError,
}

impl DiagnosticCode {
    pub fn name(&self) -> String {
        return match *self {
            UnexpectedToken => "unexpected-token",
            MissingToken => "missing-token",
            ExtraToken => "extra-token",
            NoViableAlternative => "no-viable-alternative",
            UnterminatedConstruct => "unterminated-construct",
            LexError => "lex-error",
        };
    }
}

pub enum RecoveryAction {
    Inserted,
    Deleted,
    SkippedTo,
    FilledMissing,
    None,
}

pub struct Diagnostic {
    pub severity: Severity = Severity::Error,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub expected: List<i32> = [],
    pub found: i32 = -1,
    pub rule_stack: List<String> = [],
    pub recovery: RecoveryAction = RecoveryAction::None,
}

impl Diagnostic {
    pub fn error<S: AsStrSlice>(
        code: DiagnosticCode,
        message: S,
        span: Span,
        expected: List<i32>,
        found: i32,
        recovery: RecoveryAction,
    ) -> Diagnostic {
        return Diagnostic { code, message: message.to_string(), span, expected, found, recovery };
    }

    pub fn is_error(&self) -> bool {
        return self.severity matches { Error };
    }

    pub fn rule_path(&self) -> String {
        let stack = &self.rule_stack;
        let mut out = String::with_capacity(stack.len() * 8);
        let n = stack.len();
        for let mut i = 0; i < n; i += 1 {
            let name = &stack[n - 1 - i];
            if i > 0 {
                if *name == stack[n - i] {
                    continue;
                }
                out.push_str(" > ");
            }
            out.push_str(name);
        }
        return out;
    }
}

impl Display for Diagnostic {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.severity.label()}[${self.code.name()}] at ${self.line}:${self.col}: ${self.message}`);
    }
}

fn lex_error_at(tokens: &TokenStream, i: i32) -> Diagnostic {
    let mut message = String::from("token recognition error at: '");
    push_chars_escaped(&mut message, tokens.chars, tokens.starts[i], tokens.ends[i]);
    message.push('\'');
    return Diagnostic::error(
        DiagnosticCode::LexError,
        message,
        tokens.span_at(i),
        [],
        tokens.kinds[i],
        RecoveryAction::None,
    );
}

pub fn merge_lex_errors(tokens: &TokenStream, diagnostics: &mut List<Diagnostic>, max_errors: i32) {
    let mut merged: List<Diagnostic> = [];
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.is_lex_error(i) {
            merged.push(lex_error_at(tokens, i));
        }
    }
    merged.extend(diagnostics);
    merged.sort_by(|a: &Diagnostic, b: &Diagnostic| a.span.start.cmp(&b.span.start));
    merged.truncate(max_errors);
    *diagnostics = merged;
}

pub fn resolve_positions(diagnostics: &mut List<Diagnostic>, chars: &List<char>) {
    if diagnostics.is_empty() {
        return;
    }
    let starts = line_starts(chars);
    for let mut i = 0; i < diagnostics.len(); i += 1 {
        let lc = line_col_at(&starts, diagnostics[i].span.start);
        diagnostics[i].line = lc.0;
        diagnostics[i].col = lc.1;
    }
}

pub type NodeKind = i32;

pub global K_ERROR: NodeKind = -1;

pub flags NodeFlags {
    Error,
    Incomplete,
}

pub enum EventTag {
    Open,
    Close,
    Tok,
    Miss,
    Skip,
}

pub struct CstStore {
    pub tag: List<EventTag>,
    pub a: List<i32>,
    pub b: List<i32>,
    alt: List<i32>,
    end: List<i32>,
    flags: List<NodeFlags>,
    next: List<i32>,
}

pub enum ChildKind {
    Node,
    Token,
    Missing,
    Skipped,
}

impl CstStore {
    pub fn row_count(&self) -> i32 {
        return self.tag.len();
    }

    pub fn kind(&self, i: i32) -> NodeKind {
        return self.a[i] as NodeKind;
    }

    pub fn close_kind(&self, i: i32) -> NodeKind {
        return self.b[i] as NodeKind;
    }

    pub fn span(&self, i: i32) -> Span {
        return Span::new(self.b[i], self.end[i]);
    }

    pub fn alt(&self, i: i32) -> i32 {
        return self.alt[i];
    }

    pub fn is_error(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Error != NodeFlags::none();
    }

    pub fn is_incomplete(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Incomplete != NodeFlags::none();
    }

    pub fn is_node(&self, i: i32) -> bool {
        return self.tag[i] matches { Open };
    }

    pub fn is_token(&self, i: i32) -> bool {
        return self.tag[i] matches { Tok | Miss | Skip };
    }

    pub fn child_kind(&self, i: i32) -> ChildKind {
        return match self.tag[i] {
            Open => ChildKind::Node,
            Miss => ChildKind::Missing,
            Skip => ChildKind::Skipped,
            Tok => ChildKind::Token,
            Close => panic("CstStore::child_kind: Close is not a child row"),
        };
    }

    pub fn token_index(&self, i: i32) -> i32 {
        return self.a[i];
    }

    pub fn first_child(&self, i: i32) -> i32 {
        let c = i + 1;
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn next_sibling(&self, child: i32) -> i32 {
        let c = if self.tag[child] matches { Open } { self.next[child] } else { child + 1 };
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn find_child(&self, i: i32, kind: NodeKind) -> i32 {
        let k = kind as i32;
        for let mut c = self.first_child(i); c >= 0; c = self.next_sibling(c) {
            if self.tag[c] matches { Open } && self.kind(c) as i32 == k {
                return c;
            }
        }
        return -1;
    }

    pub fn to_string_tree(
        &self,
        i: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(256);
        let _ = render_node(&mut out, &self.tag, &self.a, i, toks, rule_names, token_names);
        return out;
    }
}

pub struct ParseResult {
    pub cst: CstStore,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
    pub output: String = "",
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        return self.diagnostics.iter_ref().any(|d| d.is_error());
    }

    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

fn bubble_to_parent(stack: &List<i32>, end: &mut List<i32>, flags: &mut List<NodeFlags>, child: i32) {
    if stack.len() > 0 {
        let parent = stack[stack.len() - 1];
        if end[child] > end[parent] {
            end[parent] = end[child];
        }
        flags[parent] = flags[parent] | flags[child] & NodeFlags::Error;
    }
}

pub struct TreeBuilder {
    tag: List<EventTag>,
    a: List<i32>,
    b: List<i32>,
    alt: List<i32>,
    open: List<i32>,
    last_finished: i32,
    error_row: i32,
}

impl TreeBuilder {
    pub fn with_capacity(rows: i32) -> TreeBuilder {
        return TreeBuilder {
            tag: List::with_capacity(rows),
            a: List::with_capacity(rows),
            b: List::with_capacity(rows),
            alt: List::with_capacity(rows),
            open: [],
            last_finished: -1,
            error_row: -1,
        };
    }

    fn push_row(&mut self, tag: EventTag, a: i32, b: i32) {
        if self.tag.len() >= self.tag.capacity() {
            builtin::cold_path();
            self.tag.grow();
            self.a.grow();
            self.b.grow();
            self.alt.grow();
            assert self.a.capacity() == self.tag.capacity()
                && self.b.capacity() == self.tag.capacity()
                && self.alt.capacity() == self.tag.capacity(), "TreeBuilder event columns must grow in lockstep";
        }
        self.tag.push_within_capacity(tag);
        self.a.push_within_capacity(a);
        self.b.push_within_capacity(b);
        self.alt.push_within_capacity(-1);
    }

    pub fn start_node(&mut self, kind: NodeKind, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, kind as i32, start);
        self.open.push(row);
    }

    pub fn start_error(&mut self, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, K_ERROR as i32, start);
        self.open.push(row);
    }

    pub fn set_alt(&mut self, alt: i32) {
        self.alt[self.open[self.open.len() - 1]] = alt;
    }

    pub fn checkpoint(&self) -> i32 {
        return self.tag.len();
    }

    pub fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32) {
        self.tag.insert(checkpoint, EventTag::Open);
        self.a.insert(checkpoint, kind as i32);
        self.b.insert(checkpoint, start);
        self.alt.insert(checkpoint, -1);
        self.open.push(checkpoint);
        if self.last_finished >= checkpoint {
            self.last_finished += 1;
        }
        if self.error_row >= checkpoint {
            self.error_row += 1;
        }
    }

    pub fn truncate(&mut self, checkpoint: i32) {
        self.tag.truncate(checkpoint);
        self.a.truncate(checkpoint);
        self.b.truncate(checkpoint);
        self.alt.truncate(checkpoint);
        while self.open.len() > 0 && self.open[self.open.len() - 1] >= checkpoint {
            let _ = self.open.pop();
        }
        if self.last_finished >= checkpoint {
            self.last_finished = -1;
        }
        if self.error_row > checkpoint {
            self.error_row = checkpoint;
        }
    }

    pub fn finish_node(&mut self, end: i32) {
        self.push_row(EventTag::Close, end, 0);
        self.last_finished = self.open[self.open.len() - 1];
        let _ = self.open.pop();
    }

    pub fn innermost_open(&self) -> i32 {
        if self.open.is_empty() {
            return -1;
        }
        return self.open[self.open.len() - 1];
    }

    pub fn node_kind(&self, row: i32) -> NodeKind {
        return self.a[row] as NodeKind;
    }

    pub fn resume_node(&mut self, row: i32, end: i32) {
        while self.innermost_open() > row {
            self.finish_node(end);
        }
        if self.innermost_open() == row {
            return;
        }
        assert self.last_finished == row && self.tag[self.tag.len() - 1] matches { Close }, "resume_node: a node no longer open is the last one closed";
        self.truncate(self.tag.len() - 1);
        self.open.push(row);
    }

    pub fn mark_error(&mut self) {
        self.error_row = self.tag.len();
    }

    pub fn in_error_mode(&self) -> bool {
        if self.error_row < 0 {
            return false;
        }
        for let mut r = self.error_row; r < self.tag.len(); r += 1 {
            if self.tag[r] matches { Tok } {
                return false;
            }
        }
        return true;
    }

    pub fn push_open_rule_names(&self, rule_names: &List<String>, out: &mut List<String>) {
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            let kind = self.a[self.open[i]];
            if kind != K_ERROR as i32 {
                out.push(rule_names[kind]);
            }
        }
    }

    pub fn token(&mut self, idx: i32) {
        self.push_row(EventTag::Tok, idx, 0);
    }

    pub fn missing(&mut self, syn_idx: i32) {
        self.push_row(EventTag::Miss, syn_idx, 0);
    }

    pub fn skip(&mut self, idx: i32) {
        self.push_row(EventTag::Skip, idx, 0);
    }

    pub fn finish(&self) -> CstStore {
        let n = self.tag.len();
        let mut b = self.b;
        let mut end = List::filled(n, 0);
        let mut flags = List::filled(n, NodeFlags::none());
        let mut next = List::filled(n, 0);
        let mut stack: List<i32> = [];
        for let mut r = 0; r < n; r += 1 {
            match self.tag[r] {
                Open => {
                    let node_kind = self.a[r];
                    let start_offset = self.b[r];
                    if node_kind == K_ERROR as i32 {
                        flags[r] = NodeFlags::Error;
                    }
                    end[r] = start_offset;
                    stack.push(r);
                },
                Miss => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Incomplete | NodeFlags::Error;
                },
                Skip => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Error;
                },
                Close => {
                    let oi = stack[stack.len() - 1];
                    let _ = stack.pop();
                    let close_offset = self.a[r];
                    let open_kind = self.a[oi];
                    if close_offset > end[oi] {
                        end[oi] = close_offset;
                    }
                    b[r] = open_kind;
                    next[oi] = r + 1;
                    bubble_to_parent(&stack, &mut end, &mut flags, oi);
                },
                Tok => {
                },
            }
        }
        while stack.len() > 0 {
            let oi = stack[stack.len() - 1];
            let _ = stack.pop();
            next[oi] = n;
            bubble_to_parent(&stack, &mut end, &mut flags, oi);
        }
        return CstStore { tag: self.tag, a: self.a, b, alt: self.alt, end, flags, next };
    }

    pub fn render_open(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if self.open.len() == 0 {
            return String::new();
        }
        return self.render_from(self.open[self.open.len() - 1], toks, rule_names, token_names);
    }

    pub fn render_at(
        &self,
        row: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if row < 0 || row >= self.tag.len() || !self.tag[row] matches { Open } {
            return String::new();
        }
        return self.render_from(row, toks, rule_names, token_names);
    }

    pub fn open_rule_names(&self, rule_names: &List<String>) -> String {
        let mut out = String::from("[");
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            if i < self.open.len() - 1 {
                out.push_str(", ");
            }
            let kind = self.a[self.open[i]];
            let name = if kind == K_ERROR as i32 { "<error>" } else { rule_names[kind] };
            out.push_str(&name);
        }
        out.push_str("]");
        return out;
    }

    pub fn render_last_finished(
        &self,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if self.last_finished < 0 {
            return String::new();
        }
        return self.render_from(self.last_finished, toks, rule_names, token_names);
    }

    fn render_from(
        &self,
        root: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(128);
        let _ = render_node(&mut out, &self.tag, &self.a, root, toks, rule_names, token_names);
        return out;
    }
}

fn render_node(
    out: &mut String,
    tag: &List<EventTag>,
    a: &List<i32>,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) -> i32 {
    let name = if a[i] == K_ERROR as i32 { "<error>" } else { rule_names[a[i]] };
    if i + 1 >= tag.len() || tag[i + 1] matches { Close } {
        out.push_str(&name);
        if i + 1 < tag.len() {
            return i + 2;
        }
        return i + 1;
    }
    out.push_str("(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < tag.len() {
        match tag[c] {
            Open => {
                out.push_str(" ");
                c = render_node(out, tag, a, c, toks, rule_names, token_names);
            },
            Close => {
                out.push_str(")");
                return c + 1;
            },
            Tok => {
                if !toks.is_empty_text(a[c]) {
                    out.push_str(" ");
                    toks.push_token_text_escaped(out, a[c]);
                }
                c += 1;
            },
            Miss => {
                out.push_str(` <missing ${token_names[toks.kind_at(a[c])]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(" <skip ");
                toks.push_token_text_escaped(out, a[c]);
                out.push_str(">");
                c += 1;
            },
        }
    }
    out.push_str(")");
    return c;
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let starts = line_starts(tokens.chars);
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &starts,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &starts,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    starts: &List<i32>,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let type_id = if is_eof { -1 } else { kind + 1 };
    let lc = line_col_at(starts, start);
    out.push_str(`[@${index},${start}:${end - 1}='`);
    if is_eof {
        out.push_str("<EOF>");
    } else {
        push_chars_escaped(out, tokens.chars, start, end);
    }
    out.push_str(`',<${type_id}>,`);
    if channel != 0 {
        out.push_str(`channel=${channel},`);
    }
    out.push_str(`${lc.0}:${lc.1}]\n`);
}
pub global ATN_BASIC: i32 = 1;
pub global ATN_RULE_START: i32 = 2;
pub global ATN_RULE_STOP: i32 = 3;
pub global ATN_BLOCK_START: i32 = 4;
pub global ATN_BLOCK_END: i32 = 5;
pub global ATN_STAR_LOOP_ENTRY: i32 = 6;
pub global ATN_STAR_LOOP_BACK: i32 = 7;
pub global ATN_PLUS_LOOP_BACK: i32 = 8;
pub global ATN_LOOP_END: i32 = 9;

pub global ATN_TR_EPSILON: i32 = 0;
pub global ATN_TR_ATOM: i32 = 1;
pub global ATN_TR_NOT_ATOM: i32 = 2;
pub global ATN_TR_WILDCARD: i32 = 3;
pub global ATN_TR_RULE: i32 = 4;
pub global ATN_TR_PRECEDENCE: i32 = 5;

pub struct AtnSim {
    pub state_kind: List<i32>,
    pub state_tr_start: List<i32>,
    pub state_tr_count: List<i32>,
    pub tr_kind: List<i32>,
    pub tr_target: List<i32>,
    pub tr_label: List<i32>,
    pub tr_follow: List<i32>,
    pub tr_prec: List<i32>,
    pub decision_state: List<i32>,
    pub rule_start: List<i32>,
    pub rule_nullable: List<bool> = [],
    pub rule_first: List<List<i32>> = [],
    pub rule_first_neg: List<List<i32>> = [],
    pub rule_first_open: List<bool> = [],
    pub state_cont_nullable: List<bool> = [],
    pub state_cont_first_start: List<i32> = [],
    pub state_cont_first_count: List<i32> = [],
    pub state_cont_neg_start: List<i32> = [],
    pub state_cont_neg_count: List<i32> = [],
    pub cont_first_label: List<i32> = [],
    pub cont_neg_label: List<i32> = [],
    pub state_cont_first_open: List<bool> = [],
    pub state_collapse_to: List<i32> = [],
    pub state_call_prec: List<i32>,
}

fn atn_read_u8(bytes: &ByteList, pos: i32) -> i32 {
    return bytes.get_byte_unchecked(pos) as i32;
}

fn atn_read_u16(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    return b0 | b1 << 8;
}

fn atn_read_u24(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    let b2 = bytes.get_byte_unchecked(pos + 2) as i32;
    return b0 | b1 << 8 | b2 << 16;
}

pub fn atn_decode(bytes: &ByteList) -> AtnSim {
    let mut p = 0;
    let nrules = atn_read_u16(bytes, p);
    p += 2;
    let ndec = atn_read_u16(bytes, p);
    p += 2;
    let nstates = atn_read_u16(bytes, p);
    p += 2;

    let mut rule_start: List<i32> = List::with_capacity(nrules);
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(atn_read_u16(bytes, p));
        p += 2;
    }
    let mut decision_state: List<i32> = List::with_capacity(ndec);
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let mut state_kind: List<i32> = List::with_capacity(nstates);
    for let mut i = 0; i < nstates; i += 1 {
        state_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut state_tr_start: List<i32> = List::with_capacity(nstates);
    let mut state_tr_count: List<i32> = List::with_capacity(nstates);
    let mut ntrans_total = 0;
    for let mut i = 0; i < nstates; i += 1 {
        let count = atn_read_u16(bytes, p);
        p += 2;
        state_tr_start.push(ntrans_total);
        state_tr_count.push(count);
        ntrans_total += count;
    }

    let mut tr_kind: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut tr_target: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_target.push(atn_read_u16(bytes, p) - 1);
        p += 2;
    }
    let mut tr_label: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_label.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_follow: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_follow.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_prec: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_prec.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let mut state_call_prec = List::filled(nstates, 0);
    for let mut j = 0; j < ntrans_total; j += 1 {
        if tr_kind[j] == ATN_TR_RULE {
            assert tr_follow[j] >= 0, "a rule transition returns to a follow state";
            state_call_prec[tr_follow[j]] = tr_prec[j];
        }
    }

    return AtnSim {
        state_kind,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
        state_call_prec,
    };
}

global ATN_ACCEPT_EOF: i32 = -2;

global ATN_CLOSURE_GUARD: i32 = 2000000;
global ATN_ARENA_CAP: i32 = 400000;

global ATN_NODE_PAIR_STRIDE: i64 = 1000000;

global CFG_KEY_PR_SLOT: i32 = 2048;
global CFG_KEY_ALT_SLOT: i32 = 2048;
global CFG_KEY_STATE_SLOT: i32 = 1048576;

global CTX_BOUNDARY: i32 = -3;
global CTX_UNKNOWN_RETURN: i32 = -4;

global CTX_EMPTY: i32 = 0;
global CTX_UNKNOWN: i32 = 1;

pub struct AtnState {
    pub stack: List<i32>,
    verdict_index: AtnKeyMap,
    verdict_next: List<i32>,
    verdict_start: List<i32>,
    verdict_alt: List<i32>,
    verdict_keys: List<i32>,
}

impl AtnState {
    pub fn new() -> AtnState {
        return AtnState {
            stack: [],
            verdict_index: AtnKeyMap::new(),
            verdict_next: [],
            verdict_start: [],
            verdict_alt: [],
            verdict_keys: [],
        };
    }

    fn question_hash(&self, decision: i32, pos: i32, min_prec: i32, depth: i32) -> i64 {
        let mut h: i64 = 1469598103934665603;
        h = (h ^ decision as i64) * 1099511628211;
        h = (h ^ pos as i64) * 1099511628211;
        h = (h ^ min_prec as i64) * 1099511628211;
        for let mut i = 0; i < depth; i += 1 {
            h = (h ^ self.stack[i] as i64 + 2) * 1099511628211;
        }
        return h & 4611686018427387903;
    }

    fn asks(&self, verdict: i32, decision: i32, pos: i32, min_prec: i32, depth: i32) -> bool {
        let s = self.verdict_start[verdict];
        if self.verdict_keys[s] != decision
            || self.verdict_keys[s + 1] != pos
            || self.verdict_keys[s + 2] != min_prec
            || self.verdict_keys[s + 3] != depth {
            return false;
        }
        for let mut i = 0; i < depth; i += 1 {
            if self.verdict_keys[s + 4 + i] != self.stack[i] {
                return false;
            }
        }
        return true;
    }

    fn recorded_verdict(&self, h: i64, decision: i32, pos: i32, min_prec: i32, depth: i32) -> i32 {
        let mut v = self.verdict_index.get(h);
        while v >= 0 && !self.asks(v, decision, pos, min_prec, depth) {
            v = self.verdict_next[v];
        }
        return v;
    }

    pub fn record_verdict(&mut self, decision: i32, pos: i32, min_prec: i32, depth: i32, alt: i32) {
        let h = self.question_hash(decision, pos, min_prec, depth);
        if self.recorded_verdict(h, decision, pos, min_prec, depth) >= 0 {
            return;
        }
        let v = self.verdict_start.len();
        self.verdict_start.push(self.verdict_keys.len());
        self.verdict_keys.push(decision);
        self.verdict_keys.push(pos);
        self.verdict_keys.push(min_prec);
        self.verdict_keys.push(depth);
        for let mut i = 0; i < depth; i += 1 {
            self.verdict_keys.push(self.stack[i]);
        }
        self.verdict_alt.push(alt);
        self.verdict_next.push(self.verdict_index.get(h));
        self.verdict_index.set(h, v);
    }
}

struct AtnKeyMap {
    keys: List<i64>,
    vals: List<i32>,
    used: List<i32>,
}

impl AtnKeyMap {
    fn new() -> AtnKeyMap {
        return AtnKeyMap::with_slots(64);
    }

    fn with_slots(slots: i32) -> AtnKeyMap {
        assert slots & slots - 1 == 0, "slot count is a power of two";
        return AtnKeyMap {
            keys: List::filled(slots, -1 as i64),
            vals: List::filled(slots, -1),
            used: [],
        };
    }

    fn clear(&mut self) {
        for let mut j = 0; j < self.used.len(); j += 1 {
            let s = self.used[j];
            self.keys[s] = -1;
            self.vals[s] = -1;
        }
        self.used.clear();
    }

    fn slot_of(&self, k: i64) -> i32 {
        assert k >= 0, "keys are non-negative";
        let mask = self.keys.len() - 1;
        let mut i = ((k ^ k >> 29) * 0x5851F42D4C957F2D >> 32) as i32 & mask;
        while self.keys[i] >= 0 && self.keys[i] != k {
            i = i + 1 & mask;
        }
        return i;
    }

    fn get(&self, k: i64) -> i32 {
        return self.vals[self.slot_of(k)];
    }

    fn set(&mut self, k: i64, v: i32) {
        if (self.used.len() + 1) * 2 > self.keys.len() {
            let mut grown = AtnKeyMap::with_slots(self.keys.len() * 2);
            for let mut j = 0; j < self.used.len(); j += 1 {
                let s = self.used[j];
                grown.set(self.keys[s], self.vals[s]);
            }
            *self = grown;
        }
        let i = self.slot_of(k);
        if self.keys[i] < 0 {
            self.keys[i] = k;
            self.used.push(i);
        }
        self.vals[i] = v;
    }
}

struct CtxArena {
    node_start: List<i32>,
    node_len: List<i32>,
    ret: List<i32>,
    rpr: List<i32>,
    parent: List<i32>,
    pending: List<i32>,
    intern_head: AtnKeyMap,
    intern_next: List<i32>,
    merge_cache: AtnKeyMap,
    cover_cache: AtnKeyMap,
}

struct AtnConfig {
    state: i32,
    alt: i32,
    pctx: i32,
    pr: i32,
}

impl CtxArena {
    fn new() -> CtxArena {
        let mut arena = CtxArena {
            node_start: [],
            node_len: [],
            ret: [],
            rpr: [],
            parent: [],
            pending: [],
            intern_head: AtnKeyMap::new(),
            intern_next: [],
            merge_cache: AtnKeyMap::new(),
            cover_cache: AtnKeyMap::new(),
        };
        let empty = arena.push(CTX_BOUNDARY, 0, CTX_EMPTY);
        let unknown = arena.push(CTX_UNKNOWN_RETURN, 0, CTX_EMPTY);
        assert empty == CTX_EMPTY && unknown == CTX_UNKNOWN, "the bottom and unknown-caller contexts are the arena's first nodes";
        return arena;
    }

    fn node_count(&self) -> i32 {
        return self.node_start.len();
    }

    fn push_caller_stack(&mut self, sim: &AtnSim, rstk: &List<i32>) -> i32 {
        if rstk.is_empty() {
            return CTX_UNKNOWN;
        }
        let mut ctx = CTX_EMPTY;
        for let mut k = 0; k < rstk.len(); k += 1 {
            if rstk[k] >= 0 {
                ctx = self.push(rstk[k], atn_invocation_prec(sim, rstk, k - 1), ctx);
            } else if k > 0 {
                ctx = CTX_UNKNOWN;
            }
        }
        return ctx;
    }

    fn append_edge(&mut self, return_state: i32, restore_pr: i32, parent: i32) {
        self.ret.push(return_state);
        self.rpr.push(restore_pr);
        self.parent.push(parent);
    }

    fn hash_edges(&self, s: i32, n: i32) -> i64 {
        let mut h: i64 = 1469598103934665603;
        for let mut e = s; e < s + n; e += 1 {
            h = (h ^ self.ret[e] as i64 + 1) * 1099511628211;
            h = (h ^ self.rpr[e] as i64 + 1) * 1099511628211;
            h = (h ^ self.parent[e] as i64 + 1) * 1099511628211;
        }
        return h & 4611686018427387903;
    }

    fn edges_eq(&self, node: i32, s: i32, n: i32) -> bool {
        if self.node_len[node] != n {
            return false;
        }
        let t = self.node_start[node];
        for let mut i = 0; i < n; i += 1 {
            if self.ret[t + i] != self.ret[s + i]
                || self.rpr[t + i] != self.rpr[s + i]
                || self.parent[t + i] != self.parent[s + i] {
                return false;
            }
        }
        return true;
    }

    fn intern_from(&mut self, s: i32) -> i32 {
        let n = self.ret.len() - s;
        assert n > 0, "a context has at least one edge";
        let h = self.hash_edges(s, n);
        let head = self.intern_head.get(h);
        let mut cand = head;
        while cand >= 0 {
            if self.edges_eq(cand, s, n) {
                self.ret.truncate(s);
                self.rpr.truncate(s);
                self.parent.truncate(s);
                return cand;
            }
            cand = self.intern_next[cand];
        }
        let id = self.node_start.len();
        self.node_start.push(s);
        self.node_len.push(n);
        self.intern_next.push(head);
        self.intern_head.set(h, id);
        return id;
    }

    fn push(&mut self, return_state: i32, restore_pr: i32, parent: i32) -> i32 {
        let s = self.ret.len();
        self.append_edge(return_state, restore_pr, parent);
        return self.intern_from(s);
    }

    fn key_cmp(&self, x: i32, y: i32) -> i32 {
        if self.ret[x] != self.ret[y] {
            return if self.ret[x] < self.ret[y] { -1 } else { 1 };
        }
        if self.rpr[x] != self.rpr[y] {
            return if self.rpr[x] < self.rpr[y] { -1 } else { 1 };
        }
        return 0;
    }

    fn merge(&mut self, a: i32, b: i32) -> i32 {
        if a == b {
            return a;
        }
        let ck = if a < b { atn_node_pair_key(a, b) } else { atn_node_pair_key(b, a) };
        let cached = self.merge_cache.get(ck);
        if cached >= 0 {
            return cached;
        }
        let sa = self.node_start[a];
        let na = self.node_len[a];
        let sb = self.node_start[b];
        let nb = self.node_len[b];
        let base = self.pending.len();
        let mut i = 0;
        let mut j = 0;
        while i < na && j < nb {
            let c = self.key_cmp(sa + i, sb + j);
            if c < 0 {
                i += 1;
            } else if c > 0 {
                j += 1;
            } else {
                let m = self.merge(self.parent[sa + i], self.parent[sb + j]);
                self.pending.push(m);
                i += 1;
                j += 1;
            }
        }
        let s = self.ret.len();
        let mut k = base;
        i = 0;
        j = 0;
        while i < na || j < nb {
            let c = if i >= na {
                1;
            } else if j >= nb {
                -1;
            } else {
                self.key_cmp(sa + i, sb + j);
            };
            if c < 0 {
                self.append_edge(self.ret[sa + i], self.rpr[sa + i], self.parent[sa + i]);
                i += 1;
            } else if c > 0 {
                self.append_edge(self.ret[sb + j], self.rpr[sb + j], self.parent[sb + j]);
                j += 1;
            } else {
                self.append_edge(self.ret[sa + i], self.rpr[sa + i], self.pending[k]);
                k += 1;
                i += 1;
                j += 1;
            }
        }
        self.pending.truncate(base);
        let id = self.intern_from(s);
        self.merge_cache.set(ck, id);
        return id;
    }

    fn covers(&mut self, outer: i32, inner: i32) -> bool {
        if outer == inner {
            return true;
        }
        let ck = atn_node_pair_key(outer, inner);
        let cached = self.cover_cache.get(ck);
        if cached >= 0 {
            return cached == 1;
        }
        let so = self.node_start[outer];
        let no = self.node_len[outer];
        let si = self.node_start[inner];
        let ni = self.node_len[inner];
        let mut i = 0;
        let mut covered = true;
        for let mut j = 0; j < ni; j += 1 {
            while i < no && self.key_cmp(so + i, si + j) < 0 {
                i += 1;
            }
            if i >= no || self.key_cmp(so + i, si + j) != 0 || !self.covers(self.parent[so + i], self.parent[si + j]) {
                covered = false;
                break;
            }
            i += 1;
        }
        self.cover_cache.set(ck, if covered { 1 } else { 0 });
        return covered;
    }
}

fn atn_node_pair_key(a: i32, b: i32) -> i64 {
    assert ATN_NODE_PAIR_STRIDE > ATN_ARENA_CAP as i64, "the pair-key stride must exceed the arena cap, or two node id pairs alias onto one key";
    return a as i64 * ATN_NODE_PAIR_STRIDE + b as i64;
}

fn atn_state_pr_key(state: i32, pr: i32) -> i64 {
    assert pr + 2 < CFG_KEY_PR_SLOT, `ATN config precedence ${pr} exceeds packed-key slot`;
    assert state + 2 < CFG_KEY_STATE_SLOT, `ATN config state ${state} exceeds packed-key slot`;
    return (state + 2) as i64 * CFG_KEY_PR_SLOT as i64 + (pr + 2) as i64;
}

pub fn atn_invocation_prec(sim: &AtnSim, rstk: &List<i32>, k: i32) -> i32 {
    if k < 0 || rstk[k] < 0 {
        return 0;
    }
    return sim.state_call_prec[rstk[k]];
}

fn atn_state_consumes(sim: &AtnSim, state: i32) -> bool {
    let cnt = sim.state_tr_count[state];
    if cnt == 0 {
        return false;
    }
    let k = sim.tr_kind[sim.state_tr_start[state]];
    return k == ATN_TR_ATOM || k == ATN_TR_NOT_ATOM || k == ATN_TR_WILDCARD;
}

struct CfgSet {
    state: List<i32>,
    alt: List<i32>,
    pr: List<i32>,
    pctx: List<i32>,
    index: AtnKeyMap,
}

impl CfgSet {
    fn new() -> CfgSet {
        return CfgSet {
            state: [],
            alt: [],
            pr: [],
            pctx: [],
            index: AtnKeyMap::new(),
        };
    }

    fn clear(&mut self) {
        self.state.clear();
        self.alt.clear();
        self.pr.clear();
        self.pctx.clear();
        self.index.clear();
    }

    fn add(&mut self, arena: &mut CtxArena, state: i32, alt: i32, pr: i32, pctx: i32) -> [i32, bool] {
        assert alt + 1 < CFG_KEY_ALT_SLOT, `ATN config alt ${alt} exceeds packed-key slot`;
        let k = atn_state_pr_key(state, pr) * CFG_KEY_ALT_SLOT as i64 + (alt + 1) as i64;
        let found = self.index.get(k);
        if found >= 0 {
            let merged = arena.merge(self.pctx[found], pctx);
            let changed = merged != self.pctx[found];
            self.pctx[found] = merged;
            return [found, changed];
        }
        let i = self.state.len();
        self.state.push(state);
        self.alt.push(alt);
        self.pr.push(pr);
        self.pctx.push(pctx);
        self.index.set(k, i);
        return [i, true];
    }

    fn to_list(&self) -> List<AtnConfig> {
        let mut out: List<AtnConfig> = [];
        for let mut i = 0; i < self.state.len(); i += 1 {
            out.push(AtnConfig {
                state: self.state[i],
                alt: self.alt[i],
                pctx: self.pctx[i],
                pr: self.pr[i],
            });
        }
        return out;
    }
}

struct ClosureScratch {
    cset: CfgSet,
    rset: CfgSet,
    work: List<AtnConfig>,
    expanded: List<i32>,
}

impl ClosureScratch {
    fn new() -> ClosureScratch {
        return ClosureScratch {
            cset: CfgSet::new(),
            rset: CfgSet::new(),
            work: [],
            expanded: [],
        };
    }
}

fn atn_closure(
    sim: &AtnSim,
    arena: &mut CtxArena,
    seeds: &List<AtnConfig>,
    scratch: &mut ClosureScratch,
) -> List<AtnConfig> {
    scratch.cset.clear();
    scratch.rset.clear();
    scratch.expanded.clear();
    scratch.work.clear();
    scratch.work.extend(seeds);
    let mut guard = 0;
    while let Some(c) = scratch.work.pop() {
        guard += 1;
        if guard > ATN_CLOSURE_GUARD {
            break;
        }
        let res = scratch.cset.add(arena, c.state, c.alt, c.pr, c.pctx);
        let idx = res.0;
        while scratch.expanded.len() <= idx {
            scratch.expanded.push(-9);
        }
        let merged_pctx = scratch.cset.pctx[idx];
        if scratch.expanded[idx] == merged_pctx {
            continue;
        }
        scratch.expanded[idx] = merged_pctx;
        let cur = AtnConfig { state: c.state, alt: c.alt, pctx: merged_pctx, pr: c.pr };
        atn_expand(sim, arena, &cur, &mut scratch.work, &mut scratch.rset);
    }
    return scratch.rset.to_list();
}

fn atn_expand(sim: &AtnSim, arena: &mut CtxArena, cur: &AtnConfig, work: &mut List<AtnConfig>, rset: &mut CfgSet) {
    if cur.state == ATN_ACCEPT_EOF {
        rset.add(arena, cur.state, cur.alt, cur.pr, cur.pctx);
        return;
    }
    if sim.state_kind[cur.state] == ATN_RULE_STOP {
        atn_pop(arena, cur, work, rset);
        return;
    }
    if atn_state_consumes(sim, cur.state) {
        rset.add(arena, cur.state, cur.alt, cur.pr, cur.pctx);
        return;
    }
    let pctx = atn_collapse_into_caller_loop(sim, arena, cur, work);
    if pctx < 0 {
        return;
    }
    let start = sim.state_tr_start[cur.state];
    let cnt = sim.state_tr_count[cur.state];
    for let mut j = 0; j < cnt; j += 1 {
        let k = sim.tr_kind[start + j];
        let target = sim.tr_target[start + j];
        if k == ATN_TR_EPSILON {
            work.push(AtnConfig { state: target, alt: cur.alt, pctx, pr: cur.pr });
        } else if k == ATN_TR_PRECEDENCE {
            if sim.tr_prec[start + j] >= cur.pr {
                work.push(AtnConfig { state: target, alt: cur.alt, pctx, pr: cur.pr });
            }
        } else if k == ATN_TR_RULE {
            if target < 0 || arena.node_count() >= ATN_ARENA_CAP {
                continue;
            }
            let npctx = arena.push(sim.tr_follow[start + j], cur.pr, pctx);
            work.push(AtnConfig { state: target, alt: cur.alt, pctx: npctx, pr: sim.tr_prec[start + j] });
        }
    }
}

fn atn_collapse_into_caller_loop(sim: &AtnSim, arena: &mut CtxArena, cur: &AtnConfig, work: &mut List<AtnConfig>) -> i32 {
    if sim.state_collapse_to.is_empty() {
        return cur.pctx;
    }
    let s = arena.node_start[cur.pctx];
    let n = arena.node_len[cur.pctx];
    let mut collapses = false;
    for let mut e = s; e < s + n; e += 1 {
        if atn_edge_collapses(sim, arena, e, cur) {
            collapses = true;
            break;
        }
    }
    if !collapses {
        return cur.pctx;
    }
    let kept = arena.ret.len();
    for let mut e = s; e < s + n; e += 1 {
        if atn_edge_collapses(sim, arena, e, cur) {
            work.push(AtnConfig { state: cur.state, alt: cur.alt, pctx: arena.parent[e], pr: arena.rpr[e] });
        } else {
            arena.append_edge(arena.ret[e], arena.rpr[e], arena.parent[e]);
        }
    }
    if arena.ret.len() == kept {
        return -1;
    }
    return arena.intern_from(kept);
}

fn atn_edge_collapses(sim: &AtnSim, arena: &CtxArena, e: i32, cur: &AtnConfig) -> bool {
    let r = arena.ret[e];
    return r >= 0 && sim.state_collapse_to[r] == cur.state && cur.pr >= arena.rpr[e];
}

fn atn_pop(arena: &mut CtxArena, cur: &AtnConfig, work: &mut List<AtnConfig>, rset: &mut CfgSet) {
    let s = arena.node_start[cur.pctx];
    let n = arena.node_len[cur.pctx];
    for let mut e = s; e < s + n; e += 1 {
        let r = arena.ret[e];
        if r == CTX_BOUNDARY {
            rset.add(arena, ATN_ACCEPT_EOF, cur.alt, cur.pr, CTX_EMPTY);
        } else if r == CTX_UNKNOWN_RETURN {
            rset.add(arena, cur.state, cur.alt, cur.pr, CTX_UNKNOWN);
        } else {
            work.push(AtnConfig { state: r, alt: cur.alt, pctx: arena.parent[e], pr: arena.rpr[e] });
        }
    }
}

fn atn_move(sim: &AtnSim, configs: &List<AtnConfig>, token: i32, eof: i32) -> List<AtnConfig> {
    let mut out: List<AtnConfig> = [];
    for let c of configs {
        if c.state == ATN_ACCEPT_EOF {
            if token == eof {
                out.push(*c);
            }
            continue;
        }
        if sim.state_kind[c.state] == ATN_RULE_STOP {
            out.push(*c);
            continue;
        }
        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let label = sim.tr_label[start + j];
            let matched = if k == ATN_TR_ATOM {
                label == token;
            } else if k == ATN_TR_WILDCARD {
                token != eof;
            } else if k == ATN_TR_NOT_ATOM {
                token != label && token != eof;
            } else {
                false;
            };
            if matched {
                out.push(AtnConfig { state: sim.tr_target[start + j], alt: c.alt, pctx: c.pctx, pr: c.pr });
            }
        }
    }
    return out;
}

fn atn_unique_alts(configs: &List<AtnConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return alts;
}

fn atn_min_alt(sorted_alts: &List<i32>) -> i32 {
    return if sorted_alts.is_empty() { -1 } else { sorted_alts[0] };
}

fn atn_min_alt_covers_rest(arena: &mut CtxArena, configs: &List<AtnConfig>, min_alt: i32) -> bool {
    let mut min_ctx = AtnKeyMap::new();
    for let c of configs {
        if c.alt == min_alt {
            min_ctx.set(atn_state_pr_key(c.state, c.pr), c.pctx);
        }
    }
    for let c of configs {
        if c.alt != min_alt {
            let e = min_ctx.get(atn_state_pr_key(c.state, c.pr));
            if e < 0 || !arena.covers(e, c.pctx) {
                return false;
            }
        }
    }
    return true;
}

fn atn_all_at_end(sim: &AtnSim, configs: &List<AtnConfig>) -> bool {
    if configs.is_empty() {
        return false;
    }
    for let c of configs {
        if c.state != ATN_ACCEPT_EOF && sim.state_kind[c.state] != ATN_RULE_STOP {
            return false;
        }
    }
    return true;
}

pub global ATN_NO_DISABLED: List<i32> = [];

pub fn atn_predict_once(
    sim: &AtnSim,
    decision: i32,
    atn: &mut AtnState,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let depth = atn.stack.len();
    let v = atn.recorded_verdict(atn.question_hash(decision, pos, min_prec, depth), decision, pos, min_prec, depth);
    if v >= 0 {
        return atn.verdict_alt[v];
    }
    let alt = atn_predict_with_stack(sim, decision, &atn.stack, tokens, pos, eof, min_prec);
    atn.record_verdict(decision, pos, min_prec, depth, alt);
    return alt;
}

pub fn atn_predict_with_stack(
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32 = 0,
    disabled_alts: &List<i32> = &ATN_NO_DISABLED,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let start = sim.state_tr_start[dstate];
    let cnt = sim.state_tr_count[dstate];
    let mut arena = CtxArena::new();
    let caller = arena.push_caller_stack(sim, rule_stack);
    let mut seeds: List<AtnConfig> = [];
    for let mut j = 0; j < cnt; j += 1 {
        if sim.tr_kind[start + j] == ATN_TR_PRECEDENCE && sim.tr_prec[start + j] < min_prec {
            continue;
        }
        if !disabled_alts.is_empty() && disabled_alts.contains(&j) {
            continue;
        }
        seeds.push(AtnConfig { state: sim.tr_target[start + j], alt: j, pctx: caller, pr: min_prec });
    }
    let mut scratch = ClosureScratch::new();
    let mut configs = atn_closure(sim, &mut arena, &seeds, &mut scratch);
    let mut pos = start_pos;
    let mut prev = atn_unique_alts(&configs);
    let limit = tokens.len() - start_pos + 8;
    let mut guard = 0;
    loop {
        guard += 1;
        if guard > limit {
            return atn_min_alt(&prev);
        }
        let alts = atn_unique_alts(&configs);
        if alts.is_empty() {
            return atn_min_alt(&prev);
        }
        if alts.len() == 1 {
            return alts[0];
        }
        if atn_min_alt_covers_rest(&mut arena, &configs, alts[0]) {
            return alts[0];
        }
        if atn_all_at_end(sim, &configs) {
            return alts[0];
        }
        prev = alts;
        let token = if pos < tokens.len() { tokens[pos] } else { eof };
        let moved = atn_move(sim, &configs, token, eof);
        pos += 1;
        configs = atn_closure(sim, &mut arena, &moved, &mut scratch);
    }
}
pub global TK_WS: i32 = 0;
pub global TK_EOF: i32 = 1;
pub global TK_ERROR: i32 = 2;
pub global TK_LIT_c: i32 = 3;
pub global TK_LIT_a: i32 = 4;
pub global TK_LIT_b: i32 = 5;
pub global TK_LIT_k: i32 = 6;
pub global TK_LIT_x: i32 = 7;
pub global TK_LIT_y: i32 = 8;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ' ' { return -1; }
    pos += 1;
    return pos;
}

fn try_lit_c(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'c' { return -1; }
    return pos + 1;
}

fn try_lit_a(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'a' { return -1; }
    return pos + 1;
}

fn try_lit_b(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'b' { return -1; }
    return pos + 1;
}

fn try_lit_k(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'k' { return -1; }
    return pos + 1;
}

fn try_lit_x(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'x' { return -1; }
    return pos + 1;
}

fn try_lit_y(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'y' { return -1; }
    return pos + 1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        match first_char {
            ' ' => {
                end = try_WS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_WS; }
            },
            'a' => {
                end = try_lit_a(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_a; }
            },
            'b' => {
                end = try_lit_b(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_b; }
            },
            'c' => {
                end = try_lit_c(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_c; }
            },
            'k' => {
                end = try_lit_k(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_k; }
            },
            'x' => {
                end = try_lit_x(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_x; }
            },
            'y' => {
                end = try_lit_y(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_y; }
            },
            _ => {},
        }
        if best_end <= start {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_c => "'c'",
        TK_LIT_a => "'a'",
        TK_LIT_b => "'b'",
        TK_LIT_k => "'k'",
        TK_LIT_x => "'x'",
        TK_LIT_y => "'y'",
        _ => "Unknown",
    };
}

pub global RK_TAKES: NodeKind = 0;
pub global RK_XT: NodeKind = 1;
pub global RK_REJECTS: NodeKind = 2;
pub global RK_XR: NodeKind = 3;
pub global RK_CTXKEEP: NodeKind = 4;
pub global RK_CK: NodeKind = 5;
pub global RK_CTXDROP: NodeKind = 6;
pub global RK_CD: NodeKind = 7;
pub global RK_ALLFALSE: NodeKind = 8;
pub global RK_AF: NodeKind = 9;
pub global RK_SCANNED: NodeKind = 10;
pub global RK_XG: NodeKind = 11;

global RULE_NAMES: List<String> = ["takes", "xt", "rejects", "xr", "ctxkeep", "ck", "ctxdrop", "cd", "allfalse", "af", "scanned", "xg"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    site: i32,
    sites: List<i32>,
    atn: AtnState,
    atn_ret_pending: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    line_starts: List<i32>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, site: -1, sites: [], atn: AtnState::new(), atn_ret_pending: -1, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], line_starts: line_starts(tokens.chars) };
    }

    fn emit(&mut self, s: String) {
        self.tokens.output.push_str(&s);
    }

    fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.chars[j] == '-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.chars[j];
            if c.is_ascii_digit() {
                acc = acc * 10 + (c as i32 - '0' as i32);
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    fn token_line(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).0;
    }

    fn token_col(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).1;
    }

    fn token_start(&self, i: i32) -> i32 {
        return self.tokens.starts[i];
    }

    fn la(&self, k: i32) -> i32 {
        return self.peek_at(k - 1);
    }

    fn lt(&self, k: i32) -> i32 {
        let idx = self.pos + k - 1;
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    fn text_span(&self, start: i32, end: i32) -> String {
        let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };
        return chars_text(self.tokens.chars, start, hi);
    }

    fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.chars.len());
    }

    fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.recovering = true;
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
        }
        self.recovering = true;
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail_expecting(&([kind] as List<i32>));
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn recover_rule(&mut self, rule: NodeKind, name: String, row: i32) -> bool {
        if self.speculating || self.diagnostics.len() >= self.max_errors {
            self.push_rule_stack(name);
            return false;
        }
        let node = if row < 0 { self.b.innermost_open() } else { row };
        self.b.resume_node(node, self.last_end());
        assert self.b.node_kind(node) == rule, "recover_rule: the resumed node is the failed rule's";
        self.commit_pending();
        self.recovering = false;
        self.skip_until(&self.resync_set(&[]));
        return true;
    }

    fn commit_pending(&mut self) {
        let Some(d) = self.pending else { return; };
        self.pending = null;
        let mut diag = d;
        self.b.push_open_rule_names(&RULE_NAMES, &mut diag.rule_stack);
        self.report(diag);
    }

    fn report(&mut self, diag: Diagnostic) {
        if self.b.in_error_mode() { return; }
        self.diagnostics.push(diag);
        self.b.mark_error();
    }

    fn resync_set(&self, base: &List<i32>) -> List<i32> {
        let mut set = *base;
        for let s of &self.sites {
            if *s < 0 { continue; }
            let f = &CALL_FOLLOW_SETS[CALL_FOLLOW[*s]];
            while set.len() < f.len() { set.push(0); }
            for let mut i = 0; i < f.len(); i += 1 { set[i] = set[i] | f[i]; }
        }
        return set;
    }

    fn follows_rules_under_way(&self, k: i32) -> bool {
        for let mut i = self.sites.len() - 1; i >= 0; i -= 1 {
            let s = self.sites[i];
            if s < 0 { return i == 0 && k == TK_EOF; }
            if kind_set_has(&CALL_FOLLOW_SETS[CALL_FOLLOW[s]], k) { return true; }
            if !CALL_FOLLOW_ENDS[s] { return false; }
        }
        return k == TK_EOF;
    }

    fn skip_until(&mut self, set: &List<i32>) {
        loop {
            let k = self.kinds[self.pos];
            if k == TK_EOF || kind_set_has(set, k) { break; }
            self.skip_one();
        }
    }

    fn skip_one(&mut self) {
        let _sk = self.advance();
        self.tokens.mark_skipped(_sk);
        self.b.skip(_sk);
    }

    fn sync_delete(&mut self, expected: &List<i32>, names: &List<i32>) -> bool {
        if self.speculating || self.kinds[self.pos] == TK_EOF || !kind_set_has(expected, self.peek_at(1)) {
            return false;
        }
        self.report_extraneous(names, RecoveryAction::Deleted);
        self.skip_one();
        return true;
    }

    fn sync_enter(&mut self, expected: &List<i32>, names: &List<i32>) {
        if !self.recovering && !self.sync_delete(expected, names) {
            self.fail_expecting(names);
        }
    }

    fn sync_alts(&mut self, expected: &List<i32>, names: &List<i32>) {
        if !self.recovering && !self.sync_delete(expected, names) {
            self.no_viable("no viable alternative", self.peek_span(), names);
        }
    }

    fn sync_back(&mut self, expected: &List<i32>, names: &List<i32>) {
        if self.recovering || self.kinds[self.pos] == TK_EOF { return; }
        if self.speculating {
            self.fail_expecting(names);
            return;
        }
        self.report_extraneous(names, RecoveryAction::SkippedTo);
        self.skip_until(&self.resync_set(expected));
    }

    fn fail_expecting(&mut self, names: &List<i32>) {
        let code = if self.kinds[self.pos] == TK_EOF { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
        self.fail_on_token("got", names, code);
    }

    fn report_extraneous(&mut self, names: &List<i32>, recovery: RecoveryAction) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), *names, self.kinds[self.pos], recovery));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let found = self.kinds[self.pos];
        let at_eof = found == TK_EOF;
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.report(Diagnostic::error(code, `missing ${token_display_name(kind)}`, self.tokens.span_at(self.pos), [kind], found, recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>, may_end_rule: bool) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extraneous(&[kind], RecoveryAction::Deleted);
            self.skip_one();
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if kind_set_has(sync, self.kinds[self.pos]) || may_end_rule && self.follows_rules_under_way(self.kinds[self.pos]) {
            self.report_missing(kind);
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            if !may_end_rule && self.kinds[self.pos] == TK_EOF {
                self.fail_on_kind(kind);
                return self.pos;
            }
            self.report_unexpected(kind);
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || kind_set_has(sync, _k) { break; }
                    self.skip_one();
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        let kind = self.kinds[self.pos];
        if kind == TK_EOF {
            self.b.token(self.pos);
            return self.pos;
        }
        let _i = self.advance();
        self.b.token(_i);
        return _i;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("expected any token; got", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !kind_set_has(excluded, k) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("unexpected token", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>, expected: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if kind_set_has(included, k) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("got", expected, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

struct CkVals {
    mode: i32 = 0,
}

struct CdVals {
    mode: i32 = 0,
}

fn scan_scanned_alt_0(tokens: &Array<i32>, pos: i32, atn: &mut AtnState) -> i32 {
    let mut pos = pos;
    atn.stack.push(133);
    pos = scan_xg(tokens, pos, atn);
    atn.stack.pop();
    if pos < 0 { return -1; }
    if pos < tokens.len() && tokens[pos] == TK_LIT_c {
        pos += 1;
    }
    while pos < tokens.len() && tokens[pos] == TK_LIT_k {
        pos += 1;
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_x { return -1; }
    pos += 1;
    return pos;
}

fn scan_scanned_alt_1(tokens: &Array<i32>, pos: i32, atn: &mut AtnState) -> i32 {
    let mut pos = pos;
    atn.stack.push(147);
    pos = scan_xg(tokens, pos, atn);
    atn.stack.pop();
    if pos < 0 { return -1; }
    if pos < tokens.len() && tokens[pos] == TK_LIT_c {
        pos += 1;
    }
    while pos < tokens.len() && tokens[pos] == TK_LIT_k {
        pos += 1;
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_y { return -1; }
    pos += 1;
    return pos;
}

fn scan_scanned(tokens: &Array<i32>, pos: i32, atn: &mut AtnState) -> i32 {
    let start = pos;
    let mut pos = pos;
    let kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if kind == TK_LIT_a {
        let mut best: i32 = -1;
        let try_0_end = scan_scanned_alt_0(tokens, start, atn);
        if try_0_end > best { best = try_0_end; }
        let try_1_end = scan_scanned_alt_1(tokens, start, atn);
        if try_1_end > best { best = try_1_end; }
        if best >= 0 { pos = best; return pos; }
        return -1;
    }
    return -1;
}

fn scan_xg_alt_0(tokens: &Array<i32>, pos: i32, atn: &mut AtnState) -> i32 {
    let mut pos = pos;
    if !(( false )) { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_a { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_b { return -1; }
    pos += 1;
    return pos;
}

fn scan_xg_alt_1(tokens: &Array<i32>, pos: i32, atn: &mut AtnState) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_a { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_b { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_c { return -1; }
    pos += 1;
    return pos;
}

fn scan_xg(tokens: &Array<i32>, pos: i32, atn: &mut AtnState) -> i32 {
    let start = pos;
    let mut pos = pos;
    let kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if kind == TK_LIT_a {
        let mut _atn_disabled: List<i32> = [];
        if !(( false )) { _atn_disabled.push(0); }
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 10, &atn.stack, tokens, pos, TK_EOF, 0, &_atn_disabled);
        if _atn_alt < 0 {
            return -1;
        }
        if _atn_alt == 1 {
            return scan_xg_alt_1(tokens, start, atn);
        }
        return scan_xg_alt_0(tokens, start, atn);
    }
    return -1;
}

fn _parse_takes__inner(p: &mut Parser) -> () {
    p.site = 0;
    p.atn_ret_pending = 28;
    _parse_xt(p);
    p.expect(TK_LIT_c, &EMPTY_SYNC, true);
    return;
}

fn _parse_takes(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_TAKES, _start);
    _parse_takes__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_TAKES, "takes", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

