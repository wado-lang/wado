    }
    return;
}

fn _parse_scanned__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_2, p.kinds[p.pos]) { p.sync_alts(&SYNC_2, &EXPECTED_2); }
    let kind = p.peek_kind();
    if kind == TK_LIT_a {
        let _sd_tokens = &p.kinds;
        let _sd_pos = p.pos;
        let _sd_p_0 = scan_scanned_alt_0(_sd_tokens, _sd_pos, &mut p.atn);
        let _sd_p_1 = scan_scanned_alt_1(_sd_tokens, _sd_pos, &mut p.atn);
        let mut _sd_best_i: i32 = -1;
        let mut _sd_best_p: i32 = -1;
        if _sd_p_0 > _sd_best_p {
            _sd_best_p = _sd_p_0;
            _sd_best_i = 0;
        }
        if _sd_p_1 > _sd_best_p {
            _sd_best_p = _sd_p_1;
            _sd_best_i = 1;
        }
        if _sd_best_i == 0 {
            return _parse_scanned__inner_alt_0(p);
        }
        return _parse_scanned__inner_alt_1(p);
    }
    p.no_viable(
        "no alternative of scanned matches",
        p.peek_span(),
        &EXPECTED_2,
    );
    return;
}

fn _parse_scanned(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_SCANNED, _start);
    _parse_scanned__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_SCANNED, "scanned", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

