fn try_NUM(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { '0'..='9' | '٠'..='٩' | '۰'..='۹' | '߀'..='߉' | '०'..='९' | '০'..='৯' | '੦'..='੯' | '૦'..='૯' | '୦'..='୯' | '௦'..='௯' | '౦'..='౯' | '೦'..='೯' | '൦'..='൯' | '෦'..='෯' | '๐'..='๙' | '໐'..='໙' | '༠'..='༩' | '၀'..='၉' | '႐'..='႙' | '០'..='៩' | '᠐'..='᠙' | '᥆'..='᥏' | '᧐'..='᧙' | '᪀'..='᪉' | '᪐'..='᪙' | '᭐'..='᭙' | '᮰'..='᮹' | '᱀'..='᱉' | '᱐'..='᱙' | '꘠'..='꘩' | '꣐'..='꣙' | '꤀'..='꤉' | '꧐'..='꧙' | '꧰'..='꧹' | '꩐'..='꩙' | '꯰'..='꯹' | '０'..='９' | '𐒠'..='𐒩' | '𐴰'..='𐴹' | '𐵀'..='𐵉' | '𑁦'..='𑁯' | '𑃰'..='𑃹' | '𑄶'..='𑄿' | '𑇐'..='𑇙' | '𑋰'..='𑋹' | '𑑐'..='𑑙' | '𑓐'..='𑓙' | '𑙐'..='𑙙' | '𑛀'..='𑛉' | '𑛐'..='𑛣' | '𑜰'..='𑜹' | '𑣠'..='𑣩' | '𑥐'..='𑥙' | '𑯰'..='𑯹' | '𑱐'..='𑱙' | '𑵐'..='𑵙' | '𑶠'..='𑶩' | '𑷠'..='𑷩' | '𑽐'..='𑽙' | '𖄰'..='𖄹' | '𖩠'..='𖩩' | '𖫀'..='𖫉' | '𖭐'..='𖭙' | '𖵰'..='𖵹' | '𜳰'..='𜳹' | '𝟎'..='𝟿' | '𞅀'..='𞅉' | '𞋰'..='𞋹' | '𞓰'..='𞓹' | '𞗱'..='𞗺' | '𞥐'..='𞥙' | '🯰'..='🯹' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_2 = pos;
        rep_2: {
            if pos >= chars.len() { break rep_2; }
            if !((chars[pos] matches { '0'..='9' | '٠'..='٩' | '۰'..='۹' | '߀'..='߉' | '०'..='९' | '০'..='৯' | '੦'..='੯' | '૦'..='૯' | '୦'..='୯' | '௦'..='௯' | '౦'..='౯' | '೦'..='೯' | '൦'..='൯' | '෦'..='෯' | '๐'..='๙' | '໐'..='໙' | '༠'..='༩' | '၀'..='၉' | '႐'..='႙' | '០'..='៩' | '᠐'..='᠙' | '᥆'..='᥏' | '᧐'..='᧙' | '᪀'..='᪉' | '᪐'..='᪙' | '᭐'..='᭙' | '᮰'..='᮹' | '᱀'..='᱉' | '᱐'..='᱙' | '꘠'..='꘩' | '꣐'..='꣙' | '꤀'..='꤉' | '꧐'..='꧙' | '꧰'..='꧹' | '꩐'..='꩙' | '꯰'..='꯹' | '０'..='９' | '𐒠'..='𐒩' | '𐴰'..='𐴹' | '𐵀'..='𐵉' | '𑁦'..='𑁯' | '𑃰'..='𑃹' | '𑄶'..='𑄿' | '𑇐'..='𑇙' | '𑋰'..='𑋹' | '𑑐'..='𑑙' | '𑓐'..='𑓙' | '𑙐'..='𑙙' | '𑛀'..='𑛉' | '𑛐'..='𑛣' | '𑜰'..='𑜹' | '𑣠'..='𑣩' | '𑥐'..='𑥙' | '𑯰'..='𑯹' | '𑱐'..='𑱙' | '𑵐'..='𑵙' | '𑶠'..='𑶩' | '𑷠'..='𑷩' | '𑽐'..='𑽙' | '𖄰'..='𖄹' | '𖩠'..='𖩩' | '𖫀'..='𖫉' | '𖭐'..='𖭙' | '𖵰'..='𖵹' | '𜳰'..='𜳹' | '𝟎'..='𝟿' | '𞅀'..='𞅉' | '𞋰'..='𞋹' | '𞓰'..='𞓹' | '𞗱'..='𞗺' | '𞥐'..='𞥙' | '🯰'..='🯹' })) { break rep_2; }
            pos += 1;
            continue;
        }
        pos = rep_saved_2;
        break;
    }
    return pos;
}

fn try_SPACE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { ' ' | ' ' | ' ' | ' '..=' ' | ' ' | ' ' | '　' })) { return -1; }
    pos += 1;
    return pos;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char matches { ' ' | ' ' | ' ' | ' ' | ' ' | '　' } {
            end = try_SPACE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SPACE; }
