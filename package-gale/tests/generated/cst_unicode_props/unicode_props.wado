}

fn try_NUM(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { '0'..='9' | '٠'..='٩' | '۰'..='۹' | '߀'..='߉' | '०'..='९' | '০'..='৯' | '੦'..='੯' | '૦'..='૯' | '୦'..='୯' | '௦'..='௯' | '౦'..='౯' | '೦'..='೯' | '൦'..='൯' | '෦'..='෯' | '๐'..='๙' | '໐'..='໙' | '༠'..='༩' | '၀'..='၉' | '႐'..='႙' | '០'..='៩' | '᠐'..='᠙' | '᥆'..='᥏' | '᧐'..='᧙' | '᪀'..='᪉' | '᪐'..='᪙' | '᭐'..='᭙' | '᮰'..='᮹' | '᱀'..='᱉' | '᱐'..='᱙' | '꘠'..='꘩' | '꣐'..='꣙' | '꤀'..='꤉' | '꧐'..='꧙' | '꧰'..='꧹' | '꩐'..='꩙' | '꯰'..='꯹' | '０'..='９' | '𐒠'..='𐒩' | '𐴰'..='𐴹' | '𐵀'..='𐵉' | '𑁦'..='𑁯' | '𑃰'..='𑃹' | '𑄶'..='𑄿' | '𑇐'..='𑇙' | '𑋰'..='𑋹' | '𑑐'..='𑑙' | '𑓐'..='𑓙' | '𑙐'..='𑙙' | '𑛀'..='𑛉' | '𑛐'..='𑛣' | '𑜰'..='𑜹' | '𑣠'..='𑣩' | '𑥐'..='𑥙' | '𑯰'..='𑯹' | '𑱐'..='𑱙' | '𑵐'..='𑵙' | '𑶠'..='𑶩' | '𑷠'..='𑷩' | '𑽐'..='𑽙' | '𖄰'..='𖄹' | '𖩠'..='𖩩' | '𖫀'..='𖫉' | '𖭐'..='𖭙' | '𖵰'..='𖵹' | '𜳰'..='𜳹' | '𝟎'..='𝟿' | '𞅀'..='𞅉' | '𞋰'..='𞋹' | '𞓰'..='𞓹' | '𞗱'..='𞗺' | '𞥐'..='𞥙' | '🯰'..='🯹' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            if pos >= chars.len() { break rep_1; }
            if !((chars[pos] matches { '0'..='9' | '٠'..='٩' | '۰'..='۹' | '߀'..='߉' | '०'..='९' | '০'..='৯' | '੦'..='੯' | '૦'..='૯' | '୦'..='୯' | '௦'..='௯' | '౦'..='౯' | '೦'..='೯' | '൦'..='൯' | '෦'..='෯' | '๐'..='๙' | '໐'..='໙' | '༠'..='༩' | '၀'..='၉' | '႐'..='႙' | '០'..='៩' | '᠐'..='᠙' | '᥆'..='᥏' | '᧐'..='᧙' | '᪀'..='᪉' | '᪐'..='᪙' | '᭐'..='᭙' | '᮰'..='᮹' | '᱀'..='᱉' | '᱐'..='᱙' | '꘠'..='꘩' | '꣐'..='꣙' | '꤀'..='꤉' | '꧐'..='꧙' | '꧰'..='꧹' | '꩐'..='꩙' | '꯰'..='꯹' | '０'..='９' | '𐒠'..='𐒩' | '𐴰'..='𐴹' | '𐵀'..='𐵉' | '𑁦'..='𑁯' | '𑃰'..='𑃹' | '𑄶'..='𑄿' | '𑇐'..='𑇙' | '𑋰'..='𑋹' | '𑑐'..='𑑙' | '𑓐'..='𑓙' | '𑙐'..='𑙙' | '𑛀'..='𑛉' | '𑛐'..='𑛣' | '𑜰'..='𑜹' | '𑣠'..='𑣩' | '𑥐'..='𑥙' | '𑯰'..='𑯹' | '𑱐'..='𑱙' | '𑵐'..='𑵙' | '𑶠'..='𑶩' | '𑷠'..='𑷩' | '𑽐'..='𑽙' | '𖄰'..='𖄹' | '𖩠'..='𖩩' | '𖫀'..='𖫉' | '𖭐'..='𖭙' | '𖵰'..='𖵹' | '𜳰'..='𜳹' | '𝟎'..='𝟿' | '𞅀'..='𞅉' | '𞋰'..='𞋹' | '𞓰'..='𞓹' | '𞗱'..='𞗺' | '𞥐'..='𞥙' | '🯰'..='🯹' })) { break rep_1; }
            pos += 1;
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_SPACE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { ' ' | ' ' | ' ' | ' '..=' ' | ' ' | ' ' | '　' })) { return -1; }
    pos += 1;
    return pos;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char matches { ' ' | ' ' | ' ' | ' ' | ' ' | '　' } {
            end = try_SPACE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SPACE; }
        } else if first_char matches { 'ª' | 'µ' | 'º' | 'Ā' | 'ā' | 'Ă' | 'ă' | 'Ą' | 'ą' | 'Ć' | 'ć' | 'Ĉ' | 'ĉ' | 'Ċ' | 'ċ' | 'Č' | 'č' | 'Ď' | 'ď' | 'Đ' | 'đ' | 'Ē' | 'ē' | 'Ĕ' | 'ĕ' | 'Ė' | 'ė' | 'Ę' | 'ę' | 'Ě' | 'ě' | 'Ĝ' | 'ĝ' | 'Ğ' | 'ğ' | 'Ġ' | 'ġ' | 'Ģ' | 'ģ' | 'Ĥ' | 'ĥ' | 'Ħ' | 'ħ' | 'Ĩ' | 'ĩ' | 'Ī' | 'ī' | 'Ĭ' | 'ĭ' | 'Į' | 'į' | 'İ' | 'ı' | 'Ĳ' | 'ĳ' | 'Ĵ' | 'ĵ' | 'Ķ' | 'Ĺ' | 'ĺ' | 'Ļ' | 'ļ' | 'Ľ' | 'ľ' | 'Ŀ' | 'ŀ' | 'Ł' | 'ł' | 'Ń' | 'ń' | 'Ņ' | 'ņ' | 'Ň' | 'Ŋ' | 'ŋ' | 'Ō' | 'ō' | 'Ŏ' | 'ŏ' | 'Ő' | 'ő' | 'Œ' | 'œ' | 'Ŕ' | 'ŕ' | 'Ŗ' | 'ŗ' | 'Ř' | 'ř' | 'Ś' | 'ś' | 'Ŝ' | 'ŝ' | 'Ş' | 'ş' | 'Š' | 'š' | 'Ţ' | 'ţ' | 'Ť' | 'ť' | 'Ŧ' | 'ŧ' | 'Ũ' | 'ũ' | 'Ū' | 'ū' | 'Ŭ' | 'ŭ' | 'Ů' | 'ů' | 'Ű' | 'ű' | 'Ų' | 'ų' | 'Ŵ' | 'ŵ' | 'Ŷ' | 'ŷ' | 'ź' | 'Ż' | 'ż' | 'Ž' | 'ƃ' | 'Ƅ' | 'ƅ' | 'ƈ' | 'ƒ' | 'ƕ' | 'ƞ' | 'ơ' | 'Ƣ' | 'ƣ' | 'Ƥ' | 'ƥ' | 'ƨ' | 'Ʃ' | 'Ƭ' | 'ƭ' | 'ư' | 'ƴ' | 'Ƶ' | 'ƶ' | 'ƻ' | 'Ƽ' | 'Ǆ' | 'ǅ' | 'ǆ' | 'Ǉ' | 'ǈ' | 'ǉ' | 'Ǌ' | 'ǋ' | 'ǌ' | 'Ǎ' | 'ǎ' | 'Ǐ' | 'ǐ' | 'Ǒ' | 'ǒ' | 'Ǔ' | 'ǔ' | 'Ǖ' | 'ǖ' | 'Ǘ' | 'ǘ' | 'Ǚ' | 'ǚ' | 'Ǜ' | 'Ǟ' | 'ǟ' | 'Ǡ' | 'ǡ' | 'Ǣ' | 'ǣ' | 'Ǥ' | 'ǥ' | 'Ǧ' | 'ǧ' | 'Ǩ' | 'ǩ' | 'Ǫ' | 'ǫ' | 'Ǭ' | 'ǭ' | 'Ǯ' | 'Ǳ' | 'ǲ' | 'ǳ' | 'Ǵ' | 'ǵ' | 'ǹ' | 'Ǻ' | 'ǻ' | 'Ǽ' | 'ǽ' | 'Ǿ' | 'ǿ' | 'Ȁ' | 'ȁ' | 'Ȃ' | 'ȃ' | 'Ȅ' | 'ȅ' | 'Ȇ' | 'ȇ' | 'Ȉ' | 'ȉ' | 'Ȋ' | 'ȋ' | 'Ȍ' | 'ȍ' | 'Ȏ' | 'ȏ' | 'Ȑ' | 'ȑ' | 'Ȓ' | 'ȓ' | 'Ȕ' | 'ȕ' | 'Ȗ' | 'ȗ' | 'Ș' | 'ș' | 'Ț' | 'ț' | 'Ȝ' | 'ȝ' | 'Ȟ' | 'ȟ' | 'Ƞ' | 'ȡ' | 'Ȣ' | 'ȣ' | 'Ȥ' | 'ȥ' | 'Ȧ' | 'ȧ' | 'Ȩ' | 'ȩ' | 'Ȫ' | 'ȫ' | 'Ȭ' | 'ȭ' | 'Ȯ' | 'ȯ' | 'Ȱ' | 'ȱ' | 'Ȳ' | 'ȼ' | 'Ɂ' | 'ɂ' | 'ɇ' | 'Ɉ' | 'ɉ' | 'Ɋ' | 'ɋ' | 'Ɍ' | 'ɍ' | 'Ɏ' | 'ˬ' | 'ˮ' | 'Ͱ' | 'ͱ' | 'Ͳ' | 'ͳ' | 'ʹ' | 'Ͷ' | 'ͷ' | 'ͺ' | 'Ϳ' | 'Ά' | 'Ό' | 'ΐ' | 'Ϗ' | 'Ϙ' | 'ϙ' | 'Ϛ' | 'ϛ' | 'Ϝ' | 'ϝ' | 'Ϟ' | 'ϟ' | 'Ϡ' | 'ϡ' | 'Ϣ' | 'ϣ' | 'Ϥ' | 'ϥ' | 'Ϧ' | 'ϧ' | 'Ϩ' | 'ϩ' | 'Ϫ' | 'ϫ' | 'Ϭ' | 'ϭ' | 'Ϯ' | 'ϴ' | 'ϵ' | 'Ϸ' | 'ϸ' | 'Ѡ' | 'ѡ' | 'Ѣ' | 'ѣ' | 'Ѥ' | 'ѥ' | 'Ѧ' | 'ѧ' | 'Ѩ' | 'ѩ' | 'Ѫ' | 'ѫ' | 'Ѭ' | 'ѭ' | 'Ѯ' | 'ѯ' | 'Ѱ' | 'ѱ' | 'Ѳ' | 'ѳ' | 'Ѵ' | 'ѵ' | 'Ѷ' | 'ѷ' | 'Ѹ' |