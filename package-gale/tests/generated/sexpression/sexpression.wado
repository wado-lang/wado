                    pos = alts_saved_5;
                    if pos >= chars.len() || chars[pos] != '\r' { break alts_5_3; }
                    pos += 1;
                    alts_ok_5 = true;
                }
            }
        }
    }
    if !alts_ok_5 { return -1; }
    loop {
        let rep_saved_4 = pos;
        rep_4: {
            let alts_saved_6 = pos;
            let mut alts_ok_6 = false;
            alts_6_0: {
                pos = alts_saved_6;
                if pos >= chars.len() || chars[pos] != ' ' { break alts_6_0; }
                pos += 1;
                alts_ok_6 = true;
            }
            if !alts_ok_6 {
                alts_6_1: {
                    pos = alts_saved_6;
                    if pos >= chars.len() || chars[pos] != '\n' { break alts_6_1; }
                    pos += 1;
                    alts_ok_6 = true;
