fn try_NUMBER(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let opt_saved_7 = pos;
    let mut opt_ok_7 = false;
    rep_7: {
        let alts_saved_8 = pos;
        let mut alts_ok_8 = false;
        alts_8_0: {
            pos = alts_saved_8;
            if pos >= chars.len() || chars[pos] != '+' { break alts_8_0; }
            pos += 1;
            alts_ok_8 = true;
        }
        if !alts_ok_8 {
            alts_8_1: {
                pos = alts_saved_8;
                if pos >= chars.len() || chars[pos] != '-' { break alts_8_1; }
                pos += 1;
                alts_ok_8 = true;
            }
        }
        if !alts_ok_8 { break rep_7; }
        opt_ok_7 = true;
    }
    if !opt_ok_7 { pos = opt_saved_7; }
    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { return -1; }
    pos += 1;
    loop {
        let rep_saved_9 = pos;
        rep_9: {
            if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_9; }
            pos += 1;
            continue;
        }
        pos = rep_saved_9;
        break;
    }
    let opt_saved_10 = pos;
    let mut opt_ok_10 = false;
    rep_10: {
        if pos >= chars.len() || chars[pos] != '.' { break rep_10; }
        pos += 1;
        if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_10; }
        pos += 1;
        loop {
            let rep_saved_11 = pos;
            rep_11: {
                if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_11; }
                pos += 1;
                continue;
            }
            pos = rep_saved_11;
            break;
        }
        opt_ok_10 = true;
    }
    if !opt_ok_10 { pos = opt_saved_10; }
    return pos;
}

fn try_SYMBOL(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_12 = pos;
    let mut alts_ok_12 = false;
    alts_12_0: {
        pos = alts_saved_12;
        if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_12_0; }
        pos += 1;
        alts_ok_12 = true;
    }
    if !alts_ok_12 {
        alts_12_1: {
            pos = alts_saved_12;
            if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_12_1; }
            pos += 1;
            alts_ok_12 = true;
        }
        if !alts_ok_12 {
            alts_12_2: {
                pos = alts_saved_12;
                if pos >= chars.len() || chars[pos] != '+' { break alts_12_2; }
                pos += 1;
                alts_ok_12 = true;
            }
            if !alts_ok_12 {
                alts_12_3: {
                    pos = alts_saved_12;
                    if pos >= chars.len() || chars[pos] != '-' { break alts_12_3; }
                    pos += 1;
                    alts_ok_12 = true;
                }
                if !alts_ok_12 {
                    alts_12_4: {
                        pos = alts_saved_12;
                        if pos >= chars.len() || chars[pos] != '*' { break alts_12_4; }
                        pos += 1;
                        alts_ok_12 = true;
                    }
                    if !alts_ok_12 {
                        alts_12_5: {
                            pos = alts_saved_12;
                            if pos >= chars.len() || chars[pos] != '/' { break alts_12_5; }
                            pos += 1;
                            alts_ok_12 = true;
                        }
                        if !alts_ok_12 {
                            alts_12_6: {
                                pos = alts_saved_12;
                                if pos >= chars.len() || chars[pos] != '.' { break alts_12_6; }
                                pos += 1;
                                alts_ok_12 = true;
                            }
                        }
                    }
                }
            }
        }
    }
    if !alts_ok_12 { return -1; }
    loop {
        let rep_saved_13 = pos;
        rep_13: {
            let alts_saved_14 = pos;
            let mut alts_ok_14 = false;
            alts_14_0: {
                pos = alts_saved_14;
                let alts_saved_15 = pos;
                let mut alts_ok_15 = false;
                alts_15_0: {
                    pos = alts_saved_15;
                    if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_15_0; }
                    pos += 1;
                    alts_ok_15 = true;
                }
                if !alts_ok_15 {
                    alts_15_1: {
                        pos = alts_saved_15;
                        if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_15_1; }
                        pos += 1;
                        alts_ok_15 = true;
                    }
                    if !alts_ok_15 {
                        alts_15_2: {
                            pos = alts_saved_15;
                            if pos >= chars.len() || chars[pos] != '+' { break alts_15_2; }
                            pos += 1;
                            alts_ok_15 = true;
                        }
                        if !alts_ok_15 {
                            alts_15_3: {
                                pos = alts_saved_15;
                                if pos >= chars.len() || chars[pos] != '-' { break alts_15_3; }
                                pos += 1;
                                alts_ok_15 = true;
                            }
                            if !alts_ok_15 {
                                alts_15_4: {
                                    pos = alts_saved_15;
                                    if pos >= chars.len() || chars[pos] != '*' { break alts_15_4; }
                                    pos += 1;
                                    alts_ok_15 = true;
                                }
                                if !alts_ok_15 {
                                    alts_15_5: {
                                        pos = alts_saved_15;
                                        if pos >= chars.len() || chars[pos] != '/' { break alts_15_5; }
                                        pos += 1;
                                        alts_ok_15 = true;
                                    }
                                    if !alts_ok_15 {
                                        alts_15_6: {
                                            pos = alts_saved_15;
                                            if pos >= chars.len() || chars[pos] != '.' { break alts_15_6; }
                                            pos += 1;
                                            alts_ok_15 = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if !alts_ok_15 { break alts_14_0; }
                alts_ok_14 = true;
            }
            if !alts_ok_14 {
                alts_14_1: {
                    pos = alts_saved_14;
                    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break alts_14_1; }
                    pos += 1;
