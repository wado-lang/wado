fn try_LPAREN(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '(' { return -1; }
    pos += 1;
    return pos;
}

fn try_RPAREN(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ')' { return -1; }
    pos += 1;
    return pos;
}

fn try_DOT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '.' { return -1; }
    pos += 1;
    return pos;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_WHITESPACE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WHITESPACE; }
        } else if first_char == '"' {
            end = try_STRING(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STRING; }
        } else if first_char == '(' {
            end = try_LPAREN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LPAREN; }
        } else if first_char == ')' {
            end = try_RPAREN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_RPAREN; }
        } else if first_char == '*' || first_char == '/' {
            end = try_SYMBOL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        } else if first_char == '+' || first_char == '-' {
            end = try_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_SYMBOL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        } else if first_char == '.' {
            end = try_SYMBOL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
            end = try_DOT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DOT; }
        } else if '0' <= first_char <= '9' {
            end = try_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if 'a' <= first_char <= 'z' {
            end = try_SYMBOL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_SYMBOL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        } else {
            end = try_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_SYMBOL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WHITESPACE };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_STRING => "STRING",
        TK_WHITESPACE => "WHITESPACE",
        TK_NUMBER => "NUMBER",
        TK_SYMBOL => "SYMBOL",
        TK_LPAREN => "LPAREN",
        TK_RPAREN => "RPAREN",
        TK_DOT => "DOT",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
        }
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32) -> Result<i32, ParseError> {
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                return Result::Ok(self.pos);
            }
            return Result::Ok(self.advance());
        }
        let name = token_kind_name(kind);
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<i32, ParseError> {
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<i32, ParseError> {
        if self.kinds[self.pos] != TK_EOF {
            return Result::Ok(self.advance());
        }
        return Result::Err(self.error(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::Ok(self.pos);
                }
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["token set"],
        ));
    }
}

fn scan_sexpr(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos]) {
        let sp = pos;
        pos = scan_item(tokens, pos, 0);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_item(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _gale_kind_set_1(alt_kind) {
            pos = start;
            try_0: {
                pos = scan_atom(tokens, pos, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LPAREN {
            let mut best: i32 = -1;
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos] != TK_LPAREN { break try_2; }
                pos += 1;
                pos = scan_item(tokens, pos, 0);
                if pos < 0 { break try_2; }
                if pos >= tokens.len() || tokens[pos] != TK_DOT { break try_2; }
                pos += 1;
                pos = scan_item(tokens, pos, 0);
                if pos < 0 { break try_2; }
                if pos >= tokens.len() || tokens[pos] != TK_RPAREN { break try_2; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_1: {
                pos = scan_list_(tokens, pos, 0);
                if pos < 0 { break try_1; }
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_list_(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LPAREN { return -1; }
    pos += 1;
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos]) {
        let sp = pos;
        pos = scan_item(tokens, pos, 0);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn scan_atom(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_1(tokens[pos]) {
        return pos + 1;
    }
    return -1;
}

fn _parse_sexpr__inner(p: &mut Parser) -> Result<SexprNode, ParseError> {
    let start = p.peek_start();
    let mut item_list: List<ItemNode> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_item(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 {
            if _gale_kind_set_0(p.peek_kind()) {
                let _rec_pos = p.pos;
                if let Err(_rec_e) = _parse_item(p) { p.record_deeper(_rec_e); }
                p.pos = _rec_pos;
            }
            break;
        }
        let item = _parse_item(p)?;
        item_list.push(item);
    }
    let eof = p.expect(TK_EOF)?;
    return Result::Ok(SexprNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        item_list,
        eof,
    });
}

fn _parse_sexpr(p: &mut Parser) -> Result<SexprNode, ParseError> {
    return _gale_rule(_parse_sexpr__inner(p), "sexpr");
}

fn _parse_item__inner_alt_2(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let start = p.peek_start();
    let lparen = p.expect(TK_LPAREN)?;
    let item = _parse_item(p)?;
    let dot = p.expect(TK_DOT)?;
    let item_2 = _parse_item(p)?;
    let rparen = p.expect(TK_RPAREN)?;
    return Result::Ok(ItemNode::Alt2(ItemAlt2 {
        span: Span::new(start, i32::max(start, p.last_end())),
        lparen,
        item,
        dot,
        item_2,
        rparen,
    }));
}

fn _parse_item__inner_scan_2(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LPAREN { return -1; }
    pos += 1;
    pos = scan_item(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_DOT { return -1; }
    pos += 1;
    pos = scan_item(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn _parse_item__inner_alt_1(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let start = p.peek_start();
    let list_ = _parse_list_(p)?;
    return Result::Ok(ItemNode::Alt1(ItemAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        list_,
    }));
}

fn _parse_item__inner_scan_1(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_list_(tokens, pos, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn _parse_item__inner(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _gale_kind_set_1(kind) {
        let atom = _parse_atom(p)?;
        return Result::Ok(ItemNode::Alt0(ItemAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            atom,
        }));
    }
    if kind == TK_LPAREN {
        if p.peek_kind() == TK_LPAREN {
            let _sd_tokens = &p.kinds;
            let _sd_pos = p.pos;
            let _sd_p_2 = _parse_item__inner_scan_2(_sd_tokens, _sd_pos);
            let _sd_p_1 = _parse_item__inner_scan_1(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_2 > _sd_best_p {
                _sd_best_p = _sd_p_2;
                _sd_best_i = 2;
            }
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_best_i == 2 {
                return _parse_item__inner_alt_2(p);
            }
            if _sd_best_i == 1 {
                return _parse_item__inner_alt_1(p);
            }
            return _parse_item__inner_alt_1(p);
        }
    }
    return Result::Err(p.error(
        "expected item",
        p.peek_span(),
        ["TK_STRING", "TK_SYMBOL", "TK_NUMBER", "TK_DOT", "TK_LPAREN"],
    ));
}

fn _parse_item(p: &mut Parser) -> Result<ItemNode, ParseError> {
    return _gale_rule(_parse_item__inner(p), "item");
}

fn _parse_list___inner(p: &mut Parser) -> Result<ListNode, ParseError> {
    let start = p.peek_start();
    let lparen = p.expect(TK_LPAREN)?;
    let mut item_list: List<ItemNode> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_item(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 {
            if _gale_kind_set_0(p.peek_kind()) {
                let _rec_pos = p.pos;
                if let Err(_rec_e) = _parse_item(p) { p.record_deeper(_rec_e); }
                p.pos = _rec_pos;
            }
            break;
        }
        let item = _parse_item(p)?;
        item_list.push(item);
    }
    let rparen = p.expect(TK_RPAREN)?;
    return Result::Ok(ListNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lparen,
        item_list,
        rparen,
    });
}

fn _parse_list_(p: &mut Parser) -> Result<ListNode, ParseError> {
    return _gale_rule(_parse_list___inner(p), "list_");
}

fn _parse_atom__inner(p: &mut Parser) -> Result<AtomNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _gale_kind_set_1(kind) {
        let token = p.expect(kind)?;
        return Result::Ok(AtomNode {
            span: Span::new(start, i32::max(start, p.last_end())),
            token,
        });
    }
    return Result::Err(p.error(
        "expected atom",
        p.peek_span(),
        ["TK_STRING", "TK_SYMBOL", "TK_NUMBER", "TK_DOT"],
    ));
}

fn _parse_atom(p: &mut Parser) -> Result<AtomNode, ParseError> {
    return _gale_rule(_parse_atom__inner(p), "atom");
}

fn _gale_rule<T>(r: Result<T, ParseError>, rule: String) -> Result<T, ParseError> {
    if let Err(mut e) = r {
        e.rule_stack.push(rule);
        return Result::Err(e);
    }
    return r;
}

fn _gale_run<T>(input: &String, run: fn(&mut Parser) -> Result<T, ParseError>) -> Result<ParseResult<T>, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = run(&mut parser);
    if let Err(_e) = _result {
        return Result::Err(_gale_pick_error(&parser, _e));
    }
    if let Ok(_root) = _result {
        return Result::Ok(ParseResult { root: _root, tokens: parser.tokens });
    }
    unreachable();
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    return Parser::new(tokens);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_sexpr(input: &String) -> Result<ParseResult<SexprNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_sexpr(p));
}

pub fn parse_item(input: &String) -> Result<ParseResult<ItemNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_item(p));
}

pub fn parse_list_(input: &String) -> Result<ParseResult<ListNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_list_(p));
}

pub fn parse_atom(input: &String) -> Result<ParseResult<AtomNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_atom(p));
}

pub fn parse(input: &String) -> Result<ParseResult<SexprNode>, ParseError> {
    return parse_sexpr(input);
}

pub fn walk_sexpr<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SexprNode) {
    v.enter_rule(0, &"sexpr", &node.span);
    for let item of &node.item_list {
        walk_item(v, toks, item);
    }
    v.visit_token(toks, *(&node.eof));
    v.exit_rule(0, &"sexpr", &node.span);
}

pub fn walk_item<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ItemNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(1, &"item", &n.span);
            walk_atom(v, toks, &n.atom);
            v.exit_rule(1, &"item", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(1, &"item", &n.span);
            walk_list_(v, toks, &n.list_);
            v.exit_rule(1, &"item", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(1, &"item", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_item(v, toks, &n.item);
            v.visit_token(toks, *(&n.dot));
            walk_item(v, toks, &n.item_2);
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(1, &"item", &n.span);
        }
    }
}

pub fn walk_list_<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ListNode) {
    v.enter_rule(2, &"list_", &node.span);
    v.visit_token(toks, *(&node.lparen));
    for let item of &node.item_list {
        walk_item(v, toks, item);
    }
    v.visit_token(toks, *(&node.rparen));
    v.exit_rule(2, &"list_", &node.span);
}

pub fn walk_atom<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AtomNode) {
    v.enter_rule(3, &"atom", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(3, &"atom", &node.span);
}

pub fn to_tree(result: &ParseResult<SexprNode>) -> CstNode {
    let mut recorder = TreeRecorder::new(&result.tokens);
    walk_sexpr(&mut recorder, &result.tokens, &result.root);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_DOT | TK_LPAREN | TK_NUMBER | TK_STRING | TK_SYMBOL };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_DOT | TK_NUMBER | TK_STRING | TK_SYMBOL };
}

