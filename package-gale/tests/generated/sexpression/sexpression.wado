global TK_STRING: i32 = 0;
global TK_WHITESPACE: i32 = 1;
global TK_NUMBER: i32 = 2;
global TK_SYMBOL: i32 = 3;
global TK_LPAREN: i32 = 4;
global TK_RPAREN: i32 = 5;
global TK_DOT: i32 = 6;
global TK_EOF: i32 = 7;
global TK_ERROR: i32 = 8;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_string(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '"' { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            let alts_saved_1 = pos;
            let mut alts_ok_1 = false;
            alts_1_0: {
                pos = alts_saved_1;
                if pos >= chars.len() || chars[pos] != '\\' { break alts_1_0; }
                pos += 1;
                if pos >= chars.len() { break alts_1_0; }
                pos += 1;
                alts_ok_1 = true;
            }
            if !alts_ok_1 {
                alts_1_1: {
                    pos = alts_saved_1;
                    if pos >= chars.len() { break alts_1_1; }
                    let not_saved_2 = pos;
                    let mut not_matched_2 = false;
                    not_2: {
                        let alts_saved_3 = pos;
                        let mut alts_ok_3 = false;
                        alts_3_0: {
                            pos = alts_saved_3;
                            if pos >= chars.len() || chars[pos] != '\\' { break alts_3_0; }
                            pos += 1;
                            alts_ok_3 = true;
                        }
                        if !alts_ok_3 {
                            alts_3_1: {
                                pos = alts_saved_3;
                                if pos >= chars.len() || chars[pos] != '"' { break alts_3_1; }
                                pos += 1;
                                alts_ok_3 = true;
                            }
                        }
                        if !alts_ok_3 { break not_2; }
                        not_matched_2 = true;
                    }
                    pos = not_saved_2;
                    if not_matched_2 { break alts_1_1; }
                    pos += 1;
                    alts_ok_1 = true;
                }
            }
            if !alts_ok_1 { break rep_0; }
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    if pos >= chars.len() || chars[pos] != '"' { return -1; }
    pos += 1;
    return pos;
}

