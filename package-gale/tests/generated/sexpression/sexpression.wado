pub fn tokenize(input: &String) -> List<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: List<Token> = List::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: List<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_whitespace(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WHITESPACE; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == '"' {
            end = try_string(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STRING; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == '(' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_lparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LPAREN; }
        } else if first_char == ')' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_rparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_RPAREN; }
        } else if first_char == '*' || first_char == '+' || first_char == '-' || first_char == '/' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_symbol(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        } else if first_char == '.' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_symbol(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
            end = try_dot(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DOT; }
        } else if 'a' <= first_char <= 'z' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_symbol(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_symbol(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        } else {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_symbol(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WHITESPACE };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_STRING => "STRING",
        TK_WHITESPACE => "WHITESPACE",
        TK_NUMBER => "NUMBER",
        TK_SYMBOL => "SYMBOL",
        TK_LPAREN => "LPAREN",
        TK_RPAREN => "RPAREN",
        TK_DOT => "DOT",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: List<Token>,
    pos: i32,
    chars: List<char>,
}

impl Parser {
    fn new(tokens: List<Token>, chars: List<char>) -> Parser {
        return Parser { tokens, pos: 0, chars };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(&self.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
                }
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["token set"],
        ));
    }
}

fn scan_sexpr(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos].kind) {
        let sp = pos;
        pos = scan_item(tokens, pos, 0);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_item(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if _gale_kind_set_1(alt_kind) {
            pos = start;
            try_0: {
                pos = scan_atom(tokens, pos, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LPAREN {
            let mut best: i32 = -1;
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LPAREN { break try_2; }
                pos += 1;
                pos = scan_item(tokens, pos, 0);
                if pos < 0 { break try_2; }
                if pos >= tokens.len() || tokens[pos].kind != TK_DOT { break try_2; }
                pos += 1;
                pos = scan_item(tokens, pos, 0);
                if pos < 0 { break try_2; }
                if pos >= tokens.len() || tokens[pos].kind != TK_RPAREN { break try_2; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_1: {
                pos = scan_list_(tokens, pos, 0);
                if pos < 0 { break try_1; }
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_list_(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LPAREN { return -1; }
    pos += 1;
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos].kind) {
        let sp = pos;
        pos = scan_item(tokens, pos, 0);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn scan_atom(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_1(tokens[pos].kind) {
        return pos + 1;
    }
    return -1;
}

fn _parse_sexpr__inner(p: &mut Parser) -> Result<SexprNode, ParseError> {
    let start = p.peek().span.start;
    let mut item_list: List<ItemNode> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_item(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let item = _parse_item(p)?;
        item_list.push(item);
    }
    let eof = p.expect(TK_EOF)?;
    return Result::<SexprNode, ParseError>::Ok(SexprNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        item_list,
        eof,
    });
}

fn _parse_sexpr(p: &mut Parser) -> Result<SexprNode, ParseError> {
    let r = _parse_sexpr__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("sexpr");
        return Result::<SexprNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_item__inner_bt_2(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let start = p.peek().span.start;
    let lparen = p.expect(TK_LPAREN)?;
    let item = _parse_item(p)?;
    let dot = p.expect(TK_DOT)?;
    let item_2 = _parse_item(p)?;
    let rparen = p.expect(TK_RPAREN)?;
    return Result::<ItemNode, ParseError>::Ok(ItemNode::Alt2(ItemAlt2 {
        span: Span::new(start, i32::max(start, p.last_end())),
        lparen,
        item,
        dot,
        item_2,
        rparen,
    }));
}

fn _parse_item__inner_scan_2(tokens: &List<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LPAREN { return -1; }
    pos += 1;
    pos = scan_item(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_DOT { return -1; }
    pos += 1;
    pos = scan_item(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn _parse_item__inner_bt_1(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let start = p.peek().span.start;
    let list_ = _parse_list_(p)?;
    return Result::<ItemNode, ParseError>::Ok(ItemNode::Alt1(ItemAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        list_,
    }));
}

fn _parse_item__inner_scan_1(tokens: &List<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_list_(tokens, pos, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn _parse_item__inner(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if _gale_kind_set_1(kind) {
        let atom = _parse_atom(p)?;
        return Result::<ItemNode, ParseError>::Ok(ItemNode::Alt0(ItemAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            atom,
        }));
    }
    if kind == TK_LPAREN {
        if p.peek_kind() == TK_LPAREN {
            let _sd_tokens = &p.tokens;
            let _sd_pos = p.pos;
            let _sd_p_2 = _parse_item__inner_scan_2(_sd_tokens, _sd_pos);
            let _sd_p_1 = _parse_item__inner_scan_1(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_2 > _sd_best_p {
                _sd_best_p = _sd_p_2;
                _sd_best_i = 2;
            }
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_best_i == 2 {
                return _parse_item__inner_bt_2(p);
            }
            if _sd_best_i == 1 {
                return _parse_item__inner_bt_1(p);
            }
            return _parse_item__inner_bt_1(p);
        }
    }
    return Result::<ItemNode, ParseError>::Err(p.error(
        "expected item",
        p.peek().span,
        ["TK_STRING", "TK_SYMBOL", "TK_NUMBER", "TK_DOT", "TK_LPAREN"],
    ));
}

fn _parse_item(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let r = _parse_item__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("item");
        return Result::<ItemNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_list___inner(p: &mut Parser) -> Result<ListNode, ParseError> {
    let start = p.peek().span.start;
    let lparen = p.expect(TK_LPAREN)?;
    let mut item_list: List<ItemNode> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_item(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let item = _parse_item(p)?;
        item_list.push(item);
    }
    let rparen = p.expect(TK_RPAREN)?;
    return Result::<ListNode, ParseError>::Ok(ListNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lparen,
        item_list,
        rparen,
    });
}

fn _parse_list_(p: &mut Parser) -> Result<ListNode, ParseError> {
    let r = _parse_list___inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("list_");
        return Result::<ListNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_atom__inner(p: &mut Parser) -> Result<AtomNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_STRING {
        let string = p.expect(TK_STRING)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt0(AtomAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            string,
        }));
    }
    if kind == TK_SYMBOL {
        let symbol = p.expect(TK_SYMBOL)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt1(AtomAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            symbol,
        }));
    }
    if kind == TK_NUMBER {
        let number = p.expect(TK_NUMBER)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt2(AtomAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            number,
        }));
    }
    if kind == TK_DOT {
        let dot = p.expect(TK_DOT)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt3(AtomAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            dot,
        }));
    }
    return Result::<AtomNode, ParseError>::Err(p.error(
        "expected atom",
        p.peek().span,
        ["TK_STRING", "TK_SYMBOL", "TK_NUMBER", "TK_DOT"],
    ));
}

fn _parse_atom(p: &mut Parser) -> Result<AtomNode, ParseError> {
    let r = _parse_atom__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("atom");
        return Result::<AtomNode, ParseError>::Err(e);
    }
    return r;
}

pub fn parse_sexpr(input: &String) -> Result<SexprNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    return _parse_sexpr(&mut parser);
}

pub fn parse_item(input: &String) -> Result<ItemNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    return _parse_item(&mut parser);
}

pub fn parse_list_(input: &String) -> Result<ListNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    return _parse_list_(&mut parser);
}

pub fn parse_atom(input: &String) -> Result<AtomNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    return _parse_atom(&mut parser);
}

pub fn parse(input: &String) -> Result<SexprNode, ParseError> {
    return parse_sexpr(input);
}

pub fn walk_sexpr<V: Visitor>(v: &mut V, node: &SexprNode) {
    v.enter_rule(0, &"sexpr", &node.span);
    for let item of &node.item_list {
        walk_item(v, item);
    }
    v.visit_token(&node.eof);
    v.exit_rule(0, &"sexpr", &node.span);
}

pub fn walk_item<V: Visitor>(v: &mut V, node: &ItemNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(1, &"item", &n.span);
            walk_atom(v, &n.atom);
            v.exit_rule(1, &"item", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(1, &"item", &n.span);
            walk_list_(v, &n.list_);
            v.exit_rule(1, &"item", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(1, &"item", &n.span);
            v.visit_token(&n.lparen);
            walk_item(v, &n.item);
            v.visit_token(&n.dot);
            walk_item(v, &n.item_2);
            v.visit_token(&n.rparen);
            v.exit_rule(1, &"item", &n.span);
        }
    }
}

pub fn walk_list_<V: Visitor>(v: &mut V, node: &ListNode) {
    v.enter_rule(2, &"list_", &node.span);
    v.visit_token(&node.lparen);
    for let item of &node.item_list {
        walk_item(v, item);
    }
    v.visit_token(&node.rparen);
    v.exit_rule(2, &"list_", &node.span);
}

pub fn walk_atom<V: Visitor>(v: &mut V, node: &AtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(3, &"atom", &n.span);
            v.visit_token(&n.string);
            v.exit_rule(3, &"atom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(3, &"atom", &n.span);
            v.visit_token(&n.symbol);
            v.exit_rule(3, &"atom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(3, &"atom", &n.span);
            v.visit_token(&n.number);
            v.exit_rule(3, &"atom", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(3, &"atom", &n.span);
            v.visit_token(&n.dot);
            v.exit_rule(3, &"atom", &n.span);
        }
    }
}

pub fn to_tree(node: &SexprNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_sexpr(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_DOT | TK_LPAREN | TK_NUMBER | TK_STRING | TK_SYMBOL };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_DOT | TK_NUMBER | TK_STRING | TK_SYMBOL };
}

