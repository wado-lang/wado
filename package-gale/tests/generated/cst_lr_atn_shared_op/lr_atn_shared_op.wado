}

pub struct Diagnostic {
    pub severity: Severity,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub expected: List<i32> = [],
    pub found: i32 = -1,
    pub rule_stack: List<String> = [],
    pub recovery: RecoveryAction = RecoveryAction::None,
    pub related: List<RelatedInfo> = [],
}

impl Diagnostic {
    pub fn error(code: DiagnosticCode, message: String, span: Span, line: i32, col: i32) -> Diagnostic {
        return Diagnostic {
            severity: Severity::Error,
            code,
            message,
            span,
            line,
            col,
        };
    }

    pub fn is_error(&self) -> bool {
        return self.severity matches { Error };
    }
}

impl Display for Diagnostic {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&`${self.severity.label()}[${self.code.name()}] at ${self.line}:${self.col}: ${self.message}`);
        for let r of &self.related {
            f.write_str(&`\n  note: ${r.message}`);
        }
    }
}

pub fn line_col(chars: &List<char>, pos: i32) -> [i32, i32] {
    let mut line = 1;
    let mut col = 0;
    let cap = if pos < chars.len() { pos } else { chars.len() };
    for let mut i = 0; i < cap; i += 1 {
        if chars[i] == '\n' {
            line += 1;
            col = 0;
        } else {
            col += 1;
        }
    }
    return [line, col];
}

pub type NodeKind = i32;

pub global K_ERROR: NodeKind = -1;

pub flags NodeFlags {
    Error,
    Incomplete,
}

pub enum EventTag {
    Open,
    Close,
    Tok,
    Miss,
    Skip,
}

pub struct CstStore {
    pub tag: List<EventTag>,
    pub a: List<i32>,
    pub b: List<i32>,
    alt: List<i32>,
    end: List<i32>,
    flags: List<NodeFlags>,
    next: List<i32>,
}

pub enum ChildKind {
    Node,
    Token,
    Missing,
    Skipped,
}

impl CstStore {
    pub fn row_count(&self) -> i32 {
        return self.tag.len();
    }

    pub fn kind(&self, i: i32) -> NodeKind {
        return self.a[i] as NodeKind;
    }

    pub fn close_kind(&self, i: i32) -> NodeKind {
        return self.b[i] as NodeKind;
    }

    pub fn span(&self, i: i32) -> Span {
        return Span::new(self.b[i], self.end[i]);
    }

    pub fn alt(&self, i: i32) -> i32 {
        return self.alt[i];
    }

    pub fn is_error(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Error != NodeFlags::none();
    }

    pub fn is_incomplete(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Incomplete != NodeFlags::none();
    }

    pub fn is_node(&self, i: i32) -> bool {
        return self.tag[i] matches { Open };
    }

    pub fn is_token(&self, i: i32) -> bool {
        let t = self.tag[i];
        return t matches { Tok | Miss | Skip };
    }

    pub fn child_kind(&self, i: i32) -> ChildKind {
        return match self.tag[i] {
            Open => ChildKind::Node,
            Miss => ChildKind::Missing,
            Skip => ChildKind::Skipped,
            Tok => ChildKind::Token,
            Close => panic("CstStore::child_kind: Close is not a child row"),
        };
    }

    pub fn token_index(&self, i: i32) -> i32 {
        return self.a[i];
    }

    pub fn first_child(&self, i: i32) -> i32 {
        let c = i + 1;
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn next_sibling(&self, child: i32) -> i32 {
        let c = if self.tag[child] matches { Open } { self.next[child] } else { child + 1 };
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn find_child(&self, i: i32, kind: NodeKind) -> i32 {
        let k = kind as i32;
        for let mut c = self.first_child(i); c >= 0; c = self.next_sibling(c) {
            if self.tag[c] matches { Open } && self.kind(c) as i32 == k {
                return c;
            }
        }
        return -1;
    }

    pub fn to_string_tree(
        &self,
        i: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(256);
        cst_to_string_tree_impl(&mut out, self, i, toks, rule_names, token_names);
        return out;
    }
}

fn cst_to_string_tree_impl(
    out: &mut String,
    s: &CstStore,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) {
    let node_kind = s.kind(i) as i32;
    let name = if node_kind == K_ERROR as i32 { "<error>" } else { rule_names[node_kind] };
    if i + 1 >= s.tag.len() || s.tag[i + 1] matches { Close } {
        out.push_str(&name);
        return;
    }
    out.push_str(&"(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < s.next[i] {
        match s.tag[c] {
            Open => {
                out.push_str(&" ");
                cst_to_string_tree_impl(out, s, c, toks, rule_names, token_names);
                c = s.next[c];
            },
            Tok => {
                if !toks.is_empty_text(s.token_index(c)) {
                    out.push_str(&" ");
                    toks.push_token_text_escaped(out, s.token_index(c));
                }
                c += 1;
            },
            Miss => {
                out.push_str(&` <missing ${token_names[toks.kind_at(s.token_index(c))]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(&" <skip ");
                toks.push_token_text_escaped(out, s.token_index(c));
                out.push_str(&">");
                c += 1;
            },
            Close => c += 1,
        }
    }
    out.push_str(&")");
}

pub struct ParseResult {
    pub cst: CstStore,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
    pub output: String = "",
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        return self.diagnostics.iter_ref().any(|d| d.is_error());
    }

    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

fn bubble_to_parent(stack: &List<i32>, end: &mut List<i32>, flags: &mut List<NodeFlags>, child: i32) {
    if stack.len() > 0 {
        let parent = stack[stack.len() - 1];
        if end[child] > end[parent] {
            end[parent] = end[child];
        }
        flags[parent] = flags[parent] | flags[child] & NodeFlags::Error;
    }
}

pub struct TreeBuilder {
    tag: List<EventTag>,
    a: List<i32>,
    b: List<i32>,
    alt: List<i32>,
    open: List<i32>,
    last_finished: i32,
}

impl TreeBuilder {
    pub fn new() -> TreeBuilder {
        return TreeBuilder { tag: [], a: [], b: [], alt: [], open: [], last_finished: -1 };
    }

    pub fn with_capacity(rows: i32) -> TreeBuilder {
        return TreeBuilder {
            tag: List::with_capacity(rows),
            a: List::with_capacity(rows),
            b: List::with_capacity(rows),
            alt: List::with_capacity(rows),
            open: [],
            last_finished: -1,
        };
    }

    fn push_row(&mut self, tag: EventTag, a: i32, b: i32) {
        if self.tag.len() >= self.tag.capacity() {
            builtin::cold_path();
            self.tag.grow();
            self.a.grow();
            self.b.grow();
            self.alt.grow();
            assert self.a.capacity() == self.tag.capacity()
                && self.b.capacity() == self.tag.capacity()
                && self.alt.capacity() == self.tag.capacity(), "TreeBuilder event columns must grow in lockstep";
        }
        self.tag.push_within_capacity(tag);
        self.a.push_within_capacity(a);
        self.b.push_within_capacity(b);
        self.alt.push_within_capacity(-1);
    }

    pub fn start_node(&mut self, kind: NodeKind, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, kind as i32, start);
        self.open.push(row);
    }

    pub fn start_error(&mut self, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, K_ERROR as i32, start);
        self.open.push(row);
    }

    pub fn set_alt(&mut self, alt: i32) {
        self.alt[self.open[self.open.len() - 1]] = alt;
    }

    pub fn checkpoint(&self) -> i32 {
        return self.tag.len();
    }

    pub fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32) {
        self.tag.insert(checkpoint, EventTag::Open);
        self.a.insert(checkpoint, kind as i32);
        self.b.insert(checkpoint, start);
        self.alt.insert(checkpoint, -1);
        self.open.push(checkpoint);
    }

    pub fn truncate(&mut self, checkpoint: i32) {
        while self.tag.len() > checkpoint {
            let _ = self.tag.pop();
            let _ = self.a.pop();
            let _ = self.b.pop();
            let _ = self.alt.pop();
        }
        while self.open.len() > 0 && self.open[self.open.len() - 1] >= checkpoint {
            let _ = self.open.pop();
        }
    }

    pub fn finish_node(&mut self, end: i32) {
        self.push_row(EventTag::Close, end, 0);
        self.last_finished = self.open[self.open.len() - 1];
        let _ = self.open.pop();
    }

    pub fn token(&mut self, idx: i32) {
        self.push_row(EventTag::Tok, idx, 0);
    }

    pub fn missing(&mut self, syn_idx: i32) {
        self.push_row(EventTag::Miss, syn_idx, 0);
    }

    pub fn skip(&mut self, idx: i32) {
        self.push_row(EventTag::Skip, idx, 0);
    }

    pub fn finish(&self) -> CstStore {
        let n = self.tag.len();
        let mut b = self.b;
        let mut end = List::filled(n, 0);
        let mut flags = List::filled(n, NodeFlags::none());
        let mut next = List::filled(n, 0);
        let mut stack: List<i32> = [];
        for let mut r = 0; r < n; r += 1 {
            match self.tag[r] {
                Open => {
                    let node_kind = self.a[r];
                    let start_offset = self.b[r];
                    if node_kind == K_ERROR as i32 {
                        flags[r] = NodeFlags::Error;
                    }
                    end[r] = start_offset;
                    stack.push(r);
                },
                Miss => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Incomplete | NodeFlags::Error;
                },
                Skip => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Error;
                },
                Close => {
                    let oi = stack[stack.len() - 1];
                    let _ = stack.pop();
                    let close_offset = self.a[r];
                    let open_kind = self.a[oi];
                    if close_offset > end[oi] {
                        end[oi] = close_offset;
                    }
                    b[r] = open_kind;
                    next[oi] = r + 1;
                    bubble_to_parent(&stack, &mut end, &mut flags, oi);
                },
                Tok => {
                },
            }
        }
        while stack.len() > 0 {
            let oi = stack[stack.len() - 1];
            let _ = stack.pop();
            next[oi] = n;
            bubble_to_parent(&stack, &mut end, &mut flags, oi);
        }
        return CstStore { tag: self.tag, a: self.a, b, alt: self.alt, end, flags, next };
    }

    pub fn render_open(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if self.open.len() == 0 {
            return String::new();
        }
        return self.render_from(self.open[self.open.len() - 1], toks, rule_names, token_names);
    }

    pub fn render_at(&self, row: i32, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if row < 0 || row >= self.tag.len() || !self.tag[row] matches { Open } {
            return String::new();
        }
        return self.render_from(row, toks, rule_names, token_names);
    }

    pub fn open_rule_names(&self, rule_names: &List<String>) -> String {
        let mut out = String::from("[");
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            if i < self.open.len() - 1 {
                out.push_str(&", ");
            }
            let kind = self.a[self.open[i]];
            let name = if kind == K_ERROR as i32 { "<error>" } else { rule_names[kind] };
            out.push_str(&name);
        }
        out.push_str(&"]");
        return out;
    }

    pub fn render_last_finished(
        &self,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if self.last_finished < 0 {
            return String::new();
        }
        return self.render_from(self.last_finished, toks, rule_names, token_names);
    }

    fn render_from(
        &self,
        root: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(128);
        let _ = render_builder_node(&mut out, &self.tag, &self.a, root, toks, rule_names, token_names);
        return out;
    }
}

fn render_builder_node(
    out: &mut String,
    tag: &List<EventTag>,
    a: &List<i32>,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) -> i32 {
    let name = if a[i] == K_ERROR as i32 { "<error>" } else { rule_names[a[i]] };
    if i + 1 >= tag.len() || tag[i + 1] matches { Close } {
        out.push_str(&name);
        if i + 1 < tag.len() {
            return i + 2;
        }
        return i + 1;
    }
    out.push_str(&"(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < tag.len() {
        match tag[c] {
            Open => {
                out.push_str(&" ");
                c = render_builder_node(out, tag, a, c, toks, rule_names, token_names);
            },
            Close => {
                out.push_str(&")");
                return c + 1;
            },
            Tok => {
                if !toks.is_empty_text(a[c]) {
                    out.push_str(&" ");
                    toks.push_token_text_escaped(out, a[c]);
                }
                c += 1;
            },
            Miss => {
                out.push_str(&` <missing ${token_names[toks.kind_at(a[c])]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(&" <skip ");
                toks.push_token_text_escaped(out, a[c]);
                out.push_str(&">");
                c += 1;
            },
        }
    }
    out.push_str(&")");
    return c;
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let chars = tokens.chars;
    let mut line_starts: List<i32> = [0];
    for let mut i = 0; i < chars.len(); i += 1 {
        if chars[i] == '\n' {
            line_starts.push(i + 1);
        }
    }
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &line_starts,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &line_starts,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    line_starts: &List<i32>,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let mut text_buf = String::with_capacity(16);
    if is_eof {
        text_buf.push_str(&"<EOF>");
    } else {
        for let mut j = start; j < end; j += 1 {
            let c = tokens.chars[j];
            match c {
                '\n' => text_buf.push_str(&"\\n"),
                '\r' => text_buf.push_str(&"\\r"),
                '\t' => text_buf.push_str(&"\\t"),
                _ => text_buf.push(c),
            }
        }
    }
    let type_id = if is_eof { -1 } else { kind + 1 };
    let line_col = line_col_from_starts(line_starts, start);
    let line = line_col.0;
    let col = line_col.1;
    let end_inclusive = end - 1;
    let channel_attr = if channel != 0 { `channel=${channel},` } else { String::from("") };
    out.push_str(&`[@${index},${start}:${end_inclusive}='${text_buf}',<${type_id}>,${channel_attr}${line}:${col}]\n`);
}

fn line_col_from_starts(line_starts: &List<i32>, pos: i32) -> [i32, i32] {
    let mut lo = 0;
    let mut hi = line_starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if line_starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return [lo + 1, pos - line_starts[lo]];
}
use { TreeMap } from "core:collections";

pub global ATN_BASIC: i32 = 1;
pub global ATN_RULE_START: i32 = 2;
pub global ATN_RULE_STOP: i32 = 3;
pub global ATN_BLOCK_START: i32 = 4;
pub global ATN_BLOCK_END: i32 = 5;
pub global ATN_STAR_LOOP_ENTRY: i32 = 6;
pub global ATN_STAR_LOOP_BACK: i32 = 7;
pub global ATN_PLUS_LOOP_BACK: i32 = 8;
pub global ATN_LOOP_END: i32 = 9;

pub global ATN_TR_EPSILON: i32 = 0;
pub global ATN_TR_ATOM: i32 = 1;
pub global ATN_TR_NOT_ATOM: i32 = 2;
pub global ATN_TR_WILDCARD: i32 = 3;
pub global ATN_TR_RULE: i32 = 4;
pub global ATN_TR_PRECEDENCE: i32 = 5;

global ATN_ACCEPT_EOF: i32 = -2;

global ATN_CLOSURE_GUARD: i32 = 2000000;
global ATN_ARENA_CAP: i32 = 400000;

global ATN_MERGE_CACHE_STRIDE: i64 = 1000000;

global CFG_KEY_PR_SLOT: i32 = 2048;
global CFG_KEY_ALT_SLOT: i32 = 2048;
global CFG_KEY_RS_SLOT: i32 = 1048576;
global CFG_KEY_STATE_SLOT: i32 = 1048576;

pub struct AtnSim {
    pub state_kind: List<i32>,
    pub state_tr_start: List<i32>,
    pub state_tr_count: List<i32>,
    pub tr_kind: List<i32>,
    pub tr_target: List<i32>,
    pub tr_label: List<i32>,
    pub tr_follow: List<i32>,
    pub tr_prec: List<i32>,
    pub decision_state: List<i32>,
    pub rule_start: List<i32>,
    pub rule_nullable: List<bool>,
    pub rule_first: List<List<i32>>,
    pub rule_first_neg: List<List<i32>>,
    pub rule_first_open: List<bool>,
    pub state_cont_nullable: List<bool>,
    pub state_cont_first_start: List<i32>,
    pub state_cont_first_count: List<i32>,
    pub state_cont_neg_start: List<i32>,
    pub state_cont_neg_count: List<i32>,
    pub cont_first_label: List<i32>,
    pub cont_neg_label: List<i32>,
    pub state_cont_first_open: List<bool>,
}

global CTX_BOUNDARY: i32 = -3;

global CTX_EMPTY: i32 = 0;

struct CtxArena {
    edges: List<List<[i32, i32, i32]>>,
    intern: TreeMap<i64, List<i32>>,
    merge_cache: TreeMap<i64, i32>,
}

struct AtnConfig {
    state: i32,
    alt: i32,
    pctx: i32,
    rs: i32,
    pr: i32,
}

impl CtxArena {
    fn new() -> CtxArena {
        let empty: List<[i32, i32, i32]> = [];
        return CtxArena {
            edges: [empty],
            intern: TreeMap::<i64, List<i32>>::new(),
            merge_cache: TreeMap::<i64, i32>::new(),
        };
    }

    fn hash_of(edges: &List<[i32, i32, i32]>) -> i64 {
        let mut h: i64 = 1469598103934665603;
        for let e of edges {
            h = (h ^ e.0 as i64 + 1) * 1099511628211;
            h = (h ^ e.1 as i64 + 1) * 1099511628211;
            h = (h ^ e.2 as i64 + 1) * 1099511628211;
        }
        return h & 4611686018427387903;
    }

    fn intern_edges(&mut self, sorted: &List<[i32, i32, i32]>) -> i32 {
        if sorted.is_empty() {
            return CTX_EMPTY;
        }
        let h = CtxArena::hash_of(sorted);
        if let Some(cands) = self.intern.get(h) {
            for let id of &cands {
                if edge_lists_eq(&self.edges[*id], sorted) {
                    return *id;
                }
            }
        }
        let id = self.edges.len();
        self.edges.push(*sorted);
        let mut cands = if let Some(c) = self.intern.get(h) {
            c;
        } else {
            [] as List<i32>;
        };
        cands.push(id);
        self.intern[h] = cands;
        return id;
    }

    fn push(&mut self, return_state: i32, restore_pr: i32, parent: i32) -> i32 {
        let one: List<[i32, i32, i32]> = [
            [return_state, restore_pr, parent],
        ];
        return self.intern_edges(&one);
    }

    fn edges_view(&self, id: i32) -> List<[i32, i32, i32]> {
        if id == CTX_EMPTY {
            return [
                [CTX_BOUNDARY, 0, CTX_EMPTY],
            ];
        }
        return self.edges[id];
    }

    fn merge(&mut self, a: i32, b: i32) -> i32 {
        if a == b {
            return a;
        }
        let lo = if a < b { a } else { b };
        let hi = if a < b { b } else { a };
        assert ATN_MERGE_CACHE_STRIDE > ATN_ARENA_CAP as i64, "the merge-cache stride must exceed the arena cap, or two arena id pairs alias onto one key";
        let ck = lo as i64 * ATN_MERGE_CACHE_STRIDE + hi as i64;
        if let Some(id) = self.merge_cache.get(ck) {
            return id;
        }
        let ea = self.edges_view(a);
        let eb = self.edges_view(b);
        let mut keys: List<[i32, i32]> = [];
        let mut parents: List<i32> = [];
        for let src of [&ea, &eb] {
            for let e of *src {
                let rk = [e.0, e.1];
                let mut found = -1;
                for let mut i = 0; i < keys.len(); i += 1 {
                    if keys[i].0 == rk.0 && keys[i].1 == rk.1 {
                        found = i;
                        break;
                    }
                }
                if found < 0 {
                    keys.push(rk);
                    parents.push(e.2);
                } else {
                    parents[found] = self.merge(parents[found], e.2);
                }
            }
        }
        let mut merged: List<[i32, i32, i32]> = [];
        for let mut i = 0; i < keys.len(); i += 1 {
            merged.push([keys[i].0, keys[i].1, parents[i]]);
        }
        sort_ctx_edges(&mut merged);
        let id = self.intern_edges(&merged);
        self.merge_cache[ck] = id;
        return id;
    }
}

fn sort_ctx_edges(edges: &mut List<[i32, i32, i32]>) {
    let n = edges.len();
    for let mut i = 1; i < n; i += 1 {
        let cur = edges[i];
        let mut j = i - 1;
        while j >= 0 && ctx_edge_gt(&edges[j], &cur) {
            edges[j + 1] = edges[j];
            j -= 1;
        }
        edges[j + 1] = cur;
    }
}

fn ctx_edge_gt(a: &[i32, i32, i32], b: &[i32, i32, i32]) -> bool {
    if a.0 != b.0 {
        return a.0 > b.0;
    }
    if a.1 != b.1 {
        return a.1 > b.1;
    }
    return a.2 > b.2;
}

fn edge_lists_eq(a: &List<[i32, i32, i32]>, b: &List<[i32, i32, i32]>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for let mut i = 0; i < a.len(); i += 1 {
        if a[i].0 != b[i].0 || a[i].1 != b[i].1 || a[i].2 != b[i].2 {
            return false;
        }
    }
    return true;
}

fn atn_read_u8(bytes: &ByteList, pos: i32) -> i32 {
    return bytes.get_byte_unchecked(pos) as i32;
}

fn atn_read_u16(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    return b0 | b1 << 8;
}

fn atn_read_u24(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    let b2 = bytes.get_byte_unchecked(pos + 2) as i32;
    return b0 | b1 << 8 | b2 << 16;
}

pub fn atn_decode(bytes: &ByteList, lr_tables: bool = true) -> AtnSim {
    let mut p = 0;
    let nrules = atn_read_u16(bytes, p);
    p += 2;
    let ndec = atn_read_u16(bytes, p);
    p += 2;
    let nstates = atn_read_u16(bytes, p);
    p += 2;

    let mut rule_start: List<i32> = List::with_capacity(nrules);
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(atn_read_u16(bytes, p));
        p += 2;
    }
    let mut decision_state: List<i32> = List::with_capacity(ndec);
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let mut state_kind: List<i32> = List::with_capacity(nstates);
    for let mut i = 0; i < nstates; i += 1 {
        state_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut state_tr_start: List<i32> = List::with_capacity(nstates);
    let mut state_tr_count: List<i32> = List::with_capacity(nstates);
    let mut ntrans_total = 0;
    for let mut i = 0; i < nstates; i += 1 {
        let count = atn_read_u16(bytes, p);
        p += 2;
        state_tr_start.push(ntrans_total);
        state_tr_count.push(count);
        ntrans_total += count;
    }

    let mut tr_kind: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut tr_target: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_target.push(atn_read_u16(bytes, p) - 1);
        p += 2;
    }
    let mut tr_label: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_label.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_follow: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_follow.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_prec: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_prec.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let nrules_count = rule_start.len();
    let mut sim = AtnSim {
        state_kind,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
        rule_nullable: [],
        rule_first: [],
        rule_first_neg: [],
        rule_first_open: [],
        state_cont_nullable: [],
        state_cont_first_start: [],
        state_cont_first_count: [],
        state_cont_neg_start: [],
        state_cont_neg_count: [],
        cont_first_label: [],
        cont_neg_label: [],
        state_cont_first_open: [],
    };
    for let mut r = 0; r < nrules_count; r += 1 {
        sim.rule_nullable.push(false);
        sim.rule_first.push([]);
        sim.rule_first_neg.push([]);
        sim.rule_first_open.push(false);
    }
    let mut has_precedence = false;
    for let k of &sim.tr_kind {
        if *k == ATN_TR_PRECEDENCE {
            has_precedence = true;
            break;
        }
    }
    if lr_tables && has_precedence {
        atn_compute_first_nullable(&mut sim);
        atn_compute_state_cont(&mut sim);
    }
    return sim;
}

fn atn_compute_state_cont(sim: &mut AtnSim) {
    let nstates = sim.state_kind.len();
    for let mut st = 0; st < nstates; st += 1 {
        let mut v1: List<i32> = [];
        let nullable = atn_cont_nullable(sim, st, &mut v1);
        let mut v2: List<i32> = [];
        let mut f: List<i32> = [];
        let mut fneg: List<i32> = [];
        let open = atn_cont_first(sim, st, &mut v2, &mut f, &mut fneg);
        sim.state_cont_nullable.push(nullable);
        sim.state_cont_first_start.push(sim.cont_first_label.len());
        sim.state_cont_first_count.push(f.len());
        for let t of &f {
            sim.cont_first_label.push(*t);
        }
        sim.state_cont_neg_start.push(sim.cont_neg_label.len());
        sim.state_cont_neg_count.push(fneg.len());
        for let x of &fneg {
            sim.cont_neg_label.push(*x);
        }
        sim.state_cont_first_open.push(open);
    }
}

fn atn_compute_first_nullable(sim: &mut AtnSim) {
    let nrules = sim.rule_start.len();
    let mut changed = true;
    while changed {
        changed = false;
        for let mut r = 0; r < nrules; r += 1 {
            let mut v1: List<i32> = [];
            if atn_cont_nullable(sim, sim.rule_start[r], &mut v1) && !sim.rule_nullable[r] {
                sim.rule_nullable[r] = true;
                changed = true;
            }
            let mut v2: List<i32> = [];
            let mut f: List<i32> = [];
            let mut fneg: List<i32> = [];
            if atn_cont_first(sim, sim.rule_start[r], &mut v2, &mut f, &mut fneg) && !sim.rule_first_open[r] {
                sim.rule_first_open[r] = true;
                changed = true;
            }
            for let t of &f {
                if !sim.rule_first[r].contains(t) {
                    sim.rule_first[r].push(*t);
                    changed = true;
                }
            }
            for let x of &fneg {
                if !sim.rule_first_neg[r].contains(x) {
                    sim.rule_first_neg[r].push(*x);
                    changed = true;
                }
            }
        }
    }
}

fn atn_cont_nullable(sim: &AtnSim, state: i32, visited: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return true;
    }
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_nullable(sim, sim.tr_target[s + j], visited) {
                return true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 && sim.rule_nullable[callee] && atn_cont_nullable(sim, sim.tr_follow[s + j], visited) {
                return true;
            }
        }
    }
    return false;
}

fn atn_cont_first(sim: &AtnSim, state: i32, visited: &mut List<i32>, out: &mut List<i32>, neg: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return false;
    }
    let mut open = false;
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_ATOM {
            if !out.contains(&sim.tr_label[s + j]) {
                out.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_WILDCARD {
            open = true;
        } else if k == ATN_TR_NOT_ATOM {
            if !neg.contains(&sim.tr_label[s + j]) {
                neg.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_first(sim, sim.tr_target[s + j], visited, out, neg) {
                open = true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 {
                for let t of &sim.rule_first[callee] {
                    if !out.contains(t) {
                        out.push(*t);
                    }
                }
                for let x of &sim.rule_first_neg[callee] {
                    if !neg.contains(x) {
                        neg.push(*x);
                    }
                }
                if sim.rule_first_open[callee] {
                    open = true;
                }
                if sim.rule_nullable[callee] && atn_cont_first(sim, sim.tr_follow[s + j], visited, out, neg) {
                    open = true;
                }
            }
        }
    }
    return open;
}

fn atn_state_cont_admits(sim: &AtnSim, state: i32, t: i32, eof: i32) -> bool {
    if sim.state_cont_first_open[state] && t != eof {
        return true;
    }
    let fs = sim.state_cont_first_start[state];
    let fc = sim.state_cont_first_count[state];
    for let mut j = 0; j < fc; j += 1 {
        if sim.cont_first_label[fs + j] == t {
            return true;
        }
    }
    if t != eof {
        let ns = sim.state_cont_neg_start[state];
        let nc = sim.state_cont_neg_count[state];
        for let mut j = 0; j < nc; j += 1 {
            if sim.cont_neg_label[ns + j] != t {
                return true;
            }
        }
    }
    return false;
}

fn atn_state_consumes(sim: &AtnSim, state: i32) -> bool {
    let cnt = sim.state_tr_count[state];
    if cnt == 0 {
        return false;
    }
    let k = sim.tr_kind[sim.state_tr_start[state]];
    return k == ATN_TR_ATOM || k == ATN_TR_NOT_ATOM || k == ATN_TR_WILDCARD;
}

struct CfgSet {
    state: List<i32>,
    alt: List<i32>,
    rs: List<i32>,
    pr: List<i32>,
    pctx: List<i32>,
    index: TreeMap<i64, i32>,
}

impl CfgSet {
    fn new() -> CfgSet {
        return CfgSet {
            state: [],
            alt: [],
            rs: [],
            pr: [],
            pctx: [],
            index: TreeMap::<i64, i32>::new(),
        };
    }

    fn add(&mut self, arena: &mut CtxArena, state: i32, alt: i32, rs: i32, pr: i32, pctx: i32) -> [i32, bool] {
        assert pr + 2 < CFG_KEY_PR_SLOT, `ATN config precedence ${pr} exceeds packed-key slot`;
        assert alt + 1 < CFG_KEY_ALT_SLOT, `ATN config alt ${alt} exceeds packed-key slot`;
        assert rs + 2 < CFG_KEY_RS_SLOT, `ATN config caller-stack depth ${rs} exceeds packed-key slot`;
        assert state + 2 < CFG_KEY_STATE_SLOT, `ATN config state ${state} exceeds packed-key slot`;
        let k = (((state + 2) as i64 * CFG_KEY_RS_SLOT as i64 + (rs + 2) as i64) * CFG_KEY_ALT_SLOT as i64 + (alt + 1) as i64) * CFG_KEY_PR_SLOT as i64 + (pr + 2) as i64;
        if let Some(i) = self.index.get(k) {
            let merged = arena.merge(self.pctx[i], pctx);
            let changed = merged != self.pctx[i];
            self.pctx[i] = merged;
            return [i, changed];
        }
        let i = self.state.len();
        self.state.push(state);
        self.alt.push(alt);
        self.rs.push(rs);
        self.pr.push(pr);
        self.pctx.push(pctx);
        self.index[k] = i;
        return [i, true];
    }

    fn to_list(&self) -> List<AtnConfig> {
        let mut out: List<AtnConfig> = [];
        for let mut i = 0; i < self.state.len(); i += 1 {
            out.push(AtnConfig {
                state: self.state[i],
                alt: self.alt[i],
                pctx: self.pctx[i],
                rs: self.rs[i],
                pr: self.pr[i],
            });
        }
        return out;
    }
}

fn atn_closure(sim: &AtnSim, arena: &mut CtxArena, seeds: &List<AtnConfig>, rstk: &List<i32>) -> List<AtnConfig> {
    let mut cset = CfgSet::new();
    let mut expanded: List<i32> = [];
    let mut rset = CfgSet::new();
    let mut work: List<AtnConfig> = *seeds;
    let mut guard = 0;
    while let Some(c) = work.pop() {
        guard += 1;
        if guard > ATN_CLOSURE_GUARD {
            break;
        }
        let res = cset.add(arena, c.state, c.alt, c.rs, c.pr, c.pctx);
        let idx = res.0;
        while expanded.len() <= idx {
            expanded.push(-9);
        }
        let merged_pctx = cset.pctx[idx];
        if expanded[idx] == merged_pctx {
            continue;
        }
        expanded[idx] = merged_pctx;
        let cur = AtnConfig { state: c.state, alt: c.alt, pctx: merged_pctx, rs: c.rs, pr: c.pr };
        atn_expand(sim, arena, &cur, rstk, &mut work, &mut rset);
    }
    return rset.to_list();
}

fn atn_expand(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if cur.state == ATN_ACCEPT_EOF {
        rset.add(arena, cur.state, cur.alt, cur.rs, cur.pr, cur.pctx);
        return;
    }
    if sim.state_kind[cur.state] == ATN_RULE_STOP {
        atn_pop(sim, arena, cur, rstk, work, rset);
        return;
    }
    if atn_state_consumes(sim, cur.state) {
        rset.add(arena, cur.state, cur.alt, cur.rs, cur.pr, cur.pctx);
        return;
    }
    let start = sim.state_tr_start[cur.state];
    let cnt = sim.state_tr_count[cur.state];
    for let mut j = 0; j < cnt; j += 1 {
        let k = sim.tr_kind[start + j];
        let target = sim.tr_target[start + j];
        if k == ATN_TR_EPSILON {
            work.push(AtnConfig { state: target, alt: cur.alt, pctx: cur.pctx, rs: cur.rs, pr: cur.pr });
        } else if k == ATN_TR_PRECEDENCE {
            if sim.tr_prec[start + j] >= cur.pr {
                work.push(AtnConfig { state: target, alt: cur.alt, pctx: cur.pctx, rs: cur.rs, pr: cur.pr });
            }
        } else if k == ATN_TR_RULE {
            if target < 0 || arena.edges.len() >= ATN_ARENA_CAP {
                continue;
            }
            let npctx = arena.push(sim.tr_follow[start + j], cur.pr, cur.pctx);
            work.push(AtnConfig { state: target, alt: cur.alt, pctx: npctx, rs: cur.rs, pr: sim.tr_prec[start + j] });
        }
    }
}

fn atn_pop(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if cur.pctx == CTX_EMPTY {
        atn_rs_pop(arena, cur.state, cur.alt, cur.rs, cur.pr, rstk, work, rset);
        return;
    }
    let edges = arena.edges[cur.pctx];
    for let e of &edges {
        if e.0 == CTX_BOUNDARY {
            atn_rs_pop(arena, cur.state, cur.alt, cur.rs, cur.pr, rstk, work, rset);
        } else {
            work.push(AtnConfig { state: e.0, alt: cur.alt, pctx: e.2, rs: cur.rs, pr: e.1 });
        }
    }
}

fn atn_rs_pop(
    arena: &mut CtxArena,
    stop_state: i32,
    alt: i32,
    rs: i32,
    pr: i32,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if rs >= 0 {
        let ret = rstk[rs];
        if ret >= 0 {
            work.push(AtnConfig { state: ret, alt: alt, pctx: CTX_EMPTY, rs: rs - 1, pr: pr });
        } else if rs == 0 {
            rset.add(arena, ATN_ACCEPT_EOF, alt, -1, pr, CTX_EMPTY);
        } else {
            rset.add(arena, stop_state, alt, rs, pr, CTX_EMPTY);
        }
    } else if rstk.is_empty() {
        rset.add(arena, stop_state, alt, rs, pr, CTX_EMPTY);
    } else {
        rset.add(arena, ATN_ACCEPT_EOF, alt, -1, pr, CTX_EMPTY);
    }
}

fn atn_move(sim: &AtnSim, configs: &List<AtnConfig>, token: i32, eof: i32) -> List<AtnConfig> {
    let mut out: List<AtnConfig> = [];
    for let c of configs {
        if c.state == ATN_ACCEPT_EOF {
            if token == eof {
                out.push(*c);
            }
            continue;
        }
        if sim.state_kind[c.state] == ATN_RULE_STOP {
            out.push(*c);
            continue;
        }
        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let label = sim.tr_label[start + j];
            let matched = if k == ATN_TR_ATOM {
                label == token;
            } else if k == ATN_TR_WILDCARD {
                token != eof;
            } else if k == ATN_TR_NOT_ATOM {
                token != label && token != eof;
            } else {
                false;
            };
            if matched {
                out.push(AtnConfig { state: sim.tr_target[start + j], alt: c.alt, pctx: c.pctx, rs: c.rs, pr: c.pr });
            }
        }
    }
    return out;
}

fn atn_unique_alts(configs: &List<AtnConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return alts;
}

fn atn_min_alt(alts: &List<i32>) -> i32 {
    if alts.is_empty() {
        return -1;
    }
    let mut m = alts[0];
    for let a of alts {
        if *a < m {
            m = *a;
        }
    }
    return m;
}

fn atn_all_at_end(sim: &AtnSim, configs: &List<AtnConfig>) -> bool {
    if configs.is_empty() {
        return false;
    }
    for let c of configs {
        if c.state != ATN_ACCEPT_EOF && sim.state_kind[c.state] != ATN_RULE_STOP {
            return false;
        }
    }
    return true;
}

pub global ATN_NO_DISABLED: List<i32> = [];

pub fn atn_predict_with_stack(
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32 = 0,
    disabled_alts: &List<i32> = &ATN_NO_DISABLED,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let start = sim.state_tr_start[dstate];
    let cnt = sim.state_tr_count[dstate];
    let rs_init = rule_stack.len() - 1;
    let mut arena = CtxArena::new();
    let mut seeds: List<AtnConfig> = [];
    for let mut j = 0; j < cnt; j += 1 {
        if sim.tr_kind[start + j] == ATN_TR_PRECEDENCE && sim.tr_prec[start + j] < min_prec {
            continue;
        }
        if !disabled_alts.is_empty() && disabled_alts.contains(&j) {
            continue;
        }
        seeds.push(AtnConfig { state: sim.tr_target[start + j], alt: j, pctx: CTX_EMPTY, rs: rs_init, pr: min_prec });
    }
    let mut configs = atn_closure(sim, &mut arena, &seeds, rule_stack);
    let mut pos = start_pos;
    let mut prev = atn_unique_alts(&configs);
    let limit = tokens.len() - start_pos + 8;
    let mut guard = 0;
    loop {
        guard += 1;
        if guard > limit {
            return atn_min_alt(&prev);
        }
        let alts = atn_unique_alts(&configs);
        if alts.is_empty() {
            return atn_min_alt(&prev);
        }
        if alts.len() == 1 {
            return alts[0];
        }
        if atn_all_at_end(sim, &configs) {
            return atn_min_alt(&alts);
        }
        prev = alts;
        let token = if pos < tokens.len() { tokens[pos] } else { eof };
        let moved = atn_move(sim, &configs, token, eof);
        pos += 1;
        configs = atn_closure(sim, &mut arena, &moved, rule_stack);
    }
}

pub fn atn_lr_loop_decision(
    sim: &AtnSim,
    rule_stack: &List<i32>,
    decision: i32,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let t = if pos < tokens.len() { tokens[pos] } else { eof };
    let s = sim.state_tr_start[dstate];
    let c = sim.state_tr_count[dstate];
    let exit_alt = c - 1;
    if atn_caller_mandates(sim, rule_stack, t, eof) {
        return exit_alt;
    }
    for let mut j = 0; j < c; j += 1 {
        if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE {
            if sim.tr_prec[s + j] < min_prec {
                continue;
            }
            let tgt = sim.tr_target[s + j];
            if atn_state_cont_admits(sim, tgt, t, eof) {
                return j;
            }
        }
    }
    return exit_alt;
}

fn atn_caller_mandates(sim: &AtnSim, rule_stack: &List<i32>, t: i32, eof: i32) -> bool {
    let mut i = rule_stack.len() - 1;
    while i >= 0 {
        let ret = rule_stack[i];
        if ret < 0 {
            return i == 0 && t == eof;
        }
        if sim.state_cont_nullable[ret] {
            i -= 1;
            continue;
        }
        return atn_state_cont_admits(sim, ret, t, eof);
    }
    return false;
}

pub fn atn_adaptive_predict(sim: &AtnSim, decision: i32, tokens: &Array<i32>, start_pos: i32, eof: i32) -> i32 {
    let empty: List<i32> = [];
    return atn_predict_with_stack(sim, decision, &empty, tokens, start_pos, eof);
}
pub enum TokenKind {
    ID,
    WS,
    Eof,
    Error,
}

pub global TK_ID: i32 = 0;
pub global TK_WS: i32 = 1;
pub global TK_EOF: i32 = 2;
pub global TK_ERROR: i32 = 3;
pub global TK_LIT_SEMI: i32 = 4;
pub global TK_LIT_AND: i32 = 5;
pub global TK_LIT_NOT: i32 = 6;
pub global TK_LIT_IN: i32 = 7;
pub global TK_LIT_LIKE: i32 = 8;
pub global TK_LIT_BETWEEN: i32 = 9;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice with stores[self] {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_ID(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { 'a'..='z' | 'A'..='Z' | '_' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !((chars[pos] matches { 'a'..='z' | 'A'..='Z' | '_' | '0'..='9' })) { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            if pos >= chars.len() { break rep_1; }
            if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' })) { break rep_1; }
            pos += 1;
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_lit_semi(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ';' { return -1; }
    return pos + 1;
}

fn try_lit_and(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'a' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'n' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'd' { return -1; }
    return pos + 3;
}

fn try_lit_not(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'n' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'o' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 't' { return -1; }
    return pos + 3;
}

fn try_lit_in(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'i' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'n' { return -1; }
    return pos + 2;
}

fn try_lit_like(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'l' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'i' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'k' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'e' { return -1; }
    return pos + 4;
}

fn try_lit_between(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'b' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'e' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 't' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'w' { return -1; }
    if pos + 4 >= chars.len() || chars[pos + 4] != 'e' { return -1; }
    if pos + 5 >= chars.len() || chars[pos + 5] != 'e' { return -1; }
    if pos + 6 >= chars.len() || chars[pos + 6] != 'n' { return -1; }
    return pos + 7;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char matches { '\t' | '\n' | '\r' | ' ' } {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char matches { ';' } {
            end = try_lit_semi(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_SEMI; }
        } else if first_char matches { '_' } {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'a' } {
            end = try_lit_and(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_AND; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'b' } {
            end = try_lit_between(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BETWEEN; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'i' } {
            end = try_lit_in(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_IN; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'l' } {
            end = try_lit_like(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LIKE; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'n' } {
            end = try_lit_not(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_NOT; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'a'..='z' | 'A'..='Z' } {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_SEMI => "';'",
        TK_LIT_AND => "'and'",
        TK_LIT_NOT => "'not'",
        TK_LIT_IN => "'in'",
        TK_LIT_LIKE => "'like'",
        TK_LIT_BETWEEN => "'between'",
        _ => "Unknown",
    };
}

pub global RK_STAT: NodeKind = 0;
pub global RK_EXPR: NodeKind = 1;

global RULE_NAMES: List<String> = ["stat", "expr"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    pending_code: DiagnosticCode,
    speculating: bool,
    max_errors: i32,
    atn_stack: List<i32>,
    atn_ret_pending: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX, atn_stack: [], atn_ret_pending: -1, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: &List<i32>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, kind_names(expected), lc.0, lc.1);
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        let take = if let Some(cur) = &self.pending { span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(self.error(message, span, expected));
            self.pending_code = code;
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn report_missing(&mut self, kind: i32, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        let name = token_kind_name(kind);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));
    }

    fn report_unexpected(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail(`got "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), &([kind] as List<i32>), DiagnosticCode::UnexpectedToken);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(self.tokens.span_at(self.pos));
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind, self.tokens.span_at(self.pos));
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(self.tokens.span_at(self.pos));
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &([kind] as List<i32>),
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token; got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !self.in_set(k, excluded) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `unexpected token "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if self.in_set(k, included) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            included,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }
}

fn scan_stat(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    SCAN_STACK.push(8);
    pos = scan_expr(tokens, pos, 0);
    SCAN_STACK.pop();
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_SEMI { return -1; }
    pos += 1;
    return pos;
}

fn scan_expr_atom(tokens: &Array<i32>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos] != TK_ID { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_BETWEEN {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_BETWEEN { break try_1; }
                pos += 1;
                SCAN_STACK.push(20);
                pos = scan_expr(tokens, pos, 0);
                SCAN_STACK.pop();
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_AND { break try_1; }
                pos += 1;
                SCAN_STACK.push(24);
                pos = scan_expr(tokens, pos, 0);
                SCAN_STACK.pop();
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expr_lr_1(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_AND { return -1; }
    pos += 1;
    SCAN_STACK.push(32);
    pos = scan_expr(tokens, pos, 4);
    SCAN_STACK.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr_lr_2(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && tokens[pos] == TK_LIT_NOT {
        pos += 1;
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_IN { return -1; }
    pos += 1;
    SCAN_STACK.push(41);
    pos = scan_expr(tokens, pos, 3);
    SCAN_STACK.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr_lr_3(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && tokens[pos] == TK_LIT_NOT {
        pos += 1;
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LIKE { return -1; }
    pos += 1;
    SCAN_STACK.push(50);
    pos = scan_expr(tokens, pos, 2);
    SCAN_STACK.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_expr_atom(tokens, pos);
    if pos < 0 { return -1; }
    loop {
        let mut _atn_alt = atn_lr_loop_decision(&ATN_SIM, &SCAN_STACK, 1, tokens, pos, TK_EOF, min_prec);
        if _atn_alt == 1 || _atn_alt == 2 {
            let mut _lr_best: i32 = -1;
            let mut _lr_s_1: i32 = -1;
            if 2 >= min_prec {
                _lr_s_1 = scan_expr_lr_2(tokens, pos);
            }
            let mut _lr_s_2: i32 = -1;
            if 1 >= min_prec {
                _lr_s_2 = scan_expr_lr_3(tokens, pos);
            }
            if _lr_s_1 > _lr_best {
                _lr_best = _lr_s_1;
                _atn_alt = 1;
            }
            if _lr_s_2 > _lr_best {
                _lr_best = _lr_s_2;
                _atn_alt = 2;
            }
        }
        let _lr_pos0 = pos;
        if _atn_alt == 0 {
            pos = scan_expr_lr_1(tokens, pos);
            if pos < 0 { return -1; }
        } else if _atn_alt == 1 {
            pos = scan_expr_lr_2(tokens, pos);
            if pos < 0 { return -1; }
        } else if _atn_alt == 2 {
            pos = scan_expr_lr_3(tokens, pos);
            if pos < 0 { return -1; }
        } else {
            break;
        }
        if pos == _lr_pos0 {
            break;
        }
    }
    return pos;
}

fn _parse_stat__inner(p: &mut Parser) -> () {
    p.atn_ret_pending = 8;
    _parse_expr(p);
    p.expect(TK_LIT_SEMI, &EMPTY_SYNC);
    return;
}

fn _parse_stat(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    let _start = p.peek_start();
    p.b.start_node(RK_STAT, _start);
    _parse_stat__inner(p);
    p.b.finish_node(p.last_end());
    p.atn_stack.pop();
    if p.recovering {
        p.push_rule_stack("stat");
    }
}

fn _parse_expr__inner_atom(p: &mut Parser, min_prec: i32 = 0) -> () {
    let kind = p.peek_kind();
    if kind == TK_ID {
        p.expect(TK_ID, &EMPTY_SYNC);
        return;
    }
    if kind == TK_LIT_BETWEEN {
        p.expect(TK_LIT_BETWEEN, &SYNC_0);
        p.atn_ret_pending = 20;
        _parse_expr(p);
        p.expect(TK_LIT_AND, &SYNC_0);
        p.atn_ret_pending = 24;
        _parse_expr(p, 1);
        return;
    }
    p.no_viable(
        "no alternative of expr matches",
        p.peek_span(),
        &SYNC_0,
    );
    return;
}

fn _parse_expr__inner(p: &mut Parser, min_prec: i32 = 0) -> () {
    let _cp = p.b.checkpoint();
    let _start = p.peek_start();
    p.b.start_node(RK_EXPR, _start);
    _parse_expr__inner_atom(p, min_prec);
    p.b.finish_node(p.last_end());
    loop {
        if p.recovering { break; }
        let mut _atn_alt = atn_lr_loop_decision(&ATN_SIM, &p.atn_stack, 1, &p.kinds, p.pos, TK_EOF, min_prec);
        if _atn_alt == 1 || _atn_alt == 2 {
            let mut _lr_best: i32 = -1;
            let mut _lr_s_1: i32 = -1;
            if 2 >= min_prec {
                _lr_s_1 = scan_expr_lr_2(&p.kinds, p.pos);
            }
            let mut _lr_s_2: i32 = -1;
            if 1 >= min_prec {
                _lr_s_2 = scan_expr_lr_3(&p.kinds, p.pos);
            }
            if _lr_s_1 > _lr_best {
                _lr_best = _lr_s_1;
                _atn_alt = 1;
            }
            if _lr_s_2 > _lr_best {
                _lr_best = _lr_s_2;
                _atn_alt = 2;
            }
        }
        let _lr_pos0 = p.pos;
        if _atn_alt == 0 {
            p.b.start_node_at(_cp, RK_EXPR, _start);
            p.expect(TK_LIT_AND, &EMPTY_SYNC);
            p.atn_ret_pending = 32;
            _parse_expr(p, 4);
            p.b.finish_node(p.last_end());
        } else if _atn_alt == 1 {
            p.b.start_node_at(_cp, RK_EXPR, _start);
            if p.peek_kind() == TK_LIT_NOT {
                p.expect(TK_LIT_NOT, &EMPTY_SYNC);
            }
            p.expect(TK_LIT_IN, &EMPTY_SYNC);
            p.atn_ret_pending = 41;
            _parse_expr(p, 3);
            p.b.finish_node(p.last_end());
        } else if _atn_alt == 2 {
            p.b.start_node_at(_cp, RK_EXPR, _start);
            if p.peek_kind() == TK_LIT_NOT {
                p.expect(TK_LIT_NOT, &EMPTY_SYNC);
            }
            p.expect(TK_LIT_LIKE, &EMPTY_SYNC);
            p.atn_ret_pending = 50;
            _parse_expr(p, 2);
            p.b.finish_node(p.last_end());
        } else {
            break;
        }
        if p.pos == _lr_pos0 {
            break;
        }
    }
    return;
}

fn _parse_expr(p: &mut Parser, min_prec: i32 = 0) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    _parse_expr__inner(p, min_prec);
    p.atn_stack.pop();
    if p.recovering {
        p.push_rule_stack("expr");
    }
}

fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(e) = &p.pending {
            let lc = line_col(p.tokens.chars, e.span.start);
            let mut d = Diagnostic::error(p.pending_code, e.full_message(), e.span, lc.0, lc.1);
            d.rule_stack = e.rule_stack;
            p.diagnostics.push(d);
        }
    }
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_stat(input, max_errors);
}

pub fn parse_stat(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_stat(p));
}

pub fn parse_expr(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expr(p));
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(10);
    for let mut k = 0; k < 10; k += 1 {
        v.push(token_kind_name(k));
    }
    return v;
}

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &_token_names());
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &_token_names());
    }
    return String::new();
}

