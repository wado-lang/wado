    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_labeled_element(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<LabeledElementNode, ParseError>::Err(_d);
            }
        }
        return Result::<LabeledElementNode, ParseError>::Err(_e);
    }
    return _result;
}

