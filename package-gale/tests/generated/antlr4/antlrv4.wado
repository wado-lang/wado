pub fn parse_grammar_spec(input: &String) -> Result<GrammarSpecNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_grammar_spec(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<GrammarSpecNode, ParseError>::Err(_d);
            }
        }
        return Result::<GrammarSpecNode, ParseError>::Err(_e);
    }
    return _result;
}

