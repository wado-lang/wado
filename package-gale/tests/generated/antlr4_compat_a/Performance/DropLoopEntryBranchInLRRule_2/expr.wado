use { TreeMap } from "core:collections";

// ATN wire-format constants — the single source of truth for the serialized
// blob layout, shared by the builder/serializer in `src/atn.wado` (which
// `use`s these) and the decoder/simulator below. They live here, not in
// `atn.wado`, because this runtime is `#include_str`'d verbatim into every
// generated parser and so cannot import from the compiler crate — whereas
// the compiler crate is free to `use` the runtime. Bump `ATN_BLOB_VERSION`
// on any layout change so a stale committed blob fails loudly.
pub global ATN_BLOB_MAGIC: i32 = 0x47_41_54_4e;
pub global ATN_BLOB_VERSION: i32 = 2;

// State kinds. `atn_decode` copies every state's kind through verbatim and
// the simulator only interprets `RULE_STOP` / `BLOCK_START` / `BLOCK_END`,
// but the builder writes the full enumeration, so the whole set lives here
// to keep one numbering authority (no split-numbering hazard across files).
pub global ATN_BASIC: i32 = 1;
pub global ATN_RULE_START: i32 = 2;
pub global ATN_RULE_STOP: i32 = 3;
pub global ATN_BLOCK_START: i32 = 4;
pub global ATN_BLOCK_END: i32 = 5;
pub global ATN_STAR_LOOP_ENTRY: i32 = 6;
pub global ATN_STAR_LOOP_BACK: i32 = 7;
pub global ATN_PLUS_LOOP_BACK: i32 = 8;
pub global ATN_LOOP_END: i32 = 9;

// Transition kinds. `label`/`follow`/`prec` carry kind-specific data
// (see `AtnTransition` in `atn.wado`).
pub global ATN_TR_EPSILON: i32 = 0;
pub global ATN_TR_ATOM: i32 = 1;
pub global ATN_TR_NOT_ATOM: i32 = 2;
pub global ATN_TR_WILDCARD: i32 = 3;
pub global ATN_TR_RULE: i32 = 4;
// Precedence-predicate edge `{prec_i >= pr}?`, emitted on a
// left-recursive rule's loop-entry decision (one per LR alt). `prec`
// carries the alt's own precedence (`prec_i`); the simulator compares it
// against the current min-prec context `pr` and prunes the edge when the
// predicate is false. Traversed like epsilon otherwise. Precedence
// evaluation itself lands in P4.3; until then closure walks it
// unconditionally (no LR grammar routes through the simulator yet).
pub global ATN_TR_PRECEDENCE: i32 = 5;

/// Sentinel "state": a config that has returned past the real stack bottom
/// and is viable only if the next token is EOF (the start rule's follow).
#[allow(dead_code)]
global ATN_ACCEPT_EOF: i32 = -2;

/// Bounds that keep a pathological closure (deep recursion, config blow-up)
/// from looping forever. On overflow the predictor bails to the lowest
/// viable alt — the same conservative answer it gives on a true conflict.
#[allow(dead_code)]
global ATN_MAX_STACK: i32 = 64;
#[allow(dead_code)]
global ATN_MAX_CONFIGS: i32 = 6000;
/// Safety caps for the merged closure. With graph-merged contexts the work is
/// polynomial for any finite input, so these are only tripped by pathological
/// epsilon-cycle grammars; on overflow the predictor bails to the lowest
/// viable alt (the same conservative answer as a true conflict). Generous so
/// realistic deep recursion never approximates.
#[allow(dead_code)]
global ATN_CLOSURE_GUARD: i32 = 2000000;
#[allow(dead_code)]
global ATN_ARENA_CAP: i32 = 400000;

/// The decoded ATN, in struct-of-arrays form. Decoded once from the
/// serialized blob (into the module-level `GALE_ATN_SIM` in a generated
/// parser) and read (never mutated) during prediction.
pub struct AtnSim {
    pub state_kind: List<i32>,
    pub state_rule: List<i32>,
    pub state_decision: List<i32>,
    pub state_tr_start: List<i32>,
    pub state_tr_count: List<i32>,
    pub tr_kind: List<i32>,
    pub tr_src: List<i32>,
    pub tr_target: List<i32>,
    pub tr_label: List<i32>,
    pub tr_follow: List<i32>,
    pub tr_prec: List<i32>,
    pub decision_state: List<i32>,
    pub rule_start: List<i32>,
    pub rule_stop: List<i32>,
    pub num_tokens: i32,
    /// Per-rule FIRST / nullability, computed once from the decoded ATN (not
    /// from the blob). `rule_nullable[r]` — can rule `r` derive empty;
    /// `rule_first[r]` — the explicit token kinds rule `r` can start with;
    /// `rule_first_neg[r]` — labels EXCLUDED by `~X` edges in rule `r`'s FIRST
    /// (a `~X` start admits any token but `X`); `rule_first_open[r]` — rule
    /// `r`'s FIRST admits a true wildcard `.`. Together these answer
    /// `atn_first_admits`. They drive the LR loop-entry decision's
    /// caller-mandatory check (`atn_lr_loop_decision`).
    pub rule_nullable: List<bool>,
    pub rule_first: List<List<i32>>,
    pub rule_first_neg: List<List<i32>>,
    pub rule_first_open: List<bool>,
}

/// Sentinel return state inside a `PredictionContext`: this branch's
/// during-prediction stack is empty, so a rule-stop reaching it falls back to
/// the caller stack (`rs` / `rule_stack`). Distinct from real ATN state ids
/// (>= 0) and from the -1 start-frame / -2 EOF markers used on `rule_stack`.
#[allow(dead_code)]
global CTX_BOUNDARY: i32 = -3;

/// The empty during-prediction context (no frames entered yet). A config with
/// `ctx == CTX_EMPTY` pops straight to the caller stack.
#[allow(dead_code)]
global CTX_EMPTY: i32 = 0;

/// Graph-structured during-prediction stack ("PredictionContext" DAG). Each
/// node is a *set* of edges `[return_state, restore_pr, parent]`; identical
/// edge-sets are hash-consed to one id, and configs reaching the same
/// `(state, alt, rs, pr)` via different stacks are merged by unioning their
/// contexts here. This collapses what would otherwise be an exponential number
/// of distinct list-stacks under deep left recursion into a polynomial DAG —
/// the core of the ALL(*) tractability guarantee. Built fresh per prediction.
///
/// `edges[id]` is the node's edge list; `edges[CTX_EMPTY]` is empty. `intern`
/// maps a canonical edge-set key to its id; `merge_cache` memoizes `merge`.
struct CtxArena {
    edges: List<List<[i32, i32, i32]>>,
    // Hash -> candidate node ids (collision buckets; edges compared on lookup).
    intern: TreeMap<i64, List<i32>>,
    merge_cache: TreeMap<i64, i32>,
}

/// One ATN configuration. `ctx` is the graph-structured during-prediction
/// stack (a `CtxArena` node id); `rs` indexes the caller's pre-existing parse
/// stack (the next outer frame to return into once `ctx` empties, or -1 for
/// SLL / exhausted). `pr` is the current min-precedence context.
struct AtnConfig {
    state: i32,
    alt: i32,
    ctx: i32,
    rs: i32,
    pr: i32,
}


impl CtxArena {
    fn new() -> CtxArena {
        // Node 0 = CTX_EMPTY (no edges).
        let empty: List<[i32, i32, i32]> = [];
        return CtxArena {
            edges: [empty],
            intern: TreeMap::<i64, List<i32>>::new(),
            merge_cache: TreeMap::<i64, i32>::new(),
        };
    }

    /// FNV-style hash of a sorted edge set (the interning key).
    fn hash_of(edges: &List<[i32, i32, i32]>) -> i64 {
        let mut h: i64 = 1469598103934665603;
        for let e of edges {
            h = (h ^ e.0 as i64 + 1) * 1099511628211;
            h = (h ^ e.1 as i64 + 1) * 1099511628211;
            h = (h ^ e.2 as i64 + 1) * 1099511628211;
        }
        return h & 4611686018427387903;
    }

    /// Intern a (already sorted, deduped) edge set, returning its node id.
    /// Collisions on the i64 hash are resolved by comparing edge lists.
    fn intern_edges(&mut self, sorted: &List<[i32, i32, i32]>) -> i32 {
        if sorted.is_empty() {
            return CTX_EMPTY;
        }
        let h = CtxArena::hash_of(sorted);
        if let Some(cands) = self.intern.get(h) {
            for let id of &cands {
                if edge_lists_eq(&self.edges[*id], sorted) {
                    return *id;
                }
            }
        }
        let id = self.edges.len();
        self.edges.push(*sorted);
        let mut cands = if let Some(c) = self.intern.get(h) {
            c;
        } else {
            [] as List<i32>;
        };
        cands.push(id);
        self.intern[h] = cands;
        return id;
    }

    /// Push a frame: a context with the single edge `(return_state, restore_pr,
    /// parent)`.
    fn push(&mut self, return_state: i32, restore_pr: i32, parent: i32) -> i32 {
        let one: List<[i32, i32, i32]> = [
            [return_state, restore_pr, parent],
        ];
        return self.intern_edges(&one);
    }

    /// The edge view of a node, treating `CTX_EMPTY` as a single boundary edge
    /// so it can be unioned with real frames during a merge.
    fn edges_view(&self, id: i32) -> List<[i32, i32, i32]> {
        if id == CTX_EMPTY {
            return [
                [CTX_BOUNDARY, 0, CTX_EMPTY],
            ];
        }
        return self.edges[id];
    }

    /// Merge two contexts into one whose branch-set is their union. Edges with
    /// the same `(return_state, restore_pr)` collapse, their parents merged
    /// recursively; memoized so the whole operation stays polynomial.
    fn merge(&mut self, a: i32, b: i32) -> i32 {
        if a == b {
            return a;
        }
        let lo = if a < b { a } else { b };
        let hi = if a < b { b } else { a };
        let ck = lo as i64 * 1000000 + hi as i64;
        if let Some(id) = self.merge_cache.get(ck) {
            return id;
        }
        let ea = self.edges_view(a);
        let eb = self.edges_view(b);
        // Group edges by (return_state, restore_pr), merging parents.
        let mut keys: List<[i32, i32]> = [];
        let mut parents: List<i32> = [];
        for let src of [&ea, &eb] {
            for let e of *src {
                let rk = [e.0, e.1];
                let mut found = -1;
                for let mut i = 0; i < keys.len(); i += 1 {
                    if keys[i].0 == rk.0 && keys[i].1 == rk.1 {
                        found = i;
                        break;
                    }
                }
                if found < 0 {
                    keys.push(rk);
                    parents.push(e.2);
                } else {
                    parents[found] = self.merge(parents[found], e.2);
                }
            }
        }
        let mut merged: List<[i32, i32, i32]> = [];
        for let mut i = 0; i < keys.len(); i += 1 {
            merged.push([keys[i].0, keys[i].1, parents[i]]);
        }
        sort_ctx_edges(&mut merged);
        let id = self.intern_edges(&merged);
        self.merge_cache[ck] = id;
        return id;
    }
}

/// Sort an edge list by (return_state, restore_pr, parent) so interning keys
/// are canonical regardless of insertion order.
#[allow(dead_code)]
fn sort_ctx_edges(edges: &mut List<[i32, i32, i32]>) {
    let n = edges.len();
    for let mut i = 1; i < n; i += 1 {
        let cur = edges[i];
        let mut j = i - 1;
        while j >= 0 && ctx_edge_gt(&edges[j], &cur) {
            edges[j + 1] = edges[j];
            j -= 1;
        }
        edges[j + 1] = cur;
    }
}

#[allow(dead_code)]
fn ctx_edge_gt(a: &[i32, i32, i32], b: &[i32, i32, i32]) -> bool {
    if a.0 != b.0 {
        return a.0 > b.0;
    }
    if a.1 != b.1 {
        return a.1 > b.1;
    }
    return a.2 > b.2;
}

/// Structural equality of two (sorted) edge lists, for interning-collision
/// disambiguation.
#[allow(dead_code)]
fn edge_lists_eq(a: &List<[i32, i32, i32]>, b: &List<[i32, i32, i32]>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for let mut i = 0; i < a.len(); i += 1 {
        if a[i].0 != b[i].0 || a[i].1 != b[i].1 || a[i].2 != b[i].2 {
            return false;
        }
    }
    return true;
}

/// Decode the serialized ATN blob into `AtnSim`. Mirrors the layout of
/// `atn.wado::serialize_atn`.
#[allow(dead_code)]
pub fn atn_decode(data: &List<i32>) -> AtnSim {
    let mut p = 0;
    let magic = data[p];
    p += 1;
    let version = data[p];
    p += 1;
    assert magic == ATN_BLOB_MAGIC, `ATN blob magic mismatch: {magic}`;
    assert version == ATN_BLOB_VERSION, `ATN blob version mismatch: {version}`;
    let num_tokens = data[p];
    p += 1;

    let nrules = data[p];
    p += 1;
    let mut rule_start: List<i32> = [];
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(data[p]);
        p += 1;
    }
    let mut rule_stop: List<i32> = [];
    for let mut i = 0; i < nrules; i += 1 {
        rule_stop.push(data[p]);
        p += 1;
    }
    let ndec = data[p];
    p += 1;
    let mut decision_state: List<i32> = [];
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(data[p]);
        p += 1;
    }

    let nstates = data[p];
    p += 1;
    let mut state_kind: List<i32> = [];
    let mut state_rule: List<i32> = [];
    let mut state_decision: List<i32> = [];
    let mut state_tr_start: List<i32> = [];
    let mut state_tr_count: List<i32> = [];
    let mut tr_kind: List<i32> = [];
    let mut tr_src: List<i32> = [];
    let mut tr_target: List<i32> = [];
    let mut tr_label: List<i32> = [];
    let mut tr_follow: List<i32> = [];
    let mut tr_prec: List<i32> = [];
    for let mut i = 0; i < nstates; i += 1 {
        let kind = data[p];
        p += 1;
        let rule = data[p];
        p += 1;
        let decision = data[p];
        p += 1;
        let ntrans = data[p];
        p += 1;
        state_kind.push(kind);
        state_rule.push(rule);
        state_decision.push(decision);
        state_tr_start.push(tr_kind.len());
        state_tr_count.push(ntrans);
        for let mut j = 0; j < ntrans; j += 1 {
            tr_kind.push(data[p]);
            p += 1;
            tr_src.push(i);
            tr_target.push(data[p]);
            p += 1;
            tr_label.push(data[p]);
            p += 1;
            tr_follow.push(data[p]);
            p += 1;
            tr_prec.push(data[p]);
            p += 1;
        }
    }
    let nrules_count = rule_start.len();
    let mut sim = AtnSim {
        state_kind,
        state_rule,
        state_decision,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_src,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
        rule_stop,
        num_tokens,
        rule_nullable: [],
        rule_first: [],
        rule_first_neg: [],
        rule_first_open: [],
    };
    for let mut r = 0; r < nrules_count; r += 1 {
        sim.rule_nullable.push(false);
        sim.rule_first.push([]);
        sim.rule_first_neg.push([]);
        sim.rule_first_open.push(false);
    }
    // The FIRST/nullable fixpoint feeds only the LR loop-entry decision
    // (`atn_lr_loop_decision` / `atn_caller_mandates`), which exists solely
    // for rules with precedence edges. A grammar without any precedence edge
    // (e.g. one that needs the simulator only for a non-greedy `??`) never
    // reads this data, so skip the whole fixpoint there.
    let mut has_precedence = false;
    for let k of &sim.tr_kind {
        if *k == ATN_TR_PRECEDENCE {
            has_precedence = true;
            break;
        }
    }
    if has_precedence {
        atn_compute_first_nullable(&mut sim);
    }
    return sim;
}

/// Fill `rule_nullable` / `rule_first` / `rule_first_open` by a monotone
/// fixpoint over the ATN: each pass recomputes every rule's FIRST/nullable
/// from the current values (used for rule-ref edges), stopping when nothing
/// grows. Runs once at decode, and only when the ATN has precedence edges
/// (see `atn_decode`); the grammar (ATN) is constant so this is O(1) w.r.t.
/// input.
#[allow(dead_code)]
fn atn_compute_first_nullable(sim: &mut AtnSim) {
    let nrules = sim.rule_start.len();
    let mut changed = true;
    while changed {
        changed = false;
        for let mut r = 0; r < nrules; r += 1 {
            let mut v1: List<i32> = [];
            if atn_cont_nullable(sim, sim.rule_start[r], &mut v1) && !sim.rule_nullable[r] {
                sim.rule_nullable[r] = true;
                changed = true;
            }
            let mut v2: List<i32> = [];
            let mut f: List<i32> = [];
            let mut fneg: List<i32> = [];
            if atn_cont_first(sim, sim.rule_start[r], &mut v2, &mut f, &mut fneg) && !sim.rule_first_open[r] {
                sim.rule_first_open[r] = true;
                changed = true;
            }
            for let t of &f {
                if !sim.rule_first[r].contains(t) {
                    sim.rule_first[r].push(*t);
                    changed = true;
                }
            }
            for let x of &fneg {
                if !sim.rule_first_neg[r].contains(x) {
                    sim.rule_first_neg[r].push(*x);
                    changed = true;
                }
            }
        }
    }
}

/// True iff the continuation from `state` to its rule's `RULE_STOP` can be
/// empty (derive no token). Uses `sim.rule_nullable` for rule-ref edges;
/// `visited` breaks within-rule cycles (a re-entered state adds no new
/// nullability).
#[allow(dead_code)]
fn atn_cont_nullable(sim: &AtnSim, state: i32, visited: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return true;
    }
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_nullable(sim, sim.tr_target[s + j], visited) {
                return true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 && sim.rule_nullable[callee] && atn_cont_nullable(sim, sim.tr_follow[s + j], visited) {
                return true;
            }
        }
    }
    return false;
}

/// Collect the explicit FIRST token kinds of the continuation from `state`
/// into `out`, and the labels EXCLUDED by `~X` (`NOT_ATOM`) edges into `neg`
/// (a `~X` edge matches any token except `X`). Returns `open` (true only for
/// a true wildcard `.`, which matches any token). A token `t` is admitted by
/// this FIRST iff `atn_first_admits(out, open, neg, t, eof)`.
/// Stops at consuming atoms (their label is the FIRST; no walk past them).
/// Uses `sim.rule_first` / `rule_first_open` / `rule_first_neg` /
/// `rule_nullable` for rule-ref edges; `visited` breaks within-rule cycles.
///
/// Precedence edges (an LR rule's loop entry) are walked like epsilon: when
/// the rule's atom prefix is nullable the rule can begin with a loop operator,
/// so those operator tokens belong in the rule's FIRST. (For the common
/// non-nullable atom the walk stops at the atom before ever reaching the loop
/// entry, so no operator enters FIRST.)
#[allow(dead_code)]
fn atn_cont_first(sim: &AtnSim, state: i32, visited: &mut List<i32>, out: &mut List<i32>, neg: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return false;
    }
    let mut open = false;
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_ATOM {
            if !out.contains(&sim.tr_label[s + j]) {
                out.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_WILDCARD {
            open = true;
        } else if k == ATN_TR_NOT_ATOM {
            if !neg.contains(&sim.tr_label[s + j]) {
                neg.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_first(sim, sim.tr_target[s + j], visited, out, neg) {
                open = true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 {
                for let t of &sim.rule_first[callee] {
                    if !out.contains(t) {
                        out.push(*t);
                    }
                }
                for let x of &sim.rule_first_neg[callee] {
                    if !neg.contains(x) {
                        neg.push(*x);
                    }
                }
                if sim.rule_first_open[callee] {
                    open = true;
                }
                if sim.rule_nullable[callee] && atn_cont_first(sim, sim.tr_follow[s + j], visited, out, neg) {
                    open = true;
                }
            }
        }
    }
    return open;
}

/// Whether the FIRST set described by (`out`, `open`, `neg`) admits token `t`:
/// an explicit atom match, a true wildcard, or a `~X` exclusion whose excluded
/// label is not `t` (matching `atn_move`'s `token != label && token != eof`).
#[allow(dead_code)]
fn atn_first_admits(out: &List<i32>, open: bool, neg: &List<i32>, t: i32, eof: i32) -> bool {
    if open && t != eof {
        return true;
    }
    if out.contains(&t) {
        return true;
    }
    if t != eof {
        for let x of neg {
            if *x != t {
                return true;
            }
        }
    }
    return false;
}

/// True when `state`'s outgoing edges consume a token (atom / wildcard /
/// not-atom). Such a state is a resting point: closure stops there and
/// `atn_move` reads the edge. Epsilon / rule states are expanded instead.
#[allow(dead_code)]
fn atn_state_consumes(sim: &AtnSim, state: i32) -> bool {
    let cnt = sim.state_tr_count[state];
    if cnt == 0 {
        return false;
    }
    let k = sim.tr_kind[sim.state_tr_start[state]];
    return k == ATN_TR_ATOM || k == ATN_TR_NOT_ATOM || k == ATN_TR_WILDCARD;
}

/// A merged configuration set: at most one config per `(state, alt, rs, pr)`,
/// its `ctx` the merged graph context of every path that reached it. This
/// collapse is what bounds the closure to polynomial size under deep left
/// recursion (instead of one config per distinct list-stack). Keyed by a
/// string for O(log n) lookup.
struct CfgSet {
    state: List<i32>,
    alt: List<i32>,
    rs: List<i32>,
    pr: List<i32>,
    ctx: List<i32>,
    index: TreeMap<i64, i32>,
}


impl CfgSet {
    fn new() -> CfgSet {
        return CfgSet {
            state: [],
            alt: [],
            rs: [],
            pr: [],
            ctx: [],
            index: TreeMap::<i64, i32>::new(),
        };
    }

    /// Merge `(state, alt, rs, pr, ctx)` in. Returns `[index, changed]` where
    /// `changed` is true iff the stored ctx grew (a fresh key always counts).
    fn add(&mut self, arena: &mut CtxArena, state: i32, alt: i32, rs: i32, pr: i32, ctx: i32) -> [i32, bool] {
        // Packed i64 key (avoids per-config string allocation on the hot
        // closure path). Each field gets a power-of-two bit slot, offset by
        // its -2/-1 sentinel so the value stays non-negative:
        //   pr    : bits [0,11)  (×1)            — precedence level
        //   alt   : bits [11,22) (×2^11 = 2048)  — alternative index
        //   rs    : bits [22,42) (×2^22)         — caller-stack depth
        //   state : bits [42,62) (×2^42)         — ATN state id
        // The slots are far wider than anything reachable: `pr`/`alt` admit
        // ~2046 (a rule never has thousands of precedence levels or alts),
        // `rs` ~1M caller frames (the wasm stack overflows in the low
        // thousands first), `state` ~1M states. The asserts document the
        // encoding capacity and fail loudly rather than let a field overflow
        // its slot and alias a *different* config onto the same key.
        assert pr + 2 < 2048, `ATN config precedence {pr} exceeds packed-key slot`;
        assert alt + 1 < 2048, `ATN config alt {alt} exceeds packed-key slot`;
        assert rs + 2 < 1048576, `ATN config caller-stack depth {rs} exceeds packed-key slot`;
        assert state + 2 < 1048576, `ATN config state {state} exceeds packed-key slot`;
        let k = (state + 2) as i64 * 4398046511104 + (rs + 2) as i64 * 4194304 + (alt + 1) as i64 * 2048 + (pr + 2) as i64;
        if let Some(i) = self.index.get(k) {
            let merged = arena.merge(self.ctx[i], ctx);
            let changed = merged != self.ctx[i];
            self.ctx[i] = merged;
            return [i, changed];
        }
        let i = self.state.len();
        self.state.push(state);
        self.alt.push(alt);
        self.rs.push(rs);
        self.pr.push(pr);
        self.ctx.push(ctx);
        self.index[k] = i;
        return [i, true];
    }

    fn to_list(&self) -> List<AtnConfig> {
        let mut out: List<AtnConfig> = [];
        for let mut i = 0; i < self.state.len(); i += 1 {
            out.push(AtnConfig {
                state: self.state[i],
                alt: self.alt[i],
                ctx: self.ctx[i],
                rs: self.rs[i],
                pr: self.pr[i],
            });
        }
        return out;
    }
}

/// Closure of a seed set with graph-merged contexts. Resting configs
/// (consuming states; rule-stop "at-end"; `ATN_ACCEPT_EOF`) are returned;
/// epsilon / precedence / rule-ref edges are followed, rule-stops pop the
/// graph context (then the caller stack `rstk` once the context empties).
/// Configs reaching the same `(state, alt, rs, pr)` are merged, so the work
/// stays polynomial under deep left recursion (the recursion is input-driven
/// — an LR operand is only reached after consuming its operator token — so
/// the context depth is bounded by the input, no cyclic-context handling is
/// needed; the guards below are a safety net for pathological epsilon cycles).
#[allow(dead_code)]
fn atn_closure(sim: &AtnSim, arena: &mut CtxArena, seeds: &List<AtnConfig>, rstk: &List<i32>) -> List<AtnConfig> {
    let mut cset = CfgSet::new();
    let mut expanded: List<i32> = [];
    let mut rset = CfgSet::new();
    let mut work: List<AtnConfig> = *seeds;
    let mut guard = 0;
    while let Some(c) = work.pop() {
        guard += 1;
        if guard > ATN_CLOSURE_GUARD {
            break;
        }
        let res = cset.add(arena, c.state, c.alt, c.rs, c.pr, c.ctx);
        let idx = res.0;
        while expanded.len() <= idx {
            expanded.push(-9);
        }
        let merged_ctx = cset.ctx[idx];
        if expanded[idx] == merged_ctx {
            continue;
        }
        expanded[idx] = merged_ctx;
        let cur = AtnConfig { state: c.state, alt: c.alt, ctx: merged_ctx, rs: c.rs, pr: c.pr };
        atn_expand(sim, arena, &cur, rstk, &mut work, &mut rset);
    }
    return rset.to_list();
}

/// Expand one (merged) config: rest it (consuming / at-end / EOF) or push its
/// epsilon / precedence / rule-ref successors onto `work`.
#[allow(dead_code)]
fn atn_expand(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if cur.state == ATN_ACCEPT_EOF {
        rset.add(arena, cur.state, cur.alt, cur.rs, cur.pr, cur.ctx);
        return;
    }
    if sim.state_kind[cur.state] == ATN_RULE_STOP {
        atn_pop(sim, arena, cur, rstk, work, rset);
        return;
    }
    if atn_state_consumes(sim, cur.state) {
        rset.add(arena, cur.state, cur.alt, cur.rs, cur.pr, cur.ctx);
        return;
    }
    let start = sim.state_tr_start[cur.state];
    let cnt = sim.state_tr_count[cur.state];
    for let mut j = 0; j < cnt; j += 1 {
        let k = sim.tr_kind[start + j];
        let target = sim.tr_target[start + j];
        if k == ATN_TR_EPSILON {
            work.push(AtnConfig { state: target, alt: cur.alt, ctx: cur.ctx, rs: cur.rs, pr: cur.pr });
        } else if k == ATN_TR_PRECEDENCE {
            // Loop-entry predicate `{prec_i >= pr}?`: prune below the context.
            if sim.tr_prec[start + j] >= cur.pr {
                work.push(AtnConfig { state: target, alt: cur.alt, ctx: cur.ctx, rs: cur.rs, pr: cur.pr });
            }
        } else if k == ATN_TR_RULE {
            if target < 0 || arena.edges.len() >= ATN_ARENA_CAP {
                continue;
            }
            // A recursive operand `expr[next_i]` carries its raised floor on
            // the RuleRef `prec`; push a frame saving the current `pr`.
            let nctx = arena.push(sim.tr_follow[start + j], cur.pr, cur.ctx);
            work.push(AtnConfig { state: target, alt: cur.alt, ctx: nctx, rs: cur.rs, pr: sim.tr_prec[start + j] });
        }
    }
}

/// Pop a rule-stop: follow each graph-context edge back to its caller frame;
/// a boundary edge (or an empty context) falls through to the pre-existing
/// caller stack `rstk` via `atn_rs_pop`.
#[allow(dead_code)]
fn atn_pop(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if cur.ctx == CTX_EMPTY {
        atn_rs_pop(arena, cur.state, cur.alt, cur.rs, cur.pr, rstk, work, rset);
        return;
    }
    let edges = arena.edges[cur.ctx];
    for let e of &edges {
        if e.0 == CTX_BOUNDARY {
            atn_rs_pop(arena, cur.state, cur.alt, cur.rs, cur.pr, rstk, work, rset);
        } else {
            work.push(AtnConfig { state: e.0, alt: cur.alt, ctx: e.2, rs: cur.rs, pr: e.1 });
        }
    }
}

/// Return into the pre-existing caller stack once the during-prediction
/// context is exhausted. Mirrors the exact-return-state semantics: continue
/// at `rstk[rs]`; the bottom start frame's follow is EOF; an unstamped /
/// SLL frame matches any follow (the rule-stop stays "at-end").
#[allow(dead_code)]
fn atn_rs_pop(
    arena: &mut CtxArena,
    stop_state: i32,
    alt: i32,
    rs: i32,
    pr: i32,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if rs >= 0 {
        let ret = rstk[rs];
        if ret >= 0 {
            work.push(AtnConfig { state: ret, alt: alt, ctx: CTX_EMPTY, rs: rs - 1, pr: pr });
        } else if rs == 0 {
            rset.add(arena, ATN_ACCEPT_EOF, alt, -1, pr, CTX_EMPTY);
        } else {
            rset.add(arena, stop_state, alt, rs, pr, CTX_EMPTY);
        }
    } else if rstk.is_empty() {
        rset.add(arena, stop_state, alt, rs, pr, CTX_EMPTY);
    } else {
        rset.add(arena, ATN_ACCEPT_EOF, alt, -1, pr, CTX_EMPTY);
    }
}

/// Advance a resting config set by one input token. At-end and accept-EOF
/// configs carry only when still viable; consuming configs follow whichever
/// edge matches `token`.
#[allow(dead_code)]
fn atn_move(sim: &AtnSim, configs: &List<AtnConfig>, token: i32, eof: i32) -> List<AtnConfig> {
    let mut out: List<AtnConfig> = [];
    for let c of configs {
        if c.state == ATN_ACCEPT_EOF {
            if token == eof {
                out.push(*c);
            }
            continue;
        }
        if sim.state_kind[c.state] == ATN_RULE_STOP {
            out.push(*c);
            continue;
        }
        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let label = sim.tr_label[start + j];
            let matched = if k == ATN_TR_ATOM {
                label == token;
            } else if k == ATN_TR_WILDCARD {
                token != eof;
            } else if k == ATN_TR_NOT_ATOM {
                token != label && token != eof;
            } else {
                false;
            };
            if matched {
                out.push(AtnConfig { state: sim.tr_target[start + j], alt: c.alt, ctx: c.ctx, rs: c.rs, pr: c.pr });
            }
        }
    }
    return out;
}

#[allow(dead_code)]
fn atn_unique_alts(configs: &List<AtnConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return alts;
}

#[allow(dead_code)]
fn atn_min_alt(alts: &List<i32>) -> i32 {
    if alts.is_empty() {
        return -1;
    }
    let mut m = alts[0];
    for let a of alts {
        if *a < m {
            m = *a;
        }
    }
    return m;
}

#[allow(dead_code)]
fn atn_all_at_end(sim: &AtnSim, configs: &List<AtnConfig>) -> bool {
    if configs.is_empty() {
        return false;
    }
    for let c of configs {
        if c.state != ATN_ACCEPT_EOF && sim.state_kind[c.state] != ATN_RULE_STOP {
            return false;
        }
    }
    return true;
}

/// Predict the winning alternative at `decision` against `tokens` from
/// `start_pos`, with full context: `rule_stack` is the caller's current
/// chain of ATN return states (outermost — the start-rule frame — first).
/// Pass an empty `rule_stack` for plain SLL. `min_prec` is the current
/// precedence context `pr`: a loop-entry edge `{prec_i >= pr}?` whose
/// `prec_i < min_prec` is pruned (left/right-associative precedence
/// climbing). Returns the 0-based alternative index (the decision state's
/// edge order), or -1 if no alternative is viable.
///
/// Resolution: simulate until one alt survives (return it), the config set
/// empties (return the previous step's lowest alt), or all survivors are
/// at-end together (a genuine conflict — return the lowest alt, matching
/// ANTLR4's rule-order tie-break; non-greedy repeats order their exit edge
/// first so this yields the exit).
#[allow(dead_code)]
pub fn atn_predict_with_stack(
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    tokens: &List<Token>,
    start_pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let start = sim.state_tr_start[dstate];
    let cnt = sim.state_tr_count[dstate];
    let rs_init = rule_stack.len() - 1;
    // Fresh context arena per prediction. (A persistent per-Parser arena was
    // measured to hurt: it accumulates every prediction's contexts, growing
    // the intern buckets; and full-context LR results are not memoizable
    // since the context encodes the whole nesting depth — see git history.)
    let mut arena = CtxArena::new();
    let mut seeds: List<AtnConfig> = [];
    for let mut j = 0; j < cnt; j += 1 {
        // Prune a precedence-guarded enter edge whose alt precedence is below
        // the current context (the predicate `{prec_i >= min_prec}?` is false).
        if sim.tr_kind[start + j] == ATN_TR_PRECEDENCE && sim.tr_prec[start + j] < min_prec {
            continue;
        }
        seeds.push(AtnConfig { state: sim.tr_target[start + j], alt: j, ctx: CTX_EMPTY, rs: rs_init, pr: min_prec });
    }
    let mut configs = atn_closure(sim, &mut arena, &seeds, rule_stack);
    let mut pos = start_pos;
    let mut prev = atn_unique_alts(&configs);
    let limit = tokens.len() - start_pos + 8;
    let mut guard = 0;
    loop {
        guard += 1;
        if guard > limit {
            return atn_min_alt(&prev);
        }
        let alts = atn_unique_alts(&configs);
        if alts.is_empty() {
            return atn_min_alt(&prev);
        }
        if alts.len() == 1 {
            return alts[0];
        }
        if atn_all_at_end(sim, &configs) {
            return atn_min_alt(&alts);
        }
        prev = alts;
        let token = if pos < tokens.len() { tokens[pos].kind } else { eof };
        let moved = atn_move(sim, &configs, token, eof);
        pos += 1;
        configs = atn_closure(sim, &mut arena, &moved, rule_stack);
    }
}

/// Decide an LR rule's loop-entry: ENTER alt `j` (continue the loop with
/// operator alt `j`) or EXIT (the trailing exit-edge index `c - 1`). This is
/// the LR loop-entry's true semantics — precedence + yield-to-caller-mandatory
/// — computed directly, not by general ALL(*) simulation (which is correct but
/// O(n^2) here because the exit branch re-walks the whole enclosing-loop
/// caller chain). O(caller-depth + grammar) per decision.
///
/// 1. If the current token is MANDATORY in the caller continuation (the first
///    non-nullable level of the caller return-state stack), EXIT — the caller
///    needs it (`between`'s mandatory `'and'`).
/// 2. Else the lowest-index precedence-allowed (`prec >= min_prec`) enter edge
///    whose suffix can start with the token wins (greedy; left-associativity
///    falls out of the precedence prune).
/// 3. Else EXIT.
#[allow(dead_code)]
pub fn atn_lr_loop_decision(
    sim: &AtnSim,
    rule_stack: &List<i32>,
    decision: i32,
    tokens: &List<Token>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let t = if pos < tokens.len() { tokens[pos].kind } else { eof };
    let s = sim.state_tr_start[dstate];
    let c = sim.state_tr_count[dstate];
    let exit_alt = c - 1;
    if atn_caller_mandates(sim, rule_stack, t, eof) {
        return exit_alt;
    }
    for let mut j = 0; j < c; j += 1 {
        if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE {
            if sim.tr_prec[s + j] < min_prec {
                continue;
            }
            let mut v: List<i32> = [];
            let mut f: List<i32> = [];
            let mut fneg: List<i32> = [];
            let open = atn_cont_first(sim, sim.tr_target[s + j], &mut v, &mut f, &mut fneg);
            if atn_first_admits(&f, open, &fneg, t, eof) {
                return j;
            }
        }
    }
    return exit_alt;
}

/// True iff the caller continuation MANDATES token `t`: walking the caller
/// return-state stack from the top, pop nullable continuations (optional
/// loops / nullable tails), and at the first non-nullable level test whether
/// its FIRST admits `t`. The start frame (-1 at index 0) mandates EOF.
#[allow(dead_code)]
fn atn_caller_mandates(sim: &AtnSim, rule_stack: &List<i32>, t: i32, eof: i32) -> bool {
    let mut i = rule_stack.len() - 1;
    while i >= 0 {
        let ret = rule_stack[i];
        if ret < 0 {
            return i == 0 && t == eof;
        }
        let mut v: List<i32> = [];
        if atn_cont_nullable(sim, ret, &mut v) {
            i -= 1;
            continue;
        }
        let mut v2: List<i32> = [];
        let mut f: List<i32> = [];
        let mut fneg: List<i32> = [];
        let open = atn_cont_first(sim, ret, &mut v2, &mut f, &mut fneg);
        return atn_first_admits(&f, open, &fneg, t, eof);
    }
    return false;
}

/// SLL convenience wrapper: predict with an empty rule stack. Correct for
/// top-level decisions; deeper decisions whose disambiguation depends on the
/// caller's follow need `atn_predict_with_stack` with the real rule stack.
#[allow(dead_code)]
pub fn atn_adaptive_predict(sim: &AtnSim, decision: i32, tokens: &List<Token>, start_pos: i32, eof: i32) -> i32 {
    let empty: List<i32> = [];
    return atn_predict_with_stack(sim, decision, &empty, tokens, start_pos, eof);
}

/// Decide whether a non-greedy optional (`(...)?? `) should ENTER (consume
/// its body) or SKIP, using full-context ATN prediction. `current_rule` (a
/// compile-time constant the emitter passes) names the rule the `??` lives
/// in; the decision is that rule's unique exit-first BlockStart (an optional
/// whose edge 0 goes straight to BlockEnd — the non-greedy ordering).
/// `rule_stack` is the caller stack of ATN return states. Returns true to
/// ENTER.
///
/// Falls back to ENTER (the prior greedy behaviour) when context is absent
/// or the decision can't be uniquely identified (0 or >1 candidates), so a
/// mapping miss degrades gracefully instead of mispredicting.
#[allow(dead_code)]
pub fn atn_ng_optional_enter(
    sim: &AtnSim,
    current_rule: i32,
    rule_stack: &List<i32>,
    tokens: &List<Token>,
    pos: i32,
    eof: i32,
) -> bool {
    // `current_rule` is the rule the `??` lives in (a compile-time constant
    // the emitter passes): the caller stack now holds ATN return states, so
    // the current rule is no longer recoverable from its top.
    let rule = current_rule;
    let mut dec = -1;
    let mut found = 0;
    for let mut d = 0; d < sim.decision_state.len(); d += 1 {
        let ds = sim.decision_state[d];
        if sim.state_kind[ds] != ATN_BLOCK_START || sim.state_rule[ds] != rule {
            continue;
        }
        if sim.state_tr_count[ds] < 1 {
            continue;
        }
        let first_target = sim.tr_target[sim.state_tr_start[ds]];
        if sim.state_kind[first_target] == ATN_BLOCK_END {
            dec = d;
            found += 1;
        }
    }
    if found != 1 {
        return true;
    }
    let alt = atn_predict_with_stack(sim, dec, rule_stack, tokens, pos, eof);
    // Non-greedy optional edges are ordered [exit=0, enter=1].
    return alt == 1;
}
pub enum TokenKind {
    ID,
    WS,
    Eof,
    Error,
}

pub variant StatNode {
    Alt0(StatAlt0),
    Alt1(StatAlt1),
}

pub struct StatAlt0 {
    pub span: Span,
    pub expr: ExprNode,
    pub semicolon: Token,
}

pub struct StatAlt1 {
    pub span: Span,
    pub expr: ExprNode,
    pub dot: Token,
}

pub variant ExprNode {
    Alt0(ExprAlt0),
    Alt1(ExprAlt1),
    Alt2(ExprAlt2),
    Alt3(ExprAlt3),
    Alt4(ExprAlt4),
    Alt5(ExprAlt5),
    Alt6(ExprAlt6),
}

pub struct ExprAlt0 {
    pub span: Span,
    pub id: Token,
}

pub struct ExprAlt1 {
    pub span: Span,
    pub lit_not: Token,
    pub expr: ExprNode,
}

pub struct ExprAlt2 {
    pub span: Span,
    pub expr: ExprNode,
    pub lit_and: Token,
    pub expr_2: ExprNode,
}

pub struct ExprAlt3 {
    pub span: Span,
    pub expr: ExprNode,
    pub lit_or: Token,
    pub expr_2: ExprNode,
}

pub struct ExprAlt4 {
    pub span: Span,
    pub lparen: Token,
    pub id: Token,
    pub rparen: Token,
    pub expr: ExprNode,
}

pub struct ExprAlt5 {
    pub span: Span,
    pub expr: ExprNode,
    pub question: Token,
    pub expr_2: ExprNode,
    pub colon: Token,
    pub expr_3: ExprNode,
}

pub struct ExprAlt6 {
    pub span: Span,
    pub lit_between: Token,
    pub expr: ExprNode,
    pub lit_and: Token,
    pub expr_2: ExprNode,
}

global TK_ID: i32 = 0;
global TK_WS: i32 = 1;
global TK_EOF: i32 = 2;
global TK_ERROR: i32 = 3;
global TK_LIT_SEMI: i32 = 4;
global TK_LIT_DOT: i32 = 5;
global TK_LIT_NOT: i32 = 6;
global TK_LIT_AND: i32 = 7;
global TK_LIT_OR: i32 = 8;
global TK_LIT_LPAREN: i32 = 9;
global TK_LIT_RPAREN: i32 = 10;
global TK_LIT_QUESTION: i32 = 11;
global TK_LIT_COLON: i32 = 12;
global TK_LIT_BETWEEN: i32 = 13;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_id(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || 'a' <= chars[pos] <= 'z' || 'A' <= chars[pos] <= 'Z' || chars[pos] == '_') { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !(false || 'a' <= chars[pos] <= 'z' || 'A' <= chars[pos] <= 'Z' || chars[pos] == '_' || '0' <= chars[pos] <= '9') { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_ws(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || chars[pos] == ' ' || chars[pos] == '\t' || chars[pos] == '\n' || chars[pos] == '\r' || chars[pos] == 'f') { return -1; }
    pos += 1;
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            if pos >= chars.len() { break rep_1; }
            if !(false || chars[pos] == ' ' || chars[pos] == '\t' || chars[pos] == '\n' || chars[pos] == '\r' || chars[pos] == 'f') { break rep_1; }
            pos += 1;
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_lit_semi(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ';' { return -1; }
    return pos + 1;
}

fn try_lit_dot(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '.' { return -1; }
    return pos + 1;
}

fn try_lit_not(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'n' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'o' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 't' { return -1; }
    return pos + 3;
}

fn try_lit_and(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'a' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'n' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'd' { return -1; }
    return pos + 3;
}

fn try_lit_or(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'o' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'r' { return -1; }
    return pos + 2;
}

fn try_lit_lparen(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '(' { return -1; }
    return pos + 1;
}

fn try_lit_rparen(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ')' { return -1; }
    return pos + 1;
}

fn try_lit_question(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '?' { return -1; }
    return pos + 1;
}

fn try_lit_colon(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ':' { return -1; }
    return pos + 1;
}

fn try_lit_between(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'b' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'e' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 't' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'w' { return -1; }
    if pos + 4 >= chars.len() || chars[pos + 4] != 'e' { return -1; }
    if pos + 5 >= chars.len() || chars[pos + 5] != 'e' { return -1; }
    if pos + 6 >= chars.len() || chars[pos + 6] != 'n' { return -1; }
    return pos + 7;
}

pub fn tokenize(input: &String) -> List<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: List<Token> = List::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: List<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '(' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LPAREN; }
        } else if first_char == ')' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_RPAREN; }
        } else if first_char == '.' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_DOT; }
        } else if first_char == ':' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_COLON; }
        } else if first_char == ';' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_SEMI; }
        } else if first_char == '?' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_QUESTION; }
        } else if first_char == '_' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char == 'a' {
            end = try_lit_and(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_AND; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char == 'b' {
            end = try_lit_between(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BETWEEN; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char == 'f' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == 'n' {
            end = try_lit_not(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_NOT; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char == 'o' {
            end = try_lit_or(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_OR; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if 'a' <= first_char <= 'z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_SEMI => "TK_LIT_SEMI",
        TK_LIT_DOT => "TK_LIT_DOT",
        TK_LIT_NOT => "TK_LIT_NOT",
        TK_LIT_AND => "TK_LIT_AND",
        TK_LIT_OR => "TK_LIT_OR",
        TK_LIT_LPAREN => "TK_LIT_LPAREN",
        TK_LIT_RPAREN => "TK_LIT_RPAREN",
        TK_LIT_QUESTION => "TK_LIT_QUESTION",
        TK_LIT_COLON => "TK_LIT_COLON",
        TK_LIT_BETWEEN => "TK_LIT_BETWEEN",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: List<Token>,
    pos: i32,
    chars: List<char>,
    pending: Option<ParseError>,
    atn_stack: List<i32>,
    atn_ret_pending: i32,
}

impl Parser {
    fn new(tokens: List<Token>, chars: List<char>) -> Parser {
        return Parser { tokens, pos: 0, chars, pending: null, atn_stack: [], atn_ret_pending: -1 };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(&self.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::<ParseError>::Some(e);
        }
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
                }
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["token set"],
        ));
    }
}

fn scan_stat(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if _gale_kind_set_0(alt_kind) {
            let mut best: i32 = -1;
            pos = start;
            try_0: {
                GALE_SCAN_STACK.push(8);
                pos = scan_expr(tokens, pos, 0);
                GALE_SCAN_STACK.pop();
                if pos < 0 { break try_0; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SEMI { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_1: {
                GALE_SCAN_STACK.push(13);
                pos = scan_expr(tokens, pos, 0);
                GALE_SCAN_STACK.pop();
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break try_1; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expr_atom(tokens: &List<Token>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_NOT {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_NOT { break try_1; }
                pos += 1;
                GALE_SCAN_STACK.push(25);
                pos = scan_expr(tokens, pos, 0);
                GALE_SCAN_STACK.pop();
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LPAREN {
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { break try_2; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_2; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RPAREN { break try_2; }
                pos += 1;
                GALE_SCAN_STACK.push(34);
                pos = scan_expr(tokens, pos, 0);
                GALE_SCAN_STACK.pop();
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_BETWEEN {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_BETWEEN { break try_3; }
                pos += 1;
                GALE_SCAN_STACK.push(39);
                pos = scan_expr(tokens, pos, 0);
                GALE_SCAN_STACK.pop();
                if pos < 0 { break try_3; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_AND { break try_3; }
                pos += 1;
                GALE_SCAN_STACK.push(43);
                pos = scan_expr(tokens, pos, 0);
                GALE_SCAN_STACK.pop();
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expr_lr_2(tokens: &List<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_AND { return -1; }
    pos += 1;
    GALE_SCAN_STACK.push(51);
    pos = scan_expr(tokens, pos, 4);
    GALE_SCAN_STACK.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr_lr_3(tokens: &List<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_OR { return -1; }
    pos += 1;
    GALE_SCAN_STACK.push(56);
    pos = scan_expr(tokens, pos, 3);
    GALE_SCAN_STACK.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr_lr_5(tokens: &List<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_QUESTION { return -1; }
    pos += 1;
    GALE_SCAN_STACK.push(61);
    pos = scan_expr(tokens, pos, 0);
    GALE_SCAN_STACK.pop();
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COLON { return -1; }
    pos += 1;
    GALE_SCAN_STACK.push(65);
    pos = scan_expr(tokens, pos, 2);
    GALE_SCAN_STACK.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_expr_atom(tokens, pos);
    if pos < 0 { return -1; }
    loop {
        let _atn_alt = atn_lr_loop_decision(&GALE_ATN_SIM, &GALE_SCAN_STACK, 2, tokens, pos, TK_EOF, min_prec);
        let _lr_pos0 = pos;
        if _atn_alt == 0 {
            pos = scan_expr_lr_2(tokens, pos);
            if pos < 0 { return -1; }
        } else if _atn_alt == 1 {
            pos = scan_expr_lr_3(tokens, pos);
            if pos < 0 { return -1; }
        } else if _atn_alt == 2 {
            pos = scan_expr_lr_5(tokens, pos);
            if pos < 0 { return -1; }
        } else {
            break;
        }
        if pos == _lr_pos0 {
            break;
        }
    }
    return pos;
}

fn _parse_stat__inner_bt_0(p: &mut Parser) -> Result<StatNode, ParseError> {
    let start = p.peek().span.start;
    p.atn_ret_pending = 8;
    let expr = _parse_expr(p)?;
    let semicolon = p.expect(TK_LIT_SEMI)?;
    return Result::<StatNode, ParseError>::Ok(StatNode::Alt0(StatAlt0 {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr,
        semicolon,
    }));
}

fn _parse_stat__inner_scan_0(tokens: &List<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    GALE_SCAN_STACK.push(8);
    pos = scan_expr(tokens, pos, 0);
    GALE_SCAN_STACK.pop();
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SEMI { return -1; }
    pos += 1;
    return pos;
}

fn _parse_stat__inner_bt_1(p: &mut Parser) -> Result<StatNode, ParseError> {
    let start = p.peek().span.start;
    p.atn_ret_pending = 13;
    let expr = _parse_expr(p)?;
    let dot = p.expect(TK_LIT_DOT)?;
    return Result::<StatNode, ParseError>::Ok(StatNode::Alt1(StatAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr,
        dot,
    }));
}

fn _parse_stat__inner_scan_1(tokens: &List<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    GALE_SCAN_STACK.push(13);
    pos = scan_expr(tokens, pos, 0);
    GALE_SCAN_STACK.pop();
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { return -1; }
    pos += 1;
    return pos;
}

fn _parse_stat__inner(p: &mut Parser) -> Result<StatNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if _gale_kind_set_0(kind) {
        if _gale_kind_set_0(p.peek_kind()) {
            let _sd_tokens = &p.tokens;
            let _sd_pos = p.pos;
            let _sd_p_0 = _parse_stat__inner_scan_0(_sd_tokens, _sd_pos);
            let _sd_p_1 = _parse_stat__inner_scan_1(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_0 > _sd_best_p {
                _sd_best_p = _sd_p_0;
                _sd_best_i = 0;
            }
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_best_i == 0 {
                return _parse_stat__inner_bt_0(p);
            }
            if _sd_best_i == 1 {
                return _parse_stat__inner_bt_1(p);
            }
            return _parse_stat__inner_bt_1(p);
        }
    }
    return Result::<StatNode, ParseError>::Err(p.error(
        "expected stat",
        p.peek().span,
        ["TK_ID", "TK_LIT_NOT", "TK_LIT_LPAREN", "TK_LIT_BETWEEN"],
    ));
}

fn _parse_stat(p: &mut Parser) -> Result<StatNode, ParseError> {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    let r = _parse_stat__inner(p);
    p.atn_stack.pop();
    if let Err(mut e) = r {
        e.rule_stack.push("stat");
        return Result::<StatNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_expr__inner_atom(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_ID {
        let id = p.expect(TK_ID)?;
        return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt0(ExprAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            id,
        }));
    }
    if kind == TK_LIT_NOT {
        let lit_not = p.expect(TK_LIT_NOT)?;
        p.atn_ret_pending = 25;
        let expr = _parse_expr(p, 4)?;
        return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt1(ExprAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lit_not,
            expr,
        }));
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let id = p.expect(TK_ID)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        p.atn_ret_pending = 34;
        let expr = _parse_expr(p, 2)?;
        return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt4(ExprAlt4 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lparen,
            id,
            rparen,
            expr,
        }));
    }
    if kind == TK_LIT_BETWEEN {
        let lit_between = p.expect(TK_LIT_BETWEEN)?;
        p.atn_ret_pending = 39;
        let expr = _parse_expr(p)?;
        let lit_and = p.expect(TK_LIT_AND)?;
        p.atn_ret_pending = 43;
        let expr_2 = _parse_expr(p, 1)?;
        return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt6(ExprAlt6 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lit_between,
            expr,
            lit_and,
            expr_2,
        }));
    }
    return Result::<ExprNode, ParseError>::Err(p.error(
        "expected expr",
        p.peek().span,
        ["TK_ID", "TK_LIT_NOT", "TK_LIT_LPAREN", "TK_LIT_BETWEEN"],
    ));
}

fn _parse_expr__inner_lr_2(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let lit_and = p.expect(TK_LIT_AND)?;
    p.atn_ret_pending = 51;
    let expr_2 = _parse_expr__inner(p, 4)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt2(ExprAlt2 {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr: left,
        lit_and,
        expr_2,
    }));
}

fn _parse_expr__inner_lr_3(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let lit_or = p.expect(TK_LIT_OR)?;
    p.atn_ret_pending = 56;
    let expr_2 = _parse_expr__inner(p, 3)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt3(ExprAlt3 {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr: left,
        lit_or,
        expr_2,
    }));
}

fn _parse_expr__inner_lr_5(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let question = p.expect(TK_LIT_QUESTION)?;
    p.atn_ret_pending = 61;
    let expr_2 = _parse_expr__inner(p, 0)?;
    let colon = p.expect(TK_LIT_COLON)?;
    p.atn_ret_pending = 65;
    let expr_3 = _parse_expr__inner(p, 2)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt5(ExprAlt5 {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr: left,
        question,
        expr_2,
        colon,
        expr_3,
    }));
}

fn _parse_expr__inner(p: &mut Parser, min_prec: i32 = 0) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let mut result = _parse_expr__inner_atom(p)?;
    loop {
        let _atn_alt = atn_lr_loop_decision(&GALE_ATN_SIM, &p.atn_stack, 2, &p.tokens, p.pos, TK_EOF, min_prec);
        let _lr_pos0 = p.pos;
        if _atn_alt == 0 {
            result = _parse_expr__inner_lr_2(p, result, start)?;
        } else if _atn_alt == 1 {
            result = _parse_expr__inner_lr_3(p, result, start)?;
        } else if _atn_alt == 2 {
            result = _parse_expr__inner_lr_5(p, result, start)?;
        } else {
            break;
        }
        if p.pos == _lr_pos0 {
            break;
        }
    }
    return Result::<ExprNode, ParseError>::Ok(result);
}

fn _parse_expr(p: &mut Parser, min_prec: i32 = 0) -> Result<ExprNode, ParseError> {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    let r = _parse_expr__inner(p, min_prec);
    p.atn_stack.pop();
    if let Err(mut e) = r {
        e.rule_stack.push("expr");
        return Result::<ExprNode, ParseError>::Err(e);
    }
    return r;
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    return Parser::new(tokens, chars);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_stat(input: &String) -> Result<StatNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_stat(&mut parser);
    if let Err(_e) = _result {
        return Result::<StatNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_expr(input: &String) -> Result<ExprNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_expr(&mut parser, 0);
    if let Err(_e) = _result {
        return Result::<ExprNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse(input: &String) -> Result<StatNode, ParseError> {
    return parse_stat(input);
}

pub fn walk_stat<V: Visitor>(v: &mut V, node: &StatNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(0, &"stat", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.semicolon);
            v.exit_rule(0, &"stat", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(0, &"stat", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.dot);
            v.exit_rule(0, &"stat", &n.span);
        }
    }
}

pub fn walk_expr<V: Visitor>(v: &mut V, node: &ExprNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(1, &"expr", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(1, &"expr", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(1, &"expr", &n.span);
            v.visit_token(&n.lit_not);
            walk_expr(v, &n.expr);
            v.exit_rule(1, &"expr", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(1, &"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.lit_and);
            walk_expr(v, &n.expr_2);
            v.exit_rule(1, &"expr", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(1, &"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.lit_or);
            walk_expr(v, &n.expr_2);
            v.exit_rule(1, &"expr", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(1, &"expr", &n.span);
            v.visit_token(&n.lparen);
            v.visit_token(&n.id);
            v.visit_token(&n.rparen);
            walk_expr(v, &n.expr);
            v.exit_rule(1, &"expr", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(1, &"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.question);
            walk_expr(v, &n.expr_2);
            v.visit_token(&n.colon);
            walk_expr(v, &n.expr_3);
            v.exit_rule(1, &"expr", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(1, &"expr", &n.span);
            v.visit_token(&n.lit_between);
            walk_expr(v, &n.expr);
            v.visit_token(&n.lit_and);
            walk_expr(v, &n.expr_2);
            v.exit_rule(1, &"expr", &n.span);
        }
    }
}

pub fn to_tree(node: &StatNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_stat(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_ID | TK_LIT_BETWEEN | TK_LIT_LPAREN | TK_LIT_NOT };
}

