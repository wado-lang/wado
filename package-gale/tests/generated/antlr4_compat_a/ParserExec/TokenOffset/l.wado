fn try_lit_60(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '6' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '0' { return -1; }
    return pos + 2;
}

fn try_lit_61(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '6' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '1' { return -1; }
    return pos + 2;
}

fn try_lit_62(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '6' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '2' { return -1; }
    return pos + 2;
}

fn try_lit_63(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '6' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '3' { return -1; }
    return pos + 2;
}

fn try_lit_64(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '6' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '4' { return -1; }
    return pos + 2;
}

fn try_lit_65(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '6' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '5' { return -1; }
    return pos + 2;
}

fn try_lit_66(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '6' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '6' { return -1; }
    return pos + 2;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\n' || first_char == ' ' {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '1' {
            end = try_lit_1(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_1; }
            end = try_lit_10(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_10; }
            end = try_lit_11(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_11; }
            end = try_lit_12(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_12; }
            end = try_lit_13(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_13; }
            end = try_lit_14(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_14; }
            end = try_lit_15(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_15; }
            end = try_lit_16(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_16; }
            end = try_lit_17(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_17; }
            end = try_lit_18(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_18; }
            end = try_lit_19(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_19; }
        } else if first_char == '2' {
            end = try_lit_2(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_2; }
            end = try_lit_20(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_20; }
            end = try_lit_21(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_21; }
            end = try_lit_22(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_22; }
            end = try_lit_23(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_23; }
            end = try_lit_24(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_24; }
            end = try_lit_25(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_25; }
            end = try_lit_26(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_26; }
            end = try_lit_27(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_27; }
            end = try_lit_28(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_28; }
            end = try_lit_29(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_29; }
        } else if first_char == '3' {
            end = try_lit_3(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_3; }
            end = try_lit_30(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_30; }
            end = try_lit_31(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_31; }
            end = try_lit_32(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_32; }
            end = try_lit_33(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_33; }
            end = try_lit_34(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_34; }
            end = try_lit_35(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_35; }
            end = try_lit_36(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_36; }
            end = try_lit_37(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_37; }
            end = try_lit_38(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_38; }
            end = try_lit_39(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_39; }
        } else if first_char == '4' {
            end = try_lit_4(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_4; }
            end = try_lit_40(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_40; }
            end = try_lit_41(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_41; }
            end = try_lit_42(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_42; }
            end = try_lit_43(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_43; }
            end = try_lit_44(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_44; }
            end = try_lit_45(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_45; }
            end = try_lit_46(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_46; }
            end = try_lit_47(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_47; }
            end = try_lit_48(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_48; }
            end = try_lit_49(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_49; }
        } else if first_char == '5' {
            end = try_lit_5(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_5; }
            end = try_lit_50(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_50; }
            end = try_lit_51(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_51; }
            end = try_lit_52(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_52; }
            end = try_lit_53(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_53; }
            end = try_lit_54(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_54; }
            end = try_lit_55(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_55; }
            end = try_lit_56(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_56; }
            end = try_lit_57(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_57; }
            end = try_lit_58(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_58; }
            end = try_lit_59(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_59; }
        } else if first_char == '6' {
            end = try_lit_6(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_6; }
            end = try_lit_60(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_60; }
            end = try_lit_61(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_61; }
            end = try_lit_62(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_62; }
            end = try_lit_63(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_63; }
            end = try_lit_64(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_64; }
            end = try_lit_65(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_65; }
            end = try_lit_66(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_66; }
        } else if first_char == '7' {
            end = try_lit_7(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_7; }
        } else if first_char == '8' {
            end = try_lit_8(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_8; }
        } else if first_char == '9' {
            end = try_lit_9(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_9; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_1 => "TK_LIT_1",
        TK_LIT_2 => "TK_LIT_2",
        TK_LIT_3 => "TK_LIT_3",
        TK_LIT_4 => "TK_LIT_4",
        TK_LIT_5 => "TK_LIT_5",
        TK_LIT_6 => "TK_LIT_6",
        TK_LIT_7 => "TK_LIT_7",
        TK_LIT_8 => "TK_LIT_8",
        TK_LIT_9 => "TK_LIT_9",
        TK_LIT_10 => "TK_LIT_10",
        TK_LIT_11 => "TK_LIT_11",
        TK_LIT_12 => "TK_LIT_12",
        TK_LIT_13 => "TK_LIT_13",
        TK_LIT_14 => "TK_LIT_14",
        TK_LIT_15 => "TK_LIT_15",
        TK_LIT_16 => "TK_LIT_16",
        TK_LIT_17 => "TK_LIT_17",
        TK_LIT_18 => "TK_LIT_18",
        TK_LIT_19 => "TK_LIT_19",
        TK_LIT_20 => "TK_LIT_20",
        TK_LIT_21 => "TK_LIT_21",
        TK_LIT_22 => "TK_LIT_22",
        TK_LIT_23 => "TK_LIT_23",
        TK_LIT_24 => "TK_LIT_24",
        TK_LIT_25 => "TK_LIT_25",
        TK_LIT_26 => "TK_LIT_26",
        TK_LIT_27 => "TK_LIT_27",
        TK_LIT_28 => "TK_LIT_28",
        TK_LIT_29 => "TK_LIT_29",
        TK_LIT_30 => "TK_LIT_30",
        TK_LIT_31 => "TK_LIT_31",
        TK_LIT_32 => "TK_LIT_32",
        TK_LIT_33 => "TK_LIT_33",
        TK_LIT_34 => "TK_LIT_34",
        TK_LIT_35 => "TK_LIT_35",
        TK_LIT_36 => "TK_LIT_36",
        TK_LIT_37 => "TK_LIT_37",
        TK_LIT_38 => "TK_LIT_38",
        TK_LIT_39 => "TK_LIT_39",
        TK_LIT_40 => "TK_LIT_40",
        TK_LIT_41 => "TK_LIT_41",
        TK_LIT_42 => "TK_LIT_42",
        TK_LIT_43 => "TK_LIT_43",
        TK_LIT_44 => "TK_LIT_44",
        TK_LIT_45 => "TK_LIT_45",
        TK_LIT_46 => "TK_LIT_46",
        TK_LIT_47 => "TK_LIT_47",
        TK_LIT_48 => "TK_LIT_48",
        TK_LIT_49 => "TK_LIT_49",
        TK_LIT_50 => "TK_LIT_50",
        TK_LIT_51 => "TK_LIT_51",
        TK_LIT_52 => "TK_LIT_52",
        TK_LIT_53 => "TK_LIT_53",
        TK_LIT_54 => "TK_LIT_54",
        TK_LIT_55 => "TK_LIT_55",
        TK_LIT_56 => "TK_LIT_56",
        TK_LIT_57 => "TK_LIT_57",
        TK_LIT_58 => "TK_LIT_58",
        TK_LIT_59 => "TK_LIT_59",
        TK_LIT_60 => "TK_LIT_60",
        TK_LIT_61 => "TK_LIT_61",
        TK_LIT_62 => "TK_LIT_62",
        TK_LIT_63 => "TK_LIT_63",
        TK_LIT_64 => "TK_LIT_64",
        TK_LIT_65 => "TK_LIT_65",
        TK_LIT_66 => "TK_LIT_66",
        _ => "Unknown",
    };
}

pub global RK_A: NodeKind = 0;

global RULE_NAMES: List<String> = ["a"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`({*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    pending_code: DiagnosticCode,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn fail(&mut self, message: String, span: Span, expected: List<String>, code: DiagnosticCode) {
        let e = self.error(message, span, expected);
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
            self.pending_code = code;
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: List<String>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn pending_message(&self) -> String {
        if let Some(e) = &self.pending { return e.message; }
        return String::from("");
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "{self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn report_missing(&mut self, kind: i32, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        let name = token_kind_name(kind);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing {name}`, span, lc.0, lc.1));
    }

    fn report_unexpected(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "{self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            let name = token_kind_name(kind);
            self.fail(`expected {name}, got "{self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [name], DiagnosticCode::UnexpectedToken);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(self.tokens.span_at(self.pos));
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind, self.tokens.span_at(self.pos));
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(self.tokens.span_at(self.pos));
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        let name = token_kind_name(kind);
        self.fail(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_not(&mut self, excluded: List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
