        TK_LIT_51 => "TK_LIT_51",
        TK_LIT_52 => "TK_LIT_52",
        TK_LIT_53 => "TK_LIT_53",
        TK_LIT_54 => "TK_LIT_54",
        TK_LIT_55 => "TK_LIT_55",
        TK_LIT_56 => "TK_LIT_56",
        TK_LIT_57 => "TK_LIT_57",
        TK_LIT_58 => "TK_LIT_58",
        TK_LIT_59 => "TK_LIT_59",
        TK_LIT_60 => "TK_LIT_60",
