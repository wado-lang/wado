struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_ws(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_0 = pos;
    let mut alts_ok_0 = false;
    alts_0_0: {
        pos = alts_saved_0;
        if pos >= chars.len() || chars[pos] != ' ' { break alts_0_0; }
        pos += 1;
        alts_ok_0 = true;
    }
    if !alts_ok_0 {
        alts_0_1: {
            pos = alts_saved_0;
            if pos >= chars.len() || chars[pos] != '\n' { break alts_0_1; }
            pos += 1;
            alts_ok_0 = true;
        }
    }
    if !alts_ok_0 { return -1; }
    return pos;
}

fn try_lit_1(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '1' { return -1; }
    return pos + 1;
}

