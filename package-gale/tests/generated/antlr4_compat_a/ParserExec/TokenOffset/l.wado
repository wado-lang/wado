pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = Array::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: Array<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\n' || first_char == ' ' {
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '1' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_1; }
            end = try_lit_10(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_10; }
            end = try_lit_11(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_11; }
            end = try_lit_12(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_12; }
            end = try_lit_13(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_13; }
            end = try_lit_14(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_14; }
            end = try_lit_15(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_15; }
            end = try_lit_16(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_16; }
            end = try_lit_17(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_17; }
            end = try_lit_18(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_18; }
            end = try_lit_19(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_19; }
        } else if first_char == '2' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_2; }
            end = try_lit_20(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_20; }
            end = try_lit_21(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_21; }
            end = try_lit_22(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_22; }
            end = try_lit_23(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_23; }
            end = try_lit_24(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_24; }
            end = try_lit_25(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_25; }
            end = try_lit_26(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_26; }
            end = try_lit_27(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_27; }
            end = try_lit_28(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_28; }
            end = try_lit_29(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_29; }
        } else if first_char == '3' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_3; }
            end = try_lit_30(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_30; }
            end = try_lit_31(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_31; }
            end = try_lit_32(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_32; }
            end = try_lit_33(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_33; }
            end = try_lit_34(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_34; }
            end = try_lit_35(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_35; }
            end = try_lit_36(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_36; }
            end = try_lit_37(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_37; }
            end = try_lit_38(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_38; }
            end = try_lit_39(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_39; }
        } else if first_char == '4' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_4; }
            end = try_lit_40(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_40; }
            end = try_lit_41(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_41; }
            end = try_lit_42(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_42; }
            end = try_lit_43(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_43; }
            end = try_lit_44(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_44; }
            end = try_lit_45(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_45; }
            end = try_lit_46(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_46; }
            end = try_lit_47(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_47; }
            end = try_lit_48(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_48; }
            end = try_lit_49(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_49; }
        } else if first_char == '5' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_5; }
            end = try_lit_50(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_50; }
            end = try_lit_51(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_51; }
            end = try_lit_52(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_52; }
            end = try_lit_53(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_53; }
            end = try_lit_54(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_54; }
            end = try_lit_55(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_55; }
            end = try_lit_56(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_56; }
            end = try_lit_57(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_57; }
            end = try_lit_58(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_58; }
            end = try_lit_59(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_59; }
        } else if first_char == '6' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_6; }
            end = try_lit_60(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_60; }
            end = try_lit_61(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_61; }
            end = try_lit_62(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_62; }
            end = try_lit_63(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_63; }
            end = try_lit_64(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_64; }
            end = try_lit_65(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_65; }
            end = try_lit_66(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_66; }
        } else if first_char == '7' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_7; }
        } else if first_char == '8' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_8; }
        } else if first_char == '9' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_9; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_1 => "TK_LIT_1",
        TK_LIT_2 => "TK_LIT_2",
