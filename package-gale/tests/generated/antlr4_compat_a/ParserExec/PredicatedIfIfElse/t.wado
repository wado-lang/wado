global TK_ELSE: i32 = 0;
global TK_ID: i32 = 1;
global TK_WS: i32 = 2;
global TK_EOF: i32 = 3;
global TK_ERROR: i32 = 4;
global TK_LIT_IF: i32 = 5;
global TK_LIT_ELSE: i32 = 6;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_id(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || 'a' <= chars[pos] <= 'z' || 'A' <= chars[pos] <= 'Z') { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !(false || 'a' <= chars[pos] <= 'z' || 'A' <= chars[pos] <= 'Z') { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_ws(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || chars[pos] == ' ' || chars[pos] == '\n' || chars[pos] == '\t') { return -1; }
    pos += 1;
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            if pos >= chars.len() { break rep_1; }
            if !(false || chars[pos] == ' ' || chars[pos] == '\n' || chars[pos] == '\t') { break rep_1; }
            pos += 1;
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_lit_if(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'i' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'f' { return -1; }
    return pos + 2;
}

fn try_lit_else(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'e' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'l' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 's' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'e' { return -1; }
    return pos + 4;
}

pub fn tokenize(input: &String) -> List<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: List<Token> = List::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: List<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == ' ' {
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == 'e' {
            end = try_lit_else(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_ELSE; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char == 'i' {
            end = try_lit_if(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_IF; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if 'a' <= first_char <= 'z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ELSE => "ELSE",
        TK_ID => "ID",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_IF => "TK_LIT_IF",
        TK_LIT_ELSE => "TK_LIT_ELSE",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: List<Token>,
    pos: i32,
    chars: List<char>,
}

impl Parser {
    fn new(tokens: List<Token>, chars: List<char>) -> Parser {
        return Parser { tokens, pos: 0, chars };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(&self.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
                }
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["token set"],
        ));
    }
}

fn scan_s(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_stmt(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_stmt(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LIT_IF {
            pos = start;
            try_0: {
                pos = scan_if_stmt(tokens, pos, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_ID {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_if_stmt(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_IF { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_ID { return -1; }
    pos += 1;
    pos = scan_stmt(tokens, pos, 0);
    if pos < 0 { return -1; }
    let gp_0 = pos;
    let sgk_0 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    if sgk_0 == TK_LIT_ELSE {
        sg_0: {
            pos = gp_0;
            sg_0_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_ELSE { break sg_0_0; }
                pos += 1;
                pos = scan_stmt(tokens, pos, 0);
                if pos < 0 { break sg_0_0; }
                break sg_0;
            }
            pos = gp_0;
            sg_0_1: {
                break sg_0;
            }
            pos = gp_0;
        }
    }
    return pos;
}

fn _parse_s__inner(p: &mut Parser) -> Result<SNode, ParseError> {
    let start = p.peek().span.start;
    let stmt = _parse_stmt(p)?;
    let eof = p.expect(TK_EOF)?;
    return Result::<SNode, ParseError>::Ok(SNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        stmt,
        eof,
    });
}

fn _parse_s(p: &mut Parser) -> Result<SNode, ParseError> {
    let r = _parse_s__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("s");
        return Result::<SNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_stmt__inner(p: &mut Parser) -> Result<StmtNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_IF {
        let if_stmt = _parse_if_stmt(p)?;
        return Result::<StmtNode, ParseError>::Ok(StmtNode::Alt0(StmtAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            if_stmt,
        }));
    }
    if kind == TK_ID {
        let id = p.expect(TK_ID)?;
        return Result::<StmtNode, ParseError>::Ok(StmtNode::Alt1(StmtAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            id,
        }));
    }
    return Result::<StmtNode, ParseError>::Err(p.error(
        "expected stmt",
        p.peek().span,
        ["TK_LIT_IF", "TK_ID"],
    ));
}

fn _parse_stmt(p: &mut Parser) -> Result<StmtNode, ParseError> {
    let r = _parse_stmt__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("stmt");
        return Result::<StmtNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_if_stmt__inner(p: &mut Parser) -> Result<IfStmtNode, ParseError> {
    let start = p.peek().span.start;
    let lit_if = p.expect(TK_LIT_IF)?;
    let id = p.expect(TK_ID)?;
    let stmt = _parse_stmt(p)?;
    let mut group_0_inner: Option<IfStmtGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_ELSE {
        let lit_else = p.expect(TK_LIT_ELSE)?;
        let stmt = _parse_stmt(p)?;
        group_0_inner = Option::<IfStmtGroup0>::Some(IfStmtGroup0::Alt0(IfStmtGroup0Alt0 {
            lit_else,
            stmt,
        }));
    } else if true {
        group_0_inner = Option::<IfStmtGroup0>::Some(IfStmtGroup0::Alt1(IfStmtGroup0Alt1 {
        }));
    }
    let group_0 = group_0_inner;
    return Result::<IfStmtNode, ParseError>::Ok(IfStmtNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lit_if,
        id,
        stmt,
        group_0,
    });
}

fn _parse_if_stmt(p: &mut Parser) -> Result<IfStmtNode, ParseError> {
    let r = _parse_if_stmt__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("ifStmt");
        return Result::<IfStmtNode, ParseError>::Err(e);
    }
    return r;
}

pub fn parse_s(input: &String) -> Result<SNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    return _parse_s(&mut parser);
}

pub fn parse_stmt(input: &String) -> Result<StmtNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    return _parse_stmt(&mut parser);
}

pub fn parse_if_stmt(input: &String) -> Result<IfStmtNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    return _parse_if_stmt(&mut parser);
}

pub fn parse(input: &String) -> Result<SNode, ParseError> {
    return parse_s(input);
}

pub fn walk_s<V: Visitor>(v: &mut V, node: &SNode) {
    v.enter_rule(0, &"s", &node.span);
    walk_stmt(v, &node.stmt);
    v.visit_token(&node.eof);
    v.exit_rule(0, &"s", &node.span);
}

pub fn walk_stmt<V: Visitor>(v: &mut V, node: &StmtNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(1, &"stmt", &n.span);
            walk_ifStmt(v, &n.if_stmt);
            v.exit_rule(1, &"stmt", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(1, &"stmt", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(1, &"stmt", &n.span);
        }
    }
}

pub fn walk_ifStmt<V: Visitor>(v: &mut V, node: &IfStmtNode) {
    v.enter_rule(2, &"ifStmt", &node.span);
    v.visit_token(&node.lit_if);
    v.visit_token(&node.id);
    walk_stmt(v, &node.stmt);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.lit_else);
                walk_stmt(v, &inner.stmt);
            }
            Alt1(inner) => {
            }
        }
    }
    v.exit_rule(2, &"ifStmt", &node.span);
}

pub fn to_tree(node: &SNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_s(&mut recorder, node);
    return recorder.build();
}

