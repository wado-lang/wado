pub struct StartNode {
    pub span: Span,
    pub id: Token,
    pub colon: Token,
    pub expr: ExprNode,
}

pub variant ExprNode {
    Alt0(ExprAlt0),
    Alt1(ExprAlt1),
}

pub struct ExprAlt0 {
    pub span: Span,
    pub primary: PrimaryNode,
    pub expr: Option<ExprNode>,
}

pub struct ExprAlt1 {
    pub span: Span,
    pub expr: ExprNode,
    pub lit_minusgt: Token,
    pub id: Token,
