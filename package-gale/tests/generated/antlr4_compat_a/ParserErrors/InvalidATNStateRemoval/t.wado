global TK_ID: i32 = 0;
global TK_EOF: i32 = 1;
global TK_ERROR: i32 = 2;
global TK_LIT_COLON: i32 = 3;
global TK_LIT_MINUSGT: i32 = 4;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_ID(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || 'a' <= chars[pos] <= 'z') { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !(false || 'a' <= chars[pos] <= 'z') { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_lit_colon(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ':' { return -1; }
    return pos + 1;
}

fn try_lit_minusgt(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '-' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '>' { return -1; }
    return pos + 2;
}

pub fn tokenize(input: &String) -> List<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: List<Token> = List::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: List<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '-' {
            end = try_lit_minusgt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_MINUSGT; }
        } else if first_char == ':' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_COLON; }
        } else if 'a' <= first_char <= 'z' {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = false;
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_COLON => "TK_LIT_COLON",
        TK_LIT_MINUSGT => "TK_LIT_MINUSGT",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: List<Token>,
    pos: i32,
    chars: List<char>,
    pending: Option<ParseError>,
}

impl Parser {
    fn new(tokens: List<Token>, chars: List<char>) -> Parser {
        return Parser { tokens, pos: 0, chars, pending: null };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(&self.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::<ParseError>::Some(e);
        }
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
                }
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["token set"],
        ));
    }
}

fn scan_start(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COLON { return -1; }
    pos += 1;
    pos = scan_expr(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr_atom(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_primary(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    if pos < tokens.len() && tokens[pos].kind == TK_ID && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        pos = scan_expr(tokens, pos, &EMPTY_FOLLOW, 0);
        if pos < 0 { pos = sp; }
    }
    return pos;
}

fn scan_expr_lr_1(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_MINUSGT { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn scan_expr(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_expr_atom(tokens, pos, follow);
    if pos < 0 { return -1; }
    loop {
        let suffix_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
        if suffix_kind == TK_LIT_MINUSGT {
            if 1 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expr_lr_1(tokens, pos, follow);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return pos;
}

fn scan_primary(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn _parse_start__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<StartNode, ParseError> {
    let start = p.peek().span.start;
    let id = p.expect(TK_ID)?;
    let colon = p.expect(TK_LIT_COLON)?;
    let expr = _parse_expr(p, follow)?;
    return Result::<StartNode, ParseError>::Ok(StartNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        id,
        colon,
        expr,
    });
}

fn _parse_start(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<StartNode, ParseError> {
    let r = _parse_start__inner(p, follow);
    if let Err(mut e) = r {
        e.rule_stack.push("start");
        return Result::<StartNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_expr__inner_atom(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_ID {
        let primary = _parse_primary(p, follow)?;
        let expr: Option<ExprNode> = if follow_yields(&p.tokens, p.pos, follow, TK_EOF) {
            null
        } else if p.peek_kind() == TK_ID {
            let expr = _parse_expr(p, &EMPTY_FOLLOW)?;
            Option::<ExprNode>::Some(expr)
        } else {
            null
        };
        return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt0(ExprAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            primary,
            expr,
        }));
    }
    return Result::<ExprNode, ParseError>::Err(p.error(
        "expected expr",
        p.peek().span,
        ["TK_ID"],
    ));
}

fn _parse_expr__inner_lr_1(p: &mut Parser, left: ExprNode, start: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ExprNode, ParseError> {
    let lit_minusgt = p.expect(TK_LIT_MINUSGT)?;
    let id = p.expect(TK_ID)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt1(ExprAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr: left,
        lit_minusgt,
        id,
    }));
}

fn _parse_expr__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let mut result = _parse_expr__inner_atom(p, follow)?;
    loop {
        let suffix_kind = p.peek_kind();
        if suffix_kind == TK_LIT_MINUSGT {
            if 1 >= min_prec {
                if scan_expr_lr_1(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expr__inner_lr_1(p, result, start, follow)?;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return Result::<ExprNode, ParseError>::Ok(result);
}

fn _parse_expr(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> Result<ExprNode, ParseError> {
    let r = _parse_expr__inner(p, follow, min_prec);
    if let Err(mut e) = r {
        e.rule_stack.push("expr");
        return Result::<ExprNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_primary__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PrimaryNode, ParseError> {
    let start = p.peek().span.start;
    let id = p.expect(TK_ID)?;
    return Result::<PrimaryNode, ParseError>::Ok(PrimaryNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        id,
    });
}

fn _parse_primary(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PrimaryNode, ParseError> {
    let r = _parse_primary__inner(p, follow);
    if let Err(mut e) = r {
        e.rule_stack.push("primary");
        return Result::<PrimaryNode, ParseError>::Err(e);
    }
    return r;
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    return Parser::new(tokens, chars);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_start(input: &String) -> Result<StartNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_start(&mut parser);
    if let Err(_e) = _result {
        return Result::<StartNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_expr(input: &String) -> Result<ExprNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_expr(&mut parser, &EMPTY_FOLLOW, 0);
    if let Err(_e) = _result {
        return Result::<ExprNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_primary(input: &String) -> Result<PrimaryNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_primary(&mut parser);
    if let Err(_e) = _result {
        return Result::<PrimaryNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse(input: &String) -> Result<StartNode, ParseError> {
    return parse_start(input);
}

pub fn walk_start<V: Visitor>(v: &mut V, node: &StartNode) {
    v.enter_rule(0, &"start", &node.span);
    v.visit_token(&node.id);
    v.visit_token(&node.colon);
    walk_expr(v, &node.expr);
    v.exit_rule(0, &"start", &node.span);
}

pub fn walk_expr<V: Visitor>(v: &mut V, node: &ExprNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(1, &"expr", &n.span);
            walk_primary(v, &n.primary);
            if let Some(item) = &n.expr {
                walk_expr(v, item);
            }
            v.exit_rule(1, &"expr", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(1, &"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.lit_minusgt);
            v.visit_token(&n.id);
            v.exit_rule(1, &"expr", &n.span);
        }
    }
}

pub fn walk_primary<V: Visitor>(v: &mut V, node: &PrimaryNode) {
    v.enter_rule(2, &"primary", &node.span);
    v.visit_token(&node.id);
    v.exit_rule(2, &"primary", &node.span);
}

pub fn to_tree(node: &StartNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_start(&mut recorder, node);
    return recorder.build();
}

global FOLLOW_MASK_0: List<List<i32>> = [[TK_LIT_COLON]];
global FOLLOW_MASK_1: List<List<i32>> = [[TK_ID]];

