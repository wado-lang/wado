pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char matches { '\t' | '\n' | '\r' | ' ' } {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char matches { '!' } {
            end = try_lit_bang(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANG; }
            end = try_lit_bangeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANGEQ; }
        } else if first_char matches { '"' } {
            end = try_DQ_STRING(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DQ_STRING; }
        } else if first_char matches { '%' } {
            end = try_lit_percent(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PERCENT; }
        } else if first_char matches { '&' } {
            end = try_lit_amp(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_AMP; }
        } else if first_char matches { '\'' } {
            end = try_DATE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DATE; }
            end = try_SQ_STRING(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SQ_STRING; }
        } else if first_char matches { '(' } {
            end = try_lit_lparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LPAREN; }
        } else if first_char matches { ')' } {
            end = try_lit_rparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RPAREN; }
        } else if first_char matches { '*' } {
            end = try_lit_star(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_STAR; }
        } else if first_char matches { '+' } {
            end = try_lit_plus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PLUS; }
        } else if first_char matches { ',' } {
            end = try_lit_comma(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_COMMA; }
        } else if first_char matches { '-' } {
            end = try_lit_minus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_MINUS; }
        } else if first_char matches { '/' } {
            end = try_lit_slash(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_SLASH; }
            end = try_COMMENTS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMENTS; }
        } else if first_char matches { '<' } {
            end = try_lit_lt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LT; }
            end = try_lit_lteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTEQ; }
        } else if first_char matches { '=' } {
            end = try_lit_eq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_EQ; }
        } else if first_char matches { '>' } {
            end = try_lit_gt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GT; }
            end = try_lit_gteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTEQ; }
        } else if first_char matches { '[' } {
            end = try_lit_lbracket(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LBRACKET; }
        } else if first_char matches { ']' } {
            end = try_lit_rbracket(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RBRACKET; }
        } else if first_char matches { '^' } {
            end = try_lit_caret(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_CARET; }
        } else if first_char matches { '|' } {
            end = try_lit_pipe(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PIPE; }
        } else if first_char matches { 'a'..='z' | 'A'..='Z' } {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { '0'..='9' } {
            end = try_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS | TK_COMMENTS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_NUMBER => "NUMBER",
        TK_DATE => "DATE",
        TK_SQ_STRING => "SQ_STRING",
        TK_DQ_STRING => "DQ_STRING",
        TK_WS => "WS",
        TK_COMMENTS => "COMMENTS",
        TK_K_IN => "K_IN",  // virtual
        TK_K_AND => "K_AND",  // virtual
        TK_K_OR => "K_OR",  // virtual
        TK_K_TRUE => "K_TRUE",  // virtual
        TK_K_FALSE => "K_FALSE",  // virtual
        TK_K_NULL => "K_NULL",  // virtual
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_LPAREN => "'('",
        TK_LIT_COMMA => "','",
        TK_LIT_RPAREN => "')'",
        TK_LIT_BANG => "'!'",
        TK_LIT_MINUS => "'-'",
        TK_LIT_PLUS => "'+'",
        TK_LIT_CARET => "'^'",
        TK_LIT_STAR => "'*'",
        TK_LIT_SLASH => "'/'",
        TK_LIT_PERCENT => "'%'",
        TK_LIT_EQ => "'='",
        TK_LIT_BANGEQ => "'!='",
        TK_LIT_GT => "'>'",
        TK_LIT_GTEQ => "'>='",
        TK_LIT_LT => "'<'",
        TK_LIT_LTEQ => "'<='",
        TK_LIT_AMP => "'&'",
        TK_LIT_PIPE => "'|'",
        TK_LIT_LBRACKET => "'['",
        TK_LIT_RBRACKET => "']'",
        _ => "Unknown",
    };
}

pub global RK_PROG: NodeKind = 0;
pub global RK_EXPRESSION: NodeKind = 1;

global RULE_NAMES: List<String> = ["prog", "expression"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

pub enum ExpressionAlt {
    doFunction,
    doParenthesis,
    doNot,
    doNegate,
    doPositiv,
    doPower,
    doMultipy,
    doDivide,
    doModulo,
    doMinus,
    doPlus,
    doEqual,
    doNotEqual,
    doGreather,
    doGreatherEqual,
    doLesser,
    doLesserEqual,
    doIn,
    doAnd,
    doOr,
    newArray,
    newTrueBoolean,
    newFalseBoolean,
    newNumber,
    newDateTime,
    newIdentifier,
    newString,
    newNull,
}

impl CstStore {
    pub fn expression_alt(&self, node: i32) -> Option<ExpressionAlt> {
        return match self.alt(node) {
            0 => Option::Some(ExpressionAlt::doFunction),
            1 => Option::Some(ExpressionAlt::doParenthesis),
            2 => Option::Some(ExpressionAlt::doNot),
            3 => Option::Some(ExpressionAlt::doNegate),
            4 => Option::Some(ExpressionAlt::doPositiv),
            5 => Option::Some(ExpressionAlt::doPower),
            6 => Option::Some(ExpressionAlt::doMultipy),
            7 => Option::Some(ExpressionAlt::doDivide),
            8 => Option::Some(ExpressionAlt::doModulo),
            9 => Option::Some(ExpressionAlt::doMinus),
            10 => Option::Some(ExpressionAlt::doPlus),
            11 => Option::Some(ExpressionAlt::doEqual),
            12 => Option::Some(ExpressionAlt::doNotEqual),
            13 => Option::Some(ExpressionAlt::doGreather),
            14 => Option::Some(ExpressionAlt::doGreatherEqual),
            15 => Option::Some(ExpressionAlt::doLesser),
            16 => Option::Some(ExpressionAlt::doLesserEqual),
            17 => Option::Some(ExpressionAlt::doIn),
            18 => Option::Some(ExpressionAlt::doAnd),
            19 => Option::Some(ExpressionAlt::doOr),
            20 => Option::Some(ExpressionAlt::newArray),
            21 => Option::Some(ExpressionAlt::newTrueBoolean),
            22 => Option::Some(ExpressionAlt::newFalseBoolean),
            23 => Option::Some(ExpressionAlt::newNumber),
            24 => Option::Some(ExpressionAlt::newDateTime),
            25 => Option::Some(ExpressionAlt::newIdentifier),
            26 => Option::Some(ExpressionAlt::newString),
            27 => Option::Some(ExpressionAlt::newNull),
            _ => null,
        };
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    pending_code: DiagnosticCode,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: &List<i32>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, kind_names(expected), lc.0, lc.1);
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        let take = if let Some(cur) = &self.pending { span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(self.error(message, span, expected));
            self.pending_code = code;
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn report_missing(&mut self, kind: i32, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        let name = token_kind_name(kind);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));
    }

    fn report_unexpected(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail(`got "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), &([kind] as List<i32>), DiagnosticCode::UnexpectedToken);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(self.tokens.span_at(self.pos));
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind, self.tokens.span_at(self.pos));
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(self.tokens.span_at(self.pos));
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &([kind] as List<i32>),
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token; got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !self.in_set(k, excluded) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `unexpected token "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if self.in_set(k, included) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            included,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }
}

fn scan_prog(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression_atom(tokens: &Array<i32>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            let mut best: i32 = -1;
            pos = start + 1;
            try_0: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_LPAREN { break try_0; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_0; }
                while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA {
                    let sp = pos;
                    sg_0_done: {
                        sg_0: {
                            if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_0; }
                            pos += 1;
                            pos = scan_expression(tokens, pos, 0);
                            if pos < 0 { break sg_0; }
                            break sg_0_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start + 1;
            if pos > best { best = pos; }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_LPAREN {
            pos = start + 1;
            try_1: {
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_BANG {
            pos = start + 1;
            try_2: {
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_MINUS {
            pos = start + 1;
            try_3: {
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_PLUS {
            pos = start + 1;
            try_4: {
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_4; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LBRACKET {
            pos = start + 1;
            try_5: {
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_5; }
                while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA {
                    let sp = pos;
                    sg_1_done: {
                        sg_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_1; }
                            pos += 1;
                            pos = scan_expression(tokens, pos, 0);
                            if pos < 0 { break sg_1; }
                            break sg_1_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { break try_5; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_K_TRUE {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_K_FALSE {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_NUMBER {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_DATE {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_SQ_STRING {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_K_NULL {
            pos = start + 1;
            break scan_alts;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expression_lr_5(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_CARET { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 16);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_6(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_STAR { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 15);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_7(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_SLASH { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 14);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_8(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_PERCENT { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 13);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_9(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_MINUS { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 12);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_10(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_PLUS { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 11);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_11(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_EQ { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 10);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_12(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_BANGEQ { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 9);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_13(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_GT { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 8);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_14(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_GTEQ { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 7);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_15(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LT { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 6);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_16(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LTEQ { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 5);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_17(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_K_IN { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LPAREN { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_2; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression_lr_18(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    let gp_3 = pos;
    let sgk_3 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    let mut sg_3_best = -1;
    if sgk_3 == TK_LIT_AMP {
        pos = gp_3;
        sg_3_0: {
            if pos >= tokens.len() || tokens[pos] != TK_LIT_AMP { break sg_3_0; }
            pos += 1;
            if pos > sg_3_best { sg_3_best = pos; }
        }
    } else if sgk_3 == TK_K_AND {
        pos = gp_3;
        sg_3_1: {
            if pos >= tokens.len() || tokens[pos] != TK_K_AND { break sg_3_1; }
            pos += 1;
            if pos > sg_3_best { sg_3_best = pos; }
        }
    }
    if sg_3_best >= 0 {
        pos = sg_3_best;
    } else {
        return -1;
    }
    pos = scan_expression(tokens, pos, 3);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_19(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    let gp_4 = pos;
    let sgk_4 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    let mut sg_4_best = -1;
    if sgk_4 == TK_LIT_PIPE {
        pos = gp_4;
        sg_4_0: {
            if pos >= tokens.len() || tokens[pos] != TK_LIT_PIPE { break sg_4_0; }
            pos += 1;
            if pos > sg_4_best { sg_4_best = pos; }
        }
    } else if sgk_4 == TK_K_OR {
        pos = gp_4;
        sg_4_1: {
            if pos >= tokens.len() || tokens[pos] != TK_K_OR { break sg_4_1; }
            pos += 1;
            if pos > sg_4_best { sg_4_best = pos; }
        }
    }
    if sg_4_best >= 0 {
        pos = sg_4_best;
    } else {
        return -1;
    }
    pos = scan_expression(tokens, pos, 2);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_expression_atom(tokens, pos);
    if pos < 0 { return -1; }
    loop {
        let suffix_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        let _lr_pos0 = pos;
        if suffix_kind == TK_LIT_CARET {
            if 15 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_5(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_STAR {
            if 14 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_6(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_SLASH {
            if 13 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_7(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_PERCENT {
            if 12 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_8(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_MINUS {
            if 11 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_9(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_PLUS {
            if 10 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_10(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_EQ {
            if 9 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_11(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_BANGEQ {
            if 8 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_12(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_GT {
            if 7 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_13(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_GTEQ {
            if 6 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_14(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_LT {
            if 5 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_15(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_LTEQ {
            if 4 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_16(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if suffix_kind == TK_K_IN {
            if 3 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_17(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if _kind_set_0(suffix_kind) {
            if 2 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_18(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if _kind_set_1(suffix_kind) {
            if 1 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expression_lr_19(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else {
            break;
        }
        if pos == _lr_pos0 {
            break;
        }
    }
    return pos;
}

fn _parse_prog__inner(p: &mut Parser) -> () {
    _parse_expression(p);
    p.expect(TK_EOF, &EMPTY_SYNC);
    return;
}

fn _parse_prog(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_PROG, _start);
    _parse_prog__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("prog");
    }
}

fn _parse_expression__inner_alt_0(p: &mut Parser) -> () {
    p.b.set_alt(0);
    p.expect(TK_ID, &SYNC_0);
    p.expect(TK_LIT_LPAREN, &SYNC_1);
    _parse_expression(p);
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_5_done: {
                sg_5: {
                    if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_5; }
                    pos += 1;
                    pos = scan_expression(tokens, pos, 0);
                    if pos < 0 { break sg_5; }
                    break sg_5_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.expect(TK_LIT_COMMA, &SYNC_1);
        _parse_expression(p);
    }
    p.expect(TK_LIT_RPAREN, &EMPTY_SYNC);
    return;
}

fn _parse_expression__inner_scan_0(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LPAREN { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA {
        let sp = pos;
        sg_6_done: {
            sg_6: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_6; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break sg_6; }
                break sg_6_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn _parse_expression__inner_alt_25(p: &mut Parser) -> () {
    p.b.set_alt(25);
    p.expect(TK_ID, &EMPTY_SYNC);
    return;
}

fn _parse_expression__inner_scan_25(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn _parse_expression__inner_atom(p: &mut Parser, min_prec: i32 = 0) -> () {
    let kind = p.peek_kind();
    if kind == TK_ID {
        let _sd_tokens = &p.kinds;
        let _sd_pos = p.pos;
        let _sd_p_0 = _parse_expression__inner_scan_0(_sd_tokens, _sd_pos);
        let _sd_p_25 = _parse_expression__inner_scan_25(_sd_tokens, _sd_pos);
        let mut _sd_best_i: i32 = -1;
        let mut _sd_best_p: i32 = -1;
        if _sd_p_0 > _sd_best_p {
            _sd_best_p = _sd_p_0;
            _sd_best_i = 0;
        }
        if _sd_p_25 > _sd_best_p {
            _sd_best_p = _sd_p_25;
            _sd_best_i = 25;
        }
        if _sd_best_i == 0 {
            return _parse_expression__inner_alt_0(p);
        }
        return _parse_expression__inner_alt_25(p);
    }
    if kind == TK_LIT_LPAREN {
        p.b.set_alt(1);
        p.expect(TK_LIT_LPAREN, &SYNC_1);
        _parse_expression(p);
        p.expect(TK_LIT_RPAREN, &EMPTY_SYNC);
        return;
    }
    if kind == TK_LIT_BANG {
        p.b.set_alt(2);
        p.expect(TK_LIT_BANG, &SYNC_1);
        _parse_expression(p, 16);
        return;
    }
    if kind == TK_LIT_MINUS {
        p.b.set_alt(3);
        p.expect(TK_LIT_MINUS, &SYNC_1);
        _parse_expression(p, 16);
        return;
    }
    if kind == TK_LIT_PLUS {
        p.b.set_alt(4);
        p.expect(TK_LIT_PLUS, &SYNC_1);
        _parse_expression(p, 16);
        return;
    }
    if kind == TK_LIT_LBRACKET {
        p.b.set_alt(20);
        p.expect(TK_LIT_LBRACKET, &SYNC_1);
        _parse_expression(p);
        loop {
            if p.recovering { break; }
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                sg_7_done: {
                    sg_7: {
                        if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_7; }
                        pos += 1;
                        pos = scan_expression(tokens, pos, 0);
                        if pos < 0 { break sg_7; }
                        break sg_7_done;
                    }
                    break rep_scan;
                }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            p.expect(TK_LIT_COMMA, &SYNC_1);
            _parse_expression(p);
        }
        p.expect(TK_LIT_RBRACKET, &EMPTY_SYNC);
        return;
    }
    if kind == TK_K_TRUE {
        p.b.set_alt(21);
        p.expect(TK_K_TRUE, &EMPTY_SYNC);
        return;
    }
    if kind == TK_K_FALSE {
        p.b.set_alt(22);
        p.expect(TK_K_FALSE, &EMPTY_SYNC);
        return;
    }
    if kind == TK_NUMBER {
        p.b.set_alt(23);
        p.expect(TK_NUMBER, &EMPTY_SYNC);
        return;
    }
    if kind == TK_DATE {
        p.b.set_alt(24);
        p.expect(TK_DATE, &EMPTY_SYNC);
        return;
    }
    if kind == TK_SQ_STRING {
        p.b.set_alt(26);
        p.expect(TK_SQ_STRING, &EMPTY_SYNC);
        return;
    }
    if kind == TK_K_NULL {
        p.b.set_alt(27);
        p.expect(TK_K_NULL, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of expression matches",
        p.peek_span(),
        &SYNC_1,
    );
    return;
}

fn _parse_expression__inner(p: &mut Parser, min_prec: i32 = 0) -> () {
    let _cp = p.b.checkpoint();
    let _start = p.peek_start();
    p.b.start_node(RK_EXPRESSION, _start);
    _parse_expression__inner_atom(p, min_prec);
    p.b.finish_node(p.last_end());
    loop {
        if p.recovering { break; }
        let _sk = p.peek_kind();
        if _sk == TK_LIT_CARET {
            if 15 >= min_prec {
                if scan_expression_lr_5(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(5);
                p.expect(TK_LIT_CARET, &EMPTY_SYNC);
                _parse_expression(p, 16);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_STAR {
            if 14 >= min_prec {
                if scan_expression_lr_6(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(6);
                p.expect(TK_LIT_STAR, &EMPTY_SYNC);
                _parse_expression(p, 15);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_SLASH {
            if 13 >= min_prec {
                if scan_expression_lr_7(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(7);
                p.expect(TK_LIT_SLASH, &EMPTY_SYNC);
                _parse_expression(p, 14);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_PERCENT {
            if 12 >= min_prec {
                if scan_expression_lr_8(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(8);
                p.expect(TK_LIT_PERCENT, &EMPTY_SYNC);
                _parse_expression(p, 13);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_MINUS {
            if 11 >= min_prec {
                if scan_expression_lr_9(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(9);
                p.expect(TK_LIT_MINUS, &EMPTY_SYNC);
                _parse_expression(p, 12);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_PLUS {
            if 10 >= min_prec {
                if scan_expression_lr_10(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(10);
                p.expect(TK_LIT_PLUS, &EMPTY_SYNC);
                _parse_expression(p, 11);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_EQ {
            if 9 >= min_prec {
                if scan_expression_lr_11(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(11);
                p.expect(TK_LIT_EQ, &EMPTY_SYNC);
                _parse_expression(p, 10);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_BANGEQ {
            if 8 >= min_prec {
                if scan_expression_lr_12(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(12);
                p.expect(TK_LIT_BANGEQ, &EMPTY_SYNC);
                _parse_expression(p, 9);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_GT {
            if 7 >= min_prec {
                if scan_expression_lr_13(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(13);
                p.expect(TK_LIT_GT, &EMPTY_SYNC);
                _parse_expression(p, 8);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_GTEQ {
            if 6 >= min_prec {
                if scan_expression_lr_14(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(14);
                p.expect(TK_LIT_GTEQ, &EMPTY_SYNC);
                _parse_expression(p, 7);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_LT {
            if 5 >= min_prec {
                if scan_expression_lr_15(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(15);
                p.expect(TK_LIT_LT, &EMPTY_SYNC);
                _parse_expression(p, 6);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_LIT_LTEQ {
            if 4 >= min_prec {
                if scan_expression_lr_16(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(16);
                p.expect(TK_LIT_LTEQ, &EMPTY_SYNC);
                _parse_expression(p, 5);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _sk == TK_K_IN {
            if 3 >= min_prec {
                if scan_expression_lr_17(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(17);
                p.expect(TK_K_IN, &EMPTY_SYNC);
                p.expect(TK_LIT_LPAREN, &EMPTY_SYNC);
                _parse_expression(p, 0);
                while !p.recovering && (p.peek_kind() == TK_LIT_COMMA) {
                    p.expect(TK_LIT_COMMA, &EMPTY_SYNC);
                    _parse_expression(p, 0);
                }
                p.expect(TK_LIT_RPAREN, &EMPTY_SYNC);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _kind_set_0(_sk) {
            if 2 >= min_prec {
                if scan_expression_lr_18(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(18);
                let _ = p.expect_set(&SYNC_2);
                _parse_expression(p, 3);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else if _kind_set_1(_sk) {
            if 1 >= min_prec {
                if scan_expression_lr_19(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPRESSION, _start);
                p.b.set_alt(19);
                let _ = p.expect_set(&SYNC_3);
                _parse_expression(p, 2);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return;
}

fn _parse_expression(p: &mut Parser, min_prec: i32 = 0) -> () {
    if p.recovering { return; }
    _parse_expression__inner(p, min_prec);
    if p.recovering {
        p.push_rule_stack("expression");
    }
}

fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(e) = &p.pending {
            let lc = line_col(p.tokens.chars, e.span.start);
            let mut d = Diagnostic::error(p.pending_code, e.full_message(), e.span, lc.0, lc.1);
            d.rule_stack = e.rule_stack;
            p.diagnostics.push(d);
        }
    }
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_prog(input, max_errors);
}

pub fn parse_prog(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_prog(p));
}

pub fn parse_expression(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expression(p));
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(35);
    for let mut k = 0; k < 35; k += 1 {
        v.push(token_kind_name(k));
    }
    return v;
}

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &_token_names());
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &_token_names());
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_K_AND | TK_LIT_AMP };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_K_OR | TK_LIT_PIPE };
}

global EMPTY_SYNC: List<i32> = [];
global SYNC_0: List<i32> = [TK_LIT_LPAREN];
global SYNC_1: List<i32> = [TK_DATE, TK_ID, TK_K_FALSE, TK_K_NULL, TK_K_TRUE, TK_LIT_BANG, TK_LIT_LBRACKET, TK_LIT_LPAREN, TK_LIT_MINUS, TK_LIT_PLUS, TK_NUMBER, TK_SQ_STRING];
