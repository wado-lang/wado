            Error => "error",
            Warning => "warning",
            Info => "info",
            Hint => "hint",
        };
    }
}

pub enum DiagnosticCode {
    UnexpectedToken,
    MissingToken,
    ExtraToken,
    NoViableAlternative,
    UnterminatedConstruct,
