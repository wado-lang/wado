pub fn tokenize(input: &String) -> List<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: List<Token> = List::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: List<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '!' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_BANG; }
            end = try_lit_bangeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANGEQ; }
        } else if first_char == '"' {
            end = try_dq_string(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DQ_STRING; }
        } else if first_char == '%' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_PERCENT; }
        } else if first_char == '&' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_AMP; }
        } else if first_char == '\'' {
            end = try_date(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DATE; }
            end = try_sq_string(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SQ_STRING; }
        } else if first_char == '(' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LPAREN; }
        } else if first_char == ')' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_RPAREN; }
        } else if first_char == '*' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_STAR; }
        } else if first_char == '+' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_PLUS; }
        } else if first_char == ',' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_COMMA; }
        } else if first_char == '-' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_MINUS; }
        } else if first_char == '/' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_SLASH; }
            end = try_comments(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMENTS; }
        } else if first_char == '<' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LT; }
            end = try_lit_lteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTEQ; }
        } else if first_char == '=' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_EQ; }
        } else if first_char == '>' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_GT; }
            end = try_lit_gteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTEQ; }
        } else if first_char == '[' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LBRACKET; }
        } else if first_char == ']' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_RBRACKET; }
        } else if first_char == '^' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_CARET; }
        } else if first_char == '|' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_PIPE; }
        } else if 'a' <= first_char <= 'z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if '0' <= first_char <= '9' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS | TK_COMMENTS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_NUMBER => "NUMBER",
        TK_DATE => "DATE",
        TK_SQ_STRING => "SQ_STRING",
        TK_DQ_STRING => "DQ_STRING",
        TK_WS => "WS",
        TK_COMMENTS => "COMMENTS",
        TK_K_IN => "K_IN",  // virtual
        TK_K_AND => "K_AND",  // virtual
        TK_K_OR => "K_OR",  // virtual
        TK_K_TRUE => "K_TRUE",  // virtual
        TK_K_FALSE => "K_FALSE",  // virtual
        TK_K_NULL => "K_NULL",  // virtual
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_LPAREN => "TK_LIT_LPAREN",
        TK_LIT_COMMA => "TK_LIT_COMMA",
        TK_LIT_RPAREN => "TK_LIT_RPAREN",
        TK_LIT_BANG => "TK_LIT_BANG",
        TK_LIT_MINUS => "TK_LIT_MINUS",
        TK_LIT_PLUS => "TK_LIT_PLUS",
        TK_LIT_CARET => "TK_LIT_CARET",
        TK_LIT_STAR => "TK_LIT_STAR",
        TK_LIT_SLASH => "TK_LIT_SLASH",
        TK_LIT_PERCENT => "TK_LIT_PERCENT",
        TK_LIT_EQ => "TK_LIT_EQ",
        TK_LIT_BANGEQ => "TK_LIT_BANGEQ",
        TK_LIT_GT => "TK_LIT_GT",
        TK_LIT_GTEQ => "TK_LIT_GTEQ",
        TK_LIT_LT => "TK_LIT_LT",
        TK_LIT_LTEQ => "TK_LIT_LTEQ",
        TK_LIT_AMP => "TK_LIT_AMP",
        TK_LIT_PIPE => "TK_LIT_PIPE",
        TK_LIT_LBRACKET => "TK_LIT_LBRACKET",
        TK_LIT_RBRACKET => "TK_LIT_RBRACKET",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: List<Token>,
    pos: i32,
    chars: List<char>,
    pending: Option<ParseError>,
}

impl Parser {
    fn new(tokens: List<Token>, chars: List<char>) -> Parser {
        return Parser { tokens, pos: 0, chars, pending: null };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(&self.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::<ParseError>::Some(e);
        }
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
                }
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["token set"],
        ));
    }
}

fn scan_prog(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_expression(tokens, pos, &FOLLOW_MASK_0, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression_atom(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            let mut best: i32 = -1;
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_0; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { break try_0; }
                pos += 1;
                pos = scan_expression(tokens, pos, &FOLLOW_MASK_3, 0);
                if pos < 0 { break try_0; }
                while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
                    let sp = pos;
                    sg_0_done: {
                        sg_0: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_0; }
                            pos += 1;
                            pos = scan_expression(tokens, pos, follow, 0);
                            if pos < 0 { break sg_0; }
                            break sg_0_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RPAREN { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_10: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_10; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_LPAREN {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { break try_1; }
                pos += 1;
                pos = scan_expression(tokens, pos, &FOLLOW_MASK_4, 0);
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RPAREN { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_BANG {
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_BANG { break try_2; }
                pos += 1;
                pos = scan_expression(tokens, pos, follow, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_MINUS {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_MINUS { break try_3; }
                pos += 1;
                pos = scan_expression(tokens, pos, follow, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_PLUS {
            pos = start;
            try_4: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_PLUS { break try_4; }
                pos += 1;
                pos = scan_expression(tokens, pos, follow, 0);
                if pos < 0 { break try_4; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LBRACKET {
            pos = start;
            try_5: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { break try_5; }
                pos += 1;
                pos = scan_expression(tokens, pos, &FOLLOW_MASK_5, 0);
                if pos < 0 { break try_5; }
                while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
                    let sp = pos;
                    sg_1_done: {
                        sg_1: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_1; }
                            pos += 1;
                            pos = scan_expression(tokens, pos, follow, 0);
                            if pos < 0 { break sg_1; }
                            break sg_1_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { break try_5; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_K_TRUE {
            pos = start;
            try_6: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_TRUE { break try_6; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_K_FALSE {
            pos = start;
            try_7: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_FALSE { break try_7; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_NUMBER {
            pos = start;
            try_8: {
                if pos >= tokens.len() || tokens[pos].kind != TK_NUMBER { break try_8; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_DATE {
            pos = start;
            try_9: {
                if pos >= tokens.len() || tokens[pos].kind != TK_DATE { break try_9; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_SQ_STRING {
            pos = start;
            try_11: {
                if pos >= tokens.len() || tokens[pos].kind != TK_SQ_STRING { break try_11; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_K_NULL {
            pos = start;
            try_12: {
                if pos >= tokens.len() || tokens[pos].kind != TK_K_NULL { break try_12; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expression_lr_5(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_CARET { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, follow, 16);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_6(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_STAR { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, follow, 15);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_7(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SLASH { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, follow, 14);
    if pos < 0 { return -1; }
