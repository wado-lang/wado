fn _parse_expression(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> Result<ExpressionNode, ParseError> {
    let r = _parse_expression__inner(p, follow, min_prec);
    if let Err(mut e) = r {
        e.rule_stack.push("expression");
        return Result::<ExpressionNode, ParseError>::Err(e);
    }
    return r;
}

pub fn parse_prog(input: &String) -> Result<ProgNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_prog(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<ProgNode, ParseError>::Err(_d);
            }
        }
        return Result::<ProgNode, ParseError>::Err(_e);
    }
    return _result;
}

pub fn parse_expression(input: &String) -> Result<ExpressionNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_expression(&mut parser, &EMPTY_FOLLOW, 0);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<ExpressionNode, ParseError>::Err(_d);
            }
        }
        return Result::<ExpressionNode, ParseError>::Err(_e);
    }
    return _result;
}

pub fn parse(input: &String) -> Result<ProgNode, ParseError> {
    return parse_prog(input);
}

pub fn walk_prog<V: Visitor>(v: &mut V, node: &ProgNode) {
    v.enter_rule(0, &"prog", &node.span);
    walk_expression(v, &node.expression);
    v.visit_token(&node.eof);
    v.exit_rule(0, &"prog", &node.span);
}

pub fn walk_expression<V: Visitor>(v: &mut V, node: &ExpressionNode) {
    match node {
        doFunction(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.id);
            v.visit_token(&n.lparen);
            walk_expression(v, &n.expression);
            for let item of &n.comma_expression_list {
                v.visit_token(&item.comma);
                walk_expression(v, &item.expression);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(1, &"expression", &n.span);
        }
        doParenthesis(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.lparen);
            walk_expression(v, &n.expression);
            v.visit_token(&n.rparen);
            v.exit_rule(1, &"expression", &n.span);
        }
        doNot(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.bang);
            walk_expression(v, &n.expression);
            v.exit_rule(1, &"expression", &n.span);
        }
        doNegate(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.minus);
            walk_expression(v, &n.expression);
            v.exit_rule(1, &"expression", &n.span);
        }
        doPositiv(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.plus);
            walk_expression(v, &n.expression);
            v.exit_rule(1, &"expression", &n.span);
        }
        doPower(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.caret);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doMultipy(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.star);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doDivide(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.slash);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doModulo(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.percent);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doMinus(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.minus);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doPlus(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.plus);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.eq);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doNotEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.lit_bangeq);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doGreather(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.gt);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doGreatherEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.lit_gteq);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doLesser(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.lt);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doLesserEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.lit_lteq);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doIn(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.k_in);
            v.visit_token(&n.lparen);
            walk_expression(v, &n.expression_2);
            for let item of &n.comma_expression_list {
                v.visit_token(&item.comma);
                walk_expression(v, &item.expression);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(1, &"expression", &n.span);
        }
        doAnd(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.amp_or_k_and);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doOr(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, &n.expression);
            v.visit_token(&n.pipe_or_k_or);
            walk_expression(v, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        newArray(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.lbracket);
            walk_expression(v, &n.expression);
            for let item of &n.comma_expression_list {
                v.visit_token(&item.comma);
                walk_expression(v, &item.expression);
            }
            v.visit_token(&n.rbracket);
            v.exit_rule(1, &"expression", &n.span);
        }
        newTrueBoolean(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.k_true);
            v.exit_rule(1, &"expression", &n.span);
        }
        newFalseBoolean(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.k_false);
            v.exit_rule(1, &"expression", &n.span);
        }
        newNumber(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.number);
            v.exit_rule(1, &"expression", &n.span);
        }
        newDateTime(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.date);
            v.exit_rule(1, &"expression", &n.span);
        }
        newIdentifier(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(1, &"expression", &n.span);
        }
        newString(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.sq_string);
            v.exit_rule(1, &"expression", &n.span);
        }
        newNull(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(&n.k_null);
            v.exit_rule(1, &"expression", &n.span);
        }
    }
}

pub fn to_tree(node: &ProgNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_prog(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_K_AND | TK_LIT_AMP };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_K_OR | TK_LIT_PIPE };
}

global FOLLOW_MASK_0: List<List<i32>> = [[TK_EOF]];
global FOLLOW_MASK_1: List<List<i32>> = [[TK_LIT_LPAREN]];
global FOLLOW_MASK_2: List<List<i32>> = [[TK_DATE, TK_ID, TK_K_FALSE, TK_K_NULL, TK_K_TRUE, TK_LIT_BANG, TK_LIT_LBRACKET, TK_LIT_LPAREN, TK_LIT_MINUS, TK_LIT_PLUS, TK_NUMBER, TK_SQ_STRING]];
global FOLLOW_MASK_3: List<List<i32>> = [[TK_LIT_COMMA, TK_LIT_RPAREN]];
global FOLLOW_MASK_4: List<List<i32>> = [[TK_LIT_RPAREN]];
global FOLLOW_MASK_5: List<List<i32>> = [[TK_LIT_COMMA, TK_LIT_RBRACKET]];
global FOLLOW_MASK_6: List<List<i32>> = [[TK_LIT_RBRACKET]];

