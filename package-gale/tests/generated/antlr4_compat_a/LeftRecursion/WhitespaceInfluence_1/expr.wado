pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '!' {
            end = try_lit_bang(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANG; }
            end = try_lit_bangeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANGEQ; }
        } else if first_char == '"' {
            end = try_DQ_STRING(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DQ_STRING; }
        } else if first_char == '%' {
            end = try_lit_percent(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PERCENT; }
        } else if first_char == '&' {
            end = try_lit_amp(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_AMP; }
        } else if first_char == '\'' {
            end = try_DATE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DATE; }
            end = try_SQ_STRING(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SQ_STRING; }
        } else if first_char == '(' {
            end = try_lit_lparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LPAREN; }
        } else if first_char == ')' {
            end = try_lit_rparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RPAREN; }
        } else if first_char == '*' {
            end = try_lit_star(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_STAR; }
        } else if first_char == '+' {
            end = try_lit_plus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PLUS; }
        } else if first_char == ',' {
            end = try_lit_comma(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_COMMA; }
        } else if first_char == '-' {
            end = try_lit_minus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_MINUS; }
        } else if first_char == '/' {
            end = try_lit_slash(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_SLASH; }
            end = try_COMMENTS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMENTS; }
        } else if first_char == '<' {
            end = try_lit_lt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LT; }
            end = try_lit_lteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTEQ; }
        } else if first_char == '=' {
            end = try_lit_eq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_EQ; }
        } else if first_char == '>' {
            end = try_lit_gt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GT; }
            end = try_lit_gteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTEQ; }
        } else if first_char == '[' {
            end = try_lit_lbracket(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LBRACKET; }
        } else if first_char == ']' {
            end = try_lit_rbracket(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RBRACKET; }
        } else if first_char == '^' {
            end = try_lit_caret(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_CARET; }
        } else if first_char == '|' {
            end = try_lit_pipe(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PIPE; }
        } else if 'a' <= first_char <= 'z' {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if '0' <= first_char <= '9' {
            end = try_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS | TK_COMMENTS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_NUMBER => "NUMBER",
        TK_DATE => "DATE",
        TK_SQ_STRING => "SQ_STRING",
        TK_DQ_STRING => "DQ_STRING",
        TK_WS => "WS",
        TK_COMMENTS => "COMMENTS",
        TK_K_IN => "K_IN",  // virtual
        TK_K_AND => "K_AND",  // virtual
        TK_K_OR => "K_OR",  // virtual
        TK_K_TRUE => "K_TRUE",  // virtual
        TK_K_FALSE => "K_FALSE",  // virtual
        TK_K_NULL => "K_NULL",  // virtual
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_LPAREN => "TK_LIT_LPAREN",
        TK_LIT_COMMA => "TK_LIT_COMMA",
        TK_LIT_RPAREN => "TK_LIT_RPAREN",
        TK_LIT_BANG => "TK_LIT_BANG",
        TK_LIT_MINUS => "TK_LIT_MINUS",
        TK_LIT_PLUS => "TK_LIT_PLUS",
        TK_LIT_CARET => "TK_LIT_CARET",
        TK_LIT_STAR => "TK_LIT_STAR",
        TK_LIT_SLASH => "TK_LIT_SLASH",
        TK_LIT_PERCENT => "TK_LIT_PERCENT",
        TK_LIT_EQ => "TK_LIT_EQ",
        TK_LIT_BANGEQ => "TK_LIT_BANGEQ",
        TK_LIT_GT => "TK_LIT_GT",
        TK_LIT_GTEQ => "TK_LIT_GTEQ",
        TK_LIT_LT => "TK_LIT_LT",
        TK_LIT_LTEQ => "TK_LIT_LTEQ",
        TK_LIT_AMP => "TK_LIT_AMP",
        TK_LIT_PIPE => "TK_LIT_PIPE",
        TK_LIT_LBRACKET => "TK_LIT_LBRACKET",
        TK_LIT_RBRACKET => "TK_LIT_RBRACKET",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: TokenStream,
    pos: i32,
    pending: Option<ParseError>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        return Parser { tokens, pos: 0, pending: null };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
        }
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32) -> Result<i32, ParseError> {
        if self.tokens.kinds[self.pos] == kind {
            if kind == TK_EOF {
                return Result::Ok(self.pos);
            }
            return Result::Ok(self.advance());
        }
        let name = token_kind_name(kind);
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<i32, ParseError> {
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<i32, ParseError> {
        if self.tokens.kinds[self.pos] != TK_EOF {
            return Result::Ok(self.advance());
        }
        return Result::Err(self.error(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<i32, ParseError> {
        let k = self.tokens.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<i32, ParseError> {
        let k = self.tokens.kinds[self.pos];
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::Ok(self.pos);
                }
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["token set"],
        ));
    }
}

fn scan_prog(tokens: &TokenStream, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens.kinds[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression_atom(tokens: &TokenStream, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens.kinds[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            let mut best: i32 = -1;
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_ID { break try_0; }
                pos += 1;
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_LPAREN { break try_0; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_0; }
                while pos < tokens.len() && tokens.kinds[pos] == TK_LIT_COMMA {
                    let sp = pos;
                    sg_0_done: {
                        sg_0: {
                            if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COMMA { break sg_0; }
                            pos += 1;
                            pos = scan_expression(tokens, pos, 0);
                            if pos < 0 { break sg_0; }
                            break sg_0_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_RPAREN { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_10: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_ID { break try_10; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_LPAREN {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_LPAREN { break try_1; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_RPAREN { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_BANG {
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_BANG { break try_2; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_MINUS {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_MINUS { break try_3; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_PLUS {
            pos = start;
            try_4: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_PLUS { break try_4; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_4; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LBRACKET {
            pos = start;
            try_5: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_LBRACKET { break try_5; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_5; }
                while pos < tokens.len() && tokens.kinds[pos] == TK_LIT_COMMA {
                    let sp = pos;
                    sg_1_done: {
                        sg_1: {
                            if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COMMA { break sg_1; }
                            pos += 1;
                            pos = scan_expression(tokens, pos, 0);
                            if pos < 0 { break sg_1; }
                            break sg_1_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_RBRACKET { break try_5; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_K_TRUE {
            pos = start;
            try_6: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_K_TRUE { break try_6; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_K_FALSE {
            pos = start;
            try_7: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_K_FALSE { break try_7; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_NUMBER {
            pos = start;
            try_8: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_NUMBER { break try_8; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_DATE {
            pos = start;
            try_9: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_DATE { break try_9; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_SQ_STRING {
            pos = start;
            try_11: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_SQ_STRING { break try_11; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_K_NULL {
            pos = start;
            try_12: {
                if pos >= tokens.len() || tokens.kinds[pos] != TK_K_NULL { break try_12; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expression_lr_5(tokens: &TokenStream, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_CARET { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 16);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_6(tokens: &TokenStream, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_STAR { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 15);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expression_lr_7(tokens: &TokenStream, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_SLASH { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 14);
    if pos < 0 { return -1; }
    return pos;
