                break alts_23_1;
            }
            pos = accept_25;
            if pos >= chars.len() || chars[pos] != '\n' { panic("lexer DFA invariant: gen_lexer_suffix_peek and the post-loop suffix commit must agree on match outcome (accept_<id> recorded a position the commit then rejected)"); }
            pos += 1;
            alts_ok_23 = true;
        }
    }
    if !alts_ok_23 { return -1; }
    return pos;
}

fn try_lit_lparen(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '(' { return -1; }
    return pos + 1;
}

