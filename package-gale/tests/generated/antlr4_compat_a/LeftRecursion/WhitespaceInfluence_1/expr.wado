        span: Span::new(start, i32::max(start, p.last_end())),
        expression: left,
        lit_lteq,
        expression_2,
    }));
}

fn _parse_expression__inner_lr_17(p: &mut Parser, left: ExpressionNode, start: i32) -> Result<ExpressionNode, ParseError> {
    let k_in = p.expect(TK_K_IN)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let expression_2 = _parse_expression__inner(p, 4)?;
    let mut comma_expression_list: List<CommaExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            sg_8_done: {
                sg_8: {
                    if pos >= tokens.len() || tokens.kinds[pos] != TK_LIT_COMMA { break sg_8; }
                    pos += 1;
                    pos = scan_expression(tokens, pos, 4);
                    if pos < 0 { break sg_8; }
                    break sg_8_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        let expression = _parse_expression(p, 4)?;
        let comma_expression = CommaExpressionItem {
            comma,
            expression,
        };
        comma_expression_list.push(comma_expression);
    }
    let rparen = p.expect(TK_LIT_RPAREN)?;
    return Result::Ok(ExpressionNode::doIn(ExpressiondoIn {
        span: Span::new(start, i32::max(start, p.last_end())),
        expression: left,
        k_in,
        lparen,
        expression_2,
        comma_expression_list,
        rparen,
    }));
}

fn _parse_expression__inner_lr_18(p: &mut Parser, left: ExpressionNode, start: i32) -> Result<ExpressionNode, ParseError> {
    let amp_or_k_and = p.match_set([TK_LIT_AMP, TK_K_AND])?;
    let expression_2 = _parse_expression__inner(p, 3)?;
    return Result::Ok(ExpressionNode::doAnd(ExpressiondoAnd {
        span: Span::new(start, i32::max(start, p.last_end())),
        expression: left,
        amp_or_k_and,
        expression_2,
    }));
}

fn _parse_expression__inner_lr_19(p: &mut Parser, left: ExpressionNode, start: i32) -> Result<ExpressionNode, ParseError> {
    let pipe_or_k_or = p.match_set([TK_LIT_PIPE, TK_K_OR])?;
    let expression_2 = _parse_expression__inner(p, 2)?;
    return Result::Ok(ExpressionNode::doOr(ExpressiondoOr {
        span: Span::new(start, i32::max(start, p.last_end())),
        expression: left,
        pipe_or_k_or,
        expression_2,
    }));
}

fn _parse_expression__inner(p: &mut Parser, min_prec: i32 = 0) -> Result<ExpressionNode, ParseError> {
    let start = p.peek_start();
    let mut result = _parse_expression__inner_atom(p)?;
    loop {
        let suffix_kind = p.peek_kind();
        if suffix_kind == TK_LIT_CARET {
            if 15 >= min_prec {
                if scan_expression_lr_5(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_5(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_STAR {
            if 14 >= min_prec {
                if scan_expression_lr_6(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_6(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_SLASH {
            if 13 >= min_prec {
                if scan_expression_lr_7(&p.tokens, p.pos) < 0 {
