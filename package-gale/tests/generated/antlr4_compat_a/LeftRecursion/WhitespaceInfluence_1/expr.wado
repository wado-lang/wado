    doMultipy(ExpressiondoMultipy),
    doDivide(ExpressiondoDivide),
    doModulo(ExpressiondoModulo),
    doMinus(ExpressiondoMinus),
    doPlus(ExpressiondoPlus),
    doEqual(ExpressiondoEqual),
    doNotEqual(ExpressiondoNotEqual),
    doGreather(ExpressiondoGreather),
