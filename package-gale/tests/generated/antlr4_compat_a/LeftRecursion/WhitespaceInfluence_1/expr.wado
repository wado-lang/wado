            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_PERCENT {
            if 12 >= min_prec {
                if scan_expression_lr_8(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_8(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_MINUS {
            if 11 >= min_prec {
                if scan_expression_lr_9(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_9(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_PLUS {
            if 10 >= min_prec {
                if scan_expression_lr_10(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_10(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_EQ {
            if 9 >= min_prec {
                if scan_expression_lr_11(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_11(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_BANGEQ {
            if 8 >= min_prec {
                if scan_expression_lr_12(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_12(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_GT {
            if 7 >= min_prec {
                if scan_expression_lr_13(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_13(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_GTEQ {
            if 6 >= min_prec {
                if scan_expression_lr_14(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_14(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_LT {
            if 5 >= min_prec {
                if scan_expression_lr_15(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_15(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_LTEQ {
            if 4 >= min_prec {
                if scan_expression_lr_16(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_16(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_K_IN {
            if 3 >= min_prec {
                if scan_expression_lr_17(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_17(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_0(suffix_kind) {
            if 2 >= min_prec {
                if scan_expression_lr_18(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expression__inner_lr_18(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_1(suffix_kind) {
            if 1 >= min_prec {
                if scan_expression_lr_19(&p.tokens, p.pos) < 0 {
