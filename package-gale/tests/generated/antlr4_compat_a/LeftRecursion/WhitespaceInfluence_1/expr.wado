fn _parse_expression(p: &mut Parser, min_prec: i32 = 0) -> Result<ExpressionNode, ParseError> {
    return _gale_rule(_parse_expression__inner(p, min_prec), "expression");
}

fn _gale_rule<T>(r: Result<T, ParseError>, rule: String) -> Result<T, ParseError> {
    if let Err(mut e) = r {
        e.rule_stack.push(rule);
        return Result::Err(e);
    }
    return r;
}

fn _gale_run<T>(input: &String, run: fn(&mut Parser) -> Result<T, ParseError>) -> Result<ParseResult<T>, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = run(&mut parser);
    if let Err(_e) = _result {
        return Result::Err(_gale_pick_error(&parser, _e));
    }
    if let Ok(_root) = _result {
        return Result::Ok(ParseResult { root: _root, tokens: parser.tokens });
    }
    unreachable();
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    return Parser::new(tokens);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_prog(input: &String) -> Result<ParseResult<ProgNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_prog(p));
}

pub fn parse_expression(input: &String) -> Result<ParseResult<ExpressionNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_expression(p));
}

pub fn parse(input: &String) -> Result<ParseResult<ProgNode>, ParseError> {
    return parse_prog(input);
}

pub fn walk_prog<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ProgNode) {
    v.enter_rule(0, &"prog", &node.span);
    walk_expression(v, toks, &node.expression);
    v.visit_token(toks, *(&node.eof));
    v.exit_rule(0, &"prog", &node.span);
}

pub fn walk_expression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExpressionNode) {
    match node {
        doFunction(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.id));
            v.visit_token(toks, *(&n.lparen));
            walk_expression(v, toks, &n.expression);
            for let item of &n.comma_expression_list {
                v.visit_token(toks, *(&item.comma));
                walk_expression(v, toks, &item.expression);
            }
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(1, &"expression", &n.span);
        }
        doParenthesis(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(1, &"expression", &n.span);
        }
        doNot(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.bang));
            walk_expression(v, toks, &n.expression);
            v.exit_rule(1, &"expression", &n.span);
        }
        doNegate(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.minus));
            walk_expression(v, toks, &n.expression);
            v.exit_rule(1, &"expression", &n.span);
        }
        doPositiv(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.plus));
            walk_expression(v, toks, &n.expression);
            v.exit_rule(1, &"expression", &n.span);
        }
        doPower(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.caret));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doMultipy(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.star));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doDivide(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.slash));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doModulo(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.percent));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doMinus(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.minus));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doPlus(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.plus));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.eq));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doNotEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.lit_bangeq));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doGreather(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.gt));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doGreatherEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.lit_gteq));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doLesser(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.lt));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doLesserEqual(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.lit_lteq));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doIn(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.k_in));
            v.visit_token(toks, *(&n.lparen));
            walk_expression(v, toks, &n.expression_2);
            for let item of &n.comma_expression_list {
                v.visit_token(toks, *(&item.comma));
                walk_expression(v, toks, &item.expression);
            }
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(1, &"expression", &n.span);
        }
        doAnd(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.amp_or_k_and));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        doOr(n) => {
            v.enter_rule(1, &"expression", &n.span);
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.pipe_or_k_or));
            walk_expression(v, toks, &n.expression_2);
            v.exit_rule(1, &"expression", &n.span);
        }
        newArray(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.lbracket));
            walk_expression(v, toks, &n.expression);
            for let item of &n.comma_expression_list {
                v.visit_token(toks, *(&item.comma));
                walk_expression(v, toks, &item.expression);
            }
            v.visit_token(toks, *(&n.rbracket));
            v.exit_rule(1, &"expression", &n.span);
        }
        newTrueBoolean(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.k_true));
            v.exit_rule(1, &"expression", &n.span);
        }
        newFalseBoolean(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.k_false));
            v.exit_rule(1, &"expression", &n.span);
        }
        newNumber(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.number));
            v.exit_rule(1, &"expression", &n.span);
        }
        newDateTime(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.date));
            v.exit_rule(1, &"expression", &n.span);
        }
        newIdentifier(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.id));
            v.exit_rule(1, &"expression", &n.span);
        }
        newString(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.sq_string));
            v.exit_rule(1, &"expression", &n.span);
        }
        newNull(n) => {
            v.enter_rule(1, &"expression", &n.span);
            v.visit_token(toks, *(&n.k_null));
            v.exit_rule(1, &"expression", &n.span);
        }
    }
}

pub fn to_tree(result: &ParseResult<ProgNode>) -> CstNode {
    let mut recorder = TreeRecorder::new(&result.tokens);
    walk_prog(&mut recorder, &result.tokens, &result.root);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_K_AND | TK_LIT_AMP };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_K_OR | TK_LIT_PIPE };
}

