global TK_MUL: i32 = 0;
global TK_DIV: i32 = 1;
global TK_ADD: i32 = 2;
global TK_SUB: i32 = 3;
global TK_ID: i32 = 4;
global TK_INT: i32 = 5;
global TK_NEWLINE: i32 = 6;
global TK_WS: i32 = 7;
global TK_EOF: i32 = 8;
global TK_ERROR: i32 = 9;
global TK_LIT_EQ: i32 = 10;
global TK_LIT_STAR: i32 = 11;
global TK_LIT_SLASH: i32 = 12;
global TK_LIT_PLUS: i32 = 13;
global TK_LIT_MINUS: i32 = 14;
global TK_LIT_LPAREN: i32 = 15;
global TK_LIT_RPAREN: i32 = 16;

struct Lexer {
    chars: Array<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_id(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || 'a' <= chars[pos] <= 'z' || 'A' <= chars[pos] <= 'Z') { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !(false || 'a' <= chars[pos] <= 'z' || 'A' <= chars[pos] <= 'Z') { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_int(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || '0' <= chars[pos] <= '9') { return -1; }
    pos += 1;
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            if pos >= chars.len() { break rep_1; }
            if !(false || '0' <= chars[pos] <= '9') { break rep_1; }
            pos += 1;
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_newline(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    let opt_saved_2 = pos;
    let mut opt_ok_2 = false;
    rep_2: {
        if pos >= chars.len() || chars[pos] != '\r' { break rep_2; }
        pos += 1;
        opt_ok_2 = true;
    }
    if !opt_ok_2 { pos = opt_saved_2; }
    if pos >= chars.len() || chars[pos] != '\n' { return -1; }
    pos += 1;
    return pos;
}

fn try_ws(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || chars[pos] == ' ' || chars[pos] == '\t') { return -1; }
    pos += 1;
    loop {
        let rep_saved_3 = pos;
        rep_3: {
            if pos >= chars.len() { break rep_3; }
            if !(false || chars[pos] == ' ' || chars[pos] == '\t') { break rep_3; }
            pos += 1;
            continue;
        }
        pos = rep_saved_3;
        break;
    }
    return pos;
}

fn try_lit_eq(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '=' { return -1; }
    return pos + 1;
}

fn try_lit_star(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '*' { return -1; }
    return pos + 1;
}

fn try_lit_slash(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '/' { return -1; }
    return pos + 1;
}

fn try_lit_plus(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '+' { return -1; }
    return pos + 1;
}

fn try_lit_minus(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '-' { return -1; }
    return pos + 1;
}

fn try_lit_lparen(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '(' { return -1; }
    return pos + 1;
}

fn try_lit_rparen(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ')' { return -1; }
    return pos + 1;
}

pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = Array::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: Array<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == ' ' {
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '(' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LPAREN; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if first_char == ')' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_RPAREN; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if first_char == '*' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_STAR; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if first_char == '+' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_PLUS; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if first_char == '-' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_MINUS; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if first_char == '/' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_SLASH; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if first_char == '=' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_EQ; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if 'a' <= first_char <= 'z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else if '0' <= first_char <= '9' {
            end = try_int(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INT; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        } else {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_int(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INT; }
            end = try_newline(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NEWLINE; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_MUL => "MUL",
        TK_DIV => "DIV",
        TK_ADD => "ADD",
        TK_SUB => "SUB",
        TK_ID => "ID",
        TK_INT => "INT",
        TK_NEWLINE => "NEWLINE",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_EQ => "TK_LIT_EQ",
        TK_LIT_STAR => "TK_LIT_STAR",
        TK_LIT_SLASH => "TK_LIT_SLASH",
        TK_LIT_PLUS => "TK_LIT_PLUS",
        TK_LIT_MINUS => "TK_LIT_MINUS",
        TK_LIT_LPAREN => "TK_LIT_LPAREN",
        TK_LIT_RPAREN => "TK_LIT_RPAREN",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: Array<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }
}

fn scan_prog(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_stat(tokens, pos, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_stat(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if _gale_kind_set_0(alt_kind) {
            pos = start;
            try_0: {
                pos = scan_expr(tokens, pos, 0);
                if pos < 0 { break try_0; }
                if pos >= tokens.len() || tokens[pos].kind != TK_NEWLINE { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_ID {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_EQ { break try_1; }
                pos += 1;
                pos = scan_expr(tokens, pos, 0);
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos].kind != TK_NEWLINE { break try_1; }
                pos += 1;
                break scan_alts;
            }
            pos = start;
            try_0: {
                pos = scan_expr(tokens, pos, 0);
                if pos < 0 { break try_0; }
                if pos >= tokens.len() || tokens[pos].kind != TK_NEWLINE { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_NEWLINE {
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_NEWLINE { break try_2; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expr_atom(tokens: &Array<Token>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_INT {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_INT { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_ID {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LPAREN {
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { break try_2; }
                pos += 1;
                pos = scan_expr(tokens, pos, 0);
                if pos < 0 { break try_2; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RPAREN { break try_2; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expr_lr_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    let gp_0 = pos;
    sg_0: {
        pos = gp_0;
        sg_0_0: {
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_STAR { break sg_0_0; }
            pos += 1;
            break sg_0;
        }
        pos = gp_0;
        sg_0_1: {
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_SLASH { break sg_0_1; }
            pos += 1;
            break sg_0;
        }
        return -1;
    }
    pos = scan_expr(tokens, pos, 3);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr_lr_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    let gp_1 = pos;
    sg_1: {
        pos = gp_1;
        sg_1_0: {
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_PLUS { break sg_1_0; }
            pos += 1;
            break sg_1;
        }
        pos = gp_1;
        sg_1_1: {
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_MINUS { break sg_1_1; }
            pos += 1;
            break sg_1;
        }
        return -1;
    }
    pos = scan_expr(tokens, pos, 2);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_expr_atom(tokens, pos);
    if pos < 0 { return -1; }
    loop {
        let suffix_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
        if _gale_kind_set_1(suffix_kind) {
            if 2 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expr_lr_0(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else if _gale_kind_set_2(suffix_kind) {
            if 1 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expr_lr_1(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return pos;
}

fn _parse_prog(p: &mut Parser) -> Result<ProgNode, ParseError> {
    let start = p.peek().span.start;
    let stat = _parse_stat(p)?;
    return Result::<ProgNode, ParseError>::Ok(ProgNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        stat,
    });
}

fn _parse_stat_bt_1(p: &mut Parser) -> Result<StatNode, ParseError> {
    let start = p.peek().span.start;
    let id = p.expect(TK_ID)?;
    let eq = p.expect(TK_LIT_EQ)?;
    let expr = _parse_expr(p)?;
    let newline = p.expect(TK_NEWLINE)?;
    return Result::<StatNode, ParseError>::Ok(StatNode::assign(Statassign {
        span: Span::new(start, i32::max(start, p.last_end())),
        id,
        eq,
        expr,
        newline,
    }));
}

fn _parse_stat_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_EQ { return -1; }
    pos += 1;
    pos = scan_expr(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_NEWLINE { return -1; }
    pos += 1;
    return pos;
}

fn _parse_stat_bt_0(p: &mut Parser) -> Result<StatNode, ParseError> {
    let start = p.peek().span.start;
    let expr = _parse_expr(p)?;
    let newline = p.expect(TK_NEWLINE)?;
    return Result::<StatNode, ParseError>::Ok(StatNode::printExpr(StatprintExpr {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr,
        newline,
    }));
}

fn _parse_stat_scan_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_expr(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_NEWLINE { return -1; }
    pos += 1;
    return pos;
}

fn _parse_stat(p: &mut Parser) -> Result<StatNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if _gale_kind_set_3(kind) {
        if p.peek_kind() == TK_ID {
            let _sd_tokens = &p.tokens;
            let _sd_pos = p.pos;
            let _sd_p_1 = _parse_stat_scan_1(_sd_tokens, _sd_pos);
            let _sd_p_0 = _parse_stat_scan_0(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_p_0 > _sd_best_p {
                _sd_best_p = _sd_p_0;
                _sd_best_i = 0;
            }
            if _sd_best_i == 1 {
                return _parse_stat_bt_1(p);
            }
            if _sd_best_i == 0 {
                return _parse_stat_bt_0(p);
            }
            return _parse_stat_bt_0(p);
        } else if _gale_kind_set_0(p.peek_kind()) {
            return _parse_stat_bt_0(p);
        }
    }
    if kind == TK_NEWLINE {
        let newline = p.expect(TK_NEWLINE)?;
        return Result::<StatNode, ParseError>::Ok(StatNode::blank(Statblank {
            span: Span::new(start, i32::max(start, p.last_end())),
            newline,
        }));
    }
    return Result::<StatNode, ParseError>::Err(ParseError::new(
        "expected stat",
        p.peek().span,
        ["TK_INT", "TK_ID", "TK_LIT_LPAREN", "TK_NEWLINE"],
    ));
}

fn _parse_expr_atom(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_INT {
        let int = p.expect(TK_INT)?;
        return Result::<ExprNode, ParseError>::Ok(ExprNode::int(Exprint {
            span: Span::new(start, i32::max(start, p.last_end())),
            int,
        }));
    }
    if kind == TK_ID {
        let id = p.expect(TK_ID)?;
        return Result::<ExprNode, ParseError>::Ok(ExprNode::id(Exprid {
            span: Span::new(start, i32::max(start, p.last_end())),
            id,
        }));
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let expr = _parse_expr(p)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::<ExprNode, ParseError>::Ok(ExprNode::parens(Exprparens {
            span: Span::new(start, i32::max(start, p.last_end())),
            lparen,
            expr,
            rparen,
        }));
    }
    return Result::<ExprNode, ParseError>::Err(ParseError::new(
        "expected expr",
        p.peek().span,
        ["TK_INT", "TK_ID", "TK_LIT_LPAREN"],
    ));
}

fn _parse_expr_lr_0(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let star_or_slash = p.advance();
    let expr_2 = _parse_expr(p, 3)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::MulDiv(ExprMulDiv {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr: left,
        star_or_slash,
        expr_2,
    }));
}

fn _parse_expr_lr_1(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let plus_or_minus = p.advance();
    let expr_2 = _parse_expr(p, 2)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::AddSub(ExprAddSub {
        span: Span::new(start, i32::max(start, p.last_end())),
        expr: left,
        plus_or_minus,
        expr_2,
    }));
}

fn _parse_expr(p: &mut Parser, min_prec: i32 = 0) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let mut result = _parse_expr_atom(p)?;
    loop {
        let suffix_kind = p.peek_kind();
        if _gale_kind_set_1(suffix_kind) {
            if 2 >= min_prec {
                if scan_expr_lr_0(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expr_lr_0(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_2(suffix_kind) {
            if 1 >= min_prec {
                if scan_expr_lr_1(&p.tokens, p.pos) < 0 {
                    break;
                }
                result = _parse_expr_lr_1(p, result, start)?;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return Result::<ExprNode, ParseError>::Ok(result);
}

pub fn parse_prog(input: &String) -> Result<ProgNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return _parse_prog(&mut parser);
}

pub fn parse_stat(input: &String) -> Result<StatNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return _parse_stat(&mut parser);
}

pub fn parse_expr(input: &String) -> Result<ExprNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return _parse_expr(&mut parser, 0);
}

pub fn parse(input: &String) -> Result<ProgNode, ParseError> {
    return parse_prog(input);
}

pub fn walk_prog<V: Visitor>(v: &mut V, node: &ProgNode) {
    v.enter_rule(0, &"prog", &node.span);
    walk_stat(v, &node.stat);
    v.exit_rule(0, &"prog", &node.span);
}

pub fn walk_stat<V: Visitor>(v: &mut V, node: &StatNode) {
    match node {
        printExpr(n) => {
            v.enter_rule(1, &"stat", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.newline);
            v.exit_rule(1, &"stat", &n.span);
        }
        assign(n) => {
            v.enter_rule(1, &"stat", &n.span);
            v.visit_token(&n.id);
            v.visit_token(&n.eq);
            walk_expr(v, &n.expr);
            v.visit_token(&n.newline);
            v.exit_rule(1, &"stat", &n.span);
        }
        blank(n) => {
            v.enter_rule(1, &"stat", &n.span);
            v.visit_token(&n.newline);
            v.exit_rule(1, &"stat", &n.span);
        }
    }
}

pub fn walk_expr<V: Visitor>(v: &mut V, node: &ExprNode) {
    match node {
        MulDiv(n) => {
            v.enter_rule(2, &"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.star_or_slash);
            walk_expr(v, &n.expr_2);
            v.exit_rule(2, &"expr", &n.span);
        }
        AddSub(n) => {
            v.enter_rule(2, &"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.plus_or_minus);
            walk_expr(v, &n.expr_2);
            v.exit_rule(2, &"expr", &n.span);
        }
        int(n) => {
            v.enter_rule(2, &"expr", &n.span);
            v.visit_token(&n.int);
            v.exit_rule(2, &"expr", &n.span);
        }
        id(n) => {
            v.enter_rule(2, &"expr", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(2, &"expr", &n.span);
        }
        parens(n) => {
            v.enter_rule(2, &"expr", &n.span);
            v.visit_token(&n.lparen);
            walk_expr(v, &n.expr);
            v.visit_token(&n.rparen);
            v.exit_rule(2, &"expr", &n.span);
        }
    }
}

pub fn to_tree(node: &ProgNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_prog(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_INT | TK_LIT_LPAREN };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_LIT_SLASH | TK_LIT_STAR };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_PLUS };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_ID | TK_INT | TK_LIT_LPAREN };
}

