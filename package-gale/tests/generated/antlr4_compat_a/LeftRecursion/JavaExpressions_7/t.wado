fn _parse_e(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    _parse_e__inner(p, follow, min_prec);
    p.atn_stack.pop();
    if p.recovering {
        p.push_rule_stack("e");
    }
}

fn _parse_typespec__inner_alt_1(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let id = p.expect(TK_ID, &SYNC_14);
    let lbracket = p.expect(TK_LIT_LBRACKET, &SYNC_15);
    let rbracket = p.expect(TK_LIT_RBRACKET, &EMPTY_SYNC);
    return;
}

fn _parse_typespec__inner_scan_1(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner_alt_0(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let id = p.expect(TK_ID, &EMPTY_SYNC);
    return;
}

fn _parse_typespec__inner_scan_0(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner_alt_3(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let lit_int = p.expect(TK_LIT_INT, &SYNC_14);
    let lbracket = p.expect(TK_LIT_LBRACKET, &SYNC_15);
    let rbracket = p.expect(TK_LIT_RBRACKET, &EMPTY_SYNC);
    return;
}

fn _parse_typespec__inner_scan_3(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_INT { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner_alt_2(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let lit_int = p.expect(TK_LIT_INT, &EMPTY_SYNC);
    return;
}

fn _parse_typespec__inner_scan_2(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_INT { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let kind = p.peek_kind();
    if kind == TK_ID {
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 18, &p.atn_stack, &p.kinds, p.pos, TK_EOF, 0);
        if _atn_alt == 1 {
            return _parse_typespec__inner_alt_1(p, follow);
        }
        return _parse_typespec__inner_alt_0(p, follow);
    }
    if kind == TK_LIT_INT {
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 18, &p.atn_stack, &p.kinds, p.pos, TK_EOF, 0);
        if _atn_alt == 3 {
            return _parse_typespec__inner_alt_3(p, follow);
        }
        return _parse_typespec__inner_alt_2(p, follow);
    }
    p.no_viable(
        "no alternative of typespec matches",
        p.peek_span(),
        &SYNC_1,
    );
    return;
}

fn _parse_typespec(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    let _start = p.peek_start();
    p.b.start_node(RK_TYPESPEC, _start);
    _parse_typespec__inner(p, follow);
    p.b.finish_node(p.last_end());
    p.atn_stack.pop();
    if p.recovering {
        p.push_rule_stack("typespec");
    }
}

fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.output = p.tokens.output;
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(e) = &p.pending {
            let lc = line_col(p.tokens.chars, e.span.start);
            let mut d = Diagnostic::error(p.pending_code, e.full_message(), e.span, lc.0, lc.1);
            d.rule_stack = e.rule_stack;
            p.diagnostics.push(d);
        }
    }
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.output };
}

pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_s(input, max_errors);
}

pub fn parse_s(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_s(p));
}

pub fn parse_expression_list(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expression_list(p));
}

pub fn parse_e(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_e(p));
}

pub fn parse_typespec(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_typespec(p));
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(54);
    for let mut k = 0; k < 54; k += 1 {
        v.push(token_kind_name(k));
    }
    return v;
}

global CTX_TOKEN_NAMES: List<String> = _token_names();

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &_token_names());
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &_token_names());
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_ID | TK_INT | TK_LIT_BANG | TK_LIT_INT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_NEW | TK_LIT_PLUS | TK_LIT_PLUSPLUS | TK_LIT_SUPER | TK_LIT_THIS | TK_LIT_TILDE };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_PLUSPLUS };
}

fn _kind_set_2(k: i32) -> bool {
    return k matches { TK_LIT_BANG | TK_LIT_TILDE };
}

fn _kind_set_3(k: i32) -> bool {
    return k matches { TK_LIT_MINUSMINUS | TK_LIT_PLUSPLUS };
}

fn _kind_set_4(k: i32) -> bool {
    return k matches { TK_LIT_PERCENT | TK_LIT_SLASH | TK_LIT_STAR };
}

fn _kind_set_5(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_PLUS };
}

fn _kind_set_6(k: i32) -> bool {
    return k matches { TK_LIT_GTGT | TK_LIT_GTGTGT | TK_LIT_LTLT };
}

fn _kind_set_7(k: i32) -> bool {
    return k matches { TK_LIT_GT | TK_LIT_GTEQ | TK_LIT_LT | TK_LIT_LTEQ };
}

fn _kind_set_8(k: i32) -> bool {
    return k matches { TK_LIT_BANGEQ | TK_LIT_EQEQ };
}

fn _kind_set_9(k: i32) -> bool {
    return k matches { TK_LIT_AMPEQ | TK_LIT_CARETEQ | TK_LIT_EQ | TK_LIT_GTGTEQ | TK_LIT_GTGTGTEQ | TK_LIT_LTLTEQ | TK_LIT_MINUSEQ | TK_LIT_PERCENTEQ | TK_LIT_PIPEEQ | TK_LIT_PLUSEQ | TK_LIT_SLASHEQ | TK_LIT_STAREQ };
}

fn _kind_set_10(k: i32) -> bool {
    return k matches { TK_ID | TK_LIT_INT };
}

