pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char matches { '\n' | ' ' } {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char matches { '!' } {
            end = try_lit_bang(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANG; }
            end = try_lit_bangeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_BANGEQ; }
        } else if first_char matches { '$' | '_' } {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { '%' } {
            end = try_lit_percent(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PERCENT; }
            end = try_lit_percenteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PERCENTEQ; }
        } else if first_char matches { '&' } {
            end = try_lit_amp(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_AMP; }
            end = try_lit_ampamp(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_AMPAMP; }
            end = try_lit_ampeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_AMPEQ; }
        } else if first_char matches { '(' } {
            end = try_lit_lparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LPAREN; }
        } else if first_char matches { ')' } {
            end = try_lit_rparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RPAREN; }
        } else if first_char matches { '*' } {
            end = try_lit_star(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_STAR; }
            end = try_lit_stareq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_STAREQ; }
        } else if first_char matches { '+' } {
            end = try_lit_plusplus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PLUSPLUS; }
            end = try_lit_plus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PLUS; }
            end = try_lit_pluseq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PLUSEQ; }
        } else if first_char matches { ',' } {
            end = try_lit_comma(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_COMMA; }
        } else if first_char matches { '-' } {
            end = try_lit_minusminus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_MINUSMINUS; }
            end = try_lit_minus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_MINUS; }
            end = try_lit_minuseq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_MINUSEQ; }
        } else if first_char matches { '.' } {
            end = try_lit_dot(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_DOT; }
        } else if first_char matches { '/' } {
            end = try_lit_slash(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_SLASH; }
            end = try_lit_slasheq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_SLASHEQ; }
        } else if first_char matches { ':' } {
            end = try_lit_colon(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_COLON; }
        } else if first_char matches { '<' } {
            end = try_lit_ltlt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTLT; }
            end = try_lit_lteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTEQ; }
            end = try_lit_lt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LT; }
            end = try_lit_ltlteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LTLTEQ; }
        } else if first_char matches { '=' } {
            end = try_lit_eqeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_EQEQ; }
            end = try_lit_eq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_EQ; }
        } else if first_char matches { '>' } {
            end = try_lit_gtgtgt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTGTGT; }
            end = try_lit_gtgt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTGT; }
            end = try_lit_gteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTEQ; }
            end = try_lit_gt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GT; }
            end = try_lit_gtgteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTGTEQ; }
            end = try_lit_gtgtgteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_GTGTGTEQ; }
        } else if first_char matches { '?' } {
            end = try_lit_question(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_QUESTION; }
        } else if first_char matches { '[' } {
            end = try_lit_lbracket(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LBRACKET; }
        } else if first_char matches { ']' } {
            end = try_lit_rbracket(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RBRACKET; }
        } else if first_char matches { '^' } {
            end = try_lit_caret(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_CARET; }
            end = try_lit_careteq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_CARETEQ; }
        } else if first_char matches { 'c' } {
            end = try_lit_class(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_CLASS; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'i' } {
            end = try_lit_instanceof(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_INSTANCEOF; }
            end = try_lit_int(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_INT; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'n' } {
            end = try_lit_new(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_NEW; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 's' } {
            end = try_lit_super(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_SUPER; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 't' } {
            end = try_lit_this(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_THIS; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { '|' } {
            end = try_lit_pipe(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PIPE; }
            end = try_lit_pipepipe(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PIPEPIPE; }
            end = try_lit_pipeeq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PIPEEQ; }
        } else if first_char matches { '~' } {
            end = try_lit_tilde(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_TILDE; }
        } else if first_char matches { 'a'..='z' | 'A'..='Z' } {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { '0'..='9' } {
            end = try_INT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INT; }
        } else {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_INT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INT; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_INT => "INT",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_COMMA => "','",
        TK_LIT_LPAREN => "'('",
        TK_LIT_RPAREN => "')'",
        TK_LIT_THIS => "'this'",
        TK_LIT_SUPER => "'super'",
        TK_LIT_DOT => "'.'",
        TK_LIT_CLASS => "'class'",
        TK_LIT_NEW => "'new'",
        TK_LIT_LBRACKET => "'['",
        TK_LIT_RBRACKET => "']'",
        TK_LIT_PLUSPLUS => "'++'",
        TK_LIT_MINUSMINUS => "'--'",
        TK_LIT_PLUS => "'+'",
        TK_LIT_MINUS => "'-'",
        TK_LIT_TILDE => "'~'",
        TK_LIT_BANG => "'!'",
        TK_LIT_STAR => "'*'",
        TK_LIT_SLASH => "'/'",
        TK_LIT_PERCENT => "'%'",
        TK_LIT_LTLT => "'<<'",
        TK_LIT_GTGTGT => "'>>>'",
        TK_LIT_GTGT => "'>>'",
        TK_LIT_LTEQ => "'<='",
        TK_LIT_GTEQ => "'>='",
        TK_LIT_GT => "'>'",
        TK_LIT_LT => "'<'",
        TK_LIT_INSTANCEOF => "'instanceof'",
        TK_LIT_EQEQ => "'=='",
        TK_LIT_BANGEQ => "'!='",
        TK_LIT_AMP => "'&'",
        TK_LIT_CARET => "'^'",
        TK_LIT_PIPE => "'|'",
        TK_LIT_AMPAMP => "'&&'",
        TK_LIT_PIPEPIPE => "'||'",
        TK_LIT_QUESTION => "'?'",
        TK_LIT_COLON => "':'",
        TK_LIT_EQ => "'='",
        TK_LIT_PLUSEQ => "'+='",
        TK_LIT_MINUSEQ => "'-='",
        TK_LIT_STAREQ => "'*='",
        TK_LIT_SLASHEQ => "'/='",
        TK_LIT_AMPEQ => "'&='",
        TK_LIT_PIPEEQ => "'|='",
        TK_LIT_CARETEQ => "'^='",
        TK_LIT_GTGTEQ => "'>>='",
        TK_LIT_GTGTGTEQ => "'>>>='",
        TK_LIT_LTLTEQ => "'<<='",
        TK_LIT_PERCENTEQ => "'%='",
        TK_LIT_INT => "'int'",
        _ => "Unknown",
    };
}

pub global RK_S: NodeKind = 0;
pub global RK_EXPRESSIONLIST: NodeKind = 1;
pub global RK_E: NodeKind = 2;
pub global RK_TYPESPEC: NodeKind = 3;

global RULE_NAMES: List<String> = ["s", "expressionList", "e", "typespec"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    pending_code: DiagnosticCode,
    speculating: bool,
    max_errors: i32,
    atn_stack: List<i32>,
    atn_ret_pending: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    output: String,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX, atn_stack: [], atn_ret_pending: -1, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], output: "" };
    }

    fn emit(&mut self, s: String) {
        self.output.push_str(&s);
    }

    fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.chars[j] == '-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.chars[j];
            if c.is_ascii_digit() {
                acc = acc * 10 + (c as i32 - '0' as i32);
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    fn token_line(&self, i: i32) -> i32 {
        return line_col(self.tokens.chars, self.tokens.span_at(i).start).0;
    }

    fn token_col(&self, i: i32) -> i32 {
        return line_col(self.tokens.chars, self.tokens.span_at(i).start).1;
    }

    fn token_start(&self, i: i32) -> i32 {
        return self.tokens.starts[i];
    }

    fn la(&self, k: i32) -> i32 {
        return self.peek_at(k - 1);
    }

    fn lt(&self, k: i32) -> i32 {
        let idx = self.pos + k - 1;
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    fn text_span(&self, start: i32, end: i32) -> String {
        let mut out = String::new();
        let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };
        for let mut i = start; i < hi; i += 1 {
            out.push(self.tokens.chars[i]);
        }
        return out;
    }

    fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.chars.len());
    }

    fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn error(&self, message: String, span: Span, expected: &List<i32>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, kind_names(expected), lc.0, lc.1);
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        let take = if let Some(cur) = &self.pending { span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(self.error(message, span, expected));
            self.pending_code = code;
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn report_missing(&mut self, kind: i32, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        let name = token_kind_name(kind);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));
    }

    fn report_unexpected(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail(`got "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), &([kind] as List<i32>), DiagnosticCode::UnexpectedToken);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(self.tokens.span_at(self.pos));
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind, self.tokens.span_at(self.pos));
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(self.tokens.span_at(self.pos));
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &([kind] as List<i32>),
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token; got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !self.in_set(k, excluded) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `unexpected token "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if self.in_set(k, included) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            included,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }
}

fn scan_s(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_e(tokens, pos, &FOLLOW_MASK_0, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression_list(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let scan_start = pos;
    let mut pos = pos;
    pos = scan_e(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_0; }
                pos += 1;
                pos = scan_e(tokens, pos, follow, 0);
                if pos < 0 { break sg_0; }
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos == scan_start { return -1; }
    return pos;
}

fn scan_e_atom_alt_5(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_typespec(tokens, pos, &FOLLOW_MASK_2);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_DOT { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_CLASS { return -1; }
    pos += 1;
    return pos;
}

fn scan_e_atom(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LIT_LPAREN {
            let mut best: i32 = -1;
            pos = start + 1;
            try_7: {
                pos = scan_typespec(tokens, pos, &FOLLOW_MASK_1);
                if pos < 0 { break try_7; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_7; }
                pos += 1;
                pos = scan_e(tokens, pos, follow, 0);
                if pos < 0 { break try_7; }
                if pos > best { best = pos; }
            }
            pos = start + 1;
            try_0: {
                pos = scan_e(tokens, pos, &FOLLOW_MASK_1, 0);
                if pos < 0 { break try_0; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_THIS {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_LIT_SUPER {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_INT {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_ID {
            let mut best: i32 = -1;
            let try_5_end = scan_e_atom_alt_5(tokens, start, follow);
            if try_5_end > best { best = try_5_end; }
            pos = start + 1;
            if pos > best { best = pos; }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_INT {
            pos = scan_e_atom_alt_5(tokens, start, follow);
            if pos >= 0 { break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_NEW {
            pos = start + 1;
            try_6: {
                pos = scan_typespec(tokens, pos, &FOLLOW_MASK_3);
                if pos < 0 { break try_6; }
                let gp_1 = pos;
                let sgk_1 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                let mut sg_1_best = -1;
                if sgk_1 == TK_LIT_LPAREN {
                    pos = gp_1;
                    sg_1_0: {
                        if pos >= tokens.len() || tokens[pos] != TK_LIT_LPAREN { break sg_1_0; }
                        pos += 1;
                        if pos < tokens.len() && _kind_set_0(tokens[pos]) {
                            let sp = pos;
                            pos = scan_expression_list(tokens, pos, &EMPTY_FOLLOW);
                            if pos < 0 { pos = sp; }
                        }
                        if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break sg_1_0; }
                        pos += 1;
                        if pos > sg_1_best { sg_1_best = pos; }
                    }
                } else if sgk_1 == TK_LIT_LBRACKET {
                    pos = gp_1;
                    sg_1_1: {
                        sg_2_done: {
                            sg_2: {
                                if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { break sg_2; }
                                pos += 1;
                                pos = scan_e(tokens, pos, &FOLLOW_MASK_4, 0);
                                if pos < 0 { break sg_2; }
                                if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { break sg_2; }
                                pos += 1;
                                break sg_2_done;
                            }
                            break sg_1_1;
                        }
                        while pos < tokens.len() && tokens[pos] == TK_LIT_LBRACKET && !(follow_yields(tokens, pos, follow, TK_EOF)) {
                            let sp = pos;
                            sg_3_done: {
                                sg_3: {
                                    if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { break sg_3; }
                                    pos += 1;
                                    pos = scan_e(tokens, pos, &FOLLOW_MASK_4, 0);
                                    if pos < 0 { break sg_3; }
                                    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { break sg_3; }
                                    pos += 1;
                                    break sg_3_done;
                                }
                                pos = -1;
                            }
                            if pos < 0 { pos = sp; break; }
                            if pos == sp { break; }
                        }
                        if pos > sg_1_best { sg_1_best = pos; }
                    }
                }
                if sg_1_best >= 0 {
                    pos = sg_1_best;
                } else {
                    pos = gp_1;
                }
                break scan_alts;
            }
            return -1;
        } else if _kind_set_1(alt_kind) {
            pos = start;
            try_8: {
                let gp_4 = pos;
                let sgk_4 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                let mut sg_4_best = -1;
                if sgk_4 == TK_LIT_PLUS {
                    pos = gp_4;
                    sg_4_0: {
                        if pos >= tokens.len() || tokens[pos] != TK_LIT_PLUS { break sg_4_0; }
                        pos += 1;
                        if pos > sg_4_best { sg_4_best = pos; }
                    }
                } else if sgk_4 == TK_LIT_MINUS {
                    pos = gp_4;
                    sg_4_1: {
                        if pos >= tokens.len() || tokens[pos] != TK_LIT_MINUS { break sg_4_1; }
                        pos += 1;
                        if pos > sg_4_best { sg_4_best = pos; }
                    }
                } else if sgk_4 == TK_LIT_PLUSPLUS {
