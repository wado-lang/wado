struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice with stores[self] {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_ID(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_1 = pos;
    let mut alts_ok_1 = false;
    alts_1_0: {
        pos = alts_saved_1;
        if pos >= chars.len() || !(chars[pos] matches { 'a'..='z' }) { break alts_1_0; }
        pos += 1;
        alts_ok_1 = true;
    }
    if !alts_ok_1 {
        alts_1_1: {
            pos = alts_saved_1;
            if pos >= chars.len() || !(chars[pos] matches { 'A'..='Z' }) { break alts_1_1; }
            pos += 1;
            alts_ok_1 = true;
        }
        if !alts_ok_1 {
            alts_1_2: {
                pos = alts_saved_1;
                if pos >= chars.len() || chars[pos] != '_' { break alts_1_2; }
                pos += 1;
                alts_ok_1 = true;
            }
            if !alts_ok_1 {
                alts_1_3: {
                    pos = alts_saved_1;
                    if pos >= chars.len() || chars[pos] != '$' { break alts_1_3; }
                    pos += 1;
                    alts_ok_1 = true;
                }
            }
        }
    }
    if !alts_ok_1 { return -1; }
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            let alts_saved_3 = pos;
            let mut alts_ok_3 = false;
            alts_3_0: {
                pos = alts_saved_3;
                if pos >= chars.len() || !(chars[pos] matches { 'a'..='z' }) { break alts_3_0; }
                pos += 1;
                alts_ok_3 = true;
            }
            if !alts_ok_3 {
                alts_3_1: {
                    pos = alts_saved_3;
                    if pos >= chars.len() || !(chars[pos] matches { 'A'..='Z' }) { break alts_3_1; }
                    pos += 1;
                    alts_ok_3 = true;
                }
                if !alts_ok_3 {
                    alts_3_2: {
                        pos = alts_saved_3;
                        if pos >= chars.len() || chars[pos] != '_' { break alts_3_2; }
                        pos += 1;
                        alts_ok_3 = true;
                    }
                    if !alts_ok_3 {
                        alts_3_3: {
                            pos = alts_saved_3;
                            if pos >= chars.len() || chars[pos] != '$' { break alts_3_3; }
                            pos += 1;
                            alts_ok_3 = true;
                        }
                    }
                }
            }
            if !alts_ok_3 { break rep_0; }
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_INT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || !(chars[pos] matches { '0'..='9' }) { return -1; }
    pos += 1;
    loop {
        let rep_saved_4 = pos;
        rep_4: {
            if pos >= chars.len() || !(chars[pos] matches { '0'..='9' }) { break rep_4; }
            pos += 1;
            continue;
        }
        pos = rep_saved_4;
        break;
    }
    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_6 = pos;
    let mut alts_ok_6 = false;
    alts_6_0: {
        pos = alts_saved_6;
        if pos >= chars.len() || chars[pos] != ' ' { break alts_6_0; }
        pos += 1;
        alts_ok_6 = true;
    }
    if !alts_ok_6 {
        alts_6_1: {
            pos = alts_saved_6;
            if pos >= chars.len() || chars[pos] != '\n' { break alts_6_1; }
            pos += 1;
            alts_ok_6 = true;
        }
    }
    if !alts_ok_6 { return -1; }
    return pos;
}

