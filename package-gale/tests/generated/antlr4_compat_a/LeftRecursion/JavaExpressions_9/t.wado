fn scan_typespec(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            let mut best: i32 = -1;
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos] != TK_ID { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { break try_1; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos] != TK_ID { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_INT {
            let mut best: i32 = -1;
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_INT { break try_3; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { break try_3; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { break try_3; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_INT { break try_2; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn _parse_s__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let e = _parse_e(p, &FOLLOW_MASK_0);
    let eof = p.expect(TK_EOF, &EMPTY_SYNC);
    return;
}

fn _parse_s(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_S, _start);
    _parse_s__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("s");
    }
}

fn _parse_expression_list__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let e = _parse_e(p, follow);
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_13_done: {
                sg_13: {
                    if pos >= tokens.len() || tokens[pos] != TK_LIT_COMMA { break sg_13; }
                    pos += 1;
                    pos = scan_e(tokens, pos, follow, 0);
                    if pos < 0 { break sg_13; }
                    break sg_13_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA, &EMPTY_SYNC);
        let e = _parse_e(p, follow);
    }
    return;
}

fn _parse_expression_list(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_EXPRESSIONLIST, _start);
    _parse_expression_list__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("expressionList");
