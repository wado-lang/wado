fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(66);
    for let mut k = 0; k < 66; k += 1 {
        v.push(token_kind_name(k));
    }
    v[TK_OpenBracket] = "'['";
    v[TK_CloseBracket] = "']'";
    v[TK_OpenParen] = "'('";
    v[TK_CloseParen] = "')'";
    v[TK_OpenBrace] = "'{'";
    v[TK_CloseBrace] = "'}'";
    v[TK_SemiColon] = "';'";
    v[TK_Equal] = "'='";
    v[TK_Colon] = "':'";
    v[TK_Dot] = "'.'";
    v[TK_Multiply] = "'*'";
    v[TK_Divide] = "'/'";
    v[TK_Pipe] = "'|'";
    v[TK_Underscore] = "'_'";
    v[TK_Cdo] = "'<!--'";
    v[TK_Cdc] = "'-->'";
    v[TK_Includes] = "'~='";
    v[TK_DashMatch] = "'|='";
    v[TK_Charset] = "'@charset '";
    v[TK_Url_] = "'url('";
    v[TK_Plus] = "'+'";
    v[TK_Minus] = "'-'";
    v[TK_Greater] = "'>'";
    v[TK_Comma] = "','";
    v[TK_Tilde] = "'~'";
    v[TK_PrefixMatch] = "'^='";
    v[TK_SuffixMatch] = "'$='";
    v[TK_SubstringMatch] = "'*='";
    v[TK_Calc] = "'calc('";
    v[TK_Var] = "'var('";
    return v;
}

global TOKEN_NAMES: List<String> = _token_names();

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }
    return String::new();
}

