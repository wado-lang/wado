fn atn_decide_12(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            TK_Charset => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        TK_Comment | TK_Space => {
                            if pos + 2 < tokens.len() {
                                match tokens[pos + 2] {
                                    TK_String_ => {
                                        if pos + 3 < tokens.len() && tokens[pos + 3] < 66 {
                                            match tokens[pos + 3] {
                                                TK_SemiColon => {
                                                    return 0;
                                                },
                                                TK_CloseBracket | TK_CloseParen | TK_CloseBrace | TK_Equal | TK_Divide | TK_Underscore | TK_Comment | TK_Space | TK_Important | TK_Greater | TK_Comma | TK_Tilde | TK_PrefixMatch | TK_SuffixMatch | TK_SubstringMatch | TK_Calc | TK_DxImageTransform | TK_Variable | TK_Var | TK_UnexpectedCharacter | TK_EOF | TK_ERROR => {},
                                                _ => {
                                                    return 1;
                                                },
                                            };
                                        }
                                    },
                                    _ => {},
                                };
                            }
                        },
                        TK_String_ => {
                            if pos + 2 < tokens.len() && tokens[pos + 2] < 66 {
                                match tokens[pos + 2] {
                                    TK_SemiColon => {
                                        return 0;
                                    },
                                    TK_Comment | TK_Space => {
                                        if pos + 3 < tokens.len() && tokens[pos + 3] < 66 {
                                            match tokens[pos + 3] {
                                                TK_SemiColon => {
                                                    return 0;
                                                },
                                                TK_CloseBracket | TK_CloseParen | TK_CloseBrace | TK_Equal | TK_Divide | TK_Underscore | TK_Comment | TK_Space | TK_Important | TK_Greater | TK_Comma | TK_Tilde | TK_PrefixMatch | TK_SuffixMatch | TK_SubstringMatch | TK_Calc | TK_DxImageTransform | TK_Variable | TK_Var | TK_UnexpectedCharacter | TK_EOF | TK_ERROR => {},
                                                _ => {
                                                    return 1;
                                                },
                                            };
                                        }
                                    },
                                    TK_CloseBracket | TK_CloseParen | TK_CloseBrace | TK_Equal | TK_Divide | TK_Underscore | TK_Important | TK_Greater | TK_Comma | TK_Tilde | TK_PrefixMatch | TK_SuffixMatch | TK_SubstringMatch | TK_Calc | TK_DxImageTransform | TK_Variable | TK_Var | TK_UnexpectedCharacter | TK_EOF | TK_ERROR => {},
                                    _ => {
                                        return 1;
                                    },
                                };
                            }
                        },
                        _ => {},
                    };
                }
            },
            _ => {},
        };
    }
    return atn_predict_once(&ATN_SIM, 12, atn, tokens, pos, TK_EOF, min_prec);
}

