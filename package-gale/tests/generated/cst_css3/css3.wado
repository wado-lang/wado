fn _parse_feature_value_block__inner(p: &mut Parser, follow: i64 = 0) {
    p.site = 353;
    p.atn_ret_pending = 1665;
    _parse_feature_type(p);
    p.site = 354;
    p.atn_ret_pending = 1667;
    _parse_ws(p, follow_push(FOLLOW_SITE_130, follow));
