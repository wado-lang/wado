        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_66_done: {
                sg_66: {
                    pos = scan_ws(tokens, pos, FOLLOW_MASK_31);
                    if pos < 0 { break sg_66; }
                    if pos >= tokens.len() || tokens[pos] != TK_Comma { break sg_66; }
                    pos += 1;
                    pos = scan_ws(tokens, pos, FOLLOW_MASK_12);
                    if pos < 0 { break sg_66; }
                    pos = scan_font_family_name(tokens, pos, follow);
                    if pos < 0 { break sg_66; }
                    break sg_66_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.site = 347;
        _parse_ws(p, FOLLOW_MASK_31);
        p.expect(TK_Comma, &SYNC_0, false);
        p.site = 348;
        _parse_ws(p, FOLLOW_MASK_12);
        p.site = 349;
        _parse_font_family_name(p, follow);
    }
    return;
}

fn _parse_font_family_name_list(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_FONT_FAMILY_NAME_LIST, _start);
    _parse_font_family_name_list__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_FONT_FAMILY_NAME_LIST, "fontFamilyNameList", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_font_family_name__inner(p: &mut Parser, follow: i64 = 0) -> () {
    if !kind_set_has(&SYNC_0, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_0, &EXPECTED_0); }
    let kind = p.peek_kind();
    if kind == TK_String_ {
        p.take();
        return;
    } else if _kind_set_3(kind) {
        p.site = 350;
        _parse_ident(p);
        loop {
            if p.recovering { break; }
            if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                sg_67_done: {
                    sg_67: {
                        pos = scan_ws(tokens, pos, FOLLOW_MASK_5);
                        if pos < 0 { break sg_67; }
                        if pos >= tokens.len() || !_kind_set_3(tokens[pos]) { break sg_67; }
                        pos += 1;
                        break sg_67_done;
                    }
                    break rep_scan;
                }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            p.site = 351;
            _parse_ws(p, FOLLOW_MASK_5);
            p.site = 352;
            _parse_ident(p);
        }
        return;
    }
    p.no_viable(
        "no alternative of fontFamilyName matches",
        p.peek_span(),
        &EXPECTED_17,
    );
    return;
}

fn _parse_font_family_name(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_FONT_FAMILY_NAME, _start);
