fn _parse_ws__inner(p: &mut Parser, follow: i64 = 0) -> () {
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || !_kind_set_29(tokens[pos]) { break rep_scan; }
            pos += 1;
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.expect_set(&SYNC_43, &EXPECTED_43);
    }
    return;
}

fn _parse_ws(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_WS, _start);
    _parse_ws__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_WS, "ws", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_stylesheet(input, max_errors);
}

pub fn parse_stylesheet<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_stylesheet(p));
}

