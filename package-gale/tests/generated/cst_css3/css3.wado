                    let mut pos: i32 = p.pos;
                    pos = scan_declaration_list(tokens, pos, follow);
                    if pos < 0 { break gd_scan; }
                    gd_end = pos;
                }
                if gd_end > gd_best {
                    gd_best = gd_end;
                    gd_winner = 0;
                }
                if gd_best >= p.kinds.len() {
                    break gd_tourney;
                }
                let mut gd_end_2: i32 = -1;
                gd_scan_2: {
                    let tokens = &p.kinds;
                    let mut pos: i32 = p.pos;
                    pos = scan_nested_statement(tokens, pos, follow);
                    if pos < 0 { break gd_scan_2; }
                    gd_end_2 = pos;
                }
                if gd_end_2 > gd_best {
                    gd_best = gd_end_2;
                    gd_winner = 1;
                }
                if gd_best >= p.kinds.len() {
                    break gd_tourney;
                }
                let mut gd_end_3: i32 = -1;
                gd_scan_3: {
                    let tokens = &p.kinds;
                    let mut pos: i32 = p.pos;
                    pos = scan_any_(tokens, pos, follow);
                    if pos < 0 { break gd_scan_3; }
                    gd_end_3 = pos;
                }
                if gd_end_3 > gd_best {
                    gd_best = gd_end_3;
                    gd_winner = 2;
                }
                if gd_best >= p.kinds.len() {
                    break gd_tourney;
                }
                let mut gd_end_4: i32 = -1;
                gd_scan_4: {
                    let tokens = &p.kinds;
                    let mut pos: i32 = p.pos;
                    pos = scan_block(tokens, pos, follow);
                    if pos < 0 { break gd_scan_4; }
                    gd_end_4 = pos;
