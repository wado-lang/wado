                    if pos < 0 { break sg_82; }
                    pos = scan_font_family_name(tokens, pos, follow);
                    if pos < 0 { break sg_82; }
                    break sg_82_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.site = 347;
        _parse_ws(p, FOLLOW_MASK_31);
        p.expect(TK_Comma, &SYNC_75, false);
        p.site = 348;
        _parse_ws(p, FOLLOW_MASK_12);
        p.site = 349;
        _parse_font_family_name(p, follow);
    }
    return;
}

fn _parse_font_family_name_list(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_FONT_FAMILY_NAME_LIST, _start);
    _parse_font_family_name_list__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_FONT_FAMILY_NAME_LIST, "fontFamilyNameList", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_font_family_name__inner(p: &mut Parser, follow: i64 = 0) -> () {
    if !kind_set_has(&SYNC_0, p.kinds[p.pos]) { p.sync_alts(&SYNC_0, &EXPECTED_0); }
    let kind = p.peek_kind();
    if kind == TK_String_ {
        p.take();
        return;
    }
    if _kind_set_3(kind) {
        p.site = 350;
        _parse_ident(p);
        loop {
            if p.recovering { break; }
            if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                sg_83_done: {
                    sg_83: {
                        pos = scan_ws(tokens, pos, FOLLOW_MASK_5);
                        if pos < 0 { break sg_83; }
                        if pos >= tokens.len() || !_kind_set_3(tokens[pos]) { break sg_83; }
                        pos += 1;
                        break sg_83_done;
                    }
                    break rep_scan;
                }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            p.site = 351;
            _parse_ws(p, FOLLOW_MASK_5);
            p.site = 352;
            _parse_ident(p);
        }
        return;
    }
    p.no_viable(
        "no alternative of fontFamilyName matches",
        p.peek_span(),
        &EXPECTED_30,
    );
    return;
}

fn _parse_font_family_name(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_FONT_FAMILY_NAME, _start);
    _parse_font_family_name__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_FONT_FAMILY_NAME, "fontFamilyName", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_feature_value_block__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.site = 353;
    _parse_feature_type(p);
    p.site = 354;
    _parse_ws(p, FOLLOW_MASK_3);
    p.expect(TK_OpenBrace, &SYNC_77, false);
    p.site = 355;
    _parse_ws(p, 0);
    if !kind_set_has(&SYNC_18, p.kinds[p.pos]) { p.sync_enter(&SYNC_18, &EXPECTED_18); }
    if _kind_set_3(p.peek_kind()) {
        p.site = 356;
        _parse_feature_value_definition(p, 0);
    }
    if !kind_set_has(&SYNC_18, p.kinds[p.pos]) { p.sync_enter(&SYNC_18, &EXPECTED_18); }
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_84_done: {
                sg_84: {
                    pos = scan_ws(tokens, pos, FOLLOW_MASK_1);
                    if pos < 0 { break sg_84; }
                    if pos >= tokens.len() || tokens[pos] != TK_SemiColon { break sg_84; }
                    pos += 1;
                    pos = scan_ws(tokens, pos, follow);
                    if pos < 0 { break sg_84; }
                    if pos < tokens.len() && _kind_set_3(tokens[pos]) {
                        let sp = pos;
                        pos = scan_feature_value_definition(tokens, pos, follow);
                        if pos < 0 { pos = sp; }
                    }
                    break sg_84_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.site = 357;
        _parse_ws(p, FOLLOW_MASK_1);
        p.expect(TK_SemiColon, &SYNC_14);
        p.site = 358;
        _parse_ws(p, follow);
        if !kind_set_has(&SYNC_18, p.kinds[p.pos]) { p.sync_enter(&SYNC_18, &EXPECTED_18); }
        if _kind_set_3(p.peek_kind()) {
            p.site = 359;
            _parse_feature_value_definition(p, follow);
        }
        if !kind_set_has(&SYNC_18, p.kinds[p.pos]) { p.sync_back(&SYNC_18, &EXPECTED_18); }
    }
    p.expect(TK_CloseBrace, &SYNC_4, true, true);
    p.site = 360;
    _parse_ws(p, follow);
    return;
}

fn _parse_feature_value_block(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
