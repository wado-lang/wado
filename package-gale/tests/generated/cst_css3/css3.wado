            if pos >= chars.len() || chars[pos] != '*' { break rep_4; }
            pos += 1;
            loop {
                let rep_saved_7 = pos;
                rep_7: {
                    if pos >= chars.len() || chars[pos] != '*' { break rep_7; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_7;
                break;
            }
            continue;
        }
        pos = rep_saved_4;
        break;
    }
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    return pos;
}

