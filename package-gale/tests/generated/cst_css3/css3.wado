fn _parse_ws__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            let gp_122 = pos;
            let sgk_122 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
            let mut sg_122_best = -1;
            if sgk_122 == TK_Comment {
                pos = gp_122;
                sg_122_0: {
                    if pos >= tokens.len() || tokens[pos] != TK_Comment { break sg_122_0; }
                    pos += 1;
                    if pos > sg_122_best { sg_122_best = pos; }
                }
            } else if sgk_122 == TK_Space {
                pos = gp_122;
                sg_122_1: {
                    if pos >= tokens.len() || tokens[pos] != TK_Space { break sg_122_1; }
                    pos += 1;
                    if pos > sg_122_best { sg_122_best = pos; }
                }
            }
            if sg_122_best >= 0 {
                pos = sg_122_best;
            } else {
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.expect_set(&SYNC_3);
    }
    return;
