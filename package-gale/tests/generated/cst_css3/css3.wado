struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    site: i32,
    sites: List<i32>,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, site: -1, sites: [], b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.recovering = true;
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
        }
        self.recovering = true;
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail_expecting(&([kind] as List<i32>));
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn recover_rule(&mut self, rule: NodeKind, name: String, row: i32) -> bool {
        if self.speculating || self.diagnostics.len() >= self.max_errors {
            self.push_rule_stack(name);
            return false;
        }
        let node = if row < 0 { self.b.innermost_open() } else { row };
        self.b.resume_node(node, self.last_end());
        assert self.b.node_kind(node) == rule, "recover_rule: the resumed node is the failed rule's";
        self.commit_pending();
        self.recovering = false;
        self.skip_until(&self.resync_set(&[]));
        return true;
    }

    fn commit_pending(&mut self) {
        let Some(d) = self.pending else { return; };
        self.pending = null;
        let mut diag = d;
        self.b.push_open_rule_names(&RULE_NAMES, &mut diag.rule_stack);
        self.report(diag);
    }

    fn report(&mut self, diag: Diagnostic) {
        if self.b.in_error_mode() { return; }
        self.diagnostics.push(diag);
        self.b.mark_error();
    }

    fn resync_set(&self, base: &List<i32>) -> List<i32> {
        let mut set = *base;
        for let s of &self.sites {
            if *s < 0 { continue; }
            let f = &CALL_FOLLOW_SETS[CALL_FOLLOW[*s]];
            while set.len() < f.len() { set.push(0); }
            for let mut i = 0; i < f.len(); i += 1 { set[i] = set[i] | f[i]; }
        }
        return set;
    }

    fn follows_rules_under_way(&self, k: i32) -> bool {
        for let mut i = self.sites.len() - 1; i >= 0; i -= 1 {
            let s = self.sites[i];
            if s < 0 { return i == 0 && k == TK_EOF; }
            if kind_set_has(&CALL_FOLLOW_SETS[CALL_FOLLOW[s]], k) { return true; }
            if !CALL_FOLLOW_ENDS[s] { return false; }
        }
        return k == TK_EOF;
    }

    fn skip_until(&mut self, set: &List<i32>) {
        loop {
            let k = self.kinds[self.pos];
            if k == TK_EOF || kind_set_has(set, k) { break; }
            self.skip_one();
        }
