pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(lexer.src);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = char_at(&lexer.src, start);
        let mut best_channel: i32 = 0;
        match first_char {
            '\t' | '\n' | '\u{c}' | '\r' | ' ' => {
                end = try_Space(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Space; best_channel = 0; }
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '\u{b}' | '\u{e}'..='\u{1f}' | '%'..='&' | '?' | 'B'..='E' | 'G'..='M' | 'P'..='S' | 'V'..='Z' | '_'..='`' | 'b' | 'd'..='e' | 'g'..='m' | 'q'..='s' | 'w'..='z' => {
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '!' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\u{8}' | '\u{b}' | '\u{e}'..='\u{1f}' | '!'..='\'' | '(' | ')'..=',' | '-' | '.' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='H' | 'J'..='Z' | '[' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='h' | 'j'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '\t' | ' ' | '/' | 'I' | '\\' | 'i' => {
                        end = try_Important(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Important; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '\n' | '\u{c}' | '\r' => {
                        end = try_Important(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Important; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '"' | '\'' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_String_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_String_; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '#' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '.'..='/' | ':'..='@' | '[' | ']'..='^' | '`' | '{'..='\u{7f}' => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '-' | '0'..='9' | 'A'..='F' | 'G'..='Z' | '\\' | '_' | 'a'..='f' | 'g'..='z' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Hash(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Hash; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '$' => {
                let second_at = lexer.src.ceil_char_boundary(start + 1);
                let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='<' | '>'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '=' => {
                        end = try_SuffixMatch(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_SuffixMatch; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
