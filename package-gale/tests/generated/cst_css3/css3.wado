    _parse_ws(p, FOLLOW_MASK_17);
    p.expect(TK_Colon, &SYNC_0, false);
    p.site = 363;
    _parse_ws(p, FOLLOW_MASK_29);
    p.site = 364;
    _parse_number(p, follow);
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_68_done: {
                sg_68: {
                    pos = scan_ws(tokens, pos, FOLLOW_MASK_29);
                    if pos < 0 { break sg_68; }
                    pos = scan_number(tokens, pos, follow);
                    if pos < 0 { break sg_68; }
                    break sg_68_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.site = 365;
        _parse_ws(p, FOLLOW_MASK_29);
        p.site = 366;
        _parse_number(p, follow);
    }
    return;
}

fn _parse_feature_value_definition(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_FEATURE_VALUE_DEFINITION, _start);
    _parse_feature_value_definition__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_FEATURE_VALUE_DEFINITION, "featureValueDefinition", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_ident__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_42, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_42, &EXPECTED_42); }
    let kind = p.peek_kind();
    if _kind_set_3(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of ident matches",
        p.peek_span(),
        &EXPECTED_42,
    );
    return;
}

fn _parse_ident(p: &mut Parser) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_IDENT, _start);
    _parse_ident__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_IDENT, "ident", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_ws__inner(p: &mut Parser, follow: i64 = 0) -> () {
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || !_kind_set_29(tokens[pos]) { break rep_scan; }
            pos += 1;
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.expect_set(&SYNC_43, &EXPECTED_43);
    }
    return;
}

fn _parse_ws(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_WS, _start);
    _parse_ws__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_WS, "ws", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

