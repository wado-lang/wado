    pos = scan_ws(tokens, pos, FOLLOW_MASK_3);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_OpenBrace { return -1; }
    pos += 1;
    pos = scan_ws(tokens, pos, 0);
    if pos < 0 { return -1; }
