        alts_1214_2: {
            pos = alts_saved_1214;
            if pos >= chars.len() || chars[pos] != '\\' { break alts_1214_2; }
            pos += 1;
            pos = frag_ZeroToFourZeros(chars, pos);
            if pos < 0 { break alts_1214_2; }
            let alts_saved_1215 = pos;
            alts_done_1215: {
                alts_1215_0: {
                    pos = alts_saved_1215;
                    if pos >= chars.len() || chars[pos] != '5' { break alts_1215_0; }
                    pos += 1;
                    if pos >= chars.len() || chars[pos] != '7' { break alts_1215_0; }
                    pos += 1;
                    break alts_done_1215;
                }
                alts_1215_1: {
                    pos = alts_saved_1215;
                    if pos >= chars.len() || chars[pos] != '7' { break alts_1215_1; }
                    pos += 1;
                    if pos >= chars.len() || chars[pos] != '7' { break alts_1215_1; }
                    pos += 1;
                    break alts_done_1215;
                }
                break alts_1214_2;
            }
            pos = frag_tail_NewlineOrSpace(chars, pos);
            if pos < 0 { break alts_1214_2; }
            break alts_done_1214;
        }
        alts_1214_3: {
            pos = alts_saved_1214;
            if pos >= chars.len() || chars[pos] != '\\' { break alts_1214_3; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != 'w' { break alts_1214_3; }
            pos += 1;
            break alts_done_1214;
        }
        alts_1214_4: {
            pos = alts_saved_1214;
            if pos >= chars.len() || chars[pos] != '\\' { break alts_1214_4; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != 'W' { break alts_1214_4; }
            pos += 1;
            break alts_done_1214;
        }
        return -1;
    }
    return pos;
}

fn frag_Unicode(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\\' { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { return -1; }
    pos += 1;
    let opt_saved_1216 = pos;
    let mut opt_ok_1216 = false;
    opt_1216: {
        if pos >= chars.len() { break opt_1216; }
        if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_1216; }
        pos += 1;
        opt_ok_1216 = true;
    }
    if !opt_ok_1216 { pos = opt_saved_1216; }
    let opt_saved_1217 = pos;
    let mut opt_ok_1217 = false;
    opt_1217: {
        if pos >= chars.len() { break opt_1217; }
        if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_1217; }
        pos += 1;
        opt_ok_1217 = true;
    }
    if !opt_ok_1217 { pos = opt_saved_1217; }
    let opt_saved_1218 = pos;
    let mut opt_ok_1218 = false;
    opt_1218: {
        if pos >= chars.len() { break opt_1218; }
        if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_1218; }
        pos += 1;
        opt_ok_1218 = true;
    }
    if !opt_ok_1218 { pos = opt_saved_1218; }
    let opt_saved_1219 = pos;
    let mut opt_ok_1219 = false;
    opt_1219: {
        if pos >= chars.len() { break opt_1219; }
        if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_1219; }
        pos += 1;
        opt_ok_1219 = true;
    }
    if !opt_ok_1219 { pos = opt_saved_1219; }
    let opt_saved_1220 = pos;
    let mut opt_ok_1220 = false;
    opt_1220: {
        if pos >= chars.len() { break opt_1220; }
        if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_1220; }
        pos += 1;
        opt_ok_1220 = true;
    }
    if !opt_ok_1220 { pos = opt_saved_1220; }
    pos = frag_NewlineOrSpace(chars, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn classify_keyword(chars: &List<char>, start: i32, end: i32) -> i32 {
    match end - start {
        1 => { if chars[start] == '_' { return TK_Underscore; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
