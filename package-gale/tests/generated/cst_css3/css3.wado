fn _parse_ident__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_42, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_42, &EXPECTED_42); }
    let kind = p.peek_kind();
    if _kind_set_3(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of ident matches",
        p.peek_span(),
        &EXPECTED_42,
    );
    return;
}

fn _parse_ident(p: &mut Parser) -> () {
    if p.recovering { return; }
