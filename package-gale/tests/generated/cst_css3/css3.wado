fn _parse_feature_value_definition__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let ident = _parse_ident(p, &FOLLOW_MASK_16);
    let ws = _parse_ws(p, &FOLLOW_MASK_22);
    let colon = p.expect(TK_LIT_COLON, &SYNC_0);
    let ws_2 = _parse_ws(p, &FOLLOW_MASK_38);
    let number = _parse_number(p, follow);
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_136_done: {
                sg_136: {
                    pos = scan_ws(tokens, pos, &FOLLOW_MASK_38, 0);
                    if pos < 0 { break sg_136; }
                    pos = scan_number(tokens, pos, follow, 0);
                    if pos < 0 { break sg_136; }
                    break sg_136_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let ws = _parse_ws(p, &FOLLOW_MASK_38);
        let number = _parse_number(p, follow);
    }
    return;
}

fn _parse_feature_value_definition(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
