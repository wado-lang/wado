}

fn try_DashMatch(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'|' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'=' { return -1; }
    pos += 1;
    return pos;
}

fn try_Hash(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'#' { return -1; }
    pos += 1;
    pos = frag_Name(src, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn try_Import(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() { return -1; }
    if !(unchecked src.byte_at(pos) matches { b'@' }) { return -1; }
    pos += 1;
    let la_saved_0 = pos;
    let mut la_reach_0: i32 = -1;
    let mut la_win_0: i32 = -1;
    let mut la_arm_0_0: i32 = -1;
    la_alt_0_0: {
        pos = la_saved_0;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'i' { break la_alt_0_0; }
        pos += 1;
        la_arm_0_0 = pos;
    }
    let mut la_arm_0_1: i32 = -1;
    la_alt_0_1: {
        pos = la_saved_0;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'I' { break la_alt_0_1; }
        pos += 1;
        la_arm_0_1 = pos;
    }
    let mut la_arm_0_2: i32 = -1;
    la_alt_0_2: {
        pos = la_saved_0;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'\\' { break la_alt_0_2; }
        pos += 1;
        pos = frag_ZeroToFourZeros(src, pos);
        if pos < 0 { break la_alt_0_2; }
        let alts_saved_1 = pos;
        alts_done_1: {
            alts_1_0: {
                pos = alts_saved_1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'4' { break alts_1_0; }
                pos += 1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'9' { break alts_1_0; }
                pos += 1;
                break alts_done_1;
            }
            alts_1_1: {
                pos = alts_saved_1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'6' { break alts_1_1; }
                pos += 1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'9' { break alts_1_1; }
                pos += 1;
                break alts_done_1;
            }
            break la_alt_0_2;
        }
        if pos >= src.len() || unchecked src.byte_at(pos) != b'\x0d' { break la_alt_0_2; }
        pos += 1;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'\x0a' { break la_alt_0_2; }
        pos += 1;
        la_arm_0_2 = pos;
    }
    let mut la_arm_0_3: i32 = -1;
    la_alt_0_3: {
        pos = la_saved_0;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'\\' { break la_alt_0_3; }
        pos += 1;
        pos = frag_ZeroToFourZeros(src, pos);
        if pos < 0 { break la_alt_0_3; }
        let alts_saved_2 = pos;
        alts_done_2: {
            alts_2_0: {
                pos = alts_saved_2;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'4' { break alts_2_0; }
                pos += 1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'9' { break alts_2_0; }
                pos += 1;
                break alts_done_2;
            }
            alts_2_1: {
                pos = alts_saved_2;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'6' { break alts_2_1; }
                pos += 1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'9' { break alts_2_1; }
                pos += 1;
                break alts_done_2;
            }
            break la_alt_0_3;
        }
        if pos >= src.len() { break la_alt_0_3; }
        if !(unchecked src.byte_at(pos) matches { b' ' | b'\x09' | b'\x0d' | b'\x0a' | b'\x0c' }) { break la_alt_0_3; }
        pos += 1;
        la_arm_0_3 = pos;
    }
    let mut la_arm_0_4: i32 = -1;
    la_alt_0_4: {
        pos = la_saved_0;
        if pos >= src.len() || unchecked src.byte_at(pos) != b'\\' { break la_alt_0_4; }
        pos += 1;
        pos = frag_ZeroToFourZeros(src, pos);
        if pos < 0 { break la_alt_0_4; }
        let alts_saved_3 = pos;
        alts_done_3: {
            alts_3_0: {
                pos = alts_saved_3;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'4' { break alts_3_0; }
                pos += 1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'9' { break alts_3_0; }
                pos += 1;
                break alts_done_3;
            }
            alts_3_1: {
                pos = alts_saved_3;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'6' { break alts_3_1; }
                pos += 1;
                if pos >= src.len() || unchecked src.byte_at(pos) != b'9' { break alts_3_1; }
                pos += 1;
                break alts_done_3;
            }
            break la_alt_0_4;
        }
        la_arm_0_4 = pos;
    }
    let mut la_arm_0_5: i32 = -1;
