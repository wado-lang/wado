pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        let mut best_channel: i32 = 0;
        match first_char {
            '\t' | '\n' | '\u{c}' | '\r' | ' ' => {
                end = try_Space(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Space; best_channel = 0; }
                end = try_Ident(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '\u{b}' | '\u{e}'..='\u{1f}' | '%'..='&' | '?' | 'B'..='E' | 'G'..='M' | 'P'..='S' | 'V'..='Z' | '_'..='`' | 'b' | 'd'..='e' | 'g'..='m' | 'q'..='s' | 'w'..='z' => {
                end = try_Ident(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
