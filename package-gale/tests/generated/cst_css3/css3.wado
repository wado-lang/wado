                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '|' => {
                end = try_Pipe(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Pipe; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..='*' | ',' | '-' | '.'..='/' | '0'..='9' | ':'..='<' | '>'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Ident(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '+' => {
                        end = try_UnicodeRange(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_UnicodeRange; best_channel = 0; }
                        end = try_Ident(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '=' => {
                        end = try_DashMatch(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_DashMatch; best_channel = 0; }
                        end = try_Ident(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Ident(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '}' => {
                end = try_CloseBrace(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_CloseBrace; best_channel = 0; }
                end = try_Ident(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '~' => {
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='<' | '>'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Tilde(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Tilde; best_channel = 0; }
                        end = try_Ident(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '=' => {
                        end = try_Includes(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Includes; best_channel = 0; }
                        end = try_Tilde(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Tilde; best_channel = 0; }
                        end = try_Ident(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Tilde(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Tilde; best_channel = 0; }
                        end = try_Ident(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            _ => {
                end = try_Ident(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
        }
        if best_end <= start {
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        }
        if best_end <= start {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            if best_kind matches { TK_Ident | TK_UnexpectedCharacter } {
                let kw_kind = classify_keyword(&lexer.chars, start, best_end);
                if kw_kind >= 0 { best_kind = kw_kind; best_channel = 0; }
            }
            let tok_start = start;
            if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_OpenBracket => "OpenBracket",
        TK_CloseBracket => "CloseBracket",
        TK_OpenParen => "OpenParen",
        TK_CloseParen => "CloseParen",
        TK_OpenBrace => "OpenBrace",
        TK_CloseBrace => "CloseBrace",
        TK_SemiColon => "SemiColon",
        TK_Equal => "Equal",
        TK_Colon => "Colon",
        TK_Dot => "Dot",
        TK_Multiply => "Multiply",
        TK_Divide => "Divide",
        TK_Pipe => "Pipe",
        TK_Underscore => "Underscore",
        TK_Comment => "Comment",
        TK_Url => "Url",
        TK_Space => "Space",
        TK_Cdo => "Cdo",
        TK_Cdc => "Cdc",
        TK_Includes => "Includes",
        TK_DashMatch => "DashMatch",
        TK_Hash => "Hash",
        TK_Import => "Import",
        TK_Page => "Page",
        TK_Media => "Media",
        TK_Namespace => "Namespace",
        TK_Charset => "Charset",
        TK_Important => "Important",
        TK_Percentage => "Percentage",
        TK_Url_ => "Url_",
        TK_UnicodeRange => "UnicodeRange",
        TK_MediaOnly => "MediaOnly",
        TK_Not => "Not",
        TK_And => "And",
        TK_Dimension => "Dimension",
        TK_UnknownDimension => "UnknownDimension",
        TK_Plus => "Plus",
        TK_Minus => "Minus",
        TK_Greater => "Greater",
        TK_Comma => "Comma",
        TK_Tilde => "Tilde",
        TK_PseudoNot => "PseudoNot",
        TK_Number => "Number",
        TK_String_ => "String_",
        TK_PrefixMatch => "PrefixMatch",
        TK_SuffixMatch => "SuffixMatch",
        TK_SubstringMatch => "SubstringMatch",
        TK_FontFace => "FontFace",
        TK_Supports => "Supports",
        TK_Or => "Or",
        TK_Keyframes => "Keyframes",
        TK_From => "From",
        TK_To => "To",
        TK_Calc => "Calc",
        TK_Viewport => "Viewport",
        TK_CounterStyle => "CounterStyle",
        TK_FontFeatureValues => "FontFeatureValues",
        TK_DxImageTransform => "DxImageTransform",
        TK_AtKeyword => "AtKeyword",
        TK_Variable => "Variable",
        TK_Var => "Var",
        TK_Ident => "Ident",
        TK_Function_ => "Function_",
        TK_UnexpectedCharacter => "UnexpectedCharacter",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

