struct Lexer {
    src: StrSlice,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { src: input.as_str_slice(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.src.len();
    }
}

fn try_OpenBracket(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'[' { return -1; }
    pos += 1;
    return pos;
}

fn try_CloseBracket(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b']' { return -1; }
    pos += 1;
    return pos;
}

fn try_OpenParen(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'(' { return -1; }
    pos += 1;
    return pos;
}

fn try_CloseParen(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b')' { return -1; }
    pos += 1;
    return pos;
}

fn try_OpenBrace(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'{' { return -1; }
    pos += 1;
    return pos;
}

fn try_CloseBrace(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'}' { return -1; }
    pos += 1;
    return pos;
}

fn try_SemiColon(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b';' { return -1; }
    pos += 1;
    return pos;
}

fn try_Equal(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'=' { return -1; }
    pos += 1;
    return pos;
}

fn try_Colon(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b':' { return -1; }
    pos += 1;
    return pos;
}

fn try_Dot(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'.' { return -1; }
    pos += 1;
    return pos;
}

fn try_Multiply(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { return -1; }
    pos += 1;
    return pos;
}

fn try_Divide(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    return pos;
}

fn try_Pipe(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'|' { return -1; }
    pos += 1;
    return pos;
}

fn try_Comment(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { return -1; }
    pos += 1;
    loop {
        rep_0: {
            if pos >= src.len() { break rep_0; }
            if (unchecked src.byte_at(pos) matches { b'*' }) { break rep_0; }
            pos = src.ceil_char_boundary(pos + 1);
            continue;
        }
        break;
    }
    if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { return -1; }
    pos += 1;
    loop {
        rep_1: {
            if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { break rep_1; }
            pos += 1;
            continue;
        }
        break;
    }
    loop {
        let rep_saved_3 = pos;
        rep_3: {
            if pos >= src.len() { break rep_3; }
            if (unchecked src.byte_at(pos) matches { b'/' | b'*' }) { break rep_3; }
            pos = src.ceil_char_boundary(pos + 1);
            loop {
                rep_4: {
                    if pos >= src.len() { break rep_4; }
                    if (unchecked src.byte_at(pos) matches { b'*' }) { break rep_4; }
                    pos = src.ceil_char_boundary(pos + 1);
                    continue;
                }
                break;
            }
            if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { break rep_3; }
            pos += 1;
            loop {
                rep_5: {
                    if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { break rep_5; }
                    pos += 1;
                    continue;
                }
                break;
            }
            continue;
        }
        pos = rep_saved_3;
        break;
    }
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    return pos;
}

fn try_Url(src: &StrSlice, start: i32) -> i32 {
    return latn_match(&LATN_SIM, 0, src, start, true);
}

fn try_Space(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() { return -1; }
    if !(unchecked src.byte_at(pos) matches { b' ' | b'\x09' | b'\x0d' | b'\x0a' | b'\x0c' }) { return -1; }
    pos += 1;
    loop {
        rep_7: {
            if pos >= src.len() { break rep_7; }
            if !(unchecked src.byte_at(pos) matches { b' ' | b'\x09' | b'\x0d' | b'\x0a' | b'\x0c' }) { break rep_7; }
            pos += 1;
            continue;
        }
        break;
    }
    return pos;
}

fn try_Cdo(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'<' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'!' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'-' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'-' { return -1; }
    pos += 1;
    return pos;
}

fn try_Cdc(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
