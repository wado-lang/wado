struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }
}

fn try_OpenBracket(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '[' { return -1; }
    pos += 1;
    return pos;
}

fn try_CloseBracket(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ']' { return -1; }
    pos += 1;
    return pos;
}

fn try_OpenParen(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '(' { return -1; }
    pos += 1;
    return pos;
}

fn try_CloseParen(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ')' { return -1; }
    pos += 1;
    return pos;
}

fn try_OpenBrace(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '{' { return -1; }
    pos += 1;
    return pos;
}

fn try_CloseBrace(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '}' { return -1; }
    pos += 1;
    return pos;
}

fn try_SemiColon(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ';' { return -1; }
    pos += 1;
    return pos;
}

fn try_Equal(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '=' { return -1; }
    pos += 1;
    return pos;
}

fn try_Colon(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ':' { return -1; }
    pos += 1;
    return pos;
}

fn try_Dot(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '.' { return -1; }
    pos += 1;
    return pos;
}

fn try_Multiply(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '*' { return -1; }
    pos += 1;
    return pos;
}

fn try_Divide(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    return pos;
}

fn try_Pipe(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '|' { return -1; }
    pos += 1;
    return pos;
}

fn try_Comment(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '*' { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if (chars[pos] matches { '*' }) { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
