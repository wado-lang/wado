}

fn scan_imports_alt_2(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Import { return -1; }
    pos += 1;
