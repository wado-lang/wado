global TOKEN_NAMES: List<String> = ["'['", "']'", "'('", "')'", "'{'", "'}'", "';'", "'='", "':'", "'.'", "'*'", "'/'", "'|'", "'_'", "Comment", "Url", "Space", "'<!--'", "'-->'", "'~='", "'|='", "Hash", "Import", "Page", "Media", "Namespace", "'@charset '", "Important", "Percentage", "'url('", "UnicodeRange", "MediaOnly", "Not", "And", "Dimension", "UnknownDimension", "'+'", "'-'", "'>'", "','", "'~'", "PseudoNot", "Number", "String_", "'^='", "'$='", "'*='", "FontFace", "Supports", "Or", "Keyframes", "From", "To", "'calc('", "Viewport", "CounterStyle", "FontFeatureValues", "DxImageTransform", "AtKeyword", "Variable", "'var('", "Ident", "Function_", "UnexpectedCharacter", "Eof", "Error"];

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_Cdc | TK_Cdo | TK_Comment | TK_Space };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_And | TK_AtKeyword | TK_Colon | TK_CounterStyle | TK_DashMatch | TK_Dimension | TK_Dot | TK_FontFace | TK_FontFeatureValues | TK_From | TK_Function_ | TK_Hash | TK_Ident | TK_Includes | TK_Keyframes | TK_Media | TK_MediaOnly | TK_Minus | TK_Multiply | TK_Not | TK_Number | TK_OpenBrace | TK_OpenBracket | TK_OpenParen | TK_Or | TK_Page | TK_Percentage | TK_Pipe | TK_Plus | TK_PseudoNot | TK_String_ | TK_Supports | TK_To | TK_UnicodeRange | TK_UnknownDimension | TK_Url | TK_Url_ | TK_Viewport };
}

fn _kind_set_2(k: i32) -> bool {
    return k matches { TK_Url | TK_Url_ };
}

fn _kind_set_3(k: i32) -> bool {
    return k matches { TK_And | TK_From | TK_Ident | TK_MediaOnly | TK_Not | TK_Or | TK_To };
}

fn _kind_set_4(k: i32) -> bool {
    return k matches { TK_And | TK_Comment | TK_From | TK_Ident | TK_MediaOnly | TK_Not | TK_OpenParen | TK_Or | TK_Space | TK_To };
