fn try_Number(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_0 = pos;
    let mut alts_best_0 = -1;
    alts_0_0: {
        pos = alts_saved_0;
        if pos >= src.len() { break alts_0_0; }
        if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' }) { break alts_0_0; }
        pos += 1;
        loop {
            rep_1: {
                if pos >= src.len() { break rep_1; }
                if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' }) { break rep_1; }
                pos += 1;
                continue;
            }
            break;
        }
        if pos > alts_best_0 { alts_best_0 = pos; }
    }
    alts_0_1: {
        pos = alts_saved_0;
        loop {
            rep_3: {
                if pos >= src.len() { break rep_3; }
                if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' }) { break rep_3; }
                pos += 1;
                continue;
            }
            break;
        }
        if pos >= src.len() || unchecked src.byte_at(pos) != b'.' { break alts_0_1; }
        pos += 1;
        if pos >= src.len() { break alts_0_1; }
        if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' }) { break alts_0_1; }
        pos += 1;
        loop {
            rep_4: {
                if pos >= src.len() { break rep_4; }
                if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' }) { break rep_4; }
                pos += 1;
                continue;
            }
            break;
        }
        if pos > alts_best_0 { alts_best_0 = pos; }
    }
    if alts_best_0 < 0 { return -1; }
    pos = alts_best_0;
    return pos;
}

fn try_String_(src: &StrSlice, start: i32) -> i32 {
    return latn_match(&LATN_SIM, 8, src, start, true);
}

fn try_PrefixMatch(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'^' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'=' { return -1; }
    pos += 1;
    return pos;
}

fn try_SuffixMatch(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'$' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'=' { return -1; }
    pos += 1;
    return pos;
}

fn try_SubstringMatch(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'=' { return -1; }
    pos += 1;
