global mut ATN_MISMATCH: String = "";

fn atn_verify_begin() -> String {
    let outer = ATN_MISMATCH;
    ATN_MISMATCH = "";
    return outer;
}

fn atn_verify_end(diagnostics: &List<Diagnostic>, outer: String) {
    if diagnostics.is_empty() && !ATN_MISMATCH.is_empty() {
        panic(`prediction verify: ${ATN_MISMATCH}`);
    }
    ATN_MISMATCH = outer;
}

fn atn_verified(decision: i32, picker: i32, atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32, alt: i32) -> i32 {
    return atn_verified_against(decision, picker, pos, atn_predict_walk(&ATN_SIM, decision, &atn.stack, tokens, pos, TK_EOF, min_prec, &ATN_NO_PREDS.met, &ATN_NO_PREDS.own, atn_unasked), alt);
}

fn atn_verified_against(decision: i32, picker: i32, pos: i32, verdict: [i32, bool], alt: i32) -> i32 {
    let [simulated, viable] = verdict;
    if viable {
        atn_shadow(decision, picker, pos, alt, simulated);
    }
    return alt;
}

fn atn_shadow(decision: i32, picker: i32, pos: i32, alt: i32, simulated: i32) {
    if alt == simulated || !ATN_MISMATCH.is_empty() {
        return;
    }
    let by = match picker {
        0 => "the tournament",
        1 => "the repeat",
        2 => "the lookahead DFA",
        3 => "the LR table",
        4 => "the left-recursion loop",
        _ => unreachable(),
    };
    ATN_MISMATCH = `decision ${decision} at token ${pos}: ${by} picks ${alt}, the simulator ${simulated}`;
}

