fn _parse_feature_value_block__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.site = 353;
    _parse_feature_type(p);
    p.site = 354;
    _parse_ws(p, FOLLOW_MASK_3);
    p.expect(TK_OpenBrace, &SYNC_8, false);
    p.site = 355;
    _parse_ws(p, 0);
    if !kind_set_has(&SYNC_8, p.kinds[p.pos]) { builtin::cold_path(); p.sync_enter(&SYNC_8, &EXPECTED_8); }
    if _kind_set_3(p.peek_kind()) {
        p.site = 356;
        _parse_feature_value_definition(p, 0);
    }
    if !kind_set_has(&SYNC_8, p.kinds[p.pos]) { builtin::cold_path(); p.sync_enter(&SYNC_8, &EXPECTED_8); }
    while !p.recovering && (_kind_set_33(p.peek_kind())) {
        p.site = 357;
        _parse_ws(p, FOLLOW_MASK_1);
        p.expect(TK_SemiColon, &SYNC_8, false);
        p.site = 358;
        _parse_ws(p, follow);
        if !kind_set_has(&SYNC_8, p.kinds[p.pos]) { builtin::cold_path(); p.sync_enter(&SYNC_8, &EXPECTED_8); }
        if _kind_set_3(p.peek_kind()) {
            p.site = 359;
            _parse_feature_value_definition(p, follow);
        }
        if !kind_set_has(&SYNC_8, p.kinds[p.pos]) { builtin::cold_path(); p.sync_back(&SYNC_8, &EXPECTED_8); }
    }
    p.expect(TK_CloseBrace, &SYNC_0, true);
    p.site = 360;
    _parse_ws(p, follow);
    return;
}

