global RULE_NAMES: List<String> = ["stylesheet", "charset", "imports", "namespace_", "namespacePrefix", "media", "mediaQueryList", "mediaQuery", "mediaType", "mediaExpression", "mediaFeature", "page", "pseudoPage", "selectorGroup", "selector", "combinator", "simpleSelectorSequence", "typeSelector", "typeNamespacePrefix", "elementName", "universal", "className", "attrib", "pseudo", "functionalPseudo", "expression", "negation", "negationArg", "operator_", "property_", "ruleset", "declarationList", "declaration", "prio", "value", "expr", "term", "function_", "dxImageTransform", "hexcolor", "number", "percentage", "dimension", "unknownDimension", "any_", "atRule", "unused", "block", "nestedStatement", "groupRuleBody", "supportsRule", "supportsCondition", "supportsConditionInParens", "supportsNegation", "supportsConjunction", "supportsDisjunction", "supportsDeclarationCondition", "generalEnclosed", "url", "var_", "calc", "calcSum", "calcProduct", "calcValue", "fontFaceRule", "fontFaceDeclaration", "keyframesRule", "keyframeBlock", "keyframeSelector", "viewport", "counterStyle", "fontFeatureValuesRule", "fontFamilyNameList", "fontFamilyName", "featureValueBlock", "featureType", "featureValueDefinition", "ident", "ws"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

pub enum CharsetAlt {
    goodCharset,
    badCharset,
}

impl CstStore {
    pub fn charset_alt(&self, node: i32) -> Option<CharsetAlt> {
        return match self.alt(node) {
            0 => Option::Some(CharsetAlt::goodCharset),
            1 => Option::Some(CharsetAlt::badCharset),
            _ => null,
        };
    }
}

pub enum ImportsAlt {
    goodImport,
    badImport,
}

impl CstStore {
    pub fn imports_alt(&self, node: i32) -> Option<ImportsAlt> {
        return match self.alt(node) {
            0 => Option::Some(ImportsAlt::goodImport),
            1 => Option::Some(ImportsAlt::goodImport),
            2 => Option::Some(ImportsAlt::badImport),
            3 => Option::Some(ImportsAlt::badImport),
            _ => null,
        };
    }
}

pub enum NamespaceAlt {
    goodNamespace,
    badNamespace,
}

impl CstStore {
    pub fn namespace__alt(&self, node: i32) -> Option<NamespaceAlt> {
        return match self.alt(node) {
            0 => Option::Some(NamespaceAlt::goodNamespace),
            1 => Option::Some(NamespaceAlt::badNamespace),
            _ => null,
        };
    }
}

pub enum OperatorAlt {
    goodOperator,
    badOperator,
}

impl CstStore {
    pub fn operator__alt(&self, node: i32) -> Option<OperatorAlt> {
        return match self.alt(node) {
            0 => Option::Some(OperatorAlt::goodOperator),
            1 => Option::Some(OperatorAlt::goodOperator),
            2 => Option::Some(OperatorAlt::goodOperator),
            3 => Option::Some(OperatorAlt::badOperator),
            _ => null,
        };
    }
}

