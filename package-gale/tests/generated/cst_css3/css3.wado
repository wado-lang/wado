fn _parse_ident__inner(p: &mut Parser) {
    if !SYNC_29.has(p.peek_kind()) { builtin::cold_path(); p.sync_alts(&SYNC_29, &EXPECTED_29); }
    let kind = p.peek_kind();
    if _kind_set_3(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of ident matches",
        p.peek_span(),
        &EXPECTED_29,
    );
    return;
}

fn _parse_ident(p: &mut Parser) {
    if !p.open_rule(RK_IDENT) { return; }
    _parse_ident__inner(p);
    p.close_rule(RK_IDENT, "ident");
}

fn _parse_ws__inner(p: &mut Parser, follow: i64 = 0) {
    loop {
        if p.recovering { break; }
        let rs_pick_135 = atn_verified(128, 2, &mut p.atn, &p.kinds, p.pos, 0, atn_decide_128(&mut p.atn, &p.kinds, p.pos, 0));
        if rs_pick_135 < 0 && rs_pick_135 != ATN_NOTHING_STARTS { p.no_viable("no viable alternative", p.peek_span(), &NO_EXPECTED); }
        let rs_simulated_135 = rs_pick_135 == 0;
        if !p.recovering && !p.speculating {
            let mut rs_enters = false;
            loop {
                if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_TABLES, TK_EOF) {
                    let mut iter_scan_pos: i32 = -1;
                    iter_scan: {
                        let tokens = &p.kinds;
                        let mut pos: i32 = p.pos;
                        if pos >= tokens.len() || !_kind_set_34(tokens[pos]) { break iter_scan; }
                        pos += 1;
                        iter_scan_pos = pos;
                    }
                    if iter_scan_pos < 0 || !follow_yields(&p.kinds, iter_scan_pos, follow_push(FOLLOW_SITE_17, follow), &FOLLOW_TABLES, TK_EOF) { break; }
                }
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.kinds;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || !_kind_set_34(tokens[pos]) { break rep_scan; }
                    pos += 1;
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
                rs_enters = true;
                break;
            }
            atn_shadow(128, 1, p.pos, if rs_enters { 0 } else { 1 }, if rs_simulated_135 { 0 } else { 1 });
        }
        if !rs_simulated_135 { break; }
        p.expect_set(&SYNC_10, &EXPECTED_10);
    }
    return;
}

fn _parse_ws(p: &mut Parser, follow: i64 = 0) {
    if !p.open_rule(RK_WS) { return; }
    _parse_ws__inner(p, follow);
    p.close_rule(RK_WS, "ws");
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1;
    let follow_outer = follow_links_enter();
    let verify_outer = atn_verify_begin();
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    follow_links_leave(follow_outer);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, &p.tokens.src);
    atn_verify_end(&p.diagnostics, verify_outer);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_stylesheet(input, max_errors);
}

pub fn parse_stylesheet<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_stylesheet(p, FOLLOW_SITE_138));
