fn try_Var(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'v' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'a' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'r' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '(' { return -1; }
    pos += 1;
    return pos;
}

