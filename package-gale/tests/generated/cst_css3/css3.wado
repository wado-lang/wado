                if gd_best >= p.kinds.len() {
                    break gd_tourney;
                }
                let mut gd_end_5: i32 = -1;
                gd_scan_5: {
                    let tokens = &p.kinds;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos] != TK_AtKeyword { break gd_scan_5; }
                    pos += 1;
                    pos = scan_ws(tokens, pos, follow);
                    if pos < 0 { break gd_scan_5; }
                    gd_end_5 = pos;
                }
                if gd_end_5 > gd_best {
                    gd_best = gd_end_5;
                    gd_winner = 4;
                }
                if gd_best >= p.kinds.len() {
                    break gd_tourney;
                }
                let mut gd_end_6: i32 = -1;
                gd_scan_6: {
                    let tokens = &p.kinds;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos] != TK_SemiColon { break gd_scan_6; }
                    pos += 1;
                    pos = scan_ws(tokens, pos, follow);
                    if pos < 0 { break gd_scan_6; }
                    gd_end_6 = pos;
                }
                if gd_end_6 > gd_best {
