fn _parse_nested_statement__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    let kind = p.peek_kind();
    if _kind_set_25(kind) {
        _parse_ruleset(p, follow);
        return;
    }
    if kind == TK_Media {
        _parse_media(p, follow);
        return;
    }
    if kind == TK_Page {
        _parse_page(p, follow);
        return;
    }
    if kind == TK_FontFace {
        _parse_font_face_rule(p, follow);
        return;
    }
    if kind == TK_Keyframes {
        _parse_keyframes_rule(p, follow);
        return;
    }
    if kind == TK_Supports {
        _parse_supports_rule(p, follow);
        return;
    }
    if kind == TK_Viewport {
        _parse_viewport(p, follow);
        return;
    }
    if kind == TK_CounterStyle {
        _parse_counter_style(p, follow);
        return;
    }
    if kind == TK_FontFeatureValues {
        _parse_font_feature_values_rule(p, follow);
        return;
    }
    if kind == TK_AtKeyword {
        _parse_at_rule(p, follow);
        return;
    }
    p.no_viable(
        "no alternative of nestedStatement matches",
        p.peek_span(),
