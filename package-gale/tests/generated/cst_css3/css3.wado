fn try_Function_(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    pos = try_Ident(chars, pos);
    if pos < 0 { return -1; }
    if pos >= chars.len() || chars[pos] != '(' { return -1; }
    pos += 1;
    return pos;
}

fn try_UnexpectedCharacter(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    pos += 1;
    return pos;
}

