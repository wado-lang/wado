    if pos < 0 { return -1; }
    return pos;
}

fn scan_imports_alt_3(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Import { return -1; }
    pos += 1;
    pos = scan_ws(tokens, pos, FOLLOW_MASK_2);
    if pos < 0 { return -1; }
    sg_7_done: {
        let sgk_7 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        if sgk_7 == TK_String_ {
            pos += 1;
            break sg_7_done;
        } else if _kind_set_2(sgk_7) {
            sg_7_1: {
                pos = scan_url(tokens, pos, follow);
                if pos < 0 { break sg_7_1; }
                break sg_7_done;
            }
        }
        return -1;
    }
    pos = scan_ws(tokens, pos, follow);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_imports(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if kind == TK_Import {
        let mut best: i32 = -1;
        let try_0_end = scan_imports_alt_0(tokens, start, follow);
        if try_0_end > best { best = try_0_end; }
        let try_1_end = scan_imports_alt_1(tokens, start, follow);
        if try_1_end > best { best = try_1_end; }
        let try_2_end = scan_imports_alt_2(tokens, start, follow);
        if try_2_end > best { best = try_2_end; }
        let try_3_end = scan_imports_alt_3(tokens, start, follow);
        if try_3_end > best { best = try_3_end; }
        if best >= 0 { pos = best; return pos; }
        return -1;
    }
    return -1;
}

fn scan_namespace__alt_0(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Namespace { return -1; }
    pos += 1;
    pos = scan_ws(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos < tokens.len() && _kind_set_3(tokens[pos]) {
        let sp = pos;
        sg_8_done: {
            sg_8: {
                pos += 1;
                pos = scan_ws(tokens, pos, FOLLOW_MASK_2);
                if pos < 0 { break sg_8; }
                break sg_8_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; }
    }
    sg_9_done: {
        let sgk_9 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        if sgk_9 == TK_String_ {
            pos += 1;
            break sg_9_done;
        } else if _kind_set_2(sgk_9) {
            sg_9_1: {
                pos = scan_url(tokens, pos, 0);
                if pos < 0 { break sg_9_1; }
                break sg_9_done;
            }
        }
        return -1;
    }
    pos = scan_ws(tokens, pos, FOLLOW_MASK_1);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_SemiColon { return -1; }
    pos += 1;
    pos = scan_ws(tokens, pos, follow);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_namespace__alt_1(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Namespace { return -1; }
    pos += 1;
