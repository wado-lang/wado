            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { ']' } {
            end = try_lit_rbracket(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RBRACKET; best_channel = 0; }
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { '^' } {
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_PrefixMatch(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PrefixMatch; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { '_' } {
            end = try_lit_u5f(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_U5f; best_channel = 0; }
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { 'c' } {
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Calc(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Calc; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { 'p' } {
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_DxImageTransform(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DxImageTransform; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { 'u' } {
            end = try_Url(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Url; best_channel = 0; }
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Url_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Url_; best_channel = 0; }
            end = try_UnicodeRange(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnicodeRange; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { 'v' } {
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Var(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Var; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { '{' } {
            end = try_lit_lbrace(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LBRACE; best_channel = 0; }
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { '|' } {
            end = try_lit_pipe(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PIPE; best_channel = 0; }
            end = try_DashMatch(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DashMatch; best_channel = 0; }
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_UnicodeRange(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnicodeRange; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { '}' } {
            end = try_lit_rbrace(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RBRACE; best_channel = 0; }
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { '~' } {
            end = try_Includes(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Includes; best_channel = 0; }
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Tilde(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Tilde; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else if first_char matches { '0'..='9' } {
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Number; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        } else {
            end = try_Percentage(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
            end = try_Dimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
            end = try_UnknownDimension(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
            end = try_Number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Number; best_channel = 0; }
            end = try_Ident(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
            end = try_Function_(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
            end = try_UnexpectedCharacter(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_channel = 2; }
        }
        if best_end > start {
            let kw_kind = classify_keyword(&lexer.chars, start, best_end);
            if kw_kind >= 0 { best_kind = kw_kind; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = false;
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_OpenBracket => "OpenBracket",
        TK_CloseBracket => "CloseBracket",
        TK_OpenParen => "OpenParen",
        TK_CloseParen => "CloseParen",
        TK_OpenBrace => "OpenBrace",
        TK_CloseBrace => "CloseBrace",
        TK_SemiColon => "SemiColon",
        TK_Equal => "Equal",
        TK_Colon => "Colon",
        TK_Dot => "Dot",
        TK_Multiply => "Multiply",
        TK_Divide => "Divide",
        TK_Pipe => "Pipe",
        TK_Underscore => "Underscore",
        TK_Comment => "Comment",
        TK_Url => "Url",
        TK_Space => "Space",
        TK_Cdo => "Cdo",
        TK_Cdc => "Cdc",
        TK_Includes => "Includes",
        TK_DashMatch => "DashMatch",
        TK_Hash => "Hash",
        TK_Import => "Import",
        TK_Page => "Page",
        TK_Media => "Media",
        TK_Namespace => "Namespace",
        TK_Charset => "Charset",
        TK_Important => "Important",
        TK_Percentage => "Percentage",
        TK_Url_ => "Url_",
        TK_UnicodeRange => "UnicodeRange",
        TK_MediaOnly => "MediaOnly",
        TK_Not => "Not",
        TK_And => "And",
        TK_Dimension => "Dimension",
        TK_UnknownDimension => "UnknownDimension",
        TK_Plus => "Plus",
        TK_Minus => "Minus",
        TK_Greater => "Greater",
        TK_Comma => "Comma",
        TK_Tilde => "Tilde",
        TK_PseudoNot => "PseudoNot",
        TK_Number => "Number",
        TK_String_ => "String_",
        TK_PrefixMatch => "PrefixMatch",
        TK_SuffixMatch => "SuffixMatch",
        TK_SubstringMatch => "SubstringMatch",
        TK_FontFace => "FontFace",
        TK_Supports => "Supports",
        TK_Or => "Or",
        TK_Keyframes => "Keyframes",
        TK_From => "From",
        TK_To => "To",
        TK_Calc => "Calc",
        TK_Viewport => "Viewport",
        TK_CounterStyle => "CounterStyle",
        TK_FontFeatureValues => "FontFeatureValues",
        TK_DxImageTransform => "DxImageTransform",
        TK_AtKeyword => "AtKeyword",
        TK_Variable => "Variable",
        TK_Var => "Var",
        TK_Ident => "Ident",
        TK_Function_ => "Function_",
        TK_UnexpectedCharacter => "UnexpectedCharacter",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_SEMI => "TK_LIT_SEMI",
        TK_LIT_LPAREN => "TK_LIT_LPAREN",
        TK_LIT_COLON => "TK_LIT_COLON",
        TK_LIT_RPAREN => "TK_LIT_RPAREN",
        TK_LIT_LBRACE => "TK_LIT_LBRACE",
        TK_LIT_RBRACE => "TK_LIT_RBRACE",
        TK_LIT_STAR => "TK_LIT_STAR",
        TK_LIT_PIPE => "TK_LIT_PIPE",
        TK_LIT_DOT => "TK_LIT_DOT",
        TK_LIT_LBRACKET => "TK_LIT_LBRACKET",
        TK_LIT_EQ => "TK_LIT_EQ",
        TK_LIT_RBRACKET => "TK_LIT_RBRACKET",
        TK_LIT_SLASH => "TK_LIT_SLASH",
        TK_LIT_U5f => "TK_LIT_U5f",
        _ => "Unknown",
    };
}

