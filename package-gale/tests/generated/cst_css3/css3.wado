#![generated(by = "gale", sources = ["tests/grammars/css3Lexer.g4", "tests/grammars/css3Parser.g4"])]

use { TreeMap, TreeSet } from "core:collections";

// Grammar metadata from source .g4 prequels:
//   option tokenVocab = css3Lexer

pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }
}

pub fn push_chars(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    let mut bytes = 0;
    for let mut i = start; i < end; i += 1 {
        bytes += chars[i].len_utf8();
    }
    out.reserve(bytes);
    for let mut i = start; i < end; i += 1 {
        out.push(chars[i]);
    }
}

pub fn chars_text(chars: &List<char>, start: i32, end: i32) -> String {
    let mut s = String::new();
    push_chars(&mut s, chars, start, end);
    return s;
}

pub fn push_chars_escaped(out: &mut String, chars: &List<char>, start: i32, end: i32) {
    for let mut i = start; i < end; i += 1 {
        match chars[i] {
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            c => out.push(c),
        }
    }
}

pub fn kind_set_has(set: &List<i32>, kind: i32) -> bool {
    let w = kind >> 5;
    if w >= set.len() {
        return false;
    }
    return set[w] >> (kind & 31) & 1 == 1;
}

pub fn with_expected<S: AsStrSlice>(message: S, expected: &List<String>) -> String {
    let n = expected.len();
    if n == 0 {
        return message.to_string();
    }
    let mut out = String::with_capacity(n * 8 + message.len() + 11);
    out.push_str("expected ");
    for let mut i = 0; i < n; i += 1 {
        if i > 0 {
            out.push_str(&if i == n - 1 { " or " } else { ", " });
        }
        out.push_str(&expected[i]);
    }
    out.push_str("; ");
    out.push_str(message);
    return out;
}

pub fn char_pos_in_line(chars: &List<char>, i: i32) -> i32 {
    let mut j = if i < chars.len() { i } else { chars.len() };
    let mut col = 0;
    while j > 0 && chars[j - 1] != '\n' {
        col += 1;
        j -= 1;
    }
    return col;
}

pub fn line_starts(chars: &List<char>) -> List<i32> {
    let mut starts: List<i32> = [0];
    for let mut i = 0; i < chars.len(); i += 1 {
        if chars[i] == '\n' {
            starts.push(i + 1);
        }
    }
    return starts;
}

pub fn line_col_at(starts: &List<i32>, pos: i32) -> [i32, i32] {
    let mut lo = 0;
    let mut hi = starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return [lo + 1, pos - starts[lo]];
}

pub flags TokenFlags {
    Synthetic,
    Skipped,
    LexError,
}

pub struct TokenStream {
    pub kinds: List<i32>,
    pub starts: List<i32>,
    pub ends: List<i32>,
    pub triv_lo: List<i32>,
    pub triv_hi: List<i32>,
    pub chars: &List<char>,
    pub triv_kinds: List<i32>,
    pub triv_starts: List<i32>,
    pub triv_ends: List<i32>,
    pub triv_chans: List<i32>,
    pub flags: List<TokenFlags>,
    pub output: String = "",
}

impl TokenStream {
    pub fn new(chars: &List<char>) -> TokenStream {
        let cap = chars.len() / 4 + 1;
        return TokenStream {
            kinds: List::with_capacity(cap),
            starts: List::with_capacity(cap),
            ends: List::with_capacity(cap),
            triv_lo: List::with_capacity(cap),
            triv_hi: List::with_capacity(cap),
            chars,
            triv_kinds: List::with_capacity(cap),
            triv_starts: List::with_capacity(cap),
            triv_ends: List::with_capacity(cap),
            triv_chans: List::with_capacity(cap),
            flags: List::with_capacity(cap),
        };
    }

    pub fn len(&self) -> i32 {
        return self.kinds.len();
    }

    pub fn trivia_mark(&self) -> i32 {
        return self.triv_kinds.len();
    }

    pub fn push_trivia(&mut self, kind: i32, start: i32, end: i32, channel: i32) {
        if self.triv_kinds.len() >= self.triv_kinds.capacity() {
            builtin::cold_path();
            self.triv_kinds.grow();
            self.triv_starts.grow();
            self.triv_ends.grow();
            self.triv_chans.grow();
            assert self.triv_starts.capacity() == self.triv_kinds.capacity()
                && self.triv_ends.capacity() == self.triv_kinds.capacity()
                && self.triv_chans.capacity() == self.triv_kinds.capacity(), "TokenStream trivia columns must grow in lockstep";
        }
        self.triv_kinds.push_within_capacity(kind);
        self.triv_starts.push_within_capacity(start);
        self.triv_ends.push_within_capacity(end);
        self.triv_chans.push_within_capacity(channel);
    }

    pub fn push_token(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32) {
        self.push_token_flagged(kind, start, end, triv_lo, triv_hi, TokenFlags::none());
    }

    pub fn push_token_flagged(
        &mut self,
        kind: i32,
        start: i32,
        end: i32,
        triv_lo: i32,
        triv_hi: i32,
        flags: TokenFlags,
    ) -> i32 {
        let idx = self.kinds.len();
        if idx >= self.kinds.capacity() {
            builtin::cold_path();
            self.kinds.grow();
            self.starts.grow();
            self.ends.grow();
            self.triv_lo.grow();
            self.triv_hi.grow();
            self.flags.grow();
            assert self.starts.capacity() == self.kinds.capacity()
                && self.ends.capacity() == self.kinds.capacity()
                && self.triv_lo.capacity() == self.kinds.capacity()
                && self.triv_hi.capacity() == self.kinds.capacity()
                && self.flags.capacity() == self.kinds.capacity(), "TokenStream token columns must grow in lockstep";
        }
        self.kinds.push_within_capacity(kind);
        self.starts.push_within_capacity(start);
        self.ends.push_within_capacity(end);
        self.triv_lo.push_within_capacity(triv_lo);
        self.triv_hi.push_within_capacity(triv_hi);
        self.flags.push_within_capacity(flags);
        return idx;
    }

    pub fn push_synthetic(&mut self, expected_kind: i32, at: i32) -> i32 {
        let m = self.trivia_mark();
        return self.push_token_flagged(expected_kind, at, at, m, m, TokenFlags::Synthetic);
    }

    pub fn flags_at(&self, i: i32) -> TokenFlags {
        return self.flags[i];
    }

    pub fn set_flag(&mut self, i: i32, flag: TokenFlags) {
        self.flags[i] = self.flags[i] | flag;
    }

    pub fn mark_skipped(&mut self, i: i32) {
        self.set_flag(i, TokenFlags::Skipped);
    }

    pub fn is_synthetic(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Synthetic != TokenFlags::none();
    }

    pub fn is_skipped(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Skipped != TokenFlags::none();
    }

    pub fn is_lex_error(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::LexError != TokenFlags::none();
    }

    pub fn kind_at(&self, i: i32) -> i32 {
        return self.kinds[i];
    }

    pub fn span_at(&self, i: i32) -> Span {
        return Span::new(self.starts[i], self.ends[i]);
    }

    pub fn is_empty_text(&self, i: i32) -> bool {
        return self.starts[i] >= self.ends[i];
    }

    pub fn token_text(&self, i: i32) -> String {
        return chars_text(self.chars, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text(&self, out: &mut String, i: i32) {
        push_chars(out, self.chars, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text_escaped(&self, out: &mut String, i: i32) {
        push_chars_escaped(out, self.chars, self.starts[i], self.ends[i]);
    }

    pub fn rule_text(&self, start_tok: i32, end_tok: i32) -> String {
        let mut out = String::new();
        for let mut i = start_tok; i <= end_tok; i += 1 {
            if i > start_tok {
                for let mut j = self.triv_lo[i]; j < self.triv_hi[i]; j += 1 {
                    if self.triv_chans[j] != 0 {
                        push_chars(&mut out, self.chars, self.triv_starts[j], self.triv_ends[j]);
                    }
                }
            }
            self.push_token_text(&mut out, i);
        }
        return out;
    }
}

pub enum Severity {
    Error,
}

impl Severity {
    pub fn label(&self) -> String {
        return match *self { Error => "error" };
    }
}

pub enum DiagnosticCode {
    UnexpectedToken,
    MissingToken,
    ExtraToken,
    NoViableAlternative,
    UnterminatedConstruct,
    LexError,
}

impl DiagnosticCode {
    pub fn name(&self) -> String {
        return match *self {
            UnexpectedToken => "unexpected-token",
            MissingToken => "missing-token",
            ExtraToken => "extra-token",
            NoViableAlternative => "no-viable-alternative",
            UnterminatedConstruct => "unterminated-construct",
            LexError => "lex-error",
        };
    }
}

pub enum RecoveryAction {
    Inserted,
    Deleted,
    SkippedTo,
    FilledMissing,
    None,
}

pub struct Diagnostic {
    pub severity: Severity = Severity::Error,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub expected: List<i32> = [],
    pub found: i32 = -1,
    pub rule_stack: List<String> = [],
    pub recovery: RecoveryAction = RecoveryAction::None,
}

impl Diagnostic {
    pub fn error<S: AsStrSlice>(
        code: DiagnosticCode,
        message: S,
        span: Span,
        expected: List<i32>,
        found: i32,
        recovery: RecoveryAction,
    ) -> Diagnostic {
        return Diagnostic { code, message: message.to_string(), span, expected, found, recovery };
    }

    pub fn is_error(&self) -> bool {
        return self.severity matches { Error };
    }

    pub fn rule_path(&self) -> String {
        let stack = &self.rule_stack;
        let mut out = String::with_capacity(stack.len() * 8);
        let n = stack.len();
        for let mut i = 0; i < n; i += 1 {
            let name = &stack[n - 1 - i];
            if i > 0 {
                if *name == stack[n - i] {
                    continue;
                }
                out.push_str(" > ");
            }
            out.push_str(name);
        }
        return out;
    }
}

impl Display for Diagnostic {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.severity.label()}[${self.code.name()}] at ${self.line}:${self.col}: ${self.message}`);
    }
}

fn lex_error_at(tokens: &TokenStream, i: i32) -> Diagnostic {
    let mut message = String::from("token recognition error at: '");
    push_chars_escaped(&mut message, tokens.chars, tokens.starts[i], tokens.ends[i]);
    message.push('\'');
    return Diagnostic::error(
        DiagnosticCode::LexError,
        message,
        tokens.span_at(i),
        [],
        tokens.kinds[i],
        RecoveryAction::None,
    );
}

pub fn merge_lex_errors(tokens: &TokenStream, diagnostics: &mut List<Diagnostic>, max_errors: i32) {
    let mut merged: List<Diagnostic> = [];
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.is_lex_error(i) {
            merged.push(lex_error_at(tokens, i));
        }
    }
    merged.extend(diagnostics);
    merged.sort_by(|a: &Diagnostic, b: &Diagnostic| a.span.start.cmp(&b.span.start));
    merged.truncate(max_errors);
    *diagnostics = merged;
}

pub fn resolve_positions(diagnostics: &mut List<Diagnostic>, chars: &List<char>) {
    if diagnostics.is_empty() {
        return;
    }
    let starts = line_starts(chars);
    for let mut i = 0; i < diagnostics.len(); i += 1 {
        let lc = line_col_at(&starts, diagnostics[i].span.start);
        diagnostics[i].line = lc.0;
        diagnostics[i].col = lc.1;
    }
}

pub type NodeKind = i32;

pub global K_ERROR: NodeKind = -1;

pub flags NodeFlags {
    Error,
    Incomplete,
}

pub enum EventTag {
    Open,
    Close,
    Tok,
    Miss,
    Skip,
}

pub struct CstStore {
    pub tag: List<EventTag>,
    pub id: List<i32>,
    pub offset: List<i32>,
    alt: List<i32>,
    end: List<i32>,
    flags: List<NodeFlags>,
    next: List<i32>,
}

pub enum ChildKind {
    Node,
    Token,
    Missing,
    Skipped,
}

impl CstStore {
    pub fn row_count(&self) -> i32 {
        return self.tag.len();
    }

    pub fn kind(&self, i: i32) -> NodeKind {
        return self.id[i] as NodeKind;
    }

    pub fn span(&self, i: i32) -> Span {
        return Span::new(self.offset[i], self.end[i]);
    }

    pub fn alt(&self, i: i32) -> i32 {
        return self.alt[i];
    }

    pub fn is_error(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Error != NodeFlags::none();
    }

    pub fn is_incomplete(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Incomplete != NodeFlags::none();
    }

    pub fn is_node(&self, i: i32) -> bool {
        return self.tag[i] matches { Open };
    }

    pub fn is_token(&self, i: i32) -> bool {
        return self.tag[i] matches { Tok | Miss | Skip };
    }

    pub fn child_kind(&self, i: i32) -> ChildKind {
        return match self.tag[i] {
            Open => ChildKind::Node,
            Miss => ChildKind::Missing,
            Skip => ChildKind::Skipped,
            Tok => ChildKind::Token,
            Close => panic("CstStore::child_kind: Close is not a child row"),
        };
    }

    pub fn token_index(&self, i: i32) -> i32 {
        return self.id[i];
    }

    pub fn first_child(&self, i: i32) -> i32 {
        let c = i + 1;
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn next_sibling(&self, child: i32) -> i32 {
        let c = if self.tag[child] matches { Open } { self.next[child] } else { child + 1 };
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn find_child(&self, i: i32, kind: NodeKind) -> i32 {
        let k = kind as i32;
        for let mut c = self.first_child(i); c >= 0; c = self.next_sibling(c) {
            if self.tag[c] matches { Open } && self.kind(c) as i32 == k {
                return c;
            }
        }
        return -1;
    }

    pub fn to_string_tree(
        &self,
        i: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(256);
        let _ = render_node(&mut out, &self.tag, &self.id, i, toks, rule_names, token_names);
        return out;
    }
}

pub struct ParseResult {
    pub cst: CstStore,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
    pub output: String = "",
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        return self.diagnostics.iter_ref().any(|d| d.is_error());
    }

    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

fn bubble_to_parent(stack: &List<i32>, end: &mut List<i32>, flags: &mut List<NodeFlags>, child: i32) {
    if stack.len() > 0 {
        let parent = stack[stack.len() - 1];
        if end[child] > end[parent] {
            end[parent] = end[child];
        }
        flags[parent] = flags[parent] | flags[child] & NodeFlags::Error;
    }
}

pub struct TreeBuilder {
    tag: List<EventTag>,
    id: List<i32>,
    offset: List<i32>,
    alt: List<i32>,
    open: List<i32>,
    last_finished: i32,
    error_row: i32,
}

impl TreeBuilder {
    pub fn with_capacity(rows: i32) -> TreeBuilder {
        return TreeBuilder {
            tag: List::with_capacity(rows),
            id: List::with_capacity(rows),
            offset: List::with_capacity(rows),
            alt: List::with_capacity(rows),
            open: [],
            last_finished: -1,
            error_row: -1,
        };
    }

    fn push_row(&mut self, tag: EventTag, id: i32, offset: i32) {
        if self.tag.len() >= self.tag.capacity() {
            builtin::cold_path();
            self.tag.grow();
            self.id.grow();
            self.offset.grow();
            self.alt.grow();
            assert self.id.capacity() == self.tag.capacity()
                && self.offset.capacity() == self.tag.capacity()
                && self.alt.capacity() == self.tag.capacity(), "TreeBuilder event columns must grow in lockstep";
        }
        self.tag.push_within_capacity(tag);
        self.id.push_within_capacity(id);
        self.offset.push_within_capacity(offset);
        self.alt.push_within_capacity(-1);
    }

    pub fn start_node(&mut self, kind: NodeKind, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, kind as i32, start);
        self.open.push(row);
    }

    pub fn start_error(&mut self, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, K_ERROR as i32, start);
        self.open.push(row);
    }

    pub fn set_alt(&mut self, alt: i32) {
        self.alt[self.open[self.open.len() - 1]] = alt;
    }

    pub fn checkpoint(&self) -> i32 {
        return self.tag.len();
    }

    pub fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32) {
        assert self.innermost_open() < checkpoint, "a node wraps only rows finished before it";
        self.tag.insert(checkpoint, EventTag::Open);
        self.id.insert(checkpoint, kind as i32);
        self.offset.insert(checkpoint, start);
        self.alt.insert(checkpoint, -1);
        self.open.push(checkpoint);
        if self.last_finished >= checkpoint {
            self.last_finished += 1;
        }
        if self.error_row >= checkpoint {
            self.error_row += 1;
        }
    }

    pub fn truncate(&mut self, checkpoint: i32) {
        self.tag.truncate(checkpoint);
        self.id.truncate(checkpoint);
        self.offset.truncate(checkpoint);
        self.alt.truncate(checkpoint);
        while self.open.len() > 0 && self.open[self.open.len() - 1] >= checkpoint {
            let _ = self.open.pop();
        }
        if self.last_finished >= checkpoint {
            self.last_finished = -1;
        }
        if self.error_row > checkpoint {
            self.error_row = checkpoint;
        }
    }

    pub fn finish_node(&mut self, end: i32) {
        let row = self.open[self.open.len() - 1];
        self.push_row(EventTag::Close, self.id[row], end);
        self.last_finished = row;
        let _ = self.open.pop();
    }

    pub fn innermost_open(&self) -> i32 {
        if self.open.is_empty() {
            return -1;
        }
        return self.open[self.open.len() - 1];
    }

    pub fn node_kind(&self, row: i32) -> NodeKind {
        return self.id[row] as NodeKind;
    }

    pub fn resume_node(&mut self, row: i32, end: i32) {
        while self.innermost_open() > row {
            self.finish_node(end);
        }
        if self.innermost_open() == row {
            return;
        }
        assert self.last_finished == row && self.tag[self.tag.len() - 1] matches { Close }, "resume_node: a node no longer open is the last one closed";
        self.truncate(self.tag.len() - 1);
        self.open.push(row);
    }

    pub fn mark_error(&mut self) {
        self.error_row = self.tag.len();
    }

    pub fn in_error_mode(&self) -> bool {
        if self.error_row < 0 {
            return false;
        }
        for let mut r = self.error_row; r < self.tag.len(); r += 1 {
            if self.tag[r] matches { Tok } {
                return false;
            }
        }
        return true;
    }

    pub fn push_open_rule_names(&self, rule_names: &List<String>, out: &mut List<String>) {
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            let kind = self.id[self.open[i]];
            if kind != K_ERROR as i32 {
                out.push(rule_names[kind]);
            }
        }
    }

    pub fn token(&mut self, idx: i32) {
        self.push_row(EventTag::Tok, idx, 0);
    }

    pub fn missing(&mut self, syn_idx: i32) {
        self.push_row(EventTag::Miss, syn_idx, 0);
    }

    pub fn skip(&mut self, idx: i32) {
        self.push_row(EventTag::Skip, idx, 0);
    }

    pub fn finish(&self) -> CstStore {
        let n = self.tag.len();
        let mut end = List::filled(n, 0);
        let mut flags = List::filled(n, NodeFlags::none());
        let mut next = List::filled(n, 0);
        let mut stack: List<i32> = [];
        for let mut r = 0; r < n; r += 1 {
            match self.tag[r] {
                Open => {
                    if self.id[r] == K_ERROR as i32 {
                        flags[r] = NodeFlags::Error;
                    }
                    end[r] = self.offset[r];
                    stack.push(r);
                },
                Miss => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Incomplete | NodeFlags::Error;
                },
                Skip => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Error;
                },
                Close => {
                    let oi = stack[stack.len() - 1];
                    let _ = stack.pop();
                    if self.offset[r] > end[oi] {
                        end[oi] = self.offset[r];
                    }
                    next[oi] = r + 1;
                    bubble_to_parent(&stack, &mut end, &mut flags, oi);
                },
                Tok => {
                },
            }
        }
        while stack.len() > 0 {
            let oi = stack[stack.len() - 1];
            let _ = stack.pop();
            next[oi] = n;
            bubble_to_parent(&stack, &mut end, &mut flags, oi);
        }
        return CstStore { tag: self.tag, id: self.id, offset: self.offset, alt: self.alt, end, flags, next };
    }

    pub fn render_open(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if self.open.len() == 0 {
            return String::new();
        }
        return self.render_from(self.open[self.open.len() - 1], toks, rule_names, token_names);
    }

    pub fn render_at(
        &self,
        row: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if row < 0 || row >= self.tag.len() || !self.tag[row] matches { Open } {
            return String::new();
        }
        return self.render_from(row, toks, rule_names, token_names);
    }

    pub fn open_rule_names(&self, rule_names: &List<String>) -> String {
        let mut out = String::from("[");
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            if i < self.open.len() - 1 {
                out.push_str(", ");
            }
            let kind = self.id[self.open[i]];
            let name = if kind == K_ERROR as i32 { "<error>" } else { rule_names[kind] };
            out.push_str(&name);
        }
        out.push_str("]");
        return out;
    }

    pub fn render_last_finished(
        &self,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if self.last_finished < 0 {
            return String::new();
        }
        return self.render_from(self.last_finished, toks, rule_names, token_names);
    }

    fn render_from(
        &self,
        root: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(128);
        let _ = render_node(&mut out, &self.tag, &self.id, root, toks, rule_names, token_names);
        return out;
    }
}

fn render_node(
    out: &mut String,
    tag: &List<EventTag>,
    id: &List<i32>,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) -> i32 {
    let name = if id[i] == K_ERROR as i32 { "<error>" } else { rule_names[id[i]] };
    if i + 1 >= tag.len() || tag[i + 1] matches { Close } {
        out.push_str(&name);
        if i + 1 < tag.len() {
            return i + 2;
        }
        return i + 1;
    }
    out.push_str("(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < tag.len() {
        match tag[c] {
            Open => {
                out.push_str(" ");
                c = render_node(out, tag, id, c, toks, rule_names, token_names);
            },
            Close => {
                out.push_str(")");
                return c + 1;
            },
            Tok => {
                if !toks.is_empty_text(id[c]) {
                    out.push_str(" ");
                    toks.push_token_text_escaped(out, id[c]);
                }
                c += 1;
            },
            Miss => {
                out.push_str(` <missing ${token_names[toks.kind_at(id[c])]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(" <skip ");
                toks.push_token_text_escaped(out, id[c]);
                out.push_str(">");
                c += 1;
            },
        }
    }
    out.push_str(")");
    return c;
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let starts = line_starts(tokens.chars);
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &starts,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &starts,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    starts: &List<i32>,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let type_id = if is_eof { -1 } else { kind + 1 };
    let lc = line_col_at(starts, start);
    out.push_str(`[@${index},${start}:${end - 1}='`);
    if is_eof {
        out.push_str("<EOF>");
    } else {
        push_chars_escaped(out, tokens.chars, start, end);
    }
    out.push_str(`',<${type_id}>,`);
    if channel != 0 {
        out.push_str(`channel=${channel},`);
    }
    out.push_str(`${lc.0}:${lc.1}]\n`);
}

pub global FOLLOW_MAX_DEPTH: i32 = 4;

pub global FOLLOW_SLOT_BITS: i64 = 8;

pub global FOLLOW_ID_MASK: i64 = 127;

pub global FOLLOW_OPENS_BIT: i64 = 128;

pub global FOLLOW_CONT_MASK: i64 = 0x00FF_FFFF_FFFF_FFFF;

pub global FOLLOW_SEQUENCED: i64 = 0x007F_7F7F_7F7F_7F7F;

pub fn follow_yields(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    let mut c = cont;
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    while c & FOLLOW_ID_MASK != 0 {
        if c & FOLLOW_OPENS_BIT != 0 {
            if alive && constrained {
                return true;
            }
            depth = 0;
            alive = true;
            constrained = false;
        }
        if depth < FOLLOW_MAX_DEPTH {
            constrained = true;
            if alive {
                let set = &sets[((c & FOLLOW_ID_MASK) - 1) as i32];
                if !set.is_empty() {
                    let idx = pos + depth;
                    let kind = if idx < tokens.len() { tokens[idx] } else { eof_kind };
                    if !kind_set_has(set, kind) {
                        alive = false;
                    }
                }
            }
            depth += 1;
        }
        c = c >> FOLLOW_SLOT_BITS;
    }
    return alive && constrained;
}
pub global ATN_BASIC: i32 = 1;
pub global ATN_RULE_START: i32 = 2;
pub global ATN_RULE_STOP: i32 = 3;
pub global ATN_BLOCK_START: i32 = 4;
pub global ATN_BLOCK_END: i32 = 5;
pub global ATN_STAR_LOOP_ENTRY: i32 = 6;
pub global ATN_STAR_LOOP_BACK: i32 = 7;
pub global ATN_PLUS_LOOP_BACK: i32 = 8;
pub global ATN_LOOP_END: i32 = 9;

pub global ATN_TR_EPSILON: i32 = 0;
pub global ATN_TR_ATOM: i32 = 1;
pub global ATN_TR_NOT_ATOM: i32 = 2;
pub global ATN_TR_WILDCARD: i32 = 3;
pub global ATN_TR_RULE: i32 = 4;
pub global ATN_TR_PRECEDENCE: i32 = 5;

pub struct AtnSim {
    pub state_kind: List<i32>,
    pub state_tr_start: List<i32>,
    pub state_tr_count: List<i32>,
    pub tr_kind: List<i32>,
    pub tr_target: List<i32>,
    pub tr_label: List<i32>,
    pub tr_follow: List<i32>,
    pub tr_prec: List<i32>,
    pub decision_state: List<i32>,
    pub rule_start: List<i32>,
    pub rule_nullable: List<bool> = [],
    pub rule_first: List<List<i32>> = [],
    pub rule_first_neg: List<List<i32>> = [],
    pub rule_first_open: List<bool> = [],
    pub state_cont_nullable: List<bool> = [],
    pub state_cont_first_start: List<i32> = [],
    pub state_cont_first_count: List<i32> = [],
    pub state_cont_neg_start: List<i32> = [],
    pub state_cont_neg_count: List<i32> = [],
    pub cont_first_label: List<i32> = [],
    pub cont_neg_label: List<i32> = [],
    pub state_cont_first_open: List<bool> = [],
    pub state_collapse_to: List<i32> = [],
    pub state_call_prec: List<i32>,
}

fn atn_read_u8(bytes: &ByteList, pos: i32) -> i32 {
    return bytes.get_byte_unchecked(pos) as i32;
}

fn atn_read_u16(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    return b0 | b1 << 8;
}

fn atn_read_u24(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = bytes.get_byte_unchecked(pos) as i32;
    let b1 = bytes.get_byte_unchecked(pos + 1) as i32;
    let b2 = bytes.get_byte_unchecked(pos + 2) as i32;
    return b0 | b1 << 8 | b2 << 16;
}

pub fn atn_decode(bytes: &ByteList) -> AtnSim {
    let mut p = 0;
    let nrules = atn_read_u16(bytes, p);
    p += 2;
    let ndec = atn_read_u16(bytes, p);
    p += 2;
    let nstates = atn_read_u16(bytes, p);
    p += 2;

    let mut rule_start: List<i32> = List::with_capacity(nrules);
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(atn_read_u16(bytes, p));
        p += 2;
    }
    let mut decision_state: List<i32> = List::with_capacity(ndec);
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let mut state_kind: List<i32> = List::with_capacity(nstates);
    for let mut i = 0; i < nstates; i += 1 {
        state_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut state_tr_start: List<i32> = List::with_capacity(nstates);
    let mut state_tr_count: List<i32> = List::with_capacity(nstates);
    let mut ntrans_total = 0;
    for let mut i = 0; i < nstates; i += 1 {
        let count = atn_read_u16(bytes, p);
        p += 2;
        state_tr_start.push(ntrans_total);
        state_tr_count.push(count);
        ntrans_total += count;
    }

    let mut tr_kind: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut tr_target: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_target.push(atn_read_u16(bytes, p) - 1);
        p += 2;
    }
    let mut tr_label: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_label.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_follow: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_follow.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_prec: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_prec.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let mut state_call_prec = List::filled(nstates, 0);
    for let mut j = 0; j < ntrans_total; j += 1 {
        if tr_kind[j] == ATN_TR_RULE {
            assert tr_follow[j] >= 0, "a rule transition returns to a follow state";
            state_call_prec[tr_follow[j]] = tr_prec[j];
        }
    }

    return AtnSim {
        state_kind,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
        state_call_prec,
    };
}

struct LThread {
    state: i32,
    stack: i32,
    accept: bool,
}

struct LatnStacks {
    parent: List<i32>,
    ret: List<i32>,
    ids: TreeMap<i64, i32>,
}

impl LatnStacks {
    fn push(&mut self, parent: i32, ret: i32) -> i32 {
        let key = latn_pair_key(parent, ret);
        if let Some(id) = self.ids.get(key) {
            return id;
        }
        let id = self.parent.len();
        self.parent.push(parent);
        self.ret.push(ret);
        self.ids[key] = id;
        return id;
    }
}

fn latn_pair_key(hi: i32, lo: i32) -> i64 {
    assert hi >= -1 && lo >= -1, "latn keys pair a state or stack id with -1 for none";
    return (hi + 1) as i64 << 32 | (lo + 1) as i64;
}

struct LatnVisited {
    step: i32,
    step_of: List<i32>,
    stack_of: List<i32>,
    more: TreeSet<i64>,
}

impl LatnVisited {
    fn new(nstates: i32) -> LatnVisited {
        return LatnVisited {
            step: 0,
            step_of: List::filled(nstates, -1),
            stack_of: List::filled(nstates, -1),
            more: TreeSet::<i64>::new(),
        };
    }

    fn first_visit(&mut self, state: i32, stack: i32) -> bool {
        if self.step_of[state] != self.step {
            self.step_of[state] = self.step;
            self.stack_of[state] = stack;
            return true;
        }
        if self.stack_of[state] == stack {
            return false;
        }
        return self.more.insert(latn_pair_key(state, stack));
    }

    fn next_step(&mut self) {
        self.step += 1;
        if !self.more.is_empty() {
            self.more.clear();
        }
    }
}

fn latn_closure(
    sim: &AtnSim,
    stacks: &mut LatnStacks,
    out: &mut List<LThread>,
    visited: &mut LatnVisited,
    state: i32,
    stack: i32,
    open: &mut List<i32>,
) {
    if !visited.first_visit(state, stack) {
        return;
    }

    if sim.state_kind[state] == ATN_RULE_STOP {
        if stack < 0 {
            out.push(LThread { state, stack, accept: true });
            return;
        }
        let returned = open.pop();
        latn_closure(sim, stacks, out, visited, stacks.ret[stack], stacks.parent[stack], open);
        if let Some(rule) = returned {
            open.push(rule);
        }
        return;
    }

    let ts = sim.state_tr_start[state];
    let tc = sim.state_tr_count[state];
    if tc > 0 {
        let k0 = sim.tr_kind[ts];
        if k0 == ATN_TR_ATOM || k0 == ATN_TR_NOT_ATOM || k0 == ATN_TR_WILDCARD {
            out.push(LThread { state, stack, accept: false });
            return;
        }
    }
    for let mut i = 0; i < tc; i += 1 {
        let idx = ts + i;
        let target = sim.tr_target[idx];
        if sim.tr_kind[idx] == ATN_TR_RULE {
            if target < 0 || open.contains(&target) {
                continue;
            }
            let pushed = stacks.push(stack, sim.tr_follow[idx]);
            open.push(target);
            latn_closure(sim, stacks, out, visited, target, pushed, open);
            let _ = open.pop();
        } else {
            latn_closure(sim, stacks, out, visited, target, stack, open);
        }
    }
}

pub fn latn_match(sim: &AtnSim, start_rule: i32, chars: &List<char>, start: i32, longest: bool) -> i32 {
    let mut best = -1;
    let mut stacks = LatnStacks { parent: [], ret: [], ids: TreeMap::<i64, i32>::new() };
    let mut open: List<i32> = [];
    let mut visited = LatnVisited::new(sim.state_kind.len());
    let mut clist: List<LThread> = [];
    latn_closure(sim, &mut stacks, &mut clist, &mut visited, sim.rule_start[start_rule], -1, &mut open);

    let mut nlist: List<LThread> = [];
    let mut pos = start;
    loop {
        let cur = if pos < chars.len() { chars[pos] as i32 } else { -1 };
        nlist.clear();
        visited.next_step();
        let mut i = 0;
        let mut stop = false;
        while i < clist.len() && !stop {
            let th = &clist[i];
            if th.accept {
                best = pos;
                stop = !longest;
            } else if cur >= 0 {
                let ts = sim.state_tr_start[th.state];
                let tc = sim.state_tr_count[th.state];
                for let mut j = 0; j < tc; j += 1 {
                    let idx = ts + j;
                    let kind = sim.tr_kind[idx];
                    let matched = if kind == ATN_TR_ATOM {
                        cur >= sim.tr_label[idx] && cur <= sim.tr_follow[idx];
                    } else if kind == ATN_TR_WILDCARD {
                        true;
                    } else if kind == ATN_TR_NOT_ATOM {
                        cur != sim.tr_label[idx];
                    } else {
                        false;
                    };
                    if matched {
                        latn_closure(
                            sim,
                            &mut stacks,
                            &mut nlist,
                            &mut visited,
                            sim.tr_target[idx],
                            th.stack,
                            &mut open,
                        );
                    }
                }
            }
            i += 1;
        }
        if nlist.is_empty() {
            break;
        }
        let spent = clist;
        clist = nlist;
        nlist = spent;
        pos += 1;
    }
    return best;
}
