fn try_UnknownDimension(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    pos = try_Number(chars, pos);
    if pos < 0 { return -1; }
    pos = try_Ident(chars, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn try_Plus(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '+' { return -1; }
    pos += 1;
    return pos;
}

