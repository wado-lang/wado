        pos = rep_saved_2;
        break;
    }
    loop {
        let rep_saved_4 = pos;
        rep_4: {
            if pos >= chars.len() { break rep_4; }
            if (chars[pos] matches { '/' | '*' }) { break rep_4; }
            pos += 1;
            loop {
                let rep_saved_5 = pos;
                rep_5: {
                    if pos >= chars.len() { break rep_5; }
