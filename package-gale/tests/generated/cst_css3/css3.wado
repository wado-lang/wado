fn _parse_feature_value_definition__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.site = 361;
    _parse_ident(p);
    p.site = 362;
    _parse_ws(p, FOLLOW_MASK_17);
    p.expect(TK_Colon, &SYNC_0, false);
    p.site = 363;
    _parse_ws(p, FOLLOW_MASK_29);
    p.site = 364;
    _parse_number(p, follow);
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_68_done: {
                sg_68: {
                    pos = scan_ws(tokens, pos, FOLLOW_MASK_29);
                    if pos < 0 { break sg_68; }
                    pos = scan_number(tokens, pos, follow);
                    if pos < 0 { break sg_68; }
                    break sg_68_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.site = 365;
        _parse_ws(p, FOLLOW_MASK_29);
        p.site = 366;
        _parse_number(p, follow);
    }
    return;
}

