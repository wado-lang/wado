                let peek_save_5 = pos;
                peek_5: {
                    let mut la_end_6: i32 = -1;
                    let mut la_once_6 = false;
                    loop {
                        let mut la_tot_7: i32 = -1;
                        let peek_save_8 = pos;
                        peek_8: {
                            let mut la_end_9: i32 = -1;
                            let mut la_once_9 = false;
                            loop {
                                let mut la_tot_10: i32 = -1;
                                let peek_save_11 = pos;
                                peek_11: {
                                    let mut la_end_12: i32 = -1;
                                    let mut la_once_12 = false;
                                    loop {
                                        let mut la_tot_13: i32 = -1;
                                        let peek_save_14 = pos;
                                        peek_14: {
                                            pos = frag_NewlineOrSpace(src, pos);
                                            if pos < 0 { break peek_14; }
                                            la_tot_13 = pos;
                                        }
                                        pos = peek_save_14;
                                        if la_tot_13 >= 0 && la_tot_13 >= la_end_12 {
                                            la_end_12 = la_tot_13;
                                        }
                                        if la_once_12 { break; }
                                        la_once_12 = true;
                                        let la_saved_12 = pos;
                                        la_rep_12: {
                                            if pos >= src.len() { break la_rep_12; }
                                            if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break la_rep_12; }
                                            pos += 1;
                                            continue;
                                        }
                                        pos = la_saved_12;
                                        break;
                                    }
                                    if la_end_12 < 0 {
                                        break peek_11;
                                    }
                                    pos = la_end_12;
                                    la_tot_10 = pos;
                                }
                                pos = peek_save_11;
                                if la_tot_10 >= 0 && la_tot_10 >= la_end_9 {
                                    la_end_9 = la_tot_10;
                                }
                                if la_once_9 { break; }
                                la_once_9 = true;
                                let la_saved_9 = pos;
                                la_rep_9: {
                                    if pos >= src.len() { break la_rep_9; }
                                    if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break la_rep_9; }
                                    pos += 1;
                                    continue;
                                }
                                pos = la_saved_9;
                                break;
                            }
                            if la_end_9 < 0 {
                                break peek_8;
                            }
                            pos = la_end_9;
                            la_tot_7 = pos;
                        }
                        pos = peek_save_8;
                        if la_tot_7 >= 0 && la_tot_7 >= la_end_6 {
                            la_end_6 = la_tot_7;
                        }
                        if la_once_6 { break; }
                        la_once_6 = true;
                        let la_saved_6 = pos;
                        la_rep_6: {
                            if pos >= src.len() { break la_rep_6; }
                            if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break la_rep_6; }
                            pos += 1;
                            continue;
                        }
                        pos = la_saved_6;
                        break;
                    }
                    if la_end_6 < 0 {
                        break peek_5;
                    }
                    pos = la_end_6;
                    la_tot_4 = pos;
                }
                pos = peek_save_5;
                if la_tot_4 >= 0 && la_tot_4 >= la_end_3 {
                    la_end_3 = la_tot_4;
                }
                if la_once_3 { break; }
                la_once_3 = true;
                let la_saved_3 = pos;
                la_rep_3: {
                    if pos >= src.len() { break la_rep_3; }
                    if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break la_rep_3; }
                    pos += 1;
                    continue;
                }
                pos = la_saved_3;
                break;
            }
            if la_end_3 < 0 {
                break peek_2;
            }
            pos = la_end_3;
            la_tot_1 = pos;
        }
        pos = peek_save_2;
        if la_tot_1 >= 0 && la_tot_1 >= la_end_0 {
            la_end_0 = la_tot_1;
        }
        if la_once_0 { break; }
        la_once_0 = true;
        let la_saved_0 = pos;
        la_rep_0: {
            if pos >= src.len() { break la_rep_0; }
            if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break la_rep_0; }
            pos += 1;
            continue;
        }
        pos = la_saved_0;
        break;
    }
    if la_end_0 < 0 {
        return -1;
    }
    pos = la_end_0;
    return pos;
}

fn classify_keyword(src: &StrSlice, start: i32, end: i32) -> i32 {
    match end - start {
        1 => { if unchecked src.byte_at(start) == b'_' { return TK_Underscore; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(lexer.src);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = char_at(&lexer.src, start);
        let mut best_channel: i32 = 0;
        match first_char {
            '\t' | '\n' | '\u{c}' | '\r' | ' ' => {
                end = try_Space(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Space; best_channel = 0; }
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '\u{b}' | '\u{e}'..='\u{1f}' | '%'..='&' | '?' | 'B'..='E' | 'G'..='M' | 'P'..='S' | 'V'..='Z' | '_'..='`' | 'b' | 'd'..='e' | 'g'..='m' | 'q'..='s' | 'w'..='z' => {
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '!' => {
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\u{8}' | '\u{b}' | '\u{e}'..='\u{1f}' | '!'..='\'' | '(' | ')'..=',' | '-' | '.' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='H' | 'J'..='Z' | '[' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='h' | 'j'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '\t' | ' ' | '/' | 'I' | '\\' | 'i' => {
                        end = try_Important(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Important; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '\n' | '\u{c}' | '\r' => {
                        end = try_Important(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Important; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '"' | '\'' => {
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_String_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_String_; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '#' => {
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '.'..='/' | ':'..='@' | '[' | ']'..='^' | '`' | '{'..='\u{7f}' => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '-' | '0'..='9' | 'A'..='F' | 'G'..='Z' | '\\' | '_' | 'a'..='f' | 'g'..='z' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Hash(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Hash; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '$' => {
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='<' | '>'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '=' => {
                        end = try_SuffixMatch(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_SuffixMatch; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '(' => {
                end = try_OpenParen(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_OpenParen; best_channel = 0; }
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            ')' => {
                end = try_CloseParen(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_CloseParen; best_channel = 0; }
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '*' => {
                end = try_Multiply(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Multiply; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='<' | '>'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '=' => {
                        end = try_SubstringMatch(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_SubstringMatch; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '+' => {
                end = try_Plus(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Plus; best_channel = 0; }
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            ',' => {
                end = try_Comma(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Comma; best_channel = 0; }
                end = try_Ident(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '-' => {
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Minus(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Minus; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '-' => {
                        end = try_Cdc(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Cdc; best_channel = 0; }
                        end = try_Minus(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Minus; best_channel = 0; }
                        end = try_Variable(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Variable; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                        end = try_Minus(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Minus; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                    },
                }
            },
            '.' => {
                end = try_Dot(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_Dot; best_channel = 0; }
                let second_char = char_after(&lexer.src, start);
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='$' | '&'..='\'' | '(' | ')'..=',' | '/' | ':'..='@' | '[' | ']'..='^' | '`' | '{'..='\u{7f}' => {
                        end = try_Dimension(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
                        end = try_Number(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Number; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '%' => {
                        end = try_Percentage(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Percentage; best_channel = 0; }
                        end = try_Dimension(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
                        end = try_Number(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Number; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                        end = try_Function_(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    '-' | 'A'..='F' | 'G'..='Z' | '\\' | '_' | 'a'..='f' | 'g'..='z' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Dimension(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Dimension; best_channel = 0; }
                        end = try_UnknownDimension(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_UnknownDimension; best_channel = 0; }
                        end = try_Number(&lexer.src, start);
                        if end > best_end { best_end = end; best_kind = TK_Number; best_channel = 0; }
                        end = try_Ident(&lexer.src, start);
