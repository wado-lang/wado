fn _parse_calc_value__inner(p: &mut Parser, follow: i64 = 0) -> () {
    if !kind_set_has(&SYNC_0, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_0, &EXPECTED_0); }
    let kind = p.peek_kind();
    if _kind_set_40(kind) {
        if _kind_set_21(kind) {
            if p.peek_at(1) == TK_Number {
                return _parse_calc_value__inner_alt_0(p, follow);
            } else if p.peek_at(1) == TK_Dimension {
                return _parse_calc_value__inner_alt_1(p, follow);
            } else if p.peek_at(1) == TK_UnknownDimension {
                return _parse_calc_value__inner_alt_2(p, follow);
            } else if p.peek_at(1) == TK_Percentage {
                return _parse_calc_value__inner_alt_3(p, follow);
            } else {
                let _sd_tokens = &p.kinds;
                let _sd_pos = p.pos;
                let _sd_p_0 = scan_calc_value_alt_0(_sd_tokens, _sd_pos, follow);
                let _sd_p_1 = scan_calc_value_alt_1(_sd_tokens, _sd_pos, follow);
                let _sd_p_2 = scan_calc_value_alt_2(_sd_tokens, _sd_pos, follow);
                let _sd_p_3 = scan_calc_value_alt_3(_sd_tokens, _sd_pos, follow);
                let mut _sd_best_i: i32 = -1;
                let mut _sd_best_p: i32 = -1;
                if _sd_p_0 > _sd_best_p {
                    _sd_best_p = _sd_p_0;
                    _sd_best_i = 0;
                }
                if _sd_p_1 > _sd_best_p {
                    _sd_best_p = _sd_p_1;
                    _sd_best_i = 1;
                }
                if _sd_p_2 > _sd_best_p {
                    _sd_best_p = _sd_p_2;
                    _sd_best_i = 2;
                }
                if _sd_p_3 > _sd_best_p {
                    _sd_best_p = _sd_p_3;
                    _sd_best_i = 3;
                }
                if _sd_best_i >= 0 {
                    if _sd_best_i == 0 {
                        return _parse_calc_value__inner_alt_0(p, follow);
                    }
                    if _sd_best_i == 1 {
                        return _parse_calc_value__inner_alt_1(p, follow);
                    }
                    if _sd_best_i == 2 {
                        return _parse_calc_value__inner_alt_2(p, follow);
                    }
                    return _parse_calc_value__inner_alt_3(p, follow);
                }
            }
        } else if kind == TK_Number {
            return _parse_calc_value__inner_alt_0(p, follow);
        } else if kind == TK_Dimension {
            return _parse_calc_value__inner_alt_1(p, follow);
        } else if kind == TK_UnknownDimension {
            return _parse_calc_value__inner_alt_2(p, follow);
        } else if kind == TK_Percentage {
            return _parse_calc_value__inner_alt_3(p, follow);
        }
    }
    if kind == TK_OpenParen {
        p.take();
        p.site = 301;
        _parse_ws(p, FOLLOW_MASK_27);
        p.site = 302;
        _parse_calc_sum(p, FOLLOW_MASK_8);
        p.expect(TK_CloseParen, &SYNC_0, true);
        p.site = 303;
        _parse_ws(p, follow);
        return;
    }
    p.no_viable(
        "no alternative of calcValue matches",
        p.peek_span(),
        &EXPECTED_40,
    );
    return;
}

