struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    pending_code: DiagnosticCode,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: &List<i32>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, kind_names(expected), lc.0, lc.1);
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        let take = if let Some(cur) = &self.pending { span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(self.error(message, span, expected));
            self.pending_code = code;
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn report_missing(&mut self, kind: i32, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        let name = token_kind_name(kind);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));
    }

    fn report_unexpected(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail(`got "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), &([kind] as List<i32>), DiagnosticCode::UnexpectedToken);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(self.tokens.span_at(self.pos));
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind, self.tokens.span_at(self.pos));
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(self.tokens.span_at(self.pos));
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &([kind] as List<i32>),
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token; got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !self.in_set(k, excluded) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `unexpected token "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if self.in_set(k, included) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            included,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }
}

fn scan_stylesheet(tokens: &Array<i32>, pos: i32, follow: &List<i32> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_ws(tokens, pos, &EMPTY_FOLLOW);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_Charset {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                pos = scan_charset(tokens, pos, &follow_prepend(&FOLLOW_MASK_0, follow));
                if pos < 0 { break sg_0; }
                while pos < tokens.len() && _kind_set_0(tokens[pos]) {
                    let sp = pos;
                    let gp_1 = pos;
                    let sgk_1 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                    let mut sg_1_best = -1;
                    if sgk_1 == TK_Comment {
                        pos = gp_1;
                        sg_1_0: {
                            if pos >= tokens.len() || tokens[pos] != TK_Comment { break sg_1_0; }
                            pos += 1;
                            if pos > sg_1_best { sg_1_best = pos; }
                        }
                    } else if sgk_1 == TK_Space {
                        pos = gp_1;
                        sg_1_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_Space { break sg_1_1; }
                            pos += 1;
                            if pos > sg_1_best { sg_1_best = pos; }
                        }
                    } else if sgk_1 == TK_Cdo {
                        pos = gp_1;
                        sg_1_2: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdo { break sg_1_2; }
                            pos += 1;
                            if pos > sg_1_best { sg_1_best = pos; }
                        }
                    } else if sgk_1 == TK_Cdc {
                        pos = gp_1;
                        sg_1_3: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdc { break sg_1_3; }
                            pos += 1;
                            if pos > sg_1_best { sg_1_best = pos; }
                        }
                    }
                    if sg_1_best >= 0 {
                        pos = sg_1_best;
                    } else {
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    while pos < tokens.len() && tokens[pos] == TK_Import {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                pos = scan_imports(tokens, pos, &follow_prepend(&FOLLOW_MASK_0, follow));
                if pos < 0 { break sg_2; }
                while pos < tokens.len() && _kind_set_0(tokens[pos]) {
                    let sp = pos;
                    let gp_3 = pos;
                    let sgk_3 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                    let mut sg_3_best = -1;
                    if sgk_3 == TK_Comment {
                        pos = gp_3;
                        sg_3_0: {
                            if pos >= tokens.len() || tokens[pos] != TK_Comment { break sg_3_0; }
                            pos += 1;
                            if pos > sg_3_best { sg_3_best = pos; }
                        }
                    } else if sgk_3 == TK_Space {
                        pos = gp_3;
                        sg_3_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_Space { break sg_3_1; }
                            pos += 1;
                            if pos > sg_3_best { sg_3_best = pos; }
                        }
                    } else if sgk_3 == TK_Cdo {
                        pos = gp_3;
                        sg_3_2: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdo { break sg_3_2; }
                            pos += 1;
                            if pos > sg_3_best { sg_3_best = pos; }
                        }
                    } else if sgk_3 == TK_Cdc {
                        pos = gp_3;
                        sg_3_3: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdc { break sg_3_3; }
                            pos += 1;
                            if pos > sg_3_best { sg_3_best = pos; }
                        }
                    }
                    if sg_3_best >= 0 {
                        pos = sg_3_best;
                    } else {
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    while pos < tokens.len() && tokens[pos] == TK_Namespace {
        let sp = pos;
        sg_4_done: {
            sg_4: {
                pos = scan_namespace_(tokens, pos, &follow_prepend(&FOLLOW_MASK_0, follow));
                if pos < 0 { break sg_4; }
                while pos < tokens.len() && _kind_set_0(tokens[pos]) {
                    let sp = pos;
                    let gp_5 = pos;
                    let sgk_5 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                    let mut sg_5_best = -1;
                    if sgk_5 == TK_Comment {
                        pos = gp_5;
                        sg_5_0: {
                            if pos >= tokens.len() || tokens[pos] != TK_Comment { break sg_5_0; }
                            pos += 1;
                            if pos > sg_5_best { sg_5_best = pos; }
                        }
                    } else if sgk_5 == TK_Space {
                        pos = gp_5;
                        sg_5_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_Space { break sg_5_1; }
                            pos += 1;
                            if pos > sg_5_best { sg_5_best = pos; }
                        }
                    } else if sgk_5 == TK_Cdo {
                        pos = gp_5;
                        sg_5_2: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdo { break sg_5_2; }
                            pos += 1;
                            if pos > sg_5_best { sg_5_best = pos; }
                        }
                    } else if sgk_5 == TK_Cdc {
                        pos = gp_5;
                        sg_5_3: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdc { break sg_5_3; }
                            pos += 1;
                            if pos > sg_5_best { sg_5_best = pos; }
                        }
                    }
                    if sg_5_best >= 0 {
                        pos = sg_5_best;
                    } else {
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                break sg_4_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    while pos < tokens.len() && _kind_set_1(tokens[pos]) {
        let sp = pos;
        sg_6_done: {
            sg_6: {
                pos = scan_nested_statement(tokens, pos, &follow_prepend(&FOLLOW_MASK_0, follow));
                if pos < 0 { break sg_6; }
                while pos < tokens.len() && _kind_set_0(tokens[pos]) {
                    let sp = pos;
                    let gp_7 = pos;
                    let sgk_7 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                    let mut sg_7_best = -1;
                    if sgk_7 == TK_Comment {
                        pos = gp_7;
                        sg_7_0: {
                            if pos >= tokens.len() || tokens[pos] != TK_Comment { break sg_7_0; }
                            pos += 1;
                            if pos > sg_7_best { sg_7_best = pos; }
                        }
                    } else if sgk_7 == TK_Space {
                        pos = gp_7;
                        sg_7_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_Space { break sg_7_1; }
                            pos += 1;
                            if pos > sg_7_best { sg_7_best = pos; }
                        }
                    } else if sgk_7 == TK_Cdo {
                        pos = gp_7;
                        sg_7_2: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdo { break sg_7_2; }
                            pos += 1;
                            if pos > sg_7_best { sg_7_best = pos; }
                        }
                    } else if sgk_7 == TK_Cdc {
                        pos = gp_7;
                        sg_7_3: {
                            if pos >= tokens.len() || tokens[pos] != TK_Cdc { break sg_7_3; }
                            pos += 1;
                            if pos > sg_7_best { sg_7_best = pos; }
                        }
                    }
                    if sg_7_best >= 0 {
                        pos = sg_7_best;
                    } else {
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                break sg_6_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_charset(tokens: &Array<i32>, pos: i32, follow: &List<i32> = &EMPTY_FOLLOW) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_Charset {
            let mut best: i32 = -1;
            pos = start + 1;
            try_0: {
                pos = scan_ws(tokens, pos, &follow_prepend(&FOLLOW_MASK_1, follow));
                if pos < 0 { break try_0; }
                if pos >= tokens.len() || tokens[pos] != TK_String_ { break try_0; }
                pos += 1;
                pos = scan_ws(tokens, pos, &follow_prepend(&FOLLOW_MASK_2, follow));
                if pos < 0 { break try_0; }
