            pos = frag_tail_NewlineOrSpace(chars, pos);
            if pos < 0 { break alts_628_2; }
            break alts_done_628;
        }
        alts_628_3: {
            pos = alts_saved_628;
            if pos >= chars.len() || chars[pos] != '\\' { break alts_628_3; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != 'w' { break alts_628_3; }
            pos += 1;
            break alts_done_628;
        }
        alts_628_4: {
            pos = alts_saved_628;
            if pos >= chars.len() || chars[pos] != '\\' { break alts_628_4; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != 'W' { break alts_628_4; }
            pos += 1;
            break alts_done_628;
        }
        return -1;
    }
    return pos;
}

fn frag_Unicode(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\\' { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' }) { return -1; }
    pos += 1;
    opt_630: {
        if pos >= chars.len() { break opt_630; }
        if !(chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' }) { break opt_630; }
        pos += 1;
    }
    opt_631: {
        if pos >= chars.len() { break opt_631; }
        if !(chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' }) { break opt_631; }
        pos += 1;
    }
    opt_632: {
        if pos >= chars.len() { break opt_632; }
        if !(chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' }) { break opt_632; }
        pos += 1;
    }
    opt_633: {
        if pos >= chars.len() { break opt_633; }
        if !(chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' }) { break opt_633; }
        pos += 1;
    }
    opt_634: {
        if pos >= chars.len() { break opt_634; }
        if !(chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' }) { break opt_634; }
        pos += 1;
    }
    pos = frag_NewlineOrSpace(chars, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn classify_keyword(chars: &List<char>, start: i32, end: i32) -> i32 {
    match end - start {
        1 => { if chars[start] == '_' { return TK_Underscore; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        let mut best_channel: i32 = 0;
        match first_char {
            '\t' | '\n' | '\u{c}' | '\r' | ' ' => {
                end = try_Space(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Space; best_channel = 0; }
                end = try_Ident(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
                    },
                    _ => {
                    },
                }
            },
            '\u{b}' | '\u{e}'..='\u{1f}' | '%'..='&' | '?' | 'B'..='E' | 'G'..='M' | 'P'..='S' | 'V'..='Z' | '_'..='`' | 'b' | 'd'..='e' | 'g'..='m' | 'q'..='s' | 'w'..='z' => {
                end = try_Ident(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_Ident; best_channel = 0; }
                let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                match second_char {
                    '\u{0}'..='\t' | '\u{b}' | '\u{e}'..='\'' | '(' | ')'..=',' | '-' | '.'..='/' | '0'..='9' | ':'..='@' | 'A'..='F' | 'G'..='Z' | '[' | '\\' | ']'..='^' | '_' | '`' | 'a'..='f' | 'g'..='z' | '{'..='\u{7f}' | '\u{80}'..='\u{10ffff}' => {
                        end = try_Function_(&lexer.chars, start);
                        if end > best_end { best_end = end; best_kind = TK_Function_; best_channel = 0; }
