        p.atn_ret_pending = 1685;
        _parse_ws(p, follow_push(FOLLOW_SITE_131, follow));
        if !SYNC_96.has(p.peek_kind()) { builtin::cold_path(); p.sync_enter(&SYNC_96, &EXPECTED_96); }
        if _kind_set_3(p.peek_kind()) {
            p.site = 359;
            p.atn_ret_pending = 1689;
            _parse_feature_value_definition(p, follow_push(FOLLOW_SITE_132, follow));
        }
        if !SYNC_97.has(p.peek_kind()) { builtin::cold_path(); p.sync_back(&SYNC_97, &EXPECTED_97); }
    }
    p.expect(TK_CloseBrace, &SYNC_10, true);
    p.site = 360;
    p.atn_ret_pending = 1694;
    _parse_ws(p, follow);
    return;
