            loop {
                let rep_saved_4 = pos;
                rep_4: {
                    if pos >= chars.len() { break rep_4; }
                    if (chars[pos] matches { '*' }) { break rep_4; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_4;
                break;
            }
            if pos >= chars.len() || chars[pos] != '*' { break rep_3; }
            pos += 1;
            loop {
                let rep_saved_5 = pos;
                rep_5: {
                    if pos >= chars.len() || chars[pos] != '*' { break rep_5; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_5;
                break;
            }
            continue;
        }
        pos = rep_saved_3;
        break;
    }
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    return pos;
}

fn try_Url(chars: &List<char>, start: i32) -> i32 {
    return latn_match(&LATN_SIM, 0, chars, start, true);
}

fn try_Space(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' | '\u{c}' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_7 = pos;
        rep_7: {
            if pos >= chars.len() { break rep_7; }
            if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' | '\u{c}' })) { break rep_7; }
            pos += 1;
            continue;
        }
        pos = rep_saved_7;
        break;
    }
    return pos;
}

