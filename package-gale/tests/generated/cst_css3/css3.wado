fn _parse_ident__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _kind_set_4(kind) {
        let _ = p.expect(kind, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "expected ident",
        p.peek_span(),
        ["TK_Ident", "TK_MediaOnly", "TK_Not", "TK_And", "TK_Or", "TK_From", "TK_To"],
    );
    return;
}

fn _parse_ident(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
