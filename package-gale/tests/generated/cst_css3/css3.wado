fn try_Charset(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '@' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'c' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'h' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'a' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'r' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 's' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'e' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 't' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != ' ' { return -1; }
    pos += 1;
    return pos;
}

fn try_Important(chars: &List<char>, start: i32) -> i32 {
    return latn_match(&LATN_SIM, 12, chars, start, true);
}

fn try_Percentage(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    pos = try_Number(chars, pos);
    if pos < 0 { return -1; }
    if pos >= chars.len() || chars[pos] != '%' { return -1; }
    pos += 1;
    return pos;
}

