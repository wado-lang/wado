global TOKEN_NAMES: List<String> = ["'['", "']'", "'('", "')'", "'{'", "'}'", "';'", "'='", "':'", "'.'", "'*'", "'/'", "'|'", "'_'", "Comment", "Url", "Space", "'<!--'", "'-->'", "'~='", "'|='", "Hash", "Import", "Page", "Media", "Namespace", "'@charset '", "Important", "Percentage", "'url('", "UnicodeRange", "MediaOnly", "Not", "And", "Dimension", "UnknownDimension", "'+'", "'-'", "'>'", "','", "'~'", "PseudoNot", "Number", "String_", "'^='", "'$='", "'*='", "FontFace", "Supports", "Or", "Keyframes", "From", "To", "'calc('", "Viewport", "CounterStyle", "FontFeatureValues", "DxImageTransform", "AtKeyword", "Variable", "'var('", "Ident", "Function_", "UnexpectedCharacter", "Eof", "Error"];

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }
    return String::new();
}

