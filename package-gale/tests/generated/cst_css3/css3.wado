fn _parse_feature_value_definition__inner(p: &mut Parser, follow: i64 = 0) {
    p.site = 361;
    p.atn_ret_pending = 1702;
    _parse_ident(p);
    p.site = 362;
    p.atn_ret_pending = 1704;
    _parse_ws(p, follow_push(FOLLOW_SITE_135, follow));
    p.expect(TK_Colon, &SYNC_86, false);
    p.site = 363;
    p.atn_ret_pending = 1708;
    _parse_ws(p, follow_push(FOLLOW_SITE_136, follow));
    p.site = 364;
    p.atn_ret_pending = 1710;
    _parse_number(p, follow_push(FOLLOW_SITE_137, follow));
    loop {
        if p.recovering { break; }
        let rs_pick_133 = atn_verified(126, 2, &mut p.atn, &p.kinds, p.pos, 0, atn_decide_126(&mut p.atn, &p.kinds, p.pos, 0));
        if rs_pick_133 < 0 && rs_pick_133 != ATN_NOTHING_STARTS { p.no_viable("no viable alternative", p.peek_span(), &NO_EXPECTED); }
        let rs_simulated_133 = rs_pick_133 == 0;
        if !p.recovering && !p.speculating {
            let mut rs_enters = false;
            loop {
                if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_TABLES, TK_EOF) {
                    let mut iter_scan_pos: i32 = -1;
                    iter_scan: {
                        let tokens = &p.kinds;
                        let mut pos: i32 = p.pos;
                        sg_38_done: {
                            sg_38: {
                                p.atn.stack.push(1716);
                                pos = scan_ws(tokens, pos, &mut p.atn, follow_push(FOLLOW_SITE_136, follow));
                                p.atn.stack.pop();
                                if pos < 0 { break sg_38; }
                                pos = scan_number(tokens, pos, &mut p.atn, follow_push(FOLLOW_SITE_137, follow));
                                if pos < 0 { break sg_38; }
                                break sg_38_done;
                            }
                            break iter_scan;
                        }
                        iter_scan_pos = pos;
                    }
                    if iter_scan_pos < 0 || !follow_yields(&p.kinds, iter_scan_pos, follow_push(FOLLOW_SITE_137, follow), &FOLLOW_TABLES, TK_EOF) { break; }
                }
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.kinds;
                    let mut pos: i32 = p.pos;
                    sg_39_done: {
                        sg_39: {
                            p.atn.stack.push(1716);
                            pos = scan_ws(tokens, pos, &mut p.atn, follow_push(FOLLOW_SITE_136, follow));
                            p.atn.stack.pop();
                            if pos < 0 { break sg_39; }
                            pos = scan_number(tokens, pos, &mut p.atn, follow_push(FOLLOW_SITE_137, follow));
                            if pos < 0 { break sg_39; }
                            break sg_39_done;
                        }
                        break rep_scan;
                    }
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
                rs_enters = true;
                break;
            }
            atn_shadow(126, 1, p.pos, if rs_enters { 0 } else { 1 }, if rs_simulated_133 { 0 } else { 1 });
        }
        if !rs_simulated_133 { break; }
        p.site = 365;
        p.atn_ret_pending = 1716;
        _parse_ws(p, follow_push(FOLLOW_SITE_136, follow));
        p.site = 366;
        p.atn_ret_pending = 1718;
        _parse_number(p, follow_push(FOLLOW_SITE_137, follow));
    }
    return;
}

