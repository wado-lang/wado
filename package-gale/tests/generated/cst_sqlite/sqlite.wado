    if p.recovering { let _ = p.recover_rule(RK_TRANSACTION_NAME, "transaction_name", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn _parse_any_name__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_7, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_7, &EXPECTED_7); }
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        p.take();
        return;
    } else if _kind_set_68(kind) {
        p.site = 332;
        p.atn_ret_pending = 3666;
        _parse_keyword(p);
        return;
    } else if kind == TK_STRING_LITERAL {
        p.take();
        return;
    } else if kind == TK_OPEN_PAR {
        p.take();
        p.site = 333;
        p.atn_ret_pending = 3674;
        _parse_any_name(p);
        p.expect(TK_CLOSE_PAR, &EMPTY_SYNC, true);
        return;
    }
    p.no_viable(
        "no alternative of any_name matches",
        p.peek_span(),
        &EXPECTED_7,
    );
    return;
}

fn _parse_any_name(p: &mut Parser) -> () {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_ANY_NAME, _start);
    _parse_any_name__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_ANY_NAME, "any_name", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, &p.tokens.src);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_parse(input, max_errors);
}

pub fn parse_parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_parse(p));
}

