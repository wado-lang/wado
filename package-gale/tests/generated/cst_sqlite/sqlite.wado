fn _parse_any_name__inner(p: &mut Parser) -> () {
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        p.expect(TK_IDENTIFIER, &EMPTY_SYNC);
        return;
    }
    if _kind_set_37(kind) {
        _parse_keyword(p);
        return;
    }
    if kind == TK_STRING_LITERAL {
        p.expect(TK_STRING_LITERAL, &EMPTY_SYNC);
        return;
    }
    if kind == TK_OPEN_PAR {
        p.expect(TK_OPEN_PAR, &SYNC_4);
        _parse_any_name(p);
        p.expect(TK_CLOSE_PAR, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of any_name matches",
        p.peek_span(),
        &SYNC_4,
    );
    return;
}

fn _parse_any_name(p: &mut Parser) -> () {
