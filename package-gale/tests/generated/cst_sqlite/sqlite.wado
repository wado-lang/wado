            if chars[start + 0].eq_ignore_ascii_case(&'r') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'g') && chars[start + 3].eq_ignore_ascii_case(&'h') && chars[start + 4].eq_ignore_ascii_case(&'t') { return TK_K_RIGHT; }
