        } else if chars[start].eq_ignore_ascii_case(&'j') {
            if chars[start + 0].eq_ignore_ascii_case(&'j') && chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'n') { return TK_K_JOIN; }
        } else if chars[start].eq_ignore_ascii_case(&'l') {
            if chars[start + 0].eq_ignore_ascii_case(&'l') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'t') { return TK_K_LEFT; }
            if chars[start + 0].eq_ignore_ascii_case(&'l') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'k') && chars[start + 3].eq_ignore_ascii_case(&'e') { return TK_K_LIKE; }
        } else if chars[start].eq_ignore_ascii_case(&'n') {
            if chars[start + 0].eq_ignore_ascii_case(&'n') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'l') && chars[start + 3].eq_ignore_ascii_case(&'l') { return TK_K_NULL; }
        } else if chars[start].eq_ignore_ascii_case(&'p') {
            if chars[start + 0].eq_ignore_ascii_case(&'p') && chars[start + 1].eq_ignore_ascii_case(&'l') && chars[start + 2].eq_ignore_ascii_case(&'a') && chars[start + 3].eq_ignore_ascii_case(&'n') { return TK_K_PLAN; }
        } else if chars[start].eq_ignore_ascii_case(&'t') {
            if chars[start + 0].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'p') { return TK_K_TEMP; }
            if chars[start + 0].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'h') && chars[start + 2].eq_ignore_ascii_case(&'e') && chars[start + 3].eq_ignore_ascii_case(&'n') { return TK_K_THEN; }
        } else if chars[start].eq_ignore_ascii_case(&'v') {
            if chars[start + 0].eq_ignore_ascii_case(&'v') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'e') && chars[start + 3].eq_ignore_ascii_case(&'w') { return TK_K_VIEW; }
        } else if chars[start].eq_ignore_ascii_case(&'w') {
            if chars[start + 0].eq_ignore_ascii_case(&'w') && chars[start + 1].eq_ignore_ascii_case(&'h') && chars[start + 2].eq_ignore_ascii_case(&'e') && chars[start + 3].eq_ignore_ascii_case(&'n') { return TK_K_WHEN; }
            if chars[start + 0].eq_ignore_ascii_case(&'w') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'h') { return TK_K_WITH; }
        }
    } else if len == 5 {
        if chars[start].eq_ignore_ascii_case(&'a') {
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'b') && chars[start + 2].eq_ignore_ascii_case(&'o') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'t') { return TK_K_ABORT; }
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'f') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') { return TK_K_AFTER; }
            if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'l') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') { return TK_K_ALTER; }
        } else if chars[start].eq_ignore_ascii_case(&'b') {
            if chars[start + 0].eq_ignore_ascii_case(&'b') && chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'g') && chars[start + 3].eq_ignore_ascii_case(&'i') && chars[start + 4].eq_ignore_ascii_case(&'n') { return TK_K_BEGIN; }
        } else if chars[start].eq_ignore_ascii_case(&'c') {
            if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'h') && chars[start + 2].eq_ignore_ascii_case(&'e') && chars[start + 3].eq_ignore_ascii_case(&'c') && chars[start + 4].eq_ignore_ascii_case(&'k') { return TK_K_CHECK; }
            if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'o') && chars[start + 3].eq_ignore_ascii_case(&'s') && chars[start + 4].eq_ignore_ascii_case(&'s') { return TK_K_CROSS; }
        } else if chars[start].eq_ignore_ascii_case(&'g') {
            if chars[start + 0].eq_ignore_ascii_case(&'g') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'o') && chars[start + 3].eq_ignore_ascii_case(&'u') && chars[start + 4].eq_ignore_ascii_case(&'p') { return TK_K_GROUP; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'d') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'x') { return TK_K_INDEX; }
            if chars[start + 0].eq_ignore_ascii_case(&'i') && chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'n') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') { return TK_K_INNER; }
        } else if chars[start].eq_ignore_ascii_case(&'l') {
            if chars[start + 0].eq_ignore_ascii_case(&'l') && chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'i') && chars[start + 4].eq_ignore_ascii_case(&'t') { return TK_K_LIMIT; }
        } else if chars[start].eq_ignore_ascii_case(&'m') {
            if chars[start + 0].eq_ignore_ascii_case(&'m') && chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'c') && chars[start + 4].eq_ignore_ascii_case(&'h') { return TK_K_MATCH; }
        } else if chars[start].eq_ignore_ascii_case(&'o') {
            if chars[start + 0].eq_ignore_ascii_case(&'o') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'d') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') { return TK_K_ORDER; }
            if chars[start + 0].eq_ignore_ascii_case(&'o') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') { return TK_K_OUTER; }
        } else if chars[start].eq_ignore_ascii_case(&'q') {
