pub global RK_DELETE_STMT_LIMITED: NodeKind = 16;
pub global RK_DETACH_STMT: NodeKind = 17;
pub global RK_DROP_INDEX_STMT: NodeKind = 18;
pub global RK_DROP_TABLE_STMT: NodeKind = 19;
pub global RK_DROP_TRIGGER_STMT: NodeKind = 20;
pub global RK_DROP_VIEW_STMT: NodeKind = 21;
pub global RK_FACTORED_SELECT_STMT: NodeKind = 22;
pub global RK_INSERT_STMT: NodeKind = 23;
pub global RK_PRAGMA_STMT: NodeKind = 24;
pub global RK_REINDEX_STMT: NodeKind = 25;
pub global RK_RELEASE_STMT: NodeKind = 26;
pub global RK_ROLLBACK_STMT: NodeKind = 27;
pub global RK_SAVEPOINT_STMT: NodeKind = 28;
pub global RK_SIMPLE_SELECT_STMT: NodeKind = 29;
pub global RK_SELECT_STMT: NodeKind = 30;
pub global RK_SELECT_OR_VALUES: NodeKind = 31;
pub global RK_UPDATE_STMT: NodeKind = 32;
pub global RK_UPDATE_STMT_LIMITED: NodeKind = 33;
