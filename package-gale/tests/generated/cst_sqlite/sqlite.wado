        TK_K_WITHOUT => "K_WITHOUT",
        TK_IDENTIFIER => "IDENTIFIER",
        TK_NUMERIC_LITERAL => "NUMERIC_LITERAL",
        TK_BIND_PARAMETER => "BIND_PARAMETER",
        TK_STRING_LITERAL => "STRING_LITERAL",
        TK_BLOB_LITERAL => "BLOB_LITERAL",
        TK_SINGLE_LINE_COMMENT => "SINGLE_LINE_COMMENT",
        TK_MULTILINE_COMMENT => "MULTILINE_COMMENT",
        TK_SPACES => "SPACES",
        TK_UNEXPECTED_CHAR => "UNEXPECTED_CHAR",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

pub global RK_PARSE: NodeKind = 0;
pub global RK_ERROR: NodeKind = 1;
pub global RK_SQL_STMT_LIST: NodeKind = 2;
pub global RK_SQL_STMT: NodeKind = 3;
pub global RK_ALTER_TABLE_STMT: NodeKind = 4;
pub global RK_ANALYZE_STMT: NodeKind = 5;
pub global RK_ATTACH_STMT: NodeKind = 6;
pub global RK_BEGIN_STMT: NodeKind = 7;
pub global RK_COMMIT_STMT: NodeKind = 8;
pub global RK_COMPOUND_SELECT_STMT: NodeKind = 9;
pub global RK_CREATE_INDEX_STMT: NodeKind = 10;
pub global RK_CREATE_TABLE_STMT: NodeKind = 11;
pub global RK_CREATE_TRIGGER_STMT: NodeKind = 12;
pub global RK_CREATE_VIEW_STMT: NodeKind = 13;
pub global RK_CREATE_VIRTUAL_TABLE_STMT: NodeKind = 14;
