fn _parse_table_alias__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        let identifier = p.expect(TK_IDENTIFIER, &EMPTY_SYNC);
        return;
    }
    if kind == TK_STRING_LITERAL {
        let string_literal = p.expect(TK_STRING_LITERAL, &EMPTY_SYNC);
        return;
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN, &SYNC_63);
        p.atn_ret_pending = 3651;
        let table_alias = _parse_table_alias(p, &FOLLOW_MASK_13);
        let rparen = p.expect(TK_LIT_RPAREN, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "expected table_alias",
        p.peek_span(),
        ["TK_IDENTIFIER", "TK_STRING_LITERAL", "TK_LIT_LPAREN"],
    );
    return;
}

