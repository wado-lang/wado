fn atn_decide_8(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            TK_K_ALTER => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 0);
            },
            TK_K_ANALYZE => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 1);
            },
            TK_K_ATTACH => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 2);
            },
            TK_K_BEGIN => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 3);
            },
            TK_K_COMMIT | TK_K_END => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 4);
            },
            TK_K_CREATE => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        TK_K_INDEX | TK_K_UNIQUE => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 6);
                        },
                        TK_K_TABLE => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 7);
                        },
                        TK_K_TEMP | TK_K_TEMPORARY => {
                            if pos + 2 < tokens.len() {
                                match tokens[pos + 2] {
                                    TK_K_TABLE => {
                                        return atn_verified(8, 2, atn, tokens, pos, min_prec, 7);
                                    },
                                    TK_K_TRIGGER => {
                                        return atn_verified(8, 2, atn, tokens, pos, min_prec, 8);
                                    },
                                    TK_K_VIEW => {
                                        return atn_verified(8, 2, atn, tokens, pos, min_prec, 9);
                                    },
                                    _ => {},
                                };
                            }
                        },
                        TK_K_TRIGGER => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 8);
                        },
                        TK_K_VIEW => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 9);
                        },
                        TK_K_VIRTUAL => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 10);
                        },
                        _ => {},
                    };
                }
            },
            TK_K_DELETE => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        TK_K_FROM => {
                            if pos + 2 < tokens.len() && tokens[pos + 2] < 159 {
                                match tokens[pos + 2] {
                                    TK_SCOL | TK_DOT | TK_OPEN_PAR | TK_CLOSE_PAR | TK_COMMA | TK_ASSIGN | TK_STAR | TK_PLUS | TK_MINUS | TK_TILDE | TK_PIPE2 | TK_DIV | TK_MOD | TK_LT2 | TK_GT2 | TK_AMP | TK_PIPE | TK_LT | TK_LT_EQ | TK_GT | TK_GT_EQ | TK_EQ | TK_NOT_EQ1 | TK_NOT_EQ2 | TK_NUMERIC_LITERAL | TK_BIND_PARAMETER | TK_BLOB_LITERAL | TK_SINGLE_LINE_COMMENT | TK_MULTILINE_COMMENT | TK_SPACES | TK_UNEXPECTED_CHAR | TK_EOF | TK_ERROR => {},
                                    _ => {
                                        if pos + 3 < tokens.len() {
                                            match tokens[pos + 3] {
                                                TK_SCOL | TK_K_ALTER | TK_K_ANALYZE | TK_K_ATTACH | TK_K_BEGIN | TK_K_COMMIT | TK_K_CREATE | TK_K_DELETE | TK_K_DETACH | TK_K_DROP | TK_K_END | TK_K_EXPLAIN | TK_K_INSERT | TK_K_PRAGMA | TK_K_REINDEX | TK_K_RELEASE | TK_K_REPLACE | TK_K_ROLLBACK | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_UPDATE | TK_K_VACUUM | TK_K_VALUES | TK_K_WITH | TK_UNEXPECTED_CHAR => {
                                                    return atn_verified(8, 2, atn, tokens, pos, min_prec, 11);
                                                },
                                                TK_K_LIMIT | TK_K_ORDER => {
                                                    return atn_verified(8, 2, atn, tokens, pos, min_prec, 12);
                                                },
                                                _ => {},
                                            };
                                        }
                                    },
                                };
                            }
                        },
                        _ => {},
                    };
                }
            },
            TK_K_DETACH => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 13);
            },
            TK_K_DROP => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        TK_K_INDEX => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 14);
                        },
                        TK_K_TABLE => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 15);
                        },
                        TK_K_TRIGGER => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 16);
                        },
                        TK_K_VIEW => {
                            return atn_verified(8, 2, atn, tokens, pos, min_prec, 17);
                        },
                        _ => {},
                    };
                }
            },
            TK_K_INSERT | TK_K_REPLACE => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 19);
            },
            TK_K_PRAGMA => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 20);
            },
            TK_K_REINDEX => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 21);
            },
            TK_K_RELEASE => {
                return atn_verified(8, 2, atn, tokens, pos, min_prec, 22);
