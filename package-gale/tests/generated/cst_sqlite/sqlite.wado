            if chars[start + 0].eq_ignore_ascii_case(&'e') && chars[start + 1].eq_ignore_ascii_case(&'x') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'s') && chars[start + 4].eq_ignore_ascii_case(&'t') && chars[start + 5].eq_ignore_ascii_case(&'s') { return TK_K_EXISTS; }
