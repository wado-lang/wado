fn classify_keyword(src: &StrSlice, start: i32, end: i32) -> i32 {
    match end - start {
        2 => {
            match unchecked src.byte_at(start) {
                b'A' | b'a' => { if (unchecked src.byte_at(start + 1)).eq_ignore_ascii_case(&b's') { return TK_K_AS; } },
                b'B' | b'b' => { if (unchecked src.byte_at(start + 1)).eq_ignore_ascii_case(&b'y') { return TK_K_BY; } },
                b'I' | b'i' => {
                    match unchecked src.byte_at(start + 1) {
                        b'F' | b'f' => { return TK_K_IF; },
                        b'N' | b'n' => { return TK_K_IN; },
                        b'S' | b's' => { return TK_K_IS; },
                        _ => {},
                    }
                },
                b'N' | b'n' => { if (unchecked src.byte_at(start + 1)).eq_ignore_ascii_case(&b'o') { return TK_K_NO; } },
                b'O' | b'o' => {
                    match unchecked src.byte_at(start + 1) {
                        b'F' | b'f' => { return TK_K_OF; },
                        b'N' | b'n' => { return TK_K_ON; },
                        b'R' | b'r' => { return TK_K_OR; },
                        _ => {},
                    }
                },
                b'T' | b't' => { if (unchecked src.byte_at(start + 1)).eq_ignore_ascii_case(&b'o') { return TK_K_TO; } },
                _ => {},
            }
        },
        3 => {
            match unchecked src.byte_at(start) {
