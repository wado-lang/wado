            if chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'a') && chars[start + 4].eq_ignore_ascii_case(&'b') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'s') && chars[start + 7].eq_ignore_ascii_case(&'e') { return TK_K_DATABASE; }
            if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'e') && chars[start + 7].eq_ignore_ascii_case(&'d') { return TK_K_DEFERRED; }
            if chars[start + 1].eq_ignore_ascii_case(&'i') && chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_DISTINCT; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'s') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') { return TK_K_RESTRICT; }
            if chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'l') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'b') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'k') { return TK_K_ROLLBACK; }
        }
    } else if len == 9 {
        if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 1].eq_ignore_ascii_case(&'x') && chars[start + 2].eq_ignore_ascii_case(&'c') && chars[start + 3].eq_ignore_ascii_case(&'l') && chars[start + 4].eq_ignore_ascii_case(&'u') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'v') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_EXCLUSIVE; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 1].eq_ignore_ascii_case(&'m') && chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'d') && chars[start + 5].eq_ignore_ascii_case(&'i') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'t') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_IMMEDIATE; }
            if chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'i') && chars[start + 3].eq_ignore_ascii_case(&'t') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'l') && chars[start + 7].eq_ignore_ascii_case(&'l') && chars[start + 8].eq_ignore_ascii_case(&'y') { return TK_K_INITIALLY; }
            if chars[start + 1].eq_ignore_ascii_case(&'n') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'e') && chars[start + 7].eq_ignore_ascii_case(&'c') && chars[start + 8].eq_ignore_ascii_case(&'t') { return TK_K_INTERSECT; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'c') && chars[start + 3].eq_ignore_ascii_case(&'u') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'s') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'v') && chars[start + 8].eq_ignore_ascii_case(&'e') { return TK_K_RECURSIVE; }
        } else if chars[start].eq_ignore_ascii_case(&'s') {
            if chars[start + 1].eq_ignore_ascii_case(&'a') && chars[start + 2].eq_ignore_ascii_case(&'v') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'p') && chars[start + 5].eq_ignore_ascii_case(&'o') && chars[start + 6].eq_ignore_ascii_case(&'i') && chars[start + 7].eq_ignore_ascii_case(&'n') && chars[start + 8].eq_ignore_ascii_case(&'t') { return TK_K_SAVEPOINT; }
        } else if chars[start].eq_ignore_ascii_case(&'t') {
            if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'m') && chars[start + 3].eq_ignore_ascii_case(&'p') && chars[start + 4].eq_ignore_ascii_case(&'o') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'r') && chars[start + 8].eq_ignore_ascii_case(&'y') { return TK_K_TEMPORARY; }
        }
    } else if len == 10 {
        if chars[start].eq_ignore_ascii_case(&'c') {
            if chars[start + 1].eq_ignore_ascii_case(&'o') && chars[start + 2].eq_ignore_ascii_case(&'n') && chars[start + 3].eq_ignore_ascii_case(&'s') && chars[start + 4].eq_ignore_ascii_case(&'t') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'i') && chars[start + 8].eq_ignore_ascii_case(&'n') && chars[start + 9].eq_ignore_ascii_case(&'t') { return TK_K_CONSTRAINT; }
        } else if chars[start].eq_ignore_ascii_case(&'d') {
            if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'r') && chars[start + 6].eq_ignore_ascii_case(&'a') && chars[start + 7].eq_ignore_ascii_case(&'b') && chars[start + 8].eq_ignore_ascii_case(&'l') && chars[start + 9].eq_ignore_ascii_case(&'e') { return TK_K_DEFERRABLE; }
        } else if chars[start].eq_ignore_ascii_case(&'r') {
            if chars[start + 1].eq_ignore_ascii_case(&'e') && chars[start + 2].eq_ignore_ascii_case(&'f') && chars[start + 3].eq_ignore_ascii_case(&'e') && chars[start + 4].eq_ignore_ascii_case(&'r') && chars[start + 5].eq_ignore_ascii_case(&'e') && chars[start + 6].eq_ignore_ascii_case(&'n') && chars[start + 7].eq_ignore_ascii_case(&'c') && chars[start + 8].eq_ignore_ascii_case(&'e') && chars[start + 9].eq_ignore_ascii_case(&'s') { return TK_K_REFERENCES; }
        }
    } else if len == 11 {
        if chars[start + 0].eq_ignore_ascii_case(&'t') && chars[start + 1].eq_ignore_ascii_case(&'r') && chars[start + 2].eq_ignore_ascii_case(&'a') && chars[start + 3].eq_ignore_ascii_case(&'n') && chars[start + 4].eq_ignore_ascii_case(&'s') && chars[start + 5].eq_ignore_ascii_case(&'a') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'t') && chars[start + 8].eq_ignore_ascii_case(&'i') && chars[start + 9].eq_ignore_ascii_case(&'o') && chars[start + 10].eq_ignore_ascii_case(&'n') { return TK_K_TRANSACTION; }
    } else if len == 12 {
        if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' && chars[start + 8].eq_ignore_ascii_case(&'d') && chars[start + 9].eq_ignore_ascii_case(&'a') && chars[start + 10].eq_ignore_ascii_case(&'t') && chars[start + 11].eq_ignore_ascii_case(&'e') { return TK_K_CURRENT_DATE; }
        if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' && chars[start + 8].eq_ignore_ascii_case(&'t') && chars[start + 9].eq_ignore_ascii_case(&'i') && chars[start + 10].eq_ignore_ascii_case(&'m') && chars[start + 11].eq_ignore_ascii_case(&'e') { return TK_K_CURRENT_TIME; }
    } else if len == 13 {
        if chars[start + 0].eq_ignore_ascii_case(&'a') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'t') && chars[start + 3].eq_ignore_ascii_case(&'o') && chars[start + 4].eq_ignore_ascii_case(&'i') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'c') && chars[start + 7].eq_ignore_ascii_case(&'r') && chars[start + 8].eq_ignore_ascii_case(&'e') && chars[start + 9].eq_ignore_ascii_case(&'m') && chars[start + 10].eq_ignore_ascii_case(&'e') && chars[start + 11].eq_ignore_ascii_case(&'n') && chars[start + 12].eq_ignore_ascii_case(&'t') { return TK_K_AUTOINCREMENT; }
    } else if len == 17 {
        if chars[start + 0].eq_ignore_ascii_case(&'c') && chars[start + 1].eq_ignore_ascii_case(&'u') && chars[start + 2].eq_ignore_ascii_case(&'r') && chars[start + 3].eq_ignore_ascii_case(&'r') && chars[start + 4].eq_ignore_ascii_case(&'e') && chars[start + 5].eq_ignore_ascii_case(&'n') && chars[start + 6].eq_ignore_ascii_case(&'t') && chars[start + 7] == '_' && chars[start + 8].eq_ignore_ascii_case(&'t') && chars[start + 9].eq_ignore_ascii_case(&'i') && chars[start + 10].eq_ignore_ascii_case(&'m') && chars[start + 11].eq_ignore_ascii_case(&'e') && chars[start + 12].eq_ignore_ascii_case(&'s') && chars[start + 13].eq_ignore_ascii_case(&'t') && chars[start + 14].eq_ignore_ascii_case(&'a') && chars[start + 15].eq_ignore_ascii_case(&'m') && chars[start + 16].eq_ignore_ascii_case(&'p') { return TK_K_CURRENT_TIMESTAMP; }
    }
    return -1;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        let mut best_channel: i32 = 0;
        if first_char matches { '\t' | '\n' | '\u{b}' | '\r' | ' ' } {
            end = try_SPACES(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SPACES; best_channel = 1; }
        } else if first_char matches { '!' } {
            end = try_NOT_EQ1(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NOT_EQ1; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '"' | '[' | '_' | '`' } {
            end = try_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '$' | ':' | '?' | '@' } {
            end = try_BIND_PARAMETER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BIND_PARAMETER; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '%' } {
            end = try_MOD(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MOD; best_channel = 0; }
        } else if first_char matches { '&' } {
            end = try_AMP(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_AMP; best_channel = 0; }
        } else if first_char matches { '\'' } {
            end = try_STRING_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STRING_LITERAL; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '(' } {
            end = try_OPEN_PAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_OPEN_PAR; best_channel = 0; }
        } else if first_char matches { ')' } {
            end = try_CLOSE_PAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_CLOSE_PAR; best_channel = 0; }
        } else if first_char matches { '*' } {
            end = try_STAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STAR; best_channel = 0; }
        } else if first_char matches { '+' } {
            end = try_PLUS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PLUS; best_channel = 0; }
        } else if first_char matches { ',' } {
            end = try_COMMA(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMA; best_channel = 0; }
        } else if first_char matches { '-' } {
            end = try_MINUS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MINUS; best_channel = 0; }
            end = try_SINGLE_LINE_COMMENT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SINGLE_LINE_COMMENT; best_channel = 1; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '.' } {
            end = try_DOT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DOT; best_channel = 0; }
            end = try_NUMERIC_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '/' } {
            end = try_DIV(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DIV; best_channel = 0; }
            end = try_MULTILINE_COMMENT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MULTILINE_COMMENT; best_channel = 1; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { ';' } {
            end = try_SCOL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCOL; best_channel = 0; }
        } else if first_char matches { '<' } {
            end = try_LT2(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LT2; best_channel = 0; }
            end = try_LT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LT; best_channel = 0; }
            end = try_LT_EQ(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LT_EQ; best_channel = 0; }
            end = try_NOT_EQ2(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NOT_EQ2; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '=' } {
            end = try_ASSIGN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ASSIGN; best_channel = 0; }
            end = try_EQ(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_EQ; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '>' } {
            end = try_GT2(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_GT2; best_channel = 0; }
            end = try_GT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_GT; best_channel = 0; }
            end = try_GT_EQ(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_GT_EQ; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { 'X' | 'x' } {
            end = try_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
            end = try_BLOB_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_BLOB_LITERAL; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '|' } {
            end = try_PIPE2(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PIPE2; best_channel = 0; }
            end = try_PIPE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PIPE; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '~' } {
            end = try_TILDE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TILDE; best_channel = 0; }
        } else if first_char matches { 'a'..='z' | 'A'..='Z' } {
            end = try_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else if first_char matches { '0'..='9' } {
            end = try_NUMERIC_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        } else {
            end = try_IDENTIFIER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_IDENTIFIER; best_channel = 0; }
            end = try_NUMERIC_LITERAL(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMERIC_LITERAL; best_channel = 0; }
            end = try_UNEXPECTED_CHAR(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_UNEXPECTED_CHAR; best_channel = 0; }
        }
        if best_end > start {
            let kw_kind = classify_keyword(&lexer.chars, start, best_end);
            if kw_kind >= 0 { best_kind = kw_kind; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_SCOL => "SCOL",
        TK_DOT => "DOT",
        TK_OPEN_PAR => "OPEN_PAR",
        TK_CLOSE_PAR => "CLOSE_PAR",
        TK_COMMA => "COMMA",
        TK_ASSIGN => "ASSIGN",
        TK_STAR => "STAR",
        TK_PLUS => "PLUS",
        TK_MINUS => "MINUS",
        TK_TILDE => "TILDE",
        TK_PIPE2 => "PIPE2",
        TK_DIV => "DIV",
        TK_MOD => "MOD",
        TK_LT2 => "LT2",
        TK_GT2 => "GT2",
        TK_AMP => "AMP",
        TK_PIPE => "PIPE",
        TK_LT => "LT",
        TK_LT_EQ => "LT_EQ",
        TK_GT => "GT",
        TK_GT_EQ => "GT_EQ",
        TK_EQ => "EQ",
        TK_NOT_EQ1 => "NOT_EQ1",
        TK_NOT_EQ2 => "NOT_EQ2",
        TK_K_ABORT => "K_ABORT",
        TK_K_ACTION => "K_ACTION",
        TK_K_ADD => "K_ADD",
        TK_K_AFTER => "K_AFTER",
        TK_K_ALL => "K_ALL",
        TK_K_ALTER => "K_ALTER",
        TK_K_ANALYZE => "K_ANALYZE",
        TK_K_AND => "K_AND",
        TK_K_AS => "K_AS",
        TK_K_ASC => "K_ASC",
        TK_K_ATTACH => "K_ATTACH",
        TK_K_AUTOINCREMENT => "K_AUTOINCREMENT",
        TK_K_BEFORE => "K_BEFORE",
        TK_K_BEGIN => "K_BEGIN",
