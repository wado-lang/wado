fn atn_lr_decide_180(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32, follow: i64 = 0) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            TK_ASSIGN | TK_EQ | TK_NOT_EQ1 | TK_NOT_EQ2 => {
                if min_prec > 9 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 5; }
            },
            TK_STAR | TK_DIV | TK_MOD => {
                if min_prec > 13 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 1; }
            },
            TK_PLUS | TK_MINUS => {
                if min_prec > 12 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 2; }
            },
            TK_PIPE2 => {
                if min_prec > 14 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 0; }
            },
            TK_LT2 | TK_GT2 | TK_AMP | TK_PIPE => {
                if min_prec > 11 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 3; }
            },
            TK_LT | TK_LT_EQ | TK_GT | TK_GT_EQ => {
                if min_prec > 10 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 4; }
            },
            TK_K_AND => {
                if min_prec > 7 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 7; }
            },
            TK_K_BETWEEN => {
                if min_prec > 1 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 13; }
            },
            TK_K_COLLATE => {
                if min_prec > 5 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 9; }
            },
            TK_K_GLOB | TK_K_LIKE | TK_K_MATCH | TK_K_REGEXP => {
                if min_prec > 4 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 10; }
            },
            TK_K_IN => {
                if min_prec > 8 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 6; }
            },
            TK_K_IS => {
                if min_prec > 2 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 12; }
            },
            TK_K_ISNULL | TK_K_NOTNULL => {
                if min_prec > 3 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 11; }
            },
            TK_K_OR => {
                if min_prec > 6 { return 14; }
                if !follow_admits(tokens, pos, follow, &FOLLOW_SETS, TK_EOF) { return 8; }
            },
            TK_K_NOT => {},
            _ => { return 14; },
        };
    }
    return atn_lr_loop_decision(&ATN_SIM, atn, 180, tokens, pos, TK_EOF, min_prec);
}

