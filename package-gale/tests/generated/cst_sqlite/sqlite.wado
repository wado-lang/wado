        },
        13 => { if (unchecked src.byte_at(start)).eq_ignore_ascii_case(&b'a') && (unchecked src.byte_at(start + 1)).eq_ignore_ascii_case(&b'u') && (unchecked src.byte_at(start + 2)).eq_ignore_ascii_case(&b't') && (unchecked src.byte_at(start + 3)).eq_ignore_ascii_case(&b'o') && (unchecked src.byte_at(start + 4)).eq_ignore_ascii_case(&b'i') && (unchecked src.byte_at(start + 5)).eq_ignore_ascii_case(&b'n') && (unchecked src.byte_at(start + 6)).eq_ignore_ascii_case(&b'c') && (unchecked src.byte_at(start + 7)).eq_ignore_ascii_case(&b'r') && (unchecked src.byte_at(start + 8)).eq_ignore_ascii_case(&b'e') && (unchecked src.byte_at(start + 9)).eq_ignore_ascii_case(&b'm') && (unchecked src.byte_at(start + 10)).eq_ignore_ascii_case(&b'e') && (unchecked src.byte_at(start + 11)).eq_ignore_ascii_case(&b'n') && (unchecked src.byte_at(start + 12)).eq_ignore_ascii_case(&b't') { return TK_K_AUTOINCREMENT; } },
