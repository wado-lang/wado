fn atn_verified(decision: i32, picker: i32, atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32, alt: i32) -> i32 {
    let [simulated, viable] = atn_predict_walk(&mut ATN_DFA, &ATN_SIM, decision, &atn.stack, 0, tokens, pos, TK_EOF, min_prec, &ATN_NO_FALSE_PREDS);
    if viable && simulated != alt {
        let by = match picker {
            0 => "the tournament",
            1 => "the repeat",
            2 => "the lookahead DFA",
            3 => "the LR table",
            4 => "the left-recursion loop",
            _ => unreachable(),
        };
        panic(`atn verify: decision ${decision} at token ${pos}: ${by} picks ${alt}, the simulator ${simulated}`);
    }
    return alt;
}

