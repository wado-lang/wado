struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice with stores[self] {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_SCOL(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ';' { return -1; }
    pos += 1;
    return pos;
}

fn try_DOT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '.' { return -1; }
    pos += 1;
    return pos;
}

fn try_OPEN_PAR(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '(' { return -1; }
    pos += 1;
    return pos;
}

fn try_CLOSE_PAR(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ')' { return -1; }
    pos += 1;
    return pos;
}

fn try_COMMA(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != ',' { return -1; }
    pos += 1;
    return pos;
}

fn try_ASSIGN(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '=' { return -1; }
    pos += 1;
    return pos;
}

fn try_STAR(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '*' { return -1; }
    pos += 1;
    return pos;
}

fn try_PLUS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '+' { return -1; }
    pos += 1;
    return pos;
}

fn try_MINUS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '-' { return -1; }
    pos += 1;
    return pos;
}

fn try_TILDE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '~' { return -1; }
    pos += 1;
    return pos;
}

fn try_PIPE2(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '|' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '|' { return -1; }
    pos += 1;
    return pos;
}

fn try_DIV(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    return pos;
}

fn try_MOD(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '%' { return -1; }
    pos += 1;
    return pos;
}

fn try_LT2(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '<' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '<' { return -1; }
    pos += 1;
    return pos;
}

fn try_GT2(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '>' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '>' { return -1; }
    pos += 1;
    return pos;
}

fn try_AMP(chars: &List<char>, start: i32) -> i32 {
