fn _parse_any_name__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        p.expect(TK_IDENTIFIER, &EMPTY_SYNC);
        return;
    }
    if _kind_set_60(kind) {
        _parse_keyword(p, follow);
        return;
    }
    if kind == TK_STRING_LITERAL {
        p.expect(TK_STRING_LITERAL, &EMPTY_SYNC);
        return;
    }
    if kind == TK_OPEN_PAR {
        p.expect(TK_OPEN_PAR, &SYNC_3);
        _parse_any_name(p, &FOLLOW_MASK_9);
        p.expect(TK_CLOSE_PAR, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of any_name matches",
        p.peek_span(),
        &SYNC_3,
    );
    return;
}

