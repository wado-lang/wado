        TK_K_CURRENT_TIMESTAMP => "K_CURRENT_TIMESTAMP",
        TK_K_DATABASE => "K_DATABASE",
        TK_K_DEFAULT => "K_DEFAULT",
        TK_K_DEFERRABLE => "K_DEFERRABLE",
        TK_K_DEFERRED => "K_DEFERRED",
        TK_K_DELETE => "K_DELETE",
        TK_K_DESC => "K_DESC",
        TK_K_DETACH => "K_DETACH",
        TK_K_DISTINCT => "K_DISTINCT",
        TK_K_DROP => "K_DROP",
        TK_K_EACH => "K_EACH",
        TK_K_ELSE => "K_ELSE",
        TK_K_END => "K_END",
        TK_K_ESCAPE => "K_ESCAPE",
        TK_K_EXCEPT => "K_EXCEPT",
        TK_K_EXCLUSIVE => "K_EXCLUSIVE",
        TK_K_EXISTS => "K_EXISTS",
        TK_K_EXPLAIN => "K_EXPLAIN",
        TK_K_FAIL => "K_FAIL",
        TK_K_FOR => "K_FOR",
