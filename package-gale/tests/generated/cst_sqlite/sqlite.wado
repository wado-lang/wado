fn _parse_table_alias__inner(p: &mut Parser) -> () {
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        p.expect(TK_IDENTIFIER, &EMPTY_SYNC);
        return;
    }
    if kind == TK_STRING_LITERAL {
        p.expect(TK_STRING_LITERAL, &EMPTY_SYNC);
        return;
    }
    if kind == TK_OPEN_PAR {
        p.expect(TK_OPEN_PAR, &SYNC_95);
        _parse_table_alias(p);
        p.expect(TK_CLOSE_PAR, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of table_alias matches",
        p.peek_span(),
        &SYNC_95,
    );
    return;
}

