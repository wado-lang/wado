        TK_K_SELECT => "K_SELECT",
        TK_K_SET => "K_SET",
        TK_K_TABLE => "K_TABLE",
        TK_K_TEMP => "K_TEMP",
        TK_K_TEMPORARY => "K_TEMPORARY",
        TK_K_THEN => "K_THEN",
        TK_K_TO => "K_TO",
        TK_K_TRANSACTION => "K_TRANSACTION",
        TK_K_TRIGGER => "K_TRIGGER",
        TK_K_UNION => "K_UNION",
        TK_K_UNIQUE => "K_UNIQUE",
        TK_K_UPDATE => "K_UPDATE",
        TK_K_USING => "K_USING",
        TK_K_VACUUM => "K_VACUUM",
        TK_K_VALUES => "K_VALUES",
        TK_K_VIEW => "K_VIEW",
        TK_K_VIRTUAL => "K_VIRTUAL",
        TK_K_WHEN => "K_WHEN",
        TK_K_WHERE => "K_WHERE",
        TK_K_WITH => "K_WITH",
        TK_K_WITHOUT => "K_WITHOUT",
        TK_IDENTIFIER => "IDENTIFIER",
        TK_NUMERIC_LITERAL => "NUMERIC_LITERAL",
        TK_BIND_PARAMETER => "BIND_PARAMETER",
        TK_STRING_LITERAL => "STRING_LITERAL",
        TK_BLOB_LITERAL => "BLOB_LITERAL",
        TK_SINGLE_LINE_COMMENT => "SINGLE_LINE_COMMENT",
        TK_MULTILINE_COMMENT => "MULTILINE_COMMENT",
        TK_SPACES => "SPACES",
        TK_UNEXPECTED_CHAR => "UNEXPECTED_CHAR",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

pub global RK_PARSE: NodeKind = 0;
pub global RK_ERROR: NodeKind = 1;
pub global RK_SQL_STMT_LIST: NodeKind = 2;
pub global RK_SQL_STMT: NodeKind = 3;
pub global RK_ALTER_TABLE_STMT: NodeKind = 4;
pub global RK_ANALYZE_STMT: NodeKind = 5;
pub global RK_ATTACH_STMT: NodeKind = 6;
pub global RK_BEGIN_STMT: NodeKind = 7;
pub global RK_COMMIT_STMT: NodeKind = 8;
pub global RK_COMPOUND_SELECT_STMT: NodeKind = 9;
pub global RK_CREATE_INDEX_STMT: NodeKind = 10;
pub global RK_CREATE_TABLE_STMT: NodeKind = 11;
pub global RK_CREATE_TRIGGER_STMT: NodeKind = 12;
pub global RK_CREATE_VIEW_STMT: NodeKind = 13;
pub global RK_CREATE_VIRTUAL_TABLE_STMT: NodeKind = 14;
pub global RK_DELETE_STMT: NodeKind = 15;
pub global RK_DELETE_STMT_LIMITED: NodeKind = 16;
pub global RK_DETACH_STMT: NodeKind = 17;
pub global RK_DROP_INDEX_STMT: NodeKind = 18;
pub global RK_DROP_TABLE_STMT: NodeKind = 19;
pub global RK_DROP_TRIGGER_STMT: NodeKind = 20;
pub global RK_DROP_VIEW_STMT: NodeKind = 21;
pub global RK_FACTORED_SELECT_STMT: NodeKind = 22;
pub global RK_INSERT_STMT: NodeKind = 23;
pub global RK_PRAGMA_STMT: NodeKind = 24;
pub global RK_REINDEX_STMT: NodeKind = 25;
pub global RK_RELEASE_STMT: NodeKind = 26;
pub global RK_ROLLBACK_STMT: NodeKind = 27;
pub global RK_SAVEPOINT_STMT: NodeKind = 28;
pub global RK_SIMPLE_SELECT_STMT: NodeKind = 29;
pub global RK_SELECT_STMT: NodeKind = 30;
pub global RK_SELECT_OR_VALUES: NodeKind = 31;
pub global RK_UPDATE_STMT: NodeKind = 32;
pub global RK_UPDATE_STMT_LIMITED: NodeKind = 33;
