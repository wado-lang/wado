fn _parse_table_alias__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_117, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_117, &EXPECTED_117); }
    let kind = p.peek_kind();
    if _kind_set_65(kind) {
        p.take();
        return;
    } else if kind == TK_OPEN_PAR {
        p.take();
        p.site = 330;
        p.atn_ret_pending = 2734;
        _parse_table_alias(p);
        p.expect(TK_CLOSE_PAR, &EMPTY_SYNC, true);
        return;
    }
    p.no_viable(
        "no alternative of table_alias matches",
        p.peek_span(),
        &EXPECTED_117,
    );
    return;
}

fn _parse_table_alias(p: &mut Parser) -> () {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_TABLE_ALIAS, _start);
    _parse_table_alias__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_TABLE_ALIAS, "table_alias", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

