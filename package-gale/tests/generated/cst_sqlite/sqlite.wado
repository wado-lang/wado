fn _parse_sql_stmt(p: &mut Parser, follow: i64 = 0) -> () {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_SQL_STMT, _start);
    _parse_sql_stmt__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_SQL_STMT, "sql_stmt", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

