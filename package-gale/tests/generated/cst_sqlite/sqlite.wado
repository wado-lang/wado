pub fn to_string_tree(result: &ParseResult) -> String {
    let mut token_names: List<String> = List::with_capacity(183);
    for let mut k = 0; k < 183; k += 1 {
        token_names.push(token_kind_name(k));
    }
    return result.root.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut token_names: List<String> = List::with_capacity(183);
    for let mut k = 0; k < 183; k += 1 {
        token_names.push(token_kind_name(k));
    }
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if let Some(sub) = result.root.find_child(_kind as NodeKind) {
        return sub.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_K_ALTER | TK_K_ANALYZE | TK_K_ATTACH | TK_K_BEGIN | TK_K_COMMIT | TK_K_CREATE | TK_K_DELETE | TK_K_DETACH | TK_K_DROP | TK_K_END | TK_K_EXPLAIN | TK_K_INSERT | TK_K_PRAGMA | TK_K_REINDEX | TK_K_RELEASE | TK_K_REPLACE | TK_K_ROLLBACK | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_UPDATE | TK_K_VACUUM | TK_K_VALUES | TK_K_WITH | TK_LIT_SEMI };
}

