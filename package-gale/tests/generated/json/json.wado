fn try_lit_comma(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ',' { return -1; }
    return pos + 1;
}

fn try_lit_rbrace(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '}' { return -1; }
    return pos + 1;
}

fn try_lit_colon(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ':' { return -1; }
    return pos + 1;
}

fn try_lit_lbracket(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '[' { return -1; }
    return pos + 1;
}

fn try_lit_rbracket(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ']' { return -1; }
    return pos + 1;
}

fn try_lit_true(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 't' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'r' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'u' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'e' { return -1; }
    return pos + 4;
}

fn try_lit_false(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'f' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'a' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'l' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 's' { return -1; }
    if pos + 4 >= chars.len() || chars[pos + 4] != 'e' { return -1; }
    return pos + 5;
}

fn try_lit_null(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'n' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'u' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'l' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'l' { return -1; }
    return pos + 4;
}

pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = [];
    let mut trivia: Array<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '"' {
            end = try_string(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STRING; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == ',' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_COMMA; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == ':' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_COLON; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == '[' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LBRACKET; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == ']' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_RBRACKET; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == 'f' {
            end = try_lit_false(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_FALSE; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == 'n' {
            end = try_lit_null(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_NULL; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == 't' {
            end = try_lit_true(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_TRUE; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == '{' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_LBRACE; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else if first_char == '}' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_RBRACE; }
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        } else {
            end = try_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_STRING => "STRING",
        TK_NUMBER => "NUMBER",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_LBRACE => "TK_LIT_LBRACE",
        TK_LIT_COMMA => "TK_LIT_COMMA",
        TK_LIT_RBRACE => "TK_LIT_RBRACE",
        TK_LIT_COLON => "TK_LIT_COLON",
        TK_LIT_LBRACKET => "TK_LIT_LBRACKET",
        TK_LIT_RBRACKET => "TK_LIT_RBRACKET",
        TK_LIT_TRUE => "TK_LIT_TRUE",
        TK_LIT_FALSE => "TK_LIT_FALSE",
        TK_LIT_NULL => "TK_LIT_NULL",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: Array<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }
}

fn scan_json(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_value(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_obj(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LIT_LBRACE {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACE { break try_0; }
                pos += 1;
                pos = scan_pair(tokens, pos, 0);
                if pos < 0 { break try_0; }
                while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
                    let sp = pos;
                    sg_0_done: {
                        sg_0: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_0; }
                            pos += 1;
                            pos = scan_pair(tokens, pos, 0);
                            if pos < 0 { break sg_0; }
                            break sg_0_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACE { break try_0; }
                pos += 1;
                break scan_alts;
            }
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACE { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACE { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_pair(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_STRING { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COLON { return -1; }
    pos += 1;
    pos = scan_value(tokens, pos, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_arr(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LIT_LBRACKET {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { break try_0; }
                pos += 1;
                pos = scan_value(tokens, pos, 0);
                if pos < 0 { break try_0; }
                while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
                    let sp = pos;
                    sg_1_done: {
                        sg_1: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_1; }
                            pos += 1;
                            pos = scan_value(tokens, pos, 0);
                            if pos < 0 { break sg_1; }
                            break sg_1_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { break try_0; }
                pos += 1;
                break scan_alts;
            }
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_value(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_STRING {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_STRING { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_NUMBER {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_NUMBER { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LBRACE {
            pos = start;
            try_2: {
                pos = scan_obj(tokens, pos, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LBRACKET {
            pos = start;
            try_3: {
                pos = scan_arr(tokens, pos, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_TRUE {
            pos = start;
            try_4: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_TRUE { break try_4; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_FALSE {
            pos = start;
            try_5: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_FALSE { break try_5; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_NULL {
            pos = start;
            try_6: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_NULL { break try_6; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn parse_json(p: &mut Parser) -> Result<JsonNode, ParseError> {
    let start = p.peek().span.start;
    let value = parse_value(p)?;
    let eof = p.expect(TK_EOF)?;
    return Result::<JsonNode, ParseError>::Ok(JsonNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        value,
        eof,
    });
}

fn parse_obj_bt_0(p: &mut Parser) -> Result<ObjNode, ParseError> {
    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let pair = parse_pair(p)?;
    let mut comma_pair_list: Array<CommaPairItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
            pos += 1;
            pos = scan_pair(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        let pair = parse_pair(p)?;
        let comma_pair = CommaPairItem {
            comma,
            pair,
        };
        comma_pair_list.push(comma_pair);
    }
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<ObjNode, ParseError>::Ok(ObjNode::Alt0(ObjAlt0 {
        span: Span::new(start, i32::max(start, p.last_end())),
        lbrace,
        pair,
        comma_pair_list,
        rbrace,
    }));
}

fn parse_obj_scan_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACE { return -1; }
    pos += 1;
    pos = scan_pair(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_2; }
                pos += 1;
                pos = scan_pair(tokens, pos, 0);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACE { return -1; }
    pos += 1;
    return pos;
}

fn parse_obj_bt_1(p: &mut Parser) -> Result<ObjNode, ParseError> {
    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<ObjNode, ParseError>::Ok(ObjNode::Alt1(ObjAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        lbrace,
        rbrace,
    }));
}

fn parse_obj_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACE { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACE { return -1; }
    pos += 1;
    return pos;
}

fn parse_obj(p: &mut Parser) -> Result<ObjNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_LBRACE {
        let lbrace = p.expect(TK_LIT_LBRACE)?;
        if p.peek_kind() == TK_STRING {
            let pair = parse_pair(p)?;
            let mut comma_pair_list: Array<CommaPairItem> = [];
            loop {
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                    pos += 1;
                    pos = scan_pair(tokens, pos, 0);
                    if pos < 0 { break rep_scan; }
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
                let comma = p.expect(TK_LIT_COMMA)?;
                let pair = parse_pair(p)?;
                let comma_pair = CommaPairItem {
                    comma,
                    pair,
                };
                comma_pair_list.push(comma_pair);
            }
            let rbrace = p.expect(TK_LIT_RBRACE)?;
            return Result::<ObjNode, ParseError>::Ok(ObjNode::Alt0(ObjAlt0 {
                span: Span::new(start, i32::max(start, p.last_end())),
                lbrace,
                pair,
                comma_pair_list,
                rbrace,
            }));
        } else if p.peek_kind() == TK_LIT_RBRACE {
            let rbrace = p.expect(TK_LIT_RBRACE)?;
            return Result::<ObjNode, ParseError>::Ok(ObjNode::Alt1(ObjAlt1 {
                span: Span::new(start, i32::max(start, p.last_end())),
                lbrace,
                rbrace,
            }));
        }
    }
    return Result::<ObjNode, ParseError>::Err(ParseError::new(
        "expected obj",
        p.peek().span,
        ["TK_LIT_LBRACE"],
    ));
}

fn parse_pair(p: &mut Parser) -> Result<PairNode, ParseError> {
    let start = p.peek().span.start;
    let string = p.expect(TK_STRING)?;
    let colon = p.expect(TK_LIT_COLON)?;
    let value = parse_value(p)?;
    return Result::<PairNode, ParseError>::Ok(PairNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        string,
        colon,
        value,
    });
}

fn parse_arr_bt_0(p: &mut Parser) -> Result<ArrNode, ParseError> {
    let start = p.peek().span.start;
    let lbracket = p.expect(TK_LIT_LBRACKET)?;
    let value = parse_value(p)?;
    let mut comma_value_list: Array<CommaValueItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
            pos += 1;
            pos = scan_value(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        let value = parse_value(p)?;
        let comma_value = CommaValueItem {
            comma,
            value,
        };
        comma_value_list.push(comma_value);
    }
    let rbracket = p.expect(TK_LIT_RBRACKET)?;
    return Result::<ArrNode, ParseError>::Ok(ArrNode::Alt0(ArrAlt0 {
        span: Span::new(start, i32::max(start, p.last_end())),
        lbracket,
        value,
        comma_value_list,
        rbracket,
    }));
}

fn parse_arr_scan_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    pos = scan_value(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
        let sp = pos;
        sg_3_done: {
            sg_3: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_3; }
                pos += 1;
                pos = scan_value(tokens, pos, 0);
                if pos < 0 { break sg_3; }
                break sg_3_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn parse_arr_bt_1(p: &mut Parser) -> Result<ArrNode, ParseError> {
    let start = p.peek().span.start;
    let lbracket = p.expect(TK_LIT_LBRACKET)?;
    let rbracket = p.expect(TK_LIT_RBRACKET)?;
    return Result::<ArrNode, ParseError>::Ok(ArrNode::Alt1(ArrAlt1 {
        span: Span::new(start, i32::max(start, p.last_end())),
        lbracket,
        rbracket,
    }));
}

fn parse_arr_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn parse_arr(p: &mut Parser) -> Result<ArrNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_LBRACKET {
        let lbracket = p.expect(TK_LIT_LBRACKET)?;
        if _gale_kind_set_0(p.peek_kind()) {
            let value = parse_value(p)?;
            let mut comma_value_list: Array<CommaValueItem> = [];
            loop {
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                    pos += 1;
                    pos = scan_value(tokens, pos, 0);
                    if pos < 0 { break rep_scan; }
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
                let comma = p.expect(TK_LIT_COMMA)?;
                let value = parse_value(p)?;
                let comma_value = CommaValueItem {
                    comma,
                    value,
                };
                comma_value_list.push(comma_value);
            }
            let rbracket = p.expect(TK_LIT_RBRACKET)?;
            return Result::<ArrNode, ParseError>::Ok(ArrNode::Alt0(ArrAlt0 {
                span: Span::new(start, i32::max(start, p.last_end())),
                lbracket,
                value,
                comma_value_list,
                rbracket,
            }));
        } else if p.peek_kind() == TK_LIT_RBRACKET {
            let rbracket = p.expect(TK_LIT_RBRACKET)?;
            return Result::<ArrNode, ParseError>::Ok(ArrNode::Alt1(ArrAlt1 {
                span: Span::new(start, i32::max(start, p.last_end())),
                lbracket,
                rbracket,
            }));
        }
    }
    return Result::<ArrNode, ParseError>::Err(ParseError::new(
        "expected arr",
        p.peek().span,
        ["TK_LIT_LBRACKET"],
    ));
}

fn parse_value(p: &mut Parser) -> Result<ValueNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_STRING {
        let string = p.expect(TK_STRING)?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt0(ValueAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            string,
        }));
    }
    if kind == TK_NUMBER {
        let number = p.expect(TK_NUMBER)?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt1(ValueAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            number,
        }));
    }
    if kind == TK_LIT_LBRACE {
        let obj = parse_obj(p)?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt2(ValueAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            obj,
        }));
    }
    if kind == TK_LIT_LBRACKET {
        let arr = parse_arr(p)?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt3(ValueAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            arr,
        }));
    }
    if kind == TK_LIT_TRUE {
        let lit_true = p.expect(TK_LIT_TRUE)?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt4(ValueAlt4 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lit_true,
        }));
    }
    if kind == TK_LIT_FALSE {
        let lit_false = p.expect(TK_LIT_FALSE)?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt5(ValueAlt5 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lit_false,
        }));
    }
    if kind == TK_LIT_NULL {
        let lit_null = p.expect(TK_LIT_NULL)?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt6(ValueAlt6 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lit_null,
        }));
    }
    return Result::<ValueNode, ParseError>::Err(ParseError::new(
        "expected value",
        p.peek().span,
        ["TK_STRING", "TK_NUMBER", "TK_LIT_LBRACE", "TK_LIT_LBRACKET", "TK_LIT_TRUE", "TK_LIT_FALSE", "TK_LIT_NULL"],
    ));
}

pub fn parse(input: &String) -> Result<JsonNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_json(&mut parser);
}

pub fn walk_json<V: Visitor>(v: &mut V, node: &JsonNode) {
    v.enter_rule(&"json", &node.span);
    walk_value(v, &node.value);
    v.visit_token(&node.eof);
    v.exit_rule(&"json", &node.span);
}

pub fn walk_obj<V: Visitor>(v: &mut V, node: &ObjNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"obj", &n.span);
            v.visit_token(&n.lbrace);
            walk_pair(v, &n.pair);
            for let item of &n.comma_pair_list {
                v.visit_token(&item.comma);
                walk_pair(v, &item.pair);
            }
            v.visit_token(&n.rbrace);
            v.exit_rule(&"obj", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"obj", &n.span);
            v.visit_token(&n.lbrace);
            v.visit_token(&n.rbrace);
            v.exit_rule(&"obj", &n.span);
        }
    }
}

pub fn walk_pair<V: Visitor>(v: &mut V, node: &PairNode) {
    v.enter_rule(&"pair", &node.span);
    v.visit_token(&node.string);
    v.visit_token(&node.colon);
    walk_value(v, &node.value);
    v.exit_rule(&"pair", &node.span);
}

pub fn walk_arr<V: Visitor>(v: &mut V, node: &ArrNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"arr", &n.span);
            v.visit_token(&n.lbracket);
            walk_value(v, &n.value);
            for let item of &n.comma_value_list {
                v.visit_token(&item.comma);
                walk_value(v, &item.value);
            }
            v.visit_token(&n.rbracket);
            v.exit_rule(&"arr", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"arr", &n.span);
            v.visit_token(&n.lbracket);
            v.visit_token(&n.rbracket);
            v.exit_rule(&"arr", &n.span);
        }
    }
}

pub fn walk_value<V: Visitor>(v: &mut V, node: &ValueNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"value", &n.span);
            v.visit_token(&n.string);
            v.exit_rule(&"value", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"value", &n.span);
            v.visit_token(&n.number);
            v.exit_rule(&"value", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"value", &n.span);
            walk_obj(v, &n.obj);
            v.exit_rule(&"value", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"value", &n.span);
            walk_arr(v, &n.arr);
            v.exit_rule(&"value", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"value", &n.span);
            v.visit_token(&n.lit_true);
            v.exit_rule(&"value", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"value", &n.span);
            v.visit_token(&n.lit_false);
            v.exit_rule(&"value", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"value", &n.span);
            v.visit_token(&n.lit_null);
            v.exit_rule(&"value", &n.span);
        }
    }
}

pub fn to_tree(node: &JsonNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_json(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_FALSE | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_NULL | TK_LIT_TRUE | TK_NUMBER | TK_STRING };
}

