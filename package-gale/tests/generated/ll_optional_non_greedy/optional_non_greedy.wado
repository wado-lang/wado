//! Core lexing vocabulary shared by every generated parser and by Gale's
//! own front end: source spans, lazy token-text slices, tokens, and the
//! parse-error type. Prelude-only and self-contained so it can be both
//! imported as a module (by Gale's `token`/`lexer`/`parser`/`ir`) and
//! `#include_str`'d verbatim into generated parsers.

/// Span represents a byte range in source text.
pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn merge(&self, other: &Span) -> Span {
        let start = if self.start < other.start { self.start } else { other.start };
        let end = if self.end > other.end { self.end } else { other.end };
        return Span { start, end };
    }
}

impl Eq for Span {
    fn eq(&self, other: &Self) -> bool {
        return self.start == other.start && self.end == other.end;
    }
}

/// LexerSlice is a lazy reference to a range of characters in the source input.
/// It avoids allocating a String for every token during tokenization.
pub struct LexerSlice {
    pub chars: &List<char>,
    pub start: i32,
    pub end: i32,
}

impl LexerSlice {
    pub fn new(chars: &List<char>, start: i32, end: i32) -> LexerSlice with stores[chars] {
        return LexerSlice { chars, start, end };
    }

    pub fn empty(chars: &List<char>) -> LexerSlice with stores[chars] {
        return LexerSlice { chars, start: 0, end: 0 };
    }

    pub fn from_string(s: String) -> LexerSlice {
        let chars = s.chars().collect();
        return LexerSlice { chars: &chars, start: 0, end: chars.len() };
    }

    pub fn is_empty(&self) -> bool {
        return self.start >= self.end;
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn push_to(&self, out: &mut String) {
        for let mut i = self.start; i < self.end; i += 1 {
            out.push(self.chars[i]);
        }
    }

    pub fn to_string(&self) -> String {
        let mut s = String::with_capacity(self.end - self.start);
        self.push_to(&mut s);
        return s;
    }

    pub fn eq_str(a: &String, b: &LexerSlice) -> bool {
        let a_chars = a.chars();
        let mut a_iter = a_chars;
        let mut i = b.start;
        loop {
            let a_next = a_iter.next();
            if i >= b.end {
                return a_next matches { None };
            }
            if let Some(ac) = a_next {
                if ac != b.chars[i] {
                    return false;
                }
            } else {
                return false;
            }
            i += 1;
        }
    }
}

impl Display for LexerSlice {
    fn fmt(&self, f: &mut Formatter) {
        for let mut i = self.start; i < self.end; i += 1 {
            f.write_char(self.chars[i]);
        }
    }
}

impl Eq for LexerSlice {
    fn eq(&self, other: &Self) -> bool {
        let len = self.end - self.start;
        if len != other.end - other.start {
            return false;
        }
        for let mut i = 0; i < len; i += 1 {
            if self.chars[self.start + i] != other.chars[other.start + i] {
                return false;
            }
        }
        return true;
    }
}

/// Token represents a lexed token with its kind, text, and position.
/// Leading trivia (whitespace, comments) is attached to each token.
/// `channel` is the ANTLR4 channel id (0 = default, 1 = HIDDEN; named
/// channels resolve to integer ids declared in the grammar).
pub struct Token {
    pub kind: i32,
    pub text: LexerSlice,
    pub span: Span,
    pub leading_trivia: List<Token>,
    pub channel: i32,
}

impl Token {
    pub fn new(kind: i32, text: LexerSlice, span: Span) -> Token {
        return Token { kind, text, span, leading_trivia: [], channel: 0 };
    }

    pub fn with_trivia(kind: i32, text: LexerSlice, span: Span, leading_trivia: List<Token>) -> Token {
        return Token { kind, text, span, leading_trivia, channel: 0 };
    }

    pub fn with_channel(kind: i32, text: LexerSlice, span: Span, leading_trivia: List<Token>, channel: i32) -> Token {
        return Token { kind, text, span, leading_trivia, channel };
    }
}

// Note: Token Eq is intentionally omitted. Auto-derived Eq on recursive structs
// with reference-containing fields triggers a compiler bug
// (see wado-compiler/tests/fixtures/recursive_struct_ref_eq.wado).

/// ParseError represents a parse failure with location and expected tokens.
///
/// `message` is the local "expected X, got Y" description, kept free of
/// position and rule context so it stays composable. `line`/`col` are a
/// 1-based line and 0-based column (ANTLR4 `Token` convention) resolved
/// from `span.start` against the source at error-construction time;
/// `Parser::error` fills them in. `rule_stack` records the chain of parser
/// rules that were active when the error was raised, innermost first — each
/// rule entry wrapper pushes its own name as the `Err` propagates outward,
/// so the last element is the start rule and the first is the rule the
/// failing token sat in. The `Display` impl renders all of this into a
/// human-readable diagnostic.
pub struct ParseError {
    pub message: String,
    pub span: Span,
    pub expected: List<String>,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub rule_stack: List<String> = [],
}

impl ParseError {
    pub fn new(message: String, span: Span, expected: List<String>) -> ParseError {
        return ParseError { message, span, expected };
    }

    /// Construct a ParseError whose position is already resolved. Used by
    /// `Parser::error`, which has the source on hand to compute line/col.
    pub fn at(message: String, span: Span, expected: List<String>, line: i32, col: i32) -> ParseError {
        return ParseError { message, span, expected, line, col, rule_stack: [] };
    }

    /// Render the rule chain as `outer > ... > inner` (start rule first).
    /// `rule_stack` is stored innermost-first, so iterate it in reverse.
    /// Consecutive duplicates are collapsed: a left-recursive rule re-enters
    /// itself once per precedence level, which would otherwise print
    /// `expr > expr > expr` for a deep expression.
    pub fn rule_path(&self) -> String {
        let mut out = String::with_capacity(self.rule_stack.len() * 8);
        let n = self.rule_stack.len();
        let mut written = 0;
        for let mut i = 0; i < n; i += 1 {
            let name = &self.rule_stack[n - 1 - i];
            if written > 0 && *name == self.rule_stack[n - i] {
                continue;
            }
            if written > 0 {
                out.push_str(&" > ");
            }
            out.push_str(name);
            written += 1;
        }
        return out;
    }
}

impl Display for ParseError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&`parse error at {self.line}:{self.col}: {self.message}`);
        if !self.rule_stack.is_empty() {
            f.write_str(&`\n  in rule: {self.rule_path()}`);
        }
    }
}
//! Generic (untyped) concrete syntax tree, the `Visitor` trait every
//! generated walker drives, and the `TreeRecorder` that materialises a
//! `CstNode` tree from a walk (`to_tree`). Always emitted into generated
//! parsers. Imports its lexing vocabulary from `lex.wado`; that import is
//! stripped at `#include_str` time (see `gen_runtime` in `codegen.wado`),
//! where `lex.wado` is concatenated first.


/// CstChild is either a terminal token or a non-terminal sub-tree.
pub variant CstChild {
    Token(Token),
    Node(CstNode),
}

/// CstNode is a generic (untyped) concrete syntax tree node.
pub struct CstNode {
    pub name: String,
    pub span: Span,
    pub children: List<CstChild>,
}

impl CstNode {
    /// Produce an ANTLR4-style S-expression representation of this tree.
    /// Rule nodes become `(name child1 child2 ...)`, tokens become their text.
    /// Tokens with empty text (e.g. EOF) are omitted.
    pub fn to_string_tree(&self) -> String {
        let mut out = String::with_capacity(256);
        cst_to_string_tree_impl(&mut out, self);
        return out;
    }
}

fn cst_to_string_tree_impl(out: &mut String, node: &CstNode) {
    out.push_str(&`({node.name}`);
    for let child of &node.children {
        if let Token(t) = *child {
            if !t.text.is_empty() {
                out.push_str(&` {t.text}`);
            }
        } else if let Node(n) = *child {
            out.push_str(&" ");
            cst_to_string_tree_impl(out, &n);
        }
    }
    out.push_str(&")");
}

/// Visitor trait for walking typed CST nodes.
/// Default methods are no-ops; override to add behavior.
///
/// `rule_id` is the parser-rule's index in the grammar's parser_rules array
/// (0..n in declaration order). It's passed alongside `name` so visitors
/// that want cheap dispatch (HighlightVisitor's rule stack) can avoid
/// String compares while visitors that care about the name (TreeRecorder)
/// can still use it.
pub trait Visitor {
    fn enter_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
    }
    fn exit_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
    }
    fn visit_token(&mut self, token: &Token) {
    }
}

/// TreeRecorder is a Visitor that records events for building a CstNode tree.
pub struct TreeRecorder {
    events: List<TreeEvent>,
}

variant TreeEvent {
    Enter(TreeEnterInfo),
    Exit,
    VisitToken(Token),
}

struct TreeEnterInfo {
    name: String,
    span: Span,
}

impl TreeRecorder {
    pub fn new() -> TreeRecorder {
        return TreeRecorder { events: [] };
    }

    pub fn build(&self) -> CstNode {
        let mut pos = 0;
        return tree_build_node(&self.events, &mut pos);
    }
}

impl Visitor for TreeRecorder {
    fn enter_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
        self.events.push(TreeEvent::Enter(TreeEnterInfo { name: *name, span: *span }));
    }

    fn exit_rule(&mut self, rule_id: i32, name: &String, span: &Span) {
        self.events.push(TreeEvent::Exit);
    }

    fn visit_token(&mut self, token: &Token) {
        self.events.push(TreeEvent::VisitToken(*token));
    }
}

fn tree_build_node(events: &List<TreeEvent>, pos: &mut i32) -> CstNode {
    if let Enter(info) = events[*pos] {
        *pos += 1;
        let mut children: List<CstChild> = [];
        loop {
            if *pos >= events.len() {
                break;
            }
            let ev = events[*pos];
            if let Exit = ev {
                *pos += 1;
                break;
            }
            if let Enter(_) = ev {
                children.push(CstChild::Node(tree_build_node(events, pos)));
            } else if let VisitToken(t) = ev {
                children.push(CstChild::Token(t));
                *pos += 1;
            }
        }
        return CstNode { name: info.name, span: info.span, children };
    }
    panic("TreeRecorder: expected Enter event");
    return CstNode { name: "", span: Span::new(0, 0), children: [] };
}
//! Consumer-facing tree / token utilities exposed by every generated
//! parser: S-expression normalisation, child-node lookup, and the
//! ANTLR4-format token-stream dump used by the compatibility suite. Always
//! emitted. The generated parser code never calls these itself; consumers
//! (driver tests, the ANTLR4-compat suite) import them from the generated
//! module. The
//! `./lex.wado` / `./cst.wado` imports are stripped at `#include_str` time.


/// Normalize a multi-line S-expression string for comparison.
/// Collapses whitespace runs to single spaces and trims, while preserving
/// whitespace inside double-quoted strings.
pub fn normalize_tree(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    let mut in_string = false;
    let mut space_pending = false;
    for let c of s.chars() {
        if in_string {
            out.push(c);
            if c == '"' {
                in_string = false;
            }
        } else if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            if out.len() > 0 {
                space_pending = true;
            }
        } else {
            if space_pending {
                out.push(' ');
                space_pending = false;
            }
            if c == '"' {
                in_string = true;
            }
            out.push(c);
        }
    }
    return out;
}

/// Find the first direct child Node of `parent` whose rule name equals
/// `name`. Returns `None` when no such child exists.
///
/// Used by Stage B sub-tree drivers: many ANTLR4 descriptors print a
/// labelled sub-tree (`@after { <ToStringTree("$r.ctx"):writeln()> }`)
/// rather than the start rule's full tree. Gale's `parse()` always
/// returns the full tree, so the test must navigate down to the
/// referenced child before comparing.
pub fn find_first_child_node(parent: &CstNode, name: &String) -> Option<CstNode> {
    for let child of &parent.children {
        if let Node(n) = *child {
            if n.name == *name {
                return Option::<CstNode>::Some(n);
            }
        }
    }
    return null;
}

/// Produce an ANTLR4-style `Token.toString()` dump of the token stream:
///
///   [@<idx>,<start>:<end>='<text>',<<type>>,<line>:<col>]\n  (per token)
///
/// Used by Stage L (token-stream equivalence) tests against the upstream
/// `LexerExec` / etc. `[output]` blocks.
///
/// - `tokens` is the public-channel stream returned by the generated
///   `tokenize(input)`. Skip-channel tokens never reach this array, so no
///   filtering is needed here.
/// - `input` is the original source; passed in so line/col can be
///   computed from byte offsets (Gale's `Token` does not carry these).
/// - `eof_kind` is the value of the generated `TK_EOF` constant; EOF
///   tokens print as `<EOF>` text with type id `-1`.
///
/// Type IDs are remapped from Gale's 0-based numbering to ANTLR4's
/// 1-based: `kind + 1` for explicit lexer rules, `-1` for EOF. Lexer-only
/// grammars never introduce implicit literals, so the contiguous
/// `0..num_lexer_rules` range maps directly onto ANTLR4's
/// `1..num_lexer_rules+1`.
///
/// Text escaping follows `CommonToken.toString` (`vendor/antlr4/runtime/
/// Java/src/org/antlr/v4/runtime/CommonToken.java`): only `\n`, `\r`,
/// `\t` are escaped; backslashes and quotes pass through unchanged.
pub fn to_lexer_string(tokens: &List<Token>, input: &String, eof_kind: i32) -> String {
    let chars: List<char> = input.chars().collect();
    let mut out = String::with_capacity(tokens.len() * 32);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let tok = &tokens[i];
        // Non-default-channel tokens (e.g. `-> channel(HIDDEN)`) are invisible
        // to the parser, so the generated tokenizer parks them in the next
        // token's `leading_trivia` alongside skip tokens. ANTLR4 still emits
        // them into the token dump in source order with a `channel=N`
        // attribute and a sequential index, so interleave them ahead of their
        // host token. Skip tokens carry channel 0 and are discarded entirely —
        // they neither print nor advance the index (matching ANTLR4's
        // `Lexer.skip()`).
        for let tr of &tok.leading_trivia {
            if tr.channel != 0 {
                emit_lexer_token(&mut out, tr, &chars, index, eof_kind);
                index += 1;
            }
        }
        emit_lexer_token(&mut out, tok, &chars, index, eof_kind);
        index += 1;
    }
    return out;
}

/// Renders a single token in ANTLR4's `CommonToken.toString` format, used by
/// `to_lexer_string` for both main-stream tokens and interleaved
/// non-default-channel trivia. `channel=N` is printed only for non-default
/// channels, matching ANTLR4.
fn emit_lexer_token(out: &mut String, tok: &Token, chars: &List<char>, index: i32, eof_kind: i32) {
    let is_eof = tok.kind == eof_kind;
    let mut text_buf = String::with_capacity(16);
    if is_eof {
        text_buf.push_str(&"<EOF>");
    } else {
        for let mut j = tok.text.start; j < tok.text.end; j += 1 {
            let c = tok.text.chars[j];
            match c {
                '\n' => text_buf.push_str(&"\\n"),
                '\r' => text_buf.push_str(&"\\r"),
                '\t' => text_buf.push_str(&"\\t"),
                _ => text_buf.push(c),
            }
        }
    }
    let type_id = if is_eof { -1 } else { tok.kind + 1 };
    let line_col = line_col_at(chars, tok.span.start);
    let line = line_col.0;
    let col = line_col.1;
    let end_inclusive = tok.span.end - 1;
    let channel_attr = if tok.channel != 0 { `channel={tok.channel},` } else { String::from("") };
    out.push_str(&`[@{index},{tok.span.start}:{end_inclusive}='{text_buf}',<{type_id}>,{channel_attr}{line}:{col}]\n`);
}

/// Compute (line, column) at a 0-based char index in `chars`, with
/// 1-based line and 0-based column to match ANTLR4's `Token` getters.
fn line_col_at(chars: &List<char>, pos: i32) -> [i32, i32] {
    let mut line = 1;
    let mut col = 0;
    let cap = if pos < chars.len() { pos } else { chars.len() };
    for let mut i = 0; i < cap; i += 1 {
        if chars[i] == '\n' {
            line += 1;
            col = 0;
        } else {
            col += 1;
        }
    }
    return [line, col];
}
//! Runtime FOLLOW-continuation gate for tail-greedy loops. Emitted into a
//! generated parser only when lowering constructed a caller-FOLLOW gate
//! (`GenContext::emit_follow`); gate-free grammars carry none of this. The
//! `./lex.wado` import is stripped at `#include_str` time.


/// `follow` is the caller's deterministic K-prefix continuation:
/// `follow[d]` is the set of token kinds that may appear at input depth
/// `d` if control belongs to the caller rather than to another iteration
/// of the loop. An empty `follow` (the common, non-repair case) disables
/// the gate. The loop yields to the caller — breaking `*`/`+` or skipping
/// `?` — exactly when EVERY non-empty depth-set matches the upcoming
/// input, i.e. when the next tokens are unambiguously the caller's
/// continuation.
///
/// Threaded as a defaulted `&EMPTY_FOLLOW` argument through the generated
/// `parse_*` / `scan_*` functions; repair call sites pass a `FOLLOW_MASK_*`
/// constant (or forward their own `follow`). This replaces the previous
/// per-(rule, mask) cloned `__follow_<id>` variants: the mask is data
/// carried at runtime, not code baked into a specialised function.
///
/// `eof_kind` is the token kind reported past the end of the stream, so a
/// caller continuation ending in EOF gates correctly. Used by both the
/// parse side (`tokens = &p.tokens`, `pos = p.pos`) and the scan side
/// (raw `tokens` / `pos`), keeping the longest-match tournament's view in
/// lockstep with parse.
pub global EMPTY_FOLLOW: List<List<i32>> = [];

/// Prepend a static local prefix to an inherited FOLLOW continuation.
/// Used for the `FollowArg::Combined` case: a callee at the current
/// rule's tail whose preceding local suffix is nullable, so its
/// continuation is `prefix` (the optional local elements' per-depth
/// first sets) followed by the caller's own `follow`. Bounded by
/// `FOLLOW_MASK_MAX_K` so the result stays small; the only
/// allocating point on a repaired path (the common Static/Forward
/// cases pass a reference directly).
pub fn follow_prepend(prefix: &List<List<i32>>, follow: &List<List<i32>>) -> List<List<i32>> {
    let mut combined: List<List<i32>> = [];
    for let depth of prefix {
        combined.push(*depth);
    }
    for let depth of follow {
        combined.push(*depth);
    }
    return combined;
}

pub fn follow_yields(tokens: &List<Token>, pos: i32, follow: &List<List<i32>>, eof_kind: i32) -> bool {
    if follow.is_empty() {
        return false;
    }
    for let mut d = 0; d < follow.len(); d += 1 {
        let set = &follow[d];
        if set.is_empty() {
            // No constraint at this depth — a vacuous match, keep going.
            continue;
        }
        let idx = pos + d;
        let kind = if idx < tokens.len() { tokens[idx].kind } else { eof_kind };
        let mut hit = false;
        for let t of set {
            if kind == *t {
                hit = true;
                break;
            }
        }
        if !hit {
            return false;
        }
    }
    return true;
}
//! Runtime ATN simulator (hybrid ALL(*)) — full-context SLL prediction.
//!
//! Emitted into a generated parser only when lowering saw a construct that
//! needs it (`GenContext::needs_atn`, today a non-greedy `??`). The
//! compiled fast path handles everything else, so this never runs on the
//! hot path.
//!
//! Full context without a per-call-site GIR<->ATN mapping: the caller passes
//! its current *rule-invocation stack* (a list of rule indices, cheaply
//! maintained by the rule-entry wrapper). When a config exhausts a rule it
//! branches into every ATN return-state where the caller rule invokes the
//! callee (rule-context precision). The bottom of a real stack is the start
//! rule, whose follow is EOF — so a config that returns past it accepts only
//! EOF (`ATN_ACCEPT_EOF`), not any token. An empty stack falls back to plain
//! SLL (rule-stop = wildcard follow).
//!
//! Clean-room: follows the published ALL(*) description, not ANTLR4 sources
//! (License hygiene, AGENTS.md). The wire-format constants below are the
//! single source of truth; the builder/serializer in `src/atn.wado` `use`s
//! them. The blob carries a version word `atn_decode` asserts.
//!
//! The `./lex.wado` import is stripped at `#include_str` time (see
//! `gen_runtime` in `codegen.wado`); `src/atn.wado` imports these symbols
//! as a normal module.


// ATN wire-format constants — the single source of truth for the serialized
// blob layout, shared by the builder/serializer in `src/atn.wado` (which
// `use`s these) and the decoder/simulator below. They live here, not in
// `atn.wado`, because this runtime is `#include_str`'d verbatim into every
// generated parser and so cannot import from the compiler crate — whereas
// the compiler crate is free to `use` the runtime. Bump `ATN_BLOB_VERSION`
// on any layout change so a stale committed blob fails loudly.
pub global ATN_BLOB_MAGIC: i32 = 0x47_41_54_4e;
pub global ATN_BLOB_VERSION: i32 = 1;

// State kinds. `atn_decode` copies every state's kind through verbatim and
// the simulator only interprets `RULE_STOP` / `BLOCK_START` / `BLOCK_END`,
// but the builder writes the full enumeration, so the whole set lives here
// to keep one numbering authority (no split-numbering hazard across files).
pub global ATN_BASIC: i32 = 1;
pub global ATN_RULE_START: i32 = 2;
pub global ATN_RULE_STOP: i32 = 3;
pub global ATN_BLOCK_START: i32 = 4;
pub global ATN_BLOCK_END: i32 = 5;
pub global ATN_STAR_LOOP_ENTRY: i32 = 6;
pub global ATN_STAR_LOOP_BACK: i32 = 7;
pub global ATN_PLUS_LOOP_BACK: i32 = 8;
pub global ATN_LOOP_END: i32 = 9;

// Transition kinds. `label`/`follow`/`prec` carry kind-specific data
// (see `AtnTransition` in `atn.wado`).
pub global ATN_TR_EPSILON: i32 = 0;
pub global ATN_TR_ATOM: i32 = 1;
pub global ATN_TR_NOT_ATOM: i32 = 2;
pub global ATN_TR_WILDCARD: i32 = 3;
pub global ATN_TR_RULE: i32 = 4;

/// Sentinel "state": a config that has returned past the real stack bottom
/// and is viable only if the next token is EOF (the start rule's follow).
#[allow(dead_code)]
global ATN_ACCEPT_EOF: i32 = -2;

/// Bounds that keep a pathological closure (deep recursion, config blow-up)
/// from looping forever. On overflow the predictor bails to the lowest
/// viable alt — the same conservative answer it gives on a true conflict.
#[allow(dead_code)]
global ATN_MAX_STACK: i32 = 64;
#[allow(dead_code)]
global ATN_MAX_CONFIGS: i32 = 6000;

/// The decoded ATN, in struct-of-arrays form. Built once per parser from
/// the serialized blob and read (never mutated) during prediction.
pub struct AtnSim {
    pub state_kind: List<i32>,
    pub state_rule: List<i32>,
    pub state_decision: List<i32>,
    pub state_tr_start: List<i32>,
    pub state_tr_count: List<i32>,
    pub tr_kind: List<i32>,
    pub tr_src: List<i32>,
    pub tr_target: List<i32>,
    pub tr_label: List<i32>,
    pub tr_follow: List<i32>,
    pub tr_prec: List<i32>,
    pub decision_state: List<i32>,
    pub rule_start: List<i32>,
    pub rule_stop: List<i32>,
    pub num_tokens: i32,
}

/// One ATN configuration. `stack` is the precise return-state stack for
/// rules entered *during* this prediction; `rs` indexes the caller's
/// pre-existing rule-invocation stack (the next outer frame to return into,
/// or -1 once exhausted / for SLL).
struct AtnConfig {
    state: i32,
    alt: i32,
    stack: List<i32>,
    rs: i32,
}

/// Decode the serialized ATN blob into `AtnSim`. Mirrors the layout of
/// `atn.wado::serialize_atn`.
#[allow(dead_code)]
pub fn atn_decode(data: &List<i32>) -> AtnSim {
    let mut p = 0;
    let magic = data[p]; p += 1;
    let version = data[p]; p += 1;
    assert magic == ATN_BLOB_MAGIC, `ATN blob magic mismatch: {magic}`;
    assert version == ATN_BLOB_VERSION, `ATN blob version mismatch: {version}`;
    let num_tokens = data[p]; p += 1;

    let nrules = data[p]; p += 1;
    let mut rule_start: List<i32> = [];
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(data[p]); p += 1;
    }
    let mut rule_stop: List<i32> = [];
    for let mut i = 0; i < nrules; i += 1 {
        rule_stop.push(data[p]); p += 1;
    }
    let ndec = data[p]; p += 1;
    let mut decision_state: List<i32> = [];
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(data[p]); p += 1;
    }

    let nstates = data[p]; p += 1;
    let mut state_kind: List<i32> = [];
    let mut state_rule: List<i32> = [];
    let mut state_decision: List<i32> = [];
    let mut state_tr_start: List<i32> = [];
    let mut state_tr_count: List<i32> = [];
    let mut tr_kind: List<i32> = [];
    let mut tr_src: List<i32> = [];
    let mut tr_target: List<i32> = [];
    let mut tr_label: List<i32> = [];
    let mut tr_follow: List<i32> = [];
    let mut tr_prec: List<i32> = [];
    for let mut i = 0; i < nstates; i += 1 {
        let kind = data[p]; p += 1;
        let rule = data[p]; p += 1;
        let decision = data[p]; p += 1;
        let ntrans = data[p]; p += 1;
        state_kind.push(kind);
        state_rule.push(rule);
        state_decision.push(decision);
        state_tr_start.push(tr_kind.len());
        state_tr_count.push(ntrans);
        for let mut j = 0; j < ntrans; j += 1 {
            tr_kind.push(data[p]); p += 1;
            tr_src.push(i);
            tr_target.push(data[p]); p += 1;
            tr_label.push(data[p]); p += 1;
            tr_follow.push(data[p]); p += 1;
            tr_prec.push(data[p]); p += 1;
        }
    }
    return AtnSim {
        state_kind, state_rule, state_decision, state_tr_start, state_tr_count,
        tr_kind, tr_src, tr_target, tr_label, tr_follow, tr_prec,
        decision_state, rule_start, rule_stop, num_tokens,
    };
}

/// Return states at which `caller` rule invokes `callee` rule. Used to
/// continue a config into its real caller on rule exit (cold path; a linear
/// transition scan is fine).
#[allow(dead_code)]
fn atn_call_return_states(sim: &AtnSim, caller: i32, callee: i32) -> List<i32> {
    let mut out: List<i32> = [];
    for let mut j = 0; j < sim.tr_kind.len(); j += 1 {
        if sim.tr_kind[j] == ATN_TR_RULE && sim.tr_label[j] == callee && sim.state_rule[sim.tr_src[j]] == caller {
            out.push(sim.tr_follow[j]);
        }
    }
    return out;
}

/// True when `state`'s outgoing edges consume a token (atom / wildcard /
/// not-atom). Such a state is a resting point: closure stops there and
/// `atn_move` reads the edge. Epsilon / rule states are expanded instead.
#[allow(dead_code)]
fn atn_state_consumes(sim: &AtnSim, state: i32) -> bool {
    let cnt = sim.state_tr_count[state];
    if cnt == 0 {
        return false;
    }
    let k = sim.tr_kind[sim.state_tr_start[state]];
    return k == ATN_TR_ATOM || k == ATN_TR_NOT_ATOM || k == ATN_TR_WILDCARD;
}

/// Expand a seed set to its closure: resting configs (consuming states;
/// rule-stop "at-end"; and `ATN_ACCEPT_EOF`). Follows epsilon edges and
/// rule invocations (precise `stack`), pops rule-stops against `stack`,
/// and on a fully-exhausted rule branches into the caller via `rstk` (the
/// pre-existing rule-invocation stack). Dedups to break cycles.
#[allow(dead_code)]
fn atn_closure(sim: &AtnSim, seeds: &List<AtnConfig>, rstk: &List<i32>) -> List<AtnConfig> {
    let mut result: List<AtnConfig> = [];
    let mut work: List<AtnConfig> = *seeds;
    let mut seen: List<AtnConfig> = [];
    while let Some(c) = work.pop() {
        if seen.len() > ATN_MAX_CONFIGS {
            break;
        }
        if seen.contains(&c) {
            continue;
        }
        seen.push(c);

        if c.state == ATN_ACCEPT_EOF {
            result.push(c);
            continue;
        }

        if sim.state_kind[c.state] == ATN_RULE_STOP {
            if !c.stack.is_empty() {
                let mut ns = c.stack;
                let ret = ns.pop().unwrap();
                work.push(AtnConfig { state: ret, alt: c.alt, stack: ns, rs: c.rs });
            } else if c.rs > 0 {
                let callee = rstk[c.rs];
                let caller = rstk[c.rs - 1];
                let sites = atn_call_return_states(sim, caller, callee);
                if sites.is_empty() {
                    result.push(c);
                } else {
                    for let st of &sites {
                        work.push(AtnConfig { state: *st, alt: c.alt, stack: [], rs: c.rs - 1 });
                    }
                }
            } else if rstk.is_empty() {
                // SLL: caller unknown, rule-stop matches any follow.
                result.push(c);
            } else {
                // Real stack exhausted to the start rule: follow is EOF.
                result.push(AtnConfig { state: ATN_ACCEPT_EOF, alt: c.alt, stack: [], rs: -1 });
            }
            continue;
        }

        if atn_state_consumes(sim, c.state) {
            result.push(c);
            continue;
        }

        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let target = sim.tr_target[start + j];
            if k == ATN_TR_EPSILON {
                work.push(AtnConfig { state: target, alt: c.alt, stack: c.stack, rs: c.rs });
            } else if k == ATN_TR_RULE {
                if c.stack.len() >= ATN_MAX_STACK || target < 0 {
                    continue;
                }
                let mut ns = c.stack;
                ns.push(sim.tr_follow[start + j]);
                work.push(AtnConfig { state: target, alt: c.alt, stack: ns, rs: c.rs });
            }
        }
    }
    return result;
}

/// Advance a resting config set by one input token. At-end and accept-EOF
/// configs carry only when still viable; consuming configs follow whichever
/// edge matches `token`.
#[allow(dead_code)]
fn atn_move(sim: &AtnSim, configs: &List<AtnConfig>, token: i32, eof: i32) -> List<AtnConfig> {
    let mut out: List<AtnConfig> = [];
    for let c of configs {
        if c.state == ATN_ACCEPT_EOF {
            if token == eof {
                out.push(*c);
            }
            continue;
        }
        if sim.state_kind[c.state] == ATN_RULE_STOP {
            out.push(*c);
            continue;
        }
        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let label = sim.tr_label[start + j];
            let matched = if k == ATN_TR_ATOM {
                label == token;
            } else if k == ATN_TR_WILDCARD {
                token != eof;
            } else if k == ATN_TR_NOT_ATOM {
                token != label && token != eof;
            } else {
                false;
            };
            if matched {
                out.push(AtnConfig { state: sim.tr_target[start + j], alt: c.alt, stack: c.stack, rs: c.rs });
            }
        }
    }
    return out;
}

#[allow(dead_code)]
fn atn_unique_alts(configs: &List<AtnConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return alts;
}

#[allow(dead_code)]
fn atn_min_alt(alts: &List<i32>) -> i32 {
    if alts.is_empty() {
        return -1;
    }
    let mut m = alts[0];
    for let a of alts {
        if *a < m {
            m = *a;
        }
    }
    return m;
}

#[allow(dead_code)]
fn atn_all_at_end(sim: &AtnSim, configs: &List<AtnConfig>) -> bool {
    if configs.is_empty() {
        return false;
    }
    for let c of configs {
        if c.state != ATN_ACCEPT_EOF && sim.state_kind[c.state] != ATN_RULE_STOP {
            return false;
        }
    }
    return true;
}

/// Predict the winning alternative at `decision` against `tokens` from
/// `start_pos`, with full context: `rule_stack` is the caller's current
/// rule-invocation chain (rule indices, outermost first, the decision's own
/// rule last). Pass an empty `rule_stack` for plain SLL. Returns the 0-based
/// alternative index (the decision state's edge order), or -1 if no
/// alternative is viable.
///
/// Resolution: simulate until one alt survives (return it), the config set
/// empties (return the previous step's lowest alt), or all survivors are
/// at-end together (a genuine conflict — return the lowest alt, matching
/// ANTLR4's rule-order tie-break; non-greedy repeats order their exit edge
/// first so this yields the exit).
#[allow(dead_code)]
pub fn atn_predict_with_stack(sim: &AtnSim, decision: i32, rule_stack: &List<i32>, tokens: &List<Token>, start_pos: i32, eof: i32) -> i32 {
    let dstate = sim.decision_state[decision];
    let start = sim.state_tr_start[dstate];
    let cnt = sim.state_tr_count[dstate];
    let rs_init = rule_stack.len() - 1;
    let mut seeds: List<AtnConfig> = [];
    for let mut j = 0; j < cnt; j += 1 {
        seeds.push(AtnConfig { state: sim.tr_target[start + j], alt: j, stack: [], rs: rs_init });
    }
    let mut configs = atn_closure(sim, &seeds, rule_stack);
    let mut pos = start_pos;
    let mut prev = atn_unique_alts(&configs);
    let limit = tokens.len() - start_pos + 8;
    let mut guard = 0;
    loop {
        guard += 1;
        if guard > limit {
            return atn_min_alt(&prev);
        }
        let alts = atn_unique_alts(&configs);
        if alts.is_empty() {
            return atn_min_alt(&prev);
        }
        if alts.len() == 1 {
            return alts[0];
        }
        if atn_all_at_end(sim, &configs) {
            return atn_min_alt(&alts);
        }
        prev = alts;
        let token = if pos < tokens.len() { tokens[pos].kind } else { eof };
        let moved = atn_move(sim, &configs, token, eof);
        pos += 1;
        configs = atn_closure(sim, &moved, rule_stack);
    }
}

/// SLL convenience wrapper: predict with an empty rule stack. Correct for
/// top-level decisions; deeper decisions whose disambiguation depends on the
/// caller's follow need `atn_predict_with_stack` with the real rule stack.
#[allow(dead_code)]
pub fn atn_adaptive_predict(sim: &AtnSim, decision: i32, tokens: &List<Token>, start_pos: i32, eof: i32) -> i32 {
    let empty: List<i32> = [];
    return atn_predict_with_stack(sim, decision, &empty, tokens, start_pos, eof);
}

/// Decide whether a non-greedy optional (`(...)?? `) should ENTER (consume
/// its body) or SKIP, using full-context ATN prediction. The current rule
/// is the top of `rule_stack` (maintained by the rule-entry wrapper); the
/// decision is that rule's unique exit-first BlockStart (an optional whose
/// edge 0 goes straight to BlockEnd — the non-greedy ordering). Returns
/// true to ENTER.
///
/// Falls back to ENTER (the prior greedy behaviour) when context is absent
/// or the decision can't be uniquely identified (0 or >1 candidates), so a
/// mapping miss degrades gracefully instead of mispredicting.
#[allow(dead_code)]
pub fn atn_ng_optional_enter(sim: &AtnSim, rule_stack: &List<i32>, tokens: &List<Token>, pos: i32, eof: i32) -> bool {
    if rule_stack.is_empty() {
        return true;
    }
    let rule = rule_stack[rule_stack.len() - 1];
    let mut dec = -1;
    let mut found = 0;
    for let mut d = 0; d < sim.decision_state.len(); d += 1 {
        let ds = sim.decision_state[d];
        if sim.state_kind[ds] != ATN_BLOCK_START || sim.state_rule[ds] != rule {
            continue;
        }
        if sim.state_tr_count[ds] < 1 {
            continue;
        }
        let first_target = sim.tr_target[sim.state_tr_start[ds]];
        if sim.state_kind[first_target] == ATN_BLOCK_END {
            dec = d;
            found += 1;
        }
    }
    if found != 1 {
        return true;
    }
    let alt = atn_predict_with_stack(sim, dec, rule_stack, tokens, pos, eof);
    // Non-greedy optional edges are ordered [exit=0, enter=1].
    return alt == 1;
}
pub enum TokenKind {
    ID,
    WS,
    Eof,
    Error,
}

pub struct StartNode {
    pub span: Span,
    pub statement_list: List<StatementNode>,
}

pub variant StatementNode {
    Alt0(StatementAlt0),
    Alt1(StatementAlt1),
}

pub struct StatementAlt0 {
    pub span: Span,
    pub lit_x: Token,
}

pub struct StatementAlt1 {
    pub span: Span,
    pub if_statement: IfStatementNode,
}

pub struct LitElseStatementItem {
    pub lit_else: Token,
    pub statement: StatementNode,
}

pub struct IfStatementNode {
    pub span: Span,
    pub lit_if: Token,
    pub lit_y: Token,
    pub statement: StatementNode,
    pub lit_else_statement: Option<LitElseStatementItem>,
}

global TK_ID: i32 = 0;
global TK_WS: i32 = 1;
global TK_EOF: i32 = 2;
global TK_ERROR: i32 = 3;
global TK_LIT_X: i32 = 4;
global TK_LIT_IF: i32 = 5;
global TK_LIT_Y: i32 = 6;
global TK_LIT_ELSE: i32 = 7;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_id(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_ws(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_1 = pos;
    let mut alts_ok_1 = false;
    alts_1_0: {
        pos = alts_saved_1;
        if pos >= chars.len() || chars[pos] != ' ' { break alts_1_0; }
        pos += 1;
        alts_ok_1 = true;
    }
    if !alts_ok_1 {
        alts_1_1: {
            pos = alts_saved_1;
            if pos >= chars.len() || chars[pos] != '\n' { break alts_1_1; }
            pos += 1;
            alts_ok_1 = true;
        }
    }
    if !alts_ok_1 { return -1; }
    return pos;
}

fn try_lit_x(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'x' { return -1; }
    return pos + 1;
}

fn try_lit_if(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'i' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'f' { return -1; }
    return pos + 2;
}

fn try_lit_y(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'y' { return -1; }
    return pos + 1;
}

fn try_lit_else(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'e' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'l' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 's' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'e' { return -1; }
    return pos + 4;
}

pub fn tokenize(input: &String) -> List<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: List<Token> = List::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: List<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        let mut best_channel: i32 = 0;
        if first_char == '\n' || first_char == ' ' {
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; best_channel = 1; }
        } else if first_char == 'e' {
            end = try_lit_else(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_ELSE; best_channel = 0; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; best_channel = 0; }
        } else if first_char == 'i' {
            end = try_lit_if(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_IF; best_channel = 0; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; best_channel = 0; }
        } else if first_char == 'x' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_X; best_channel = 0; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; best_channel = 0; }
        } else if first_char == 'y' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_Y; best_channel = 0; }
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; best_channel = 0; }
        } else if 'a' <= first_char <= 'z' {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; best_channel = 0; }
        } else {
            end = try_id(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; best_channel = 0; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = false;
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else if best_channel != 0 {
                trivia.push(Token::with_channel(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), [], best_channel));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_X => "TK_LIT_X",
        TK_LIT_IF => "TK_LIT_IF",
        TK_LIT_Y => "TK_LIT_Y",
        TK_LIT_ELSE => "TK_LIT_ELSE",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: List<Token>,
    pos: i32,
    chars: List<char>,
    pending: Option<ParseError>,
    atn: AtnSim,
    atn_stack: List<i32>,
}

impl Parser {
    fn new(tokens: List<Token>, chars: List<char>) -> Parser {
        return Parser { tokens, pos: 0, chars, pending: null, atn: atn_decode(&GALE_ATN_DATA), atn_stack: [] };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(&self.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::<ParseError>::Some(e);
        }
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
                }
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["token set"],
        ));
    }
}

fn scan_start(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_statement(tokens, pos, &EMPTY_FOLLOW, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos].kind) && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        pos = scan_statement(tokens, pos, &EMPTY_FOLLOW, 0);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_statement(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LIT_X {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_X { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_IF {
            pos = start;
            try_1: {
                pos = scan_if_statement(tokens, pos, follow, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_if_statement(tokens: &List<Token>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_IF { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_Y { return -1; }
    pos += 1;
    pos = scan_statement(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    if pos < tokens.len() && tokens[pos].kind == TK_LIT_ELSE {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_ELSE { break sg_0; }
                pos += 1;
                pos = scan_statement(tokens, pos, follow, 0);
                if pos < 0 { break sg_0; }
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; }
    }
    return pos;
}

fn _parse_start__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<StartNode, ParseError> {
    let start = p.peek().span.start;
    let mut statement_list: List<StatementNode> = [];
    let mut _plus_first = true;
    loop {
        if !_plus_first {
            if follow_yields(&p.tokens, p.pos, follow, TK_EOF) { break; }
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                pos = scan_statement(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 {
                if _gale_kind_set_0(p.peek_kind()) {
                    let _rec_pos = p.pos;
                    if let Err(_rec_e) = _parse_statement(p, &EMPTY_FOLLOW) { p.record_deeper(_rec_e); }
                    p.pos = _rec_pos;
                }
                break;
            }
        }
        _plus_first = false;
        let statement = _parse_statement(p, &EMPTY_FOLLOW)?;
        statement_list.push(statement);
    }
    return Result::<StartNode, ParseError>::Ok(StartNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        statement_list,
    });
}

fn _parse_start(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<StartNode, ParseError> {
    p.atn_stack.push(0);
    let r = _parse_start__inner(p, follow);
    p.atn_stack.pop();
    if let Err(mut e) = r {
        e.rule_stack.push("start");
        return Result::<StartNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_statement__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<StatementNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_X {
        let lit_x = p.expect(TK_LIT_X)?;
        return Result::<StatementNode, ParseError>::Ok(StatementNode::Alt0(StatementAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lit_x,
        }));
    }
    if kind == TK_LIT_IF {
        let if_statement = _parse_if_statement(p, follow)?;
        return Result::<StatementNode, ParseError>::Ok(StatementNode::Alt1(StatementAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            if_statement,
        }));
    }
    return Result::<StatementNode, ParseError>::Err(p.error(
        "expected statement",
        p.peek().span,
        ["TK_LIT_X", "TK_LIT_IF"],
    ));
}

fn _parse_statement(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<StatementNode, ParseError> {
    p.atn_stack.push(1);
    let r = _parse_statement__inner(p, follow);
    p.atn_stack.pop();
    if let Err(mut e) = r {
        e.rule_stack.push("statement");
        return Result::<StatementNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_if_statement__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<IfStatementNode, ParseError> {
    let start = p.peek().span.start;
    let lit_if = p.expect(TK_LIT_IF)?;
    let lit_y = p.expect(TK_LIT_Y)?;
    let statement = _parse_statement(p, follow)?;
    let lit_else_statement: Option<LitElseStatementItem> = if atn_ng_optional_enter(&p.atn, &p.atn_stack, &p.tokens, p.pos, TK_EOF) {
        let lit_else = p.expect(TK_LIT_ELSE)?;
        let statement = _parse_statement(p, follow)?;
        let lit_else_statement = LitElseStatementItem {
            lit_else,
            statement,
        };
        Option::<LitElseStatementItem>::Some(lit_else_statement)
    } else {
        null
    };
    return Result::<IfStatementNode, ParseError>::Ok(IfStatementNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lit_if,
        lit_y,
        statement,
        lit_else_statement,
    });
}

fn _parse_if_statement(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<IfStatementNode, ParseError> {
    p.atn_stack.push(2);
    let r = _parse_if_statement__inner(p, follow);
    p.atn_stack.pop();
    if let Err(mut e) = r {
        e.rule_stack.push("ifStatement");
        return Result::<IfStatementNode, ParseError>::Err(e);
    }
    return r;
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    return Parser::new(tokens, chars);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_start(input: &String) -> Result<StartNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_start(&mut parser);
    if let Err(_e) = _result {
        return Result::<StartNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_statement(input: &String) -> Result<StatementNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_statement(&mut parser);
    if let Err(_e) = _result {
        return Result::<StatementNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse_if_statement(input: &String) -> Result<IfStatementNode, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = _parse_if_statement(&mut parser);
    if let Err(_e) = _result {
        return Result::<IfStatementNode, ParseError>::Err(_gale_pick_error(&parser, _e));
    }
    return _result;
}

pub fn parse(input: &String) -> Result<StartNode, ParseError> {
    return parse_start(input);
}

pub fn walk_start<V: Visitor>(v: &mut V, node: &StartNode) {
    v.enter_rule(0, &"start", &node.span);
    for let item of &node.statement_list {
        walk_statement(v, item);
    }
    v.exit_rule(0, &"start", &node.span);
}

pub fn walk_statement<V: Visitor>(v: &mut V, node: &StatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(1, &"statement", &n.span);
            v.visit_token(&n.lit_x);
            v.exit_rule(1, &"statement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(1, &"statement", &n.span);
            walk_ifStatement(v, &n.if_statement);
            v.exit_rule(1, &"statement", &n.span);
        }
    }
}

pub fn walk_ifStatement<V: Visitor>(v: &mut V, node: &IfStatementNode) {
    v.enter_rule(2, &"ifStatement", &node.span);
    v.visit_token(&node.lit_if);
    v.visit_token(&node.lit_y);
    walk_statement(v, &node.statement);
    if let Some(item) = &node.lit_else_statement {
        v.visit_token(&item.lit_else);
        walk_statement(v, &item.statement);
    }
    v.exit_rule(2, &"ifStatement", &node.span);
}

pub fn to_tree(node: &StartNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_start(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_IF | TK_LIT_X };
}

