    pos = scan_identifier(tokens, pos, &FOLLOW_MASK_7, 0);
    if pos < 0 { return -1; }
    pos = scan_action_block(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_action_scope_name(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
