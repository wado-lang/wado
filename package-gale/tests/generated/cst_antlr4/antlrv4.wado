global TOKEN_NAMES: List<String> = ["DOC_COMMENT", "BLOCK_COMMENT", "LINE_COMMENT", "INT", "STRING_LITERAL", "UNTERMINATED_STRING_LITERAL", "'['", "ACTION", "OPTIONS", "TOKENS", "CHANNELS", "'import'", "'fragment'", "'lexer'", "'parser'", "'grammar'", "'protected'", "'public'", "'private'", "'returns'", "'locals'", "'throws'", "'catch'", "'finally'", "'mode'", "':'", "'::'", "','", "';'", "'('", "')'", "'}'", "'->'", "'<'", "'>'", "'='", "'?'", "'*'", "'+='", "'+'", "'|'", "'$'", "'..'", "'.'", "'@'", "'#'", "'~'", "ID", "WS", "END_ARGUMENT", "UNTERMINATED_ARGUMENT", "ARGUMENT_CONTENT", "LEXER_CHAR_SET", "UNTERMINATED_CHAR_SET", "ARG_ACTION", "ARG_OR_CHARSET", "RULE_REF", "SEMPRED", "TOKEN_REF", "UNICODE_ESC", "UNICODE_EXTENDED_ESC", "ALT", "BLOCK", "CLOSURE", "ELEMENT_OPTIONS", "EPSILON", "LEXER_ACTION_CALL", "LEXER_ALT_ACTION", "OPTIONAL", "POSITIVE_CLOSURE", "RULE", "RULEMODIFIERS", "RULES", "SET", "WILDCARD", "NESTED_ARGUMENT", "ARGUMENT_ESCAPE", "ARGUMENT_STRING_LITERAL", "ARGUMENT_CHAR_LITERAL", "LEXER_CHAR_SET_BODY", "Eof", "Error"];

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }
    return String::new();
}

