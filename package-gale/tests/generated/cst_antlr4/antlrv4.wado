fn token_display_name(kind: i32) -> String {
    return match kind {
        TK_BEGIN_ARGUMENT => "'['",
        TK_IMPORT => "'import'",
        TK_FRAGMENT => "'fragment'",
        TK_LEXER => "'lexer'",
        TK_PARSER => "'parser'",
        TK_GRAMMAR => "'grammar'",
        TK_PROTECTED => "'protected'",
        TK_PUBLIC => "'public'",
        TK_PRIVATE => "'private'",
        TK_RETURNS => "'returns'",
        TK_LOCALS => "'locals'",
        TK_THROWS => "'throws'",
        TK_CATCH => "'catch'",
        TK_FINALLY => "'finally'",
        TK_MODE => "'mode'",
        TK_COLON => "':'",
        TK_COLONCOLON => "'::'",
        TK_COMMA => "','",
        TK_SEMI => "';'",
        TK_LPAREN => "'('",
        TK_RPAREN => "')'",
        TK_RBRACE => "'}'",
        TK_RARROW => "'->'",
        TK_LT => "'<'",
        TK_GT => "'>'",
        TK_ASSIGN => "'='",
        TK_QUESTION => "'?'",
        TK_STAR => "'*'",
        TK_PLUS_ASSIGN => "'+='",
        TK_PLUS => "'+'",
        TK_OR => "'|'",
        TK_DOLLAR => "'$'",
        TK_RANGE => "'..'",
        TK_DOT => "'.'",
        TK_AT => "'@'",
        TK_POUND => "'#'",
        TK_NOT => "'~'",
        _ => token_kind_name(kind),
    };
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(82);
    for let mut k = 0; k < 82; k += 1 {
        v.push(token_display_name(k));
    }
    return v;
}

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &_token_names());
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &_token_names());
    }
    return String::new();
}

