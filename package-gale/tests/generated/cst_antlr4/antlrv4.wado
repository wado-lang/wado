struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_DOC_COMMENT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '*' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '*' { return -1; }
    pos += 1;
    loop {
        let ng_saved_0 = pos;
        let mut ng_exit_0 = false;
        ng_0: {
            let alts_saved_1 = pos;
            let mut alts_ok_1 = false;
            alts_1_0: {
                pos = alts_saved_1;
                if pos >= chars.len() || chars[pos] != '*' { break alts_1_0; }
                pos += 1;
                if pos >= chars.len() || chars[pos] != '/' { break alts_1_0; }
                pos += 1;
                alts_ok_1 = true;
            }
            if !alts_ok_1 {
                alts_1_1: {
                    pos = alts_saved_1;
                    if pos < chars.len() { break alts_1_1; }
                    alts_ok_1 = true;
                }
            }
            if !alts_ok_1 { break ng_0; }
            ng_exit_0 = true;
        }
        if ng_exit_0 {
            break;
        }
        pos = ng_saved_0;
        if pos >= chars.len() { return -1; }
        pos += 1;
    }
    return pos;
}

fn try_BLOCK_COMMENT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '*' { return -1; }
    pos += 1;
    loop {
        let ng_saved_2 = pos;
        let mut ng_exit_2 = false;
        ng_2: {
            let alts_saved_3 = pos;
            let mut alts_ok_3 = false;
            alts_3_0: {
                pos = alts_saved_3;
                if pos >= chars.len() || chars[pos] != '*' { break alts_3_0; }
                pos += 1;
                if pos >= chars.len() || chars[pos] != '/' { break alts_3_0; }
                pos += 1;
                alts_ok_3 = true;
            }
            if !alts_ok_3 {
                alts_3_1: {
                    pos = alts_saved_3;
                    if pos < chars.len() { break alts_3_1; }
                    alts_ok_3 = true;
                }
            }
            if !alts_ok_3 { break ng_2; }
            ng_exit_2 = true;
        }
        if ng_exit_2 {
            break;
        }
        pos = ng_saved_2;
        if pos >= chars.len() { return -1; }
        pos += 1;
    }
    return pos;
}

fn try_LINE_COMMENT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '/' { return -1; }
    pos += 1;
    loop {
        let rep_saved_4 = pos;
        rep_4: {
            if pos >= chars.len() { break rep_4; }
            if (chars[pos] matches { '\r' | '\n' }) { break rep_4; }
            pos += 1;
            continue;
        }
        pos = rep_saved_4;
        break;
    }
    return pos;
}

fn try_INT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_5 = pos;
    let mut alts_ok_5 = false;
    alts_5_0: {
        pos = alts_saved_5;
        if pos >= chars.len() || chars[pos] != '0' { break alts_5_0; }
        pos += 1;
        alts_ok_5 = true;
    }
    if !alts_ok_5 {
        alts_5_1: {
            pos = alts_saved_5;
            if pos >= chars.len() { break alts_5_1; }
            if !((chars[pos] matches { '1'..='9' })) { break alts_5_1; }
            pos += 1;
            loop {
                let rep_saved_6 = pos;
                rep_6: {
                    if pos >= chars.len() { break rep_6; }
                    if !((chars[pos] matches { '0'..='9' })) { break rep_6; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_6;
                break;
            }
            alts_ok_5 = true;
        }
    }
    if !alts_ok_5 { return -1; }
    return pos;
}

fn try_STRING_LITERAL(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\'' { return -1; }
    pos += 1;
    loop {
        let rep_saved_7 = pos;
        rep_7: {
            let alts_saved_8 = pos;
            let mut alts_ok_8 = false;
            alts_8_0: {
                pos = alts_saved_8;
                if pos >= chars.len() || chars[pos] != '\\' { break alts_8_0; }
                pos += 1;
                let alts_saved_9 = pos;
                let mut alts_ok_9 = false;
                alts_9_0: {
                    pos = alts_saved_9;
                    if pos >= chars.len() { break alts_9_0; }
                    if !((chars[pos] matches { 'b' | 't' | 'n' | 'f' | 'r' | '"' | '\'' | '\\' })) { break alts_9_0; }
                    pos += 1;
                    alts_ok_9 = true;
                }
                if !alts_ok_9 {
                    alts_9_1: {
                        pos = alts_saved_9;
                        if pos >= chars.len() || chars[pos] != 'u' { break alts_9_1; }
                        pos += 1;
                        let opt_saved_10 = pos;
                        let mut opt_ok_10 = false;
                        rep_10: {
                            if pos >= chars.len() { break rep_10; }
                            if !((chars[pos] matches { '0'..='9' | 'a'..='f' | 'A'..='F' })) { break rep_10; }
                            pos += 1;
                            let opt_saved_11 = pos;
                            let mut opt_ok_11 = false;
                            rep_11: {
                                if pos >= chars.len() { break rep_11; }
                                if !((chars[pos] matches { '0'..='9' | 'a'..='f' | 'A'..='F' })) { break rep_11; }
                                pos += 1;
                                let opt_saved_12 = pos;
                                let mut opt_ok_12 = false;
                                rep_12: {
                                    if pos >= chars.len() { break rep_12; }
                                    if !((chars[pos] matches { '0'..='9' | 'a'..='f' | 'A'..='F' })) { break rep_12; }
                                    pos += 1;
                                    let opt_saved_13 = pos;
                                    let mut opt_ok_13 = false;
                                    rep_13: {
                                        if pos >= chars.len() { break rep_13; }
                                        if !((chars[pos] matches { '0'..='9' | 'a'..='f' | 'A'..='F' })) { break rep_13; }
                                        pos += 1;
                                        opt_ok_13 = true;
                                    }
                                    if !opt_ok_13 { pos = opt_saved_13; }
                                    opt_ok_12 = true;
                                }
                                if !opt_ok_12 { pos = opt_saved_12; }
                                opt_ok_11 = true;
                            }
                            if !opt_ok_11 { pos = opt_saved_11; }
                            opt_ok_10 = true;
                        }
                        if !opt_ok_10 { pos = opt_saved_10; }
                        alts_ok_9 = true;
                    }
                    if !alts_ok_9 {
                        alts_9_2: {
                            pos = alts_saved_9;
                            if pos >= chars.len() { break alts_9_2; }
                            pos += 1;
                            alts_ok_9 = true;
                        }
                        if !alts_ok_9 {
                            alts_9_3: {
                                pos = alts_saved_9;
                                if pos < chars.len() { break alts_9_3; }
                                alts_ok_9 = true;
                            }
                        }
                    }
                }
                if !alts_ok_9 { break alts_8_0; }
                alts_ok_8 = true;
            }
            if !alts_ok_8 {
                alts_8_1: {
                    pos = alts_saved_8;
                    if pos >= chars.len() { break alts_8_1; }
                    if (chars[pos] matches { '\'' | '\r' | '\n' | '\\' }) { break alts_8_1; }
                    pos += 1;
                    alts_ok_8 = true;
                }
            }
            if !alts_ok_8 { break rep_7; }
            continue;
        }
        pos = rep_saved_7;
        break;
    }
    if pos >= chars.len() || chars[pos] != '\'' { return -1; }
    pos += 1;
    return pos;
}

fn try_UNTERMINATED_STRING_LITERAL(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\'' { return -1; }
    pos += 1;
    loop {
        let rep_saved_14 = pos;
        rep_14: {
            let alts_saved_15 = pos;
            let mut alts_ok_15 = false;
            alts_15_0: {
                pos = alts_saved_15;
