            pos = alts_saved_21;
            pos = frag_UnicodeESC(src, pos);
            if pos < 0 { break alts_21_1; }
            break alts_done_21;
        }
        alts_21_2: {
            pos = alts_saved_21;
            if pos >= src.len() { break alts_21_2; }
            pos = src.ceil_char_boundary(pos + 1);
            break alts_done_21;
        }
        alts_21_3: {
            pos = alts_saved_21;
            if pos < src.len() { break alts_21_3; }
            break alts_done_21;
        }
        return -1;
    }
    return pos;
}

fn frag_DoubleQuoteLiteral(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'"' { return -1; }
    pos += 1;
    loop {
        let ng_saved_22 = pos;
        let mut ng_exit_22 = false;
        ng_22: {
            if pos >= src.len() || unchecked src.byte_at(pos) != b'"' { break ng_22; }
            pos += 1;
            ng_exit_22 = true;
        }
        if ng_exit_22 {
            break;
        }
        pos = ng_saved_22;
        let alts_saved_23 = pos;
        alts_done_23: {
            alts_23_0: {
                pos = alts_saved_23;
                pos = frag_ESC_SEQUENCE(src, pos);
                if pos < 0 { break alts_23_0; }
                break alts_done_23;
            }
            alts_23_1: {
                pos = alts_saved_23;
                if pos >= src.len() { break alts_23_1; }
                if (unchecked src.byte_at(pos) matches { b'"' | b'\x0d' | b'\x0a' | b'\\' }) { break alts_23_1; }
                pos = src.ceil_char_boundary(pos + 1);
                break alts_done_23;
            }
            return -1;
        }
    }
    return pos;
}

fn frag_UnicodeESC(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'u' { return -1; }
    pos += 1;
    let opt_saved_24 = pos;
    let mut opt_ok_24 = false;
    opt_24: {
        if pos >= src.len() { break opt_24; }
        if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break opt_24; }
        pos += 1;
        let opt_saved_25 = pos;
        let mut opt_ok_25 = false;
        opt_25: {
            if pos >= src.len() { break opt_25; }
            if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break opt_25; }
            pos += 1;
            let opt_saved_26 = pos;
            let mut opt_ok_26 = false;
            opt_26: {
                if pos >= src.len() { break opt_26; }
                if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break opt_26; }
                pos += 1;
                opt_27: {
                    if pos >= src.len() { break opt_27; }
                    if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' | b'A'..=b'F' | b'a'..=b'f' }) { break opt_27; }
                    pos += 1;
                }
                opt_ok_26 = true;
            }
            if !opt_ok_26 { pos = opt_saved_26; }
            opt_ok_25 = true;
        }
        if !opt_ok_25 { pos = opt_saved_25; }
        opt_ok_24 = true;
    }
    if !opt_ok_24 { pos = opt_saved_24; }
    return pos;
}

fn classify_keyword(src: &StrSlice, start: i32, end: i32) -> i32 {
    match end - start {
        4 => { if unchecked src.byte_at(start) == b'm' && unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'd' && unchecked src.byte_at(start + 3) == b'e' { return TK_MODE; } },
        5 => { if unchecked src.byte_at(start) == b'l' && unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'x' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'r' { return TK_LEXER; } },
        6 => {
            match unchecked src.byte_at(start) {
                b'i' => { if unchecked src.byte_at(start + 1) == b'm' && unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'o' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b't' { return TK_IMPORT; } },
                b'l' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'c' && unchecked src.byte_at(start + 3) == b'a' && unchecked src.byte_at(start + 4) == b'l' && unchecked src.byte_at(start + 5) == b's' { return TK_LOCALS; } },
                b'p' => {
                    match unchecked src.byte_at(start + 1) {
                        b'a' => { if unchecked src.byte_at(start + 2) == b'r' && unchecked src.byte_at(start + 3) == b's' && unchecked src.byte_at(start + 4) == b'e' && unchecked src.byte_at(start + 5) == b'r' { return TK_PARSER; } },
                        b'u' => { if unchecked src.byte_at(start + 2) == b'b' && unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'i' && unchecked src.byte_at(start + 5) == b'c' { return TK_PUBLIC; } },
                        _ => {},
                    }
                },
                _ => {},
            }
        },
        7 => {
            match unchecked src.byte_at(start) {
                b'f' => { if unchecked src.byte_at(start + 1) == b'i' && unchecked src.byte_at(start + 2) == b'n' && unchecked src.byte_at(start + 3) == b'a' && unchecked src.byte_at(start + 4) == b'l' && unchecked src.byte_at(start + 5) == b'l' && unchecked src.byte_at(start + 6) == b'y' { return TK_FINALLY; } },
                b'g' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b'm' && unchecked src.byte_at(start + 4) == b'm' && unchecked src.byte_at(start + 5) == b'a' && unchecked src.byte_at(start + 6) == b'r' { return TK_GRAMMAR; } },
                b'p' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b'v' && unchecked src.byte_at(start + 4) == b'a' && unchecked src.byte_at(start + 5) == b't' && unchecked src.byte_at(start + 6) == b'e' { return TK_PRIVATE; } },
                b'r' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'u' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'n' && unchecked src.byte_at(start + 6) == b's' { return TK_RETURNS; } },
                _ => {},
            }
        },
        8 => { if unchecked src.byte_at(start) == b'f' && unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b'g' && unchecked src.byte_at(start + 4) == b'm' && unchecked src.byte_at(start + 5) == b'e' && unchecked src.byte_at(start + 6) == b'n' && unchecked src.byte_at(start + 7) == b't' { return TK_FRAGMENT; } },
        9 => { if unchecked src.byte_at(start) == b'p' && unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'o' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'e' && unchecked src.byte_at(start + 5) == b'c' && unchecked src.byte_at(start + 6) == b't' && unchecked src.byte_at(start + 7) == b'e' && unchecked src.byte_at(start + 8) == b'd' { return TK_PROTECTED; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream with LexerAdaptor {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(lexer.src);
    let mut triv_lo = ts.trivia_mark();
    let mut more_start: i32 = -1;
    let mut mode_stack: List<i32> = [];
    let mut current_mode: i32 = 0;
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let mut best_act: i32 = -1;
        let mut best_act_skip = false;
        let first_char = char_at(&lexer.src, start);
        let mut best_push_mode: i32 = -1;
        let mut best_pop_mode = false;
        let mut best_set_mode: i32 = -1;
        let mut best_more = false;
        let mut best_channel: i32 = 0;
        if current_mode == 0 {
            match first_char {
                '\t' | '\n' | '\u{c}' | '\r' | ' ' => {
                    end = try_WS(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_WS; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 2; best_act = -1; }
                },
                '#' => {
                    end = try_POUND(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_POUND; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '$' => {
                    end = try_DOLLAR(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_DOLLAR; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '\'' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        '\u{0}'..='\t' | '\u{b}'..='\u{c}' | '\u{e}'..='\u{10ffff}' => {
                            end = try_STRING_LITERAL(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_STRING_LITERAL; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_UNTERMINATED_STRING_LITERAL(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_STRING_LITERAL; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '(' => {
                    end = try_LPAREN(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_LPAREN; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                ')' => {
                    end = try_RPAREN(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_RPAREN; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '*' => {
                    end = try_STAR(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_STAR; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '+' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        '=' => {
                            end = try_PLUS_ASSIGN(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_PLUS_ASSIGN; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_PLUS(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_PLUS; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                ',' => {
                    end = try_COMMA(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_COMMA; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '-' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        '>' => {
                            end = try_RARROW(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_RARROW; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                },
                '.' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        '.' => {
                            end = try_RANGE(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_RANGE; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_DOT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_DOT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '/' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        '*' => {
                            end = try_DOC_COMMENT(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_DOC_COMMENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 3; best_act = -1; }
                            end = try_BLOCK_COMMENT(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_BLOCK_COMMENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 3; best_act = -1; }
                        },
                        '/' => {
                            end = try_LINE_COMMENT(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_LINE_COMMENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 3; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                },
                '0' | '1'..='9' => {
                    end = try_INT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_INT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                ':' => {
                    end = try_COLON(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_COLON; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        ':' => {
                            end = try_COLONCOLON(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_COLONCOLON; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                },
                ';' => {
                    end = try_SEMI(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_SEMI; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '<' => {
                    end = try_LT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_LT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '=' => {
                    end = try_ASSIGN(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ASSIGN; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '>' => {
                    end = try_GT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_GT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '?' => {
                    end = try_QUESTION(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_QUESTION; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '@' => {
                    end = try_AT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_AT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                'A'..='Z' | 'a'..='b' | 'd'..='n' | 'p'..='s' | 'u'..='z' | 'À'..='Ö' | 'Ø'..='ö' | 'ø'..='˿' | 'Ͱ'..='ͽ' | 'Ϳ'..='\u{1fff}' | '\u{200c}'..='\u{200d}' | '⁰'..='\u{218f}' | 'Ⰰ'..='\u{2fef}' | '、'..='\u{d7ff}' | '豈'..='﷏' | 'ﷰ'..='�' => {
                    end = try_ID(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ID; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '[' => {
                    end = try_BEGIN_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_BEGIN_ARGUMENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 0; }
                },
                'c' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        'a' => {
                            end = try_CATCH(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_CATCH; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'h' => {
                            end = try_CHANNELS(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_CHANNELS; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_ID(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ID; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                'o' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        'p' => {
                            end = try_OPTIONS(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_OPTIONS; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_ID(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ID; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                't' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        'h' => {
                            end = try_THROWS(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_THROWS; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'o' => {
                            end = try_TOKENS(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_TOKENS; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_ID(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ID; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '{' => {
                    end = try_ACTION(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ACTION; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '|' => {
                    end = try_OR(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_OR; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '}' => {
                    end = try_RBRACE(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_RBRACE; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '~' => {
                    end = try_NOT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_NOT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                _ => {},
            }
        } else if current_mode == 1 {
            match first_char {
                '"' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        '\u{0}'..='\t' | '\u{b}'..='\u{c}' | '\u{e}'..='\u{10ffff}' => {
                            end = try_ARGUMENT_STRING_LITERAL(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_ARGUMENT_CONTENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_UNTERMINATED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_ARGUMENT; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '#'..='&' | '('..='Z' => {
                    end = try_UNTERMINATED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_ARGUMENT; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '\'' => {
                    let second_at = lexer.src.ceil_char_boundary(start + 1);
                    let second_char = if second_at < lexer.src.len() { char_at(&lexer.src, second_at) } else { '\u{0}' };
                    match second_char {
                        '\u{0}'..='\t' | '\u{b}'..='\u{c}' | '\u{e}'..='\u{10ffff}' => {
                            end = try_ARGUMENT_CHAR_LITERAL(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_ARGUMENT_CONTENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_UNTERMINATED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_ARGUMENT; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '[' => {
                    end = try_NESTED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ARGUMENT_CONTENT; best_push_mode = 1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    end = try_UNTERMINATED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_ARGUMENT; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '\\' => {
                    end = try_ARGUMENT_ESCAPE(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_ARGUMENT_CONTENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    end = try_UNTERMINATED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_ARGUMENT; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                ']' => {
                    end = try_END_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_END_ARGUMENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 1; }
                    end = try_UNTERMINATED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_ARGUMENT; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                _ => {
                    end = try_UNTERMINATED_ARGUMENT(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_ARGUMENT; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
            }
            if best_end <= start {
                end = try_ARGUMENT_CONTENT(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_ARGUMENT_CONTENT; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
            }
        } else if current_mode == 2 {
            match first_char {
                ']' => {
                    end = try_LEXER_CHAR_SET_BODY(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_LEXER_CHAR_SET_BODY; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = true; best_channel = 0; best_act = -1; }
                    end = try_LEXER_CHAR_SET(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_LEXER_CHAR_SET; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    end = try_UNTERMINATED_CHAR_SET(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_CHAR_SET; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                _ => {
                    end = try_LEXER_CHAR_SET_BODY(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_LEXER_CHAR_SET_BODY; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = true; best_channel = 0; best_act = -1; }
                    end = try_UNTERMINATED_CHAR_SET(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_UNTERMINATED_CHAR_SET; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
            }
        }
        if best_end < start || (best_end == start && best_push_mode < 0 && !best_pop_mode && best_set_mode < 0) {
            let error_end = lexer.src.ceil_char_boundary(start + 1);
            let _ = ts.push_token_flagged(TK_ERROR, start, error_end, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = error_end;
        } else {
            if current_mode == 0 && best_kind == TK_ID {
                let kw_kind = classify_keyword(&lexer.src, start, best_end);
                if kw_kind >= 0 { best_kind = kw_kind; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
            }
            if best_act >= 0 {
                lexer.reset_actions(best_kind, best_channel, mode_stack.len());
                if best_act == 0 {
                    apply_BEGIN_ARGUMENT_actions(&mut lexer, start, best_end);
                } else if best_act == 1 {
                    apply_END_ARGUMENT_actions(&mut lexer, start, best_end);
                }
                best_kind = lexer.act_type;
                best_channel = lexer.act_channel;
                if lexer.act_more { best_more = true; }
                if lexer.act_skip { best_act_skip = true; }
                if lexer.act_push_mode >= 0 { best_push_mode = lexer.act_push_mode; }
                if lexer.act_pop_mode { best_pop_mode = true; }
                if lexer.act_set_mode >= 0 { best_set_mode = lexer.act_set_mode; }
            }
            let tok_start = if more_start >= 0 { more_start } else { start };
            let is_skip = false || best_act_skip;
            if !is_skip && !best_more {
                best_kind = LexerAdaptor::emit(LexerView { src: &lexer.src, start: tok_start, pos: best_end }, best_kind, best_channel);
            }
            if best_more {
                if more_start < 0 { more_start = start; }
            } else if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
                more_start = -1;
            } else if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
                more_start = -1;
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
                more_start = -1;
            }
            if best_push_mode >= 0 {
                mode_stack.push(current_mode);
                current_mode = best_push_mode;
                best_push_mode = -1;
            }
            if best_pop_mode {
                if mode_stack.is_empty() {
                    current_mode = 0;
                } else {
                    current_mode = mode_stack[mode_stack.len() - 1];
                    mode_stack.pop();
                }
                best_pop_mode = false;
            }
            if best_set_mode >= 0 {
                current_mode = best_set_mode;
                best_set_mode = -1;
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    ts.output = lexer.act_output;
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_DOC_COMMENT => "DOC_COMMENT",
        TK_BLOCK_COMMENT => "BLOCK_COMMENT",
        TK_LINE_COMMENT => "LINE_COMMENT",
        TK_INT => "INT",
        TK_STRING_LITERAL => "STRING_LITERAL",
        TK_UNTERMINATED_STRING_LITERAL => "UNTERMINATED_STRING_LITERAL",
        TK_BEGIN_ARGUMENT => "BEGIN_ARGUMENT",
        TK_ACTION => "ACTION",
        TK_OPTIONS => "OPTIONS",
        TK_TOKENS => "TOKENS",
        TK_CHANNELS => "CHANNELS",
        TK_IMPORT => "IMPORT",
        TK_FRAGMENT => "FRAGMENT",
        TK_LEXER => "LEXER",
        TK_PARSER => "PARSER",
        TK_GRAMMAR => "GRAMMAR",
        TK_PROTECTED => "PROTECTED",
        TK_PUBLIC => "PUBLIC",
        TK_PRIVATE => "PRIVATE",
        TK_RETURNS => "RETURNS",
        TK_LOCALS => "LOCALS",
        TK_THROWS => "THROWS",
        TK_CATCH => "CATCH",
        TK_FINALLY => "FINALLY",
        TK_MODE => "MODE",
        TK_COLON => "COLON",
        TK_COLONCOLON => "COLONCOLON",
        TK_COMMA => "COMMA",
        TK_SEMI => "SEMI",
        TK_LPAREN => "LPAREN",
        TK_RPAREN => "RPAREN",
        TK_RBRACE => "RBRACE",
        TK_RARROW => "RARROW",
        TK_LT => "LT",
        TK_GT => "GT",
        TK_ASSIGN => "ASSIGN",
        TK_QUESTION => "QUESTION",
        TK_STAR => "STAR",
        TK_PLUS_ASSIGN => "PLUS_ASSIGN",
        TK_PLUS => "PLUS",
        TK_OR => "OR",
        TK_DOLLAR => "DOLLAR",
        TK_RANGE => "RANGE",
        TK_DOT => "DOT",
        TK_AT => "AT",
        TK_POUND => "POUND",
        TK_NOT => "NOT",
        TK_ID => "ID",
        TK_WS => "WS",
        TK_NESTED_ARGUMENT => "NESTED_ARGUMENT",
        TK_ARGUMENT_ESCAPE => "ARGUMENT_ESCAPE",
        TK_ARGUMENT_STRING_LITERAL => "ARGUMENT_STRING_LITERAL",
        TK_ARGUMENT_CHAR_LITERAL => "ARGUMENT_CHAR_LITERAL",
        TK_END_ARGUMENT => "END_ARGUMENT",
        TK_UNTERMINATED_ARGUMENT => "UNTERMINATED_ARGUMENT",
        TK_ARGUMENT_CONTENT => "ARGUMENT_CONTENT",
        TK_LEXER_CHAR_SET_BODY => "LEXER_CHAR_SET_BODY",
        TK_LEXER_CHAR_SET => "LEXER_CHAR_SET",
        TK_UNTERMINATED_CHAR_SET => "UNTERMINATED_CHAR_SET",
        TK_ARG_ACTION => "ARG_ACTION",  // virtual
        TK_ARG_OR_CHARSET => "ARG_OR_CHARSET",  // virtual
        TK_RULE_REF => "RULE_REF",  // virtual
        TK_SEMPRED => "SEMPRED",  // virtual
        TK_TOKEN_REF => "TOKEN_REF",  // virtual
        TK_UNICODE_ESC => "UNICODE_ESC",  // virtual
        TK_UNICODE_EXTENDED_ESC => "UNICODE_EXTENDED_ESC",  // virtual
        TK_ALT => "ALT",  // virtual
        TK_BLOCK => "BLOCK",  // virtual
        TK_CLOSURE => "CLOSURE",  // virtual
        TK_ELEMENT_OPTIONS => "ELEMENT_OPTIONS",  // virtual
        TK_EPSILON => "EPSILON",  // virtual
        TK_LEXER_ACTION_CALL => "LEXER_ACTION_CALL",  // virtual
        TK_LEXER_ALT_ACTION => "LEXER_ALT_ACTION",  // virtual
        TK_OPTIONAL => "OPTIONAL",  // virtual
        TK_POSITIVE_CLOSURE => "POSITIVE_CLOSURE",  // virtual
        TK_RULE => "RULE",  // virtual
        TK_RULEMODIFIERS => "RULEMODIFIERS",  // virtual
        TK_RULES => "RULES",  // virtual
        TK_SET => "SET",  // virtual
        TK_WILDCARD => "WILDCARD",  // virtual
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

pub global RK_GRAMMAR_SPEC: NodeKind = 0;
pub global RK_GRAMMAR_DECL: NodeKind = 1;
pub global RK_GRAMMAR_TYPE: NodeKind = 2;
pub global RK_PREQUEL_CONSTRUCT: NodeKind = 3;
pub global RK_OPTIONS_SPEC: NodeKind = 4;
pub global RK_OPTION: NodeKind = 5;
pub global RK_OPTION_VALUE: NodeKind = 6;
pub global RK_DELEGATE_GRAMMARS: NodeKind = 7;
pub global RK_DELEGATE_GRAMMAR: NodeKind = 8;
pub global RK_TOKENS_SPEC: NodeKind = 9;
pub global RK_CHANNELS_SPEC: NodeKind = 10;
pub global RK_ID_LIST: NodeKind = 11;
pub global RK_ACTION_: NodeKind = 12;
pub global RK_ACTION_SCOPE_NAME: NodeKind = 13;
pub global RK_ACTION_BLOCK: NodeKind = 14;
pub global RK_ARG_ACTION_BLOCK: NodeKind = 15;
pub global RK_MODE_SPEC: NodeKind = 16;
