#![generated(by = "gale", sources = ["grammars/ANTLRv4Lexer.g4", "grammars/ANTLRv4Parser.g4"])]

// Grammar metadata from source .g4 prequels:
//   option superClass = LexerAdaptor
//   option tokenVocab = ANTLRv4Lexer

//! Core lexing vocabulary shared by every generated parser and by Gale's
//! own front end: source spans, lazy token-text slices, tokens, and the
//! parse-error type. Prelude-only and self-contained so it can be both
//! imported as a module (by Gale's `token`/`lexer`/`parser`/`ir`) and
//! `#include_str`'d verbatim into generated parsers.

/// Span represents a byte range in source text.
pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn merge(&self, other: &Span) -> Span {
        let start = if self.start < other.start { self.start } else { other.start };
        let end = if self.end > other.end { self.end } else { other.end };
        return Span { start, end };
    }
}

impl Eq for Span {
    fn eq(&self, other: &Self) -> bool {
        return self.start == other.start && self.end == other.end;
    }
}

/// LexerSlice is a lazy reference to a range of characters in the source input.
/// It avoids allocating a String for every token during tokenization.
pub struct LexerSlice {
    pub chars: &List<char>,
    pub start: i32,
    pub end: i32,
}

impl LexerSlice {
    pub fn new(chars: &List<char>, start: i32, end: i32) -> LexerSlice with stores[chars] {
        return LexerSlice { chars, start, end };
    }

    pub fn empty(chars: &List<char>) -> LexerSlice with stores[chars] {
        return LexerSlice { chars, start: 0, end: 0 };
    }

    pub fn from_string(s: String) -> LexerSlice {
        let chars = s.chars().collect();
        return LexerSlice { chars: &chars, start: 0, end: chars.len() };
    }

    pub fn is_empty(&self) -> bool {
        return self.start >= self.end;
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }

    pub fn push_to(&self, out: &mut String) {
        for let mut i = self.start; i < self.end; i += 1 {
            out.push(self.chars[i]);
        }
    }

    pub fn to_string(&self) -> String {
        let mut s = String::with_capacity(self.end - self.start);
        self.push_to(&mut s);
        return s;
    }

    pub fn eq_str(a: &String, b: &LexerSlice) -> bool {
        let a_chars = a.chars();
        let mut a_iter = a_chars;
        let mut i = b.start;
        loop {
            let a_next = a_iter.next();
            if i >= b.end {
                return a_next matches { None };
            }
            if let Some(ac) = a_next {
                if ac != b.chars[i] {
                    return false;
                }
            } else {
                return false;
            }
            i += 1;
        }
    }
}

impl Display for LexerSlice {
    fn fmt(&self, f: &mut Formatter) {
        for let mut i = self.start; i < self.end; i += 1 {
            f.write_char(self.chars[i]);
        }
    }
}

impl Eq for LexerSlice {
    fn eq(&self, other: &Self) -> bool {
        let len = self.end - self.start;
        if len != other.end - other.start {
            return false;
        }
        for let mut i = 0; i < len; i += 1 {
            if self.chars[self.start + i] != other.chars[other.start + i] {
                return false;
            }
        }
        return true;
    }
}

/// Token represents a lexed token with its kind, text, and position.
/// Leading trivia (whitespace, comments) is attached to each token.
/// `channel` is the ANTLR4 channel id (0 = default, 1 = HIDDEN; named
/// channels resolve to integer ids declared in the grammar).
pub struct Token {
    pub kind: i32,
    pub text: LexerSlice,
    pub span: Span,
    pub leading_trivia: List<Token>,
    pub channel: i32,
}

impl Token {
    pub fn new(kind: i32, text: LexerSlice, span: Span) -> Token {
        return Token { kind, text, span, leading_trivia: [], channel: 0 };
    }

    pub fn with_trivia(kind: i32, text: LexerSlice, span: Span, leading_trivia: List<Token>) -> Token {
        return Token { kind, text, span, leading_trivia, channel: 0 };
    }

    pub fn with_channel(kind: i32, text: LexerSlice, span: Span, leading_trivia: List<Token>, channel: i32) -> Token {
        return Token { kind, text, span, leading_trivia, channel };
    }
}

// Note: Token Eq is intentionally omitted. Auto-derived Eq on recursive structs
// with reference-containing fields triggers a compiler bug
// (see wado-compiler/tests/fixtures/recursive_struct_ref_eq.wado).

/// TokenStream is the struct-of-arrays token storage for generated parsers.
/// A "token" is an `i32` index into these parallel arrays; no per-token
/// aggregate is ever allocated. The hot fields (`kinds` / `starts` / `ends`)
/// are read on every scan/dispatch step as a single `array.get i32`; the
/// trivia and source-char data are cold, materialised on demand only by the
/// diagnostic / round-trip paths.
///
/// `Token` above stays the value-typed vocabulary for Gale's own `.g4` front
/// end; the generated-parser runtime uses `TokenStream` instead.
///
/// Layout invariant: the per-token arrays (`kinds` / `starts` / `ends` /
/// `triv_lo` / `triv_hi`) always share a length, because `push_token` is the
/// only writer and advances all five together. Hidden / skip tokens ("trivia")
/// live in the flat `triv_*` arrays in source order; each parser token owns the
/// half-open range `[triv_lo[i], triv_hi[i])`.
/// Per-token recovery flags (a bitset stored in `TokenStream.flags`). A normal
/// lexed token has `0`. The bits mark tokens the error-resilient parser created
/// or set aside during recovery, so the tree builder and diagnostics can render
/// them without a side table:
///
/// - `TOK_SYNTHETIC` — a zero-width token the parser *inserted* to stand in for
///   a required terminal that was absent (its `kinds[i]` is the expected kind).
/// - `TOK_SKIPPED` — a real lexed token the parser *deleted* during recovery
///   (it belongs to no rule; preserved for lossless round-trip).
/// - `TOK_LEX_ERROR` — a fast mirror of the `TK_ERROR` kind: a char run that
///   matched no lexer rule.
pub global TOK_SYNTHETIC: i32 = 1;
pub global TOK_SKIPPED: i32 = 2;
pub global TOK_LEX_ERROR: i32 = 4;

/// TokenStream is the struct-of-arrays token storage for generated parsers.
/// A "token" is an `i32` index into these parallel arrays; no per-token
/// aggregate is ever allocated. The hot fields (`kinds` / `starts` / `ends`)
/// are read on every scan/dispatch step as a single `array.get i32`; the
/// trivia and source-char data are cold, materialised on demand only by the
/// diagnostic / round-trip paths.
///
/// `Token` above stays the value-typed vocabulary for Gale's own `.g4` front
/// end; the generated-parser runtime uses `TokenStream` instead.
///
/// Layout invariant: the per-token arrays (`kinds` / `starts` / `ends` /
/// `triv_lo` / `triv_hi` / `flags`) always share a length, because
/// `push_token` is the only writer and advances all of them together. Hidden /
/// skip tokens ("trivia") live in the flat `triv_*` arrays in source order;
/// each parser token owns the half-open range `[triv_lo[i], triv_hi[i])`.
pub struct TokenStream {
    pub kinds: List<i32>,
    pub starts: List<i32>,
    pub ends: List<i32>,
    pub triv_lo: List<i32>,
    pub triv_hi: List<i32>,
    pub chars: &List<char>,
    pub triv_kinds: List<i32>,
    pub triv_starts: List<i32>,
    pub triv_ends: List<i32>,
    pub triv_chans: List<i32>,
    pub flags: List<i32>,
}

impl TokenStream {
    /// Empty stream over `chars` (a borrow of the source char list, like
    /// `LexerSlice`). Pre-size every array — trivia included — to ~one token
    /// per four chars; trivia tracks token count, so `[]` would re-grow from
    /// zero every parse.
    pub fn new(chars: &List<char>) -> TokenStream with stores[chars] {
        let cap = chars.len() / 4 + 1;
        return TokenStream {
            kinds: List::with_capacity(cap),
            starts: List::with_capacity(cap),
            ends: List::with_capacity(cap),
            triv_lo: List::with_capacity(cap),
            triv_hi: List::with_capacity(cap),
            chars,
            triv_kinds: List::with_capacity(cap),
            triv_starts: List::with_capacity(cap),
            triv_ends: List::with_capacity(cap),
            triv_chans: List::with_capacity(cap),
            flags: List::with_capacity(cap),
        };
    }

    pub fn len(&self) -> i32 {
        return self.kinds.len();
    }

    /// The next trivia index — the lexer records this as a token's `triv_lo`
    /// before accumulating that token's leading trivia, and again as `triv_hi`
    /// after.
    pub fn trivia_mark(&self) -> i32 {
        return self.triv_kinds.len();
    }

    /// Append one hidden / skip token to the flat trivia arrays.
    pub fn push_trivia(&mut self, kind: i32, start: i32, end: i32, channel: i32) {
        self.triv_kinds.push(kind);
        self.triv_starts.push(start);
        self.triv_ends.push(end);
        self.triv_chans.push(channel);
    }

    /// Append one parser (default-channel) token. The sole writer of the
    /// per-token arrays, so their lengths stay in lockstep by construction.
    pub fn push_token(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32) {
        self.push_token_flagged(kind, start, end, triv_lo, triv_hi, 0);
    }

    /// Append a token carrying recovery `flags`, returning its index. The
    /// real lockstep writer; `push_token` is the `flags = 0` common case.
    pub fn push_token_flagged(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32, flags: i32) -> i32 {
        let idx = self.kinds.len();
        self.kinds.push(kind);
        self.starts.push(start);
        self.ends.push(end);
        self.triv_lo.push(triv_lo);
        self.triv_hi.push(triv_hi);
        self.flags.push(flags);
        return idx;
    }

    /// Append a zero-width synthetic token at byte offset `at`, standing in for
    /// a required terminal of kind `expected_kind` that the parser inserted
    /// during recovery. Returns the new token index. The token owns no trivia.
    pub fn push_synthetic(&mut self, expected_kind: i32, at: i32) -> i32 {
        let m = self.trivia_mark();
        return self.push_token_flagged(expected_kind, at, at, m, m, TOK_SYNTHETIC);
    }

    pub fn flags_at(&self, i: i32) -> i32 {
        return self.flags[i];
    }

    pub fn set_flag(&mut self, i: i32, flag: i32) {
        self.flags[i] = self.flags[i] | flag;
    }

    /// Mark token `i` as deleted by recovery (preserved, but bound to no rule).
    pub fn mark_skipped(&mut self, i: i32) {
        self.set_flag(i, TOK_SKIPPED);
    }

    /// Mark token `i` as a lexer error (a char run that matched no rule). The
    /// lexer sets this alongside the `TK_ERROR` kind so consumers can test the
    /// flag without knowing the grammar's `TK_ERROR` id.
    pub fn mark_lex_error(&mut self, i: i32) {
        self.set_flag(i, TOK_LEX_ERROR);
    }

    pub fn is_synthetic(&self, i: i32) -> bool {
        return self.flags[i] & TOK_SYNTHETIC != 0;
    }

    pub fn is_skipped(&self, i: i32) -> bool {
        return self.flags[i] & TOK_SKIPPED != 0;
    }

    pub fn is_lex_error(&self, i: i32) -> bool {
        return self.flags[i] & TOK_LEX_ERROR != 0;
    }

    pub fn kind_at(&self, i: i32) -> i32 {
        return self.kinds[i];
    }

    pub fn span_at(&self, i: i32) -> Span {
        return Span::new(self.starts[i], self.ends[i]);
    }

    pub fn is_empty_text(&self, i: i32) -> bool {
        return self.starts[i] >= self.ends[i];
    }

    /// Append `chars[start..end]` to `out` (no allocation).
    pub fn push_text(&self, out: &mut String, start: i32, end: i32) {
        for let mut j = start; j < end; j += 1 {
            out.push(self.chars[j]);
        }
    }

    /// Materialise token `i`'s text as an owned `String` (cold path).
    pub fn token_text(&self, i: i32) -> String {
        let start = self.starts[i];
        let end = self.ends[i];
        let mut s = String::with_capacity(end - start);
        self.push_text(&mut s, start, end);
        return s;
    }

    /// Append token `i`'s text to `out` (no allocation).
    pub fn push_token_text(&self, out: &mut String, i: i32) {
        self.push_text(out, self.starts[i], self.ends[i]);
    }

    /// Append the text of token `i`'s leading trivia, in source order.
    pub fn push_leading_trivia_text(&self, out: &mut String, i: i32) {
        for let mut j = self.triv_lo[i]; j < self.triv_hi[i]; j += 1 {
            self.push_text(out, self.triv_starts[j], self.triv_ends[j]);
        }
    }
}


/// ParseError represents a parse failure with location and expected tokens.
///
/// `message` is the local "expected X, got Y" description, kept free of
/// position and rule context so it stays composable. `line`/`col` are a
/// 1-based line and 0-based column (ANTLR4 `Token` convention) resolved
/// from `span.start` against the source at error-construction time;
/// `Parser::error` fills them in. `rule_stack` records the chain of parser
/// rules that were active when the error was raised, innermost first — each
/// rule entry wrapper pushes its own name as the `Err` propagates outward,
/// so the last element is the start rule and the first is the rule the
/// failing token sat in. The `Display` impl renders all of this into a
/// human-readable diagnostic.
pub struct ParseError {
    pub message: String,
    pub span: Span,
    pub expected: List<String>,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub rule_stack: List<String> = [],
}

impl ParseError {
    pub fn new(message: String, span: Span, expected: List<String>) -> ParseError {
        return ParseError { message, span, expected };
    }

    /// Construct a ParseError whose position is already resolved. Used by
    /// `Parser::error`, which has the source on hand to compute line/col.
    pub fn at(message: String, span: Span, expected: List<String>, line: i32, col: i32) -> ParseError {
        return ParseError { message, span, expected, line, col, rule_stack: [] };
    }

    /// Render the rule chain as `outer > ... > inner` (start rule first).
    /// `rule_stack` is stored innermost-first, so iterate it in reverse.
    /// Consecutive duplicates are collapsed: a left-recursive rule re-enters
    /// itself once per precedence level, which would otherwise print
    /// `expr > expr > expr` for a deep expression.
    pub fn rule_path(&self) -> String {
        let mut out = String::with_capacity(self.rule_stack.len() * 8);
        let n = self.rule_stack.len();
        let mut written = 0;
        for let mut i = 0; i < n; i += 1 {
            let name = &self.rule_stack[n - 1 - i];
            if written > 0 && *name == self.rule_stack[n - i] {
                continue;
            }
            if written > 0 {
                out.push_str(&" > ");
            }
            out.push_str(name);
            written += 1;
        }
        return out;
    }
}

impl Display for ParseError {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&`parse error at {self.line}:{self.col}: {self.message}`);
        if !self.rule_stack.is_empty() {
            f.write_str(&`\n  in rule: {self.rule_path()}`);
        }
    }
}
//! Diagnostics emitted by the error-resilient parser. A parse always returns a
//! tree; `Diagnostic`s say where and how it was repaired. Inlined into every
//! generated parser alongside the recovery runtime. Imports `Span` from
//! `lex.wado`; that import is stripped at `#include_str` time.


pub enum Severity {
    Error,
    Warning,
    Info,
    Hint,
}

impl Severity {
    pub fn label(&self) -> String {
        return match *self {
            Error => "error",
            Warning => "warning",
            Info => "info",
            Hint => "hint",
        };
    }
}

/// What went wrong, independent of the specific tokens. Tooling can switch on
/// this without parsing the human message.
pub enum DiagnosticCode {
    UnexpectedToken,  // a token that fits nowhere in the current rule
    MissingToken,  // a required terminal was absent (one was inserted)
    ExtraToken,  // a spurious terminal was deleted
    NoViableAlternative,  // alternative dispatch found no match
    UnterminatedConstruct,  // EOF reached inside a rule (missing closer)
    LexError,  // a char run matched no lexer rule (TK_ERROR)
}

impl DiagnosticCode {
    pub fn name(&self) -> String {
        return match *self {
            UnexpectedToken => "unexpected-token",
            MissingToken => "missing-token",
            ExtraToken => "extra-token",
            NoViableAlternative => "no-viable-alternative",
            UnterminatedConstruct => "unterminated-construct",
            LexError => "lex-error",
        };
    }
}

/// The repair the parser applied at this site, so a fixit/IDE can describe it.
pub enum RecoveryAction {
    Inserted,  // synthesised a missing terminal
    Deleted,  // skipped one spurious terminal
    SkippedTo,  // skipped a run up to a synchronizing token
    FilledMissing,  // hit EOF; filled remaining required terminals
    None,  // reported only, no edit
}

/// A secondary location attached to a diagnostic, e.g. "'(' opened here" for an
/// unterminated group.
pub struct RelatedInfo {
    pub message: String,
    pub span: Span,
}

/// A single parse diagnostic. `expected`/`found` carry token-kind ids (not
/// names) so tooling reuses the grammar's own name tables; `message` is the
/// pre-rendered human text. `line`/`col` are 1-based line and 0-based column
/// (ANTLR4 `Token` convention) resolved from `span.start`.
pub struct Diagnostic {
    pub severity: Severity,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub expected: List<i32> = [],
    pub found: i32 = -1,
    pub rule_stack: List<String> = [],
    pub recovery: RecoveryAction = RecoveryAction::None,
    pub related: List<RelatedInfo> = [],
}

impl Diagnostic {
    /// A bare error diagnostic with position resolved; callers fill the
    /// optional fields (`expected`, `rule_stack`, `related`, ...) as needed.
    pub fn error(code: DiagnosticCode, message: String, span: Span, line: i32, col: i32) -> Diagnostic {
        return Diagnostic {
            severity: Severity::Error,
            code,
            message,
            span,
            line,
            col,
        };
    }

    pub fn is_error(&self) -> bool {
        return self.severity matches { Error };
    }
}

impl Display for Diagnostic {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&`{self.severity.label()}[{self.code.name()}] at {self.line}:{self.col}: {self.message}`);
        for let r of &self.related {
            f.write_str(&`\n  note: {r.message}`);
        }
    }
}

/// Resolve a char index to (line, column): 1-based line, 0-based column
/// (ANTLR4 `Token` convention). A linear scan; the parser resolves at most a
/// handful of positions per parse, so this stays off the hot path.
pub fn line_col(chars: &List<char>, pos: i32) -> [i32, i32] {
    let mut line = 1;
    let mut col = 0;
    let cap = if pos < chars.len() { pos } else { chars.len() };
    for let mut i = 0; i < cap; i += 1 {
        if chars[i] == '\n' {
            line += 1;
            col = 0;
        } else {
            col += 1;
        }
    }
    return [line, col];
}
//! The single (untyped) concrete syntax tree produced by every
//! generated error-resilient parser, the `TreeBuilder` the parser drives to
//! construct it, and the `ParseResult` the parser returns.
//!
//! Unlike the retired typed-CST-then-convert design, the parser builds *this*
//! tree directly — there is no second typed representation and no walk/convert
//! step. Consumers (compiler front ends, LSP, syntax highlight) read this tree
//! as-is, so the generic view they want is free.
//!
//! `CstNode` is a pure value tree: it holds no reference to the token stream,
//! so it composes and stores freely and `ParseResult` can own both the tree and
//! the stream it indexes without a self-referential borrow. Methods that need
//! terminal text or kinds take a `&TokenStream` argument.
//!
//! Error tokens are first-class and lossless: `Missing` (an inserted synthetic
//! terminal), `Skipped` (a real terminal deleted during recovery), and a
//! `<error>` region node (kind `K_ERROR`) together capture every recovery edit
//! (insert / delete / region) so the original input round-trips. The token-
//! stream flags (`TOK_SYNTHETIC` / `TOK_SKIPPED`, see `lex.wado`) carry the same
//! facts at the terminal level.
//!
//! Imports `TokenStream` from `lex.wado` and `Diagnostic` from `diag.wado`;
//! those imports are stripped at `#include_str` time (see `gen_runtime` in
//! `codegen.wado`), where the fragments are concatenated into one module.


/// A node's kind: a parser-rule id (`0..num_rules`, in grammar declaration
/// order) or the reserved `K_ERROR` sentinel for a recovery region node. A
/// newtype over `i32` so the generated parser can give it a name-aware
/// `Display` (`Inspect` shows `name(id)`); the name table is grammar-specific,
/// so codegen emits those impls.
pub type NodeKind = i32;

/// The reserved kind for a `<error>` region node — a run of skipped tokens or
/// a partial sub-parse swept up during panic-mode recovery. Never collides with
/// a real rule id (those are non-negative).
pub global K_ERROR: NodeKind = -1;

/// `CstNode.flags` bits.
///
/// - `NODE_ERROR` — this node, or some descendant, contains a recovery edit
///   (a missing/skipped terminal or an error region). Bubbles up so a consumer
///   can prune clean subtrees in one check.
/// - `NODE_INCOMPLETE` — this node is missing a required terminal that the
///   parser had to insert (it has a `Missing` child).
pub global NODE_ERROR: i32 = 1;
pub global NODE_INCOMPLETE: i32 = 2;

/// A child slot of a `CstNode`. The full error-token vocabulary lives here:
/// `Missing` is an inserted terminal, `Skipped` a deleted terminal, and an
/// error region is a `Node` whose kind is `K_ERROR`.
pub variant CstChild {
    Token(i32),  // a real terminal: an index into the TokenStream
    Missing(i32),  // an inserted synthetic terminal (zero-width; TOK_SYNTHETIC)
    Skipped(i32),  // a real terminal deleted during recovery (TOK_SKIPPED)
    Node(CstNode),  // a sub-rule (an error region when its kind is K_ERROR)
}

/// A node in the tree. A pure value: terminals are `i32` indices
/// into a `TokenStream` that lives outside the tree (in `ParseResult`), so
/// rendering methods take that stream as an argument.
pub struct CstNode {
    pub kind: NodeKind,
    pub span: Span,
    pub children: List<CstChild>,
    pub flags: i32,
}

impl CstNode {
    pub fn is_error(&self) -> bool {
        return self.flags & NODE_ERROR != 0;
    }

    pub fn is_incomplete(&self) -> bool {
        return self.flags & NODE_INCOMPLETE != 0;
    }

    /// ANTLR4-style S-expression: `(name child ...)`, tokens as their text.
    /// `rule_names[kind]` names rule nodes (`K_ERROR` renders `<error>`);
    /// `token_names[kind]` names missing terminals. Real terminals with empty
    /// text (e.g. EOF) are omitted; missing/skipped terminals render markers.
    pub fn to_string_tree(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        let mut out = String::with_capacity(256);
        cst_to_string_tree_impl(&mut out, self, toks, rule_names, token_names);
        return out;
    }

    /// First direct child node of rule `kind`, or `null`. Used by sub-tree
    /// rendering (e.g. an ANTLR4 descriptor whose `[output]` is a labelled
    /// child subtree, not the start rule's full tree).
    pub fn find_child(&self, kind: NodeKind) -> Option<CstNode> {
        for let child of &self.children {
            if let Node(n) = *child {
                if n.kind == kind {
                    return Option::Some(n);
                }
            }
        }
        return null;
    }
}

fn cst_to_string_tree_impl(
    out: &mut String,
    node: &CstNode,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) {
    out.push_str(&"(");
    if node.kind == K_ERROR {
        out.push_str(&"<error>");
    } else {
        out.push_str(&rule_names[node.kind as i32]);
    }
    for let child of &node.children {
        match *child {
            Token(i) => {
                if !toks.is_empty_text(i) {
                    out.push_str(&" ");
                    toks.push_token_text(out, i);
                }
            },
            Missing(i) => {
                out.push_str(&` <missing {token_names[toks.kind_at(i)]}>`);
            },
            Skipped(i) => {
                out.push_str(&" <skip ");
                toks.push_token_text(out, i);
                out.push_str(&">");
            },
            Node(n) => {
                out.push_str(&" ");
                cst_to_string_tree_impl(out, &n, toks, rule_names, token_names);
            },
        }
    }
    out.push_str(&")");
}

/// What a parse returns: the root, the token stream its terminal
/// indices point into, and any diagnostics. A clean parse leaves `diagnostics`
/// empty. Owns both `root` and `tokens` outright (the tree borrows nothing), so
/// the result is a freely movable value.
pub struct ParseResult {
    pub root: CstNode,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        for let d of &self.diagnostics {
            if d.is_error() {
                return true;
            }
        }
        return false;
    }

    /// True when the parse produced no error-severity diagnostics.
    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

/// A flat event recorded by the parser as it descends. `finish()` replays the
/// events once to materialise the tree, so each `CstNode` is allocated exactly
/// once (no per-step deep copy of the in-progress subtree).
variant BuildEvent {
    Open([NodeKind, i32]),  // [kind, start byte offset]
    Close(i32),  // end byte offset
    Tok(i32),  // real terminal index
    Miss(i32),  // inserted synthetic terminal index
    Skip(i32),  // skipped real terminal index
}

/// The builder the generated parser drives. It records a flat event stream
/// (`start_node` / `token` / `missing` / `skip` / `finish_node`) and replays it
/// in `finish()`. It is purely structural — it stores token *indices*, never the
/// stream itself; the parser owns the `TokenStream`, appending synthetic
/// "missing" tokens and marking skipped ones on its own copy.
pub struct TreeBuilder {
    events: List<BuildEvent>,
}

impl TreeBuilder {
    pub fn new() -> TreeBuilder {
        return TreeBuilder { events: [] };
    }

    /// Open a rule node of `kind` starting at byte offset `start`.
    pub fn start_node(&mut self, kind: NodeKind, start: i32) {
        self.events.push(BuildEvent::Open([kind, start]));
    }

    /// Open a `<error>` region node (kind `K_ERROR`) at byte offset `start`.
    pub fn start_error(&mut self, start: i32) {
        self.events.push(BuildEvent::Open([K_ERROR, start]));
    }

    /// A position in the event stream to retro-open a node at. Used for
    /// left-associative wrapping (precedence climbing): capture a checkpoint
    /// before the first operand, then `start_node_at` to make a new node whose
    /// first child is everything recorded since the checkpoint.
    pub fn checkpoint(&self) -> i32 {
        return self.events.len();
    }

    /// Retro-open a node of `kind` (starting at byte offset `start`) at a
    /// previously captured `checkpoint`, so all events recorded since wrap
    /// inside it. Close it with the matching `finish_node`. Re-using the same
    /// checkpoint across loop iterations nests left-associatively.
    pub fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32) {
        self.events.insert(checkpoint, BuildEvent::Open([kind, start]));
    }

    /// Discard every event recorded since `checkpoint`, rolling the builder
    /// back to that point. Used by a *speculative* parse that runs only to
    /// localise a deep error (and then restores the cursor): under the
    /// emitter the speculative subtree must not leak into the real
    /// tree, so the caller brackets it with `checkpoint()` / `truncate()`.
    pub fn truncate(&mut self, checkpoint: i32) {
        while self.events.len() > checkpoint {
            let _ = self.events.pop();
        }
    }

    /// Close the innermost open node at byte offset `end`.
    pub fn finish_node(&mut self, end: i32) {
        self.events.push(BuildEvent::Close(end));
    }

    /// Append a real terminal (`idx` into the stream) to the open node.
    pub fn token(&mut self, idx: i32) {
        self.events.push(BuildEvent::Tok(idx));
    }

    /// Append an inserted synthetic terminal. `syn_idx` is the index returned
    /// by `TokenStream::push_synthetic`.
    pub fn missing(&mut self, syn_idx: i32) {
        self.events.push(BuildEvent::Miss(syn_idx));
    }

    /// Append a skipped real terminal. The caller marks `idx` with
    /// `TokenStream::mark_skipped` first.
    pub fn skip(&mut self, idx: i32) {
        self.events.push(BuildEvent::Skip(idx));
    }

    /// Materialise the tree. Valid once the root node has been closed.
    pub fn finish(&self) -> CstNode {
        let mut pos = 0;
        return tree_build_node(&self.events, &mut pos);
    }
}

fn tree_build_node(events: &List<BuildEvent>, pos: &mut i32) -> CstNode {
    if let Open(info) = events[*pos] {
        let kind = info.0;
        let start = info.1;
        *pos += 1;
        let mut children: List<CstChild> = [];
        let mut flags = if kind == K_ERROR { NODE_ERROR } else { 0 };
        let mut end = start;
        loop {
            if *pos >= events.len() {
                break;
            }
            let ev = events[*pos];
            if let Close(e) = ev {
                end = e;
                *pos += 1;
                break;
            }
            if let Open(_) = ev {
                let child = tree_build_node(events, pos);
                if child.flags & NODE_ERROR != 0 {
                    flags = flags | NODE_ERROR;
                }
                if child.span.end > end {
                    end = child.span.end;
                }
                children.push(CstChild::Node(child));
            } else if let Tok(i) = ev {
                children.push(CstChild::Token(i));
                *pos += 1;
            } else if let Miss(i) = ev {
                children.push(CstChild::Missing(i));
                flags = flags | NODE_INCOMPLETE | NODE_ERROR;
                *pos += 1;
            } else if let Skip(i) = ev {
                children.push(CstChild::Skipped(i));
                flags = flags | NODE_ERROR;
                *pos += 1;
            }
        }
        return CstNode { kind, span: Span::new(start, end), children, flags };
    }
    panic("TreeBuilder: expected Open event");
}
//! Consumer-facing tree / token utilities exposed by every generated
//! parser: S-expression normalisation (`normalize_tree`) and the
//! ANTLR4-format token-stream dump (`to_lexer_string`) used by the
//! compatibility suite. Always emitted. The generated parser code never calls
//! these itself; consumers (driver tests, the ANTLR4-compat suite) import them
//! from the generated module. The `./lex.wado` import is stripped at
//! `#include_str` time.


/// Normalize a multi-line S-expression string for comparison.
/// Collapses whitespace runs to single spaces and trims, while preserving
/// whitespace inside double-quoted strings.
pub fn normalize_tree(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    let mut in_string = false;
    let mut space_pending = false;
    for let c of s.chars() {
        if in_string {
            out.push(c);
            if c == '"' {
                in_string = false;
            }
        } else if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            if out.len() > 0 {
                space_pending = true;
            }
        } else {
            if space_pending {
                out.push(' ');
                space_pending = false;
            }
            if c == '"' {
                in_string = true;
            }
            out.push(c);
        }
    }
    return out;
}

/// Produce an ANTLR4-style `Token.toString()` dump of the token stream:
///
///   [@<idx>,<start>:<end>='<text>',<<type>>,<line>:<col>]\n  (per token)
///
/// Used by Stage L (token-stream equivalence) tests against the upstream
/// `LexerExec` / etc. `[output]` blocks.
///
/// - `tokens` is the `TokenStream` returned by the generated
///   `tokenize(input)`. Skip-channel trivia (channel 0) is discarded; only
///   non-default-channel trivia is interleaved.
/// - `eof_kind` is the value of the generated `TK_EOF` constant; EOF
///   tokens print as `<EOF>` text with type id `-1`.
///
/// Type IDs are remapped from Gale's 0-based numbering to ANTLR4's
/// 1-based: `kind + 1` for explicit lexer rules, `-1` for EOF. Lexer-only
/// grammars never introduce implicit literals, so the contiguous
/// `0..num_lexer_rules` range maps directly onto ANTLR4's
/// `1..num_lexer_rules+1`.
///
/// Text escaping follows ANTLR4's `CommonToken.toString` format (observed
/// via the published jar as a black-box oracle): only `\n`, `\r`, `\t` are
/// escaped; backslashes and quotes pass through unchanged.
pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let chars = tokens.chars;
    // Char index where each line begins; built once so each token's `line:col`
    // is an O(log n) binary search (`line_col_from_starts`) not an O(pos) rescan.
    let mut line_starts: List<i32> = [0];
    for let mut i = 0; i < chars.len(); i += 1 {
        if chars[i] == '\n' {
            line_starts.push(i + 1);
        }
    }
    let mut out = String::with_capacity(tokens.len() * 32);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        // Non-default-channel trivia (`-> channel(HIDDEN)`) is parked in this
        // token's trivia range; ANTLR4 still dumps it in source order with a
        // `channel=N` attribute, so interleave it ahead of the host token.
        // Skip trivia (channel 0) is discarded — neither printed nor indexed
        // (matching ANTLR4's `Lexer.skip()`).
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &line_starts,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &line_starts,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

/// Renders a single token in ANTLR4's `CommonToken.toString` format, used by
/// `to_lexer_string` for both main-stream tokens and interleaved
/// non-default-channel trivia. `channel=N` is printed only for non-default
/// channels, matching ANTLR4.
fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    line_starts: &List<i32>,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let mut text_buf = String::with_capacity(16);
    if is_eof {
        text_buf.push_str(&"<EOF>");
    } else {
        for let mut j = start; j < end; j += 1 {
            let c = tokens.chars[j];
            match c {
                '\n' => text_buf.push_str(&"\\n"),
                '\r' => text_buf.push_str(&"\\r"),
                '\t' => text_buf.push_str(&"\\t"),
                _ => text_buf.push(c),
            }
        }
    }
    let type_id = if is_eof { -1 } else { kind + 1 };
    let line_col = line_col_from_starts(line_starts, start);
    let line = line_col.0;
    let col = line_col.1;
    let end_inclusive = end - 1;
    let channel_attr = if channel != 0 { `channel={channel},` } else { String::from("") };
    out.push_str(&`[@{index},{start}:{end_inclusive}='{text_buf}',<{type_id}>,{channel_attr}{line}:{col}]\n`);
}

/// Compute (line, column) at a 0-based char index in `chars`, with
/// 1-based line and 0-based column to match ANTLR4's `Token` getters.
/// The parser's error path reports at most one position per parse, so the
/// linear scan is fine; the per-token dump uses `line_col_from_starts`.
fn line_col_at(chars: &List<char>, pos: i32) -> [i32, i32] {
    let mut line = 1;
    let mut col = 0;
    let cap = if pos < chars.len() { pos } else { chars.len() };
    for let mut i = 0; i < cap; i += 1 {
        if chars[i] == '\n' {
            line += 1;
            col = 0;
        } else {
            col += 1;
        }
    }
    return [line, col];
}

/// Compute (line, column) from the precomputed `line_starts` table (char
/// index where each line begins). Binary search for the greatest
/// `line_starts[j] <= pos`: that line is `j + 1` and the column is the
/// offset past its start. O(log lines) per call.
fn line_col_from_starts(line_starts: &List<i32>, pos: i32) -> [i32, i32] {
    let mut lo = 0;
    let mut hi = line_starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if line_starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return [lo + 1, pos - line_starts[lo]];
}
//! Runtime FOLLOW-continuation gate for tail-greedy loops. Emitted into a
//! generated parser only when lowering constructed a caller-FOLLOW gate
//! (`GenContext::emit_follow`); gate-free grammars carry none of this.

/// `follow` is the caller's deterministic K-prefix continuation:
/// `follow[d]` is the set of token kinds that may appear at input depth
/// `d` if control belongs to the caller rather than to another iteration
/// of the loop. An empty `follow` (the common, non-repair case) disables
/// the gate. The loop yields to the caller — breaking `*`/`+` or skipping
/// `?` — exactly when EVERY non-empty depth-set matches the upcoming
/// input, i.e. when the next tokens are unambiguously the caller's
/// continuation.
///
/// Threaded as a defaulted `&EMPTY_FOLLOW` argument through the generated
/// `parse_*` / `scan_*` functions; repair call sites pass a `FOLLOW_MASK_*`
/// constant (or forward their own `follow`). This replaces the previous
/// per-(rule, mask) cloned `__follow_<id>` variants: the mask is data
/// carried at runtime, not code baked into a specialised function.
///
/// `eof_kind` is the token kind reported past the end of the stream, so a
/// caller continuation ending in EOF gates correctly. `tokens` is the bare
/// `kinds` array (`&p.kinds` on the parse side, the scan `kinds` array on the
/// scan side) — gating only reads token kinds, and a flat `&Array<i32>` keeps
/// scan frames a slot smaller than the `List` wrapper or `&TokenStream`
/// would, which matters for deeply recursive scan grammars.
pub global EMPTY_FOLLOW: List<List<i32>> = [];

/// Prepend a static local prefix to an inherited FOLLOW continuation.
/// Used for the `FollowArg::Combined` case: a callee at the current
/// rule's tail whose preceding local suffix is nullable, so its
/// continuation is `prefix` (the optional local elements' per-depth
/// first sets) followed by the caller's own `follow`. Bounded by
/// `FOLLOW_MASK_MAX_K` so the result stays small; the only
/// allocating point on a repaired path (the common Static/Forward
/// cases pass a reference directly).
pub fn follow_prepend(prefix: &List<List<i32>>, follow: &List<List<i32>>) -> List<List<i32>> {
    let mut combined: List<List<i32>> = [];
    for let depth of prefix {
        combined.push(*depth);
    }
    for let depth of follow {
        combined.push(*depth);
    }
    return combined;
}

pub fn follow_yields(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>>, eof_kind: i32) -> bool {
    if follow.is_empty() {
        return false;
    }
    for let mut d = 0; d < follow.len(); d += 1 {
        let set = &follow[d];
        if set.is_empty() {
            // No constraint at this depth — a vacuous match, keep going.
            continue;
        }
        let idx = pos + d;
        let kind = if idx < tokens.len() { tokens[idx] } else { eof_kind };
        let mut hit = false;
        for let t of set {
            if kind == *t {
                hit = true;
                break;
            }
        }
        if !hit {
            return false;
        }
    }
    return true;
}
//! Runtime ATN simulator (hybrid ALL(*)) — full-context SLL prediction.
//!
//! Emitted into a generated parser only when lowering saw a construct that
//! needs it (`GenContext::needs_atn`, today a non-greedy `??`). The
//! compiled fast path handles everything else, so this never runs on the
//! hot path.
//!
//! Full context without a per-call-site GIR<->ATN mapping: the caller passes
//! its current *rule-invocation stack* (a list of rule indices, cheaply
//! maintained by the rule-entry wrapper). When a config exhausts a rule it
//! branches into every ATN return-state where the caller rule invokes the
//! callee (rule-context precision). The bottom of a real stack is the start
//! rule, whose follow is EOF — so a config that returns past it accepts only
//! EOF (`ATN_ACCEPT_EOF`), not any token. An empty stack falls back to plain
//! SLL (rule-stop = wildcard follow).
//!
//! Clean-room: follows the published ALL(*) description, not ANTLR4 sources
//! (License hygiene, AGENTS.md). The wire-format constants below are the
//! single source of truth; the builder/serializer in `src/atn.wado` `use`s
//! them. The blob carries a version word `atn_decode` asserts.
//!
//! Prediction reads token kinds only, so the simulator takes the flat
//! `&Array<i32>` kinds array rather than the full `TokenStream` (or the
//! `List` wrapper) — this keeps scan frames a slot smaller, which matters
//! for deeply recursive grammars.

use { TreeMap } from "core:collections";

// ATN wire-format constants — the single source of truth for the serialized
// blob layout, shared by the builder/serializer in `src/atn.wado` (which
// `use`s these) and the decoder/simulator below. They live here, not in
// `atn.wado`, because this runtime is `#include_str`'d verbatim into every
// generated parser and so cannot import from the compiler crate — whereas
// the compiler crate is free to `use` the runtime. Bump `ATN_BLOB_VERSION`
// on any layout change so a stale committed blob fails loudly.
pub global ATN_BLOB_MAGIC: i32 = 0x47_41_54_4e;
pub global ATN_BLOB_VERSION: i32 = 2;

// State kinds. `atn_decode` copies every state's kind through verbatim and
// the simulator only interprets `RULE_STOP` / `BLOCK_START` / `BLOCK_END`,
// but the builder writes the full enumeration, so the whole set lives here
// to keep one numbering authority (no split-numbering hazard across files).
pub global ATN_BASIC: i32 = 1;
pub global ATN_RULE_START: i32 = 2;
pub global ATN_RULE_STOP: i32 = 3;
pub global ATN_BLOCK_START: i32 = 4;
pub global ATN_BLOCK_END: i32 = 5;
pub global ATN_STAR_LOOP_ENTRY: i32 = 6;
pub global ATN_STAR_LOOP_BACK: i32 = 7;
pub global ATN_PLUS_LOOP_BACK: i32 = 8;
pub global ATN_LOOP_END: i32 = 9;

// Transition kinds. `label`/`follow`/`prec` carry kind-specific data
// (see `AtnTransition` in `atn.wado`).
pub global ATN_TR_EPSILON: i32 = 0;
pub global ATN_TR_ATOM: i32 = 1;
pub global ATN_TR_NOT_ATOM: i32 = 2;
pub global ATN_TR_WILDCARD: i32 = 3;
pub global ATN_TR_RULE: i32 = 4;
// Precedence-predicate edge `{prec_i >= pr}?`, emitted on a
// left-recursive rule's loop-entry decision (one per LR alt). `prec`
// carries the alt's own precedence (`prec_i`); the simulator compares it
// against the current min-prec context `pr` and prunes the edge when the
// predicate is false. Traversed like epsilon otherwise. Precedence
// evaluation itself lands in P4.3; until then closure walks it
// unconditionally (no LR grammar routes through the simulator yet).
pub global ATN_TR_PRECEDENCE: i32 = 5;

/// Sentinel "state": a config that has returned past the real stack bottom
/// and is viable only if the next token is EOF (the start rule's follow).
#[allow(dead_code)]
global ATN_ACCEPT_EOF: i32 = -2;

/// Safety caps for the merged closure. With graph-merged contexts the work is
/// polynomial for any finite input, so these are only tripped by pathological
/// epsilon-cycle grammars; on overflow the predictor bails to the lowest
/// viable alt (the same conservative answer as a true conflict). Generous so
/// realistic deep recursion never approximates.
#[allow(dead_code)]
global ATN_CLOSURE_GUARD: i32 = 2000000;
#[allow(dead_code)]
global ATN_ARENA_CAP: i32 = 400000;

/// Stride for `CtxArena::merge`'s pair-key packing (`lo * stride + hi`).
/// Must exceed `ATN_ARENA_CAP` so two distinct arena ids can never alias
/// onto the same key; kept comfortably above it.
global ATN_MERGE_CACHE_STRIDE: i64 = 1000000;

/// The decoded ATN, in struct-of-arrays form. Decoded once from the
/// serialized blob (into the module-level `ATN_SIM` in a generated
/// parser) and read (never mutated) during prediction.
pub struct AtnSim {
    pub state_kind: List<i32>,
    pub state_rule: List<i32>,
    pub state_decision: List<i32>,
    pub state_tr_start: List<i32>,
    pub state_tr_count: List<i32>,
    pub tr_kind: List<i32>,
    pub tr_target: List<i32>,
    pub tr_label: List<i32>,
    pub tr_follow: List<i32>,
    pub tr_prec: List<i32>,
    pub decision_state: List<i32>,
    pub rule_start: List<i32>,
    pub rule_stop: List<i32>,
    pub num_tokens: i32,
    /// Per-rule FIRST / nullability, computed once from the decoded ATN (not
    /// from the blob). `rule_nullable[r]` — can rule `r` derive empty;
    /// `rule_first[r]` — the explicit token kinds rule `r` can start with;
    /// `rule_first_neg[r]` — labels EXCLUDED by `~X` edges in rule `r`'s FIRST
    /// (a `~X` start admits any token but `X`); `rule_first_open[r]` — rule
    /// `r`'s FIRST admits a true wildcard `.`. Together these answer
    /// `atn_first_admits`. They drive the LR loop-entry decision's
    /// caller-mandatory check (`atn_lr_loop_decision`).
    pub rule_nullable: List<bool>,
    pub rule_first: List<List<i32>>,
    pub rule_first_neg: List<List<i32>>,
    pub rule_first_open: List<bool>,
}

/// Sentinel return state inside a `PredictionContext`: this branch's
/// during-prediction stack is empty, so a rule-stop reaching it falls back to
/// the caller stack (`rs` / `rule_stack`). Distinct from real ATN state ids
/// (>= 0) and from the -1 start-frame / -2 EOF markers used on `rule_stack`.
#[allow(dead_code)]
global CTX_BOUNDARY: i32 = -3;

/// The empty during-prediction context (no frames entered yet). A config with
/// `pctx == CTX_EMPTY` pops straight to the caller stack.
#[allow(dead_code)]
global CTX_EMPTY: i32 = 0;

/// Graph-structured during-prediction stack ("PredictionContext" DAG). Each
/// node is a *set* of edges `[return_state, restore_pr, parent]`; identical
/// edge-sets are hash-consed to one id, and configs reaching the same
/// `(state, alt, rs, pr)` via different stacks are merged by unioning their
/// contexts here. This collapses what would otherwise be an exponential number
/// of distinct list-stacks under deep left recursion into a polynomial DAG —
/// the core of the ALL(*) tractability guarantee. Built fresh per prediction.
///
/// `edges[id]` is the node's edge list; `edges[CTX_EMPTY]` is empty. `intern`
/// maps a canonical edge-set key to its id; `merge_cache` memoizes `merge`.
struct CtxArena {
    edges: List<List<[i32, i32, i32]>>,
    // Hash -> candidate node ids (collision buckets; edges compared on lookup).
    intern: TreeMap<i64, List<i32>>,
    merge_cache: TreeMap<i64, i32>,
}

/// One ATN configuration. `pctx` is the graph-structured during-prediction
/// stack (a `CtxArena` node id); `rs` indexes the caller's pre-existing parse
/// stack (the next outer frame to return into once `pctx` empties, or -1 for
/// SLL / exhausted). `pr` is the current min-precedence context.
struct AtnConfig {
    state: i32,
    alt: i32,
    pctx: i32,
    rs: i32,
    pr: i32,
}


impl CtxArena {
    fn new() -> CtxArena {
        // Node 0 = CTX_EMPTY (no edges).
        let empty: List<[i32, i32, i32]> = [];
        return CtxArena {
            edges: [empty],
            intern: TreeMap::<i64, List<i32>>::new(),
            merge_cache: TreeMap::<i64, i32>::new(),
        };
    }

    /// FNV-style hash of a sorted edge set (the interning key).
    fn hash_of(edges: &List<[i32, i32, i32]>) -> i64 {
        let mut h: i64 = 1469598103934665603;
        for let e of edges {
            h = (h ^ e.0 as i64 + 1) * 1099511628211;
            h = (h ^ e.1 as i64 + 1) * 1099511628211;
            h = (h ^ e.2 as i64 + 1) * 1099511628211;
        }
        return h & 4611686018427387903;
    }

    /// Intern a (already sorted, deduped) edge set, returning its node id.
    /// Collisions on the i64 hash are resolved by comparing edge lists.
    fn intern_edges(&mut self, sorted: &List<[i32, i32, i32]>) -> i32 {
        if sorted.is_empty() {
            return CTX_EMPTY;
        }
        let h = CtxArena::hash_of(sorted);
        if let Some(cands) = self.intern.get(h) {
            for let id of &cands {
                if edge_lists_eq(&self.edges[*id], sorted) {
                    return *id;
                }
            }
        }
        let id = self.edges.len();
        self.edges.push(*sorted);
        let mut cands = if let Some(c) = self.intern.get(h) {
            c;
        } else {
            [] as List<i32>;
        };
        cands.push(id);
        self.intern[h] = cands;
        return id;
    }

    /// Push a frame: a context with the single edge `(return_state, restore_pr,
    /// parent)`.
    fn push(&mut self, return_state: i32, restore_pr: i32, parent: i32) -> i32 {
        let one: List<[i32, i32, i32]> = [
            [return_state, restore_pr, parent],
        ];
        return self.intern_edges(&one);
    }

    /// The edge view of a node, treating `CTX_EMPTY` as a single boundary edge
    /// so it can be unioned with real frames during a merge.
    fn edges_view(&self, id: i32) -> List<[i32, i32, i32]> {
        if id == CTX_EMPTY {
            return [
                [CTX_BOUNDARY, 0, CTX_EMPTY],
            ];
        }
        return self.edges[id];
    }

    /// Merge two contexts into one whose branch-set is their union. Edges with
    /// the same `(return_state, restore_pr)` collapse, their parents merged
    /// recursively; memoized so the whole operation stays polynomial.
    fn merge(&mut self, a: i32, b: i32) -> i32 {
        if a == b {
            return a;
        }
        let lo = if a < b { a } else { b };
        let hi = if a < b { b } else { a };
        let ck = lo as i64 * ATN_MERGE_CACHE_STRIDE + hi as i64;
        if let Some(id) = self.merge_cache.get(ck) {
            return id;
        }
        let ea = self.edges_view(a);
        let eb = self.edges_view(b);
        // Group edges by (return_state, restore_pr), merging parents.
        let mut keys: List<[i32, i32]> = [];
        let mut parents: List<i32> = [];
        for let src of [&ea, &eb] {
            for let e of *src {
                let rk = [e.0, e.1];
                let mut found = -1;
                for let mut i = 0; i < keys.len(); i += 1 {
                    if keys[i].0 == rk.0 && keys[i].1 == rk.1 {
                        found = i;
                        break;
                    }
                }
                if found < 0 {
                    keys.push(rk);
                    parents.push(e.2);
                } else {
                    parents[found] = self.merge(parents[found], e.2);
                }
            }
        }
        let mut merged: List<[i32, i32, i32]> = [];
        for let mut i = 0; i < keys.len(); i += 1 {
            merged.push([keys[i].0, keys[i].1, parents[i]]);
        }
        sort_ctx_edges(&mut merged);
        let id = self.intern_edges(&merged);
        self.merge_cache[ck] = id;
        return id;
    }
}

/// Sort an edge list by (return_state, restore_pr, parent) so interning keys
/// are canonical regardless of insertion order.
#[allow(dead_code)]
fn sort_ctx_edges(edges: &mut List<[i32, i32, i32]>) {
    let n = edges.len();
    for let mut i = 1; i < n; i += 1 {
        let cur = edges[i];
        let mut j = i - 1;
        while j >= 0 && ctx_edge_gt(&edges[j], &cur) {
            edges[j + 1] = edges[j];
            j -= 1;
        }
        edges[j + 1] = cur;
    }
}

#[allow(dead_code)]
fn ctx_edge_gt(a: &[i32, i32, i32], b: &[i32, i32, i32]) -> bool {
    if a.0 != b.0 {
        return a.0 > b.0;
    }
    if a.1 != b.1 {
        return a.1 > b.1;
    }
    return a.2 > b.2;
}

/// Structural equality of two (sorted) edge lists, for interning-collision
/// disambiguation.
#[allow(dead_code)]
fn edge_lists_eq(a: &List<[i32, i32, i32]>, b: &List<[i32, i32, i32]>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for let mut i = 0; i < a.len(); i += 1 {
        if a[i].0 != b[i].0 || a[i].1 != b[i].1 || a[i].2 != b[i].2 {
            return false;
        }
    }
    return true;
}

/// Decode the serialized ATN blob into `AtnSim`. Mirrors the layout of
/// `atn.wado::serialize_atn`.
#[allow(dead_code)]
pub fn atn_decode(data: &List<i32>) -> AtnSim {
    let mut p = 0;
    let magic = data[p];
    p += 1;
    let version = data[p];
    p += 1;
    assert magic == ATN_BLOB_MAGIC, `ATN blob magic mismatch: {magic}`;
    assert version == ATN_BLOB_VERSION, `ATN blob version mismatch: {version}`;
    let num_tokens = data[p];
    p += 1;

    let nrules = data[p];
    p += 1;
    let mut rule_start: List<i32> = [];
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(data[p]);
        p += 1;
    }
    let mut rule_stop: List<i32> = [];
    for let mut i = 0; i < nrules; i += 1 {
        rule_stop.push(data[p]);
        p += 1;
    }
    let ndec = data[p];
    p += 1;
    let mut decision_state: List<i32> = [];
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(data[p]);
        p += 1;
    }

    let nstates = data[p];
    p += 1;
    let mut state_kind: List<i32> = [];
    let mut state_rule: List<i32> = [];
    let mut state_decision: List<i32> = [];
    let mut state_tr_start: List<i32> = [];
    let mut state_tr_count: List<i32> = [];
    let mut tr_kind: List<i32> = [];
    let mut tr_target: List<i32> = [];
    let mut tr_label: List<i32> = [];
    let mut tr_follow: List<i32> = [];
    let mut tr_prec: List<i32> = [];
    for let mut i = 0; i < nstates; i += 1 {
        let kind = data[p];
        p += 1;
        let rule = data[p];
        p += 1;
        let decision = data[p];
        p += 1;
        let ntrans = data[p];
        p += 1;
        state_kind.push(kind);
        state_rule.push(rule);
        state_decision.push(decision);
        state_tr_start.push(tr_kind.len());
        state_tr_count.push(ntrans);
        for let mut j = 0; j < ntrans; j += 1 {
            tr_kind.push(data[p]);
            p += 1;
            tr_target.push(data[p]);
            p += 1;
            tr_label.push(data[p]);
            p += 1;
            tr_follow.push(data[p]);
            p += 1;
            tr_prec.push(data[p]);
            p += 1;
        }
    }
    let nrules_count = rule_start.len();
    let mut sim = AtnSim {
        state_kind,
        state_rule,
        state_decision,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
        rule_stop,
        num_tokens,
        rule_nullable: [],
        rule_first: [],
        rule_first_neg: [],
        rule_first_open: [],
    };
    for let mut r = 0; r < nrules_count; r += 1 {
        sim.rule_nullable.push(false);
        sim.rule_first.push([]);
        sim.rule_first_neg.push([]);
        sim.rule_first_open.push(false);
    }
    // The FIRST/nullable fixpoint feeds only the LR loop-entry decision
    // (`atn_lr_loop_decision` / `atn_caller_mandates`), which exists solely
    // for rules with precedence edges. A grammar without any precedence edge
    // (e.g. one that needs the simulator only for a non-greedy `??`) never
    // reads this data, so skip the whole fixpoint there.
    let mut has_precedence = false;
    for let k of &sim.tr_kind {
        if *k == ATN_TR_PRECEDENCE {
            has_precedence = true;
            break;
        }
    }
    if has_precedence {
        atn_compute_first_nullable(&mut sim);
    }
    return sim;
}

/// Fill `rule_nullable` / `rule_first` / `rule_first_open` by a monotone
/// fixpoint over the ATN: each pass recomputes every rule's FIRST/nullable
/// from the current values (used for rule-ref edges), stopping when nothing
/// grows. Runs once at decode, and only when the ATN has precedence edges
/// (see `atn_decode`); the grammar (ATN) is constant so this is O(1) w.r.t.
/// input.
#[allow(dead_code)]
fn atn_compute_first_nullable(sim: &mut AtnSim) {
    let nrules = sim.rule_start.len();
    let mut changed = true;
    while changed {
        changed = false;
        for let mut r = 0; r < nrules; r += 1 {
            let mut v1: List<i32> = [];
            if atn_cont_nullable(sim, sim.rule_start[r], &mut v1) && !sim.rule_nullable[r] {
                sim.rule_nullable[r] = true;
                changed = true;
            }
            let mut v2: List<i32> = [];
            let mut f: List<i32> = [];
            let mut fneg: List<i32> = [];
            if atn_cont_first(sim, sim.rule_start[r], &mut v2, &mut f, &mut fneg) && !sim.rule_first_open[r] {
                sim.rule_first_open[r] = true;
                changed = true;
            }
            for let t of &f {
                if !sim.rule_first[r].contains(t) {
                    sim.rule_first[r].push(*t);
                    changed = true;
                }
            }
            for let x of &fneg {
                if !sim.rule_first_neg[r].contains(x) {
                    sim.rule_first_neg[r].push(*x);
                    changed = true;
                }
            }
        }
    }
}

/// True iff the continuation from `state` to its rule's `RULE_STOP` can be
/// empty (derive no token). Uses `sim.rule_nullable` for rule-ref edges;
/// `visited` breaks within-rule cycles (a re-entered state adds no new
/// nullability).
#[allow(dead_code)]
fn atn_cont_nullable(sim: &AtnSim, state: i32, visited: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return true;
    }
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_nullable(sim, sim.tr_target[s + j], visited) {
                return true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 && sim.rule_nullable[callee] && atn_cont_nullable(sim, sim.tr_follow[s + j], visited) {
                return true;
            }
        }
    }
    return false;
}

/// Collect the explicit FIRST token kinds of the continuation from `state`
/// into `out`, and the labels EXCLUDED by `~X` (`NOT_ATOM`) edges into `neg`
/// (a `~X` edge matches any token except `X`). Returns `open` (true only for
/// a true wildcard `.`, which matches any token). A token `t` is admitted by
/// this FIRST iff `atn_first_admits(out, open, neg, t, eof)`.
/// Stops at consuming atoms (their label is the FIRST; no walk past them).
/// Uses `sim.rule_first` / `rule_first_open` / `rule_first_neg` /
/// `rule_nullable` for rule-ref edges; `visited` breaks within-rule cycles.
///
/// Precedence edges (an LR rule's loop entry) are walked like epsilon: when
/// the rule's atom prefix is nullable the rule can begin with a loop operator,
/// so those operator tokens belong in the rule's FIRST. (For the common
/// non-nullable atom the walk stops at the atom before ever reaching the loop
/// entry, so no operator enters FIRST.)
#[allow(dead_code)]
fn atn_cont_first(sim: &AtnSim, state: i32, visited: &mut List<i32>, out: &mut List<i32>, neg: &mut List<i32>) -> bool {
    if visited.contains(&state) {
        return false;
    }
    visited.push(state);
    if sim.state_kind[state] == ATN_RULE_STOP {
        return false;
    }
    let mut open = false;
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_ATOM {
            if !out.contains(&sim.tr_label[s + j]) {
                out.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_WILDCARD {
            open = true;
        } else if k == ATN_TR_NOT_ATOM {
            if !neg.contains(&sim.tr_label[s + j]) {
                neg.push(sim.tr_label[s + j]);
            }
        } else if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_first(sim, sim.tr_target[s + j], visited, out, neg) {
                open = true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 {
                for let t of &sim.rule_first[callee] {
                    if !out.contains(t) {
                        out.push(*t);
                    }
                }
                for let x of &sim.rule_first_neg[callee] {
                    if !neg.contains(x) {
                        neg.push(*x);
                    }
                }
                if sim.rule_first_open[callee] {
                    open = true;
                }
                if sim.rule_nullable[callee] && atn_cont_first(sim, sim.tr_follow[s + j], visited, out, neg) {
                    open = true;
                }
            }
        }
    }
    return open;
}

/// Whether the FIRST set described by (`out`, `open`, `neg`) admits token `t`:
/// an explicit atom match, a true wildcard, or a `~X` exclusion whose excluded
/// label is not `t` (matching `atn_move`'s `token != label && token != eof`).
#[allow(dead_code)]
fn atn_first_admits(out: &List<i32>, open: bool, neg: &List<i32>, t: i32, eof: i32) -> bool {
    if open && t != eof {
        return true;
    }
    if out.contains(&t) {
        return true;
    }
    if t != eof {
        for let x of neg {
            if *x != t {
                return true;
            }
        }
    }
    return false;
}

/// True when `state`'s outgoing edges consume a token (atom / wildcard /
/// not-atom). Such a state is a resting point: closure stops there and
/// `atn_move` reads the edge. Epsilon / rule states are expanded instead.
#[allow(dead_code)]
fn atn_state_consumes(sim: &AtnSim, state: i32) -> bool {
    let cnt = sim.state_tr_count[state];
    if cnt == 0 {
        return false;
    }
    let k = sim.tr_kind[sim.state_tr_start[state]];
    return k == ATN_TR_ATOM || k == ATN_TR_NOT_ATOM || k == ATN_TR_WILDCARD;
}

/// A merged configuration set: at most one config per `(state, alt, rs, pr)`,
/// its `pctx` the merged graph context of every path that reached it. This
/// collapse is what bounds the closure to polynomial size under deep left
/// recursion (instead of one config per distinct list-stack). Keyed by a
/// string for O(log n) lookup.
struct CfgSet {
    state: List<i32>,
    alt: List<i32>,
    rs: List<i32>,
    pr: List<i32>,
    pctx: List<i32>,
    index: TreeMap<i64, i32>,
}


impl CfgSet {
    fn new() -> CfgSet {
        return CfgSet {
            state: [],
            alt: [],
            rs: [],
            pr: [],
            pctx: [],
            index: TreeMap::<i64, i32>::new(),
        };
    }

    /// Merge `(state, alt, rs, pr, pctx)` in. Returns `[index, changed]` where
    /// `changed` is true iff the stored pctx grew (a fresh key always counts).
    fn add(&mut self, arena: &mut CtxArena, state: i32, alt: i32, rs: i32, pr: i32, pctx: i32) -> [i32, bool] {
        // Packed i64 key (avoids per-config string allocation on the hot
        // closure path). Each field gets a power-of-two bit slot, offset by
        // its -2/-1 sentinel so the value stays non-negative:
        //   pr    : bits [0,11)  (×1)            — precedence level
        //   alt   : bits [11,22) (×2^11 = 2048)  — alternative index
        //   rs    : bits [22,42) (×2^22)         — caller-stack depth
        //   state : bits [42,62) (×2^42)         — ATN state id
        // The slots are far wider than anything reachable: `pr`/`alt` admit
        // ~2046 (a rule never has thousands of precedence levels or alts),
        // `rs` ~1M caller frames (the wasm stack overflows in the low
        // thousands first), `state` ~1M states. The asserts document the
        // encoding capacity and fail loudly rather than let a field overflow
        // its slot and alias a *different* config onto the same key.
        assert pr + 2 < 2048, `ATN config precedence {pr} exceeds packed-key slot`;
        assert alt + 1 < 2048, `ATN config alt {alt} exceeds packed-key slot`;
        assert rs + 2 < 1048576, `ATN config caller-stack depth {rs} exceeds packed-key slot`;
        assert state + 2 < 1048576, `ATN config state {state} exceeds packed-key slot`;
        let k = (state + 2) as i64 * 4398046511104 + (rs + 2) as i64 * 4194304 + (alt + 1) as i64 * 2048 + (pr + 2) as i64;
        if let Some(i) = self.index.get(k) {
            let merged = arena.merge(self.pctx[i], pctx);
            let changed = merged != self.pctx[i];
            self.pctx[i] = merged;
            return [i, changed];
        }
        let i = self.state.len();
        self.state.push(state);
        self.alt.push(alt);
        self.rs.push(rs);
        self.pr.push(pr);
        self.pctx.push(pctx);
        self.index[k] = i;
        return [i, true];
    }

    fn to_list(&self) -> List<AtnConfig> {
        let mut out: List<AtnConfig> = [];
        for let mut i = 0; i < self.state.len(); i += 1 {
            out.push(AtnConfig {
                state: self.state[i],
                alt: self.alt[i],
                pctx: self.pctx[i],
                rs: self.rs[i],
                pr: self.pr[i],
            });
        }
        return out;
    }
}

/// Closure of a seed set with graph-merged contexts. Resting configs
/// (consuming states; rule-stop "at-end"; `ATN_ACCEPT_EOF`) are returned;
/// epsilon / precedence / rule-ref edges are followed, rule-stops pop the
/// graph context (then the caller stack `rstk` once the context empties).
/// Configs reaching the same `(state, alt, rs, pr)` are merged, so the work
/// stays polynomial under deep left recursion (the recursion is input-driven
/// — an LR operand is only reached after consuming its operator token — so
/// the context depth is bounded by the input, no cyclic-context handling is
/// needed; the guards below are a safety net for pathological epsilon cycles).
#[allow(dead_code)]
fn atn_closure(sim: &AtnSim, arena: &mut CtxArena, seeds: &List<AtnConfig>, rstk: &List<i32>) -> List<AtnConfig> {
    let mut cset = CfgSet::new();
    let mut expanded: List<i32> = [];
    let mut rset = CfgSet::new();
    let mut work: List<AtnConfig> = *seeds;
    let mut guard = 0;
    while let Some(c) = work.pop() {
        guard += 1;
        if guard > ATN_CLOSURE_GUARD {
            break;
        }
        let res = cset.add(arena, c.state, c.alt, c.rs, c.pr, c.pctx);
        let idx = res.0;
        while expanded.len() <= idx {
            expanded.push(-9);
        }
        let merged_pctx = cset.pctx[idx];
        if expanded[idx] == merged_pctx {
            continue;
        }
        expanded[idx] = merged_pctx;
        let cur = AtnConfig { state: c.state, alt: c.alt, pctx: merged_pctx, rs: c.rs, pr: c.pr };
        atn_expand(sim, arena, &cur, rstk, &mut work, &mut rset);
    }
    return rset.to_list();
}

/// Expand one (merged) config: rest it (consuming / at-end / EOF) or push its
/// epsilon / precedence / rule-ref successors onto `work`.
#[allow(dead_code)]
fn atn_expand(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if cur.state == ATN_ACCEPT_EOF {
        rset.add(arena, cur.state, cur.alt, cur.rs, cur.pr, cur.pctx);
        return;
    }
    if sim.state_kind[cur.state] == ATN_RULE_STOP {
        atn_pop(sim, arena, cur, rstk, work, rset);
        return;
    }
    if atn_state_consumes(sim, cur.state) {
        rset.add(arena, cur.state, cur.alt, cur.rs, cur.pr, cur.pctx);
        return;
    }
    let start = sim.state_tr_start[cur.state];
    let cnt = sim.state_tr_count[cur.state];
    for let mut j = 0; j < cnt; j += 1 {
        let k = sim.tr_kind[start + j];
        let target = sim.tr_target[start + j];
        if k == ATN_TR_EPSILON {
            work.push(AtnConfig { state: target, alt: cur.alt, pctx: cur.pctx, rs: cur.rs, pr: cur.pr });
        } else if k == ATN_TR_PRECEDENCE {
            // Loop-entry predicate `{prec_i >= pr}?`: prune below the context.
            if sim.tr_prec[start + j] >= cur.pr {
                work.push(AtnConfig { state: target, alt: cur.alt, pctx: cur.pctx, rs: cur.rs, pr: cur.pr });
            }
        } else if k == ATN_TR_RULE {
            if target < 0 || arena.edges.len() >= ATN_ARENA_CAP {
                continue;
            }
            // A recursive operand `expr[next_i]` carries its raised floor on
            // the RuleRef `prec`; push a frame saving the current `pr`.
            let npctx = arena.push(sim.tr_follow[start + j], cur.pr, cur.pctx);
            work.push(AtnConfig { state: target, alt: cur.alt, pctx: npctx, rs: cur.rs, pr: sim.tr_prec[start + j] });
        }
    }
}

/// Pop a rule-stop: follow each graph-context edge back to its caller frame;
/// a boundary edge (or an empty context) falls through to the pre-existing
/// caller stack `rstk` via `atn_rs_pop`.
#[allow(dead_code)]
fn atn_pop(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if cur.pctx == CTX_EMPTY {
        atn_rs_pop(arena, cur.state, cur.alt, cur.rs, cur.pr, rstk, work, rset);
        return;
    }
    let edges = arena.edges[cur.pctx];
    for let e of &edges {
        if e.0 == CTX_BOUNDARY {
            atn_rs_pop(arena, cur.state, cur.alt, cur.rs, cur.pr, rstk, work, rset);
        } else {
            work.push(AtnConfig { state: e.0, alt: cur.alt, pctx: e.2, rs: cur.rs, pr: e.1 });
        }
    }
}

/// Return into the pre-existing caller stack once the during-prediction
/// context is exhausted. Mirrors the exact-return-state semantics: continue
/// at `rstk[rs]`; the bottom start frame's follow is EOF; an unstamped /
/// SLL frame matches any follow (the rule-stop stays "at-end").
#[allow(dead_code)]
fn atn_rs_pop(
    arena: &mut CtxArena,
    stop_state: i32,
    alt: i32,
    rs: i32,
    pr: i32,
    rstk: &List<i32>,
    work: &mut List<AtnConfig>,
    rset: &mut CfgSet,
) {
    if rs >= 0 {
        let ret = rstk[rs];
        if ret >= 0 {
            work.push(AtnConfig { state: ret, alt: alt, pctx: CTX_EMPTY, rs: rs - 1, pr: pr });
        } else if rs == 0 {
            rset.add(arena, ATN_ACCEPT_EOF, alt, -1, pr, CTX_EMPTY);
        } else {
            rset.add(arena, stop_state, alt, rs, pr, CTX_EMPTY);
        }
    } else if rstk.is_empty() {
        rset.add(arena, stop_state, alt, rs, pr, CTX_EMPTY);
    } else {
        rset.add(arena, ATN_ACCEPT_EOF, alt, -1, pr, CTX_EMPTY);
    }
}

/// Advance a resting config set by one input token. At-end and accept-EOF
/// configs carry only when still viable; consuming configs follow whichever
/// edge matches `token`.
#[allow(dead_code)]
fn atn_move(sim: &AtnSim, configs: &List<AtnConfig>, token: i32, eof: i32) -> List<AtnConfig> {
    let mut out: List<AtnConfig> = [];
    for let c of configs {
        if c.state == ATN_ACCEPT_EOF {
            if token == eof {
                out.push(*c);
            }
            continue;
        }
        if sim.state_kind[c.state] == ATN_RULE_STOP {
            out.push(*c);
            continue;
        }
        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let label = sim.tr_label[start + j];
            let matched = if k == ATN_TR_ATOM {
                label == token;
            } else if k == ATN_TR_WILDCARD {
                token != eof;
            } else if k == ATN_TR_NOT_ATOM {
                token != label && token != eof;
            } else {
                false;
            };
            if matched {
                out.push(AtnConfig { state: sim.tr_target[start + j], alt: c.alt, pctx: c.pctx, rs: c.rs, pr: c.pr });
            }
        }
    }
    return out;
}

#[allow(dead_code)]
fn atn_unique_alts(configs: &List<AtnConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return alts;
}

#[allow(dead_code)]
fn atn_min_alt(alts: &List<i32>) -> i32 {
    if alts.is_empty() {
        return -1;
    }
    let mut m = alts[0];
    for let a of alts {
        if *a < m {
            m = *a;
        }
    }
    return m;
}

#[allow(dead_code)]
fn atn_all_at_end(sim: &AtnSim, configs: &List<AtnConfig>) -> bool {
    if configs.is_empty() {
        return false;
    }
    for let c of configs {
        if c.state != ATN_ACCEPT_EOF && sim.state_kind[c.state] != ATN_RULE_STOP {
            return false;
        }
    }
    return true;
}

/// Predict the winning alternative at `decision` against `tokens` from
/// `start_pos`, with full context: `rule_stack` is the caller's current
/// chain of ATN return states (outermost — the start-rule frame — first).
/// Pass an empty `rule_stack` for plain SLL. `min_prec` is the current
/// precedence context `pr`: a loop-entry edge `{prec_i >= pr}?` whose
/// `prec_i < min_prec` is pruned (left/right-associative precedence
/// climbing). Returns the 0-based alternative index (the decision state's
/// edge order), or -1 if no alternative is viable.
///
/// Resolution: simulate until one alt survives (return it), the config set
/// empties (return the previous step's lowest alt), or all survivors are
/// at-end together (a genuine conflict — return the lowest alt, matching
/// ANTLR4's rule-order tie-break; non-greedy repeats order their exit edge
/// first so this yields the exit).
#[allow(dead_code)]
pub fn atn_predict_with_stack(
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let start = sim.state_tr_start[dstate];
    let cnt = sim.state_tr_count[dstate];
    let rs_init = rule_stack.len() - 1;
    // Fresh context arena per prediction: a persistent per-Parser arena
    // measured slower (it accumulates contexts, growing the intern buckets),
    // and full-context LR results aren't memoizable (the context encodes the
    // whole nesting depth).
    let mut arena = CtxArena::new();
    let mut seeds: List<AtnConfig> = [];
    for let mut j = 0; j < cnt; j += 1 {
        // Prune a precedence-guarded enter edge whose alt precedence is below
        // the current context (the predicate `{prec_i >= min_prec}?` is false).
        if sim.tr_kind[start + j] == ATN_TR_PRECEDENCE && sim.tr_prec[start + j] < min_prec {
            continue;
        }
        seeds.push(AtnConfig { state: sim.tr_target[start + j], alt: j, pctx: CTX_EMPTY, rs: rs_init, pr: min_prec });
    }
    let mut configs = atn_closure(sim, &mut arena, &seeds, rule_stack);
    let mut pos = start_pos;
    let mut prev = atn_unique_alts(&configs);
    let limit = tokens.len() - start_pos + 8;
    let mut guard = 0;
    loop {
        guard += 1;
        if guard > limit {
            return atn_min_alt(&prev);
        }
        let alts = atn_unique_alts(&configs);
        if alts.is_empty() {
            return atn_min_alt(&prev);
        }
        if alts.len() == 1 {
            return alts[0];
        }
        if atn_all_at_end(sim, &configs) {
            return atn_min_alt(&alts);
        }
        prev = alts;
        let token = if pos < tokens.len() { tokens[pos] } else { eof };
        let moved = atn_move(sim, &configs, token, eof);
        pos += 1;
        configs = atn_closure(sim, &mut arena, &moved, rule_stack);
    }
}

/// Decide an LR rule's loop-entry: ENTER alt `j` (continue the loop with
/// operator alt `j`) or EXIT (the trailing exit-edge index `c - 1`). This is
/// the LR loop-entry's true semantics — precedence + yield-to-caller-mandatory
/// — computed directly, not by general ALL(*) simulation (which is correct but
/// O(n^2) here because the exit branch re-walks the whole enclosing-loop
/// caller chain). O(caller-depth + grammar) per decision.
///
/// 1. If the current token is MANDATORY in the caller continuation (the first
///    non-nullable level of the caller return-state stack), EXIT — the caller
///    needs it (`between`'s mandatory `'and'`).
/// 2. Else the lowest-index precedence-allowed (`prec >= min_prec`) enter edge
///    whose suffix can start with the token wins (greedy; left-associativity
///    falls out of the precedence prune).
/// 3. Else EXIT.
#[allow(dead_code)]
pub fn atn_lr_loop_decision(
    sim: &AtnSim,
    rule_stack: &List<i32>,
    decision: i32,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let t = if pos < tokens.len() { tokens[pos] } else { eof };
    let s = sim.state_tr_start[dstate];
    let c = sim.state_tr_count[dstate];
    let exit_alt = c - 1;
    if atn_caller_mandates(sim, rule_stack, t, eof) {
        return exit_alt;
    }
    for let mut j = 0; j < c; j += 1 {
        if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE {
            if sim.tr_prec[s + j] < min_prec {
                continue;
            }
            let mut v: List<i32> = [];
            let mut f: List<i32> = [];
            let mut fneg: List<i32> = [];
            let open = atn_cont_first(sim, sim.tr_target[s + j], &mut v, &mut f, &mut fneg);
            if atn_first_admits(&f, open, &fneg, t, eof) {
                return j;
            }
        }
    }
    return exit_alt;
}

/// True iff the caller continuation MANDATES token `t`: walking the caller
/// return-state stack from the top, pop nullable continuations (optional
/// loops / nullable tails), and at the first non-nullable level test whether
/// its FIRST admits `t`. The start frame (-1 at index 0) mandates EOF.
#[allow(dead_code)]
fn atn_caller_mandates(sim: &AtnSim, rule_stack: &List<i32>, t: i32, eof: i32) -> bool {
    let mut i = rule_stack.len() - 1;
    while i >= 0 {
        let ret = rule_stack[i];
        if ret < 0 {
            return i == 0 && t == eof;
        }
        let mut v: List<i32> = [];
        if atn_cont_nullable(sim, ret, &mut v) {
            i -= 1;
            continue;
        }
        let mut v2: List<i32> = [];
        let mut f: List<i32> = [];
        let mut fneg: List<i32> = [];
        let open = atn_cont_first(sim, ret, &mut v2, &mut f, &mut fneg);
        return atn_first_admits(&f, open, &fneg, t, eof);
    }
    return false;
}

/// SLL convenience wrapper: predict with an empty rule stack. Correct for
/// top-level decisions; deeper decisions whose disambiguation depends on the
/// caller's follow need `atn_predict_with_stack` with the real rule stack.
#[allow(dead_code)]
pub fn atn_adaptive_predict(sim: &AtnSim, decision: i32, tokens: &Array<i32>, start_pos: i32, eof: i32) -> i32 {
    let empty: List<i32> = [];
    return atn_predict_with_stack(sim, decision, &empty, tokens, start_pos, eof);
}

/// Decide whether a non-greedy optional (`(...)?? `) should ENTER (consume
/// its body) or SKIP, using full-context ATN prediction. `current_rule` (a
/// compile-time constant the emitter passes) names the rule the `??` lives
/// in; the decision is that rule's unique exit-first BlockStart (an optional
/// whose edge 0 goes straight to BlockEnd — the non-greedy ordering).
/// `rule_stack` is the caller stack of ATN return states. Returns true to
/// ENTER.
///
/// Falls back to ENTER (the prior greedy behaviour) when context is absent
/// or the decision can't be uniquely identified (0 or >1 candidates), so a
/// mapping miss degrades gracefully instead of mispredicting.
#[allow(dead_code)]
pub fn atn_ng_optional_enter(
    sim: &AtnSim,
    current_rule: i32,
    rule_stack: &List<i32>,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
) -> bool {
    // `current_rule` is the rule the `??` lives in (a compile-time constant
    // the emitter passes): the caller stack now holds ATN return states, so
    // the current rule is no longer recoverable from its top.
    let rule = current_rule;
    let mut dec = -1;
    let mut found = 0;
    for let mut d = 0; d < sim.decision_state.len(); d += 1 {
        let ds = sim.decision_state[d];
        if sim.state_kind[ds] != ATN_BLOCK_START || sim.state_rule[ds] != rule {
            continue;
        }
        if sim.state_tr_count[ds] < 1 {
            continue;
        }
        let first_target = sim.tr_target[sim.state_tr_start[ds]];
        if sim.state_kind[first_target] == ATN_BLOCK_END {
            dec = d;
            found += 1;
        }
    }
    if found != 1 {
        return true;
    }
    let alt = atn_predict_with_stack(sim, dec, rule_stack, tokens, pos, eof);
    // Non-greedy optional edges are ordered [exit=0, enter=1].
    return alt == 1;
}
//! Runtime lexer ATN simulator — Pike-VM (leftmost-first) NFA matching.
//!
//! Emitted into a generated lexer only for ATN-class lexer rules: a rule
//! whose non-greedy repeat body recurses into itself, the nested-comment
//! pattern `CMT : '/*' (CMT | .)+? '*' '/'`. Static single-pass lexing
//! cannot decide whether an inner `/*` opens a nested rule or is just
//! wildcard text — that needs unbounded lookahead. This simulator runs a
//! Thompson NFA over the input characters with an ordered thread list
//! (leftmost-first / PCRE priority): no backtracking, linear in the
//! live thread-set per position.
//!
//! Semantics (matches ANTLR4 as a black box, characterized via the
//! published jar — see License hygiene in AGENTS.md): the winning match
//! is the one reached by the highest-priority thread, where priority is
//! the order transitions are laid down at build time — non-greedy loops
//! put the exit edge first, alternations keep source order. A
//! higher-priority thread that is still live preempts a lower-priority
//! thread's earlier accept, so greedy loops yield the longest match and
//! non-greedy loops the shortest that still lets the rule finish.
//!
//! Clean-room: textbook Thompson / Pike VM (ordered thread list, epsilon
//! closure with a per-step visited set, char-class move), NOT ANTLR4's
//! lexer ATN simulator. The atom alphabet is Unicode scalars; recursion
//! into a referenced lexer rule uses a per-thread return stack of ATN
//! states.

use { TreeSet } from "core:collections";

/// One NFA thread parked at an actionable state: either a consuming state
/// (its transitions are atom/wildcard, read by the move step) or an accept
/// marker (the start rule's stop reached with an empty return stack).
struct LThread {
    state: i32,
    stack: List<i32>,
    accept: bool,
}

/// Canonical key for the per-step visited set: the state plus its return
/// stack. `#` separates the state from the stack and `,` separates frames
/// so distinct (state, stack) pairs never collide (`1#2,3` vs `12#3`).
fn latn_sig(state: i32, stack: &List<i32>) -> String {
    let mut s = `{state}#`;
    for let mut i = 0; i < stack.len(); i += 1 {
        if i > 0 {
            s.push_str(&",");
        }
        s.push_str(&`{stack[i]}`);
    }
    return s;
}

/// Epsilon-closure of `(state, stack)`, appending every reachable
/// actionable thread to `out` in priority (transition) order. `visited`
/// dedups by (state, stack) so epsilon cycles terminate. A `RULE`
/// transition pushes its return state and jumps to the callee start; a
/// `RULE_STOP` pops (or accepts when the stack is empty).
fn latn_closure(sim: &AtnSim, out: &mut List<LThread>, visited: &mut TreeSet<String>, state: i32, stack: &List<i32>) {
    let key = latn_sig(state, stack);
    if visited.contains(key) {
        return;
    }
    visited.insert(key);

    if sim.state_kind[state] == ATN_RULE_STOP {
        if stack.is_empty() {
            out.push(LThread { state, stack: [], accept: true });
        } else {
            let ret = stack[stack.len() - 1];
            let mut rest: List<i32> = [];
            for let mut i = 0; i < stack.len() - 1; i += 1 {
                rest.push(stack[i]);
            }
            latn_closure(sim, out, visited, ret, &rest);
        }
        return;
    }

    let ts = sim.state_tr_start[state];
    let tc = sim.state_tr_count[state];
    if tc > 0 {
        let k0 = sim.tr_kind[ts];
        if k0 == ATN_TR_ATOM || k0 == ATN_TR_NOT_ATOM || k0 == ATN_TR_WILDCARD {
            out.push(LThread { state, stack: *stack, accept: false });
            return;
        }
    }
    for let mut i = 0; i < tc; i += 1 {
        let idx = ts + i;
        let target = sim.tr_target[idx];
        if sim.tr_kind[idx] == ATN_TR_RULE {
            if target < 0 {
                // Unresolved rule reference — a dead edge, skip it.
                continue;
            }
            let mut ns: List<i32> = *stack;
            ns.push(sim.tr_follow[idx]);
            latn_closure(sim, out, visited, target, &ns);
        } else {
            latn_closure(sim, out, visited, target, stack);
        }
    }
}

/// Match lexer rule `start_rule` against `chars` starting at `start`.
/// Returns the end position (exclusive) of the winning match, or -1 if the
/// rule does not match. The caller (the generated tokenizer) compares this
/// length against the other rules' for the cross-rule longest-match.
pub fn latn_match(sim: &AtnSim, start_rule: i32, chars: &List<char>, start: i32) -> i32 {
    let mut best = -1;
    let mut clist: List<LThread> = [];
    let mut seed = TreeSet::<String>::new();
    let empty: List<i32> = [];
    latn_closure(sim, &mut clist, &mut seed, sim.rule_start[start_rule], &empty);

    let mut pos = start;
    loop {
        let cur = if pos < chars.len() { chars[pos] as i32 } else { -1 };
        let mut nlist: List<LThread> = [];
        let mut nseen = TreeSet::<String>::new();
        let mut i = 0;
        let mut stop = false;
        while i < clist.len() && !stop {
            let th = &clist[i];
            if th.accept {
                // Highest-priority surviving accept at this position wins;
                // lower-priority threads after it are discarded. Threads
                // before it (higher priority, still consuming) already fed
                // `nlist` and may overwrite `best` with a longer match.
                best = pos;
                stop = true;
            } else {
                let ts = sim.state_tr_start[th.state];
                let tc = sim.state_tr_count[th.state];
                for let mut j = 0; j < tc; j += 1 {
                    let idx = ts + j;
                    let kind = sim.tr_kind[idx];
                    let matched = if cur < 0 {
                        false;
                    } else if kind == ATN_TR_ATOM {
                        cur >= sim.tr_label[idx] && cur <= sim.tr_follow[idx];
                    } else if kind == ATN_TR_WILDCARD {
                        true;
                    } else if kind == ATN_TR_NOT_ATOM {
                        cur != sim.tr_label[idx];
                    } else {
                        false;
                    };
                    if matched {
                        latn_closure(sim, &mut nlist, &mut nseen, sim.tr_target[idx], &th.stack);
                    }
                }
            }
            i += 1;
        }
        clist = nlist;
        if clist.is_empty() {
            break;
        }
        pos += 1;
    }
    return best;
}
