fn _parse_block__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<(), ParseError> {
    let start = p.peek_start();
    let lparen = p.expect(TK_LPAREN)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.kinds;
