        p.push_rule_stack("block");
    }
}

fn _parse_ruleref__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let rule_ref = p.expect(TK_RULE_REF, &SYNC_22);
    if !(follow_yields(&p.kinds, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_BEGIN_ARGUMENT) {
        let arg_action_block = _parse_arg_action_block(p, &EMPTY_FOLLOW);
    }
    if !(follow_yields(&p.kinds, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_LT) {
        let element_options = _parse_element_options(p, &EMPTY_FOLLOW);
    }
    return;
}

fn _parse_ruleref(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
