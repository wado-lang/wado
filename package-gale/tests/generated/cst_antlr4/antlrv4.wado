fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser) -> Result<(), ParseError>) -> ParseResult {
    let _ = max_errors;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    let _r = entry(&mut p);
    if let Err(e) = _r {
        let e = if let Some(_d) = &p.pending { if _d.span.start >= e.span.start { *_d } else { e } } else { e };
        let lc = line_col(p.tokens.chars, e.span.start);
        let mut d = Diagnostic::error(DiagnosticCode::UnexpectedToken, e.message, e.span, lc.0, lc.1);
        d.rule_stack = e.rule_stack;
        p.diagnostics.push(d);
    }
    return ParseResult { root: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_grammar_spec(input, max_errors);
}

pub fn parse_grammar_spec(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_grammar_spec(p));
}

