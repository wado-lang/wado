    UNTERMINATED_ARGUMENT,
    ARGUMENT_CONTENT,
    LEXER_CHAR_SET_BODY,
    LEXER_CHAR_SET,
    UNTERMINATED_CHAR_SET,
    ARG_ACTION,  // virtual
    ARG_OR_CHARSET,  // virtual
    RULE_REF,  // virtual
