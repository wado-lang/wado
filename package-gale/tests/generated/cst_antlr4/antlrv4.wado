            let mut _sd_best_p: i32 = -1;
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_p_2 > _sd_best_p {
                _sd_best_p = _sd_p_2;
                _sd_best_i = 2;
            }
            if _sd_best_i == 1 {
