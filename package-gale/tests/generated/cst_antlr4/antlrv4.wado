struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, b: TreeBuilder::new(), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
        }
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32) -> Result<i32, ParseError> {
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return Result::Ok(self.pos);
            }
            let _i = self.advance();
            self.b.token(_i);
            return Result::Ok(_i);
        }
        let name = token_kind_name(kind);
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<i32, ParseError> {
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<i32, ParseError> {
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return Result::Ok(_i);
        }
        return Result::Err(self.error(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                let _i = self.advance();
                self.b.token(_i);
                return Result::Ok(_i);
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    self.b.token(self.pos);
                    return Result::Ok(self.pos);
                }
                let _i = self.advance();
                self.b.token(_i);
                return Result::Ok(_i);
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["token set"],
        ));
    }
}

fn scan_grammar_spec(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_grammar_decl(tokens, pos, &FOLLOW_MASK_0, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _kind_set_0(tokens[pos]) {
        let sp = pos;
        pos = scan_prequel_construct(tokens, pos, &EMPTY_FOLLOW, 0);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    pos = scan_rules(tokens, pos, &FOLLOW_MASK_1, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_MODE {
        let sp = pos;
        pos = scan_mode_spec(tokens, pos, &EMPTY_FOLLOW, 0);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_grammar_decl(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_grammar_type(tokens, pos, &FOLLOW_MASK_2, 0);
    if pos < 0 { return -1; }
    pos = scan_identifier(tokens, pos, &FOLLOW_MASK_3, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_SEMI { return -1; }
    pos += 1;
    return pos;
}

fn scan_grammar_type(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LEXER {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos] != TK_LEXER { break try_0; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_GRAMMAR { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_PARSER {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos] != TK_PARSER { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_GRAMMAR { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_GRAMMAR {
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos] != TK_GRAMMAR { break try_2; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_prequel_construct(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_OPTIONS {
            pos = start;
            try_0: {
                pos = scan_options_spec(tokens, pos, follow, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_IMPORT {
            pos = start;
            try_1: {
                pos = scan_delegate_grammars(tokens, pos, follow, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_TOKENS {
            pos = start;
            try_2: {
                pos = scan_tokens_spec(tokens, pos, follow, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_CHANNELS {
            pos = start;
            try_3: {
                pos = scan_channels_spec(tokens, pos, follow, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_AT {
            pos = start;
            try_4: {
                pos = scan_action_(tokens, pos, follow, 0);
                if pos < 0 { break try_4; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_options_spec(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_OPTIONS { return -1; }
    pos += 1;
    while pos < tokens.len() && _kind_set_1(tokens[pos]) {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                pos = scan_option(tokens, pos, &FOLLOW_MASK_3, 0);
                if pos < 0 { break sg_0; }
                if pos >= tokens.len() || tokens[pos] != TK_SEMI { break sg_0; }
                pos += 1;
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_RBRACE { return -1; }
    pos += 1;
    return pos;
}

fn scan_option(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_identifier(tokens, pos, &FOLLOW_MASK_4, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_ASSIGN { return -1; }
