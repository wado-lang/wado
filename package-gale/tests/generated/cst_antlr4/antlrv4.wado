pub fn to_string_tree(result: &ParseResult) -> String {
    let mut token_names: List<String> = List::with_capacity(82);
    for let mut k = 0; k < 82; k += 1 {
        token_names.push(token_kind_name(k));
    }
    return result.root.to_string_tree(&result.tokens, &GALE_RULE_NAMES, &token_names);
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut token_names: List<String> = List::with_capacity(82);
    for let mut k = 0; k < 82; k += 1 {
        token_names.push(token_kind_name(k));
    }
    let mut _kind: i32 = -1;
    for let mut i = 0; i < GALE_RULE_NAMES.len(); i += 1 {
        if GALE_RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if let Some(sub) = result.root.find_child(_kind as NodeKind) {
        return sub.to_string_tree(&result.tokens, &GALE_RULE_NAMES, &token_names);
    }
    return String::new();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_AT | TK_CHANNELS | TK_IMPORT | TK_OPTIONS | TK_TOKENS };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_RULE_REF | TK_TOKEN_REF };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_LEXER | TK_PARSER | TK_RULE_REF | TK_TOKEN_REF };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_FRAGMENT | TK_TOKEN_REF };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_FRAGMENT | TK_PRIVATE | TK_PROTECTED | TK_PUBLIC | TK_RULE_REF | TK_TOKEN_REF };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_FRAGMENT | TK_PRIVATE | TK_PROTECTED | TK_PUBLIC };
}

fn _gale_kind_set_6(k: i32) -> bool {
    return k matches { TK_AT | TK_OPTIONS };
}

fn _gale_kind_set_7(k: i32) -> bool {
    return k matches { TK_ACTION | TK_DOT | TK_LEXER_CHAR_SET | TK_LPAREN | TK_NOT | TK_STRING_LITERAL | TK_TOKEN_REF };
}

fn _gale_kind_set_8(k: i32) -> bool {
    return k matches { TK_DOT | TK_LEXER_CHAR_SET | TK_NOT | TK_STRING_LITERAL | TK_TOKEN_REF };
}

fn _gale_kind_set_9(k: i32) -> bool {
    return k matches { TK_PLUS | TK_QUESTION | TK_STAR };
}

fn _gale_kind_set_10(k: i32) -> bool {
