fn atn_decide_58(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            TK_RULE_REF | TK_TOKEN_REF => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        TK_COMMA | TK_GT | TK_DOT => {
                            return 0;
                        },
                        TK_ASSIGN => {
                            if pos + 2 < tokens.len() {
                                match tokens[pos + 2] {
                                    TK_INT | TK_STRING_LITERAL | TK_RULE_REF | TK_TOKEN_REF => {
                                        return 0;
                                    },
                                    TK_ACTION => {
                                        return 1;
                                    },
                                    _ => {},
                                };
                            }
                        },
                        _ => {},
