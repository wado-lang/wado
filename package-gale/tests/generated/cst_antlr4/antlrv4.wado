    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' | '\u{c}' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_25 = pos;
        rep_25: {
            if pos >= chars.len() { break rep_25; }
            if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' | '\u{c}' })) { break rep_25; }
            pos += 1;
            continue;
        }
        pos = rep_saved_25;
        break;
    }
    return pos;
}

fn try_NESTED_ARGUMENT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '[' { return -1; }
    pos += 1;
    return pos;
}

fn try_ARGUMENT_ESCAPE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\\' { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    pos += 1;
    return pos;
}

fn try_ARGUMENT_STRING_LITERAL(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '"' { return -1; }
    pos += 1;
    loop {
        let ng_saved_27 = pos;
        let mut ng_exit_27 = false;
        ng_27: {
            if pos >= chars.len() || chars[pos] != '"' { break ng_27; }
            pos += 1;
            ng_exit_27 = true;
        }
        if ng_exit_27 {
            break;
        }
        pos = ng_saved_27;
        let alts_saved_28 = pos;
        alts_done_28: {
            alts_28_0: {
                pos = alts_saved_28;
                if pos >= chars.len() || chars[pos] != '\\' { break alts_28_0; }
                pos += 1;
                let alts_saved_29 = pos;
                alts_done_29: {
                    alts_29_0: {
                        pos = alts_saved_29;
                        if pos >= chars.len() { break alts_29_0; }
                        if !((chars[pos] matches { 'b' | 't' | 'n' | 'f' | 'r' | '"' | '\'' | '\\' })) { break alts_29_0; }
                        pos += 1;
                        break alts_done_29;
                    }
                    alts_29_1: {
                        pos = alts_saved_29;
                        if pos >= chars.len() || chars[pos] != 'u' { break alts_29_1; }
                        pos += 1;
                        let opt_saved_30 = pos;
                        let mut opt_ok_30 = false;
                        opt_30: {
                            if pos >= chars.len() { break opt_30; }
                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_30; }
                            pos += 1;
                            let opt_saved_31 = pos;
                            let mut opt_ok_31 = false;
                            opt_31: {
                                if pos >= chars.len() { break opt_31; }
                                if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_31; }
                                pos += 1;
                                let opt_saved_32 = pos;
                                let mut opt_ok_32 = false;
                                opt_32: {
                                    if pos >= chars.len() { break opt_32; }
                                    if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_32; }
                                    pos += 1;
                                    let opt_saved_33 = pos;
                                    let mut opt_ok_33 = false;
                                    opt_33: {
                                        if pos >= chars.len() { break opt_33; }
                                        if !((chars[pos] matches { '0'..='9' | 'A'..='F' | 'a'..='f' })) { break opt_33; }
                                        pos += 1;
                                        opt_ok_33 = true;
                                    }
                                    if !opt_ok_33 { pos = opt_saved_33; }
                                    opt_ok_32 = true;
                                }
                                if !opt_ok_32 { pos = opt_saved_32; }
                                opt_ok_31 = true;
                            }
                            if !opt_ok_31 { pos = opt_saved_31; }
                            opt_ok_30 = true;
                        }
                        if !opt_ok_30 { pos = opt_saved_30; }
                        break alts_done_29;
                    }
                    alts_29_2: {
                        pos = alts_saved_29;
                        if pos >= chars.len() { break alts_29_2; }
                        pos += 1;
                        break alts_done_29;
                    }
                    alts_29_3: {
                        pos = alts_saved_29;
                        if pos < chars.len() { break alts_29_3; }
                        break alts_done_29;
                    }
                    break alts_28_0;
                }
                break alts_done_28;
            }
            alts_28_1: {
                pos = alts_saved_28;
                if pos >= chars.len() { break alts_28_1; }
                if (chars[pos] matches { '"' | '\r' | '\n' | '\\' }) { break alts_28_1; }
                pos += 1;
                break alts_done_28;
            }
            return -1;
        }
    }
    return pos;
}

fn try_ARGUMENT_CHAR_LITERAL(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    pos = try_STRING_LITERAL(chars, pos);
    if pos < 0 { return -1; }
    return pos;
}

