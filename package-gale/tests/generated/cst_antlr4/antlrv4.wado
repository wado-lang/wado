        if pos < tokens.len() && tokens[pos] == TK_OPTIONS {
            let sp = pos;
            pos = scan_options_spec(tokens, pos, &EMPTY_FOLLOW, 0);
            if pos < 0 { pos = sp; }
        }
        while pos < tokens.len() && tokens[pos] == TK_AT {
            let sp = pos;
            pos = scan_rule_action(tokens, pos, &EMPTY_FOLLOW, 0);
            if pos < 0 { pos = sp; break; }
            if pos == sp { break; }
        }
        if pos >= tokens.len() || tokens[pos] != TK_COLON { break opt_scan; }
        pos += 1;
        opt_scan_pos = pos;
    }
    if opt_scan_pos >= 0 {
        if p.peek_kind() == TK_OPTIONS {
            let options_spec = _parse_options_spec(p, &EMPTY_FOLLOW)?;
        }
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                pos = scan_rule_action(tokens, pos, &EMPTY_FOLLOW, 0);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 {
                if p.peek_kind() == TK_AT {
                    let _rec_pos = p.pos;
                    let _rec_cp = p.b.checkpoint();
                    if let Err(_rec_e) = _parse_rule_action(p, &EMPTY_FOLLOW) { p.record_deeper(_rec_e); }
                    p.pos = _rec_pos;
                    p.b.truncate(_rec_cp);
