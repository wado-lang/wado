                break;
            }
            let rule_action = _parse_rule_action(p, &EMPTY_FOLLOW)?;
        }
        let colon = p.expect(TK_COLON)?;
    }
    let alt_list = _parse_alt_list(p, &FOLLOW_MASK_9)?;
    let rparen = p.expect(TK_RPAREN)?;
    return Result::Ok(());
}

