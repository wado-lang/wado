pub global RK_RULE_PREQUEL: NodeKind = 23;
pub global RK_RULE_RETURNS: NodeKind = 24;
pub global RK_THROWS_SPEC: NodeKind = 25;
pub global RK_LOCALS_SPEC: NodeKind = 26;
pub global RK_RULE_ACTION: NodeKind = 27;
pub global RK_RULE_MODIFIERS: NodeKind = 28;
pub global RK_RULE_MODIFIER: NodeKind = 29;
pub global RK_RULE_BLOCK: NodeKind = 30;
pub global RK_RULE_ALT_LIST: NodeKind = 31;
pub global RK_LABELED_ALT: NodeKind = 32;
pub global RK_LEXER_RULE_SPEC: NodeKind = 33;
pub global RK_LEXER_RULE_BLOCK: NodeKind = 34;
pub global RK_LEXER_ALT_LIST: NodeKind = 35;
pub global RK_LEXER_ALT: NodeKind = 36;
pub global RK_LEXER_ELEMENTS: NodeKind = 37;
pub global RK_LEXER_ELEMENT: NodeKind = 38;
pub global RK_LEXER_BLOCK: NodeKind = 39;
pub global RK_LEXER_COMMANDS: NodeKind = 40;
pub global RK_LEXER_COMMAND: NodeKind = 41;
pub global RK_LEXER_COMMAND_NAME: NodeKind = 42;
pub global RK_LEXER_COMMAND_EXPR: NodeKind = 43;
pub global RK_ALT_LIST: NodeKind = 44;
pub global RK_ALTERNATIVE: NodeKind = 45;
pub global RK_ELEMENT: NodeKind = 46;
pub global RK_PREDICATE_OPTIONS: NodeKind = 47;
pub global RK_PREDICATE_OPTION: NodeKind = 48;
pub global RK_LABELED_ELEMENT: NodeKind = 49;
pub global RK_EBNF: NodeKind = 50;
pub global RK_BLOCK_SUFFIX: NodeKind = 51;
pub global RK_EBNF_SUFFIX: NodeKind = 52;
pub global RK_LEXER_ATOM: NodeKind = 53;
pub global RK_ATOM: NodeKind = 54;
pub global RK_WILDCARD: NodeKind = 55;
pub global RK_NOT_SET: NodeKind = 56;
pub global RK_BLOCK_SET: NodeKind = 57;
pub global RK_SET_ELEMENT: NodeKind = 58;
pub global RK_BLOCK: NodeKind = 59;
pub global RK_RULEREF: NodeKind = 60;
pub global RK_CHARACTER_RANGE: NodeKind = 61;
pub global RK_TERMINAL_DEF: NodeKind = 62;
