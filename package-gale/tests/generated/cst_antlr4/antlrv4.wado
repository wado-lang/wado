fn _parse_terminal_def__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_TOKEN_REF {
        let token_ref = p.expect(TK_TOKEN_REF, &SYNC_18);
        if !(follow_yields(&p.kinds, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_LT) {
            let element_options = _parse_element_options(p, &EMPTY_FOLLOW);
        }
        return;
    }
    if kind == TK_STRING_LITERAL {
        let string_literal = p.expect(TK_STRING_LITERAL, &SYNC_18);
        if !(follow_yields(&p.kinds, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_LT) {
            let element_options = _parse_element_options(p, &EMPTY_FOLLOW);
        }
        return;
    }
    p.no_viable(
        "expected terminalDef",
        p.peek_span(),
        ["TK_TOKEN_REF", "TK_STRING_LITERAL"],
    );
    return;
}

fn _parse_terminal_def(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_TERMINALDEF, _start);
    _parse_terminal_def__inner(p, follow);
    p.b.finish_node(p.last_end());
