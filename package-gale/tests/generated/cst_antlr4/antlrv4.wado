fn _parse_element_options__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let lt = p.expect(TK_LT, &SYNC_3);
    let element_option = _parse_element_option(p, &FOLLOW_MASK_11);
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_32_done: {
                sg_32: {
                    if pos >= tokens.len() || tokens[pos] != TK_COMMA { break sg_32; }
                    pos += 1;
                    pos = scan_element_option(tokens, pos, follow, 0);
                    if pos < 0 { break sg_32; }
                    break sg_32_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_COMMA, &SYNC_3);
        let element_option = _parse_element_option(p, follow);
    }
    let gt = p.expect(TK_GT, &EMPTY_SYNC);
    return;
}

fn _parse_element_options(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_ELEMENTOPTIONS, _start);
    _parse_element_options__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("elementOptions");
    }
}

fn _parse_element_option__inner_alt_0(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let qualified_identifier = _parse_qualified_identifier(p, follow);
    return;
}

fn _parse_element_option__inner_scan_0(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_qualified_identifier(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn _parse_element_option__inner_alt_1(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let identifier = _parse_identifier(p, &FOLLOW_MASK_4);
    let assign = p.expect(TK_ASSIGN, &SYNC_25);
    let grp_kind = p.peek_kind();
    if _kind_set_1(grp_kind) {
        let qualified_identifier = _parse_qualified_identifier(p, follow);
    } else if grp_kind == TK_STRING_LITERAL {
        let string_literal = p.expect(TK_STRING_LITERAL, &EMPTY_SYNC);
    } else if grp_kind == TK_INT {
        let int = p.expect(TK_INT, &EMPTY_SYNC);
    }
    return;
}

fn _parse_element_option__inner_scan_1(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_identifier(tokens, pos, &FOLLOW_MASK_4, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_ASSIGN { return -1; }
    pos += 1;
    let gp_33 = pos;
    let sgk_33 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if _kind_set_17(sgk_33) {
        sg_33: {
            pos = gp_33;
            sg_33_0: {
                pos = scan_qualified_identifier(tokens, pos, follow, 0);
                if pos < 0 { break sg_33_0; }
                break sg_33;
            }
            pos = gp_33;
            sg_33_1: {
                if pos >= tokens.len() || tokens[pos] != TK_STRING_LITERAL { break sg_33_1; }
                pos += 1;
                break sg_33;
            }
            pos = gp_33;
            sg_33_2: {
                if pos >= tokens.len() || tokens[pos] != TK_INT { break sg_33_2; }
                pos += 1;
                break sg_33;
            }
            pos = gp_33;
        }
    }
    return pos;
}

fn _parse_element_option__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let kind = p.peek_kind();
    if _kind_set_1(kind) {
        if _kind_set_1(p.peek_kind()) {
            let _sd_tokens = &p.kinds;
            let _sd_pos = p.pos;
            let _sd_p_0 = _parse_element_option__inner_scan_0(_sd_tokens, _sd_pos);
            let _sd_p_1 = _parse_element_option__inner_scan_1(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_0 > _sd_best_p {
                _sd_best_p = _sd_p_0;
                _sd_best_i = 0;
            }
            if _sd_p_1 > _sd_best_p {
                _sd_best_p = _sd_p_1;
                _sd_best_i = 1;
            }
            if _sd_best_i == 0 {
                return _parse_element_option__inner_alt_0(p, follow);
            }
            if _sd_best_i == 1 {
                return _parse_element_option__inner_alt_1(p, follow);
            }
            return _parse_element_option__inner_alt_1(p, follow);
        }
    }
    p.no_viable(
        "expected elementOption",
        p.peek_span(),
        ["TK_RULE_REF", "TK_TOKEN_REF"],
    );
    return;
}

fn _parse_element_option(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
