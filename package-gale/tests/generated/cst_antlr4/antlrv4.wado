fn atn_decide_52(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            TK_STRING_LITERAL | TK_DOT | TK_NOT => {
                return 1;
            },
            TK_ACTION => {
                return 3;
            },
            TK_LPAREN => {
                return 2;
            },
            TK_RULE_REF => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        TK_STRING_LITERAL | TK_BEGIN_ARGUMENT | TK_ACTION | TK_SEMI | TK_LPAREN | TK_RPAREN | TK_LT | TK_QUESTION | TK_STAR | TK_PLUS | TK_OR | TK_DOT | TK_POUND | TK_NOT | TK_RULE_REF | TK_TOKEN_REF => {
                            return 1;
                        },
                        TK_ASSIGN | TK_PLUS_ASSIGN => {
                            return 0;
                        },
                        _ => {},
                    };
                }
            },
            TK_TOKEN_REF => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        TK_STRING_LITERAL | TK_ACTION | TK_SEMI | TK_LPAREN | TK_RPAREN | TK_LT | TK_QUESTION | TK_STAR | TK_PLUS | TK_OR | TK_DOT | TK_POUND | TK_NOT | TK_RULE_REF | TK_TOKEN_REF => {
                            return 1;
                        },
                        TK_ASSIGN | TK_PLUS_ASSIGN => {
                            return 0;
                        },
                        _ => {},
                    };
                }
            },
            _ => {},
        };
    }
    return atn_predict_once(&ATN_SIM, 52, atn, tokens, pos, TK_EOF, min_prec);
}

