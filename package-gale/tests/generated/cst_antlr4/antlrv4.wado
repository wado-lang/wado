    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_ELEMENT_OPTION, _start);
    _parse_element_option__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_ELEMENT_OPTION, "elementOption", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn _parse_identifier__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_6, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_6, &EXPECTED_6); }
    let kind = p.peek_kind();
    if _kind_set_2(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of identifier matches",
        p.peek_span(),
        &EXPECTED_6,
    );
    return;
}

fn _parse_identifier(p: &mut Parser) -> () {
    let _atn_ret = p.atn_ret_pending;
