fn _parse_grammar_spec__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<(), ParseError> {
    let start = p.peek_start();
    let grammar_decl = _parse_grammar_decl(p, &FOLLOW_MASK_0)?;
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_prequel_construct(tokens, pos, &EMPTY_FOLLOW, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 {
            if _gale_kind_set_0(p.peek_kind()) {
                let _rec_pos = p.pos;
                let _rec_cp = p.b.checkpoint();
                if let Err(_rec_e) = _parse_prequel_construct(p, &EMPTY_FOLLOW) { p.record_deeper(_rec_e); }
                p.pos = _rec_pos;
                p.b.truncate(_rec_cp);
            }
            break;
        }
        let prequel_construct = _parse_prequel_construct(p, &EMPTY_FOLLOW)?;
    }
    let rules = _parse_rules(p, &FOLLOW_MASK_1)?;
    loop {
        let mut rep_scan_pos_2: i32 = -1;
        rep_scan_2: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_mode_spec(tokens, pos, &EMPTY_FOLLOW, 0);
            if pos < 0 { break rep_scan_2; }
            if pos <= p.pos { break rep_scan_2; }
            rep_scan_pos_2 = pos;
        }
        if rep_scan_pos_2 < 0 {
            if p.peek_kind() == TK_MODE {
                let _rec_pos = p.pos;
                let _rec_cp = p.b.checkpoint();
                if let Err(_rec_e) = _parse_mode_spec(p, &EMPTY_FOLLOW) { p.record_deeper(_rec_e); }
                p.pos = _rec_pos;
                p.b.truncate(_rec_cp);
            }
            break;
        }
        let mode_spec = _parse_mode_spec(p, &EMPTY_FOLLOW)?;
    }
    let eof = p.expect(TK_EOF)?;
    return Result::Ok(());
}

fn _parse_grammar_spec(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<(), ParseError> {
    let _start = p.peek_start();
    p.b.start_node(RK_GRAMMARSPEC, _start);
    let r = _parse_grammar_spec__inner(p, follow);
    p.b.finish_node(p.last_end());
    if let Err(mut e) = r {
        e.rule_stack.push("grammarSpec");
        return Result::Err(e);
    }
    return Result::Ok(());
}

