fn scan_option_value(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_1(alt_kind) {
            pos = start;
            try_0: {
                pos = scan_identifier(tokens, pos, follow, 0);
                if pos < 0 { break try_0; }
                while pos < tokens.len() && tokens[pos] == TK_DOT && !(follow_yields(tokens, pos, follow, TK_EOF)) {
                    let sp = pos;
                    sg_1_done: {
                        sg_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_DOT { break sg_1; }
                            pos += 1;
                            pos = scan_identifier(tokens, pos, follow, 0);
                            if pos < 0 { break sg_1; }
                            break sg_1_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; break; }
                    if pos == sp { break; }
                }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_STRING_LITERAL {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos] != TK_STRING_LITERAL { break try_1; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_ACTION {
            pos = start;
            try_2: {
                pos = scan_action_block(tokens, pos, follow, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_INT {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos] != TK_INT { break try_3; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_delegate_grammars(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_IMPORT { return -1; }
    pos += 1;
    pos = scan_delegate_grammar(tokens, pos, &FOLLOW_MASK_5, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_COMMA {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                if pos >= tokens.len() || tokens[pos] != TK_COMMA { break sg_2; }
                pos += 1;
                pos = scan_delegate_grammar(tokens, pos, follow, 0);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_SEMI { return -1; }
    pos += 1;
    return pos;
}

fn scan_delegate_grammar(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_1(alt_kind) {
            let mut best: i32 = -1;
            pos = start;
            try_1: {
                pos = scan_identifier(tokens, pos, follow, 0);
                if pos < 0 { break try_1; }
                if pos > best { best = pos; }
            }
            pos = start;
            try_0: {
                pos = scan_identifier(tokens, pos, &FOLLOW_MASK_4, 0);
                if pos < 0 { break try_0; }
                if pos >= tokens.len() || tokens[pos] != TK_ASSIGN { break try_0; }
                pos += 1;
                pos = scan_identifier(tokens, pos, follow, 0);
                if pos < 0 { break try_0; }
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_tokens_spec(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_TOKENS { return -1; }
    pos += 1;
    if pos < tokens.len() && _kind_set_1(tokens[pos]) {
        let sp = pos;
        pos = scan_id_list(tokens, pos, &EMPTY_FOLLOW, 0);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_RBRACE { return -1; }
    pos += 1;
