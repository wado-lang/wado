pub fn to_string_tree(result: &ParseResult) -> String {
    let mut token_names: List<String> = List::with_capacity(82);
    for let mut k = 0; k < 82; k += 1 {
        token_names.push(token_kind_name(k));
    }
    return result.root.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut token_names: List<String> = List::with_capacity(82);
    for let mut k = 0; k < 82; k += 1 {
        token_names.push(token_kind_name(k));
    }
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if let Some(sub) = result.root.find_child(_kind as NodeKind) {
        return sub.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_AT | TK_CHANNELS | TK_IMPORT | TK_OPTIONS | TK_TOKENS };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_RULE_REF | TK_TOKEN_REF };
}

