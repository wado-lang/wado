}

fn try_LEXER_CHAR_SET_BODY(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_35 = pos;
    alts_done_35: {
        alts_35_0: {
            pos = alts_saved_35;
            if pos >= chars.len() { break alts_35_0; }
            if (chars[pos] matches { ']' | '\\' }) { break alts_35_0; }
            pos += 1;
            break alts_done_35;
        }
        alts_35_1: {
            pos = alts_saved_35;
            if pos >= chars.len() || chars[pos] != '\\' { break alts_35_1; }
            pos += 1;
            if pos >= chars.len() { break alts_35_1; }
            pos += 1;
            break alts_done_35;
        }
        return -1;
    }
    loop {
        let rep_saved_34 = pos;
        rep_34: {
            let alts_saved_37 = pos;
            alts_done_37: {
                alts_37_0: {
                    pos = alts_saved_37;
                    if pos >= chars.len() { break alts_37_0; }
                    if (chars[pos] matches { ']' | '\\' }) { break alts_37_0; }
                    pos += 1;
                    break alts_done_37;
                }
                alts_37_1: {
                    pos = alts_saved_37;
                    if pos >= chars.len() || chars[pos] != '\\' { break alts_37_1; }
                    pos += 1;
                    if pos >= chars.len() { break alts_37_1; }
                    pos += 1;
                    break alts_done_37;
                }
                break rep_34;
            }
            continue;
        }
        pos = rep_saved_34;
        break;
    }
    return pos;
}

fn try_LEXER_CHAR_SET(chars: &List<char>, start: i32) -> i32 {
