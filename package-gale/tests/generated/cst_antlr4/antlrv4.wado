use { HashMap, HashSet, HashSeed } from "core:collections";

// Grammar metadata from source .g4 prequels:
//   option superClass = LexerAdaptor (lexer)
//   option tokenVocab = ANTLRv4Lexer

pub struct Span {
    pub start: i32,
    pub end: i32,
}

impl Span {
    pub fn new(start: i32, end: i32) -> Span {
        return Span { start, end };
    }

    pub fn len(&self) -> i32 {
        return self.end - self.start;
    }
}

internal fn char_at(src: &StrSlice, pos: i32) -> char
    contract 0 <= pos < src.len()
{
    let b = unchecked src.byte_at(pos);
    if b < 0x80 {
        return b as char;
    }
    return src.char_at_byte(pos);
}

internal fn char_count(src: &StrSlice, start: i32, end: i32) -> i32
    contract 0 <= start <= end <= src.len()
{
    let mut n = 0;
    for let mut i = start; i < end; i += 1 {
        if src.is_char_boundary(i) {
            n += 1;
        }
    }
    return n;
}

internal fn span_text(src: &StrSlice, start: i32, end: i32) -> String {
    return src.slice(start, end).to_string();
}

internal fn push_escaped(out: &mut String, src: &StrSlice, start: i32, end: i32) {
    let mut run = start;
    for let mut i = start; i < end; i += 1 {
        let b = unchecked src.byte_at(i);
        if b matches { b'\n' | b'\r' | b'\t' } {
            out.push_str(unchecked src.slice(run, i));
            out.push_str(match b {
                b'\n' => "\\n",
                b'\r' => "\\r",
                _ => "\\t",
            });
            run = i + 1;
        }
    }
    out.push_str(unchecked src.slice(run, end));
}

internal fn kind_set_has(set: &List<i32>, kind: i32) -> bool {
    let w = kind >> 5;
    if w >= set.len() {
        return false;
    }
    return set[w] >> (kind & 31) & 1 == 1;
}

internal fn with_expected<S: AsStrSlice>(message: S, expected: &List<String>) -> String {
    let n = expected.len();
    if n == 0 {
        return message.to_string();
    }
    let mut out = String::with_capacity(n * 8 + message.len() + 11);
    out.push_str("expected ");
    for let mut i = 0; i < n; i += 1 {
        if i > 0 {
            out.push_str(&if i == n - 1 { " or " } else { ", " });
        }
        out.push_str(&expected[i]);
    }
    out.push_str("; ");
    out.push_str(message);
    return out;
}

internal fn char_pos_in_line(src: &StrSlice, pos: i32) -> i32 {
    let end = i32::min(pos, src.len());
    let mut line_start = end;
    while line_start > 0 && unchecked src.byte_at(line_start - 1) != b'\n' {
        line_start -= 1;
    }
    return char_count(src, line_start, end);
}

internal fn line_starts(src: &StrSlice) -> List<i32> {
    let mut starts: List<i32> = [0];
    for let mut i = 0; i < src.len(); i += 1 {
        if unchecked src.byte_at(i) == b'\n' {
            starts.push(i + 1);
        }
    }
    return starts;
}

internal fn line_at(starts: &List<i32>, pos: i32) -> i32 {
    let mut lo = 0;
    let mut hi = starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return lo + 1;
}

internal fn line_col_at(src: &StrSlice, starts: &List<i32>, pos: i32) -> [i32, i32] {
    let line = line_at(starts, pos);
    return [line, char_count(src, starts[line - 1], pos)];
}

pub flags TokenFlags {
    Synthetic,
    Skipped,
    LexError,
}

pub struct TokenStream {
    pub kinds: List<i32>,
    pub starts: List<i32>,
    pub ends: List<i32>,
    pub triv_lo: List<i32>,
    pub triv_hi: List<i32>,
    pub src: StrSlice,
    pub triv_kinds: List<i32>,
    pub triv_starts: List<i32>,
    pub triv_ends: List<i32>,
    pub triv_chans: List<i32>,
    pub flags: List<TokenFlags>,
    pub output: String = "",
}

impl TokenStream {
    internal fn new(src: StrSlice) -> TokenStream {
        let cap = src.len() / 4 + 1;
        return TokenStream {
            kinds: List::with_capacity(cap),
            starts: List::with_capacity(cap),
            ends: List::with_capacity(cap),
            triv_lo: List::with_capacity(cap),
            triv_hi: List::with_capacity(cap),
            src,
            triv_kinds: List::with_capacity(cap),
            triv_starts: List::with_capacity(cap),
            triv_ends: List::with_capacity(cap),
            triv_chans: List::with_capacity(cap),
            flags: List::with_capacity(cap),
        };
    }

    pub fn len(&self) -> i32 {
        return self.kinds.len();
    }

    internal fn trivia_mark(&self) -> i32 {
        return self.triv_kinds.len();
    }

    internal fn push_trivia(&mut self, kind: i32, start: i32, end: i32, channel: i32) {
        if self.triv_kinds.len() >= self.triv_kinds.capacity() {
            builtin::cold_path();
            self.triv_kinds.grow();
            self.triv_starts.grow();
            self.triv_ends.grow();
            self.triv_chans.grow();
            assert self.triv_starts.capacity() == self.triv_kinds.capacity()
                && self.triv_ends.capacity() == self.triv_kinds.capacity()
                && self.triv_chans.capacity() == self.triv_kinds.capacity(), "TokenStream trivia columns must grow in lockstep";
        }
        unchecked self.triv_kinds.push_within_capacity(kind);
        unchecked self.triv_starts.push_within_capacity(start);
        unchecked self.triv_ends.push_within_capacity(end);
        unchecked self.triv_chans.push_within_capacity(channel);
    }

    internal fn push_token(&mut self, kind: i32, start: i32, end: i32, triv_lo: i32, triv_hi: i32) {
        self.push_token_flagged(kind, start, end, triv_lo, triv_hi, TokenFlags::none());
    }

    internal fn push_token_flagged(
        &mut self,
        kind: i32,
        start: i32,
        end: i32,
        triv_lo: i32,
        triv_hi: i32,
        flags: TokenFlags,
    ) -> i32 {
        let idx = self.kinds.len();
        if idx >= self.kinds.capacity() {
            builtin::cold_path();
            self.kinds.grow();
            self.starts.grow();
            self.ends.grow();
            self.triv_lo.grow();
            self.triv_hi.grow();
            self.flags.grow();
            assert self.starts.capacity() == self.kinds.capacity()
                && self.ends.capacity() == self.kinds.capacity()
                && self.triv_lo.capacity() == self.kinds.capacity()
                && self.triv_hi.capacity() == self.kinds.capacity()
                && self.flags.capacity() == self.kinds.capacity(), "TokenStream token columns must grow in lockstep";
        }
        unchecked self.kinds.push_within_capacity(kind);
        unchecked self.starts.push_within_capacity(start);
        unchecked self.ends.push_within_capacity(end);
        unchecked self.triv_lo.push_within_capacity(triv_lo);
        unchecked self.triv_hi.push_within_capacity(triv_hi);
        unchecked self.flags.push_within_capacity(flags);
        return idx;
    }

    internal fn push_synthetic(&mut self, expected_kind: i32, at: i32) -> i32 {
        let m = self.trivia_mark();
        return self.push_token_flagged(expected_kind, at, at, m, m, TokenFlags::Synthetic);
    }

    pub fn flags_at(&self, i: i32) -> TokenFlags {
        return self.flags[i];
    }

    internal fn set_flag(&mut self, i: i32, flag: TokenFlags) {
        self.flags[i] |= flag;
    }

    internal fn mark_skipped(&mut self, i: i32) {
        self.set_flag(i, TokenFlags::Skipped);
    }

    pub fn is_synthetic(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Synthetic != TokenFlags::none();
    }

    pub fn is_skipped(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::Skipped != TokenFlags::none();
    }

    pub fn is_lex_error(&self, i: i32) -> bool {
        return self.flags[i] & TokenFlags::LexError != TokenFlags::none();
    }

    pub fn kind_at(&self, i: i32) -> i32 {
        return self.kinds[i];
    }

    pub fn span_at(&self, i: i32) -> Span {
        return Span::new(self.starts[i], self.ends[i]);
    }

    pub fn is_empty_text(&self, i: i32) -> bool {
        return self.starts[i] >= self.ends[i];
    }

    pub fn token_text(&self, i: i32) -> String {
        return span_text(&self.src, self.starts[i], self.ends[i]);
    }

    pub fn push_token_text(&self, out: &mut String, i: i32) {
        out.push_str(self.src.slice(self.starts[i], self.ends[i]));
    }

    pub fn push_token_text_escaped(&self, out: &mut String, i: i32) {
        push_escaped(out, &self.src, self.starts[i], self.ends[i]);
    }

    pub fn rule_text(&self, start_tok: i32, end_tok: i32) -> String {
        let mut out = String::new();
        for let mut i = start_tok; i <= end_tok; i += 1 {
            if i > start_tok {
                for let mut j = self.triv_lo[i]; j < self.triv_hi[i]; j += 1 {
                    if self.triv_chans[j] != 0 {
                        out.push_str(self.src.slice(self.triv_starts[j], self.triv_ends[j]));
                    }
                }
            }
            self.push_token_text(&mut out, i);
        }
        return out;
    }
}

pub enum Severity {
    Error,
}

impl Severity {
    pub fn label(&self) -> String {
        return match *self { Error => "error" };
    }
}

pub enum DiagnosticCode {
    UnexpectedToken,
    MissingToken,
    ExtraToken,
    NoViableAlternative,
    UnterminatedConstruct,
    LexError,
}

impl DiagnosticCode {
    pub fn name(&self) -> String {
        return match *self {
            UnexpectedToken => "unexpected-token",
            MissingToken => "missing-token",
            ExtraToken => "extra-token",
            NoViableAlternative => "no-viable-alternative",
            UnterminatedConstruct => "unterminated-construct",
            LexError => "lex-error",
        };
    }
}

pub enum RecoveryAction {
    Inserted,
    Deleted,
    SkippedTo,
    FilledMissing,
    None,
}

pub struct Diagnostic {
    pub severity: Severity = Severity::Error,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub expected: List<i32> = [],
    pub found: i32 = -1,
    pub rule_stack: List<String> = [],
    pub recovery: RecoveryAction = RecoveryAction::None,
}

impl Diagnostic {
    internal fn error<S: AsStrSlice>(
        code: DiagnosticCode,
        message: S,
        span: Span,
        expected: List<i32>,
        found: i32,
        recovery: RecoveryAction,
    ) -> Diagnostic {
        return Diagnostic { code, message: message.to_string(), span, expected, found, recovery };
    }

    pub fn is_error(&self) -> bool {
        return self.severity matches { Error };
    }

    pub fn rule_path(&self) -> String {
        let stack = &self.rule_stack;
        let mut out = String::with_capacity(stack.len() * 8);
        let n = stack.len();
        for let mut i = 0; i < n; i += 1 {
            let name = &stack[n - 1 - i];
            if i > 0 {
                if *name == stack[n - i] {
                    continue;
                }
                out.push_str(" > ");
            }
            out.push_str(name);
        }
        return out;
    }
}

impl Display for Diagnostic {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(`${self.severity.label()}[${self.code.name()}] at ${self.line}:${self.col}: ${self.message}`);
    }
}

fn lex_error_at(tokens: &TokenStream, i: i32) -> Diagnostic {
    let mut message = String::from("token recognition error at: '");
    push_escaped(&mut message, &tokens.src, tokens.starts[i], tokens.ends[i]);
    message.push('\'');
    return Diagnostic::error(
        DiagnosticCode::LexError,
        message,
        tokens.span_at(i),
        [],
        tokens.kinds[i],
        RecoveryAction::None,
    );
}

internal fn merge_lex_errors(tokens: &TokenStream, diagnostics: &mut List<Diagnostic>, max_errors: i32) {
    let mut merged: List<Diagnostic> = [];
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.is_lex_error(i) {
            merged.push(lex_error_at(tokens, i));
        }
    }
    merged.extend(diagnostics);
    merged.sort_by(|a: &Diagnostic, b: &Diagnostic| a.span.start.cmp(&b.span.start));
    merged.truncate(max_errors);
    *diagnostics = merged;
}

internal fn resolve_positions(diagnostics: &mut List<Diagnostic>, src: &StrSlice) {
    if diagnostics.is_empty() {
        return;
    }
    let starts = line_starts(src);
    for let mut i = 0; i < diagnostics.len(); i += 1 {
        let lc = line_col_at(src, &starts, diagnostics[i].span.start);
        diagnostics[i].line = lc.0;
        diagnostics[i].col = lc.1;
    }
}

pub type NodeKind = i32;

pub global K_ERROR: NodeKind = -1;

pub flags NodeFlags {
    Error,
    Incomplete,
}

pub enum EventTag {
    Open,
    Close,
    Tok,
    Miss,
    Skip,
}

pub struct CstStore {
    pub tag: List<EventTag>,
    pub id: List<i32>,
    pub offset: List<i32>,
    alt: List<i32>,
    end: List<i32>,
    flags: List<NodeFlags>,
    next: List<i32>,
}

pub enum ChildKind {
    Node,
    Token,
    Missing,
    Skipped,
}

impl CstStore {
    pub fn row_count(&self) -> i32 {
        return self.tag.len();
    }

    pub fn kind(&self, i: i32) -> NodeKind {
        return self.id[i] as NodeKind;
    }

    pub fn span(&self, i: i32) -> Span {
        return Span::new(self.offset[i], self.end[i]);
    }

    pub fn alt(&self, i: i32) -> i32 {
        return self.alt[i];
    }

    pub fn is_error(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Error != NodeFlags::none();
    }

    pub fn is_incomplete(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Incomplete != NodeFlags::none();
    }

    pub fn is_node(&self, i: i32) -> bool {
        return self.tag[i] matches { Open };
    }

    pub fn is_token(&self, i: i32) -> bool {
        return self.tag[i] matches { Tok | Miss | Skip };
    }

    pub fn child_kind(&self, i: i32) -> ChildKind {
        return match self.tag[i] {
            Open => ChildKind::Node,
            Miss => ChildKind::Missing,
            Skip => ChildKind::Skipped,
            Tok => ChildKind::Token,
            Close => panic("CstStore::child_kind: Close is not a child row"),
        };
    }

    pub fn token_index(&self, i: i32) -> i32 {
        return self.id[i];
    }

    pub fn first_child(&self, i: i32) -> i32 {
        let c = i + 1;
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn next_sibling(&self, child: i32) -> i32 {
        let c = if self.tag[child] matches { Open } { self.next[child] } else { child + 1 };
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn find_child(&self, i: i32, kind: NodeKind) -> i32 {
        let k = kind as i32;
        for let mut c = self.first_child(i); c >= 0; c = self.next_sibling(c) {
            if self.tag[c] matches { Open } && self.kind(c) as i32 == k {
                return c;
            }
        }
        return -1;
    }

    pub fn to_string_tree(
        &self,
        i: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(256);
        let _ = render_node(&mut out, &self.tag, &self.id, i, toks, rule_names, token_names);
        return out;
    }
}

pub struct ParseResult {
    pub cst: CstStore,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
    pub output: String = "",
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        return self.diagnostics.iter_ref().any(|d| d.is_error());
    }

    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

fn bubble_to_parent(stack: &List<i32>, end: &mut List<i32>, flags: &mut List<NodeFlags>, child: i32) {
    if stack.len() > 0 {
        let parent = stack[stack.len() - 1];
        if end[child] > end[parent] {
            end[parent] = end[child];
        }
        flags[parent] |= flags[child] & NodeFlags::Error;
    }
}

internal struct TreeBuilder {
    tag: List<EventTag>,
    id: List<i32>,
    offset: List<i32>,
    alt: List<i32>,
    open: List<i32>,
    last_finished: i32,
    error_row: i32,
}

impl TreeBuilder {
    internal fn with_capacity(rows: i32) -> TreeBuilder {
        return TreeBuilder {
            tag: List::with_capacity(rows),
            id: List::with_capacity(rows),
            offset: List::with_capacity(rows),
            alt: List::with_capacity(rows),
            open: [],
            last_finished: -1,
            error_row: -1,
        };
    }

    fn push_row(&mut self, tag: EventTag, id: i32, offset: i32) {
        if self.tag.len() >= self.tag.capacity() {
            builtin::cold_path();
            self.tag.grow();
            self.id.grow();
            self.offset.grow();
            self.alt.grow();
            assert self.id.capacity() == self.tag.capacity()
                && self.offset.capacity() == self.tag.capacity()
                && self.alt.capacity() == self.tag.capacity(), "TreeBuilder event columns must grow in lockstep";
        }
        unchecked self.tag.push_within_capacity(tag);
        unchecked self.id.push_within_capacity(id);
        unchecked self.offset.push_within_capacity(offset);
        unchecked self.alt.push_within_capacity(-1);
    }

    internal fn start_node(&mut self, kind: NodeKind, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, kind as i32, start);
        self.open.push(row);
    }

    internal fn start_error(&mut self, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, K_ERROR as i32, start);
        self.open.push(row);
    }

    internal fn set_alt(&mut self, alt: i32) {
        self.alt[self.open[self.open.len() - 1]] = alt;
    }

    internal fn checkpoint(&self) -> i32 {
        return self.tag.len();
    }

    internal fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32)
        contract self.innermost_open() < checkpoint, "a node wraps only rows finished before it"
    {
        self.tag.insert(checkpoint, EventTag::Open);
        self.id.insert(checkpoint, kind as i32);
        self.offset.insert(checkpoint, start);
        self.alt.insert(checkpoint, -1);
        self.open.push(checkpoint);
        if self.last_finished >= checkpoint {
            self.last_finished += 1;
        }
        if self.error_row >= checkpoint {
            self.error_row += 1;
        }
    }

    internal fn truncate(&mut self, checkpoint: i32) {
        self.tag.truncate(checkpoint);
        self.id.truncate(checkpoint);
        self.offset.truncate(checkpoint);
        self.alt.truncate(checkpoint);
        while self.open.len() > 0 && self.open[self.open.len() - 1] >= checkpoint {
            let _ = self.open.pop();
        }
        if self.last_finished >= checkpoint {
            self.last_finished = -1;
        }
        if self.error_row > checkpoint {
            self.error_row = checkpoint;
        }
    }

    internal fn finish_node(&mut self, end: i32) {
        let row = self.open[self.open.len() - 1];
        self.push_row(EventTag::Close, self.id[row], end);
        self.last_finished = row;
        let _ = self.open.pop();
    }

    internal fn innermost_open(&self) -> i32 {
        if self.open.is_empty() {
            return -1;
        }
        return self.open[self.open.len() - 1];
    }

    internal fn node_kind(&self, row: i32) -> NodeKind {
        return self.id[row] as NodeKind;
    }

    internal fn resume_node(&mut self, row: i32, end: i32) {
        while self.innermost_open() > row {
            self.finish_node(end);
        }
        if self.innermost_open() == row {
            return;
        }
        assert self.last_finished == row && self.tag[self.tag.len() - 1] matches { Close }, "resume_node: a node no longer open is the last one closed";
        self.truncate(self.tag.len() - 1);
        self.open.push(row);
    }

    internal fn mark_error(&mut self) {
        self.error_row = self.tag.len();
    }

    internal fn in_error_mode(&self) -> bool {
        if self.error_row < 0 {
            return false;
        }
        for let mut r = self.error_row; r < self.tag.len(); r += 1 {
            if self.tag[r] matches { Tok } {
                return false;
            }
        }
        return true;
    }

    internal fn push_open_rule_names(&self, rule_names: &List<String>, out: &mut List<String>) {
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            let kind = self.id[self.open[i]];
            if kind != K_ERROR as i32 {
                out.push(rule_names[kind]);
            }
        }
    }

    internal fn token(&mut self, idx: i32) {
        self.push_row(EventTag::Tok, idx, 0);
    }

    internal fn missing(&mut self, syn_idx: i32) {
        self.push_row(EventTag::Miss, syn_idx, 0);
    }

    internal fn skip(&mut self, idx: i32) {
        self.push_row(EventTag::Skip, idx, 0);
    }

    internal fn finish(&self) -> CstStore {
        let n = self.tag.len();
        let mut end = List::filled(n, 0);
        let mut flags = List::filled(n, NodeFlags::none());
        let mut next = List::filled(n, 0);
        let mut stack: List<i32> = [];
        for let mut r = 0; r < n; r += 1 {
            match self.tag[r] {
                Open => {
                    if self.id[r] == K_ERROR as i32 {
                        flags[r] = NodeFlags::Error;
                    }
                    end[r] = self.offset[r];
                    stack.push(r);
                },
                Miss => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Incomplete | NodeFlags::Error;
                },
                Skip => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] |= NodeFlags::Error;
                },
                Close => {
                    let oi = stack[stack.len() - 1];
                    let _ = stack.pop();
                    if self.offset[r] > end[oi] {
                        end[oi] = self.offset[r];
                    }
                    next[oi] = r + 1;
                    bubble_to_parent(&stack, &mut end, &mut flags, oi);
                },
                Tok => {
                },
            }
        }
        while stack.len() > 0 {
            let oi = stack[stack.len() - 1];
            let _ = stack.pop();
            next[oi] = n;
            bubble_to_parent(&stack, &mut end, &mut flags, oi);
        }
        return CstStore { tag: self.tag, id: self.id, offset: self.offset, alt: self.alt, end, flags, next };
    }

    internal fn render_open(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if self.open.len() == 0 {
            return String::new();
        }
        return self.render_from(self.open[self.open.len() - 1], toks, rule_names, token_names);
    }

    internal fn render_at(
        &self,
        row: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if row < 0 || row >= self.tag.len() || !self.tag[row] matches { Open } {
            return String::new();
        }
        return self.render_from(row, toks, rule_names, token_names);
    }

    internal fn open_rule_names(&self, rule_names: &List<String>) -> String {
        let mut out = String::from("[");
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            if i < self.open.len() - 1 {
                out.push_str(", ");
            }
            let kind = self.id[self.open[i]];
            let name = if kind == K_ERROR as i32 { "<error>" } else { rule_names[kind] };
            out.push_str(&name);
        }
        out.push_str("]");
        return out;
    }

    internal fn render_last_finished(
        &self,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if self.last_finished < 0 {
            return String::new();
        }
        return self.render_from(self.last_finished, toks, rule_names, token_names);
    }

    fn render_from(
        &self,
        root: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(128);
        let _ = render_node(&mut out, &self.tag, &self.id, root, toks, rule_names, token_names);
        return out;
    }
}

fn render_node(
    out: &mut String,
    tag: &List<EventTag>,
    id: &List<i32>,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) -> i32 {
    let name = if id[i] == K_ERROR as i32 { "<error>" } else { rule_names[id[i]] };
    if i + 1 >= tag.len() || tag[i + 1] matches { Close } {
        out.push_str(&name);
        if i + 1 < tag.len() {
            return i + 2;
        }
        return i + 1;
    }
    out.push_str("(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < tag.len() {
        match tag[c] {
            Open => {
                out.push_str(" ");
                c = render_node(out, tag, id, c, toks, rule_names, token_names);
            },
            Close => {
                out.push_str(")");
                return c + 1;
            },
            Tok => {
                if !toks.is_empty_text(id[c]) {
                    out.push_str(" ");
                    toks.push_token_text_escaped(out, id[c]);
                }
                c += 1;
            },
            Miss => {
                out.push_str(` <missing ${token_names[toks.kind_at(id[c])]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(" <skip ");
                toks.push_token_text_escaped(out, id[c]);
                out.push_str(">");
                c += 1;
            },
        }
    }
    out.push_str(")");
    return c;
}

struct SourceCursor {
    byte: i32,
    char: i32,
    line: i32,
    line_char: i32,
}

impl SourceCursor {
    fn advance_to(&mut self, src: &StrSlice, byte: i32) {
        assert byte >= self.byte, "to_lexer_string visits tokens in source order";
        for let mut i = self.byte; i < byte; i += 1 {
            if src.is_char_boundary(i) {
                self.char += 1;
            }
            if unchecked src.byte_at(i) == b'\n' {
                self.line += 1;
                self.line_char = self.char;
            }
        }
        self.byte = byte;
    }
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let mut cursor = SourceCursor { byte: 0, char: 0, line: 1, line_char: 0 };
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &mut cursor,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &mut cursor,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    cursor: &mut SourceCursor,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let type_id = if is_eof { -1 } else { kind + 1 };
    cursor.advance_to(&tokens.src, start);
    let first = cursor.char;
    let stop = first + char_count(&tokens.src, start, end) - 1;
    out.push_str(`[@${index},${first}:${stop}='`);
    if is_eof {
        out.push_str("<EOF>");
    } else {
        push_escaped(out, &tokens.src, start, end);
    }
    out.push_str(`',<${type_id}>,`);
    if channel != 0 {
        out.push_str(`channel=${channel},`);
    }
    out.push_str(`${cursor.line}:${first - cursor.line_char}]\n`);
}

pub struct LexerView {
    src: &StrSlice,
    start: i32,
    pos: i32,
}

impl LexerView {
    pub fn la(&self, k: i32) -> i32 {
        let mut i = self.pos;
        for let mut step = 1; step < k; step += 1 {
            if i >= self.src.len() {
                return -1;
            }
            i = self.src.ceil_char_boundary(i + 1);
        }
        for let mut step = 0; step > k; step -= 1 {
            if i == 0 {
                return -1;
            }
            i = self.src.floor_char_boundary(i - 1);
        }
        return self.char_at(i);
    }

    pub fn text(&self) -> String {
        return span_text(self.src, self.start, self.pos);
    }

    pub fn start(&self) -> i32 {
        return self.start;
    }

    pub fn pos(&self) -> i32 {
        return self.pos;
    }

    pub fn char_at(&self, i: i32) -> i32 {
        if i < 0 || i >= self.src.len() {
            return -1;
        }
        return char_at(self.src, i) as i32;
    }

    pub fn input_len(&self) -> i32 {
        return self.src.len();
    }
}

internal global FOLLOW_MAX_DEPTH: i32 = 4;

internal global FOLLOW_SLOT_BITS: i64 = 8;

internal global FOLLOW_ID_MASK: i64 = 127;

internal global FOLLOW_OPENS_BIT: i64 = 128;

internal global FOLLOW_CONT_MASK: i64 = 0x00FF_FFFF_FFFF_FFFF;

internal global FOLLOW_SEQUENCED: i64 = 0x007F_7F7F_7F7F_7F7F;

internal global FOLLOW_OPEN_READING: i64 = 0x0100_0000_0000_0000;

internal global FOLLOW_OPEN_FIELD: i64 = ~0x00FF_FFFF_FFFF_FFFF;

internal global FOLLOW_OPEN_SET_SHIFT: i64 = 57;

internal fn follow_open_mark(cont: i64) -> i64 {
    return if cont == 0 { FOLLOW_OPEN_READING } else { cont & FOLLOW_OPEN_FIELD };
}

internal fn follow_open_set(mask: i64) -> i64 {
    return FOLLOW_OPEN_READING | (mask & FOLLOW_ID_MASK) << FOLLOW_OPEN_SET_SHIFT;
}

internal fn follow_open_join(a: i64, b: i64) -> i64 {
    if a == 0 || a == b {
        return b;
    }
    if b == 0 {
        return a;
    }
    return FOLLOW_OPEN_READING;
}

internal fn follow_open_with(cont: i64, open: i64) -> i64 {
    return cont & FOLLOW_CONT_MASK | follow_open_join(follow_open_mark(cont), open);
}

internal fn follow_then(prefix: i64, prefix_bits: i64, cont: i64) -> i64 {
    return (prefix | (cont & FOLLOW_SEQUENCED) << prefix_bits) & FOLLOW_CONT_MASK;
}

internal fn follow_then_opening(prefix: i64, prefix_bits: i64, cont: i64) -> i64 {
    let opened = (cont & FOLLOW_CONT_MASK | FOLLOW_OPENS_BIT) << prefix_bits;
    return (prefix | opened) & FOLLOW_CONT_MASK | follow_open_mark(cont);
}

internal fn follow_or(prefix: i64, prefix_bits: i64, alternative: i64) -> i64 {
    let opened = (alternative | FOLLOW_OPENS_BIT) << prefix_bits;
    return (prefix | opened) & FOLLOW_CONT_MASK | alternative & FOLLOW_OPEN_FIELD;
}

internal fn follow_admits(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    return follow_heads_have(tokens, pos, cont, sets, eof_kind, true);
}

internal fn follow_resumes(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    return follow_heads_have(tokens, pos, cont, sets, eof_kind, false);
}

internal fn follow_exit_viable(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    if cont == 0 || follow_yields(tokens, pos, cont, sets, eof_kind) {
        return true;
    }
    let kind = follow_kind_at(tokens, pos, eof_kind);
    return follow_open_has(cont, kind, sets, true);
}

fn follow_open_has(cont: i64, kind: i32, sets: &List<List<i32>>, unknown_has: bool) -> bool {
    let open = cont & FOLLOW_OPEN_FIELD;
    if open == 0 {
        return false;
    }
    let set_id = open >> FOLLOW_OPEN_SET_SHIFT & FOLLOW_ID_MASK;
    return if set_id == 0 { unknown_has } else { follow_set_has(sets, set_id, kind) };
}

fn follow_kind_at(tokens: &Array<i32>, pos: i32, eof_kind: i32) -> i32 {
    return if pos < tokens.len() { tokens[pos] } else { eof_kind };
}

fn follow_set_has(sets: &List<List<i32>>, id: i64, kind: i32) -> bool {
    let set = &sets[(id - 1) as i32];
    return set.is_empty() || kind_set_has(set, kind);
}

fn follow_heads_have(
    tokens: &Array<i32>,
    pos: i32,
    cont: i64,
    sets: &List<List<i32>>,
    eof_kind: i32,
    unknown_has: bool,
) -> bool {
    if cont == 0 {
        return unknown_has;
    }
    let kind = follow_kind_at(tokens, pos, eof_kind);
    if follow_open_has(cont, kind, sets, unknown_has) {
        return true;
    }
    let mut c = cont & FOLLOW_CONT_MASK;
    let mut head = true;
    while c & FOLLOW_ID_MASK != 0 {
        if c & FOLLOW_OPENS_BIT != 0 {
            head = true;
        }
        if head {
            if follow_set_has(sets, c & FOLLOW_ID_MASK, kind) {
                return true;
            }
            head = false;
        }
        c >>= FOLLOW_SLOT_BITS;
    }
    return false;
}

internal fn follow_yields(tokens: &Array<i32>, pos: i32, cont: i64, sets: &List<List<i32>>, eof_kind: i32) -> bool {
    let mut c = cont & FOLLOW_CONT_MASK;
    let mut depth = 0;
    let mut alive = true;
    let mut constrained = false;
    while c & FOLLOW_ID_MASK != 0 {
        if c & FOLLOW_OPENS_BIT != 0 {
            if alive && constrained {
                return true;
            }
            depth = 0;
            alive = true;
            constrained = false;
        }
        if depth < FOLLOW_MAX_DEPTH {
            constrained = true;
            if alive {
                alive = follow_set_has(sets, c & FOLLOW_ID_MASK, follow_kind_at(tokens, pos + depth, eof_kind));
            }
            depth += 1;
        }
        c >>= FOLLOW_SLOT_BITS;
    }
    return alive && constrained;
}
internal global ATN_BASIC: i32 = 1;
internal global ATN_RULE_START: i32 = 2;
internal global ATN_RULE_STOP: i32 = 3;
internal global ATN_BLOCK_START: i32 = 4;
internal global ATN_BLOCK_END: i32 = 5;
internal global ATN_STAR_LOOP_ENTRY: i32 = 6;
internal global ATN_STAR_LOOP_BACK: i32 = 7;
internal global ATN_PLUS_LOOP_BACK: i32 = 8;
internal global ATN_LOOP_END: i32 = 9;

internal global ATN_TR_EPSILON: i32 = 0;
internal global ATN_TR_ATOM: i32 = 1;
internal global ATN_TR_NOT_ATOM: i32 = 2;
internal global ATN_TR_WILDCARD: i32 = 3;
internal global ATN_TR_RULE: i32 = 4;
internal global ATN_TR_PRECEDENCE: i32 = 5;
internal global ATN_TR_SET: i32 = 6;

internal struct AtnSim {
    internal state_kind: List<i32>,
    internal state_tr_start: List<i32>,
    internal state_tr_count: List<i32>,
    internal tr_kind: List<i32>,
    internal tr_target: List<i32>,
    internal tr_label: List<i32>,
    internal tr_follow: List<i32>,
    internal tr_prec: List<i32>,
    internal decision_state: List<i32>,
    internal rule_start: List<i32>,
    internal set_members: List<List<i32>>,
    internal set_words: i32,
    internal set_bits: List<i64>,
    internal rule_nullable: List<bool> = [],
    internal rule_first: List<List<i32>> = [],
    internal rule_first_neg: List<List<i32>> = [],
    internal rule_first_open: List<bool> = [],
    internal state_cont_nullable: List<bool> = [],
    internal cont_kinds: i32 = 0,
    internal cont_words: i32 = 0,
    internal state_cont_first: List<i64> = [],
    internal state_cont_any_but: List<i32> = [],
    internal state_collapse_to: List<i32> = [],
    internal state_collapse_target: List<bool> = [],
    internal state_call_prec: List<i32>,
}

fn atn_read_u8(bytes: &ByteList, pos: i32) -> i32 {
    return unchecked bytes[pos] as i32;
}

fn atn_read_u16(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = unchecked bytes[pos] as i32;
    let b1 = unchecked bytes[pos + 1] as i32;
    return b0 | b1 << 8;
}

fn atn_read_u24(bytes: &ByteList, pos: i32) -> i32 {
    let b0 = unchecked bytes[pos] as i32;
    let b1 = unchecked bytes[pos + 1] as i32;
    let b2 = unchecked bytes[pos + 2] as i32;
    return b0 | b1 << 8 | b2 << 16;
}

internal fn atn_decode(bytes: &ByteList) -> AtnSim {
    let mut p = 0;
    let nrules = atn_read_u16(bytes, p);
    p += 2;
    let ndec = atn_read_u16(bytes, p);
    p += 2;
    let nstates = atn_read_u16(bytes, p);
    p += 2;

    let mut rule_start: List<i32> = List::with_capacity(nrules);
    for let mut i = 0; i < nrules; i += 1 {
        rule_start.push(atn_read_u16(bytes, p));
        p += 2;
    }
    let mut decision_state: List<i32> = List::with_capacity(ndec);
    for let mut i = 0; i < ndec; i += 1 {
        decision_state.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let mut state_kind: List<i32> = List::with_capacity(nstates);
    for let mut i = 0; i < nstates; i += 1 {
        state_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut state_tr_start: List<i32> = List::with_capacity(nstates);
    let mut state_tr_count: List<i32> = List::with_capacity(nstates);
    let mut ntrans_total = 0;
    for let mut i = 0; i < nstates; i += 1 {
        let count = atn_read_u16(bytes, p);
        p += 2;
        state_tr_start.push(ntrans_total);
        state_tr_count.push(count);
        ntrans_total += count;
    }

    let mut tr_kind: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_kind.push(atn_read_u8(bytes, p));
        p += 1;
    }
    let mut tr_target: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_target.push(atn_read_u16(bytes, p) - 1);
        p += 2;
    }
    let mut tr_label: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_label.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_follow: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_follow.push(atn_read_u24(bytes, p) - 1);
        p += 3;
    }
    let mut tr_prec: List<i32> = List::with_capacity(ntrans_total);
    for let mut i = 0; i < ntrans_total; i += 1 {
        tr_prec.push(atn_read_u16(bytes, p));
        p += 2;
    }

    let nsets = atn_read_u16(bytes, p);
    p += 2;
    let mut set_members: List<List<i32>> = List::with_capacity(nsets);
    let mut kinds = 0;
    for let mut i = 0; i < nsets; i += 1 {
        let count = atn_read_u16(bytes, p);
        p += 2;
        let mut members: List<i32> = List::with_capacity(count);
        for let mut k = 0; k < count; k += 1 {
            let t = atn_read_u16(bytes, p);
            p += 2;
            members.push(t);
            kinds = i32::max(kinds, t + 1);
        }
        set_members.push(members);
    }
    let set_words = (kinds + 63) / 64;
    let mut set_bits = List::<i64>::filled(nsets * set_words, 0);
    for let mut i = 0; i < nsets; i += 1 {
        for let t of &set_members[i] {
            set_bits[i * set_words + *t / 64] |= 1 as i64 << (*t % 64) as i64;
        }
    }

    let mut state_call_prec = List::filled(nstates, 0);
    for let mut j = 0; j < ntrans_total; j += 1 {
        if tr_kind[j] == ATN_TR_RULE {
            assert tr_follow[j] >= 0, "a rule transition returns to a follow state";
            state_call_prec[tr_follow[j]] = tr_prec[j];
        }
    }

    return AtnSim {
        state_kind,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
        set_members,
        set_words,
        set_bits,
        state_call_prec,
    };
}

internal fn atn_tr_consumes(kind: i32) -> bool {
    return kind == ATN_TR_ATOM || kind == ATN_TR_SET || kind == ATN_TR_NOT_ATOM || kind == ATN_TR_WILDCARD;
}

internal fn atn_set_contains(sim: &AtnSim, set: i32, t: i32) -> bool {
    return t >= 0
        && t < sim.set_words * 64
        && sim.set_bits[set * sim.set_words + t / 64] & 1 as i64 << (t % 64) as i64 != 0;
}

global ATN_ACCEPT_EOF: i32 = -2;

global ATN_CLOSURE_GUARD: i32 = 2000000;
global ATN_ARENA_CAP: i32 = 400000;

global ATN_NODE_PAIR_STRIDE: i64 = 1073741824;
global ATN_DFA_NODE_CAP: i32 = 4000000;

global CFG_KEY_PR_SLOT: i32 = 2048;
global CFG_KEY_ALT_SLOT: i32 = 2048;
global CFG_KEY_STATE_SLOT: i32 = 1048576;

global CTX_BOUNDARY: i32 = -3;
global CTX_UNKNOWN_RETURN: i32 = -4;
global CTX_HIDDEN_RETURN: i32 = -5;

global CTX_EMPTY: i32 = 0;
global CTX_UNKNOWN: i32 = 1;

global ATN_READS_HIDDEN: i32 = -6;
global ATN_FAILED_ALT: i32 = 1024;

global ATN_DFA_UNDECIDED: i32 = -7;
global ATN_DFA_DEAD: i32 = -8;
global ATN_DFA_START_KEY: i32 = -9;
global ATN_DFA_TOKEN_SLOT: i64 = 65536;

global mut ATN_DFA: AtnDfa = AtnDfa::new();

internal struct AtnPredictor {
    internal stack: List<i32>,
    floor: i32,
    reach: i32,
    questions: AtnKeyLists,
    verdict_alt: List<i32>,
    verdict_reach: List<i32>,
}

internal struct AtnFloor {
    depth: i32,
    reach: i32,
}

impl AtnPredictor {
    internal fn new() -> AtnPredictor {
        return AtnPredictor {
            stack: [],
            floor: 0,
            reach: 0,
            questions: AtnKeyLists::new(),
            verdict_alt: [],
            verdict_reach: [],
        };
    }

    internal fn hide_callers(&mut self) -> AtnFloor {
        let saved = AtnFloor { depth: self.floor, reach: self.reach };
        self.floor = self.stack.len();
        self.reach = self.floor;
        return saved;
    }

    internal fn reveal_callers(&mut self, saved: AtnFloor) -> bool {
        let read = self.reach < self.floor;
        self.floor = saved.depth;
        self.reach = i32::min(saved.reach, self.reach);
        return read;
    }

    internal fn predict(
        &mut self,
        sim: &AtnSim,
        decision: i32,
        tokens: &Array<i32>,
        pos: i32,
        eof: i32,
        min_prec: i32,
        false_preds: &List<i32>,
    ) -> i32 {
        let [alt, reach] = self.predict_reaching(sim, decision, tokens, pos, eof, min_prec, false_preds);
        self.read_down_to(reach);
        return alt;
    }

    internal fn read_down_to(&mut self, depth: i32) {
        self.reach = i32::min(self.reach, depth);
    }

    fn predict_reaching(
        &mut self,
        sim: &AtnSim,
        decision: i32,
        tokens: &Array<i32>,
        pos: i32,
        eof: i32,
        min_prec: i32,
        false_preds: &List<i32>,
    ) -> [i32, i32]
        contract self.stack.len() >= self.floor, "a scan returns before its caller pops the frames below its floor"
    {
        if self.floor > 0 {
            let alt = atn_predict_above(
                &mut ATN_DFA,
                sim,
                decision,
                &self.stack,
                self.floor,
                tokens,
                pos,
                eof,
                min_prec,
                false_preds,
            );
            if alt != ATN_READS_HIDDEN {
                return [alt, self.floor];
            }
        }
        return [
            atn_predict_above(&mut ATN_DFA, sim, decision, &self.stack, 0, tokens, pos, eof, min_prec, false_preds),
            0,
        ];
    }

    fn ask(&mut self, decision: i32, pos: i32, min_prec: i32, depth: i32) -> i32 {
        let from = self.questions.keys.len();
        self.questions.keys.push(decision);
        self.questions.keys.push(pos);
        self.questions.keys.push(min_prec);
        for let mut i = 0; i < depth; i += 1 {
            self.questions.keys.push(self.stack[i]);
        }
        return from;
    }

    fn recorded_verdict(&mut self, decision: i32, pos: i32, min_prec: i32, depth: i32) -> i32 {
        let from = self.ask(decision, pos, min_prec, depth);
        let v = self.questions.find(from);
        self.questions.keys.truncate(from);
        return v;
    }

    internal fn record_verdict(&mut self, decision: i32, pos: i32, min_prec: i32, depth: i32, alt: i32, reach: i32) {
        let from = self.ask(decision, pos, min_prec, depth);
        if self.questions.find(from) >= 0 {
            self.questions.keys.truncate(from);
            return;
        }
        self.questions.add(from);
        self.verdict_alt.push(alt);
        self.verdict_reach.push(reach);
    }
}

struct AtnKeyLists {
    keys: List<i32>,
    start: List<i32>,
    len: List<i32>,
    same_hash_next: List<i32>,
    index: AtnKeyMap,
}

impl AtnKeyLists {
    fn new() -> AtnKeyLists {
        return AtnKeyLists { keys: [], start: [], len: [], same_hash_next: [], index: AtnKeyMap::new() };
    }

    fn hash_from(&self, from: i32) -> i64 {
        let mut h: i64 = 1469598103934665603;
        for let mut i = from; i < self.keys.len(); i += 1 {
            h = (h ^ self.keys[i] as i64 + 16) * 1099511628211;
        }
        return h & 4611686018427387903;
    }

    fn equals_pending(&self, id: i32, from: i32) -> bool {
        let n = self.keys.len() - from;
        if self.len[id] != n {
            return false;
        }
        let s = self.start[id];
        for let mut i = 0; i < n; i += 1 {
            if self.keys[s + i] != self.keys[from + i] {
                return false;
            }
        }
        return true;
    }

    fn find(&self, from: i32) -> i32 {
        let mut id = self.index.get(self.hash_from(from));
        while id >= 0 && !self.equals_pending(id, from) {
            id = self.same_hash_next[id];
        }
        return id;
    }

    fn add(&mut self, from: i32) -> i32 {
        let id = self.start.len();
        let h = self.hash_from(from);
        self.start.push(from);
        self.len.push(self.keys.len() - from);
        self.same_hash_next.push(self.index.get(h));
        self.index.set(h, id);
        return id;
    }
}

struct AtnKeyMap {
    keys: List<i64>,
    vals: List<i32>,
    used: List<i32>,
}

impl AtnKeyMap {
    fn new() -> AtnKeyMap {
        return AtnKeyMap::with_slots(64);
    }

    fn with_slots(slots: i32) -> AtnKeyMap
        contract slots & slots - 1 == 0, "slot count is a power of two"
    {
        return AtnKeyMap {
            keys: List::filled(slots, -1 as i64),
            vals: List::filled(slots, -1),
            used: [],
        };
    }

    fn clear(&mut self) {
        for let mut j = 0; j < self.used.len(); j += 1 {
            let s = self.used[j];
            self.keys[s] = -1;
            self.vals[s] = -1;
        }
        self.used.clear();
    }

    fn slot_of(&self, k: i64) -> i32
        contract k >= 0, "keys are non-negative"
    {
        let mask = self.keys.len() - 1;
        let mut i = ((k ^ k >> 29) * 0x5851F42D4C957F2D >> 32) as i32 & mask;
        while self.keys[i] >= 0 && self.keys[i] != k {
            i = i + 1 & mask;
        }
        return i;
    }

    fn get(&self, k: i64) -> i32 {
        return self.vals[self.slot_of(k)];
    }

    fn set(&mut self, k: i64, v: i32) {
        if (self.used.len() + 1) * 2 > self.keys.len() {
            let mut grown = AtnKeyMap::with_slots(self.keys.len() * 2);
            for let mut j = 0; j < self.used.len(); j += 1 {
                let s = self.used[j];
                grown.set(self.keys[s], self.vals[s]);
            }
            *self = grown;
        }
        let i = self.slot_of(k);
        if self.keys[i] < 0 {
            self.keys[i] = k;
            self.used.push(i);
        }
        self.vals[i] = v;
    }
}

struct CtxArena {
    node_start: List<i32>,
    node_len: List<i32>,
    ret: List<i32>,
    rpr: List<i32>,
    parent: List<i32>,
    pending: List<i32>,
    intern_head: AtnKeyMap,
    intern_next: List<i32>,
    merge_cache: AtnKeyMap,
    cover_cache: AtnKeyMap,
    node_limit: i32,
    closure_cut_short: bool,
}

struct AtnConfig {
    state: i32,
    alt: i32,
    pctx: i32,
    pr: i32,
}

impl CtxArena {
    fn new() -> CtxArena {
        let mut arena = CtxArena {
            node_start: [],
            node_len: [],
            ret: [],
            rpr: [],
            parent: [],
            pending: [],
            intern_head: AtnKeyMap::new(),
            intern_next: [],
            merge_cache: AtnKeyMap::new(),
            cover_cache: AtnKeyMap::new(),
            node_limit: ATN_ARENA_CAP,
            closure_cut_short: false,
        };
        let empty = arena.push(CTX_BOUNDARY, 0, CTX_EMPTY);
        let unknown = arena.push(CTX_UNKNOWN_RETURN, 0, CTX_EMPTY);
        assert empty == CTX_EMPTY && unknown == CTX_UNKNOWN, "the bottom and unknown-caller contexts are the arena's first nodes";
        return arena;
    }

    fn node_count(&self) -> i32 {
        return self.node_start.len();
    }

    fn open_budget(&mut self) {
        self.node_limit = self.node_count() + ATN_ARENA_CAP;
    }

    fn push_caller_stack(&mut self, sim: &AtnSim, rstk: &List<i32>, floor: i32) -> i32 {
        if rstk.is_empty() {
            return CTX_UNKNOWN;
        }
        let mut ctx = if floor > 0 { self.push(CTX_HIDDEN_RETURN, 0, CTX_EMPTY) } else { CTX_EMPTY };
        for let mut k = floor; k < rstk.len(); k += 1 {
            if rstk[k] >= 0 {
                ctx = self.push(rstk[k], atn_invocation_prec(sim, rstk, k - 1), ctx);
            } else if k > 0 {
                ctx = CTX_UNKNOWN;
            }
        }
        return ctx;
    }

    fn append_edge(&mut self, return_state: i32, restore_pr: i32, parent: i32) {
        self.ret.push(return_state);
        self.rpr.push(restore_pr);
        self.parent.push(parent);
    }

    fn hash_edges(&self, s: i32, n: i32) -> i64 {
        let mut h: i64 = 1469598103934665603;
        for let mut e = s; e < s + n; e += 1 {
            h = (h ^ self.ret[e] as i64 + 1) * 1099511628211;
            h = (h ^ self.rpr[e] as i64 + 1) * 1099511628211;
            h = (h ^ self.parent[e] as i64 + 1) * 1099511628211;
        }
        return h & 4611686018427387903;
    }

    fn edges_eq(&self, node: i32, s: i32, n: i32) -> bool {
        if self.node_len[node] != n {
            return false;
        }
        let t = self.node_start[node];
        for let mut i = 0; i < n; i += 1 {
            if self.ret[t + i] != self.ret[s + i]
                || self.rpr[t + i] != self.rpr[s + i]
                || self.parent[t + i] != self.parent[s + i] {
                return false;
            }
        }
        return true;
    }

    fn intern_from(&mut self, s: i32) -> i32 {
        let n = self.ret.len() - s;
        assert n > 0, "a context has at least one edge";
        let h = self.hash_edges(s, n);
        let head = self.intern_head.get(h);
        let mut cand = head;
        while cand >= 0 {
            if self.edges_eq(cand, s, n) {
                self.ret.truncate(s);
                self.rpr.truncate(s);
                self.parent.truncate(s);
                return cand;
            }
            cand = self.intern_next[cand];
        }
        let id = self.node_start.len();
        assert (id as i64) < ATN_NODE_PAIR_STRIDE, "a node id at the pair-key stride aliases two node pairs onto one key";
        self.node_start.push(s);
        self.node_len.push(n);
        self.intern_next.push(head);
        self.intern_head.set(h, id);
        return id;
    }

    fn push(&mut self, return_state: i32, restore_pr: i32, parent: i32) -> i32 {
        let s = self.ret.len();
        self.append_edge(return_state, restore_pr, parent);
        return self.intern_from(s);
    }

    fn key_cmp(&self, x: i32, y: i32) -> i32 {
        if self.ret[x] != self.ret[y] {
            return if self.ret[x] < self.ret[y] { -1 } else { 1 };
        }
        if self.rpr[x] != self.rpr[y] {
            return if self.rpr[x] < self.rpr[y] { -1 } else { 1 };
        }
        return 0;
    }

    fn merge(&mut self, a: i32, b: i32) -> i32 {
        if a == b {
            return a;
        }
        let ck = if a < b { atn_node_pair_key(a, b) } else { atn_node_pair_key(b, a) };
        let cached = self.merge_cache.get(ck);
        if cached >= 0 {
            return cached;
        }
        let sa = self.node_start[a];
        let na = self.node_len[a];
        let sb = self.node_start[b];
        let nb = self.node_len[b];
        let base = self.pending.len();
        let mut i = 0;
        let mut j = 0;
        while i < na && j < nb {
            let c = self.key_cmp(sa + i, sb + j);
            if c < 0 {
                i += 1;
            } else if c > 0 {
                j += 1;
            } else {
                let m = self.merge(self.parent[sa + i], self.parent[sb + j]);
                self.pending.push(m);
                i += 1;
                j += 1;
            }
        }
        let s = self.ret.len();
        let mut k = base;
        i = 0;
        j = 0;
        while i < na || j < nb {
            let c = if i >= na {
                1;
            } else if j >= nb {
                -1;
            } else {
                self.key_cmp(sa + i, sb + j);
            };
            if c < 0 {
                self.append_edge(self.ret[sa + i], self.rpr[sa + i], self.parent[sa + i]);
                i += 1;
            } else if c > 0 {
                self.append_edge(self.ret[sb + j], self.rpr[sb + j], self.parent[sb + j]);
                j += 1;
            } else {
                self.append_edge(self.ret[sa + i], self.rpr[sa + i], self.pending[k]);
                k += 1;
                i += 1;
                j += 1;
            }
        }
        self.pending.truncate(base);
        let id = self.intern_from(s);
        self.merge_cache.set(ck, id);
        return id;
    }

    fn covers(&mut self, outer: i32, inner: i32) -> bool {
        if outer == inner {
            return true;
        }
        let ck = atn_node_pair_key(outer, inner);
        let cached = self.cover_cache.get(ck);
        if cached >= 0 {
            return cached == 1;
        }
        let so = self.node_start[outer];
        let no = self.node_len[outer];
        let si = self.node_start[inner];
        let ni = self.node_len[inner];
        let mut i = 0;
        let mut covered = true;
        for let mut j = 0; j < ni; j += 1 {
            while i < no && self.key_cmp(so + i, si + j) < 0 {
                i += 1;
            }
            if i >= no || self.key_cmp(so + i, si + j) != 0 || !self.covers(self.parent[so + i], self.parent[si + j]) {
                covered = false;
                break;
            }
            i += 1;
        }
        self.cover_cache.set(ck, if covered { 1 } else { 0 });
        return covered;
    }
}

fn atn_node_pair_key(a: i32, b: i32) -> i64 {
    return a as i64 * ATN_NODE_PAIR_STRIDE + b as i64;
}

fn atn_state_pr_key(state: i32, pr: i32) -> i64
    contract pr + 2 < CFG_KEY_PR_SLOT
    contract state + 2 < CFG_KEY_STATE_SLOT
{
    return (state + 2) as i64 * CFG_KEY_PR_SLOT as i64 + (pr + 2) as i64;
}

internal fn atn_invocation_prec(sim: &AtnSim, rstk: &List<i32>, k: i32) -> i32 {
    if k < 0 || rstk[k] < 0 {
        return 0;
    }
    return sim.state_call_prec[rstk[k]];
}

fn atn_state_consumes(sim: &AtnSim, state: i32) -> bool {
    let cnt = sim.state_tr_count[state];
    if cnt == 0 {
        return false;
    }
    return atn_tr_consumes(sim.tr_kind[sim.state_tr_start[state]]);
}

struct CfgSet {
    state: List<i32>,
    alt: List<i32>,
    pr: List<i32>,
    pctx: List<i32>,
    index: AtnKeyMap,
}

impl CfgSet {
    fn new() -> CfgSet {
        return CfgSet {
            state: [],
            alt: [],
            pr: [],
            pctx: [],
            index: AtnKeyMap::new(),
        };
    }

    fn clear(&mut self) {
        self.state.clear();
        self.alt.clear();
        self.pr.clear();
        self.pctx.clear();
        self.index.clear();
    }

    fn add(&mut self, arena: &mut CtxArena, state: i32, alt: i32, pr: i32, pctx: i32) -> [i32, bool]
        contract alt + 1 < CFG_KEY_ALT_SLOT
    {
        let k = atn_state_pr_key(state, pr) * CFG_KEY_ALT_SLOT as i64 + (alt + 1) as i64;
        let found = self.index.get(k);
        if found >= 0 {
            let merged = arena.merge(self.pctx[found], pctx);
            let changed = merged != self.pctx[found];
            self.pctx[found] = merged;
            return [found, changed];
        }
        let i = self.state.len();
        self.state.push(state);
        self.alt.push(alt);
        self.pr.push(pr);
        self.pctx.push(pctx);
        self.index.set(k, i);
        return [i, true];
    }

    fn to_list(&self) -> List<AtnConfig> {
        let mut out: List<AtnConfig> = [];
        for let mut i = 0; i < self.state.len(); i += 1 {
            out.push(AtnConfig {
                state: self.state[i],
                alt: self.alt[i],
                pctx: self.pctx[i],
                pr: self.pr[i],
            });
        }
        return out;
    }
}

struct ClosureScratch {
    cset: CfgSet,
    rset: CfgSet,
    work: List<AtnConfig>,
    expanded: List<i32>,
    hidden_alts: List<i32>,
}

impl ClosureScratch {
    fn new() -> ClosureScratch {
        return ClosureScratch {
            cset: CfgSet::new(),
            rset: CfgSet::new(),
            work: [],
            expanded: [],
            hidden_alts: [],
        };
    }
}

fn atn_closure(
    sim: &AtnSim,
    arena: &mut CtxArena,
    seeds: &List<AtnConfig>,
    scratch: &mut ClosureScratch,
    lr_loop_unconsumed: i32 = -1,
    false_preds: &List<i32> = &ATN_NO_FALSE_PREDS,
) -> List<AtnConfig> {
    scratch.cset.clear();
    scratch.rset.clear();
    scratch.expanded.clear();
    scratch.hidden_alts.clear();
    scratch.work.clear();
    scratch.work.extend(seeds);
    let mut guard = 0;
    while let Some(c) = scratch.work.pop() {
        guard += 1;
        if guard > ATN_CLOSURE_GUARD {
            break;
        }
        if c.state == lr_loop_unconsumed && sim.tr_kind[sim.state_tr_start[c.state] + c.alt] == ATN_TR_PRECEDENCE {
            continue;
        }
        let res = scratch.cset.add(arena, c.state, c.alt, c.pr, c.pctx);
        let idx = res.0;
        while scratch.expanded.len() <= idx {
            scratch.expanded.push(-9);
        }
        let merged_pctx = scratch.cset.pctx[idx];
        if scratch.expanded[idx] == merged_pctx {
            continue;
        }
        scratch.expanded[idx] = merged_pctx;
        let cur = AtnConfig { state: c.state, alt: c.alt, pctx: merged_pctx, pr: c.pr };
        atn_expand(sim, arena, &cur, scratch, false_preds);
    }
    return scratch.rset.to_list();
}

fn atn_expand(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    scratch: &mut ClosureScratch,
    false_preds: &List<i32>,
) {
    let work = &mut scratch.work;
    let rset = &mut scratch.rset;
    if cur.state == ATN_ACCEPT_EOF {
        rset.add(arena, cur.state, cur.alt, cur.pr, cur.pctx);
        return;
    }
    if sim.state_kind[cur.state] == ATN_RULE_STOP {
        atn_pop(arena, cur, scratch);
        return;
    }
    if atn_state_consumes(sim, cur.state) {
        rset.add(arena, cur.state, cur.alt, cur.pr, cur.pctx);
        return;
    }
    let pctx = atn_collapse_into_caller_loop(sim, arena, cur, work, &mut scratch.hidden_alts);
    if pctx < 0 {
        return;
    }
    let start = sim.state_tr_start[cur.state];
    let cnt = sim.state_tr_count[cur.state];
    for let mut j = 0; j < cnt; j += 1 {
        let k = sim.tr_kind[start + j];
        let target = sim.tr_target[start + j];
        if k == ATN_TR_EPSILON {
            let pred = sim.tr_label[start + j];
            let alt = if pred >= 0 && cur.alt < ATN_FAILED_ALT && false_preds.contains(&pred) {
                cur.alt + ATN_FAILED_ALT;
            } else {
                cur.alt;
            };
            work.push(AtnConfig { state: target, alt, pctx, pr: cur.pr });
        } else if k == ATN_TR_PRECEDENCE {
            if sim.tr_prec[start + j] >= cur.pr {
                work.push(AtnConfig { state: target, alt: cur.alt, pctx, pr: cur.pr });
            }
        } else if k == ATN_TR_RULE {
            if target < 0 {
                continue;
            }
            if arena.node_count() >= arena.node_limit {
                arena.closure_cut_short = true;
                continue;
            }
            let npctx = arena.push(sim.tr_follow[start + j], cur.pr, pctx);
            work.push(AtnConfig { state: target, alt: cur.alt, pctx: npctx, pr: sim.tr_prec[start + j] });
        }
    }
}

fn atn_collapse_into_caller_loop(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    work: &mut List<AtnConfig>,
    hidden_alts: &mut List<i32>,
) -> i32 {
    if sim.state_collapse_to.is_empty() || !sim.state_collapse_target[cur.state] {
        return cur.pctx;
    }
    let s = arena.node_start[cur.pctx];
    let n = arena.node_len[cur.pctx];
    let mut collapses = false;
    for let mut e = s; e < s + n; e += 1 {
        if arena.ret[e] == CTX_HIDDEN_RETURN && !hidden_alts.contains(&cur.alt) {
            hidden_alts.push(cur.alt);
        }
        collapses = collapses || atn_edge_collapses(sim, arena, e, cur);
    }
    if !collapses {
        return cur.pctx;
    }
    let kept = arena.ret.len();
    for let mut e = s; e < s + n; e += 1 {
        if atn_edge_collapses(sim, arena, e, cur) {
            work.push(AtnConfig { state: cur.state, alt: cur.alt, pctx: arena.parent[e], pr: arena.rpr[e] });
        } else {
            arena.append_edge(arena.ret[e], arena.rpr[e], arena.parent[e]);
        }
    }
    if arena.ret.len() == kept {
        return -1;
    }
    return arena.intern_from(kept);
}

fn atn_edge_collapses(sim: &AtnSim, arena: &CtxArena, e: i32, cur: &AtnConfig) -> bool {
    let r = arena.ret[e];
    return r >= 0 && sim.state_collapse_to[r] == cur.state && cur.pr >= arena.rpr[e];
}

fn atn_pop(arena: &mut CtxArena, cur: &AtnConfig, scratch: &mut ClosureScratch) {
    let s = arena.node_start[cur.pctx];
    let n = arena.node_len[cur.pctx];
    for let mut e = s; e < s + n; e += 1 {
        let r = arena.ret[e];
        if r == CTX_BOUNDARY {
            scratch.rset.add(arena, ATN_ACCEPT_EOF, cur.alt, cur.pr, CTX_EMPTY);
        } else if r == CTX_UNKNOWN_RETURN {
            scratch.rset.add(arena, cur.state, cur.alt, cur.pr, CTX_UNKNOWN);
        } else if r == CTX_HIDDEN_RETURN {
            if !scratch.hidden_alts.contains(&cur.alt) {
                scratch.hidden_alts.push(cur.alt);
            }
        } else {
            scratch.work.push(AtnConfig { state: r, alt: cur.alt, pctx: arena.parent[e], pr: arena.rpr[e] });
        }
    }
}

fn atn_move(sim: &AtnSim, configs: &List<AtnConfig>, token: i32, eof: i32) -> List<AtnConfig> {
    let mut out: List<AtnConfig> = [];
    let mut ended: List<AtnConfig> = [];
    for let c of configs {
        if c.state == ATN_ACCEPT_EOF {
            if token == eof {
                ended.push(*c);
            }
            continue;
        }
        if sim.state_kind[c.state] == ATN_RULE_STOP {
            out.push(*c);
            continue;
        }
        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let label = sim.tr_label[start + j];
            let matched = if k == ATN_TR_ATOM {
                label == token;
            } else if k == ATN_TR_SET {
                atn_set_contains(sim, label, token);
            } else if k == ATN_TR_WILDCARD {
                token != eof;
            } else if k == ATN_TR_NOT_ATOM {
                token != label && token != eof;
            } else {
                false;
            };
            if matched {
                out.push(AtnConfig { state: sim.tr_target[start + j], alt: c.alt, pctx: c.pctx, pr: c.pr });
            }
        }
    }
    if out.iter_ref().any(|c| sim.state_kind[c.state] != ATN_RULE_STOP) {
        return out;
    }
    for let c of ended {
        out.push(c);
    }
    return out;
}

fn atn_unique_alts(configs: &List<AtnConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return alts;
}

fn atn_resolve(sorted_alts: &List<i32>) -> i32 {
    return if sorted_alts.is_empty() || sorted_alts[0] >= ATN_FAILED_ALT { -1 } else { sorted_alts[0] };
}

fn atn_one_alt(sorted_alts: &List<i32>) -> bool {
    let a = sorted_alts[0] % ATN_FAILED_ALT;
    return sorted_alts.iter_ref().all(|b| *b % ATN_FAILED_ALT == a);
}

fn atn_min_alt_covers_rest(arena: &mut CtxArena, configs: &List<AtnConfig>, min_alt: i32) -> bool {
    let mut min_ctx = AtnKeyMap::new();
    for let c of configs {
        if c.alt == min_alt {
            min_ctx.set(atn_state_pr_key(c.state, c.pr), c.pctx);
        }
    }
    for let c of configs {
        if c.alt != min_alt {
            let e = min_ctx.get(atn_state_pr_key(c.state, c.pr));
            if e < 0 || !arena.covers(e, c.pctx) {
                return false;
            }
        }
    }
    return true;
}

fn atn_all_at_end(sim: &AtnSim, configs: &List<AtnConfig>) -> bool {
    if configs.is_empty() {
        return false;
    }
    for let c of configs {
        if c.state != ATN_ACCEPT_EOF && sim.state_kind[c.state] != ATN_RULE_STOP {
            return false;
        }
    }
    return true;
}

internal global ATN_NO_FALSE_PREDS: List<i32> = [];

internal fn atn_predict_once(
    sim: &AtnSim,
    decision: i32,
    atn: &mut AtnPredictor,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let depth = atn.stack.len();
    let v = atn.recorded_verdict(decision, pos, min_prec, depth);
    if v >= 0 {
        atn.read_down_to(atn.verdict_reach[v]);
        return atn.verdict_alt[v];
    }
    let [alt, reach] = atn.predict_reaching(sim, decision, tokens, pos, eof, min_prec, &ATN_NO_FALSE_PREDS);
    atn.read_down_to(reach);
    atn.record_verdict(decision, pos, min_prec, depth, alt, reach);
    return alt;
}

internal fn atn_predict_with_stack(
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32 = 0,
    false_preds: &List<i32> = &ATN_NO_FALSE_PREDS,
) -> i32 {
    let mut dfa = AtnDfa::new();
    return atn_predict_above(&mut dfa, sim, decision, rule_stack, 0, tokens, start_pos, eof, min_prec, false_preds);
}

fn atn_predict_above(
    dfa: &mut AtnDfa,
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    floor: i32,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32,
    false_preds: &List<i32>,
) -> i32 {
    let [alt, _] = atn_predict_walk(
        dfa,
        sim,
        decision,
        rule_stack,
        floor,
        tokens,
        start_pos,
        eof,
        min_prec,
        false_preds,
    );
    return alt;
}

fn atn_predict_walk(
    dfa: &mut AtnDfa,
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    floor: i32,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32,
    false_preds: &List<i32>,
) -> [i32, bool] {
    dfa.make_room(sim);
    let caller = dfa.arena.push_caller_stack(sim, rule_stack, floor);
    dfa.arena.open_budget();
    let mut s = dfa.start_state(sim, decision, caller, min_prec, false_preds);
    let mut fallback = -1;
    let mut pos = start_pos;
    loop {
        let verdict = dfa.state_verdict[s];
        if verdict == ATN_DFA_DEAD {
            return [fallback, false];
        }
        if verdict != ATN_DFA_UNDECIDED {
            return [verdict, true];
        }
        fallback = dfa.state_first[s];
        let token = if pos < tokens.len() { tokens[pos] } else { eof };
        if token == eof {
            let survivors = atn_unique_alts(&atn_move(sim, &dfa.state_configs[s], eof, eof));
            return if survivors.is_empty() { [fallback, false] } else { [atn_resolve(&survivors), true] };
        }
        s = dfa.step(sim, s, token, eof);
        pos += 1;
    }
}

struct AtnDfa {
    arena: CtxArena,
    scratch: ClosureScratch,
    state_configs: List<List<AtnConfig>>,
    state_verdict: List<i32>,
    state_first: List<i32>,
    seeds: AtnKeyLists,
    edges: AtnKeyMap,
    sim_states: i32,
}

impl AtnDfa {
    fn new() -> AtnDfa {
        return AtnDfa {
            arena: CtxArena::new(),
            scratch: ClosureScratch::new(),
            state_configs: [],
            state_verdict: [],
            state_first: [],
            seeds: AtnKeyLists::new(),
            edges: AtnKeyMap::new(),
            sim_states: -1,
        };
    }

    fn make_room(&mut self, sim: &AtnSim) {
        if self.sim_states < 0 {
            self.sim_states = sim.state_kind.len();
        }
        assert self.sim_states == sim.state_kind.len(), "a DFA caches the predictions of one ATN";
        if self.arena.closure_cut_short || self.arena.node_count() >= ATN_DFA_NODE_CAP {
            *self = AtnDfa::new();
            self.sim_states = sim.state_kind.len();
        }
    }

    fn start_state(&mut self, sim: &AtnSim, decision: i32, caller: i32, min_prec: i32, false_preds: &List<i32>) -> i32 {
        let from = self.seeds.keys.len();
        self.seeds.keys.push(ATN_DFA_START_KEY);
        self.seeds.keys.push(decision);
        self.seeds.keys.push(caller);
        self.seeds.keys.push(min_prec);
        self.seeds.keys.extend(false_preds);
        let known = self.seeds.find(from);
        if known >= 0 {
            self.seeds.keys.truncate(from);
            return known;
        }
        let dstate = sim.decision_state[decision];
        let start = sim.state_tr_start[dstate];
        let mut seeds: List<AtnConfig> = [];
        for let mut j = 0; j < sim.state_tr_count[dstate]; j += 1 {
            if sim.tr_kind[start + j] == ATN_TR_PRECEDENCE && sim.tr_prec[start + j] < min_prec {
                continue;
            }
            seeds.push(AtnConfig { state: sim.tr_target[start + j], alt: j, pctx: caller, pr: min_prec });
        }
        let configs = atn_closure(sim, &mut self.arena, &seeds, &mut self.scratch, dstate, false_preds);
        return self.add_state(sim, configs, from);
    }

    fn step(&mut self, sim: &AtnSim, s: i32, token: i32, eof: i32) -> i32
        contract token >= 0 && (token as i64) < ATN_DFA_TOKEN_SLOT
    {
        let edge = s as i64 * ATN_DFA_TOKEN_SLOT + token as i64;
        let cached = self.edges.get(edge);
        if cached >= 0 {
            return cached;
        }
        let moved = atn_move(sim, &self.state_configs[s], token, eof);
        let from = self.seeds.keys.len();
        for let c of &moved {
            self.seeds.keys.push(c.state);
            self.seeds.keys.push(c.alt);
            self.seeds.keys.push(c.pr);
            self.seeds.keys.push(c.pctx);
        }
        let mut next = self.seeds.find(from);
        if next >= 0 {
            self.seeds.keys.truncate(from);
        } else {
            let configs = atn_closure(sim, &mut self.arena, &moved, &mut self.scratch);
            next = self.add_state(sim, configs, from);
        }
        self.edges.set(edge, next);
        return next;
    }

    fn add_state(&mut self, sim: &AtnSim, configs: List<AtnConfig>, seeds_from: i32) -> i32 {
        let s = self.seeds.add(seeds_from);
        assert s == self.state_configs.len(), "a DFA state is the closure of the seeds it is interned by";
        let alts = atn_unique_alts(&configs);
        self.state_first.push(atn_resolve(&alts));
        let verdict = self.verdict_of(sim, &configs, alts);
        self.state_verdict.push(verdict);
        self.state_configs.push(configs);
        return s;
    }

    fn verdict_of(&mut self, sim: &AtnSim, configs: &List<AtnConfig>, alts: List<i32>) -> i32 {
        if !self.scratch.hidden_alts.is_empty() {
            let mut alive = alts;
            for let a of &self.scratch.hidden_alts {
                if !alive.contains(a) {
                    alive.push(*a);
                }
            }
            alive.sort();
            return if atn_one_alt(&alive) { atn_resolve(&alive) } else { ATN_READS_HIDDEN };
        }
        if alts.is_empty() {
            return ATN_DFA_DEAD;
        }
        let first = atn_resolve(&alts);
        if first < 0
            || atn_one_alt(&alts)
            || atn_min_alt_covers_rest(&mut self.arena, configs, first)
            || atn_all_at_end(sim, configs) {
            return first;
        }
        return ATN_DFA_UNDECIDED;
    }
}

global LATN_SEED: HashSeed = HashSeed::fixed(0xA4093822299F31D0, 0x082EFA98EC4E6C89);

struct LThread {
    state: i32,
    stack: i32,
    accept: bool,
}

struct LatnStacks {
    parent: List<i32>,
    ret: List<i32>,
    ids: HashMap<i64, i32>,
}

impl LatnStacks {
    fn push(&mut self, parent: i32, ret: i32) -> i32 {
        let key = latn_pair_key(parent, ret);
        if let Some(id) = self.ids.get(key) {
            return id;
        }
        let id = self.parent.len();
        self.parent.push(parent);
        self.ret.push(ret);
        self.ids[key] = id;
        return id;
    }
}

fn latn_pair_key(hi: i32, lo: i32) -> i64
    contract hi >= -1 && lo >= -1, "latn keys pair a state or stack id with -1 for none"
{
    return (hi + 1) as i64 << 32 | (lo + 1) as i64;
}

struct LatnVisited {
    step: i32,
    step_of: List<i32>,
    stack_of: List<i32>,
    more: HashSet<i64>,
}

global mut LATN_VISITED: LatnVisited = LatnVisited {
    step: 0,
    step_of: [],
    stack_of: [],
    more: HashSet::with_seed(LATN_SEED),
};

impl LatnVisited {
    fn cover(&mut self, nstates: i32) {
        while self.step_of.len() < nstates {
            self.step_of.push(-1);
            self.stack_of.push(-1);
        }
    }

    fn first_visit(&mut self, state: i32, stack: i32) -> bool {
        if self.step_of[state] != self.step {
            self.step_of[state] = self.step;
            self.stack_of[state] = stack;
            return true;
        }
        if self.stack_of[state] == stack {
            return false;
        }
        return self.more.insert(latn_pair_key(state, stack));
    }

    fn next_step(&mut self) {
        if self.step == i32::MAX {
            self.step_of = List::filled(self.step_of.len(), -1);
            self.step = -1;
        }
        self.step += 1;
        if !self.more.is_empty() {
            self.more.clear();
        }
    }
}

fn latn_closure(
    sim: &AtnSim,
    stacks: &mut LatnStacks,
    out: &mut List<LThread>,
    visited: &mut LatnVisited,
    state: i32,
    stack: i32,
    open: &mut List<i32>,
) {
    if !visited.first_visit(state, stack) {
        return;
    }

    if sim.state_kind[state] == ATN_RULE_STOP {
        if stack < 0 {
            out.push(LThread { state, stack, accept: true });
            return;
        }
        let returned = open.pop();
        latn_closure(sim, stacks, out, visited, stacks.ret[stack], stacks.parent[stack], open);
        if let Some(rule) = returned {
            open.push(rule);
        }
        return;
    }

    let ts = sim.state_tr_start[state];
    let tc = sim.state_tr_count[state];
    if tc > 0 {
        if atn_tr_consumes(sim.tr_kind[ts]) {
            out.push(LThread { state, stack, accept: false });
            return;
        }
    }
    for let mut i = 0; i < tc; i += 1 {
        let idx = ts + i;
        let target = sim.tr_target[idx];
        if sim.tr_kind[idx] == ATN_TR_RULE {
            if target < 0 || open.contains(&target) {
                continue;
            }
            let pushed = stacks.push(stack, sim.tr_follow[idx]);
            open.push(target);
            latn_closure(sim, stacks, out, visited, target, pushed, open);
            let _ = open.pop();
        } else {
            latn_closure(sim, stacks, out, visited, target, stack, open);
        }
    }
}

internal fn latn_match(sim: &AtnSim, start_rule: i32, src: &StrSlice, start: i32, longest: bool) -> i32 {
    let mut best = -1;
    let mut stacks = LatnStacks { parent: [], ret: [], ids: HashMap::with_seed(LATN_SEED) };
    let mut open: List<i32> = [];
    let visited = &mut LATN_VISITED;
    visited.cover(sim.state_kind.len());
    visited.next_step();
    let mut clist: List<LThread> = [];
    latn_closure(sim, &mut stacks, &mut clist, visited, sim.rule_start[start_rule], -1, &mut open);

    let mut nlist: List<LThread> = [];
    let mut pos = start;
    loop {
        let cur = if pos < src.len() { char_at(src, pos) as i32 } else { -1 };
        nlist.clear();
        visited.next_step();
        let mut i = 0;
        let mut stop = false;
        while i < clist.len() && !stop {
            let th = &clist[i];
            if th.accept {
                best = pos;
                stop = !longest;
            } else if cur >= 0 {
                let ts = sim.state_tr_start[th.state];
                let tc = sim.state_tr_count[th.state];
                for let mut j = 0; j < tc; j += 1 {
                    let idx = ts + j;
                    let kind = sim.tr_kind[idx];
                    let matched = if kind == ATN_TR_ATOM {
                        cur >= sim.tr_label[idx] && cur <= sim.tr_follow[idx];
                    } else if kind == ATN_TR_WILDCARD {
                        true;
                    } else if kind == ATN_TR_NOT_ATOM {
                        cur != sim.tr_label[idx];
                    } else {
                        false;
                    };
                    if matched {
                        latn_closure(
                            sim,
                            &mut stacks,
                            &mut nlist,
                            visited,
                            sim.tr_target[idx],
                            th.stack,
                            &mut open,
                        );
                    }
                }
            }
            i += 1;
        }
        if nlist.is_empty() {
            break;
        }
        let spent = clist;
        clist = nlist;
        nlist = spent;
        pos = src.ceil_char_boundary(pos + 1);
    }
    return best;
}
