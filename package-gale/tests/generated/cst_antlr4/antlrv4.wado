            opt_enter = opt_scan_pos >= 0 && (!follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) || follow_resumes(&p.kinds, opt_scan_pos, follow, &FOLLOW_SETS, TK_EOF));
        }
        if opt_enter {
            p.site = 126;
            p.atn_ret_pending = 873;
            _parse_element_options(p, follow);
        }
        return;
    } else if kind == TK_STRING_LITERAL {
        p.take();
        let mut opt_enter: bool = p.peek_kind() == TK_LT;
        if opt_enter && follow_admits(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) {
            let mut opt_scan_pos: i32 = -1;
            opt_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                p.atn.stack.push(879);
                pos = scan_element_options(tokens, pos, &mut p.atn, follow);
                p.atn.stack.pop();
                if pos < 0 { break opt_scan; }
                opt_scan_pos = pos;
            }
            opt_enter = opt_scan_pos >= 0 && (!follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) || follow_resumes(&p.kinds, opt_scan_pos, follow, &FOLLOW_SETS, TK_EOF));
        }
        if opt_enter {
            p.site = 127;
            p.atn_ret_pending = 879;
            _parse_element_options(p, follow);
        }
        return;
    }
    p.no_viable(
        "no alternative of terminalDef matches",
        p.peek_span(),
        &EXPECTED_51,
    );
    return;
}

fn _parse_terminal_def(p: &mut Parser, follow: i64 = 0) -> () {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_TERMINAL_DEF, _start);
    _parse_terminal_def__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_TERMINAL_DEF, "terminalDef", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn _parse_element_options__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.expect(TK_LT, &SYNC_6, false);
    p.site = 128;
    p.atn_ret_pending = 885;
    _parse_element_option(p, follow_or(FOLLOW_MASK_8, 16, follow_then(FOLLOW_MASK_27, 8, follow)));
    if !kind_set_has(&SYNC_34, p.kinds[p.pos]) { builtin::cold_path(); p.sync_enter(&SYNC_34, &EXPECTED_34); }
    while !p.recovering && p.peek_kind() == TK_COMMA {
        p.take();
        p.site = 129;
        p.atn_ret_pending = 893;
        _parse_element_option(p, follow_or(FOLLOW_MASK_8, 16, follow_then(FOLLOW_MASK_27, 8, follow)));
        if !kind_set_has(&SYNC_34, p.kinds[p.pos]) { builtin::cold_path(); p.sync_back(&SYNC_34, &EXPECTED_34); }
    }
    p.expect(TK_GT, &EMPTY_SYNC, true);
    return;
}

fn _parse_element_options(p: &mut Parser, follow: i64 = 0) -> () {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_ELEMENT_OPTIONS, _start);
    _parse_element_options__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_ELEMENT_OPTIONS, "elementOptions", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn _parse_element_option__inner_alt_1(p: &mut Parser, follow: i64 = 0) -> () {
    p.site = 131;
    p.atn_ret_pending = 902;
    _parse_identifier(p);
    p.expect(TK_ASSIGN, &SYNC_52, false);
    if !kind_set_has(&SYNC_52, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_52, &EXPECTED_52); }
    let grp_kind = p.peek_kind();
    if _kind_set_2(grp_kind) {
        p.site = 132;
        p.atn_ret_pending = 908;
        _parse_qualified_identifier(p, follow);
    } else if _kind_set_27(grp_kind) {
        p.take();
    } else {
        p.no_viable("no viable alternative", p.peek_span(), &EXPECTED_52);
    }
    return;
}

fn scan_element_option__alt_1(tokens: &Array<i32>, pos: i32, atn: &mut AtnPredictor, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || !_kind_set_2(tokens[pos]) { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_ASSIGN { return -1; }
    pos += 1;
    sg_1_done: {
        let sgk_1 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        if _kind_set_2(sgk_1) {
            sg_1_0: {
                pos = scan_qualified_identifier(tokens, pos, atn, follow);
                if pos < 0 { break sg_1_0; }
                break sg_1_done;
            }
        } else if _kind_set_27(sgk_1) {
            pos += 1;
            break sg_1_done;
        }
        return -1;
    }
    return pos;
}

fn _parse_element_option__inner(p: &mut Parser, follow: i64 = 0) -> () {
    if !kind_set_has(&SYNC_6, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_6, &EXPECTED_6); }
    let kind = p.peek_kind();
    if _kind_set_2(kind) {
        let _atn_alt = atn_decide_84(&mut p.atn, &p.kinds, p.pos, 0);
        if _atn_alt == 0 {
            p.site = 130;
            p.atn_ret_pending = 900;
            return _parse_qualified_identifier(p, follow);
        }
        return _parse_element_option__inner_alt_1(p, follow);
    }
    p.no_viable(
        "no alternative of elementOption matches",
        p.peek_span(),
        &EXPECTED_6,
    );
    return;
}

fn _parse_element_option(p: &mut Parser, follow: i64 = 0) -> () {
    let _atn_ret = p.atn_ret_pending;
