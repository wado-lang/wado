fn _parse_element_option(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_ELEMENT_OPTION, _start);
    _parse_element_option__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_ELEMENT_OPTION, "elementOption", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_identifier__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_7, p.kinds[p.pos]) { p.sync_alts(&SYNC_7, &EXPECTED_7); }
    let kind = p.peek_kind();
    if _kind_set_1(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of identifier matches",
        p.peek_span(),
        &EXPECTED_7,
    );
    return;
}

fn _parse_identifier(p: &mut Parser) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_IDENTIFIER, _start);
    _parse_identifier__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_IDENTIFIER, "identifier", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _parse_qualified_identifier__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.site = 133;
    _parse_identifier(p);
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_32_done: {
                sg_32: {
                    if pos >= tokens.len() || tokens[pos] != TK_DOT { break sg_32; }
                    pos += 1;
                    if pos >= tokens.len() || !_kind_set_1(tokens[pos]) { break sg_32; }
                    pos += 1;
                    break sg_32_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        p.expect(TK_DOT, &SYNC_7, false);
        p.site = 134;
        _parse_identifier(p);
    }
    return;
}

fn _parse_qualified_identifier(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_QUALIFIED_IDENTIFIER, _start);
    _parse_qualified_identifier__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_QUALIFIED_IDENTIFIER, "qualifiedIdentifier", -1); }
    p.b.finish_node(p.last_end());
    p.sites.pop();
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult with LexerAdaptor {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(d) = p.pending {
            p.diagnostics.push(d);
        }
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult with LexerAdaptor {
    return parse_grammar_spec(input, max_errors);
}

pub fn parse_grammar_spec<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult with LexerAdaptor {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_grammar_spec(p));
}

