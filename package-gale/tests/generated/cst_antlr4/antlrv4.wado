fn _parse_identifier__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _kind_set_1(kind) {
        let _ = p.expect(kind, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "expected identifier",
        p.peek_span(),
        ["TK_RULE_REF", "TK_TOKEN_REF"],
