fn scan_id_list(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_identifier(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_COMMA && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_3_done: {
            sg_3: {
                if pos >= tokens.len() || tokens[pos] != TK_COMMA { break sg_3; }
                pos += 1;
                pos = scan_identifier(tokens, pos, follow, 0);
                if pos < 0 { break sg_3; }
                break sg_3_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos < tokens.len() && tokens[pos] == TK_COMMA && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos] != TK_COMMA { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; }
    }
    return pos;
}

fn scan_action_(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_AT { return -1; }
