fn _parse_html_misc__inner(p: &mut Parser) -> () {
    let kind = p.peek_kind();
    if _kind_set_5(kind) {
        _parse_html_comment(p);
        return;
    }
    if kind == TK_SEA_WS {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of htmlMisc matches",
        p.peek_span(),
        &SYNC_12,
