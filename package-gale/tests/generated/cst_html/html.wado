        p.expect(TK_SCRIPTLET, &EMPTY_SYNC);
        return;
    }
    if kind == TK_SCRIPT_OPEN {
        _parse_script(p, follow);
        return;
    }
    if kind == TK_STYLE_OPEN {
        _parse_style(p, follow);
        return;
    }
    p.no_viable(
        "no alternative of htmlElement matches",
        p.peek_span(),
        &SYNC_7,
    );
    return;
}

fn _parse_html_element(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTMLELEMENT, _start);
    _parse_html_element__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlElement");
    }
}

fn _parse_html_content__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if !(follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF)) && (_kind_set_6(p.peek_kind())) {
        _parse_html_chardata(p, follow);
    }
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_7_done: {
                sg_7: {
                    let gp_8 = pos;
                    let sgk_8 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                    let mut sg_8_best = -1;
                    if _kind_set_4(sgk_8) {
                        pos = gp_8;
                        sg_8_0: {
                            pos = scan_html_element(tokens, pos, follow);
                            if pos < 0 { break sg_8_0; }
                            if pos > sg_8_best { sg_8_best = pos; }
                        }
                    } else if sgk_8 == TK_CDATA {
                        pos = gp_8;
                        sg_8_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_CDATA { break sg_8_1; }
                            pos += 1;
                            if pos > sg_8_best { sg_8_best = pos; }
                        }
                    } else if _kind_set_5(sgk_8) {
                        pos = gp_8;
                        sg_8_2: {
                            pos = scan_html_comment(tokens, pos, follow);
                            if pos < 0 { break sg_8_2; }
                            if pos > sg_8_best { sg_8_best = pos; }
                        }
                    }
                    if sg_8_best >= 0 {
                        pos = sg_8_best;
                    } else {
                        pos = gp_8;
                    }
                    if pos < tokens.len() && _kind_set_6(tokens[pos]) && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
                        let sp = pos;
                        pos = scan_html_chardata(tokens, pos, follow);
                        if pos < 0 { pos = sp; }
                    }
                    break sg_7_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let grp_kind = p.peek_kind();
        if _kind_set_4(grp_kind) {
            _parse_html_element(p, follow);
        } else if grp_kind == TK_CDATA {
            p.expect(TK_CDATA, &EMPTY_SYNC);
        } else if _kind_set_5(grp_kind) {
            _parse_html_comment(p, follow);
        } else {
            p.no_viable("no viable alternative", p.peek_span(), &SYNC_8);
        }
        if !(follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF)) && (_kind_set_6(p.peek_kind())) {
            _parse_html_chardata(p, follow);
        }
    }
    return;
}

fn _parse_html_content(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTMLCONTENT, _start);
    _parse_html_content__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlContent");
    }
}

fn _parse_html_attribute__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    p.expect(TK_TAG_NAME, &SYNC_9);
    if !(follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF)) && (p.peek_kind() == TK_TAG_EQUALS && p.peek_at(1) == TK_ATTVALUE_VALUE) {
        p.expect(TK_TAG_EQUALS, &SYNC_10);
        p.expect(TK_ATTVALUE_VALUE, &EMPTY_SYNC);
    }
    return;
}

fn _parse_html_attribute(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTMLATTRIBUTE, _start);
    _parse_html_attribute__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlAttribute");
    }
}

fn _parse_html_chardata__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    let kind = p.peek_kind();
    if _kind_set_6(kind) {
        let _ = p.expect(kind, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of htmlChardata matches",
        p.peek_span(),
        &SYNC_11,
    );
    return;
}

fn _parse_html_chardata(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTMLCHARDATA, _start);
    _parse_html_chardata__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlChardata");
    }
}

fn _parse_html_misc__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    let kind = p.peek_kind();
    if _kind_set_5(kind) {
        _parse_html_comment(p, follow);
        return;
    }
    if kind == TK_SEA_WS {
        p.expect(TK_SEA_WS, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of htmlMisc matches",
        p.peek_span(),
        &SYNC_12,
    );
    return;
}

fn _parse_html_misc(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTMLMISC, _start);
    _parse_html_misc__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlMisc");
    }
}

fn _parse_html_comment__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    let kind = p.peek_kind();
    if _kind_set_5(kind) {
        let _ = p.expect(kind, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of htmlComment matches",
        p.peek_span(),
        &SYNC_13,
    );
    return;
}

fn _parse_html_comment(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTMLCOMMENT, _start);
    _parse_html_comment__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlComment");
