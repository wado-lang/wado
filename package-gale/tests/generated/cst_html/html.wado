fn _parse_html_chardata__inner(p: &mut Parser) -> () {
    let kind = p.peek_kind();
    if _kind_set_6(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of htmlChardata matches",
        p.peek_span(),
        &SYNC_11,
