pub fn parse_script(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_script(p));
}

pub fn parse_style(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_style(p));
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(25);
    for let mut k = 0; k < 25; k += 1 {
        v.push(token_kind_name(k));
    }
    return v;
}

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &_token_names());
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &_token_names());
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_SCRIPTLET | TK_SEA_WS };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_SEA_WS | TK_STYLE_OPEN | TK_TAG_OPEN };
}

fn _kind_set_2(k: i32) -> bool {
    return k matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SEA_WS };
}

fn _kind_set_3(k: i32) -> bool {
    return k matches { TK_CDATA | TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_HTML_TEXT | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_SEA_WS | TK_STYLE_OPEN | TK_TAG_OPEN };
}

fn _kind_set_4(k: i32) -> bool {
    return k matches { TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN | TK_TAG_OPEN };
}

fn _kind_set_5(k: i32) -> bool {
    return k matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT };
}

fn _kind_set_6(k: i32) -> bool {
    return k matches { TK_HTML_TEXT | TK_SEA_WS };
}

fn _kind_set_7(k: i32) -> bool {
    return k matches { TK_CDATA | TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN | TK_TAG_OPEN };
}

global EMPTY_SYNC: List<i32> = [];
global SYNC_0: List<i32> = [TK_SCRIPTLET, TK_SEA_WS];
global SYNC_1: List<i32> = [TK_TAG_NAME];
global SYNC_2: List<i32> = [TK_TAG_CLOSE, TK_TAG_NAME, TK_TAG_SLASH_CLOSE];
global SYNC_3: List<i32> = [TK_CDATA, TK_HTML_COMMENT, TK_HTML_CONDITIONAL_COMMENT, TK_HTML_TEXT, TK_SCRIPTLET, TK_SCRIPT_OPEN, TK_SEA_WS, TK_STYLE_OPEN, TK_TAG_OPEN];
global SYNC_4: List<i32> = [TK_TAG_SLASH];
global SYNC_5: List<i32> = [TK_TAG_CLOSE];
global SYNC_6: List<i32> = [TK_TAG_CLOSE, TK_TAG_SLASH_CLOSE];
global SYNC_7: List<i32> = [TK_SCRIPTLET, TK_SCRIPT_OPEN, TK_STYLE_OPEN, TK_TAG_OPEN];
global SYNC_8: List<i32> = [TK_CDATA, TK_HTML_COMMENT, TK_HTML_CONDITIONAL_COMMENT, TK_SCRIPTLET, TK_SCRIPT_OPEN, TK_STYLE_OPEN, TK_TAG_OPEN];
global SYNC_9: List<i32> = [TK_TAG_EQUALS];
global SYNC_10: List<i32> = [TK_ATTVALUE_VALUE];
global SYNC_11: List<i32> = [TK_HTML_TEXT, TK_SEA_WS];
global SYNC_12: List<i32> = [TK_HTML_COMMENT, TK_HTML_CONDITIONAL_COMMENT, TK_SEA_WS];
global SYNC_13: List<i32> = [TK_HTML_COMMENT, TK_HTML_CONDITIONAL_COMMENT];
global SYNC_14: List<i32> = [TK_SCRIPT_BODY, TK_SCRIPT_SHORT_BODY];
global SYNC_15: List<i32> = [TK_STYLE_BODY, TK_STYLE_SHORT_BODY];

global FOLLOW_SETS: List<List<i32>> = [[TK_HTML_COMMENT, TK_HTML_CONDITIONAL_COMMENT, TK_SEA_WS], [TK_TAG_OPEN], [TK_TAG_SLASH], [TK_TAG_NAME], [TK_TAG_CLOSE]];
global FOLLOW_MASK_0: List<i32> = [0];
global FOLLOW_MASK_1: List<i32> = [1, 2, 3, 4];

