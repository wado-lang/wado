    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_html_content(p));
}

pub fn parse_html_attribute<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_html_attribute(p));
}

pub fn parse_html_chardata<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
