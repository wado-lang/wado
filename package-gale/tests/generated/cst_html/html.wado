fn _parse_html_attribute__inner(p: &mut Parser, follow: i64 = 0) -> () {
    p.expect(TK_TAG_NAME, &SYNC_9);
    if !(follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF)) && (p.peek_kind() == TK_TAG_EQUALS && p.peek_at(1) == TK_ATTVALUE_VALUE) {
        p.expect(TK_TAG_EQUALS, &SYNC_10);
        p.expect(TK_ATTVALUE_VALUE, &EMPTY_SYNC);
    }
    return;
}

fn _parse_html_attribute(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
