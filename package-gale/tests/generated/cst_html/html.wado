fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    push_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(d) = p.pending {
            p.diagnostics.push(d);
        }
    }
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_html_document(input, max_errors);
}

pub fn parse_html_document<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_html_document(p));
}

pub fn parse_scriptlet_or_sea_ws<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_scriptlet_or_sea_ws(p));
}

pub fn parse_html_elements<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_html_elements(p));
}

pub fn parse_html_element<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
