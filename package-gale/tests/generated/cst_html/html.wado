            if pos >= chars.len() || chars[pos] != 'e' { break ng_21; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != '>' { break ng_21; }
            pos += 1;
            ng_exit_21 = true;
        }
        if ng_exit_21 {
            break;
        }
        pos = ng_saved_21;
        if pos >= chars.len() { return -1; }
        pos += 1;
    }
    return pos;
}

fn try_STYLE_SHORT_BODY(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    loop {
        let ng_saved_22 = pos;
        let mut ng_exit_22 = false;
        ng_22: {
            if pos >= chars.len() || chars[pos] != '<' { break ng_22; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != '/' { break ng_22; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != '>' { break ng_22; }
            pos += 1;
            ng_exit_22 = true;
        }
        if ng_exit_22 {
            break;
        }
        pos = ng_saved_22;
        if pos >= chars.len() { return -1; }
        pos += 1;
    }
    return pos;
}

fn try_ATTVALUE_VALUE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    loop {
        let rep_saved_23 = pos;
        rep_23: {
            if pos >= chars.len() || chars[pos] != ' ' { break rep_23; }
            pos += 1;
            continue;
        }
        pos = rep_saved_23;
        break;
    }
    pos = try_ATTRIBUTE(chars, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn try_ATTRIBUTE(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_24 = pos;
    alts_done_24: {
        alts_24_0: {
            pos = alts_saved_24;
            if pos >= chars.len() || chars[pos] != '"' { break alts_24_0; }
            pos += 1;
            loop {
                let rep_saved_25 = pos;
                rep_25: {
                    if pos >= chars.len() { break rep_25; }
                    if (chars[pos] matches { '<' | '"' }) { break rep_25; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_25;
                break;
            }
            if pos >= chars.len() || chars[pos] != '"' { break alts_24_0; }
            pos += 1;
            break alts_done_24;
        }
        alts_24_1: {
            pos = alts_saved_24;
            if pos >= chars.len() || chars[pos] != '\'' { break alts_24_1; }
            pos += 1;
            loop {
                let rep_saved_26 = pos;
                rep_26: {
                    if pos >= chars.len() { break rep_26; }
                    if (chars[pos] matches { '<' | '\'' }) { break rep_26; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_26;
                break;
            }
            if pos >= chars.len() || chars[pos] != '\'' { break alts_24_1; }
            pos += 1;
            break alts_done_24;
        }
        alts_24_2: {
            pos = alts_saved_24;
            if pos >= chars.len() { break alts_24_2; }
            if !((chars[pos] matches { '#' | '+'..=';' | '=' | '?' | 'A'..='Z' | '_' | 'a'..='z' })) { break alts_24_2; }
            pos += 1;
            loop {
                let rep_saved_27 = pos;
                rep_27: {
                    if pos >= chars.len() { break rep_27; }
                    if !((chars[pos] matches { '#' | '+'..=';' | '=' | '?' | 'A'..='Z' | '_' | 'a'..='z' })) { break rep_27; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_27;
                break;
            }
            let opt_saved_29 = pos;
            let mut opt_ok_29 = false;
            opt_29: {
                if pos >= chars.len() || chars[pos] != ' ' { break opt_29; }
                pos += 1;
                opt_ok_29 = true;
            }
            if !opt_ok_29 { pos = opt_saved_29; }
            break alts_done_24;
        }
        alts_24_3: {
            pos = alts_saved_24;
            if pos >= chars.len() || chars[pos] != '#' { break alts_24_3; }
            pos += 1;
            if pos >= chars.len() { break alts_24_3; }
            if !((chars[pos] matches { '0'..='9' | 'a'..='f' | 'A'..='F' })) { break alts_24_3; }
            pos += 1;
            loop {
                let rep_saved_30 = pos;
                rep_30: {
                    if pos >= chars.len() { break rep_30; }
                    if !((chars[pos] matches { '0'..='9' | 'a'..='f' | 'A'..='F' })) { break rep_30; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_30;
                break;
            }
            break alts_done_24;
        }
        alts_24_4: {
            pos = alts_saved_24;
            if pos >= chars.len() { break alts_24_4; }
            if !((chars[pos] matches { '0'..='9' })) { break alts_24_4; }
            pos += 1;
            loop {
                let rep_saved_32 = pos;
                rep_32: {
                    if pos >= chars.len() { break rep_32; }
                    if !((chars[pos] matches { '0'..='9' })) { break rep_32; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_32;
                break;
            }
            let opt_saved_34 = pos;
            let mut opt_ok_34 = false;
            opt_34: {
                if pos >= chars.len() || chars[pos] != '%' { break opt_34; }
                pos += 1;
                opt_ok_34 = true;
            }
            if !opt_ok_34 { pos = opt_saved_34; }
            break alts_done_24;
        }
        return -1;
    }
    return pos;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    let mut mode_stack: List<i32> = [];
    let mut current_mode: i32 = 0;
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        let mut best_push_mode: i32 = -1;
        let mut best_pop_mode = false;
        let mut best_channel: i32 = 0;
        if current_mode == 0 {
            match first_char {
                '\t' | '\n' | '\r' | ' ' => {
                    end = try_SEA_WS(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_SEA_WS; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                    end = try_HTML_TEXT(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_HTML_TEXT; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                },
                '\u{b}'..='\u{c}' | '\u{e}'..='\u{1f}' | '!'..=';' => {
                    end = try_HTML_TEXT(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_HTML_TEXT; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                },
                '<' => {
                    end = try_HTML_COMMENT(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_HTML_COMMENT; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                    end = try_HTML_CONDITIONAL_COMMENT(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_HTML_CONDITIONAL_COMMENT; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                    end = try_XML(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_XML; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                    end = try_CDATA(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_CDATA; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                    end = try_DTD(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_DTD; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                    end = try_SCRIPTLET(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_SCRIPTLET; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                    end = try_SCRIPT_OPEN(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_SCRIPT_OPEN; best_push_mode = 1; best_pop_mode = false; best_channel = 0; }
                    end = try_STYLE_OPEN(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_STYLE_OPEN; best_push_mode = 2; best_pop_mode = false; best_channel = 0; }
                    end = try_TAG_OPEN(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TAG_OPEN; best_push_mode = 3; best_pop_mode = false; best_channel = 0; }
                    end = try_HTML_TEXT(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_HTML_TEXT; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                },
                _ => {
                    end = try_HTML_TEXT(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_HTML_TEXT; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                },
            }
        } else if current_mode == 1 {
            end = try_SCRIPT_BODY(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCRIPT_BODY; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
            end = try_SCRIPT_SHORT_BODY(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCRIPT_SHORT_BODY; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
        } else if current_mode == 2 {
            end = try_STYLE_BODY(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STYLE_BODY; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
            end = try_STYLE_SHORT_BODY(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STYLE_SHORT_BODY; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
        } else if current_mode == 3 {
            match first_char {
                '\t' | '\n' | '\r' | ' ' => {
                    end = try_TAG_WHITESPACE(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TAG_WHITESPACE; best_push_mode = -1; best_pop_mode = false; best_channel = 1; }
                },
                '/' => {
                    end = try_TAG_SLASH_CLOSE(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TAG_SLASH_CLOSE; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
                    end = try_TAG_SLASH(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TAG_SLASH; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                },
                ':' | 'A'..='Z' | 'a'..='z' | '⁰'..='\u{218f}' | 'Ⰰ'..='\u{2fef}' | '、'..='\u{d7ff}' | '豈'..='﷏' | 'ﷰ'..='�' => {
                    end = try_TAG_NAME(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TAG_NAME; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                },
                '=' => {
                    end = try_TAG_EQUALS(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TAG_EQUALS; best_push_mode = 4; best_pop_mode = false; best_channel = 0; }
                },
                '>' => {
                    end = try_TAG_CLOSE(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TAG_CLOSE; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
                },
                _ => {},
            }
        } else if current_mode == 4 {
            match first_char {
                ' ' => {
                    end = try_ATTVALUE_VALUE(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_ATTVALUE_VALUE; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
                },
                '"' | '#' | '\'' | '+' | ',' | '-' | '.' | '/' | '0'..='9' | ':' | ';' | '=' | '?' | 'A'..='Z' | '_' | 'a'..='z' => {
                    end = try_ATTVALUE_VALUE(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_ATTVALUE_VALUE; best_push_mode = -1; best_pop_mode = true; best_channel = 0; }
                    end = try_ATTRIBUTE(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_ATTRIBUTE; best_push_mode = -1; best_pop_mode = false; best_channel = 0; }
                },
                _ => {},
            }
        }
        if best_end < start || (best_end == start && best_push_mode < 0 && !best_pop_mode) {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            if best_push_mode >= 0 {
                mode_stack.push(current_mode);
                current_mode = best_push_mode;
                best_push_mode = -1;
            }
            if best_pop_mode {
                if mode_stack.is_empty() {
                    current_mode = 0;
                } else {
                    current_mode = mode_stack[mode_stack.len() - 1];
                    mode_stack.pop();
                }
                best_pop_mode = false;
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_HTML_COMMENT => "HTML_COMMENT",
        TK_HTML_CONDITIONAL_COMMENT => "HTML_CONDITIONAL_COMMENT",
        TK_XML => "XML",
        TK_CDATA => "CDATA",
        TK_DTD => "DTD",
        TK_SCRIPTLET => "SCRIPTLET",
        TK_SEA_WS => "SEA_WS",
        TK_SCRIPT_OPEN => "SCRIPT_OPEN",
        TK_STYLE_OPEN => "STYLE_OPEN",
        TK_TAG_OPEN => "TAG_OPEN",
        TK_HTML_TEXT => "HTML_TEXT",
        TK_TAG_CLOSE => "TAG_CLOSE",
        TK_TAG_SLASH_CLOSE => "TAG_SLASH_CLOSE",
        TK_TAG_SLASH => "TAG_SLASH",
        TK_TAG_EQUALS => "TAG_EQUALS",
        TK_TAG_NAME => "TAG_NAME",
        TK_TAG_WHITESPACE => "TAG_WHITESPACE",
        TK_SCRIPT_BODY => "SCRIPT_BODY",
        TK_SCRIPT_SHORT_BODY => "SCRIPT_SHORT_BODY",
        TK_STYLE_BODY => "STYLE_BODY",
        TK_STYLE_SHORT_BODY => "STYLE_SHORT_BODY",
        TK_ATTVALUE_VALUE => "ATTVALUE_VALUE",
        TK_ATTRIBUTE => "ATTRIBUTE",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

pub global RK_HTML_DOCUMENT: NodeKind = 0;
pub global RK_SCRIPTLET_OR_SEA_WS: NodeKind = 1;
pub global RK_HTML_ELEMENTS: NodeKind = 2;
pub global RK_HTML_ELEMENT: NodeKind = 3;
pub global RK_HTML_CONTENT: NodeKind = 4;
pub global RK_HTML_ATTRIBUTE: NodeKind = 5;
pub global RK_HTML_CHARDATA: NodeKind = 6;
pub global RK_HTML_MISC: NodeKind = 7;
pub global RK_HTML_COMMENT: NodeKind = 8;
pub global RK_SCRIPT: NodeKind = 9;
pub global RK_STYLE: NodeKind = 10;

global RULE_NAMES: List<String> = ["htmlDocument", "scriptletOrSeaWs", "htmlElements", "htmlElement", "htmlContent", "htmlAttribute", "htmlChardata", "htmlMisc", "htmlComment", "script", "style"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.recovering = true;
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
        }
        self.recovering = true;
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            let code = if self.kinds[self.pos] == TK_EOF { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
            self.fail_on_token("got", &([kind] as List<i32>), code);
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::Deleted));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let found = self.kinds[self.pos];
        let at_eof = found == TK_EOF;
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.diagnostics.push(Diagnostic::error(code, `missing ${token_kind_name(kind)}`, self.tokens.span_at(self.pos), [kind], found, recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(kind);
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind);
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(kind);
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        let kind = self.kinds[self.pos];
        if kind == TK_EOF {
            self.b.token(self.pos);
            return self.pos;
        }
        let _i = self.advance();
        self.b.token(_i);
        return _i;
    }

