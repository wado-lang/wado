fn _parse_html_elements__inner(p: &mut Parser, follow: i64 = 0) -> () {
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_html_misc(tokens, pos);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 {
            if _kind_set_2(p.peek_kind()) {
                let _rec_pos = p.pos;
                let _rec_cp = p.b.checkpoint();
                let _rec_sav = p.recovering;
                let _rec_spec = p.speculating;
                p.speculating = true;
                _parse_html_misc(p);
                p.speculating = _rec_spec;
                p.recovering = _rec_sav;
                p.pos = _rec_pos;
                p.b.truncate(_rec_cp);
            }
            break;
        }
        _parse_html_misc(p);
    }
    _parse_html_element(p, follow);
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos_2: i32 = -1;
        rep_scan_2: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_html_misc(tokens, pos);
            if pos < 0 { break rep_scan_2; }
            if pos <= p.pos { break rep_scan_2; }
            rep_scan_pos_2 = pos;
        }
        if rep_scan_pos_2 < 0 {
            if _kind_set_2(p.peek_kind()) {
                let _rec_pos = p.pos;
                let _rec_cp = p.b.checkpoint();
                let _rec_sav = p.recovering;
                let _rec_spec = p.speculating;
                p.speculating = true;
                _parse_html_misc(p);
                p.speculating = _rec_spec;
                p.recovering = _rec_sav;
                p.pos = _rec_pos;
                p.b.truncate(_rec_cp);
            }
            break;
        }
        _parse_html_misc(p);
    }
    return;
}

fn _parse_html_elements(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTML_ELEMENTS, _start);
    _parse_html_elements__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlElements");
    }
}

fn _parse_html_element__inner(p: &mut Parser, follow: i64 = 0) -> () {
    let kind = p.peek_kind();
    if kind == TK_TAG_OPEN {
        p.take();
        p.expect(TK_TAG_NAME, &SYNC_1);
        loop {
            if p.recovering { break; }
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                pos = scan_html_attribute(tokens, pos, 0);
                if pos < 0 { break rep_scan; }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 {
                if p.peek_kind() == TK_TAG_NAME {
                    let _rec_pos = p.pos;
                    let _rec_cp = p.b.checkpoint();
                    let _rec_sav = p.recovering;
                    let _rec_spec = p.speculating;
                    p.speculating = true;
                    _parse_html_attribute(p, 0);
                    p.speculating = _rec_spec;
                    p.recovering = _rec_sav;
                    p.pos = _rec_pos;
                    p.b.truncate(_rec_cp);
                }
                break;
            }
            _parse_html_attribute(p, 0);
        }
        let grp_kind = p.peek_kind();
        if grp_kind == TK_TAG_CLOSE {
            p.expect(TK_TAG_CLOSE, &SYNC_2);
            let mut opt_scan_pos: i32 = -1;
            opt_scan: {
                let tokens = &p.kinds;
                let mut pos: i32 = p.pos;
                pos = scan_html_content(tokens, pos, FOLLOW_MASK_0);
                if pos < 0 { break opt_scan; }
                if pos >= tokens.len() || tokens[pos] != TK_TAG_OPEN { break opt_scan; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_TAG_SLASH { break opt_scan; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_TAG_NAME { break opt_scan; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_TAG_CLOSE { break opt_scan; }
                pos += 1;
                opt_scan_pos = pos;
            }
            if !(follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF)) && (opt_scan_pos >= 0) {
                _parse_html_content(p, FOLLOW_MASK_0);
                p.expect(TK_TAG_OPEN, &SYNC_3);
                p.expect(TK_TAG_SLASH, &SYNC_4);
                p.expect(TK_TAG_NAME, &SYNC_5);
                p.expect(TK_TAG_CLOSE, &EMPTY_SYNC);
            }
        } else if grp_kind == TK_TAG_SLASH_CLOSE {
            p.expect(TK_TAG_SLASH_CLOSE, &EMPTY_SYNC);
        } else {
            p.no_viable("no viable alternative", p.peek_span(), &SYNC_6);
        }
        return;
    }
    if kind == TK_SCRIPTLET {
        p.take();
        return;
    }
    if kind == TK_SCRIPT_OPEN {
        _parse_script(p);
        return;
    }
    if kind == TK_STYLE_OPEN {
        _parse_style(p);
        return;
    }
    p.no_viable(
        "no alternative of htmlElement matches",
        p.peek_span(),
        &SYNC_7,
    );
    return;
}

fn _parse_html_element(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTML_ELEMENT, _start);
    _parse_html_element__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("htmlElement");
    }
}

fn _parse_html_content__inner(p: &mut Parser, follow: i64 = 0) -> () {
    if !(follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF)) && (_kind_set_6(p.peek_kind())) {
        _parse_html_chardata(p);
    }
    loop {
        if p.recovering { break; }
        if follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_8_done: {
                sg_8: {
                    sg_9_done: {
                        let sgk_9 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                        if _kind_set_4(sgk_9) {
                            sg_9_0: {
                                pos = scan_html_element(tokens, pos, follow);
                                if pos < 0 { break sg_9_0; }
                                break sg_9_done;
                            }
                        } else if sgk_9 == TK_CDATA {
                            pos += 1;
                            break sg_9_done;
                        } else if _kind_set_5(sgk_9) {
                            pos += 1;
                            break sg_9_done;
                        }
                        break sg_8;
                    }
                    if pos < tokens.len() && _kind_set_6(tokens[pos]) && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
                        let sp = pos;
                        pos += 1;
                        if pos < 0 { pos = sp; }
                    }
                    break sg_8_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let grp_kind = p.peek_kind();
        if _kind_set_4(grp_kind) {
            _parse_html_element(p, follow);
        } else if grp_kind == TK_CDATA {
            p.expect(TK_CDATA, &EMPTY_SYNC);
        } else if _kind_set_5(grp_kind) {
            _parse_html_comment(p);
        } else {
            p.no_viable("no viable alternative", p.peek_span(), &SYNC_8);
        }
        if !(follow_yields(&p.kinds, p.pos, follow, &FOLLOW_SETS, TK_EOF)) && (_kind_set_6(p.peek_kind())) {
            _parse_html_chardata(p);
        }
    }
    return;
}

fn _parse_html_content(p: &mut Parser, follow: i64 = 0) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_HTML_CONTENT, _start);
    _parse_html_content__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
