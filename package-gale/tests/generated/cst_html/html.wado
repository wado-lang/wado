}

pub fn parse_script<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_script(p));
}

pub fn parse_style<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
