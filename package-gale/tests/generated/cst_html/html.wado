}

fn _parse_style__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    p.expect(TK_STYLE_OPEN, &SYNC_15);
    p.expect_set(&SYNC_15);
    return;
}

fn _parse_style(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_STYLE, _start);
    _parse_style__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("style");
