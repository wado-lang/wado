}

fn _parse_script__inner(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    p.expect(TK_SCRIPT_OPEN, &SYNC_14);
    p.expect_set(&SYNC_14);
    return;
}

fn _parse_script(p: &mut Parser, follow: &List<i32> = &EMPTY_FOLLOW) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_SCRIPT, _start);
    _parse_script__inner(p, follow);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("script");
