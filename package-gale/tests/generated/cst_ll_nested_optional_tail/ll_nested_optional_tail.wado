}

pub struct Diagnostic {
    pub severity: Severity,
    pub code: DiagnosticCode,
    pub message: String,
    pub span: Span,
    pub line: i32 = 1,
    pub col: i32 = 0,
    pub expected: List<i32> = [],
    pub found: i32 = -1,
    pub rule_stack: List<String> = [],
    pub recovery: RecoveryAction = RecoveryAction::None,
    pub related: List<RelatedInfo> = [],
}

impl Diagnostic {
    pub fn error(code: DiagnosticCode, message: String, span: Span, line: i32, col: i32) -> Diagnostic {
        return Diagnostic {
            severity: Severity::Error,
            code,
            message,
            span,
            line,
            col,
        };
    }

    pub fn is_error(&self) -> bool {
        return self.severity matches { Error };
    }
}

impl Display for Diagnostic {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(&`${self.severity.label()}[${self.code.name()}] at ${self.line}:${self.col}: ${self.message}`);
        for let r of &self.related {
            f.write_str(&`\n  note: ${r.message}`);
        }
    }
}

pub fn line_col(chars: &List<char>, pos: i32) -> [i32, i32] {
    let mut line = 1;
    let mut col = 0;
    let cap = if pos < chars.len() { pos } else { chars.len() };
    for let mut i = 0; i < cap; i += 1 {
        if chars[i] == '\n' {
            line += 1;
            col = 0;
        } else {
            col += 1;
        }
    }
    return [line, col];
}

pub type NodeKind = i32;

pub global K_ERROR: NodeKind = -1;

pub flags NodeFlags {
    Error,
    Incomplete,
}

pub enum EventTag {
    Open,
    Close,
    Tok,
    Miss,
    Skip,
}

pub struct CstStore {
    pub tag: List<EventTag>,
    pub a: List<i32>,
    pub b: List<i32>,
    alt: List<i32>,
    end: List<i32>,
    flags: List<NodeFlags>,
    next: List<i32>,
}

pub enum ChildKind {
    Node,
    Token,
    Missing,
    Skipped,
}

impl CstStore {
    pub fn row_count(&self) -> i32 {
        return self.tag.len();
    }

    pub fn kind(&self, i: i32) -> NodeKind {
        return self.a[i] as NodeKind;
    }

    pub fn close_kind(&self, i: i32) -> NodeKind {
        return self.b[i] as NodeKind;
    }

    pub fn span(&self, i: i32) -> Span {
        return Span::new(self.b[i], self.end[i]);
    }

    pub fn alt(&self, i: i32) -> i32 {
        return self.alt[i];
    }

    pub fn is_error(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Error != NodeFlags::none();
    }

    pub fn is_incomplete(&self, i: i32) -> bool {
        return self.flags[i] & NodeFlags::Incomplete != NodeFlags::none();
    }

    pub fn is_node(&self, i: i32) -> bool {
        return self.tag[i] matches { Open };
    }

    pub fn is_token(&self, i: i32) -> bool {
        let t = self.tag[i];
        return t matches { Tok | Miss | Skip };
    }

    pub fn child_kind(&self, i: i32) -> ChildKind {
        return match self.tag[i] {
            Open => ChildKind::Node,
            Miss => ChildKind::Missing,
            Skip => ChildKind::Skipped,
            Tok => ChildKind::Token,
            Close => panic("CstStore::child_kind: Close is not a child row"),
        };
    }

    pub fn token_index(&self, i: i32) -> i32 {
        return self.a[i];
    }

    pub fn first_child(&self, i: i32) -> i32 {
        let c = i + 1;
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn next_sibling(&self, child: i32) -> i32 {
        let c = if self.tag[child] matches { Open } { self.next[child] } else { child + 1 };
        if c >= self.tag.len() || self.tag[c] matches { Close } {
            return -1;
        }
        return c;
    }

    pub fn find_child(&self, i: i32, kind: NodeKind) -> i32 {
        let k = kind as i32;
        for let mut c = self.first_child(i); c >= 0; c = self.next_sibling(c) {
            if self.tag[c] matches { Open } && self.kind(c) as i32 == k {
                return c;
            }
        }
        return -1;
    }

    pub fn to_string_tree(
        &self,
        i: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(256);
        cst_to_string_tree_impl(&mut out, self, i, toks, rule_names, token_names);
        return out;
    }
}

fn cst_to_string_tree_impl(
    out: &mut String,
    s: &CstStore,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) {
    let node_kind = s.kind(i) as i32;
    let name = if node_kind == K_ERROR as i32 { "<error>" } else { rule_names[node_kind] };
    if i + 1 >= s.tag.len() || s.tag[i + 1] matches { Close } {
        out.push_str(&name);
        return;
    }
    out.push_str(&"(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < s.next[i] {
        match s.tag[c] {
            Open => {
                out.push_str(&" ");
                cst_to_string_tree_impl(out, s, c, toks, rule_names, token_names);
                c = s.next[c];
            },
            Tok => {
                if !toks.is_empty_text(s.token_index(c)) {
                    out.push_str(&" ");
                    toks.push_token_text_escaped(out, s.token_index(c));
                }
                c += 1;
            },
            Miss => {
                out.push_str(&` <missing ${token_names[toks.kind_at(s.token_index(c))]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(&" <skip ");
                toks.push_token_text_escaped(out, s.token_index(c));
                out.push_str(&">");
                c += 1;
            },
            Close => c += 1,
        }
    }
    out.push_str(&")");
}

pub struct ParseResult {
    pub cst: CstStore,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
    pub output: String = "",
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        return self.diagnostics.iter_ref().any(|d| d.is_error());
    }

    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

fn bubble_to_parent(stack: &List<i32>, end: &mut List<i32>, flags: &mut List<NodeFlags>, child: i32) {
    if stack.len() > 0 {
        let parent = stack[stack.len() - 1];
        if end[child] > end[parent] {
            end[parent] = end[child];
        }
        flags[parent] = flags[parent] | flags[child] & NodeFlags::Error;
    }
}

pub struct TreeBuilder {
    tag: List<EventTag>,
    a: List<i32>,
    b: List<i32>,
    alt: List<i32>,
    open: List<i32>,
    last_finished: i32,
}

impl TreeBuilder {
    pub fn new() -> TreeBuilder {
        return TreeBuilder { tag: [], a: [], b: [], alt: [], open: [], last_finished: -1 };
    }

    pub fn with_capacity(rows: i32) -> TreeBuilder {
        return TreeBuilder {
            tag: List::with_capacity(rows),
            a: List::with_capacity(rows),
            b: List::with_capacity(rows),
            alt: List::with_capacity(rows),
            open: [],
            last_finished: -1,
        };
    }

    fn push_row(&mut self, tag: EventTag, a: i32, b: i32) {
        if self.tag.len() >= self.tag.capacity() {
            builtin::cold_path();
            self.tag.grow();
            self.a.grow();
            self.b.grow();
            self.alt.grow();
            assert self.a.capacity() == self.tag.capacity()
                && self.b.capacity() == self.tag.capacity()
                && self.alt.capacity() == self.tag.capacity(), "TreeBuilder event columns must grow in lockstep";
        }
        self.tag.push_within_capacity(tag);
        self.a.push_within_capacity(a);
        self.b.push_within_capacity(b);
        self.alt.push_within_capacity(-1);
    }

    pub fn start_node(&mut self, kind: NodeKind, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, kind as i32, start);
        self.open.push(row);
    }

    pub fn start_error(&mut self, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, K_ERROR as i32, start);
        self.open.push(row);
    }

    pub fn set_alt(&mut self, alt: i32) {
        self.alt[self.open[self.open.len() - 1]] = alt;
    }

    pub fn checkpoint(&self) -> i32 {
        return self.tag.len();
    }

    pub fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32) {
        self.tag.insert(checkpoint, EventTag::Open);
        self.a.insert(checkpoint, kind as i32);
        self.b.insert(checkpoint, start);
        self.alt.insert(checkpoint, -1);
        self.open.push(checkpoint);
    }

    pub fn truncate(&mut self, checkpoint: i32) {
        while self.tag.len() > checkpoint {
            let _ = self.tag.pop();
            let _ = self.a.pop();
            let _ = self.b.pop();
            let _ = self.alt.pop();
        }
        while self.open.len() > 0 && self.open[self.open.len() - 1] >= checkpoint {
            let _ = self.open.pop();
        }
    }

    pub fn finish_node(&mut self, end: i32) {
        self.push_row(EventTag::Close, end, 0);
        self.last_finished = self.open[self.open.len() - 1];
        let _ = self.open.pop();
    }

    pub fn token(&mut self, idx: i32) {
        self.push_row(EventTag::Tok, idx, 0);
    }

    pub fn missing(&mut self, syn_idx: i32) {
        self.push_row(EventTag::Miss, syn_idx, 0);
    }

    pub fn skip(&mut self, idx: i32) {
        self.push_row(EventTag::Skip, idx, 0);
    }

    pub fn finish(&self) -> CstStore {
        let n = self.tag.len();
        let mut b = self.b;
        let mut end = List::filled(n, 0);
        let mut flags = List::filled(n, NodeFlags::none());
        let mut next = List::filled(n, 0);
        let mut stack: List<i32> = [];
        for let mut r = 0; r < n; r += 1 {
            match self.tag[r] {
                Open => {
                    let node_kind = self.a[r];
                    let start_offset = self.b[r];
                    if node_kind == K_ERROR as i32 {
                        flags[r] = NodeFlags::Error;
                    }
                    end[r] = start_offset;
                    stack.push(r);
                },
                Miss => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Incomplete | NodeFlags::Error;
                },
                Skip => {
                    let oi = stack[stack.len() - 1];
                    flags[oi] = flags[oi] | NodeFlags::Error;
                },
                Close => {
                    let oi = stack[stack.len() - 1];
                    let _ = stack.pop();
                    let close_offset = self.a[r];
                    let open_kind = self.a[oi];
                    if close_offset > end[oi] {
                        end[oi] = close_offset;
                    }
                    b[r] = open_kind;
                    next[oi] = r + 1;
                    bubble_to_parent(&stack, &mut end, &mut flags, oi);
                },
                Tok => {
                },
            }
        }
        while stack.len() > 0 {
            let oi = stack[stack.len() - 1];
            let _ = stack.pop();
            next[oi] = n;
            bubble_to_parent(&stack, &mut end, &mut flags, oi);
        }
        return CstStore { tag: self.tag, a: self.a, b, alt: self.alt, end, flags, next };
    }

    pub fn render_open(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if self.open.len() == 0 {
            return String::new();
        }
        return self.render_from(self.open[self.open.len() - 1], toks, rule_names, token_names);
    }

    pub fn render_at(&self, row: i32, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        if row < 0 || row >= self.tag.len() || !self.tag[row] matches { Open } {
            return String::new();
        }
        return self.render_from(row, toks, rule_names, token_names);
    }

    pub fn open_rule_names(&self, rule_names: &List<String>) -> String {
        let mut out = String::from("[");
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            if i < self.open.len() - 1 {
                out.push_str(&", ");
            }
            let kind = self.a[self.open[i]];
            let name = if kind == K_ERROR as i32 { "<error>" } else { rule_names[kind] };
            out.push_str(&name);
        }
        out.push_str(&"]");
        return out;
    }

    pub fn render_last_finished(
        &self,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if self.last_finished < 0 {
            return String::new();
        }
        return self.render_from(self.last_finished, toks, rule_names, token_names);
    }

    fn render_from(
        &self,
        root: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(128);
        let _ = render_builder_node(&mut out, &self.tag, &self.a, root, toks, rule_names, token_names);
        return out;
    }
}

fn render_builder_node(
    out: &mut String,
    tag: &List<EventTag>,
    a: &List<i32>,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) -> i32 {
    let name = if a[i] == K_ERROR as i32 { "<error>" } else { rule_names[a[i]] };
    if i + 1 >= tag.len() || tag[i + 1] matches { Close } {
        out.push_str(&name);
        if i + 1 < tag.len() {
            return i + 2;
        }
        return i + 1;
    }
    out.push_str(&"(");
    out.push_str(&name);
    let mut c = i + 1;
    while c < tag.len() {
        match tag[c] {
            Open => {
                out.push_str(&" ");
                c = render_builder_node(out, tag, a, c, toks, rule_names, token_names);
            },
            Close => {
                out.push_str(&")");
                return c + 1;
            },
            Tok => {
                if !toks.is_empty_text(a[c]) {
                    out.push_str(&" ");
                    toks.push_token_text_escaped(out, a[c]);
                }
                c += 1;
            },
            Miss => {
                out.push_str(&` <missing ${token_names[toks.kind_at(a[c])]}>`);
                c += 1;
            },
            Skip => {
                out.push_str(&" <skip ");
                toks.push_token_text_escaped(out, a[c]);
                out.push_str(&">");
                c += 1;
            },
        }
    }
    out.push_str(&")");
    return c;
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let chars = tokens.chars;
    let mut line_starts: List<i32> = [0];
    for let mut i = 0; i < chars.len(); i += 1 {
        if chars[i] == '\n' {
            line_starts.push(i + 1);
        }
    }
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.triv_lo[i];
        let hi = tokens.triv_hi[i];
        for let mut t = lo; t < hi; t += 1 {
            if tokens.triv_chans[t] != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.triv_kinds[t],
                    tokens.triv_starts[t],
                    tokens.triv_ends[t],
                    tokens.triv_chans[t],
                    &line_starts,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.starts[i],
            tokens.ends[i],
            0,
            &line_starts,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    line_starts: &List<i32>,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let mut text_buf = String::with_capacity(16);
    if is_eof {
        text_buf.push_str(&"<EOF>");
    } else {
        for let mut j = start; j < end; j += 1 {
            let c = tokens.chars[j];
            match c {
                '\n' => text_buf.push_str(&"\\n"),
                '\r' => text_buf.push_str(&"\\r"),
                '\t' => text_buf.push_str(&"\\t"),
                _ => text_buf.push(c),
            }
        }
    }
    let type_id = if is_eof { -1 } else { kind + 1 };
    let line_col = line_col_from_starts(line_starts, start);
    let line = line_col.0;
    let col = line_col.1;
    let end_inclusive = end - 1;
    let channel_attr = if channel != 0 { `channel=${channel},` } else { String::from("") };
    out.push_str(&`[@${index},${start}:${end_inclusive}='${text_buf}',<${type_id}>,${channel_attr}${line}:${col}]\n`);
}

fn line_col_from_starts(line_starts: &List<i32>, pos: i32) -> [i32, i32] {
    let mut lo = 0;
    let mut hi = line_starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if line_starts[mid] <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return [lo + 1, pos - line_starts[lo]];
}
pub enum TokenKind {
    ID,
    INT,
    WS,
    Eof,
    Error,
}

pub global TK_ID: i32 = 0;
pub global TK_INT: i32 = 1;
pub global TK_WS: i32 = 2;
pub global TK_EOF: i32 = 3;
pub global TK_ERROR: i32 = 4;
pub global TK_LIT_LET: i32 = 5;
pub global TK_LIT_EQ: i32 = 6;
pub global TK_LIT_ELSE: i32 = 7;
pub global TK_LIT_SEMI: i32 = 8;
pub global TK_LIT_PLUS: i32 = 9;
pub global TK_LIT_LPAREN: i32 = 10;
pub global TK_LIT_RPAREN: i32 = 11;
pub global TK_LIT_LBRACE: i32 = 12;
pub global TK_LIT_RBRACE: i32 = 13;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice with stores[self] {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_ID(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { 'a'..='z' | 'A'..='Z' | '_' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !((chars[pos] matches { 'a'..='z' | 'A'..='Z' | '_' | '0'..='9' })) { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_INT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { '0'..='9' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            if pos >= chars.len() { break rep_1; }
            if !((chars[pos] matches { '0'..='9' })) { break rep_1; }
            pos += 1;
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_2 = pos;
        rep_2: {
            if pos >= chars.len() { break rep_2; }
            if !((chars[pos] matches { ' ' | '\t' | '\r' | '\n' })) { break rep_2; }
            pos += 1;
            continue;
        }
        pos = rep_saved_2;
        break;
    }
    return pos;
}

fn try_lit_let(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'l' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'e' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 't' { return -1; }
    return pos + 3;
}

fn try_lit_eq(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '=' { return -1; }
    return pos + 1;
}

fn try_lit_else(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'e' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'l' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 's' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'e' { return -1; }
    return pos + 4;
}

fn try_lit_semi(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ';' { return -1; }
    return pos + 1;
}

fn try_lit_plus(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '+' { return -1; }
    return pos + 1;
}

fn try_lit_lparen(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '(' { return -1; }
    return pos + 1;
}

fn try_lit_rparen(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ')' { return -1; }
    return pos + 1;
}

fn try_lit_lbrace(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '{' { return -1; }
    return pos + 1;
}

fn try_lit_rbrace(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '}' { return -1; }
    return pos + 1;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char matches { '\t' | '\n' | '\r' | ' ' } {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char matches { '(' } {
            end = try_lit_lparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LPAREN; }
        } else if first_char matches { ')' } {
            end = try_lit_rparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RPAREN; }
        } else if first_char matches { '+' } {
            end = try_lit_plus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_PLUS; }
        } else if first_char matches { ';' } {
            end = try_lit_semi(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_SEMI; }
        } else if first_char matches { '=' } {
            end = try_lit_eq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_EQ; }
        } else if first_char matches { '_' } {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'e' } {
            end = try_lit_else(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_ELSE; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { 'l' } {
            end = try_lit_let(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LET; }
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { '{' } {
            end = try_lit_lbrace(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_LBRACE; }
        } else if first_char matches { '}' } {
            end = try_lit_rbrace(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LIT_RBRACE; }
        } else if first_char matches { 'a'..='z' | 'A'..='Z' } {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
        } else if first_char matches { '0'..='9' } {
            end = try_INT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INT; }
        } else {
            end = try_ID(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ID; }
            end = try_INT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_INT; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_INT => "INT",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_LET => "'let'",
        TK_LIT_EQ => "'='",
        TK_LIT_ELSE => "'else'",
        TK_LIT_SEMI => "';'",
        TK_LIT_PLUS => "'+'",
        TK_LIT_LPAREN => "'('",
        TK_LIT_RPAREN => "')'",
        TK_LIT_LBRACE => "'{'",
        TK_LIT_RBRACE => "'}'",
        _ => "Unknown",
    };
}

pub global RK_PROG: NodeKind = 0;
pub global RK_STMT: NodeKind = 1;
pub global RK_EXPR: NodeKind = 2;
pub global RK_BLOCK: NodeKind = 3;

global RULE_NAMES: List<String> = ["prog", "stmt", "expr", "block"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    pending_code: DiagnosticCode,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [] };
    }

    fn error(&self, message: String, span: Span, expected: &List<i32>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, kind_names(expected), lc.0, lc.1);
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        let take = if let Some(cur) = &self.pending { span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(self.error(message, span, expected));
            self.pending_code = code;
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn report_missing(&mut self, kind: i32, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        let name = token_kind_name(kind);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));
    }

    fn report_unexpected(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail(`got "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), &([kind] as List<i32>), DiagnosticCode::UnexpectedToken);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(self.tokens.span_at(self.pos));
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind, self.tokens.span_at(self.pos));
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(self.tokens.span_at(self.pos));
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &([kind] as List<i32>),
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token; got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !self.in_set(k, excluded) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `unexpected token "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if self.in_set(k, included) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            included,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }
}

fn scan_prog(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && tokens[pos] == TK_LIT_LET {
        let sp = pos;
        pos = scan_stmt(tokens, pos);
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_stmt(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    osl_0_done: {
        if pos < tokens.len() && tokens[pos] == TK_LIT_EQ && pos + 1 < tokens.len() && _kind_set_0(tokens[pos + 1]) {
            let sol_1_save = pos;
            sol_1: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_EQ { break sol_1; }
                pos += 1;
                pos = scan_expr(tokens, pos, 0);
                if pos < 0 { break sol_1; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_ELSE { break sol_1; }
                pos += 1;
                pos = scan_block(tokens, pos);
                if pos < 0 { break sol_1; }
                break osl_0_done;
            }
            pos = sol_1_save;
        }
        if pos < tokens.len() && tokens[pos] == TK_LIT_EQ && pos + 1 < tokens.len() && _kind_set_0(tokens[pos + 1]) {
            let sol_2_save = pos;
            sol_2: {
                if pos >= tokens.len() || tokens[pos] != TK_LIT_EQ { break sol_2; }
                pos += 1;
                pos = scan_expr(tokens, pos, 0);
                if pos < 0 { break sol_2; }
                break osl_0_done;
            }
            pos = sol_2_save;
        }
    }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_SEMI { return -1; }
    pos += 1;
    return pos;
}

fn scan_expr_atom(tokens: &Array<i32>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            let mut best: i32 = -1;
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos] != TK_ID { break try_0; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_LIT_LPAREN { break try_0; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_ID { break try_0; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos] != TK_ID { break try_1; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_INT {
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos] != TK_INT { break try_2; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_expr_lr_0(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_PLUS { return -1; }
    pos += 1;
    pos = scan_expr(tokens, pos, 2);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_expr(tokens: &Array<i32>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_expr_atom(tokens, pos);
    if pos < 0 { return -1; }
    loop {
        let suffix_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        let _lr_pos0 = pos;
        if suffix_kind == TK_LIT_PLUS {
            if 1 >= min_prec {
                let lr_saved_pos = pos;
                pos = scan_expr_lr_0(tokens, pos);
                if pos < 0 { pos = lr_saved_pos; break; }
            } else {
                break;
            }
        } else {
            break;
        }
        if pos == _lr_pos0 {
            break;
        }
    }
    return pos;
}

fn scan_block(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACE { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACE { return -1; }
    pos += 1;
    return pos;
}

fn _parse_prog__inner(p: &mut Parser) -> () {
    loop {
        if p.recovering { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            pos = scan_stmt(tokens, pos);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 {
            if p.peek_kind() == TK_LIT_LET {
                let _rec_pos = p.pos;
                let _rec_cp = p.b.checkpoint();
                let _rec_sav = p.recovering;
                let _rec_spec = p.speculating;
                p.speculating = true;
                _parse_stmt(p);
                p.speculating = _rec_spec;
                p.recovering = _rec_sav;
                p.pos = _rec_pos;
                p.b.truncate(_rec_cp);
            }
            break;
        }
        _parse_stmt(p);
    }
    p.expect(TK_EOF, &EMPTY_SYNC);
    return;
}

fn _parse_prog(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_PROG, _start);
    _parse_prog__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("prog");
    }
}

fn _parse_stmt__inner(p: &mut Parser) -> () {
    p.expect(TK_LIT_LET, &SYNC_0);
    p.expect(TK_ID, &SYNC_1);
    if p.peek_kind() == TK_LIT_EQ {
        p.expect(TK_LIT_EQ, &SYNC_2);
        _parse_expr(p);
        if p.peek_kind() == TK_LIT_ELSE {
            p.expect(TK_LIT_ELSE, &SYNC_3);
            _parse_block(p);
        }
    }
    p.expect(TK_LIT_SEMI, &EMPTY_SYNC);
    return;
}

fn _parse_stmt(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_STMT, _start);
    _parse_stmt__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("stmt");
    }
}

fn _parse_expr__inner_alt_1(p: &mut Parser) -> () {
    p.expect(TK_ID, &SYNC_4);
    p.expect(TK_LIT_LPAREN, &SYNC_0);
    p.expect(TK_ID, &SYNC_5);
    p.expect(TK_LIT_RPAREN, &EMPTY_SYNC);
    return;
}

fn _parse_expr__inner_scan_1(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LPAREN { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn _parse_expr__inner_alt_2(p: &mut Parser) -> () {
    p.expect(TK_ID, &EMPTY_SYNC);
    return;
}

fn _parse_expr__inner_scan_2(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn _parse_expr__inner_atom(p: &mut Parser, min_prec: i32 = 0) -> () {
    let kind = p.peek_kind();
    if kind == TK_ID {
        let _sd_tokens = &p.kinds;
        let _sd_pos = p.pos;
        let _sd_p_1 = _parse_expr__inner_scan_1(_sd_tokens, _sd_pos);
        let _sd_p_2 = _parse_expr__inner_scan_2(_sd_tokens, _sd_pos);
        let mut _sd_best_i: i32 = -1;
        let mut _sd_best_p: i32 = -1;
        if _sd_p_1 > _sd_best_p {
            _sd_best_p = _sd_p_1;
            _sd_best_i = 1;
        }
        if _sd_p_2 > _sd_best_p {
            _sd_best_p = _sd_p_2;
            _sd_best_i = 2;
        }
        if _sd_best_i == 1 {
            return _parse_expr__inner_alt_1(p);
        }
        return _parse_expr__inner_alt_2(p);
    }
    if kind == TK_INT {
        p.expect(TK_INT, &EMPTY_SYNC);
        return;
    }
    p.no_viable(
        "no alternative of expr matches",
        p.peek_span(),
        &SYNC_2,
    );
    return;
}

fn _parse_expr__inner(p: &mut Parser, min_prec: i32 = 0) -> () {
    let _cp = p.b.checkpoint();
    let _start = p.peek_start();
    p.b.start_node(RK_EXPR, _start);
    _parse_expr__inner_atom(p, min_prec);
    p.b.finish_node(p.last_end());
    loop {
        if p.recovering { break; }
        let _sk = p.peek_kind();
        if _sk == TK_LIT_PLUS {
            if 1 >= min_prec {
                if scan_expr_lr_0(&p.kinds, p.pos) < 0 {
                    break;
                }
                p.b.start_node_at(_cp, RK_EXPR, _start);
                p.expect(TK_LIT_PLUS, &EMPTY_SYNC);
                _parse_expr(p, 2);
                p.b.finish_node(p.last_end());
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return;
}

fn _parse_expr(p: &mut Parser, min_prec: i32 = 0) -> () {
    if p.recovering { return; }
    _parse_expr__inner(p, min_prec);
    if p.recovering {
        p.push_rule_stack("expr");
    }
}

fn _parse_block__inner(p: &mut Parser) -> () {
    p.expect(TK_LIT_LBRACE, &SYNC_6);
    p.expect(TK_LIT_RBRACE, &EMPTY_SYNC);
    return;
}

fn _parse_block(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _start = p.peek_start();
    p.b.start_node(RK_BLOCK, _start);
    _parse_block__inner(p);
    p.b.finish_node(p.last_end());
    if p.recovering {
        p.push_rule_stack("block");
    }
}

fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(e) = &p.pending {
            let lc = line_col(p.tokens.chars, e.span.start);
            let mut d = Diagnostic::error(p.pending_code, e.full_message(), e.span, lc.0, lc.1);
            d.rule_stack = e.rule_stack;
            p.diagnostics.push(d);
        }
    }
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics };
}

pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_prog(input, max_errors);
}

pub fn parse_prog(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_prog(p));
}

pub fn parse_stmt(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_stmt(p));
}

pub fn parse_expr(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expr(p));
}

pub fn parse_block(input: &String, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_block(p));
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(14);
    for let mut k = 0; k < 14; k += 1 {
        v.push(token_kind_name(k));
    }
    return v;
}

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &_token_names());
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &_token_names());
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_ID | TK_INT };
}

global EMPTY_SYNC: List<i32> = [];
global SYNC_0: List<i32> = [TK_ID];
global SYNC_1: List<i32> = [TK_LIT_EQ, TK_LIT_SEMI];
global SYNC_2: List<i32> = [TK_ID, TK_INT];
global SYNC_3: List<i32> = [TK_LIT_LBRACE];
global SYNC_4: List<i32> = [TK_LIT_LPAREN];
global SYNC_5: List<i32> = [TK_LIT_RPAREN];
global SYNC_6: List<i32> = [TK_LIT_RBRACE];

