fn atn_decide_0(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            == TK_ID => {
                if pos + 1 < tokens.len() {
                    match tokens[pos + 1] {
                        == TK_LIT_EQ => {
                            return 0;
                        },
                        == TK_LIT_PLUS => {
                            return 1;
                        },
                        _ => {},
                    };
                }
            },
            _ => {},
        };
    }
    return atn_predict_once(&ATN_SIM, 0, atn, tokens, pos, TK_EOF, min_prec);
}

fn atn_lr_decide_1(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() && tokens[pos] < 7 {
        match tokens[pos] {
            == TK_LIT_PLUS => {
                if min_prec > 1 { return 1; }
                return atn_lr_enter_or_ask(&ATN_SIM, atn, 1, 0, tokens, pos, TK_EOF, min_prec);
            },
            _ => { return 1; },
        };
    }
    return atn_lr_loop_decision(&ATN_SIM, atn, 1, tokens, pos, TK_EOF, min_prec);
}

