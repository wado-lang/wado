fn lex_error_at(tokens: &TokenStream, i: i32) -> Diagnostic {
    let mut message = String::from("token recognition error at: '");
    push_escaped(&mut message, &tokens.src, tokens.start_at(i), tokens.end_at(i));
    message.push('\'');
    return Diagnostic::error(
        DiagnosticCode::LexError,
        message,
        tokens.span_at(i),
        [],
        tokens.kinds[i],
        RecoveryAction::None,
    );
}

internal fn merge_lex_errors(tokens: &TokenStream, diagnostics: &mut List<Diagnostic>, max_errors: i32) {
    let mut merged: List<Diagnostic> = [];
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.is_lex_error(i) {
            merged.push(lex_error_at(tokens, i));
        }
    }
    merged.extend(diagnostics);
    merged.sort_by(|a: &Diagnostic, b: &Diagnostic| a.span.start.cmp(&b.span.start));
    merged.truncate(max_errors);
    *diagnostics = merged;
}

internal fn resolve_positions(diagnostics: &mut List<Diagnostic>, src: &StrSlice) {
    if diagnostics.is_empty() {
        return;
    }
    let starts = line_starts(src);
    for let mut i = 0; i < diagnostics.len(); i += 1 {
        let lc = line_col_at(src, &starts, diagnostics[i].span.start);
        diagnostics[i].line = lc.0;
        diagnostics[i].col = lc.1;
    }
}

pub type NodeKind = i32;

pub global K_ERROR: NodeKind = -1;

pub flags NodeFlags {
    Error,
    Incomplete,
}

pub enum EventTag {
    Open,
    Close,
    Tok,
    Miss,
    Skip,
}

pub struct CstStore {
    pub tag: List<EventTag>,
    pub id: List<i32>,
    pub offset: List<i32>,
    alt: List<i32>,
    end: List<i32>,
    flags: List<NodeFlags>,
    next: List<i32>,
}

pub enum ChildKind {
    Node,
    Token,
    Missing,
    Skipped,
}

impl CstStore {
    pub fn row_count(&self) -> i32 {
        return self.tag.len();
    }

    pub fn kind(&self, i: i32) -> NodeKind {
        return self.id[i] as NodeKind;
    }

    pub fn span(&self, i: i32) -> Span {
        return Span::new(self.offset[i], self.end[i]);
    }

    pub fn alt(&self, i: i32) -> i32 {
        return self.alt[i];
    }

    fn has_flag(&self, i: i32, flag: NodeFlags) -> bool {
        return self.flags[i] & flag != NodeFlags::none();
    }

    pub fn is_error(&self, i: i32) -> bool {
        return self.has_flag(i, NodeFlags::Error);
    }

    pub fn is_incomplete(&self, i: i32) -> bool {
        return self.has_flag(i, NodeFlags::Incomplete);
    }

    pub fn is_node(&self, i: i32) -> bool {
        return self.tag[i] matches { _::Open };
    }

    pub fn is_token(&self, i: i32) -> bool {
        return self.tag[i] matches { _::Tok | _::Miss | _::Skip };
    }

    pub fn child_kind(&self, i: i32) -> ChildKind {
        return match self.tag[i] {
            _::Open => ChildKind::Node,
            _::Miss => ChildKind::Missing,
            _::Skip => ChildKind::Skipped,
            _::Tok => ChildKind::Token,
            _::Close => panic("CstStore::child_kind: Close is not a child row"),
        };
    }

    pub fn token_index(&self, i: i32) -> i32 {
        return self.id[i];
    }

    fn child_row(&self, c: i32) -> i32 {
        if c >= self.tag.len() || self.tag[c] matches { _::Close } {
            return -1;
        }
        return c;
    }

    pub fn first_child(&self, i: i32) -> i32 {
        return self.child_row(i + 1);
    }

    pub fn next_sibling(&self, child: i32) -> i32 {
        return self.child_row(if self.is_node(child) { self.next[child] } else { child + 1 });
    }

    pub fn find_child(&self, i: i32, kind: NodeKind) -> i32 {
        for let mut c = self.first_child(i); c >= 0; c = self.next_sibling(c) {
            if self.is_node(c) && self.kind(c) == kind {
                return c;
            }
        }
        return -1;
    }

    pub fn to_string_tree(
        &self,
        i: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        let mut out = String::with_capacity(256);
        let _ = render_node(&mut out, &self.tag, &self.id, i, toks, rule_names, token_names);
        return out;
    }
}

pub struct ParseResult {
    pub cst: CstStore,
    pub tokens: TokenStream,
    pub diagnostics: List<Diagnostic>,
    pub output: String = "",
}

impl ParseResult {
    pub fn has_errors(&self) -> bool {
        return self.diagnostics.iter_ref().any(|d| d.is_error());
    }

    pub fn ok(&self) -> bool {
        return !self.has_errors();
    }
}

fn bubble_to_parent(stack: &List<i32>, end: &mut List<i32>, flags: &mut List<NodeFlags>, child: i32) {
    if let Some(parent) = stack.last() {
        if end[child] > end[parent] {
            end[parent] = end[child];
        }
        flags[parent] |= flags[child] & NodeFlags::Error;
    }
}

internal struct TreeBuilder {
    tag: List<EventTag>,
    id: List<i32>,
    offset: List<i32>,
    alt: List<i32>,
    open: List<i32>,
    last_finished: i32,
    error_row: i32,
}

impl TreeBuilder {
    internal fn with_capacity(rows: i32) -> TreeBuilder {
        return TreeBuilder {
            tag: List::with_capacity(rows),
            id: List::with_capacity(rows),
            offset: List::with_capacity(rows),
            alt: List::with_capacity(rows),
            open: [],
            last_finished: -1,
            error_row: -1,
        };
    }

    fn push_row(&mut self, tag: EventTag, id: i32, offset: i32) {
        if self.tag.len() >= self.tag.capacity() {
            builtin::cold_path();
            self.tag.grow();
            self.id.grow();
            self.offset.grow();
            self.alt.grow();
            assert self.id.capacity() == self.tag.capacity()
                && self.offset.capacity() == self.tag.capacity()
                && self.alt.capacity() == self.tag.capacity(), "TreeBuilder event columns must grow in lockstep";
        }
        unchecked self.tag.push_within_capacity(tag);
        unchecked self.id.push_within_capacity(id);
        unchecked self.offset.push_within_capacity(offset);
        unchecked self.alt.push_within_capacity(-1);
    }

    internal fn start_node(&mut self, kind: NodeKind, start: i32) {
        let row = self.tag.len();
        self.push_row(EventTag::Open, kind as i32, start);
        self.open.push(row);
    }

    internal fn start_error(&mut self, start: i32) {
        self.start_node(K_ERROR, start);
    }

    internal fn set_alt(&mut self, alt: i32) {
        self.alt[self.innermost_open()] = alt;
    }

    internal fn checkpoint(&self) -> i32 {
        return self.tag.len();
    }

    internal fn start_node_at(&mut self, checkpoint: i32, kind: NodeKind, start: i32)
        contract self.innermost_open() < checkpoint, "a node wraps only rows finished before it"
    {
        self.tag.insert(checkpoint, EventTag::Open);
        self.id.insert(checkpoint, kind as i32);
        self.offset.insert(checkpoint, start);
        self.alt.insert(checkpoint, -1);
        self.open.push(checkpoint);
        if self.last_finished >= checkpoint {
            self.last_finished += 1;
        }
        if self.error_row >= checkpoint {
            self.error_row += 1;
        }
    }

    internal fn truncate(&mut self, checkpoint: i32) {
        self.tag.truncate(checkpoint);
        self.id.truncate(checkpoint);
        self.offset.truncate(checkpoint);
        self.alt.truncate(checkpoint);
        while self.innermost_open() >= checkpoint {
            let _ = self.open.pop();
        }
        if self.last_finished >= checkpoint {
            self.last_finished = -1;
        }
        if self.error_row > checkpoint {
            self.error_row = checkpoint;
        }
    }

    internal fn finish_node(&mut self, end: i32) {
        let row = self.open.pop().unwrap();
        self.push_row(EventTag::Close, self.id[row], end);
        self.last_finished = row;
    }

    internal fn innermost_open(&self) -> i32 {
        return self.open.last().unwrap_or(-1);
    }

    internal fn node_kind(&self, row: i32) -> NodeKind {
        return self.id[row] as NodeKind;
    }

    internal fn resume_node(&mut self, row: i32, end: i32) {
        while self.innermost_open() > row {
            self.finish_node(end);
        }
        if self.innermost_open() == row {
            return;
        }
        assert self.last_finished == row && self.tag[self.tag.len() - 1] matches { _::Close }, "resume_node: a node no longer open is the last one closed";
        self.truncate(self.tag.len() - 1);
        self.open.push(row);
    }

    internal fn mark_error(&mut self) {
        self.error_row = self.tag.len();
    }

    internal fn in_error_mode(&self) -> bool {
        if self.error_row < 0 {
            return false;
        }
        for let mut r = self.error_row; r < self.tag.len(); r += 1 {
            if self.tag[r] matches { _::Tok } {
                return false;
            }
        }
        return true;
    }

    internal fn push_open_rule_names(&self, rule_names: &List<String>, out: &mut List<String>) {
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            let kind = self.id[self.open[i]];
            if kind != K_ERROR as i32 {
                out.push(rule_names[kind]);
            }
        }
    }

    internal fn token(&mut self, idx: i32) {
        self.push_row(EventTag::Tok, idx, 0);
    }

    internal fn missing(&mut self, syn_idx: i32) {
        self.push_row(EventTag::Miss, syn_idx, 0);
    }

    internal fn skip(&mut self, idx: i32) {
        self.push_row(EventTag::Skip, idx, 0);
    }

    internal fn finish(&self) -> CstStore {
        let n = self.tag.len();
        let mut end = List::filled(n, 0);
        let mut flags = List::filled(n, NodeFlags::none());
        let mut next = List::filled(n, 0);
        let mut stack: List<i32> = [];
        for let mut r = 0; r < n; r += 1 {
            match self.tag[r] {
                _::Open => {
                    if self.id[r] == K_ERROR as i32 {
                        flags[r] = NodeFlags::Error;
                    }
                    end[r] = self.offset[r];
                    stack.push(r);
                },
                _::Miss => {
                    flags[stack.last().unwrap()] |= NodeFlags::Incomplete | NodeFlags::Error;
                },
                _::Skip => {
                    flags[stack.last().unwrap()] |= NodeFlags::Error;
                },
                _::Close => {
                    let oi = stack.pop().unwrap();
                    if self.offset[r] > end[oi] {
                        end[oi] = self.offset[r];
                    }
                    next[oi] = r + 1;
                    bubble_to_parent(&stack, &mut end, &mut flags, oi);
                },
                _::Tok => {
                },
            }
        }
        while let Some(oi) = stack.pop() {
            next[oi] = n;
            bubble_to_parent(&stack, &mut end, &mut flags, oi);
        }
        return CstStore { tag: self.tag, id: self.id, offset: self.offset, alt: self.alt, end, flags, next };
    }

    internal fn render_open(&self, toks: &TokenStream, rule_names: &List<String>, token_names: &List<String>) -> String {
        return self.render_at(self.innermost_open(), toks, rule_names, token_names);
    }

    internal fn render_at(
        &self,
        row: i32,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        if row < 0 || row >= self.tag.len() || !self.tag[row] matches { _::Open } {
            return String::new();
        }
        let mut out = String::with_capacity(128);
        let _ = render_node(&mut out, &self.tag, &self.id, row, toks, rule_names, token_names);
        return out;
    }

    internal fn open_rule_names(&self, rule_names: &List<String>) -> String {
        let mut out = String::from("[");
        for let mut i = self.open.len() - 1; i >= 0; i -= 1 {
            if i < self.open.len() - 1 {
                out.push_str(", ");
            }
            out.push_str(node_name(rule_names, self.node_kind(self.open[i])));
        }
        out.push_str("]");
        return out;
    }

    internal fn render_last_finished(
        &self,
        toks: &TokenStream,
        rule_names: &List<String>,
        token_names: &List<String>,
    ) -> String {
        return self.render_at(self.last_finished, toks, rule_names, token_names);
    }
}

internal fn node_name(rule_names: &List<String>, kind: NodeKind) -> String {
    return if kind == K_ERROR { "<error>" } else { rule_names[kind as i32] };
}

fn render_node(
    out: &mut String,
    tag: &List<EventTag>,
    id: &List<i32>,
    i: i32,
    toks: &TokenStream,
    rule_names: &List<String>,
    token_names: &List<String>,
) -> i32 {
    let name = node_name(rule_names, id[i] as NodeKind);
    if i + 1 >= tag.len() || tag[i + 1] matches { _::Close } {
        out.push_str(name);
        if i + 1 < tag.len() {
            return i + 2;
        }
        return i + 1;
    }
    out.push_str("(");
    out.push_str(name);
    let mut c = i + 1;
    while c < tag.len() {
        match tag[c] {
            _::Open => {
                out.push_str(" ");
                c = render_node(out, tag, id, c, toks, rule_names, token_names);
            },
            _::Close => {
                out.push_str(")");
                return c + 1;
            },
            _::Tok => {
                if !toks.is_empty_text(id[c]) {
                    out.push_str(" ");
                    toks.push_token_text_escaped(out, id[c]);
                }
                c += 1;
            },
            _::Miss => {
                out.push_str(` <missing ${token_names[toks.kind_at(id[c])]}>`);
                c += 1;
            },
            _::Skip => {
                out.push_str(" <skip ");
                toks.push_token_text_escaped(out, id[c]);
                out.push_str(">");
                c += 1;
            },
        }
    }
    out.push_str(")");
    return c;
}

struct SourceCursor {
    byte: i32,
    char: i32,
    line: i32,
    line_char: i32,
}

impl SourceCursor {
    fn advance_to(&mut self, src: &StrSlice, byte: i32) {
        assert byte >= self.byte, "to_lexer_string visits tokens in source order";
        for let mut i = self.byte; i < byte; i += 1 {
            if src.is_char_boundary(i) {
                self.char += 1;
            }
            if unchecked src.byte_at(i) == b'\n' {
                self.line += 1;
                self.line_char = self.char;
            }
        }
        self.byte = byte;
    }
}

pub fn to_lexer_string(tokens: &TokenStream, eof_kind: i32) -> String {
    let mut cursor = SourceCursor { byte: 0, char: 0, line: 1, line_char: 0 };
    let mut out = String::with_capacity(tokens.output.len() + tokens.len() * 32);
    out.push_str(&tokens.output);
    let mut index = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        let lo = tokens.trivia_lo_at(i);
        let hi = tokens.trivia_hi_at(i);
        for let mut t = lo; t < hi; t += 1 {
            if tokens.trivia_channel_at(t) != 0 {
                emit_lexer_token(
                    &mut out,
                    tokens,
                    tokens.trivia_kind_at(t),
                    tokens.trivia_start_at(t),
                    tokens.trivia_end_at(t),
                    tokens.trivia_channel_at(t),
                    &mut cursor,
                    index,
                    eof_kind,
                );
                index += 1;
            }
        }
        emit_lexer_token(
            &mut out,
            tokens,
            tokens.kinds[i],
            tokens.start_at(i),
            tokens.end_at(i),
            0,
            &mut cursor,
            index,
            eof_kind,
        );
        index += 1;
    }
    return out;
}

fn emit_lexer_token(
    out: &mut String,
    tokens: &TokenStream,
    kind: i32,
    start: i32,
    end: i32,
    channel: i32,
    cursor: &mut SourceCursor,
    index: i32,
    eof_kind: i32,
) {
    let is_eof = kind == eof_kind;
    let type_id = if is_eof { -1 } else { kind + 1 };
    cursor.advance_to(&tokens.src, start);
    let first = cursor.char;
    let stop = first + char_count(&tokens.src, start, end) - 1;
    out.push_str(`[@${index},${first}:${stop}='`);
    if is_eof {
        out.push_str("<EOF>");
    } else {
        push_escaped(out, &tokens.src, start, end);
    }
    out.push_str(`',<${type_id}>,`);
    if channel != 0 {
        out.push_str(`channel=${channel},`);
    }
    out.push_str(`${cursor.line}:${first - cursor.line_char}]\n`);
}
internal struct ScanMemo<G> {
    heads: Array<i32>,
    entries: List<ScanMemoEntry<G>>,
}

struct ScanMemoEntry<G> {
    next: i32,
    rule: i32,
    min_prec: i32,
    follow: i64,
    cont: i64,
    gate_in: G,
    end: i32,
    gate_out: G,
}

impl<G: Eq> ScanMemo<G> {
    internal fn new(positions: i32) -> ScanMemo<G> {
        return ScanMemo { heads: Array::<i32>::filled(positions + 1, -1), entries: [] };
    }

    internal fn find(&self, rule: i32, pos: i32, min_prec: i32, follow: i64, cont: i64, gate: &G) -> i32 {
        let mut at = self.heads[pos];
        while at >= 0 {
            let e = &self.entries[at];
            if e.rule == rule && e.min_prec == min_prec && e.follow == follow && e.cont == cont && e.gate_in == *gate {
                return at;
            }
            at = e.next;
        }
        return -1;
    }

    internal fn end_of(&self, entry: i32) -> i32 {
        return self.entries[entry].end;
    }

    internal fn gate_of(&self, entry: i32) -> G {
        return self.entries[entry].gate_out;
    }

    internal fn put(
        &mut self,
        rule: i32,
        pos: i32,
        min_prec: i32,
        follow: i64,
        cont: i64,
        gate_in: G,
        end: i32,
        gate_out: G,
    ) {
        self.entries.push(ScanMemoEntry { next: self.heads[pos], rule, min_prec, follow, cont, gate_in, end, gate_out });
        self.heads[pos] = self.entries.len() - 1;
    }
}
internal global ATN_BASIC: i32 = 1;
internal global ATN_RULE_START: i32 = 2;
internal global ATN_RULE_STOP: i32 = 3;
internal global ATN_BLOCK_START: i32 = 4;
internal global ATN_BLOCK_END: i32 = 5;
internal global ATN_STAR_LOOP_ENTRY: i32 = 6;
internal global ATN_STAR_LOOP_BACK: i32 = 7;
internal global ATN_PLUS_LOOP_BACK: i32 = 8;
internal global ATN_LOOP_END: i32 = 9;

internal global ATN_TR_EPSILON: i32 = 0;
internal global ATN_TR_ATOM: i32 = 1;
internal global ATN_TR_NOT_ATOM: i32 = 2;
internal global ATN_TR_WILDCARD: i32 = 3;
internal global ATN_TR_RULE: i32 = 4;
internal global ATN_TR_PRECEDENCE: i32 = 5;
internal global ATN_TR_SET: i32 = 6;

internal global ATN_ACTION_EDGE: i32 = 16777214;

global mut ATN_SIMS_DECODED: i32 = 0;

internal struct AtnSim {
    internal serial: i32,
    internal num_tokens: i32,
    internal state_kind: List<i32>,
    internal state_tr_start: List<i32>,
    internal state_tr_count: List<i32>,
    internal tr_kind: List<i32>,
    internal tr_target: List<i32>,
    internal tr_label: List<i32>,
    internal tr_follow: List<i32>,
    internal tr_prec: List<i32>,
    internal decision_state: List<i32>,
    internal rule_start: List<i32>,
    internal set_members: List<List<i32>>,
    internal set_words: i32,
    internal set_bits: List<i64>,
    internal rule_nullable: List<bool> = [],
    internal rule_first: List<List<i32>> = [],
    internal rule_first_neg: List<List<i32>> = [],
    internal rule_first_open: List<bool> = [],
    internal state_cont_nullable: List<bool> = [],
    internal cont_words: i32 = 0,
    internal state_cont_first: List<i64> = [],
    internal state_cont_any_but: List<i32> = [],
    internal state_collapse_to: List<i32> = [],
    internal state_collapse_target: List<bool> = [],
    internal state_call_prec: List<i32>,
    internal rule_follow_start: List<i32>,
    internal rule_follow: List<i32>,
}

fn atn_take(bytes: &ByteList, pos: &mut i32, width: i32) -> i32 {
    let mut value = 0;
    for let mut i = 0; i < width; i += 1 {
        value |= unchecked bytes[*pos + i] as i32 << 8 * i;
    }
    *pos += width;
    return value;
}

fn atn_take_list(bytes: &ByteList, pos: &mut i32, count: i32, width: i32, bias: i32) -> List<i32> {
    let mut out: List<i32> = List::with_capacity(count);
    for let mut i = 0; i < count; i += 1 {
        out.push(atn_take(bytes, pos, width) - bias);
    }
    return out;
}

internal fn atn_decode(bytes: &ByteList) -> AtnSim {
    let mut p = 0;
    let nrules = atn_take(bytes, &mut p, 2);
    let ndec = atn_take(bytes, &mut p, 2);
    let nstates = atn_take(bytes, &mut p, 2);
    let num_tokens = atn_take(bytes, &mut p, 2);

    let rule_start = atn_take_list(bytes, &mut p, nrules, 2, 0);
    let decision_state = atn_take_list(bytes, &mut p, ndec, 2, 0);

    let state_kind = atn_take_list(bytes, &mut p, nstates, 1, 0);
    let state_tr_count = atn_take_list(bytes, &mut p, nstates, 2, 0);
    let mut state_tr_start: List<i32> = List::with_capacity(nstates);
    let mut ntrans_total = 0;
    for let count of &state_tr_count {
        state_tr_start.push(ntrans_total);
        ntrans_total += *count;
    }

    let tr_kind = atn_take_list(bytes, &mut p, ntrans_total, 1, 0);
    let tr_target = atn_take_list(bytes, &mut p, ntrans_total, 2, 1);
    let tr_label = atn_take_list(bytes, &mut p, ntrans_total, 3, 1);
    let tr_follow = atn_take_list(bytes, &mut p, ntrans_total, 3, 1);
    let tr_prec = atn_take_list(bytes, &mut p, ntrans_total, 2, 0);

    let nsets = atn_take(bytes, &mut p, 2);
    let mut set_members: List<List<i32>> = List::with_capacity(nsets);
    let mut kinds = 0;
    for let mut i = 0; i < nsets; i += 1 {
        let count = atn_take(bytes, &mut p, 2);
        let members = atn_take_list(bytes, &mut p, count, 2, 0);
        for let t of &members {
            kinds = i32::max(kinds, *t + 1);
        }
        set_members.push(members);
    }
    let set_words = (kinds + 63) / 64;
    let mut set_bits = List::<i64>::filled(nsets * set_words, 0);
    for let mut i = 0; i < nsets; i += 1 {
        for let t of &set_members[i] {
            set_bits[i * set_words + *t / 64] |= 1 as i64 << (*t % 64) as i64;
        }
    }

    for let mut r = 0; r < nrules; r += 1 {
        assert state_kind[2 * r + 1] == ATN_RULE_STOP, "rule r stops at state 2r + 1";
    }
    let mut state_call_prec = List::filled(nstates, 0);
    let mut rule_follow_start = List::filled(nrules + 1, 0);
    for let mut j = 0; j < ntrans_total; j += 1 {
        if tr_kind[j] == ATN_TR_RULE {
            assert tr_follow[j] >= 0, "a rule transition returns to a follow state";
            state_call_prec[tr_follow[j]] = tr_prec[j];
            if tr_label[j] >= 0 {
                rule_follow_start[tr_label[j] + 1] += 1;
            }
        }
    }
    for let mut r = 0; r < nrules; r += 1 {
        rule_follow_start[r + 1] += rule_follow_start[r];
    }
    let mut rule_follow = List::filled(rule_follow_start[nrules], 0);
    let mut next_follow = rule_follow_start;
    for let mut j = 0; j < ntrans_total; j += 1 {
        if tr_kind[j] == ATN_TR_RULE && tr_label[j] >= 0 {
            let r = tr_label[j];
            rule_follow[next_follow[r]] = tr_follow[j];
            next_follow[r] += 1;
        }
    }

    ATN_SIMS_DECODED += 1;
    return AtnSim {
        serial: ATN_SIMS_DECODED,
        num_tokens,
        state_kind,
        state_tr_start,
        state_tr_count,
        tr_kind,
        tr_target,
        tr_label,
        tr_follow,
        tr_prec,
        decision_state,
        rule_start,
        set_members,
        set_words,
        set_bits,
        state_call_prec,
        rule_follow_start,
        rule_follow,
    };
}

internal fn atn_tr_consumes(kind: i32) -> bool {
    return kind == ATN_TR_ATOM || kind == ATN_TR_SET || kind == ATN_TR_NOT_ATOM || kind == ATN_TR_WILDCARD;
}

internal fn atn_set_contains(sim: &AtnSim, set: i32, t: i32) -> bool {
    return t >= 0
        && t < sim.set_words * 64
        && sim.set_bits[set * sim.set_words + t / 64] & 1 as i64 << (t % 64) as i64 != 0;
}

global ATN_ACCEPT_EOF: i32 = -2;

global ATN_CLOSURE_GUARD: i32 = 2000000;
global ATN_ARENA_CAP: i32 = 400000;

global ATN_NODE_BITS: i64 = 30;
global ATN_NODE_PAIR_STRIDE: i64 = 1 << ATN_NODE_BITS;
global ATN_DFA_NODE_CAP: i32 = 4000000;

global ATN_PR_BITS: i64 = 11;
global CFG_KEY_PR_SLOT: i32 = (1 << ATN_PR_BITS) as i32;
global CFG_KEY_ALT_SLOT: i32 = 4096;
global CFG_KEY_GUARD_SLOT: i32 = 65536;
global ATN_DFA_GUARD_CAP: i32 = 32768;
global CFG_KEY_STATE_SLOT: i32 = 1048576;
global ATN_NO_GUARD: i32 = 0;

global CTX_BOUNDARY: i32 = -3;
global CTX_UNKNOWN_RETURN: i32 = -4;
global CTX_HIDDEN_RETURN: i32 = -5;
global CTX_ANY_CALLER_RETURN: i32 = -6;

global CTX_EMPTY: i32 = 0;
global CTX_UNKNOWN: i32 = 1;
global CTX_ANY_CALLER: i32 = 2;

global ATN_READS_HIDDEN: i32 = -6;
internal global ATN_FAILED_ALT: i32 = 1024;
global ATN_PASSED_ACTION: i32 = 2048;

global ATN_DFA_UNDECIDED: i32 = -7;
global ATN_DFA_DEAD: i32 = -8;
global ATN_DFA_START_KEY: i32 = -9;
global ATN_NOTHING_STARTS: i32 = -10;
global ATN_DFA_TOKEN_SLOT: i64 = 65536;

global ATN_REAL_NODE_CAP: i32 = 1000000;
global ATN_DFA_BRANCH_OPEN: i32 = 2147483646;
global ATN_DFA_BRANCH_LEAF: i32 = 2147483647;
global ATN_ASK_COVERS: i32 = 0;
global ATN_ASK_SAME: i32 = 1;
global ATN_ASK_MERGE: i32 = 2;
global ATN_ASK_KINDS: i64 = 3;

internal global mut ATN_DFA: AtnDfa = AtnDfa::new();

internal struct AtnPredictor {
    internal stack: List<i32>,
    floor: i32,
    reach: i32,
    questions: AtnKeyLists<i32>,
    verdict_alt: List<i32>,
    verdict_reach: List<i32>,
}

internal struct AtnFloor {
    depth: i32,
    reach: i32,
}

impl AtnPredictor {
    internal fn new() -> AtnPredictor {
        return AtnPredictor {
            stack: [],
            floor: 0,
            reach: 0,
            questions: AtnKeyLists::new(),
            verdict_alt: [],
            verdict_reach: [],
        };
    }

    internal fn hide_callers(&mut self) -> AtnFloor {
        let saved = AtnFloor { depth: self.floor, reach: self.reach };
        self.floor = self.stack.len();
        self.reach = self.floor;
        return saved;
    }

    internal fn reveal_callers(&mut self, saved: AtnFloor) -> bool {
        let read = self.reach < self.floor;
        self.floor = saved.depth;
        self.reach = i32::min(saved.reach, self.reach);
        return read;
    }

    internal fn predict<effect E>(
        &mut self,
        sim: &AtnSim,
        decision: i32,
        tokens: &Array<i32>,
        pos: i32,
        eof: i32,
        min_prec: i32,
        met: &List<i32>,
        own: &List<i32>,
        ask: fn(i32) -> bool with E,
    ) -> i32 with E {
        let [alt, reach] = self.predict_reaching(sim, decision, tokens, pos, eof, min_prec, met, own, ask);
        self.read_down_to(reach);
        return alt;
    }

    internal fn read_down_to(&mut self, depth: i32) {
        self.reach = i32::min(self.reach, depth);
    }

    fn predict_reaching<effect E>(
        &mut self,
        sim: &AtnSim,
        decision: i32,
        tokens: &Array<i32>,
        pos: i32,
        eof: i32,
        min_prec: i32,
        met: &List<i32>,
        own: &List<i32>,
        ask: fn(i32) -> bool with E,
    ) -> [i32, i32] with E
        contract self.stack.len() >= self.floor, "a scan returns before its caller pops the frames below its floor"
    {
        let mut preds = AtnPreds { met: *met, own: *own, failed: [] };
        let mut asked: List<i32> = [];
        let mut floor = self.floor;
        loop {
            let [alt, _] = atn_predict_above(
                &mut ATN_DFA,
                sim,
                decision,
                &self.stack,
                floor,
                tokens,
                pos,
                eof,
                min_prec,
                &mut preds,
                &mut asked,
                ask,
            );
            if floor == 0 || alt != ATN_READS_HIDDEN {
                return [alt, floor];
            }
            floor = 0;
        }
    }

    fn ask(&mut self, decision: i32, pos: i32, min_prec: i32, depth: i32) -> i32 {
        let from = self.questions.keys.len();
        self.questions.keys.push(decision);
        self.questions.keys.push(pos);
        self.questions.keys.push(min_prec);
        for let mut i = 0; i < depth; i += 1 {
            self.questions.keys.push(self.stack[i]);
        }
        return from;
    }

    fn recorded_verdict(&mut self, decision: i32, pos: i32, min_prec: i32, depth: i32) -> i32 {
        let from = self.ask(decision, pos, min_prec, depth);
        return self.questions.find_and_drop(from);
    }

    internal fn record_verdict(&mut self, decision: i32, pos: i32, min_prec: i32, depth: i32, alt: i32, reach: i32) {
        let from = self.ask(decision, pos, min_prec, depth);
        if self.questions.intern(from) == self.verdict_alt.len() {
            self.verdict_alt.push(alt);
            self.verdict_reach.push(reach);
        }
    }
}

trait AtnKey with () {
    fn key_bits(&self) -> i64;
}

impl AtnKey for i32 {
    fn key_bits(&self) -> i64 {
        return *self as i64;
    }
}

impl AtnKey for AtnEdge {
    fn key_bits(&self) -> i64 {
        return *self as i64;
    }
}

struct AtnKeyLists<T> {
    keys: List<T>,
    start: List<i32>,
    len: List<i32>,
    index: HashIndex,
}

impl<T: AtnKey + Eq> AtnKeyLists<T> {
    fn new() -> AtnKeyLists<T> {
        return AtnKeyLists { keys: [], start: [], len: [], index: HashIndex::new() };
    }

    fn hash_from(&self, from: i32) -> u64 {
        let mut h: i64 = 1469598103934665603;
        for let mut i = from; i < self.keys.len(); i += 1 {
            h = (h ^ self.keys[i].key_bits() + 16) * 1099511628211;
        }
        return ((h ^ (h as u64 >> 32) as i64) * -7046029254386353131) as u64;
    }

    fn count(&self) -> i32 {
        return self.start.len();
    }

    fn intern(&mut self, from: i32) -> i32 {
        let id = self.start.len();
        let known = self.index.find_or_insert(self.hash_from(from), |row| self.equals_pending(row, from), id);
        if known != id {
            self.keys.truncate(from);
            return known;
        }
        self.start.push(from);
        self.len.push(self.keys.len() - from);
        return id;
    }

    fn find_and_drop(&mut self, from: i32) -> i32 {
        let known = self.find(from);
        self.keys.truncate(from);
        return known;
    }

    fn intern_moved(&mut self, pending: &mut List<T>, from: i32) -> i32 {
        let s = self.keys.len();
        for let mut i = from; i < pending.len(); i += 1 {
            self.keys.push(pending[i]);
        }
        pending.truncate(from);
        return self.intern(s);
    }

    fn add_unkeyed(&mut self) -> i32 {
        self.start.push(0);
        self.len.push(0);
        return self.start.len() - 1;
    }

    fn equals_pending(&self, id: i32, from: i32) -> bool {
        let n = self.keys.len() - from;
        if self.len[id] != n {
            return false;
        }
        let s = self.start[id];
        for let mut i = 0; i < n; i += 1 {
            if self.keys[s + i] != self.keys[from + i] {
                return false;
            }
        }
        return true;
    }

    fn find(&self, from: i32) -> i32 {
        return self.index.find(self.hash_from(from), |row| self.equals_pending(row, from));
    }

    fn add(&mut self, from: i32) -> i32 {
        let id = self.start.len();
        self.index.insert(self.hash_from(from), id);
        self.start.push(from);
        self.len.push(self.keys.len() - from);
        return id;
    }
}

type AtnKeyMap = HashMap<i64, i32>;

type AtnEdge = i64;

global ATN_EDGE_RET_BIAS: i32 = 8;

impl AtnEdge {
    fn to(ret: i32, rpr: i32, parent: i32) -> AtnEdge
        contract ret + ATN_EDGE_RET_BIAS > 0 && ret < CFG_KEY_STATE_SLOT
        contract rpr >= 0 && rpr < CFG_KEY_PR_SLOT
        contract parent >= 0 && (parent as i64) < ATN_NODE_PAIR_STRIDE
    {
        let label = (ret + ATN_EDGE_RET_BIAS) as i64 << ATN_PR_BITS | rpr as i64;
        return (label << ATN_NODE_BITS | parent as i64) as AtnEdge;
    }

    fn label(&self) -> i64 {
        return *self as i64 >> ATN_NODE_BITS;
    }

    fn ret(&self) -> i32 {
        return (self.label() >> ATN_PR_BITS) as i32 - ATN_EDGE_RET_BIAS;
    }

    fn rpr(&self) -> i32 {
        return (self.label() & (CFG_KEY_PR_SLOT - 1) as i64) as i32;
    }

    fn parent(&self) -> i32 {
        return (*self as i64 & ATN_NODE_PAIR_STRIDE - 1) as i32;
    }

    fn above(&self, parent: i32) -> AtnEdge
        contract parent >= 0 && (parent as i64) < ATN_NODE_PAIR_STRIDE
    {
        return (self.label() << ATN_NODE_BITS | parent as i64) as AtnEdge;
    }
}

fn atn_merge_edges(
    edges: &List<AtnEdge>,
    sa: i32,
    na: i32,
    sb: i32,
    nb: i32,
    merged: &mut List<AtnEdge>,
    mut merge_below: fn mut(i32, i32) -> i32,
) {
    let mut i = sa;
    let mut j = sb;
    while i < sa + na || j < sb + nb {
        if j >= sb + nb || i < sa + na && edges[i].label() < edges[j].label() {
            merged.push(edges[i]);
            i += 1;
        } else if i >= sa + na || edges[j].label() < edges[i].label() {
            merged.push(edges[j]);
            j += 1;
        } else {
            let below = merge_below(edges[i].parent(), edges[j].parent());
            merged.push(edges[i].above(below));
            i += 1;
            j += 1;
        }
    }
}

struct RealStacks {
    nodes: AtnKeyLists<AtnEdge>,
    cover_cache: AtnKeyMap,
    merge_cache: AtnKeyMap,
    pending_edges: List<AtnEdge>,
}

impl RealStacks {
    fn new() -> RealStacks {
        let mut real = RealStacks {
            nodes: AtnKeyLists::new(),
            cover_cache: AtnKeyMap::new(),
            merge_cache: AtnKeyMap::new(),
            pending_edges: [],
        };
        let empty = real.push(CTX_BOUNDARY, 0, CTX_EMPTY);
        let unknown = real.push(CTX_UNKNOWN_RETURN, 0, CTX_EMPTY);
        let any_caller = real.push(CTX_ANY_CALLER_RETURN, 0, CTX_EMPTY);
        assert empty == CTX_EMPTY && unknown == CTX_UNKNOWN && any_caller == CTX_ANY_CALLER, "the bottom, unknown-caller and any-caller stacks are numbered as their contexts are";
        return real;
    }

    fn push(&mut self, return_state: i32, restore_pr: i32, parent: i32) -> i32 {
        let s = self.nodes.keys.len();
        self.nodes.keys.push(AtnEdge::to(return_state, restore_pr, parent));
        return self.nodes.intern(s);
    }

    fn covers(&mut self, outer: i32, inner: i32) -> bool {
        if outer == inner {
            return true;
        }
        let ck = atn_node_pair_key(outer, inner);
        if let Some(cached) = self.cover_cache.get(ck) {
            return cached == 1;
        }
        let outer_end = self.nodes.start[outer] + self.nodes.len[outer];
        let si = self.nodes.start[inner];
        let mut i = self.nodes.start[outer];
        let mut covered = true;
        for let mut j = si; j < si + self.nodes.len[inner]; j += 1 {
            let wanted = self.nodes.keys[j];
            while i < outer_end && self.nodes.keys[i].label() < wanted.label() {
                i += 1;
            }
            if i >= outer_end
                || self.nodes.keys[i].label() != wanted.label()
                || !self.covers(self.nodes.keys[i].parent(), wanted.parent()) {
                covered = false;
                break;
            }
            i += 1;
        }
        self.cover_cache[ck] = if covered { 1 } else { 0 };
        return covered;
    }

    fn merge(&mut self, a: i32, b: i32) -> i32 {
        if a == b {
            return a;
        }
        let ck = if a < b { atn_node_pair_key(a, b) } else { atn_node_pair_key(b, a) };
        if let Some(cached) = self.merge_cache.get(ck) {
            return cached;
        }
        let from = self.pending_edges.len();
        atn_merge_edges(
            &self.nodes.keys,
            self.nodes.start[a],
            self.nodes.len[a],
            self.nodes.start[b],
            self.nodes.len[b],
            &mut self.pending_edges,
            |x, y| self.merge(x, y),
        );
        let id = self.nodes.intern_moved(&mut self.pending_edges, from);
        self.merge_cache[ck] = id;
        return id;
    }

    fn callers_below(&self, caller: i32) -> List<i32> {
        let mut below: List<i32> = [];
        let mut n = caller;
        while n != CTX_EMPTY && n != CTX_UNKNOWN {
            assert self.nodes.len[n] == 1, "a caller stack is a chain";
            n = self.nodes.keys[self.nodes.start[n]].parent();
            below.push(n);
        }
        return below;
    }

    fn returns_below(&self, stack: i32, caller: i32, below: &mut List<i32>, stays: &mut List<i32>) -> bool {
        if below.contains(&stack) {
            return true;
        }
        if stack == caller || stack == CTX_EMPTY || stack == CTX_UNKNOWN || stays.contains(&stack) {
            return false;
        }
        let s = self.nodes.start[stack];
        for let mut e = s; e < s + self.nodes.len[stack]; e += 1 {
            let edge = self.nodes.keys[e];
            if edge.ret() == CTX_ANY_CALLER_RETURN || self.returns_below(edge.parent(), caller, below, stays) {
                below.push(stack);
                return true;
            }
        }
        stays.push(stack);
        return false;
    }
}

struct CtxArena {
    nodes: AtnKeyLists<AtnEdge>,
    pending_edges: List<AtnEdge>,
    pending: List<i32>,
    merge_cache: AtnKeyMap,
    walk_merge_cache: AtnKeyMap,
    question_index: AtnKeyMap,
    question_first: List<i32>,
    question_second: List<i32>,
    question_kind: List<i32>,
    question_asked_in: List<i32>,
    node_slot: List<i32>,
    node_open: List<bool>,
    slot_node: List<i32>,
    slot_cap: List<i32>,
    slot_revealed_in: List<i32>,
    slot_read_in: List<i32>,
    env: List<i32>,
    env_base: i32,
    env_len: i32,
    left_env_base: i32,
    left_env_len: i32,
    epoch: i32,
    real: RealStacks,
    env_real: AtnKeyMap,
    real_slot: List<i32>,
    real_slot_in: List<i32>,
    closed_real: AtnKeyMap,
    caller: i32,
    reading: i32,
    slot_merges: i32,
    reads: List<i32>,
    node_limit: i32,
    closure_cut_short: bool,
    guard_label: List<i32>,
    guard_rest: List<i32>,
    guard_index: AtnKeyMap,
}

struct AtnConfig {
    state: i32,
    alt: i32,
    pctx: i32,
    pr: i32,
    guard: i32,
}

internal struct AtnPreds {
    met: List<i32>,
    own: List<i32>,
    failed: List<i32>,
    origin: i32 = -1,
}

internal global ATN_NO_PREDS: AtnPreds = AtnPreds { met: [], own: [], failed: [] };

internal fn atn_unasked(_label: i32) -> bool {
    return true;
}

impl CtxArena {
    fn new() -> CtxArena {
        let mut arena = CtxArena {
            nodes: AtnKeyLists::new(),
            pending_edges: [],
            pending: [],
            merge_cache: AtnKeyMap::new(),
            walk_merge_cache: AtnKeyMap::new(),
            question_index: AtnKeyMap::new(),
            question_first: [],
            question_second: [],
            question_kind: [],
            question_asked_in: [],
            node_slot: [],
            node_open: [],
            slot_node: [],
            slot_cap: [],
            slot_revealed_in: [],
            slot_read_in: [],
            env: [],
            env_base: 0,
            env_len: 0,
            left_env_base: 0,
            left_env_len: 0,
            epoch: 0,
            real: RealStacks::new(),
            env_real: AtnKeyMap::new(),
            real_slot: [],
            real_slot_in: [],
            closed_real: AtnKeyMap::new(),
            caller: CTX_UNKNOWN,
            reading: 0,
            slot_merges: 0,
            reads: [],
            node_limit: ATN_ARENA_CAP,
            closure_cut_short: false,
            guard_label: [-1],
            guard_rest: [ATN_NO_GUARD],
            guard_index: AtnKeyMap::new(),
        };
        let empty = arena.push(CTX_BOUNDARY, 0, CTX_EMPTY);
        let unknown = arena.push(CTX_UNKNOWN_RETURN, 0, CTX_EMPTY);
        let any_caller = arena.push(CTX_ANY_CALLER_RETURN, 0, CTX_EMPTY);
        assert empty == CTX_EMPTY && unknown == CTX_UNKNOWN && any_caller == CTX_ANY_CALLER, "the bottom, unknown-caller and any-caller contexts are the arena's first nodes";
        return arena;
    }

    fn guard_with(&mut self, guard: i32, label: i32) -> i32
        contract label >= 0
    {
        if self.guard_holds(guard, label) {
            return guard;
        }
        let k = atn_node_pair_key(guard, label);
        if let Some(known) = self.guard_index.get(k) {
            return known;
        }
        let g = self.guard_label.len();
        assert g < CFG_KEY_GUARD_SLOT, "one prediction's guards fit the config key";
        self.guard_label.push(label);
        self.guard_rest.push(guard);
        self.guard_index[k] = g;
        return g;
    }

    fn guard_holds(&self, guard: i32, label: i32) -> bool {
        let mut g = guard;
        while g != ATN_NO_GUARD {
            if self.guard_label[g] == label {
                return true;
            }
            g = self.guard_rest[g];
        }
        return false;
    }

    fn push_held_guards(&self, configs: &List<AtnConfig>, out: &mut List<i32>) {
        for let c of configs {
            if c.alt >= ATN_FAILED_ALT {
                continue;
            }
            let mut g = c.guard;
            while g != ATN_NO_GUARD {
                if !out.contains(&self.guard_label[g]) {
                    out.push(self.guard_label[g]);
                }
                g = self.guard_rest[g];
            }
        }
    }

    fn node_count(&self) -> i32 {
        return self.nodes.count();
    }

    fn open_budget(&mut self) {
        self.node_limit = self.node_count() + ATN_ARENA_CAP;
    }

    fn enter_caller_stack(&mut self, sim: &AtnSim, rstk: &List<i32>, floor: i32) -> i32 {
        if self.real.nodes.count() >= ATN_REAL_NODE_CAP {
            self.real = RealStacks::new();
            self.closed_real.clear();
        }
        self.env.clear();
        self.env_base = 0;
        self.env_len = 0;
        self.enter_epoch();
        self.caller = CTX_UNKNOWN;
        if !rstk.is_empty() {
            self.caller = if floor > 0 { self.real.push(CTX_HIDDEN_RETURN, 0, CTX_EMPTY) } else { CTX_EMPTY };
            for let mut k = floor; k < rstk.len(); k += 1 {
                if rstk[k] >= 0 {
                    self.caller = self.real.push(rstk[k], atn_invocation_prec(sim, rstk, k - 1), self.caller);
                } else if k > 0 {
                    self.caller = CTX_UNKNOWN;
                }
            }
        }
        return self.bind(self.caller);
    }

    fn slot(&mut self, k: i32) -> i32 {
        while self.slot_node.len() <= k {
            self.slot_node.push(self.nodes.add_unkeyed());
            self.slot_cap.push(0);
            self.slot_revealed_in.push(0);
            self.slot_read_in.push(0);
            self.node_slot.push(self.slot_node.len() - 1);
            self.node_open.push(true);
        }
        return self.slot_node[k];
    }

    fn bind(&mut self, real: i32) -> i32 {
        if real <= CTX_ANY_CALLER {
            return real;
        }
        assert self.env.len() == self.env_base + self.env_len, "the walk binds into the environment it is in";
        if !self.env_holds(real) {
            self.real_slot[real] = self.env_len;
            self.real_slot_in[real] = self.epoch;
            self.env.push(real);
            self.env_len += 1;
        }
        return self.slot(self.real_slot[real]);
    }

    fn env_holds(&mut self, real: i32) -> bool {
        while self.real_slot.len() <= real {
            self.real_slot.push(0);
            self.real_slot_in.push(0);
        }
        return self.real_slot_in[real] == self.epoch;
    }

    fn enter_epoch(&mut self) {
        self.epoch += 1;
        self.env_real.clear();
        for let mut k = 0; k < self.env_len; k += 1 {
            let real = self.env[self.env_base + k];
            if real > CTX_ANY_CALLER && !self.env_holds(real) {
                self.real_slot[real] = k;
                self.real_slot_in[real] = self.epoch;
            }
        }
    }

    fn real_of(&mut self, node: i32) -> i32 {
        let k = self.node_slot[node];
        if k >= 0 {
            return self.env[self.env_base + k];
        }
        if node <= CTX_ANY_CALLER {
            return node;
        }
        let known = if self.node_open[node] {
            self.env_real.get(node as i64);
        } else {
            self.closed_real.get(node as i64);
        };
        if let Some(real) = known {
            return real;
        }
        let from = self.pending_edges.len();
        let s = self.nodes.start[node];
        for let mut e = s; e < s + self.nodes.len[node]; e += 1 {
            let below = self.real_of(self.nodes.keys[e].parent());
            self.pending_edges.push(self.nodes.keys[e].above(below));
        }
        let real = self.real.nodes.intern_moved(&mut self.pending_edges, from);
        if self.node_open[node] {
            self.env_real[node as i64] = real;
        } else {
            self.closed_real[node as i64] = real;
        }
        return real;
    }

    fn enter_env(&mut self, sources: &List<i32>, from: i32, count: i32) {
        let reals = self.pending.len();
        for let mut i = from; i < from + count; i += 1 {
            let real = self.real_of(sources[i]);
            self.pending.push(real);
        }
        self.left_env_base = self.env_base;
        self.left_env_len = self.env_len;
        self.env_base = self.env.len();
        self.env_len = count;
        for let mut i = 0; i < count; i += 1 {
            self.env.push(self.pending[reals + i]);
        }
        self.pending.truncate(reals);
        self.enter_epoch();
    }

    fn reenter_left_env(&mut self) {
        self.env.truncate(self.env_base);
        self.env_base = self.left_env_base;
        self.env_len = self.left_env_len;
        self.enter_epoch();
    }

    fn reveal(&mut self, k: i32) {
        if self.slot_revealed_in[k] == self.epoch {
            return;
        }
        let real = self.env[self.env_base + k];
        let s = self.real.nodes.start[real];
        let n = self.real.nodes.len[real];
        let from = self.pending.len();
        for let mut e = s; e < s + n; e += 1 {
            let above = self.bind(self.real.nodes.keys[e].parent());
            self.pending.push(above);
        }
        let slot = self.slot_node[k];
        if n > self.slot_cap[k] {
            self.slot_cap[k] = n * 2;
            self.nodes.start[slot] = self.nodes.keys.len();
            for let mut i = 0; i < n * 2; i += 1 {
                self.nodes.keys.push(AtnEdge::to(0, 0, 0));
            }
        }
        let start = self.nodes.start[slot];
        for let mut i = 0; i < n; i += 1 {
            self.nodes.keys[start + i] = self.real.nodes.keys[s + i].above(self.pending[from + i]);
        }
        self.nodes.len[slot] = n;
        self.pending.truncate(from);
        self.slot_revealed_in[k] = self.epoch;
    }

    fn read(&mut self, node: i32) {
        let k = self.node_slot[node];
        if k < 0 {
            return;
        }
        self.reveal(k);
        if self.slot_read_in[k] != self.reading {
            self.slot_read_in[k] = self.reading;
            self.reads.push(k);
        }
    }

    fn open_reads(&mut self) {
        self.reading += 1;
        self.reads.clear();
        self.walk_merge_cache.clear();
    }

    fn same(&mut self, a: i32, b: i32) -> bool {
        if a == b {
            return true;
        }
        if !self.node_open[a] && !self.node_open[b] {
            return false;
        }
        if self.node_slot[a] >= 0 || self.node_slot[b] >= 0 {
            return self.ask(ATN_ASK_SAME, i32::min(a, b), i32::max(a, b)) == 1;
        }
        if self.nodes.len[a] != self.nodes.len[b] {
            return false;
        }
        for let mut i = 0; i < self.nodes.len[a]; i += 1 {
            let x = self.nodes.keys[self.nodes.start[a] + i];
            let y = self.nodes.keys[self.nodes.start[b] + i];
            if x.label() != y.label() || !self.same(x.parent(), y.parent()) {
                return false;
            }
        }
        return true;
    }

    fn ask(&mut self, kind: i32, first: i32, second: i32) -> i32 {
        let ck = atn_node_pair_key(first, second) * ATN_ASK_KINDS + kind as i64;
        let mut question = self.question_index.get(ck).unwrap_or(-1);
        if question < 0 {
            question = self.question_first.len();
            self.question_kind.push(kind);
            self.question_first.push(first);
            self.question_second.push(second);
            self.question_asked_in.push(0);
            self.question_index[ck] = question;
        }
        if self.question_asked_in[question] != self.reading {
            self.question_asked_in[question] = self.reading;
            self.reads.push(-1 - question);
        }
        return self.answer(question);
    }

    fn answer(&mut self, question: i32) -> i32 {
        let first = self.real_of(self.question_first[question]);
        let second = self.real_of(self.question_second[question]);
        let kind = self.question_kind[question];
        if kind == ATN_ASK_MERGE {
            let merged = self.real.merge(first, second);
            return self.bind(merged);
        }
        return (if kind == ATN_ASK_SAME { first == second } else { self.real.covers(first, second) }) as i32;
    }

    fn intern_pending(&mut self, from: i32) -> i32
        contract self.pending_edges.len() > from, "a context has at least one edge"
    {
        let id = self.nodes.intern_moved(&mut self.pending_edges, from);
        if id < self.node_slot.len() {
            return id;
        }
        assert (id as i64) < ATN_NODE_PAIR_STRIDE, "a node id at the pair-key stride aliases two node pairs onto one key";
        let s = self.nodes.start[id];
        let mut open = false;
        for let mut e = s; e < s + self.nodes.len[id]; e += 1 {
            let below = self.nodes.keys[e].parent();
            open = open || below < id && self.node_open[below];
        }
        self.node_slot.push(-1);
        self.node_open.push(open);
        return id;
    }

    fn push(&mut self, return_state: i32, restore_pr: i32, parent: i32) -> i32 {
        let from = self.pending_edges.len();
        self.pending_edges.push(AtnEdge::to(return_state, restore_pr, parent));
        return self.intern_pending(from);
    }

    fn merge(&mut self, a: i32, b: i32) -> i32 {
        if a == b {
            return a;
        }
        let ck = if a < b { atn_node_pair_key(a, b) } else { atn_node_pair_key(b, a) };
        if let Some(cached) = self.merge_cache.get(ck) {
            return cached;
        }
        if self.node_slot[a] >= 0 || self.node_slot[b] >= 0 {
            self.slot_merges += 1;
            return self.ask(ATN_ASK_MERGE, i32::min(a, b), i32::max(a, b));
        }
        if let Some(cached_for_walk) = self.walk_merge_cache.get(ck) {
            self.slot_merges += 1;
            return cached_for_walk;
        }
        let slot_merges_before = self.slot_merges;
        let from = self.pending_edges.len();
        atn_merge_edges(
            &self.nodes.keys,
            self.nodes.start[a],
            self.nodes.len[a],
            self.nodes.start[b],
            self.nodes.len[b],
            &mut self.pending_edges,
            |x, y| self.merge(x, y),
        );
        let id = self.intern_pending(from);
        if self.slot_merges == slot_merges_before {
            self.merge_cache[ck] = id;
        } else {
            self.walk_merge_cache[ck] = id;
        }
        return id;
    }

    fn covers(&mut self, outer: i32, inner: i32) -> bool {
        if outer == inner {
            return true;
        }
        if !self.node_open[outer] && !self.node_open[inner] {
            let real_outer = self.real_of(outer);
            let real_inner = self.real_of(inner);
            return self.real.covers(real_outer, real_inner);
        }
        return self.ask(ATN_ASK_COVERS, outer, inner) == 1;
    }
}

fn atn_node_pair_key(a: i32, b: i32) -> i64 {
    return a as i64 * ATN_NODE_PAIR_STRIDE + b as i64;
}

fn atn_state_pr_key(state: i32, pr: i32) -> i64
    contract pr + 2 < CFG_KEY_PR_SLOT
    contract state + 2 < CFG_KEY_STATE_SLOT
{
    return (state + 2) as i64 * CFG_KEY_PR_SLOT as i64 + (pr + 2) as i64;
}

internal fn atn_invocation_prec(sim: &AtnSim, rstk: &List<i32>, k: i32) -> i32 {
    if k < 0 || rstk[k] < 0 {
        return 0;
    }
    return sim.state_call_prec[rstk[k]];
}

fn atn_state_consumes(sim: &AtnSim, state: i32) -> bool {
    let cnt = sim.state_tr_count[state];
    if cnt == 0 {
        return false;
    }
    return atn_tr_consumes(sim.tr_kind[sim.state_tr_start[state]]);
}

struct CfgSet {
    state: List<i32>,
    alt: List<i32>,
    pr: List<i32>,
    pctx: List<i32>,
    guard: List<i32>,
    index: AtnKeyMap,
}

impl CfgSet {
    fn new() -> CfgSet {
        return CfgSet {
            state: [],
            alt: [],
            pr: [],
            pctx: [],
            guard: [],
            index: AtnKeyMap::new(),
        };
    }

    fn clear(&mut self) {
        self.state.clear();
        self.alt.clear();
        self.pr.clear();
        self.pctx.clear();
        self.guard.clear();
        self.index.clear();
    }

    fn add(&mut self, arena: &mut CtxArena, state: i32, alt: i32, pr: i32, pctx: i32, guard: i32) -> [i32, bool]
        contract alt + 1 < CFG_KEY_ALT_SLOT
    {
        let k = (atn_state_pr_key(state, pr) * CFG_KEY_ALT_SLOT as i64 + (alt + 1) as i64) * CFG_KEY_GUARD_SLOT as i64 + guard as i64;
        if let Some(found) = self.index.get(k) {
            let merged = arena.merge(self.pctx[found], pctx);
            let changed = merged != self.pctx[found];
            self.pctx[found] = merged;
            return [found, changed];
        }
        let i = self.state.len();
        self.state.push(state);
        self.alt.push(alt);
        self.pr.push(pr);
        self.pctx.push(pctx);
        self.guard.push(guard);
        self.index[k] = i;
        return [i, true];
    }

    fn to_list(&self) -> List<AtnConfig> {
        let mut out: List<AtnConfig> = [];
        for let mut i = 0; i < self.state.len(); i += 1 {
            out.push(AtnConfig {
                state: self.state[i],
                alt: self.alt[i],
                pctx: self.pctx[i],
                pr: self.pr[i],
                guard: self.guard[i],
            });
        }
        return out;
    }
}

struct ClosureScratch {
    cset: CfgSet,
    rset: CfgSet,
    work: List<AtnConfig>,
    expanded: List<i32>,
    hidden_alts: List<i32>,
}

impl ClosureScratch {
    fn new() -> ClosureScratch {
        return ClosureScratch {
            cset: CfgSet::new(),
            rset: CfgSet::new(),
            work: [],
            expanded: [],
            hidden_alts: [],
        };
    }
}

fn atn_closure(
    sim: &AtnSim,
    arena: &mut CtxArena,
    seeds: &List<AtnConfig>,
    scratch: &mut ClosureScratch,
    lr_loop_unconsumed: i32 = -1,
    preds: &AtnPreds = &ATN_NO_PREDS,
) -> List<AtnConfig> {
    scratch.cset.clear();
    scratch.rset.clear();
    scratch.expanded.clear();
    scratch.hidden_alts.clear();
    scratch.work.clear();
    scratch.work.extend(seeds);
    let mut guard = 0;
    while let Some(c) = scratch.work.pop() {
        guard += 1;
        if guard > ATN_CLOSURE_GUARD {
            break;
        }
        if c.state == lr_loop_unconsumed
            && sim.tr_kind[sim.state_tr_start[c.state] + c.alt % ATN_FAILED_ALT] == ATN_TR_PRECEDENCE {
            continue;
        }
        let res = scratch.cset.add(arena, c.state, c.alt, c.pr, c.pctx, c.guard);
        let idx = res.0;
        while scratch.expanded.len() <= idx {
            scratch.expanded.push(-9);
        }
        let merged_pctx = scratch.cset.pctx[idx];
        if scratch.expanded[idx] >= 0 && arena.same(scratch.expanded[idx], merged_pctx) {
            continue;
        }
        scratch.expanded[idx] = merged_pctx;
        let cur = AtnConfig { ..c, pctx: merged_pctx };
        atn_expand(sim, arena, &cur, scratch, preds);
    }
    return scratch.rset.to_list();
}

fn atn_expand(sim: &AtnSim, arena: &mut CtxArena, cur: &AtnConfig, scratch: &mut ClosureScratch, preds: &AtnPreds) {
    let work = &mut scratch.work;
    let rset = &mut scratch.rset;
    if cur.state == ATN_ACCEPT_EOF || atn_state_consumes(sim, cur.state) {
        rset.add(arena, cur.state, atn_settled_alt(cur.alt), cur.pr, cur.pctx, cur.guard);
        return;
    }
    if sim.state_kind[cur.state] == ATN_RULE_STOP {
        atn_pop(sim, arena, cur, scratch);
        return;
    }
    let pctx = atn_collapse_into_caller_loop(sim, arena, cur, work, &mut scratch.hidden_alts);
    if pctx < 0 {
        return;
    }
    let start = sim.state_tr_start[cur.state];
    let cnt = sim.state_tr_count[cur.state];
    for let mut j = 0; j < cnt; j += 1 {
        let k = sim.tr_kind[start + j];
        let target = sim.tr_target[start + j];
        if k == ATN_TR_EPSILON {
            work.push(atn_past_edge(arena, &AtnConfig { ..*cur, state: target, pctx }, sim.tr_label[start + j], preds));
        } else if k == ATN_TR_PRECEDENCE {
            if sim.tr_prec[start + j] >= cur.pr {
                work.push(AtnConfig { ..*cur, state: target, pctx });
            }
        } else if k == ATN_TR_RULE {
            if target < 0 {
                continue;
            }
            if arena.node_count() >= arena.node_limit {
                arena.closure_cut_short = true;
                continue;
            }
            let npctx = arena.push(sim.tr_follow[start + j], cur.pr, pctx);
            work.push(AtnConfig { ..*cur, state: target, pctx: npctx, pr: sim.tr_prec[start + j] });
        }
    }
}

fn atn_past_edge(arena: &mut CtxArena, next: &AtnConfig, label: i32, preds: &AtnPreds) -> AtnConfig {
    if label < 0 || next.alt >= ATN_FAILED_ALT {
        return *next;
    }
    if label == ATN_ACTION_EDGE {
        return AtnConfig { ..*next, alt: next.alt + ATN_PASSED_ACTION };
    }
    if preds.own.contains(&label) && !arena.same(next.pctx, preds.origin) {
        return *next;
    }
    if preds.failed.contains(&label) {
        return AtnConfig { ..*next, alt: next.alt + ATN_FAILED_ALT };
    }
    if preds.met.contains(&label) {
        return AtnConfig { ..*next, guard: arena.guard_with(next.guard, label) };
    }
    return *next;
}

fn atn_settled_alt(alt: i32) -> i32 {
    return if alt >= ATN_PASSED_ACTION { alt - ATN_PASSED_ACTION } else { alt };
}

fn atn_collapse_into_caller_loop(
    sim: &AtnSim,
    arena: &mut CtxArena,
    cur: &AtnConfig,
    work: &mut List<AtnConfig>,
    hidden_alts: &mut List<i32>,
) -> i32 {
    if sim.state_collapse_to.is_empty() || !sim.state_collapse_target[cur.state] {
        return cur.pctx;
    }
    arena.read(cur.pctx);
    let s = arena.nodes.start[cur.pctx];
    let n = arena.nodes.len[cur.pctx];
    let mut collapses = false;
    let settled = atn_settled_alt(cur.alt);
    for let mut e = s; e < s + n; e += 1 {
        let edge = arena.nodes.keys[e];
        if edge.ret() == CTX_HIDDEN_RETURN && !hidden_alts.contains(&settled) {
            hidden_alts.push(settled);
        }
        collapses = collapses || atn_edge_collapses(sim, edge, cur);
    }
    if !collapses {
        return cur.pctx;
    }
    let kept = arena.pending_edges.len();
    for let mut e = s; e < s + n; e += 1 {
        let edge = arena.nodes.keys[e];
        if atn_edge_collapses(sim, edge, cur) {
            work.push(AtnConfig {
                ..*cur,
                pctx: edge.parent(),
                pr: edge.rpr(),
            });
        } else {
            arena.pending_edges.push(edge);
        }
    }
    if arena.pending_edges.len() == kept {
        return -1;
    }
    return arena.intern_pending(kept);
}

fn atn_edge_collapses(sim: &AtnSim, edge: AtnEdge, cur: &AtnConfig) -> bool {
    let r = edge.ret();
    return r >= 0 && sim.state_collapse_to[r] == cur.state && cur.pr >= edge.rpr();
}

fn atn_pop(sim: &AtnSim, arena: &mut CtxArena, cur: &AtnConfig, scratch: &mut ClosureScratch) {
    arena.read(cur.pctx);
    let s = arena.nodes.start[cur.pctx];
    let n = arena.nodes.len[cur.pctx];
    let settled = atn_settled_alt(cur.alt);
    for let mut e = s; e < s + n; e += 1 {
        let edge = arena.nodes.keys[e];
        let r = edge.ret();
        if r == CTX_BOUNDARY || r == CTX_ANY_CALLER_RETURN {
            atn_pop_into_callers(sim, arena, cur, scratch);
        } else if r == CTX_UNKNOWN_RETURN {
            scratch.rset.add(arena, cur.state, settled, cur.pr, CTX_UNKNOWN, cur.guard);
        } else if r == CTX_HIDDEN_RETURN {
            if !scratch.hidden_alts.contains(&settled) {
                scratch.hidden_alts.push(settled);
            }
        } else {
            scratch.work.push(AtnConfig {
                ..*cur,
                state: r,
                pctx: edge.parent(),
                pr: edge.rpr(),
            });
        }
    }
}

fn atn_pop_into_callers(sim: &AtnSim, arena: &mut CtxArena, cur: &AtnConfig, scratch: &mut ClosureScratch) {
    let rule = cur.state / 2;
    let first = sim.rule_follow_start[rule];
    let end = sim.rule_follow_start[rule + 1];
    scratch.rset.add(arena, ATN_ACCEPT_EOF, atn_settled_alt(cur.alt), cur.pr, CTX_EMPTY, cur.guard);
    for let mut f = first; f < end; f += 1 {
        scratch.work.push(AtnConfig { ..*cur, state: sim.rule_follow[f], pctx: CTX_ANY_CALLER, pr: 0 });
    }
}

fn atn_move(sim: &AtnSim, configs: &List<AtnConfig>, token: i32, eof: i32) -> List<AtnConfig> {
    let mut out: List<AtnConfig> = [];
    let mut ended: List<AtnConfig> = [];
    for let c of configs {
        if c.state == ATN_ACCEPT_EOF {
            if token == eof {
                ended.push(*c);
            }
            continue;
        }
        if sim.state_kind[c.state] == ATN_RULE_STOP {
            out.push(*c);
            continue;
        }
        let start = sim.state_tr_start[c.state];
        let cnt = sim.state_tr_count[c.state];
        for let mut j = 0; j < cnt; j += 1 {
            let k = sim.tr_kind[start + j];
            let label = sim.tr_label[start + j];
            let matched = if k == ATN_TR_ATOM {
                label == token;
            } else if k == ATN_TR_SET {
                atn_set_contains(sim, label, token);
            } else if k == ATN_TR_WILDCARD {
                token != eof;
            } else if k == ATN_TR_NOT_ATOM {
                token != label && token != eof;
            } else {
                false;
            };
            if matched {
                out.push(AtnConfig { ..*c, state: sim.tr_target[start + j] });
            }
        }
    }
    if out.iter_ref().any(|c| sim.state_kind[c.state] != ATN_RULE_STOP) {
        return out;
    }
    for let c of ended {
        out.push(c);
    }
    return out;
}

fn atn_unique_alts(configs: &List<AtnConfig>) -> List<i32> {
    let mut alts: List<i32> = [];
    for let c of configs {
        if !alts.contains(&c.alt) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return alts;
}

fn atn_resolve(sorted_alts: &List<i32>) -> i32 {
    return if sorted_alts.is_empty() || sorted_alts[0] >= ATN_FAILED_ALT { -1 } else { sorted_alts[0] };
}

fn atn_dead_end(arena: &mut CtxArena, configs: &List<AtnConfig>, at_first_token: bool) -> i32 {
    let alt = atn_finished_alt(arena, configs);
    return if alt < 0 && at_first_token { ATN_NOTHING_STARTS } else { alt };
}

fn atn_finished_alt(arena: &mut CtxArena, configs: &List<AtnConfig>) -> i32 {
    let caller = arena.caller;
    let mut below = arena.real.callers_below(caller);
    let mut stays: List<i32> = [];
    let mut alts: List<i32> = [];
    for let c of configs {
        if alts.contains(&c.alt) {
            continue;
        }
        if c.state == ATN_ACCEPT_EOF {
            alts.push(c.alt);
            continue;
        }
        let stack = arena.real_of(c.pctx);
        if arena.real.returns_below(stack, caller, &mut below, &mut stays) {
            alts.push(c.alt);
        }
    }
    alts.sort();
    return atn_resolve(&alts);
}

fn atn_one_alt(sorted_alts: &List<i32>) -> bool {
    let a = sorted_alts[0] % ATN_FAILED_ALT;
    return sorted_alts.iter_ref().all(|b| *b % ATN_FAILED_ALT == a);
}

fn atn_min_alt_covers_rest(arena: &mut CtxArena, configs: &List<AtnConfig>, min_alt: i32) -> bool {
    let mut min_ctx = AtnKeyMap::new();
    for let c of configs {
        if c.alt == min_alt {
            min_ctx[atn_state_pr_key(c.state, c.pr)] = c.pctx;
        }
    }
    for let c of configs {
        if c.alt != min_alt {
            let Some(e) = min_ctx.get(atn_state_pr_key(c.state, c.pr)) else {
                return false;
            };
            if !arena.covers(e, c.pctx) {
                return false;
            }
        }
    }
    return true;
}

fn atn_all_at_end(sim: &AtnSim, configs: &List<AtnConfig>) -> bool {
    if configs.is_empty() {
        return false;
    }
    for let c of configs {
        if c.state != ATN_ACCEPT_EOF && sim.state_kind[c.state] != ATN_RULE_STOP {
            return false;
        }
    }
    return true;
}

internal fn atn_predict_once(
    sim: &AtnSim,
    decision: i32,
    atn: &mut AtnPredictor,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let depth = atn.stack.len();
    let v = atn.recorded_verdict(decision, pos, min_prec, depth);
    if v >= 0 {
        atn.read_down_to(atn.verdict_reach[v]);
        return atn.verdict_alt[v];
    }
    let [alt, reach] = atn.predict_reaching(
        sim,
        decision,
        tokens,
        pos,
        eof,
        min_prec,
        &ATN_NO_PREDS.met,
        &ATN_NO_PREDS.own,
        atn_unasked,
    );
    atn.read_down_to(reach);
    atn.record_verdict(decision, pos, min_prec, depth, alt, reach);
    return alt;
}

internal fn atn_predict_with_stack(
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32 = 0,
    met: &List<i32> = &ATN_NO_PREDS.met,
    own: &List<i32> = &ATN_NO_PREDS.own,
    ask: fn(i32) -> bool = atn_unasked,
) -> i32 {
    let mut dfa = AtnDfa::new();
    let mut preds = AtnPreds { met: *met, own: *own, failed: [] };
    return atn_predict_above(
        &mut dfa,
        sim,
        decision,
        rule_stack,
        0,
        tokens,
        start_pos,
        eof,
        min_prec,
        &mut preds,
        &mut [],
        ask,
    ).0;
}

fn atn_predict_above<effect E>(
    dfa: &mut AtnDfa,
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    floor: i32,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32,
    preds: &mut AtnPreds,
    asked: &mut List<i32>,
    ask: fn(i32) -> bool with E,
) -> [i32, bool] with E {
    loop {
        let mut held: List<i32> = [];
        let verdict = atn_walk(
            dfa,
            sim,
            decision,
            rule_stack,
            floor,
            tokens,
            start_pos,
            eof,
            min_prec,
            preds,
            &mut held,
        );
        held.sort();
        let known_failed = preds.failed.len();
        for let label of held {
            if asked.contains(&label) {
                continue;
            }
            asked.push(label);
            if !ask(label) {
                preds.failed.push(label);
            }
        }
        if preds.failed.len() == known_failed {
            return verdict;
        }
        preds.failed.sort();
    }
}

fn atn_predict_walk<effect E>(
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32,
    met: &List<i32>,
    own: &List<i32>,
    ask: fn(i32) -> bool with E,
) -> [i32, bool] with E {
    let mut preds = AtnPreds { met: *met, own: *own, failed: [] };
    return atn_predict_above(
        &mut ATN_DFA,
        sim,
        decision,
        rule_stack,
        0,
        tokens,
        start_pos,
        eof,
        min_prec,
        &mut preds,
        &mut [],
        ask,
    );
}

fn atn_walk(
    dfa: &mut AtnDfa,
    sim: &AtnSim,
    decision: i32,
    rule_stack: &List<i32>,
    floor: i32,
    tokens: &Array<i32>,
    start_pos: i32,
    eof: i32,
    min_prec: i32,
    preds: &AtnPreds,
    held: &mut List<i32>,
) -> [i32, bool] {
    dfa.make_room(sim);
    let caller = dfa.arena.enter_caller_stack(sim, rule_stack, floor);
    dfa.arena.open_budget();
    let mut s = dfa.start_state(sim, decision, caller, min_prec, &AtnPreds { ..*preds, origin: caller });
    let mut live = s;
    let mut pos = start_pos;
    loop {
        let verdict = dfa.state_verdict[s];
        if verdict == ATN_DFA_DEAD {
            if live != s {
                dfa.arena.reenter_left_env();
            }
            return [atn_dead_end(&mut dfa.arena, &dfa.state_configs[live], pos == start_pos + 1), false];
        }
        if verdict != ATN_DFA_UNDECIDED {
            if verdict != ATN_READS_HIDDEN {
                dfa.arena.push_held_guards(&dfa.state_configs[s], held);
            }
            return [verdict, true];
        }
        live = s;
        let token = if pos < tokens.len() { tokens[pos] } else { eof };
        if token == eof {
            let ended = atn_move(sim, &dfa.state_configs[s], eof, eof);
            dfa.arena.push_held_guards(&ended, held);
            let survivors = atn_unique_alts(&ended);
            return if survivors.is_empty() {
                [atn_dead_end(&mut dfa.arena, &dfa.state_configs[s], pos == start_pos), false];
            } else {
                [atn_resolve(&survivors), true];
            };
        }
        s = dfa.step(sim, s, token, eof);
        pos += 1;
    }
}

internal struct AtnDfa {
    arena: CtxArena,
    scratch: ClosureScratch,
    state_configs: List<List<AtnConfig>>,
    internal state_verdict: List<i32>,
    seeds: AtnKeyLists<i32>,
    seed_branch: List<i32>,
    branches: AtnKeyLists<i32>,
    branch_asks: List<i32>,
    branch_state: List<i32>,
    edges: AtnKeyMap,
    edge_seed: List<i32>,
    edge_sources_from: List<i32>,
    edge_sources: List<i32>,
    sim_serial: i32,
}

impl AtnDfa {
    fn new() -> AtnDfa {
        return AtnDfa {
            arena: CtxArena::new(),
            scratch: ClosureScratch::new(),
            state_configs: [],
            state_verdict: [],
            seeds: AtnKeyLists::new(),
            seed_branch: [],
            branches: AtnKeyLists::new(),
            branch_asks: [],
            branch_state: [],
            edges: AtnKeyMap::new(),
            edge_seed: [],
            edge_sources_from: [],
            edge_sources: [],
            sim_serial: 0,
        };
    }

    fn make_room(&mut self, sim: &AtnSim) {
        if self.sim_serial == 0 {
            self.sim_serial = sim.serial;
        }
        assert self.sim_serial == sim.serial, "a DFA caches the predictions of one ATN";
        if self.arena.closure_cut_short
            || self.arena.node_count() >= ATN_DFA_NODE_CAP
            || self.arena.guard_label.len() >= ATN_DFA_GUARD_CAP {
            *self = AtnDfa::new();
            self.sim_serial = sim.serial;
        }
    }

    fn start_state(&mut self, sim: &AtnSim, decision: i32, caller: i32, min_prec: i32, preds: &AtnPreds) -> i32 {
        let from = self.seeds.keys.len();
        self.seeds.keys.push(ATN_DFA_START_KEY);
        self.seeds.keys.push(decision);
        self.seeds.keys.push(caller);
        self.seeds.keys.push(min_prec);
        self.seeds.keys.extend(&preds.met);
        self.seeds.keys.push(ATN_DFA_START_KEY);
        self.seeds.keys.extend(&preds.own);
        self.seeds.keys.push(ATN_DFA_START_KEY);
        self.seeds.keys.extend(&preds.failed);
        let seed = self.seed(from);
        let known = self.known_state(seed);
        if known >= 0 {
            return known;
        }
        self.arena.open_reads();
        let dstate = sim.decision_state[decision];
        let start = sim.state_tr_start[dstate];
        let mut seeds: List<AtnConfig> = [];
        for let mut j = 0; j < sim.state_tr_count[dstate]; j += 1 {
            if sim.tr_kind[start + j] == ATN_TR_PRECEDENCE && sim.tr_prec[start + j] < min_prec {
                continue;
            }
            seeds.push(AtnConfig {
                state: sim.tr_target[start + j],
                alt: j,
                pctx: caller,
                pr: min_prec,
                guard: ATN_NO_GUARD,
            });
        }
        let configs = atn_closure(sim, &mut self.arena, &seeds, &mut self.scratch, dstate, preds);
        return self.add_state(sim, configs, seed);
    }

    fn step(&mut self, sim: &AtnSim, s: i32, token: i32, eof: i32) -> i32
        contract token >= 0 && (token as i64) < ATN_DFA_TOKEN_SLOT
    {
        let edge = s as i64 * ATN_DFA_TOKEN_SLOT + token as i64;
        let mut taken = self.edges.get(edge).unwrap_or(-1);
        if taken < 0 {
            let moved = atn_move(sim, &self.state_configs[s], token, eof);
            let from = self.seeds.keys.len();
            let sources_from = self.edge_sources.len();
            for let c of &moved {
                let mut pctx = c.pctx;
                if self.arena.node_open[pctx] {
                    let mut i = sources_from;
                    while i < self.edge_sources.len() && self.edge_sources[i] != pctx {
                        i += 1;
                    }
                    if i == self.edge_sources.len() {
                        self.edge_sources.push(pctx);
                    }
                    pctx = self.arena.slot(i - sources_from);
                }
                self.seeds.keys.push(c.state);
                self.seeds.keys.push(c.alt);
                self.seeds.keys.push(c.pr);
                self.seeds.keys.push(pctx);
                self.seeds.keys.push(c.guard);
            }
            taken = self.edge_seed.len();
            self.edge_seed.push(self.seed(from));
            self.edge_sources_from.push(sources_from);
            self.edges[edge] = taken;
        }
        let sources_from = self.edge_sources_from[taken];
        let sources_end = if taken + 1 < self.edge_seed.len() {
            self.edge_sources_from[taken + 1];
        } else {
            self.edge_sources.len();
        };
        self.arena.enter_env(&self.edge_sources, sources_from, sources_end - sources_from);
        let seed = self.edge_seed[taken];
        let known = self.known_state(seed);
        if known >= 0 {
            return known;
        }
        self.arena.open_reads();
        let moved = self.seed_configs(seed);
        let configs = atn_closure(sim, &mut self.arena, &moved, &mut self.scratch);
        return self.add_state(sim, configs, seed);
    }

    fn seed(&mut self, from: i32) -> i32 {
        let known = self.seeds.find(from);
        if known >= 0 {
            self.seeds.keys.truncate(from);
            return known;
        }
        let root = self.branches.keys.len();
        self.branches.keys.push(self.seeds.count());
        let branch = self.open_branch(root);
        self.seed_branch.push(branch);
        return self.seeds.add(from);
    }

    fn seed_configs(&self, seed: i32) -> List<AtnConfig> {
        let mut configs: List<AtnConfig> = [];
        let from = self.seeds.start[seed];
        for let mut i = from; i < from + self.seeds.len[seed]; i += 5 {
            configs.push(AtnConfig {
                state: self.seeds.keys[i],
                alt: self.seeds.keys[i + 1],
                pr: self.seeds.keys[i + 2],
                pctx: self.seeds.keys[i + 3],
                guard: self.seeds.keys[i + 4],
            });
        }
        return configs;
    }

    fn open_branch(&mut self, from: i32) -> i32 {
        self.branch_asks.push(ATN_DFA_BRANCH_OPEN);
        self.branch_state.push(-1);
        return self.branches.add(from);
    }

    fn branch_key(&mut self, branch: i32, read: i32) -> i32 {
        let from = self.branches.keys.len();
        if read < 0 {
            self.branches.keys.push(branch);
            self.branches.keys.push(self.arena.answer(-1 - read));
            return from;
        }
        self.arena.reveal(read);
        let node = self.arena.slot_node[read];
        let s = self.arena.nodes.start[node];
        self.branches.keys.push(branch);
        for let mut e = s; e < s + self.arena.nodes.len[node]; e += 1 {
            let edge = self.arena.nodes.keys[e];
            self.branches.keys.push(edge.ret());
            self.branches.keys.push(edge.rpr());
            self.branches.keys.push(edge.parent());
        }
        return from;
    }

    fn known_state(&mut self, seed: i32) -> i32 {
        let mut branch = self.seed_branch[seed];
        while branch >= 0 && self.branch_asks[branch] != ATN_DFA_BRANCH_LEAF {
            if self.branch_asks[branch] == ATN_DFA_BRANCH_OPEN {
                return -1;
            }
            let from = self.branch_key(branch, self.branch_asks[branch]);
            branch = self.branches.find_and_drop(from);
        }
        return if branch >= 0 { self.branch_state[branch] } else { -1 };
    }

    fn keep_state(&mut self, seed: i32, state: i32) {
        if self.arena.closure_cut_short {
            return;
        }
        let reads = self.arena.reads;
        let mut branch = self.seed_branch[seed];
        for let read of reads {
            if self.branch_asks[branch] == ATN_DFA_BRANCH_OPEN {
                self.branch_asks[branch] = read;
            }
            assert self.branch_asks[branch] == read, "equal frames lead a closure to read the same frame next";
            let from = self.branch_key(branch, read);
            let known = self.branches.find(from);
            if known >= 0 {
                self.branches.keys.truncate(from);
            }
            branch = if known >= 0 { known } else { self.open_branch(from) };
        }
        assert self.branch_asks[branch] == ATN_DFA_BRANCH_OPEN, "a state is kept once per seed and frames read";
        self.branch_asks[branch] = ATN_DFA_BRANCH_LEAF;
        self.branch_state[branch] = state;
    }

    fn add_state(&mut self, sim: &AtnSim, configs: List<AtnConfig>, seed: i32) -> i32 {
        let s = self.state_configs.len();
        let alts = atn_unique_alts(&configs);
        let verdict = self.verdict_of(sim, &configs, alts);
        self.state_verdict.push(verdict);
        self.state_configs.push(configs);
        self.keep_state(seed, s);
        return s;
    }

    fn verdict_of(&mut self, sim: &AtnSim, configs: &List<AtnConfig>, alts: List<i32>) -> i32 {
        if !self.scratch.hidden_alts.is_empty() {
            let mut alive = alts;
            for let a of &self.scratch.hidden_alts {
                if !alive.contains(a) {
                    alive.push(*a);
                }
            }
            alive.sort();
            return if atn_one_alt(&alive) { atn_resolve(&alive) } else { ATN_READS_HIDDEN };
        }
        if alts.is_empty() {
            return ATN_DFA_DEAD;
        }
        let first = atn_resolve(&alts);
        if first < 0
            || atn_one_alt(&alts)
            || atn_min_alt_covers_rest(&mut self.arena, configs, first)
            || atn_all_at_end(sim, configs) {
            return first;
        }
        return ATN_DFA_UNDECIDED;
    }
}

global ATN_CONT_ANY: i32 = -1;
global ATN_CONT_NONE: i32 = -2;

internal fn atn_with_lr_tables(sim: AtnSim) -> AtnSim {
    let mut out = sim;
    let nrules = out.rule_start.len();
    for let mut r = 0; r < nrules; r += 1 {
        out.rule_nullable.push(false);
        out.rule_first.push([]);
        out.rule_first_neg.push([]);
        out.rule_first_open.push(false);
    }
    if out.tr_kind.contains(&ATN_TR_PRECEDENCE) {
        let kinds = out.num_tokens;
        out.cont_words = (kinds + 63) / 64;
        let mut walk = AtnContWalk {
            seen: List::filled(out.state_kind.len(), 0),
            stamp: 0,
            has: List::filled(kinds, false),
            first: [],
            neg: [],
        };
        atn_compute_first_nullable(&mut out, &mut walk);
        atn_compute_state_cont(&mut out, &mut walk);
        atn_compute_collapse(&mut out);
    }
    return out;
}

struct AtnContWalk {
    seen: List<i32>,
    stamp: i32,
    has: List<bool>,
    first: List<i32>,
    neg: List<i32>,
}

impl AtnContWalk {
    fn begin(&mut self) {
        self.stamp += 1;
        for let t of &self.first {
            self.has[*t] = false;
        }
        self.first.clear();
        self.neg.clear();
    }

    fn enters(&mut self, state: i32) -> bool {
        if self.seen[state] == self.stamp {
            return false;
        }
        self.seen[state] = self.stamp;
        return true;
    }

    fn add_first(&mut self, t: i32) {
        if !self.has[t] {
            self.has[t] = true;
            self.first.push(t);
        }
    }

    fn add_neg(&mut self, t: i32) {
        if !self.neg.contains(&t) {
            self.neg.push(t);
        }
    }
}

fn atn_compute_collapse(sim: &mut AtnSim) {
    let nstates = sim.state_kind.len();
    sim.state_collapse_target = List::filled(nstates, false);
    for let mut st = 0; st < nstates; st += 1 {
        let entry = atn_lr_entry_reached(sim, st);
        sim.state_collapse_to.push(entry);
        if entry >= 0 {
            sim.state_collapse_target[entry] = true;
        }
    }
}

fn atn_lr_entry_reached(sim: &AtnSim, from: i32) -> i32 {
    let mut st = from;
    for let mut steps = 0; steps < 8; steps += 1 {
        let s = sim.state_tr_start[st];
        let c = sim.state_tr_count[st];
        for let mut j = 0; j < c; j += 1 {
            if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE {
                return if steps > 0 { st } else { -1 };
            }
        }
        if c != 1 || sim.tr_kind[s] != ATN_TR_EPSILON {
            return -1;
        }
        st = sim.tr_target[s];
    }
    return -1;
}

fn atn_compute_state_cont(sim: &mut AtnSim, walk: &mut AtnContWalk) {
    let nstates = sim.state_kind.len();
    let mut entered_from = List::<i32>::filled(nstates, -1);
    let mut read = List::filled(nstates, false);
    for let mut st = 0; st < nstates; st += 1 {
        let s = sim.state_tr_start[st];
        for let mut j = s; j < s + sim.state_tr_count[st]; j += 1 {
            if sim.tr_kind[j] == ATN_TR_PRECEDENCE {
                entered_from[sim.tr_target[j]] = st;
                read[sim.tr_target[j]] = true;
            } else if sim.tr_kind[j] == ATN_TR_RULE {
                read[sim.tr_follow[j]] = true;
            }
        }
    }
    for let mut st = 0; st < nstates; st += 1 {
        if !read[st] {
            sim.state_cont_nullable.push(false);
            atn_push_cont_admits(sim, &[], &[], false);
            continue;
        }
        walk.begin();
        let nullable = atn_cont_nullable(sim, st, walk);
        walk.begin();
        if entered_from[st] >= 0 {
            let _ = walk.enters(entered_from[st]);
        }
        let open = atn_cont_first(sim, st, walk);
        sim.state_cont_nullable.push(nullable);
        atn_push_cont_admits(sim, &walk.first, &walk.neg, open);
    }
}

fn atn_push_cont_admits(sim: &mut AtnSim, first: &List<i32>, neg: &List<i32>, open: bool) {
    let row = sim.state_cont_first.len();
    for let mut w = 0; w < sim.cont_words; w += 1 {
        sim.state_cont_first.push(0);
    }
    for let t of first {
        sim.state_cont_first[row + *t / 64] |= 1 as i64 << (*t % 64) as i64;
    }
    let any_but = if open || neg.iter_ref().any(|x| *x != neg[0]) {
        ATN_CONT_ANY;
    } else if neg.is_empty() {
        ATN_CONT_NONE;
    } else {
        neg[0];
    };
    sim.state_cont_any_but.push(any_but);
}

fn atn_compute_first_nullable(sim: &mut AtnSim, walk: &mut AtnContWalk) {
    let nrules = sim.rule_start.len();
    let mut changed = true;
    while changed {
        changed = false;
        for let mut r = 0; r < nrules; r += 1 {
            walk.begin();
            if atn_cont_nullable(sim, sim.rule_start[r], walk) && !sim.rule_nullable[r] {
                sim.rule_nullable[r] = true;
                changed = true;
            }
            walk.begin();
            if atn_cont_first(sim, sim.rule_start[r], walk) && !sim.rule_first_open[r] {
                sim.rule_first_open[r] = true;
                changed = true;
            }
            assert walk.first.len() >= sim.rule_first[r].len() && walk.neg.len() >= sim.rule_first_neg[r].len(), "a rule's first set only grows as its callees' do";
            if walk.first.len() > sim.rule_first[r].len() || walk.neg.len() > sim.rule_first_neg[r].len() {
                sim.rule_first[r] = walk.first;
                sim.rule_first_neg[r] = walk.neg;
                changed = true;
            }
        }
    }
}

fn atn_cont_nullable(sim: &AtnSim, state: i32, walk: &mut AtnContWalk) -> bool {
    if !walk.enters(state) {
        return false;
    }
    if sim.state_kind[state] == ATN_RULE_STOP {
        return true;
    }
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_nullable(sim, sim.tr_target[s + j], walk) {
                return true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 && sim.rule_nullable[callee] && atn_cont_nullable(sim, sim.tr_follow[s + j], walk) {
                return true;
            }
        }
    }
    return false;
}

fn atn_cont_first(sim: &AtnSim, state: i32, walk: &mut AtnContWalk) -> bool {
    if !walk.enters(state) {
        return false;
    }
    if sim.state_kind[state] == ATN_RULE_STOP {
        return false;
    }
    let mut open = false;
    let s = sim.state_tr_start[state];
    let c = sim.state_tr_count[state];
    for let mut j = 0; j < c; j += 1 {
        let k = sim.tr_kind[s + j];
        if k == ATN_TR_ATOM {
            walk.add_first(sim.tr_label[s + j]);
        } else if k == ATN_TR_SET {
            for let t of &sim.set_members[sim.tr_label[s + j]] {
                walk.add_first(*t);
            }
        } else if k == ATN_TR_WILDCARD {
            open = true;
        } else if k == ATN_TR_NOT_ATOM {
            walk.add_neg(sim.tr_label[s + j]);
        } else if k == ATN_TR_EPSILON || k == ATN_TR_PRECEDENCE {
            if atn_cont_first(sim, sim.tr_target[s + j], walk) {
                open = true;
            }
        } else if k == ATN_TR_RULE {
            let callee = sim.tr_label[s + j];
            if callee >= 0 {
                for let t of &sim.rule_first[callee] {
                    walk.add_first(*t);
                }
                for let x of &sim.rule_first_neg[callee] {
                    walk.add_neg(*x);
                }
                if sim.rule_first_open[callee] {
                    open = true;
                }
                if sim.rule_nullable[callee] && atn_cont_first(sim, sim.tr_follow[s + j], walk) {
                    open = true;
                }
            }
        }
    }
    return open;
}

internal fn atn_state_cont_admits(sim: &AtnSim, state: i32, t: i32, eof: i32) -> bool {
    let any_but = sim.state_cont_any_but[state];
    if t != eof && (any_but == ATN_CONT_ANY || any_but >= 0 && t != any_but) {
        return true;
    }
    return t < sim.num_tokens && sim.state_cont_first[state * sim.cont_words + t / 64] >> (t % 64) as i64 & 1 != 0;
}

internal fn atn_lr_loop_decision(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32 = 0,
) -> i32 {
    let dstate = sim.decision_state[decision];
    let t = if pos < tokens.len() { tokens[pos] } else { eof };
    let s = sim.state_tr_start[dstate];
    let c = sim.state_tr_count[dstate];
    let exit_alt = c - 1;
    let mut enter = -1;
    let mut contested = false;
    for let mut j = 0; j < c; j += 1 {
        if sim.tr_kind[s + j] == ATN_TR_PRECEDENCE
            && sim.tr_prec[s + j] >= min_prec
            && atn_state_cont_admits(sim, sim.tr_target[s + j], t, eof) {
            if enter >= 0 {
                contested = true;
                break;
            }
            enter = j;
        }
    }
    if enter < 0 {
        return exit_alt;
    }
    if !contested && !atn_caller_contests(sim, atn, dstate, t, eof, min_prec) {
        return enter;
    }
    return atn_lr_predict(sim, atn, decision, tokens, pos, t, eof, min_prec);
}

internal fn atn_lr_enter_or_ask(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    enter: i32,
    tokens: &Array<i32>,
    pos: i32,
    eof: i32,
    min_prec: i32,
) -> i32 {
    let t = if pos < tokens.len() { tokens[pos] } else { eof };
    if !atn_caller_contests(sim, atn, sim.decision_state[decision], t, eof, min_prec) {
        return enter;
    }
    return atn_lr_predict(sim, atn, decision, tokens, pos, t, eof, min_prec);
}

fn atn_lr_predict(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    tokens: &Array<i32>,
    pos: i32,
    t: i32,
    eof: i32,
    min_prec: i32,
) -> i32 {
    let alt = atn_predict_once(sim, decision, atn, tokens, pos, eof, min_prec);
    if alt == sim.state_tr_count[sim.decision_state[decision]] - 1 {
        atn_record_callers_exit(sim, atn, decision, pos, min_prec, t, eof);
    }
    return alt;
}

fn atn_record_callers_exit(
    sim: &AtnSim,
    atn: &mut AtnPredictor,
    decision: i32,
    pos: i32,
    min_prec: i32,
    t: i32,
    eof: i32,
) {
    let dstate = sim.decision_state[decision];
    let exit_alt = sim.state_tr_count[dstate] - 1;
    let mut mp = min_prec;
    for let mut k = atn.stack.len() - 1; k >= 1; k -= 1 {
        let ret = atn.stack[k];
        atn.read_down_to(k);
        if ret < 0 || sim.state_collapse_to[ret] != dstate {
            return;
        }
        let caller_mp = atn_invocation_prec(sim, &atn.stack, k - 1);
        atn.read_down_to(k - 1);
        if atn_caller_alone_enters(sim, dstate, t, eof, caller_mp, mp) {
            return;
        }
        atn.record_verdict(decision, pos, caller_mp, k, exit_alt, 0);
        mp = caller_mp;
    }
}

fn atn_caller_alone_enters(sim: &AtnSim, dstate: i32, t: i32, eof: i32, caller_mp: i32, mp: i32) -> bool {
    let s = sim.state_tr_start[dstate];
    for let mut j = s; j < s + sim.state_tr_count[dstate]; j += 1 {
        if sim.tr_kind[j] == ATN_TR_PRECEDENCE
            && sim.tr_prec[j] >= caller_mp
            && sim.tr_prec[j] < mp
            && atn_state_cont_admits(sim, sim.tr_target[j], t, eof) {
            return true;
        }
    }
    return false;
}

fn atn_caller_contests(sim: &AtnSim, atn: &mut AtnPredictor, dstate: i32, t: i32, eof: i32, min_prec: i32) -> bool {
    let [contests, lowest_read] = atn_callers_contest(sim, &atn.stack, dstate, t, eof, min_prec);
    atn.read_down_to(lowest_read);
    return contests;
}

fn atn_callers_contest(
    sim: &AtnSim,
    rule_stack: &List<i32>,
    dstate: i32,
    t: i32,
    eof: i32,
    min_prec: i32,
) -> [bool, i32] {
    let mut mp = min_prec;
    let mut same_loop = true;
    let mut i = rule_stack.len() - 1;
    while i >= 0 {
        let ret = rule_stack[i];
        if ret < 0 {
            return [i == 0 && t == eof, i];
        }
        same_loop = same_loop && i >= 1 && sim.state_collapse_to[ret] == dstate;
        if same_loop {
            let caller_mp = atn_invocation_prec(sim, rule_stack, i - 1);
            if atn_caller_alone_enters(sim, dstate, t, eof, caller_mp, mp) {
                return [true, i - 1];
            }
            mp = caller_mp;
        } else if atn_state_cont_admits(sim, ret, t, eof) {
            return [true, i];
        }
        if !sim.state_cont_nullable[ret] {
            return [false, i];
        }
        i -= 1;
    }
    return [false, 0];
}
pub global TK_ID: i32 = 0;
pub global TK_INT: i32 = 1;
pub global TK_WS: i32 = 2;
pub global TK_EOF: i32 = 3;
pub global TK_ERROR: i32 = 4;
pub global TK_LIT_EQ: i32 = 5;
pub global TK_LIT_PLUS: i32 = 6;

struct Lexer {
    src: StrSlice,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { src: input.as_str_slice(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.src.len();
    }
}

fn try_ID(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() { return -1; }
    if !(unchecked src.byte_at(pos) matches { b'a'..=b'z' }) { return -1; }
    pos += 1;
    loop {
        rep_0: {
            if pos >= src.len() { break rep_0; }
            if !(unchecked src.byte_at(pos) matches { b'a'..=b'z' }) { break rep_0; }
            pos += 1;
            continue;
        }
        break;
    }
    return pos;
}

fn try_INT(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() { return -1; }
    if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' }) { return -1; }
    pos += 1;
    loop {
        rep_0: {
            if pos >= src.len() { break rep_0; }
            if !(unchecked src.byte_at(pos) matches { b'0'..=b'9' }) { break rep_0; }
            pos += 1;
            continue;
        }
        break;
    }
    return pos;
}

fn try_WS(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() { return -1; }
    if !(unchecked src.byte_at(pos) matches { b'\x0a' | b' ' }) { return -1; }
    pos += 1;
    return pos;
}

fn try_lit_EQ(src: &StrSlice, start: i32) -> i32 {
    if start + 1 > src.len() || unchecked src.byte_at(start) != b'=' { return -1; }
    return start + 1;
}

fn try_lit_PLUS(src: &StrSlice, start: i32) -> i32 {
    if start + 1 > src.len() || unchecked src.byte_at(start) != b'+' { return -1; }
    return start + 1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(lexer.src);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = char_at(&lexer.src, start);
        match first_char {
            '\n' | ' ' => {
                end = try_WS(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_WS; }
            },
            '+' => {
                end = try_lit_PLUS(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PLUS; }
            },
            '0'..='9' => {
                end = try_INT(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_INT; }
            },
            '=' => {
                end = try_lit_EQ(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_EQ; }
            },
            'a'..='z' => {
                end = try_ID(&lexer.src, start);
                if end > best_end { best_end = end; best_kind = TK_ID; }
            },
            _ => {},
        }
        if best_end <= start {
            let error_end = lexer.src.ceil_char_boundary(start + 1);
            let _ = ts.push_token_flagged(TK_ERROR, start, error_end, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = error_end;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { == TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        == TK_ID => "ID",
        == TK_INT => "INT",
        == TK_WS => "WS",
        == TK_EOF => "Eof",
        == TK_ERROR => "Error",
        == TK_LIT_EQ => "'='",
        == TK_LIT_PLUS => "'+'",
        _ => "Unknown",
    };
}

pub global RK_S: NodeKind = 0;
pub global RK_E: NodeKind = 1;

global RULE_NAMES: List<String> = ["s", "e"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        f.write_str(node_name(&RULE_NAMES, *self));
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    site: i32,
    sites: List<i32>,
    failed_expected: List<i32>,
    recovery_pos: i32,
    recovered_failures: List<[NodeKind, List<i32>]>,
    atn: AtnPredictor,
    atn_ret_pending: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    line_starts: List<i32>,
    memo: ScanMemo<()>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(TOKEN_NAMES[*k]);
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, site: -1, sites: [], failed_expected: [], recovery_pos: -1, recovered_failures: [], atn: AtnPredictor::new(), atn_ret_pending: -1, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], line_starts: line_starts(&tokens.src), memo: ScanMemo::new(kinds.len()) };
    }

    fn emit(&mut self, s: String) {
        self.tokens.output.push_str(&s);
    }

    fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.src.byte_at(j) == b'-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.src.byte_at(j);
            if c.is_ascii_digit() {
                acc = acc * 10 + (c - b'0') as i32;
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    fn token_line(&self, i: i32) -> i32 {
        return line_at(&self.line_starts, self.tokens.start_at(i));
    }

    fn token_col(&self, i: i32) -> i32 {
        return line_col_at(&self.tokens.src, &self.line_starts, self.tokens.start_at(i)).1;
    }

    fn token_start(&self, i: i32) -> i32 {
        return self.tokens.start_at(i);
    }

    fn lt(&self, k: i32) -> i32 {
        let idx = if k > 0 { self.pos + k - 1 } else { self.pos + k };
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    fn la(&self, k: i32) -> i32 {
        return self.kinds[self.lt(k)];
    }

    fn text_span(&self, start: i32, end: i32) -> String {
        return span_text(&self.tokens.src, start, end);
    }

    fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.src.len());
    }

    fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }

    fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }

    fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &TOKEN_NAMES);
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.peek_kind(), RecoveryAction::None));
        }
        self.enter_recovery(expected);
    }

    fn enter_recovery(&mut self, expected: &List<i32>) {
        self.recovering = true;
        if !self.speculating { self.failed_expected = *expected; }
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.peek_start()) {
            self.fail(`${what} "${self.peek_text()}"`, self.peek_span(), expected, code);
            return;
        }
        self.enter_recovery(expected);
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.speculating && !self.supersedes_pending(self.peek_start()) {
            self.recovering = true;
            return;
        }
        self.fail_expecting(&([kind] as List<i32>));
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn recover_rule(&mut self, rule: NodeKind, name: String, row: i32) -> bool {
        if self.speculating || self.diagnostics.len() >= self.max_errors {
            self.push_rule_stack(name);
            return false;
        }
        let node = if row < 0 { self.b.innermost_open() } else { row };
        self.b.resume_node(node, self.last_end());
        assert self.b.node_kind(node) == rule, "recover_rule: the resumed node is the failed rule's";
        if !self.b.in_error_mode() { self.recovered_failures.clear(); }
        self.commit_pending();
        self.recovering = false;
        let failure = [rule, self.failed_expected];
        if self.pos == self.recovery_pos && self.recovered_failures.contains(&failure) && !self.at_eof() {
            self.skip_one();
        }
        self.recovery_pos = self.pos;
        self.recovered_failures.push(failure);
        self.skip_until(&self.resync_set(&EMPTY_SYNC));
        return true;
    }

    fn commit_pending(&mut self) {
        let Some(d) = self.pending else { return; };
        self.pending = null;
        let mut diag = d;
        self.b.push_open_rule_names(&RULE_NAMES, &mut diag.rule_stack);
        self.report(diag);
    }

    fn report(&mut self, diag: Diagnostic) {
        if self.b.in_error_mode() { return; }
        self.diagnostics.push(diag);
        self.b.mark_error();
    }

    fn resync_set(&self, base: &KindSet) -> KindSet {
        let mut set = *base;
        for let s of &self.sites {
            if *s >= 0 { set.union_with(&CALL_FOLLOW_SETS[CALL_FOLLOW[*s]]); }
        }
        return set;
    }

    fn follows_rules_under_way(&self, k: i32) -> bool {
        for let mut i = self.sites.len() - 1; i >= 0; i -= 1 {
            let s = self.sites[i];
            if s < 0 { return i == 0 && k == TK_EOF; }
            if CALL_FOLLOW_SETS[CALL_FOLLOW[s]].has(k) { return true; }
            if !CALL_FOLLOW_ENDS[s] { return false; }
        }
        return k == TK_EOF;
    }

    fn skip_until(&mut self, set: &KindSet) {
        while !self.at_eof() && !set.has(self.peek_kind()) {
            self.skip_one();
        }
    }

    fn skip_one(&mut self) {
        let _sk = self.advance();
        self.tokens.mark_skipped(_sk);
        self.b.skip(_sk);
    }

    fn sync_delete(&mut self, sync: &KindSet, expected: &List<i32>) -> bool {
        if self.speculating || self.at_eof() || !sync.has(self.peek_at(1)) {
            return false;
        }
        self.report_extraneous(expected, RecoveryAction::Deleted);
        self.skip_one();
        return true;
    }

    fn sync_enter(&mut self, sync: &KindSet, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.fail_expecting(expected);
        }
    }

    fn sync_alts(&mut self, sync: &KindSet, expected: &List<i32>) {
        if !self.recovering && !self.sync_delete(sync, expected) {
            self.no_viable("no viable alternative", self.peek_span(), expected);
        }
    }

    fn sync_back(&mut self, sync: &KindSet, expected: &List<i32>) {
        if self.recovering || self.at_eof() { return; }
        if self.speculating {
            self.fail_expecting(expected);
            return;
        }
        self.report_extraneous(expected, RecoveryAction::SkippedTo);
        self.skip_until(&self.resync_set(sync));
    }

    fn fail_expecting(&mut self, expected: &List<i32>) {
        let code = if self.at_eof() { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
        self.fail_on_token("got", expected, code);
    }

    fn report_extraneous(&mut self, expected: &List<i32>, recovery: RecoveryAction) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.peek_text()}"`, self.peek_span(), *expected, self.peek_kind(), recovery));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let at_eof = self.at_eof();
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.report(Diagnostic::error(code, `missing ${TOKEN_NAMES[kind]}`, self.peek_span(), [kind], self.peek_kind(), recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.report(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.peek_text()}"`, self.peek_span(), [kind], self.peek_kind(), RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.start_at(self.pos);
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_text(&self) -> String {
        return self.tokens.token_text(self.pos);
    }

    fn at_eof(&self) -> bool {
        return self.peek_kind() == TK_EOF;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.end_at(self.pos - 1);
    }

    fn enter_rule(&mut self) -> bool {
        let ret = self.atn_ret_pending;
        self.atn_ret_pending = -1;
        if self.recovering { return false; }
        self.atn.stack.push(ret);
        self.sites.push(self.site);
        return true;
    }

    fn leave_rule(&mut self) {
        self.atn.stack.pop();
        self.sites.pop();
    }

    fn open_rule(&mut self, kind: NodeKind) -> bool {
        if !self.enter_rule() { return false; }
        self.b.start_node(kind, self.peek_start());
        return true;
    }

    fn close_rule(&mut self, kind: NodeKind, name: String) {
        if self.recovering { let _ = self.recover_rule(kind, name, -1); }
        self.b.finish_node(self.last_end());
        self.leave_rule();
    }

    fn close_lr_rule(&mut self, kind: NodeKind, name: String, row: i32) {
        if self.recovering && self.recover_rule(kind, name, row) { self.b.finish_node(self.last_end()); }
        self.leave_rule();
    }

    fn consume(&mut self) -> i32 {
        let i = self.pos;
        if !self.at_eof() { self.pos += 1; }
        self.b.token(i);
        return i;
    }

    fn insert_missing(&mut self, kind: i32) -> i32 {
        let i = self.tokens.push_synthetic(kind, self.peek_start());
        self.b.missing(i);
        return i;
    }

    fn expect(&mut self, kind: i32, sync: &KindSet, may_end_rule: bool) -> i32 {
        if self.recovering { return self.pos; }
        if self.peek_kind() == kind { return self.consume(); }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extraneous(&[kind], RecoveryAction::Deleted);
            self.skip_one();
            return self.consume();
        }
        if sync.has(self.peek_kind()) || may_end_rule && self.follows_rules_under_way(self.peek_kind()) {
            self.report_missing(kind);
            return self.insert_missing(kind);
        }
        if !sync.is_empty() {
            if !may_end_rule && self.at_eof() {
                self.fail_on_kind(kind);
                return self.pos;
            }
            self.report_unexpected(kind);
            if !self.at_eof() {
                self.b.start_error(self.peek_start());
                while !self.at_eof() && self.peek_kind() != kind && !sync.has(self.peek_kind()) {
                    self.skip_one();
                }
                self.b.finish_node(self.last_end());
            }
            if self.peek_kind() == kind { return self.consume(); }
            return self.insert_missing(kind);
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        return self.consume();
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if !self.at_eof() { return self.consume(); }
        self.fail_on_token("expected any token; got", &NO_EXPECTED, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &KindSet) -> i32 {
        if self.recovering { return self.pos; }
        if !self.at_eof() && !excluded.has(self.peek_kind()) { return self.consume(); }
        self.fail_on_token("unexpected token", &NO_EXPECTED, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &KindSet, expected: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if included.has(self.peek_kind()) { return self.consume(); }
        self.fail_on_token("got", expected, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

struct EVals {
    result: String = "",
}

fn scan_e_atom(tokens: &Array<i32>, pos: i32, atn: &mut AtnPredictor, memo: &mut ScanMemo<()>, min_prec: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    if kind == TK_ID {
        let _atn_alt = atn_decide_0(atn, tokens, pos, min_prec);
        if _atn_alt < 0 {
            return -1;
        }
        if _atn_alt == 0 {
            return scan_e__alt_0(tokens, start, atn, memo, min_prec);
        }
        return scan_e__alt_1(tokens, start, atn, memo, min_prec);
    }
    return -1;
}

fn scan_e_lr_2(tokens: &Array<i32>, pos: i32, atn: &mut AtnPredictor, memo: &mut ScanMemo<()>, min_prec: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_PLUS { return -1; }
    pos += 1;
    atn.stack.push(30);
    pos = scan_e(tokens, pos, atn, memo, 2);
    atn.stack.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn scan_e(tokens: &Array<i32>, pos: i32, atn: &mut AtnPredictor, memo: &mut ScanMemo<()>, min_prec: i32 = 0) -> i32 {
    let memo_at = memo.find(1, pos, min_prec, 0, 0, &());
    if memo_at >= 0 {
        return memo.end_of(memo_at);
    }
    let memo_gate = ();
    let memo_callers = atn.hide_callers();
    let memo_end = scan_e__walk(tokens, pos, atn, memo, min_prec);
    if !atn.reveal_callers(memo_callers) { memo.put(1, pos, min_prec, 0, 0, memo_gate, memo_end, ()); }
    return memo_end;
}

fn scan_e__walk(tokens: &Array<i32>, pos: i32, atn: &mut AtnPredictor, memo: &mut ScanMemo<()>, min_prec: i32 = 0) -> i32 {
    let mut pos = scan_e_atom(tokens, pos, atn, memo, min_prec);
    if pos < 0 { return -1; }
    loop {
        let _atn_alt = atn_lr_decide_1(atn, tokens, pos, min_prec);
        if _atn_alt == 0 {
            pos = scan_e_lr_2(tokens, pos, atn, memo, min_prec);
            if pos < 0 { return -1; }
        } else {
            break;
        }
    }
    return pos;
}

fn _parse_s__inner(p: &mut Parser) {
    p.site = 0;
    p.atn_ret_pending = 7;
    let e = _parse_e(p);
    if !p.speculating {
        p.emit(`${e.result}\n`);
    }
    return;
}

fn _parse_s(p: &mut Parser) {
    if !p.open_rule(RK_S) { return; }
    _parse_s__inner(p);
    p.close_rule(RK_S, "s");
}

fn _parse_e__inner_alt_0(p: &mut Parser, min_prec: i32, vals: EVals = EVals {}) -> EVals {
    let mut vals = vals;
    let id = p.expect(TK_ID, &SYNC_0, false);
    p.expect(TK_LIT_EQ, &SYNC_1, false);
    p.site = 1;
    p.atn_ret_pending = 17;
    let e1 = _parse_e(p, 2);
    if !p.speculating {
        vals.result = `(${p.token_text(id)}=${e1.result})`;
    }
    return vals;
}

fn scan_e__alt_0(tokens: &Array<i32>, pos: i32, atn: &mut AtnPredictor, memo: &mut ScanMemo<()>, min_prec: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_EQ { return -1; }
    pos += 1;
    atn.stack.push(17);
    pos = scan_e(tokens, pos, atn, memo, 2);
    atn.stack.pop();
    if pos < 0 { return -1; }
    return pos;
}

fn _parse_e__inner_alt_1(p: &mut Parser, min_prec: i32, vals: EVals = EVals {}) -> EVals {
    let mut vals = vals;
    let id = p.expect(TK_ID, &SYNC_2, true);
    if !p.speculating {
        vals.result = p.token_text(id);
    }
    return vals;
}

fn scan_e__alt_1(tokens: &Array<i32>, pos: i32, atn: &mut AtnPredictor, memo: &mut ScanMemo<()>, min_prec: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn _parse_e__inner_atom(p: &mut Parser, vals: EVals = EVals {}, min_prec: i32 = 0) -> EVals {
    let mut vals = vals;
    if !SYNC_1.has(p.peek_kind()) { builtin::cold_path(); p.sync_alts(&SYNC_1, &EXPECTED_1); }
    let kind = p.peek_kind();
    if kind == TK_ID {
        let _atn_alt = atn_decide_0(&mut p.atn, &p.kinds, p.pos, min_prec);
        if _atn_alt < 0 {
            p.no_viable("no viable alternative", p.peek_span(), &NO_EXPECTED);
            return vals;
        }
        if _atn_alt == 0 {
            return _parse_e__inner_alt_0(p, min_prec, vals);
        }
        return _parse_e__inner_alt_1(p, min_prec, vals);
    }
    p.no_viable(
        "no alternative of e matches",
        p.peek_span(),
        &EXPECTED_1,
    );
    return vals;
}

fn _parse_e__inner(p: &mut Parser, min_prec: i32 = 0) -> EVals {
    let _cp = p.b.checkpoint();
    let _start = p.peek_start();
    p.b.start_node(RK_E, _start);
    let vals = EVals {};
    let mut _lr_acc = _parse_e__inner_atom(p, vals, min_prec);
    p.b.finish_node(p.last_end());
    loop {
        if p.recovering { break; }
        let _atn_alt = atn_lr_decide_1(&mut p.atn, &p.kinds, p.pos, min_prec);
        let _lr_pos0 = p.pos;
        if _atn_alt == 0 {
            p.b.start_node_at(_cp, RK_E, _start);
            let e1 = _lr_acc;
            let mut vals = EVals {};
            p.take();
            p.site = 3;
            p.atn_ret_pending = 30;
            let e2 = _parse_e(p, 2);
            if !p.speculating {
                vals.result = `(${e1.result}+${e2.result})`;
            }
            p.b.finish_node(p.last_end());
            _lr_acc = vals;
        } else {
            break;
        }
        if p.pos == _lr_pos0 {
            break;
        }
    }
    return _lr_acc;
}

fn _parse_e(p: &mut Parser, min_prec: i32 = 0) -> EVals {
    if !p.enter_rule() { return EVals {}; }
    let _row = p.b.checkpoint();
    let __vals = _parse_e__inner(p, min_prec);
    p.close_lr_rule(RK_E, "e", _row);
    return __vals;
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, &p.tokens.src);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.tokens.output };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_s(input, max_errors);
}

pub fn parse_s<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_s(p));
}

pub fn parse_e<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| { let _ = _parse_e(p); });
}

global CALL_FOLLOW_SETS: List<KindSet> = [[], [64]];
global CALL_FOLLOW: List<i32> = [0, 1, 0, 1];
global CALL_FOLLOW_ENDS: List<bool> = [true, true, false, true];

global TOKEN_NAMES: List<String> = ["ID", "INT", "WS", "Eof", "Error", "'='", "'+'"];

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let Some(kind) = RULE_NAMES.position(|name| rule == name) else { return ""; };
    let sub = result.cst.find_child(0, kind as NodeKind);
    if sub < 0 { return ""; }
    return result.cst.to_string_tree(sub, &result.tokens, &RULE_NAMES, &TOKEN_NAMES);
}

