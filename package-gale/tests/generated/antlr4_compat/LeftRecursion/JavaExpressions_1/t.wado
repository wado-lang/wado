    }
    if kind == TK_LIT_NEW {
        let lit_new = p.expect(TK_LIT_NEW)?;
        let typespec = parse_typespec(p)?;
        let mut group_0_inner: Option<EGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_LIT_LPAREN {
            let lparen = p.expect(TK_LIT_LPAREN)?;
            let expression_list: Option<ExpressionListNode> = if _gale_kind_set_1(p.peek_kind()) {
                let expression_list = parse_expression_list(p)?;
                Option::<ExpressionListNode>::Some(expression_list)
            } else {
                null
            };
            let rparen = p.expect(TK_LIT_RPAREN)?;
            group_0_inner = Option::<EGroup0>::Some(EGroup0::Alt0(EGroup0Alt0 {
                lparen,
                expression_list,
                rparen,
            }));
        } else if grp_kind == TK_LIT_LBRACKET {
            let mut lbracket_e_rbracket_list: Array<LbracketERbracketItem> = [];
            let mut _plus_first = true;
            loop {
                if !_plus_first {
                    let mut rep_scan_pos: i32 = -1;
                    rep_scan: {
                        let tokens = &p.tokens;
                        let mut pos: i32 = p.pos;
                        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { break rep_scan; }
                        pos += 1;
                        pos = scan_e(tokens, pos);
                        if pos < 0 { break rep_scan; }
                        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { break rep_scan; }
                        pos += 1;
                        if pos <= p.pos { break rep_scan; }
                        rep_scan_pos = pos;
                    }
                    if rep_scan_pos < 0 { break; }
                }
                _plus_first = false;
                let lbracket = p.expect(TK_LIT_LBRACKET)?;
                let e = parse_e(p)?;
                let rbracket = p.expect(TK_LIT_RBRACKET)?;
                let lbracket_e_rbracket = LbracketERbracketItem {
                    lbracket,
                    e,
                    rbracket,
                };
                lbracket_e_rbracket_list.push(lbracket_e_rbracket);
            }
            group_0_inner = Option::<EGroup0>::Some(EGroup0::Alt1(EGroup0Alt1 {
                lbracket_e_rbracket_list,
            }));
        }
        let group_0 = group_0_inner;
        return Result::<ENode, ParseError>::Ok(ENode::Alt10(EAlt10 {
            span: Span::new(start, p.last_end()),
            lit_new,
            typespec,
            group_0,
        }));
    }
    if _gale_kind_set_2(kind) {
        let plus_or_minus_or_lit_plusplus_or_lit_minusminus = p.advance();
        let e = parse_e(p, 14)?;
        return Result::<ENode, ParseError>::Ok(ENode::Alt15(EAlt15 {
            span: Span::new(start, p.last_end()),
            plus_or_minus_or_lit_plusplus_or_lit_minusminus,
            e,
        }));
    }
    if _gale_kind_set_3(kind) {
        let tilde_or_bang = p.advance();
        let e = parse_e(p, 14)?;
        return Result::<ENode, ParseError>::Ok(ENode::Alt16(EAlt16 {
            span: Span::new(start, p.last_end()),
            tilde_or_bang,
            e,
        }));
    }
    return Result::<ENode, ParseError>::Err(ParseError::new(
        "expected e",
        p.peek().span,
        ["TK_LIT_LPAREN", "TK_LIT_THIS", "TK_LIT_SUPER", "TK_INT", "TK_ID", "TK_LIT_INT", "TK_LIT_NEW", "TK_LIT_PLUS", "TK_LIT_MINUS", "TK_LIT_PLUSPLUS", "TK_LIT_MINUSMINUS", "TK_LIT_TILDE", "TK_LIT_BANG"],
    ));
}

