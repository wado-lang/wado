        e_2,
    }));
}

fn parse_e(p: &mut Parser, min_prec: i32 = 0) -> Result<ENode, ParseError> {
    let start = p.peek().span.start;
    let mut result = parse_e_atom(p)?;
    loop {
        let suffix_kind = p.peek_kind();
        if suffix_kind == TK_LIT_DOT {
            if suffix_kind == TK_LIT_DOT {
                if p.peek_at(1) == TK_ID {
                    if 20 >= min_prec {
                        result = parse_e_lr_6(p, result, start)?;
                    } else {
                        break;
                    }
                } else if p.peek_at(1) == TK_LIT_THIS {
                    if 19 >= min_prec {
                        result = parse_e_lr_7(p, result, start)?;
                    } else {
                        break;
                    }
                } else if p.peek_at(1) == TK_LIT_SUPER {
                    if 18 >= min_prec {
                        result = parse_e_lr_8(p, result, start)?;
                    } else {
                        break;
                    }
                } else {
                    if 17 >= min_prec {
                        result = parse_e_lr_9(p, result, start)?;
                    } else {
                        break;
                    }
                }
            }
        } else if suffix_kind == TK_LIT_LBRACKET {
            if 16 >= min_prec {
                result = parse_e_lr_11(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_4(suffix_kind) {
            if 15 >= min_prec {
                result = parse_e_lr_13(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_LPAREN {
            if 14 >= min_prec {
                result = parse_e_lr_14(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_5(suffix_kind) {
            if 13 >= min_prec {
                result = parse_e_lr_17(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_6(suffix_kind) {
            if 12 >= min_prec {
                result = parse_e_lr_18(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_7(suffix_kind) {
            if 11 >= min_prec {
                result = parse_e_lr_19(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_8(suffix_kind) {
            if 10 >= min_prec {
                result = parse_e_lr_20(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_INSTANCEOF {
            if 9 >= min_prec {
                result = parse_e_lr_21(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_9(suffix_kind) {
            if 8 >= min_prec {
                result = parse_e_lr_22(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_AMP {
            if 7 >= min_prec {
                result = parse_e_lr_23(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_CARET {
            if 6 >= min_prec {
                result = parse_e_lr_24(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_PIPE {
            if 5 >= min_prec {
                result = parse_e_lr_25(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_AMPAMP {
            if 4 >= min_prec {
                result = parse_e_lr_26(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_PIPEPIPE {
            if 3 >= min_prec {
                result = parse_e_lr_27(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_LIT_QUESTION {
            if 2 >= min_prec {
                result = parse_e_lr_28(p, result, start)?;
            } else {
                break;
            }
        } else if _gale_kind_set_10(suffix_kind) {
            if 1 >= min_prec {
                result = parse_e_lr_29(p, result, start)?;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return Result::<ENode, ParseError>::Ok(result);
}

fn parse_typespec_bt_1(p: &mut Parser) -> Result<TypespecNode, ParseError> {
    let start = p.peek().span.start;
    let id = p.expect(TK_ID)?;
    let lbracket = p.expect(TK_LIT_LBRACKET)?;
    let rbracket = p.expect(TK_LIT_RBRACKET)?;
    return Result::<TypespecNode, ParseError>::Ok(TypespecNode::Alt1(TypespecAlt1 {
        span: Span::new(start, p.last_end()),
        id,
        lbracket,
        rbracket,
    }));
}

fn parse_typespec_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn parse_typespec_bt_0(p: &mut Parser) -> Result<TypespecNode, ParseError> {
    let start = p.peek().span.start;
    let id = p.expect(TK_ID)?;
    return Result::<TypespecNode, ParseError>::Ok(TypespecNode::Alt0(TypespecAlt0 {
        span: Span::new(start, p.last_end()),
        id,
    }));
}

fn parse_typespec_scan_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn parse_typespec_bt_3(p: &mut Parser) -> Result<TypespecNode, ParseError> {
    let start = p.peek().span.start;
    let lit_int = p.expect(TK_LIT_INT)?;
    let lbracket = p.expect(TK_LIT_LBRACKET)?;
    let rbracket = p.expect(TK_LIT_RBRACKET)?;
    return Result::<TypespecNode, ParseError>::Ok(TypespecNode::Alt3(TypespecAlt3 {
        span: Span::new(start, p.last_end()),
        lit_int,
        lbracket,
        rbracket,
    }));
}

fn parse_typespec_scan_3(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_INT { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn parse_typespec_bt_2(p: &mut Parser) -> Result<TypespecNode, ParseError> {
    let start = p.peek().span.start;
    let lit_int = p.expect(TK_LIT_INT)?;
    return Result::<TypespecNode, ParseError>::Ok(TypespecNode::Alt2(TypespecAlt2 {
        span: Span::new(start, p.last_end()),
        lit_int,
    }));
}

fn parse_typespec_scan_2(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_INT { return -1; }
    pos += 1;
    return pos;
}

fn parse_typespec(p: &mut Parser) -> Result<TypespecNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_ID {
        let id = p.expect(TK_ID)?;
        if p.peek_kind() == TK_LIT_LBRACKET {
            let lbracket = p.expect(TK_LIT_LBRACKET)?;
            let rbracket = p.expect(TK_LIT_RBRACKET)?;
            return Result::<TypespecNode, ParseError>::Ok(TypespecNode::Alt1(TypespecAlt1 {
                span: Span::new(start, p.last_end()),
                id,
                lbracket,
                rbracket,
            }));
        }
    }
    if kind == TK_LIT_INT {
        if p.peek_kind() == TK_LIT_LBRACKET {
            return parse_typespec_bt_3(p);
        }
    }
    return Result::<TypespecNode, ParseError>::Err(ParseError::new(
        "expected typespec",
        p.peek().span,
        ["TK_ID", "TK_LIT_INT"],
    ));
}

pub fn parse(input: &String) -> Result<SNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_s(&mut parser);
}

pub fn walk_s<V: Visitor>(v: &mut V, node: &SNode) {
    v.enter_rule(&"s", &node.span);
    walk_e(v, &node.e);
    v.visit_token(&node.eof);
    v.exit_rule(&"s", &node.span);
}

pub fn walk_expressionList<V: Visitor>(v: &mut V, node: &ExpressionListNode) {
    v.enter_rule(&"expressionList", &node.span);
    walk_e(v, &node.e);
    for let item of &node.comma_e_list {
        v.visit_token(&item.comma);
        walk_e(v, &item.e);
    }
    v.exit_rule(&"expressionList", &node.span);
}

pub fn walk_e<V: Visitor>(v: &mut V, node: &ENode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.lparen);
            walk_e(v, &n.e);
            v.visit_token(&n.rparen);
            v.exit_rule(&"e", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.lit_this);
            v.exit_rule(&"e", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.lit_super);
            v.exit_rule(&"e", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.int);
            v.exit_rule(&"e", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(&"e", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"e", &n.span);
            walk_typespec(v, &n.typespec);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_class);
            v.exit_rule(&"e", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.id);
            v.exit_rule(&"e", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_this);
            v.exit_rule(&"e", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_super);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(&"e", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_new);
            v.visit_token(&n.id);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(&"e", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.lit_new);
            walk_typespec(v, &n.typespec);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.lparen);
                        if let Some(item) = &inner.expression_list {
                            walk_expressionList(v, item);
                        }
                        v.visit_token(&inner.rparen);
                    }
                    Alt1(inner) => {
                        for let item of &inner.lbracket_e_rbracket_list {
                            v.visit_token(&item.lbracket);
                            walk_e(v, &item.e);
                            v.visit_token(&item.rbracket);
                        }
                    }
                }
            }
            v.exit_rule(&"e", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lbracket);
            walk_e(v, &n.e_2);
            v.visit_token(&n.rbracket);
            v.exit_rule(&"e", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.lparen);
            walk_typespec(v, &n.typespec);
            v.visit_token(&n.rparen);
            walk_e(v, &n.e);
            v.exit_rule(&"e", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_plusplus_or_lit_minusminus);
            v.exit_rule(&"e", &n.span);
        }
        Alt14(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(&"e", &n.span);
        }
        Alt15(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.plus_or_minus_or_lit_plusplus_or_lit_minusminus);
            walk_e(v, &n.e);
            v.exit_rule(&"e", &n.span);
        }
        Alt16(n) => {
            v.enter_rule(&"e", &n.span);
            v.visit_token(&n.tilde_or_bang);
            walk_e(v, &n.e);
            v.exit_rule(&"e", &n.span);
        }
        Alt17(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.star_or_slash_or_percent);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt18(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.plus_or_minus);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt19(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_ltlt_or_lit_gtgtgt_or_lit_gtgt);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt20(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_lteq_or_lit_gteq_or_gt_or_lt);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt21(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_instanceof);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt22(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_eqeq_or_lit_bangeq);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt23(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.amp);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt24(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.caret);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt25(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.pipe);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt26(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_ampamp);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt27(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_pipepipe);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
        Alt28(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.question);
            walk_e(v, &n.e_2);
            v.visit_token(&n.colon);
            walk_e(v, &n.e_3);
            v.exit_rule(&"e", &n.span);
        }
        Alt29(n) => {
            v.enter_rule(&"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.eq_or_lit_pluseq_or_lit_minuseq_or_lit_stareq_or_lit_slasheq_or_lit_ampeq_or_lit_pipeeq_or_lit_careteq_or_lit_gtgteq_or_lit_gtgtgteq_or_lit_ltlteq_or_lit_percenteq);
            walk_e(v, &n.e_2);
            v.exit_rule(&"e", &n.span);
        }
    }
}

pub fn walk_typespec<V: Visitor>(v: &mut V, node: &TypespecNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"typespec", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(&"typespec", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"typespec", &n.span);
            v.visit_token(&n.id);
            v.visit_token(&n.lbracket);
            v.visit_token(&n.rbracket);
            v.exit_rule(&"typespec", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"typespec", &n.span);
            v.visit_token(&n.lit_int);
            v.exit_rule(&"typespec", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"typespec", &n.span);
            v.visit_token(&n.lit_int);
            v.visit_token(&n.lbracket);
            v.visit_token(&n.rbracket);
            v.exit_rule(&"typespec", &n.span);
        }
    }
}

pub fn to_tree(node: &SNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_s(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_LBRACKET | TK_LIT_LPAREN };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_ID | TK_INT | TK_LIT_BANG | TK_LIT_INT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_NEW | TK_LIT_PLUS | TK_LIT_PLUSPLUS | TK_LIT_SUPER | TK_LIT_THIS | TK_LIT_TILDE };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_PLUSPLUS };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_LIT_BANG | TK_LIT_TILDE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_LIT_MINUSMINUS | TK_LIT_PLUSPLUS };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_LIT_PERCENT | TK_LIT_SLASH | TK_LIT_STAR };
}

fn _gale_kind_set_6(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_PLUS };
}

fn _gale_kind_set_7(k: i32) -> bool {
    return k matches { TK_LIT_GTGT | TK_LIT_GTGTGT | TK_LIT_LTLT };
}

fn _gale_kind_set_8(k: i32) -> bool {
    return k matches { TK_LIT_GT | TK_LIT_GTEQ | TK_LIT_LT | TK_LIT_LTEQ };
}

fn _gale_kind_set_9(k: i32) -> bool {
    return k matches { TK_LIT_BANGEQ | TK_LIT_EQEQ };
}

fn _gale_kind_set_10(k: i32) -> bool {
    return k matches { TK_LIT_AMPEQ | TK_LIT_CARETEQ | TK_LIT_EQ | TK_LIT_GTGTEQ | TK_LIT_GTGTGTEQ | TK_LIT_LTLTEQ | TK_LIT_MINUSEQ | TK_LIT_PERCENTEQ | TK_LIT_PIPEEQ | TK_LIT_PLUSEQ | TK_LIT_SLASHEQ | TK_LIT_STAREQ };
}

fn _gale_kind_set_11(k: i32) -> bool {
    return k matches { TK_ID | TK_LIT_INT };
}

