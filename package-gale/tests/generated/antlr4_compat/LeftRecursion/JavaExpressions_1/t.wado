fn parse_e_atom(p: &mut Parser) -> Result<ENode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_LPAREN {
        let _sd_tokens = &p.tokens;
        let _sd_pos = p.pos;
        let _sd_p_12 = parse_e_scan_12(_sd_tokens, _sd_pos);
        let _sd_p_0 = parse_e_scan_0(_sd_tokens, _sd_pos);
        let mut _sd_best_i: i32 = -1;
        let mut _sd_best_p: i32 = -1;
        if _sd_p_12 > _sd_best_p {
            _sd_best_p = _sd_p_12;
            _sd_best_i = 12;
        }
        if _sd_p_0 > _sd_best_p {
            _sd_best_p = _sd_p_0;
            _sd_best_i = 0;
        }
        if _sd_best_i == 12 {
            return parse_e_bt_12(p);
        }
        if _sd_best_i == 0 {
            return parse_e_bt_0(p);
        }
        return parse_e_bt_0(p);
    }
    if kind == TK_LIT_THIS {
        let lit_this = p.expect(TK_LIT_THIS)?;
        return Result::<ENode, ParseError>::Ok(ENode::Alt1(EAlt1 {
            span: Span::new(start, p.last_end()),
            lit_this,
        }));
    }
    if kind == TK_LIT_SUPER {
        let lit_super = p.expect(TK_LIT_SUPER)?;
        return Result::<ENode, ParseError>::Ok(ENode::Alt2(EAlt2 {
            span: Span::new(start, p.last_end()),
            lit_super,
        }));
    }
    if kind == TK_INT {
        let int = p.expect(TK_INT)?;
        return Result::<ENode, ParseError>::Ok(ENode::Alt3(EAlt3 {
            span: Span::new(start, p.last_end()),
            int,
        }));
    }
    if _gale_kind_set_11(kind) {
        if p.peek_kind() == TK_ID {
            let _sd_tokens = &p.tokens;
            let _sd_pos = p.pos;
            let _sd_p_5 = parse_e_scan_5(_sd_tokens, _sd_pos);
            let _sd_p_4 = parse_e_scan_4(_sd_tokens, _sd_pos);
            let mut _sd_best_i: i32 = -1;
            let mut _sd_best_p: i32 = -1;
            if _sd_p_5 > _sd_best_p {
                _sd_best_p = _sd_p_5;
                _sd_best_i = 5;
            }
            if _sd_p_4 > _sd_best_p {
                _sd_best_p = _sd_p_4;
                _sd_best_i = 4;
            }
            if _sd_best_i == 5 {
                return parse_e_bt_5(p);
            }
            if _sd_best_i == 4 {
                return parse_e_bt_4(p);
            }
            return parse_e_bt_4(p);
        } else if p.peek_kind() == TK_LIT_INT {
            return parse_e_bt_5(p);
