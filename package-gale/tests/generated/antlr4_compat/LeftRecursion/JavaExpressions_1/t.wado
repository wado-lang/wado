fn scan_typespec(tokens: &Array<Token>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_ID {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { break try_1; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { break try_1; }
                pos += 1;
                break scan_alts;
            }
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_ID { break try_0; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_INT {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_INT { break try_3; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { break try_3; }
                pos += 1;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_RBRACKET { break try_3; }
                pos += 1;
                break scan_alts;
            }
            pos = start;
            try_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_INT { break try_2; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn parse_s(p: &mut Parser) -> Result<SNode, ParseError> {
    let start = p.peek().span.start;
    let e = parse_e(p)?;
    let eof = p.expect(TK_EOF)?;
    return Result::<SNode, ParseError>::Ok(SNode {
        span: Span::new(start, p.last_end()),
        e,
        eof,
    });
}

fn parse_expression_list(p: &mut Parser) -> Result<ExpressionListNode, ParseError> {
    let start = p.peek().span.start;
    let e = parse_e(p)?;
    let mut comma_e_list: Array<CommaEItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
            pos += 1;
            pos = scan_e(tokens, pos);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        let e = parse_e(p)?;
        let comma_e = CommaEItem {
            comma,
            e,
        };
        comma_e_list.push(comma_e);
    }
    return Result::<ExpressionListNode, ParseError>::Ok(ExpressionListNode {
        span: Span::new(start, p.last_end()),
        e,
        comma_e_list,
    });
}

fn parse_e_bt_12(p: &mut Parser) -> Result<ENode, ParseError> {
    let start = p.peek().span.start;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let typespec = parse_typespec(p)?;
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let e = parse_e(p, 16)?;
    return Result::<ENode, ParseError>::Ok(ENode::Alt12(EAlt12 {
        span: Span::new(start, p.last_end()),
        lparen,
        typespec,
        rparen,
        e,
    }));
}

fn parse_e_scan_12(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { return -1; }
