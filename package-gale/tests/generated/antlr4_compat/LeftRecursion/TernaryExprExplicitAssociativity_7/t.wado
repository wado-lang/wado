    fn exit_rule(&mut self, name: &String, span: &Span) {
        if !self.rule_stack.is_empty() {
            let last = self.rule_stack.len() - 1;
            let mut new_stack: Array<String> = [];
            for let mut i = 0; i < last; i += 1 {
                new_stack.push(self.rule_stack[i]);
