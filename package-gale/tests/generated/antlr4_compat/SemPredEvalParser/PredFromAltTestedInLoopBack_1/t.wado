        let sp = pos;
        let gp_1 = pos;
        sg_1: {
            pos = gp_1;
            sg_1_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_S { break sg_1_0; }
                pos += 1;
                break sg_1;
            }
            pos = gp_1;
            sg_1_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_X { break sg_1_1; }
                pos += 1;
                break sg_1;
            }
            pos = gp_1;
            sg_1_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_NL { break sg_1_2; }
                pos += 1;
                break sg_1;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_s(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_S { return -1; }
    pos += 1;
    return pos;
}

fn parse_file_(p: &mut Parser) -> Result<FileNode, ParseError> {
    let start = p.peek().span.start;
    let para = parse_para(p)?;
    let para_2 = parse_para(p)?;
    let eof = p.expect(TK_EOF)?;
    return Result::<FileNode, ParseError>::Ok(FileNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        para,
        para_2,
        eof,
    });
}

fn parse_para(p: &mut Parser) -> Result<ParaNode, ParseError> {
    let start = p.peek().span.start;
    let para_content = parse_para_content(p)?;
    let nl = p.expect(TK_NL)?;
    let nl_2 = p.expect(TK_NL)?;
    return Result::<ParaNode, ParseError>::Ok(ParaNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        para_content,
        nl,
        nl_2,
    });
}

fn parse_para_content(p: &mut Parser) -> Result<ParaContentNode, ParseError> {
    let start = p.peek().span.start;
    let mut lit_s_or_lit_x_or_nl_list: Array<Token> = [];
    let mut _plus_first = true;
    loop {
        if !_plus_first {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                let gp_2 = pos;
                sg_2: {
                    pos = gp_2;
                    sg_2_0: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_S { break sg_2_0; }
                        pos += 1;
                        break sg_2;
                    }
                    pos = gp_2;
                    sg_2_1: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_LIT_X { break sg_2_1; }
                        pos += 1;
                        break sg_2;
                    }
                    pos = gp_2;
                    sg_2_2: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_NL { break sg_2_2; }
                        pos += 1;
                        break sg_2;
                    }
                    break rep_scan;
                }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
        }
        _plus_first = false;
        let lit_s_or_lit_x_or_nl = p.advance();
        lit_s_or_lit_x_or_nl_list.push(lit_s_or_lit_x_or_nl);
    }
    return Result::<ParaContentNode, ParseError>::Ok(ParaContentNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lit_s_or_lit_x_or_nl_list,
    });
}

fn parse_s(p: &mut Parser) -> Result<SNode, ParseError> {
    let start = p.peek().span.start;
    let lit_s = p.expect(TK_LIT_S)?;
    return Result::<SNode, ParseError>::Ok(SNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        lit_s,
    });
}

pub fn parse(input: &String) -> Result<FileNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_file_(&mut parser);
}

pub fn walk_file_<V: Visitor>(v: &mut V, node: &FileNode) {
    v.enter_rule(&"file_", &node.span);
    walk_para(v, &node.para);
    walk_para(v, &node.para_2);
    v.visit_token(&node.eof);
    v.exit_rule(&"file_", &node.span);
}

pub fn walk_para<V: Visitor>(v: &mut V, node: &ParaNode) {
    v.enter_rule(&"para", &node.span);
    walk_paraContent(v, &node.para_content);
    v.visit_token(&node.nl);
    v.visit_token(&node.nl_2);
    v.exit_rule(&"para", &node.span);
}

pub fn walk_paraContent<V: Visitor>(v: &mut V, node: &ParaContentNode) {
    v.enter_rule(&"paraContent", &node.span);
    for let item of &node.lit_s_or_lit_x_or_nl_list {
        v.visit_token(item);
    }
    v.exit_rule(&"paraContent", &node.span);
}

pub fn walk_s<V: Visitor>(v: &mut V, node: &SNode) {
    v.enter_rule(&"s", &node.span);
    v.visit_token(&node.lit_s);
    v.exit_rule(&"s", &node.span);
}

pub fn to_tree(node: &FileNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_file_(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_S | TK_LIT_X | TK_NL };
}

