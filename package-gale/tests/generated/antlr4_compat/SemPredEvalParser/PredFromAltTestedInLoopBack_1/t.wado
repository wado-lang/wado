global TK_NL: i32 = 0;
global TK_X: i32 = 1;
global TK_EOF: i32 = 2;
global TK_ERROR: i32 = 3;
global TK_LIT_S: i32 = 4;
global TK_LIT_X: i32 = 5;

struct Lexer {
    chars: Array<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_nl(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '\n' { return -1; }
    pos += 1;
    return pos;
}

fn try_lit_s(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 's' { return -1; }
    return pos + 1;
}

fn try_lit_x(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'x' { return -1; }
    return pos + 1;
}

pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = [];
    let mut trivia: Array<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\n' {
            end = try_nl(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_NL; }
        } else if first_char == 's' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_S; }
        } else if first_char == 'x' {
            if start + 1 > best_end { best_end = start + 1; best_kind = TK_LIT_X; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = false;
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_NL => "NL",
        TK_X => "X",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_S => "TK_LIT_S",
        TK_LIT_X => "TK_LIT_X",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: Array<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }
}

fn scan_file_(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_para(tokens, pos, 0);
    if pos < 0 { return -1; }
    pos = scan_para(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_para(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_para_content(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_NL { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_NL { return -1; }
    pos += 1;
    return pos;
}

fn scan_para_content(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    let gp_0 = pos;
    sg_0: {
        pos = gp_0;
        sg_0_0: {
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_S { break sg_0_0; }
            pos += 1;
            break sg_0;
        }
        pos = gp_0;
        sg_0_1: {
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_X { break sg_0_1; }
            pos += 1;
            break sg_0;
        }
        pos = gp_0;
        sg_0_2: {
            if pos >= tokens.len() || tokens[pos].kind != TK_NL { break sg_0_2; }
            pos += 1;
            break sg_0;
        }
        return -1;
