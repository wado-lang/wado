fn parse_ident(p: &mut Parser) -> Result<IdentNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_Ident {
        let ident = p.expect(TK_Ident)?;
        return Result::<IdentNode, ParseError>::Ok(IdentNode::Alt0(IdentAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            ident,
        }));
    }
    if kind == TK_MediaOnly {
        let mediaonly = p.expect(TK_MediaOnly)?;
        return Result::<IdentNode, ParseError>::Ok(IdentNode::Alt1(IdentAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            mediaonly,
        }));
    }
    if kind == TK_Not {
        let not = p.expect(TK_Not)?;
        return Result::<IdentNode, ParseError>::Ok(IdentNode::Alt2(IdentAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            not,
        }));
    }
    if kind == TK_And {
        let and = p.expect(TK_And)?;
        return Result::<IdentNode, ParseError>::Ok(IdentNode::Alt3(IdentAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            and,
        }));
    }
    if kind == TK_Or {
        let or = p.expect(TK_Or)?;
        return Result::<IdentNode, ParseError>::Ok(IdentNode::Alt4(IdentAlt4 {
            span: Span::new(start, i32::max(start, p.last_end())),
            or,
        }));
    }
    if kind == TK_From {
        let from_ = p.expect(TK_From)?;
        return Result::<IdentNode, ParseError>::Ok(IdentNode::Alt5(IdentAlt5 {
            span: Span::new(start, i32::max(start, p.last_end())),
            from_,
        }));
    }
    if kind == TK_To {
        let to = p.expect(TK_To)?;
        return Result::<IdentNode, ParseError>::Ok(IdentNode::Alt6(IdentAlt6 {
            span: Span::new(start, i32::max(start, p.last_end())),
            to,
        }));
    }
    return Result::<IdentNode, ParseError>::Err(ParseError::new(
        "expected ident",
        p.peek().span,
        ["TK_Ident", "TK_MediaOnly", "TK_Not", "TK_And", "TK_Or", "TK_From", "TK_To"],
    ));
}

fn parse_ws(p: &mut Parser) -> Result<WsNode, ParseError> {
    let start = p.peek().span.start;
    let mut comment_or_space_list: Array<Token> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_131 = pos;
            sg_131: {
                pos = gp_131;
                sg_131_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_Comment { break sg_131_0; }
                    pos += 1;
                    break sg_131;
                }
                pos = gp_131;
                sg_131_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_Space { break sg_131_1; }
                    pos += 1;
                    break sg_131;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comment_or_space = p.advance();
        comment_or_space_list.push(comment_or_space);
    }
    return Result::<WsNode, ParseError>::Ok(WsNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        comment_or_space_list,
    });
}

fn scan_ws__follow_0(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    while pos < tokens.len() && _gale_kind_set_30(tokens[pos].kind) && !((pos + 0 < tokens.len() && tokens[pos + 0].kind == TK_Space)) {
        let sp = pos;
        let gp_132 = pos;
        sg_132: {
            pos = gp_132;
            sg_132_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_Comment { break sg_132_0; }
                pos += 1;
                break sg_132;
            }
            pos = gp_132;
            sg_132_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_Space { break sg_132_1; }
                pos += 1;
                break sg_132;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn parse_ws__follow_0(p: &mut Parser) -> Result<WsNode, ParseError> {
    let start = p.peek().span.start;
    let mut comment_or_space_list: Array<Token> = [];
    loop {
        if p.peek_kind() == TK_Space { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_133 = pos;
            sg_133: {
                pos = gp_133;
                sg_133_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_Comment { break sg_133_0; }
                    pos += 1;
                    break sg_133;
                }
                pos = gp_133;
                sg_133_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_Space { break sg_133_1; }
                    pos += 1;
                    break sg_133;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comment_or_space = p.advance();
        comment_or_space_list.push(comment_or_space);
    }
    return Result::<WsNode, ParseError>::Ok(WsNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        comment_or_space_list,
    });
}

pub fn parse(input: &String) -> Result<StylesheetNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_stylesheet(&mut parser);
}

pub fn walk_stylesheet<V: Visitor>(v: &mut V, node: &StylesheetNode) {
    v.enter_rule(0, &"stylesheet", &node.span);
    walk_ws(v, &node.ws);
    for let item of &node.charset_item_list {
        walk_charset(v, &item.charset);
        for let item of &item.comment_or_space_or_cdo_or_cdc_list {
            v.visit_token(item);
        }
    }
    for let item of &node.imports_item_list {
        walk_imports(v, &item.imports);
        for let item of &item.comment_or_space_or_cdo_or_cdc_list {
            v.visit_token(item);
        }
    }
    for let item of &node.namespace__item_list {
        walk_namespace_(v, &item.namespace_);
        for let item of &item.comment_or_space_or_cdo_or_cdc_list {
            v.visit_token(item);
        }
    }
    for let item of &node.nested_statement_item_list {
        walk_nestedStatement(v, &item.nested_statement);
        for let item of &item.comment_or_space_or_cdo_or_cdc_list {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.eof);
    v.exit_rule(0, &"stylesheet", &node.span);
}

pub fn walk_charset<V: Visitor>(v: &mut V, node: &CharsetNode) {
    match node {
        goodCharset(n) => {
            v.enter_rule(1, &"charset", &n.span);
            v.visit_token(&n.charset);
            walk_ws(v, &n.ws);
            v.visit_token(&n.string_);
            walk_ws(v, &n.ws_2);
            v.visit_token(&n.semicolon);
            walk_ws(v, &n.ws_3);
            v.exit_rule(1, &"charset", &n.span);
        }
        badCharset(n) => {
            v.enter_rule(1, &"charset", &n.span);
            v.visit_token(&n.charset);
            walk_ws(v, &n.ws);
            v.visit_token(&n.string_);
            walk_ws(v, &n.ws_2);
            v.exit_rule(1, &"charset", &n.span);
        }
    }
}

pub fn walk_imports<V: Visitor>(v: &mut V, node: &ImportsNode) {
    match node {
        goodImport0(n) => {
            v.enter_rule(2, &"imports", &n.span);
            v.visit_token(&n.import_);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.string_);
                    }
                    Alt1(inner) => {
                        walk_url(v, &inner.url);
                    }
                }
            }
            walk_ws(v, &n.ws_2);
            walk_mediaQueryList(v, &n.media_query_list);
            v.visit_token(&n.semicolon);
            walk_ws(v, &n.ws_3);
            v.exit_rule(2, &"imports", &n.span);
        }
        goodImport1(n) => {
            v.enter_rule(2, &"imports", &n.span);
            v.visit_token(&n.import_);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.group_1 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.string_);
                    }
                    Alt1(inner) => {
                        walk_url(v, &inner.url);
                    }
                }
            }
            walk_ws(v, &n.ws_2);
            v.visit_token(&n.semicolon);
            walk_ws(v, &n.ws_3);
            v.exit_rule(2, &"imports", &n.span);
        }
        badImport0(n) => {
            v.enter_rule(2, &"imports", &n.span);
            v.visit_token(&n.import_);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.group_2 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.string_);
                    }
                    Alt1(inner) => {
                        walk_url(v, &inner.url);
                    }
                }
            }
            walk_ws(v, &n.ws_2);
            walk_mediaQueryList(v, &n.media_query_list);
            v.exit_rule(2, &"imports", &n.span);
        }
        badImport1(n) => {
            v.enter_rule(2, &"imports", &n.span);
            v.visit_token(&n.import_);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.group_3 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.string_);
                    }
                    Alt1(inner) => {
                        walk_url(v, &inner.url);
                    }
                }
            }
            walk_ws(v, &n.ws_2);
            v.exit_rule(2, &"imports", &n.span);
        }
    }
}

pub fn walk_namespace_<V: Visitor>(v: &mut V, node: &NamespaceNode) {
    match node {
        goodNamespace(n) => {
            v.enter_rule(3, &"namespace_", &n.span);
            v.visit_token(&n.namespace);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.namespace_prefix_ws {
                walk_namespacePrefix(v, &item.namespace_prefix);
                walk_ws(v, &item.ws);
            }
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.string_);
                    }
                    Alt1(inner) => {
                        walk_url(v, &inner.url);
                    }
                }
            }
            walk_ws(v, &n.ws_2);
            v.visit_token(&n.semicolon);
            walk_ws(v, &n.ws_3);
            v.exit_rule(3, &"namespace_", &n.span);
        }
        badNamespace(n) => {
            v.enter_rule(3, &"namespace_", &n.span);
            v.visit_token(&n.namespace);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.namespace_prefix_ws {
                walk_namespacePrefix(v, &item.namespace_prefix);
                walk_ws(v, &item.ws);
            }
            if let Some(item) = &n.group_1 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.string_);
                    }
                    Alt1(inner) => {
                        walk_url(v, &inner.url);
                    }
                }
            }
            walk_ws(v, &n.ws_2);
            v.exit_rule(3, &"namespace_", &n.span);
        }
    }
}

pub fn walk_namespacePrefix<V: Visitor>(v: &mut V, node: &NamespacePrefixNode) {
    v.enter_rule(4, &"namespacePrefix", &node.span);
    walk_ident(v, &node.ident);
    v.exit_rule(4, &"namespacePrefix", &node.span);
}

pub fn walk_media<V: Visitor>(v: &mut V, node: &MediaNode) {
    v.enter_rule(5, &"media", &node.span);
    v.visit_token(&node.media);
    walk_ws(v, &node.ws);
    walk_mediaQueryList(v, &node.media_query_list);
    walk_groupRuleBody(v, &node.group_rule_body);
    walk_ws(v, &node.ws_2);
    v.exit_rule(5, &"media", &node.span);
}

pub fn walk_mediaQueryList<V: Visitor>(v: &mut V, node: &MediaQueryListNode) {
    v.enter_rule(6, &"mediaQueryList", &node.span);
    if let Some(item) = &node.media_query_item {
        walk_mediaQuery(v, &item.media_query);
        for let item of &item.comma_ws_media_query_list {
            v.visit_token(&item.comma);
            walk_ws(v, &item.ws);
            walk_mediaQuery(v, &item.media_query);
        }
    }
    walk_ws(v, &node.ws);
    v.exit_rule(6, &"mediaQueryList", &node.span);
}

pub fn walk_mediaQuery<V: Visitor>(v: &mut V, node: &MediaQueryNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(7, &"mediaQuery", &n.span);
            if let Some(item) = &n.mediaonly_or_not {
                v.visit_token(item);
            }
            walk_ws(v, &n.ws);
            walk_mediaType(v, &n.media_type);
            walk_ws(v, &n.ws_2);
            for let item of &n.and_ws_media_expression_list {
                v.visit_token(&item.and);
                walk_ws(v, &item.ws);
                walk_mediaExpression(v, &item.media_expression);
            }
            v.exit_rule(7, &"mediaQuery", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(7, &"mediaQuery", &n.span);
            walk_mediaExpression(v, &n.media_expression);
            for let item of &n.and_ws_media_expression_list {
                v.visit_token(&item.and);
                walk_ws(v, &item.ws);
                walk_mediaExpression(v, &item.media_expression);
            }
            v.exit_rule(7, &"mediaQuery", &n.span);
        }
    }
}

pub fn walk_mediaType<V: Visitor>(v: &mut V, node: &MediaTypeNode) {
    v.enter_rule(8, &"mediaType", &node.span);
    walk_ident(v, &node.ident);
    v.exit_rule(8, &"mediaType", &node.span);
}

pub fn walk_mediaExpression<V: Visitor>(v: &mut V, node: &MediaExpressionNode) {
    v.enter_rule(9, &"mediaExpression", &node.span);
    v.visit_token(&node.lparen);
    walk_ws(v, &node.ws);
    walk_mediaFeature(v, &node.media_feature);
    if let Some(item) = &node.colon_ws_expr {
        v.visit_token(&item.colon);
        walk_ws(v, &item.ws);
        walk_expr(v, &item.expr);
    }
    v.visit_token(&node.rparen);
    walk_ws(v, &node.ws_2);
    v.exit_rule(9, &"mediaExpression", &node.span);
}

pub fn walk_mediaFeature<V: Visitor>(v: &mut V, node: &MediaFeatureNode) {
    v.enter_rule(10, &"mediaFeature", &node.span);
    walk_ident(v, &node.ident);
    walk_ws(v, &node.ws);
    v.exit_rule(10, &"mediaFeature", &node.span);
}

pub fn walk_page<V: Visitor>(v: &mut V, node: &PageNode) {
    v.enter_rule(11, &"page", &node.span);
    v.visit_token(&node.page);
    walk_ws(v, &node.ws);
    if let Some(item) = &node.pseudo_page {
        walk_pseudoPage(v, item);
    }
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws_2);
    if let Some(item) = &node.declaration {
        walk_declaration(v, item);
    }
    for let item of &node.semicolon_ws_declaration_list {
        v.visit_token(&item.semicolon);
        walk_ws(v, &item.ws);
        if let Some(item) = &item.declaration {
            walk_declaration(v, item);
        }
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_3);
    v.exit_rule(11, &"page", &node.span);
}

pub fn walk_pseudoPage<V: Visitor>(v: &mut V, node: &PseudoPageNode) {
    v.enter_rule(12, &"pseudoPage", &node.span);
    v.visit_token(&node.colon);
    walk_ident(v, &node.ident);
    walk_ws(v, &node.ws);
    v.exit_rule(12, &"pseudoPage", &node.span);
}

pub fn walk_selectorGroup<V: Visitor>(v: &mut V, node: &SelectorGroupNode) {
    v.enter_rule(13, &"selectorGroup", &node.span);
    walk_selector(v, &node.selector);
    for let item of &node.comma_ws_selector_list {
        v.visit_token(&item.comma);
        walk_ws(v, &item.ws);
        walk_selector(v, &item.selector);
    }
    v.exit_rule(13, &"selectorGroup", &node.span);
}

pub fn walk_selector<V: Visitor>(v: &mut V, node: &SelectorNode) {
    v.enter_rule(14, &"selector", &node.span);
    walk_simpleSelectorSequence(v, &node.simple_selector_sequence);
    walk_ws(v, &node.ws);
    for let item of &node.combinator_simple_selector_sequence_ws_list {
        walk_combinator(v, &item.combinator);
        walk_simpleSelectorSequence(v, &item.simple_selector_sequence);
        walk_ws(v, &item.ws);
    }
    v.exit_rule(14, &"selector", &node.span);
}

pub fn walk_combinator<V: Visitor>(v: &mut V, node: &CombinatorNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(15, &"combinator", &n.span);
            v.visit_token(&n.plus);
            walk_ws(v, &n.ws);
            v.exit_rule(15, &"combinator", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(15, &"combinator", &n.span);
            v.visit_token(&n.greater);
            walk_ws(v, &n.ws);
            v.exit_rule(15, &"combinator", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(15, &"combinator", &n.span);
            v.visit_token(&n.tilde);
            walk_ws(v, &n.ws);
            v.exit_rule(15, &"combinator", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(15, &"combinator", &n.span);
            v.visit_token(&n.space);
            walk_ws(v, &n.ws);
            v.exit_rule(15, &"combinator", &n.span);
        }
    }
}

pub fn walk_simpleSelectorSequence<V: Visitor>(v: &mut V, node: &SimpleSelectorSequenceNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(16, &"simpleSelectorSequence", &n.span);
            if let Some(item) = &n.type_selector_or_universal {
                match item {
                    TypeSelector(inner) => {
                        walk_typeSelector(v, inner);
                    }
                    Universal(inner) => {
                        walk_universal(v, inner);
                    }
                }
            }
            for let item of &n.group_0_list {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.hash);
                    }
                    Alt1(inner) => {
                        walk_className(v, &inner.class_name);
                    }
                    Alt2(inner) => {
                        walk_attrib(v, &inner.attrib);
                    }
                    Alt3(inner) => {
                        walk_pseudo(v, &inner.pseudo);
                    }
                    Alt4(inner) => {
                        walk_negation(v, &inner.negation);
                    }
                }
            }
            v.exit_rule(16, &"simpleSelectorSequence", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(16, &"simpleSelectorSequence", &n.span);
            for let item of &n.group_1_list {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.hash);
                    }
                    Alt1(inner) => {
                        walk_className(v, &inner.class_name);
                    }
                    Alt2(inner) => {
                        walk_attrib(v, &inner.attrib);
                    }
                    Alt3(inner) => {
                        walk_pseudo(v, &inner.pseudo);
                    }
                    Alt4(inner) => {
                        walk_negation(v, &inner.negation);
                    }
                }
            }
            v.exit_rule(16, &"simpleSelectorSequence", &n.span);
        }
    }
}

pub fn walk_typeSelector<V: Visitor>(v: &mut V, node: &TypeSelectorNode) {
    v.enter_rule(17, &"typeSelector", &node.span);
    if let Some(item) = &node.type_namespace_prefix {
        walk_typeNamespacePrefix(v, item);
    }
    walk_elementName(v, &node.element_name);
    v.exit_rule(17, &"typeSelector", &node.span);
}

pub fn walk_typeNamespacePrefix<V: Visitor>(v: &mut V, node: &TypeNamespacePrefixNode) {
    v.enter_rule(18, &"typeNamespacePrefix", &node.span);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_ident(v, &inner.ident);
            }
            Alt1(inner) => {
                v.visit_token(&inner.star);
            }
        }
    }
    v.visit_token(&node.pipe);
    v.exit_rule(18, &"typeNamespacePrefix", &node.span);
}

pub fn walk_elementName<V: Visitor>(v: &mut V, node: &ElementNameNode) {
    v.enter_rule(19, &"elementName", &node.span);
    walk_ident(v, &node.ident);
    v.exit_rule(19, &"elementName", &node.span);
}

pub fn walk_universal<V: Visitor>(v: &mut V, node: &UniversalNode) {
    v.enter_rule(20, &"universal", &node.span);
    if let Some(item) = &node.type_namespace_prefix {
        walk_typeNamespacePrefix(v, item);
    }
    v.visit_token(&node.star);
    v.exit_rule(20, &"universal", &node.span);
}

pub fn walk_className<V: Visitor>(v: &mut V, node: &ClassNameNode) {
    v.enter_rule(21, &"className", &node.span);
    v.visit_token(&node.dot);
    walk_ident(v, &node.ident);
    v.exit_rule(21, &"className", &node.span);
}

pub fn walk_attrib<V: Visitor>(v: &mut V, node: &AttribNode) {
    v.enter_rule(22, &"attrib", &node.span);
    v.visit_token(&node.lbracket);
    walk_ws(v, &node.ws);
    if let Some(item) = &node.type_namespace_prefix {
        walk_typeNamespacePrefix(v, item);
    }
    walk_ident(v, &node.ident);
    walk_ws(v, &node.ws_2);
    if let Some(item) = &node.item_ws_item_ws {
        v.visit_token(&item.prefixmatch_or_suffixmatch_or_substringmatch_or_eq_or_includes_or_dashmatch);
        walk_ws(v, &item.ws);
        if let Some(item) = &item.group_0 {
            match item {
                Alt0(inner) => {
                    walk_ident(v, &inner.ident);
                }
                Alt1(inner) => {
                    v.visit_token(&inner.string_);
                }
            }
        }
        walk_ws(v, &item.ws_2);
    }
    v.visit_token(&node.rbracket);
    v.exit_rule(22, &"attrib", &node.span);
}

pub fn walk_pseudo<V: Visitor>(v: &mut V, node: &PseudoNode) {
    v.enter_rule(23, &"pseudo", &node.span);
    v.visit_token(&node.colon);
    if let Some(item) = &node.colon_2 {
        v.visit_token(item);
    }
    if let Some(item) = &node.ident_or_functional_pseudo {
        match item {
            Ident(inner) => {
                walk_ident(v, inner);
            }
            FunctionalPseudo(inner) => {
                walk_functionalPseudo(v, inner);
            }
        }
    }
    v.exit_rule(23, &"pseudo", &node.span);
}

pub fn walk_functionalPseudo<V: Visitor>(v: &mut V, node: &FunctionalPseudoNode) {
    v.enter_rule(24, &"functionalPseudo", &node.span);
    v.visit_token(&node.function_);
    walk_ws(v, &node.ws);
    walk_expression(v, &node.expression);
    v.visit_token(&node.rparen);
    v.exit_rule(24, &"functionalPseudo", &node.span);
}

pub fn walk_expression<V: Visitor>(v: &mut V, node: &ExpressionNode) {
    v.enter_rule(25, &"expression", &node.span);
    for let item of &node.item_ws_list {
        if let Some(item) = &item.group_0 {
            match item {
                Alt0(inner) => {
                    v.visit_token(&inner.plus);
                }
                Alt1(inner) => {
                    v.visit_token(&inner.minus);
                }
                Alt2(inner) => {
                    v.visit_token(&inner.dimension);
                }
                Alt3(inner) => {
                    v.visit_token(&inner.unknowndimension);
                }
                Alt4(inner) => {
                    v.visit_token(&inner.number);
                }
                Alt5(inner) => {
                    v.visit_token(&inner.string_);
                }
                Alt6(inner) => {
                    walk_ident(v, &inner.ident);
                }
            }
        }
        walk_ws(v, &item.ws);
    }
    v.exit_rule(25, &"expression", &node.span);
}

pub fn walk_negation<V: Visitor>(v: &mut V, node: &NegationNode) {
    v.enter_rule(26, &"negation", &node.span);
    v.visit_token(&node.pseudonot);
    walk_ws(v, &node.ws);
    walk_negationArg(v, &node.negation_arg);
    walk_ws(v, &node.ws_2);
    v.visit_token(&node.rparen);
    v.exit_rule(26, &"negation", &node.span);
}

pub fn walk_negationArg<V: Visitor>(v: &mut V, node: &NegationArgNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(27, &"negationArg", &n.span);
            walk_typeSelector(v, &n.type_selector);
            v.exit_rule(27, &"negationArg", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(27, &"negationArg", &n.span);
            walk_universal(v, &n.universal);
            v.exit_rule(27, &"negationArg", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(27, &"negationArg", &n.span);
            v.visit_token(&n.hash);
            v.exit_rule(27, &"negationArg", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(27, &"negationArg", &n.span);
            walk_className(v, &n.class_name);
            v.exit_rule(27, &"negationArg", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(27, &"negationArg", &n.span);
            walk_attrib(v, &n.attrib);
            v.exit_rule(27, &"negationArg", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(27, &"negationArg", &n.span);
            walk_pseudo(v, &n.pseudo);
            v.exit_rule(27, &"negationArg", &n.span);
        }
    }
}

pub fn walk_operator_<V: Visitor>(v: &mut V, node: &OperatorNode) {
    match node {
        goodOperator0(n) => {
            v.enter_rule(28, &"operator_", &n.span);
            v.visit_token(&n.slash);
            walk_ws(v, &n.ws);
            v.exit_rule(28, &"operator_", &n.span);
        }
        goodOperator1(n) => {
            v.enter_rule(28, &"operator_", &n.span);
            v.visit_token(&n.comma);
            walk_ws(v, &n.ws);
            v.exit_rule(28, &"operator_", &n.span);
        }
        goodOperator2(n) => {
            v.enter_rule(28, &"operator_", &n.span);
            v.visit_token(&n.space);
            walk_ws(v, &n.ws);
            v.exit_rule(28, &"operator_", &n.span);
        }
        badOperator(n) => {
            v.enter_rule(28, &"operator_", &n.span);
            v.visit_token(&n.eq);
            walk_ws(v, &n.ws);
            v.exit_rule(28, &"operator_", &n.span);
        }
    }
}

pub fn walk_property_<V: Visitor>(v: &mut V, node: &PropertyNode) {
    match node {
        goodProperty0(n) => {
            v.enter_rule(29, &"property_", &n.span);
            walk_ident(v, &n.ident);
            walk_ws(v, &n.ws);
            v.exit_rule(29, &"property_", &n.span);
        }
        goodProperty1(n) => {
            v.enter_rule(29, &"property_", &n.span);
            v.visit_token(&n.variable);
            walk_ws(v, &n.ws);
            v.exit_rule(29, &"property_", &n.span);
        }
        badProperty0(n) => {
            v.enter_rule(29, &"property_", &n.span);
            v.visit_token(&n.star);
            walk_ident(v, &n.ident);
            v.exit_rule(29, &"property_", &n.span);
        }
        badProperty1(n) => {
            v.enter_rule(29, &"property_", &n.span);
            v.visit_token(&n.lit_u5f);
            walk_ident(v, &n.ident);
            v.exit_rule(29, &"property_", &n.span);
        }
    }
}

pub fn walk_ruleset<V: Visitor>(v: &mut V, node: &RulesetNode) {
    match node {
        knownRuleset(n) => {
            v.enter_rule(30, &"ruleset", &n.span);
            walk_selectorGroup(v, &n.selector_group);
            v.visit_token(&n.lbrace);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.declaration_list {
                walk_declarationList(v, item);
            }
            v.visit_token(&n.rbrace);
            walk_ws(v, &n.ws_2);
            v.exit_rule(30, &"ruleset", &n.span);
        }
        unknownRuleset(n) => {
            v.enter_rule(30, &"ruleset", &n.span);
            for let item of &n.any__list {
                walk_any_(v, item);
            }
            v.visit_token(&n.lbrace);
            walk_ws(v, &n.ws);
            if let Some(item) = &n.declaration_list {
                walk_declarationList(v, item);
            }
            v.visit_token(&n.rbrace);
            walk_ws(v, &n.ws_2);
            v.exit_rule(30, &"ruleset", &n.span);
        }
    }
}

pub fn walk_declarationList<V: Visitor>(v: &mut V, node: &DeclarationListNode) {
    v.enter_rule(31, &"declarationList", &node.span);
    for let item of &node.semicolon_ws_list {
        v.visit_token(&item.semicolon);
        walk_ws(v, &item.ws);
    }
    walk_declaration(v, &node.declaration);
    walk_ws(v, &node.ws);
    for let item of &node.semicolon_ws_declaration_list {
        v.visit_token(&item.semicolon);
        walk_ws(v, &item.ws);
        if let Some(item) = &item.declaration {
            walk_declaration(v, item);
        }
    }
    v.exit_rule(31, &"declarationList", &node.span);
}

pub fn walk_declaration<V: Visitor>(v: &mut V, node: &DeclarationNode) {
    match node {
        knownDeclaration(n) => {
            v.enter_rule(32, &"declaration", &n.span);
            walk_property_(v, &n.property_);
            v.visit_token(&n.colon);
            walk_ws(v, &n.ws);
            walk_expr(v, &n.expr);
            if let Some(item) = &n.prio {
                walk_prio(v, item);
            }
            v.exit_rule(32, &"declaration", &n.span);
        }
        unknownDeclaration(n) => {
            v.enter_rule(32, &"declaration", &n.span);
            walk_property_(v, &n.property_);
            v.visit_token(&n.colon);
            walk_ws(v, &n.ws);
            walk_value(v, &n.value);
            v.exit_rule(32, &"declaration", &n.span);
        }
    }
}

pub fn walk_prio<V: Visitor>(v: &mut V, node: &PrioNode) {
    v.enter_rule(33, &"prio", &node.span);
    v.visit_token(&node.important);
    walk_ws(v, &node.ws);
    v.exit_rule(33, &"prio", &node.span);
}

pub fn walk_value<V: Visitor>(v: &mut V, node: &ValueNode) {
    v.enter_rule(34, &"value", &node.span);
    for let item of &node.group_0_list {
        match item {
            Alt0(inner) => {
                walk_any_(v, &inner.any_);
            }
            Alt1(inner) => {
                walk_block(v, &inner.block);
            }
            Alt2(inner) => {
                v.visit_token(&inner.atkeyword);
                walk_ws(v, &inner.ws);
            }
        }
    }
    v.exit_rule(34, &"value", &node.span);
}

pub fn walk_expr<V: Visitor>(v: &mut V, node: &ExprNode) {
    v.enter_rule(35, &"expr", &node.span);
    walk_term(v, &node.term);
    for let item of &node.operator__term_list {
        if let Some(item) = &item.operator_ {
            walk_operator_(v, item);
        }
        walk_term(v, &item.term);
    }
    v.exit_rule(35, &"expr", &node.span);
}

pub fn walk_term<V: Visitor>(v: &mut V, node: &TermNode) {
    match node {
        knownTerm0(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_number(v, &n.number);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm1(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_percentage(v, &n.percentage);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm2(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_dimension(v, &n.dimension);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm3(n) => {
            v.enter_rule(36, &"term", &n.span);
            v.visit_token(&n.string_);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm4(n) => {
            v.enter_rule(36, &"term", &n.span);
            v.visit_token(&n.unicoderange);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm5(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_ident(v, &n.ident);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm6(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_var_(v, &n.var_);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm7(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_url(v, &n.url);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm8(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_hexcolor(v, &n.hexcolor);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm9(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_calc(v, &n.calc);
            v.exit_rule(36, &"term", &n.span);
        }
        knownTerm10(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_function_(v, &n.function_);
            v.exit_rule(36, &"term", &n.span);
        }
        unknownTerm(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_unknownDimension(v, &n.unknown_dimension);
            walk_ws(v, &n.ws);
            v.exit_rule(36, &"term", &n.span);
        }
        badTerm(n) => {
            v.enter_rule(36, &"term", &n.span);
            walk_dxImageTransform(v, &n.dx_image_transform);
            v.exit_rule(36, &"term", &n.span);
        }
    }
}

pub fn walk_function_<V: Visitor>(v: &mut V, node: &FunctionNode) {
    v.enter_rule(37, &"function_", &node.span);
    v.visit_token(&node.function_);
    walk_ws(v, &node.ws);
    walk_expr(v, &node.expr);
    v.visit_token(&node.rparen);
    walk_ws(v, &node.ws_2);
    v.exit_rule(37, &"function_", &node.span);
}

