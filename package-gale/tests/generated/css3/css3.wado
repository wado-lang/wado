            span: Span::new(start, i32::max(start, p.last_end())),
            plus,
            ws,
        }));
    }
    if kind == TK_Greater {
        let greater = p.expect(TK_Greater)?;
        let ws = parse_ws(p)?;
        return Result::<CombinatorNode, ParseError>::Ok(CombinatorNode::Alt1(CombinatorAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            greater,
            ws,
        }));
    }
    if kind == TK_Tilde {
        let tilde = p.expect(TK_Tilde)?;
        let ws = parse_ws(p)?;
        return Result::<CombinatorNode, ParseError>::Ok(CombinatorNode::Alt2(CombinatorAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            tilde,
            ws,
        }));
    }
    if kind == TK_Space {
        let space = p.expect(TK_Space)?;
        let ws = parse_ws(p)?;
        return Result::<CombinatorNode, ParseError>::Ok(CombinatorNode::Alt3(CombinatorAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            space,
            ws,
        }));
    }
    return Result::<CombinatorNode, ParseError>::Err(ParseError::new(
        "expected combinator",
        p.peek().span,
        ["TK_Plus", "TK_Greater", "TK_Tilde", "TK_Space"],
    ));
