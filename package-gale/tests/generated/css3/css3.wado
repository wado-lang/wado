            if p.peek_at(1) == TK_Number {
                return parse_term_bt_0(p);
            } else if p.peek_at(1) == TK_Percentage {
                return parse_term_bt_1(p);
            } else if p.peek_at(1) == TK_Dimension {
                return parse_term_bt_2(p);
            } else if p.peek_at(1) == TK_UnknownDimension {
                return parse_term_bt_11(p);
            }
        } else if p.peek_kind() == TK_Minus {
            if p.peek_at(1) == TK_Number {
                return parse_term_bt_0(p);
            } else if p.peek_at(1) == TK_Percentage {
                return parse_term_bt_1(p);
            } else if p.peek_at(1) == TK_Dimension {
                return parse_term_bt_2(p);
            } else if p.peek_at(1) == TK_UnknownDimension {
                return parse_term_bt_11(p);
            }
        } else if p.peek_kind() == TK_Number {
            return parse_term_bt_0(p);
        } else if p.peek_kind() == TK_Percentage {
            return parse_term_bt_1(p);
        } else if p.peek_kind() == TK_Dimension {
            return parse_term_bt_2(p);
        } else if p.peek_kind() == TK_UnknownDimension {
            return parse_term_bt_11(p);
        }
    }
    if kind == TK_String_ {
        let string_ = p.expect(TK_String_)?;
        let ws = parse_ws(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm3(TermknownTerm3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            string_,
            ws,
        }));
    }
    if kind == TK_UnicodeRange {
        let unicoderange = p.expect(TK_UnicodeRange)?;
        let ws = parse_ws(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm4(TermknownTerm4 {
            span: Span::new(start, i32::max(start, p.last_end())),
            unicoderange,
            ws,
        }));
    }
    if _gale_kind_set_4(kind) {
        let ident = parse_ident(p)?;
        let ws = parse_ws(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm5(TermknownTerm5 {
            span: Span::new(start, i32::max(start, p.last_end())),
            ident,
            ws,
        }));
    }
    if kind == TK_Var {
        let var_ = parse_var_(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm6(TermknownTerm6 {
            span: Span::new(start, i32::max(start, p.last_end())),
            var_,
        }));
    }
    if _gale_kind_set_2(kind) {
        let url = parse_url(p)?;
        let ws = parse_ws(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm7(TermknownTerm7 {
            span: Span::new(start, i32::max(start, p.last_end())),
            url,
            ws,
        }));
    }
    if kind == TK_Hash {
        let hexcolor = parse_hexcolor(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm8(TermknownTerm8 {
            span: Span::new(start, i32::max(start, p.last_end())),
            hexcolor,
        }));
    }
    if kind == TK_Calc {
        let calc = parse_calc(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm9(TermknownTerm9 {
            span: Span::new(start, i32::max(start, p.last_end())),
            calc,
        }));
    }
    if kind == TK_Function_ {
        let function_ = parse_function_(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::knownTerm10(TermknownTerm10 {
            span: Span::new(start, i32::max(start, p.last_end())),
            function_,
        }));
    }
    if kind == TK_DxImageTransform {
        let dx_image_transform = parse_dx_image_transform(p)?;
        return Result::<TermNode, ParseError>::Ok(TermNode::badTerm(TermbadTerm {
            span: Span::new(start, i32::max(start, p.last_end())),
            dx_image_transform,
        }));
    }
    return Result::<TermNode, ParseError>::Err(ParseError::new(
        "expected term",
        p.peek().span,
        ["TK_Plus", "TK_Minus", "TK_Number", "TK_Percentage", "TK_Dimension", "TK_String_", "TK_UnicodeRange", "TK_Ident", "TK_MediaOnly", "TK_Not", "TK_And", "TK_Or", "TK_From", "TK_To", "TK_Var", "TK_Url_", "TK_Url", "TK_Hash", "TK_Calc", "TK_Function_", "TK_UnknownDimension", "TK_DxImageTransform"],
    ));
