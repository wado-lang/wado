fn parse_font_family_name(p: &mut Parser) -> Result<FontFamilyNameNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_String_ {
        let string_ = p.expect(TK_String_)?;
        return Result::<FontFamilyNameNode, ParseError>::Ok(FontFamilyNameNode::Alt0(FontFamilyNameAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            string_,
        }));
    }
    if _gale_kind_set_4(kind) {
        let ident = parse_ident(p)?;
        let mut ws_ident_list: Array<WsIdentItem> = [];
        loop {
            let mut rep_scan_pos: i32 = -1;
            rep_scan: {
                let tokens = &p.tokens;
                let mut pos: i32 = p.pos;
                sg_128_done: {
                    sg_128: {
                        pos = scan_ws(tokens, pos, 0);
                        if pos < 0 { break sg_128; }
                        pos = scan_ident(tokens, pos, 0);
                        if pos < 0 { break sg_128; }
                        break sg_128_done;
                    }
                    break rep_scan;
                }
                if pos <= p.pos { break rep_scan; }
                rep_scan_pos = pos;
            }
            if rep_scan_pos < 0 { break; }
            let ws = parse_ws(p)?;
            let ident = parse_ident(p)?;
            let ws_ident = WsIdentItem {
                ws,
                ident,
            };
            ws_ident_list.push(ws_ident);
        }
        return Result::<FontFamilyNameNode, ParseError>::Ok(FontFamilyNameNode::Alt1(FontFamilyNameAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            ident,
            ws_ident_list,
        }));
    }
    return Result::<FontFamilyNameNode, ParseError>::Err(ParseError::new(
        "expected fontFamilyName",
        p.peek().span,
        ["TK_String_", "TK_Ident", "TK_MediaOnly", "TK_Not", "TK_And", "TK_Or", "TK_From", "TK_To"],
    ));
}

fn parse_feature_value_block(p: &mut Parser) -> Result<FeatureValueBlockNode, ParseError> {
