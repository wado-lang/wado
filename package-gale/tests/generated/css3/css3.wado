        break;
    }
    loop {
        let rep_saved_3 = pos;
        rep_3: {
            if pos >= chars.len() { break rep_3; }
            if false || chars[pos] == '/' || chars[pos] == '*' { break rep_3; }
            pos += 1;
            loop {
                let rep_saved_4 = pos;
                rep_4: {
                    if pos >= chars.len() { break rep_4; }
                    let not_saved_5 = pos;
                    let mut not_matched_5 = false;
                    not_5: {
