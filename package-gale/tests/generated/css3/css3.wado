pub fn walk_any_<V: Visitor>(v: &mut V, node: &AnyNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(44, &"any_", &n.span);
            walk_ident(v, &n.ident);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(44, &"any_", &n.span);
            walk_number(v, &n.number);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(44, &"any_", &n.span);
            walk_percentage(v, &n.percentage);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(44, &"any_", &n.span);
            walk_dimension(v, &n.dimension);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(44, &"any_", &n.span);
            walk_unknownDimension(v, &n.unknown_dimension);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.string_);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(44, &"any_", &n.span);
            walk_url(v, &n.url);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.hash);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.unicoderange);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.includes);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.dashmatch);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.colon);
            walk_ws(v, &n.ws);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.function_);
            walk_ws(v, &n.ws);
            for let item of &n.any__or_unused_list {
                match item {
                    Any(inner) => {
                        walk_any_(v, inner);
                    }
                    Unused(inner) => {
                        walk_unused(v, inner);
                    }
                }
            }
            v.visit_token(&n.rparen);
            walk_ws(v, &n.ws_2);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.lparen);
            walk_ws(v, &n.ws);
            for let item of &n.any__or_unused_list {
                match item {
                    Any(inner) => {
                        walk_any_(v, inner);
                    }
                    Unused(inner) => {
                        walk_unused(v, inner);
                    }
                }
            }
            v.visit_token(&n.rparen);
            walk_ws(v, &n.ws_2);
            v.exit_rule(44, &"any_", &n.span);
        }
        Alt14(n) => {
            v.enter_rule(44, &"any_", &n.span);
            v.visit_token(&n.lbracket);
            walk_ws(v, &n.ws);
            for let item of &n.any__or_unused_list {
                match item {
                    Any(inner) => {
                        walk_any_(v, inner);
                    }
                    Unused(inner) => {
                        walk_unused(v, inner);
                    }
                }
            }
            v.visit_token(&n.rbracket);
            walk_ws(v, &n.ws_2);
            v.exit_rule(44, &"any_", &n.span);
        }
    }
}

pub fn walk_atRule<V: Visitor>(v: &mut V, node: &AtRuleNode) {
    v.enter_rule(45, &"atRule", &node.span);
    v.visit_token(&node.atkeyword);
    walk_ws(v, &node.ws);
    for let item of &node.any__list {
        walk_any_(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_block(v, &inner.block);
            }
            Alt1(inner) => {
                v.visit_token(&inner.semicolon);
                walk_ws(v, &inner.ws);
            }
        }
    }
    v.exit_rule(45, &"atRule", &node.span);
}

pub fn walk_unused<V: Visitor>(v: &mut V, node: &UnusedNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(46, &"unused", &n.span);
            walk_block(v, &n.block);
            v.exit_rule(46, &"unused", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(46, &"unused", &n.span);
            v.visit_token(&n.atkeyword);
            walk_ws(v, &n.ws);
            v.exit_rule(46, &"unused", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(46, &"unused", &n.span);
            v.visit_token(&n.semicolon);
            walk_ws(v, &n.ws);
            v.exit_rule(46, &"unused", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(46, &"unused", &n.span);
            v.visit_token(&n.cdo);
            walk_ws(v, &n.ws);
            v.exit_rule(46, &"unused", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(46, &"unused", &n.span);
            v.visit_token(&n.cdc);
            walk_ws(v, &n.ws);
            v.exit_rule(46, &"unused", &n.span);
        }
    }
}

pub fn walk_block<V: Visitor>(v: &mut V, node: &BlockNode) {
    v.enter_rule(47, &"block", &node.span);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws);
    for let item of &node.group_0_list {
        match item {
            Alt0(inner) => {
                walk_declarationList(v, &inner.declaration_list);
            }
            Alt1(inner) => {
                walk_nestedStatement(v, &inner.nested_statement);
            }
            Alt2(inner) => {
                walk_any_(v, &inner.any_);
            }
            Alt3(inner) => {
                walk_block(v, &inner.block);
            }
            Alt4(inner) => {
                v.visit_token(&inner.atkeyword);
                walk_ws(v, &inner.ws);
            }
            Alt5(inner) => {
                v.visit_token(&inner.semicolon);
                walk_ws(v, &inner.ws);
            }
        }
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_2);
    v.exit_rule(47, &"block", &node.span);
}

pub fn walk_nestedStatement<V: Visitor>(v: &mut V, node: &NestedStatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_ruleset(v, &n.ruleset);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_media(v, &n.media);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_page(v, &n.page);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_fontFaceRule(v, &n.font_face_rule);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_keyframesRule(v, &n.keyframes_rule);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_supportsRule(v, &n.supports_rule);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_viewport(v, &n.viewport);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_counterStyle(v, &n.counter_style);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_fontFeatureValuesRule(v, &n.font_feature_values_rule);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(48, &"nestedStatement", &n.span);
            walk_atRule(v, &n.at_rule);
            v.exit_rule(48, &"nestedStatement", &n.span);
        }
    }
}

pub fn walk_groupRuleBody<V: Visitor>(v: &mut V, node: &GroupRuleBodyNode) {
    v.enter_rule(49, &"groupRuleBody", &node.span);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws);
    for let item of &node.nested_statement_list {
        walk_nestedStatement(v, item);
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_2);
    v.exit_rule(49, &"groupRuleBody", &node.span);
}

pub fn walk_supportsRule<V: Visitor>(v: &mut V, node: &SupportsRuleNode) {
    v.enter_rule(50, &"supportsRule", &node.span);
    v.visit_token(&node.supports);
    walk_ws(v, &node.ws);
    walk_supportsCondition(v, &node.supports_condition);
    walk_ws(v, &node.ws_2);
    walk_groupRuleBody(v, &node.group_rule_body);
    v.exit_rule(50, &"supportsRule", &node.span);
}

pub fn walk_supportsCondition<V: Visitor>(v: &mut V, node: &SupportsConditionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(51, &"supportsCondition", &n.span);
            walk_supportsNegation(v, &n.supports_negation);
            v.exit_rule(51, &"supportsCondition", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(51, &"supportsCondition", &n.span);
            walk_supportsConjunction(v, &n.supports_conjunction);
            v.exit_rule(51, &"supportsCondition", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(51, &"supportsCondition", &n.span);
            walk_supportsDisjunction(v, &n.supports_disjunction);
            v.exit_rule(51, &"supportsCondition", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(51, &"supportsCondition", &n.span);
            walk_supportsConditionInParens(v, &n.supports_condition_in_parens);
            v.exit_rule(51, &"supportsCondition", &n.span);
        }
    }
}

pub fn walk_supportsConditionInParens<V: Visitor>(v: &mut V, node: &SupportsConditionInParensNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(52, &"supportsConditionInParens", &n.span);
            v.visit_token(&n.lparen);
            walk_ws(v, &n.ws);
            walk_supportsCondition(v, &n.supports_condition);
            walk_ws(v, &n.ws_2);
            v.visit_token(&n.rparen);
            v.exit_rule(52, &"supportsConditionInParens", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(52, &"supportsConditionInParens", &n.span);
            walk_supportsDeclarationCondition(v, &n.supports_declaration_condition);
            v.exit_rule(52, &"supportsConditionInParens", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(52, &"supportsConditionInParens", &n.span);
            walk_generalEnclosed(v, &n.general_enclosed);
            v.exit_rule(52, &"supportsConditionInParens", &n.span);
        }
    }
}

pub fn walk_supportsNegation<V: Visitor>(v: &mut V, node: &SupportsNegationNode) {
    v.enter_rule(53, &"supportsNegation", &node.span);
    v.visit_token(&node.not);
    walk_ws(v, &node.ws);
    v.visit_token(&node.space);
    walk_ws(v, &node.ws_2);
    walk_supportsConditionInParens(v, &node.supports_condition_in_parens);
    v.exit_rule(53, &"supportsNegation", &node.span);
}

pub fn walk_supportsConjunction<V: Visitor>(v: &mut V, node: &SupportsConjunctionNode) {
    v.enter_rule(54, &"supportsConjunction", &node.span);
    walk_supportsConditionInParens(v, &node.supports_condition_in_parens);
    for let item of &node.ws_space_ws_and_ws_space_ws_supports_condition_in_parens_list {
        walk_ws(v, &item.ws);
        v.visit_token(&item.space);
        walk_ws(v, &item.ws_2);
        v.visit_token(&item.and);
        walk_ws(v, &item.ws_3);
        v.visit_token(&item.space_2);
        walk_ws(v, &item.ws_4);
        walk_supportsConditionInParens(v, &item.supports_condition_in_parens);
    }
    v.exit_rule(54, &"supportsConjunction", &node.span);
}

pub fn walk_supportsDisjunction<V: Visitor>(v: &mut V, node: &SupportsDisjunctionNode) {
    v.enter_rule(55, &"supportsDisjunction", &node.span);
    walk_supportsConditionInParens(v, &node.supports_condition_in_parens);
    for let item of &node.ws_space_ws_or_ws_space_ws_supports_condition_in_parens_list {
        walk_ws(v, &item.ws);
        v.visit_token(&item.space);
        walk_ws(v, &item.ws_2);
        v.visit_token(&item.or);
        walk_ws(v, &item.ws_3);
        v.visit_token(&item.space_2);
        walk_ws(v, &item.ws_4);
        walk_supportsConditionInParens(v, &item.supports_condition_in_parens);
    }
    v.exit_rule(55, &"supportsDisjunction", &node.span);
}

pub fn walk_supportsDeclarationCondition<V: Visitor>(v: &mut V, node: &SupportsDeclarationConditionNode) {
    v.enter_rule(56, &"supportsDeclarationCondition", &node.span);
    v.visit_token(&node.lparen);
    walk_ws(v, &node.ws);
    walk_declaration(v, &node.declaration);
    v.visit_token(&node.rparen);
    v.exit_rule(56, &"supportsDeclarationCondition", &node.span);
}

pub fn walk_generalEnclosed<V: Visitor>(v: &mut V, node: &GeneralEnclosedNode) {
    v.enter_rule(57, &"generalEnclosed", &node.span);
    v.visit_token(&node.function__or_lparen);
    for let item of &node.any__or_unused_list {
        match item {
            Any(inner) => {
                walk_any_(v, inner);
            }
            Unused(inner) => {
                walk_unused(v, inner);
            }
        }
    }
    v.visit_token(&node.rparen);
    v.exit_rule(57, &"generalEnclosed", &node.span);
}

pub fn walk_url<V: Visitor>(v: &mut V, node: &UrlNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(58, &"url", &n.span);
            v.visit_token(&n.url_);
            walk_ws(v, &n.ws);
            v.visit_token(&n.string_);
            walk_ws(v, &n.ws_2);
            v.visit_token(&n.rparen);
            v.exit_rule(58, &"url", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(58, &"url", &n.span);
            v.visit_token(&n.url);
            v.exit_rule(58, &"url", &n.span);
        }
    }
}

pub fn walk_var_<V: Visitor>(v: &mut V, node: &VarNode) {
    v.enter_rule(59, &"var_", &node.span);
    v.visit_token(&node.var);
    walk_ws(v, &node.ws);
    v.visit_token(&node.variable);
    walk_ws(v, &node.ws_2);
    v.visit_token(&node.rparen);
    walk_ws(v, &node.ws_3);
    v.exit_rule(59, &"var_", &node.span);
}

pub fn walk_calc<V: Visitor>(v: &mut V, node: &CalcNode) {
    v.enter_rule(60, &"calc", &node.span);
    v.visit_token(&node.calc);
    walk_ws(v, &node.ws);
    walk_calcSum(v, &node.calc_sum);
    v.visit_token(&node.rparen);
    walk_ws(v, &node.ws_2);
    v.exit_rule(60, &"calc", &node.span);
}

pub fn walk_calcSum<V: Visitor>(v: &mut V, node: &CalcSumNode) {
    v.enter_rule(61, &"calcSum", &node.span);
    walk_calcProduct(v, &node.calc_product);
    for let item of &node.space_ws_item_ws_space_ws_calc_product_list {
        v.visit_token(&item.space);
        walk_ws(v, &item.ws);
        v.visit_token(&item.plus_or_minus);
        walk_ws(v, &item.ws_2);
        v.visit_token(&item.space_2);
        walk_ws(v, &item.ws_3);
        walk_calcProduct(v, &item.calc_product);
    }
    v.exit_rule(61, &"calcSum", &node.span);
}

pub fn walk_calcProduct<V: Visitor>(v: &mut V, node: &CalcProductNode) {
    v.enter_rule(62, &"calcProduct", &node.span);
    walk_calcValue(v, &node.calc_value);
    for let item of &node.group_0_list {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.star);
                walk_ws(v, &inner.ws);
                walk_calcValue(v, &inner.calc_value);
            }
            Alt1(inner) => {
                v.visit_token(&inner.slash);
                walk_ws(v, &inner.ws);
                walk_number(v, &inner.number);
                walk_ws(v, &inner.ws_2);
            }
        }
    }
    v.exit_rule(62, &"calcProduct", &node.span);
}

pub fn walk_calcValue<V: Visitor>(v: &mut V, node: &CalcValueNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(63, &"calcValue", &n.span);
            walk_number(v, &n.number);
            walk_ws(v, &n.ws);
            v.exit_rule(63, &"calcValue", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(63, &"calcValue", &n.span);
            walk_dimension(v, &n.dimension);
            walk_ws(v, &n.ws);
            v.exit_rule(63, &"calcValue", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(63, &"calcValue", &n.span);
            walk_unknownDimension(v, &n.unknown_dimension);
            walk_ws(v, &n.ws);
            v.exit_rule(63, &"calcValue", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(63, &"calcValue", &n.span);
            walk_percentage(v, &n.percentage);
            walk_ws(v, &n.ws);
            v.exit_rule(63, &"calcValue", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(63, &"calcValue", &n.span);
            v.visit_token(&n.lparen);
            walk_ws(v, &n.ws);
            walk_calcSum(v, &n.calc_sum);
            v.visit_token(&n.rparen);
            walk_ws(v, &n.ws_2);
            v.exit_rule(63, &"calcValue", &n.span);
        }
    }
}

pub fn walk_fontFaceRule<V: Visitor>(v: &mut V, node: &FontFaceRuleNode) {
    v.enter_rule(64, &"fontFaceRule", &node.span);
    v.visit_token(&node.fontface);
    walk_ws(v, &node.ws);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws_2);
    if let Some(item) = &node.font_face_declaration {
        walk_fontFaceDeclaration(v, item);
    }
    for let item of &node.semicolon_ws_font_face_declaration_list {
        v.visit_token(&item.semicolon);
        walk_ws(v, &item.ws);
        if let Some(item) = &item.font_face_declaration {
            walk_fontFaceDeclaration(v, item);
        }
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_3);
    v.exit_rule(64, &"fontFaceRule", &node.span);
}

pub fn walk_fontFaceDeclaration<V: Visitor>(v: &mut V, node: &FontFaceDeclarationNode) {
    match node {
        knownFontFaceDeclaration(n) => {
            v.enter_rule(65, &"fontFaceDeclaration", &n.span);
            walk_property_(v, &n.property_);
            v.visit_token(&n.colon);
            walk_ws(v, &n.ws);
            walk_expr(v, &n.expr);
            v.exit_rule(65, &"fontFaceDeclaration", &n.span);
        }
        unknownFontFaceDeclaration(n) => {
            v.enter_rule(65, &"fontFaceDeclaration", &n.span);
            walk_property_(v, &n.property_);
            v.visit_token(&n.colon);
            walk_ws(v, &n.ws);
            walk_value(v, &n.value);
            v.exit_rule(65, &"fontFaceDeclaration", &n.span);
        }
    }
}

pub fn walk_keyframesRule<V: Visitor>(v: &mut V, node: &KeyframesRuleNode) {
    v.enter_rule(66, &"keyframesRule", &node.span);
    v.visit_token(&node.keyframes);
    walk_ws(v, &node.ws);
    v.visit_token(&node.space);
    walk_ws(v, &node.ws_2);
    walk_ident(v, &node.ident);
    walk_ws(v, &node.ws_3);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws_4);
    for let item of &node.keyframe_block_list {
        walk_keyframeBlock(v, item);
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_5);
    v.exit_rule(66, &"keyframesRule", &node.span);
}

pub fn walk_keyframeBlock<V: Visitor>(v: &mut V, node: &KeyframeBlockNode) {
    v.enter_rule(67, &"keyframeBlock", &node.span);
    walk_keyframeSelector(v, &node.keyframe_selector_lbrace_ws_declaration_list_rbrace_ws.keyframe_selector);
    v.visit_token(&node.keyframe_selector_lbrace_ws_declaration_list_rbrace_ws.lbrace);
    walk_ws(v, &node.keyframe_selector_lbrace_ws_declaration_list_rbrace_ws.ws);
    if let Some(item) = &node.keyframe_selector_lbrace_ws_declaration_list_rbrace_ws.declaration_list {
        walk_declarationList(v, item);
    }
    v.visit_token(&node.keyframe_selector_lbrace_ws_declaration_list_rbrace_ws.rbrace);
    walk_ws(v, &node.keyframe_selector_lbrace_ws_declaration_list_rbrace_ws.ws_2);
    v.exit_rule(67, &"keyframeBlock", &node.span);
}

pub fn walk_keyframeSelector<V: Visitor>(v: &mut V, node: &KeyframeSelectorNode) {
    v.enter_rule(68, &"keyframeSelector", &node.span);
    v.visit_token(&node.from__or_to_or_percentage);
    walk_ws(v, &node.ws);
    for let item of &node.comma_ws_item_ws_list {
        v.visit_token(&item.comma);
        walk_ws(v, &item.ws);
        v.visit_token(&item.from__or_to_or_percentage);
        walk_ws(v, &item.ws_2);
    }
    v.exit_rule(68, &"keyframeSelector", &node.span);
}

pub fn walk_viewport<V: Visitor>(v: &mut V, node: &ViewportNode) {
    v.enter_rule(69, &"viewport", &node.span);
    v.visit_token(&node.viewport);
    walk_ws(v, &node.ws);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws_2);
    if let Some(item) = &node.declaration_list {
        walk_declarationList(v, item);
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_3);
    v.exit_rule(69, &"viewport", &node.span);
}

pub fn walk_counterStyle<V: Visitor>(v: &mut V, node: &CounterStyleNode) {
    v.enter_rule(70, &"counterStyle", &node.span);
    v.visit_token(&node.counterstyle);
    walk_ws(v, &node.ws);
    walk_ident(v, &node.ident);
    walk_ws(v, &node.ws_2);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws_3);
    if let Some(item) = &node.declaration_list {
        walk_declarationList(v, item);
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_4);
    v.exit_rule(70, &"counterStyle", &node.span);
}

pub fn walk_fontFeatureValuesRule<V: Visitor>(v: &mut V, node: &FontFeatureValuesRuleNode) {
    v.enter_rule(71, &"fontFeatureValuesRule", &node.span);
    v.visit_token(&node.fontfeaturevalues);
    walk_ws(v, &node.ws);
    walk_fontFamilyNameList(v, &node.font_family_name_list);
    walk_ws(v, &node.ws_2);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws_3);
    for let item of &node.feature_value_block_list {
        walk_featureValueBlock(v, item);
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_4);
    v.exit_rule(71, &"fontFeatureValuesRule", &node.span);
}

pub fn walk_fontFamilyNameList<V: Visitor>(v: &mut V, node: &FontFamilyNameListNode) {
    v.enter_rule(72, &"fontFamilyNameList", &node.span);
    walk_fontFamilyName(v, &node.font_family_name);
    for let item of &node.ws_comma_ws_font_family_name_list {
        walk_ws(v, &item.ws);
        v.visit_token(&item.comma);
        walk_ws(v, &item.ws_2);
        walk_fontFamilyName(v, &item.font_family_name);
    }
    v.exit_rule(72, &"fontFamilyNameList", &node.span);
}

pub fn walk_fontFamilyName<V: Visitor>(v: &mut V, node: &FontFamilyNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(73, &"fontFamilyName", &n.span);
            v.visit_token(&n.string_);
            v.exit_rule(73, &"fontFamilyName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(73, &"fontFamilyName", &n.span);
            walk_ident(v, &n.ident);
            for let item of &n.ws_ident_list {
                walk_ws(v, &item.ws);
                walk_ident(v, &item.ident);
            }
            v.exit_rule(73, &"fontFamilyName", &n.span);
        }
    }
}

pub fn walk_featureValueBlock<V: Visitor>(v: &mut V, node: &FeatureValueBlockNode) {
    v.enter_rule(74, &"featureValueBlock", &node.span);
    walk_featureType(v, &node.feature_type);
    walk_ws(v, &node.ws);
    v.visit_token(&node.lbrace);
    walk_ws(v, &node.ws_2);
    if let Some(item) = &node.feature_value_definition {
        walk_featureValueDefinition(v, item);
    }
    for let item of &node.ws_semicolon_ws_feature_value_definition_list {
        walk_ws(v, &item.ws);
        v.visit_token(&item.semicolon);
        walk_ws(v, &item.ws_2);
        if let Some(item) = &item.feature_value_definition {
            walk_featureValueDefinition(v, item);
        }
    }
    v.visit_token(&node.rbrace);
    walk_ws(v, &node.ws_3);
    v.exit_rule(74, &"featureValueBlock", &node.span);
}

pub fn walk_featureType<V: Visitor>(v: &mut V, node: &FeatureTypeNode) {
    v.enter_rule(75, &"featureType", &node.span);
    v.visit_token(&node.atkeyword);
    v.exit_rule(75, &"featureType", &node.span);
}

pub fn walk_featureValueDefinition<V: Visitor>(v: &mut V, node: &FeatureValueDefinitionNode) {
    v.enter_rule(76, &"featureValueDefinition", &node.span);
    walk_ident(v, &node.ident);
    walk_ws(v, &node.ws);
    v.visit_token(&node.colon);
    walk_ws(v, &node.ws_2);
    walk_number(v, &node.number);
    for let item of &node.ws_number_list {
        walk_ws(v, &item.ws);
        walk_number(v, &item.number);
    }
    v.exit_rule(76, &"featureValueDefinition", &node.span);
}

pub fn walk_ident<V: Visitor>(v: &mut V, node: &IdentNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(77, &"ident", &n.span);
            v.visit_token(&n.ident);
            v.exit_rule(77, &"ident", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(77, &"ident", &n.span);
            v.visit_token(&n.mediaonly);
            v.exit_rule(77, &"ident", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(77, &"ident", &n.span);
            v.visit_token(&n.not);
            v.exit_rule(77, &"ident", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(77, &"ident", &n.span);
            v.visit_token(&n.and);
            v.exit_rule(77, &"ident", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(77, &"ident", &n.span);
            v.visit_token(&n.or);
            v.exit_rule(77, &"ident", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(77, &"ident", &n.span);
            v.visit_token(&n.from_);
            v.exit_rule(77, &"ident", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(77, &"ident", &n.span);
            v.visit_token(&n.to);
            v.exit_rule(77, &"ident", &n.span);
        }
    }
}

pub fn walk_ws<V: Visitor>(v: &mut V, node: &WsNode) {
    v.enter_rule(78, &"ws", &node.span);
    for let item of &node.comment_or_space_list {
        v.visit_token(item);
    }
    v.exit_rule(78, &"ws", &node.span);
}

pub fn to_tree(node: &StylesheetNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_stylesheet(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_Cdc | TK_Cdo | TK_Comment | TK_Space };
}

