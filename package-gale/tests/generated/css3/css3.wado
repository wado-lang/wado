fn try_function_(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    pos = try_ident(chars, pos);
    if pos < 0 { return -1; }
    if pos >= chars.len() || chars[pos] != '(' { return -1; }
    pos += 1;
    return pos;
}

fn try_unexpectedcharacter(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    pos += 1;
    return pos;
}

fn try_lit_semi(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ';' { return -1; }
    return pos + 1;
}

fn try_lit_lparen(chars: &Array<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '(' { return -1; }
    return pos + 1;
}

