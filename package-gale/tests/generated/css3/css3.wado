fn parse_combinator(p: &mut Parser) -> Result<CombinatorNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_Plus {
        let plus = p.expect(TK_Plus)?;
        let ws = parse_ws(p)?;
