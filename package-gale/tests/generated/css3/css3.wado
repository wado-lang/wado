        let ws = parse_ws(p)?;
        let semicolon = p.expect(TK_LIT_SEMI)?;
        let ws_2 = parse_ws(p)?;
        let feature_value_definition: Option<FeatureValueDefinitionNode> = if _gale_kind_set_4(p.peek_kind()) {
            let feature_value_definition = parse_feature_value_definition(p)?;
            Option::<FeatureValueDefinitionNode>::Some(feature_value_definition)
        } else {
