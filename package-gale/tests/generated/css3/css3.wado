fn parse_at_rule(p: &mut Parser) -> Result<AtRuleNode, ParseError> {
    let start = p.peek().span.start;
    let atkeyword = p.expect(TK_AtKeyword)?;
    let ws = parse_ws(p)?;
    let mut any__list: Array<AnyNode> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_any_(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let any_ = parse_any_(p)?;
        any__list.push(any_);
    }
    let mut group_0_inner: Option<AtRuleGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_LBRACE {
        let block = parse_block(p)?;
        group_0_inner = Option::<AtRuleGroup0>::Some(AtRuleGroup0::Alt0(AtRuleGroup0Alt0 {
            block,
        }));
    } else if grp_kind == TK_LIT_SEMI {
        let semicolon = p.expect(TK_LIT_SEMI)?;
        let ws = parse_ws(p)?;
        group_0_inner = Option::<AtRuleGroup0>::Some(AtRuleGroup0::Alt1(AtRuleGroup0Alt1 {
            semicolon,
            ws,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<AtRuleNode, ParseError>::Ok(AtRuleNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        atkeyword,
        ws,
        any__list,
        group_0,
    });
}

fn parse_unused(p: &mut Parser) -> Result<UnusedNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_LBRACE {
        let block = parse_block(p)?;
        return Result::<UnusedNode, ParseError>::Ok(UnusedNode::Alt0(UnusedAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            block,
        }));
    }
    if kind == TK_AtKeyword {
        let atkeyword = p.expect(TK_AtKeyword)?;
        let ws = parse_ws(p)?;
        return Result::<UnusedNode, ParseError>::Ok(UnusedNode::Alt1(UnusedAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            atkeyword,
            ws,
        }));
    }
    if kind == TK_LIT_SEMI {
        let semicolon = p.expect(TK_LIT_SEMI)?;
        let ws = parse_ws(p)?;
        return Result::<UnusedNode, ParseError>::Ok(UnusedNode::Alt2(UnusedAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            semicolon,
            ws,
        }));
    }
    if kind == TK_Cdo {
        let cdo = p.expect(TK_Cdo)?;
        let ws = parse_ws(p)?;
        return Result::<UnusedNode, ParseError>::Ok(UnusedNode::Alt3(UnusedAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            cdo,
            ws,
        }));
    }
    if kind == TK_Cdc {
        let cdc = p.expect(TK_Cdc)?;
        let ws = parse_ws(p)?;
        return Result::<UnusedNode, ParseError>::Ok(UnusedNode::Alt4(UnusedAlt4 {
            span: Span::new(start, i32::max(start, p.last_end())),
            cdc,
            ws,
        }));
    }
    return Result::<UnusedNode, ParseError>::Err(ParseError::new(
        "expected unused",
        p.peek().span,
        ["TK_LIT_LBRACE", "TK_AtKeyword", "TK_LIT_SEMI", "TK_Cdo", "TK_Cdc"],
    ));
}

