    return k matches { TK_And | TK_AtKeyword | TK_CounterStyle | TK_DashMatch | TK_Dimension | TK_FontFace | TK_FontFeatureValues | TK_From | TK_Function_ | TK_Hash | TK_Ident | TK_Includes | TK_Keyframes | TK_LIT_COLON | TK_LIT_DOT | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PIPE | TK_LIT_STAR | TK_Media | TK_MediaOnly | TK_Minus | TK_Not | TK_Number | TK_Or | TK_Page | TK_Percentage | TK_Plus | TK_PseudoNot | TK_String_ | TK_Supports | TK_To | TK_UnicodeRange | TK_UnknownDimension | TK_Url | TK_Url_ | TK_Viewport };
