global TK_COS: i32 = 0;
global TK_SIN: i32 = 1;
global TK_TAN: i32 = 2;
global TK_ACOS: i32 = 3;
global TK_ASIN: i32 = 4;
global TK_ATAN: i32 = 5;
global TK_LN: i32 = 6;
global TK_LOG: i32 = 7;
global TK_SQRT: i32 = 8;
global TK_LPAREN: i32 = 9;
global TK_RPAREN: i32 = 10;
global TK_PLUS: i32 = 11;
global TK_MINUS: i32 = 12;
global TK_TIMES: i32 = 13;
global TK_DIV: i32 = 14;
global TK_GT: i32 = 15;
global TK_LT: i32 = 16;
global TK_EQ: i32 = 17;
global TK_COMMA: i32 = 18;
global TK_POINT: i32 = 19;
global TK_POW: i32 = 20;
global TK_PI: i32 = 21;
global TK_EULER: i32 = 22;
global TK_I: i32 = 23;
global TK_VARIABLE: i32 = 24;
global TK_SCIENTIFIC_NUMBER: i32 = 25;
global TK_WS: i32 = 26;
global TK_EOF: i32 = 27;
global TK_ERROR: i32 = 28;

struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_cos(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'c' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'o' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 's' { return -1; }
    pos += 1;
    return pos;
}

fn try_sin(chars: &List<char>, start: i32) -> i32 {
