        return Result::<FuncNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_funcname__inner(p: &mut Parser) -> Result<FuncnameNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_COS {
        let cos = p.expect(TK_COS)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt0(FuncnameAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            cos,
        }));
    }
    if kind == TK_TAN {
        let tan = p.expect(TK_TAN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt1(FuncnameAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            tan,
        }));
    }
    if kind == TK_SIN {
        let sin = p.expect(TK_SIN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt2(FuncnameAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            sin,
        }));
    }
    if kind == TK_ACOS {
        let acos = p.expect(TK_ACOS)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt3(FuncnameAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            acos,
        }));
    }
    if kind == TK_ATAN {
        let atan = p.expect(TK_ATAN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt4(FuncnameAlt4 {
            span: Span::new(start, i32::max(start, p.last_end())),
            atan,
        }));
    }
    if kind == TK_ASIN {
        let asin = p.expect(TK_ASIN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt5(FuncnameAlt5 {
            span: Span::new(start, i32::max(start, p.last_end())),
            asin,
        }));
    }
    if kind == TK_LOG {
        let log = p.expect(TK_LOG)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt6(FuncnameAlt6 {
            span: Span::new(start, i32::max(start, p.last_end())),
            log,
        }));
    }
    if kind == TK_LN {
        let ln = p.expect(TK_LN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt7(FuncnameAlt7 {
            span: Span::new(start, i32::max(start, p.last_end())),
            ln,
        }));
    }
    if kind == TK_SQRT {
        let sqrt = p.expect(TK_SQRT)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt8(FuncnameAlt8 {
            span: Span::new(start, i32::max(start, p.last_end())),
            sqrt,
        }));
    }
    return Result::<FuncnameNode, ParseError>::Err(p.error(
        "expected funcname",
        p.peek().span,
        ["TK_COS", "TK_TAN", "TK_SIN", "TK_ACOS", "TK_ATAN", "TK_ASIN", "TK_LOG", "TK_LN", "TK_SQRT"],
    ));
}

