fn _parse_relop__inner(p: &mut Parser) -> Result<RelopNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_EQ {
        let eq = p.expect(TK_EQ)?;
        return Result::<RelopNode, ParseError>::Ok(RelopNode::Alt0(RelopAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
