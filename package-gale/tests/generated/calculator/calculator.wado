    return pos;
}

fn try_pi(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'p' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'i' { return -1; }
    pos += 1;
    return pos;
}

fn try_variable(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_0 = pos;
    let mut alts_ok_0 = false;
    alts_0_0: {
        pos = alts_saved_0;
        if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_0_0; }
        pos += 1;
        alts_ok_0 = true;
    }
    if !alts_ok_0 {
        alts_0_1: {
            pos = alts_saved_0;
            if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_0_1; }
            pos += 1;
            alts_ok_0 = true;
        }
        if !alts_ok_0 {
            alts_0_2: {
                pos = alts_saved_0;
                if pos >= chars.len() || chars[pos] != '_' { break alts_0_2; }
                pos += 1;
                alts_ok_0 = true;
            }
        }
    }
    if !alts_ok_0 { return -1; }
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            let alts_saved_2 = pos;
            let mut alts_ok_2 = false;
            alts_2_0: {
                pos = alts_saved_2;
                let alts_saved_3 = pos;
                let mut alts_ok_3 = false;
                alts_3_0: {
                    pos = alts_saved_3;
                    if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_3_0; }
                    pos += 1;
                    alts_ok_3 = true;
                }
                if !alts_ok_3 {
                    alts_3_1: {
                        pos = alts_saved_3;
                        if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_3_1; }
                        pos += 1;
                        alts_ok_3 = true;
                    }
                    if !alts_ok_3 {
                        alts_3_2: {
                            pos = alts_saved_3;
                            if pos >= chars.len() || chars[pos] != '_' { break alts_3_2; }
                            pos += 1;
                            alts_ok_3 = true;
                        }
                    }
                }
                if !alts_ok_3 { break alts_2_0; }
                alts_ok_2 = true;
            }
            if !alts_ok_2 {
                alts_2_1: {
                    pos = alts_saved_2;
                    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break alts_2_1; }
                    pos += 1;
                    alts_ok_2 = true;
                }
            }
            if !alts_ok_2 { break rep_1; }
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_scientific_number(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { return -1; }
    pos += 1;
    loop {
        let rep_saved_4 = pos;
        rep_4: {
            if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_4; }
            pos += 1;
            continue;
        }
        pos = rep_saved_4;
        break;
    }
    let opt_saved_5 = pos;
    let mut opt_ok_5 = false;
    rep_5: {
        if pos >= chars.len() || chars[pos] != '.' { break rep_5; }
        pos += 1;
        if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_5; }
        pos += 1;
        loop {
            let rep_saved_6 = pos;
            rep_6: {
                if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_6; }
                pos += 1;
                continue;
            }
            pos = rep_saved_6;
            break;
        }
        opt_ok_5 = true;
    }
    if !opt_ok_5 { pos = opt_saved_5; }
    let opt_saved_7 = pos;
    let mut opt_ok_7 = false;
    rep_7: {
        let alts_saved_8 = pos;
        let mut alts_ok_8 = false;
        alts_8_0: {
            pos = alts_saved_8;
            if pos >= chars.len() || chars[pos] != 'E' { break alts_8_0; }
            pos += 1;
            alts_ok_8 = true;
        }
        if !alts_ok_8 {
            alts_8_1: {
                pos = alts_saved_8;
                if pos >= chars.len() || chars[pos] != 'e' { break alts_8_1; }
                pos += 1;
                alts_ok_8 = true;
            }
        }
        if !alts_ok_8 { break rep_7; }
        let opt_saved_9 = pos;
        let mut opt_ok_9 = false;
        rep_9: {
            let alts_saved_10 = pos;
            let mut alts_ok_10 = false;
            alts_10_0: {
                pos = alts_saved_10;
                if pos >= chars.len() || chars[pos] != '+' { break alts_10_0; }
                pos += 1;
                alts_ok_10 = true;
            }
            if !alts_ok_10 {
                alts_10_1: {
                    pos = alts_saved_10;
                    if pos >= chars.len() || chars[pos] != '-' { break alts_10_1; }
                    pos += 1;
                    alts_ok_10 = true;
                }
            }
            if !alts_ok_10 { break rep_9; }
            opt_ok_9 = true;
        }
        if !opt_ok_9 { pos = opt_saved_9; }
        if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_7; }
        pos += 1;
        loop {
            let rep_saved_11 = pos;
            rep_11: {
                if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_11; }
                pos += 1;
                continue;
            }
            pos = rep_saved_11;
            break;
        }
        let opt_saved_12 = pos;
        let mut opt_ok_12 = false;
        rep_12: {
            if pos >= chars.len() || chars[pos] != '.' { break rep_12; }
            pos += 1;
            if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_12; }
            pos += 1;
            loop {
                let rep_saved_13 = pos;
                rep_13: {
                    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_13; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_13;
                break;
            }
            opt_ok_12 = true;
        }
        if !opt_ok_12 { pos = opt_saved_12; }
        opt_ok_7 = true;
    }
    if !opt_ok_7 { pos = opt_saved_7; }
    return pos;
}

fn try_ws(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { return -1; }
    pos += 1;
    loop {
        let rep_saved_14 = pos;
        rep_14: {
            if pos >= chars.len() { break rep_14; }
            if !(false || chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { break rep_14; }
            pos += 1;
            continue;
        }
        pos = rep_saved_14;
        break;
    }
    return pos;
}

fn classify_keyword(chars: &Array<char>, start: i32, end: i32) -> i32 {
    let len = end - start;
    if len == 1 {
        if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 0] == 'e' { return TK_EULER; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0] == 'i' { return TK_I; }
        }
    }
    return -1;
}

pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = [];
    let mut trivia: Array<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '(' {
            end = try_lparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LPAREN; }
        } else if first_char == ')' {
            end = try_rparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_RPAREN; }
        } else if first_char == '*' {
            end = try_times(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TIMES; }
        } else if first_char == '+' {
            end = try_plus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PLUS; }
        } else if first_char == ',' {
            end = try_comma(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMA; }
        } else if first_char == '-' {
            end = try_minus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MINUS; }
        } else if first_char == '.' {
            end = try_point(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POINT; }
        } else if first_char == '/' {
            end = try_div(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DIV; }
        } else if first_char == '<' {
            end = try_lt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LT; }
        } else if first_char == '=' {
            end = try_eq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_EQ; }
        } else if first_char == '>' {
            end = try_gt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_GT; }
        } else if first_char == '^' {
            end = try_pow(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POW; }
        } else if first_char == '_' {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'a' {
            end = try_acos(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ACOS; }
            end = try_asin(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ASIN; }
            end = try_atan(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ATAN; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'c' {
            end = try_cos(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COS; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'l' {
            end = try_ln(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LN; }
            end = try_log(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LOG; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'p' {
            end = try_pi(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PI; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 's' {
            end = try_sin(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SIN; }
            end = try_sqrt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SQRT; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 't' {
            end = try_tan(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAN; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'a' <= first_char <= 'z' {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if '0' <= first_char <= '9' {
            end = try_scientific_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        } else {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
            end = try_scientific_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        }
        if best_end > start {
            let kw_kind = classify_keyword(&lexer.chars, start, best_end);
            if kw_kind >= 0 { best_kind = kw_kind; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_COS => "COS",
        TK_SIN => "SIN",
        TK_TAN => "TAN",
        TK_ACOS => "ACOS",
        TK_ASIN => "ASIN",
        TK_ATAN => "ATAN",
        TK_LN => "LN",
        TK_LOG => "LOG",
        TK_SQRT => "SQRT",
        TK_LPAREN => "LPAREN",
        TK_RPAREN => "RPAREN",
        TK_PLUS => "PLUS",
        TK_MINUS => "MINUS",
        TK_TIMES => "TIMES",
        TK_DIV => "DIV",
        TK_GT => "GT",
        TK_LT => "LT",
        TK_EQ => "EQ",
        TK_COMMA => "COMMA",
        TK_POINT => "POINT",
        TK_POW => "POW",
        TK_PI => "PI",
        TK_EULER => "EULER",
        TK_I => "I",
        TK_VARIABLE => "VARIABLE",
        TK_SCIENTIFIC_NUMBER => "SCIENTIFIC_NUMBER",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: Array<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }
}

fn scan_equation(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    pos = scan_relop(tokens, pos, 0);
    if pos < 0 { return -1; }
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_multiplying_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos].kind) {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                let gp_1 = pos;
                sg_1: {
                    pos = gp_1;
                    sg_1_0: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_PLUS { break sg_1_0; }
                        pos += 1;
                        break sg_1;
                    }
                    pos = gp_1;
                    sg_1_1: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_MINUS { break sg_1_1; }
                        pos += 1;
                        break sg_1;
                    }
                    break sg_0;
                }
                pos = scan_multiplying_expression(tokens, pos, 0);
                if pos < 0 { break sg_0; }
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_multiplying_expression(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_pow_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _gale_kind_set_1(tokens[pos].kind) {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                let gp_3 = pos;
                sg_3: {
                    pos = gp_3;
                    sg_3_0: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_TIMES { break sg_3_0; }
                        pos += 1;
                        break sg_3;
                    }
                    pos = gp_3;
                    sg_3_1: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_DIV { break sg_3_1; }
                        pos += 1;
                        break sg_3;
                    }
                    break sg_2;
                }
                pos = scan_pow_expression(tokens, pos, 0);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_pow_expression(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_signed_atom(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_POW {
        let sp = pos;
        sg_4_done: {
            sg_4: {
                if pos >= tokens.len() || tokens[pos].kind != TK_POW { break sg_4; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, 0);
                if pos < 0 { break sg_4; }
                break sg_4_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_signed_atom(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_PLUS {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_PLUS { break try_0; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_MINUS {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_MINUS { break try_1; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_2(alt_kind) {
            pos = start;
            try_2: {
                pos = scan_func_(tokens, pos, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_3(alt_kind) {
            pos = start;
            try_3: {
                pos = scan_atom(tokens, pos, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_atom(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_SCIENTIFIC_NUMBER {
            pos = start;
            try_0: {
                pos = scan_scientific(tokens, pos, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_VARIABLE {
            pos = start;
            try_1: {
                pos = scan_variable(tokens, pos, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_4(alt_kind) {
            pos = start;
            try_2: {
                pos = scan_constant(tokens, pos, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LPAREN {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LPAREN { break try_3; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_3; }
                if pos >= tokens.len() || tokens[pos].kind != TK_RPAREN { break try_3; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_scientific(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_SCIENTIFIC_NUMBER { return -1; }
    pos += 1;
    return pos;
}

fn scan_constant(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_4(tokens[pos].kind) {
        return pos + 1;
    }
    return -1;
}

fn scan_variable(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_VARIABLE { return -1; }
    pos += 1;
    return pos;
}

fn scan_func_(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_funcname(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_LPAREN { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_COMMA {
        let sp = pos;
        sg_5_done: {
            sg_5: {
                if pos >= tokens.len() || tokens[pos].kind != TK_COMMA { break sg_5; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break sg_5; }
                break sg_5_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn scan_funcname(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_2(tokens[pos].kind) {
        return pos + 1;
    }
    return -1;
}

fn scan_relop(tokens: &Array<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_5(tokens[pos].kind) {
        return pos + 1;
    }
    return -1;
}

fn parse_equation(p: &mut Parser) -> Result<EquationNode, ParseError> {
    let start = p.peek().span.start;
    let expression = parse_expression(p)?;
    let relop = parse_relop(p)?;
    let expression_2 = parse_expression(p)?;
    let eof = p.expect(TK_EOF)?;
    return Result::<EquationNode, ParseError>::Ok(EquationNode {
        span: Span::new(start, p.last_end()),
        expression,
        relop,
        expression_2,
        eof,
    });
}

fn parse_expression(p: &mut Parser) -> Result<ExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let multiplying_expression = parse_multiplying_expression(p)?;
    let mut item_multiplying_expression_list: Array<ItemMultiplyingExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_6 = pos;
            sg_6: {
                pos = gp_6;
                sg_6_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_PLUS { break sg_6_0; }
                    pos += 1;
                    break sg_6;
                }
                pos = gp_6;
                sg_6_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_MINUS { break sg_6_1; }
                    pos += 1;
                    break sg_6;
                }
                break rep_scan;
            }
            pos = scan_multiplying_expression(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let plus_or_minus = p.advance();
        let multiplying_expression = parse_multiplying_expression(p)?;
        let item_multiplying_expression = ItemMultiplyingExpressionItem {
            plus_or_minus,
            multiplying_expression,
        };
        item_multiplying_expression_list.push(item_multiplying_expression);
    }
    return Result::<ExpressionNode, ParseError>::Ok(ExpressionNode {
        span: Span::new(start, p.last_end()),
        multiplying_expression,
        item_multiplying_expression_list,
    });
}

fn parse_multiplying_expression(p: &mut Parser) -> Result<MultiplyingExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let pow_expression = parse_pow_expression(p)?;
    let mut item_pow_expression_list: Array<ItemPowExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            let gp_7 = pos;
            sg_7: {
                pos = gp_7;
                sg_7_0: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_TIMES { break sg_7_0; }
                    pos += 1;
                    break sg_7;
                }
                pos = gp_7;
                sg_7_1: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_DIV { break sg_7_1; }
                    pos += 1;
                    break sg_7;
                }
                break rep_scan;
            }
            pos = scan_pow_expression(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let times_or_div = p.advance();
        let pow_expression = parse_pow_expression(p)?;
        let item_pow_expression = ItemPowExpressionItem {
            times_or_div,
            pow_expression,
        };
        item_pow_expression_list.push(item_pow_expression);
    }
    return Result::<MultiplyingExpressionNode, ParseError>::Ok(MultiplyingExpressionNode {
        span: Span::new(start, p.last_end()),
        pow_expression,
        item_pow_expression_list,
    });
}

fn parse_pow_expression(p: &mut Parser) -> Result<PowExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let signed_atom = parse_signed_atom(p)?;
    let mut pow_signed_atom_list: Array<PowSignedAtomItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_POW { break rep_scan; }
            pos += 1;
            pos = scan_signed_atom(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let pow = p.expect(TK_POW)?;
        let signed_atom = parse_signed_atom(p)?;
        let pow_signed_atom = PowSignedAtomItem {
            pow,
            signed_atom,
        };
        pow_signed_atom_list.push(pow_signed_atom);
    }
    return Result::<PowExpressionNode, ParseError>::Ok(PowExpressionNode {
        span: Span::new(start, p.last_end()),
        signed_atom,
        pow_signed_atom_list,
    });
}

fn parse_signed_atom(p: &mut Parser) -> Result<SignedAtomNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_PLUS {
        let plus = p.expect(TK_PLUS)?;
        let signed_atom = parse_signed_atom(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt0(SignedAtomAlt0 {
            span: Span::new(start, p.last_end()),
            plus,
            signed_atom,
        }));
    }
    if kind == TK_MINUS {
        let minus = p.expect(TK_MINUS)?;
        let signed_atom = parse_signed_atom(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt1(SignedAtomAlt1 {
            span: Span::new(start, p.last_end()),
            minus,
            signed_atom,
        }));
    }
    if _gale_kind_set_2(kind) {
        let func_ = parse_func_(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt2(SignedAtomAlt2 {
            span: Span::new(start, p.last_end()),
            func_,
        }));
    }
    if _gale_kind_set_3(kind) {
        let atom = parse_atom(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt3(SignedAtomAlt3 {
            span: Span::new(start, p.last_end()),
            atom,
        }));
    }
    return Result::<SignedAtomNode, ParseError>::Err(ParseError::new(
        "expected signedAtom",
        p.peek().span,
        ["TK_PLUS", "TK_MINUS", "TK_COS", "TK_TAN", "TK_SIN", "TK_ACOS", "TK_ATAN", "TK_ASIN", "TK_LOG", "TK_LN", "TK_SQRT", "TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    ));
}

fn parse_atom(p: &mut Parser) -> Result<AtomNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_SCIENTIFIC_NUMBER {
        let scientific = parse_scientific(p)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt0(AtomAlt0 {
            span: Span::new(start, p.last_end()),
            scientific,
        }));
    }
    if kind == TK_VARIABLE {
        let variable = parse_variable(p)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt1(AtomAlt1 {
            span: Span::new(start, p.last_end()),
            variable,
        }));
    }
    if _gale_kind_set_4(kind) {
        let constant = parse_constant(p)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt2(AtomAlt2 {
            span: Span::new(start, p.last_end()),
            constant,
        }));
    }
    if kind == TK_LPAREN {
        let lparen = p.expect(TK_LPAREN)?;
        let expression = parse_expression(p)?;
        let rparen = p.expect(TK_RPAREN)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt3(AtomAlt3 {
            span: Span::new(start, p.last_end()),
            lparen,
            expression,
            rparen,
        }));
    }
    return Result::<AtomNode, ParseError>::Err(ParseError::new(
        "expected atom",
        p.peek().span,
        ["TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    ));
}

fn parse_scientific(p: &mut Parser) -> Result<ScientificNode, ParseError> {
    let start = p.peek().span.start;
    let scientific_number = p.expect(TK_SCIENTIFIC_NUMBER)?;
    return Result::<ScientificNode, ParseError>::Ok(ScientificNode {
        span: Span::new(start, p.last_end()),
        scientific_number,
    });
}

fn parse_constant(p: &mut Parser) -> Result<ConstantNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_PI {
        let pi = p.expect(TK_PI)?;
        return Result::<ConstantNode, ParseError>::Ok(ConstantNode::Alt0(ConstantAlt0 {
            span: Span::new(start, p.last_end()),
            pi,
        }));
    }
    if kind == TK_EULER {
        let euler = p.expect(TK_EULER)?;
        return Result::<ConstantNode, ParseError>::Ok(ConstantNode::Alt1(ConstantAlt1 {
            span: Span::new(start, p.last_end()),
            euler,
        }));
    }
    if kind == TK_I {
        let i = p.expect(TK_I)?;
        return Result::<ConstantNode, ParseError>::Ok(ConstantNode::Alt2(ConstantAlt2 {
            span: Span::new(start, p.last_end()),
            i,
        }));
    }
    return Result::<ConstantNode, ParseError>::Err(ParseError::new(
        "expected constant",
        p.peek().span,
        ["TK_PI", "TK_EULER", "TK_I"],
    ));
}

fn parse_variable(p: &mut Parser) -> Result<VariableNode, ParseError> {
    let start = p.peek().span.start;
    let variable = p.expect(TK_VARIABLE)?;
    return Result::<VariableNode, ParseError>::Ok(VariableNode {
        span: Span::new(start, p.last_end()),
        variable,
    });
}

fn parse_func_(p: &mut Parser) -> Result<FuncNode, ParseError> {
    let start = p.peek().span.start;
    let funcname = parse_funcname(p)?;
    let lparen = p.expect(TK_LPAREN)?;
    let expression = parse_expression(p)?;
    let mut comma_expression_list: Array<CommaExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_COMMA { break rep_scan; }
            pos += 1;
            pos = scan_expression(tokens, pos, 0);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_COMMA)?;
        let expression = parse_expression(p)?;
        let comma_expression = CommaExpressionItem {
            comma,
            expression,
        };
        comma_expression_list.push(comma_expression);
    }
    let rparen = p.expect(TK_RPAREN)?;
    return Result::<FuncNode, ParseError>::Ok(FuncNode {
        span: Span::new(start, p.last_end()),
        funcname,
        lparen,
        expression,
        comma_expression_list,
        rparen,
    });
}

fn parse_funcname(p: &mut Parser) -> Result<FuncnameNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_COS {
        let cos = p.expect(TK_COS)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt0(FuncnameAlt0 {
            span: Span::new(start, p.last_end()),
            cos,
        }));
    }
    if kind == TK_TAN {
        let tan = p.expect(TK_TAN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt1(FuncnameAlt1 {
            span: Span::new(start, p.last_end()),
            tan,
        }));
    }
    if kind == TK_SIN {
        let sin = p.expect(TK_SIN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt2(FuncnameAlt2 {
            span: Span::new(start, p.last_end()),
            sin,
        }));
    }
    if kind == TK_ACOS {
        let acos = p.expect(TK_ACOS)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt3(FuncnameAlt3 {
            span: Span::new(start, p.last_end()),
            acos,
        }));
    }
    if kind == TK_ATAN {
        let atan = p.expect(TK_ATAN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt4(FuncnameAlt4 {
            span: Span::new(start, p.last_end()),
            atan,
        }));
    }
    if kind == TK_ASIN {
        let asin = p.expect(TK_ASIN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt5(FuncnameAlt5 {
            span: Span::new(start, p.last_end()),
            asin,
        }));
    }
    if kind == TK_LOG {
        let log = p.expect(TK_LOG)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt6(FuncnameAlt6 {
            span: Span::new(start, p.last_end()),
            log,
        }));
    }
    if kind == TK_LN {
        let ln = p.expect(TK_LN)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt7(FuncnameAlt7 {
            span: Span::new(start, p.last_end()),
            ln,
        }));
    }
    if kind == TK_SQRT {
        let sqrt = p.expect(TK_SQRT)?;
        return Result::<FuncnameNode, ParseError>::Ok(FuncnameNode::Alt8(FuncnameAlt8 {
            span: Span::new(start, p.last_end()),
            sqrt,
        }));
    }
    return Result::<FuncnameNode, ParseError>::Err(ParseError::new(
        "expected funcname",
        p.peek().span,
        ["TK_COS", "TK_TAN", "TK_SIN", "TK_ACOS", "TK_ATAN", "TK_ASIN", "TK_LOG", "TK_LN", "TK_SQRT"],
    ));
}

fn parse_relop(p: &mut Parser) -> Result<RelopNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_EQ {
        let eq = p.expect(TK_EQ)?;
        return Result::<RelopNode, ParseError>::Ok(RelopNode::Alt0(RelopAlt0 {
            span: Span::new(start, p.last_end()),
            eq,
        }));
    }
    if kind == TK_GT {
        let gt = p.expect(TK_GT)?;
        return Result::<RelopNode, ParseError>::Ok(RelopNode::Alt1(RelopAlt1 {
            span: Span::new(start, p.last_end()),
            gt,
        }));
    }
    if kind == TK_LT {
        let lt = p.expect(TK_LT)?;
        return Result::<RelopNode, ParseError>::Ok(RelopNode::Alt2(RelopAlt2 {
            span: Span::new(start, p.last_end()),
            lt,
        }));
    }
    return Result::<RelopNode, ParseError>::Err(ParseError::new(
        "expected relop",
        p.peek().span,
        ["TK_EQ", "TK_GT", "TK_LT"],
    ));
}

pub fn parse(input: &String) -> Result<EquationNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_equation(&mut parser);
}

pub fn walk_equation<V: Visitor>(v: &mut V, node: &EquationNode) {
    v.enter_rule(&"equation", &node.span);
    walk_expression(v, &node.expression);
    walk_relop(v, &node.relop);
    walk_expression(v, &node.expression_2);
    v.visit_token(&node.eof);
    v.exit_rule(&"equation", &node.span);
}

pub fn walk_expression<V: Visitor>(v: &mut V, node: &ExpressionNode) {
    v.enter_rule(&"expression", &node.span);
    walk_multiplyingExpression(v, &node.multiplying_expression);
    for let item of &node.item_multiplying_expression_list {
        v.visit_token(&item.plus_or_minus);
        walk_multiplyingExpression(v, &item.multiplying_expression);
    }
    v.exit_rule(&"expression", &node.span);
}

pub fn walk_multiplyingExpression<V: Visitor>(v: &mut V, node: &MultiplyingExpressionNode) {
    v.enter_rule(&"multiplyingExpression", &node.span);
    walk_powExpression(v, &node.pow_expression);
    for let item of &node.item_pow_expression_list {
        v.visit_token(&item.times_or_div);
        walk_powExpression(v, &item.pow_expression);
    }
    v.exit_rule(&"multiplyingExpression", &node.span);
}

pub fn walk_powExpression<V: Visitor>(v: &mut V, node: &PowExpressionNode) {
    v.enter_rule(&"powExpression", &node.span);
    walk_signedAtom(v, &node.signed_atom);
    for let item of &node.pow_signed_atom_list {
        v.visit_token(&item.pow);
        walk_signedAtom(v, &item.signed_atom);
    }
    v.exit_rule(&"powExpression", &node.span);
}

pub fn walk_signedAtom<V: Visitor>(v: &mut V, node: &SignedAtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"signedAtom", &n.span);
            v.visit_token(&n.plus);
            walk_signedAtom(v, &n.signed_atom);
            v.exit_rule(&"signedAtom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"signedAtom", &n.span);
            v.visit_token(&n.minus);
            walk_signedAtom(v, &n.signed_atom);
            v.exit_rule(&"signedAtom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"signedAtom", &n.span);
            walk_func_(v, &n.func_);
            v.exit_rule(&"signedAtom", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"signedAtom", &n.span);
            walk_atom(v, &n.atom);
            v.exit_rule(&"signedAtom", &n.span);
        }
    }
}

pub fn walk_atom<V: Visitor>(v: &mut V, node: &AtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"atom", &n.span);
            walk_scientific(v, &n.scientific);
            v.exit_rule(&"atom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"atom", &n.span);
            walk_variable(v, &n.variable);
            v.exit_rule(&"atom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"atom", &n.span);
            walk_constant(v, &n.constant);
            v.exit_rule(&"atom", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"atom", &n.span);
            v.visit_token(&n.lparen);
            walk_expression(v, &n.expression);
            v.visit_token(&n.rparen);
            v.exit_rule(&"atom", &n.span);
        }
    }
}

pub fn walk_scientific<V: Visitor>(v: &mut V, node: &ScientificNode) {
    v.enter_rule(&"scientific", &node.span);
    v.visit_token(&node.scientific_number);
    v.exit_rule(&"scientific", &node.span);
}

pub fn walk_constant<V: Visitor>(v: &mut V, node: &ConstantNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"constant", &n.span);
            v.visit_token(&n.pi);
            v.exit_rule(&"constant", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"constant", &n.span);
            v.visit_token(&n.euler);
            v.exit_rule(&"constant", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"constant", &n.span);
            v.visit_token(&n.i);
            v.exit_rule(&"constant", &n.span);
        }
    }
}

pub fn walk_variable<V: Visitor>(v: &mut V, node: &VariableNode) {
    v.enter_rule(&"variable", &node.span);
    v.visit_token(&node.variable);
    v.exit_rule(&"variable", &node.span);
}

pub fn walk_func_<V: Visitor>(v: &mut V, node: &FuncNode) {
    v.enter_rule(&"func_", &node.span);
    walk_funcname(v, &node.funcname);
    v.visit_token(&node.lparen);
    walk_expression(v, &node.expression);
    for let item of &node.comma_expression_list {
        v.visit_token(&item.comma);
        walk_expression(v, &item.expression);
    }
    v.visit_token(&node.rparen);
    v.exit_rule(&"func_", &node.span);
}

pub fn walk_funcname<V: Visitor>(v: &mut V, node: &FuncnameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.cos);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.tan);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.sin);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.acos);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.atan);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.asin);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.log);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.ln);
            v.exit_rule(&"funcname", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(&"funcname", &n.span);
            v.visit_token(&n.sqrt);
            v.exit_rule(&"funcname", &n.span);
        }
    }
}

pub fn walk_relop<V: Visitor>(v: &mut V, node: &RelopNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"relop", &n.span);
            v.visit_token(&n.eq);
            v.exit_rule(&"relop", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"relop", &n.span);
            v.visit_token(&n.gt);
            v.exit_rule(&"relop", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"relop", &n.span);
            v.visit_token(&n.lt);
            v.exit_rule(&"relop", &n.span);
        }
    }
}

pub fn to_tree(node: &EquationNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_equation(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_MINUS | TK_PLUS };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_DIV | TK_TIMES };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_ACOS | TK_ASIN | TK_ATAN | TK_COS | TK_LN | TK_LOG | TK_SIN | TK_SQRT | TK_TAN };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_LPAREN | TK_PI | TK_SCIENTIFIC_NUMBER | TK_VARIABLE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_PI };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_EQ | TK_GT | TK_LT };
}

