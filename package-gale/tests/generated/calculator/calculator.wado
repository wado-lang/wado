fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { return -1; }
    pos += 1;
    loop {
        let rep_saved_14 = pos;
        rep_14: {
            if pos >= chars.len() { break rep_14; }
            if !(chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { break rep_14; }
            pos += 1;
            continue;
        }
        pos = rep_saved_14;
        break;
    }
    return pos;
}

fn classify_keyword(chars: &List<char>, start: i32, end: i32) -> i32 {
    let len = end - start;
    if len == 1 {
        if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 0] == 'e' { return TK_EULER; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0] == 'i' { return TK_I; }
        }
    }
    return -1;
}

pub fn tokenize(input: &String) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_WS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '(' {
            end = try_LPAREN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LPAREN; }
        } else if first_char == ')' {
            end = try_RPAREN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_RPAREN; }
        } else if first_char == '*' {
            end = try_TIMES(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TIMES; }
        } else if first_char == '+' {
            end = try_PLUS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PLUS; }
        } else if first_char == ',' {
            end = try_COMMA(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMA; }
        } else if first_char == '-' {
            end = try_MINUS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MINUS; }
        } else if first_char == '.' {
            end = try_POINT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POINT; }
        } else if first_char == '/' {
            end = try_DIV(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DIV; }
        } else if first_char == '<' {
            end = try_LT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LT; }
        } else if first_char == '=' {
            end = try_EQ(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_EQ; }
        } else if first_char == '>' {
            end = try_GT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_GT; }
        } else if first_char == '^' {
            end = try_POW(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POW; }
        } else if first_char == '_' {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'a' {
            end = try_ACOS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ACOS; }
            end = try_ASIN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ASIN; }
            end = try_ATAN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ATAN; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'c' {
            end = try_COS(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COS; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'l' {
            end = try_LN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LN; }
            end = try_LOG(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LOG; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'p' {
            end = try_PI(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PI; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 's' {
            end = try_SIN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SIN; }
            end = try_SQRT(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SQRT; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 't' {
            end = try_TAN(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAN; }
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'a' <= first_char <= 'z' {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if '0' <= first_char <= '9' {
            end = try_SCIENTIFIC_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        } else {
            end = try_VARIABLE(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
            end = try_SCIENTIFIC_NUMBER(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        }
        if best_end > start {
            let kw_kind = classify_keyword(&lexer.chars, start, best_end);
            if kw_kind >= 0 { best_kind = kw_kind; }
        }
        if best_end <= start {
            ts.push_token(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark());
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_COS => "COS",
        TK_SIN => "SIN",
        TK_TAN => "TAN",
        TK_ACOS => "ACOS",
        TK_ASIN => "ASIN",
        TK_ATAN => "ATAN",
        TK_LN => "LN",
        TK_LOG => "LOG",
        TK_SQRT => "SQRT",
        TK_LPAREN => "LPAREN",
        TK_RPAREN => "RPAREN",
        TK_PLUS => "PLUS",
        TK_MINUS => "MINUS",
        TK_TIMES => "TIMES",
        TK_DIV => "DIV",
        TK_GT => "GT",
        TK_LT => "LT",
        TK_EQ => "EQ",
        TK_COMMA => "COMMA",
        TK_POINT => "POINT",
        TK_POW => "POW",
        TK_PI => "PI",
        TK_EULER => "EULER",
        TK_I => "I",
        TK_VARIABLE => "VARIABLE",
        TK_SCIENTIFIC_NUMBER => "SCIENTIFIC_NUMBER",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(self.tokens.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(e);
        }
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32) -> Result<i32, ParseError> {
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                return Result::Ok(self.pos);
            }
            return Result::Ok(self.advance());
        }
        let name = token_kind_name(kind);
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<i32, ParseError> {
        return Result::Err(self.error(
            `expected {name}, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<i32, ParseError> {
        if self.kinds[self.pos] != TK_EOF {
            return Result::Ok(self.advance());
        }
        return Result::Err(self.error(
            `expected any token, got "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<i32, ParseError> {
        let k = self.kinds[self.pos];
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::Ok(self.pos);
                }
                return Result::Ok(self.advance());
            }
        }
        return Result::Err(self.error(
            `unexpected token "{self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            ["token set"],
        ));
    }
}

fn scan_equation(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_expression(tokens, pos, &FOLLOW_MASK_0, 0);
    if pos < 0 { return -1; }
    pos = scan_relop(tokens, pos, &FOLLOW_MASK_1, 0);
    if pos < 0 { return -1; }
    pos = scan_expression(tokens, pos, &FOLLOW_MASK_2, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_multiplying_expression(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos]) && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                let gp_1 = pos;
                sg_1: {
                    pos = gp_1;
                    sg_1_0: {
                        if pos >= tokens.len() || tokens[pos] != TK_PLUS { break sg_1_0; }
                        pos += 1;
                        break sg_1;
                    }
                    pos = gp_1;
                    sg_1_1: {
                        if pos >= tokens.len() || tokens[pos] != TK_MINUS { break sg_1_1; }
                        pos += 1;
                        break sg_1;
                    }
                    break sg_0;
                }
                pos = scan_multiplying_expression(tokens, pos, follow, 0);
                if pos < 0 { break sg_0; }
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_multiplying_expression(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_pow_expression(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _gale_kind_set_1(tokens[pos]) && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                let gp_3 = pos;
                sg_3: {
                    pos = gp_3;
                    sg_3_0: {
                        if pos >= tokens.len() || tokens[pos] != TK_TIMES { break sg_3_0; }
                        pos += 1;
                        break sg_3;
                    }
                    pos = gp_3;
                    sg_3_1: {
                        if pos >= tokens.len() || tokens[pos] != TK_DIV { break sg_3_1; }
                        pos += 1;
                        break sg_3;
                    }
                    break sg_2;
                }
                pos = scan_pow_expression(tokens, pos, follow, 0);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_pow_expression(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_signed_atom(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_POW && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_4_done: {
            sg_4: {
                if pos >= tokens.len() || tokens[pos] != TK_POW { break sg_4; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, follow, 0);
                if pos < 0 { break sg_4; }
                break sg_4_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_signed_atom(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_PLUS {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos] != TK_PLUS { break try_0; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, follow, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_MINUS {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos] != TK_MINUS { break try_1; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, follow, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_2(alt_kind) {
            pos = start;
            try_2: {
                pos = scan_func_(tokens, pos, follow, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_3(alt_kind) {
            pos = start;
            try_3: {
                pos = scan_atom(tokens, pos, follow, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_atom(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_SCIENTIFIC_NUMBER {
            pos = start;
            try_0: {
                pos = scan_scientific(tokens, pos, follow, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_VARIABLE {
            pos = start;
            try_1: {
                pos = scan_variable(tokens, pos, follow, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_4(alt_kind) {
            pos = start;
            try_2: {
                pos = scan_constant(tokens, pos, follow, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LPAREN {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos] != TK_LPAREN { break try_3; }
                pos += 1;
                pos = scan_expression(tokens, pos, &FOLLOW_MASK_3, 0);
                if pos < 0 { break try_3; }
                if pos >= tokens.len() || tokens[pos] != TK_RPAREN { break try_3; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_scientific(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_SCIENTIFIC_NUMBER { return -1; }
    pos += 1;
    return pos;
}

fn scan_constant(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_4(tokens[pos]) {
        return pos + 1;
    }
    return -1;
}

fn scan_variable(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_VARIABLE { return -1; }
    pos += 1;
    return pos;
}

fn scan_func_(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_funcname(tokens, pos, &FOLLOW_MASK_4, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_LPAREN { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, &FOLLOW_MASK_5, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_COMMA {
        let sp = pos;
        sg_5_done: {
            sg_5: {
                if pos >= tokens.len() || tokens[pos] != TK_COMMA { break sg_5; }
                pos += 1;
                pos = scan_expression(tokens, pos, follow, 0);
                if pos < 0 { break sg_5; }
                break sg_5_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn scan_funcname(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_2(tokens[pos]) {
        return pos + 1;
    }
    return -1;
}

fn scan_relop(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_5(tokens[pos]) {
        return pos + 1;
    }
    return -1;
}

fn _parse_equation__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<EquationNode, ParseError> {
    let start = p.peek_start();
    let expression = _parse_expression(p, &FOLLOW_MASK_0)?;
    let relop = _parse_relop(p, &FOLLOW_MASK_1)?;
    let expression_2 = _parse_expression(p, &FOLLOW_MASK_2)?;
    let eof = p.expect(TK_EOF)?;
    return Result::Ok(EquationNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        expression,
        relop,
        expression_2,
        eof,
    });
}

fn _parse_equation(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<EquationNode, ParseError> {
    return _gale_rule(_parse_equation__inner(p, follow), "equation");
}

fn _parse_expression__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ExpressionNode, ParseError> {
    let start = p.peek_start();
    let multiplying_expression = _parse_multiplying_expression(p, follow)?;
    let mut item_multiplying_expression_list: List<ItemMultiplyingExpressionItem> = [];
    loop {
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_6_done: {
                sg_6: {
                    let gp_7 = pos;
                    sg_7: {
                        pos = gp_7;
                        sg_7_0: {
                            if pos >= tokens.len() || tokens[pos] != TK_PLUS { break sg_7_0; }
                            pos += 1;
                            break sg_7;
                        }
                        pos = gp_7;
                        sg_7_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_MINUS { break sg_7_1; }
                            pos += 1;
                            break sg_7;
                        }
                        break sg_6;
                    }
                    pos = scan_multiplying_expression(tokens, pos, follow, 0);
                    if pos < 0 { break sg_6; }
                    break sg_6_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let plus_or_minus = p.match_set([TK_PLUS, TK_MINUS])?;
        let multiplying_expression = _parse_multiplying_expression(p, follow)?;
        let item_multiplying_expression = ItemMultiplyingExpressionItem {
            plus_or_minus,
            multiplying_expression,
        };
        item_multiplying_expression_list.push(item_multiplying_expression);
    }
    return Result::Ok(ExpressionNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        multiplying_expression,
        item_multiplying_expression_list,
    });
}

fn _parse_expression(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ExpressionNode, ParseError> {
    return _gale_rule(_parse_expression__inner(p, follow), "expression");
}

fn _parse_multiplying_expression__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<MultiplyingExpressionNode, ParseError> {
    let start = p.peek_start();
    let pow_expression = _parse_pow_expression(p, follow)?;
    let mut item_pow_expression_list: List<ItemPowExpressionItem> = [];
    loop {
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_8_done: {
                sg_8: {
                    let gp_9 = pos;
                    sg_9: {
                        pos = gp_9;
                        sg_9_0: {
                            if pos >= tokens.len() || tokens[pos] != TK_TIMES { break sg_9_0; }
                            pos += 1;
                            break sg_9;
                        }
                        pos = gp_9;
                        sg_9_1: {
                            if pos >= tokens.len() || tokens[pos] != TK_DIV { break sg_9_1; }
                            pos += 1;
                            break sg_9;
                        }
                        break sg_8;
                    }
                    pos = scan_pow_expression(tokens, pos, follow, 0);
                    if pos < 0 { break sg_8; }
                    break sg_8_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let times_or_div = p.match_set([TK_TIMES, TK_DIV])?;
        let pow_expression = _parse_pow_expression(p, follow)?;
        let item_pow_expression = ItemPowExpressionItem {
            times_or_div,
            pow_expression,
        };
        item_pow_expression_list.push(item_pow_expression);
    }
    return Result::Ok(MultiplyingExpressionNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        pow_expression,
        item_pow_expression_list,
    });
}

fn _parse_multiplying_expression(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<MultiplyingExpressionNode, ParseError> {
    return _gale_rule(_parse_multiplying_expression__inner(p, follow), "multiplyingExpression");
}

fn _parse_pow_expression__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PowExpressionNode, ParseError> {
    let start = p.peek_start();
    let signed_atom = _parse_signed_atom(p, follow)?;
    let mut pow_signed_atom_list: List<PowSignedAtomItem> = [];
    loop {
        if follow_yields(&p.kinds, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_10_done: {
                sg_10: {
                    if pos >= tokens.len() || tokens[pos] != TK_POW { break sg_10; }
                    pos += 1;
                    pos = scan_signed_atom(tokens, pos, follow, 0);
                    if pos < 0 { break sg_10; }
                    break sg_10_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let pow = p.expect(TK_POW)?;
        let signed_atom = _parse_signed_atom(p, follow)?;
        let pow_signed_atom = PowSignedAtomItem {
            pow,
            signed_atom,
        };
        pow_signed_atom_list.push(pow_signed_atom);
    }
    return Result::Ok(PowExpressionNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        signed_atom,
        pow_signed_atom_list,
    });
}

fn _parse_pow_expression(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<PowExpressionNode, ParseError> {
    return _gale_rule(_parse_pow_expression__inner(p, follow), "powExpression");
}

fn _parse_signed_atom__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<SignedAtomNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_PLUS {
        let plus = p.expect(TK_PLUS)?;
        let signed_atom = _parse_signed_atom(p, follow)?;
        return Result::Ok(SignedAtomNode::Alt0(SignedAtomAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            plus,
            signed_atom,
        }));
    }
    if kind == TK_MINUS {
        let minus = p.expect(TK_MINUS)?;
        let signed_atom = _parse_signed_atom(p, follow)?;
        return Result::Ok(SignedAtomNode::Alt1(SignedAtomAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            minus,
            signed_atom,
        }));
    }
    if _gale_kind_set_2(kind) {
        let func_ = _parse_func_(p, follow)?;
        return Result::Ok(SignedAtomNode::Alt2(SignedAtomAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            func_,
        }));
    }
    if _gale_kind_set_3(kind) {
        let atom = _parse_atom(p, follow)?;
        return Result::Ok(SignedAtomNode::Alt3(SignedAtomAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            atom,
        }));
    }
    return Result::Err(p.error(
        "expected signedAtom",
        p.peek_span(),
        ["TK_PLUS", "TK_MINUS", "TK_COS", "TK_TAN", "TK_SIN", "TK_ACOS", "TK_ATAN", "TK_ASIN", "TK_LOG", "TK_LN", "TK_SQRT", "TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    ));
}

fn _parse_signed_atom(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<SignedAtomNode, ParseError> {
    return _gale_rule(_parse_signed_atom__inner(p, follow), "signedAtom");
}

fn _parse_atom__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<AtomNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if kind == TK_SCIENTIFIC_NUMBER {
        let scientific = _parse_scientific(p, follow)?;
        return Result::Ok(AtomNode::Alt0(AtomAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            scientific,
        }));
    }
    if kind == TK_VARIABLE {
        let variable = _parse_variable(p, follow)?;
        return Result::Ok(AtomNode::Alt1(AtomAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            variable,
        }));
    }
    if _gale_kind_set_4(kind) {
        let constant = _parse_constant(p, follow)?;
        return Result::Ok(AtomNode::Alt2(AtomAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            constant,
        }));
    }
    if kind == TK_LPAREN {
        let lparen = p.expect(TK_LPAREN)?;
        let expression = _parse_expression(p, &FOLLOW_MASK_3)?;
        let rparen = p.expect(TK_RPAREN)?;
        return Result::Ok(AtomNode::Alt3(AtomAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lparen,
            expression,
            rparen,
        }));
    }
    return Result::Err(p.error(
        "expected atom",
        p.peek_span(),
        ["TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    ));
}

fn _parse_atom(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<AtomNode, ParseError> {
    return _gale_rule(_parse_atom__inner(p, follow), "atom");
}

fn _parse_scientific__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ScientificNode, ParseError> {
    let start = p.peek_start();
    let scientific_number = p.expect(TK_SCIENTIFIC_NUMBER)?;
    return Result::Ok(ScientificNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        scientific_number,
    });
}

fn _parse_scientific(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ScientificNode, ParseError> {
    return _gale_rule(_parse_scientific__inner(p, follow), "scientific");
}

fn _parse_constant__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ConstantNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _gale_kind_set_4(kind) {
        let token = p.expect(kind)?;
        return Result::Ok(ConstantNode {
            span: Span::new(start, i32::max(start, p.last_end())),
            token,
        });
    }
    return Result::Err(p.error(
        "expected constant",
        p.peek_span(),
        ["TK_PI", "TK_EULER", "TK_I"],
    ));
}

fn _parse_constant(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<ConstantNode, ParseError> {
    return _gale_rule(_parse_constant__inner(p, follow), "constant");
}

fn _parse_variable__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<VariableNode, ParseError> {
    let start = p.peek_start();
    let variable = p.expect(TK_VARIABLE)?;
    return Result::Ok(VariableNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        variable,
    });
}

fn _parse_variable(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<VariableNode, ParseError> {
    return _gale_rule(_parse_variable__inner(p, follow), "variable");
}

fn _parse_func___inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<FuncNode, ParseError> {
    let start = p.peek_start();
    let funcname = _parse_funcname(p, &FOLLOW_MASK_4)?;
    let lparen = p.expect(TK_LPAREN)?;
    let expression = _parse_expression(p, &FOLLOW_MASK_5)?;
    let mut comma_expression_list: List<CommaExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.kinds;
            let mut pos: i32 = p.pos;
            sg_11_done: {
                sg_11: {
                    if pos >= tokens.len() || tokens[pos] != TK_COMMA { break sg_11; }
                    pos += 1;
                    pos = scan_expression(tokens, pos, follow, 0);
                    if pos < 0 { break sg_11; }
                    break sg_11_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_COMMA)?;
        let expression = _parse_expression(p, follow)?;
        let comma_expression = CommaExpressionItem {
            comma,
            expression,
        };
        comma_expression_list.push(comma_expression);
    }
    let rparen = p.expect(TK_RPAREN)?;
    return Result::Ok(FuncNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        funcname,
        lparen,
        expression,
        comma_expression_list,
        rparen,
    });
}

fn _parse_func_(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<FuncNode, ParseError> {
    return _gale_rule(_parse_func___inner(p, follow), "func_");
}

fn _parse_funcname__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<FuncnameNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _gale_kind_set_2(kind) {
        let token = p.expect(kind)?;
        return Result::Ok(FuncnameNode {
            span: Span::new(start, i32::max(start, p.last_end())),
            token,
        });
    }
    return Result::Err(p.error(
        "expected funcname",
        p.peek_span(),
        ["TK_COS", "TK_TAN", "TK_SIN", "TK_ACOS", "TK_ATAN", "TK_ASIN", "TK_LOG", "TK_LN", "TK_SQRT"],
    ));
}

fn _parse_funcname(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<FuncnameNode, ParseError> {
    return _gale_rule(_parse_funcname__inner(p, follow), "funcname");
}

fn _parse_relop__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<RelopNode, ParseError> {
    let start = p.peek_start();
    let kind = p.peek_kind();
    if _gale_kind_set_5(kind) {
        let token = p.expect(kind)?;
        return Result::Ok(RelopNode {
            span: Span::new(start, i32::max(start, p.last_end())),
            token,
        });
    }
    return Result::Err(p.error(
        "expected relop",
        p.peek_span(),
        ["TK_EQ", "TK_GT", "TK_LT"],
    ));
}

fn _parse_relop(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<RelopNode, ParseError> {
    return _gale_rule(_parse_relop__inner(p, follow), "relop");
}

fn _gale_rule<T>(r: Result<T, ParseError>, rule: String) -> Result<T, ParseError> {
    if let Err(mut e) = r {
        e.rule_stack.push(rule);
        return Result::Err(e);
    }
    return r;
}

fn _gale_run<T>(input: &String, run: fn(&mut Parser) -> Result<T, ParseError>) -> Result<ParseResult<T>, ParseError> {
    let mut parser = _gale_new_parser(input);
    let _result = run(&mut parser);
    if let Err(_e) = _result {
        return Result::Err(_gale_pick_error(&parser, _e));
    }
    if let Ok(_root) = _result {
        return Result::Ok(ParseResult { root: _root, tokens: parser.tokens });
    }
    unreachable();
}

fn _gale_new_parser(input: &String) -> Parser {
    let tokens = tokenize(input);
    return Parser::new(tokens);
}

fn _gale_pick_error(parser: &Parser, e: ParseError) -> ParseError {
    if let Some(_d) = &parser.pending {
        if _d.span.start >= e.span.start {
            return *_d;
        }
    }
    return e;
}

pub fn parse_equation(input: &String) -> Result<ParseResult<EquationNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_equation(p));
}

pub fn parse_expression(input: &String) -> Result<ParseResult<ExpressionNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_expression(p));
}

pub fn parse_multiplying_expression(input: &String) -> Result<ParseResult<MultiplyingExpressionNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_multiplying_expression(p));
}

pub fn parse_pow_expression(input: &String) -> Result<ParseResult<PowExpressionNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_pow_expression(p));
}

pub fn parse_signed_atom(input: &String) -> Result<ParseResult<SignedAtomNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_signed_atom(p));
}

pub fn parse_atom(input: &String) -> Result<ParseResult<AtomNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_atom(p));
}

pub fn parse_scientific(input: &String) -> Result<ParseResult<ScientificNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_scientific(p));
}

pub fn parse_constant(input: &String) -> Result<ParseResult<ConstantNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_constant(p));
}

pub fn parse_variable(input: &String) -> Result<ParseResult<VariableNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_variable(p));
}

pub fn parse_func_(input: &String) -> Result<ParseResult<FuncNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_func_(p));
}

pub fn parse_funcname(input: &String) -> Result<ParseResult<FuncnameNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_funcname(p));
}

pub fn parse_relop(input: &String) -> Result<ParseResult<RelopNode>, ParseError> {
    return _gale_run(input, |p: &mut Parser| _parse_relop(p));
}

pub fn parse(input: &String) -> Result<ParseResult<EquationNode>, ParseError> {
    return parse_equation(input);
}

pub fn walk_equation<V: Visitor>(v: &mut V, toks: &TokenStream, node: &EquationNode) {
    v.enter_rule(0, &"equation", &node.span);
    walk_expression(v, toks, &node.expression);
    walk_relop(v, toks, &node.relop);
    walk_expression(v, toks, &node.expression_2);
    v.visit_token(toks, *(&node.eof));
    v.exit_rule(0, &"equation", &node.span);
}

pub fn walk_expression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ExpressionNode) {
    v.enter_rule(1, &"expression", &node.span);
    walk_multiplyingExpression(v, toks, &node.multiplying_expression);
    for let item of &node.item_multiplying_expression_list {
        v.visit_token(toks, *(&item.plus_or_minus));
        walk_multiplyingExpression(v, toks, &item.multiplying_expression);
    }
    v.exit_rule(1, &"expression", &node.span);
}

pub fn walk_multiplyingExpression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &MultiplyingExpressionNode) {
    v.enter_rule(2, &"multiplyingExpression", &node.span);
    walk_powExpression(v, toks, &node.pow_expression);
    for let item of &node.item_pow_expression_list {
        v.visit_token(toks, *(&item.times_or_div));
        walk_powExpression(v, toks, &item.pow_expression);
    }
    v.exit_rule(2, &"multiplyingExpression", &node.span);
}

pub fn walk_powExpression<V: Visitor>(v: &mut V, toks: &TokenStream, node: &PowExpressionNode) {
    v.enter_rule(3, &"powExpression", &node.span);
    walk_signedAtom(v, toks, &node.signed_atom);
    for let item of &node.pow_signed_atom_list {
        v.visit_token(toks, *(&item.pow));
        walk_signedAtom(v, toks, &item.signed_atom);
    }
    v.exit_rule(3, &"powExpression", &node.span);
}

pub fn walk_signedAtom<V: Visitor>(v: &mut V, toks: &TokenStream, node: &SignedAtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            v.visit_token(toks, *(&n.plus));
            walk_signedAtom(v, toks, &n.signed_atom);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            v.visit_token(toks, *(&n.minus));
            walk_signedAtom(v, toks, &n.signed_atom);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            walk_func_(v, toks, &n.func_);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            walk_atom(v, toks, &n.atom);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
    }
}

pub fn walk_atom<V: Visitor>(v: &mut V, toks: &TokenStream, node: &AtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(5, &"atom", &n.span);
            walk_scientific(v, toks, &n.scientific);
            v.exit_rule(5, &"atom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(5, &"atom", &n.span);
            walk_variable(v, toks, &n.variable);
            v.exit_rule(5, &"atom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(5, &"atom", &n.span);
            walk_constant(v, toks, &n.constant);
            v.exit_rule(5, &"atom", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(5, &"atom", &n.span);
            v.visit_token(toks, *(&n.lparen));
            walk_expression(v, toks, &n.expression);
            v.visit_token(toks, *(&n.rparen));
            v.exit_rule(5, &"atom", &n.span);
        }
    }
}

pub fn walk_scientific<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ScientificNode) {
    v.enter_rule(6, &"scientific", &node.span);
    v.visit_token(toks, *(&node.scientific_number));
    v.exit_rule(6, &"scientific", &node.span);
}

pub fn walk_constant<V: Visitor>(v: &mut V, toks: &TokenStream, node: &ConstantNode) {
    v.enter_rule(7, &"constant", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(7, &"constant", &node.span);
}

pub fn walk_variable<V: Visitor>(v: &mut V, toks: &TokenStream, node: &VariableNode) {
    v.enter_rule(8, &"variable", &node.span);
    v.visit_token(toks, *(&node.variable));
    v.exit_rule(8, &"variable", &node.span);
}

pub fn walk_func_<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FuncNode) {
    v.enter_rule(9, &"func_", &node.span);
    walk_funcname(v, toks, &node.funcname);
    v.visit_token(toks, *(&node.lparen));
    walk_expression(v, toks, &node.expression);
    for let item of &node.comma_expression_list {
        v.visit_token(toks, *(&item.comma));
        walk_expression(v, toks, &item.expression);
    }
    v.visit_token(toks, *(&node.rparen));
    v.exit_rule(9, &"func_", &node.span);
}

pub fn walk_funcname<V: Visitor>(v: &mut V, toks: &TokenStream, node: &FuncnameNode) {
    v.enter_rule(10, &"funcname", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(10, &"funcname", &node.span);
}

pub fn walk_relop<V: Visitor>(v: &mut V, toks: &TokenStream, node: &RelopNode) {
    v.enter_rule(11, &"relop", &node.span);
    v.visit_token(toks, node.token);
    v.exit_rule(11, &"relop", &node.span);
}

pub fn to_tree(result: &ParseResult<EquationNode>) -> CstNode {
    let mut recorder = TreeRecorder::new(&result.tokens);
    walk_equation(&mut recorder, &result.tokens, &result.root);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_MINUS | TK_PLUS };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_DIV | TK_TIMES };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_ACOS | TK_ASIN | TK_ATAN | TK_COS | TK_LN | TK_LOG | TK_SIN | TK_SQRT | TK_TAN };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_LPAREN | TK_PI | TK_SCIENTIFIC_NUMBER | TK_VARIABLE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_PI };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_EQ | TK_GT | TK_LT };
}

global FOLLOW_MASK_0: List<List<i32>> = [[TK_EQ, TK_GT, TK_LT]];
global FOLLOW_MASK_1: List<List<i32>> = [[TK_ACOS, TK_ASIN, TK_ATAN, TK_COS, TK_EULER, TK_I, TK_LN, TK_LOG, TK_LPAREN, TK_MINUS, TK_PI, TK_PLUS, TK_SCIENTIFIC_NUMBER, TK_SIN, TK_SQRT, TK_TAN, TK_VARIABLE]];
global FOLLOW_MASK_2: List<List<i32>> = [[TK_EOF]];
global FOLLOW_MASK_3: List<List<i32>> = [[TK_RPAREN]];
global FOLLOW_MASK_4: List<List<i32>> = [[TK_LPAREN]];
global FOLLOW_MASK_5: List<List<i32>> = [[TK_COMMA, TK_RPAREN]];

