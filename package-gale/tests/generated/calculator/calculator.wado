fn _parse_func___inner(p: &mut Parser) -> Result<FuncNode, ParseError> {
    let start = p.peek().span.start;
    let funcname = _parse_funcname(p)?;
    let lparen = p.expect(TK_LPAREN)?;
    let expression = _parse_expression(p)?;
    let mut comma_expression_list: List<CommaExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            sg_11_done: {
                sg_11: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_COMMA { break sg_11; }
                    pos += 1;
                    pos = scan_expression(tokens, pos, 0);
                    if pos < 0 { break sg_11; }
                    break sg_11_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_COMMA)?;
        let expression = _parse_expression(p)?;
        let comma_expression = CommaExpressionItem {
            comma,
            expression,
        };
        comma_expression_list.push(comma_expression);
    }
    let rparen = p.expect(TK_RPAREN)?;
    return Result::<FuncNode, ParseError>::Ok(FuncNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        funcname,
        lparen,
        expression,
        comma_expression_list,
        rparen,
    });
}

