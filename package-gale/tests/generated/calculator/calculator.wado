    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '>' { return -1; }
    pos += 1;
    return pos;
}

fn try_lt(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '<' { return -1; }
