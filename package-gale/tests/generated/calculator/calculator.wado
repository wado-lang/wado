    }
    return r;
}

pub fn parse_equation(input: &String) -> Result<EquationNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_equation(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<EquationNode, ParseError>::Err(_d);
            }
        }
        return Result::<EquationNode, ParseError>::Err(_e);
    }
    return _result;
}

