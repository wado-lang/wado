        }));
    }
    if kind == TK_GT {
        let gt = p.expect(TK_GT)?;
        return Result::<RelopNode, ParseError>::Ok(RelopNode::Alt1(RelopAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            gt,
        }));
    }
    if kind == TK_LT {
        let lt = p.expect(TK_LT)?;
        return Result::<RelopNode, ParseError>::Ok(RelopNode::Alt2(RelopAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lt,
        }));
    }
    return Result::<RelopNode, ParseError>::Err(p.error(
        "expected relop",
        p.peek().span,
        ["TK_EQ", "TK_GT", "TK_LT"],
    ));
}

