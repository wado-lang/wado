pub fn parse(input: &String) -> Result<EquationNode, ParseError> {
    return parse_equation(input);
}

pub fn walk_equation<V: Visitor>(v: &mut V, node: &EquationNode) {
    v.enter_rule(0, &"equation", &node.span);
    walk_expression(v, &node.expression);
    walk_relop(v, &node.relop);
    walk_expression(v, &node.expression_2);
    v.visit_token(&node.eof);
    v.exit_rule(0, &"equation", &node.span);
}

pub fn walk_expression<V: Visitor>(v: &mut V, node: &ExpressionNode) {
    v.enter_rule(1, &"expression", &node.span);
    walk_multiplyingExpression(v, &node.multiplying_expression);
    for let item of &node.item_multiplying_expression_list {
        v.visit_token(&item.plus_or_minus);
        walk_multiplyingExpression(v, &item.multiplying_expression);
    }
    v.exit_rule(1, &"expression", &node.span);
}

pub fn walk_multiplyingExpression<V: Visitor>(v: &mut V, node: &MultiplyingExpressionNode) {
    v.enter_rule(2, &"multiplyingExpression", &node.span);
    walk_powExpression(v, &node.pow_expression);
    for let item of &node.item_pow_expression_list {
        v.visit_token(&item.times_or_div);
        walk_powExpression(v, &item.pow_expression);
    }
    v.exit_rule(2, &"multiplyingExpression", &node.span);
}

pub fn walk_powExpression<V: Visitor>(v: &mut V, node: &PowExpressionNode) {
    v.enter_rule(3, &"powExpression", &node.span);
    walk_signedAtom(v, &node.signed_atom);
    for let item of &node.pow_signed_atom_list {
        v.visit_token(&item.pow);
        walk_signedAtom(v, &item.signed_atom);
    }
    v.exit_rule(3, &"powExpression", &node.span);
}

pub fn walk_signedAtom<V: Visitor>(v: &mut V, node: &SignedAtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            v.visit_token(&n.plus);
            walk_signedAtom(v, &n.signed_atom);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            v.visit_token(&n.minus);
            walk_signedAtom(v, &n.signed_atom);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            walk_func_(v, &n.func_);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(4, &"signedAtom", &n.span);
            walk_atom(v, &n.atom);
            v.exit_rule(4, &"signedAtom", &n.span);
        }
    }
}

pub fn walk_atom<V: Visitor>(v: &mut V, node: &AtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(5, &"atom", &n.span);
            walk_scientific(v, &n.scientific);
            v.exit_rule(5, &"atom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(5, &"atom", &n.span);
            walk_variable(v, &n.variable);
            v.exit_rule(5, &"atom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(5, &"atom", &n.span);
            walk_constant(v, &n.constant);
            v.exit_rule(5, &"atom", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(5, &"atom", &n.span);
            v.visit_token(&n.lparen);
            walk_expression(v, &n.expression);
            v.visit_token(&n.rparen);
            v.exit_rule(5, &"atom", &n.span);
        }
    }
}

pub fn walk_scientific<V: Visitor>(v: &mut V, node: &ScientificNode) {
    v.enter_rule(6, &"scientific", &node.span);
    v.visit_token(&node.scientific_number);
    v.exit_rule(6, &"scientific", &node.span);
}

pub fn walk_constant<V: Visitor>(v: &mut V, node: &ConstantNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(7, &"constant", &n.span);
            v.visit_token(&n.pi);
            v.exit_rule(7, &"constant", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(7, &"constant", &n.span);
            v.visit_token(&n.euler);
            v.exit_rule(7, &"constant", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(7, &"constant", &n.span);
            v.visit_token(&n.i);
            v.exit_rule(7, &"constant", &n.span);
        }
    }
}

pub fn walk_variable<V: Visitor>(v: &mut V, node: &VariableNode) {
    v.enter_rule(8, &"variable", &node.span);
    v.visit_token(&node.variable);
    v.exit_rule(8, &"variable", &node.span);
}

pub fn walk_func_<V: Visitor>(v: &mut V, node: &FuncNode) {
    v.enter_rule(9, &"func_", &node.span);
    walk_funcname(v, &node.funcname);
    v.visit_token(&node.lparen);
    walk_expression(v, &node.expression);
    for let item of &node.comma_expression_list {
        v.visit_token(&item.comma);
        walk_expression(v, &item.expression);
    }
    v.visit_token(&node.rparen);
    v.exit_rule(9, &"func_", &node.span);
}

pub fn walk_funcname<V: Visitor>(v: &mut V, node: &FuncnameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.cos);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.tan);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.sin);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.acos);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.atan);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.asin);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.log);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.ln);
            v.exit_rule(10, &"funcname", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(10, &"funcname", &n.span);
            v.visit_token(&n.sqrt);
            v.exit_rule(10, &"funcname", &n.span);
        }
    }
}

pub fn walk_relop<V: Visitor>(v: &mut V, node: &RelopNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(11, &"relop", &n.span);
            v.visit_token(&n.eq);
            v.exit_rule(11, &"relop", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(11, &"relop", &n.span);
            v.visit_token(&n.gt);
            v.exit_rule(11, &"relop", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(11, &"relop", &n.span);
            v.visit_token(&n.lt);
            v.exit_rule(11, &"relop", &n.span);
        }
    }
}

pub fn to_tree(node: &EquationNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_equation(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_MINUS | TK_PLUS };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_DIV | TK_TIMES };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_ACOS | TK_ASIN | TK_ATAN | TK_COS | TK_LN | TK_LOG | TK_SIN | TK_SQRT | TK_TAN };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_LPAREN | TK_PI | TK_SCIENTIFIC_NUMBER | TK_VARIABLE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_EULER | TK_I | TK_PI };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_EQ | TK_GT | TK_LT };
}

