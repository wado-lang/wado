fn try_variable(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_0 = pos;
    let mut alts_ok_0 = false;
    alts_0_0: {
        pos = alts_saved_0;
        if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_0_0; }
        pos += 1;
        alts_ok_0 = true;
    }
    if !alts_ok_0 {
        alts_0_1: {
            pos = alts_saved_0;
            if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_0_1; }
            pos += 1;
            alts_ok_0 = true;
        }
        if !alts_ok_0 {
            alts_0_2: {
                pos = alts_saved_0;
                if pos >= chars.len() || chars[pos] != '_' { break alts_0_2; }
                pos += 1;
                alts_ok_0 = true;
            }
        }
    }
    if !alts_ok_0 { return -1; }
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            let alts_saved_2 = pos;
            let mut alts_ok_2 = false;
            alts_2_0: {
                pos = alts_saved_2;
                let alts_saved_3 = pos;
                let mut alts_ok_3 = false;
                alts_3_0: {
                    pos = alts_saved_3;
                    if pos >= chars.len() || !('a' <= chars[pos] <= 'z') { break alts_3_0; }
                    pos += 1;
                    alts_ok_3 = true;
                }
                if !alts_ok_3 {
                    alts_3_1: {
                        pos = alts_saved_3;
                        if pos >= chars.len() || !('A' <= chars[pos] <= 'Z') { break alts_3_1; }
                        pos += 1;
                        alts_ok_3 = true;
                    }
                    if !alts_ok_3 {
                        alts_3_2: {
                            pos = alts_saved_3;
                            if pos >= chars.len() || chars[pos] != '_' { break alts_3_2; }
                            pos += 1;
                            alts_ok_3 = true;
                        }
                    }
                }
                if !alts_ok_3 { break alts_2_0; }
                alts_ok_2 = true;
            }
            if !alts_ok_2 {
                alts_2_1: {
                    pos = alts_saved_2;
                    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break alts_2_1; }
                    pos += 1;
                    alts_ok_2 = true;
                }
            }
            if !alts_ok_2 { break rep_1; }
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

fn try_scientific_number(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { return -1; }
    pos += 1;
    loop {
        let rep_saved_4 = pos;
        rep_4: {
            if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_4; }
            pos += 1;
            continue;
        }
        pos = rep_saved_4;
        break;
    }
    let opt_saved_5 = pos;
    let mut opt_ok_5 = false;
    rep_5: {
        if pos >= chars.len() || chars[pos] != '.' { break rep_5; }
        pos += 1;
        if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_5; }
        pos += 1;
        loop {
            let rep_saved_6 = pos;
            rep_6: {
                if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_6; }
                pos += 1;
                continue;
            }
            pos = rep_saved_6;
            break;
        }
        opt_ok_5 = true;
    }
    if !opt_ok_5 { pos = opt_saved_5; }
    let opt_saved_7 = pos;
    let mut opt_ok_7 = false;
    rep_7: {
        let alts_saved_8 = pos;
        let mut alts_ok_8 = false;
        alts_8_0: {
            pos = alts_saved_8;
            if pos >= chars.len() || chars[pos] != 'E' { break alts_8_0; }
            pos += 1;
            alts_ok_8 = true;
        }
        if !alts_ok_8 {
            alts_8_1: {
                pos = alts_saved_8;
                if pos >= chars.len() || chars[pos] != 'e' { break alts_8_1; }
                pos += 1;
                alts_ok_8 = true;
            }
        }
        if !alts_ok_8 { break rep_7; }
        let opt_saved_9 = pos;
        let mut opt_ok_9 = false;
        rep_9: {
            let alts_saved_10 = pos;
            let mut alts_ok_10 = false;
            alts_10_0: {
                pos = alts_saved_10;
                if pos >= chars.len() || chars[pos] != '+' { break alts_10_0; }
                pos += 1;
                alts_ok_10 = true;
            }
            if !alts_ok_10 {
                alts_10_1: {
                    pos = alts_saved_10;
                    if pos >= chars.len() || chars[pos] != '-' { break alts_10_1; }
                    pos += 1;
                    alts_ok_10 = true;
                }
            }
            if !alts_ok_10 { break rep_9; }
            opt_ok_9 = true;
        }
        if !opt_ok_9 { pos = opt_saved_9; }
        if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_7; }
        pos += 1;
        loop {
            let rep_saved_11 = pos;
            rep_11: {
                if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_11; }
                pos += 1;
                continue;
            }
            pos = rep_saved_11;
            break;
        }
        let opt_saved_12 = pos;
        let mut opt_ok_12 = false;
        rep_12: {
            if pos >= chars.len() || chars[pos] != '.' { break rep_12; }
            pos += 1;
            if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_12; }
            pos += 1;
            loop {
                let rep_saved_13 = pos;
                rep_13: {
                    if pos >= chars.len() || !('0' <= chars[pos] <= '9') { break rep_13; }
                    pos += 1;
                    continue;
                }
                pos = rep_saved_13;
                break;
            }
            opt_ok_12 = true;
        }
        if !opt_ok_12 { pos = opt_saved_12; }
        opt_ok_7 = true;
    }
    if !opt_ok_7 { pos = opt_saved_7; }
    return pos;
}

fn try_ws(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { return -1; }
    pos += 1;
    loop {
        let rep_saved_14 = pos;
        rep_14: {
            if pos >= chars.len() { break rep_14; }
            if !(false || chars[pos] == ' ' || chars[pos] == '\r' || chars[pos] == '\n' || chars[pos] == '\t') { break rep_14; }
            pos += 1;
            continue;
        }
        pos = rep_saved_14;
        break;
    }
    return pos;
}

fn classify_keyword(chars: &List<char>, start: i32, end: i32) -> i32 {
    let len = end - start;
    if len == 1 {
        if chars[start].eq_ignore_ascii_case(&'e') {
            if chars[start + 0] == 'e' { return TK_EULER; }
        } else if chars[start].eq_ignore_ascii_case(&'i') {
            if chars[start + 0] == 'i' { return TK_I; }
        }
    }
    return -1;
}

pub fn tokenize(input: &String) -> List<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: List<Token> = List::with_capacity(lexer.chars.len() / 4 + 1);
    let mut trivia: List<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        if first_char == '\t' || first_char == '\n' || first_char == '\r' || first_char == ' ' {
            end = try_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_WS; }
        } else if first_char == '(' {
            end = try_lparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LPAREN; }
        } else if first_char == ')' {
            end = try_rparen(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_RPAREN; }
        } else if first_char == '*' {
            end = try_times(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TIMES; }
        } else if first_char == '+' {
            end = try_plus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PLUS; }
        } else if first_char == ',' {
            end = try_comma(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COMMA; }
        } else if first_char == '-' {
            end = try_minus(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_MINUS; }
        } else if first_char == '.' {
            end = try_point(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POINT; }
        } else if first_char == '/' {
            end = try_div(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DIV; }
        } else if first_char == '<' {
            end = try_lt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LT; }
        } else if first_char == '=' {
            end = try_eq(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_EQ; }
        } else if first_char == '>' {
            end = try_gt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_GT; }
        } else if first_char == '^' {
            end = try_pow(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_POW; }
        } else if first_char == '_' {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'a' {
            end = try_acos(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ACOS; }
            end = try_asin(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ASIN; }
            end = try_atan(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ATAN; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'c' {
            end = try_cos(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_COS; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'l' {
            end = try_ln(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LN; }
            end = try_log(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_LOG; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 'p' {
            end = try_pi(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_PI; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 's' {
            end = try_sin(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SIN; }
            end = try_sqrt(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SQRT; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if first_char == 't' {
            end = try_tan(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAN; }
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'a' <= first_char <= 'z' {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if 'A' <= first_char <= 'Z' {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
        } else if '0' <= first_char <= '9' {
            end = try_scientific_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        } else {
            end = try_variable(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_VARIABLE; }
            end = try_scientific_number(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCIENTIFIC_NUMBER; }
        }
        if best_end > start {
            let kw_kind = classify_keyword(&lexer.chars, start, best_end);
            if kw_kind >= 0 { best_kind = kw_kind; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(tok_start, best_end), Span::new(tok_start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, LexerSlice::empty(&lexer.chars), Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_COS => "COS",
        TK_SIN => "SIN",
        TK_TAN => "TAN",
        TK_ACOS => "ACOS",
        TK_ASIN => "ASIN",
        TK_ATAN => "ATAN",
        TK_LN => "LN",
        TK_LOG => "LOG",
        TK_SQRT => "SQRT",
        TK_LPAREN => "LPAREN",
        TK_RPAREN => "RPAREN",
        TK_PLUS => "PLUS",
        TK_MINUS => "MINUS",
        TK_TIMES => "TIMES",
        TK_DIV => "DIV",
        TK_GT => "GT",
        TK_LT => "LT",
        TK_EQ => "EQ",
        TK_COMMA => "COMMA",
        TK_POINT => "POINT",
        TK_POW => "POW",
        TK_PI => "PI",
        TK_EULER => "EULER",
        TK_I => "I",
        TK_VARIABLE => "VARIABLE",
        TK_SCIENTIFIC_NUMBER => "SCIENTIFIC_NUMBER",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: List<Token>,
    pos: i32,
    chars: List<char>,
    pending: Option<ParseError>,
}

impl Parser {
    fn new(tokens: List<Token>, chars: List<char>) -> Parser {
        return Parser { tokens, pos: 0, chars, pending: null };
    }

    fn error(&self, message: String, span: Span, expected: List<String>) -> ParseError {
        let lc = line_col_at(&self.chars, span.start);
        return ParseError::at(message, span, expected, lc.0, lc.1);
    }

    fn record_deeper(&mut self, e: ParseError) {
        let take = if let Some(cur) = &self.pending { e.span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::<ParseError>::Some(e);
        }
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            if kind == TK_EOF {
                return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
            }
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }

    fn match_set(&mut self, included: List<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        for let x of included {
            if x == k {
                if k == TK_EOF {
                    return Result::<Token, ParseError>::Ok(self.tokens[self.pos]);
                }
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(self.error(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["token set"],
        ));
    }
}

fn scan_equation(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    pos = scan_relop(tokens, pos, 0);
    if pos < 0 { return -1; }
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_EOF { return -1; }
    pos += 1;
    return pos;
}

fn scan_expression(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_multiplying_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _gale_kind_set_0(tokens[pos].kind) {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                let gp_1 = pos;
                sg_1: {
                    pos = gp_1;
                    sg_1_0: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_PLUS { break sg_1_0; }
                        pos += 1;
                        break sg_1;
                    }
                    pos = gp_1;
                    sg_1_1: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_MINUS { break sg_1_1; }
                        pos += 1;
                        break sg_1;
                    }
                    break sg_0;
                }
                pos = scan_multiplying_expression(tokens, pos, 0);
                if pos < 0 { break sg_0; }
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_multiplying_expression(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_pow_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && _gale_kind_set_1(tokens[pos].kind) {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                let gp_3 = pos;
                sg_3: {
                    pos = gp_3;
                    sg_3_0: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_TIMES { break sg_3_0; }
                        pos += 1;
                        break sg_3;
                    }
                    pos = gp_3;
                    sg_3_1: {
                        if pos >= tokens.len() || tokens[pos].kind != TK_DIV { break sg_3_1; }
                        pos += 1;
                        break sg_3;
                    }
                    break sg_2;
                }
                pos = scan_pow_expression(tokens, pos, 0);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_pow_expression(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_signed_atom(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_POW {
        let sp = pos;
        sg_4_done: {
            sg_4: {
                if pos >= tokens.len() || tokens[pos].kind != TK_POW { break sg_4; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, 0);
                if pos < 0 { break sg_4; }
                break sg_4_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_signed_atom(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_PLUS {
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_PLUS { break try_0; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_MINUS {
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_MINUS { break try_1; }
                pos += 1;
                pos = scan_signed_atom(tokens, pos, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_2(alt_kind) {
            pos = start;
            try_2: {
                pos = scan_func_(tokens, pos, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_3(alt_kind) {
            pos = start;
            try_3: {
                pos = scan_atom(tokens, pos, 0);
                if pos < 0 { break try_3; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_atom(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_SCIENTIFIC_NUMBER {
            pos = start;
            try_0: {
                pos = scan_scientific(tokens, pos, 0);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_VARIABLE {
            pos = start;
            try_1: {
                pos = scan_variable(tokens, pos, 0);
                if pos < 0 { break try_1; }
                break scan_alts;
            }
            return -1;
        } else if _gale_kind_set_4(alt_kind) {
            pos = start;
            try_2: {
                pos = scan_constant(tokens, pos, 0);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LPAREN {
            pos = start;
            try_3: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LPAREN { break try_3; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break try_3; }
                if pos >= tokens.len() || tokens[pos].kind != TK_RPAREN { break try_3; }
                pos += 1;
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_scientific(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_SCIENTIFIC_NUMBER { return -1; }
    pos += 1;
    return pos;
}

fn scan_constant(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_4(tokens[pos].kind) {
        return pos + 1;
    }
    return -1;
}

fn scan_variable(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_VARIABLE { return -1; }
    pos += 1;
    return pos;
}

fn scan_func_(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_funcname(tokens, pos, 0);
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos].kind != TK_LPAREN { return -1; }
    pos += 1;
    pos = scan_expression(tokens, pos, 0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_COMMA {
        let sp = pos;
        sg_5_done: {
            sg_5: {
                if pos >= tokens.len() || tokens[pos].kind != TK_COMMA { break sg_5; }
                pos += 1;
                pos = scan_expression(tokens, pos, 0);
                if pos < 0 { break sg_5; }
                break sg_5_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_RPAREN { return -1; }
    pos += 1;
    return pos;
}

fn scan_funcname(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_2(tokens[pos].kind) {
        return pos + 1;
    }
    return -1;
}

fn scan_relop(tokens: &List<Token>, pos: i32, min_prec: i32 = 0) -> i32 {
    if pos < tokens.len() && _gale_kind_set_5(tokens[pos].kind) {
        return pos + 1;
    }
    return -1;
}

fn _parse_equation__inner(p: &mut Parser) -> Result<EquationNode, ParseError> {
    let start = p.peek().span.start;
    let expression = _parse_expression(p)?;
    let relop = _parse_relop(p)?;
    let expression_2 = _parse_expression(p)?;
    let eof = p.expect(TK_EOF)?;
    return Result::<EquationNode, ParseError>::Ok(EquationNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        expression,
        relop,
        expression_2,
        eof,
    });
}

fn _parse_equation(p: &mut Parser) -> Result<EquationNode, ParseError> {
    let r = _parse_equation__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("equation");
        return Result::<EquationNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_expression__inner(p: &mut Parser) -> Result<ExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let multiplying_expression = _parse_multiplying_expression(p)?;
    let mut item_multiplying_expression_list: List<ItemMultiplyingExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            sg_6_done: {
                sg_6: {
                    let gp_7 = pos;
                    sg_7: {
                        pos = gp_7;
                        sg_7_0: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_PLUS { break sg_7_0; }
                            pos += 1;
                            break sg_7;
                        }
                        pos = gp_7;
                        sg_7_1: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_MINUS { break sg_7_1; }
                            pos += 1;
                            break sg_7;
                        }
                        break sg_6;
                    }
                    pos = scan_multiplying_expression(tokens, pos, 0);
                    if pos < 0 { break sg_6; }
                    break sg_6_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let plus_or_minus = p.match_set([TK_PLUS, TK_MINUS])?;
        let multiplying_expression = _parse_multiplying_expression(p)?;
        let item_multiplying_expression = ItemMultiplyingExpressionItem {
            plus_or_minus,
            multiplying_expression,
        };
        item_multiplying_expression_list.push(item_multiplying_expression);
    }
    return Result::<ExpressionNode, ParseError>::Ok(ExpressionNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        multiplying_expression,
        item_multiplying_expression_list,
    });
}

fn _parse_expression(p: &mut Parser) -> Result<ExpressionNode, ParseError> {
    let r = _parse_expression__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("expression");
        return Result::<ExpressionNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_multiplying_expression__inner(p: &mut Parser) -> Result<MultiplyingExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let pow_expression = _parse_pow_expression(p)?;
    let mut item_pow_expression_list: List<ItemPowExpressionItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            sg_8_done: {
                sg_8: {
                    let gp_9 = pos;
                    sg_9: {
                        pos = gp_9;
                        sg_9_0: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_TIMES { break sg_9_0; }
                            pos += 1;
                            break sg_9;
                        }
                        pos = gp_9;
                        sg_9_1: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_DIV { break sg_9_1; }
                            pos += 1;
                            break sg_9;
                        }
                        break sg_8;
                    }
                    pos = scan_pow_expression(tokens, pos, 0);
                    if pos < 0 { break sg_8; }
                    break sg_8_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let times_or_div = p.match_set([TK_TIMES, TK_DIV])?;
        let pow_expression = _parse_pow_expression(p)?;
        let item_pow_expression = ItemPowExpressionItem {
            times_or_div,
            pow_expression,
        };
        item_pow_expression_list.push(item_pow_expression);
    }
    return Result::<MultiplyingExpressionNode, ParseError>::Ok(MultiplyingExpressionNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        pow_expression,
        item_pow_expression_list,
    });
}

fn _parse_multiplying_expression(p: &mut Parser) -> Result<MultiplyingExpressionNode, ParseError> {
    let r = _parse_multiplying_expression__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("multiplyingExpression");
        return Result::<MultiplyingExpressionNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_pow_expression__inner(p: &mut Parser) -> Result<PowExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let signed_atom = _parse_signed_atom(p)?;
    let mut pow_signed_atom_list: List<PowSignedAtomItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            sg_10_done: {
                sg_10: {
                    if pos >= tokens.len() || tokens[pos].kind != TK_POW { break sg_10; }
                    pos += 1;
                    pos = scan_signed_atom(tokens, pos, 0);
                    if pos < 0 { break sg_10; }
                    break sg_10_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let pow = p.expect(TK_POW)?;
        let signed_atom = _parse_signed_atom(p)?;
        let pow_signed_atom = PowSignedAtomItem {
            pow,
            signed_atom,
        };
        pow_signed_atom_list.push(pow_signed_atom);
    }
    return Result::<PowExpressionNode, ParseError>::Ok(PowExpressionNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        signed_atom,
        pow_signed_atom_list,
    });
}

fn _parse_pow_expression(p: &mut Parser) -> Result<PowExpressionNode, ParseError> {
    let r = _parse_pow_expression__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("powExpression");
        return Result::<PowExpressionNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_signed_atom__inner(p: &mut Parser) -> Result<SignedAtomNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_PLUS {
        let plus = p.expect(TK_PLUS)?;
        let signed_atom = _parse_signed_atom(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt0(SignedAtomAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            plus,
            signed_atom,
        }));
    }
    if kind == TK_MINUS {
        let minus = p.expect(TK_MINUS)?;
        let signed_atom = _parse_signed_atom(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt1(SignedAtomAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            minus,
            signed_atom,
        }));
    }
    if _gale_kind_set_2(kind) {
        let func_ = _parse_func_(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt2(SignedAtomAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            func_,
        }));
    }
    if _gale_kind_set_3(kind) {
        let atom = _parse_atom(p)?;
        return Result::<SignedAtomNode, ParseError>::Ok(SignedAtomNode::Alt3(SignedAtomAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            atom,
        }));
    }
    return Result::<SignedAtomNode, ParseError>::Err(p.error(
        "expected signedAtom",
        p.peek().span,
        ["TK_PLUS", "TK_MINUS", "TK_COS", "TK_TAN", "TK_SIN", "TK_ACOS", "TK_ATAN", "TK_ASIN", "TK_LOG", "TK_LN", "TK_SQRT", "TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    ));
}

fn _parse_signed_atom(p: &mut Parser) -> Result<SignedAtomNode, ParseError> {
    let r = _parse_signed_atom__inner(p);
    if let Err(mut e) = r {
        e.rule_stack.push("signedAtom");
        return Result::<SignedAtomNode, ParseError>::Err(e);
    }
    return r;
}

fn _parse_atom__inner(p: &mut Parser) -> Result<AtomNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_SCIENTIFIC_NUMBER {
        let scientific = _parse_scientific(p)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt0(AtomAlt0 {
            span: Span::new(start, i32::max(start, p.last_end())),
            scientific,
        }));
    }
    if kind == TK_VARIABLE {
        let variable = _parse_variable(p)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt1(AtomAlt1 {
            span: Span::new(start, i32::max(start, p.last_end())),
            variable,
        }));
    }
    if _gale_kind_set_4(kind) {
        let constant = _parse_constant(p)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt2(AtomAlt2 {
            span: Span::new(start, i32::max(start, p.last_end())),
            constant,
        }));
    }
    if kind == TK_LPAREN {
        let lparen = p.expect(TK_LPAREN)?;
        let expression = _parse_expression(p)?;
        let rparen = p.expect(TK_RPAREN)?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt3(AtomAlt3 {
            span: Span::new(start, i32::max(start, p.last_end())),
            lparen,
            expression,
            rparen,
        }));
    }
    return Result::<AtomNode, ParseError>::Err(p.error(
        "expected atom",
        p.peek().span,
        ["TK_SCIENTIFIC_NUMBER", "TK_VARIABLE", "TK_PI", "TK_EULER", "TK_I", "TK_LPAREN"],
    ));
}

