pub fn parse(input: &String) -> Result<HtmlDocumentNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_html_document(&mut parser);
}

pub fn walk_htmlDocument<V: Visitor>(v: &mut V, node: &HtmlDocumentNode) {
    v.enter_rule(&"htmlDocument", &node.span);
    for let item of &node.scriptlet_or_sea_ws_list {
        walk_scriptletOrSeaWs(v, item);
    }
    if let Some(item) = &node.xml {
        v.visit_token(item);
    }
    for let item of &node.scriptlet_or_sea_ws_list_2 {
        walk_scriptletOrSeaWs(v, item);
    }
    if let Some(item) = &node.dtd {
        v.visit_token(item);
    }
    for let item of &node.scriptlet_or_sea_ws_list_3 {
        walk_scriptletOrSeaWs(v, item);
    }
    for let item of &node.html_elements_list {
        walk_htmlElements(v, item);
    }
    v.exit_rule(&"htmlDocument", &node.span);
}

pub fn walk_scriptletOrSeaWs<V: Visitor>(v: &mut V, node: &ScriptletOrSeaWsNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"scriptletOrSeaWs", &n.span);
            v.visit_token(&n.scriptlet);
            v.exit_rule(&"scriptletOrSeaWs", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"scriptletOrSeaWs", &n.span);
            v.visit_token(&n.sea_ws);
            v.exit_rule(&"scriptletOrSeaWs", &n.span);
        }
    }
}

pub fn walk_htmlElements<V: Visitor>(v: &mut V, node: &HtmlElementsNode) {
    v.enter_rule(&"htmlElements", &node.span);
    for let item of &node.html_misc_list {
        walk_htmlMisc(v, item);
    }
    walk_htmlElement(v, &node.html_element);
    for let item of &node.html_misc_list_2 {
        walk_htmlMisc(v, item);
    }
    v.exit_rule(&"htmlElements", &node.span);
}

pub fn walk_htmlElement<V: Visitor>(v: &mut V, node: &HtmlElementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            v.visit_token(&n.tag_open);
            v.visit_token(&n.tag_name);
            for let item of &n.html_attribute_list {
                walk_htmlAttribute(v, item);
            }
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.tag_close);
                        if let Some(item) = &inner.html_content_tag_open_tag_slash_tag_name_tag_close {
                            walk_htmlContent(v, &item.html_content);
                            v.visit_token(&item.tag_open);
                            v.visit_token(&item.tag_slash);
                            v.visit_token(&item.tag_name);
                            v.visit_token(&item.tag_close);
                        }
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.tag_slash_close);
                    }
                }
            }
            v.exit_rule(&"htmlElement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            v.visit_token(&n.scriptlet);
            v.exit_rule(&"htmlElement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            walk_script(v, &n.script);
            v.exit_rule(&"htmlElement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            walk_style(v, &n.style);
            v.exit_rule(&"htmlElement", &n.span);
        }
    }
}

pub fn walk_htmlContent<V: Visitor>(v: &mut V, node: &HtmlContentNode) {
    v.enter_rule(&"htmlContent", &node.span);
    if let Some(item) = &node.html_chardata {
        walk_htmlChardata(v, item);
    }
    for let item of &node.item_html_chardata_list {
        if let Some(item) = &item.group_0 {
            match item {
                Alt0(inner) => {
                    walk_htmlElement(v, &inner.html_element);
                }
                Alt1(inner) => {
                    v.visit_token(&inner.cdata);
                }
                Alt2(inner) => {
                    walk_htmlComment(v, &inner.html_comment);
                }
            }
        }
        if let Some(item) = &item.html_chardata {
            walk_htmlChardata(v, item);
        }
    }
    v.exit_rule(&"htmlContent", &node.span);
}

pub fn walk_htmlAttribute<V: Visitor>(v: &mut V, node: &HtmlAttributeNode) {
    v.enter_rule(&"htmlAttribute", &node.span);
    v.visit_token(&node.tag_name);
    if let Some(item) = &node.tag_equals_attvalue_value {
        v.visit_token(&item.tag_equals);
        v.visit_token(&item.attvalue_value);
    }
    v.exit_rule(&"htmlAttribute", &node.span);
}

pub fn walk_htmlChardata<V: Visitor>(v: &mut V, node: &HtmlChardataNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlChardata", &n.span);
            v.visit_token(&n.html_text);
            v.exit_rule(&"htmlChardata", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlChardata", &n.span);
            v.visit_token(&n.sea_ws);
            v.exit_rule(&"htmlChardata", &n.span);
        }
    }
}

pub fn walk_htmlMisc<V: Visitor>(v: &mut V, node: &HtmlMiscNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlMisc", &n.span);
            walk_htmlComment(v, &n.html_comment);
            v.exit_rule(&"htmlMisc", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlMisc", &n.span);
            v.visit_token(&n.sea_ws);
            v.exit_rule(&"htmlMisc", &n.span);
        }
    }
}

pub fn walk_htmlComment<V: Visitor>(v: &mut V, node: &HtmlCommentNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlComment", &n.span);
            v.visit_token(&n.html_comment);
            v.exit_rule(&"htmlComment", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlComment", &n.span);
            v.visit_token(&n.html_conditional_comment);
            v.exit_rule(&"htmlComment", &n.span);
        }
    }
}

pub fn walk_script<V: Visitor>(v: &mut V, node: &ScriptNode) {
    v.enter_rule(&"script", &node.span);
    v.visit_token(&node.script_open);
    v.visit_token(&node.script_body_or_script_short_body);
    v.exit_rule(&"script", &node.span);
}

pub fn walk_style<V: Visitor>(v: &mut V, node: &StyleNode) {
    v.enter_rule(&"style", &node.span);
    v.visit_token(&node.style_open);
    v.visit_token(&node.style_body_or_style_short_body);
    v.exit_rule(&"style", &node.span);
}

pub fn to_tree(node: &HtmlDocumentNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_htmlDocument(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_SCRIPTLET | TK_SEA_WS };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_SEA_WS | TK_STYLE_OPEN | TK_TAG_OPEN };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SEA_WS };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_TAG_CLOSE | TK_TAG_SLASH_CLOSE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_CDATA | TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_HTML_TEXT | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_SEA_WS | TK_STYLE_OPEN | TK_TAG_OPEN };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN | TK_TAG_OPEN };
}

fn _gale_kind_set_6(k: i32) -> bool {
    return k matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT };
}

fn _gale_kind_set_7(k: i32) -> bool {
    return k matches { TK_HTML_TEXT | TK_SEA_WS };
}

fn _gale_kind_set_8(k: i32) -> bool {
    return k matches { TK_CDATA | TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN | TK_TAG_OPEN };
}

