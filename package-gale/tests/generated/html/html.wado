global TK_TAG_SLASH_CLOSE: i32 = 12;
global TK_TAG_SLASH: i32 = 13;
global TK_TAG_EQUALS: i32 = 14;
global TK_TAG_NAME: i32 = 15;
global TK_TAG_WHITESPACE: i32 = 16;
