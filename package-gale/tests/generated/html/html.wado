    if pos >= chars.len() || chars[pos] != '[' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'C' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'D' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'A' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'T' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'A' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '[' { return -1; }
    pos += 1;
    loop {
        let ng_saved_3 = pos;
        let mut ng_exit_3 = false;
        ng_3: {
            if pos >= chars.len() || chars[pos] != ']' { break ng_3; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != ']' { break ng_3; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != '>' { break ng_3; }
