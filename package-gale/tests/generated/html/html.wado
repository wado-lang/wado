global TK_HTML_COMMENT: i32 = 0;
global TK_HTML_CONDITIONAL_COMMENT: i32 = 1;
global TK_XML: i32 = 2;
global TK_CDATA: i32 = 3;
global TK_DTD: i32 = 4;
global TK_SCRIPTLET: i32 = 5;
global TK_SEA_WS: i32 = 6;
global TK_SCRIPT_OPEN: i32 = 7;
global TK_STYLE_OPEN: i32 = 8;
global TK_TAG_OPEN: i32 = 9;
