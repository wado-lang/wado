fn _parse_html_content__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<HtmlContentNode, ParseError> {
    let start = p.peek().span.start;
    let html_chardata: Option<HtmlChardataNode> = if follow_yields(&p.tokens, p.pos, follow, TK_EOF) {
        null
    } else if _gale_kind_set_7(p.peek_kind()) {
        let html_chardata = _parse_html_chardata(p, &EMPTY_FOLLOW)?;
        Option::<HtmlChardataNode>::Some(html_chardata)
    } else {
        null
    };
    let mut item_html_chardata_list: List<ItemHtmlChardataOptItem> = [];
    loop {
        if follow_yields(&p.tokens, p.pos, follow, TK_EOF) { break; }
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            sg_7_done: {
                sg_7: {
                    let gp_8 = pos;
                    let sgk_8 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
                    if _gale_kind_set_8(sgk_8) {
                        sg_8: {
                            pos = gp_8;
                            sg_8_0: {
                                pos = scan_html_element(tokens, pos, follow, 0);
                                if pos < 0 { break sg_8_0; }
                                break sg_8;
                            }
                            pos = gp_8;
                            sg_8_1: {
                                if pos >= tokens.len() || tokens[pos].kind != TK_CDATA { break sg_8_1; }
                                pos += 1;
                                break sg_8;
                            }
                            pos = gp_8;
                            sg_8_2: {
                                pos = scan_html_comment(tokens, pos, follow, 0);
                                if pos < 0 { break sg_8_2; }
                                break sg_8;
                            }
                            pos = gp_8;
                        }
                    }
                    if pos < tokens.len() && _gale_kind_set_7(tokens[pos].kind) && !(follow_yields(tokens, pos, follow, TK_EOF)) {
                        let sp = pos;
                        pos = scan_html_chardata(tokens, pos, &EMPTY_FOLLOW, 0);
                        if pos < 0 { pos = sp; }
                    }
                    break sg_7_done;
                }
                break rep_scan;
            }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let mut group_0_inner: Option<HtmlContentGroup0> = null;
        let grp_kind = p.peek_kind();
        if _gale_kind_set_5(grp_kind) {
            let html_element = _parse_html_element(p, follow)?;
            group_0_inner = Option::<HtmlContentGroup0>::Some(HtmlContentGroup0::Alt0(HtmlContentGroup0Alt0 {
                html_element,
            }));
        } else if grp_kind == TK_CDATA {
            let cdata = p.expect(TK_CDATA)?;
            group_0_inner = Option::<HtmlContentGroup0>::Some(HtmlContentGroup0::Alt1(HtmlContentGroup0Alt1 {
                cdata,
            }));
        } else if _gale_kind_set_6(grp_kind) {
            let html_comment = _parse_html_comment(p, follow)?;
            group_0_inner = Option::<HtmlContentGroup0>::Some(HtmlContentGroup0::Alt2(HtmlContentGroup0Alt2 {
                html_comment,
            }));
        }
        let group_0 = group_0_inner;
        let html_chardata: Option<HtmlChardataNode> = if follow_yields(&p.tokens, p.pos, follow, TK_EOF) {
            null
        } else if _gale_kind_set_7(p.peek_kind()) {
            let html_chardata = _parse_html_chardata(p, &EMPTY_FOLLOW)?;
            Option::<HtmlChardataNode>::Some(html_chardata)
        } else {
            null
        };
        let item_html_chardata = ItemHtmlChardataOptItem {
            group_0,
            html_chardata,
        };
        item_html_chardata_list.push(item_html_chardata);
    }
    return Result::<HtmlContentNode, ParseError>::Ok(HtmlContentNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        html_chardata,
        item_html_chardata_list,
    });
}

