    pos += 1;
    if pos >= chars.len() || chars[pos] != '?' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'x' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'm' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != 'l' { return -1; }
    pos += 1;
    loop {
        let ng_saved_2 = pos;
