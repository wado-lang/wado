struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.chars().collect(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_html_comment(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '<' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '!' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '-' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '-' { return -1; }
    pos += 1;
    loop {
        let ng_saved_0 = pos;
        let mut ng_exit_0 = false;
        ng_0: {
            if pos >= chars.len() || chars[pos] != '-' { break ng_0; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != '-' { break ng_0; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != '>' { break ng_0; }
            pos += 1;
            ng_exit_0 = true;
        }
        if ng_exit_0 {
            break;
        }
        pos = ng_saved_0;
        if pos >= chars.len() { return -1; }
        pos += 1;
    }
    return pos;
}

fn try_html_conditional_comment(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '<' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '!' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '[' { return -1; }
    pos += 1;
    loop {
        let ng_saved_1 = pos;
        let mut ng_exit_1 = false;
        ng_1: {
            if pos >= chars.len() || chars[pos] != ']' { break ng_1; }
            pos += 1;
            if pos >= chars.len() || chars[pos] != '>' { break ng_1; }
            pos += 1;
            ng_exit_1 = true;
        }
        if ng_exit_1 {
            break;
        }
        pos = ng_saved_1;
        if pos >= chars.len() { return -1; }
        pos += 1;
    }
    return pos;
}

fn try_xml(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
