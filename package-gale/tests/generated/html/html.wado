    TAG_EQUALS,
    TAG_NAME,
    TAG_WHITESPACE,
    SCRIPT_BODY,
    SCRIPT_SHORT_BODY,
    STYLE_BODY,
    STYLE_SHORT_BODY,
    ATTVALUE_VALUE,
    ATTRIBUTE,
    Eof,
    Error,
}

