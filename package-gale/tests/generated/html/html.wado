fn _parse_html_attribute__inner(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> Result<HtmlAttributeNode, ParseError> {
    let start = p.peek().span.start;
    let tag_name = p.expect(TK_TAG_NAME)?;
    let tag_equals_attvalue_value: Option<TagEqualsAttvalueValueItem> = if !(follow_yields(&p.tokens, p.pos, follow, TK_EOF)) && (p.peek_kind() == TK_TAG_EQUALS && p.peek_at(1) == TK_ATTVALUE_VALUE) {
        let tag_equals = p.expect(TK_TAG_EQUALS)?;
        let attvalue_value = p.expect(TK_ATTVALUE_VALUE)?;
        let tag_equals_attvalue_value = TagEqualsAttvalueValueItem {
            tag_equals,
            attvalue_value,
        };
        Option::<TagEqualsAttvalueValueItem>::Some(tag_equals_attvalue_value)
    } else {
        null
    };
    return Result::<HtmlAttributeNode, ParseError>::Ok(HtmlAttributeNode {
        span: Span::new(start, i32::max(start, p.last_end())),
        tag_name,
        tag_equals_attvalue_value,
    });
}

