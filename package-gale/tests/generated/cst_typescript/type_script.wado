pub interface TypeScriptLexerBase {
    fn is_regex_possible(view: LexerView) -> bool;
    fn process_open_brace(view: LexerView, lx: &mut Lexer);
    fn is_in_template_string(view: LexerView) -> bool;
    fn process_close_brace(view: LexerView, lx: &mut Lexer);
    fn is_strict_mode(view: LexerView) -> bool;
    fn process_string_literal(view: LexerView, lx: &mut Lexer);
    fn increase_template_depth(view: LexerView, lx: &mut Lexer);
    fn decrease_template_depth(view: LexerView, lx: &mut Lexer);
    fn start_template_string(view: LexerView, lx: &mut Lexer);
    /// Called with the span, type and channel of each token the lexer
    /// commits — not a skipped or `more`d match, and not the EOF
    /// sentinel. Returns the type to emit.
    fn emit(view: LexerView, ty: i32, channel: i32) -> i32 {
        return ty;
    }
}

pub struct Lexer {
    chars: List<char>,
    pos: i32,
    act_output: String = "",
    act_type: i32 = -1,
    act_channel: i32 = -1,
    act_skip: bool = false,
    act_more: bool = false,
    act_push_mode: i32 = -1,
    act_pop_mode: bool = false,
    act_set_mode: i32 = -1,
    act_mode_depth: i32 = 0,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    pub fn emit(&mut self, s: String) {
        self.act_output.push_str(&s);
    }

    fn reset_actions(&mut self, kind: i32, channel: i32, depth: i32) {
        self.act_type = kind;
        self.act_channel = channel;
        self.act_skip = false;
        self.act_more = false;
        self.act_push_mode = -1;
        self.act_pop_mode = false;
        self.act_set_mode = -1;
        self.act_mode_depth = depth;
    }

    pub fn set_type(&mut self, t: i32) {
        self.act_type = t;
    }

    pub fn set_channel(&mut self, c: i32) {
        self.act_channel = c;
    }

    pub fn skip(&mut self) {
        self.act_skip = true;
    }

    pub fn more(&mut self) {
        self.act_more = true;
    }

    pub fn push_mode(&mut self, m: i32) {
        assert self.act_push_mode < 0 && !self.act_pop_mode && self.act_set_mode < 0, "a lexer action may issue at most one mode command per token";
        self.act_push_mode = m;
        self.act_mode_depth += 1;
    }

    pub fn pop_mode(&mut self) {
        assert self.act_push_mode < 0 && !self.act_pop_mode && self.act_set_mode < 0, "a lexer action may issue at most one mode command per token";
        self.act_pop_mode = true;
        self.act_mode_depth -= 1;
    }

    pub fn set_mode(&mut self, m: i32) {
        assert self.act_push_mode < 0 && !self.act_pop_mode && self.act_set_mode < 0, "a lexer action may issue at most one mode command per token";
        self.act_set_mode = m;
    }

    pub fn mode_depth(&self) -> i32 {
        return self.act_mode_depth;
    }
}

pub global MODE_DEFAULT_MODE: i32 = 0;
pub global MODE_TEMPLATE: i32 = 1;

fn apply_OpenBrace_actions(lx: &mut Lexer, start: i32, end: i32) with TypeScriptLexerBase {
    let chars = &lx.chars;
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '{' { return; }
    pos += 1;
    TypeScriptLexerBase::process_open_brace(LexerView { chars, start, pos }, lx);
}

fn apply_CloseBrace_actions(lx: &mut Lexer, start: i32, end: i32) with TypeScriptLexerBase {
    let chars = &lx.chars;
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != '}' { return; }
    pos += 1;
    TypeScriptLexerBase::process_close_brace(LexerView { chars, start, pos }, lx);
}

fn apply_StringLiteral_actions(lx: &mut Lexer, start: i32, end: i32) with TypeScriptLexerBase {
    let chars = &lx.chars;
    let mut pos = start;
    let sel_saved_0 = pos;
    let mut sel_alt_0 = -1;
    sel_done_0: {
        sel_0_0: {
            pos = sel_saved_0;
            if pos >= chars.len() || chars[pos] != '"' { break sel_0_0; }
            pos += 1;
            loop {
                let rep_saved_1 = pos;
                rep_1: {
                    let alts_saved_2 = pos;
                    alts_done_2: {
                        alts_2_0: {
                            pos = alts_saved_2;
                            if pos >= chars.len() { break alts_2_0; }
                            if (chars[pos] matches { '"' | '\\' | '\r' | '\n' }) { break alts_2_0; }
                            pos += 1;
                            break alts_done_2;
                        }
                        alts_2_1: {
                            pos = alts_saved_2;
                            if pos >= chars.len() || chars[pos] != '\\' { break alts_2_1; }
                            pos += 1;
                            let alts_saved_3 = pos;
                            alts_done_3: {
                                alts_3_0: {
                                    pos = alts_saved_3;
                                    let alts_saved_4 = pos;
                                    alts_done_4: {
                                        alts_4_0: {
                                            pos = alts_saved_4;
                                            if pos >= chars.len() { break alts_4_0; }
                                            if !((chars[pos] matches { '"' | '\'' | '\\' | 'b' | 'f' | 'n' | 'r' | 't' | 'v' })) { break alts_4_0; }
                                            pos += 1;
                                            break alts_done_4;
                                        }
                                        alts_4_1: {
                                            pos = alts_saved_4;
                                            if pos >= chars.len() { break alts_4_1; }
                                            if (chars[pos] matches { '\'' | '"' | '\\' | 'b' | 'f' | 'n' | 'r' | 't' | 'v' | '0'..='9' | 'x' | 'u' | '\r' | '\n' }) { break alts_4_1; }
                                            pos += 1;
                                            break alts_done_4;
                                        }
                                        break alts_3_0;
                                    }
                                    break alts_done_3;
                                }
                                alts_3_1: {
                                    pos = alts_saved_3;
                                    if pos >= chars.len() || chars[pos] != '0' { break alts_3_1; }
                                    pos += 1;
                                    break alts_done_3;
