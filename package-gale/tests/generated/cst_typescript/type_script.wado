fn classify_keyword(src: &StrSlice, start: i32, end: i32) -> i32 {
    match end - start {
        2 => {
            match unchecked src.byte_at(start) {
                b'a' => { if unchecked src.byte_at(start + 1) == b's' { return TK_As; } },
                b'd' => { if unchecked src.byte_at(start + 1) == b'o' { return TK_Do; } },
                b'i' => {
                    match unchecked src.byte_at(start + 1) {
                        b'f' => { return TK_If; },
                        b'n' => { return TK_In; },
                        b's' => { return TK_Is; },
                        _ => {},
                    }
                },
                b'o' => { if unchecked src.byte_at(start + 1) == b'f' { return TK_Of; } },
                _ => {},
            }
        },
        3 => {
            match unchecked src.byte_at(start) {
                b'a' => { if unchecked src.byte_at(start + 1) == b'n' && unchecked src.byte_at(start + 2) == b'y' { return TK_Any; } },
                b'l' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b't' { return TK_Let; } },
                b'n' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'w' { return TK_New; } },
                b'v' => { if unchecked src.byte_at(start + 1) == b'a' && unchecked src.byte_at(start + 2) == b'r' { return TK_Var; } },
                _ => {},
            }
        },
        4 => {
            match unchecked src.byte_at(start) {
                b'c' => { if unchecked src.byte_at(start + 1) == b'a' && unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b'e' { return TK_Case; } },
                b'e' => {
                    match unchecked src.byte_at(start + 1) {
                        b'l' => { if unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b'e' { return TK_Else; } },
                        b'n' => { if unchecked src.byte_at(start + 2) == b'u' && unchecked src.byte_at(start + 3) == b'm' { return TK_Enum; } },
                        _ => {},
                    }
                },
                b'n' => { if unchecked src.byte_at(start + 1) == b'u' && unchecked src.byte_at(start + 2) == b'l' && unchecked src.byte_at(start + 3) == b'l' { return TK_NullLiteral; } },
                b'v' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b'd' { return TK_Void; } },
                b'w' => { if unchecked src.byte_at(start + 1) == b'i' && unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'h' { return TK_With; } },
                _ => {},
            }
        },
        5 => {
            match unchecked src.byte_at(start) {
                b'a' => {
                    match unchecked src.byte_at(start + 1) {
                        b's' => { if unchecked src.byte_at(start + 2) == b'y' && unchecked src.byte_at(start + 3) == b'n' && unchecked src.byte_at(start + 4) == b'c' { return TK_Async; } },
                        b'w' => { if unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b'i' && unchecked src.byte_at(start + 4) == b't' { return TK_Await; } },
                        _ => {},
                    }
                },
                b'b' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'e' && unchecked src.byte_at(start + 3) == b'a' && unchecked src.byte_at(start + 4) == b'k' { return TK_Break; } },
                b'c' => {
                    match unchecked src.byte_at(start + 1) {
                        b'a' => { if unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'c' && unchecked src.byte_at(start + 4) == b'h' { return TK_Catch; } },
                        b'l' => { if unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b's' && unchecked src.byte_at(start + 4) == b's' { return TK_Class; } },
                        b'o' => { if unchecked src.byte_at(start + 2) == b'n' && unchecked src.byte_at(start + 3) == b's' && unchecked src.byte_at(start + 4) == b't' { return TK_Const; } },
                        _ => {},
                    }
                },
                b'k' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'y' && unchecked src.byte_at(start + 3) == b'o' && unchecked src.byte_at(start + 4) == b'f' { return TK_KeyOf; } },
                b'n' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'v' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'r' { return TK_Never; } },
                b's' => { if unchecked src.byte_at(start + 1) == b'u' && unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'r' { return TK_Super; } },
                b'w' => { if unchecked src.byte_at(start + 1) == b'h' && unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'e' { return TK_While; } },
                b'y' => { if unchecked src.byte_at(start + 1) == b'i' && unchecked src.byte_at(start + 2) == b'e' && unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'd' { return TK_Yield; } },
                _ => {},
            }
        },
        6 => {
            match unchecked src.byte_at(start) {
                b'd' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'l' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b't' && unchecked src.byte_at(start + 5) == b'e' { return TK_Delete; } },
                b'e' => { if unchecked src.byte_at(start + 1) == b'x' && unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'o' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b't' { return TK_Export; } },
                b'i' => { if unchecked src.byte_at(start + 1) == b'm' && unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'o' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b't' { return TK_Import; } },
                b'm' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'd' && unchecked src.byte_at(start + 3) == b'u' && unchecked src.byte_at(start + 4) == b'l' && unchecked src.byte_at(start + 5) == b'e' { return TK_Module; } },
                b'n' => { if unchecked src.byte_at(start + 1) == b'u' && unchecked src.byte_at(start + 2) == b'm' && unchecked src.byte_at(start + 3) == b'b' && unchecked src.byte_at(start + 4) == b'e' && unchecked src.byte_at(start + 5) == b'r' { return TK_Number; } },
                b'o' => { if unchecked src.byte_at(start + 1) == b'b' && unchecked src.byte_at(start + 2) == b'j' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'c' && unchecked src.byte_at(start + 5) == b't' { return TK_Object; } },
                b'p' => { if unchecked src.byte_at(start + 1) == b'u' && unchecked src.byte_at(start + 2) == b'b' && unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'i' && unchecked src.byte_at(start + 5) == b'c' { return TK_Public; } },
                b'r' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'u' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'n' { return TK_Return; } },
                b's' => {
                    match unchecked src.byte_at(start + 1) {
                        b't' => {
                            match unchecked src.byte_at(start + 2) {
                                b'a' => { if unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'i' && unchecked src.byte_at(start + 5) == b'c' { return TK_Static; } },
                                b'r' => { if unchecked src.byte_at(start + 3) == b'i' && unchecked src.byte_at(start + 4) == b'n' && unchecked src.byte_at(start + 5) == b'g' { return TK_String; } },
                                _ => {},
                            }
                        },
                        b'w' => { if unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'c' && unchecked src.byte_at(start + 5) == b'h' { return TK_Switch; } },
                        b'y' => { if unchecked src.byte_at(start + 2) == b'm' && unchecked src.byte_at(start + 3) == b'b' && unchecked src.byte_at(start + 4) == b'o' && unchecked src.byte_at(start + 5) == b'l' { return TK_Symbol; } },
                        _ => {},
                    }
                },
                b'u' => { if unchecked src.byte_at(start + 1) == b'n' && unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b'q' && unchecked src.byte_at(start + 4) == b'u' && unchecked src.byte_at(start + 5) == b'e' { return TK_Unique; } },
                _ => {},
            }
        },
        7 => {
            match unchecked src.byte_at(start) {
                b'b' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'o' && unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'e' && unchecked src.byte_at(start + 5) == b'a' && unchecked src.byte_at(start + 6) == b'n' { return TK_Boolean; } },
                b'd' => {
                    if unchecked src.byte_at(start + 1) == b'e' {
                        match unchecked src.byte_at(start + 2) {
                            b'c' => { if unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'a' && unchecked src.byte_at(start + 5) == b'r' && unchecked src.byte_at(start + 6) == b'e' { return TK_Declare; } },
                            b'f' => { if unchecked src.byte_at(start + 3) == b'a' && unchecked src.byte_at(start + 4) == b'u' && unchecked src.byte_at(start + 5) == b'l' && unchecked src.byte_at(start + 6) == b't' { return TK_Default; } },
                            _ => {},
                        }
                    }
                },
                b'e' => { if unchecked src.byte_at(start + 1) == b'x' && unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'n' && unchecked src.byte_at(start + 5) == b'd' && unchecked src.byte_at(start + 6) == b's' { return TK_Extends; } },
                b'p' => {
                    match unchecked src.byte_at(start + 1) {
                        b'a' => { if unchecked src.byte_at(start + 2) == b'c' && unchecked src.byte_at(start + 3) == b'k' && unchecked src.byte_at(start + 4) == b'a' && unchecked src.byte_at(start + 5) == b'g' && unchecked src.byte_at(start + 6) == b'e' { return TK_Package; } },
                        b'r' => { if unchecked src.byte_at(start + 2) == b'i' && unchecked src.byte_at(start + 3) == b'v' && unchecked src.byte_at(start + 4) == b'a' && unchecked src.byte_at(start + 5) == b't' && unchecked src.byte_at(start + 6) == b'e' { return TK_Private; } },
                        _ => {},
                    }
                },
                b'r' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'q' && unchecked src.byte_at(start + 3) == b'u' && unchecked src.byte_at(start + 4) == b'i' && unchecked src.byte_at(start + 5) == b'r' && unchecked src.byte_at(start + 6) == b'e' { return TK_Require; } },
                _ => {},
            }
        },
        8 => {
            match unchecked src.byte_at(start) {
                b'a' => { if unchecked src.byte_at(start + 1) == b'b' && unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'a' && unchecked src.byte_at(start + 6) == b'c' && unchecked src.byte_at(start + 7) == b't' { return TK_Abstract; } },
                b'c' => { if unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'n' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'i' && unchecked src.byte_at(start + 5) == b'n' && unchecked src.byte_at(start + 6) == b'u' && unchecked src.byte_at(start + 7) == b'e' { return TK_Continue; } },
                b'd' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'b' && unchecked src.byte_at(start + 3) == b'u' && unchecked src.byte_at(start + 4) == b'g' && unchecked src.byte_at(start + 5) == b'g' && unchecked src.byte_at(start + 6) == b'e' && unchecked src.byte_at(start + 7) == b'r' { return TK_Debugger; } },
                b'r' => { if unchecked src.byte_at(start + 1) == b'e' && unchecked src.byte_at(start + 2) == b'a' && unchecked src.byte_at(start + 3) == b'd' && unchecked src.byte_at(start + 4) == b'o' && unchecked src.byte_at(start + 5) == b'n' && unchecked src.byte_at(start + 6) == b'l' && unchecked src.byte_at(start + 7) == b'y' { return TK_ReadOnly; } },
                _ => {},
            }
        },
        9 => {
            match unchecked src.byte_at(start) {
                b'i' => { if unchecked src.byte_at(start + 1) == b'n' && unchecked src.byte_at(start + 2) == b't' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'r' && unchecked src.byte_at(start + 5) == b'f' && unchecked src.byte_at(start + 6) == b'a' && unchecked src.byte_at(start + 7) == b'c' && unchecked src.byte_at(start + 8) == b'e' { return TK_Interface; } },
                b'n' => { if unchecked src.byte_at(start + 1) == b'a' && unchecked src.byte_at(start + 2) == b'm' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b's' && unchecked src.byte_at(start + 5) == b'p' && unchecked src.byte_at(start + 6) == b'a' && unchecked src.byte_at(start + 7) == b'c' && unchecked src.byte_at(start + 8) == b'e' { return TK_Namespace; } },
                b'p' => { if unchecked src.byte_at(start + 1) == b'r' && unchecked src.byte_at(start + 2) == b'o' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'e' && unchecked src.byte_at(start + 5) == b'c' && unchecked src.byte_at(start + 6) == b't' && unchecked src.byte_at(start + 7) == b'e' && unchecked src.byte_at(start + 8) == b'd' { return TK_Protected; } },
                b'u' => { if unchecked src.byte_at(start + 1) == b'n' && unchecked src.byte_at(start + 2) == b'd' && unchecked src.byte_at(start + 3) == b'e' && unchecked src.byte_at(start + 4) == b'f' && unchecked src.byte_at(start + 5) == b'i' && unchecked src.byte_at(start + 6) == b'n' && unchecked src.byte_at(start + 7) == b'e' && unchecked src.byte_at(start + 8) == b'd' { return TK_Undefined; } },
                _ => {},
            }
        },
        10 => {
            if unchecked src.byte_at(start) == b'i' {
                match unchecked src.byte_at(start + 1) {
                    b'm' => { if unchecked src.byte_at(start + 2) == b'p' && unchecked src.byte_at(start + 3) == b'l' && unchecked src.byte_at(start + 4) == b'e' && unchecked src.byte_at(start + 5) == b'm' && unchecked src.byte_at(start + 6) == b'e' && unchecked src.byte_at(start + 7) == b'n' && unchecked src.byte_at(start + 8) == b't' && unchecked src.byte_at(start + 9) == b's' { return TK_Implements; } },
                    b'n' => { if unchecked src.byte_at(start + 2) == b's' && unchecked src.byte_at(start + 3) == b't' && unchecked src.byte_at(start + 4) == b'a' && unchecked src.byte_at(start + 5) == b'n' && unchecked src.byte_at(start + 6) == b'c' && unchecked src.byte_at(start + 7) == b'e' && unchecked src.byte_at(start + 8) == b'o' && unchecked src.byte_at(start + 9) == b'f' { return TK_Instanceof; } },
                    _ => {},
                }
            }
        },
        11 => { if unchecked src.byte_at(start) == b'c' && unchecked src.byte_at(start + 1) == b'o' && unchecked src.byte_at(start + 2) == b'n' && unchecked src.byte_at(start + 3) == b's' && unchecked src.byte_at(start + 4) == b't' && unchecked src.byte_at(start + 5) == b'r' && unchecked src.byte_at(start + 6) == b'u' && unchecked src.byte_at(start + 7) == b'c' && unchecked src.byte_at(start + 8) == b't' && unchecked src.byte_at(start + 9) == b'o' && unchecked src.byte_at(start + 10) == b'r' { return TK_Constructor; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream with TypeScriptLexerBase {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(lexer.src);
    let mut triv_lo = ts.trivia_mark();
    let mut more_start: i32 = -1;
    let mut mode_stack: List<i32> = [];
    let mut current_mode: i32 = 0;
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let mut best_act: i32 = -1;
        let mut best_act_skip = false;
        let first_char = char_at(&lexer.src, start);
        let mut best_push_mode: i32 = -1;
        let mut best_pop_mode = false;
        let mut best_set_mode: i32 = -1;
        let mut best_more = false;
        let mut best_channel: i32 = 0;
        if current_mode == 0 {
            match first_char {
                '\t' | '\u{b}' | '\u{c}' | ' ' | '\u{a0}' => {
                    end = try_WhiteSpaces(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_WhiteSpaces; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 1; best_act = -1; }
                },
                '\n' | '\r' | '\u{2028}' | '\u{2029}' => {
                    end = try_LineTerminator(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_LineTerminator; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 1; best_act = -1; }
                },
                '!' => {
                    end = try_Not(&lexer.src, start);
                    if end > best_end { best_end = end; best_kind = TK_Not; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    let second_char = char_after(&lexer.src, start);
                    match second_char {
                        '=' => {
                            end = try_NotEquals(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_NotEquals; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                            end = try_IdentityNotEquals(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_IdentityNotEquals; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                },
                '"' | '\'' => {
                    let second_char = char_after(&lexer.src, start);
                    match second_char {
                        '\u{0}'..='\t' | '\u{b}'..='\u{c}' | '\u{e}'..='\u{10ffff}' => {
                            end = try_StringLiteral(&lexer.src, start);
                            if end > best_end { best_end = end; best_kind = TK_StringLiteral; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 2; }
                        },
                        _ => {
                        },
                    }
                },
                '#' => {
                    end = try_Hashtag(&lexer.src, start);
