                            if end > best_end { best_end = end; best_kind = TK_BooleanLiteral; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'i' => {
                            end = try_Finally(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_Finally; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'o' => {
                            end = try_For(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_For; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'r' => {
                            end = try_BooleanLiteral(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_BooleanLiteral; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                            end = try_From(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_From; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'u' => {
                            end = try_Function_(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_Function_; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_Identifier(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_Identifier; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                't' => {
                    let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                    match second_char {
                        'a' => {
                            end = try_BooleanLiteral(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_BooleanLiteral; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'h' => {
                            end = try_This(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_This; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                            end = try_Throw(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_Throw; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'r' => {
                            end = try_BooleanLiteral(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_BooleanLiteral; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                            end = try_Try(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_Try; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        'y' => {
                            end = try_Typeof(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_Typeof; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                            end = try_TypeAlias(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_TypeAlias; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_Identifier(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_Identifier; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                'y' => {
                    let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                    match second_char {
                        'i' => {
                            end = try_YieldStar(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_YieldStar; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                    end = try_Identifier(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_Identifier; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '{' => {
                    end = try_OpenBrace(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_OpenBrace; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 0; }
                },
                '|' => {
                    end = try_BitOr(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_BitOr; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                    match second_char {
                        '=' => {
                            end = try_BitOrAssign(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_BitOrAssign; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        '|' => {
                            end = try_Or(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_Or; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                        },
                        _ => {
                        },
                    }
                },
                '}' => {
                    end = try_TemplateCloseBrace(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateCloseBrace; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    end = try_CloseBrace(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_CloseBrace; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 1; }
                },
                '~' => {
                    end = try_BitNot(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_BitNot; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                _ => {},
            }
            if best_end <= start {
                end = try_UnexpectedCharacter(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_UnexpectedCharacter; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 2; best_act = -1; }
            }
        } else if current_mode == 1 {
            match first_char {
                '$' => {
                    let second_char = if start + 1 < lexer.chars.len() { lexer.chars[start + 1] } else { '\u{0}' };
                    match second_char {
                        '{' => {
                            end = try_TemplateStringStartExpression(&lexer.chars, start);
                            if end > best_end { best_end = end; best_kind = TK_TemplateStringStartExpression; best_push_mode = 0; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 5; }
                        },
                        _ => {
                        },
                    }
                    end = try_TemplateStringAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '%'..='[' | ']'..='_' => {
                    end = try_TemplateStringAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '\\' => {
                    end = try_TemplateStringEscapeAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringEscapeAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    end = try_TemplateStringAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '`' => {
                    end = try_BackTickInside(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_BackTick; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 4; }
                    end = try_TemplateStringAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                _ => {
                    end = try_TemplateStringAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
            }
        }
        if best_end < start || (best_end == start && best_push_mode < 0 && !best_pop_mode && best_set_mode < 0) {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            if current_mode == 0 && best_kind == TK_Identifier {
                let kw_kind = classify_keyword(&lexer.chars, start, best_end);
                if kw_kind >= 0 { best_kind = kw_kind; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
            }
            if best_act >= 0 {
                lexer.reset_actions(best_kind, best_channel, mode_stack.len());
                if best_act == 0 {
                    apply_OpenBrace_actions(&mut lexer, start, best_end);
                } else if best_act == 1 {
                    apply_CloseBrace_actions(&mut lexer, start, best_end);
                } else if best_act == 2 {
                    apply_StringLiteral_actions(&mut lexer, start, best_end);
                } else if best_act == 3 {
                    apply_BackTick_actions(&mut lexer, start, best_end);
                } else if best_act == 4 {
                    apply_BackTickInside_actions(&mut lexer, start, best_end);
                } else if best_act == 5 {
                    apply_TemplateStringStartExpression_actions(&mut lexer, start, best_end);
                }
                best_kind = lexer.act_type;
                best_channel = lexer.act_channel;
                if lexer.act_more { best_more = true; }
                if lexer.act_skip { best_act_skip = true; }
                if lexer.act_push_mode >= 0 { best_push_mode = lexer.act_push_mode; }
                if lexer.act_pop_mode { best_pop_mode = true; }
                if lexer.act_set_mode >= 0 { best_set_mode = lexer.act_set_mode; }
            }
            let tok_start = if more_start >= 0 { more_start } else { start };
            let is_skip = false || best_act_skip;
            if !is_skip && !best_more {
                best_kind = TypeScriptLexerBase::emit(LexerView { chars: &lexer.chars, start: tok_start, pos: best_end }, best_kind, best_channel);
            }
            if best_more {
                if more_start < 0 { more_start = start; }
            } else if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
                more_start = -1;
            } else if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
                more_start = -1;
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
                more_start = -1;
            }
            if best_push_mode >= 0 {
                mode_stack.push(current_mode);
                current_mode = best_push_mode;
                best_push_mode = -1;
            }
            if best_pop_mode {
                if mode_stack.is_empty() {
                    current_mode = 0;
                } else {
                    current_mode = mode_stack[mode_stack.len() - 1];
                    mode_stack.pop();
                }
                best_pop_mode = false;
            }
            if best_set_mode >= 0 {
                current_mode = best_set_mode;
                best_set_mode = -1;
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    ts.output = lexer.act_output;
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_MultiLineComment => "MultiLineComment",
        TK_SingleLineComment => "SingleLineComment",
        TK_RegularExpressionLiteral => "RegularExpressionLiteral",
        TK_OpenBracket => "OpenBracket",
        TK_CloseBracket => "CloseBracket",
        TK_OpenParen => "OpenParen",
        TK_CloseParen => "CloseParen",
        TK_OpenBrace => "OpenBrace",
        TK_TemplateCloseBrace => "TemplateCloseBrace",
        TK_CloseBrace => "CloseBrace",
        TK_SemiColon => "SemiColon",
        TK_Comma => "Comma",
        TK_Assign => "Assign",
        TK_QuestionMark => "QuestionMark",
        TK_QuestionMarkDot => "QuestionMarkDot",
        TK_Colon => "Colon",
        TK_Ellipsis => "Ellipsis",
        TK_Dot => "Dot",
        TK_PlusPlus => "PlusPlus",
        TK_MinusMinus => "MinusMinus",
        TK_Plus => "Plus",
        TK_Minus => "Minus",
        TK_BitNot => "BitNot",
        TK_Not => "Not",
        TK_Multiply => "Multiply",
        TK_Divide => "Divide",
        TK_Modulus => "Modulus",
        TK_Power => "Power",
        TK_NullCoalesce => "NullCoalesce",
        TK_Hashtag => "Hashtag",
        TK_LeftShiftArithmetic => "LeftShiftArithmetic",
        TK_LessThan => "LessThan",
        TK_MoreThan => "MoreThan",
        TK_LessThanEquals => "LessThanEquals",
        TK_GreaterThanEquals => "GreaterThanEquals",
        TK_Equals_ => "Equals_",
        TK_NotEquals => "NotEquals",
        TK_IdentityEquals => "IdentityEquals",
        TK_IdentityNotEquals => "IdentityNotEquals",
        TK_BitAnd => "BitAnd",
        TK_BitXOr => "BitXOr",
        TK_BitOr => "BitOr",
        TK_And => "And",
        TK_Or => "Or",
        TK_MultiplyAssign => "MultiplyAssign",
        TK_DivideAssign => "DivideAssign",
        TK_ModulusAssign => "ModulusAssign",
        TK_PlusAssign => "PlusAssign",
        TK_MinusAssign => "MinusAssign",
        TK_LeftShiftArithmeticAssign => "LeftShiftArithmeticAssign",
        TK_RightShiftArithmeticAssign => "RightShiftArithmeticAssign",
        TK_RightShiftLogicalAssign => "RightShiftLogicalAssign",
        TK_BitAndAssign => "BitAndAssign",
        TK_BitXorAssign => "BitXorAssign",
        TK_BitOrAssign => "BitOrAssign",
        TK_PowerAssign => "PowerAssign",
        TK_NullishCoalescingAssign => "NullishCoalescingAssign",
        TK_ARROW => "ARROW",
        TK_NullLiteral => "NullLiteral",
        TK_BooleanLiteral => "BooleanLiteral",
        TK_DecimalLiteral => "DecimalLiteral",
        TK_HexIntegerLiteral => "HexIntegerLiteral",
        TK_OctalIntegerLiteral => "OctalIntegerLiteral",
        TK_OctalIntegerLiteral2 => "OctalIntegerLiteral2",
        TK_BinaryIntegerLiteral => "BinaryIntegerLiteral",
        TK_BigHexIntegerLiteral => "BigHexIntegerLiteral",
        TK_BigOctalIntegerLiteral => "BigOctalIntegerLiteral",
        TK_BigBinaryIntegerLiteral => "BigBinaryIntegerLiteral",
        TK_BigDecimalIntegerLiteral => "BigDecimalIntegerLiteral",
        TK_Break => "Break",
        TK_Do => "Do",
        TK_Instanceof => "Instanceof",
        TK_Typeof => "Typeof",
        TK_Case => "Case",
        TK_Else => "Else",
        TK_New => "New",
        TK_Var => "Var",
        TK_Catch => "Catch",
        TK_Finally => "Finally",
        TK_Return => "Return",
        TK_Void => "Void",
        TK_Continue => "Continue",
        TK_For => "For",
        TK_Switch => "Switch",
        TK_While => "While",
        TK_Debugger => "Debugger",
        TK_Function_ => "Function_",
        TK_This => "This",
        TK_With => "With",
        TK_Default => "Default",
        TK_If => "If",
        TK_Throw => "Throw",
        TK_Delete => "Delete",
        TK_In => "In",
        TK_Try => "Try",
        TK_As => "As",
        TK_From => "From",
        TK_ReadOnly => "ReadOnly",
        TK_Async => "Async",
        TK_Await => "Await",
        TK_Yield => "Yield",
        TK_YieldStar => "YieldStar",
        TK_Class => "Class",
        TK_Enum => "Enum",
        TK_Extends => "Extends",
        TK_Super => "Super",
        TK_Const => "Const",
        TK_Export => "Export",
        TK_Import => "Import",
        TK_Implements => "Implements",
        TK_Let => "Let",
        TK_Private => "Private",
        TK_Public => "Public",
        TK_Interface => "Interface",
        TK_Package => "Package",
        TK_Protected => "Protected",
        TK_Static => "Static",
        TK_Any => "Any",
        TK_Number => "Number",
        TK_Never => "Never",
        TK_Boolean => "Boolean",
        TK_String => "String",
        TK_Unique => "Unique",
        TK_Symbol => "Symbol",
        TK_Undefined => "Undefined",
        TK_Object => "Object",
        TK_Of => "Of",
        TK_KeyOf => "KeyOf",
        TK_TypeAlias => "TypeAlias",
        TK_Constructor => "Constructor",
        TK_Namespace => "Namespace",
        TK_Require => "Require",
        TK_Module => "Module",
        TK_Declare => "Declare",
        TK_Abstract => "Abstract",
        TK_Is => "Is",
        TK_At => "At",
        TK_Identifier => "Identifier",
        TK_StringLiteral => "StringLiteral",
        TK_BackTick => "BackTick",
        TK_WhiteSpaces => "WhiteSpaces",
        TK_LineTerminator => "LineTerminator",
        TK_HtmlComment => "HtmlComment",
        TK_CDataComment => "CDataComment",
        TK_UnexpectedCharacter => "UnexpectedCharacter",
        TK_TemplateStringEscapeAtom => "TemplateStringEscapeAtom",
        TK_BackTickInside => "BackTickInside",
        TK_TemplateStringStartExpression => "TemplateStringStartExpression",
        TK_TemplateStringAtom => "TemplateStringAtom",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

pub global RK_INITIALIZER: NodeKind = 0;
pub global RK_BINDING_PATTERN: NodeKind = 1;
pub global RK_TYPE_PARAMETERS: NodeKind = 2;
pub global RK_TYPE_PARAMETER_LIST: NodeKind = 3;
pub global RK_TYPE_PARAMETER: NodeKind = 4;
pub global RK_CONSTRAINT: NodeKind = 5;
pub global RK_TYPE_ARGUMENTS: NodeKind = 6;
pub global RK_TYPE_ARGUMENT_LIST: NodeKind = 7;
pub global RK_TYPE_ARGUMENT: NodeKind = 8;
pub global RK_TYPE_: NodeKind = 9;
pub global RK_UNION_OR_INTERSECTION_OR_PRIMARY_TYPE: NodeKind = 10;
pub global RK_PRIMARY_TYPE: NodeKind = 11;
pub global RK_PREDEFINED_TYPE: NodeKind = 12;
