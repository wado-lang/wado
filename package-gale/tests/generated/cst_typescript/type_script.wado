pub fn to_string_tree(result: &ParseResult) -> String {
    let mut token_names: List<String> = List::with_capacity(209);
    for let mut k = 0; k < 209; k += 1 {
        token_names.push(token_kind_name(k));
    }
    return result.root.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
}

pub fn to_string_subtree(result: &ParseResult, rule: &String) -> String {
    let mut token_names: List<String> = List::with_capacity(209);
    for let mut k = 0; k < 209; k += 1 {
        token_names.push(token_kind_name(k));
    }
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if RULE_NAMES[i] == *rule {
            _kind = i;
            break;
        }
    }
    if let Some(sub) = result.root.find_child(_kind as NodeKind) {
        return sub.to_string_tree(&result.tokens, &RULE_NAMES, &token_names);
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_LBRACE | TK_LIT_LBRACKET };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_Abstract | TK_Any | TK_As | TK_Async | TK_Boolean | TK_Constructor | TK_From | TK_Identifier | TK_KeyOf | TK_LIT_LT | TK_Namespace | TK_Never | TK_Number | TK_Object | TK_Of | TK_String | TK_Symbol | TK_TypeAlias | TK_Undefined | TK_Unique | TK_Yield };
}

fn _kind_set_2(k: i32) -> bool {
    return k matches { TK_Abstract | TK_Any | TK_As | TK_Async | TK_Boolean | TK_BooleanLiteral | TK_Constructor | TK_DecimalLiteral | TK_From | TK_Identifier | TK_KeyOf | TK_LIT_AMP | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_LT | TK_LIT_NEW | TK_LIT_PIPE | TK_LIT_TYPEOF | TK_Namespace | TK_Never | TK_NullLiteral | TK_Number | TK_Object | TK_Of | TK_String | TK_StringLiteral | TK_Symbol | TK_This | TK_TypeAlias | TK_Undefined | TK_Unique | TK_Void | TK_Yield };
}

fn _kind_set_3(k: i32) -> bool {
    return k matches { TK_LIT_AMP | TK_LIT_PIPE };
