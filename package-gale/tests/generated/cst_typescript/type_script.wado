fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser) with TypeScriptParserBase) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(d) = p.pending {
            p.diagnostics.push(d);
        }
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.tokens.output };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    return parse_initializer(input, max_errors);
}

pub fn parse_initializer<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_initializer(p));
