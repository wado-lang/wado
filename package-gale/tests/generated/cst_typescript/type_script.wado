fn apply_BackTick_actions(lx: &mut Lexer, start: i32, end: i32) with TypeScriptLexerBase {
    let src = &lx.src;
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'`' { return; }
    pos += 1;
    TypeScriptLexerBase::increase_template_depth(LexerView { src, start, pos }, lx);
}

fn apply_BackTickInside_actions(lx: &mut Lexer, start: i32, end: i32) with TypeScriptLexerBase {
    let src = &lx.src;
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'`' { return; }
    pos += 1;
    TypeScriptLexerBase::decrease_template_depth(LexerView { src, start, pos }, lx);
}

fn apply_TemplateStringStartExpression_actions(lx: &mut Lexer, start: i32, end: i32) with TypeScriptLexerBase {
    let src = &lx.src;
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'$' { return; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'{' { return; }
    pos += 1;
    TypeScriptLexerBase::start_template_string(LexerView { src, start, pos }, lx);
}

fn try_MultiLineComment(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { return -1; }
    pos += 1;
    loop {
        let ng_saved_0 = pos;
        let mut ng_exit_0 = false;
        ng_0: {
            if pos >= src.len() || unchecked src.byte_at(pos) != b'*' { break ng_0; }
            pos += 1;
            if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { break ng_0; }
            pos += 1;
            ng_exit_0 = true;
        }
        if ng_exit_0 {
            break;
        }
        pos = ng_saved_0;
        if pos >= src.len() { return -1; }
        pos = src.ceil_char_boundary(pos + 1);
    }
    return pos;
}

fn try_SingleLineComment(src: &StrSlice, start: i32) -> i32 {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    loop {
        rep_0: {
            if pos >= src.len() { break rep_0; }
            if (char_at(src, pos) matches { '\r' | '\n' | '\u{2028}' | '\u{2029}' }) { break rep_0; }
            pos = src.ceil_char_boundary(pos + 1);
            continue;
        }
        break;
    }
    return pos;
}

fn try_RegularExpressionLiteral(src: &StrSlice, start: i32) -> i32 with TypeScriptLexerBase {
    let mut pos = start;
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    pos = frag_RegularExpressionFirstChar(src, pos);
    if pos < 0 { return -1; }
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            pos = frag_RegularExpressionChar(src, pos);
            if pos < 0 { break rep_0; }
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    if !TypeScriptLexerBase::is_regex_possible(LexerView { src, start, pos }) { return -1; }
    if pos >= src.len() || unchecked src.byte_at(pos) != b'/' { return -1; }
    pos += 1;
    loop {
        let rep_saved_1 = pos;
        rep_1: {
            pos = frag_IdentifierPart(src, pos);
            if pos < 0 { break rep_1; }
            continue;
        }
        pos = rep_saved_1;
        break;
    }
    return pos;
}

