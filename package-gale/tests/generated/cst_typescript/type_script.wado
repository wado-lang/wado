    let _start = p.peek_start();
    p.b.start_node(RK_RESERVED_WORD, _start);
    _parse_reserved_word__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_RESERVED_WORD, "reservedWord", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn _parse_keyword__inner(p: &mut Parser, follow: i64 = 0) -> () with TypeScriptParserBase {
    if !kind_set_has(&SYNC_87, p.kinds[p.pos]) { builtin::cold_path(); p.sync_alts(&SYNC_87, &EXPECTED_87); }
    let kind = p.peek_kind();
    if _kind_set_117(kind) {
        p.take();
        return;
    }
    p.no_viable(
        "no alternative of keyword matches",
        p.peek_span(),
        &EXPECTED_87,
    );
    return;
}

fn _parse_keyword(p: &mut Parser, follow: i64 = 0) -> () with TypeScriptParserBase {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_KEYWORD, _start);
    _parse_keyword__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_KEYWORD, "keyword", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn _parse_eos__inner(p: &mut Parser, follow: i64 = 0) -> () with TypeScriptParserBase {
    let kind = p.peek_kind();
    if kind == TK_SemiColon {
        p.take();
        return;
    }
    if kind == TK_EOF {
        p.take();
        return;
    }
    if pred_15(p) {
        return;
    }
    if pred_16(p) {
        return;
    }
    p.no_viable(
        "no alternative of eos matches",
        p.peek_span(),
        &EXPECTED_88,
    );
    return;
}

fn _parse_eos(p: &mut Parser, follow: i64 = 0) -> () with TypeScriptParserBase {
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    if p.recovering { return; }
    p.atn.stack.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_EOS, _start);
    _parse_eos__inner(p, follow);
    if p.recovering { let _ = p.recover_rule(RK_EOS, "eos", -1); }
    p.b.finish_node(p.last_end());
    p.atn.stack.pop();
    p.sites.pop();
}

fn pred_0(p: &Parser) -> bool with TypeScriptParserBase {
    return TypeScriptParserBase::not_line_terminator(p);
}

fn pred_15(p: &Parser) -> bool with TypeScriptParserBase {
    return TypeScriptParserBase::line_terminator_ahead(p);
}

fn pred_16(p: &Parser) -> bool with TypeScriptParserBase {
    return TypeScriptParserBase::close_brace(p);
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser) with TypeScriptParserBase) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        p.commit_pending();
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.tokens.output };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    return parse_initializer(input, max_errors);
