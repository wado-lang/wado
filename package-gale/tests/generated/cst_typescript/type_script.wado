pub global RK_NAMESPACE_NAME: NodeKind = 51;
pub global RK_IMPORT_ALIAS_DECLARATION: NodeKind = 52;
pub global RK_DECORATOR_LIST: NodeKind = 53;
pub global RK_DECORATOR: NodeKind = 54;
pub global RK_DECORATOR_MEMBER_EXPRESSION: NodeKind = 55;
pub global RK_DECORATOR_CALL_EXPRESSION: NodeKind = 56;
pub global RK_PROGRAM: NodeKind = 57;
pub global RK_SOURCE_ELEMENT: NodeKind = 58;
