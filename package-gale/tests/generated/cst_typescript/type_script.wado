fn atn_decide_2(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            == TK_Comma => {
                return 0;
            },
            == TK_MoreThan => {
                return 1;
            },
            _ => {},
        };
    }
    return atn_predict_once(&ATN_SIM, 2, atn, tokens, pos, TK_EOF, min_prec);
}

fn atn_decide_4(atn: &mut AtnPredictor, tokens: &Array<i32>, pos: i32, min_prec: i32) -> i32 {
    if pos < tokens.len() {
        match tokens[pos] {
            == TK_Comma | == TK_MoreThan => {
                return 1;
            },
            == TK_Extends => {
                return 0;
