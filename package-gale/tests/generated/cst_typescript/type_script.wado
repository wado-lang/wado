            if alive.len() == 1 {
                return atn_first_enabled_alt(&alive, disabled_alts);
            }
            return ATN_READS_HIDDEN;
        }
        guard += 1;
        if guard > limit {
            return atn_first_enabled_alt(&prev, disabled_alts);
        }
        let alts = atn_unique_alts(&configs);
        if alts.is_empty() {
            return atn_first_enabled_alt(&prev, disabled_alts);
        }
        let first_enabled = atn_first_enabled_alt(&alts, disabled_alts);
        if first_enabled < 0
            || alts.len() == 1
            || atn_min_alt_covers_rest(&mut arena, &configs, first_enabled)
            || atn_all_at_end(sim, &configs) {
            return first_enabled;
        }
        prev = alts;
        let token = if pos < tokens.len() { tokens[pos] } else { eof };
        let moved = atn_move(sim, &configs, token, eof);
        pos += 1;
        configs = atn_closure(sim, &mut arena, &moved, &mut scratch);
    }
}
