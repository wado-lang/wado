global RULE_NAMES: List<String> = ["initializer", "bindingPattern", "typeParameters", "typeParameterList", "typeParameter", "constraint", "typeArguments", "typeArgumentList", "typeArgument", "type_", "unionOrIntersectionOrPrimaryType", "primaryType", "predefinedType", "typeReference", "typeGeneric", "typeName", "objectType", "typeBody", "typeMemberList", "typeMember", "arrayType", "tupleType", "tupleElementTypes", "functionType", "constructorType", "typeQuery", "typeQueryExpression", "propertySignatur", "typeAnnotation", "callSignature", "parameterList", "requiredParameterList", "parameter", "optionalParameter", "restParameter", "requiredParameter", "accessibilityModifier", "identifierOrPattern", "constructSignature", "indexSignature", "methodSignature", "typeAliasDeclaration", "constructorDeclaration", "interfaceDeclaration", "interfaceExtendsClause", "classOrInterfaceTypeList", "enumDeclaration", "enumBody", "enumMemberList", "enumMember", "namespaceDeclaration", "namespaceName", "importAliasDeclaration", "decoratorList", "decorator", "decoratorMemberExpression", "decoratorCallExpression", "program", "sourceElement", "statement", "block", "statementList", "abstractDeclaration", "importStatement", "importFromBlock", "importModuleItems", "importAliasName", "moduleExportName", "importedBinding", "importDefault", "importNamespace", "importFrom", "aliasName", "exportStatement", "exportFromBlock", "exportModuleItems", "exportAliasName", "declaration", "variableStatement", "variableDeclarationList", "variableDeclaration", "emptyStatement_", "expressionStatement", "ifStatement", "iterationStatement", "varModifier", "continueStatement", "breakStatement", "returnStatement", "yieldStatement", "withStatement", "switchStatement", "caseBlock", "caseClauses", "caseClause", "defaultClause", "labelledStatement", "throwStatement", "tryStatement", "catchProduction", "finallyProduction", "debuggerStatement", "functionDeclaration", "classDeclaration", "classHeritage", "classTail", "classExtendsClause", "implementsClause", "classElement", "propertyMemberDeclaration", "propertyMemberBase", "indexMemberDeclaration", "generatorMethod", "generatorFunctionDeclaration", "generatorBlock", "generatorDefinition", "iteratorBlock", "iteratorDefinition", "classElementName", "privateIdentifier", "formalParameterList", "formalParameterArg", "lastFormalParameterArg", "functionBody", "sourceElements", "arrayLiteral", "elementList", "arrayElement", "objectLiteral", "propertyAssignment", "getAccessor", "setAccessor", "propertyName", "arguments", "argumentList", "argument", "expressionSequence", "singleExpression", "asExpression", "assignable", "anonymousFunction", "arrowFunctionDeclaration", "arrowFunctionParameters", "arrowFunctionBody", "assignmentOperator", "literal", "templateStringLiteral", "templateStringAtom", "numericLiteral", "bigintLiteral", "getter", "setter", "identifierName", "identifier", "identifierOrKeyWord", "reservedWord", "keyword", "eos"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

pub enum UnionOrIntersectionOrPrimaryTypeAlt {
    Union,
    Intersection,
    Primary,
}

impl CstStore {
    pub fn union_or_intersection_or_primary_type_alt(&self, node: i32) -> Option<UnionOrIntersectionOrPrimaryTypeAlt> {
        return match self.alt(node) {
            0 => Option::Some(UnionOrIntersectionOrPrimaryTypeAlt::Union),
            1 => Option::Some(UnionOrIntersectionOrPrimaryTypeAlt::Intersection),
            2 => Option::Some(UnionOrIntersectionOrPrimaryTypeAlt::Primary),
            _ => null,
        };
    }
}

pub enum PrimaryTypeAlt {
    ParenthesizedPrimType,
    PredefinedPrimType,
    ReferencePrimType,
    ObjectPrimType,
    ArrayPrimType,
    TuplePrimType,
    QueryPrimType,
    ThisPrimType,
    RedefinitionOfType,
    KeyOfType,
}

impl CstStore {
    pub fn primary_type_alt(&self, node: i32) -> Option<PrimaryTypeAlt> {
        return match self.alt(node) {
            0 => Option::Some(PrimaryTypeAlt::ParenthesizedPrimType),
            1 => Option::Some(PrimaryTypeAlt::PredefinedPrimType),
            2 => Option::Some(PrimaryTypeAlt::ReferencePrimType),
            3 => Option::Some(PrimaryTypeAlt::ObjectPrimType),
            4 => Option::Some(PrimaryTypeAlt::ArrayPrimType),
            5 => Option::Some(PrimaryTypeAlt::TuplePrimType),
            6 => Option::Some(PrimaryTypeAlt::QueryPrimType),
            7 => Option::Some(PrimaryTypeAlt::ThisPrimType),
            8 => Option::Some(PrimaryTypeAlt::RedefinitionOfType),
            9 => Option::Some(PrimaryTypeAlt::KeyOfType),
            _ => null,
        };
    }
}

pub enum ExportStatementAlt {
    ExportDeclaration,
    ExportDefaultDeclaration,
}

impl CstStore {
    pub fn export_statement_alt(&self, node: i32) -> Option<ExportStatementAlt> {
        return match self.alt(node) {
            0 => Option::Some(ExportStatementAlt::ExportDeclaration),
            1 => Option::Some(ExportStatementAlt::ExportDefaultDeclaration),
            _ => null,
        };
    }
}

pub enum IterationStatementAlt {
    DoStatement,
    WhileStatement,
    ForStatement,
    ForVarStatement,
    ForInStatement,
    ForVarInStatement,
    ForOfStatement,
    ForVarOfStatement,
}

impl CstStore {
    pub fn iteration_statement_alt(&self, node: i32) -> Option<IterationStatementAlt> {
        return match self.alt(node) {
            0 => Option::Some(IterationStatementAlt::DoStatement),
            1 => Option::Some(IterationStatementAlt::WhileStatement),
            2 => Option::Some(IterationStatementAlt::ForStatement),
            3 => Option::Some(IterationStatementAlt::ForVarStatement),
            4 => Option::Some(IterationStatementAlt::ForInStatement),
            5 => Option::Some(IterationStatementAlt::ForVarInStatement),
            6 => Option::Some(IterationStatementAlt::ForOfStatement),
            7 => Option::Some(IterationStatementAlt::ForVarOfStatement),
            _ => null,
        };
    }
}

pub enum PropertyMemberDeclarationAlt {
    PropertyDeclarationExpression,
    MethodDeclarationExpression,
    GetterSetterDeclarationExpression,
    AbstractMemberDeclaration,
}

impl CstStore {
    pub fn property_member_declaration_alt(&self, node: i32) -> Option<PropertyMemberDeclarationAlt> {
        return match self.alt(node) {
            0 => Option::Some(PropertyMemberDeclarationAlt::PropertyDeclarationExpression),
            1 => Option::Some(PropertyMemberDeclarationAlt::MethodDeclarationExpression),
            2 => Option::Some(PropertyMemberDeclarationAlt::GetterSetterDeclarationExpression),
            3 => Option::Some(PropertyMemberDeclarationAlt::AbstractMemberDeclaration),
            _ => null,
        };
    }
}

pub enum PropertyAssignmentAlt {
    PropertyExpressionAssignment,
    ComputedPropertyExpressionAssignment,
    PropertyGetter,
    PropertySetter,
    MethodProperty,
    PropertyShorthand,
    SpreadOperator,
    RestParameterInObject,
}

impl CstStore {
    pub fn property_assignment_alt(&self, node: i32) -> Option<PropertyAssignmentAlt> {
        return match self.alt(node) {
            0 => Option::Some(PropertyAssignmentAlt::PropertyExpressionAssignment),
            1 => Option::Some(PropertyAssignmentAlt::ComputedPropertyExpressionAssignment),
            2 => Option::Some(PropertyAssignmentAlt::PropertyGetter),
            3 => Option::Some(PropertyAssignmentAlt::PropertySetter),
            4 => Option::Some(PropertyAssignmentAlt::MethodProperty),
            5 => Option::Some(PropertyAssignmentAlt::PropertyShorthand),
            6 => Option::Some(PropertyAssignmentAlt::SpreadOperator),
            7 => Option::Some(PropertyAssignmentAlt::RestParameterInObject),
            _ => null,
        };
    }
}

pub enum SingleExpressionAlt {
    FunctionExpression,
    ClassExpression,
    MemberIndexExpression,
    OptionalChainExpression,
    MemberDotExpression,
    NewExpression,
    ArgumentsExpression,
    PostIncrementExpression,
    PostDecreaseExpression,
    DeleteExpression,
    VoidExpression,
    TypeofExpression,
    PreIncrementExpression,
    PreDecreaseExpression,
    UnaryPlusExpression,
    UnaryMinusExpression,
    BitNotExpression,
    NotExpression,
    AwaitExpression,
    PowerExpression,
    MultiplicativeExpression,
    AdditiveExpression,
    CoalesceExpression,
    BitShiftExpression,
    RelationalExpression,
    InstanceofExpression,
    InExpression,
    EqualityExpression,
    BitAndExpression,
    BitXOrExpression,
    BitOrExpression,
    LogicalAndExpression,
    LogicalOrExpression,
    TernaryExpression,
    AssignmentExpression,
    AssignmentOperatorExpression,
    TemplateStringExpression,
    IteratorsExpression,
    GeneratorsExpression,
    GeneratorsFunctionExpression,
    YieldExpression,
    ThisExpression,
    IdentifierExpression,
    SuperExpression,
    LiteralExpression,
    ArrayLiteralExpression,
    ObjectLiteralExpression,
    ParenthesizedExpression,
    GenericTypes,
    CastAsExpression,
    NonNullAssertionExpression,
}

impl CstStore {
    pub fn single_expression_alt(&self, node: i32) -> Option<SingleExpressionAlt> {
        return match self.alt(node) {
            0 => Option::Some(SingleExpressionAlt::FunctionExpression),
            1 => Option::Some(SingleExpressionAlt::ClassExpression),
            2 => Option::Some(SingleExpressionAlt::MemberIndexExpression),
            3 => Option::Some(SingleExpressionAlt::OptionalChainExpression),
            4 => Option::Some(SingleExpressionAlt::MemberDotExpression),
            5 => Option::Some(SingleExpressionAlt::MemberDotExpression),
            6 => Option::Some(SingleExpressionAlt::NewExpression),
            7 => Option::Some(SingleExpressionAlt::NewExpression),
            8 => Option::Some(SingleExpressionAlt::ArgumentsExpression),
            9 => Option::Some(SingleExpressionAlt::PostIncrementExpression),
            10 => Option::Some(SingleExpressionAlt::PostDecreaseExpression),
            11 => Option::Some(SingleExpressionAlt::DeleteExpression),
            12 => Option::Some(SingleExpressionAlt::VoidExpression),
            13 => Option::Some(SingleExpressionAlt::TypeofExpression),
            14 => Option::Some(SingleExpressionAlt::PreIncrementExpression),
            15 => Option::Some(SingleExpressionAlt::PreDecreaseExpression),
            16 => Option::Some(SingleExpressionAlt::UnaryPlusExpression),
            17 => Option::Some(SingleExpressionAlt::UnaryMinusExpression),
            18 => Option::Some(SingleExpressionAlt::BitNotExpression),
            19 => Option::Some(SingleExpressionAlt::NotExpression),
            20 => Option::Some(SingleExpressionAlt::AwaitExpression),
            21 => Option::Some(SingleExpressionAlt::PowerExpression),
            22 => Option::Some(SingleExpressionAlt::MultiplicativeExpression),
            23 => Option::Some(SingleExpressionAlt::AdditiveExpression),
            24 => Option::Some(SingleExpressionAlt::CoalesceExpression),
            25 => Option::Some(SingleExpressionAlt::BitShiftExpression),
            26 => Option::Some(SingleExpressionAlt::RelationalExpression),
            27 => Option::Some(SingleExpressionAlt::InstanceofExpression),
            28 => Option::Some(SingleExpressionAlt::InExpression),
            29 => Option::Some(SingleExpressionAlt::EqualityExpression),
            30 => Option::Some(SingleExpressionAlt::BitAndExpression),
            31 => Option::Some(SingleExpressionAlt::BitXOrExpression),
            32 => Option::Some(SingleExpressionAlt::BitOrExpression),
            33 => Option::Some(SingleExpressionAlt::LogicalAndExpression),
            34 => Option::Some(SingleExpressionAlt::LogicalOrExpression),
            35 => Option::Some(SingleExpressionAlt::TernaryExpression),
            36 => Option::Some(SingleExpressionAlt::AssignmentExpression),
            37 => Option::Some(SingleExpressionAlt::AssignmentOperatorExpression),
            38 => Option::Some(SingleExpressionAlt::TemplateStringExpression),
            39 => Option::Some(SingleExpressionAlt::IteratorsExpression),
            40 => Option::Some(SingleExpressionAlt::GeneratorsExpression),
            41 => Option::Some(SingleExpressionAlt::GeneratorsFunctionExpression),
            42 => Option::Some(SingleExpressionAlt::YieldExpression),
            43 => Option::Some(SingleExpressionAlt::ThisExpression),
            44 => Option::Some(SingleExpressionAlt::IdentifierExpression),
            45 => Option::Some(SingleExpressionAlt::SuperExpression),
            46 => Option::Some(SingleExpressionAlt::LiteralExpression),
            47 => Option::Some(SingleExpressionAlt::ArrayLiteralExpression),
            48 => Option::Some(SingleExpressionAlt::ObjectLiteralExpression),
            49 => Option::Some(SingleExpressionAlt::ParenthesizedExpression),
            50 => Option::Some(SingleExpressionAlt::GenericTypes),
            51 => Option::Some(SingleExpressionAlt::CastAsExpression),
            52 => Option::Some(SingleExpressionAlt::NonNullAssertionExpression),
            _ => null,
        };
    }
}

pub interface TypeScriptParserBase {
    fn not_line_terminator(p: &Parser) -> bool;
    fn not_open_brace_and_not_function_and_not_interface(p: &Parser) -> bool;
    fn p(p: &Parser, a0: String) -> bool;
    fn n(p: &Parser, a0: String) -> bool;
    fn line_terminator_ahead(p: &Parser) -> bool;
    fn close_brace(p: &Parser) -> bool;
}

pub struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    line_starts: List<i32>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], line_starts: line_starts(tokens.chars) };
    }

    pub fn emit(&mut self, s: String) {
        self.tokens.output.push_str(&s);
    }

    pub fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    pub fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    pub fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.chars[j] == '-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.chars[j];
            if c.is_ascii_digit() {
                acc = acc * 10 + (c as i32 - '0' as i32);
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    pub fn token_line(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).0;
    }

    pub fn token_col(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).1;
    }

    pub fn token_start(&self, i: i32) -> i32 {
        return self.tokens.starts[i];
    }

    pub fn la(&self, k: i32) -> i32 {
        return self.peek_at(k - 1);
    }

    pub fn lt(&self, k: i32) -> i32 {
        let idx = self.pos + k - 1;
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    pub fn text_span(&self, start: i32, end: i32) -> String {
        let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };
        return chars_text(self.tokens.chars, start, hi);
    }

    pub fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    pub fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    pub fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.chars.len());
    }

    pub fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    pub fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    pub fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    pub fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.recovering = true;
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
        }
        self.recovering = true;
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            let code = if self.kinds[self.pos] == TK_EOF { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
            self.fail_on_token("got", &([kind] as List<i32>), code);
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn report_extra(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::Deleted));
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let found = self.kinds[self.pos];
        let at_eof = found == TK_EOF;
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.diagnostics.push(Diagnostic::error(code, `missing ${token_kind_name(kind)}`, self.tokens.span_at(self.pos), [kind], found, recovery));
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::SkippedTo));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(kind);
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if kind_set_has(sync, self.kinds[self.pos]) {
            self.report_missing(kind);
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(kind);
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || kind_set_has(sync, _k) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        let kind = self.kinds[self.pos];
        if kind == TK_EOF {
            self.b.token(self.pos);
            return self.pos;
        }
        let _i = self.advance();
        self.b.token(_i);
        return _i;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("expected any token; got", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !kind_set_has(excluded, k) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("unexpected token", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>, expected: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if kind_set_has(included, k) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("got", expected, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

fn scan_initializer(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Assign { return -1; }
    pos += 1;
    pos = scan_single_expression(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_binding_pattern(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    sg_0_done: {
        let sgk_0 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        if sgk_0 == TK_OpenBracket {
            sg_0_0: {
                pos = scan_array_literal(tokens, pos, 0);
                if pos < 0 { break sg_0_0; }
                break sg_0_done;
            }
        } else if sgk_0 == TK_OpenBrace {
            sg_0_1: {
                pos = scan_object_literal(tokens, pos, 0);
                if pos < 0 { break sg_0_1; }
                break sg_0_done;
            }
        }
        return -1;
    }
    return pos;
}

fn scan_type_parameters(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LessThan { return -1; }
    pos += 1;
    if pos < tokens.len() && _kind_set_0(tokens[pos]) {
        let sp = pos;
        pos = scan_type_parameter_list(tokens, pos, (FOLLOW_MASK_0 | (follow & FOLLOW_SEQUENCED) << 8) & FOLLOW_CONT_MASK);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_MoreThan { return -1; }
    pos += 1;
    return pos;
}

fn scan_type_parameter_list(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_type_parameter(tokens, pos, (FOLLOW_MASK_1 | (follow & FOLLOW_SEQUENCED | FOLLOW_OPENS_BIT) << 16) & FOLLOW_CONT_MASK);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_Comma && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
        let sp = pos;
        sg_1_done: {
            sg_1: {
                pos += 1;
                pos = scan_type_parameter(tokens, pos, (FOLLOW_MASK_1 | (follow & FOLLOW_SEQUENCED | FOLLOW_OPENS_BIT) << 16) & FOLLOW_CONT_MASK);
                if pos < 0 { break sg_1; }
                break sg_1_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_type_parameter(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_19(alt_kind) {
            let mut best: i32 = -1;
            pos = start + 1;
            try_1: {
                if pos >= tokens.len() || tokens[pos] != TK_Assign { break try_1; }
                pos += 1;
                pos = scan_type_argument(tokens, pos, follow);
                if pos < 0 { break try_1; }
                if pos > best { best = pos; }
            }
            pos = start + 1;
            if pos < tokens.len() && tokens[pos] == TK_Extends && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
                let sp = pos;
                pos = scan_constraint(tokens, pos, follow);
                if pos < 0 { pos = sp; }
            }
            if pos > best { best = pos; }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LessThan {
            try_2: {
                pos = scan_type_parameters(tokens, pos, follow);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_constraint(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Extends { return -1; }
    pos += 1;
    pos = scan_type_(tokens, pos, follow);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_type_arguments(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LessThan { return -1; }
    pos += 1;
    if pos < tokens.len() && _kind_set_1(tokens[pos]) {
        let sp = pos;
        pos = scan_type_argument_list(tokens, pos, (FOLLOW_MASK_0 | (follow & FOLLOW_SEQUENCED) << 8) & FOLLOW_CONT_MASK);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_MoreThan { return -1; }
    pos += 1;
    return pos;
}

fn scan_type_argument_list(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    pos = scan_type_argument(tokens, pos, (FOLLOW_MASK_3 | (follow & FOLLOW_SEQUENCED | FOLLOW_OPENS_BIT) << 16) & FOLLOW_CONT_MASK);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_Comma && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                pos += 1;
                pos = scan_type_argument(tokens, pos, (FOLLOW_MASK_3 | (follow & FOLLOW_SEQUENCED | FOLLOW_OPENS_BIT) << 16) & FOLLOW_CONT_MASK);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_type_argument(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let scan_start = pos;
    let mut pos = pos;
    pos = scan_type_(tokens, pos, follow);
    if pos < 0 { return -1; }
    if pos == scan_start { return -1; }
    return pos;
}

fn scan_type__alt_0(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && _kind_set_2(tokens[pos]) {
        let sp = pos;
        pos += 1;
        if pos < 0 { pos = sp; }
    }
    pos = scan_union_or_intersection_or_primary_type(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_type_(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_34(alt_kind) {
            pos = scan_type__alt_0(tokens, start, follow);
            if pos >= 0 { break scan_alts; }
            return -1;
        } else if alt_kind == TK_OpenParen {
            let mut best: i32 = -1;
            let try_1_end = scan_function_type(tokens, start, follow);
            if try_1_end > best { best = try_1_end; }
            let try_0_end = scan_type__alt_0(tokens, start, follow);
            if try_0_end > best { best = try_0_end; }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LessThan {
            let mut best: i32 = -1;
            let try_1_end = scan_function_type(tokens, start, follow);
            if try_1_end > best { best = try_1_end; }
            pos = start;
