    if pos >= chars.len() || chars[pos] != '\\' { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] matches { '\r' | '\n' | '\u{2028}' | '\u{2029}' }) { return -1; }
    pos += 1;
    loop {
        rep_51: {
            if pos >= chars.len() { break rep_51; }
            if !(chars[pos] matches { '\r' | '\n' | '\u{2028}' | '\u{2029}' }) { break rep_51; }
            pos += 1;
            continue;
        }
        break;
    }
    return pos;
}

fn frag_CharacterEscapeSequence(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_53 = pos;
    alts_done_53: {
        alts_53_0: {
            pos = alts_saved_53;
            if pos >= chars.len() { break alts_53_0; }
            if !(chars[pos] matches { '"' | '\'' | '\\' | 'b' | 'f' | 'n' | 'r' | 't' | 'v' }) { break alts_53_0; }
            pos += 1;
            break alts_done_53;
        }
        alts_53_1: {
            pos = alts_saved_53;
            pos = frag_NonEscapeCharacter(chars, pos);
            if pos < 0 { break alts_53_1; }
            break alts_done_53;
        }
        return -1;
    }
    return pos;
}

fn frag_HexEscapeSequence(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'x' { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' }) { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' }) { return -1; }
    pos += 1;
    return pos;
}

fn frag_ExtendedUnicodeEscapeSequence(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || chars[pos] != 'u' { return -1; }
    pos += 1;
    if pos >= chars.len() || chars[pos] != '{' { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    if !(chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' }) { return -1; }
    pos += 1;
    loop {
        rep_54: {
            if pos >= chars.len() { break rep_54; }
            if !(chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' }) { break rep_54; }
            pos += 1;
            continue;
        }
        break;
    }
    if pos >= chars.len() || chars[pos] != '}' { return -1; }
    pos += 1;
    return pos;
}

fn frag_NonEscapeCharacter(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if (chars[pos] matches { '\'' | '"' | '\\' | 'b' | 'f' | 'n' | 'r' | 't' | 'v' | '0'..='9' | 'x' | 'u' | '\r' | '\n' }) { return -1; }
    pos += 1;
    return pos;
}

