pub global RK_REQUIRED_PARAMETER_LIST: NodeKind = 31;
pub global RK_PARAMETER: NodeKind = 32;
pub global RK_OPTIONAL_PARAMETER: NodeKind = 33;
pub global RK_REST_PARAMETER: NodeKind = 34;
pub global RK_REQUIRED_PARAMETER: NodeKind = 35;
pub global RK_ACCESSIBILITY_MODIFIER: NodeKind = 36;
pub global RK_IDENTIFIER_OR_PATTERN: NodeKind = 37;
pub global RK_CONSTRUCT_SIGNATURE: NodeKind = 38;
pub global RK_INDEX_SIGNATURE: NodeKind = 39;
