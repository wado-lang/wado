            24 => Option::Some(SingleExpressionAlt::CoalesceExpression),
            25 => Option::Some(SingleExpressionAlt::BitShiftExpression),
            26 => Option::Some(SingleExpressionAlt::RelationalExpression),
            27 => Option::Some(SingleExpressionAlt::InstanceofExpression),
            28 => Option::Some(SingleExpressionAlt::InExpression),
            29 => Option::Some(SingleExpressionAlt::EqualityExpression),
            30 => Option::Some(SingleExpressionAlt::BitAndExpression),
            31 => Option::Some(SingleExpressionAlt::BitXOrExpression),
            32 => Option::Some(SingleExpressionAlt::BitOrExpression),
            33 => Option::Some(SingleExpressionAlt::LogicalAndExpression),
            34 => Option::Some(SingleExpressionAlt::LogicalOrExpression),
            35 => Option::Some(SingleExpressionAlt::TernaryExpression),
            36 => Option::Some(SingleExpressionAlt::AssignmentExpression),
            37 => Option::Some(SingleExpressionAlt::AssignmentOperatorExpression),
            38 => Option::Some(SingleExpressionAlt::TemplateStringExpression),
            39 => Option::Some(SingleExpressionAlt::IteratorsExpression),
            40 => Option::Some(SingleExpressionAlt::GeneratorsExpression),
            41 => Option::Some(SingleExpressionAlt::GeneratorsFunctionExpression),
            42 => Option::Some(SingleExpressionAlt::YieldExpression),
            43 => Option::Some(SingleExpressionAlt::ThisExpression),
            44 => Option::Some(SingleExpressionAlt::IdentifierExpression),
            45 => Option::Some(SingleExpressionAlt::SuperExpression),
            46 => Option::Some(SingleExpressionAlt::LiteralExpression),
            47 => Option::Some(SingleExpressionAlt::ArrayLiteralExpression),
            48 => Option::Some(SingleExpressionAlt::ObjectLiteralExpression),
            49 => Option::Some(SingleExpressionAlt::ParenthesizedExpression),
            50 => Option::Some(SingleExpressionAlt::GenericTypes),
            51 => Option::Some(SingleExpressionAlt::CastAsExpression),
            52 => Option::Some(SingleExpressionAlt::NonNullAssertionExpression),
            _ => null,
        };
    }
}

pub interface TypeScriptParserBase {
    fn not_line_terminator(p: &Parser) -> bool;
    fn not_open_brace_and_not_function_and_not_interface(p: &Parser) -> bool;
    fn p(p: &Parser, a0: String) -> bool;
    fn n(p: &Parser, a0: String) -> bool;
    fn line_terminator_ahead(p: &Parser) -> bool;
    fn close_brace(p: &Parser) -> bool;
}

pub struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<ParseError>,
    recovering: bool,
    pending_code: DiagnosticCode,
    speculating: bool,
    max_errors: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    output: String,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, pending_code: DiagnosticCode::UnexpectedToken, speculating: false, max_errors: i32::MAX, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], output: "" };
    }

    pub fn emit(&mut self, s: String) {
        self.output.push_str(&s);
    }

    pub fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    pub fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    pub fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.chars[j] == '-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.chars[j];
            if c.is_ascii_digit() {
                acc = acc * 10 + (c as i32 - '0' as i32);
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    pub fn token_line(&self, i: i32) -> i32 {
        return line_col(self.tokens.chars, self.tokens.span_at(i).start).0;
    }

    pub fn token_col(&self, i: i32) -> i32 {
        return line_col(self.tokens.chars, self.tokens.span_at(i).start).1;
    }

    pub fn token_start(&self, i: i32) -> i32 {
        return self.tokens.starts[i];
    }

    pub fn la(&self, k: i32) -> i32 {
        return self.peek_at(k - 1);
    }

    pub fn lt(&self, k: i32) -> i32 {
        let idx = self.pos + k - 1;
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    pub fn text_span(&self, start: i32, end: i32) -> String {
        let mut out = String::new();
        let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };
        for let mut i = start; i < hi; i += 1 {
            out.push(self.tokens.chars[i]);
        }
        return out;
    }

    pub fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    pub fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    pub fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.chars.len());
    }

    pub fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    pub fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    pub fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    pub fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn error(&self, message: String, span: Span, expected: &List<i32>) -> ParseError {
        let lc = line_col(self.tokens.chars, span.start);
        return ParseError::at(message, span, kind_names(expected), lc.0, lc.1);
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        let take = if let Some(cur) = &self.pending { span.start > cur.span.start } else { true };
        if take {
            self.pending = Option::Some(self.error(message, span, expected));
            self.pending_code = code;
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn in_set(&self, k: i32, set: &List<i32>) -> bool {
        for let x of set { if *x == k { return true; } }
        return false;
    }

    fn report_extra(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn report_missing(&mut self, kind: i32, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        let name = token_kind_name(kind);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::MissingToken, `missing ${name}`, span, lc.0, lc.1));
    }

    fn report_unexpected(&mut self, span: Span) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let lc = line_col(self.tokens.chars, span.start);
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, span, lc.0, lc.1));
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail(`got "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), &([kind] as List<i32>), DiagnosticCode::UnexpectedToken);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extra(self.tokens.span_at(self.pos));
            let _sk = self.advance();
            self.tokens.mark_skipped(_sk);
            self.b.skip(_sk);
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.in_set(self.kinds[self.pos], sync) {
            self.report_missing(kind, self.tokens.span_at(self.pos));
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            self.report_unexpected(self.tokens.span_at(self.pos));
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || self.in_set(_k, sync) { break; }
                    let _sk = self.advance();
                    self.tokens.mark_skipped(_sk);
                    self.b.skip(_sk);
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &([kind] as List<i32>),
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `expected any token; got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !self.in_set(k, excluded) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `unexpected token "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            &EMPTY_SYNC,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if self.in_set(k, included) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail(
            `got "${self.tokens.token_text(self.pos)}"`,
            self.tokens.span_at(self.pos),
            included,
            DiagnosticCode::UnexpectedToken,
        );
        return self.pos;
    }
}

fn scan_initializer(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Assign { return -1; }
    pos += 1;
    pos = scan_single_expression(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_binding_pattern(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let scan_start = pos;
    let mut pos = pos;
    let gp_0 = pos;
    let sgk_0 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    let mut sg_0_best = -1;
    if sgk_0 == TK_OpenBracket {
        pos = gp_0;
        sg_0_0: {
            pos = scan_array_literal(tokens, pos, &EMPTY_FOLLOW);
            if pos < 0 { break sg_0_0; }
            if pos > sg_0_best { sg_0_best = pos; }
        }
    } else if sgk_0 == TK_OpenBrace {
        pos = gp_0;
        sg_0_1: {
            pos = scan_object_literal(tokens, pos, &EMPTY_FOLLOW);
            if pos < 0 { break sg_0_1; }
            if pos > sg_0_best { sg_0_best = pos; }
        }
    }
    if sg_0_best >= 0 {
        pos = sg_0_best;
    } else {
        pos = gp_0;
    }
    if pos == scan_start { return -1; }
    return pos;
}

fn scan_type_parameters(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LessThan { return -1; }
    pos += 1;
    if pos < tokens.len() && _kind_set_0(tokens[pos]) {
        let sp = pos;
        pos = scan_type_parameter_list(tokens, pos, &EMPTY_FOLLOW);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_MoreThan { return -1; }
    pos += 1;
    return pos;
}

fn scan_type_parameter_list(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let scan_start = pos;
    let mut pos = pos;
    pos = scan_type_parameter(tokens, pos, &FOLLOW_MASK_0);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_Comma && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_1_done: {
            sg_1: {
                if pos >= tokens.len() || tokens[pos] != TK_Comma { break sg_1; }
                pos += 1;
                pos = scan_type_parameter(tokens, pos, &FOLLOW_MASK_0);
                if pos < 0 { break sg_1; }
                break sg_1_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos == scan_start { return -1; }
    return pos;
}

fn scan_type_parameter(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_19(alt_kind) {
            let mut best: i32 = -1;
            pos = start;
            try_1: {
                pos = scan_identifier(tokens, pos, &FOLLOW_MASK_1);
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos] != TK_Assign { break try_1; }
                pos += 1;
                pos = scan_type_argument(tokens, pos, follow);
                if pos < 0 { break try_1; }
                if pos > best { best = pos; }
            }
            pos = start;
            try_0: {
                pos = scan_identifier(tokens, pos, follow);
                if pos < 0 { break try_0; }
                if pos < tokens.len() && tokens[pos] == TK_Extends && !(follow_yields(tokens, pos, follow, TK_EOF)) {
                    let sp = pos;
                    pos = scan_constraint(tokens, pos, &EMPTY_FOLLOW);
                    if pos < 0 { pos = sp; }
                }
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LessThan {
            pos = start;
            try_2: {
                pos = scan_type_parameters(tokens, pos, follow);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_constraint(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_Extends { return -1; }
    pos += 1;
    pos = scan_type_(tokens, pos, follow);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_type_arguments(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LessThan { return -1; }
    pos += 1;
    if pos < tokens.len() && _kind_set_1(tokens[pos]) {
        let sp = pos;
        pos = scan_type_argument_list(tokens, pos, &EMPTY_FOLLOW);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos] != TK_MoreThan { return -1; }
    pos += 1;
    return pos;
}

fn scan_type_argument_list(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let scan_start = pos;
    let mut pos = pos;
    pos = scan_type_argument(tokens, pos, &FOLLOW_MASK_2);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_Comma && !(follow_yields(tokens, pos, follow, TK_EOF)) {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                if pos >= tokens.len() || tokens[pos] != TK_Comma { break sg_2; }
                pos += 1;
                pos = scan_type_argument(tokens, pos, &FOLLOW_MASK_2);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos == scan_start { return -1; }
    return pos;
}

fn scan_type_argument(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let scan_start = pos;
    let mut pos = pos;
    pos = scan_type_(tokens, pos, follow);
    if pos < 0 { return -1; }
    if pos == scan_start { return -1; }
    return pos;
}

fn scan_type__alt_0(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && _kind_set_2(tokens[pos]) {
        let sp = pos;
        let gp_3 = pos;
        let sgk_3 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
        let mut sg_3_best = -1;
        if sgk_3 == TK_BitOr {
            pos = gp_3;
            sg_3_0: {
                if pos >= tokens.len() || tokens[pos] != TK_BitOr { break sg_3_0; }
                pos += 1;
                if pos > sg_3_best { sg_3_best = pos; }
            }
        } else if sgk_3 == TK_BitAnd {
            pos = gp_3;
            sg_3_1: {
                if pos >= tokens.len() || tokens[pos] != TK_BitAnd { break sg_3_1; }
                pos += 1;
                if pos > sg_3_best { sg_3_best = pos; }
            }
        }
        if sg_3_best >= 0 {
            pos = sg_3_best;
        } else {
            pos = -1;
        }
        if pos < 0 { pos = sp; }
    }
    pos = scan_union_or_intersection_or_primary_type(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_type__alt_1(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_function_type(tokens, pos, follow);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_type_(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if _kind_set_34(alt_kind) {
            pos = scan_type__alt_0(tokens, start, follow);
            if pos >= 0 { break scan_alts; }
            return -1;
        } else if alt_kind == TK_OpenParen {
            let mut best: i32 = -1;
            let try_1_end = scan_type__alt_1(tokens, start, follow);
            if try_1_end > best { best = try_1_end; }
            let try_0_end = scan_type__alt_0(tokens, start, follow);
            if try_0_end > best { best = try_0_end; }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LessThan {
            let mut best: i32 = -1;
            let try_1_end = scan_type__alt_1(tokens, start, follow);
            if try_1_end > best { best = try_1_end; }
            pos = start;
            try_3: {
                pos = scan_type_generic(tokens, pos, follow);
                if pos < 0 { break try_3; }
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_New {
            pos = start;
            try_2: {
                pos = scan_constructor_type(tokens, pos, follow);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_union_or_intersection_or_primary_type_atom(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    pos = scan_primary_type(tokens, pos, follow, 0);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_union_or_intersection_or_primary_type_lr_0(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_BitOr { return -1; }
    pos += 1;
    pos = scan_union_or_intersection_or_primary_type(tokens, pos, follow, 3);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_union_or_intersection_or_primary_type_lr_1(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
