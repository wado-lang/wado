    return TypeScriptParserBase::close_brace(p);
}

fn _run_parse_entry(input: &String, max_errors: i32, entry: fn(&mut Parser) with TypeScriptParserBase) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.output = p.tokens.output;
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(e) = &p.pending {
            let lc = line_col(p.tokens.chars, e.span.start);
            let mut d = Diagnostic::error(p.pending_code, e.full_message(), e.span, lc.0, lc.1);
            d.rule_stack = e.rule_stack;
            p.diagnostics.push(d);
        }
    }
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.output };
}

pub fn parse(input: &String, max_errors: i32 = i32::MAX) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    return parse_initializer(input, max_errors);
}

pub fn parse_initializer(input: &String, max_errors: i32 = i32::MAX) -> ParseResult with (TypeScriptLexerBase, TypeScriptParserBase) {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_initializer(p));
}

