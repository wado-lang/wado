                                            if pos >= chars.len() || chars[pos] != 'u' { break alts_5_0; }
                                            pos += 1;
                                            if pos >= chars.len() { break alts_5_0; }
                                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break alts_5_0; }
                                            pos += 1;
                                            if pos >= chars.len() { break alts_5_0; }
                                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break alts_5_0; }
                                            pos += 1;
                                            if pos >= chars.len() { break alts_5_0; }
                                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break alts_5_0; }
                                            pos += 1;
                                            if pos >= chars.len() { break alts_5_0; }
                                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break alts_5_0; }
                                            pos += 1;
                                            break alts_done_5;
                                        }
                                        alts_5_1: {
                                            pos = alts_saved_5;
                                            if pos >= chars.len() || chars[pos] != 'u' { break alts_5_1; }
                                            pos += 1;
                                            if pos >= chars.len() || chars[pos] != '{' { break alts_5_1; }
                                            pos += 1;
                                            if pos >= chars.len() { break alts_5_1; }
                                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break alts_5_1; }
                                            pos += 1;
                                            if pos >= chars.len() { break alts_5_1; }
                                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break alts_5_1; }
                                            pos += 1;
                                            loop {
                                                let rep_saved_6 = pos;
                                                rep_6: {
                                                    if pos >= chars.len() { break rep_6; }
                                                    if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break rep_6; }
                                                    pos += 1;
                                                    continue;
                                                }
                                                pos = rep_saved_6;
                                                break;
                                            }
                                            if pos >= chars.len() || chars[pos] != '}' { break alts_5_1; }
                                            pos += 1;
                                            break alts_done_5;
                                        }
                                        break alts_3_3;
                                    }
                                    break alts_done_3;
                                }
                                alts_3_4: {
                                    pos = alts_saved_3;
                                    if pos >= chars.len() || chars[pos] != 'u' { break alts_3_4; }
                                    pos += 1;
                                    if pos >= chars.len() || chars[pos] != '{' { break alts_3_4; }
                                    pos += 1;
                                    if pos >= chars.len() { break alts_3_4; }
                                    if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break alts_3_4; }
                                    pos += 1;
                                    loop {
                                        let rep_saved_8 = pos;
                                        rep_8: {
                                            if pos >= chars.len() { break rep_8; }
                                            if !((chars[pos] matches { '0'..='9' | 'A'..='F' | '_' | 'a'..='f' })) { break rep_8; }
                                            pos += 1;
                                            continue;
                                        }
                                        pos = rep_saved_8;
                                        break;
                                    }
                                    if pos >= chars.len() || chars[pos] != '}' { break alts_3_4; }
                                    pos += 1;
                                    break alts_done_3;
                                }
                                break alts_2_1;
                            }
                            break alts_done_2;
                        }
                        alts_2_2: {
                            pos = alts_saved_2;
                            if pos >= chars.len() || chars[pos] != '\\' { break alts_2_2; }
                            pos += 1;
                            if pos >= chars.len() { break alts_2_2; }
                            if !((chars[pos] matches { '\r' | '\n' | '\u{2028}' | '\u{2029}' })) { break alts_2_2; }
                            pos += 1;
                            loop {
                                let rep_saved_10 = pos;
                                rep_10: {
                                    if pos >= chars.len() { break rep_10; }
                                    if !((chars[pos] matches { '\r' | '\n' | '\u{2028}' | '\u{2029}' })) { break rep_10; }
                                    pos += 1;
                                    continue;
                                }
                                pos = rep_saved_10;
                                break;
                            }
                            break alts_done_2;
                        }
                        break rep_1;
                    }
                    continue;
                }
                pos = rep_saved_1;
