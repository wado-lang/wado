}

fn in_char_set_2(c: char) -> bool {
    return c matches { '0'..='9' | '٠'..='٩' | '۰'..='۹' | '߀'..='߉' | '०'..='९' | '০'..='৯' | '੦'..='੯' | '૦'..='૯' | '୦'..='୯' | '௦'..='௯' | '౦'..='౯' | '೦'..='೯' | '൦'..='൯' | '෦'..='෯' | '๐'..='๙' | '໐'..='໙' | '༠'..='༩' | '၀'..='၉' | '႐'..='႙' | '០'..='៩' | '᠐'..='᠙' | '᥆'..='᥏' | '᧐'..='᧙' | '᪀'..='᪉' | '᪐'..='᪙' | '᭐'..='᭙' | '᮰'..='᮹' | '᱀'..='᱉' | '᱐'..='᱙' | '꘠'..='꘩' | '꣐'..='꣙' | '꤀'..='꤉' | '꧐'..='꧙' | '꧰'..='꧹' | '꩐'..='꩙' | '꯰'..='꯹' | '０'..='９' | '𐒠'..='𐒩' | '𐴰'..='𐴹' | '𐵀'..='𐵉' | '𑁦'..='𑁯' | '𑃰'..='𑃹' | '𑄶'..='𑄿' | '𑇐'..='𑇙' | '𑋰'..='𑋹' | '𑑐'..='𑑙' | '𑓐'..='𑓙' | '𑙐'..='𑙙' | '𑛀'..='𑛉' | '𑛐'..='𑛣' | '𑜰'..='𑜹' | '𑣠'..='𑣩' | '𑥐'..='𑥙' | '𑯰'..='𑯹' | '𑱐'..='𑱙' | '𑵐'..='𑵙' | '𑶠'..='𑶩' | '𑷠'..='𑷩' | '𑽐'..='𑽙' | '𖄰'..='𖄹' | '𖩠'..='𖩩' | '𖫀'..='𖫉' | '𖭐'..='𖭙' | '𖵰'..='𖵹' | '𜳰'..='𜳹' | '𝟎'..='𝟿' | '𞅀'..='𞅉' | '𞋰'..='𞋹' | '𞓰'..='𞓹' | '𞗱'..='𞗺' | '𞥐'..='𞥙' | '🯰'..='🯹' };
}

fn classify_keyword(chars: &List<char>, start: i32, end: i32) -> i32 {
    match end - start {
        2 => {
            match chars[start] {
                'a' => { if chars[start + 1] == 's' { return TK_As; } },
                'd' => { if chars[start + 1] == 'o' { return TK_Do; } },
                'i' => {
                    match chars[start + 1] {
                        'f' => { return TK_If; },
                        'n' => { return TK_In; },
                        's' => { return TK_Is; },
                        _ => {},
                    }
                },
                'o' => { if chars[start + 1] == 'f' { return TK_Of; } },
                _ => {},
            }
        },
        3 => {
            match chars[start] {
                'a' => { if chars[start + 1] == 'n' && chars[start + 2] == 'y' { return TK_Any; } },
                'l' => { if chars[start + 1] == 'e' && chars[start + 2] == 't' { return TK_Let; } },
                'n' => { if chars[start + 1] == 'e' && chars[start + 2] == 'w' { return TK_New; } },
                'v' => { if chars[start + 1] == 'a' && chars[start + 2] == 'r' { return TK_Var; } },
                _ => {},
            }
        },
        4 => {
            match chars[start] {
                'c' => { if chars[start + 1] == 'a' && chars[start + 2] == 's' && chars[start + 3] == 'e' { return TK_Case; } },
                'e' => {
                    match chars[start + 1] {
                        'l' => { if chars[start + 2] == 's' && chars[start + 3] == 'e' { return TK_Else; } },
                        'n' => { if chars[start + 2] == 'u' && chars[start + 3] == 'm' { return TK_Enum; } },
                        _ => {},
                    }
                },
                'n' => { if chars[start + 1] == 'u' && chars[start + 2] == 'l' && chars[start + 3] == 'l' { return TK_NullLiteral; } },
                'v' => { if chars[start + 1] == 'o' && chars[start + 2] == 'i' && chars[start + 3] == 'd' { return TK_Void; } },
                'w' => { if chars[start + 1] == 'i' && chars[start + 2] == 't' && chars[start + 3] == 'h' { return TK_With; } },
                _ => {},
            }
        },
        5 => {
            match chars[start] {
                'a' => {
                    match chars[start + 1] {
                        's' => { if chars[start + 2] == 'y' && chars[start + 3] == 'n' && chars[start + 4] == 'c' { return TK_Async; } },
                        'w' => { if chars[start + 2] == 'a' && chars[start + 3] == 'i' && chars[start + 4] == 't' { return TK_Await; } },
                        _ => {},
                    }
                },
                'b' => { if chars[start + 1] == 'r' && chars[start + 2] == 'e' && chars[start + 3] == 'a' && chars[start + 4] == 'k' { return TK_Break; } },
                'c' => {
                    match chars[start + 1] {
                        'a' => { if chars[start + 2] == 't' && chars[start + 3] == 'c' && chars[start + 4] == 'h' { return TK_Catch; } },
                        'l' => { if chars[start + 2] == 'a' && chars[start + 3] == 's' && chars[start + 4] == 's' { return TK_Class; } },
                        'o' => { if chars[start + 2] == 'n' && chars[start + 3] == 's' && chars[start + 4] == 't' { return TK_Const; } },
                        _ => {},
                    }
                },
                'k' => { if chars[start + 1] == 'e' && chars[start + 2] == 'y' && chars[start + 3] == 'o' && chars[start + 4] == 'f' { return TK_KeyOf; } },
                'n' => { if chars[start + 1] == 'e' && chars[start + 2] == 'v' && chars[start + 3] == 'e' && chars[start + 4] == 'r' { return TK_Never; } },
                's' => { if chars[start + 1] == 'u' && chars[start + 2] == 'p' && chars[start + 3] == 'e' && chars[start + 4] == 'r' { return TK_Super; } },
                'w' => { if chars[start + 1] == 'h' && chars[start + 2] == 'i' && chars[start + 3] == 'l' && chars[start + 4] == 'e' { return TK_While; } },
                'y' => { if chars[start + 1] == 'i' && chars[start + 2] == 'e' && chars[start + 3] == 'l' && chars[start + 4] == 'd' { return TK_Yield; } },
                _ => {},
            }
        },
        6 => {
            match chars[start] {
                'd' => { if chars[start + 1] == 'e' && chars[start + 2] == 'l' && chars[start + 3] == 'e' && chars[start + 4] == 't' && chars[start + 5] == 'e' { return TK_Delete; } },
                'e' => { if chars[start + 1] == 'x' && chars[start + 2] == 'p' && chars[start + 3] == 'o' && chars[start + 4] == 'r' && chars[start + 5] == 't' { return TK_Export; } },
                'i' => { if chars[start + 1] == 'm' && chars[start + 2] == 'p' && chars[start + 3] == 'o' && chars[start + 4] == 'r' && chars[start + 5] == 't' { return TK_Import; } },
                'm' => { if chars[start + 1] == 'o' && chars[start + 2] == 'd' && chars[start + 3] == 'u' && chars[start + 4] == 'l' && chars[start + 5] == 'e' { return TK_Module; } },
                'n' => { if chars[start + 1] == 'u' && chars[start + 2] == 'm' && chars[start + 3] == 'b' && chars[start + 4] == 'e' && chars[start + 5] == 'r' { return TK_Number; } },
                'o' => { if chars[start + 1] == 'b' && chars[start + 2] == 'j' && chars[start + 3] == 'e' && chars[start + 4] == 'c' && chars[start + 5] == 't' { return TK_Object; } },
                'p' => { if chars[start + 1] == 'u' && chars[start + 2] == 'b' && chars[start + 3] == 'l' && chars[start + 4] == 'i' && chars[start + 5] == 'c' { return TK_Public; } },
                'r' => { if chars[start + 1] == 'e' && chars[start + 2] == 't' && chars[start + 3] == 'u' && chars[start + 4] == 'r' && chars[start + 5] == 'n' { return TK_Return; } },
                's' => {
                    match chars[start + 1] {
                        't' => {
                            match chars[start + 2] {
                                'a' => { if chars[start + 3] == 't' && chars[start + 4] == 'i' && chars[start + 5] == 'c' { return TK_Static; } },
                                'r' => { if chars[start + 3] == 'i' && chars[start + 4] == 'n' && chars[start + 5] == 'g' { return TK_String; } },
                                _ => {},
                            }
                        },
                        'w' => { if chars[start + 2] == 'i' && chars[start + 3] == 't' && chars[start + 4] == 'c' && chars[start + 5] == 'h' { return TK_Switch; } },
                        'y' => { if chars[start + 2] == 'm' && chars[start + 3] == 'b' && chars[start + 4] == 'o' && chars[start + 5] == 'l' { return TK_Symbol; } },
                        _ => {},
                    }
                },
                'u' => { if chars[start + 1] == 'n' && chars[start + 2] == 'i' && chars[start + 3] == 'q' && chars[start + 4] == 'u' && chars[start + 5] == 'e' { return TK_Unique; } },
                _ => {},
            }
        },
        7 => {
            match chars[start] {
                'b' => { if chars[start + 1] == 'o' && chars[start + 2] == 'o' && chars[start + 3] == 'l' && chars[start + 4] == 'e' && chars[start + 5] == 'a' && chars[start + 6] == 'n' { return TK_Boolean; } },
                'd' => {
                    if chars[start + 1] == 'e' {
                        match chars[start + 2] {
                            'c' => { if chars[start + 3] == 'l' && chars[start + 4] == 'a' && chars[start + 5] == 'r' && chars[start + 6] == 'e' { return TK_Declare; } },
                            'f' => { if chars[start + 3] == 'a' && chars[start + 4] == 'u' && chars[start + 5] == 'l' && chars[start + 6] == 't' { return TK_Default; } },
                            _ => {},
                        }
                    }
                },
                'e' => { if chars[start + 1] == 'x' && chars[start + 2] == 't' && chars[start + 3] == 'e' && chars[start + 4] == 'n' && chars[start + 5] == 'd' && chars[start + 6] == 's' { return TK_Extends; } },
                'p' => {
                    match chars[start + 1] {
                        'a' => { if chars[start + 2] == 'c' && chars[start + 3] == 'k' && chars[start + 4] == 'a' && chars[start + 5] == 'g' && chars[start + 6] == 'e' { return TK_Package; } },
                        'r' => { if chars[start + 2] == 'i' && chars[start + 3] == 'v' && chars[start + 4] == 'a' && chars[start + 5] == 't' && chars[start + 6] == 'e' { return TK_Private; } },
                        _ => {},
                    }
                },
                'r' => { if chars[start + 1] == 'e' && chars[start + 2] == 'q' && chars[start + 3] == 'u' && chars[start + 4] == 'i' && chars[start + 5] == 'r' && chars[start + 6] == 'e' { return TK_Require; } },
                _ => {},
            }
        },
        8 => {
            match chars[start] {
                'a' => { if chars[start + 1] == 'b' && chars[start + 2] == 's' && chars[start + 3] == 't' && chars[start + 4] == 'r' && chars[start + 5] == 'a' && chars[start + 6] == 'c' && chars[start + 7] == 't' { return TK_Abstract; } },
                'c' => { if chars[start + 1] == 'o' && chars[start + 2] == 'n' && chars[start + 3] == 't' && chars[start + 4] == 'i' && chars[start + 5] == 'n' && chars[start + 6] == 'u' && chars[start + 7] == 'e' { return TK_Continue; } },
                'd' => { if chars[start + 1] == 'e' && chars[start + 2] == 'b' && chars[start + 3] == 'u' && chars[start + 4] == 'g' && chars[start + 5] == 'g' && chars[start + 6] == 'e' && chars[start + 7] == 'r' { return TK_Debugger; } },
                'r' => { if chars[start + 1] == 'e' && chars[start + 2] == 'a' && chars[start + 3] == 'd' && chars[start + 4] == 'o' && chars[start + 5] == 'n' && chars[start + 6] == 'l' && chars[start + 7] == 'y' { return TK_ReadOnly; } },
                _ => {},
            }
        },
        9 => {
            match chars[start] {
                'i' => { if chars[start + 1] == 'n' && chars[start + 2] == 't' && chars[start + 3] == 'e' && chars[start + 4] == 'r' && chars[start + 5] == 'f' && chars[start + 6] == 'a' && chars[start + 7] == 'c' && chars[start + 8] == 'e' { return TK_Interface; } },
                'n' => { if chars[start + 1] == 'a' && chars[start + 2] == 'm' && chars[start + 3] == 'e' && chars[start + 4] == 's' && chars[start + 5] == 'p' && chars[start + 6] == 'a' && chars[start + 7] == 'c' && chars[start + 8] == 'e' { return TK_Namespace; } },
                'p' => { if chars[start + 1] == 'r' && chars[start + 2] == 'o' && chars[start + 3] == 't' && chars[start + 4] == 'e' && chars[start + 5] == 'c' && chars[start + 6] == 't' && chars[start + 7] == 'e' && chars[start + 8] == 'd' { return TK_Protected; } },
                'u' => { if chars[start + 1] == 'n' && chars[start + 2] == 'd' && chars[start + 3] == 'e' && chars[start + 4] == 'f' && chars[start + 5] == 'i' && chars[start + 6] == 'n' && chars[start + 7] == 'e' && chars[start + 8] == 'd' { return TK_Undefined; } },
                _ => {},
            }
        },
        10 => {
            if chars[start] == 'i' {
                match chars[start + 1] {
                    'm' => { if chars[start + 2] == 'p' && chars[start + 3] == 'l' && chars[start + 4] == 'e' && chars[start + 5] == 'm' && chars[start + 6] == 'e' && chars[start + 7] == 'n' && chars[start + 8] == 't' && chars[start + 9] == 's' { return TK_Implements; } },
                    'n' => { if chars[start + 2] == 's' && chars[start + 3] == 't' && chars[start + 4] == 'a' && chars[start + 5] == 'n' && chars[start + 6] == 'c' && chars[start + 7] == 'e' && chars[start + 8] == 'o' && chars[start + 9] == 'f' { return TK_Instanceof; } },
                    _ => {},
                }
            }
        },
        11 => { if chars[start] == 'c' && chars[start + 1] == 'o' && chars[start + 2] == 'n' && chars[start + 3] == 's' && chars[start + 4] == 't' && chars[start + 5] == 'r' && chars[start + 6] == 'u' && chars[start + 7] == 'c' && chars[start + 8] == 't' && chars[start + 9] == 'o' && chars[start + 10] == 'r' { return TK_Constructor; } },
        _ => {},
    }
    return -1;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream with TypeScriptLexerBase {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    let mut more_start: i32 = -1;
    let mut mode_stack: List<i32> = [];
    let mut current_mode: i32 = 0;
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let mut best_act: i32 = -1;
        let mut best_act_skip = false;
        let first_char = lexer.chars[start];
        let mut best_push_mode: i32 = -1;
        let mut best_pop_mode = false;
        let mut best_set_mode: i32 = -1;
        let mut best_more = false;
        let mut best_channel: i32 = 0;
        if current_mode == 0 {
            match first_char {
                '\t' | '\u{b}' | '\u{c}' | ' ' | '\u{a0}' => {
                    end = try_WhiteSpaces(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_WhiteSpaces; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 1; best_act = -1; }
                },
                '\n' | '\r' | '\u{2028}' | '\u{2029}' => {
                    end = try_LineTerminator(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_LineTerminator; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 1; best_act = -1; }
                },
                '!' => {
                    end = try_Not(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_Not; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    end = try_NotEquals(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_NotEquals; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                    end = try_IdentityNotEquals(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_IdentityNotEquals; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                '"' | '\'' => {
                    end = try_StringLiteral(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_StringLiteral; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 2; }
                },
                '#' => {
                    end = try_Hashtag(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_Hashtag; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
