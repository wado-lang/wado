    p.no_viable(
        "expected identifierOrKeyWord",
        p.peek_span(),
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Require"],
