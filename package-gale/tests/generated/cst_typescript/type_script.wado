                    if end > best_end { best_end = end; best_kind = TK_BackTick; best_push_mode = -1; best_pop_mode = true; best_set_mode = -1; best_more = false; best_channel = 0; best_act = 4; }
                    end = try_TemplateStringAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
                _ => {
                    end = try_TemplateStringAtom(&lexer.chars, start);
                    if end > best_end { best_end = end; best_kind = TK_TemplateStringAtom; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
                },
            }
        }
        if best_end < start || (best_end == start && best_push_mode < 0 && !best_pop_mode && best_set_mode < 0) {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            if current_mode == 0 && best_kind == TK_Identifier {
                let kw_kind = classify_keyword(&lexer.chars, start, best_end);
                if kw_kind >= 0 { best_kind = kw_kind; best_push_mode = -1; best_pop_mode = false; best_set_mode = -1; best_more = false; best_channel = 0; best_act = -1; }
            }
            if best_act >= 0 {
                lexer.reset_actions(best_kind, best_channel, mode_stack.len());
                if best_act == 0 {
                    apply_OpenBrace_actions(&mut lexer, start, best_end);
                } else if best_act == 1 {
                    apply_CloseBrace_actions(&mut lexer, start, best_end);
                } else if best_act == 2 {
                    apply_StringLiteral_actions(&mut lexer, start, best_end);
                } else if best_act == 3 {
                    apply_BackTick_actions(&mut lexer, start, best_end);
                } else if best_act == 4 {
                    apply_BackTickInside_actions(&mut lexer, start, best_end);
                } else if best_act == 5 {
                    apply_TemplateStringStartExpression_actions(&mut lexer, start, best_end);
                }
                best_kind = lexer.act_type;
                best_channel = lexer.act_channel;
                if lexer.act_more { best_more = true; }
                if lexer.act_skip { best_act_skip = true; }
                if lexer.act_push_mode >= 0 { best_push_mode = lexer.act_push_mode; }
                if lexer.act_pop_mode { best_pop_mode = true; }
                if lexer.act_set_mode >= 0 { best_set_mode = lexer.act_set_mode; }
            }
            let tok_start = if more_start >= 0 { more_start } else { start };
            let is_skip = false || best_act_skip;
            if !is_skip && !best_more {
                best_kind = TypeScriptLexerBase::emit(LexerView { chars: &lexer.chars, start: tok_start, pos: best_end }, best_kind, best_channel);
            }
            if best_more {
                if more_start < 0 { more_start = start; }
            } else if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
                more_start = -1;
            } else if best_channel != 0 {
                ts.push_trivia(best_kind, tok_start, best_end, best_channel);
                more_start = -1;
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
                more_start = -1;
            }
            if best_push_mode >= 0 {
                mode_stack.push(current_mode);
                current_mode = best_push_mode;
                best_push_mode = -1;
            }
            if best_pop_mode {
                if mode_stack.is_empty() {
                    current_mode = 0;
                } else {
                    current_mode = mode_stack[mode_stack.len() - 1];
                    mode_stack.pop();
                }
                best_pop_mode = false;
            }
            if best_set_mode >= 0 {
                current_mode = best_set_mode;
                best_set_mode = -1;
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    ts.output = lexer.act_output;
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_MultiLineComment => "MultiLineComment",
        TK_SingleLineComment => "SingleLineComment",
        TK_RegularExpressionLiteral => "RegularExpressionLiteral",
        TK_OpenBracket => "OpenBracket",
        TK_CloseBracket => "CloseBracket",
        TK_OpenParen => "OpenParen",
        TK_CloseParen => "CloseParen",
        TK_OpenBrace => "OpenBrace",
        TK_TemplateCloseBrace => "TemplateCloseBrace",
        TK_CloseBrace => "CloseBrace",
        TK_SemiColon => "SemiColon",
        TK_Comma => "Comma",
        TK_Assign => "Assign",
        TK_QuestionMark => "QuestionMark",
        TK_QuestionMarkDot => "QuestionMarkDot",
        TK_Colon => "Colon",
        TK_Ellipsis => "Ellipsis",
        TK_Dot => "Dot",
        TK_PlusPlus => "PlusPlus",
        TK_MinusMinus => "MinusMinus",
        TK_Plus => "Plus",
        TK_Minus => "Minus",
        TK_BitNot => "BitNot",
        TK_Not => "Not",
        TK_Multiply => "Multiply",
        TK_Divide => "Divide",
        TK_Modulus => "Modulus",
        TK_Power => "Power",
        TK_NullCoalesce => "NullCoalesce",
        TK_Hashtag => "Hashtag",
        TK_LeftShiftArithmetic => "LeftShiftArithmetic",
        TK_LessThan => "LessThan",
        TK_MoreThan => "MoreThan",
        TK_LessThanEquals => "LessThanEquals",
        TK_GreaterThanEquals => "GreaterThanEquals",
        TK_Equals_ => "Equals_",
        TK_NotEquals => "NotEquals",
        TK_IdentityEquals => "IdentityEquals",
        TK_IdentityNotEquals => "IdentityNotEquals",
        TK_BitAnd => "BitAnd",
        TK_BitXOr => "BitXOr",
        TK_BitOr => "BitOr",
        TK_And => "And",
        TK_Or => "Or",
        TK_MultiplyAssign => "MultiplyAssign",
        TK_DivideAssign => "DivideAssign",
        TK_ModulusAssign => "ModulusAssign",
        TK_PlusAssign => "PlusAssign",
        TK_MinusAssign => "MinusAssign",
        TK_LeftShiftArithmeticAssign => "LeftShiftArithmeticAssign",
        TK_RightShiftArithmeticAssign => "RightShiftArithmeticAssign",
        TK_RightShiftLogicalAssign => "RightShiftLogicalAssign",
        TK_BitAndAssign => "BitAndAssign",
        TK_BitXorAssign => "BitXorAssign",
