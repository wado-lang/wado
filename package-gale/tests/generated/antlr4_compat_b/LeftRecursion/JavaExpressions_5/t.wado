    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 't' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'h' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 'i' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 's' { return -1; }
    return pos + 4;
}

