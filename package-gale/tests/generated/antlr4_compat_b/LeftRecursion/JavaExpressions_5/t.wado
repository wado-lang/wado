fn try_lit_BANGEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '!' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_AMP(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '&' { return -1; }
    return pos + 1;
}

fn try_lit_CARET(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '^' { return -1; }
    return pos + 1;
}

fn try_lit_PIPE(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '|' { return -1; }
    return pos + 1;
}

fn try_lit_AMPAMP(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '&' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '&' { return -1; }
    return pos + 2;
}

fn try_lit_PIPEPIPE(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '|' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '|' { return -1; }
    return pos + 2;
}

fn try_lit_QUESTION(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '?' { return -1; }
    return pos + 1;
}

fn try_lit_COLON(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ':' { return -1; }
    return pos + 1;
}

fn try_lit_EQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '=' { return -1; }
    return pos + 1;
}

fn try_lit_PLUSEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '+' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_MINUSEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '-' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_STAREQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '*' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_SLASHEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '/' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_AMPEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '&' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_PIPEEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '|' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_CARETEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '^' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_GTGTEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '>' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '>' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != '=' { return -1; }
    return pos + 3;
}

fn try_lit_GTGTGTEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '>' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '>' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != '>' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != '=' { return -1; }
    return pos + 4;
}

fn try_lit_LTLTEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '<' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '<' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != '=' { return -1; }
    return pos + 3;
}

fn try_lit_PERCENTEQ(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '%' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != '=' { return -1; }
    return pos + 2;
}

fn try_lit_int(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != 'i' { return -1; }
    if pos + 1 >= chars.len() || chars[pos + 1] != 'n' { return -1; }
    if pos + 2 >= chars.len() || chars[pos + 2] != 't' { return -1; }
    return pos + 3;
}

pub fn tokenize<S: AsStrSlice>(input: S) -> TokenStream {
    let mut lexer = Lexer::new(input);
    let mut ts = TokenStream::new(&lexer.chars);
    let mut triv_lo = ts.trivia_mark();
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let first_char = lexer.chars[start];
        match first_char {
            '\n' | ' ' => {
                end = try_WS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_WS; }
            },
            '!' => {
                end = try_lit_BANG(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_BANG; }
                end = try_lit_BANGEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_BANGEQ; }
            },
            '$' | 'A'..='Z' | '_' | 'a'..='b' | 'd'..='h' | 'j'..='m' | 'o'..='r' | 'u'..='z' => {
                end = try_ID(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_ID; }
            },
            '%' => {
                end = try_lit_PERCENT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PERCENT; }
                end = try_lit_PERCENTEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PERCENTEQ; }
            },
            '&' => {
                end = try_lit_AMP(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_AMP; }
                end = try_lit_AMPAMP(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_AMPAMP; }
                end = try_lit_AMPEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_AMPEQ; }
            },
            '(' => {
                end = try_lit_LPAREN(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_LPAREN; }
            },
            ')' => {
                end = try_lit_RPAREN(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_RPAREN; }
            },
            '*' => {
                end = try_lit_STAR(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_STAR; }
                end = try_lit_STAREQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_STAREQ; }
            },
            '+' => {
                end = try_lit_PLUSPLUS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PLUSPLUS; }
                end = try_lit_PLUS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PLUS; }
                end = try_lit_PLUSEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PLUSEQ; }
            },
            ',' => {
                end = try_lit_COMMA(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_COMMA; }
            },
            '-' => {
                end = try_lit_MINUSMINUS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_MINUSMINUS; }
                end = try_lit_MINUS(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_MINUS; }
                end = try_lit_MINUSEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_MINUSEQ; }
            },
            '.' => {
                end = try_lit_DOT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_DOT; }
            },
            '/' => {
                end = try_lit_SLASH(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_SLASH; }
                end = try_lit_SLASHEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_SLASHEQ; }
            },
            '0'..='9' => {
                end = try_INT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_INT; }
            },
            ':' => {
                end = try_lit_COLON(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_COLON; }
            },
            '<' => {
                end = try_lit_LTLT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_LTLT; }
                end = try_lit_LTEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_LTEQ; }
                end = try_lit_LT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_LT; }
                end = try_lit_LTLTEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_LTLTEQ; }
            },
            '=' => {
                end = try_lit_EQEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_EQEQ; }
                end = try_lit_EQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_EQ; }
            },
            '>' => {
                end = try_lit_GTGTGT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_GTGTGT; }
                end = try_lit_GTGT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_GTGT; }
                end = try_lit_GTEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_GTEQ; }
                end = try_lit_GT(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_GT; }
                end = try_lit_GTGTEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_GTGTEQ; }
                end = try_lit_GTGTGTEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_GTGTGTEQ; }
            },
            '?' => {
                end = try_lit_QUESTION(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_QUESTION; }
            },
            '[' => {
                end = try_lit_LBRACKET(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_LBRACKET; }
            },
            ']' => {
                end = try_lit_RBRACKET(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_RBRACKET; }
            },
            '^' => {
                end = try_lit_CARET(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_CARET; }
                end = try_lit_CARETEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_CARETEQ; }
            },
            'c' => {
                end = try_lit_class(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_class; }
                end = try_ID(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_ID; }
            },
            'i' => {
                end = try_lit_instanceof(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_instanceof; }
                end = try_lit_int(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_int; }
                end = try_ID(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_ID; }
            },
            'n' => {
                end = try_lit_new(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_new; }
                end = try_ID(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_ID; }
            },
            's' => {
                end = try_lit_super(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_super; }
                end = try_ID(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_ID; }
            },
            't' => {
                end = try_lit_this(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_this; }
                end = try_ID(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_ID; }
            },
            '|' => {
                end = try_lit_PIPE(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PIPE; }
                end = try_lit_PIPEPIPE(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PIPEPIPE; }
                end = try_lit_PIPEEQ(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_PIPEEQ; }
            },
            '~' => {
                end = try_lit_TILDE(&lexer.chars, start);
                if end > best_end { best_end = end; best_kind = TK_LIT_TILDE; }
            },
            _ => {},
        }
        if best_end <= start {
            let _ = ts.push_token_flagged(TK_ERROR, start, start + 1, triv_lo, ts.trivia_mark(), TokenFlags::LexError);
            triv_lo = ts.trivia_mark();
            lexer.pos = start + 1;
        } else {
            let tok_start = start;
            let is_skip = best_kind matches { TK_WS };
            if is_skip {
                ts.push_trivia(best_kind, tok_start, best_end, 0);
            } else {
                ts.push_token(best_kind, tok_start, best_end, triv_lo, ts.trivia_mark());
                triv_lo = ts.trivia_mark();
            }
            lexer.pos = best_end;
        }
    }
    ts.push_token(TK_EOF, lexer.pos, lexer.pos, triv_lo, ts.trivia_mark());
    return ts;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_ID => "ID",
        TK_INT => "INT",
        TK_WS => "WS",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        TK_LIT_COMMA => "','",
        TK_LIT_LPAREN => "'('",
        TK_LIT_RPAREN => "')'",
        TK_LIT_this => "'this'",
        TK_LIT_super => "'super'",
        TK_LIT_DOT => "'.'",
        TK_LIT_class => "'class'",
        TK_LIT_new => "'new'",
        TK_LIT_LBRACKET => "'['",
        TK_LIT_RBRACKET => "']'",
        TK_LIT_PLUSPLUS => "'++'",
        TK_LIT_MINUSMINUS => "'--'",
        TK_LIT_PLUS => "'+'",
        TK_LIT_MINUS => "'-'",
        TK_LIT_TILDE => "'~'",
        TK_LIT_BANG => "'!'",
        TK_LIT_STAR => "'*'",
        TK_LIT_SLASH => "'/'",
        TK_LIT_PERCENT => "'%'",
        TK_LIT_LTLT => "'<<'",
        TK_LIT_GTGTGT => "'>>>'",
        TK_LIT_GTGT => "'>>'",
        TK_LIT_LTEQ => "'<='",
        TK_LIT_GTEQ => "'>='",
        TK_LIT_GT => "'>'",
        TK_LIT_LT => "'<'",
        TK_LIT_instanceof => "'instanceof'",
        TK_LIT_EQEQ => "'=='",
        TK_LIT_BANGEQ => "'!='",
        TK_LIT_AMP => "'&'",
        TK_LIT_CARET => "'^'",
        TK_LIT_PIPE => "'|'",
        TK_LIT_AMPAMP => "'&&'",
        TK_LIT_PIPEPIPE => "'||'",
        TK_LIT_QUESTION => "'?'",
        TK_LIT_COLON => "':'",
        TK_LIT_EQ => "'='",
        TK_LIT_PLUSEQ => "'+='",
        TK_LIT_MINUSEQ => "'-='",
        TK_LIT_STAREQ => "'*='",
        TK_LIT_SLASHEQ => "'/='",
        TK_LIT_AMPEQ => "'&='",
        TK_LIT_PIPEEQ => "'|='",
        TK_LIT_CARETEQ => "'^='",
        TK_LIT_GTGTEQ => "'>>='",
        TK_LIT_GTGTGTEQ => "'>>>='",
        TK_LIT_LTLTEQ => "'<<='",
        TK_LIT_PERCENTEQ => "'%='",
        TK_LIT_int => "'int'",
        _ => "Unknown",
    };
}

pub global RK_S: NodeKind = 0;
pub global RK_EXPRESSION_LIST: NodeKind = 1;
pub global RK_E: NodeKind = 2;
pub global RK_TYPESPEC: NodeKind = 3;

global RULE_NAMES: List<String> = ["s", "expressionList", "e", "typespec"];

impl Display for NodeKind {
    fn fmt(&self, f: &mut Formatter) {
        if *self == K_ERROR {
            f.write_str(&"<error>");
        } else {
            f.write_str(&RULE_NAMES[*self as i32]);
        }
    }
}

impl Inspect for NodeKind {
    fn inspect(&self, f: &mut Formatter) {
        self.fmt(f);
        f.write_str(&`(${*self as i32})`);
    }
}

struct Parser {
    tokens: TokenStream,
    kinds: Array<i32>,
    pos: i32,
    pending: Option<Diagnostic>,
    recovering: bool,
    speculating: bool,
    max_errors: i32,
    site: i32,
    sites: List<i32>,
    err_row: i32,
    atn_ret_pending: i32,
    b: TreeBuilder,
    diagnostics: List<Diagnostic>,
    line_starts: List<i32>,
}

fn kind_names(kinds: &List<i32>) -> List<String> {
    let mut out: List<String> = List::with_capacity(kinds.len());
    for let k of kinds {
        out.push(token_kind_name(*k));
    }
    return out;
}

impl Parser {
    fn new(tokens: TokenStream) -> Parser {
        let kinds = tokens.kinds.to_array();
        return Parser { tokens, kinds, pos: 0, pending: null, recovering: false, speculating: false, max_errors: i32::MAX, site: -1, sites: [], err_row: -1, atn_ret_pending: -1, b: TreeBuilder::with_capacity(tokens.len() * 4), diagnostics: [], line_starts: line_starts(tokens.chars) };
    }

    fn emit(&mut self, s: String) {
        self.tokens.output.push_str(&s);
    }

    fn token_text(&self, i: i32) -> String {
        return self.tokens.token_text(i);
    }

    fn token_kind(&self, i: i32) -> i32 {
        return self.tokens.kind_at(i);
    }

    fn token_int(&self, i: i32) -> i32 {
        let sp = self.tokens.span_at(i);
        let mut acc: i32 = 0;
        let mut neg = false;
        let mut j = sp.start;
        if j < sp.end && self.tokens.chars[j] == '-' {
            neg = true;
            j += 1;
        }
        while j < sp.end {
            let c = self.tokens.chars[j];
            if c.is_ascii_digit() {
                acc = acc * 10 + (c as i32 - '0' as i32);
            }
            j += 1;
        }
        return if neg { -acc } else { acc };
    }

    fn token_line(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).0;
    }

    fn token_col(&self, i: i32) -> i32 {
        return line_col_at(&self.line_starts, self.tokens.starts[i]).1;
    }

    fn token_start(&self, i: i32) -> i32 {
        return self.tokens.starts[i];
    }

    fn la(&self, k: i32) -> i32 {
        return self.peek_at(k - 1);
    }

    fn lt(&self, k: i32) -> i32 {
        let idx = self.pos + k - 1;
        if idx >= self.kinds.len() { return self.kinds.len() - 1; }
        if idx < 0 { return 0; }
        return idx;
    }

    fn text_span(&self, start: i32, end: i32) -> String {
        let hi = if end < self.tokens.chars.len() { end } else { self.tokens.chars.len() };
        return chars_text(self.tokens.chars, start, hi);
    }

    fn text_between(&self, lo: i32, hi: i32) -> String {
        return self.tokens.rule_text(lo, hi);
    }

    fn rule_text(&self, start_tok: i32) -> String {
        return self.tokens.rule_text(start_tok, self.pos - 1);
    }

    fn input_text(&self) -> String {
        return self.text_span(0, self.tokens.chars.len());
    }

    fn rule_string_tree(&self) -> String {
        return self.b.render_open(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn rule_tree_at(&self, row: i32) -> String {
        return self.b.render_at(row, &self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn rule_stack(&self) -> String {
        return self.b.open_rule_names(&RULE_NAMES);
    }

    fn rule_string_tree_final(&self) -> String {
        return self.b.render_last_finished(&self.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }

    fn supersedes_pending(&self, start: i32) -> bool {
        if let Some(cur) = &self.pending { return start > cur.span.start; }
        return true;
    }

    fn fail(&mut self, message: String, span: Span, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(span.start) {
            self.pending = Option::Some(Diagnostic::error(code, with_expected(message, &kind_names(expected)), span, *expected, self.kinds[self.pos], RecoveryAction::None));
        }
        self.recovering = true;
    }

    fn fail_on_token(&mut self, what: String, expected: &List<i32>, code: DiagnosticCode) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail(`${what} "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), expected, code);
        }
        self.recovering = true;
    }

    fn fail_on_kind(&mut self, kind: i32) {
        if self.supersedes_pending(self.tokens.starts[self.pos]) {
            self.fail_expecting(&([kind] as List<i32>));
        }
        self.recovering = true;
    }

    fn no_viable(&mut self, message: String, span: Span, expected: &List<i32>) {
        self.fail(message, span, expected, DiagnosticCode::NoViableAlternative);
    }

    fn push_rule_stack(&mut self, name: String) {
        if let Some(e) = &mut self.pending {
            e.rule_stack.push(name);
        }
    }

    fn recover_rule(&mut self, rule: NodeKind, name: String, row: i32) -> bool {
        if self.speculating || self.diagnostics.len() >= self.max_errors {
            self.push_rule_stack(name);
            return false;
        }
        let node = if row < 0 { self.b.innermost_open() } else { row };
        self.b.resume_node(node, self.last_end());
        assert self.b.node_kind(node) == rule, "recover_rule: the resumed node is the failed rule's";
        self.commit_pending();
        self.recovering = false;
        self.skip_until(&self.resync_set(&[]));
        return true;
    }

    fn commit_pending(&mut self) {
        let Some(d) = self.pending else { return; };
        self.pending = null;
        if self.in_error_mode() { return; }
        let mut diag = d;
        self.b.push_open_rule_names(&RULE_NAMES, &mut diag.rule_stack);
        self.diagnostics.push(diag);
        self.note_error();
    }

    fn in_error_mode(&self) -> bool {
        return self.err_row >= 0 && !self.b.has_token_since(self.err_row);
    }

    fn note_error(&mut self) {
        self.err_row = self.b.checkpoint();
    }

    fn resync_set(&self, base: &List<i32>) -> List<i32> {
        let mut set = *base;
        for let s of &self.sites {
            if *s < 0 { continue; }
            let f = &CALL_FOLLOW_SETS[CALL_FOLLOW[*s]];
            while set.len() < f.len() { set.push(0); }
            for let mut i = 0; i < f.len(); i += 1 { set[i] = set[i] | f[i]; }
        }
        return set;
    }

    fn follows_rules_under_way(&self, k: i32) -> bool {
        for let mut i = self.sites.len() - 1; i >= 0; i -= 1 {
            let s = self.sites[i];
            if s < 0 { return i == 0 && k == TK_EOF; }
            if kind_set_has(&CALL_FOLLOW_SETS[CALL_FOLLOW[s]], k) { return true; }
            if !CALL_FOLLOW_ENDS[s] { return false; }
        }
        return k == TK_EOF;
    }

    fn skip_until(&mut self, set: &List<i32>) {
        loop {
            let k = self.kinds[self.pos];
            if k == TK_EOF || kind_set_has(set, k) { break; }
            self.skip_one();
        }
    }

    fn skip_one(&mut self) {
        let _sk = self.advance();
        self.tokens.mark_skipped(_sk);
        self.b.skip(_sk);
    }

    fn sync_delete(&mut self, expected: &List<i32>, names: &List<i32>) -> bool {
        if self.speculating || self.kinds[self.pos] == TK_EOF || !kind_set_has(expected, self.peek_at(1)) {
            return false;
        }
        self.report_extraneous(names, RecoveryAction::Deleted);
        self.skip_one();
        return true;
    }

    fn sync_enter(&mut self, expected: &List<i32>, names: &List<i32>) {
        if !self.recovering && !self.sync_delete(expected, names) {
            self.fail_expecting(names);
        }
    }

    fn sync_alts(&mut self, expected: &List<i32>, names: &List<i32>) {
        if !self.recovering && !self.sync_delete(expected, names) {
            self.no_viable("no viable alternative", self.peek_span(), names);
        }
    }

    fn sync_back(&mut self, expected: &List<i32>, names: &List<i32>) {
        if self.recovering || self.kinds[self.pos] == TK_EOF { return; }
        if self.speculating {
            self.fail_expecting(names);
            return;
        }
        self.report_extraneous(names, RecoveryAction::SkippedTo);
        self.skip_until(&self.resync_set(expected));
    }

    fn fail_expecting(&mut self, names: &List<i32>) {
        let code = if self.kinds[self.pos] == TK_EOF { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::UnexpectedToken };
        self.fail_on_token("got", names, code);
    }

    fn report_extraneous(&mut self, names: &List<i32>, recovery: RecoveryAction) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        if self.in_error_mode() { return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::ExtraToken, `extraneous input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), *names, self.kinds[self.pos], recovery));
        self.note_error();
    }

    fn report_missing(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        let found = self.kinds[self.pos];
        let at_eof = found == TK_EOF;
        let code = if at_eof { DiagnosticCode::UnterminatedConstruct } else { DiagnosticCode::MissingToken };
        let recovery = if at_eof { RecoveryAction::FilledMissing } else { RecoveryAction::Inserted };
        self.diagnostics.push(Diagnostic::error(code, `missing ${token_display_name(kind)}`, self.tokens.span_at(self.pos), [kind], found, recovery));
        self.note_error();
    }

    fn report_unexpected(&mut self, kind: i32) {
        if self.diagnostics.len() >= self.max_errors { self.recovering = true; return; }
        self.diagnostics.push(Diagnostic::error(DiagnosticCode::UnexpectedToken, `unexpected input "${self.tokens.token_text(self.pos)}"`, self.tokens.span_at(self.pos), [kind], self.kinds[self.pos], RecoveryAction::SkippedTo));
        self.note_error();
    }

    fn peek_start(&self) -> i32 {
        return self.tokens.starts[self.pos];
    }

    fn peek_span(&self) -> Span {
        return self.tokens.span_at(self.pos);
    }

    fn peek_kind(&self) -> i32 {
        return self.kinds[self.pos];
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.kinds.len() { return TK_EOF; }
        return self.kinds[idx];
    }

    fn advance(&mut self) -> i32 {
        let i = self.pos;
        self.pos += 1;
        return i;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens.ends[self.pos - 1];
    }

    fn expect(&mut self, kind: i32, sync: &List<i32>, rest_nullable: bool = true, may_end_rule: bool = false) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] == kind {
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if self.speculating {
            self.fail_on_kind(kind);
            return self.pos;
        }
        if self.peek_at(1) == kind {
            self.report_extraneous(&[kind], RecoveryAction::Deleted);
            self.skip_one();
            if kind == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        if kind_set_has(sync, self.kinds[self.pos]) || may_end_rule && self.follows_rules_under_way(self.kinds[self.pos]) {
            self.report_missing(kind);
            let _syn = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn);
            return _syn;
        }
        if !sync.is_empty() {
            if !rest_nullable && self.kinds[self.pos] == TK_EOF {
                self.fail_on_kind(kind);
                return self.pos;
            }
            self.report_unexpected(kind);
            if self.kinds[self.pos] != TK_EOF {
                self.b.start_error(self.tokens.span_at(self.pos).start);
                loop {
                    let _k = self.kinds[self.pos];
                    if _k == TK_EOF || _k == kind || kind_set_has(sync, _k) { break; }
                    self.skip_one();
                }
                self.b.finish_node(self.last_end());
            }
            if self.kinds[self.pos] == kind {
                if kind == TK_EOF {
                    self.b.token(self.pos);
                    return self.pos;
                }
                let _i = self.advance();
                self.b.token(_i);
                return _i;
            }
            let _syn2 = self.tokens.push_synthetic(kind, self.tokens.span_at(self.pos).start);
            self.b.missing(_syn2);
            return _syn2;
        }
        self.fail_on_kind(kind);
        return self.pos;
    }

    fn take(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        let kind = self.kinds[self.pos];
        if kind == TK_EOF {
            self.b.token(self.pos);
            return self.pos;
        }
        let _i = self.advance();
        self.b.token(_i);
        return _i;
    }

    fn any(&mut self) -> i32 {
        if self.recovering { return self.pos; }
        if self.kinds[self.pos] != TK_EOF {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("expected any token; got", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_not(&mut self, excluded: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if k != TK_EOF && !kind_set_has(excluded, k) {
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("unexpected token", &EMPTY_SYNC, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }

    fn expect_set(&mut self, included: &List<i32>, expected: &List<i32>) -> i32 {
        if self.recovering { return self.pos; }
        let k = self.kinds[self.pos];
        if kind_set_has(included, k) {
            if k == TK_EOF {
                self.b.token(self.pos);
                return self.pos;
            }
            let _i = self.advance();
            self.b.token(_i);
            return _i;
        }
        self.fail_on_token("got", expected, DiagnosticCode::UnexpectedToken);
        return self.pos;
    }
}

fn scan_expression_list(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let scan_start = pos;
    let mut pos = pos;
    ATN_STACK.push(19);
    pos = scan_e(tokens, pos, (FOLLOW_MASK_1 | (follow & FOLLOW_SEQUENCED | FOLLOW_OPENS_BIT) << 16) & FOLLOW_CONT_MASK, 0);
    ATN_STACK.pop();
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos] == TK_LIT_COMMA && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
        let sp = pos;
        sg_0_done: {
            sg_0: {
                pos += 1;
                ATN_STACK.push(28);
                pos = scan_e(tokens, pos, (FOLLOW_MASK_1 | (follow & FOLLOW_SEQUENCED | FOLLOW_OPENS_BIT) << 16) & FOLLOW_CONT_MASK, 0);
                ATN_STACK.pop();
                if pos < 0 { break sg_0; }
                break sg_0_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    if pos == scan_start { return -1; }
    return pos;
}

fn scan_e_atom_alt_5(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let mut pos = pos;
    ATN_STACK.push(53);
    pos = scan_typespec(tokens, pos);
    ATN_STACK.pop();
    if pos < 0 { return -1; }
    if pos >= tokens.len() || tokens[pos] != TK_LIT_DOT { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_class { return -1; }
    pos += 1;
    return pos;
}

fn scan_e_atom(tokens: &Array<i32>, pos: i32, follow: i64 = 0) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_LIT_LPAREN {
            let mut best: i32 = -1;
            pos = start + 1;
            try_7: {
                ATN_STACK.push(90);
                pos = scan_typespec(tokens, pos);
                ATN_STACK.pop();
                if pos < 0 { break try_7; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_7; }
                pos += 1;
                ATN_STACK.push(94);
                pos = scan_e(tokens, pos, follow, 16);
                ATN_STACK.pop();
                if pos < 0 { break try_7; }
                if pos > best { best = pos; }
            }
            pos = start + 1;
            try_0: {
                ATN_STACK.push(36);
                pos = scan_e(tokens, pos, (FOLLOW_MASK_2 | (follow & FOLLOW_SEQUENCED) << 8) & FOLLOW_CONT_MASK, 0);
                ATN_STACK.pop();
                if pos < 0 { break try_0; }
                if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break try_0; }
                pos += 1;
                if pos > best { best = pos; }
            }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if _kind_set_1(alt_kind) {
            pos = start + 1;
            break scan_alts;
        } else if alt_kind == TK_ID {
            let mut best: i32 = -1;
            let try_5_end = scan_e_atom_alt_5(tokens, start, follow);
            if try_5_end > best { best = try_5_end; }
            pos = start + 1;
            if pos > best { best = pos; }
            if best >= 0 { pos = best; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_int {
            pos = scan_e_atom_alt_5(tokens, start, follow);
            if pos >= 0 { break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_new {
            pos = start + 1;
            try_6: {
                ATN_STACK.push(62);
                pos = scan_typespec(tokens, pos);
                ATN_STACK.pop();
                if pos < 0 { break try_6; }
                let gp_1 = pos;
                sg_1_done: {
                    let sgk_1 = if pos < tokens.len() { tokens[pos] } else { TK_EOF };
                    if sgk_1 == TK_LIT_LPAREN {
                        sg_1_0: {
                            pos += 1;
                            if pos < tokens.len() && _kind_set_0(tokens[pos]) {
                                let sp = pos;
                                ATN_STACK.push(71);
                                pos = scan_expression_list(tokens, pos, (FOLLOW_MASK_2 | (follow & FOLLOW_SEQUENCED) << 8) & FOLLOW_CONT_MASK);
                                ATN_STACK.pop();
                                if pos < 0 { pos = sp; }
                            }
                            if pos >= tokens.len() || tokens[pos] != TK_LIT_RPAREN { break sg_1_0; }
                            pos += 1;
                            break sg_1_done;
                        }
                    } else if sgk_1 == TK_LIT_LBRACKET {
                        sg_1_1: {
                            sg_2_done: {
                                sg_2: {
                                    pos += 1;
                                    ATN_STACK.push(81);
                                    pos = scan_e(tokens, pos, (FOLLOW_MASK_5 | (follow & FOLLOW_SEQUENCED) << 8) & FOLLOW_CONT_MASK, 0);
                                    ATN_STACK.pop();
                                    if pos < 0 { break sg_2; }
                                    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { break sg_2; }
                                    pos += 1;
                                    break sg_2_done;
                                }
                                break sg_1_1;
                            }
                            while pos < tokens.len() && tokens[pos] == TK_LIT_LBRACKET && !(follow_yields(tokens, pos, follow, &FOLLOW_SETS, TK_EOF)) {
                                let sp = pos;
                                sg_3_done: {
                                    sg_3: {
                                        pos += 1;
                                        ATN_STACK.push(81);
                                        pos = scan_e(tokens, pos, (FOLLOW_MASK_5 | (follow & FOLLOW_SEQUENCED) << 8) & FOLLOW_CONT_MASK, 0);
                                        ATN_STACK.pop();
                                        if pos < 0 { break sg_3; }
                                        if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { break sg_3; }
                                        pos += 1;
                                        break sg_3_done;
                                    }
                                    pos = -1;
                                }
                                if pos < 0 { pos = sp; break; }
                                if pos == sp { break; }
                            }
                            break sg_1_done;
                        }
                    }
                    pos = gp_1;
                }
                break scan_alts;
            }
            return -1;
        } else if _kind_set_2(alt_kind) {
            try_8: {
                pos += 1;
                ATN_STACK.push(111);
                pos = scan_e(tokens, pos, follow, 14);
                ATN_STACK.pop();
                if pos < 0 { break try_8; }
                break scan_alts;
            }
            return -1;
        } else if _kind_set_3(alt_kind) {
            try_9: {
                pos += 1;
                ATN_STACK.push(122);
                pos = scan_e(tokens, pos, follow, 14);
                ATN_STACK.pop();
                if pos < 0 { break try_9; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

