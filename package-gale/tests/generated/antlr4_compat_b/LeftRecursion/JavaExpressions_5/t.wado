fn _parse_e(p: &mut Parser, follow: i64 = 0, min_prec: i32 = 0) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    ATN_STACK.push(_atn_ret);
    p.sites.push(p.site);
    let _row = p.b.checkpoint();
    _parse_e__inner(p, follow, min_prec);
    if p.recovering && p.recover_rule(RK_E, "e", _row) { p.b.finish_node(p.last_end()); }
    ATN_STACK.pop();
    p.sites.pop();
}

fn _parse_typespec__inner_alt_1(p: &mut Parser) -> () {
    p.expect(TK_ID, &SYNC_5, false);
    p.expect(TK_LIT_LBRACKET, &SYNC_8, false);
    p.expect(TK_LIT_RBRACKET, &EMPTY_SYNC, true, true);
    return;
}

fn _parse_typespec__inner_scan_1(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner_alt_0(p: &mut Parser) -> () {
    p.expect(TK_ID, &EMPTY_SYNC, true, true);
    return;
}

fn _parse_typespec__inner_scan_0(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner_alt_3(p: &mut Parser) -> () {
    p.expect(TK_LIT_int, &SYNC_5, false);
    p.expect(TK_LIT_LBRACKET, &SYNC_8, false);
    p.expect(TK_LIT_RBRACKET, &EMPTY_SYNC, true, true);
    return;
}

fn _parse_typespec__inner_scan_3(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_int { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner_alt_2(p: &mut Parser) -> () {
    p.expect(TK_LIT_int, &EMPTY_SYNC, true, true);
    return;
}

fn _parse_typespec__inner_scan_2(tokens: &Array<i32>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_int { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner(p: &mut Parser) -> () {
    if !kind_set_has(&SYNC_1, p.kinds[p.pos]) { p.sync_alts(&SYNC_1, &EXPECTED_1); }
    let kind = p.peek_kind();
    if kind == TK_ID {
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 18, &ATN_STACK, &p.kinds, p.pos, TK_EOF, 0);
        if _atn_alt == 1 {
            return _parse_typespec__inner_alt_1(p);
        }
        return _parse_typespec__inner_alt_0(p);
    }
    if kind == TK_LIT_int {
        let _atn_alt = atn_predict_with_stack(&ATN_SIM, 18, &ATN_STACK, &p.kinds, p.pos, TK_EOF, 0);
        if _atn_alt == 3 {
            return _parse_typespec__inner_alt_3(p);
        }
        return _parse_typespec__inner_alt_2(p);
    }
    p.no_viable(
        "no alternative of typespec matches",
        p.peek_span(),
        &EXPECTED_1,
    );
    return;
}

fn _parse_typespec(p: &mut Parser) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    ATN_STACK.push(_atn_ret);
    p.sites.push(p.site);
    let _start = p.peek_start();
    p.b.start_node(RK_TYPESPEC, _start);
    _parse_typespec__inner(p);
    if p.recovering { let _ = p.recover_rule(RK_TYPESPEC, "typespec", -1); }
    p.b.finish_node(p.last_end());
    ATN_STACK.pop();
    p.sites.pop();
}

fn _run_parse_entry<S: AsStrSlice>(input: S, max_errors: i32, entry: fn(&mut Parser)) -> ParseResult {
    assert max_errors >= 1, `max_errors must be >= 1, got ${max_errors}`;
    let tokens = tokenize(input);
    let mut p = Parser::new(tokens);
    p.max_errors = max_errors;
    entry(&mut p);
    if p.recovering && p.diagnostics.len() < max_errors {
        if let Some(d) = p.pending {
            p.diagnostics.push(d);
        }
    }
    merge_lex_errors(&p.tokens, &mut p.diagnostics, max_errors);
    resolve_positions(&mut p.diagnostics, p.tokens.chars);
    return ParseResult { cst: p.b.finish(), tokens: p.tokens, diagnostics: p.diagnostics, output: p.tokens.output };
}

pub fn parse<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return parse_s(input, max_errors);
}

pub fn parse_s<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_s(p));
}

pub fn parse_expression_list<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_expression_list(p));
}

pub fn parse_e<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_e(p));
}

pub fn parse_typespec<S: AsStrSlice>(input: S, max_errors: i32 = i32::MAX) -> ParseResult {
    return _run_parse_entry(input, max_errors, |p: &mut Parser| _parse_typespec(p));
}

global CALL_FOLLOW_SETS: List<List<i32>> = [[8], [32], [128], [1024], [], [8256], [16384], [-1596352, 2096895], [0, 256]];
global CALL_FOLLOW: List<i32> = [0, 1, 1, 2, 3, 4, 4, 4, 2, 4, 2, 5, 2, 6, 4, 6, 2, 7, 4, 4, 2, 7, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 7, 4, 8, 7, 4, 7];
global CALL_FOLLOW_ENDS: List<bool> = [false, true, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, true, false, false, false, true, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, false, true, false, true];

fn token_display_name(kind: i32) -> String {
    return token_kind_name(kind);
}

fn _token_names() -> List<String> {
    let mut v: List<String> = List::with_capacity(54);
    for let mut k = 0; k < 54; k += 1 {
        v.push(token_display_name(k));
    }
    return v;
}

global CTX_TOKEN_NAMES: List<String> = _token_names();

pub fn to_string_tree(result: &ParseResult) -> String {
    return result.cst.to_string_tree(0, &result.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
}

pub fn to_string_subtree<S: AsStrSlice>(result: &ParseResult, rule: S) -> String {
    let mut _kind: i32 = -1;
    for let mut i = 0; i < RULE_NAMES.len(); i += 1 {
        if rule == RULE_NAMES[i] {
            _kind = i;
            break;
        }
    }
    if _kind < 0 { return String::new(); }
    let _sub = result.cst.find_child(0, _kind as NodeKind);
    if _sub >= 0 {
        return result.cst.to_string_tree(_sub, &result.tokens, &RULE_NAMES, &CTX_TOKEN_NAMES);
    }
    return String::new();
}

fn _kind_set_0(k: i32) -> bool {
    return k matches { TK_ID | TK_INT | TK_LIT_BANG | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_PLUSPLUS | TK_LIT_TILDE | TK_LIT_int | TK_LIT_new | TK_LIT_super | TK_LIT_this };
}

fn _kind_set_1(k: i32) -> bool {
    return k matches { TK_INT | TK_LIT_super | TK_LIT_this };
}

fn _kind_set_2(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_PLUSPLUS };
}

fn _kind_set_3(k: i32) -> bool {
    return k matches { TK_LIT_BANG | TK_LIT_TILDE };
}

fn _kind_set_4(k: i32) -> bool {
    return k matches { TK_LIT_MINUSMINUS | TK_LIT_PLUSPLUS };
}

fn _kind_set_5(k: i32) -> bool {
    return k matches { TK_LIT_PERCENT | TK_LIT_SLASH | TK_LIT_STAR };
}

fn _kind_set_6(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_PLUS };
}

fn _kind_set_7(k: i32) -> bool {
    return k matches { TK_LIT_GTGT | TK_LIT_GTGTGT | TK_LIT_LTLT };
}

fn _kind_set_8(k: i32) -> bool {
    return k matches { TK_LIT_GT | TK_LIT_GTEQ | TK_LIT_LT | TK_LIT_LTEQ };
}

fn _kind_set_9(k: i32) -> bool {
    return k matches { TK_LIT_BANGEQ | TK_LIT_EQEQ };
}

fn _kind_set_10(k: i32) -> bool {
    return k matches { TK_LIT_AMPEQ | TK_LIT_CARETEQ | TK_LIT_EQ | TK_LIT_GTGTEQ | TK_LIT_GTGTGTEQ | TK_LIT_LTLTEQ | TK_LIT_MINUSEQ | TK_LIT_PERCENTEQ | TK_LIT_PIPEEQ | TK_LIT_PLUSEQ | TK_LIT_SLASHEQ | TK_LIT_STAREQ };
}

fn _kind_set_11(k: i32) -> bool {
    return k matches { TK_ID | TK_LIT_int };
