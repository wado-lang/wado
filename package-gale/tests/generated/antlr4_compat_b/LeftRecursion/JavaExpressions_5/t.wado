struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new<S: AsStrSlice>(input: S) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }
}

fn try_ID(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { '$' | 'A'..='Z' | '_' | 'a'..='z' })) { return -1; }
    pos += 1;
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            if pos >= chars.len() { break rep_0; }
            if !((chars[pos] matches { '$' | 'A'..='Z' | '_' | 'a'..='z' })) { break rep_0; }
            pos += 1;
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_INT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || !(chars[pos] matches { '0'..='9' }) { return -1; }
    pos += 1;
    loop {
        let rep_saved_2 = pos;
        rep_2: {
            if pos >= chars.len() || !(chars[pos] matches { '0'..='9' }) { break rep_2; }
            pos += 1;
            continue;
        }
        pos = rep_saved_2;
        break;
    }
    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !((chars[pos] matches { '\n' | ' ' })) { return -1; }
    pos += 1;
    return pos;
}

fn try_lit_COMMA(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != ',' { return -1; }
    return pos + 1;
}

fn try_lit_LPAREN(chars: &List<char>, start: i32) -> i32 {
    let pos = start;
    if pos + 0 >= chars.len() || chars[pos + 0] != '(' { return -1; }
    return pos + 1;
}

