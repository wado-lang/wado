struct Lexer {
    chars: List<char>,
    pos: i32,
}

impl Lexer {
    fn new(input: &String) -> Lexer {
        return Lexer { chars: input.to_chars(), pos: 0 };
    }

    fn at_end(&self) -> bool {
        return self.pos >= self.chars.len();
    }

    fn slice(&self, start: i32, end: i32) -> LexerSlice with stores[self] {
        return LexerSlice::new(&self.chars, start, end);
    }
}

fn try_ID(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_1 = pos;
    let mut alts_ok_1 = false;
    alts_1_0: {
        pos = alts_saved_1;
        if pos >= chars.len() || !(chars[pos] matches { 'a'..='z' }) { break alts_1_0; }
        pos += 1;
        alts_ok_1 = true;
    }
    if !alts_ok_1 {
        alts_1_1: {
            pos = alts_saved_1;
            if pos >= chars.len() || !(chars[pos] matches { 'A'..='Z' }) { break alts_1_1; }
            pos += 1;
            alts_ok_1 = true;
        }
        if !alts_ok_1 {
            alts_1_2: {
                pos = alts_saved_1;
                if pos >= chars.len() || chars[pos] != '_' { break alts_1_2; }
                pos += 1;
                alts_ok_1 = true;
            }
            if !alts_ok_1 {
                alts_1_3: {
                    pos = alts_saved_1;
                    if pos >= chars.len() || chars[pos] != '$' { break alts_1_3; }
                    pos += 1;
                    alts_ok_1 = true;
                }
            }
        }
    }
    if !alts_ok_1 { return -1; }
    loop {
        let rep_saved_0 = pos;
        rep_0: {
            let alts_saved_2 = pos;
            let mut alts_ok_2 = false;
            alts_2_0: {
                pos = alts_saved_2;
                if pos >= chars.len() || !(chars[pos] matches { 'a'..='z' }) { break alts_2_0; }
                pos += 1;
                alts_ok_2 = true;
            }
            if !alts_ok_2 {
                alts_2_1: {
                    pos = alts_saved_2;
                    if pos >= chars.len() || !(chars[pos] matches { 'A'..='Z' }) { break alts_2_1; }
                    pos += 1;
                    alts_ok_2 = true;
                }
                if !alts_ok_2 {
                    alts_2_2: {
                        pos = alts_saved_2;
                        if pos >= chars.len() || chars[pos] != '_' { break alts_2_2; }
                        pos += 1;
                        alts_ok_2 = true;
                    }
                    if !alts_ok_2 {
                        alts_2_3: {
                            pos = alts_saved_2;
                            if pos >= chars.len() || chars[pos] != '$' { break alts_2_3; }
                            pos += 1;
                            alts_ok_2 = true;
                        }
                    }
                }
            }
            if !alts_ok_2 { break rep_0; }
            continue;
        }
        pos = rep_saved_0;
        break;
    }
    return pos;
}

fn try_INT(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() || !(chars[pos] matches { '0'..='9' }) { return -1; }
    pos += 1;
    loop {
        let rep_saved_3 = pos;
        rep_3: {
            if pos >= chars.len() || !(chars[pos] matches { '0'..='9' }) { break rep_3; }
            pos += 1;
            continue;
        }
        pos = rep_saved_3;
        break;
    }
    return pos;
}

fn try_WS(chars: &List<char>, start: i32) -> i32 {
    let mut pos = start;
    let alts_saved_4 = pos;
    let mut alts_ok_4 = false;
    alts_4_0: {
        pos = alts_saved_4;
        if pos >= chars.len() || chars[pos] != ' ' { break alts_4_0; }
        pos += 1;
        alts_ok_4 = true;
    }
    if !alts_ok_4 {
        alts_4_1: {
            pos = alts_saved_4;
            if pos >= chars.len() || chars[pos] != '\n' { break alts_4_1; }
            pos += 1;
            alts_ok_4 = true;
        }
    }
    if !alts_ok_4 { return -1; }
    return pos;
}

