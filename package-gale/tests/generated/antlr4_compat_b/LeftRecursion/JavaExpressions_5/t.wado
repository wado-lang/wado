    if pos + 2 >= chars.len() || chars[pos + 2] != 'p' { return -1; }
    if pos + 3 >= chars.len() || chars[pos + 3] != 'e' { return -1; }
    if pos + 4 >= chars.len() || chars[pos + 4] != 'r' { return -1; }
    return pos + 5;
}

