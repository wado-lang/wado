fn _parse_e(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW, min_prec: i32 = 0) -> () {
    if p.recovering { return; }
    let _atn_ret = p.atn_ret_pending;
    p.atn_ret_pending = -1;
    p.atn_stack.push(_atn_ret);
    _parse_e__inner(p, follow, min_prec);
    p.atn_stack.pop();
    if p.recovering {
        p.push_rule_stack("e");
    }
}

fn _parse_typespec__inner_alt_1(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let id = p.expect(TK_ID, &SYNC_4);
    let lbracket = p.expect(TK_LIT_LBRACKET, &SYNC_5);
    let rbracket = p.expect(TK_LIT_RBRACKET, &EMPTY_SYNC);
    return;
}

fn _parse_typespec__inner_scan_1(tokens: &Array<i32>, pos: i32, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos] != TK_ID { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos] != TK_LIT_RBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn _parse_typespec__inner_alt_0(p: &mut Parser, follow: &List<List<i32>> = &EMPTY_FOLLOW) -> () {
    let start = p.peek_start();
    let id = p.expect(TK_ID, &EMPTY_SYNC);
    return;
}

