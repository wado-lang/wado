global SYNC_2: List<i32> = [TK_LIT_CLASS];
global SYNC_3: List<i32> = [TK_ID, TK_INT, TK_LIT_BANG, TK_LIT_INT, TK_LIT_LPAREN, TK_LIT_MINUS, TK_LIT_MINUSMINUS, TK_LIT_NEW, TK_LIT_PLUS, TK_LIT_PLUSPLUS, TK_LIT_RPAREN, TK_LIT_SUPER, TK_LIT_THIS, TK_LIT_TILDE];
global SYNC_4: List<i32> = [TK_LIT_LBRACKET];
global SYNC_5: List<i32> = [TK_LIT_RBRACKET];

global FOLLOW_MASK_0: List<List<i32>> = [[TK_EOF]];
global FOLLOW_MASK_1: List<List<i32>> = [[TK_LIT_RPAREN]];
global FOLLOW_MASK_2: List<List<i32>> = [[TK_LIT_DOT], [TK_LIT_CLASS]];
global FOLLOW_MASK_3: List<List<i32>> = [[TK_LIT_LBRACKET, TK_LIT_LPAREN]];
