pub fn parse_s(input: &String) -> Result<SNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_s(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<SNode, ParseError>::Err(_d);
            }
        }
        return Result::<SNode, ParseError>::Err(_e);
    }
    return _result;
}

pub fn parse_expression_list(input: &String) -> Result<ExpressionListNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_expression_list(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<ExpressionListNode, ParseError>::Err(_d);
            }
        }
        return Result::<ExpressionListNode, ParseError>::Err(_e);
    }
    return _result;
}

pub fn parse_e(input: &String) -> Result<ENode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_e(&mut parser, 0);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<ENode, ParseError>::Err(_d);
            }
        }
        return Result::<ENode, ParseError>::Err(_e);
    }
    return _result;
}

pub fn parse_typespec(input: &String) -> Result<TypespecNode, ParseError> {
    let tokens = tokenize(input);
    let chars: List<char> = input.chars().collect();
    let mut parser = Parser::new(tokens, chars);
    let _result = _parse_typespec(&mut parser);
    if let Err(_e) = _result {
        if let Some(_d) = parser.pending {
            if _d.span.start >= _e.span.start {
                return Result::<TypespecNode, ParseError>::Err(_d);
            }
        }
        return Result::<TypespecNode, ParseError>::Err(_e);
    }
    return _result;
}

pub fn parse(input: &String) -> Result<SNode, ParseError> {
    return parse_s(input);
}

pub fn walk_s<V: Visitor>(v: &mut V, node: &SNode) {
    v.enter_rule(0, &"s", &node.span);
    walk_e(v, &node.e);
    v.visit_token(&node.eof);
    v.exit_rule(0, &"s", &node.span);
}

pub fn walk_expressionList<V: Visitor>(v: &mut V, node: &ExpressionListNode) {
    v.enter_rule(1, &"expressionList", &node.span);
    walk_e(v, &node.e);
    for let item of &node.comma_e_list {
        v.visit_token(&item.comma);
        walk_e(v, &item.e);
    }
    v.exit_rule(1, &"expressionList", &node.span);
}

pub fn walk_e<V: Visitor>(v: &mut V, node: &ENode) {
    match node {
        Alt0(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.lparen);
            walk_e(v, &n.e);
            v.visit_token(&n.rparen);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.lit_this);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.lit_super);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.int);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_typespec(v, &n.typespec);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_class);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.id);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_this);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_super);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.dot);
            v.visit_token(&n.lit_new);
            v.visit_token(&n.id);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.lit_new);
            walk_typespec(v, &n.typespec);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.lparen);
                        if let Some(item) = &inner.expression_list {
                            walk_expressionList(v, item);
                        }
                        v.visit_token(&inner.rparen);
                    }
                    Alt1(inner) => {
                        for let item of &inner.lbracket_e_rbracket_list {
                            v.visit_token(&item.lbracket);
                            walk_e(v, &item.e);
                            v.visit_token(&item.rbracket);
                        }
                    }
                }
            }
            v.exit_rule(2, &"e", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lbracket);
            walk_e(v, &n.e_2);
            v.visit_token(&n.rbracket);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.lparen);
            walk_typespec(v, &n.typespec);
            v.visit_token(&n.rparen);
            walk_e(v, &n.e);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_plusplus_or_lit_minusminus);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt14(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expression_list {
                walk_expressionList(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt15(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.plus_or_minus_or_lit_plusplus_or_lit_minusminus);
            walk_e(v, &n.e);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt16(n) => {
            v.enter_rule(2, &"e", &n.span);
            v.visit_token(&n.tilde_or_bang);
            walk_e(v, &n.e);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt17(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.star_or_slash_or_percent);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt18(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.plus_or_minus);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt19(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_ltlt_or_lit_gtgtgt_or_lit_gtgt);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt20(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_lteq_or_lit_gteq_or_gt_or_lt);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt21(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_instanceof);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt22(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_eqeq_or_lit_bangeq);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt23(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.amp);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt24(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.caret);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt25(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.pipe);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt26(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_ampamp);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt27(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.lit_pipepipe);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt28(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.question);
            walk_e(v, &n.e_2);
            v.visit_token(&n.colon);
            walk_e(v, &n.e_3);
            v.exit_rule(2, &"e", &n.span);
        }
        Alt29(n) => {
            v.enter_rule(2, &"e", &n.span);
            walk_e(v, &n.e);
            v.visit_token(&n.eq_or_lit_pluseq_or_lit_minuseq_or_lit_stareq_or_lit_slasheq_or_lit_ampeq_or_lit_pipeeq_or_lit_careteq_or_lit_gtgteq_or_lit_gtgtgteq_or_lit_ltlteq_or_lit_percenteq);
            walk_e(v, &n.e_2);
            v.exit_rule(2, &"e", &n.span);
        }
    }
}

pub fn walk_typespec<V: Visitor>(v: &mut V, node: &TypespecNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(&n.id);
            v.exit_rule(3, &"typespec", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(&n.id);
            v.visit_token(&n.lbracket);
            v.visit_token(&n.rbracket);
            v.exit_rule(3, &"typespec", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(&n.lit_int);
            v.exit_rule(3, &"typespec", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(3, &"typespec", &n.span);
            v.visit_token(&n.lit_int);
            v.visit_token(&n.lbracket);
            v.visit_token(&n.rbracket);
            v.exit_rule(3, &"typespec", &n.span);
        }
    }
}

pub fn to_tree(node: &SNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_s(&mut recorder, node);
    return recorder.build();
}

fn _gale_kind_set_0(k: i32) -> bool {
    return k matches { TK_LIT_LBRACKET | TK_LIT_LPAREN };
}

fn _gale_kind_set_1(k: i32) -> bool {
    return k matches { TK_ID | TK_INT | TK_LIT_BANG | TK_LIT_INT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_NEW | TK_LIT_PLUS | TK_LIT_PLUSPLUS | TK_LIT_SUPER | TK_LIT_THIS | TK_LIT_TILDE };
}

fn _gale_kind_set_2(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_PLUSPLUS };
}

fn _gale_kind_set_3(k: i32) -> bool {
    return k matches { TK_LIT_BANG | TK_LIT_TILDE };
}

fn _gale_kind_set_4(k: i32) -> bool {
    return k matches { TK_LIT_MINUSMINUS | TK_LIT_PLUSPLUS };
}

fn _gale_kind_set_5(k: i32) -> bool {
    return k matches { TK_LIT_PERCENT | TK_LIT_SLASH | TK_LIT_STAR };
}

fn _gale_kind_set_6(k: i32) -> bool {
    return k matches { TK_LIT_MINUS | TK_LIT_PLUS };
}

fn _gale_kind_set_7(k: i32) -> bool {
    return k matches { TK_LIT_GTGT | TK_LIT_GTGTGT | TK_LIT_LTLT };
}

fn _gale_kind_set_8(k: i32) -> bool {
    return k matches { TK_LIT_GT | TK_LIT_GTEQ | TK_LIT_LT | TK_LIT_LTEQ };
}

fn _gale_kind_set_9(k: i32) -> bool {
    return k matches { TK_LIT_BANGEQ | TK_LIT_EQEQ };
}

fn _gale_kind_set_10(k: i32) -> bool {
    return k matches { TK_LIT_AMPEQ | TK_LIT_CARETEQ | TK_LIT_EQ | TK_LIT_GTGTEQ | TK_LIT_GTGTGTEQ | TK_LIT_LTLTEQ | TK_LIT_MINUSEQ | TK_LIT_PERCENTEQ | TK_LIT_PIPEEQ | TK_LIT_PLUSEQ | TK_LIT_SLASHEQ | TK_LIT_STAREQ };
}

fn _gale_kind_set_11(k: i32) -> bool {
    return k matches { TK_ID | TK_LIT_INT };
}

