/// Driver test for the Rust grammar parser.
///
/// The Rust grammar uses semantic predicates for disambiguation, so some
/// constructs (fn, match, use paths) are not supported without predicate
/// evaluation. These tests cover items and expressions that parse correctly.
use rust from "./grammars/RustLexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["./grammars/RustParser.g4"],
            options: { highlight: false },
            output_dir: "tests/generated/rust",
        },
    };
use { normalize_tree } from "./grammars/RustLexer.g4";

// --- Tokenize tests ---

test "tokenize fn declaration" {
    let tokens = rust::tokenize(&"fn main() {}");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_FN", `expected KW_FN, got {first}`;
}

test "tokenize struct" {
    let tokens = rust::tokenize(&"struct Point { x: i32, y: i32 }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_STRUCT", `expected KW_STRUCT, got {first}`;
}

test "tokenize enum" {
    let tokens = rust::tokenize(&"enum Color { Red, Green, Blue }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_ENUM", `expected KW_ENUM, got {first}`;
}

test "tokenize impl block" {
    let tokens = rust::tokenize(&"impl Point { fn new() -> Self { Self { x: 0, y: 0 } } }");
    assert tokens.len() >= 15, `expected at least 15 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_IMPL", `expected KW_IMPL, got {first}`;
}

test "tokenize use statement" {
    let tokens = rust::tokenize(&"use std::collections::HashMap;");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_USE", `expected KW_USE, got {first}`;
}

test "tokenize trait" {
    let tokens = rust::tokenize(&"trait Foo { fn bar(&self); }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_TRAIT", `expected KW_TRAIT, got {first}`;
}

test "tokenize match expression" {
    let tokens = rust::tokenize(&"match x { 1 => true, _ => false }");
    assert tokens.len() >= 10, `expected at least 10 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_MATCH", `expected KW_MATCH, got {first}`;
}

test "tokenize lifetime" {
    let tokens = rust::tokenize(&"fn foo<'a>(x: &'a str) -> &'a str { x }");
    assert tokens.len() >= 10, `expected at least 10 tokens, got {tokens.len()}`;
}

test "tokenize closure" {
    let tokens = rust::tokenize(&"|x: i32| x + 1");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
}

test "tokenize macro invocation" {
    let tokens = rust::tokenize(&"println!(\"hello {}\", name);");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
}

// --- Parse tests ---

test "parse empty crate" {
    let result = rust::parse(&"");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "fn keyword requires semantic predicates" {
    // "fn main() {}" fails because the Rust grammar uses semantic predicates
    // for the `fn` keyword that gale does not evaluate.
    let result = rust::parse(&"fn main() {}");
    assert result matches { Err(_) }, "expected parse to fail due to missing semantic predicates";
}

// --- S-expression tree tests ---

fn assert_tree(input: &String, expected: &String) {
    let root = rust::parse(input).unwrap();
    let tree = rust::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

// Expression tests

test "tree: operator precedence" {
    assert_tree(&"const X: i32 = 1 + 2 * 3 - 4;", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression
                (expression
                    (expression (literalExpression 1))
                    +
                    (expression
                        (expression (literalExpression 2))
                        *
                        (expression (literalExpression 3))))
                -
                (expression (literalExpression 4)))
            ;))))
    ");
}

test "tree: deeply nested grouping" {
    assert_tree(&"const X: i32 = ((((42))));", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression (
                (expression (
                    (expression (
                        (expression (
                            (expression (literalExpression 42))
                        ))
                    ))
                ))
            ))
            ;))))
    ");
}

test "tree: negation scoping with boolean and comparison" {
    assert_tree(&"const X: i32 = !true && 1 != 2 || false;", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression !
                (expression
                    (expression
                        (expression (literalExpression true))
                        &&
                        (expression
                            (expression (literalExpression 1))
                            (comparisonOperator !=)
                            (expression (literalExpression 2))))
                    ||
                    (expression (literalExpression false))))
            ;))))
    ");
}

test "tree: array with complex elements" {
    assert_tree(&"const X: i32 = [1 + 2, !true, &42];", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression [
                (arrayElements
                    (expression
                        (expression (literalExpression 1))
                        +
                        (expression (literalExpression 2)))
                    ,
                    (expression ! (expression (literalExpression true)))
                    ,
                    (expression & (expression (literalExpression 42))))
            ])
            ;))))
    ");
}

test "tree: bitwise operator precedence" {
    assert_tree(&"const X: i32 = 1 ^ 2 & 3 | 4 + 5;", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression
                (expression
                    (expression (literalExpression 1))
                    ^
                    (expression
                        (expression (literalExpression 2))
                        &
                        (expression (literalExpression 3))))
                |
                (expression
                    (expression (literalExpression 4))
                    +
                    (expression (literalExpression 5))))
            ;))))
    ");
}

test "tree: closure returning closure" {
    assert_tree(&"const X: i32 = |x: i32| || 42;", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression (closureExpression
                |
                (closureParameters
                    (closureParam
                        (pattern (patternNoTopAlt (patternWithoutRange
                            (identifierPattern (identifier x)))))
                        :
                        (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                            (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
                |
                (expression (closureExpression || (expression (literalExpression 42))))))
            ;))))
    ");
}

test "tree: alternating reference and dereference" {
    assert_tree(&"const X: i32 = &*&*&42;", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression &
                (expression *
                    (expression &
                        (expression *
                            (expression &
                                (expression (literalExpression 42)))))))
            ;))))
    ");
}

test "tree: array index with error propagation" {
    assert_tree(&"const X: i32 = [1, 2][0]??;", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression
                (expression
                    (expression
                        (expression [
                            (arrayElements
                                (expression (literalExpression 1))
                                ,
                                (expression (literalExpression 2)))
                        ])
                        [ (expression (literalExpression 0)) ])
                    ?)
                ?)
            ;))))
    ");
}

test "tree: multiple items with use, const, and as cast" {
    assert_tree(&"use ::*; const X: i32 = &[1][0]; const Y: i32 = 42 as i64;", &"
        (crate
            (item (visItem (useDeclaration use (useTree :: *) ;)))
            (item (visItem (constantItem
                const (identifier X) :
                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
                =
                (expression &
                    (expression
                        (expression [ (arrayElements (expression (literalExpression 1))) ])
                        [ (expression (literalExpression 0)) ]))
                ;)))
            (item (visItem (constantItem
                const (identifier Y) :
                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
                =
                (expression
                    (expression (literalExpression 42))
                    as
                    (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier i64))))))))
                ;))))
    ");
}

test "tree: move closure with comparison" {
    assert_tree(&"const X: i32 = move |x: i32| 1 + 2 == 3 + 4;", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression (closureExpression
                move
                |
                (closureParameters
                    (closureParam
                        (pattern (patternNoTopAlt (patternWithoutRange
                            (identifierPattern (identifier x)))))
                        :
                        (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                            (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
                |
                (expression
                    (expression
                        (expression (literalExpression 1))
                        +
                        (expression (literalExpression 2)))
                    (comparisonOperator ==)
                    (expression
                        (expression (literalExpression 3))
                        +
                        (expression (literalExpression 4))))))
            ;))))
    ");
}

// Item and type tests

test "tree: struct with fields" {
    assert_tree(&"struct Point { x: i32, y: i32 }", &"
        (crate (item (visItem (struct_ (structStruct
            struct (identifier Point)
            { (structFields
                (structField (identifier x) :
                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier i32)))))))))
                ,
                (structField (identifier y) :
                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
            })))))
    ");
}

test "tree: type alias with lifetime reference" {
    assert_tree(&"type Ref<'a> = &'a i32;", &"
        (crate (item (visItem (typeAlias
            type (identifier Ref)
            (genericParams < (genericParam (lifetimeParam 'a)) >)
            =
            (type_ (typeNoBounds (referenceType
                & (lifetime 'a)
                (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
            ;))))
    ");
}

test "tree: type alias with mutable lifetime reference" {
    assert_tree(&"type MutRef<'a> = &'a mut i32;", &"
        (crate (item (visItem (typeAlias
            type (identifier MutRef)
            (genericParams < (genericParam (lifetimeParam 'a)) >)
            =
            (type_ (typeNoBounds (referenceType
                & (lifetime 'a) mut
                (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
            ;))))
    ");
}

test "tree: pub struct and pub static mut" {
    assert_tree(&"pub struct Foo; pub static mut COUNT: i32 = 0;", &"
        (crate
            (item (visItem (visibility pub) (struct_ (structStruct
                struct (identifier Foo) ;))))
            (item (visItem (visibility pub) (staticItem
                static mut (identifier COUNT) :
                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
                = (expression (literalExpression 0)) ;))))
    ");
}

test "tree: extern crate with rename" {
    assert_tree(&"extern crate alloc as core;", &"
        (crate (item (visItem (externCrate
            extern crate (crateRef (identifier alloc))
            (asClause as (identifier core)) ;))))
    ");
}

test "tree: three items combined" {
    assert_tree(&"struct Foo<'a>; type Ref<'a> = &'a i32; const X: i32 = 42;", &"
        (crate
            (item (visItem (struct_ (structStruct
                struct (identifier Foo)
                (genericParams < (genericParam (lifetimeParam 'a)) >)
                ;))))
            (item (visItem (typeAlias
                type (identifier Ref)
                (genericParams < (genericParam (lifetimeParam 'a)) >)
                =
                (type_ (typeNoBounds (referenceType
                    & (lifetime 'a)
                    (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
                ;)))
            (item (visItem (constantItem
                const (identifier X) :
                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
                = (expression (literalExpression 42)) ;))))
    ");
}

// Trait and impl tests

test "tree: trait with associated type" {
    assert_tree(&"trait Iterator { type Item; }", &"
        (crate (item (visItem (trait_
            trait (identifier Iterator) {
                (associatedItem (typeAlias type (identifier Item) ;))
            }))))
    ");
}

test "tree: impl trait for type" {
    assert_tree(&"impl Clone for Foo {}", &"
        (crate (item (visItem (implementation (traitImpl
            impl
            (typePath (typePathSegment (pathIdentSegment (identifier Clone))))
            for
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier Foo))))))))
            { })))))
    ");
}

test "tree: impl with associated const" {
    assert_tree(&"impl Foo { const MAX: i32 = 100; }", &"
        (crate (item (visItem (implementation (inherentImpl
            impl
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier Foo))))))))
            {
                (associatedItem (constantItem
                    const (identifier MAX) :
                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
                    = (expression (literalExpression 100)) ;))
            })))))
    ");
}

test "tree: enum with tuple, struct, and unit variants" {
    assert_tree(&"enum Expr { Lit(i32), Add { left: i32, right: i32 }, Unit }", &"
        (crate (item (visItem (enumeration
            enum (identifier Expr) {
                (enumItems
                    (enumItem (identifier Lit)
                        (enumItemTuple ( (tupleFields
                            (tupleField (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
                        )))
                    ,
                    (enumItem (identifier Add)
                        (enumItemStruct { (structFields
                            (structField (identifier left) :
                                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                                    (typePath (typePathSegment (pathIdentSegment (identifier i32)))))))))
                            ,
                            (structField (identifier right) :
                                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))))
                        }))
                    ,
                    (enumItem (identifier Unit)))
            }))))
    ");
}

// Expression with block tests

test "tree: if else expression" {
    assert_tree(&"const X: i32 = if true { 1 } else { 2 };", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression (expressionWithBlock (ifExpression
                if (expression (literalExpression true))
                (blockExpression { (statements (expression (literalExpression 1))) })
                else
                (blockExpression { (statements (expression (literalExpression 2))) }))))
            ;))))
    ");
}

test "tree: block expression" {
    assert_tree(&"const X: i32 = { 1 + 2 };", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression (expressionWithBlock (blockExpression {
                (statements (expression
                    (expression (literalExpression 1))
                    +
                    (expression (literalExpression 2))))
            })))
            ;))))
    ");
}

test "tree: method call chain" {
    assert_tree(&"const X: i32 = x.foo().bar();", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
            =
            (expression
                (expression
                    (expression (pathExpression (pathInExpression
                        (pathExprSegment (pathIdentSegment (identifier x))))))
                    . (pathExprSegment (pathIdentSegment (identifier foo))) ( ))
                . (pathExprSegment (pathIdentSegment (identifier bar))) ( ))
            ;))))
    ");
}

// Advanced type tests

test "tree: struct with trait bounds" {
    assert_tree(&"struct Bounded<T: Clone + Send> { x: T }", &"
        (crate (item (visItem (struct_ (structStruct
            struct (identifier Bounded)
            (genericParams < (genericParam (typeParam
                (identifier T) :
                (typeParamBounds
                    (typeParamBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier Clone))))))
                    +
                    (typeParamBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier Send))))))))) >)
            { (structFields
                (structField (identifier x) :
                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier T))))))))))
            })))))
    ");
}

test "tree: never type and slice type" {
    assert_tree(&"type Never = !; type Slice = [u8];", &"
        (crate
            (item (visItem (typeAlias
                type (identifier Never) = (type_ (typeNoBounds (neverType !))) ;)))
            (item (visItem (typeAlias
                type (identifier Slice) =
                (type_ (typeNoBounds (sliceType [
                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier u8))))))))
                ])))
                ;))))
    ");
}

test "tree: array type with const size" {
    assert_tree(&"const X: [i32; 3] = [1, 2, 3];", &"
        (crate (item (visItem (constantItem
            const (identifier X) :
            (type_ (typeNoBounds (arrayType [
                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment (identifier i32))))))))
                ; (expression (literalExpression 3))
            ])))
            =
            (expression [
                (arrayElements
                    (expression (literalExpression 1)) ,
                    (expression (literalExpression 2)) ,
                    (expression (literalExpression 3)))
            ])
            ;))))
    ");
}

test "tree: nested generics" {
    assert_tree(&"struct Wrap<T> { inner: Option<Vec<T>> }", &"
        (crate (item (visItem (struct_ (structStruct
            struct (identifier Wrap)
            (genericParams < (genericParam (typeParam (identifier T))) >)
            { (structFields
                (structField (identifier inner) :
                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment (identifier Option))
                            (genericArgs <
                                (genericArgsTypes
                                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                                        (typePath (typePathSegment (pathIdentSegment (identifier Vec))
                                            (genericArgs <
                                                (genericArgsTypes
                                                    (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                                                        (typePath (typePathSegment (pathIdentSegment (identifier T)))))))))
                                            >))))))))
                            >)))))))))
            })))))
    ");
}
