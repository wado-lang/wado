/// Driver test for the Rust grammar parser.
///
/// The Rust grammar uses semantic predicates for disambiguation, so full
/// parsing is not supported without predicate evaluation. These tests
/// verify tokenization of various Rust constructs.
use rust from "./golden/rust.wado";
use { normalize_tree } from "./golden/rust.wado";

test "tokenize fn declaration" {
    let tokens = rust::tokenize(&"fn main() {}");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_FN", `expected KW_FN, got {first}`;
}

test "tokenize struct" {
    let tokens = rust::tokenize(&"struct Point { x: i32, y: i32 }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_STRUCT", `expected KW_STRUCT, got {first}`;
}

test "tokenize enum" {
    let tokens = rust::tokenize(&"enum Color { Red, Green, Blue }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_ENUM", `expected KW_ENUM, got {first}`;
}

test "tokenize impl block" {
    let tokens = rust::tokenize(&"impl Point { fn new() -> Self { Self { x: 0, y: 0 } } }");
    assert tokens.len() >= 15, `expected at least 15 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_IMPL", `expected KW_IMPL, got {first}`;
}

test "tokenize use statement" {
    let tokens = rust::tokenize(&"use std::collections::HashMap;");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_USE", `expected KW_USE, got {first}`;
}

test "tokenize trait" {
    let tokens = rust::tokenize(&"trait Foo { fn bar(&self); }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_TRAIT", `expected KW_TRAIT, got {first}`;
}

test "tokenize match expression" {
    let tokens = rust::tokenize(&"match x { 1 => true, _ => false }");
    assert tokens.len() >= 10, `expected at least 10 tokens, got {tokens.len()}`;
    let first = rust::token_kind_name(tokens[0].kind);
    assert first == "KW_MATCH", `expected KW_MATCH, got {first}`;
}

test "tokenize lifetime" {
    let tokens = rust::tokenize(&"fn foo<'a>(x: &'a str) -> &'a str { x }");
    assert tokens.len() >= 10, `expected at least 10 tokens, got {tokens.len()}`;
}

test "tokenize closure" {
    let tokens = rust::tokenize(&"|x: i32| x + 1");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
}

test "tokenize macro invocation" {
    let tokens = rust::tokenize(&"println!(\"hello {}\", name);");
    assert tokens.len() >= 5, `expected at least 5 tokens, got {tokens.len()}`;
}

// --- Parser tests ---
// The Rust lexer uses semantic predicates to distinguish identifiers from
// keywords, so most identifiers are tokenized incorrectly (e.g., "main" becomes
// separate tokens). Only inputs without identifiers can parse successfully.

test "parse empty crate" {
    // Empty input is valid: crate rule is `innerAttribute* item* EOF`
    let result = rust::parse(&"");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse fails with identifiers" {
    // "fn main() {}" fails because the lexer splits "main" into fragments
    // due to missing semantic predicates for identifier tokenization.
    let result = rust::parse(&"fn main() {}");
    assert result matches { Err(_) }, "expected parse to fail due to missing semantic predicates";
}

// --- S-expression tree tests ---
// The Rust lexer cannot handle ASCII identifiers or space characters due to
// unsupported Unicode property classes (\p{L}, \p{Zs}). Curly braces are also
// misclassified. These tests use newlines as whitespace and build expressions
// inside `const _: Self = EXPR;` to exercise complex parser paths.

fn assert_tree(input: &String, expected: &String) {
    let root = rust::parse(input).unwrap();
    let tree = rust::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

test "tree: operator precedence chain" {
    // 1 + (2*3) - 4: mul binds tighter than add/sub
    assert_tree(&"const\n_:\nSelf\n=\n1+2*3-4;", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression
                (expression
                    (expression (literalExpression 1))
                    +
                    (expression
                        (expression (literalExpression 2))
                        *
                        (expression (literalExpression 3))))
                -
                (expression (literalExpression 4)))
            ;))))
    ");
}

test "tree: deeply nested grouping" {
    assert_tree(&"const\n_:\nSelf\n=\n((((42))));", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression (
                (expression (
                    (expression (
                        (expression (
                            (expression (literalExpression 42))
                        ))
                    ))
                ))
            ))
            ;))))
    ");
}

test "tree: negation wraps boolean and comparison" {
    // ! greedily wraps the entire RHS: !(true && (1 != 2) || false)
    assert_tree(&"const\n_:\nSelf\n=\n!true&&1!=2||false;", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression !
                (expression
                    (expression
                        (expression (literalExpression true))
                        &&
                        (expression
                            (expression (literalExpression 1))
                            (comparisonOperator !=)
                            (expression (literalExpression 2))))
                    ||
                    (expression (literalExpression false))))
            ;))))
    ");
}

test "tree: array with complex element expressions" {
    assert_tree(&"const\n_:\nSelf\n=\n[1+2,!true,&42];", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression [
                (arrayElements
                    (expression
                        (expression (literalExpression 1))
                        +
                        (expression (literalExpression 2)))
                    ,
                    (expression ! (expression (literalExpression true)))
                    ,
                    (expression & (expression (literalExpression 42))))
            ])
            ;))))
    ");
}

test "tree: bitwise operator precedence" {
    // & > ^ > |, and + > all bitwise: (1 ^ (2 & 3)) | (4 + 5)
    assert_tree(&"const\n_:\nSelf\n=\n1^2&3|4+5;", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression
                (expression
                    (expression (literalExpression 1))
                    ^
                    (expression
                        (expression (literalExpression 2))
                        &
                        (expression (literalExpression 3))))
                |
                (expression
                    (expression (literalExpression 4))
                    +
                    (expression (literalExpression 5))))
            ;))))
    ");
}

test "tree: closure returning closure with typed param" {
    assert_tree(&"const\n_:\nSelf\n=\n|_:\nSelf|\n||42;", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression (closureExpression
                |
                (closureParameters
                    (closureParam
                        (pattern (patternNoTopAlt (patternWithoutRange (wildcardPattern _))))
                        :
                        (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                            (typePath (typePathSegment (pathIdentSegment Self)))))))))
                |
                (expression (closureExpression || (expression (literalExpression 42))))))
            ;))))
    ");
}

test "tree: alternating reference and dereference" {
    assert_tree(&"const\n_:\nSelf\n=\n&*&*&42;", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression &
                (expression *
                    (expression &
                        (expression *
                            (expression &
                                (expression (literalExpression 42)))))))
            ;))))
    ");
}

test "tree: array index with error propagation" {
    assert_tree(&"const\n_:\nSelf\n=\n[1,2][0]??;", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression
                (expression
                    (expression
                        (expression [
                            (arrayElements
                                (expression (literalExpression 1))
                                ,
                                (expression (literalExpression 2)))
                        ])
                        [ (expression (literalExpression 0)) ])
                    ?)
                ?)
            ;))))
    ");
}

test "tree: multiple items with diverse constructs" {
    assert_tree(&"use\n::*;\nconst\n_:\nSelf\n=\n&[1][0];\nconst\n_:\nSelf\n=\n42\nas\nSelf;", &"
        (crate
            (item (visItem (useDeclaration use (useTree :: *) ;)))
            (item (visItem (constantItem
                const _ :
                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment Self)))))))
                =
                (expression &
                    (expression
                        (expression [ (arrayElements (expression (literalExpression 1))) ])
                        [ (expression (literalExpression 0)) ]))
                ;)))
            (item (visItem (constantItem
                const _ :
                (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                    (typePath (typePathSegment (pathIdentSegment Self)))))))
                =
                (expression
                    (expression (literalExpression 42))
                    as
                    (typeNoBounds (traitObjectTypeOneBound (traitBound
                        (typePath (typePathSegment (pathIdentSegment Self)))))))
                ;))))
    ");
}

test "tree: move closure with ref body and comparison in const" {
    // move |_: Self| 1+2 == 3+4
    assert_tree(&"const\n_:\nSelf\n=\nmove\n|_:\nSelf|\n1+2==3+4;", &"
        (crate (item (visItem (constantItem
            const _ :
            (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                (typePath (typePathSegment (pathIdentSegment Self)))))))
            =
            (expression (closureExpression
                move
                |
                (closureParameters
                    (closureParam
                        (pattern (patternNoTopAlt (patternWithoutRange (wildcardPattern _))))
                        :
                        (type_ (typeNoBounds (traitObjectTypeOneBound (traitBound
                            (typePath (typePathSegment (pathIdentSegment Self)))))))))
                |
                (expression
                    (expression
                        (expression (literalExpression 1))
                        +
                        (expression (literalExpression 2)))
                    (comparisonOperator ==)
                    (expression
                        (expression (literalExpression 3))
                        +
                        (expression (literalExpression 4))))))
            ;))))
    ");
}
