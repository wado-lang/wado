//! Stage 3 down-payment on the emitter: a malformed element inside a
//! scan-gated repetition reports the error at the malformed token, not at the
//! following required token (the "off-by-one statement" symptom). The precise
//! position comes from the scan-gated repeat's speculative re-parse, which now
//! runs builder-safe (checkpoint/truncate) under the emitter.

use errrec from "./grammars/error_recovery.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/cst_error_recovery",
        },
    };

fn first_diag_col(input: &String) -> i32 {
    let r = errrec::parse(input);
    assert !r.ok(), `expected a diagnostic for {*input}`;
    return r.diagnostics[0].col;
}

test "error position: malformed item under `item* EOF`" {
    assert first_diag_col(&"let x = ;") == 8, `expected col 8 (the ';')`;
}
test "error position: malformed item under `item* '}'`" {
    assert first_diag_col(&"{ let x = ; }") == 10, `expected col 10 (the ';')`;
}
test "error position: non-item token stays put" {
    assert first_diag_col(&"let x = y ; +") == 12, `expected col 12 (the '+')`;
}

// Error-token trees: the resilient parser must repair broken input in place and
// the repair must round-trip through the tree (insert -> `<missing>`, delete ->
// `<skip>`). A clean parse keeps these markers absent.
fn assert_tree(input: &String, expected: &String) {
    let r = errrec::parse(input);
    let actual = errrec::to_string_tree(&r);
    assert actual == *expected, `\ninput:    {*input}\nexpected: {*expected}\nactual:   {actual}`;
}

// `item : 'let' ID '=' ID ';'`; the second ID is absent. The current token (`;`)
// is the rule's own next terminal, so recovery inserts a synthetic ID and keeps
// parsing — yielding a complete `item` with one missing leaf.
test "tree: insert missing terminal" {
    assert_tree(&"let x = ;", &"(prog (item let x = <missing ID> ;))");
}

// A spurious extra ID before `=`; peek(1) is the expected `=`, so the extra
// token is deleted (skipped) and `=` consumed.
test "tree: delete extra terminal" {
    assert_tree(&"let x y = z ;", &"(prog (item let x <skip y> = z ;))");
}

// At the second ID, `}` is neither the expected ID (match), the token before
// it (delete), nor a continuation (insert), so the run of `}` is skipped into a
// lossless `<error>` region until the rule resyncs on `;`; the absent ID is then
// inserted. The original input round-trips through the tree.
test "tree: error region resyncs to FOLLOW" {
    assert_tree(
        &"let x = } } ;",
        &"(prog (item let x = (<error> <skip }> <skip }>) <missing ID> ;))",
    );
}

// Two malformed items each insert a missing ID, so the uncapped parse reports
// two diagnostics; `max_errors` stops recovery after the first and folds.
test "max_errors caps recovery diagnostics" {
    let full = errrec::parse(&"let x = ; let y = ;");
    assert full.diagnostics.len() == 2, `expected 2, got {full.diagnostics.len()}`;
    let capped = errrec::parse(&"let x = ; let y = ;", 1);
    assert capped.diagnostics.len() == 1, `expected 1, got {capped.diagnostics.len()}`;
}
