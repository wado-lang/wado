use calc from "./golden/calculator.wado";
use {
    Span, Token,
    EquationNode, ExpressionNode, MultiplyingExpressionNode,
    PowExpressionNode, SignedAtomNode, SignedAtomAlt0, SignedAtomAlt1,
    SignedAtomAlt2, SignedAtomAlt3,
    AtomNode, AtomAlt0, AtomAlt1, AtomAlt2, AtomAlt3,
    ScientificNode, ConstantNode, ConstantAlt0, ConstantAlt1, ConstantAlt2,
    VariableNode, FuncNode, FuncnameNode,
    FuncnameAlt0, FuncnameAlt1, FuncnameAlt2, FuncnameAlt3,
    FuncnameAlt4, FuncnameAlt5, FuncnameAlt6, FuncnameAlt7, FuncnameAlt8,
    RelopNode, RelopAlt0, RelopAlt1, RelopAlt2,
    TK_PLUS, TK_MINUS, TK_TIMES, TK_DIV, TK_EQ, TK_GT, TK_LT,
    TK_LPAREN, TK_RPAREN, TK_SCIENTIFIC_NUMBER, TK_VARIABLE,
    TK_PI, TK_EULER, TK_I, TK_EOF,
    TK_COS, TK_SIN, TK_SQRT,
} from "./golden/calculator.wado";

fn tok(kind: i32, text: String, start: i32, end: i32) -> Token {
    return Token { kind, text, span: Span { start, end } };
}

fn s(start: i32, end: i32) -> Span {
    return Span { start, end };
}

fn num_expr(text: String, start: i32, end: i32) -> ExpressionNode {
    return ExpressionNode {
        span: s(start, end),
        multiplying_expression: MultiplyingExpressionNode {
            span: s(start, end),
            pow_expression: PowExpressionNode {
                span: s(start, end),
                signed_atom: SignedAtomNode::Alt3(SignedAtomAlt3 {
                    span: s(start, end),
                    atom: AtomNode::Alt0(AtomAlt0 {
                        span: s(start, end),
                        scientific: ScientificNode {
                            span: s(start, end),
                            scientific_number: tok(TK_SCIENTIFIC_NUMBER, text, start, end),
                        },
                    }),
                }),
            },
        },
    };
}

test "parse simple equation: 1 = 1" {
    let result = calc::parse(&"1 = 1");
    let tree = result.unwrap();
    let expected = EquationNode {
        span: s(0, 5),
        expression: num_expr("1", 0, 1),
        relop: RelopNode::Alt0(RelopAlt0 {
            span: s(2, 3),
            eq: tok(TK_EQ, "=", 2, 3),
        }),
        expression_2: num_expr("1", 4, 5),
        eof: tok(TK_EOF, "", 5, 5),
    };
    assert tree == expected, `AST mismatch for "1 = 1"`;
}

test "parse pi equation: pi = 3" {
    let result = calc::parse(&"pi = 3");
    let tree = result.unwrap();
    let expected = EquationNode {
        span: s(0, 6),
        expression: ExpressionNode {
            span: s(0, 2),
            multiplying_expression: MultiplyingExpressionNode {
                span: s(0, 2),
                pow_expression: PowExpressionNode {
                    span: s(0, 2),
                    signed_atom: SignedAtomNode::Alt3(SignedAtomAlt3 {
                        span: s(0, 2),
                        atom: AtomNode::Alt2(AtomAlt2 {
                            span: s(0, 2),
                            constant: ConstantNode::Alt0(ConstantAlt0 {
                                span: s(0, 2),
                                pi: tok(TK_PI, "pi", 0, 2),
                            }),
                        }),
                    }),
                },
            },
        },
        relop: RelopNode::Alt0(RelopAlt0 {
            span: s(3, 4),
            eq: tok(TK_EQ, "=", 3, 4),
        }),
        expression_2: num_expr("3", 5, 6),
        eof: tok(TK_EOF, "", 6, 6),
    };
    assert tree == expected, `AST mismatch for "pi = 3"`;
}

test "parse function call: sin(0) = 0" {
    let result = calc::parse(&"sin(0) = 0");
    let tree = result.unwrap();
    let expected = EquationNode {
        span: s(0, 10),
        expression: ExpressionNode {
            span: s(0, 6),
            multiplying_expression: MultiplyingExpressionNode {
                span: s(0, 6),
                pow_expression: PowExpressionNode {
                    span: s(0, 6),
                    signed_atom: SignedAtomNode::Alt2(SignedAtomAlt2 {
                        span: s(0, 6),
                        func_: FuncNode {
                            span: s(0, 6),
                            funcname: FuncnameNode::Alt2(FuncnameAlt2 {
                                span: s(0, 3),
                                sin: tok(TK_SIN, "sin", 0, 3),
                            }),
                            lparen: tok(TK_LPAREN, "(", 3, 4),
                            expression: num_expr("0", 4, 5),
                            rparen: tok(TK_RPAREN, ")", 5, 6),
                        },
                    }),
                },
            },
        },
        relop: RelopNode::Alt0(RelopAlt0 {
            span: s(7, 8),
            eq: tok(TK_EQ, "=", 7, 8),
        }),
        expression_2: num_expr("0", 9, 10),
        eof: tok(TK_EOF, "", 10, 10),
    };
    assert tree == expected, `AST mismatch for "sin(0) = 0"`;
}
