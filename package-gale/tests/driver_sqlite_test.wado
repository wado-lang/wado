use sqlite from "./golden/sqlite.wado";
use { CstNode, CstChild } from "./golden/sqlite.wado";

fn unparse_xml(node: &CstNode) -> String {
    let mut out = String::with_capacity(256);
    out.append(`<{node.name}>`);
    for let child of &node.children {
        if let Token(t) = *child {
            for let trivia of &t.leading_trivia {
                out.append(trivia.text);
            }
            let kind_name = sqlite::token_kind_name(t.kind);
            out.append(`<{kind_name}>`);
            out.append(t.text);
            out.append(`</{kind_name}>`);
        } else if let Node(n) = *child {
            out.append(&unparse_xml(n));
        }
    }
    out.append(`</{node.name}>`);
    return out;
}

fn strip_indent(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    let mut at_line_start = true;
    for let c of s.chars() {
        if c == '\n' {
            at_line_start = true;
        } else if at_line_start && (c == ' ' || c == '\t') {
            // skip indentation
        } else {
            at_line_start = false;
            out.append_char(c);
        }
    }
    return out;
}

fn assert_parse_xml(input: &String, expected: &String) {
    let result = sqlite::parse(input);
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
    let root = result.unwrap();
    let tree = sqlite::to_tree(&root);
    let xml = unparse_xml(&tree);
    let expected_stripped = strip_indent(expected);
    assert xml == expected_stripped, `expected: {expected_stripped}\ngot:      {xml}`;
}

test "parse simple SELECT" {
    assert_parse_xml(
        "SELECT 1;",
        "<parse>
            <sql_stmt_list>
                <sql_stmt>
                    <factored_select_stmt>
                        <select_core>
                            <K_SELECT>SELECT</K_SELECT>
                            <result_column>
                                <expr>
                                    <literal_value> <NUMERIC_LITERAL>1</NUMERIC_LITERAL></literal_value>
                                </expr>
                            </result_column>
                        </select_core>
                    </factored_select_stmt>
                </sql_stmt>
            </sql_stmt_list>
            <Eof></Eof>
        </parse>",
    );
}

test "parse CREATE TABLE" {
    assert_parse_xml(
        "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT);",
        "<parse>
            <sql_stmt_list>
                <sql_stmt>
                    <create_table_stmt>
                        <K_CREATE>CREATE</K_CREATE> <K_TABLE>TABLE</K_TABLE>
                        <table_name>
                            <any_name> <IDENTIFIER>t</IDENTIFIER></any_name>
                        </table_name>
                    </create_table_stmt>
                </sql_stmt>
            </sql_stmt_list>
            <Eof></Eof>
        </parse>",
    );
}

test "parse DELETE" {
    assert_parse_xml(
        "DELETE FROM t WHERE id = 1;",
        "<parse>
            <sql_stmt_list>
                <sql_stmt>
                    <delete_stmt>
                        <K_DELETE>DELETE</K_DELETE> <K_FROM>FROM</K_FROM>
                        <qualified_table_name>
                            <table_name>
                                <any_name> <IDENTIFIER>t</IDENTIFIER></any_name>
                            </table_name>
                        </qualified_table_name>
                    </delete_stmt>
                </sql_stmt>
            </sql_stmt_list>
            <Eof></Eof>
        </parse>",
    );
}

test "parse BEGIN" {
    assert_parse_xml(
        "BEGIN;",
        "<parse>
            <sql_stmt_list>
                <sql_stmt>
                    <begin_stmt>
                        <K_BEGIN>BEGIN</K_BEGIN>
                    </begin_stmt>
                </sql_stmt>
            </sql_stmt_list>
            <Eof></Eof>
        </parse>",
    );
}
