    }
}

test "parse EXISTS subquery" {
    let result = sqlite::parse(&"SELECT name FROM users WHERE EXISTS (SELECT 1 FROM orders WHERE orders.user_id = users.id);");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse NOT EXISTS subquery" {
    let result = sqlite::parse(&"SELECT name FROM users WHERE NOT EXISTS (SELECT 1 FROM orders WHERE orders.user_id = users.id);");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

// --- Compound SELECT (UNION, INTERSECT, EXCEPT) ---

test "parse UNION" {
    let result = sqlite::parse(&"SELECT name FROM users UNION SELECT name FROM admins;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

