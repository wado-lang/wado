}

// --- CTE (WITH clause) ---

test "parse CTE" {
    let result = sqlite::parse(&"WITH recent AS (SELECT * FROM orders WHERE date > '2024-01-01') SELECT * FROM recent;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse multiple CTEs" {
    let result = sqlite::parse(&"WITH active_users AS (SELECT id, name FROM users WHERE active = 1), user_orders AS (SELECT user_id, COUNT(*) AS cnt FROM orders GROUP BY user_id) SELECT u.name, o.cnt FROM active_users u JOIN user_orders o ON u.id = o.user_id;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse recursive CTE" {
    let result = sqlite::parse(&"WITH RECURSIVE cnt(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM cnt WHERE x < 100) SELECT x FROM cnt;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

