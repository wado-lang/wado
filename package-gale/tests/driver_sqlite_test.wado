    let result = sqlite::parse(&"SELECT u.*, o.total FROM users u JOIN orders o ON u.id = o.user_id;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

// --- DDL tests ---

test "parse CREATE TABLE with constraints" {
    let result = sqlite::parse(&"CREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, amount REAL DEFAULT 0.0, status TEXT CHECK(status IN ('pending', 'shipped', 'delivered')), UNIQUE(user_id, amount));");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse CREATE TABLE IF NOT EXISTS" {
    let result = sqlite::parse(&"CREATE TABLE IF NOT EXISTS logs (id INTEGER PRIMARY KEY, message TEXT NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP);");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse CREATE TABLE AS SELECT" {
    let result = sqlite::parse(&"CREATE TABLE user_summary AS SELECT user_id, COUNT(*) AS order_count FROM orders GROUP BY user_id;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse CREATE INDEX" {
    let result = sqlite::parse(&"CREATE INDEX idx_users_email ON users(email);");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse CREATE UNIQUE INDEX" {
    let result = sqlite::parse(&"CREATE UNIQUE INDEX IF NOT EXISTS idx_users_name ON users(last_name, first_name);");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse CREATE VIEW" {
    let result = sqlite::parse(&"CREATE VIEW active_users AS SELECT id, name FROM users WHERE active = 1;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse CREATE TRIGGER" {
    let result = sqlite::parse(&"CREATE TRIGGER update_timestamp AFTER UPDATE ON users FOR EACH ROW BEGIN UPDATE users SET updated_at = CURRENT_TIMESTAMP WHERE id = 1; END;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse ALTER TABLE RENAME" {
    let result = sqlite::parse(&"ALTER TABLE users RENAME TO customers;");
