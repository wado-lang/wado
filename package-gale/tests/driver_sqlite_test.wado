// COUNT(*) and WHERE clause require function calls and binary expr (left-recursive), not yet supported
#[TODO]
test "parse complex SELECT" {
    let result = sqlite::parse(&"SELECT COUNT(*), name FROM users WHERE age > 18 GROUP BY name HAVING COUNT(*) > 1 ORDER BY name ASC LIMIT 10;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse SELECT with alias" {
    let result = sqlite::parse(&"SELECT id AS user_id, name AS user_name FROM users;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse multiple statements" {
    let result = sqlite::parse(&"SELECT 1; SELECT 2;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}
