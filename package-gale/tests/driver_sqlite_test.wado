    let result = sqlite::parse(&"SELECT id FROM t1 UNION ALL SELECT id FROM t2 ORDER BY id;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse INTERSECT" {
    let result = sqlite::parse(&"SELECT id FROM t1 INTERSECT SELECT id FROM t2;");
