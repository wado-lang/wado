// --- JOIN tests ---

test "parse INNER JOIN" {
    let result = sqlite::parse(&"SELECT u.name, o.total FROM users u INNER JOIN orders o ON u.id = o.user_id;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse LEFT JOIN" {
    let result = sqlite::parse(&"SELECT u.name, o.total FROM users u LEFT JOIN orders o ON u.id = o.user_id;");
