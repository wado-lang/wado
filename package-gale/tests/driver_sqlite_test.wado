        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

test "parse multiple JOINs" {
    let result = sqlite::parse(&"SELECT u.name, o.id, p.name FROM users u INNER JOIN orders o ON u.id = o.user_id LEFT JOIN products p ON o.product_id = p.id;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

