}

test "parse GROUP BY with HAVING" {
    let result = sqlite::parse(&"SELECT category, COUNT(*) AS cnt, AVG(price) AS avg_price FROM products GROUP BY category HAVING COUNT(*) > 3;");
    if let Err(e) = &result {
        panic(`parse failed: {e.message} at {e.span.start}..{e.span.end}`);
    }
}

