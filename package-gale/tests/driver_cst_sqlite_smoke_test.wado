//! Stage 2b: the SQLite ATN-class grammar parses homogeneously end-to-end.
use sqlite from "./grammars/SQLite.g4"
    with { generator: { module: "../src/generator.wado",
        options: { highlight: false, homogeneous: true },
        output_dir: "tests/generated/cst_sqlite" } };

test "sqlite: SELECT parses clean" {
    let r = sqlite::parse(&"SELECT 1;");
    assert r.ok(), `unexpected diagnostics`;
}
test "sqlite: CREATE TABLE parses clean" {
    let r = sqlite::parse(&"CREATE TABLE t (a INTEGER, b TEXT);");
    assert r.ok(), `unexpected diagnostics`;
}
