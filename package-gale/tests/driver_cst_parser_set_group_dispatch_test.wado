//! Stage 2b migration: a token-only set group `(b | c)` must kind-check before
//! consuming, accepting members and rejecting non-members (the
//! emitter records a diagnostic and fails soft).

use g from "./grammars/parser_set_group_dispatch.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_parser_set_group_dispatch" },
    };

test "set-group: accepts 'a b d'" {
    assert g::parse(&"a b d").ok();
}
test "set-group: accepts 'a c d'" {
    assert g::parse(&"a c d").ok();
}
test "set-group: rejects a non-member token" {
    assert g::parse(&"a x d").has_errors();
}
test "set-group: rejects EOF in place of the set" {
    assert g::parse(&"a").has_errors();
}
