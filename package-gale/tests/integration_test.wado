use { generate, GenerateOptions } from "../src/generator.wado";
use { parse } from "../src/g4/parser.wado";
use { Grammar, merge_grammars } from "../src/ir.wado";

global DEFAULT_OPTIONS: GenerateOptions = GenerateOptions { highlight: false };

/// Parse a `.g4` source and attach the given path as a source-file entry so
/// that `gen_header` emits the same provenance metadata as the
/// `update-gale-golden` task. Both sides must agree byte-for-byte on the
/// `#![generated(by = "gale", sources = [...])]` header, which is why the
/// tests must thread the path through explicitly rather than letting
/// `gen_header` fall back to `{name}.g4`.
fn parse_grammar(input: String, path: String) -> Grammar {
    let mut g = parse(input).unwrap();
    g.source_files.push(path);
    return g;
}

test "generate json golden" {
    let grammar = parse_grammar(
        #include_str("./grammars/JSON.g4"),
        "package-gale/tests/grammars/JSON.g4",
    );
    let output = generate(&grammar, &DEFAULT_OPTIONS);
    let expected = #include_str("./golden/json.wado");
    assert output == expected, `golden mismatch:\n---actual (len={output.len()})---\n{output}\n---expected (len={expected.len()})---\n{expected}`;
}

