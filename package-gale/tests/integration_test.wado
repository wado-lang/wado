use { generate, GenerateOptions } from "../src/generator.wado";
use { parse } from "../src/g4/parser.wado";
use { merge_grammars } from "../src/ir.wado";

global DEFAULT_OPTIONS: GenerateOptions = GenerateOptions { highlight: false };

test "generate json golden" {
    let input = #include_str("./grammars/JSON.g4");
    let grammar = parse(input).unwrap();
    let output = generate(&grammar, &DEFAULT_OPTIONS);
    let expected = #include_str("./golden/json.wado");
    assert output == expected, `golden mismatch:\n---actual (len={output.len()})---\n{output}\n---expected (len={expected.len()})---\n{expected}`;
}

