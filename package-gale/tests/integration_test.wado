#[timeout_ms(90000)]
test "generate sqlite golden" {
    let grammar = parse_grammar(
        #include_str("./grammars/SQLite.g4"),
        "package-gale/tests/grammars/SQLite.g4",
    );
    let output = generate(&grammar, &DEFAULT_OPTIONS);
    let expected = #include_str("./golden/sqlite.wado");
    assert output == expected, `golden mismatch:\n---actual (len={output.len()})---\n{output}\n---expected (len={expected.len()})---\n{expected}`;
}

#[timeout_ms(30000)]
test "generate html golden" {
    let lexer_g = parse_grammar(
        #include_str("./grammars/HTMLLexer.g4"),
        "package-gale/tests/grammars/HTMLLexer.g4",
    );
    let parser_g = parse_grammar(
        #include_str("./grammars/HTMLParser.g4"),
        "package-gale/tests/grammars/HTMLParser.g4",
    );
    let grammar = merge_grammars([lexer_g, parser_g]);
    let output = generate(&grammar, &DEFAULT_OPTIONS);
    let expected = #include_str("./golden/html.wado");
    assert output == expected, `HTML golden mismatch:\n---actual (len={output.len()})---\n{output}\n---expected (len={expected.len()})---\n{expected}`;
}
