use g from "./grammars/ll_empty_alt_group.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/cst_ll_empty_alt_group",
        },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for {*input}`;
    let actual = g::to_string_tree(&result);
    assert actual == *expected, `\ninput:    {*input}\nexpected: {*expected}\nactual:   {actual}`;
}

// Sanity: a lone if with a trailing else must consume it.
test "tree: single if with trailing else binds" {
    assert_tree(&"if y x else x", &"(start (statement (ifStatement if y (statement x) else (statement x))))");
}

// Dangling-`else`: empty-first group prefers to skip, so the `else`
// binds to the OUTER ifStatement.
test "tree: dangling else binds to the outer if (empty-alt group)" {
    assert_tree(
        &"if y if y x else x",
        &"(start (statement (ifStatement if y (statement (ifStatement if y (statement x))) else (statement x))))",
    );
}
