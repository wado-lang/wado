//! A repeat over a repeat is a shape lowering cannot name. Both ways of
//! producing one — parentheses around a repeating body, and the fold of
//! `( X | )` — collapse to the plain closure, and the collapse has to keep
//! the language: zero repetitions stay legal, and so do many.
//!
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use nr from "./grammars/nested_repeat.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_nested_repeat" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = nr::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}`;
    let actual = nr::to_string_tree(&result);
    assert actual == *expected, `\ninput:    ${*input}\nexpected: ${*expected}\nactual:   ${actual}`;
}

test "nested-repeat: `(X*)?` takes none and takes many" {
    assert_tree(&"p b", &"(s p b)");
    assert_tree(&"p a a b", &"(s p a a b)");
}

test "nested-repeat: `(X+)?` is a closure, so none is legal" {
    assert_tree(&"q b", &"(s q b)");
    assert_tree(&"q a a b", &"(s q a a b)");
}

test "nested-repeat: the folded `( X* | )` collapses the same way" {
    assert_tree(&"r b", &"(s r b)");
    assert_tree(&"r a a b", &"(s r a a b)");
}
