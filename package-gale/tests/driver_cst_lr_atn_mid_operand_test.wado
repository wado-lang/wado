//! Both `between` shapes in one LR rule. The atom makes the loop entry
//! ATN-class, so the simulator, not the static continuation gate, decides how
//! far the LR alternative's `expr[0]` operand climbs as well.
//! Expected trees are the published ANTLR4 jar's (black-box oracle).

use g from "./grammars/lr_atn_mid_operand.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_lr_atn_mid_operand" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input}: ${g::to_string_tree(&result)}`;
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input}\nexpected: ${expected}\nactual:   ${actual}`;
}

test "the between atom keeps its own and" {
    assert_tree("between a and b ;", "(stat (expr between (expr a) and (expr b)) ;)");
}

test "binary and chains left-associatively" {
    assert_tree("a and b and c ;", "(stat (expr (expr (expr a) and (expr b)) and (expr c)) ;)");
}

test "the mid operand stops at the enclosing and" {
    assert_tree("a between b and c ;", "(stat (expr (expr a) between (expr b) and (expr c)) ;)");
}

test "the mid operand climbs the shared and when one is left over" {
    assert_tree(
        "a between b and c and d ;",
        "(stat (expr (expr a) between (expr (expr b) and (expr c)) and (expr d)) ;)",
    );
    assert_tree(
        "a between b and c and d and e ;",
        "(stat (expr (expr a) between (expr (expr (expr b) and (expr c)) and (expr d)) and (expr e)) ;)",
    );
}

test "the atom's first operand climbs the shared and when one is left over" {
    assert_tree(
        "between a and b and c ;",
        "(stat (expr between (expr (expr a) and (expr b)) and (expr c)) ;)",
    );
}

test "an and after a nested between goes to the outer between" {
    assert_tree(
        "a between b and c and d between e and f ;",
        "(stat (expr (expr (expr a) between (expr (expr b) and (expr c)) and (expr d)) between (expr e) and (expr f)) ;)",
    );
    assert_tree(
        "a between b and between c and d and e ;",
        "(stat (expr (expr a) between (expr (expr b) and (expr between (expr c) and (expr d))) and (expr e)) ;)",
    );
    assert_tree(
        "a between b and c between d and e and f ;",
        "(stat (expr (expr a) between (expr (expr (expr b) and (expr c)) between (expr d) and (expr e)) and (expr f)) ;)",
    );
    assert_tree(
        "a and b between c and d and e ;",
        "(stat (expr (expr (expr a) and (expr b)) between (expr (expr c) and (expr d)) and (expr e)) ;)",
    );
    assert_tree(
        "a between between b and c and d and e ;",
        "(stat (expr (expr a) between (expr between (expr (expr b) and (expr c)) and (expr d)) and (expr e)) ;)",
    );
    assert_tree(
        "between a and b between c and d and e ;",
        "(stat (expr between (expr (expr (expr a) and (expr b)) between (expr c) and (expr d)) and (expr e)) ;)",
    );
}
