//! White-box tests for `parser_gen` emitters that are unreachable
//! through the public `generate()` API today but guard latent codegen
//! hazards.

use { gen_alt_scan_fn } from "../src/parser_gen.wado";
use { EmitContext } from "../src/emit_context.wado";
use { GrammarAnalysis } from "../src/grammar_analysis.wado";
use { GenSettings } from "../src/gen_settings.wado";
use { RuleFollow } from "../src/follow_env.wado";
use { TableRegistry } from "../src/table_registry.wado";
use { ParserPlan } from "../src/parser_plan.wado";
use { decision_predicates } from "../src/gate_conditions.wado";
use { Alternative, ParserRule, Visibility } from "../src/ir.wado";
use { CodeWriter } from "wado-lang:wadopoet";
use {
    Diagnostics,
    RuleHeader,
    ScanBody,
    ScanElement,
    ScanTokenElement,
    ScanRuleCallElement,
    FollowArg,
} from "../src/gir.wado";

/// `r` is registered left-recursive: only then does `scan_r` take `min_prec`.
/// Its two alternatives keep its scan a call rather than an inlined token test.
/// It is current, as the scan emit loop makes each rule before walking it.
fn lr_ctx() -> EmitContext {
    let rules: List<ParserRule> = [
        ParserRule::new("r", Visibility::Default, [], [
            Alternative::new([]),
            Alternative::new([]),
        ]),
    ];
    let mut plan = ParserPlan::unmarked(rules.len());
    plan.lr_rule_snakes.insert("r");
    let mut analysis = GrammarAnalysis::new(&rules);
    let decisions = decision_predicates(&GenSettings {}, &mut analysis);
    let header = RuleHeader {
        name: "r",
        snake_name: "r",
        field_name: "r",
        type_name: "RNode",
        visibility: Visibility::Default,
        case_names: [],
        alt_labels: [null, null],
    };
    let mut ctx = EmitContext::new(
        [header],
        analysis,
        GenSettings {},
        RuleFollow::unknown(),
        TableRegistry::new(),
        Diagnostics {},
        plan,
        decisions,
    );
    ctx.cursor.set_current_rule_index(0);
    return ctx;
}

fn self_ref_call(min_prec_arg: Option<i32>) -> ScanElement {
    return ScanElement::RuleCall(ScanRuleCallElement {
        target_snake: "r",
        follow_arg: FollowArg::NoFollow,
        min_prec_arg,
    });
}

// The alt scan reads the precedence lowering stamped and nothing else: a
// trailing self-ref is not special, so a prefix operand climbs exactly as
// far as its parse twin.
test "alt-scan passes a self-ref's stamped min_prec verbatim" {
    let mut ctx = lr_ctx();
    let mut w = CodeWriter::new();
    let names: List<String> = ["TK_X"];
    let x = ctx.analysis.token_ids_of(&names)[0];
    let elements: List<ScanElement> = [
        ScanElement::Token(ScanTokenElement { kind: x }),
        self_ref_call(null),
        self_ref_call(Option::Some(15)),
    ];
    gen_alt_scan_fn(&mut w, "scan_r_alt_0", &ScanBody { elements, gates: [], gate_cond: "" }, 0, &mut ctx);
    let out = w.to_string();

    assert out.contains("scan_r(tokens, pos, 0)"), "an unstamped self-ref climbs from 0";
    assert out.contains("scan_r(tokens, pos, 15)"), "a stamped self-ref climbs from its stamp";
}
