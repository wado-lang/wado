//! sink_v2 parity on the caller-FOLLOW gate: a tail-greedy Repeat yields its
//! trailing token to the caller's continuation (runtime follow_yields).

use g from "./grammars/follow_gate.g4"
    with { generator: { module: "../src/generator.wado", options: { highlight: false, homogeneous: true, sink_v2: true }, output_dir: "tests/generated/cst_v2_follow" } };
test "v2-follow: a yields its trailing Y to r" {
    let result = g::parse(&"X Y");
    assert result.ok(), `unexpected diagnostics`;
    let actual = g::to_string_tree(&result);
    assert actual == "(r (a X) Y)", `actual: {actual}`;
}
