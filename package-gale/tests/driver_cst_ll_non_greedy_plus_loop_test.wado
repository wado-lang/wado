//! A non-greedy `+?` iterates as long as exiting would strand the
//! continuation. Expected trees are the published ANTLR4 jar's (black-box
//! oracle).
//!
//! No lookahead separates the body from the continuation, so each iteration
//! decides by scanning the continuation: exiting wins only when the rest of
//! the alt still matches from here.

use g from "./grammars/ll_non_greedy_plus_loop.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_non_greedy_plus_loop" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}: ${g::to_string_tree(&result)}`;
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "non-greedy plus takes the minimum when the continuation fits" {
    assert_tree(&"a a", &"(s (x a) (y a))");
}

test "non-greedy plus iterates when exiting would strand the continuation" {
    assert_tree(&"a a a", &"(s (x a) (x a) (y a))");
}

test "non-greedy plus iterates as far as needed" {
    assert_tree(&"a a a a", &"(s (x a) (x a) (x a) (y a))");
}
