use json from "./grammars/JSON.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/json",
        },
    };
use { CstNode, CstChild, normalize_tree } from "./grammars/JSON.g4";

fn assert_tree(input: &String, expected: &String) {
    let root = json::parse(input).unwrap();
    let tree = json::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

/// Unparse a CstNode tree to XML-tagged text.
/// Non-trivia tokens are wrapped in <KIND>text</KIND> tags.
/// Trivia (whitespace, comments) in leading_trivia is emitted as-is.
fn unparse_xml(node: &CstNode) -> String {
    let mut out = String::with_capacity(256);
    out.push_str(`<{node.name}>`);
    for let child of &node.children {
        if let Token(t) = *child {
            for let trivia of &t.leading_trivia {
                trivia.text.push_to(&mut out);
            }
            let kind_name = json::token_kind_name(t.kind);
            out.push_str(`<{kind_name}>`);
            t.text.push_to(&mut out);
            out.push_str(`</{kind_name}>`);
        } else if let Node(n) = *child {
            out.push_str(unparse_xml(n));
        }
    }
    out.push_str(`</{node.name}>`);
    return out;
}

test "tokenize number" {
    let tokens = json::tokenize(&"42");
    assert tokens.len() >= 1, `expected at least 1 token, got {tokens.len()}`;
}

test "parse number" {
    let result = json::parse(&"42");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse string" {
    let result = json::parse(&"\"hello\"");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse empty object" {
    let result = json::parse(&"{}");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse empty array" {
    let result = json::parse(&"[]");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse object" {
    let result = json::parse(&"{\"key\": \"value\"}");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse array" {
    let result = json::parse(&"[1, 2, 3]");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse nested" {
    let result = json::parse(&"{\"a\": [1, true, null]}");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "to_tree produces CstNode" {
    let root = json::parse(&"42").unwrap();
    let tree = json::to_tree(&root);
    assert tree.name == "json";
    assert tree.children.len() == 2;  // value + eof
}

test "unparse_xml for number" {
    let root = json::parse(&"42").unwrap();
    let tree = json::to_tree(&root);
    let xml = unparse_xml(&tree);
    let expected = "<json><value><NUMBER>42</NUMBER></value><Eof></Eof></json>";
    assert xml == expected, `got: {xml}`;
}

test "unparse_xml preserves whitespace" {
    let root = json::parse(&" 42 ").unwrap();
    let tree = json::to_tree(&root);
    let xml = unparse_xml(&tree);
    let expected = "<json><value> <NUMBER>42</NUMBER></value> <Eof></Eof></json>";
    assert xml == expected, `got: {xml}`;
}

test "unparse_xml for string" {
    let root = json::parse(&"\"hello\"").unwrap();
    let tree = json::to_tree(&root);
    let xml = unparse_xml(&tree);
    let expected = "<json><value><STRING>\"hello\"</STRING></value><Eof></Eof></json>";
    assert xml == expected, `got: {xml}`;
}

test "unparse_xml for object with multiple pairs" {
    let root = json::parse(&"{\"a\":1,\"b\":2}").unwrap();
    let tree = json::to_tree(&root);
    let xml = unparse_xml(&tree);
    // The key test: commas and subsequent pairs must appear in the CST
    assert xml.len() > 0, "empty xml";
    let has_b = false;
    for let c of xml.chars() {
        // Check that the string contains "b" key
    }
    // Full expected output: both pairs and comma separator must be in the tree
    let expected = "<json><value><obj><TK_LIT_LBRACE>{</TK_LIT_LBRACE><pair><STRING>\"a\"</STRING><TK_LIT_COLON>:</TK_LIT_COLON><value><NUMBER>1</NUMBER></value></pair><TK_LIT_COMMA>,</TK_LIT_COMMA><pair><STRING>\"b\"</STRING><TK_LIT_COLON>:</TK_LIT_COLON><value><NUMBER>2</NUMBER></value></pair><TK_LIT_RBRACE>}</TK_LIT_RBRACE></obj></value><Eof></Eof></json>";
    assert xml == expected, `\nexpected: {expected}\ngot:      {xml}`;
}

test "unparse_xml for array with multiple values" {
    let root = json::parse(&"[1,2,3]").unwrap();
    let tree = json::to_tree(&root);
    let xml = unparse_xml(&tree);
    // All values and comma separators must appear
    let expected = "<json><value><arr><TK_LIT_LBRACKET>[</TK_LIT_LBRACKET><value><NUMBER>1</NUMBER></value><TK_LIT_COMMA>,</TK_LIT_COMMA><value><NUMBER>2</NUMBER></value><TK_LIT_COMMA>,</TK_LIT_COMMA><value><NUMBER>3</NUMBER></value><TK_LIT_RBRACKET>]</TK_LIT_RBRACKET></arr></value><Eof></Eof></json>";
    assert xml == expected, `\nexpected: {expected}\ngot:      {xml}`;
}

// --- S-expression tree tests ---

test "tree: true false null" {
    assert_tree(&"true", &"(json (value true))");
    assert_tree(&"false", &"(json (value false))");
    assert_tree(&"null", &"(json (value null))");
}

test "tree: nested object with array" {
    assert_tree(&"{\"a\":[1,true,null]}", &"
        (json
          (value
            (obj
              { (pair \"a\"
                  : (value
                      (arr [ (value 1) , (value true) , (value null) ])))
              })))
    ");
}

test "tree: multiple nested objects" {
    assert_tree(&"{\"x\":{\"y\":1},\"z\":2}", &"
        (json
          (value
            (obj
              { (pair \"x\"
                  : (value
                      (obj { (pair \"y\" : (value 1)) })))
              , (pair \"z\" : (value 2))
              })))
    ");
}

test "tree: string with escapes" {
    assert_tree(&"\"hello\\nworld\"", &"
        (json (value \"hello\\nworld\"))
    ");
}

test "tree: negative number" {
    assert_tree(&"-42", &"(json (value -42))");
}

test "tree: float with exponent" {
    assert_tree(&"1.5e10", &"(json (value 1.5e10))");
}
