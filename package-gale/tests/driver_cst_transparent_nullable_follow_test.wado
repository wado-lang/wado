//! A transparent wrapper adds nothing between the group it holds and the
//! alternative around it, so a nullable alternative inside still reaches the
//! outer follow set.
//!
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use tnf from "./grammars/transparent_nullable_follow.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_transparent_nullable_follow" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = tnf::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = tnf::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "transparent nullable: each alternative's own first set selects it" {
    assert_tree(&"a c", &"(s a c)");
    assert_tree(&"b c", &"(s b c)");
}

test "transparent nullable: the follow set survives the wrapper" {
    assert_tree(&"c", &"(s c)");
}
