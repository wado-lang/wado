//! Stage 2b migration: a multi-token tail-greedy Repeat that must yield its
//! trailing tokens to the caller's continuation via the runtime FOLLOW gate.

use g from "./grammars/ll_multi_token_tail.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/cst_ll_multi_token_tail",
        },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for {*input}`;
    let actual = g::to_string_tree(&result);
    assert actual == *expected, `\ninput:    {*input}\nexpected: {*expected}\nactual:   {actual}`;
}

test "multi-token-tail: yields the caller prefix" { assert_tree(&"N X Y X Y Z", &"(r (a N X Y) (c X Y Z))"); }
test "multi-token-tail: yields on the exposing iter" { assert_tree(&"N X Y X Y X Y Z", &"(r (a N X Y X Y) (c X Y Z))"); }
