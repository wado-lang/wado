//! Stage 2b migration: a multi-token tail-greedy Repeat that must yield its
//! trailing tokens to the caller's continuation via the runtime FOLLOW gate.

use g from "./grammars/ll_multi_token_tail.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_multi_token_tail" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "multi-token-tail: yields the caller prefix" {
    assert_tree(&"N X Y X Y Z", &"(r (a N X Y) (c X Y Z))");
}
test "multi-token-tail: yields on the exposing iter" {
    assert_tree(&"N X Y X Y X Y Z", &"(r (a N X Y X Y) (c X Y Z))");
}
