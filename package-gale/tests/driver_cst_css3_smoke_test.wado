//! Stage 2b: the css3 ATN-class grammar parses homogeneously end-to-end.
use css3 from "./grammars/css3Lexer.g4"
    with { generator: { module: "../src/generator.wado",
        inputs: ["./grammars/css3Parser.g4"],
        options: { highlight: false, homogeneous: true },
        output_dir: "tests/generated/cst_css3" } };

test "css3: simple rule parses clean" {
    let r = css3::parse(&"body { color: red; }");
    assert r.ok(), `unexpected diagnostics`;
}
test "css3: multiple properties parse clean" {
    let r = css3::parse(&"h1 { font-size: 16px; margin: 0; }");
    assert r.ok(), `unexpected diagnostics`;
}
