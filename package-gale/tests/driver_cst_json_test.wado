//! Stage 2 on a real grammar: JSON via the emitter.

use json from "./grammars/JSON.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_json" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = json::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = json::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "json: number" {
    assert_tree(&"42", &"(json (value 42))");
}

test "json: nested object with array" {
    assert_tree(
        &"{\"a\":[1,true,null]}",
        &"(json (value (obj { (pair \"a\" : (value (arr [ (value 1) , (value true) , (value null) ]))) })))",
    );
}

test "json: empty object" {
    assert_tree(&"{}", &"(json (value (obj { })))");
}
