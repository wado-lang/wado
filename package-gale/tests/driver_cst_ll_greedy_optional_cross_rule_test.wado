//! A greedy `?` competing with an identical one in the caller.
//!
//! `ifExpr` ends with `('else' block)?` and so does the enclosing `stmt`.
//! ANTLR4 favours the innermost, so `if z { 1 } else { 2 } / 3` is one
//! expression. Regression for the runtime caller-FOLLOW yield gate: it fired
//! on a 1-deep mask — `stmt`'s own `('else' block)?` halted the walk — and
//! `ifExpr` yielded, leaving nothing to parse the `/`.
//!
//! Greediness is not the discriminator, viability is. `driver_cst_ll_basic_test`
//! pins `r : (a b | a) EOF ; a : X Y? ; b : Y ;`, where ANTLR4 *does* yield the
//! `Y`: there the mask spans the caller's whole suffix. A mask that stops short
//! is not evidence, and is no longer threaded.
//!
//! `driver_cst_ll_empty_alt_group_test` pins `('else' block |)` and
//! `driver_cst_lr_dangling_else_test` the non-greedy `??`.

use g from "./grammars/ll_greedy_optional_cross_rule.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_greedy_optional_cross_rule" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}: ${result.diagnostics:?}`;
    let actual = g::to_string_tree(&result);
    assert actual == *expected, `\ninput:    ${*input}\nexpected: ${*expected}\nactual:   ${actual}`;
}

// Control: with no inner `if`, the `else` is unambiguously the statement's.
test "the statement claims an else it alone can take" {
    assert_tree(&"let e = 1 else { 2 } ;", &"(prog (stmt let e = (expression 1) else (block { 2 }) ;))");
}

test "the inner if claims the else, and the chain continues" {
    assert_tree(
        &"let e = if z { 1 } else { 2 } / 3 ;",
        &"(prog (stmt let e = (expression (expression (ifExpr if z (block { 1 }) else (block { 2 }))) / (expression 3)) ;))",
    );
}

test "the inner if claims the else with nothing after it" {
    assert_tree(
        &"let e = if z { 1 } else { 2 } ;",
        &"(prog (stmt let e = (expression (ifExpr if z (block { 1 }) else (block { 2 }))) ;))",
    );
}

test "two elses: the inner if takes the first, the statement the second" {
    assert_tree(
        &"let e = if z { 1 } else { 2 } else { 3 } ;",
        &"(prog (stmt let e = (expression (ifExpr if z (block { 1 }) else (block { 2 }))) else (block { 3 }) ;))",
    );
}
