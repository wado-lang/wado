use sqlite from "./grammars/SQLite.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "./generated/cst_sqlite",
        },
    };
use { log_stdout } from "core:cli";

test "parse create table single col" {
    let r = sqlite::parse(&"CREATE TABLE t (a INTEGER);");
    if !r.ok() {
        log_stdout(`Error: {r.diagnostics[0].message}`);
    }
    assert r.ok(), "unexpected diagnostics";
}

test "parse create table as select" {
    let r = sqlite::parse(&"CREATE TABLE t AS SELECT 1;");
    if !r.ok() {
        log_stdout(`Error: {r.diagnostics[0].message}`);
    }
    assert r.ok(), "unexpected diagnostics";
}

test "parse create table multi column with constraint" {
    let r = sqlite::parse(&"CREATE TABLE users (id INTEGER, name TEXT, PRIMARY KEY (id));");
    if !r.ok() {
        log_stdout(`Error: {r.diagnostics[0].message}`);
    }
    assert r.ok(), "unexpected diagnostics";
}

test "parse select" {
    let r = sqlite::parse(&"SELECT 1;");
    assert r.ok(), "unexpected diagnostics";
}
