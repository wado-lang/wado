//! Stage C lexer `set_type` action: `A : 'a' { lx.set_type(TK_B) }` retypes the
//! emitted token, so the parser sees a `B` where the lexer matched `A`. The
//! action runs only for the winning rule at tournament commit — a losing
//! candidate never mutates the outcome. The Wado analog of ANTLR's lexer
//! `setType`.

use lst from "./grammars/wado_lex_set_type.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/action_lex_set_type" },
    };

test "a lexer set_type action retypes the emitted token" {
    // 'a' matches rule A, whose action retypes it to B; the parser reports B.
    let retyped = lst::parse(&"a");
    assert retyped.ok(), "clean parse of 'a'";
    assert retyped.output == "B", `output: '${retyped.output}'`;

    // 'b' matches B directly — no action, plain B.
    let plain = lst::parse(&"b");
    assert plain.ok(), "clean parse of 'b'";
    assert plain.output == "B", `output: '${plain.output}'`;
}
