use html from "./grammars/HTMLLexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["./grammars/HTMLParser.g4"],
            options: { highlight: false },
            output_dir: "tests/generated/html",
        },
    };
use { CstNode, CstChild, normalize_tree } from "./grammars/HTMLLexer.g4";
use { TK_TAG_WHITESPACE, TK_TAG_NAME } from "./grammars/HTMLLexer.g4";

fn assert_tree(input: &String, expected: &String) {
    let root = html::parse(input).unwrap();
    let tree = html::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

/// Unparse a CstNode tree to XML-tagged text.
fn unparse_xml(node: &CstNode) -> String {
    let mut out = String::with_capacity(256);
    out.push_str(&`<{node.name}>`);
    for let child of &node.children {
        if let Token(t) = *child {
            for let trivia of &t.leading_trivia {
                trivia.text.push_to(&mut out);
            }
            let kind_name = html::token_kind_name(t.kind);
            out.push_str(&`<{kind_name}>`);
            t.text.push_to(&mut out);
            out.push_str(&`</{kind_name}>`);
        } else if let Node(n) = *child {
            out.push_str(&unparse_xml(&n));
        }
    }
    out.push_str(&`</{node.name}>`);
    return out;
}

test "tokenize simple html" {
    let tokens = html::tokenize(&"<p>hello</p>");
    assert tokens.len() >= 3, `expected at least 3 tokens, got {tokens.len()}`;
}

test "parse simple tag" {
    let result = html::parse(&"<p>hello</p>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse self-closing tag" {
    let result = html::parse(&"<br/>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse nested tags" {
    let result = html::parse(&"<div><p>hello</p></div>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse with attributes" {
    let result = html::parse(&"<a href=\"url\">link</a>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "to_tree produces CstNode" {
    let root = html::parse(&"<p>hello</p>").unwrap();
    let tree = html::to_tree(&root);
    assert tree.name == "htmlDocument";
    assert tree.children.len() > 0;
}

test "unparse_xml for simple tag" {
    let root = html::parse(&"<p>hello</p>").unwrap();
    let tree = html::to_tree(&root);
    let xml = unparse_xml(&tree);
    assert xml.len() > 0, "empty xml";
    // Verify the XML contains the key elements
    assert xml.len() > 20, `xml too short: {xml}`;
}


test "tree: simple tag" {
    assert_tree(&"<p>hello</p>", &"
        (htmlDocument
          (htmlElements
            (htmlElement < p >
              (htmlContent
                (htmlChardata hello))
              < / p >)))
    ");
}

test "tree: self-closing tag" {
    assert_tree(&"<br/>", &"
        (htmlDocument
          (htmlElements
            (htmlElement < br />)))
    ");
}

test "tree: tag with attributes" {
    assert_tree(&"<img src=\"a.png\" alt=\"pic\"/>", &"
        (htmlDocument
          (htmlElements
            (htmlElement < img
              (htmlAttribute src = \"a.png\")
              (htmlAttribute alt = \"pic\")
              />)))
    ");
}

test "tree: nested tags" {
    assert_tree(&"<div class=\"main\"><p>text</p></div>", &"
        (htmlDocument
          (htmlElements
            (htmlElement < div
              (htmlAttribute class = \"main\")
              >
              (htmlContent
                (htmlElement < p >
                  (htmlContent
                    (htmlChardata text))
                  < / p >))
              < / div >)))
    ");
}

//
// HTMLLexer declares `TAG_WHITESPACE : [ \t\r\n] -> channel(HIDDEN)`. ANTLR4
// routes HIDDEN tokens to a separate channel so the parser never sees them,
// but they are NOT discarded — they remain available for downstream tools
// (highlighters, formatters). Gale attaches them to the following token's
// `leading_trivia` array with `channel == 1` (the predefined HIDDEN channel
// id).
//
// This test exercises the full pipeline:
//   1. Whitespace between the tag name and an attribute must NOT appear as
//      its own entry in the `tokens` array.
//   2. The whitespace must appear in the next token's `leading_trivia`.
//   3. The trivia Token's `channel` field must be 1 (HIDDEN), not 0.
test "HIDDEN channel: TAG_WHITESPACE routed to trivia" {
    let tokens = html::tokenize(&"<p class=\"x\">");
    // No main-channel token may have kind TAG_WHITESPACE — HIDDEN tokens
    // are hidden from the parser.
    for let t of &tokens {
        assert t.kind != TK_TAG_WHITESPACE, "TAG_WHITESPACE leaked into main token stream";
    }
    // After `<p` the next non-hidden token is the TAG_NAME `class`; the
    // space between `p` and `class` must show up in its leading_trivia.
    // (The first TAG_NAME is `p`; we want the second.)
    let mut tag_name_count = 0;
    let mut found_hidden_ws = false;
    for let t of &tokens {
        if t.kind == TK_TAG_NAME {
            tag_name_count += 1;
            if tag_name_count == 2 {
                for let trivia of &t.leading_trivia {
                    if trivia.kind == TK_TAG_WHITESPACE {
                        assert trivia.channel == 1, `expected HIDDEN channel 1, got {trivia.channel}`;
                        found_hidden_ws = true;
                    }
                }
            }
        }
    }
    assert tag_name_count >= 2, `expected >=2 TAG_NAME tokens, got {tag_name_count}`;
    assert found_hidden_ws, "TAG_WHITESPACE trivia not found on second TAG_NAME token";
}

test "HIDDEN channel: parser accepts whitespace-separated attributes" {
    // End-to-end: the parser must not see TAG_WHITESPACE at all, so
    // `<img src="a" alt="b"/>` must parse successfully even though the
    // whitespace between attributes would be a stray token without the
    // HIDDEN routing.
    let result = html::parse(&"<img src=\"a\" alt=\"b\"/>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}
