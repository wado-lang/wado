use html from "./golden/html.wado";
use { CstNode, CstChild } from "./golden/html.wado";

/// Unparse a CstNode tree to XML-tagged text.
fn unparse_xml(node: &CstNode) -> String {
    let mut out = String::with_capacity(256);
    out.push_str(`<{node.name}>`);
    for let child of &node.children {
        if let Token(t) = *child {
            for let trivia of &t.leading_trivia {
                out.push_str(trivia.text);
            }
            let kind_name = html::token_kind_name(t.kind);
            out.push_str(`<{kind_name}>`);
            out.push_str(t.text);
            out.push_str(`</{kind_name}>`);
        } else if let Node(n) = *child {
            out.push_str(&unparse_xml(n));
        }
    }
    out.push_str(`</{node.name}>`);
    return out;
}

test "tokenize simple html" {
    let tokens = html::tokenize(&"<p>hello</p>");
    assert tokens.len() >= 3, `expected at least 3 tokens, got {tokens.len()}`;
}

test "parse simple tag" {
    let result = html::parse(&"<p>hello</p>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse self-closing tag" {
    let result = html::parse(&"<br/>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse nested tags" {
    let result = html::parse(&"<div><p>hello</p></div>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "parse with attributes" {
    let result = html::parse(&"<a href=\"url\">link</a>");
    if let Err(e) = &result {
        panic(`parse failed: {e.message}`);
    }
}

test "to_tree produces CstNode" {
    let root = html::parse(&"<p>hello</p>").unwrap();
    let tree = html::to_tree(&root);
    assert tree.name == "htmlDocument";
    assert tree.children.len() > 0;
}

test "unparse_xml for simple tag" {
    let root = html::parse(&"<p>hello</p>").unwrap();
    let tree = html::to_tree(&root);
    let xml = unparse_xml(&tree);
    assert xml.len() > 0, "empty xml";
    // Verify the XML contains the key elements
    assert xml.len() > 20, `xml too short: {xml}`;
}
