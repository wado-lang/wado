use lmp from "./grammars/wado_lex_member_pred.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/action_lex_member_pred" },
    };

test "a lexer predicate reads @lexer::members state mid-match" {
    let r = lmp::parse(&"aaaa");
    assert r.ok(), "clean parse of 'aaaa'";
    assert r.output == "AABB", `output: '${r.output}'`;
}
