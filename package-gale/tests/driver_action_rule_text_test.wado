//! Stage C parser context API: `$text` is the input consumed by the current
//! rule so far — the concatenation of the parse-tree token texts (skipped
//! tokens are absent from the stream), matching ANTLR — via `p.rule_text(...)`.

use rt from "./grammars/wado_rule_text.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/action_rule_text" },
    };

test "$text is the concatenated token text (skipped WS excluded, ANTLR semantics)" {
    let result = rt::parse(&"foo bar");
    assert result.ok(), "clean parse";
    // The `' '` between the two IDs is `-> skip`, so it is absent from the token
    // stream; ANTLR's `$text` concatenates the parse-tree tokens, not the raw
    // source span, so the space does not appear.
    assert result.output == "foobar", `output: '{result.output}'`;
}
