//! Stage 2b: the HTML ATN-class grammar parses homogeneously end-to-end.
use html from "./grammars/HTMLLexer.g4"
    with { generator: { module: "../src/generator.wado",
        inputs: ["./grammars/HTMLParser.g4"],
        options: { highlight: false, homogeneous: true },
        output_dir: "tests/generated/cst_html" } };

test "html: nested elements parse clean" {
    let r = html::parse(&"<div><p>hello</p></div>");
    assert r.ok(), `unexpected diagnostics`;
}
test "html: void element parses clean" {
    let r = html::parse(&"<br/>");
    assert r.ok(), `unexpected diagnostics`;
}
