use sqlite_hl from "./grammars/SQLite.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: [
                { path: "./grammars/SQLite.highlights.scm", type: "tree-sitter-highlights" },
            ],
            output_dir: "./generated/cst_sqlite_highlight",
            options: { atn: "verify" },
        },
    };


test "highlight SELECT keyword" {
    let html = sqlite_hl::highlight("SELECT 1");
    assert html.contains("<span class=\"keyword\">SELECT</span>"), "missing keyword SELECT";
}

test "highlight CREATE TABLE keywords" {
    let html = sqlite_hl::highlight("CREATE TABLE t (id INTEGER)");
    assert html.contains("<span class=\"keyword\">CREATE</span>"), "missing keyword CREATE";
    assert html.contains("<span class=\"keyword\">TABLE</span>"), "missing keyword TABLE";
}

test "highlight a keyword used as a name" {
    // `any_name : IDENTIFIER | keyword | ...`: `key` names a column here, and
    // the same word in `PRIMARY KEY` is a keyword.
    let html = sqlite_hl::highlight("SELECT key FROM t");
    assert html.contains("<span class=\"variable\">key</span>"), "key is a name here";
    assert html.contains("<span class=\"keyword\">SELECT</span>"), "missing keyword SELECT";
    let decl = sqlite_hl::highlight("CREATE TABLE t (id INTEGER PRIMARY KEY)");
    assert decl.contains("<span class=\"keyword\">KEY</span>"), "KEY is a keyword here";
}

test "highlight string literal" {
    let html = sqlite_hl::highlight("SELECT 'hello'");
    assert html.contains("class=\"string\""), "missing string class";
}

test "highlight number literal" {
    let html = sqlite_hl::highlight("SELECT 42");
    assert html.contains("class=\"number\""), "missing number class";
}

test "highlight comment" {
    let html = sqlite_hl::highlight("-- comment\nSELECT 1");
    assert html.contains("class=\"comment\""), "missing comment class";
}

test "highlight punctuation" {
    let html = sqlite_hl::highlight("SELECT (1, 2)");
    assert html.contains("class=\"punctuation bracket\""), "missing bracket class";
    assert html.contains("class=\"punctuation delimiter\""), "missing delimiter class";
}

test "highlight operator" {
    let html = sqlite_hl::highlight("SELECT 1 + 2");
    assert html.contains("class=\"operator\""), "missing operator class";
}

test "highlight with unicode string literal" {
    let html = sqlite_hl::highlight("SELECT '日本語'");
    assert html.contains("日本語"), "missing unicode text";
    assert html.contains("class=\"string\""), "missing string class";
    assert html.contains("<span class=\"keyword\">SELECT</span>");
}

test "highlight with emoji in string literal" {
    let html = sqlite_hl::highlight("SELECT '🎉🚀'");
    assert html.contains("🎉🚀");
    assert html.contains("class=\"keyword\">SELECT</span>");
}

test "highlight with mixed unicode and operators" {
    let html = sqlite_hl::highlight("SELECT '日本' || '語'");
    assert html.contains("日本");
    assert html.contains("語");
}

test "highlight with HTML special chars in unicode context" {
    let html = sqlite_hl::highlight("SELECT '<日本語>'");
    assert html.contains("&lt;日本語&gt;"), "missing escaped unicode";
}
