//! Lexer char-position predicates: `_tokenStartCharPositionInLine` gates on the
//! column the token began at, `getCharPositionInLine()` on the live cursor. Both
//! are columns within the current line, so they reset after a newline.

use t from "./grammars/java_lex_pos.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/java_lex_pos" },
    };
use { TK_EOF } from "./grammars/java_lex_pos.g4";

test "lexer predicates read the token-start and cursor columns" {
    // `ab` starts at column 0, so LATE is disabled and ID wins; `cd` starts at
    // column 3, so LATE wins the tie against ID. The two spaces opening line 2
    // are an INDENT (token start at column 0), the single space on line 1 is
    // not. `x` sits at column 2, late enough for LATE.
    let actual = t::to_lexer_string(&t::tokenize(&"ab cd\n  x"), TK_EOF);
    let expected = "INDENT
[@0,0:1='ab',<3>,1:0]
[@1,2:2=' ',<4>,1:2]
[@2,3:4='cd',<2>,1:3]
[@3,5:5='\\n',<5>,1:5]
[@4,6:7='  ',<1>,2:0]
[@5,8:8='x',<2>,2:2]
[@6,9:8='<EOF>',<-1>,2:3]
";
    assert actual == expected, `actual:\n${actual}\nexpected:\n${expected}`;
}
