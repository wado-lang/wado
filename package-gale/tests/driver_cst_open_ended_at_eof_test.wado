//! `.` and `~X` admit every *token*, and EOF is not one, so an optional or
//! loop over such a body declines at EOF — on both sides of the walk.
//!
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use oae from "./grammars/open_ended_at_eof.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_open_ended_at_eof" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = oae::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = oae::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "open-ended at EOF: an optional over an open-ended rule declines" {
    assert_tree(&"k", &"(s k)");
}

test "open-ended at EOF: and takes a token where there is one" {
    assert_tree(&"k a", &"(s k (x a))");
}

test "open-ended at EOF: written in place reads the same" {
    assert_tree(&"m", &"(s m)");
    assert_tree(&"m a", &"(s m a)");
}
