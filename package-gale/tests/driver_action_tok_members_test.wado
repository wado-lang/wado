//! Stage C token members beyond `.text`: `$a.int` / `$b.int` parse the matched
//! lexeme as an integer, and `$b.index` is the token's stream index. Each reads
//! the token index bound by the call site's `let x = p.expect(...)`.

use tm from "./grammars/wado_tok_members.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            output_dir: "./generated/action_tok_members",
        },
    };

test "token .int parses the lexeme and .index is the stream position" {
    let result = tm::parse(&"10 32");
    assert result.ok(), "clean parse";
    assert result.output == "10+32=42 idx=1", `output: '{result.output}'`;
}
