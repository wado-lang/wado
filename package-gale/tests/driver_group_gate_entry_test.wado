//! A false alt-initial predicate takes its alternative out of the group. What
//! decides whether to enter the group must agree, or it admits and then reports.

use gge from "./grammars/wado_group_gate_entry.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/group_gate_entry" },
    };

test "an optional group whose only viable alternative is gated matches nothing" {
    let r = gge::parse_opt(&"a");
    assert r.ok(), `the optional matches nothing and A takes the token: ${r.diagnostics.len()} diagnostics`;
}

test "a repeat whose only viable alternative is gated exits the loop" {
    let star = gge::parse_star(&"a");
    assert star.ok(), `star: ${star.diagnostics.len()} diagnostics`;

    let nongreedy = gge::parse_nongreedy(&"a");
    assert nongreedy.ok(), `non-greedy: ${nongreedy.diagnostics.len()} diagnostics`;

    let labelled = gge::parse_list_label(&"a");
    assert labelled.ok(), `list label: ${labelled.diagnostics.len()} diagnostics`;
}

test "a single-alternative group under a repeat gates the loop" {
    // The predicate is the loop's own enter/exit decision, so it is emitted
    // once as the loop's gate — not left referencing an undefined `pred_N`.
    let star = gge::parse_solo_star(&"a");
    assert star.ok(), `star: ${star.diagnostics.len()} diagnostics`;

    let opt = gge::parse_solo_opt(&"a");
    assert opt.ok(), `optional: ${opt.diagnostics.len()} diagnostics`;
}

test "a shape-enumerated optional's entry carries its body's gate" {
    // Without the gate on every shape, the `ra A` shape admits "aaa" and the
    // whole input parses as though the predicate held.
    let bad = gge::parse_shape_opt(&"aaa");
    assert bad.has_errors(), "the gated body must not be entered";

    let other = gge::parse_shape_opt(&"c");
    assert other.ok(), `the other alternative is untouched: ${other.diagnostics.len()} diagnostics`;
}

test "a predicate in a single-alternative group guards rather than selects" {
    // `{false}?` there fails the parse — it is not a choice between the rule's
    // alternatives, so it is not silently dropped as one either.
    let bad = gge::parse_nested(&"ab");
    assert bad.has_errors(), "a false guard fails the alternative it sits in";

    let other = gge::parse_nested(&"c");
    assert other.ok(), `the other alternative is untouched: ${other.diagnostics.len()} diagnostics`;
}
