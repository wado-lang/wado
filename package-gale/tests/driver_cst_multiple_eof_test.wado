use g from "./grammars/multiple_eof.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_multiple_eof" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

// Two consecutive `EOF` references at the end of a rule must both match.
test "multiple EOF references: alt 'x'" {
    assert_tree("x", "(prog x)");
}

test "multiple EOF references: alt 'x y'" {
    assert_tree("xy", "(prog x y)");
}
