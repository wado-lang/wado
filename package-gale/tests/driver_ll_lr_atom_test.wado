use g from "./grammars/ll_lr_atom.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/ll_lr_atom",
        },
    };
use { normalize_tree } from "./grammars/ll_lr_atom.g4";

fn assert_tree(input: &String, expected: &String) {
    let root = g::parse(input).unwrap();
    let tree = g::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

#[TODO]
// Gap: `intern_follow_variant` rejects LR callees. Needs LR-aware
// variant emission — see TODO.md.
test "tree: X Y picks (a b) when a is left-recursive" {
    assert_tree(&"X Y", &"
        (r (a X) (b Y))
    ");
}

// LR rule's binary form should still work: `X + X` parses into a
// nested `a` tree.
test "tree: X + X parses through LR suffix" {
    assert_tree(&"X+X", &"
        (r (a (a X) + (a X)))
    ");
}
