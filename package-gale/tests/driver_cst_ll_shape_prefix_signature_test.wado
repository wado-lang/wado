//! A nested optional whose first token is also its continuation's, reached by
//! each route an optional takes inside a group.
//!
//! `m` and the `'@' '#'` after `m?` both start with `'@'`, so neither a
//! first-set test nor holding the optional back from what follows it is right.
//! The optional is entered only where `m` and the rest of the group both scan.
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use g from "./grammars/ll_shape_prefix_signature.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_shape_prefix_signature" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input}: ${result.diagnostics:?}`;
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input}\nexpected: ${expected}\nactual:   ${actual}`;
}

fn assert_rejected<S: AsStrSlice>(input: S) {
    let result = g::parse(input);
    assert !result.ok(), `expected diagnostics for ${input}, got ${g::to_string_tree(&result)}`;
}

test "behind a fixed-token entry: the shape without the multi-token element" {
    assert_tree("let x = @ # ;", "(prog (stmt let x = @ # ;))");
}

test "behind a fixed-token entry: the shape with it" {
    assert_tree("let x = @ ! @ # ;", "(prog (stmt let x = (m @ !) @ # ;))");
}

test "behind a fixed-token entry: neither shape" {
    assert_tree("let x ;", "(prog (stmt let x ;))");
}

test "as a shape of an optional with no fixed-token entry" {
    assert_tree("var x @ # ;", "(prog (stmt var x @ # ;))");
    assert_tree("var x @ ! @ # ;", "(prog (stmt var x (m @ !) @ # ;))");
    assert_tree("var x ;", "(prog (stmt var x ;))");
}

test "inside a mandatory group" {
    assert_tree("put x = @ # ;", "(prog (stmt put x = @ # ;))");
    assert_tree("put x = @ ! @ # ;", "(prog (stmt put x = (m @ !) @ # ;))");
}

test "a one-token body" {
    assert_tree("tok x = @ # ;", "(prog (stmt tok x = @ # ;))");
    assert_tree("tok x = @ @ # ;", "(prog (stmt tok x = @ @ # ;))");
}

test "neither reading scans: still rejected" {
    assert_rejected("let x = @ ! # ;");
    assert_rejected("var x @ ! # ;");
    assert_rejected("put x = @ ! # ;");
    assert_rejected("tok x = @ @ @ # ;");
}
