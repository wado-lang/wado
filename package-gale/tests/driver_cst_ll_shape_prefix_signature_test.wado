//! Two shapes whose lookahead signatures are in a prefix relation.
//!
//! `('=' m? '@' '#')?` enumerates a shape with `m` and one without. The first
//! truncates at the multi-token `m` to `['=', first(m)]`; the second is
//! `['=', '@', '#']`. Every input the second matches the first matches too, so
//! an `if sig0 … else if sig1 …` chain never reaches the shape without `m`.
//!
//! Shapes collide when they can both match one input, not only when equal, so
//! `scan_guarded` fires here. What still blocks it is the emitter: preferring
//! the shape strategy routes this alt through
//! `gen_op_optional_with_shape_lookahead_storable`, whose
//! `gen_op_dispatch_element` emits nothing for a `RepeatOp`; peeling it the way
//! the transparent twin does re-parents the ops into a scope lower did not bake
//! `dedup_base` for, and SQLite's `LIMIT expr ((OFFSET | ',') expr)?` then
//! emits two `let expr` in one block. Closing this needs lower to re-bake the
//! bases for a peeled shape body.

use g from "./grammars/ll_shape_prefix_signature.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_shape_prefix_signature" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}: ${result.diagnostics:?}`;
    let actual = g::to_string_tree(&result);
    assert actual == *expected, `\ninput:    ${*input}\nexpected: ${*expected}\nactual:   ${actual}`;
}

#[TODO]
test "the shape without the multi-token element" {
    assert_tree(&"let x = @ # ;", &"(prog (stmt let x = @ # ;))");
}

test "the shape with it" {
    assert_tree(&"let x = @ ! @ # ;", &"(prog (stmt let x = (m @ !) @ # ;))");
}

test "neither shape" {
    assert_tree(&"let x ;", &"(prog (stmt let x ;))");
}
