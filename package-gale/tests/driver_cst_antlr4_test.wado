/// Driver test for the ANTLR4 grammar parser.
///
/// The ANTLR4 grammar uses semantic predicates to distinguish TOKEN_REF
/// from RULE_REF, so full parsing of real ANTLR4 input is not supported.
/// These tests verify tokenization, basic parsing, and that the generated
/// parser compiles.
use antlr4 from "./grammars/ANTLRv4Lexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["./grammars/ANTLRv4Parser.g4"],
            output_dir: "./generated/cst_antlr4",
        },
    };
use { TK_LINE_COMMENT, TK_BLOCK_COMMENT, TK_INT } from "./grammars/ANTLRv4Lexer.g4";
use { TK_ARGUMENT_CONTENT, TK_END_ARGUMENT, MODE_Argument } from "./grammars/ANTLRv4Lexer.g4";
use { LexerAdaptor, LexerView, Lexer } from "./grammars/ANTLRv4Lexer.g4";

// A hand-written port of ANTLR's LexerAdaptor: these two ops drive the whole
// `Argument` mode through the lexer command surface an action op reaches.
struct Antlr4Base {
    begins: i32,
    ends: i32,
}

impl LexerAdaptor for Antlr4Base {
    // ANTLR branches here on `inLexerRule()`, which needs the rule-type state
    // the `emit` / `nextToken` hooks carry (an open Stage C item, see TODO.md).
    // Without it this always takes the parser-rule branch, so a lexer rule's
    // `[...]` char set enters `Argument` rather than `LexerCharSet`.
    fn handle_begin_argument(&mut self, view: LexerView, lx: &mut Lexer) {
        self.begins += 1;
        lx.push_mode(MODE_Argument);
        resume ();
    }

    fn handle_end_argument(&mut self, view: LexerView, lx: &mut Lexer) {
        self.ends += 1;
        lx.pop_mode();
        // A nested `[` pushed another Argument mode, so the closing bracket of
        // an inner pair is content, not the end of the argument list.
        if lx.mode_depth() > 0 {
            lx.set_type(TK_ARGUMENT_CONTENT);
        }
        resume ();
    }
}

// The commit applies a single latched push / pop / set per token, so a second
// mode command from one action cannot be represented.
struct DoublePushBase {
    hits: i32,
}

impl LexerAdaptor for DoublePushBase {
    fn handle_begin_argument(&mut self, view: LexerView, lx: &mut Lexer) {
        self.hits += 1;
        lx.push_mode(MODE_Argument);
        lx.push_mode(MODE_Argument);
        resume ();
    }

    fn handle_end_argument(&mut self, view: LexerView, lx: &mut Lexer) {
        resume ();
    }
}

#[expect_trap]
test "a second mode command in one action is a hard error" {
    let mut base = DoublePushBase { hits: 0 };
    with LexerAdaptor => &mut base do {
        antlr4::tokenize(&"r[int x] : 'a' ;");
    };
}

fn new_antlr4_base() -> Antlr4Base {
    return Antlr4Base { begins: 0, ends: 0 };
}

fn a4_tokenize(input: &String) -> antlr4::TokenStream {
    let mut base = new_antlr4_base();
    with LexerAdaptor => &mut base do {
        return antlr4::tokenize(input);
    };
}

fn a4_parse(input: &String) -> antlr4::ParseResult {
    let mut base = new_antlr4_base();
    with LexerAdaptor => &mut base do {
        return antlr4::parse(input);
    };
}

test "tokenize grammar declaration" {
    let tokens = a4_tokenize(&"grammar Foo;");
    assert tokens.len() >= 3, `expected at least 3 tokens, got ${tokens.len()}`;
    // Verify the first token is GRAMMAR keyword
    let first_name = antlr4::token_kind_name(tokens.kinds[0]);
    assert first_name == "GRAMMAR", `expected GRAMMAR, got ${first_name}`;
}

test "tokenize rule with string literal" {
    let tokens = a4_tokenize(&"bar : 'hello' ;");
    assert tokens.len() >= 4, `expected at least 4 tokens, got ${tokens.len()}`;
}

test "tokenize alternatives" {
    let tokens = a4_tokenize(&"expr : expr '+' expr | INT ;");
    // Should have: identifier, colon, identifier, string, identifier, pipe, identifier, semi
    assert tokens.len() >= 7, `expected at least 7 tokens, got ${tokens.len()}`;
}

test "tokenize character set" {
    let tokens = a4_tokenize(&"ID : [a-zA-Z_]+ ;");
    assert tokens.len() >= 4, `expected at least 4 tokens, got ${tokens.len()}`;
}

test "tokenize action block" {
    let tokens = a4_tokenize(&"rule_ : 'a' { doSomething(); } ;");
    assert tokens.len() >= 4, `expected at least 4 tokens, got ${tokens.len()}`;
}

test "tokenize options block" {
    let tokens = a4_tokenize(&"options { tokenVocab = FooLexer; }");
    assert tokens.len() >= 5, `expected at least 5 tokens, got ${tokens.len()}`;
}

test "tokenize fragment" {
    let tokens = a4_tokenize(&"fragment DIGIT : [0-9] ;");
    assert tokens.len() >= 4, `expected at least 4 tokens, got ${tokens.len()}`;
    let first_name = antlr4::token_kind_name(tokens.kinds[0]);
    assert first_name == "FRAGMENT", `expected FRAGMENT, got ${first_name}`;
}

test "tokenize labels" {
    let tokens = a4_tokenize(&"expr : INT # NumExpr ;");
    assert tokens.len() >= 5, `expected at least 5 tokens, got ${tokens.len()}`;
}

test "tokenize lexer commands" {
    let tokens = a4_tokenize(&"WS : [ \\t\\n]+ -> skip ;");
    assert tokens.len() >= 5, `expected at least 5 tokens, got ${tokens.len()}`;
}


test "parse minimal grammar" {
    // ANTLR4 lexer produces ID tokens, but the parser expects RULE_REF/TOKEN_REF
    // (distinguished by semantic predicates based on case). Without predicates,
    // any input with identifiers fails to parse. Verify the error is sensible.
    let r = a4_parse(&"grammar Foo;");
    assert !r.ok(), "expected a diagnostic";
}

//
// ANTLRv4Lexer declares `channels { OFF_CHANNEL, COMMENT }`, so DEFAULT=0,
// HIDDEN=1, OFF_CHANNEL=2, COMMENT=3. DOC/BLOCK/LINE comments route to
// channel(COMMENT), which is a non-HIDDEN user channel. The generated
// lexer must: (a) keep those tokens out of the main stream, and (b) emit
// them as trivia with `channel == 3`, not 0 or 1. This exercises the
// generic `channel(X)` routing path, not just the HIDDEN shortcut.
test "user channel: LINE_COMMENT routed to COMMENT channel" {
    let tokens = a4_tokenize(&"// hi\n42");
    // LINE_COMMENT must not appear in the main stream.
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_LINE_COMMENT, "LINE_COMMENT leaked into main stream — channel routing dropped";
    }
    // The INT `42` must follow, carrying the LINE_COMMENT as trivia on
    // channel 3 (the COMMENT channel).
    let mut found = false;
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.kinds[i] == TK_INT {
            for let mut j = tokens.triv_lo[i]; j < tokens.triv_hi[i]; j += 1 {
                if tokens.triv_kinds[j] == TK_LINE_COMMENT {
                    assert tokens.triv_chans[j] == 3, `expected COMMENT channel 3, got ${tokens.triv_chans[j]}`;
                    found = true;
                }
            }
        }
    }
    assert found, "LINE_COMMENT trivia missing on INT token";
}

test "user channel: BLOCK_COMMENT routed to COMMENT channel" {
    let tokens = a4_tokenize(&"/* hi */ 42");
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_BLOCK_COMMENT, "BLOCK_COMMENT leaked into main stream";
    }
    let mut found = false;
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.kinds[i] == TK_INT {
            for let mut j = tokens.triv_lo[i]; j < tokens.triv_hi[i]; j += 1 {
                if tokens.triv_kinds[j] == TK_BLOCK_COMMENT {
                    assert tokens.triv_chans[j] == 3, `expected COMMENT channel 3, got ${tokens.triv_chans[j]}`;
                    found = true;
                }
            }
        }
    }
    assert found, "BLOCK_COMMENT trivia missing on INT token";
}

test "the base's argument-bracket ops run on the winning tokens" {
    // BEGIN_ARGUMENT / END_ARGUMENT carry the grammar's only actions, and each
    // is a bare `{this.m();}` base call — the winner replay runs them once per
    // matched bracket, and never for a candidate that lost the tournament.
    let mut base = new_antlr4_base();
    with LexerAdaptor => &mut base do {
        let tokens = antlr4::tokenize(&"r[int x] : 'a' ;");
        assert tokens.len() >= 6, `expected at least 6 tokens, got ${tokens.len()}`;
    };
    assert base.begins == 1, `expected 1 handleBeginArgument, got ${base.begins}`;
    assert base.ends == 1, `expected 1 handleEndArgument, got ${base.ends}`;
}

test "the base drives the Argument mode from handleBeginArgument" {
    // The base pushes `Argument` on `[`, so the rule-argument body lexes as
    // ARGUMENT_CONTENT rather than DEFAULT-mode grammar tokens.
    let tokens = a4_tokenize(&"r[int x] : 'a' ;");
    let mut content = 0;
    let mut ends = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.kinds[i] == TK_ARGUMENT_CONTENT {
            content += 1;
        }
        if tokens.kinds[i] == TK_END_ARGUMENT {
            ends += 1;
        }
    }
    assert content > 0, "the argument body must lex as ARGUMENT_CONTENT";
    assert ends == 1, `expected 1 END_ARGUMENT, got ${ends}`;
}

test "a nested bracket retypes its closing bracket as content" {
    // The inner `]` pops back into the outer Argument mode, where the base's
    // depth check retypes it to content; only the outer one stays END_ARGUMENT.
    let tokens = a4_tokenize(&"r[int[] a] : 'a' ;");
    let mut ends = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.kinds[i] == TK_END_ARGUMENT {
            ends += 1;
        }
    }
    assert ends == 1, `expected 1 END_ARGUMENT, got ${ends}`;
}
