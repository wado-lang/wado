//! An ambiguous greedy optional prefers ENTERING, matching ANTLR4's
//! alternative-order ambiguity resolution. Expected trees are the published
//! ANTLR4 jar's (black-box oracle).
//!
//! Preferring to enter is only correct with a viability check: the entry probe
//! scans the body, then the continuation from where the body ended, and enters
//! only when both still match.

use g from "./grammars/ll_opt_greedy_ambig.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_opt_greedy_ambig" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}: ${g::to_string_tree(&result)}`;
    let actual = g::to_string_tree(&result);
    assert actual == *expected, `\ninput:    ${*input}\nexpected: ${*expected}\nactual:   ${actual}`;
}

fn assert_parses(input: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}: ${g::to_string_tree(&result)}`;
}

// The divergence is which node the shared token lands under, not acceptance
// (see lr_between).
test "the ambiguous inputs parse" {
    assert_parses(&"x null");
    assert_parses(&"x null null");
}

test "ambiguous optional takes the shared token" {
    assert_tree(&"x null", &"(s x (t null))");
}

test "ambiguous optional takes the first shared token, the loop the rest" {
    assert_tree(&"x null null", &"(s x (t null) (c null))");
}

test "optional is skipped when it cannot match" {
    assert_tree(&"x", &"(s x)");
}
