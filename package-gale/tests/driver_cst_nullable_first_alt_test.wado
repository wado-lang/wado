//! A rule alternative that can match nothing is viable everywhere, so its arm
//! carries no lookahead test. Where it belongs is not a property of the rule —
//! ANTLR4 takes it in one caller and not another on the same input — so no
//! static order is the answer. The ATN simulator decides it with full context.
//!
//! Trees from the published ANTLR4 jar (`scripts/antlr4-oracle.sh`).

use nfa from "./grammars/nullable_first_alt.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_nullable_first_alt" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = nfa::parse(input);
    assert result.ok(), `unexpected diagnostics for "${input}"`;
    let actual = nfa::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    "${input}"\nexpected: ${expected}\nactual:   ${actual}`;
}

test "nullable-first: the empty match wins where the caller consumes the token" {
    assert_tree("p b", "(s p r b)");
    assert_tree("p a b", "(s p (r a) b)");
}

test "nullable-first: the lookahead still picks the alternative that has one" {
    assert_tree("q a", "(s q (r a))");
    assert_tree("q", "(s q r)");
}

test "nullable-first: the caller's continuation can rule the empty match out" {
    // `q b`: alternative 0 matches empty, but EOF follows and `b` is left
    // over, so ANTLR4 takes `B`.
    assert_tree("q b", "(s q (r b))");
}
