fn parse_property_member_declaration(p: &mut Parser) -> Result<PropertyMemberDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Public | TK_Private | TK_Protected | TK_Async | TK_Static | TK_ReadOnly } {
        if p.peek_kind() matches { TK_Public | TK_Private | TK_Protected | TK_Async | TK_Static | TK_ReadOnly } {
            let saved = p.pos;
            if parse_property_member_declaration_scan_0(&p.tokens, p.pos) >= 0 {
                let r_0 = parse_property_member_declaration_bt_0(p);
                if let Err(_) = r_0 {
                    p.pos = saved;
                } else {
                    return r_0;
                }
            }
            if parse_property_member_declaration_scan_1(&p.tokens, p.pos) >= 0 {
                let r_1 = parse_property_member_declaration_bt_1(p);
                if let Err(_) = r_1 {
                    p.pos = saved;
                } else {
                    return r_1;
                }
            }
            return parse_property_member_declaration_bt_2(p);
        }
    }
    if kind == TK_Abstract {
        let abstract_declaration = parse_abstract_declaration(p)?;
        return Result::<PropertyMemberDeclarationNode, ParseError>::Ok(PropertyMemberDeclarationNode::AbstractMemberDeclaration(PropertyMemberDeclarationAbstractMemberDeclaration {
            span: Span::new(start, p.last_end()),
            abstract_declaration,
        }));
    }
    return Result::<PropertyMemberDeclarationNode, ParseError>::Err(ParseError::new(
        "expected propertyMemberDeclaration",
        p.peek().span,
        ["TK_Public", "TK_Private", "TK_Protected", "TK_Async", "TK_Static", "TK_ReadOnly", "TK_Abstract"],
    ));
}

fn parse_property_member_base(p: &mut Parser) -> Result<PropertyMemberBaseNode, ParseError> {
