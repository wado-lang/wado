fn parse_export_statement_bt_0(p: &mut Parser) -> Result<ExportStatementNode, ParseError> {
    let start = p.peek().span.start;
    let export_ = p.expect(TK_Export)?;
    let default: Option<Token> = if p.peek_kind() == TK_Default {
        let default = p.expect(TK_Default)?;
        Option::<Token>::Some(default)
    } else {
        null
    };
    let mut export_from_block_or_declaration_inner: Option<ExportFromBlockOrDeclarationGroup> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_LIT_STAR | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Declare | TK_LIT_AT } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let opt_r = parse_export_from_block(p);
                if let Err(_) = opt_r { p.pos = saved_pos; break bt_try; }
                export_from_block_or_declaration_inner = Option::<ExportFromBlockOrDeclarationGroup>::Some(ExportFromBlockOrDeclarationGroup::ExportFromBlock(opt_r.unwrap()));
                bt_done = true;
            }
        }
        if !bt_done {
            let declaration = parse_declaration(p)?;
            export_from_block_or_declaration_inner = Option::<ExportFromBlockOrDeclarationGroup>::Some(ExportFromBlockOrDeclarationGroup::Declaration(declaration));
        }
    }
    let export_from_block_or_declaration = export_from_block_or_declaration_inner;
    let eos = parse_eos(p)?;
    return Result::<ExportStatementNode, ParseError>::Ok(ExportStatementNode::ExportDeclaration(ExportStatementExportDeclaration {
        span: Span::new(start, p.last_end()),
        export_,
        default,
        export_from_block_or_declaration,
        eos,
    }));
}

fn parse_export_statement_scan_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_Export { return -1; }
    pos += 1;
    if pos < tokens.len() && tokens[pos].kind == TK_Default {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos].kind != TK_Default { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; }
    }
    return pos;
}

fn parse_export_statement_bt_1(p: &mut Parser) -> Result<ExportStatementNode, ParseError> {
    let start = p.peek().span.start;
    let export_ = p.expect(TK_Export)?;
    let default = p.expect(TK_Default)?;
    let single_expression = parse_single_expression(p)?;
    let eos = parse_eos(p)?;
    return Result::<ExportStatementNode, ParseError>::Ok(ExportStatementNode::ExportDefaultDeclaration(ExportStatementExportDefaultDeclaration {
        span: Span::new(start, p.last_end()),
        export_,
        default,
        single_expression,
        eos,
    }));
}

fn parse_export_statement_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_Export { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_Default { return -1; }
    pos += 1;
    return pos;
}

fn parse_export_statement(p: &mut Parser) -> Result<ExportStatementNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_Export {
        let saved = p.pos;
        if parse_export_statement_scan_0(&p.tokens, p.pos) >= 0 {
            let r_0 = parse_export_statement_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
        }
        return parse_export_statement_bt_1(p);
    }
    return Result::<ExportStatementNode, ParseError>::Err(ParseError::new(
        "expected exportStatement",
        p.peek().span,
        ["TK_Export"],
    ));
}

fn parse_export_from_block(p: &mut Parser) -> Result<ExportFromBlockNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_LIT_STAR | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral } {
        let import_namespace = parse_import_namespace(p)?;
        let import_from = parse_import_from(p)?;
        let eos = parse_eos(p)?;
        return Result::<ExportFromBlockNode, ParseError>::Ok(ExportFromBlockNode::Alt0(ExportFromBlockAlt0 {
            span: Span::new(start, p.last_end()),
            import_namespace,
            import_from,
            eos,
        }));
    }
    if kind == TK_LIT_LBRACE {
        let export_module_items = parse_export_module_items(p)?;
        let import_from: Option<ImportFromNode> = if p.peek_kind() == TK_From {
            let import_from = parse_import_from(p)?;
            Option::<ImportFromNode>::Some(import_from)
        } else {
            null
        };
        let eos = parse_eos(p)?;
        return Result::<ExportFromBlockNode, ParseError>::Ok(ExportFromBlockNode::Alt1(ExportFromBlockAlt1 {
            span: Span::new(start, p.last_end()),
            export_module_items,
            import_from,
            eos,
        }));
    }
    return Result::<ExportFromBlockNode, ParseError>::Err(ParseError::new(
        "expected exportFromBlock",
        p.peek().span,
        ["TK_LIT_STAR", "TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_LIT_LBRACE"],
    ));
}

fn parse_export_module_items(p: &mut Parser) -> Result<ExportModuleItemsNode, ParseError> {
    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let mut export_alias_name_comma_list: Array<ExportAliasNameCommaItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_export_alias_name(tokens, pos);
            if pos < 0 { break rep_scan; }
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
            pos += 1;
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let export_alias_name = parse_export_alias_name(p)?;
        let comma = p.expect(TK_LIT_COMMA)?;
        let export_alias_name_comma = ExportAliasNameCommaItem {
            export_alias_name,
            comma,
        };
        export_alias_name_comma_list.push(export_alias_name_comma);
    }
    let export_alias_name_comma: Option<ExportAliasNameCommaOptItem> = if (p.peek_kind() == TK_Identifier || p.peek_kind() == TK_Async || p.peek_kind() == TK_As || p.peek_kind() == TK_From || p.peek_kind() == TK_Yield || p.peek_kind() == TK_Of || p.peek_kind() == TK_Any || p.peek_kind() == TK_Number || p.peek_kind() == TK_Boolean || p.peek_kind() == TK_String || p.peek_kind() == TK_Unique || p.peek_kind() == TK_Symbol || p.peek_kind() == TK_Never || p.peek_kind() == TK_Undefined || p.peek_kind() == TK_Object || p.peek_kind() == TK_KeyOf || p.peek_kind() == TK_TypeAlias || p.peek_kind() == TK_Constructor || p.peek_kind() == TK_Namespace || p.peek_kind() == TK_Abstract || p.peek_kind() == TK_Break || p.peek_kind() == TK_Do || p.peek_kind() == TK_Instanceof || p.peek_kind() == TK_Typeof || p.peek_kind() == TK_Case || p.peek_kind() == TK_Else || p.peek_kind() == TK_New || p.peek_kind() == TK_Var || p.peek_kind() == TK_Catch || p.peek_kind() == TK_Finally || p.peek_kind() == TK_Return || p.peek_kind() == TK_Void || p.peek_kind() == TK_Continue || p.peek_kind() == TK_For || p.peek_kind() == TK_Switch || p.peek_kind() == TK_While || p.peek_kind() == TK_Debugger || p.peek_kind() == TK_Function_ || p.peek_kind() == TK_This || p.peek_kind() == TK_With || p.peek_kind() == TK_Default || p.peek_kind() == TK_If || p.peek_kind() == TK_Throw || p.peek_kind() == TK_Delete || p.peek_kind() == TK_In || p.peek_kind() == TK_Try || p.peek_kind() == TK_Class || p.peek_kind() == TK_Enum || p.peek_kind() == TK_Extends || p.peek_kind() == TK_Super || p.peek_kind() == TK_Const || p.peek_kind() == TK_Export || p.peek_kind() == TK_Import || p.peek_kind() == TK_Implements || p.peek_kind() == TK_Let || p.peek_kind() == TK_Private || p.peek_kind() == TK_Public || p.peek_kind() == TK_Interface || p.peek_kind() == TK_Package || p.peek_kind() == TK_Protected || p.peek_kind() == TK_Static || p.peek_kind() == TK_Await || p.peek_kind() == TK_ReadOnly || p.peek_kind() == TK_Require || p.peek_kind() == TK_Module || p.peek_kind() == TK_NullLiteral || p.peek_kind() == TK_BooleanLiteral || p.peek_kind() == TK_StringLiteral) && p.peek_at(1) == TK_LIT_COMMA {
        let export_alias_name = parse_export_alias_name(p)?;
        let comma: Option<Token> = if p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            Option::<Token>::Some(comma)
        } else {
            null
        };
        let export_alias_name_comma = ExportAliasNameCommaOptItem {
            export_alias_name,
            comma,
        };
        Option::<ExportAliasNameCommaOptItem>::Some(export_alias_name_comma)
    } else if (p.peek_kind() == TK_Identifier || p.peek_kind() == TK_Async || p.peek_kind() == TK_As || p.peek_kind() == TK_From || p.peek_kind() == TK_Yield || p.peek_kind() == TK_Of || p.peek_kind() == TK_Any || p.peek_kind() == TK_Number || p.peek_kind() == TK_Boolean || p.peek_kind() == TK_String || p.peek_kind() == TK_Unique || p.peek_kind() == TK_Symbol || p.peek_kind() == TK_Never || p.peek_kind() == TK_Undefined || p.peek_kind() == TK_Object || p.peek_kind() == TK_KeyOf || p.peek_kind() == TK_TypeAlias || p.peek_kind() == TK_Constructor || p.peek_kind() == TK_Namespace || p.peek_kind() == TK_Abstract || p.peek_kind() == TK_Break || p.peek_kind() == TK_Do || p.peek_kind() == TK_Instanceof || p.peek_kind() == TK_Typeof || p.peek_kind() == TK_Case || p.peek_kind() == TK_Else || p.peek_kind() == TK_New || p.peek_kind() == TK_Var || p.peek_kind() == TK_Catch || p.peek_kind() == TK_Finally || p.peek_kind() == TK_Return || p.peek_kind() == TK_Void || p.peek_kind() == TK_Continue || p.peek_kind() == TK_For || p.peek_kind() == TK_Switch || p.peek_kind() == TK_While || p.peek_kind() == TK_Debugger || p.peek_kind() == TK_Function_ || p.peek_kind() == TK_This || p.peek_kind() == TK_With || p.peek_kind() == TK_Default || p.peek_kind() == TK_If || p.peek_kind() == TK_Throw || p.peek_kind() == TK_Delete || p.peek_kind() == TK_In || p.peek_kind() == TK_Try || p.peek_kind() == TK_Class || p.peek_kind() == TK_Enum || p.peek_kind() == TK_Extends || p.peek_kind() == TK_Super || p.peek_kind() == TK_Const || p.peek_kind() == TK_Export || p.peek_kind() == TK_Import || p.peek_kind() == TK_Implements || p.peek_kind() == TK_Let || p.peek_kind() == TK_Private || p.peek_kind() == TK_Public || p.peek_kind() == TK_Interface || p.peek_kind() == TK_Package || p.peek_kind() == TK_Protected || p.peek_kind() == TK_Static || p.peek_kind() == TK_Await || p.peek_kind() == TK_ReadOnly || p.peek_kind() == TK_Require || p.peek_kind() == TK_Module || p.peek_kind() == TK_NullLiteral || p.peek_kind() == TK_BooleanLiteral || p.peek_kind() == TK_StringLiteral) {
        let export_alias_name = parse_export_alias_name(p)?;
        let comma: Option<Token> = null;
        let export_alias_name_comma = ExportAliasNameCommaOptItem {
            export_alias_name,
            comma,
        };
        Option::<ExportAliasNameCommaOptItem>::Some(export_alias_name_comma)
    } else {
        null
    };
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<ExportModuleItemsNode, ParseError>::Ok(ExportModuleItemsNode {
        span: Span::new(start, p.last_end()),
        lbrace,
        export_alias_name_comma_list,
        export_alias_name_comma,
        rbrace,
    });
}

fn parse_export_alias_name(p: &mut Parser) -> Result<ExportAliasNameNode, ParseError> {
    let start = p.peek().span.start;
    let module_export_name = parse_module_export_name(p)?;
    let as__module_export_name: Option<AsModuleExportNameItem> = if p.peek_kind() == TK_As {
        let as_ = p.expect(TK_As)?;
        let module_export_name = parse_module_export_name(p)?;
        let as__module_export_name = AsModuleExportNameItem {
            as_,
            module_export_name,
        };
        Option::<AsModuleExportNameItem>::Some(as__module_export_name)
    } else {
        null
    };
    return Result::<ExportAliasNameNode, ParseError>::Ok(ExportAliasNameNode {
        span: Span::new(start, p.last_end()),
        module_export_name,
        as__module_export_name,
    });
}

fn parse_declaration_bt_2(p: &mut Parser) -> Result<DeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let function_declaration = parse_function_declaration(p)?;
    return Result::<DeclarationNode, ParseError>::Ok(DeclarationNode::Alt2(DeclarationAlt2 {
        span: Span::new(start, p.last_end()),
        function_declaration,
    }));
}

fn parse_declaration_bt_1(p: &mut Parser) -> Result<DeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let class_declaration = parse_class_declaration(p)?;
    return Result::<DeclarationNode, ParseError>::Ok(DeclarationNode::Alt1(DeclarationAlt1 {
        span: Span::new(start, p.last_end()),
