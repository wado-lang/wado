fn parse_primary_type_prec(p: &mut Parser, min_prec: i32) -> Result<PrimaryTypeNode, ParseError> {
    let start = p.peek().span.start;
    let mut result = parse_primary_type_atom(p)?;
    loop {
        let suffix_kind = p.peek_kind();
        if suffix_kind == TK_LIT_LBRACKET {
            if 1 >= min_prec {
                result = parse_primary_type_lr_4(p, result, start)?;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return Result::<PrimaryTypeNode, ParseError>::Ok(result);
}

fn parse_primary_type(p: &mut Parser) -> Result<PrimaryTypeNode, ParseError> {
    return parse_primary_type_prec(p, 0);
}

