            let r_2 = parse_class_element_bt_2(p);
            if let Err(_) = r_2 {
                p.pos = saved;
            } else {
                return r_2;
            }
            return parse_class_element_bt_3(p);
        } else if p.peek_kind() matches { TK_Public | TK_Private | TK_Protected } {
            let saved = p.pos;
            let r_0 = parse_class_element_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            let r_3 = parse_class_element_bt_3(p);
            if let Err(_) = r_3 {
                p.pos = saved;
            } else {
                return r_3;
            }
            return parse_class_element_bt_1(p);
        } else if p.peek_kind() == TK_Constructor {
            let saved = p.pos;
            let r_0 = parse_class_element_bt_0(p);
            if let Err(_) = r_0 {
