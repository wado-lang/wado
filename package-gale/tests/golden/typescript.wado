    let arguments = parse_arguments(p)?;
    return Result::<SingleExpressionNode, ParseError>::Ok(SingleExpressionNode::NewExpression0(SingleExpressionNewExpression0 {
        span: Span::new(start, p.last_end()),
        new,
        single_expression,
