    let identifier_name = parse_identifier_name(p)?;
    return Result::<TypeQueryExpressionNode, ParseError>::Ok(TypeQueryExpressionNode::Alt1(TypeQueryExpressionAlt1 {
        span: Span::new(start, p.last_end()),
        identifier_name_dot_list,
        identifier_name,
