fn parse_declaration_bt_0(p: &mut Parser) -> Result<DeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let variable_statement = parse_variable_statement(p)?;
    return Result::<DeclarationNode, ParseError>::Ok(DeclarationNode::Alt0(DeclarationAlt0 {
        span: Span::new(start, p.last_end()),
        variable_statement,
    }));
}

fn parse_declaration(p: &mut Parser) -> Result<DeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Async | TK_Function_ | TK_LIT_AT | TK_Export | TK_Abstract | TK_Class | TK_LIT_LBRACKET | TK_LIT_LBRACE | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Require | TK_Declare } {
        if p.peek_kind() == TK_Async {
            let saved = p.pos;
            let r_0 = parse_declaration_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_declaration_bt_2(p);
        } else if p.peek_kind() == TK_Function_ {
            return parse_declaration_bt_2(p);
        } else if p.peek_kind() matches { TK_LIT_AT | TK_Export | TK_Class } {
            return parse_declaration_bt_1(p);
        } else if p.peek_kind() == TK_Abstract {
            let saved = p.pos;
            let r_0 = parse_declaration_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_declaration_bt_1(p);
        } else if p.peek_kind() matches { TK_LIT_LBRACKET | TK_LIT_LBRACE | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Require | TK_Declare } {
            return parse_declaration_bt_0(p);
        }
    }
    return Result::<DeclarationNode, ParseError>::Err(ParseError::new(
        "expected declaration",
        p.peek().span,
        ["TK_LIT_LBRACKET", "TK_LIT_LBRACE", "TK_Public", "TK_Private", "TK_Protected", "TK_Var", "TK_Let", "TK_Const", "TK_ReadOnly", "TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Require", "TK_Declare", "TK_LIT_AT", "TK_Export", "TK_Class", "TK_Function_"],
    ));
}

fn parse_variable_statement_bt_1(p: &mut Parser) -> Result<VariableStatementNode, ParseError> {
    let start = p.peek().span.start;
    let accessibility_modifier: Option<AccessibilityModifierNode> = if p.peek_kind() matches { TK_Public | TK_Private | TK_Protected } {
        let accessibility_modifier = parse_accessibility_modifier(p)?;
        Option::<AccessibilityModifierNode>::Some(accessibility_modifier)
    } else {
        null
    };
    let var_modifier: Option<VarModifierNode> = if p.peek_kind() matches { TK_Var | TK_Let | TK_Const } {
        let var_modifier = parse_var_modifier(p)?;
        Option::<VarModifierNode>::Some(var_modifier)
    } else {
        null
    };
    let readonly: Option<Token> = if p.peek_kind() == TK_ReadOnly {
        let readonly = p.expect(TK_ReadOnly)?;
        Option::<Token>::Some(readonly)
    } else {
        null
    };
    let variable_declaration_list = parse_variable_declaration_list(p)?;
    let semicolon: Option<Token> = if p.peek_kind() == TK_SemiColon {
        let semicolon = p.expect(TK_SemiColon)?;
        Option::<Token>::Some(semicolon)
    } else {
        null
    };
    return Result::<VariableStatementNode, ParseError>::Ok(VariableStatementNode::Alt1(VariableStatementAlt1 {
        span: Span::new(start, p.last_end()),
        accessibility_modifier,
        var_modifier,
        readonly,
        variable_declaration_list,
        semicolon,
    }));
}

fn parse_variable_statement_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && tokens[pos].kind matches { TK_Public | TK_Private | TK_Protected } {
        let sp = pos;
        pos = scan_accessibility_modifier(tokens, pos);
        if pos < 0 { pos = sp; }
    }
    if pos < tokens.len() && tokens[pos].kind matches { TK_Var | TK_Let | TK_Const } {
        let sp = pos;
        pos = scan_var_modifier(tokens, pos);
        if pos < 0 { pos = sp; }
    }
    if pos < tokens.len() && tokens[pos].kind == TK_ReadOnly {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos].kind != TK_ReadOnly { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; }
    }
    return pos;
}

fn parse_variable_statement_bt_0(p: &mut Parser) -> Result<VariableStatementNode, ParseError> {
    let start = p.peek().span.start;
    let binding_pattern = parse_binding_pattern(p)?;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    let initializer = parse_initializer(p)?;
    let semicolon: Option<Token> = if p.peek_kind() == TK_SemiColon {
        let semicolon = p.expect(TK_SemiColon)?;
        Option::<Token>::Some(semicolon)
    } else {
        null
    };
    return Result::<VariableStatementNode, ParseError>::Ok(VariableStatementNode::Alt0(VariableStatementAlt0 {
        span: Span::new(start, p.last_end()),
        binding_pattern,
        type_annotation,
        initializer,
        semicolon,
    }));
}

fn parse_variable_statement(p: &mut Parser) -> Result<VariableStatementNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_LIT_LBRACKET | TK_LIT_LBRACE } {
        if p.peek_kind() matches { TK_LIT_LBRACKET | TK_LIT_LBRACE } {
            let saved = p.pos;
            if parse_variable_statement_scan_1(&p.tokens, p.pos) >= 0 {
                let r_1 = parse_variable_statement_bt_1(p);
                if let Err(_) = r_1 {
                    p.pos = saved;
                } else {
                    return r_1;
                }
            }
            return parse_variable_statement_bt_0(p);
        } else if p.peek_kind() matches { TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require } {
            return parse_variable_statement_bt_1(p);
        }
    }
    if kind == TK_Declare {
        let declare = p.expect(TK_Declare)?;
        let var_modifier: Option<VarModifierNode> = if p.peek_kind() matches { TK_Var | TK_Let | TK_Const } {
            let var_modifier = parse_var_modifier(p)?;
            Option::<VarModifierNode>::Some(var_modifier)
        } else {
            null
        };
        let variable_declaration_list = parse_variable_declaration_list(p)?;
        let semicolon: Option<Token> = if p.peek_kind() == TK_SemiColon {
            let semicolon = p.expect(TK_SemiColon)?;
            Option::<Token>::Some(semicolon)
        } else {
            null
        };
        return Result::<VariableStatementNode, ParseError>::Ok(VariableStatementNode::Alt2(VariableStatementAlt2 {
            span: Span::new(start, p.last_end()),
            declare,
            var_modifier,
            variable_declaration_list,
            semicolon,
        }));
    }
    return Result::<VariableStatementNode, ParseError>::Err(ParseError::new(
        "expected variableStatement",
        p.peek().span,
        ["TK_LIT_LBRACKET", "TK_LIT_LBRACE", "TK_Public", "TK_Private", "TK_Protected", "TK_Var", "TK_Let", "TK_Const", "TK_ReadOnly", "TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Require", "TK_Declare"],
    ));
}

fn parse_variable_declaration_list(p: &mut Parser) -> Result<VariableDeclarationListNode, ParseError> {
    let start = p.peek().span.start;
    let variable_declaration = parse_variable_declaration(p)?;
    let mut comma_variable_declaration_list: Array<CommaVariableDeclarationItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let variable_declaration = parse_variable_declaration(p)?;
        let comma_variable_declaration = CommaVariableDeclarationItem {
            comma,
            variable_declaration,
        };
        comma_variable_declaration_list.push(comma_variable_declaration);
    }
    return Result::<VariableDeclarationListNode, ParseError>::Ok(VariableDeclarationListNode {
        span: Span::new(start, p.last_end()),
        variable_declaration,
        comma_variable_declaration_list,
    });
}

fn parse_variable_declaration(p: &mut Parser) -> Result<VariableDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let mut identifier_or_key_word_or_array_literal_or_object_literal_inner: Option<IdentifierOrKeyWordOrArrayLiteralOrObjectLiteralGroup> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require } {
        let identifier_or_key_word = parse_identifier_or_key_word(p)?;
        identifier_or_key_word_or_array_literal_or_object_literal_inner = Option::<IdentifierOrKeyWordOrArrayLiteralOrObjectLiteralGroup>::Some(IdentifierOrKeyWordOrArrayLiteralOrObjectLiteralGroup::IdentifierOrKeyWord(identifier_or_key_word));
    } else if grp_kind == TK_LIT_LBRACKET {
        let array_literal = parse_array_literal(p)?;
        identifier_or_key_word_or_array_literal_or_object_literal_inner = Option::<IdentifierOrKeyWordOrArrayLiteralOrObjectLiteralGroup>::Some(IdentifierOrKeyWordOrArrayLiteralOrObjectLiteralGroup::ArrayLiteral(array_literal));
    } else if grp_kind == TK_LIT_LBRACE {
        let object_literal = parse_object_literal(p)?;
        identifier_or_key_word_or_array_literal_or_object_literal_inner = Option::<IdentifierOrKeyWordOrArrayLiteralOrObjectLiteralGroup>::Some(IdentifierOrKeyWordOrArrayLiteralOrObjectLiteralGroup::ObjectLiteral(object_literal));
    }
    let identifier_or_key_word_or_array_literal_or_object_literal = identifier_or_key_word_or_array_literal_or_object_literal_inner;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    let single_expression: Option<SingleExpressionNode> = if p.peek_kind() matches { TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        let single_expression = parse_single_expression(p)?;
        Option::<SingleExpressionNode>::Some(single_expression)
    } else {
        null
    };
    let eq_type_parameters_single_expression: Option<EqTypeParametersOptSingleExpressionItem> = if p.peek_kind() == TK_LIT_EQ {
        let eq = p.expect(TK_LIT_EQ)?;
        let type_parameters: Option<TypeParametersNode> = if p.peek_kind() == TK_LIT_LT {
            let type_parameters = parse_type_parameters(p)?;
            Option::<TypeParametersNode>::Some(type_parameters)
        } else {
            null
        };
        let single_expression = parse_single_expression(p)?;
        let eq_type_parameters_single_expression = EqTypeParametersOptSingleExpressionItem {
            eq,
            type_parameters,
            single_expression,
        };
        Option::<EqTypeParametersOptSingleExpressionItem>::Some(eq_type_parameters_single_expression)
    } else {
        null
    };
    return Result::<VariableDeclarationNode, ParseError>::Ok(VariableDeclarationNode {
        span: Span::new(start, p.last_end()),
        identifier_or_key_word_or_array_literal_or_object_literal,
        type_annotation,
        single_expression,
        eq_type_parameters_single_expression,
    });
}

fn parse_empty_statement_(p: &mut Parser) -> Result<EmptyStatementNode, ParseError> {
    let start = p.peek().span.start;
    let semicolon = p.expect(TK_SemiColon)?;
    return Result::<EmptyStatementNode, ParseError>::Ok(EmptyStatementNode {
        span: Span::new(start, p.last_end()),
        semicolon,
    });
}

fn parse_expression_statement(p: &mut Parser) -> Result<ExpressionStatementNode, ParseError> {
    let start = p.peek().span.start;
    let expression_sequence = parse_expression_sequence(p)?;
    let semicolon: Option<Token> = if p.peek_kind() == TK_SemiColon {
        let semicolon = p.expect(TK_SemiColon)?;
        Option::<Token>::Some(semicolon)
    } else {
        null
    };
    return Result::<ExpressionStatementNode, ParseError>::Ok(ExpressionStatementNode {
        span: Span::new(start, p.last_end()),
        expression_sequence,
        semicolon,
    });
}

fn parse_if_statement(p: &mut Parser) -> Result<IfStatementNode, ParseError> {
    let start = p.peek().span.start;
    let if_ = p.expect(TK_If)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let expression_sequence = parse_expression_sequence(p)?;
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let statement = parse_statement(p)?;
    let else__statement: Option<ElseStatementItem> = if p.peek_kind() == TK_Else {
        let else_ = p.expect(TK_Else)?;
        let statement = parse_statement(p)?;
        let else__statement = ElseStatementItem {
            else_,
            statement,
        };
        Option::<ElseStatementItem>::Some(else__statement)
    } else {
        null
    };
    return Result::<IfStatementNode, ParseError>::Ok(IfStatementNode {
        span: Span::new(start, p.last_end()),
        if_,
        lparen,
        expression_sequence,
        rparen,
        statement,
        else__statement,
    });
}

fn parse_iteration_statement_bt_3(p: &mut Parser) -> Result<IterationStatementNode, ParseError> {
    let start = p.peek().span.start;
    let for_ = p.expect(TK_For)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let var_modifier = parse_var_modifier(p)?;
    let variable_declaration_list = parse_variable_declaration_list(p)?;
