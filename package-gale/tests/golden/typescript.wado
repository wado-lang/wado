    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let formal_parameter_list: Option<FormalParameterListNode> = if p.peek_kind() matches { TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_LIT_LBRACKET | TK_LIT_LBRACE | TK_Ellipsis } {
            let formal_parameter_list = parse_formal_parameter_list(p)?;
            Option::<FormalParameterListNode>::Some(formal_parameter_list)
        } else {
            null
        };
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::<ArrowFunctionParametersNode, ParseError>::Ok(ArrowFunctionParametersNode::Alt1(ArrowFunctionParametersAlt1 {
            span: Span::new(start, p.last_end()),
            lparen,
            formal_parameter_list,
            rparen,
        }));
    }
    return Result::<ArrowFunctionParametersNode, ParseError>::Err(ParseError::new(
        "expected arrowFunctionParameters",
        p.peek().span,
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_StringLiteral", "TK_DecimalLiteral", "TK_HexIntegerLiteral", "TK_OctalIntegerLiteral", "TK_OctalIntegerLiteral2", "TK_BinaryIntegerLiteral", "TK_LIT_LBRACKET", "TK_LIT_LPAREN"],
    ));
}

fn parse_arrow_function_body_bt_1(p: &mut Parser) -> Result<ArrowFunctionBodyNode, ParseError> {
    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let function_body = parse_function_body(p)?;
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<ArrowFunctionBodyNode, ParseError>::Ok(ArrowFunctionBodyNode::Alt1(ArrowFunctionBodyAlt1 {
        span: Span::new(start, p.last_end()),
        lbrace,
        function_body,
        rbrace,
    }));
}

fn parse_arrow_function_body_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACE { return -1; }
    pos += 1;
    return pos;
}

fn parse_arrow_function_body_bt_0(p: &mut Parser) -> Result<ArrowFunctionBodyNode, ParseError> {
    let start = p.peek().span.start;
    let single_expression = parse_single_expression(p)?;
    return Result::<ArrowFunctionBodyNode, ParseError>::Ok(ArrowFunctionBodyNode::Alt0(ArrowFunctionBodyAlt0 {
        span: Span::new(start, p.last_end()),
        single_expression,
    }));
}

fn parse_arrow_function_body(p: &mut Parser) -> Result<ArrowFunctionBodyNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_LIT_LBRACE | TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        if p.peek_kind() == TK_LIT_LBRACE {
            let saved = p.pos;
            if parse_arrow_function_body_scan_1(&p.tokens, p.pos) >= 0 {
                let r_1 = parse_arrow_function_body_bt_1(p);
                if let Err(_) = r_1 {
                    p.pos = saved;
                } else {
                    return r_1;
                }
            }
            return parse_arrow_function_body_bt_0(p);
        } else if p.peek_kind() matches { TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
            return parse_arrow_function_body_bt_0(p);
        }
    }
    return Result::<ArrowFunctionBodyNode, ParseError>::Err(ParseError::new(
        "expected arrowFunctionBody",
        p.peek().span,
        ["TK_Async", "TK_Function_", "TK_Identifier", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_StringLiteral", "TK_DecimalLiteral", "TK_HexIntegerLiteral", "TK_OctalIntegerLiteral", "TK_OctalIntegerLiteral2", "TK_BinaryIntegerLiteral", "TK_LIT_LBRACKET", "TK_LIT_LPAREN", "TK_LIT_PLUSPLUS", "TK_LIT_MINUSMINUS", "TK_LIT_PLUS", "TK_LIT_MINUS", "TK_LIT_TILDE", "TK_LIT_BANG", "TK_LIT_LBRACE", "TK_YieldStar", "TK_BackTick", "TK_RegularExpressionLiteral", "TK_BigDecimalIntegerLiteral", "TK_BigHexIntegerLiteral", "TK_BigOctalIntegerLiteral", "TK_BigBinaryIntegerLiteral", "TK_LIT_LT"],
    ));
}

fn parse_assignment_operator(p: &mut Parser) -> Result<AssignmentOperatorNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_STAREQ {
        let lit_stareq = p.expect(TK_LIT_STAREQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt0(AssignmentOperatorAlt0 {
            span: Span::new(start, p.last_end()),
            lit_stareq,
        }));
    }
    if kind == TK_LIT_SLASHEQ {
        let lit_slasheq = p.expect(TK_LIT_SLASHEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt1(AssignmentOperatorAlt1 {
            span: Span::new(start, p.last_end()),
            lit_slasheq,
        }));
    }
    if kind == TK_LIT_PERCENTEQ {
        let lit_percenteq = p.expect(TK_LIT_PERCENTEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt2(AssignmentOperatorAlt2 {
            span: Span::new(start, p.last_end()),
            lit_percenteq,
        }));
    }
    if kind == TK_LIT_PLUSEQ {
        let lit_pluseq = p.expect(TK_LIT_PLUSEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt3(AssignmentOperatorAlt3 {
            span: Span::new(start, p.last_end()),
            lit_pluseq,
        }));
    }
    if kind == TK_LIT_MINUSEQ {
        let lit_minuseq = p.expect(TK_LIT_MINUSEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt4(AssignmentOperatorAlt4 {
            span: Span::new(start, p.last_end()),
            lit_minuseq,
        }));
    }
    if kind == TK_LIT_LTLTEQ {
        let lit_ltlteq = p.expect(TK_LIT_LTLTEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt5(AssignmentOperatorAlt5 {
            span: Span::new(start, p.last_end()),
            lit_ltlteq,
        }));
    }
    if kind == TK_LIT_GTGTEQ {
        let lit_gtgteq = p.expect(TK_LIT_GTGTEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt6(AssignmentOperatorAlt6 {
            span: Span::new(start, p.last_end()),
            lit_gtgteq,
        }));
    }
    if kind == TK_LIT_GTGTGTEQ {
        let lit_gtgtgteq = p.expect(TK_LIT_GTGTGTEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt7(AssignmentOperatorAlt7 {
            span: Span::new(start, p.last_end()),
            lit_gtgtgteq,
        }));
    }
    if kind == TK_LIT_AMPEQ {
        let lit_ampeq = p.expect(TK_LIT_AMPEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt8(AssignmentOperatorAlt8 {
            span: Span::new(start, p.last_end()),
            lit_ampeq,
        }));
    }
    if kind == TK_LIT_CARETEQ {
        let lit_careteq = p.expect(TK_LIT_CARETEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt9(AssignmentOperatorAlt9 {
            span: Span::new(start, p.last_end()),
            lit_careteq,
        }));
    }
    if kind == TK_LIT_PIPEEQ {
        let lit_pipeeq = p.expect(TK_LIT_PIPEEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt10(AssignmentOperatorAlt10 {
            span: Span::new(start, p.last_end()),
            lit_pipeeq,
        }));
    }
    if kind == TK_LIT_STARSTAREQ {
        let lit_starstareq = p.expect(TK_LIT_STARSTAREQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt11(AssignmentOperatorAlt11 {
            span: Span::new(start, p.last_end()),
            lit_starstareq,
        }));
    }
    if kind == TK_LIT_QUESTIONQUESTIONEQ {
        let lit_questionquestioneq = p.expect(TK_LIT_QUESTIONQUESTIONEQ)?;
        return Result::<AssignmentOperatorNode, ParseError>::Ok(AssignmentOperatorNode::Alt12(AssignmentOperatorAlt12 {
            span: Span::new(start, p.last_end()),
            lit_questionquestioneq,
        }));
    }
    return Result::<AssignmentOperatorNode, ParseError>::Err(ParseError::new(
        "expected assignmentOperator",
        p.peek().span,
        ["TK_LIT_STAREQ", "TK_LIT_SLASHEQ", "TK_LIT_PERCENTEQ", "TK_LIT_PLUSEQ", "TK_LIT_MINUSEQ", "TK_LIT_LTLTEQ", "TK_LIT_GTGTEQ", "TK_LIT_GTGTGTEQ", "TK_LIT_AMPEQ", "TK_LIT_CARETEQ", "TK_LIT_PIPEEQ", "TK_LIT_STARSTAREQ", "TK_LIT_QUESTIONQUESTIONEQ"],
    ));
}

fn parse_literal(p: &mut Parser) -> Result<LiteralNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_NullLiteral {
        let nullliteral = p.expect(TK_NullLiteral)?;
        return Result::<LiteralNode, ParseError>::Ok(LiteralNode::Alt0(LiteralAlt0 {
            span: Span::new(start, p.last_end()),
            nullliteral,
        }));
    }
    if kind == TK_BooleanLiteral {
        let booleanliteral = p.expect(TK_BooleanLiteral)?;
        return Result::<LiteralNode, ParseError>::Ok(LiteralNode::Alt1(LiteralAlt1 {
            span: Span::new(start, p.last_end()),
            booleanliteral,
        }));
    }
    if kind == TK_StringLiteral {
        let stringliteral = p.expect(TK_StringLiteral)?;
        return Result::<LiteralNode, ParseError>::Ok(LiteralNode::Alt2(LiteralAlt2 {
            span: Span::new(start, p.last_end()),
            stringliteral,
        }));
    }
    if kind == TK_BackTick {
        let template_string_literal = parse_template_string_literal(p)?;
        return Result::<LiteralNode, ParseError>::Ok(LiteralNode::Alt3(LiteralAlt3 {
            span: Span::new(start, p.last_end()),
            template_string_literal,
        }));
    }
    if kind == TK_RegularExpressionLiteral {
        let regularexpressionliteral = p.expect(TK_RegularExpressionLiteral)?;
        return Result::<LiteralNode, ParseError>::Ok(LiteralNode::Alt4(LiteralAlt4 {
            span: Span::new(start, p.last_end()),
            regularexpressionliteral,
        }));
    }
    if kind matches { TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral } {
        let numeric_literal = parse_numeric_literal(p)?;
        return Result::<LiteralNode, ParseError>::Ok(LiteralNode::Alt5(LiteralAlt5 {
            span: Span::new(start, p.last_end()),
            numeric_literal,
        }));
    }
    if kind matches { TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral } {
        let bigint_literal = parse_bigint_literal(p)?;
        return Result::<LiteralNode, ParseError>::Ok(LiteralNode::Alt6(LiteralAlt6 {
            span: Span::new(start, p.last_end()),
            bigint_literal,
        }));
    }
    return Result::<LiteralNode, ParseError>::Err(ParseError::new(
        "expected literal",
        p.peek().span,
        ["TK_NullLiteral", "TK_BooleanLiteral", "TK_StringLiteral", "TK_BackTick", "TK_RegularExpressionLiteral", "TK_DecimalLiteral", "TK_HexIntegerLiteral", "TK_OctalIntegerLiteral", "TK_OctalIntegerLiteral2", "TK_BinaryIntegerLiteral", "TK_BigDecimalIntegerLiteral", "TK_BigHexIntegerLiteral", "TK_BigOctalIntegerLiteral", "TK_BigBinaryIntegerLiteral"],
    ));
}

fn parse_template_string_literal(p: &mut Parser) -> Result<TemplateStringLiteralNode, ParseError> {
    let start = p.peek().span.start;
    let backtick = p.expect(TK_BackTick)?;
    let mut template_string_atom_list: Array<TemplateStringAtomNode> = [];
    while p.peek_kind() matches { TK_TemplateStringAtom | TK_TemplateStringStartExpression | TK_TemplateStringEscapeAtom } {
        let template_string_atom = parse_template_string_atom(p)?;
        template_string_atom_list.push(template_string_atom);
    }
    let backtick_2 = p.expect(TK_BackTick)?;
    return Result::<TemplateStringLiteralNode, ParseError>::Ok(TemplateStringLiteralNode {
        span: Span::new(start, p.last_end()),
        backtick,
        template_string_atom_list,
        backtick_2,
    });
}

fn parse_template_string_atom(p: &mut Parser) -> Result<TemplateStringAtomNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_TemplateStringAtom {
        let templatestringatom = p.expect(TK_TemplateStringAtom)?;
        return Result::<TemplateStringAtomNode, ParseError>::Ok(TemplateStringAtomNode::Alt0(TemplateStringAtomAlt0 {
            span: Span::new(start, p.last_end()),
            templatestringatom,
        }));
    }
    if kind == TK_TemplateStringStartExpression {
        let templatestringstartexpression = p.expect(TK_TemplateStringStartExpression)?;
        let single_expression = parse_single_expression(p)?;
        let templateclosebrace = p.expect(TK_TemplateCloseBrace)?;
        return Result::<TemplateStringAtomNode, ParseError>::Ok(TemplateStringAtomNode::Alt1(TemplateStringAtomAlt1 {
            span: Span::new(start, p.last_end()),
            templatestringstartexpression,
            single_expression,
            templateclosebrace,
        }));
    }
    if kind == TK_TemplateStringEscapeAtom {
        let templatestringescapeatom = p.expect(TK_TemplateStringEscapeAtom)?;
        return Result::<TemplateStringAtomNode, ParseError>::Ok(TemplateStringAtomNode::Alt2(TemplateStringAtomAlt2 {
            span: Span::new(start, p.last_end()),
            templatestringescapeatom,
        }));
    }
    return Result::<TemplateStringAtomNode, ParseError>::Err(ParseError::new(
        "expected templateStringAtom",
        p.peek().span,
        ["TK_TemplateStringAtom", "TK_TemplateStringStartExpression", "TK_TemplateStringEscapeAtom"],
    ));
}

fn parse_numeric_literal(p: &mut Parser) -> Result<NumericLiteralNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_DecimalLiteral {
        let decimalliteral = p.expect(TK_DecimalLiteral)?;
        return Result::<NumericLiteralNode, ParseError>::Ok(NumericLiteralNode::Alt0(NumericLiteralAlt0 {
            span: Span::new(start, p.last_end()),
            decimalliteral,
        }));
    }
    if kind == TK_HexIntegerLiteral {
        let hexintegerliteral = p.expect(TK_HexIntegerLiteral)?;
        return Result::<NumericLiteralNode, ParseError>::Ok(NumericLiteralNode::Alt1(NumericLiteralAlt1 {
            span: Span::new(start, p.last_end()),
            hexintegerliteral,
        }));
    }
    if kind == TK_OctalIntegerLiteral {
        let octalintegerliteral = p.expect(TK_OctalIntegerLiteral)?;
        return Result::<NumericLiteralNode, ParseError>::Ok(NumericLiteralNode::Alt2(NumericLiteralAlt2 {
            span: Span::new(start, p.last_end()),
            octalintegerliteral,
        }));
    }
    if kind == TK_OctalIntegerLiteral2 {
        let octalintegerliteral2 = p.expect(TK_OctalIntegerLiteral2)?;
        return Result::<NumericLiteralNode, ParseError>::Ok(NumericLiteralNode::Alt3(NumericLiteralAlt3 {
            span: Span::new(start, p.last_end()),
            octalintegerliteral2,
        }));
    }
    if kind == TK_BinaryIntegerLiteral {
        let binaryintegerliteral = p.expect(TK_BinaryIntegerLiteral)?;
        return Result::<NumericLiteralNode, ParseError>::Ok(NumericLiteralNode::Alt4(NumericLiteralAlt4 {
            span: Span::new(start, p.last_end()),
            binaryintegerliteral,
        }));
    }
    return Result::<NumericLiteralNode, ParseError>::Err(ParseError::new(
        "expected numericLiteral",
        p.peek().span,
        ["TK_DecimalLiteral", "TK_HexIntegerLiteral", "TK_OctalIntegerLiteral", "TK_OctalIntegerLiteral2", "TK_BinaryIntegerLiteral"],
    ));
}

fn parse_bigint_literal(p: &mut Parser) -> Result<BigintLiteralNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_BigDecimalIntegerLiteral {
        let bigdecimalintegerliteral = p.expect(TK_BigDecimalIntegerLiteral)?;
        return Result::<BigintLiteralNode, ParseError>::Ok(BigintLiteralNode::Alt0(BigintLiteralAlt0 {
            span: Span::new(start, p.last_end()),
            bigdecimalintegerliteral,
        }));
    }
    if kind == TK_BigHexIntegerLiteral {
        let bighexintegerliteral = p.expect(TK_BigHexIntegerLiteral)?;
        return Result::<BigintLiteralNode, ParseError>::Ok(BigintLiteralNode::Alt1(BigintLiteralAlt1 {
            span: Span::new(start, p.last_end()),
            bighexintegerliteral,
        }));
    }
    if kind == TK_BigOctalIntegerLiteral {
        let bigoctalintegerliteral = p.expect(TK_BigOctalIntegerLiteral)?;
        return Result::<BigintLiteralNode, ParseError>::Ok(BigintLiteralNode::Alt2(BigintLiteralAlt2 {
            span: Span::new(start, p.last_end()),
            bigoctalintegerliteral,
        }));
    }
    if kind == TK_BigBinaryIntegerLiteral {
        let bigbinaryintegerliteral = p.expect(TK_BigBinaryIntegerLiteral)?;
        return Result::<BigintLiteralNode, ParseError>::Ok(BigintLiteralNode::Alt3(BigintLiteralAlt3 {
            span: Span::new(start, p.last_end()),
            bigbinaryintegerliteral,
        }));
    }
    return Result::<BigintLiteralNode, ParseError>::Err(ParseError::new(
        "expected bigintLiteral",
        p.peek().span,
        ["TK_BigDecimalIntegerLiteral", "TK_BigHexIntegerLiteral", "TK_BigOctalIntegerLiteral", "TK_BigBinaryIntegerLiteral"],
    ));
}

fn parse_getter(p: &mut Parser) -> Result<GetterNode, ParseError> {
    let start = p.peek().span.start;
    let identifier = parse_identifier(p)?;
    let class_element_name = parse_class_element_name(p)?;
    return Result::<GetterNode, ParseError>::Ok(GetterNode {
        span: Span::new(start, p.last_end()),
        identifier,
        class_element_name,
    });
}

fn parse_setter(p: &mut Parser) -> Result<SetterNode, ParseError> {
    let start = p.peek().span.start;
    let identifier = parse_identifier(p)?;
    let class_element_name = parse_class_element_name(p)?;
    return Result::<SetterNode, ParseError>::Ok(SetterNode {
        span: Span::new(start, p.last_end()),
        identifier,
        class_element_name,
    });
}

fn parse_identifier_name_bt_0(p: &mut Parser) -> Result<IdentifierNameNode, ParseError> {
    let start = p.peek().span.start;
    let identifier = parse_identifier(p)?;
    return Result::<IdentifierNameNode, ParseError>::Ok(IdentifierNameNode::Alt0(IdentifierNameAlt0 {
        span: Span::new(start, p.last_end()),
        identifier,
    }));
}

fn parse_identifier_name_scan_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_identifier(tokens, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn parse_identifier_name_bt_1(p: &mut Parser) -> Result<IdentifierNameNode, ParseError> {
    let start = p.peek().span.start;
    let reserved_word = parse_reserved_word(p)?;
