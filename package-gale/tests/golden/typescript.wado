            type_,
        };
        Option::<AsTypeItem>::Some(as__type_)
    } else {
        null
    };
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let statement = parse_statement(p)?;
    return Result::<IterationStatementNode, ParseError>::Ok(IterationStatementNode::ForVarOfStatement(IterationStatementForVarOfStatement {
        span: Span::new(start, p.last_end()),
        for_,
        await,
        lparen,
        var_modifier,
        variable_declaration,
        identifier,
        expression_sequence,
        as__type_,
        rparen,
        statement,
    }));
}

