pub fn walk_getter<V: Visitor>(v: &mut V, node: &GetterNode) {
    v.enter_rule(&"getter", &node.span);
    walk_identifier(v, &node.identifier);
    walk_classElementName(v, &node.class_element_name);
    v.exit_rule(&"getter", &node.span);
}

pub fn walk_setter<V: Visitor>(v: &mut V, node: &SetterNode) {
    v.enter_rule(&"setter", &node.span);
    walk_identifier(v, &node.identifier);
    walk_classElementName(v, &node.class_element_name);
    v.exit_rule(&"setter", &node.span);
}

pub fn walk_identifierName<V: Visitor>(v: &mut V, node: &IdentifierNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"identifierName", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(&"identifierName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"identifierName", &n.span);
            walk_reservedWord(v, &n.reserved_word);
            v.exit_rule(&"identifierName", &n.span);
        }
    }
}

