fn parse_formal_parameter_list(p: &mut Parser) -> Result<FormalParameterListNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_LIT_LBRACKET | TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_LIT_LBRACE } {
        if p.peek_kind() == TK_LIT_LBRACKET {
            let saved = p.pos;
            let r_2 = parse_formal_parameter_list_bt_2(p);
            if let Err(_) = r_2 {
                p.pos = saved;
            } else {
                return r_2;
            }
            return parse_formal_parameter_list_bt_0(p);
        } else if p.peek_kind() == TK_LIT_LBRACE {
            let saved = p.pos;
            let r_0 = parse_formal_parameter_list_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_formal_parameter_list_bt_3(p);
        } else if p.peek_kind() matches { TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module } {
            return parse_formal_parameter_list_bt_0(p);
        }
    }
    if kind == TK_Ellipsis {
        let last_formal_parameter_arg = parse_last_formal_parameter_arg(p)?;
        return Result::<FormalParameterListNode, ParseError>::Ok(FormalParameterListNode::Alt1(FormalParameterListAlt1 {
            span: Span::new(start, p.last_end()),
            last_formal_parameter_arg,
        }));
    }
    return Result::<FormalParameterListNode, ParseError>::Err(ParseError::new(
        "expected formalParameterList",
        p.peek().span,
        ["TK_LIT_AT", "TK_Public", "TK_Private", "TK_Protected", "TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Interface", "TK_Package", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_LIT_LBRACKET", "TK_LIT_LBRACE", "TK_Ellipsis"],
    ));
}

fn parse_formal_parameter_arg(p: &mut Parser) -> Result<FormalParameterArgNode, ParseError> {
    let start = p.peek().span.start;
    let decorator: Option<DecoratorNode> = if p.peek_kind() == TK_LIT_AT {
        let decorator = parse_decorator(p)?;
        Option::<DecoratorNode>::Some(decorator)
    } else {
        null
    };
    let accessibility_modifier: Option<AccessibilityModifierNode> = null;
    let assignable = parse_assignable(p)?;
    let question: Option<Token> = if p.peek_kind() == TK_LIT_QUESTION {
        let question = p.expect(TK_LIT_QUESTION)?;
        Option::<Token>::Some(question)
    } else {
        null
    };
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    let eq_single_expression: Option<EqSingleExpressionItem> = if p.peek_kind() == TK_LIT_EQ {
        let eq = p.expect(TK_LIT_EQ)?;
        let single_expression = parse_single_expression(p)?;
        let eq_single_expression = EqSingleExpressionItem {
            eq,
            single_expression,
        };
        Option::<EqSingleExpressionItem>::Some(eq_single_expression)
    } else {
        null
    };
    return Result::<FormalParameterArgNode, ParseError>::Ok(FormalParameterArgNode {
        span: Span::new(start, p.last_end()),
        decorator,
        accessibility_modifier,
        assignable,
        question,
        type_annotation,
        eq_single_expression,
    });
}

fn parse_last_formal_parameter_arg(p: &mut Parser) -> Result<LastFormalParameterArgNode, ParseError> {
    let start = p.peek().span.start;
    let ellipsis = p.expect(TK_Ellipsis)?;
    let identifier = parse_identifier(p)?;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    return Result::<LastFormalParameterArgNode, ParseError>::Ok(LastFormalParameterArgNode {
        span: Span::new(start, p.last_end()),
        ellipsis,
        identifier,
        type_annotation,
    });
}

fn parse_function_body(p: &mut Parser) -> Result<FunctionBodyNode, ParseError> {
    let start = p.peek().span.start;
    let source_elements: Option<SourceElementsNode> = if p.peek_kind() matches { TK_Export | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        let source_elements = parse_source_elements(p)?;
        Option::<SourceElementsNode>::Some(source_elements)
    } else {
        null
    };
    return Result::<FunctionBodyNode, ParseError>::Ok(FunctionBodyNode {
        span: Span::new(start, p.last_end()),
        source_elements,
    });
}

fn parse_source_elements(p: &mut Parser) -> Result<SourceElementsNode, ParseError> {
    let start = p.peek().span.start;
    let mut source_element_list: Array<SourceElementNode> = [];
    let mut _plus_first = true;
    while _plus_first || p.peek_kind() matches { TK_Export | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        _plus_first = false;
        let source_element = parse_source_element(p)?;
        source_element_list.push(source_element);
    }
    return Result::<SourceElementsNode, ParseError>::Ok(SourceElementsNode {
        span: Span::new(start, p.last_end()),
        source_element_list,
    });
}

fn parse_array_literal(p: &mut Parser) -> Result<ArrayLiteralNode, ParseError> {
    let start = p.peek().span.start;
    let lbracket = p.expect(TK_LIT_LBRACKET)?;
    let element_list = parse_element_list(p)?;
    let rbracket = p.expect(TK_LIT_RBRACKET)?;
    let lbracket_element_list_rbracket = LbracketElementListRbracketItem {
        lbracket,
        element_list,
        rbracket,
    };
    return Result::<ArrayLiteralNode, ParseError>::Ok(ArrayLiteralNode {
        span: Span::new(start, p.last_end()),
        lbracket_element_list_rbracket,
    });
}

fn parse_element_list(p: &mut Parser) -> Result<ElementListNode, ParseError> {
    let start = p.peek().span.start;
    let mut comma_list: Array<Token> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
            pos += 1;
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        comma_list.push(comma);
    }
    let array_element: Option<ArrayElementNode> = if p.peek_kind() matches { TK_Ellipsis | TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        let array_element = parse_array_element(p)?;
        Option::<ArrayElementNode>::Some(array_element)
    } else {
        null
    };
    let mut comma_array_element_list: Array<CommaListArrayElementItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let mut comma_list: Array<Token> = [];
        let mut _plus_first = true;
        loop {
            if !_plus_first {
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
                    pos += 1;
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
            }
            _plus_first = false;
            let comma = p.expect(TK_LIT_COMMA)?;
            comma_list.push(comma);
        }
        let array_element = parse_array_element(p)?;
        let comma_array_element = CommaListArrayElementItem {
            comma_list,
            array_element,
        };
        comma_array_element_list.push(comma_array_element);
    }
    let mut comma_list_2: Array<Token> = [];
    loop {
        let mut rep_scan_pos_2: i32 = -1;
        rep_scan_2: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan_2; }
            pos += 1;
            if pos <= p.pos { break rep_scan_2; }
            rep_scan_pos_2 = pos;
        }
        if rep_scan_pos_2 < 0 { break; }
        let comma = p.expect(TK_LIT_COMMA)?;
        comma_list_2.push(comma);
    }
    return Result::<ElementListNode, ParseError>::Ok(ElementListNode {
        span: Span::new(start, p.last_end()),
        comma_list,
        array_element,
        comma_array_element_list,
        comma_list_2,
    });
}

fn parse_array_element(p: &mut Parser) -> Result<ArrayElementNode, ParseError> {
    let start = p.peek().span.start;
    let ellipsis: Option<Token> = if p.peek_kind() == TK_Ellipsis {
        let ellipsis = p.expect(TK_Ellipsis)?;
        Option::<Token>::Some(ellipsis)
    } else {
        null
    };
    let mut single_expression_or_identifier_inner: Option<SingleExpressionOrIdentifierGroup> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let opt_r = parse_single_expression(p);
                if let Err(_) = opt_r { p.pos = saved_pos; break bt_try; }
                single_expression_or_identifier_inner = Option::<SingleExpressionOrIdentifierGroup>::Some(SingleExpressionOrIdentifierGroup::SingleExpression(opt_r.unwrap()));
                bt_done = true;
            }
        }
        if !bt_done {
            let identifier = parse_identifier(p)?;
            single_expression_or_identifier_inner = Option::<SingleExpressionOrIdentifierGroup>::Some(SingleExpressionOrIdentifierGroup::Identifier(identifier));
        }
    }
    let single_expression_or_identifier = single_expression_or_identifier_inner;
    let comma: Option<Token> = if p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        Option::<Token>::Some(comma)
    } else {
        null
    };
    return Result::<ArrayElementNode, ParseError>::Ok(ArrayElementNode {
        span: Span::new(start, p.last_end()),
        ellipsis,
        single_expression_or_identifier,
        comma,
    });
}

