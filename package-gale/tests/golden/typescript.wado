fn parse_class_tail(p: &mut Parser) -> Result<ClassTailNode, ParseError> {
    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let mut class_element_list: Array<ClassElementNode> = [];
    while p.peek_kind() matches { TK_Public | TK_Private | TK_Protected | TK_Constructor | TK_LIT_AT | TK_Async | TK_Static | TK_ReadOnly | TK_Abstract | TK_LIT_LBRACKET | TK_LIT_LBRACE | TK_Var | TK_Let | TK_Const | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Namespace | TK_Require | TK_Declare | TK_Import | TK_Export | TK_SemiColon | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        let class_element = parse_class_element(p)?;
        class_element_list.push(class_element);
    }
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<ClassTailNode, ParseError>::Ok(ClassTailNode {
        span: Span::new(start, p.last_end()),
        lbrace,
        class_element_list,
        rbrace,
    });
}

