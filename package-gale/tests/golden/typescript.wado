fn parse_type_body(p: &mut Parser) -> Result<TypeBodyNode, ParseError> {
    let start = p.peek().span.start;
    let type_member_list = parse_type_member_list(p)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        let gp_109 = pos;
        sg_109: {
            pos = gp_109;
            sg_109_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_SemiColon { break sg_109_0; }
                pos += 1;
                break sg_109;
            }
            pos = gp_109;
            sg_109_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_109_1; }
                pos += 1;
                break sg_109;
            }
            break opt_scan;
