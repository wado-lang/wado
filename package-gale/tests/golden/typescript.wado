== TK_BooleanLiteral || p.peek_kind() == TK_StringLiteral || p.peek_kind() == TK_DecimalLiteral || p.peek_kind() == TK_HexIntegerLiteral || p.peek_kind() == TK_OctalIntegerLiteral || p.peek_kind() == TK_OctalIntegerLiteral2 || p.peek_kind() == TK_BinaryIntegerLiteral || p.peek_kind() == TK_LIT_LBRACKET || p.peek_kind() == TK_LIT_STAR || p.peek_kind() == TK_Ellipsis || p.peek_kind() == TK_LIT_LPAREN || p.peek_kind() == TK_LIT_PLUSPLUS || p.peek_kind() == TK_LIT_MINUSMINUS || p.peek_kind() == TK_LIT_PLUS || p.peek_kind() == TK_LIT_MINUS || p.peek_kind() == TK_LIT_TILDE || p.peek_kind() == TK_LIT_BANG || p.peek_kind() == TK_LIT_LBRACE || p.peek_kind() == TK_YieldStar || p.peek_kind() == TK_BackTick || p.peek_kind() == TK_RegularExpressionLiteral || p.peek_kind() == TK_BigDecimalIntegerLiteral || p.peek_kind() == TK_BigHexIntegerLiteral || p.peek_kind() == TK_BigOctalIntegerLiteral || p.peek_kind() == TK_BigBinaryIntegerLiteral || p.peek_kind() == TK_LIT_LT || p.peek_kind() == TK_LIT_DOTDOTDOT) {
