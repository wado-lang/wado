            span: Span::new(start, p.last_end()),
            if_,
        }));
    }
    if kind == TK_Throw {
        let throw = p.expect(TK_Throw)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt22(KeywordAlt22 {
            span: Span::new(start, p.last_end()),
            throw,
        }));
    }
    if kind == TK_Delete {
        let delete = p.expect(TK_Delete)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt23(KeywordAlt23 {
            span: Span::new(start, p.last_end()),
            delete,
        }));
    }
    if kind == TK_In {
        let in_ = p.expect(TK_In)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt24(KeywordAlt24 {
            span: Span::new(start, p.last_end()),
            in_,
        }));
    }
    if kind == TK_Try {
        let try = p.expect(TK_Try)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt25(KeywordAlt25 {
            span: Span::new(start, p.last_end()),
            try,
        }));
    }
    if kind == TK_Class {
        let class = p.expect(TK_Class)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt26(KeywordAlt26 {
            span: Span::new(start, p.last_end()),
            class,
        }));
    }
    if kind == TK_Enum {
        let enum_ = p.expect(TK_Enum)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt27(KeywordAlt27 {
            span: Span::new(start, p.last_end()),
            enum_,
        }));
    }
    if kind == TK_Extends {
        let extends = p.expect(TK_Extends)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt28(KeywordAlt28 {
            span: Span::new(start, p.last_end()),
            extends,
        }));
    }
    if kind == TK_Super {
        let super = p.expect(TK_Super)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt29(KeywordAlt29 {
            span: Span::new(start, p.last_end()),
            super,
        }));
    }
    if kind == TK_Const {
        let const_ = p.expect(TK_Const)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt30(KeywordAlt30 {
            span: Span::new(start, p.last_end()),
            const_,
        }));
    }
    if kind == TK_Export {
        let export_ = p.expect(TK_Export)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt31(KeywordAlt31 {
            span: Span::new(start, p.last_end()),
            export_,
        }));
    }
    if kind == TK_Import {
        let import_ = p.expect(TK_Import)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt32(KeywordAlt32 {
            span: Span::new(start, p.last_end()),
            import_,
        }));
    }
    if kind == TK_Implements {
        let implements = p.expect(TK_Implements)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt33(KeywordAlt33 {
            span: Span::new(start, p.last_end()),
            implements,
        }));
    }
    if kind == TK_Let {
        let let_ = p.expect(TK_Let)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt34(KeywordAlt34 {
            span: Span::new(start, p.last_end()),
            let_,
        }));
    }
    if kind == TK_Private {
        let private = p.expect(TK_Private)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt35(KeywordAlt35 {
            span: Span::new(start, p.last_end()),
            private,
        }));
    }
    if kind == TK_Public {
        let public = p.expect(TK_Public)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt36(KeywordAlt36 {
            span: Span::new(start, p.last_end()),
            public,
        }));
    }
    if kind == TK_Interface {
        let interface = p.expect(TK_Interface)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt37(KeywordAlt37 {
            span: Span::new(start, p.last_end()),
            interface,
        }));
    }
    if kind == TK_Package {
        let package = p.expect(TK_Package)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt38(KeywordAlt38 {
            span: Span::new(start, p.last_end()),
            package,
        }));
    }
    if kind == TK_Protected {
        let protected = p.expect(TK_Protected)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt39(KeywordAlt39 {
            span: Span::new(start, p.last_end()),
            protected,
        }));
    }
    if kind == TK_Static {
        let static = p.expect(TK_Static)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt40(KeywordAlt40 {
            span: Span::new(start, p.last_end()),
            static,
        }));
    }
    if kind == TK_Yield {
        let yield = p.expect(TK_Yield)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt41(KeywordAlt41 {
            span: Span::new(start, p.last_end()),
            yield,
        }));
    }
    if kind == TK_Async {
        let async_ = p.expect(TK_Async)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt42(KeywordAlt42 {
            span: Span::new(start, p.last_end()),
            async_,
        }));
    }
    if kind == TK_Await {
        let await = p.expect(TK_Await)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt43(KeywordAlt43 {
            span: Span::new(start, p.last_end()),
            await,
        }));
    }
    if kind == TK_ReadOnly {
        let readonly = p.expect(TK_ReadOnly)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt44(KeywordAlt44 {
            span: Span::new(start, p.last_end()),
            readonly,
        }));
    }
    if kind == TK_From {
        let from_ = p.expect(TK_From)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt45(KeywordAlt45 {
            span: Span::new(start, p.last_end()),
            from_,
        }));
    }
    if kind == TK_As {
        let as_ = p.expect(TK_As)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt46(KeywordAlt46 {
            span: Span::new(start, p.last_end()),
            as_,
        }));
    }
    if kind == TK_Require {
        let require = p.expect(TK_Require)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt47(KeywordAlt47 {
            span: Span::new(start, p.last_end()),
            require,
        }));
    }
    if kind == TK_TypeAlias {
        let typealias = p.expect(TK_TypeAlias)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt48(KeywordAlt48 {
            span: Span::new(start, p.last_end()),
            typealias,
        }));
    }
    if kind == TK_String {
        let string = p.expect(TK_String)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt49(KeywordAlt49 {
            span: Span::new(start, p.last_end()),
            string,
        }));
    }
    if kind == TK_Boolean {
        let boolean = p.expect(TK_Boolean)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt50(KeywordAlt50 {
            span: Span::new(start, p.last_end()),
            boolean,
        }));
    }
    if kind == TK_Number {
        let number = p.expect(TK_Number)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt51(KeywordAlt51 {
            span: Span::new(start, p.last_end()),
            number,
        }));
    }
    if kind == TK_Module {
        let module = p.expect(TK_Module)?;
        return Result::<KeywordNode, ParseError>::Ok(KeywordNode::Alt52(KeywordAlt52 {
            span: Span::new(start, p.last_end()),
            module,
        }));
    }
    return Result::<KeywordNode, ParseError>::Err(ParseError::new(
        "expected keyword",
        p.peek().span,
        ["TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Yield", "TK_Async", "TK_Await", "TK_ReadOnly", "TK_From", "TK_As", "TK_Require", "TK_TypeAlias", "TK_String", "TK_Boolean", "TK_Number", "TK_Module"],
    ));
}

fn parse_eos(p: &mut Parser) -> Result<EosNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_SemiColon {
        let semicolon = p.expect(TK_SemiColon)?;
        return Result::<EosNode, ParseError>::Ok(EosNode::Alt0(EosAlt0 {
            span: Span::new(start, p.last_end()),
            semicolon,
        }));
    }
    if kind == TK_EOF {
        let eof = p.expect(TK_EOF)?;
        return Result::<EosNode, ParseError>::Ok(EosNode::Alt1(EosAlt1 {
            span: Span::new(start, p.last_end()),
            eof,
        }));
    }
    scope: {
        return Result::<EosNode, ParseError>::Ok(EosNode::Alt2(EosAlt2 {
            span: Span::new(start, p.last_end()),
        }));
    }
    scope: {
        return Result::<EosNode, ParseError>::Ok(EosNode::Alt3(EosAlt3 {
            span: Span::new(start, p.last_end()),
        }));
    }
    return Result::<EosNode, ParseError>::Err(ParseError::new(
        "expected eos",
        p.peek().span,
        ["TK_SemiColon", "TK_EOF"],
    ));
}

pub fn parse(input: &String) -> Result<InitializerNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_initializer(&mut parser);
}

pub fn walk_initializer<V: Visitor>(v: &mut V, node: &InitializerNode) {
    v.enter_rule(&"initializer", &node.span);
    v.visit_token(&node.eq);
    walk_singleExpression(v, &node.single_expression);
    v.exit_rule(&"initializer", &node.span);
}

pub fn walk_bindingPattern<V: Visitor>(v: &mut V, node: &BindingPatternNode) {
    v.enter_rule(&"bindingPattern", &node.span);
    if let Some(item) = &node.array_literal_or_object_literal {
        match item {
            ArrayLiteral(inner) => {
                walk_arrayLiteral(v, inner);
            }
            ObjectLiteral(inner) => {
                walk_objectLiteral(v, inner);
            }
        }
    }
    v.exit_rule(&"bindingPattern", &node.span);
}

pub fn walk_typeParameters<V: Visitor>(v: &mut V, node: &TypeParametersNode) {
    v.enter_rule(&"typeParameters", &node.span);
    v.visit_token(&node.lt);
    if let Some(item) = &node.type_parameter_list {
        walk_typeParameterList(v, item);
    }
    v.visit_token(&node.gt);
    v.exit_rule(&"typeParameters", &node.span);
}

pub fn walk_typeParameterList<V: Visitor>(v: &mut V, node: &TypeParameterListNode) {
    v.enter_rule(&"typeParameterList", &node.span);
    walk_typeParameter(v, &node.type_parameter);
    for let item of &node.comma_type_parameter_list {
        v.visit_token(&item.comma);
        walk_typeParameter(v, &item.type_parameter);
    }
    v.exit_rule(&"typeParameterList", &node.span);
}

pub fn walk_typeParameter<V: Visitor>(v: &mut V, node: &TypeParameterNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"typeParameter", &n.span);
            walk_identifier(v, &n.identifier);
            if let Some(item) = &n.constraint {
                walk_constraint(v, item);
            }
            v.exit_rule(&"typeParameter", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"typeParameter", &n.span);
            walk_identifier(v, &n.identifier);
            v.visit_token(&n.eq);
            walk_typeArgument(v, &n.type_argument);
            v.exit_rule(&"typeParameter", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"typeParameter", &n.span);
            walk_typeParameters(v, &n.type_parameters);
            v.exit_rule(&"typeParameter", &n.span);
        }
    }
}

pub fn walk_constraint<V: Visitor>(v: &mut V, node: &ConstraintNode) {
    v.enter_rule(&"constraint", &node.span);
    v.visit_token(&node.lit_extends);
    walk_type_(v, &node.type_);
    v.exit_rule(&"constraint", &node.span);
}

pub fn walk_typeArguments<V: Visitor>(v: &mut V, node: &TypeArgumentsNode) {
    v.enter_rule(&"typeArguments", &node.span);
    v.visit_token(&node.lt);
    if let Some(item) = &node.type_argument_list {
        walk_typeArgumentList(v, item);
    }
    v.visit_token(&node.gt);
    v.exit_rule(&"typeArguments", &node.span);
}

pub fn walk_typeArgumentList<V: Visitor>(v: &mut V, node: &TypeArgumentListNode) {
    v.enter_rule(&"typeArgumentList", &node.span);
    walk_typeArgument(v, &node.type_argument);
    for let item of &node.comma_type_argument_list {
        v.visit_token(&item.comma);
        walk_typeArgument(v, &item.type_argument);
    }
    v.exit_rule(&"typeArgumentList", &node.span);
}

pub fn walk_typeArgument<V: Visitor>(v: &mut V, node: &TypeArgumentNode) {
    v.enter_rule(&"typeArgument", &node.span);
    walk_type_(v, &node.type_);
    v.exit_rule(&"typeArgument", &node.span);
}

pub fn walk_type_<V: Visitor>(v: &mut V, node: &TypeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"type_", &n.span);
            if let Some(item) = &n.pipe_or_amp {
                v.visit_token(item);
            }
            walk_unionOrIntersectionOrPrimaryType(v, &n.union_or_intersection_or_primary_type);
            v.exit_rule(&"type_", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"type_", &n.span);
            walk_functionType(v, &n.function_type);
            v.exit_rule(&"type_", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"type_", &n.span);
            walk_constructorType(v, &n.constructor_type);
            v.exit_rule(&"type_", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"type_", &n.span);
            walk_typeGeneric(v, &n.type_generic);
            v.exit_rule(&"type_", &n.span);
        }
    }
}

pub fn walk_unionOrIntersectionOrPrimaryType<V: Visitor>(v: &mut V, node: &UnionOrIntersectionOrPrimaryTypeNode) {
    match node {
        Union(n) => {
            v.enter_rule(&"unionOrIntersectionOrPrimaryType", &n.span);
            walk_unionOrIntersectionOrPrimaryType(v, &n.union_or_intersection_or_primary_type);
            v.visit_token(&n.pipe);
            walk_unionOrIntersectionOrPrimaryType(v, &n.union_or_intersection_or_primary_type_2);
            v.exit_rule(&"unionOrIntersectionOrPrimaryType", &n.span);
        }
        Intersection(n) => {
            v.enter_rule(&"unionOrIntersectionOrPrimaryType", &n.span);
            walk_unionOrIntersectionOrPrimaryType(v, &n.union_or_intersection_or_primary_type);
            v.visit_token(&n.amp);
            walk_unionOrIntersectionOrPrimaryType(v, &n.union_or_intersection_or_primary_type_2);
            v.exit_rule(&"unionOrIntersectionOrPrimaryType", &n.span);
        }
        Primary(n) => {
            v.enter_rule(&"unionOrIntersectionOrPrimaryType", &n.span);
            walk_primaryType(v, &n.primary_type);
            v.exit_rule(&"unionOrIntersectionOrPrimaryType", &n.span);
        }
    }
}

pub fn walk_primaryType<V: Visitor>(v: &mut V, node: &PrimaryTypeNode) {
    match node {
        ParenthesizedPrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            v.visit_token(&n.lparen);
            walk_type_(v, &n.type_);
            v.visit_token(&n.rparen);
            v.exit_rule(&"primaryType", &n.span);
        }
        PredefinedPrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            walk_predefinedType(v, &n.predefined_type);
            v.exit_rule(&"primaryType", &n.span);
        }
        ReferencePrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            walk_typeReference(v, &n.type_reference);
            v.exit_rule(&"primaryType", &n.span);
        }
        ObjectPrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            walk_objectType(v, &n.object_type);
            v.exit_rule(&"primaryType", &n.span);
        }
        ArrayPrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            walk_primaryType(v, &n.primary_type);
            v.visit_token(&n.lbracket);
            if let Some(item) = &n.primary_type_2 {
                walk_primaryType(v, item);
            }
            v.visit_token(&n.rbracket);
            v.exit_rule(&"primaryType", &n.span);
        }
        TuplePrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            v.visit_token(&n.lbracket);
            walk_tupleElementTypes(v, &n.tuple_element_types);
            v.visit_token(&n.rbracket);
            v.exit_rule(&"primaryType", &n.span);
        }
        QueryPrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            walk_typeQuery(v, &n.type_query);
            v.exit_rule(&"primaryType", &n.span);
        }
        ThisPrimType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            v.visit_token(&n.this);
            v.exit_rule(&"primaryType", &n.span);
        }
        RedefinitionOfType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            walk_typeReference(v, &n.type_reference);
            v.visit_token(&n.is);
            walk_primaryType(v, &n.primary_type);
            v.exit_rule(&"primaryType", &n.span);
        }
        KeyOfType(n) => {
            v.enter_rule(&"primaryType", &n.span);
            v.visit_token(&n.keyof);
            walk_primaryType(v, &n.primary_type);
            v.exit_rule(&"primaryType", &n.span);
        }
    }
}

pub fn walk_predefinedType<V: Visitor>(v: &mut V, node: &PredefinedTypeNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.any);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.nullliteral);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.number);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.decimalliteral);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.boolean);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.booleanliteral);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.string);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.stringliteral);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            if let Some(item) = &n.unique_ {
                v.visit_token(item);
            }
            v.visit_token(&n.symbol);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.never);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.undefined);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.object);
            v.exit_rule(&"predefinedType", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(&"predefinedType", &n.span);
            v.visit_token(&n.void);
            v.exit_rule(&"predefinedType", &n.span);
        }
    }
}

pub fn walk_typeReference<V: Visitor>(v: &mut V, node: &TypeReferenceNode) {
    v.enter_rule(&"typeReference", &node.span);
    walk_typeName(v, &node.type_name);
    if let Some(item) = &node.type_generic {
        walk_typeGeneric(v, item);
    }
    v.exit_rule(&"typeReference", &node.span);
}

pub fn walk_typeGeneric<V: Visitor>(v: &mut V, node: &TypeGenericNode) {
    v.enter_rule(&"typeGeneric", &node.span);
    v.visit_token(&node.lt);
    walk_typeArgumentList(v, &node.type_argument_list);
    if let Some(item) = &node.type_generic {
        walk_typeGeneric(v, item);
    }
    v.visit_token(&node.gt);
    v.exit_rule(&"typeGeneric", &node.span);
}

pub fn walk_typeName<V: Visitor>(v: &mut V, node: &TypeNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"typeName", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(&"typeName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"typeName", &n.span);
            walk_namespaceName(v, &n.namespace_name);
            v.exit_rule(&"typeName", &n.span);
        }
    }
}

pub fn walk_objectType<V: Visitor>(v: &mut V, node: &ObjectTypeNode) {
    v.enter_rule(&"objectType", &node.span);
    v.visit_token(&node.lbrace);
    if let Some(item) = &node.type_body {
        walk_typeBody(v, item);
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"objectType", &node.span);
}

pub fn walk_typeBody<V: Visitor>(v: &mut V, node: &TypeBodyNode) {
    v.enter_rule(&"typeBody", &node.span);
    walk_typeMemberList(v, &node.type_member_list);
    if let Some(item) = &node.semicolon_or_comma {
        v.visit_token(item);
    }
    v.exit_rule(&"typeBody", &node.span);
}

pub fn walk_typeMemberList<V: Visitor>(v: &mut V, node: &TypeMemberListNode) {
    v.enter_rule(&"typeMemberList", &node.span);
    walk_typeMember(v, &node.type_member);
    for let item of &node.item_type_member_list {
        v.visit_token(&item.semicolon_or_comma);
        walk_typeMember(v, &item.type_member);
    }
    v.exit_rule(&"typeMemberList", &node.span);
}

pub fn walk_typeMember<V: Visitor>(v: &mut V, node: &TypeMemberNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"typeMember", &n.span);
            walk_propertySignatur(v, &n.property_signatur);
            v.exit_rule(&"typeMember", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"typeMember", &n.span);
            walk_callSignature(v, &n.call_signature);
            v.exit_rule(&"typeMember", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"typeMember", &n.span);
            walk_constructSignature(v, &n.construct_signature);
            v.exit_rule(&"typeMember", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"typeMember", &n.span);
            walk_indexSignature(v, &n.index_signature);
            v.exit_rule(&"typeMember", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"typeMember", &n.span);
            walk_methodSignature(v, &n.method_signature);
            if let Some(item) = &n.lit_eqgt_type_ {
                v.visit_token(&item.lit_eqgt);
                walk_type_(v, &item.type_);
            }
            v.exit_rule(&"typeMember", &n.span);
        }
    }
}

pub fn walk_arrayType<V: Visitor>(v: &mut V, node: &ArrayTypeNode) {
    v.enter_rule(&"arrayType", &node.span);
    walk_primaryType(v, &node.primary_type);
    v.visit_token(&node.lbracket);
    v.visit_token(&node.rbracket);
    v.exit_rule(&"arrayType", &node.span);
}

pub fn walk_tupleType<V: Visitor>(v: &mut V, node: &TupleTypeNode) {
    v.enter_rule(&"tupleType", &node.span);
    v.visit_token(&node.lbracket);
    walk_tupleElementTypes(v, &node.tuple_element_types);
    v.visit_token(&node.rbracket);
    v.exit_rule(&"tupleType", &node.span);
}

pub fn walk_tupleElementTypes<V: Visitor>(v: &mut V, node: &TupleElementTypesNode) {
    v.enter_rule(&"tupleElementTypes", &node.span);
    walk_type_(v, &node.type_);
    for let item of &node.comma_type__list {
        v.visit_token(&item.comma);
        walk_type_(v, &item.type_);
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(&"tupleElementTypes", &node.span);
}

pub fn walk_functionType<V: Visitor>(v: &mut V, node: &FunctionTypeNode) {
    v.enter_rule(&"functionType", &node.span);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, item);
    }
    v.visit_token(&node.lparen);
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, item);
    }
    v.visit_token(&node.rparen);
    v.visit_token(&node.lit_eqgt);
    walk_type_(v, &node.type_);
    v.exit_rule(&"functionType", &node.span);
}

pub fn walk_constructorType<V: Visitor>(v: &mut V, node: &ConstructorTypeNode) {
    v.enter_rule(&"constructorType", &node.span);
    v.visit_token(&node.lit_new);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, item);
    }
    v.visit_token(&node.lparen);
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, item);
    }
    v.visit_token(&node.rparen);
    v.visit_token(&node.lit_eqgt);
    walk_type_(v, &node.type_);
    v.exit_rule(&"constructorType", &node.span);
}

pub fn walk_typeQuery<V: Visitor>(v: &mut V, node: &TypeQueryNode) {
    v.enter_rule(&"typeQuery", &node.span);
    v.visit_token(&node.lit_typeof);
    walk_typeQueryExpression(v, &node.type_query_expression);
    v.exit_rule(&"typeQuery", &node.span);
}

pub fn walk_typeQueryExpression<V: Visitor>(v: &mut V, node: &TypeQueryExpressionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"typeQueryExpression", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(&"typeQueryExpression", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"typeQueryExpression", &n.span);
            for let item of &n.identifier_name_dot_list {
                walk_identifierName(v, &item.identifier_name);
                v.visit_token(&item.dot);
            }
            walk_identifierName(v, &n.identifier_name);
            v.exit_rule(&"typeQueryExpression", &n.span);
        }
    }
}

pub fn walk_propertySignatur<V: Visitor>(v: &mut V, node: &PropertySignaturNode) {
    v.enter_rule(&"propertySignatur", &node.span);
    if let Some(item) = &node.readonly {
        v.visit_token(item);
    }
    walk_propertyName(v, &node.property_name);
    if let Some(item) = &node.question {
        v.visit_token(item);
    }
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    if let Some(item) = &node.lit_eqgt_type_ {
        v.visit_token(&item.lit_eqgt);
        walk_type_(v, &item.type_);
    }
    v.exit_rule(&"propertySignatur", &node.span);
}

pub fn walk_typeAnnotation<V: Visitor>(v: &mut V, node: &TypeAnnotationNode) {
    v.enter_rule(&"typeAnnotation", &node.span);
    v.visit_token(&node.colon);
    walk_type_(v, &node.type_);
    v.exit_rule(&"typeAnnotation", &node.span);
}

pub fn walk_callSignature<V: Visitor>(v: &mut V, node: &CallSignatureNode) {
    v.enter_rule(&"callSignature", &node.span);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, item);
    }
    v.visit_token(&node.lparen);
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, item);
    }
    v.visit_token(&node.rparen);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    v.exit_rule(&"callSignature", &node.span);
}

pub fn walk_parameterList<V: Visitor>(v: &mut V, node: &ParameterListNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"parameterList", &n.span);
            walk_restParameter(v, &n.rest_parameter);
            v.exit_rule(&"parameterList", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"parameterList", &n.span);
            walk_parameter(v, &n.parameter);
            for let item of &n.comma_parameter_list {
                v.visit_token(&item.comma);
                walk_parameter(v, &item.parameter);
            }
            if let Some(item) = &n.comma_rest_parameter {
                v.visit_token(&item.comma);
                walk_restParameter(v, &item.rest_parameter);
            }
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.exit_rule(&"parameterList", &n.span);
        }
    }
}

pub fn walk_requiredParameterList<V: Visitor>(v: &mut V, node: &RequiredParameterListNode) {
    v.enter_rule(&"requiredParameterList", &node.span);
    walk_requiredParameter(v, &node.required_parameter);
    for let item of &node.comma_required_parameter_list {
        v.visit_token(&item.comma);
        walk_requiredParameter(v, &item.required_parameter);
    }
    v.exit_rule(&"requiredParameterList", &node.span);
}

pub fn walk_parameter<V: Visitor>(v: &mut V, node: &ParameterNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"parameter", &n.span);
            walk_requiredParameter(v, &n.required_parameter);
            v.exit_rule(&"parameter", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"parameter", &n.span);
            walk_optionalParameter(v, &n.optional_parameter);
            v.exit_rule(&"parameter", &n.span);
        }
    }
}

pub fn walk_optionalParameter<V: Visitor>(v: &mut V, node: &OptionalParameterNode) {
    v.enter_rule(&"optionalParameter", &node.span);
    if let Some(item) = &node.decorator_list {
        walk_decoratorList(v, item);
    }
    if let Some(item) = &node.accessibility_modifier_identifier_or_pattern_item.accessibility_modifier {
        walk_accessibilityModifier(v, item);
    }
    walk_identifierOrPattern(v, &node.accessibility_modifier_identifier_or_pattern_item.identifier_or_pattern);
    if let Some(item) = &node.accessibility_modifier_identifier_or_pattern_item.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.question);
                if let Some(item) = &inner.type_annotation {
                    walk_typeAnnotation(v, item);
                }
            }
            Alt1(inner) => {
                if let Some(item) = &inner.type_annotation {
                    walk_typeAnnotation(v, item);
                }
                walk_initializer(v, &inner.initializer);
            }
        }
    }
    v.exit_rule(&"optionalParameter", &node.span);
}

pub fn walk_restParameter<V: Visitor>(v: &mut V, node: &RestParameterNode) {
    v.enter_rule(&"restParameter", &node.span);
    v.visit_token(&node.lit_dotdotdot);
    walk_singleExpression(v, &node.single_expression);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    v.exit_rule(&"restParameter", &node.span);
}

pub fn walk_requiredParameter<V: Visitor>(v: &mut V, node: &RequiredParameterNode) {
    v.enter_rule(&"requiredParameter", &node.span);
    if let Some(item) = &node.decorator_list {
        walk_decoratorList(v, item);
    }
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, item);
    }
    walk_identifierOrPattern(v, &node.identifier_or_pattern);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    v.exit_rule(&"requiredParameter", &node.span);
}

pub fn walk_accessibilityModifier<V: Visitor>(v: &mut V, node: &AccessibilityModifierNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"accessibilityModifier", &n.span);
            v.visit_token(&n.public);
            v.exit_rule(&"accessibilityModifier", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"accessibilityModifier", &n.span);
            v.visit_token(&n.private);
            v.exit_rule(&"accessibilityModifier", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"accessibilityModifier", &n.span);
            v.visit_token(&n.protected);
            v.exit_rule(&"accessibilityModifier", &n.span);
        }
    }
}

pub fn walk_identifierOrPattern<V: Visitor>(v: &mut V, node: &IdentifierOrPatternNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"identifierOrPattern", &n.span);
            walk_identifierName(v, &n.identifier_name);
            v.exit_rule(&"identifierOrPattern", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"identifierOrPattern", &n.span);
            walk_bindingPattern(v, &n.binding_pattern);
            v.exit_rule(&"identifierOrPattern", &n.span);
        }
    }
}

pub fn walk_constructSignature<V: Visitor>(v: &mut V, node: &ConstructSignatureNode) {
    v.enter_rule(&"constructSignature", &node.span);
    v.visit_token(&node.lit_new);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, item);
    }
    v.visit_token(&node.lparen);
    if let Some(item) = &node.parameter_list {
        walk_parameterList(v, item);
    }
    v.visit_token(&node.rparen);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    v.exit_rule(&"constructSignature", &node.span);
}

pub fn walk_indexSignature<V: Visitor>(v: &mut V, node: &IndexSignatureNode) {
    v.enter_rule(&"indexSignature", &node.span);
    v.visit_token(&node.lbracket);
    walk_identifier(v, &node.identifier);
    v.visit_token(&node.colon);
    v.visit_token(&node.number_or_string);
    v.visit_token(&node.rbracket);
    walk_typeAnnotation(v, &node.type_annotation);
    v.exit_rule(&"indexSignature", &node.span);
}

pub fn walk_methodSignature<V: Visitor>(v: &mut V, node: &MethodSignatureNode) {
    v.enter_rule(&"methodSignature", &node.span);
    walk_propertyName(v, &node.property_name);
    if let Some(item) = &node.question {
        v.visit_token(item);
    }
    walk_callSignature(v, &node.call_signature);
    v.exit_rule(&"methodSignature", &node.span);
}

pub fn walk_typeAliasDeclaration<V: Visitor>(v: &mut V, node: &TypeAliasDeclarationNode) {
    v.enter_rule(&"typeAliasDeclaration", &node.span);
    if let Some(item) = &node.export_ {
        v.visit_token(item);
    }
    v.visit_token(&node.lit_type);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, item);
    }
    v.visit_token(&node.eq);
    walk_type_(v, &node.type_);
    walk_eos(v, &node.eos);
    v.exit_rule(&"typeAliasDeclaration", &node.span);
}

pub fn walk_constructorDeclaration<V: Visitor>(v: &mut V, node: &ConstructorDeclarationNode) {
    v.enter_rule(&"constructorDeclaration", &node.span);
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, item);
    }
    v.visit_token(&node.constructor);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, item);
    }
    v.visit_token(&node.rparen);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.lbrace_function_body_rbrace.lbrace);
                walk_functionBody(v, &inner.lbrace_function_body_rbrace.function_body);
                v.visit_token(&inner.lbrace_function_body_rbrace.rbrace);
            }
            Alt1(inner) => {
                v.visit_token(&inner.semicolon);
            }
        }
    }
    v.exit_rule(&"constructorDeclaration", &node.span);
}

pub fn walk_interfaceDeclaration<V: Visitor>(v: &mut V, node: &InterfaceDeclarationNode) {
    v.enter_rule(&"interfaceDeclaration", &node.span);
    if let Some(item) = &node.export_ {
        v.visit_token(item);
    }
    if let Some(item) = &node.declare {
        v.visit_token(item);
    }
    v.visit_token(&node.interface);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, item);
    }
    if let Some(item) = &node.interface_extends_clause {
        walk_interfaceExtendsClause(v, item);
    }
    walk_objectType(v, &node.object_type);
    if let Some(item) = &node.semicolon {
        v.visit_token(item);
    }
    v.exit_rule(&"interfaceDeclaration", &node.span);
}

pub fn walk_interfaceExtendsClause<V: Visitor>(v: &mut V, node: &InterfaceExtendsClauseNode) {
    v.enter_rule(&"interfaceExtendsClause", &node.span);
    v.visit_token(&node.extends);
    walk_classOrInterfaceTypeList(v, &node.class_or_interface_type_list);
    v.exit_rule(&"interfaceExtendsClause", &node.span);
}

pub fn walk_classOrInterfaceTypeList<V: Visitor>(v: &mut V, node: &ClassOrInterfaceTypeListNode) {
    v.enter_rule(&"classOrInterfaceTypeList", &node.span);
    walk_typeReference(v, &node.type_reference);
    for let item of &node.comma_type_reference_list {
        v.visit_token(&item.comma);
        walk_typeReference(v, &item.type_reference);
    }
    v.exit_rule(&"classOrInterfaceTypeList", &node.span);
}

pub fn walk_enumDeclaration<V: Visitor>(v: &mut V, node: &EnumDeclarationNode) {
    v.enter_rule(&"enumDeclaration", &node.span);
    if let Some(item) = &node.const_ {
        v.visit_token(item);
    }
    v.visit_token(&node.enum_);
    walk_identifier(v, &node.identifier);
    v.visit_token(&node.lbrace);
    if let Some(item) = &node.enum_body {
        walk_enumBody(v, item);
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"enumDeclaration", &node.span);
}

pub fn walk_enumBody<V: Visitor>(v: &mut V, node: &EnumBodyNode) {
    v.enter_rule(&"enumBody", &node.span);
    walk_enumMemberList(v, &node.enum_member_list);
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(&"enumBody", &node.span);
}

pub fn walk_enumMemberList<V: Visitor>(v: &mut V, node: &EnumMemberListNode) {
    v.enter_rule(&"enumMemberList", &node.span);
    walk_enumMember(v, &node.enum_member);
    for let item of &node.comma_enum_member_list {
        v.visit_token(&item.comma);
        walk_enumMember(v, &item.enum_member);
    }
    v.exit_rule(&"enumMemberList", &node.span);
}

pub fn walk_enumMember<V: Visitor>(v: &mut V, node: &EnumMemberNode) {
    v.enter_rule(&"enumMember", &node.span);
    walk_propertyName(v, &node.property_name);
    if let Some(item) = &node.eq_single_expression {
        v.visit_token(&item.eq);
        walk_singleExpression(v, &item.single_expression);
    }
    v.exit_rule(&"enumMember", &node.span);
}

pub fn walk_namespaceDeclaration<V: Visitor>(v: &mut V, node: &NamespaceDeclarationNode) {
    v.enter_rule(&"namespaceDeclaration", &node.span);
    if let Some(item) = &node.declare {
        v.visit_token(item);
    }
    v.visit_token(&node.namespace);
    walk_namespaceName(v, &node.namespace_name);
    v.visit_token(&node.lbrace);
    if let Some(item) = &node.statement_list {
        walk_statementList(v, item);
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"namespaceDeclaration", &node.span);
}

pub fn walk_namespaceName<V: Visitor>(v: &mut V, node: &NamespaceNameNode) {
    v.enter_rule(&"namespaceName", &node.span);
    walk_identifier(v, &node.identifier);
    for let item of &node.dot_identifier_list {
        for let item of &item.dot_list {
            v.visit_token(item);
        }
        walk_identifier(v, &item.identifier);
    }
    v.exit_rule(&"namespaceName", &node.span);
}

pub fn walk_importAliasDeclaration<V: Visitor>(v: &mut V, node: &ImportAliasDeclarationNode) {
    v.enter_rule(&"importAliasDeclaration", &node.span);
    walk_identifier(v, &node.identifier);
    v.visit_token(&node.eq);
    walk_namespaceName(v, &node.namespace_name);
    v.visit_token(&node.semicolon);
    v.exit_rule(&"importAliasDeclaration", &node.span);
}

pub fn walk_decoratorList<V: Visitor>(v: &mut V, node: &DecoratorListNode) {
    v.enter_rule(&"decoratorList", &node.span);
    for let item of &node.decorator_list {
        walk_decorator(v, item);
    }
    v.exit_rule(&"decoratorList", &node.span);
}

pub fn walk_decorator<V: Visitor>(v: &mut V, node: &DecoratorNode) {
    v.enter_rule(&"decorator", &node.span);
    v.visit_token(&node.at);
    if let Some(item) = &node.decorator_member_expression_or_decorator_call_expression {
        match item {
            DecoratorMemberExpression(inner) => {
                walk_decoratorMemberExpression(v, inner);
            }
            DecoratorCallExpression(inner) => {
                walk_decoratorCallExpression(v, inner);
            }
        }
    }
    v.exit_rule(&"decorator", &node.span);
}

pub fn walk_decoratorMemberExpression<V: Visitor>(v: &mut V, node: &DecoratorMemberExpressionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"decoratorMemberExpression", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(&"decoratorMemberExpression", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"decoratorMemberExpression", &n.span);
            walk_decoratorMemberExpression(v, &n.decorator_member_expression);
            v.visit_token(&n.dot);
            walk_identifierName(v, &n.identifier_name);
            v.exit_rule(&"decoratorMemberExpression", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"decoratorMemberExpression", &n.span);
            v.visit_token(&n.lparen);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.rparen);
            v.exit_rule(&"decoratorMemberExpression", &n.span);
        }
    }
}

pub fn walk_decoratorCallExpression<V: Visitor>(v: &mut V, node: &DecoratorCallExpressionNode) {
    v.enter_rule(&"decoratorCallExpression", &node.span);
    walk_decoratorMemberExpression(v, &node.decorator_member_expression);
    walk_arguments(v, &node.arguments);
    v.exit_rule(&"decoratorCallExpression", &node.span);
}

pub fn walk_program<V: Visitor>(v: &mut V, node: &ProgramNode) {
    v.enter_rule(&"program", &node.span);
    if let Some(item) = &node.source_elements {
        walk_sourceElements(v, item);
    }
    v.visit_token(&node.eof);
    v.exit_rule(&"program", &node.span);
}

pub fn walk_sourceElement<V: Visitor>(v: &mut V, node: &SourceElementNode) {
    v.enter_rule(&"sourceElement", &node.span);
    if let Some(item) = &node.export_ {
        v.visit_token(item);
    }
    walk_statement(v, &node.statement);
    v.exit_rule(&"sourceElement", &node.span);
}

pub fn walk_statement<V: Visitor>(v: &mut V, node: &StatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_block(v, &n.block);
            v.exit_rule(&"statement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_variableStatement(v, &n.variable_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_importStatement(v, &n.import_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_exportStatement(v, &n.export_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_emptyStatement_(v, &n.empty_statement_);
            v.exit_rule(&"statement", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_abstractDeclaration(v, &n.abstract_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_classDeclaration(v, &n.class_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_functionDeclaration(v, &n.function_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_expressionStatement(v, &n.expression_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_interfaceDeclaration(v, &n.interface_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_namespaceDeclaration(v, &n.namespace_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_ifStatement(v, &n.if_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_iterationStatement(v, &n.iteration_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_continueStatement(v, &n.continue_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt14(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_breakStatement(v, &n.break_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt15(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_returnStatement(v, &n.return_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt16(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_yieldStatement(v, &n.yield_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt17(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_withStatement(v, &n.with_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt18(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_labelledStatement(v, &n.labelled_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt19(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_switchStatement(v, &n.switch_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt20(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_throwStatement(v, &n.throw_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt21(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_tryStatement(v, &n.try_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt22(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_debuggerStatement(v, &n.debugger_statement);
            v.exit_rule(&"statement", &n.span);
        }
        Alt23(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_arrowFunctionDeclaration(v, &n.arrow_function_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt24(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_generatorFunctionDeclaration(v, &n.generator_function_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt25(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_typeAliasDeclaration(v, &n.type_alias_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt26(n) => {
            v.enter_rule(&"statement", &n.span);
            walk_enumDeclaration(v, &n.enum_declaration);
            v.exit_rule(&"statement", &n.span);
        }
        Alt27(n) => {
            v.enter_rule(&"statement", &n.span);
            v.visit_token(&n.export_);
            walk_statement(v, &n.statement);
            v.exit_rule(&"statement", &n.span);
        }
    }
}

pub fn walk_block<V: Visitor>(v: &mut V, node: &BlockNode) {
    v.enter_rule(&"block", &node.span);
    v.visit_token(&node.lbrace);
    if let Some(item) = &node.statement_list {
        walk_statementList(v, item);
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"block", &node.span);
}

pub fn walk_statementList<V: Visitor>(v: &mut V, node: &StatementListNode) {
    v.enter_rule(&"statementList", &node.span);
    for let item of &node.statement_list {
        walk_statement(v, item);
    }
    v.exit_rule(&"statementList", &node.span);
}

pub fn walk_abstractDeclaration<V: Visitor>(v: &mut V, node: &AbstractDeclarationNode) {
    v.enter_rule(&"abstractDeclaration", &node.span);
    v.visit_token(&node.abstract);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_identifier(v, &inner.identifier);
                walk_callSignature(v, &inner.call_signature);
            }
            Alt1(inner) => {
                walk_variableStatement(v, &inner.variable_statement);
            }
        }
    }
    walk_eos(v, &node.eos);
    v.exit_rule(&"abstractDeclaration", &node.span);
}

pub fn walk_importStatement<V: Visitor>(v: &mut V, node: &ImportStatementNode) {
    v.enter_rule(&"importStatement", &node.span);
    v.visit_token(&node.import_);
    walk_importFromBlock(v, &node.import_from_block);
    v.exit_rule(&"importStatement", &node.span);
}

pub fn walk_importFromBlock<V: Visitor>(v: &mut V, node: &ImportFromBlockNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"importFromBlock", &n.span);
            if let Some(item) = &n.import_default {
                walk_importDefault(v, item);
            }
            if let Some(item) = &n.import_namespace_or_import_module_items {
                match item {
                    ImportNamespace(inner) => {
                        walk_importNamespace(v, inner);
                    }
                    ImportModuleItems(inner) => {
                        walk_importModuleItems(v, inner);
                    }
                }
            }
            walk_importFrom(v, &n.import_from);
            walk_eos(v, &n.eos);
            v.exit_rule(&"importFromBlock", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"importFromBlock", &n.span);
            v.visit_token(&n.stringliteral);
            walk_eos(v, &n.eos);
            v.exit_rule(&"importFromBlock", &n.span);
        }
    }
}

pub fn walk_importModuleItems<V: Visitor>(v: &mut V, node: &ImportModuleItemsNode) {
    v.enter_rule(&"importModuleItems", &node.span);
    v.visit_token(&node.lbrace);
    for let item of &node.import_alias_name_comma_list {
        walk_importAliasName(v, &item.import_alias_name);
        v.visit_token(&item.comma);
    }
    if let Some(item) = &node.import_alias_name_comma {
        walk_importAliasName(v, &item.import_alias_name);
        if let Some(item) = &item.comma {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"importModuleItems", &node.span);
}

pub fn walk_importAliasName<V: Visitor>(v: &mut V, node: &ImportAliasNameNode) {
    v.enter_rule(&"importAliasName", &node.span);
    walk_moduleExportName(v, &node.module_export_name);
    if let Some(item) = &node.as__imported_binding {
        v.visit_token(&item.as_);
        walk_importedBinding(v, &item.imported_binding);
    }
    v.exit_rule(&"importAliasName", &node.span);
}

pub fn walk_moduleExportName<V: Visitor>(v: &mut V, node: &ModuleExportNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"moduleExportName", &n.span);
            walk_identifierName(v, &n.identifier_name);
            v.exit_rule(&"moduleExportName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"moduleExportName", &n.span);
            v.visit_token(&n.stringliteral);
            v.exit_rule(&"moduleExportName", &n.span);
        }
    }
}

pub fn walk_importedBinding<V: Visitor>(v: &mut V, node: &ImportedBindingNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"importedBinding", &n.span);
            v.visit_token(&n.identifier);
            v.exit_rule(&"importedBinding", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"importedBinding", &n.span);
            v.visit_token(&n.yield);
            v.exit_rule(&"importedBinding", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"importedBinding", &n.span);
            v.visit_token(&n.await);
            v.exit_rule(&"importedBinding", &n.span);
        }
    }
}

pub fn walk_importDefault<V: Visitor>(v: &mut V, node: &ImportDefaultNode) {
    v.enter_rule(&"importDefault", &node.span);
    walk_aliasName(v, &node.alias_name);
    v.visit_token(&node.comma);
    v.exit_rule(&"importDefault", &node.span);
}

pub fn walk_importNamespace<V: Visitor>(v: &mut V, node: &ImportNamespaceNode) {
    v.enter_rule(&"importNamespace", &node.span);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.star);
            }
            Alt1(inner) => {
                walk_identifierName(v, &inner.identifier_name);
            }
        }
    }
    if let Some(item) = &node.as__identifier_name {
        v.visit_token(&item.as_);
        walk_identifierName(v, &item.identifier_name);
    }
    v.exit_rule(&"importNamespace", &node.span);
}

pub fn walk_importFrom<V: Visitor>(v: &mut V, node: &ImportFromNode) {
    v.enter_rule(&"importFrom", &node.span);
    v.visit_token(&node.from_);
    v.visit_token(&node.stringliteral);
    v.exit_rule(&"importFrom", &node.span);
}

pub fn walk_aliasName<V: Visitor>(v: &mut V, node: &AliasNameNode) {
    v.enter_rule(&"aliasName", &node.span);
    walk_identifierName(v, &node.identifier_name);
    if let Some(item) = &node.as__identifier_name {
        v.visit_token(&item.as_);
        walk_identifierName(v, &item.identifier_name);
    }
    v.exit_rule(&"aliasName", &node.span);
}

pub fn walk_exportStatement<V: Visitor>(v: &mut V, node: &ExportStatementNode) {
    match node {
        ExportDeclaration(n) => {
            v.enter_rule(&"exportStatement", &n.span);
            v.visit_token(&n.export_);
            if let Some(item) = &n.default {
                v.visit_token(item);
            }
            if let Some(item) = &n.export_from_block_or_declaration {
                match item {
                    ExportFromBlock(inner) => {
                        walk_exportFromBlock(v, inner);
                    }
                    Declaration(inner) => {
                        walk_declaration(v, inner);
                    }
                }
            }
            walk_eos(v, &n.eos);
            v.exit_rule(&"exportStatement", &n.span);
        }
        ExportDefaultDeclaration(n) => {
            v.enter_rule(&"exportStatement", &n.span);
            v.visit_token(&n.export_);
            v.visit_token(&n.default);
            walk_singleExpression(v, &n.single_expression);
            walk_eos(v, &n.eos);
            v.exit_rule(&"exportStatement", &n.span);
        }
    }
}

pub fn walk_exportFromBlock<V: Visitor>(v: &mut V, node: &ExportFromBlockNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"exportFromBlock", &n.span);
            walk_importNamespace(v, &n.import_namespace);
            walk_importFrom(v, &n.import_from);
            walk_eos(v, &n.eos);
            v.exit_rule(&"exportFromBlock", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"exportFromBlock", &n.span);
            walk_exportModuleItems(v, &n.export_module_items);
            if let Some(item) = &n.import_from {
                walk_importFrom(v, item);
            }
            walk_eos(v, &n.eos);
            v.exit_rule(&"exportFromBlock", &n.span);
        }
    }
}

pub fn walk_exportModuleItems<V: Visitor>(v: &mut V, node: &ExportModuleItemsNode) {
    v.enter_rule(&"exportModuleItems", &node.span);
    v.visit_token(&node.lbrace);
    for let item of &node.export_alias_name_comma_list {
        walk_exportAliasName(v, &item.export_alias_name);
        v.visit_token(&item.comma);
    }
    if let Some(item) = &node.export_alias_name_comma {
        walk_exportAliasName(v, &item.export_alias_name);
        if let Some(item) = &item.comma {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"exportModuleItems", &node.span);
}

pub fn walk_exportAliasName<V: Visitor>(v: &mut V, node: &ExportAliasNameNode) {
    v.enter_rule(&"exportAliasName", &node.span);
    walk_moduleExportName(v, &node.module_export_name);
    if let Some(item) = &node.as__module_export_name {
        v.visit_token(&item.as_);
        walk_moduleExportName(v, &item.module_export_name);
    }
    v.exit_rule(&"exportAliasName", &node.span);
}

pub fn walk_declaration<V: Visitor>(v: &mut V, node: &DeclarationNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"declaration", &n.span);
            walk_variableStatement(v, &n.variable_statement);
            v.exit_rule(&"declaration", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"declaration", &n.span);
            walk_classDeclaration(v, &n.class_declaration);
            v.exit_rule(&"declaration", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"declaration", &n.span);
            walk_functionDeclaration(v, &n.function_declaration);
            v.exit_rule(&"declaration", &n.span);
        }
    }
}

pub fn walk_variableStatement<V: Visitor>(v: &mut V, node: &VariableStatementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"variableStatement", &n.span);
            walk_bindingPattern(v, &n.binding_pattern);
            if let Some(item) = &n.type_annotation {
                walk_typeAnnotation(v, item);
            }
            walk_initializer(v, &n.initializer);
            if let Some(item) = &n.semicolon {
                v.visit_token(item);
            }
            v.exit_rule(&"variableStatement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"variableStatement", &n.span);
            if let Some(item) = &n.accessibility_modifier {
                walk_accessibilityModifier(v, item);
            }
            if let Some(item) = &n.var_modifier {
                walk_varModifier(v, item);
            }
            if let Some(item) = &n.readonly {
                v.visit_token(item);
            }
            walk_variableDeclarationList(v, &n.variable_declaration_list);
            if let Some(item) = &n.semicolon {
                v.visit_token(item);
            }
            v.exit_rule(&"variableStatement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"variableStatement", &n.span);
            v.visit_token(&n.declare);
            if let Some(item) = &n.var_modifier {
                walk_varModifier(v, item);
            }
            walk_variableDeclarationList(v, &n.variable_declaration_list);
            if let Some(item) = &n.semicolon {
                v.visit_token(item);
            }
            v.exit_rule(&"variableStatement", &n.span);
        }
    }
}

pub fn walk_variableDeclarationList<V: Visitor>(v: &mut V, node: &VariableDeclarationListNode) {
    v.enter_rule(&"variableDeclarationList", &node.span);
    walk_variableDeclaration(v, &node.variable_declaration);
    for let item of &node.comma_variable_declaration_list {
        v.visit_token(&item.comma);
        walk_variableDeclaration(v, &item.variable_declaration);
    }
    v.exit_rule(&"variableDeclarationList", &node.span);
}

pub fn walk_variableDeclaration<V: Visitor>(v: &mut V, node: &VariableDeclarationNode) {
    v.enter_rule(&"variableDeclaration", &node.span);
    if let Some(item) = &node.identifier_or_key_word_or_array_literal_or_object_literal {
        match item {
            IdentifierOrKeyWord(inner) => {
                walk_identifierOrKeyWord(v, inner);
            }
            ArrayLiteral(inner) => {
                walk_arrayLiteral(v, inner);
            }
            ObjectLiteral(inner) => {
                walk_objectLiteral(v, inner);
            }
        }
    }
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    if let Some(item) = &node.single_expression {
        walk_singleExpression(v, item);
    }
    if let Some(item) = &node.eq_type_parameters_single_expression {
        v.visit_token(&item.eq);
        if let Some(item) = &item.type_parameters {
            walk_typeParameters(v, item);
        }
        walk_singleExpression(v, &item.single_expression);
    }
    v.exit_rule(&"variableDeclaration", &node.span);
}

pub fn walk_emptyStatement_<V: Visitor>(v: &mut V, node: &EmptyStatementNode) {
    v.enter_rule(&"emptyStatement_", &node.span);
    v.visit_token(&node.semicolon);
    v.exit_rule(&"emptyStatement_", &node.span);
}

pub fn walk_expressionStatement<V: Visitor>(v: &mut V, node: &ExpressionStatementNode) {
    v.enter_rule(&"expressionStatement", &node.span);
    walk_expressionSequence(v, &node.expression_sequence);
    if let Some(item) = &node.semicolon {
        v.visit_token(item);
    }
    v.exit_rule(&"expressionStatement", &node.span);
}

pub fn walk_ifStatement<V: Visitor>(v: &mut V, node: &IfStatementNode) {
    v.enter_rule(&"ifStatement", &node.span);
    v.visit_token(&node.if_);
    v.visit_token(&node.lparen);
    walk_expressionSequence(v, &node.expression_sequence);
    v.visit_token(&node.rparen);
    walk_statement(v, &node.statement);
    if let Some(item) = &node.else__statement {
        v.visit_token(&item.else_);
        walk_statement(v, &item.statement);
    }
    v.exit_rule(&"ifStatement", &node.span);
}

pub fn walk_iterationStatement<V: Visitor>(v: &mut V, node: &IterationStatementNode) {
    match node {
        DoStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.do);
            walk_statement(v, &n.statement);
            v.visit_token(&n.while_);
            v.visit_token(&n.lparen);
            walk_expressionSequence(v, &n.expression_sequence);
            v.visit_token(&n.rparen);
            walk_eos(v, &n.eos);
            v.exit_rule(&"iterationStatement", &n.span);
        }
        WhileStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.while_);
            v.visit_token(&n.lparen);
            walk_expressionSequence(v, &n.expression_sequence);
            v.visit_token(&n.rparen);
            walk_statement(v, &n.statement);
            v.exit_rule(&"iterationStatement", &n.span);
        }
        ForStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.for_);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expression_sequence {
                walk_expressionSequence(v, item);
            }
            v.visit_token(&n.semicolon);
            if let Some(item) = &n.expression_sequence_2 {
                walk_expressionSequence(v, item);
            }
            v.visit_token(&n.semicolon_2);
            if let Some(item) = &n.expression_sequence_3 {
                walk_expressionSequence(v, item);
            }
            v.visit_token(&n.rparen);
            walk_statement(v, &n.statement);
            v.exit_rule(&"iterationStatement", &n.span);
        }
        ForVarStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.for_);
            v.visit_token(&n.lparen);
            walk_varModifier(v, &n.var_modifier);
            walk_variableDeclarationList(v, &n.variable_declaration_list);
            v.visit_token(&n.semicolon);
            if let Some(item) = &n.expression_sequence {
                walk_expressionSequence(v, item);
            }
            v.visit_token(&n.semicolon_2);
            if let Some(item) = &n.expression_sequence_2 {
                walk_expressionSequence(v, item);
            }
            v.visit_token(&n.rparen);
            walk_statement(v, &n.statement);
            v.exit_rule(&"iterationStatement", &n.span);
        }
        ForInStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.for_);
            v.visit_token(&n.lparen);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.in_);
            walk_expressionSequence(v, &n.expression_sequence);
            v.visit_token(&n.rparen);
            walk_statement(v, &n.statement);
            v.exit_rule(&"iterationStatement", &n.span);
        }
        ForVarInStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.for_);
            v.visit_token(&n.lparen);
            walk_varModifier(v, &n.var_modifier);
            walk_variableDeclaration(v, &n.variable_declaration);
            v.visit_token(&n.in_);
            walk_expressionSequence(v, &n.expression_sequence);
            v.visit_token(&n.rparen);
            walk_statement(v, &n.statement);
            v.exit_rule(&"iterationStatement", &n.span);
        }
        ForOfStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.for_);
            if let Some(item) = &n.await {
                v.visit_token(item);
            }
            v.visit_token(&n.lparen);
            walk_singleExpression(v, &n.single_expression);
            walk_identifier(v, &n.identifier);
            walk_expressionSequence(v, &n.expression_sequence);
            if let Some(item) = &n.as__type_ {
                v.visit_token(&item.as_);
                walk_type_(v, &item.type_);
            }
            v.visit_token(&n.rparen);
            walk_statement(v, &n.statement);
            v.exit_rule(&"iterationStatement", &n.span);
        }
        ForVarOfStatement(n) => {
            v.enter_rule(&"iterationStatement", &n.span);
            v.visit_token(&n.for_);
            if let Some(item) = &n.await {
                v.visit_token(item);
            }
            v.visit_token(&n.lparen);
            walk_varModifier(v, &n.var_modifier);
            walk_variableDeclaration(v, &n.variable_declaration);
            walk_identifier(v, &n.identifier);
            walk_expressionSequence(v, &n.expression_sequence);
            if let Some(item) = &n.as__type_ {
                v.visit_token(&item.as_);
                walk_type_(v, &item.type_);
            }
            v.visit_token(&n.rparen);
            walk_statement(v, &n.statement);
            v.exit_rule(&"iterationStatement", &n.span);
        }
    }
}

pub fn walk_varModifier<V: Visitor>(v: &mut V, node: &VarModifierNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"varModifier", &n.span);
            v.visit_token(&n.var);
            v.exit_rule(&"varModifier", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"varModifier", &n.span);
            v.visit_token(&n.let_);
            v.exit_rule(&"varModifier", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"varModifier", &n.span);
            v.visit_token(&n.const_);
            v.exit_rule(&"varModifier", &n.span);
        }
    }
}

pub fn walk_continueStatement<V: Visitor>(v: &mut V, node: &ContinueStatementNode) {
    v.enter_rule(&"continueStatement", &node.span);
    v.visit_token(&node.continue_);
    walk_eos(v, &node.eos);
    v.exit_rule(&"continueStatement", &node.span);
}

pub fn walk_breakStatement<V: Visitor>(v: &mut V, node: &BreakStatementNode) {
    v.enter_rule(&"breakStatement", &node.span);
    v.visit_token(&node.break_);
    walk_eos(v, &node.eos);
    v.exit_rule(&"breakStatement", &node.span);
}

pub fn walk_returnStatement<V: Visitor>(v: &mut V, node: &ReturnStatementNode) {
    v.enter_rule(&"returnStatement", &node.span);
    v.visit_token(&node.return_);
    walk_eos(v, &node.eos);
    v.exit_rule(&"returnStatement", &node.span);
}

pub fn walk_yieldStatement<V: Visitor>(v: &mut V, node: &YieldStatementNode) {
    v.enter_rule(&"yieldStatement", &node.span);
    v.visit_token(&node.yield_or_yieldstar);
    walk_eos(v, &node.eos);
    v.exit_rule(&"yieldStatement", &node.span);
}

pub fn walk_withStatement<V: Visitor>(v: &mut V, node: &WithStatementNode) {
    v.enter_rule(&"withStatement", &node.span);
    v.visit_token(&node.with_);
    v.visit_token(&node.lparen);
    walk_expressionSequence(v, &node.expression_sequence);
    v.visit_token(&node.rparen);
    walk_statement(v, &node.statement);
    v.exit_rule(&"withStatement", &node.span);
}

pub fn walk_switchStatement<V: Visitor>(v: &mut V, node: &SwitchStatementNode) {
    v.enter_rule(&"switchStatement", &node.span);
    v.visit_token(&node.switch);
    v.visit_token(&node.lparen);
    walk_expressionSequence(v, &node.expression_sequence);
    v.visit_token(&node.rparen);
    walk_caseBlock(v, &node.case_block);
    v.exit_rule(&"switchStatement", &node.span);
}

pub fn walk_caseBlock<V: Visitor>(v: &mut V, node: &CaseBlockNode) {
    v.enter_rule(&"caseBlock", &node.span);
    v.visit_token(&node.lbrace);
    if let Some(item) = &node.case_clauses {
        walk_caseClauses(v, item);
    }
    if let Some(item) = &node.default_clause_case_clauses {
        walk_defaultClause(v, &item.default_clause);
        if let Some(item) = &item.case_clauses {
            walk_caseClauses(v, item);
        }
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"caseBlock", &node.span);
}

pub fn walk_caseClauses<V: Visitor>(v: &mut V, node: &CaseClausesNode) {
    v.enter_rule(&"caseClauses", &node.span);
    for let item of &node.case_clause_list {
        walk_caseClause(v, item);
    }
    v.exit_rule(&"caseClauses", &node.span);
}

pub fn walk_caseClause<V: Visitor>(v: &mut V, node: &CaseClauseNode) {
    v.enter_rule(&"caseClause", &node.span);
    v.visit_token(&node.case);
    walk_expressionSequence(v, &node.expression_sequence);
    v.visit_token(&node.colon);
    if let Some(item) = &node.statement_list {
        walk_statementList(v, item);
    }
    v.exit_rule(&"caseClause", &node.span);
}

pub fn walk_defaultClause<V: Visitor>(v: &mut V, node: &DefaultClauseNode) {
    v.enter_rule(&"defaultClause", &node.span);
    v.visit_token(&node.default);
    v.visit_token(&node.colon);
    if let Some(item) = &node.statement_list {
        walk_statementList(v, item);
    }
    v.exit_rule(&"defaultClause", &node.span);
}

pub fn walk_labelledStatement<V: Visitor>(v: &mut V, node: &LabelledStatementNode) {
    v.enter_rule(&"labelledStatement", &node.span);
    walk_identifier(v, &node.identifier);
    v.visit_token(&node.colon);
    walk_statement(v, &node.statement);
    v.exit_rule(&"labelledStatement", &node.span);
}

pub fn walk_throwStatement<V: Visitor>(v: &mut V, node: &ThrowStatementNode) {
    v.enter_rule(&"throwStatement", &node.span);
    v.visit_token(&node.throw);
    walk_expressionSequence(v, &node.expression_sequence);
    walk_eos(v, &node.eos);
    v.exit_rule(&"throwStatement", &node.span);
}

pub fn walk_tryStatement<V: Visitor>(v: &mut V, node: &TryStatementNode) {
    v.enter_rule(&"tryStatement", &node.span);
    v.visit_token(&node.try);
    walk_block(v, &node.block);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_catchProduction(v, &inner.catch_production);
                if let Some(item) = &inner.finally_production {
                    walk_finallyProduction(v, item);
                }
            }
            Alt1(inner) => {
                walk_finallyProduction(v, &inner.finally_production);
            }
        }
    }
    v.exit_rule(&"tryStatement", &node.span);
}

pub fn walk_catchProduction<V: Visitor>(v: &mut V, node: &CatchProductionNode) {
    v.enter_rule(&"catchProduction", &node.span);
    v.visit_token(&node.catch);
    if let Some(item) = &node.lparen_identifier_type_annotation_rparen {
        v.visit_token(&item.lparen);
        walk_identifier(v, &item.identifier);
        if let Some(item) = &item.type_annotation {
            walk_typeAnnotation(v, item);
        }
        v.visit_token(&item.rparen);
    }
    walk_block(v, &node.block);
    v.exit_rule(&"catchProduction", &node.span);
}

pub fn walk_finallyProduction<V: Visitor>(v: &mut V, node: &FinallyProductionNode) {
    v.enter_rule(&"finallyProduction", &node.span);
    v.visit_token(&node.finally);
    walk_block(v, &node.block);
    v.exit_rule(&"finallyProduction", &node.span);
}

pub fn walk_debuggerStatement<V: Visitor>(v: &mut V, node: &DebuggerStatementNode) {
    v.enter_rule(&"debuggerStatement", &node.span);
    v.visit_token(&node.debugger);
    walk_eos(v, &node.eos);
    v.exit_rule(&"debuggerStatement", &node.span);
}

pub fn walk_functionDeclaration<V: Visitor>(v: &mut V, node: &FunctionDeclarationNode) {
    v.enter_rule(&"functionDeclaration", &node.span);
    if let Some(item) = &node.async_ {
        v.visit_token(item);
    }
    v.visit_token(&node.function_);
    if let Some(item) = &node.star {
        v.visit_token(item);
    }
    walk_identifier(v, &node.identifier);
    walk_callSignature(v, &node.call_signature);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.lbrace_function_body_rbrace.lbrace);
                walk_functionBody(v, &inner.lbrace_function_body_rbrace.function_body);
                v.visit_token(&inner.lbrace_function_body_rbrace.rbrace);
            }
            Alt1(inner) => {
                v.visit_token(&inner.semicolon);
            }
        }
    }
    v.exit_rule(&"functionDeclaration", &node.span);
}

pub fn walk_classDeclaration<V: Visitor>(v: &mut V, node: &ClassDeclarationNode) {
    v.enter_rule(&"classDeclaration", &node.span);
    if let Some(item) = &node.decorator_list {
        walk_decoratorList(v, item);
    }
    if let Some(item) = &node.export__default {
        v.visit_token(&item.export_);
        if let Some(item) = &item.default {
            v.visit_token(item);
        }
    }
    if let Some(item) = &node.abstract {
        v.visit_token(item);
    }
    v.visit_token(&node.class);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.type_parameters {
        walk_typeParameters(v, item);
    }
    walk_classHeritage(v, &node.class_heritage);
    walk_classTail(v, &node.class_tail);
    v.exit_rule(&"classDeclaration", &node.span);
}

pub fn walk_classHeritage<V: Visitor>(v: &mut V, node: &ClassHeritageNode) {
    v.enter_rule(&"classHeritage", &node.span);
    if let Some(item) = &node.class_extends_clause {
        walk_classExtendsClause(v, item);
    }
    if let Some(item) = &node.implements_clause {
        walk_implementsClause(v, item);
    }
    v.exit_rule(&"classHeritage", &node.span);
}

pub fn walk_classTail<V: Visitor>(v: &mut V, node: &ClassTailNode) {
    v.enter_rule(&"classTail", &node.span);
    v.visit_token(&node.lbrace);
    for let item of &node.class_element_list {
        walk_classElement(v, item);
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"classTail", &node.span);
}

pub fn walk_classExtendsClause<V: Visitor>(v: &mut V, node: &ClassExtendsClauseNode) {
    v.enter_rule(&"classExtendsClause", &node.span);
    v.visit_token(&node.extends);
    walk_typeReference(v, &node.type_reference);
    v.exit_rule(&"classExtendsClause", &node.span);
}

pub fn walk_implementsClause<V: Visitor>(v: &mut V, node: &ImplementsClauseNode) {
    v.enter_rule(&"implementsClause", &node.span);
    v.visit_token(&node.implements);
    walk_classOrInterfaceTypeList(v, &node.class_or_interface_type_list);
    v.exit_rule(&"implementsClause", &node.span);
}

pub fn walk_classElement<V: Visitor>(v: &mut V, node: &ClassElementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"classElement", &n.span);
            walk_constructorDeclaration(v, &n.constructor_declaration);
            v.exit_rule(&"classElement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"classElement", &n.span);
            if let Some(item) = &n.decorator_list {
                walk_decoratorList(v, item);
            }
            walk_propertyMemberDeclaration(v, &n.property_member_declaration);
            v.exit_rule(&"classElement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"classElement", &n.span);
            walk_indexMemberDeclaration(v, &n.index_member_declaration);
            v.exit_rule(&"classElement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"classElement", &n.span);
            walk_statement(v, &n.statement);
            v.exit_rule(&"classElement", &n.span);
        }
    }
}

pub fn walk_propertyMemberDeclaration<V: Visitor>(v: &mut V, node: &PropertyMemberDeclarationNode) {
    match node {
        PropertyDeclarationExpression(n) => {
            v.enter_rule(&"propertyMemberDeclaration", &n.span);
            walk_propertyMemberBase(v, &n.property_member_base);
            walk_propertyName(v, &n.property_name);
            if let Some(item) = &n.question {
                v.visit_token(item);
            }
            if let Some(item) = &n.type_annotation {
                walk_typeAnnotation(v, item);
            }
            if let Some(item) = &n.initializer {
                walk_initializer(v, item);
            }
            v.visit_token(&n.semicolon);
            v.exit_rule(&"propertyMemberDeclaration", &n.span);
        }
        MethodDeclarationExpression(n) => {
            v.enter_rule(&"propertyMemberDeclaration", &n.span);
            walk_propertyMemberBase(v, &n.property_member_base);
            walk_propertyName(v, &n.property_name);
            walk_callSignature(v, &n.call_signature);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.lbrace_function_body_rbrace.lbrace);
                        walk_functionBody(v, &inner.lbrace_function_body_rbrace.function_body);
                        v.visit_token(&inner.lbrace_function_body_rbrace.rbrace);
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.semicolon);
                    }
                }
            }
            v.exit_rule(&"propertyMemberDeclaration", &n.span);
        }
        GetterSetterDeclarationExpression(n) => {
            v.enter_rule(&"propertyMemberDeclaration", &n.span);
            walk_propertyMemberBase(v, &n.property_member_base);
            if let Some(item) = &n.get_accessor_or_set_accessor {
                match item {
                    GetAccessor(inner) => {
                        walk_getAccessor(v, inner);
                    }
                    SetAccessor(inner) => {
                        walk_setAccessor(v, inner);
                    }
                }
            }
            v.exit_rule(&"propertyMemberDeclaration", &n.span);
        }
        AbstractMemberDeclaration(n) => {
            v.enter_rule(&"propertyMemberDeclaration", &n.span);
            walk_abstractDeclaration(v, &n.abstract_declaration);
            v.exit_rule(&"propertyMemberDeclaration", &n.span);
        }
    }
}

pub fn walk_propertyMemberBase<V: Visitor>(v: &mut V, node: &PropertyMemberBaseNode) {
    v.enter_rule(&"propertyMemberBase", &node.span);
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, item);
    }
    if let Some(item) = &node.async_ {
        v.visit_token(item);
    }
    if let Some(item) = &node.static {
        v.visit_token(item);
    }
    if let Some(item) = &node.readonly {
        v.visit_token(item);
    }
    v.exit_rule(&"propertyMemberBase", &node.span);
}

pub fn walk_indexMemberDeclaration<V: Visitor>(v: &mut V, node: &IndexMemberDeclarationNode) {
    v.enter_rule(&"indexMemberDeclaration", &node.span);
    walk_indexSignature(v, &node.index_signature);
    v.visit_token(&node.semicolon);
    v.exit_rule(&"indexMemberDeclaration", &node.span);
}

pub fn walk_generatorMethod<V: Visitor>(v: &mut V, node: &GeneratorMethodNode) {
    v.enter_rule(&"generatorMethod", &node.span);
    if let Some(item) = &node.star {
        v.visit_token(item);
    }
    walk_propertyName(v, &node.property_name);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, item);
    }
    v.visit_token(&node.rparen);
    v.visit_token(&node.lbrace);
    walk_functionBody(v, &node.function_body);
    v.visit_token(&node.rbrace);
    v.exit_rule(&"generatorMethod", &node.span);
}

pub fn walk_generatorFunctionDeclaration<V: Visitor>(v: &mut V, node: &GeneratorFunctionDeclarationNode) {
    v.enter_rule(&"generatorFunctionDeclaration", &node.span);
    if let Some(item) = &node.async_ {
        v.visit_token(item);
    }
    v.visit_token(&node.function_);
    v.visit_token(&node.star);
    if let Some(item) = &node.identifier {
        walk_identifier(v, item);
    }
    v.visit_token(&node.lparen);
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, item);
    }
    v.visit_token(&node.rparen);
    v.visit_token(&node.lbrace);
    walk_functionBody(v, &node.function_body);
    v.visit_token(&node.rbrace);
    v.exit_rule(&"generatorFunctionDeclaration", &node.span);
}

pub fn walk_generatorBlock<V: Visitor>(v: &mut V, node: &GeneratorBlockNode) {
    v.enter_rule(&"generatorBlock", &node.span);
    v.visit_token(&node.lbrace);
    walk_generatorDefinition(v, &node.generator_definition);
    for let item of &node.comma_generator_definition_list {
        v.visit_token(&item.comma);
        walk_generatorDefinition(v, &item.generator_definition);
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"generatorBlock", &node.span);
}

pub fn walk_generatorDefinition<V: Visitor>(v: &mut V, node: &GeneratorDefinitionNode) {
    v.enter_rule(&"generatorDefinition", &node.span);
    v.visit_token(&node.star);
    walk_iteratorDefinition(v, &node.iterator_definition);
    v.exit_rule(&"generatorDefinition", &node.span);
}

pub fn walk_iteratorBlock<V: Visitor>(v: &mut V, node: &IteratorBlockNode) {
    v.enter_rule(&"iteratorBlock", &node.span);
    v.visit_token(&node.lbrace);
    walk_iteratorDefinition(v, &node.iterator_definition);
    for let item of &node.comma_iterator_definition_list {
        v.visit_token(&item.comma);
        walk_iteratorDefinition(v, &item.iterator_definition);
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"iteratorBlock", &node.span);
}

pub fn walk_iteratorDefinition<V: Visitor>(v: &mut V, node: &IteratorDefinitionNode) {
    v.enter_rule(&"iteratorDefinition", &node.span);
    v.visit_token(&node.lbracket);
    walk_singleExpression(v, &node.single_expression);
    v.visit_token(&node.rbracket);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, item);
    }
    v.visit_token(&node.rparen);
    v.visit_token(&node.lbrace);
    walk_functionBody(v, &node.function_body);
    v.visit_token(&node.rbrace);
    v.exit_rule(&"iteratorDefinition", &node.span);
}

pub fn walk_classElementName<V: Visitor>(v: &mut V, node: &ClassElementNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"classElementName", &n.span);
            walk_propertyName(v, &n.property_name);
            v.exit_rule(&"classElementName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"classElementName", &n.span);
            walk_privateIdentifier(v, &n.private_identifier);
            v.exit_rule(&"classElementName", &n.span);
        }
    }
}

pub fn walk_privateIdentifier<V: Visitor>(v: &mut V, node: &PrivateIdentifierNode) {
    v.enter_rule(&"privateIdentifier", &node.span);
    v.visit_token(&node.hash);
    walk_identifierName(v, &node.identifier_name);
    v.exit_rule(&"privateIdentifier", &node.span);
}

pub fn walk_formalParameterList<V: Visitor>(v: &mut V, node: &FormalParameterListNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"formalParameterList", &n.span);
            walk_formalParameterArg(v, &n.formal_parameter_arg);
            for let item of &n.comma_formal_parameter_arg_list {
                v.visit_token(&item.comma);
                walk_formalParameterArg(v, &item.formal_parameter_arg);
            }
            if let Some(item) = &n.comma_last_formal_parameter_arg {
                v.visit_token(&item.comma);
                walk_lastFormalParameterArg(v, &item.last_formal_parameter_arg);
            }
            if let Some(item) = &n.comma {
                v.visit_token(item);
            }
            v.exit_rule(&"formalParameterList", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"formalParameterList", &n.span);
            walk_lastFormalParameterArg(v, &n.last_formal_parameter_arg);
            v.exit_rule(&"formalParameterList", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"formalParameterList", &n.span);
            walk_arrayLiteral(v, &n.array_literal);
            v.exit_rule(&"formalParameterList", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"formalParameterList", &n.span);
            walk_objectLiteral(v, &n.object_literal);
            if let Some(item) = &n.colon_formal_parameter_list {
                v.visit_token(&item.colon);
                walk_formalParameterList(v, &item.formal_parameter_list);
            }
            v.exit_rule(&"formalParameterList", &n.span);
        }
    }
}

pub fn walk_formalParameterArg<V: Visitor>(v: &mut V, node: &FormalParameterArgNode) {
    v.enter_rule(&"formalParameterArg", &node.span);
    if let Some(item) = &node.decorator {
        walk_decorator(v, item);
    }
    if let Some(item) = &node.accessibility_modifier {
        walk_accessibilityModifier(v, item);
    }
    walk_assignable(v, &node.assignable);
    if let Some(item) = &node.question {
        v.visit_token(item);
    }
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    if let Some(item) = &node.eq_single_expression {
        v.visit_token(&item.eq);
        walk_singleExpression(v, &item.single_expression);
    }
    v.exit_rule(&"formalParameterArg", &node.span);
}

pub fn walk_lastFormalParameterArg<V: Visitor>(v: &mut V, node: &LastFormalParameterArgNode) {
    v.enter_rule(&"lastFormalParameterArg", &node.span);
    v.visit_token(&node.ellipsis);
    walk_identifier(v, &node.identifier);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    v.exit_rule(&"lastFormalParameterArg", &node.span);
}

pub fn walk_functionBody<V: Visitor>(v: &mut V, node: &FunctionBodyNode) {
    v.enter_rule(&"functionBody", &node.span);
    if let Some(item) = &node.source_elements {
        walk_sourceElements(v, item);
    }
    v.exit_rule(&"functionBody", &node.span);
}

pub fn walk_sourceElements<V: Visitor>(v: &mut V, node: &SourceElementsNode) {
    v.enter_rule(&"sourceElements", &node.span);
    for let item of &node.source_element_list {
        walk_sourceElement(v, item);
    }
    v.exit_rule(&"sourceElements", &node.span);
}

pub fn walk_arrayLiteral<V: Visitor>(v: &mut V, node: &ArrayLiteralNode) {
    v.enter_rule(&"arrayLiteral", &node.span);
    v.visit_token(&node.lbracket_element_list_rbracket.lbracket);
    walk_elementList(v, &node.lbracket_element_list_rbracket.element_list);
    v.visit_token(&node.lbracket_element_list_rbracket.rbracket);
    v.exit_rule(&"arrayLiteral", &node.span);
}

pub fn walk_elementList<V: Visitor>(v: &mut V, node: &ElementListNode) {
    v.enter_rule(&"elementList", &node.span);
    for let item of &node.comma_list {
        v.visit_token(item);
    }
    if let Some(item) = &node.array_element {
        walk_arrayElement(v, item);
    }
    for let item of &node.comma_array_element_list {
        for let item of &item.comma_list {
            v.visit_token(item);
        }
        walk_arrayElement(v, &item.array_element);
    }
    for let item of &node.comma_list_2 {
        v.visit_token(item);
    }
    v.exit_rule(&"elementList", &node.span);
}

pub fn walk_arrayElement<V: Visitor>(v: &mut V, node: &ArrayElementNode) {
    v.enter_rule(&"arrayElement", &node.span);
    if let Some(item) = &node.ellipsis {
        v.visit_token(item);
    }
    if let Some(item) = &node.single_expression_or_identifier {
        match item {
            SingleExpression(inner) => {
                walk_singleExpression(v, inner);
            }
            Identifier(inner) => {
                walk_identifier(v, inner);
            }
        }
    }
    if let Some(item) = &node.comma {
        v.visit_token(item);
    }
    v.exit_rule(&"arrayElement", &node.span);
}

pub fn walk_objectLiteral<V: Visitor>(v: &mut V, node: &ObjectLiteralNode) {
    v.enter_rule(&"objectLiteral", &node.span);
    v.visit_token(&node.lbrace);
    if let Some(item) = &node.property_assignment_item_comma {
        walk_propertyAssignment(v, &item.property_assignment);
        for let item of &item.comma_property_assignment_list {
            v.visit_token(&item.comma);
            walk_propertyAssignment(v, &item.property_assignment);
        }
        if let Some(item) = &item.comma {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.rbrace);
    v.exit_rule(&"objectLiteral", &node.span);
}

pub fn walk_propertyAssignment<V: Visitor>(v: &mut V, node: &PropertyAssignmentNode) {
    match node {
        PropertyExpressionAssignment(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            walk_propertyName(v, &n.property_name);
            v.visit_token(&n.colon_or_eq);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
        ComputedPropertyExpressionAssignment(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            v.visit_token(&n.lbracket);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.rbracket);
            v.visit_token(&n.colon);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
        PropertyGetter(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            walk_getAccessor(v, &n.get_accessor);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
        PropertySetter(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            walk_setAccessor(v, &n.set_accessor);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
        MethodProperty(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            walk_generatorMethod(v, &n.generator_method);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
        PropertyShorthand(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            walk_identifierOrKeyWord(v, &n.identifier_or_key_word);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
        SpreadOperator(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            if let Some(item) = &n.ellipsis {
                v.visit_token(item);
            }
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
        RestParameterInObject(n) => {
            v.enter_rule(&"propertyAssignment", &n.span);
            walk_restParameter(v, &n.rest_parameter);
            v.exit_rule(&"propertyAssignment", &n.span);
        }
    }
}

pub fn walk_getAccessor<V: Visitor>(v: &mut V, node: &GetAccessorNode) {
    v.enter_rule(&"getAccessor", &node.span);
    walk_getter(v, &node.getter);
    v.visit_token(&node.lparen);
    v.visit_token(&node.rparen);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    v.visit_token(&node.lbrace);
    walk_functionBody(v, &node.function_body);
    v.visit_token(&node.rbrace);
    v.exit_rule(&"getAccessor", &node.span);
}

pub fn walk_setAccessor<V: Visitor>(v: &mut V, node: &SetAccessorNode) {
    v.enter_rule(&"setAccessor", &node.span);
    walk_setter(v, &node.setter);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.formal_parameter_list {
        walk_formalParameterList(v, item);
    }
    v.visit_token(&node.rparen);
    v.visit_token(&node.lbrace);
    walk_functionBody(v, &node.function_body);
    v.visit_token(&node.rbrace);
    v.exit_rule(&"setAccessor", &node.span);
}

pub fn walk_propertyName<V: Visitor>(v: &mut V, node: &PropertyNameNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"propertyName", &n.span);
            walk_identifierName(v, &n.identifier_name);
            v.exit_rule(&"propertyName", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"propertyName", &n.span);
            v.visit_token(&n.stringliteral);
            v.exit_rule(&"propertyName", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"propertyName", &n.span);
            walk_numericLiteral(v, &n.numeric_literal);
            v.exit_rule(&"propertyName", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"propertyName", &n.span);
            v.visit_token(&n.lbracket);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.rbracket);
            v.exit_rule(&"propertyName", &n.span);
        }
    }
}

pub fn walk_arguments<V: Visitor>(v: &mut V, node: &ArgumentsNode) {
    v.enter_rule(&"arguments", &node.span);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.argument_list_comma {
        walk_argumentList(v, &item.argument_list);
        if let Some(item) = &item.comma {
            v.visit_token(item);
        }
    }
    v.visit_token(&node.rparen);
    v.exit_rule(&"arguments", &node.span);
}

pub fn walk_argumentList<V: Visitor>(v: &mut V, node: &ArgumentListNode) {
    v.enter_rule(&"argumentList", &node.span);
    walk_argument(v, &node.argument);
    for let item of &node.comma_argument_list {
        v.visit_token(&item.comma);
        walk_argument(v, &item.argument);
    }
    v.exit_rule(&"argumentList", &node.span);
}

pub fn walk_argument<V: Visitor>(v: &mut V, node: &ArgumentNode) {
    v.enter_rule(&"argument", &node.span);
    if let Some(item) = &node.ellipsis {
        v.visit_token(item);
    }
    if let Some(item) = &node.single_expression_or_identifier {
        match item {
            SingleExpression(inner) => {
                walk_singleExpression(v, inner);
            }
            Identifier(inner) => {
                walk_identifier(v, inner);
            }
        }
    }
    v.exit_rule(&"argument", &node.span);
}

pub fn walk_expressionSequence<V: Visitor>(v: &mut V, node: &ExpressionSequenceNode) {
    v.enter_rule(&"expressionSequence", &node.span);
    walk_singleExpression(v, &node.single_expression);
    for let item of &node.comma_single_expression_list {
        v.visit_token(&item.comma);
        walk_singleExpression(v, &item.single_expression);
    }
    v.exit_rule(&"expressionSequence", &node.span);
}

pub fn walk_singleExpression<V: Visitor>(v: &mut V, node: &SingleExpressionNode) {
    match node {
        FunctionExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_anonymousFunction(v, &n.anonymous_function);
            v.exit_rule(&"singleExpression", &n.span);
        }
        ClassExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.class);
            if let Some(item) = &n.identifier {
                walk_identifier(v, item);
            }
            if let Some(item) = &n.type_parameters {
                walk_typeParameters(v, item);
            }
            walk_classHeritage(v, &n.class_heritage);
            walk_classTail(v, &n.class_tail);
            v.exit_rule(&"singleExpression", &n.span);
        }
        MemberIndexExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            if let Some(item) = &n.lit_questiondot {
                v.visit_token(item);
            }
            v.visit_token(&n.lbracket);
            walk_expressionSequence(v, &n.expression_sequence);
            v.visit_token(&n.rbracket);
            v.exit_rule(&"singleExpression", &n.span);
        }
        OptionalChainExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_questiondot);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        MemberDotExpression0(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            if let Some(item) = &n.bang {
                v.visit_token(item);
            }
            v.visit_token(&n.dot);
            if let Some(item) = &n.hash {
                v.visit_token(item);
            }
            walk_identifierName(v, &n.identifier_name);
            if let Some(item) = &n.type_generic {
                walk_typeGeneric(v, item);
            }
            v.exit_rule(&"singleExpression", &n.span);
        }
        MemberDotExpression1(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            if let Some(item) = &n.question {
                v.visit_token(item);
            }
            v.visit_token(&n.dot);
            if let Some(item) = &n.hash {
                v.visit_token(item);
            }
            walk_identifierName(v, &n.identifier_name);
            if let Some(item) = &n.type_generic {
                walk_typeGeneric(v, item);
            }
            v.exit_rule(&"singleExpression", &n.span);
        }
        NewExpression0(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.new);
            walk_singleExpression(v, &n.single_expression);
            if let Some(item) = &n.type_arguments {
                walk_typeArguments(v, item);
            }
            walk_arguments(v, &n.arguments);
            v.exit_rule(&"singleExpression", &n.span);
        }
        NewExpression1(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.new);
            walk_singleExpression(v, &n.single_expression);
            if let Some(item) = &n.type_arguments {
                walk_typeArguments(v, item);
            }
            v.exit_rule(&"singleExpression", &n.span);
        }
        ArgumentsExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            walk_arguments(v, &n.arguments);
            v.exit_rule(&"singleExpression", &n.span);
        }
        PostIncrementExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_plusplus);
            v.exit_rule(&"singleExpression", &n.span);
        }
        PostDecreaseExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_minusminus);
            v.exit_rule(&"singleExpression", &n.span);
        }
        DeleteExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.delete);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        VoidExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.void);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        TypeofExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.typeof);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        PreIncrementExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.lit_plusplus);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        PreDecreaseExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.lit_minusminus);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        UnaryPlusExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.plus);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        UnaryMinusExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.minus);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        BitNotExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.tilde);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        NotExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.bang);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        AwaitExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.await);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        PowerExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_starstar);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        MultiplicativeExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.star_or_slash_or_percent);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        AdditiveExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.plus_or_minus);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        CoalesceExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_questionquestion);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        BitShiftExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.lit_ltlt);
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.gt);
                        v.visit_token(&inner.gt_2);
                    }
                    Alt2(inner) => {
                        v.visit_token(&inner.gt);
                        v.visit_token(&inner.gt_2);
                        v.visit_token(&inner.gt_3);
                    }
                }
            }
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        RelationalExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lt_or_gt_or_lit_lteq_or_lit_gteq);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        InstanceofExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.instanceof);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        InExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.in_);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        EqualityExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_eqeq_or_lit_bangeq_or_lit_eqeqeq_or_lit_bangeqeq);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        BitAndExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.amp);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        BitXOrExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.caret);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        BitOrExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.pipe);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        LogicalAndExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_ampamp);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        LogicalOrExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.lit_pipepipe);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        TernaryExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.question);
            walk_singleExpression(v, &n.single_expression_2);
            v.visit_token(&n.colon);
            walk_singleExpression(v, &n.single_expression_3);
            v.exit_rule(&"singleExpression", &n.span);
        }
        AssignmentExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.eq);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        AssignmentOperatorExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            walk_assignmentOperator(v, &n.assignment_operator);
            walk_singleExpression(v, &n.single_expression_2);
            v.exit_rule(&"singleExpression", &n.span);
        }
        TemplateStringExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            walk_templateStringLiteral(v, &n.template_string_literal);
            v.exit_rule(&"singleExpression", &n.span);
        }
        IteratorsExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_iteratorBlock(v, &n.iterator_block);
            v.exit_rule(&"singleExpression", &n.span);
        }
        GeneratorsExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_generatorBlock(v, &n.generator_block);
            v.exit_rule(&"singleExpression", &n.span);
        }
        GeneratorsFunctionExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_generatorFunctionDeclaration(v, &n.generator_function_declaration);
            v.exit_rule(&"singleExpression", &n.span);
        }
        YieldExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_yieldStatement(v, &n.yield_statement);
            v.exit_rule(&"singleExpression", &n.span);
        }
        ThisExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.this);
            v.exit_rule(&"singleExpression", &n.span);
        }
        IdentifierExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_identifierName(v, &n.identifier_name);
            if let Some(item) = &n.single_expression {
                walk_singleExpression(v, item);
            }
            v.exit_rule(&"singleExpression", &n.span);
        }
        SuperExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.super);
            v.exit_rule(&"singleExpression", &n.span);
        }
        LiteralExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_literal(v, &n.literal);
            v.exit_rule(&"singleExpression", &n.span);
        }
        ArrayLiteralExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_arrayLiteral(v, &n.array_literal);
            v.exit_rule(&"singleExpression", &n.span);
        }
        ObjectLiteralExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_objectLiteral(v, &n.object_literal);
            v.exit_rule(&"singleExpression", &n.span);
        }
        ParenthesizedExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            v.visit_token(&n.lparen);
            walk_expressionSequence(v, &n.expression_sequence);
            v.visit_token(&n.rparen);
            v.exit_rule(&"singleExpression", &n.span);
        }
        GenericTypes(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_typeArguments(v, &n.type_arguments);
            if let Some(item) = &n.expression_sequence {
                walk_expressionSequence(v, item);
            }
            v.exit_rule(&"singleExpression", &n.span);
        }
        CastAsExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.as_);
            walk_asExpression(v, &n.as_expression);
            v.exit_rule(&"singleExpression", &n.span);
        }
        NonNullAssertionExpression(n) => {
            v.enter_rule(&"singleExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.bang);
            v.exit_rule(&"singleExpression", &n.span);
        }
    }
}

pub fn walk_asExpression<V: Visitor>(v: &mut V, node: &AsExpressionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"asExpression", &n.span);
            walk_predefinedType(v, &n.predefined_type);
            if let Some(item) = &n.lbracket_rbracket {
                v.visit_token(&item.lbracket);
                v.visit_token(&item.rbracket);
            }
            v.exit_rule(&"asExpression", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"asExpression", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"asExpression", &n.span);
        }
    }
}

pub fn walk_assignable<V: Visitor>(v: &mut V, node: &AssignableNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"assignable", &n.span);
            walk_identifier(v, &n.identifier);
            v.exit_rule(&"assignable", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"assignable", &n.span);
            walk_keyword(v, &n.keyword);
            v.exit_rule(&"assignable", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"assignable", &n.span);
            walk_arrayLiteral(v, &n.array_literal);
            v.exit_rule(&"assignable", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"assignable", &n.span);
            walk_objectLiteral(v, &n.object_literal);
            v.exit_rule(&"assignable", &n.span);
        }
    }
}

pub fn walk_anonymousFunction<V: Visitor>(v: &mut V, node: &AnonymousFunctionNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"anonymousFunction", &n.span);
            walk_functionDeclaration(v, &n.function_declaration);
            v.exit_rule(&"anonymousFunction", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"anonymousFunction", &n.span);
            if let Some(item) = &n.async_ {
                v.visit_token(item);
            }
            v.visit_token(&n.function_);
            if let Some(item) = &n.star {
                v.visit_token(item);
            }
            v.visit_token(&n.lparen);
            if let Some(item) = &n.formal_parameter_list {
                walk_formalParameterList(v, item);
            }
            v.visit_token(&n.rparen);
            if let Some(item) = &n.type_annotation {
                walk_typeAnnotation(v, item);
            }
            v.visit_token(&n.lbrace);
            walk_functionBody(v, &n.function_body);
            v.visit_token(&n.rbrace);
            v.exit_rule(&"anonymousFunction", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"anonymousFunction", &n.span);
            walk_arrowFunctionDeclaration(v, &n.arrow_function_declaration);
            v.exit_rule(&"anonymousFunction", &n.span);
        }
    }
}

pub fn walk_arrowFunctionDeclaration<V: Visitor>(v: &mut V, node: &ArrowFunctionDeclarationNode) {
    v.enter_rule(&"arrowFunctionDeclaration", &node.span);
    if let Some(item) = &node.async_ {
        v.visit_token(item);
    }
    walk_arrowFunctionParameters(v, &node.arrow_function_parameters);
    if let Some(item) = &node.type_annotation {
        walk_typeAnnotation(v, item);
    }
    v.visit_token(&node.lit_eqgt);
    walk_arrowFunctionBody(v, &node.arrow_function_body);
    v.exit_rule(&"arrowFunctionDeclaration", &node.span);
}

pub fn walk_arrowFunctionParameters<V: Visitor>(v: &mut V, node: &ArrowFunctionParametersNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"arrowFunctionParameters", &n.span);
            walk_propertyName(v, &n.property_name);
            v.exit_rule(&"arrowFunctionParameters", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"arrowFunctionParameters", &n.span);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.formal_parameter_list {
                walk_formalParameterList(v, item);
            }
            v.visit_token(&n.rparen);
            v.exit_rule(&"arrowFunctionParameters", &n.span);
        }
    }
}

pub fn walk_arrowFunctionBody<V: Visitor>(v: &mut V, node: &ArrowFunctionBodyNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"arrowFunctionBody", &n.span);
            walk_singleExpression(v, &n.single_expression);
            v.exit_rule(&"arrowFunctionBody", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"arrowFunctionBody", &n.span);
            v.visit_token(&n.lbrace);
            walk_functionBody(v, &n.function_body);
            v.visit_token(&n.rbrace);
            v.exit_rule(&"arrowFunctionBody", &n.span);
        }
    }
}

pub fn walk_assignmentOperator<V: Visitor>(v: &mut V, node: &AssignmentOperatorNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_stareq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_slasheq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_percenteq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_pluseq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_minuseq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_ltlteq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_gtgteq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_gtgtgteq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_ampeq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_careteq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_pipeeq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_starstareq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(&"assignmentOperator", &n.span);
            v.visit_token(&n.lit_questionquestioneq);
            v.exit_rule(&"assignmentOperator", &n.span);
        }
    }
}

pub fn walk_literal<V: Visitor>(v: &mut V, node: &LiteralNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"literal", &n.span);
            v.visit_token(&n.nullliteral);
            v.exit_rule(&"literal", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"literal", &n.span);
            v.visit_token(&n.booleanliteral);
            v.exit_rule(&"literal", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"literal", &n.span);
            v.visit_token(&n.stringliteral);
            v.exit_rule(&"literal", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"literal", &n.span);
            walk_templateStringLiteral(v, &n.template_string_literal);
            v.exit_rule(&"literal", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"literal", &n.span);
            v.visit_token(&n.regularexpressionliteral);
            v.exit_rule(&"literal", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"literal", &n.span);
            walk_numericLiteral(v, &n.numeric_literal);
            v.exit_rule(&"literal", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"literal", &n.span);
            walk_bigintLiteral(v, &n.bigint_literal);
            v.exit_rule(&"literal", &n.span);
        }
    }
}

pub fn walk_templateStringLiteral<V: Visitor>(v: &mut V, node: &TemplateStringLiteralNode) {
    v.enter_rule(&"templateStringLiteral", &node.span);
    v.visit_token(&node.backtick);
    for let item of &node.template_string_atom_list {
        walk_templateStringAtom(v, item);
    }
    v.visit_token(&node.backtick_2);
    v.exit_rule(&"templateStringLiteral", &node.span);
}

pub fn walk_templateStringAtom<V: Visitor>(v: &mut V, node: &TemplateStringAtomNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"templateStringAtom", &n.span);
            v.visit_token(&n.templatestringatom);
            v.exit_rule(&"templateStringAtom", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"templateStringAtom", &n.span);
            v.visit_token(&n.templatestringstartexpression);
            walk_singleExpression(v, &n.single_expression);
            v.visit_token(&n.templateclosebrace);
            v.exit_rule(&"templateStringAtom", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"templateStringAtom", &n.span);
            v.visit_token(&n.templatestringescapeatom);
            v.exit_rule(&"templateStringAtom", &n.span);
        }
    }
}

