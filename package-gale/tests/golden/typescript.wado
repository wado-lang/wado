    let semicolon = p.expect(TK_SemiColon)?;
    return Result::<PropertyMemberDeclarationNode, ParseError>::Ok(PropertyMemberDeclarationNode::PropertyDeclarationExpression(PropertyMemberDeclarationPropertyDeclarationExpression {
        span: Span::new(start, p.last_end()),
        property_member_base,
        property_name,
        question,
        type_annotation,
        initializer,
        semicolon,
    }));
