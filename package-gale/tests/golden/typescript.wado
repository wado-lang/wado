fn parse_property_assignment_bt_1(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let lbracket = p.expect(TK_LIT_LBRACKET)?;
    let single_expression = parse_single_expression(p)?;
    let rbracket = p.expect(TK_LIT_RBRACKET)?;
    let colon = p.expect(TK_LIT_COLON)?;
    let single_expression_2 = parse_single_expression(p)?;
    return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::ComputedPropertyExpressionAssignment(PropertyAssignmentComputedPropertyExpressionAssignment {
        span: Span::new(start, p.last_end()),
        lbracket,
        single_expression,
        rbracket,
        colon,
        single_expression_2,
    }));
}

fn parse_property_assignment_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LBRACKET { return -1; }
    pos += 1;
    return pos;
}

fn parse_property_assignment_bt_2(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let get_accessor = parse_get_accessor(p)?;
    return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::PropertyGetter(PropertyAssignmentPropertyGetter {
        span: Span::new(start, p.last_end()),
        get_accessor,
    }));
}

fn parse_property_assignment_bt_3(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let set_accessor = parse_set_accessor(p)?;
    return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::PropertySetter(PropertyAssignmentPropertySetter {
        span: Span::new(start, p.last_end()),
        set_accessor,
    }));
}

fn parse_property_assignment_bt_5(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let identifier_or_key_word = parse_identifier_or_key_word(p)?;
    return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::PropertyShorthand(PropertyAssignmentPropertyShorthand {
        span: Span::new(start, p.last_end()),
        identifier_or_key_word,
    }));
}

fn parse_property_assignment_scan_5(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_identifier_or_key_word(tokens, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn parse_property_assignment_bt_4(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let generator_method = parse_generator_method(p)?;
    return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::MethodProperty(PropertyAssignmentMethodProperty {
        span: Span::new(start, p.last_end()),
        generator_method,
    }));
}

fn parse_property_assignment_bt_0(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let property_name = parse_property_name(p)?;
    let colon_or_eq = p.advance();
    let single_expression = parse_single_expression(p)?;
    return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::PropertyExpressionAssignment(PropertyAssignmentPropertyExpressionAssignment {
        span: Span::new(start, p.last_end()),
        property_name,
        colon_or_eq,
        single_expression,
    }));
}

fn parse_property_assignment_bt_6(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let ellipsis: Option<Token> = if p.peek_kind() == TK_Ellipsis {
        let ellipsis = p.expect(TK_Ellipsis)?;
        Option::<Token>::Some(ellipsis)
    } else {
        null
    };
    let single_expression = parse_single_expression(p)?;
    return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::SpreadOperator(PropertyAssignmentSpreadOperator {
        span: Span::new(start, p.last_end()),
        ellipsis,
        single_expression,
    }));
}

fn parse_property_assignment_scan_6(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos < tokens.len() && tokens[pos].kind == TK_Ellipsis {
        let sp = pos;
        if pos >= tokens.len() || tokens[pos].kind != TK_Ellipsis { pos = -1; } else { pos += 1; }
        if pos < 0 { pos = sp; }
    }
    return pos;
}

fn parse_property_assignment(p: &mut Parser) -> Result<PropertyAssignmentNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_LIT_LBRACKET | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_LIT_STAR | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_Ellipsis | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        if p.peek_kind() == TK_LIT_LBRACKET {
            let saved = p.pos;
            let r_1 = parse_property_assignment_bt_1(p);
            if let Err(_) = r_1 {
                p.pos = saved;
            } else {
                return r_1;
            }
            let r_4 = parse_property_assignment_bt_4(p);
            if let Err(_) = r_4 {
                p.pos = saved;
            } else {
                return r_4;
            }
            let r_0 = parse_property_assignment_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_property_assignment_bt_6(p);
        } else if p.peek_kind() matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract } {
            let saved = p.pos;
            let r_2 = parse_property_assignment_bt_2(p);
            if let Err(_) = r_2 {
                p.pos = saved;
            } else {
                return r_2;
            }
            let r_3 = parse_property_assignment_bt_3(p);
            if let Err(_) = r_3 {
                p.pos = saved;
            } else {
                return r_3;
            }
            let r_4 = parse_property_assignment_bt_4(p);
            if let Err(_) = r_4 {
                p.pos = saved;
            } else {
                return r_4;
            }
            let r_5 = parse_property_assignment_bt_5(p);
            if let Err(_) = r_5 {
                p.pos = saved;
            } else {
                return r_5;
            }
            let r_0 = parse_property_assignment_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_property_assignment_bt_6(p);
        } else if p.peek_kind() == TK_Require {
            let saved = p.pos;
            let r_4 = parse_property_assignment_bt_4(p);
            if let Err(_) = r_4 {
                p.pos = saved;
            } else {
                return r_4;
            }
            let r_5 = parse_property_assignment_bt_5(p);
            if let Err(_) = r_5 {
                p.pos = saved;
            } else {
                return r_5;
            }
            let r_0 = parse_property_assignment_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_property_assignment_bt_6(p);
        } else if p.peek_kind() matches { TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral } {
            let saved = p.pos;
            let r_4 = parse_property_assignment_bt_4(p);
            if let Err(_) = r_4 {
                p.pos = saved;
            } else {
                return r_4;
            }
            let r_0 = parse_property_assignment_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_property_assignment_bt_6(p);
        } else if p.peek_kind() == TK_LIT_STAR {
            return parse_property_assignment_bt_4(p);
        } else if p.peek_kind() matches { TK_Ellipsis | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
            return parse_property_assignment_bt_6(p);
        }
    }
    if kind == TK_LIT_DOTDOTDOT {
        let rest_parameter = parse_rest_parameter(p)?;
        return Result::<PropertyAssignmentNode, ParseError>::Ok(PropertyAssignmentNode::RestParameterInObject(PropertyAssignmentRestParameterInObject {
            span: Span::new(start, p.last_end()),
            rest_parameter,
        }));
    }
    return Result::<PropertyAssignmentNode, ParseError>::Err(ParseError::new(
        "expected propertyAssignment",
        p.peek().span,
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_StringLiteral", "TK_DecimalLiteral", "TK_HexIntegerLiteral", "TK_OctalIntegerLiteral", "TK_OctalIntegerLiteral2", "TK_BinaryIntegerLiteral", "TK_LIT_LBRACKET", "TK_LIT_STAR", "TK_Ellipsis", "TK_LIT_LPAREN", "TK_LIT_PLUSPLUS", "TK_LIT_MINUSMINUS", "TK_LIT_PLUS", "TK_LIT_MINUS", "TK_LIT_TILDE", "TK_LIT_BANG", "TK_LIT_LBRACE", "TK_YieldStar", "TK_BackTick", "TK_RegularExpressionLiteral", "TK_BigDecimalIntegerLiteral", "TK_BigHexIntegerLiteral", "TK_BigOctalIntegerLiteral", "TK_BigBinaryIntegerLiteral", "TK_LIT_LT", "TK_LIT_DOTDOTDOT"],
    ));
}

fn parse_get_accessor(p: &mut Parser) -> Result<GetAccessorNode, ParseError> {
    let start = p.peek().span.start;
    let getter = parse_getter(p)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let function_body = parse_function_body(p)?;
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<GetAccessorNode, ParseError>::Ok(GetAccessorNode {
        span: Span::new(start, p.last_end()),
        getter,
        lparen,
        rparen,
        type_annotation,
        lbrace,
        function_body,
        rbrace,
    });
}

fn parse_set_accessor(p: &mut Parser) -> Result<SetAccessorNode, ParseError> {
    let start = p.peek().span.start;
    let setter = parse_setter(p)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let formal_parameter_list: Option<FormalParameterListNode> = if p.peek_kind() matches { TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_LIT_LBRACKET | TK_LIT_LBRACE | TK_Ellipsis } {
        let formal_parameter_list = parse_formal_parameter_list(p)?;
        Option::<FormalParameterListNode>::Some(formal_parameter_list)
    } else {
        null
    };
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let function_body = parse_function_body(p)?;
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<SetAccessorNode, ParseError>::Ok(SetAccessorNode {
        span: Span::new(start, p.last_end()),
        setter,
        lparen,
        formal_parameter_list,
        rparen,
        lbrace,
        function_body,
        rbrace,
    });
}

fn parse_property_name(p: &mut Parser) -> Result<PropertyNameNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral } {
        let identifier_name = parse_identifier_name(p)?;
        return Result::<PropertyNameNode, ParseError>::Ok(PropertyNameNode::Alt0(PropertyNameAlt0 {
            span: Span::new(start, p.last_end()),
            identifier_name,
        }));
    }
    if kind == TK_StringLiteral {
        let stringliteral = p.expect(TK_StringLiteral)?;
        return Result::<PropertyNameNode, ParseError>::Ok(PropertyNameNode::Alt1(PropertyNameAlt1 {
            span: Span::new(start, p.last_end()),
            stringliteral,
        }));
    }
    if kind matches { TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral } {
        let numeric_literal = parse_numeric_literal(p)?;
        return Result::<PropertyNameNode, ParseError>::Ok(PropertyNameNode::Alt2(PropertyNameAlt2 {
            span: Span::new(start, p.last_end()),
            numeric_literal,
        }));
    }
    if kind == TK_LIT_LBRACKET {
        let lbracket = p.expect(TK_LIT_LBRACKET)?;
        let single_expression = parse_single_expression(p)?;
        let rbracket = p.expect(TK_LIT_RBRACKET)?;
        return Result::<PropertyNameNode, ParseError>::Ok(PropertyNameNode::Alt3(PropertyNameAlt3 {
            span: Span::new(start, p.last_end()),
            lbracket,
            single_expression,
            rbracket,
        }));
    }
    return Result::<PropertyNameNode, ParseError>::Err(ParseError::new(
        "expected propertyName",
        p.peek().span,
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_StringLiteral", "TK_DecimalLiteral", "TK_HexIntegerLiteral", "TK_OctalIntegerLiteral", "TK_OctalIntegerLiteral2", "TK_BinaryIntegerLiteral", "TK_LIT_LBRACKET"],
    ));
}

