    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let statement_list: Option<StatementListNode> = if p.peek_kind() matches { TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_Export | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        let statement_list = parse_statement_list(p)?;
        Option::<StatementListNode>::Some(statement_list)
    } else {
        null
    };
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<BlockNode, ParseError>::Ok(BlockNode {
        span: Span::new(start, p.last_end()),
        lbrace,
        statement_list,
        rbrace,
    });
}

fn parse_statement_list(p: &mut Parser) -> Result<StatementListNode, ParseError> {
    let start = p.peek().span.start;
    let mut statement_list: Array<StatementNode> = [];
    let mut _plus_first = true;
    while _plus_first || p.peek_kind() matches { TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_Export | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        _plus_first = false;
        let statement = parse_statement(p)?;
        statement_list.push(statement);
    }
    return Result::<StatementListNode, ParseError>::Ok(StatementListNode {
        span: Span::new(start, p.last_end()),
        statement_list,
    });
}

fn parse_abstract_declaration(p: &mut Parser) -> Result<AbstractDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let abstract = p.expect(TK_Abstract)?;
    let mut group_0_inner: Option<AbstractDeclarationGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_LIT_LBRACKET | TK_LIT_LBRACE | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Require | TK_Declare } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let _bt_r = parse_variable_statement(p);
                if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                let variable_statement = _bt_r.unwrap();
                group_0_inner = Option::<AbstractDeclarationGroup0>::Some(AbstractDeclarationGroup0::Alt1(AbstractDeclarationGroup0Alt1 {
                    variable_statement,
                }));
                bt_done = true;
            }
        }
        if !bt_done {
            let identifier = parse_identifier(p)?;
            let call_signature = parse_call_signature(p)?;
            group_0_inner = Option::<AbstractDeclarationGroup0>::Some(AbstractDeclarationGroup0::Alt0(AbstractDeclarationGroup0Alt0 {
                identifier,
                call_signature,
            }));
        }
    }
    let group_0 = group_0_inner;
    let eos = parse_eos(p)?;
    return Result::<AbstractDeclarationNode, ParseError>::Ok(AbstractDeclarationNode {
        span: Span::new(start, p.last_end()),
        abstract,
        group_0,
        eos,
    });
}

fn parse_import_statement(p: &mut Parser) -> Result<ImportStatementNode, ParseError> {
    let start = p.peek().span.start;
    let import_ = p.expect(TK_Import)?;
    let import_from_block = parse_import_from_block(p)?;
    return Result::<ImportStatementNode, ParseError>::Ok(ImportStatementNode {
        span: Span::new(start, p.last_end()),
        import_,
        import_from_block,
    });
}

fn parse_import_from_block(p: &mut Parser) -> Result<ImportFromBlockNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_LIT_STAR | TK_LIT_LBRACE } {
        let import_default: Option<ImportDefaultNode> = null;
        let mut import_namespace_or_import_module_items_inner: Option<ImportNamespaceOrImportModuleItemsGroup> = null;
        let grp_kind = p.peek_kind();
        if grp_kind matches { TK_LIT_STAR | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral } {
            let import_namespace = parse_import_namespace(p)?;
            import_namespace_or_import_module_items_inner = Option::<ImportNamespaceOrImportModuleItemsGroup>::Some(ImportNamespaceOrImportModuleItemsGroup::ImportNamespace(import_namespace));
        } else if grp_kind == TK_LIT_LBRACE {
            let import_module_items = parse_import_module_items(p)?;
            import_namespace_or_import_module_items_inner = Option::<ImportNamespaceOrImportModuleItemsGroup>::Some(ImportNamespaceOrImportModuleItemsGroup::ImportModuleItems(import_module_items));
        }
        let import_namespace_or_import_module_items = import_namespace_or_import_module_items_inner;
        let import_from = parse_import_from(p)?;
        let eos = parse_eos(p)?;
        return Result::<ImportFromBlockNode, ParseError>::Ok(ImportFromBlockNode::Alt0(ImportFromBlockAlt0 {
            span: Span::new(start, p.last_end()),
            import_default,
            import_namespace_or_import_module_items,
            import_from,
            eos,
        }));
    }
    if kind == TK_StringLiteral {
        let stringliteral = p.expect(TK_StringLiteral)?;
        let eos = parse_eos(p)?;
        return Result::<ImportFromBlockNode, ParseError>::Ok(ImportFromBlockNode::Alt1(ImportFromBlockAlt1 {
            span: Span::new(start, p.last_end()),
            stringliteral,
            eos,
        }));
    }
    return Result::<ImportFromBlockNode, ParseError>::Err(ParseError::new(
        "expected importFromBlock",
        p.peek().span,
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_LIT_STAR", "TK_LIT_LBRACE", "TK_StringLiteral"],
    ));
}

fn parse_import_module_items(p: &mut Parser) -> Result<ImportModuleItemsNode, ParseError> {
    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let mut import_alias_name_comma_list: Array<ImportAliasNameCommaItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            pos = scan_import_alias_name(tokens, pos);
            if pos < 0 { break rep_scan; }
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break rep_scan; }
            pos += 1;
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let import_alias_name = parse_import_alias_name(p)?;
        let comma = p.expect(TK_LIT_COMMA)?;
        let import_alias_name_comma = ImportAliasNameCommaItem {
            import_alias_name,
            comma,
        };
        import_alias_name_comma_list.push(import_alias_name_comma);
    }
    let import_alias_name_comma: Option<ImportAliasNameCommaOptItem> = if (p.peek_kind() == TK_Identifier || p.peek_kind() == TK_Async || p.peek_kind() == TK_As || p.peek_kind() == TK_From || p.peek_kind() == TK_Yield || p.peek_kind() == TK_Of || p.peek_kind() == TK_Any || p.peek_kind() == TK_Number || p.peek_kind() == TK_Boolean || p.peek_kind() == TK_String || p.peek_kind() == TK_Unique || p.peek_kind() == TK_Symbol || p.peek_kind() == TK_Never || p.peek_kind() == TK_Undefined || p.peek_kind() == TK_Object || p.peek_kind() == TK_KeyOf || p.peek_kind() == TK_TypeAlias || p.peek_kind() == TK_Constructor || p.peek_kind() == TK_Namespace || p.peek_kind() == TK_Abstract || p.peek_kind() == TK_Break || p.peek_kind() == TK_Do || p.peek_kind() == TK_Instanceof || p.peek_kind() == TK_Typeof || p.peek_kind() == TK_Case || p.peek_kind() == TK_Else || p.peek_kind() == TK_New || p.peek_kind() == TK_Var || p.peek_kind() == TK_Catch || p.peek_kind() == TK_Finally || p.peek_kind() == TK_Return || p.peek_kind() == TK_Void || p.peek_kind() == TK_Continue || p.peek_kind() == TK_For || p.peek_kind() == TK_Switch || p.peek_kind() == TK_While || p.peek_kind() == TK_Debugger || p.peek_kind() == TK_Function_ || p.peek_kind() == TK_This || p.peek_kind() == TK_With || p.peek_kind() == TK_Default || p.peek_kind() == TK_If || p.peek_kind() == TK_Throw || p.peek_kind() == TK_Delete || p.peek_kind() == TK_In || p.peek_kind() == TK_Try || p.peek_kind() == TK_Class || p.peek_kind() == TK_Enum || p.peek_kind() == TK_Extends || p.peek_kind() == TK_Super || p.peek_kind() == TK_Const || p.peek_kind() == TK_Export || p.peek_kind() == TK_Import || p.peek_kind() == TK_Implements || p.peek_kind() == TK_Let || p.peek_kind() == TK_Private || p.peek_kind() == TK_Public || p.peek_kind() == TK_Interface || p.peek_kind() == TK_Package || p.peek_kind() == TK_Protected || p.peek_kind() == TK_Static || p.peek_kind() == TK_Await || p.peek_kind() == TK_ReadOnly || p.peek_kind() == TK_Require || p.peek_kind() == TK_Module || p.peek_kind() == TK_NullLiteral || p.peek_kind() == TK_BooleanLiteral || p.peek_kind() == TK_StringLiteral) && p.peek_at(1) == TK_LIT_COMMA {
        let import_alias_name = parse_import_alias_name(p)?;
        let comma: Option<Token> = if p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            Option::<Token>::Some(comma)
        } else {
            null
        };
        let import_alias_name_comma = ImportAliasNameCommaOptItem {
            import_alias_name,
            comma,
        };
        Option::<ImportAliasNameCommaOptItem>::Some(import_alias_name_comma)
    } else if (p.peek_kind() == TK_Identifier || p.peek_kind() == TK_Async || p.peek_kind() == TK_As || p.peek_kind() == TK_From || p.peek_kind() == TK_Yield || p.peek_kind() == TK_Of || p.peek_kind() == TK_Any || p.peek_kind() == TK_Number || p.peek_kind() == TK_Boolean || p.peek_kind() == TK_String || p.peek_kind() == TK_Unique || p.peek_kind() == TK_Symbol || p.peek_kind() == TK_Never || p.peek_kind() == TK_Undefined || p.peek_kind() == TK_Object || p.peek_kind() == TK_KeyOf || p.peek_kind() == TK_TypeAlias || p.peek_kind() == TK_Constructor || p.peek_kind() == TK_Namespace || p.peek_kind() == TK_Abstract || p.peek_kind() == TK_Break || p.peek_kind() == TK_Do || p.peek_kind() == TK_Instanceof || p.peek_kind() == TK_Typeof || p.peek_kind() == TK_Case || p.peek_kind() == TK_Else || p.peek_kind() == TK_New || p.peek_kind() == TK_Var || p.peek_kind() == TK_Catch || p.peek_kind() == TK_Finally || p.peek_kind() == TK_Return || p.peek_kind() == TK_Void || p.peek_kind() == TK_Continue || p.peek_kind() == TK_For || p.peek_kind() == TK_Switch || p.peek_kind() == TK_While || p.peek_kind() == TK_Debugger || p.peek_kind() == TK_Function_ || p.peek_kind() == TK_This || p.peek_kind() == TK_With || p.peek_kind() == TK_Default || p.peek_kind() == TK_If || p.peek_kind() == TK_Throw || p.peek_kind() == TK_Delete || p.peek_kind() == TK_In || p.peek_kind() == TK_Try || p.peek_kind() == TK_Class || p.peek_kind() == TK_Enum || p.peek_kind() == TK_Extends || p.peek_kind() == TK_Super || p.peek_kind() == TK_Const || p.peek_kind() == TK_Export || p.peek_kind() == TK_Import || p.peek_kind() == TK_Implements || p.peek_kind() == TK_Let || p.peek_kind() == TK_Private || p.peek_kind() == TK_Public || p.peek_kind() == TK_Interface || p.peek_kind() == TK_Package || p.peek_kind() == TK_Protected || p.peek_kind() == TK_Static || p.peek_kind() == TK_Await || p.peek_kind() == TK_ReadOnly || p.peek_kind() == TK_Require || p.peek_kind() == TK_Module || p.peek_kind() == TK_NullLiteral || p.peek_kind() == TK_BooleanLiteral || p.peek_kind() == TK_StringLiteral) {
        let import_alias_name = parse_import_alias_name(p)?;
        let comma: Option<Token> = null;
        let import_alias_name_comma = ImportAliasNameCommaOptItem {
            import_alias_name,
            comma,
        };
        Option::<ImportAliasNameCommaOptItem>::Some(import_alias_name_comma)
    } else {
        null
    };
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<ImportModuleItemsNode, ParseError>::Ok(ImportModuleItemsNode {
        span: Span::new(start, p.last_end()),
        lbrace,
        import_alias_name_comma_list,
        import_alias_name_comma,
        rbrace,
    });
}

fn parse_import_alias_name(p: &mut Parser) -> Result<ImportAliasNameNode, ParseError> {
    let start = p.peek().span.start;
    let module_export_name = parse_module_export_name(p)?;
    let as__imported_binding: Option<AsImportedBindingItem> = if p.peek_kind() == TK_As {
        let as_ = p.expect(TK_As)?;
        let imported_binding = parse_imported_binding(p)?;
        let as__imported_binding = AsImportedBindingItem {
            as_,
            imported_binding,
        };
        Option::<AsImportedBindingItem>::Some(as__imported_binding)
    } else {
        null
    };
    return Result::<ImportAliasNameNode, ParseError>::Ok(ImportAliasNameNode {
        span: Span::new(start, p.last_end()),
        module_export_name,
        as__imported_binding,
    });
}

fn parse_module_export_name(p: &mut Parser) -> Result<ModuleExportNameNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral } {
        let identifier_name = parse_identifier_name(p)?;
        return Result::<ModuleExportNameNode, ParseError>::Ok(ModuleExportNameNode::Alt0(ModuleExportNameAlt0 {
            span: Span::new(start, p.last_end()),
            identifier_name,
        }));
    }
    if kind == TK_StringLiteral {
        let stringliteral = p.expect(TK_StringLiteral)?;
        return Result::<ModuleExportNameNode, ParseError>::Ok(ModuleExportNameNode::Alt1(ModuleExportNameAlt1 {
            span: Span::new(start, p.last_end()),
            stringliteral,
        }));
    }
    return Result::<ModuleExportNameNode, ParseError>::Err(ParseError::new(
        "expected moduleExportName",
        p.peek().span,
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_StringLiteral"],
    ));
}

fn parse_imported_binding(p: &mut Parser) -> Result<ImportedBindingNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_Identifier {
        let identifier = p.expect(TK_Identifier)?;
        return Result::<ImportedBindingNode, ParseError>::Ok(ImportedBindingNode::Alt0(ImportedBindingAlt0 {
            span: Span::new(start, p.last_end()),
            identifier,
        }));
    }
    if kind == TK_Yield {
        let yield = p.expect(TK_Yield)?;
        return Result::<ImportedBindingNode, ParseError>::Ok(ImportedBindingNode::Alt1(ImportedBindingAlt1 {
            span: Span::new(start, p.last_end()),
            yield,
        }));
    }
    if kind == TK_Await {
        let await = p.expect(TK_Await)?;
        return Result::<ImportedBindingNode, ParseError>::Ok(ImportedBindingNode::Alt2(ImportedBindingAlt2 {
            span: Span::new(start, p.last_end()),
            await,
        }));
    }
    return Result::<ImportedBindingNode, ParseError>::Err(ParseError::new(
        "expected importedBinding",
        p.peek().span,
        ["TK_Identifier", "TK_Yield", "TK_Await"],
    ));
}

fn parse_import_default(p: &mut Parser) -> Result<ImportDefaultNode, ParseError> {
    let start = p.peek().span.start;
    let alias_name = parse_alias_name(p)?;
    let comma = p.expect(TK_LIT_COMMA)?;
    return Result::<ImportDefaultNode, ParseError>::Ok(ImportDefaultNode {
        span: Span::new(start, p.last_end()),
        alias_name,
        comma,
    });
}

fn parse_import_namespace(p: &mut Parser) -> Result<ImportNamespaceNode, ParseError> {
    let start = p.peek().span.start;
    let mut group_0_inner: Option<ImportNamespaceGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_STAR {
        let star = p.expect(TK_LIT_STAR)?;
        group_0_inner = Option::<ImportNamespaceGroup0>::Some(ImportNamespaceGroup0::Alt0(ImportNamespaceGroup0Alt0 {
            star,
        }));
    } else if grp_kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral } {
        let identifier_name = parse_identifier_name(p)?;
        group_0_inner = Option::<ImportNamespaceGroup0>::Some(ImportNamespaceGroup0::Alt1(ImportNamespaceGroup0Alt1 {
            identifier_name,
        }));
    }
    let group_0 = group_0_inner;
    let as__identifier_name: Option<AsIdentifierNameItem> = if p.peek_kind() == TK_As {
        let as_ = p.expect(TK_As)?;
        let identifier_name = parse_identifier_name(p)?;
        let as__identifier_name = AsIdentifierNameItem {
            as_,
            identifier_name,
        };
        Option::<AsIdentifierNameItem>::Some(as__identifier_name)
    } else {
        null
    };
    return Result::<ImportNamespaceNode, ParseError>::Ok(ImportNamespaceNode {
        span: Span::new(start, p.last_end()),
        group_0,
        as__identifier_name,
    });
}

