    let expression_sequence_3: Option<ExpressionSequenceNode> = if p.peek_kind() matches { TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        let expression_sequence = parse_expression_sequence(p)?;
        Option::<ExpressionSequenceNode>::Some(expression_sequence)
    } else {
        null
    };
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let statement = parse_statement(p)?;
    return Result::<IterationStatementNode, ParseError>::Ok(IterationStatementNode::ForStatement(IterationStatementForStatement {
        span: Span::new(start, p.last_end()),
        for_,
        lparen,
        expression_sequence,
        semicolon,
        expression_sequence_2,
        semicolon_2,
        expression_sequence_3,
        rparen,
        statement,
    }));
}

fn parse_iteration_statement_scan_2(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_For { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { return -1; }
    pos += 1;
    return pos;
}

fn parse_iteration_statement_bt_5(p: &mut Parser) -> Result<IterationStatementNode, ParseError> {
    let start = p.peek().span.start;
    let for_ = p.expect(TK_For)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let var_modifier = parse_var_modifier(p)?;
    let variable_declaration = parse_variable_declaration(p)?;
    let in_ = p.expect(TK_In)?;
    let expression_sequence = parse_expression_sequence(p)?;
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let statement = parse_statement(p)?;
    return Result::<IterationStatementNode, ParseError>::Ok(IterationStatementNode::ForVarInStatement(IterationStatementForVarInStatement {
        span: Span::new(start, p.last_end()),
        for_,
        lparen,
        var_modifier,
        variable_declaration,
        in_,
        expression_sequence,
        rparen,
        statement,
    }));
}

fn parse_iteration_statement_scan_5(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_For { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { return -1; }
    pos += 1;
    pos = scan_var_modifier(tokens, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn parse_iteration_statement_bt_4(p: &mut Parser) -> Result<IterationStatementNode, ParseError> {
    let start = p.peek().span.start;
    let for_ = p.expect(TK_For)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let single_expression = parse_single_expression(p)?;
    let in_ = p.expect(TK_In)?;
    let expression_sequence = parse_expression_sequence(p)?;
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let statement = parse_statement(p)?;
    return Result::<IterationStatementNode, ParseError>::Ok(IterationStatementNode::ForInStatement(IterationStatementForInStatement {
        span: Span::new(start, p.last_end()),
        for_,
        lparen,
        single_expression,
        in_,
        expression_sequence,
        rparen,
        statement,
    }));
}

fn parse_iteration_statement_scan_4(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_For { return -1; }
    pos += 1;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { return -1; }
    pos += 1;
    return pos;
}

fn parse_iteration_statement(p: &mut Parser) -> Result<IterationStatementNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_Do {
        let do = p.expect(TK_Do)?;
        let statement = parse_statement(p)?;
        let while_ = p.expect(TK_While)?;
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let expression_sequence = parse_expression_sequence(p)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let eos = parse_eos(p)?;
        return Result::<IterationStatementNode, ParseError>::Ok(IterationStatementNode::DoStatement(IterationStatementDoStatement {
            span: Span::new(start, p.last_end()),
            do,
            statement,
            while_,
            lparen,
            expression_sequence,
            rparen,
            eos,
        }));
    }
    if kind == TK_While {
        let while_ = p.expect(TK_While)?;
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let expression_sequence = parse_expression_sequence(p)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let statement = parse_statement(p)?;
        return Result::<IterationStatementNode, ParseError>::Ok(IterationStatementNode::WhileStatement(IterationStatementWhileStatement {
            span: Span::new(start, p.last_end()),
            while_,
            lparen,
            expression_sequence,
            rparen,
            statement,
        }));
    }
    if kind == TK_For {
        let saved = p.pos;
        if parse_iteration_statement_scan_3(&p.tokens, p.pos) >= 0 {
            let r_3 = parse_iteration_statement_bt_3(p);
            if let Err(_) = r_3 {
                p.pos = saved;
            } else {
                return r_3;
            }
        }
        if parse_iteration_statement_scan_7(&p.tokens, p.pos) >= 0 {
            let r_7 = parse_iteration_statement_bt_7(p);
            if let Err(_) = r_7 {
                p.pos = saved;
            } else {
                return r_7;
            }
        }
        if parse_iteration_statement_scan_6(&p.tokens, p.pos) >= 0 {
            let r_6 = parse_iteration_statement_bt_6(p);
            if let Err(_) = r_6 {
                p.pos = saved;
            } else {
                return r_6;
            }
        }
        if parse_iteration_statement_scan_2(&p.tokens, p.pos) >= 0 {
            let r_2 = parse_iteration_statement_bt_2(p);
            if let Err(_) = r_2 {
                p.pos = saved;
            } else {
                return r_2;
            }
        }
        if parse_iteration_statement_scan_5(&p.tokens, p.pos) >= 0 {
            let r_5 = parse_iteration_statement_bt_5(p);
            if let Err(_) = r_5 {
                p.pos = saved;
            } else {
                return r_5;
            }
        }
        return parse_iteration_statement_bt_4(p);
    }
    return Result::<IterationStatementNode, ParseError>::Err(ParseError::new(
        "expected iterationStatement",
        p.peek().span,
        ["TK_Do", "TK_While", "TK_For"],
    ));
}

fn parse_var_modifier(p: &mut Parser) -> Result<VarModifierNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_Var {
        let var = p.expect(TK_Var)?;
        return Result::<VarModifierNode, ParseError>::Ok(VarModifierNode::Alt0(VarModifierAlt0 {
            span: Span::new(start, p.last_end()),
            var,
        }));
    }
    if kind == TK_Let {
        let let_ = p.expect(TK_Let)?;
        return Result::<VarModifierNode, ParseError>::Ok(VarModifierNode::Alt1(VarModifierAlt1 {
            span: Span::new(start, p.last_end()),
            let_,
        }));
    }
    if kind == TK_Const {
        let const_ = p.expect(TK_Const)?;
        return Result::<VarModifierNode, ParseError>::Ok(VarModifierNode::Alt2(VarModifierAlt2 {
            span: Span::new(start, p.last_end()),
            const_,
        }));
    }
    return Result::<VarModifierNode, ParseError>::Err(ParseError::new(
        "expected varModifier",
        p.peek().span,
        ["TK_Var", "TK_Let", "TK_Const"],
    ));
}

fn parse_continue_statement(p: &mut Parser) -> Result<ContinueStatementNode, ParseError> {
    let start = p.peek().span.start;
    let continue_ = p.expect(TK_Continue)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        pos = scan_identifier(tokens, pos);
        if pos < 0 { break opt_scan; }
        opt_scan_pos = pos;
    }
    if opt_scan_pos >= 0 {
        let identifier = parse_identifier(p)?;
    }
    let eos = parse_eos(p)?;
    return Result::<ContinueStatementNode, ParseError>::Ok(ContinueStatementNode {
        span: Span::new(start, p.last_end()),
        continue_,
        eos,
    });
}

fn parse_break_statement(p: &mut Parser) -> Result<BreakStatementNode, ParseError> {
    let start = p.peek().span.start;
    let break_ = p.expect(TK_Break)?;
    let mut opt_scan_pos: i32 = -1;
    opt_scan: {
        let tokens = &p.tokens;
        let mut pos: i32 = p.pos;
        pos = scan_identifier(tokens, pos);
        if pos < 0 { break opt_scan; }
        opt_scan_pos = pos;
    }
    if opt_scan_pos >= 0 {
        let identifier = parse_identifier(p)?;
    }
    let eos = parse_eos(p)?;
    return Result::<BreakStatementNode, ParseError>::Ok(BreakStatementNode {
        span: Span::new(start, p.last_end()),
        break_,
        eos,
    });
}

fn parse_return_statement(p: &mut Parser) -> Result<ReturnStatementNode, ParseError> {
    let start = p.peek().span.start;
    let return_ = p.expect(TK_Return)?;
    if p.peek_kind() matches { TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        let opt_saved = p.pos;
        opt_bt: {
            let opt_r = parse_expression_sequence(p);
            if let Err(_) = opt_r { p.pos = opt_saved; break opt_bt; }
        }
    }
    let eos = parse_eos(p)?;
    return Result::<ReturnStatementNode, ParseError>::Ok(ReturnStatementNode {
        span: Span::new(start, p.last_end()),
        return_,
        eos,
    });
}

fn parse_yield_statement(p: &mut Parser) -> Result<YieldStatementNode, ParseError> {
    let start = p.peek().span.start;
    let yield_or_yieldstar = p.advance();
    if p.peek_kind() matches { TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        let opt_saved = p.pos;
        opt_bt: {
            let opt_r = parse_expression_sequence(p);
            if let Err(_) = opt_r { p.pos = opt_saved; break opt_bt; }
        }
    }
    let eos = parse_eos(p)?;
    return Result::<YieldStatementNode, ParseError>::Ok(YieldStatementNode {
        span: Span::new(start, p.last_end()),
        yield_or_yieldstar,
        eos,
    });
