fn parse_formal_parameter_list_bt_0(p: &mut Parser) -> Result<FormalParameterListNode, ParseError> {
    let start = p.peek().span.start;
    let formal_parameter_arg = parse_formal_parameter_arg(p)?;
    let mut comma_formal_parameter_arg_list: Array<CommaFormalParameterArgItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let formal_parameter_arg = parse_formal_parameter_arg(p)?;
        let comma_formal_parameter_arg = CommaFormalParameterArgItem {
            comma,
            formal_parameter_arg,
        };
        comma_formal_parameter_arg_list.push(comma_formal_parameter_arg);
    }
    let comma_last_formal_parameter_arg: Option<CommaLastFormalParameterArgItem> = if p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let last_formal_parameter_arg = parse_last_formal_parameter_arg(p)?;
        let comma_last_formal_parameter_arg = CommaLastFormalParameterArgItem {
            comma,
            last_formal_parameter_arg,
        };
        Option::<CommaLastFormalParameterArgItem>::Some(comma_last_formal_parameter_arg)
    } else {
        null
    };
    let comma: Option<Token> = if p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        Option::<Token>::Some(comma)
    } else {
        null
    };
    return Result::<FormalParameterListNode, ParseError>::Ok(FormalParameterListNode::Alt0(FormalParameterListAlt0 {
        span: Span::new(start, p.last_end()),
        formal_parameter_arg,
        comma_formal_parameter_arg_list,
        comma_last_formal_parameter_arg,
        comma,
    }));
}

fn parse_formal_parameter_list_bt_3(p: &mut Parser) -> Result<FormalParameterListNode, ParseError> {
    let start = p.peek().span.start;
    let object_literal = parse_object_literal(p)?;
    let colon_formal_parameter_list: Option<ColonFormalParameterListItem> = if p.peek_kind() == TK_LIT_COLON {
