fn parse_function_declaration(p: &mut Parser) -> Result<FunctionDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let async_: Option<Token> = if p.peek_kind() == TK_Async {
        let async_ = p.expect(TK_Async)?;
        Option::<Token>::Some(async_)
    } else {
        null
    };
    let function_ = p.expect(TK_Function_)?;
    let star: Option<Token> = if p.peek_kind() == TK_LIT_STAR {
        let star = p.expect(TK_LIT_STAR)?;
        Option::<Token>::Some(star)
    } else {
        null
    };
    let identifier = parse_identifier(p)?;
    let call_signature = parse_call_signature(p)?;
    let mut group_0_inner: Option<FunctionDeclarationGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_LBRACE {
        let lbrace = p.expect(TK_LIT_LBRACE)?;
        let function_body = parse_function_body(p)?;
        let rbrace = p.expect(TK_LIT_RBRACE)?;
        let lbrace_function_body_rbrace = LbraceFunctionBodyRbraceItem {
            lbrace,
            function_body,
            rbrace,
        };
        group_0_inner = Option::<FunctionDeclarationGroup0>::Some(FunctionDeclarationGroup0::Alt0(FunctionDeclarationGroup0Alt0 {
            lbrace_function_body_rbrace,
        }));
    } else if grp_kind == TK_SemiColon {
        let semicolon = p.expect(TK_SemiColon)?;
        group_0_inner = Option::<FunctionDeclarationGroup0>::Some(FunctionDeclarationGroup0::Alt1(FunctionDeclarationGroup0Alt1 {
            semicolon,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<FunctionDeclarationNode, ParseError>::Ok(FunctionDeclarationNode {
        span: Span::new(start, p.last_end()),
        async_,
        function_,
        star,
        identifier,
        call_signature,
        group_0,
    });
}

fn parse_class_declaration(p: &mut Parser) -> Result<ClassDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let decorator_list: Option<DecoratorListNode> = if p.peek_kind() == TK_LIT_AT {
        let decorator_list = parse_decorator_list(p)?;
        Option::<DecoratorListNode>::Some(decorator_list)
    } else {
        null
    };
    let export__default: Option<ExportDefaultOptItem> = if p.peek_kind() == TK_Export {
        let export_ = p.expect(TK_Export)?;
        let default: Option<Token> = if p.peek_kind() == TK_Default {
            let default = p.expect(TK_Default)?;
            Option::<Token>::Some(default)
        } else {
            null
        };
        let export__default = ExportDefaultOptItem {
            export_,
            default,
        };
        Option::<ExportDefaultOptItem>::Some(export__default)
    } else {
        null
    };
    let abstract: Option<Token> = if p.peek_kind() == TK_Abstract {
        let abstract = p.expect(TK_Abstract)?;
        Option::<Token>::Some(abstract)
    } else {
        null
    };
    let class = p.expect(TK_Class)?;
    let identifier = parse_identifier(p)?;
    let type_parameters: Option<TypeParametersNode> = if p.peek_kind() == TK_LIT_LT {
        let type_parameters = parse_type_parameters(p)?;
        Option::<TypeParametersNode>::Some(type_parameters)
    } else {
        null
    };
    let class_heritage = parse_class_heritage(p)?;
    let class_tail = parse_class_tail(p)?;
    return Result::<ClassDeclarationNode, ParseError>::Ok(ClassDeclarationNode {
        span: Span::new(start, p.last_end()),
        decorator_list,
        export__default,
        abstract,
        class,
        identifier,
        type_parameters,
        class_heritage,
        class_tail,
    });
}

