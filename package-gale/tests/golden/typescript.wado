fn parse_try_statement(p: &mut Parser) -> Result<TryStatementNode, ParseError> {
    let start = p.peek().span.start;
    let try = p.expect(TK_Try)?;
    let block = parse_block(p)?;
    let mut group_0_inner: Option<TryStatementGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_Catch {
        let catch_production = parse_catch_production(p)?;
        let finally_production: Option<FinallyProductionNode> = if p.peek_kind() == TK_Finally {
            let finally_production = parse_finally_production(p)?;
            Option::<FinallyProductionNode>::Some(finally_production)
        } else {
            null
        };
        group_0_inner = Option::<TryStatementGroup0>::Some(TryStatementGroup0::Alt0(TryStatementGroup0Alt0 {
            catch_production,
            finally_production,
        }));
    } else if grp_kind == TK_Finally {
        let finally_production = parse_finally_production(p)?;
        group_0_inner = Option::<TryStatementGroup0>::Some(TryStatementGroup0::Alt1(TryStatementGroup0Alt1 {
            finally_production,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<TryStatementNode, ParseError>::Ok(TryStatementNode {
        span: Span::new(start, p.last_end()),
