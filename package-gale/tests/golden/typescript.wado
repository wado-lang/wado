fn scan_eos(tokens: &Array<Token>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind == TK_SemiColon {
            let mut best_pos: i32 = -1;
            pos = start;
            try_0: {
                if pos >= tokens.len() || tokens[pos].kind != TK_SemiColon { break try_0; }
                pos += 1;
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_2: {
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_3: {
                if pos > best_pos { best_pos = pos; }
            }
            if best_pos >= 0 { pos = best_pos; break scan_alts; }
            return -1;
        } else if alt_kind == TK_EOF {
            let mut best_pos: i32 = -1;
            pos = start;
            try_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_EOF { break try_1; }
                pos += 1;
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_2: {
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_3: {
                if pos > best_pos { best_pos = pos; }
            }
            if best_pos >= 0 { pos = best_pos; break scan_alts; }
            return -1;
        } else {
            let mut best_pos: i32 = -1;
            pos = start;
            try_2: {
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_3: {
                if pos > best_pos { best_pos = pos; }
            }
            if best_pos >= 0 { pos = best_pos; break scan_alts; }
            return -1;
        }
    }
    return pos;
}

fn parse_initializer(p: &mut Parser) -> Result<InitializerNode, ParseError> {
    let start = p.peek().span.start;
    let eq = p.expect(TK_LIT_EQ)?;
    let single_expression = parse_single_expression(p)?;
    return Result::<InitializerNode, ParseError>::Ok(InitializerNode {
        span: Span::new(start, p.last_end()),
        eq,
        single_expression,
    });
}

fn parse_binding_pattern(p: &mut Parser) -> Result<BindingPatternNode, ParseError> {
    let start = p.peek().span.start;
    let mut array_literal_or_object_literal_inner: Option<ArrayLiteralOrObjectLiteralGroup> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_LBRACKET {
        let array_literal = parse_array_literal(p)?;
        array_literal_or_object_literal_inner = Option::<ArrayLiteralOrObjectLiteralGroup>::Some(ArrayLiteralOrObjectLiteralGroup::ArrayLiteral(array_literal));
    } else if grp_kind == TK_LIT_LBRACE {
        let object_literal = parse_object_literal(p)?;
        array_literal_or_object_literal_inner = Option::<ArrayLiteralOrObjectLiteralGroup>::Some(ArrayLiteralOrObjectLiteralGroup::ObjectLiteral(object_literal));
    }
    let array_literal_or_object_literal = array_literal_or_object_literal_inner;
    return Result::<BindingPatternNode, ParseError>::Ok(BindingPatternNode {
        span: Span::new(start, p.last_end()),
        array_literal_or_object_literal,
    });
}

fn parse_type_parameters(p: &mut Parser) -> Result<TypeParametersNode, ParseError> {
    let start = p.peek().span.start;
    let lt = p.expect(TK_LIT_LT)?;
    let type_parameter_list: Option<TypeParameterListNode> = if p.peek_kind() matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_LIT_LT } {
        let type_parameter_list = parse_type_parameter_list(p)?;
        Option::<TypeParameterListNode>::Some(type_parameter_list)
    } else {
        null
    };
    let gt = p.expect(TK_LIT_GT)?;
    return Result::<TypeParametersNode, ParseError>::Ok(TypeParametersNode {
        span: Span::new(start, p.last_end()),
        lt,
        type_parameter_list,
        gt,
    });
}

fn parse_type_parameter_list(p: &mut Parser) -> Result<TypeParameterListNode, ParseError> {
    let start = p.peek().span.start;
