    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<GeneratorBlockNode, ParseError>::Ok(GeneratorBlockNode {
        span: Span::new(start, p.last_end()),
        lbrace,
        generator_definition,
        comma_generator_definition_list,
        comma,
        rbrace,
    });
