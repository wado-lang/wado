fn parse_type_member_list(p: &mut Parser) -> Result<TypeMemberListNode, ParseError> {
    let start = p.peek().span.start;
    let type_member = parse_type_member(p)?;
    let mut item_type_member_list: Array<ItemTypeMemberItem> = [];
    while p.peek_kind() matches { TK_SemiColon | TK_LIT_COMMA } {
        let semicolon_or_comma = p.advance();
        let type_member = parse_type_member(p)?;
        let item_type_member = ItemTypeMemberItem {
