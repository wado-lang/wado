fn parse_argument_list(p: &mut Parser) -> Result<ArgumentListNode, ParseError> {
    let start = p.peek().span.start;
    let argument = parse_argument(p)?;
    let mut comma_argument_list: Array<CommaArgumentItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let argument = parse_argument(p)?;
        let comma_argument = CommaArgumentItem {
            comma,
            argument,
        };
        comma_argument_list.push(comma_argument);
    }
    return Result::<ArgumentListNode, ParseError>::Ok(ArgumentListNode {
        span: Span::new(start, p.last_end()),
        argument,
        comma_argument_list,
    });
}

fn parse_argument(p: &mut Parser) -> Result<ArgumentNode, ParseError> {
    let start = p.peek().span.start;
    let ellipsis: Option<Token> = if p.peek_kind() == TK_Ellipsis {
        let ellipsis = p.expect(TK_Ellipsis)?;
        Option::<Token>::Some(ellipsis)
    } else {
        null
    };
    let mut single_expression_or_identifier_inner: Option<SingleExpressionOrIdentifierGroup> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_Async | TK_Function_ | TK_Identifier | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_LIT_LBRACE | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let opt_r = parse_single_expression(p);
                if let Err(_) = opt_r { p.pos = saved_pos; break bt_try; }
                single_expression_or_identifier_inner = Option::<SingleExpressionOrIdentifierGroup>::Some(SingleExpressionOrIdentifierGroup::SingleExpression(opt_r.unwrap()));
                bt_done = true;
            }
        }
        if !bt_done {
            let identifier = parse_identifier(p)?;
            single_expression_or_identifier_inner = Option::<SingleExpressionOrIdentifierGroup>::Some(SingleExpressionOrIdentifierGroup::Identifier(identifier));
        }
    }
    let single_expression_or_identifier = single_expression_or_identifier_inner;
    return Result::<ArgumentNode, ParseError>::Ok(ArgumentNode {
        span: Span::new(start, p.last_end()),
        ellipsis,
        single_expression_or_identifier,
    });
}

fn parse_expression_sequence(p: &mut Parser) -> Result<ExpressionSequenceNode, ParseError> {
    let start = p.peek().span.start;
    let single_expression = parse_single_expression(p)?;
    let mut comma_single_expression_list: Array<CommaSingleExpressionItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let single_expression = parse_single_expression(p)?;
        let comma_single_expression = CommaSingleExpressionItem {
            comma,
            single_expression,
        };
        comma_single_expression_list.push(comma_single_expression);
    }
    return Result::<ExpressionSequenceNode, ParseError>::Ok(ExpressionSequenceNode {
        span: Span::new(start, p.last_end()),
        single_expression,
        comma_single_expression_list,
    });
}

fn parse_single_expression_bt_1(p: &mut Parser) -> Result<SingleExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let class = p.expect(TK_Class)?;
    let identifier: Option<IdentifierNode> = if p.peek_kind() matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract } {
        let identifier = parse_identifier(p)?;
        Option::<IdentifierNode>::Some(identifier)
    } else {
        null
    };
    let type_parameters: Option<TypeParametersNode> = if p.peek_kind() == TK_LIT_LT {
        let type_parameters = parse_type_parameters(p)?;
        Option::<TypeParametersNode>::Some(type_parameters)
    } else {
        null
    };
    let class_heritage = parse_class_heritage(p)?;
    let class_tail = parse_class_tail(p)?;
    return Result::<SingleExpressionNode, ParseError>::Ok(SingleExpressionNode::ClassExpression(SingleExpressionClassExpression {
        span: Span::new(start, p.last_end()),
        class,
        identifier,
        type_parameters,
        class_heritage,
        class_tail,
    }));
}

fn parse_single_expression_scan_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_Class { return -1; }
    pos += 1;
    if pos < tokens.len() && tokens[pos].kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract } {
        let sp = pos;
        pos = scan_identifier(tokens, pos);
        if pos < 0 { pos = sp; }
    }
    return pos;
}

