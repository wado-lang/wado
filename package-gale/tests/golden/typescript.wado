        TK_LIT_QUESTIONQUESTIONEQ => "TK_LIT_QUESTIONQUESTIONEQ",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        let name = token_kind_name(kind);
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn fail(&self, name: String) -> Result<Token, ParseError> {
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }

    fn match_any(&mut self) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind != TK_EOF {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected any token, got "{tok.text}"`,
            tok.span,
            ["any token"],
        ));
    }

    fn match_not(&mut self, excluded: &Array<i32>) -> Result<Token, ParseError> {
        let k = self.tokens[self.pos].kind;
        if k != TK_EOF {
            let mut blocked = false;
            for let x of excluded {
                if *x == k {
                    blocked = true;
                    break;
                }
            }
            if !blocked {
                return Result::<Token, ParseError>::Ok(self.advance());
            }
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `unexpected token "{tok.text}"`,
            tok.span,
            ["set complement"],
        ));
    }
}

fn scan_initializer(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_EQ { return -1; }
    pos += 1;
    pos = scan_single_expression(tokens, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_binding_pattern(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    let gp_0 = pos;
    let sgk_0 = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    if sgk_0 matches { TK_LIT_LBRACKET | TK_LIT_LBRACE } {
        sg_0: {
            pos = gp_0;
            sg_0_0: {
                pos = scan_array_literal(tokens, pos);
                if pos < 0 { break sg_0_0; }
                break sg_0;
            }
            pos = gp_0;
            sg_0_1: {
                pos = scan_object_literal(tokens, pos);
                if pos < 0 { break sg_0_1; }
                break sg_0;
            }
            pos = gp_0;
        }
    }
    return pos;
}

fn scan_type_parameters(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LT { return -1; }
    pos += 1;
    if pos < tokens.len() && tokens[pos].kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_LIT_LT } {
        let sp = pos;
        pos = scan_type_parameter_list(tokens, pos);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_GT { return -1; }
    pos += 1;
    return pos;
}

fn scan_type_parameter_list(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_type_parameter(tokens, pos);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
        let sp = pos;
        sg_1_done: {
            sg_1: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_1; }
                pos += 1;
                pos = scan_type_parameter(tokens, pos);
                if pos < 0 { break sg_1; }
                break sg_1_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_type_parameter(tokens: &Array<Token>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract } {
            let mut best_pos: i32 = -1;
            pos = start;
            try_0: {
                pos = scan_identifier(tokens, pos);
                if pos < 0 { break try_0; }
                if pos < tokens.len() && tokens[pos].kind == TK_LIT_EXTENDS {
                    let sp = pos;
                    pos = scan_constraint(tokens, pos);
                    if pos < 0 { pos = sp; }
                }
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_1: {
                pos = scan_identifier(tokens, pos);
                if pos < 0 { break try_1; }
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_EQ { break try_1; }
                pos += 1;
                pos = scan_type_argument(tokens, pos);
                if pos < 0 { break try_1; }
                if pos > best_pos { best_pos = pos; }
            }
            if best_pos >= 0 { pos = best_pos; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_LT {
            pos = start;
            try_2: {
                pos = scan_type_parameters(tokens, pos);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_constraint(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_EXTENDS { return -1; }
    pos += 1;
    pos = scan_type_(tokens, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_type_arguments(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LT { return -1; }
    pos += 1;
    if pos < tokens.len() && tokens[pos].kind matches { TK_LIT_PIPE | TK_LIT_AMP | TK_LIT_LPAREN | TK_Any | TK_NullLiteral | TK_Number | TK_DecimalLiteral | TK_Boolean | TK_BooleanLiteral | TK_String | TK_StringLiteral | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_Void | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_TYPEOF | TK_This | TK_LIT_LT | TK_LIT_NEW } {
        let sp = pos;
        pos = scan_type_argument_list(tokens, pos);
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_GT { return -1; }
    pos += 1;
    return pos;
}

fn scan_type_argument_list(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_type_argument(tokens, pos);
    if pos < 0 { return -1; }
    while pos < tokens.len() && tokens[pos].kind == TK_LIT_COMMA {
        let sp = pos;
        sg_2_done: {
            sg_2: {
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_COMMA { break sg_2; }
                pos += 1;
                pos = scan_type_argument(tokens, pos);
                if pos < 0 { break sg_2; }
                break sg_2_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; break; }
        if pos == sp { break; }
    }
    return pos;
}

fn scan_type_argument(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_type_(tokens, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_type_(tokens: &Array<Token>, pos: i32) -> i32 {
    let start = pos;
    let mut pos = pos;
    let alt_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
    scan_alts: {
        if alt_kind matches { TK_LIT_PIPE | TK_LIT_AMP | TK_Any | TK_NullLiteral | TK_Number | TK_DecimalLiteral | TK_Boolean | TK_BooleanLiteral | TK_String | TK_StringLiteral | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_Void | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_LIT_TYPEOF | TK_This } {
            pos = start;
            try_0: {
                if pos < tokens.len() && tokens[pos].kind matches { TK_LIT_PIPE | TK_LIT_AMP } {
                    let sp = pos;
                    let gp_3 = pos;
                    sg_3: {
                        pos = gp_3;
                        sg_3_0: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_PIPE { break sg_3_0; }
                            pos += 1;
                            break sg_3;
                        }
                        pos = gp_3;
                        sg_3_1: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_AMP { break sg_3_1; }
                            pos += 1;
                            break sg_3;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; }
                }
                pos = scan_union_or_intersection_or_primary_type(tokens, pos);
                if pos < 0 { break try_0; }
                break scan_alts;
            }
            return -1;
        } else if alt_kind == TK_LIT_LPAREN {
            let mut best_pos: i32 = -1;
            pos = start;
            try_0: {
                if pos < tokens.len() && tokens[pos].kind matches { TK_LIT_PIPE | TK_LIT_AMP } {
                    let sp = pos;
                    let gp_4 = pos;
                    sg_4: {
                        pos = gp_4;
                        sg_4_0: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_PIPE { break sg_4_0; }
                            pos += 1;
                            break sg_4;
                        }
                        pos = gp_4;
                        sg_4_1: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_AMP { break sg_4_1; }
                            pos += 1;
                            break sg_4;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; }
                }
                pos = scan_union_or_intersection_or_primary_type(tokens, pos);
                if pos < 0 { break try_0; }
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_1: {
                pos = scan_function_type(tokens, pos);
                if pos < 0 { break try_1; }
                if pos > best_pos { best_pos = pos; }
            }
            if best_pos >= 0 { pos = best_pos; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_LT {
            let mut best_pos: i32 = -1;
            pos = start;
            try_1: {
                pos = scan_function_type(tokens, pos);
                if pos < 0 { break try_1; }
                if pos > best_pos { best_pos = pos; }
            }
            pos = start;
            try_3: {
                pos = scan_type_generic(tokens, pos);
                if pos < 0 { break try_3; }
                if pos > best_pos { best_pos = pos; }
            }
            if best_pos >= 0 { pos = best_pos; break scan_alts; }
            return -1;
        } else if alt_kind == TK_LIT_NEW {
            pos = start;
            try_2: {
                pos = scan_constructor_type(tokens, pos);
                if pos < 0 { break try_2; }
                break scan_alts;
            }
            return -1;
        } else {
            return -1;
        }
    }
    return pos;
}

fn scan_union_or_intersection_or_primary_type_atom(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    pos = scan_primary_type(tokens, pos);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_union_or_intersection_or_primary_type_lr_0(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_PIPE { return -1; }
    pos += 1;
    pos = scan_union_or_intersection_or_primary_type_prec(tokens, pos, 3);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_union_or_intersection_or_primary_type_lr_1(tokens: &Array<Token>, pos: i32) -> i32 {
    let mut pos = pos;
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_AMP { return -1; }
    pos += 1;
    pos = scan_union_or_intersection_or_primary_type_prec(tokens, pos, 2);
    if pos < 0 { return -1; }
    return pos;
}

fn scan_union_or_intersection_or_primary_type_prec(tokens: &Array<Token>, pos: i32, min_prec: i32) -> i32 {
    let mut pos = scan_union_or_intersection_or_primary_type_atom(tokens, pos);
    if pos < 0 { return -1; }
    loop {
        let suffix_kind = if pos < tokens.len() { tokens[pos].kind } else { TK_EOF };
        if suffix_kind == TK_LIT_PIPE {
            if 2 >= min_prec {
                pos = scan_union_or_intersection_or_primary_type_lr_0(tokens, pos);
                if pos < 0 { return -1; }
            } else {
                break;
