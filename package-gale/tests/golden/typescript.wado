fn parse_property_signatur(p: &mut Parser) -> Result<PropertySignaturNode, ParseError> {
    let start = p.peek().span.start;
    let readonly: Option<Token> = if p.peek_kind() == TK_ReadOnly {
        let readonly = p.expect(TK_ReadOnly)?;
        Option::<Token>::Some(readonly)
    } else {
        null
    };
    let property_name = parse_property_name(p)?;
    let question: Option<Token> = if p.peek_kind() == TK_LIT_QUESTION {
        let question = p.expect(TK_LIT_QUESTION)?;
        Option::<Token>::Some(question)
    } else {
        null
    };
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    let lit_eqgt_type_: Option<LitEqgtTypeItem> = if p.peek_kind() == TK_LIT_EQGT {
        let lit_eqgt = p.expect(TK_LIT_EQGT)?;
        let type_ = parse_type_(p)?;
        let lit_eqgt_type_ = LitEqgtTypeItem {
            lit_eqgt,
            type_,
        };
        Option::<LitEqgtTypeItem>::Some(lit_eqgt_type_)
    } else {
        null
    };
    return Result::<PropertySignaturNode, ParseError>::Ok(PropertySignaturNode {
        span: Span::new(start, p.last_end()),
        readonly,
        property_name,
        question,
        type_annotation,
        lit_eqgt_type_,
    });
}

fn parse_type_annotation(p: &mut Parser) -> Result<TypeAnnotationNode, ParseError> {
    let start = p.peek().span.start;
    let colon = p.expect(TK_LIT_COLON)?;
    let type_ = parse_type_(p)?;
    return Result::<TypeAnnotationNode, ParseError>::Ok(TypeAnnotationNode {
        span: Span::new(start, p.last_end()),
        colon,
        type_,
    });
}

fn parse_call_signature(p: &mut Parser) -> Result<CallSignatureNode, ParseError> {
    let start = p.peek().span.start;
    let type_parameters: Option<TypeParametersNode> = if p.peek_kind() == TK_LIT_LT {
        let type_parameters = parse_type_parameters(p)?;
        Option::<TypeParametersNode>::Some(type_parameters)
    } else {
        null
    };
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let parameter_list: Option<ParameterListNode> = if p.peek_kind() matches { TK_LIT_DOTDOTDOT | TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_LIT_LBRACKET | TK_LIT_LBRACE } {
        let parameter_list = parse_parameter_list(p)?;
        Option::<ParameterListNode>::Some(parameter_list)
    } else {
        null
    };
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    return Result::<CallSignatureNode, ParseError>::Ok(CallSignatureNode {
        span: Span::new(start, p.last_end()),
        type_parameters,
        lparen,
        parameter_list,
        rparen,
        type_annotation,
    });
}

fn parse_parameter_list(p: &mut Parser) -> Result<ParameterListNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_DOTDOTDOT {
        let rest_parameter = parse_rest_parameter(p)?;
        return Result::<ParameterListNode, ParseError>::Ok(ParameterListNode::Alt0(ParameterListAlt0 {
            span: Span::new(start, p.last_end()),
            rest_parameter,
        }));
    }
    if kind matches { TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_LIT_LBRACKET | TK_LIT_LBRACE } {
        let parameter = parse_parameter(p)?;
        let mut comma_parameter_list: Array<CommaParameterItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let parameter = parse_parameter(p)?;
            let comma_parameter = CommaParameterItem {
                comma,
                parameter,
            };
            comma_parameter_list.push(comma_parameter);
        }
        let comma_rest_parameter: Option<CommaRestParameterItem> = if p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let rest_parameter = parse_rest_parameter(p)?;
            let comma_rest_parameter = CommaRestParameterItem {
                comma,
                rest_parameter,
            };
            Option::<CommaRestParameterItem>::Some(comma_rest_parameter)
        } else {
            null
        };
        let comma: Option<Token> = if p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            Option::<Token>::Some(comma)
        } else {
            null
        };
        return Result::<ParameterListNode, ParseError>::Ok(ParameterListNode::Alt1(ParameterListAlt1 {
            span: Span::new(start, p.last_end()),
            parameter,
            comma_parameter_list,
            comma_rest_parameter,
            comma,
        }));
    }
    return Result::<ParameterListNode, ParseError>::Err(ParseError::new(
        "expected parameterList",
        p.peek().span,
        ["TK_LIT_DOTDOTDOT", "TK_LIT_AT", "TK_Public", "TK_Private", "TK_Protected", "TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Interface", "TK_Package", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_LIT_LBRACKET", "TK_LIT_LBRACE"],
    ));
}

fn parse_required_parameter_list(p: &mut Parser) -> Result<RequiredParameterListNode, ParseError> {
    let start = p.peek().span.start;
    let required_parameter = parse_required_parameter(p)?;
    let mut comma_required_parameter_list: Array<CommaRequiredParameterItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let required_parameter = parse_required_parameter(p)?;
        let comma_required_parameter = CommaRequiredParameterItem {
            comma,
            required_parameter,
        };
        comma_required_parameter_list.push(comma_required_parameter);
    }
    return Result::<RequiredParameterListNode, ParseError>::Ok(RequiredParameterListNode {
        span: Span::new(start, p.last_end()),
        required_parameter,
        comma_required_parameter_list,
    });
}

fn parse_parameter_bt_0(p: &mut Parser) -> Result<ParameterNode, ParseError> {
    let start = p.peek().span.start;
    let required_parameter = parse_required_parameter(p)?;
    return Result::<ParameterNode, ParseError>::Ok(ParameterNode::Alt0(ParameterAlt0 {
        span: Span::new(start, p.last_end()),
        required_parameter,
    }));
}

fn parse_parameter_bt_1(p: &mut Parser) -> Result<ParameterNode, ParseError> {
    let start = p.peek().span.start;
    let optional_parameter = parse_optional_parameter(p)?;
    return Result::<ParameterNode, ParseError>::Ok(ParameterNode::Alt1(ParameterAlt1 {
        span: Span::new(start, p.last_end()),
        optional_parameter,
    }));
}

fn parse_parameter(p: &mut Parser) -> Result<ParameterNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_LIT_LBRACKET | TK_LIT_LBRACE } {
        if p.peek_kind() matches { TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_LIT_LBRACKET | TK_LIT_LBRACE } {
            let saved = p.pos;
            let r_0 = parse_parameter_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_parameter_bt_1(p);
        }
    }
    return Result::<ParameterNode, ParseError>::Err(ParseError::new(
        "expected parameter",
        p.peek().span,
        ["TK_LIT_AT", "TK_Public", "TK_Private", "TK_Protected", "TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Interface", "TK_Package", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_LIT_LBRACKET", "TK_LIT_LBRACE"],
    ));
}

fn parse_optional_parameter(p: &mut Parser) -> Result<OptionalParameterNode, ParseError> {
    let start = p.peek().span.start;
    let decorator_list: Option<DecoratorListNode> = if p.peek_kind() == TK_LIT_AT {
        let decorator_list = parse_decorator_list(p)?;
        Option::<DecoratorListNode>::Some(decorator_list)
    } else {
        null
    };
    let accessibility_modifier: Option<AccessibilityModifierNode> = if p.peek_kind() matches { TK_Public | TK_Private | TK_Protected } {
        let accessibility_modifier = parse_accessibility_modifier(p)?;
        Option::<AccessibilityModifierNode>::Some(accessibility_modifier)
    } else {
        null
    };
    let identifier_or_pattern = parse_identifier_or_pattern(p)?;
    let mut group_0_inner: Option<OptionalParameterGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_QUESTION {
        let question = p.expect(TK_LIT_QUESTION)?;
        let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
            let type_annotation = parse_type_annotation(p)?;
            Option::<TypeAnnotationNode>::Some(type_annotation)
        } else {
            null
        };
        group_0_inner = Option::<OptionalParameterGroup0>::Some(OptionalParameterGroup0::Alt0(OptionalParameterGroup0Alt0 {
            question,
            type_annotation,
        }));
    } else if grp_kind matches { TK_LIT_COLON | TK_LIT_EQ } {
        let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
            let type_annotation = parse_type_annotation(p)?;
            Option::<TypeAnnotationNode>::Some(type_annotation)
        } else {
            null
        };
        let initializer = parse_initializer(p)?;
        group_0_inner = Option::<OptionalParameterGroup0>::Some(OptionalParameterGroup0::Alt1(OptionalParameterGroup0Alt1 {
            type_annotation,
            initializer,
        }));
    }
    let group_0 = group_0_inner;
    let accessibility_modifier_identifier_or_pattern_item = AccessibilityModifierOptIdentifierOrPatternItemItem {
        accessibility_modifier,
        identifier_or_pattern,
        group_0,
    };
    return Result::<OptionalParameterNode, ParseError>::Ok(OptionalParameterNode {
        span: Span::new(start, p.last_end()),
        decorator_list,
        accessibility_modifier_identifier_or_pattern_item,
    });
}

fn parse_rest_parameter(p: &mut Parser) -> Result<RestParameterNode, ParseError> {
    let start = p.peek().span.start;
    let lit_dotdotdot = p.expect(TK_LIT_DOTDOTDOT)?;
    let single_expression = parse_single_expression(p)?;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    return Result::<RestParameterNode, ParseError>::Ok(RestParameterNode {
        span: Span::new(start, p.last_end()),
        lit_dotdotdot,
        single_expression,
        type_annotation,
    });
}

fn parse_required_parameter(p: &mut Parser) -> Result<RequiredParameterNode, ParseError> {
    let start = p.peek().span.start;
    let decorator_list: Option<DecoratorListNode> = if p.peek_kind() == TK_LIT_AT {
        let decorator_list = parse_decorator_list(p)?;
        Option::<DecoratorListNode>::Some(decorator_list)
    } else {
        null
    };
    let accessibility_modifier: Option<AccessibilityModifierNode> = null;
    let identifier_or_pattern = parse_identifier_or_pattern(p)?;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    return Result::<RequiredParameterNode, ParseError>::Ok(RequiredParameterNode {
        span: Span::new(start, p.last_end()),
        decorator_list,
        accessibility_modifier,
        identifier_or_pattern,
        type_annotation,
    });
}

fn parse_accessibility_modifier(p: &mut Parser) -> Result<AccessibilityModifierNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_Public {
        let public = p.expect(TK_Public)?;
        return Result::<AccessibilityModifierNode, ParseError>::Ok(AccessibilityModifierNode::Alt0(AccessibilityModifierAlt0 {
            span: Span::new(start, p.last_end()),
            public,
        }));
    }
    if kind == TK_Private {
        let private = p.expect(TK_Private)?;
        return Result::<AccessibilityModifierNode, ParseError>::Ok(AccessibilityModifierNode::Alt1(AccessibilityModifierAlt1 {
            span: Span::new(start, p.last_end()),
            private,
        }));
    }
    if kind == TK_Protected {
        let protected = p.expect(TK_Protected)?;
        return Result::<AccessibilityModifierNode, ParseError>::Ok(AccessibilityModifierNode::Alt2(AccessibilityModifierAlt2 {
            span: Span::new(start, p.last_end()),
            protected,
        }));
    }
    return Result::<AccessibilityModifierNode, ParseError>::Err(ParseError::new(
        "expected accessibilityModifier",
        p.peek().span,
        ["TK_Public", "TK_Private", "TK_Protected"],
    ));
}

fn parse_identifier_or_pattern(p: &mut Parser) -> Result<IdentifierOrPatternNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral } {
        let identifier_name = parse_identifier_name(p)?;
        return Result::<IdentifierOrPatternNode, ParseError>::Ok(IdentifierOrPatternNode::Alt0(IdentifierOrPatternAlt0 {
            span: Span::new(start, p.last_end()),
            identifier_name,
        }));
    }
    if kind matches { TK_LIT_LBRACKET | TK_LIT_LBRACE } {
        let binding_pattern = parse_binding_pattern(p)?;
        return Result::<IdentifierOrPatternNode, ParseError>::Ok(IdentifierOrPatternNode::Alt1(IdentifierOrPatternAlt1 {
            span: Span::new(start, p.last_end()),
            binding_pattern,
        }));
    }
    return Result::<IdentifierOrPatternNode, ParseError>::Err(ParseError::new(
        "expected identifierOrPattern",
        p.peek().span,
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_Break", "TK_Do", "TK_Instanceof", "TK_Typeof", "TK_Case", "TK_Else", "TK_New", "TK_Var", "TK_Catch", "TK_Finally", "TK_Return", "TK_Void", "TK_Continue", "TK_For", "TK_Switch", "TK_While", "TK_Debugger", "TK_Function_", "TK_This", "TK_With", "TK_Default", "TK_If", "TK_Throw", "TK_Delete", "TK_In", "TK_Try", "TK_Class", "TK_Enum", "TK_Extends", "TK_Super", "TK_Const", "TK_Export", "TK_Import", "TK_Implements", "TK_Let", "TK_Private", "TK_Public", "TK_Interface", "TK_Package", "TK_Protected", "TK_Static", "TK_Await", "TK_ReadOnly", "TK_Require", "TK_Module", "TK_NullLiteral", "TK_BooleanLiteral", "TK_LIT_LBRACKET", "TK_LIT_LBRACE"],
    ));
}

fn parse_construct_signature(p: &mut Parser) -> Result<ConstructSignatureNode, ParseError> {
    let start = p.peek().span.start;
    let lit_new = p.expect(TK_LIT_NEW)?;
    let type_parameters: Option<TypeParametersNode> = if p.peek_kind() == TK_LIT_LT {
        let type_parameters = parse_type_parameters(p)?;
        Option::<TypeParametersNode>::Some(type_parameters)
    } else {
        null
    };
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let parameter_list: Option<ParameterListNode> = if p.peek_kind() matches { TK_LIT_DOTDOTDOT | TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_LIT_LBRACKET | TK_LIT_LBRACE } {
        let parameter_list = parse_parameter_list(p)?;
        Option::<ParameterListNode>::Some(parameter_list)
    } else {
        null
    };
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let type_annotation: Option<TypeAnnotationNode> = if p.peek_kind() == TK_LIT_COLON {
        let type_annotation = parse_type_annotation(p)?;
        Option::<TypeAnnotationNode>::Some(type_annotation)
    } else {
        null
    };
    return Result::<ConstructSignatureNode, ParseError>::Ok(ConstructSignatureNode {
        span: Span::new(start, p.last_end()),
        lit_new,
        type_parameters,
        lparen,
        parameter_list,
        rparen,
        type_annotation,
    });
}

fn parse_index_signature(p: &mut Parser) -> Result<IndexSignatureNode, ParseError> {
    let start = p.peek().span.start;
    let lbracket = p.expect(TK_LIT_LBRACKET)?;
    let identifier = parse_identifier(p)?;
    let colon = p.expect(TK_LIT_COLON)?;
    let number_or_string = p.advance();
    let rbracket = p.expect(TK_LIT_RBRACKET)?;
    let type_annotation = parse_type_annotation(p)?;
    return Result::<IndexSignatureNode, ParseError>::Ok(IndexSignatureNode {
        span: Span::new(start, p.last_end()),
        lbracket,
        identifier,
        colon,
        number_or_string,
        rbracket,
        type_annotation,
    });
}

fn parse_method_signature(p: &mut Parser) -> Result<MethodSignatureNode, ParseError> {
    let start = p.peek().span.start;
    let property_name = parse_property_name(p)?;
    let question: Option<Token> = if p.peek_kind() == TK_LIT_QUESTION {
        let question = p.expect(TK_LIT_QUESTION)?;
        Option::<Token>::Some(question)
    } else {
        null
    };
    let call_signature = parse_call_signature(p)?;
    return Result::<MethodSignatureNode, ParseError>::Ok(MethodSignatureNode {
        span: Span::new(start, p.last_end()),
        property_name,
        question,
        call_signature,
    });
}

fn parse_type_alias_declaration(p: &mut Parser) -> Result<TypeAliasDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let export_: Option<Token> = if p.peek_kind() == TK_Export {
        let export_ = p.expect(TK_Export)?;
        Option::<Token>::Some(export_)
    } else {
        null
    };
    let lit_type = p.expect(TK_LIT_TYPE)?;
    let identifier = parse_identifier(p)?;
    let type_parameters: Option<TypeParametersNode> = if p.peek_kind() == TK_LIT_LT {
        let type_parameters = parse_type_parameters(p)?;
        Option::<TypeParametersNode>::Some(type_parameters)
    } else {
        null
    };
    let eq = p.expect(TK_LIT_EQ)?;
    let type_ = parse_type_(p)?;
    let eos = parse_eos(p)?;
    return Result::<TypeAliasDeclarationNode, ParseError>::Ok(TypeAliasDeclarationNode {
        span: Span::new(start, p.last_end()),
        export_,
        lit_type,
        identifier,
        type_parameters,
        eq,
        type_,
        eos,
    });
}

fn parse_constructor_declaration(p: &mut Parser) -> Result<ConstructorDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let accessibility_modifier: Option<AccessibilityModifierNode> = if p.peek_kind() matches { TK_Public | TK_Private | TK_Protected } {
        let accessibility_modifier = parse_accessibility_modifier(p)?;
        Option::<AccessibilityModifierNode>::Some(accessibility_modifier)
    } else {
        null
    };
    let constructor = p.expect(TK_Constructor)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let formal_parameter_list: Option<FormalParameterListNode> = if p.peek_kind() matches { TK_LIT_AT | TK_Public | TK_Private | TK_Protected | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Interface | TK_Package | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_LIT_LBRACKET | TK_LIT_LBRACE | TK_Ellipsis } {
        let formal_parameter_list = parse_formal_parameter_list(p)?;
        Option::<FormalParameterListNode>::Some(formal_parameter_list)
    } else {
        null
    };
    let rparen = p.expect(TK_LIT_RPAREN)?;
    let group_0: Option<ConstructorDeclarationGroup0> = if p.peek_kind() matches { TK_LIT_LBRACE | TK_SemiColon } {
        let opt_saved = p.pos;
        let mut opt_result: Option<ConstructorDeclarationGroup0> = null;
        opt_bt: {
            let group_0: ConstructorDeclarationGroup0 = if p.peek_kind() == TK_LIT_LBRACE {
                let lbrace = p.expect(TK_LIT_LBRACE)?;
                let function_body = parse_function_body(p)?;
                let rbrace = p.expect(TK_LIT_RBRACE)?;
                let lbrace_function_body_rbrace = LbraceFunctionBodyRbraceItem {
                    lbrace,
                    function_body,
                    rbrace,
                };
                ConstructorDeclarationGroup0::Alt0(ConstructorDeclarationGroup0Alt0 {
                    lbrace_function_body_rbrace,
                })
            } else {
                let semicolon = p.expect(TK_SemiColon)?;
                ConstructorDeclarationGroup0::Alt1(ConstructorDeclarationGroup0Alt1 {
                    semicolon,
                })
            };
            opt_result = Option::<ConstructorDeclarationGroup0>::Some(group_0);
        }
        opt_result
    } else {
        null
    };
    return Result::<ConstructorDeclarationNode, ParseError>::Ok(ConstructorDeclarationNode {
        span: Span::new(start, p.last_end()),
        accessibility_modifier,
        constructor,
        lparen,
        formal_parameter_list,
        rparen,
        group_0,
    });
}

fn parse_interface_declaration(p: &mut Parser) -> Result<InterfaceDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let export_: Option<Token> = if p.peek_kind() == TK_Export {
        let export_ = p.expect(TK_Export)?;
        Option::<Token>::Some(export_)
    } else {
        null
    };
    let declare: Option<Token> = if p.peek_kind() == TK_Declare {
        let declare = p.expect(TK_Declare)?;
        Option::<Token>::Some(declare)
    } else {
        null
    };
    let interface = p.expect(TK_Interface)?;
    let identifier = parse_identifier(p)?;
    let type_parameters: Option<TypeParametersNode> = if p.peek_kind() == TK_LIT_LT {
        let type_parameters = parse_type_parameters(p)?;
        Option::<TypeParametersNode>::Some(type_parameters)
    } else {
        null
    };
    let interface_extends_clause: Option<InterfaceExtendsClauseNode> = if p.peek_kind() == TK_Extends {
        let interface_extends_clause = parse_interface_extends_clause(p)?;
        Option::<InterfaceExtendsClauseNode>::Some(interface_extends_clause)
    } else {
        null
    };
    let object_type = parse_object_type(p)?;
    let semicolon: Option<Token> = if p.peek_kind() == TK_SemiColon {
        let semicolon = p.expect(TK_SemiColon)?;
        Option::<Token>::Some(semicolon)
    } else {
        null
    };
    return Result::<InterfaceDeclarationNode, ParseError>::Ok(InterfaceDeclarationNode {
        span: Span::new(start, p.last_end()),
        export_,
        declare,
        interface,
        identifier,
        type_parameters,
        interface_extends_clause,
        object_type,
        semicolon,
    });
}

fn parse_interface_extends_clause(p: &mut Parser) -> Result<InterfaceExtendsClauseNode, ParseError> {
    let start = p.peek().span.start;
    let extends = p.expect(TK_Extends)?;
    let class_or_interface_type_list = parse_class_or_interface_type_list(p)?;
    return Result::<InterfaceExtendsClauseNode, ParseError>::Ok(InterfaceExtendsClauseNode {
        span: Span::new(start, p.last_end()),
        extends,
        class_or_interface_type_list,
    });
}

fn parse_class_or_interface_type_list(p: &mut Parser) -> Result<ClassOrInterfaceTypeListNode, ParseError> {
    let start = p.peek().span.start;
    let type_reference = parse_type_reference(p)?;
    let mut comma_type_reference_list: Array<CommaTypeReferenceItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let type_reference = parse_type_reference(p)?;
        let comma_type_reference = CommaTypeReferenceItem {
            comma,
            type_reference,
        };
        comma_type_reference_list.push(comma_type_reference);
    }
    return Result::<ClassOrInterfaceTypeListNode, ParseError>::Ok(ClassOrInterfaceTypeListNode {
        span: Span::new(start, p.last_end()),
        type_reference,
        comma_type_reference_list,
    });
}

fn parse_enum_declaration(p: &mut Parser) -> Result<EnumDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let const_: Option<Token> = if p.peek_kind() == TK_Const {
        let const_ = p.expect(TK_Const)?;
        Option::<Token>::Some(const_)
    } else {
        null
    };
    let enum_ = p.expect(TK_Enum)?;
    let identifier = parse_identifier(p)?;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let enum_body: Option<EnumBodyNode> = if p.peek_kind() matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Var | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_Function_ | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Class | TK_Enum | TK_Extends | TK_Super | TK_Const | TK_Export | TK_Import | TK_Implements | TK_Let | TK_Private | TK_Public | TK_Interface | TK_Package | TK_Protected | TK_Static | TK_Await | TK_ReadOnly | TK_Require | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LBRACKET } {
        let enum_body = parse_enum_body(p)?;
        Option::<EnumBodyNode>::Some(enum_body)
    } else {
        null
    };
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<EnumDeclarationNode, ParseError>::Ok(EnumDeclarationNode {
        span: Span::new(start, p.last_end()),
        const_,
        enum_,
        identifier,
        lbrace,
        enum_body,
        rbrace,
    });
}

fn parse_enum_body(p: &mut Parser) -> Result<EnumBodyNode, ParseError> {
    let start = p.peek().span.start;
    let enum_member_list = parse_enum_member_list(p)?;
    let comma: Option<Token> = if p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        Option::<Token>::Some(comma)
    } else {
        null
    };
    return Result::<EnumBodyNode, ParseError>::Ok(EnumBodyNode {
        span: Span::new(start, p.last_end()),
        enum_member_list,
        comma,
    });
}

fn parse_enum_member_list(p: &mut Parser) -> Result<EnumMemberListNode, ParseError> {
    let start = p.peek().span.start;
    let enum_member = parse_enum_member(p)?;
    let mut comma_enum_member_list: Array<CommaEnumMemberItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let enum_member = parse_enum_member(p)?;
        let comma_enum_member = CommaEnumMemberItem {
            comma,
            enum_member,
        };
        comma_enum_member_list.push(comma_enum_member);
    }
    return Result::<EnumMemberListNode, ParseError>::Ok(EnumMemberListNode {
        span: Span::new(start, p.last_end()),
        enum_member,
        comma_enum_member_list,
    });
}

fn parse_enum_member(p: &mut Parser) -> Result<EnumMemberNode, ParseError> {
    let start = p.peek().span.start;
    let property_name = parse_property_name(p)?;
    let eq_single_expression: Option<EqSingleExpressionItem> = if p.peek_kind() == TK_LIT_EQ {
        let eq = p.expect(TK_LIT_EQ)?;
        let single_expression = parse_single_expression(p)?;
        let eq_single_expression = EqSingleExpressionItem {
            eq,
            single_expression,
        };
        Option::<EqSingleExpressionItem>::Some(eq_single_expression)
    } else {
        null
    };
    return Result::<EnumMemberNode, ParseError>::Ok(EnumMemberNode {
        span: Span::new(start, p.last_end()),
        property_name,
        eq_single_expression,
    });
}

fn parse_namespace_declaration(p: &mut Parser) -> Result<NamespaceDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let declare: Option<Token> = if p.peek_kind() == TK_Declare {
        let declare = p.expect(TK_Declare)?;
        Option::<Token>::Some(declare)
    } else {
        null
    };
    let namespace = p.expect(TK_Namespace)?;
    let namespace_name = parse_namespace_name(p)?;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let statement_list: Option<StatementListNode> = if p.peek_kind() matches { TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_Export | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        let statement_list = parse_statement_list(p)?;
        Option::<StatementListNode>::Some(statement_list)
    } else {
        null
    };
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<NamespaceDeclarationNode, ParseError>::Ok(NamespaceDeclarationNode {
        span: Span::new(start, p.last_end()),
        declare,
        namespace,
        namespace_name,
        lbrace,
        statement_list,
        rbrace,
    });
}

fn parse_namespace_name(p: &mut Parser) -> Result<NamespaceNameNode, ParseError> {
    let start = p.peek().span.start;
    let identifier = parse_identifier(p)?;
    let mut dot_identifier_list: Array<DotListIdentifierItem> = [];
    loop {
        let mut rep_scan_pos: i32 = -1;
        rep_scan: {
            let tokens = &p.tokens;
            let mut pos: i32 = p.pos;
            if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break rep_scan; }
            pos += 1;
            while pos < tokens.len() && tokens[pos].kind == TK_LIT_DOT {
                let sp = pos;
                if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { pos = -1; } else { pos += 1; }
                if pos < 0 { pos = sp; break; }
                if pos == sp { break; }
            }
            pos = scan_identifier(tokens, pos);
            if pos < 0 { break rep_scan; }
            if pos <= p.pos { break rep_scan; }
            rep_scan_pos = pos;
        }
        if rep_scan_pos < 0 { break; }
        let mut dot_list: Array<Token> = [];
        let mut _plus_first = true;
        loop {
            if !_plus_first {
                let mut rep_scan_pos: i32 = -1;
                rep_scan: {
                    let tokens = &p.tokens;
                    let mut pos: i32 = p.pos;
                    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_DOT { break rep_scan; }
                    pos += 1;
                    if pos <= p.pos { break rep_scan; }
                    rep_scan_pos = pos;
                }
                if rep_scan_pos < 0 { break; }
            }
            _plus_first = false;
            let dot = p.expect(TK_LIT_DOT)?;
            dot_list.push(dot);
        }
        let identifier = parse_identifier(p)?;
        let dot_identifier = DotListIdentifierItem {
            dot_list,
            identifier,
        };
        dot_identifier_list.push(dot_identifier);
    }
    return Result::<NamespaceNameNode, ParseError>::Ok(NamespaceNameNode {
        span: Span::new(start, p.last_end()),
        identifier,
        dot_identifier_list,
    });
}

fn parse_import_alias_declaration(p: &mut Parser) -> Result<ImportAliasDeclarationNode, ParseError> {
    let start = p.peek().span.start;
    let identifier = parse_identifier(p)?;
    let eq = p.expect(TK_LIT_EQ)?;
    let namespace_name = parse_namespace_name(p)?;
    let semicolon = p.expect(TK_SemiColon)?;
    return Result::<ImportAliasDeclarationNode, ParseError>::Ok(ImportAliasDeclarationNode {
        span: Span::new(start, p.last_end()),
        identifier,
        eq,
        namespace_name,
        semicolon,
    });
}

fn parse_decorator_list(p: &mut Parser) -> Result<DecoratorListNode, ParseError> {
    let start = p.peek().span.start;
    let mut decorator_list: Array<DecoratorNode> = [];
    let mut _plus_first = true;
    while _plus_first || p.peek_kind() == TK_LIT_AT {
        _plus_first = false;
        let decorator = parse_decorator(p)?;
        decorator_list.push(decorator);
    }
    return Result::<DecoratorListNode, ParseError>::Ok(DecoratorListNode {
        span: Span::new(start, p.last_end()),
        decorator_list,
    });
}

fn parse_decorator(p: &mut Parser) -> Result<DecoratorNode, ParseError> {
    let start = p.peek().span.start;
    let at = p.expect(TK_LIT_AT)?;
    let mut decorator_member_expression_or_decorator_call_expression_inner: Option<DecoratorMemberExpressionOrDecoratorCallExpressionGroup> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_LIT_LPAREN } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let opt_r = parse_decorator_member_expression(p);
                if let Err(_) = opt_r { p.pos = saved_pos; break bt_try; }
                decorator_member_expression_or_decorator_call_expression_inner = Option::<DecoratorMemberExpressionOrDecoratorCallExpressionGroup>::Some(DecoratorMemberExpressionOrDecoratorCallExpressionGroup::DecoratorMemberExpression(opt_r.unwrap()));
                bt_done = true;
            }
        }
        if !bt_done {
            let decorator_call_expression = parse_decorator_call_expression(p)?;
            decorator_member_expression_or_decorator_call_expression_inner = Option::<DecoratorMemberExpressionOrDecoratorCallExpressionGroup>::Some(DecoratorMemberExpressionOrDecoratorCallExpressionGroup::DecoratorCallExpression(decorator_call_expression));
        }
    }
    let decorator_member_expression_or_decorator_call_expression = decorator_member_expression_or_decorator_call_expression_inner;
    return Result::<DecoratorNode, ParseError>::Ok(DecoratorNode {
        span: Span::new(start, p.last_end()),
        at,
        decorator_member_expression_or_decorator_call_expression,
    });
}

fn parse_decorator_member_expression_atom(p: &mut Parser) -> Result<DecoratorMemberExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract } {
        let identifier = parse_identifier(p)?;
        return Result::<DecoratorMemberExpressionNode, ParseError>::Ok(DecoratorMemberExpressionNode::Alt0(DecoratorMemberExpressionAlt0 {
            span: Span::new(start, p.last_end()),
            identifier,
        }));
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let single_expression = parse_single_expression(p)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::<DecoratorMemberExpressionNode, ParseError>::Ok(DecoratorMemberExpressionNode::Alt2(DecoratorMemberExpressionAlt2 {
            span: Span::new(start, p.last_end()),
            lparen,
            single_expression,
            rparen,
        }));
    }
    return Result::<DecoratorMemberExpressionNode, ParseError>::Err(ParseError::new(
        "expected decoratorMemberExpression",
        p.peek().span,
        ["TK_Identifier", "TK_Async", "TK_As", "TK_From", "TK_Yield", "TK_Of", "TK_Any", "TK_Number", "TK_Boolean", "TK_String", "TK_Unique", "TK_Symbol", "TK_Never", "TK_Undefined", "TK_Object", "TK_KeyOf", "TK_TypeAlias", "TK_Constructor", "TK_Namespace", "TK_Abstract", "TK_LIT_LPAREN"],
    ));
}

fn parse_decorator_member_expression_lr_1(p: &mut Parser, left: DecoratorMemberExpressionNode, start: i32) -> Result<DecoratorMemberExpressionNode, ParseError> {
    let dot = p.expect(TK_LIT_DOT)?;
    let identifier_name = parse_identifier_name(p)?;
    return Result::<DecoratorMemberExpressionNode, ParseError>::Ok(DecoratorMemberExpressionNode::Alt1(DecoratorMemberExpressionAlt1 {
        span: Span::new(start, p.last_end()),
        decorator_member_expression: left,
        dot,
        identifier_name,
    }));
}

fn parse_decorator_member_expression_prec(p: &mut Parser, min_prec: i32) -> Result<DecoratorMemberExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let mut result = parse_decorator_member_expression_atom(p)?;
    loop {
        let suffix_kind = p.peek_kind();
        if suffix_kind == TK_LIT_DOT {
            if 1 >= min_prec {
                result = parse_decorator_member_expression_lr_1(p, result, start)?;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return Result::<DecoratorMemberExpressionNode, ParseError>::Ok(result);
}

fn parse_decorator_member_expression(p: &mut Parser) -> Result<DecoratorMemberExpressionNode, ParseError> {
    return parse_decorator_member_expression_prec(p, 0);
}

fn parse_decorator_call_expression(p: &mut Parser) -> Result<DecoratorCallExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let decorator_member_expression = parse_decorator_member_expression(p)?;
    let arguments = parse_arguments(p)?;
    return Result::<DecoratorCallExpressionNode, ParseError>::Ok(DecoratorCallExpressionNode {
        span: Span::new(start, p.last_end()),
        decorator_member_expression,
        arguments,
    });
}

fn parse_program(p: &mut Parser) -> Result<ProgramNode, ParseError> {
    let start = p.peek().span.start;
    let source_elements: Option<SourceElementsNode> = if p.peek_kind() matches { TK_Export | TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        let source_elements = parse_source_elements(p)?;
        Option::<SourceElementsNode>::Some(source_elements)
    } else {
        null
    };
    let eof = p.expect(TK_EOF)?;
    return Result::<ProgramNode, ParseError>::Ok(ProgramNode {
        span: Span::new(start, p.last_end()),
        source_elements,
        eof,
    });
}

fn parse_source_element(p: &mut Parser) -> Result<SourceElementNode, ParseError> {
    let start = p.peek().span.start;
    let export_: Option<Token> = if p.peek_kind() == TK_Export {
        let export_ = p.expect(TK_Export)?;
        Option::<Token>::Some(export_)
    } else {
        null
    };
    let statement = parse_statement(p)?;
    return Result::<SourceElementNode, ParseError>::Ok(SourceElementNode {
        span: Span::new(start, p.last_end()),
        export_,
        statement,
    });
}

