        } else {
            null
        };
        let argument_list_comma = ArgumentListCommaOptItem {
            argument_list,
            comma,
        };
        Option::<ArgumentListCommaOptItem>::Some(argument_list_comma)
    } else if (p.peek_kind() == TK_Ellipsis || p.peek_kind() == TK_Async || p.peek_kind() == TK_Function_ || p.peek_kind() == TK_Identifier || p.peek_kind() == TK_As || p.peek_kind() == TK_From || p.peek_kind() == TK_Yield || p.peek_kind() == TK_Of || p.peek_kind() == TK_Any || p.peek_kind() == TK_Number || p.peek_kind() == TK_Boolean || p.peek_kind() == TK_String || p.peek_kind() == TK_Unique || p.peek_kind() == TK_Symbol || p.peek_kind() == TK_Never || p.peek_kind() == TK_Undefined || p.peek_kind() == TK_Object || p.peek_kind() == TK_KeyOf || p.peek_kind() == TK_TypeAlias || p.peek_kind() == TK_Constructor || p.peek_kind() == TK_Namespace || p.peek_kind() == TK_Abstract || p.peek_kind() == TK_Break || p.peek_kind() == TK_Do || p.peek_kind() == TK_Instanceof || p.peek_kind() == TK_Typeof || p.peek_kind() == TK_Case || p.peek_kind() == TK_Else || p.peek_kind() == TK_New || p.peek_kind() == TK_Var || p.peek_kind() == TK_Catch || p.peek_kind() == TK_Finally || p.peek_kind() == TK_Return || p.peek_kind() == TK_Void || p.peek_kind() == TK_Continue || p.peek_kind() == TK_For || p.peek_kind() == TK_Switch || p.peek_kind() == TK_While || p.peek_kind() == TK_Debugger || p.peek_kind() == TK_This || p.peek_kind() == TK_With || p.peek_kind() == TK_Default || p.peek_kind() == TK_If || p.peek_kind() == TK_Throw || p.peek_kind() == TK_Delete || p.peek_kind() == TK_In || p.peek_kind() == TK_Try || p.peek_kind() == TK_Class || p.peek_kind() == TK_Enum || p.peek_kind() == TK_Extends || p.peek_kind() == TK_Super || p.peek_kind() == TK_Const || p.peek_kind() == TK_Export || p.peek_kind() == TK_Import || p.peek_kind() == TK_Implements || p.peek_kind() == TK_Let || p.peek_kind() == TK_Private || p.peek_kind() == TK_Public || p.peek_kind() == TK_Interface || p.peek_kind() == TK_Package || p.peek_kind() == TK_Protected || p.peek_kind() == TK_Static || p.peek_kind() == TK_Await || p.peek_kind() == TK_ReadOnly || p.peek_kind() == TK_Require || p.peek_kind() == TK_Module || p.peek_kind() == TK_NullLiteral || p.peek_kind() == TK_BooleanLiteral || p.peek_kind() == TK_StringLiteral || p.peek_kind() == TK_DecimalLiteral || p.peek_kind() == TK_HexIntegerLiteral || p.peek_kind() == TK_OctalIntegerLiteral || p.peek_kind() == TK_OctalIntegerLiteral2 || p.peek_kind() == TK_BinaryIntegerLiteral || p.peek_kind() == TK_LIT_LBRACKET || p.peek_kind() == TK_LIT_LPAREN || p.peek_kind() == TK_LIT_PLUSPLUS || p.peek_kind() == TK_LIT_MINUSMINUS || p.peek_kind() == TK_LIT_PLUS || p.peek_kind() == TK_LIT_MINUS || p.peek_kind() == TK_LIT_TILDE || p.peek_kind() == TK_LIT_BANG || p.peek_kind() == TK_LIT_LBRACE || p.peek_kind() == TK_YieldStar || p.peek_kind() == TK_BackTick || p.peek_kind() == TK_RegularExpressionLiteral || p.peek_kind() == TK_BigDecimalIntegerLiteral || p.peek_kind() == TK_BigHexIntegerLiteral || p.peek_kind() == TK_BigOctalIntegerLiteral || p.peek_kind() == TK_BigBinaryIntegerLiteral || p.peek_kind() == TK_LIT_LT) {
