        Alt45(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.from_);
            v.exit_rule(&"keyword", &n.span);
        }
        Alt46(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.as_);
            v.exit_rule(&"keyword", &n.span);
        }
        Alt47(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.require);
            v.exit_rule(&"keyword", &n.span);
        }
        Alt48(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.typealias);
            v.exit_rule(&"keyword", &n.span);
        }
        Alt49(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.string);
            v.exit_rule(&"keyword", &n.span);
        }
        Alt50(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.boolean);
            v.exit_rule(&"keyword", &n.span);
        }
        Alt51(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.number);
            v.exit_rule(&"keyword", &n.span);
        }
        Alt52(n) => {
            v.enter_rule(&"keyword", &n.span);
            v.visit_token(&n.module);
            v.exit_rule(&"keyword", &n.span);
        }
    }
}

pub fn walk_eos<V: Visitor>(v: &mut V, node: &EosNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"eos", &n.span);
            v.visit_token(&n.semicolon);
            v.exit_rule(&"eos", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"eos", &n.span);
            v.visit_token(&n.eof);
            v.exit_rule(&"eos", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"eos", &n.span);
            v.exit_rule(&"eos", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"eos", &n.span);
            v.exit_rule(&"eos", &n.span);
        }
    }
}

pub fn to_tree(node: &InitializerNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_initializer(&mut recorder, node);
    return recorder.build();
}

