fn parse_with_statement(p: &mut Parser) -> Result<WithStatementNode, ParseError> {
    let start = p.peek().span.start;
    let with_ = p.expect(TK_With)?;
    let lparen = p.expect(TK_LIT_LPAREN)?;
    let expression_sequence = parse_expression_sequence(p)?;
