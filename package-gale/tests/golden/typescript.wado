fn parse_case_block(p: &mut Parser) -> Result<CaseBlockNode, ParseError> {
    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE)?;
    let case_clauses: Option<CaseClausesNode> = if p.peek_kind() == TK_Case {
        let case_clauses = parse_case_clauses(p)?;
        Option::<CaseClausesNode>::Some(case_clauses)
    } else {
        null
    };
    let default_clause_case_clauses: Option<DefaultClauseCaseClausesOptItem> = if p.peek_kind() == TK_Default && p.peek_at(1) == TK_Case {
        let default_clause = parse_default_clause(p)?;
        let case_clauses: Option<CaseClausesNode> = if p.peek_kind() == TK_Case {
            let case_clauses = parse_case_clauses(p)?;
            Option::<CaseClausesNode>::Some(case_clauses)
        } else {
            null
        };
        let default_clause_case_clauses = DefaultClauseCaseClausesOptItem {
            default_clause,
            case_clauses,
        };
        Option::<DefaultClauseCaseClausesOptItem>::Some(default_clause_case_clauses)
    } else if p.peek_kind() == TK_Default {
        let default_clause = parse_default_clause(p)?;
        let case_clauses: Option<CaseClausesNode> = null;
        let default_clause_case_clauses = DefaultClauseCaseClausesOptItem {
            default_clause,
            case_clauses,
        };
        Option::<DefaultClauseCaseClausesOptItem>::Some(default_clause_case_clauses)
    } else {
        null
    };
    let rbrace = p.expect(TK_LIT_RBRACE)?;
    return Result::<CaseBlockNode, ParseError>::Ok(CaseBlockNode {
        span: Span::new(start, p.last_end()),
        lbrace,
        case_clauses,
        default_clause_case_clauses,
        rbrace,
    });
}

fn parse_case_clauses(p: &mut Parser) -> Result<CaseClausesNode, ParseError> {
    let start = p.peek().span.start;
    let mut case_clause_list: Array<CaseClauseNode> = [];
    let mut _plus_first = true;
    while _plus_first || p.peek_kind() == TK_Case {
        _plus_first = false;
        let case_clause = parse_case_clause(p)?;
        case_clause_list.push(case_clause);
    }
    return Result::<CaseClausesNode, ParseError>::Ok(CaseClausesNode {
        span: Span::new(start, p.last_end()),
        case_clause_list,
    });
}

fn parse_case_clause(p: &mut Parser) -> Result<CaseClauseNode, ParseError> {
    let start = p.peek().span.start;
    let case = p.expect(TK_Case)?;
    let expression_sequence = parse_expression_sequence(p)?;
    let colon = p.expect(TK_LIT_COLON)?;
    let statement_list: Option<StatementListNode> = if p.peek_kind() matches { TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_Export | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        let statement_list = parse_statement_list(p)?;
        Option::<StatementListNode>::Some(statement_list)
    } else {
        null
    };
    return Result::<CaseClauseNode, ParseError>::Ok(CaseClauseNode {
        span: Span::new(start, p.last_end()),
        case,
        expression_sequence,
        colon,
        statement_list,
    });
}

fn parse_default_clause(p: &mut Parser) -> Result<DefaultClauseNode, ParseError> {
    let start = p.peek().span.start;
    let default = p.expect(TK_Default)?;
    let colon = p.expect(TK_LIT_COLON)?;
    let statement_list: Option<StatementListNode> = if p.peek_kind() matches { TK_LIT_LBRACE | TK_LIT_LBRACKET | TK_Public | TK_Private | TK_Protected | TK_Var | TK_Let | TK_Const | TK_ReadOnly | TK_Identifier | TK_Async | TK_As | TK_From | TK_Yield | TK_Of | TK_Any | TK_Number | TK_Boolean | TK_String | TK_Unique | TK_Symbol | TK_Never | TK_Undefined | TK_Object | TK_KeyOf | TK_TypeAlias | TK_Constructor | TK_Namespace | TK_Abstract | TK_Require | TK_Declare | TK_Import | TK_Export | TK_SemiColon | TK_LIT_AT | TK_Class | TK_Function_ | TK_Break | TK_Do | TK_Instanceof | TK_Typeof | TK_Case | TK_Else | TK_New | TK_Catch | TK_Finally | TK_Return | TK_Void | TK_Continue | TK_For | TK_Switch | TK_While | TK_Debugger | TK_This | TK_With | TK_Default | TK_If | TK_Throw | TK_Delete | TK_In | TK_Try | TK_Enum | TK_Extends | TK_Super | TK_Implements | TK_Interface | TK_Package | TK_Static | TK_Await | TK_Module | TK_NullLiteral | TK_BooleanLiteral | TK_StringLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_OctalIntegerLiteral | TK_OctalIntegerLiteral2 | TK_BinaryIntegerLiteral | TK_LIT_LPAREN | TK_LIT_PLUSPLUS | TK_LIT_MINUSMINUS | TK_LIT_PLUS | TK_LIT_MINUS | TK_LIT_TILDE | TK_LIT_BANG | TK_YieldStar | TK_BackTick | TK_RegularExpressionLiteral | TK_BigDecimalIntegerLiteral | TK_BigHexIntegerLiteral | TK_BigOctalIntegerLiteral | TK_BigBinaryIntegerLiteral | TK_LIT_LT | TK_LIT_TYPE } {
        let statement_list = parse_statement_list(p)?;
        Option::<StatementListNode>::Some(statement_list)
    } else {
        null
    };
    return Result::<DefaultClauseNode, ParseError>::Ok(DefaultClauseNode {
        span: Span::new(start, p.last_end()),
        default,
        colon,
        statement_list,
    });
}

fn parse_labelled_statement(p: &mut Parser) -> Result<LabelledStatementNode, ParseError> {
    let start = p.peek().span.start;
