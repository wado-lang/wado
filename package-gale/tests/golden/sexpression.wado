pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = [];
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        end = try_string(&lexer.chars, start);
        if end > best_end { best_end = end; best_kind = TK_STRING; }
        end = try_whitespace(&lexer.chars, start);
        if end > best_end { best_end = end; best_kind = TK_WHITESPACE; }
        end = try_number(&lexer.chars, start);
        if end > best_end { best_end = end; best_kind = TK_NUMBER; }
        end = try_symbol(&lexer.chars, start);
        if end > best_end { best_end = end; best_kind = TK_SYMBOL; }
        end = try_lparen(&lexer.chars, start);
        if end > best_end { best_end = end; best_kind = TK_LPAREN; }
        end = try_rparen(&lexer.chars, start);
        if end > best_end { best_end = end; best_kind = TK_RPAREN; }
        end = try_dot(&lexer.chars, start);
        if end > best_end { best_end = end; best_kind = TK_DOT; }
        if best_end <= start {
            tokens.append(Token::new(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1)));
            lexer.pos = start + 1;
        } else {
            let is_skip = false || best_kind == TK_WHITESPACE;
            if !is_skip {
                tokens.append(Token::new(best_kind, lexer.slice(start, best_end), Span::new(start, best_end)));
            }
            lexer.pos = best_end;
        }
    }
    tokens.append(Token::new(TK_EOF, "", Span::new(lexer.pos, lexer.pos)));
    return tokens;
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32, name: String) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }
}

fn parse_sexpr(p: &mut Parser) -> Result<SexprNode, ParseError> {
    let start = p.peek().span.start;
    let mut item_list: Array<ItemNode> = [];
    while p.peek_kind() == TK_STRING || p.peek_kind() == TK_SYMBOL || p.peek_kind() == TK_NUMBER || p.peek_kind() == TK_DOT || p.peek_kind() == TK_LPAREN {
        let item = parse_item(p)?;
        item_list.append(item);
    }
    let eof = p.expect(TK_EOF, "EOF")?;
    return Result::<SexprNode, ParseError>::Ok(SexprNode {
        span: Span::new(start, p.last_end()),
        item_list,
        eof,
    });
}

fn parse_item(p: &mut Parser) -> Result<ItemNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if (kind == TK_STRING || kind == TK_SYMBOL || kind == TK_NUMBER || kind == TK_DOT) {
        let atom = parse_atom(p)?;
        return Result::<ItemNode, ParseError>::Ok(ItemNode::Alt0(ItemAlt0 {
            span: Span::new(start, p.last_end()),
            atom,
        }));
    }
    if kind == TK_LPAREN {
        let list_ = parse_list_(p)?;
        return Result::<ItemNode, ParseError>::Ok(ItemNode::Alt1(ItemAlt1 {
            span: Span::new(start, p.last_end()),
            list_,
        }));
    }
    if kind == TK_LPAREN && (p.peek_at(1) == TK_STRING || p.peek_at(1) == TK_SYMBOL || p.peek_at(1) == TK_NUMBER || p.peek_at(1) == TK_DOT || p.peek_at(1) == TK_LPAREN) {
        let lparen = p.expect(TK_LPAREN, "LPAREN")?;
        let item = parse_item(p)?;
        let dot = p.expect(TK_DOT, "DOT")?;
        let item_2 = parse_item(p)?;
        let rparen = p.expect(TK_RPAREN, "RPAREN")?;
        return Result::<ItemNode, ParseError>::Ok(ItemNode::Alt2(ItemAlt2 {
            span: Span::new(start, p.last_end()),
            lparen,
            item,
            dot,
            item_2,
            rparen,
        }));
    }
    return Result::<ItemNode, ParseError>::Err(ParseError::new(
        "expected item",
        p.peek().span,
        ["TK_STRING", "TK_SYMBOL", "TK_NUMBER", "TK_DOT", "TK_LPAREN"],
    ));
}

fn parse_list_(p: &mut Parser) -> Result<ListNode, ParseError> {
    let start = p.peek().span.start;
    let lparen = p.expect(TK_LPAREN, "LPAREN")?;
    let mut item_list: Array<ItemNode> = [];
    while p.peek_kind() == TK_STRING || p.peek_kind() == TK_SYMBOL || p.peek_kind() == TK_NUMBER || p.peek_kind() == TK_DOT || p.peek_kind() == TK_LPAREN {
        let item = parse_item(p)?;
        item_list.append(item);
    }
    let rparen = p.expect(TK_RPAREN, "RPAREN")?;
    return Result::<ListNode, ParseError>::Ok(ListNode {
        span: Span::new(start, p.last_end()),
        lparen,
        item_list,
        rparen,
    });
}

fn parse_atom(p: &mut Parser) -> Result<AtomNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_STRING {
        let string = p.expect(TK_STRING, "STRING")?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt0(AtomAlt0 {
            span: Span::new(start, p.last_end()),
            string,
        }));
    }
    if kind == TK_SYMBOL {
        let symbol = p.expect(TK_SYMBOL, "SYMBOL")?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt1(AtomAlt1 {
            span: Span::new(start, p.last_end()),
            symbol,
        }));
    }
    if kind == TK_NUMBER {
        let number = p.expect(TK_NUMBER, "NUMBER")?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt2(AtomAlt2 {
            span: Span::new(start, p.last_end()),
            number,
        }));
    }
    if kind == TK_DOT {
        let dot = p.expect(TK_DOT, "DOT")?;
        return Result::<AtomNode, ParseError>::Ok(AtomNode::Alt3(AtomAlt3 {
            span: Span::new(start, p.last_end()),
            dot,
        }));
    }
    return Result::<AtomNode, ParseError>::Err(ParseError::new(
        "expected atom",
        p.peek().span,
        ["TK_STRING", "TK_SYMBOL", "TK_NUMBER", "TK_DOT"],
    ));
}

pub fn parse(input: &String) -> Result<SexprNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_sexpr(&mut parser);
}

