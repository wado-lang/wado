fn split_lines(s: &String) -> Array<String> {
    let mut result: Array<String> = [];
    let mut current = String::with_capacity(128);
    for let c of s.chars() {
        if c == '\n' {
            result.push(current);
            current = String::with_capacity(128);
        } else {
            current.push_str(`{c}`);
        }
    }
    result.push(current);
    return result;
}

