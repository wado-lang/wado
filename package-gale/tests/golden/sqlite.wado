fn parse_alter_table_stmt(p: &mut Parser) -> Result<AlterTableStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_alter = p.expect(TK_K_ALTER, "K_ALTER")?;
    let k_table = p.expect(TK_K_TABLE, "K_TABLE")?;
    let database_name_dot: Option<DatabaseNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let opt_saved = p.pos;
        let mut opt_result: Option<DatabaseNameDotItem> = null;
        opt_bt: {
            let _bt_r = parse_database_name(p);
            if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
            let database_name = _bt_r.unwrap();
            let _bt_r_2 = p.expect(TK_LIT_DOT, "'.'");
            if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
            let dot = _bt_r_2.unwrap();
            let database_name_dot = DatabaseNameDotItem {
                database_name,
                dot,
            };
            opt_result = Option::<DatabaseNameDotItem>::Some(database_name_dot);
        }
        opt_result
    } else {
        null
    };
    let table_name = parse_table_name(p)?;
    let mut group_0_inner: Option<AlterTableStmtGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_RENAME {
        let k_rename = p.expect(TK_K_RENAME, "K_RENAME")?;
        let k_to = p.expect(TK_K_TO, "K_TO")?;
        let new_table_name = parse_new_table_name(p)?;
        group_0_inner = Option::<AlterTableStmtGroup0>::Some(AlterTableStmtGroup0::Alt0(AlterTableStmtGroup0Alt0 {
            k_rename,
            k_to,
            new_table_name,
        }));
    } else if grp_kind == TK_K_ADD {
        let k_add = p.expect(TK_K_ADD, "K_ADD")?;
        let k_column: Option<Token> = if p.peek_kind() == TK_K_COLUMN {
            let k_column = p.expect(TK_K_COLUMN, "K_COLUMN")?;
            Option::<Token>::Some(k_column)
        } else {
            null
        };
        let column_def = parse_column_def(p)?;
        group_0_inner = Option::<AlterTableStmtGroup0>::Some(AlterTableStmtGroup0::Alt1(AlterTableStmtGroup0Alt1 {
            k_add,
            k_column,
            column_def,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<AlterTableStmtNode, ParseError>::Ok(AlterTableStmtNode {
        span: Span::new(start, p.last_end()),
        k_alter,
        k_table,
        database_name_dot,
        table_name,
        group_0,
    });
}

fn parse_analyze_stmt(p: &mut Parser) -> Result<AnalyzeStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_analyze = p.expect(TK_K_ANALYZE, "K_ANALYZE")?;
    let group_0: Option<AnalyzeStmtGroup0> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let opt_saved = p.pos;
        let mut opt_result: Option<AnalyzeStmtGroup0> = null;
        opt_bt: {
            let mut group_0_opt: Option<AnalyzeStmtGroup0> = null;
            let grp_kind = p.peek_kind();
            if grp_kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
                let saved_pos = p.pos;
                let mut bt_done = false;
                if !bt_done {
                    bt_try: {
                        let _bt_r = parse_database_name(p);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                        let database_name = _bt_r.unwrap();
                        group_0_opt = Option::<AnalyzeStmtGroup0>::Some(AnalyzeStmtGroup0::Alt0(AnalyzeStmtGroup0Alt0 {
                            database_name,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    bt_try_2: {
                        let _bt_r = parse_table_or_index_name(p);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try_2; }
                        let table_or_index_name = _bt_r.unwrap();
                        group_0_opt = Option::<AnalyzeStmtGroup0>::Some(AnalyzeStmtGroup0::Alt1(AnalyzeStmtGroup0Alt1 {
                            table_or_index_name,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    let database_name = parse_database_name(p)?;
                    let dot = p.expect(TK_LIT_DOT, "'.'")?;
                    let table_or_index_name = parse_table_or_index_name(p)?;
                    group_0_opt = Option::<AnalyzeStmtGroup0>::Some(AnalyzeStmtGroup0::Alt2(AnalyzeStmtGroup0Alt2 {
                        database_name,
                        dot,
                        table_or_index_name,
                    }));
                }
            }
            if let None = group_0_opt {
                p.expect(-1, "group alternative")?;
            }
            let group_0 = group_0_opt.unwrap();
            opt_result = Option::<AnalyzeStmtGroup0>::Some(group_0);
        }
        opt_result
    } else {
        null
    };
    return Result::<AnalyzeStmtNode, ParseError>::Ok(AnalyzeStmtNode {
        span: Span::new(start, p.last_end()),
        k_analyze,
        group_0,
    });
}

fn parse_attach_stmt(p: &mut Parser) -> Result<AttachStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_attach = p.expect(TK_K_ATTACH, "K_ATTACH")?;
    let k_database: Option<Token> = if p.peek_kind() == TK_K_DATABASE {
        let k_database = p.expect(TK_K_DATABASE, "K_DATABASE")?;
        Option::<Token>::Some(k_database)
    } else {
        null
    };
    let expr = parse_expr(p)?;
    let k_as = p.expect(TK_K_AS, "K_AS")?;
    let database_name = parse_database_name(p)?;
    return Result::<AttachStmtNode, ParseError>::Ok(AttachStmtNode {
        span: Span::new(start, p.last_end()),
        k_attach,
        k_database,
        expr,
        k_as,
        database_name,
    });
}

fn parse_begin_stmt(p: &mut Parser) -> Result<BeginStmtNode, ParseError> {
