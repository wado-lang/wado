fn parse_join_clause(p: &mut Parser) -> Result<JoinClauseNode, ParseError> {
    let start = p.peek().span.start;
    let table_or_subquery = parse_table_or_subquery(p)?;
    let mut join_operator_table_or_subquery_join_constraint_list: Array<JoinOperatorTableOrSubqueryJoinConstraintItem> = [];
    while p.peek_kind() matches { TK_LIT_COMMA | TK_K_NATURAL | TK_K_LEFT | TK_K_INNER | TK_K_CROSS | TK_K_JOIN } {
        let join_operator = parse_join_operator(p)?;
        let table_or_subquery = parse_table_or_subquery(p)?;
        let join_constraint = parse_join_constraint(p)?;
        let join_operator_table_or_subquery_join_constraint = JoinOperatorTableOrSubqueryJoinConstraintItem {
            join_operator,
            table_or_subquery,
            join_constraint,
        };
        join_operator_table_or_subquery_join_constraint_list.push(join_operator_table_or_subquery_join_constraint);
    }
    return Result::<JoinClauseNode, ParseError>::Ok(JoinClauseNode {
        span: Span::new(start, p.last_end()),
        table_or_subquery,
        join_operator_table_or_subquery_join_constraint_list,
    });
}

fn parse_join_operator(p: &mut Parser) -> Result<JoinOperatorNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA, "','")?;
        return Result::<JoinOperatorNode, ParseError>::Ok(JoinOperatorNode::Alt0(JoinOperatorAlt0 {
            span: Span::new(start, p.last_end()),
            comma,
        }));
    }
    if kind matches { TK_K_NATURAL | TK_K_LEFT | TK_K_INNER | TK_K_CROSS | TK_K_JOIN } {
        let k_natural: Option<Token> = if p.peek_kind() == TK_K_NATURAL {
            let k_natural = p.expect(TK_K_NATURAL, "K_NATURAL")?;
            Option::<Token>::Some(k_natural)
        } else {
            null
        };
        let group_0: Option<JoinOperatorGroup0> = if p.peek_kind() matches { TK_K_LEFT | TK_K_INNER | TK_K_CROSS } {
            let opt_saved = p.pos;
            let mut opt_result: Option<JoinOperatorGroup0> = null;
            opt_bt: {
                let group_0: JoinOperatorGroup0 = if p.peek_kind() == TK_K_LEFT {
                    let k_left = p.expect(TK_K_LEFT, "K_LEFT")?;
                    let k_outer: Option<Token> = if p.peek_kind() == TK_K_OUTER {
                        let k_outer = p.expect(TK_K_OUTER, "K_OUTER")?;
                        Option::<Token>::Some(k_outer)
                    } else {
                        null
                    };
                    JoinOperatorGroup0::Alt0(JoinOperatorGroup0Alt0 {
                        k_left,
                        k_outer,
                    })
                } else if p.peek_kind() == TK_K_INNER {
                    let k_inner = p.expect(TK_K_INNER, "K_INNER")?;
                    JoinOperatorGroup0::Alt1(JoinOperatorGroup0Alt1 {
                        k_inner,
                    })
                } else {
                    let k_cross = p.expect(TK_K_CROSS, "K_CROSS")?;
                    JoinOperatorGroup0::Alt2(JoinOperatorGroup0Alt2 {
                        k_cross,
                    })
                };
                opt_result = Option::<JoinOperatorGroup0>::Some(group_0);
            }
            opt_result
        } else {
            null
        };
        let k_join = p.expect(TK_K_JOIN, "K_JOIN")?;
        return Result::<JoinOperatorNode, ParseError>::Ok(JoinOperatorNode::Alt1(JoinOperatorAlt1 {
            span: Span::new(start, p.last_end()),
            k_natural,
            group_0,
            k_join,
        }));
    }
    return Result::<JoinOperatorNode, ParseError>::Err(ParseError::new(
        "expected join_operator",
        p.peek().span,
        ["TK_LIT_COMMA", "TK_K_NATURAL", "TK_K_LEFT", "TK_K_INNER", "TK_K_CROSS", "TK_K_JOIN"],
    ));
}

fn parse_join_constraint(p: &mut Parser) -> Result<JoinConstraintNode, ParseError> {
    let start = p.peek().span.start;
    let group_0: Option<JoinConstraintGroup0> = if p.peek_kind() matches { TK_K_ON | TK_K_USING } {
        let opt_saved = p.pos;
        let mut opt_result: Option<JoinConstraintGroup0> = null;
        opt_bt: {
            let group_0: JoinConstraintGroup0 = if p.peek_kind() == TK_K_ON {
                let k_on = p.expect(TK_K_ON, "K_ON")?;
                let expr = parse_expr(p)?;
                JoinConstraintGroup0::Alt0(JoinConstraintGroup0Alt0 {
                    k_on,
                    expr,
                })
            } else {
                let k_using = p.expect(TK_K_USING, "K_USING")?;
                let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
                let column_name = parse_column_name(p)?;
                let mut comma_column_name_list: Array<CommaColumnNameItem> = [];
                while p.peek_kind() == TK_LIT_COMMA {
                    let comma = p.expect(TK_LIT_COMMA, "','")?;
                    let column_name = parse_column_name(p)?;
                    let comma_column_name = CommaColumnNameItem {
                        comma,
                        column_name,
                    };
                    comma_column_name_list.push(comma_column_name);
                }
                let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
                JoinConstraintGroup0::Alt1(JoinConstraintGroup0Alt1 {
                    k_using,
                    lparen,
                    column_name,
                    comma_column_name_list,
                    rparen,
                })
            };
            opt_result = Option::<JoinConstraintGroup0>::Some(group_0);
        }
        opt_result
    } else {
        null
    };
    return Result::<JoinConstraintNode, ParseError>::Ok(JoinConstraintNode {
        span: Span::new(start, p.last_end()),
        group_0,
    });
}

fn parse_select_core(p: &mut Parser) -> Result<SelectCoreNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_K_SELECT {
        let k_select = p.expect(TK_K_SELECT, "K_SELECT")?;
        let k_distinct_or_k_all: Option<Token> = if p.peek_kind() matches { TK_K_DISTINCT | TK_K_ALL } {
            let opt_saved = p.pos;
            let mut opt_result: Option<Token> = null;
            opt_bt: {
                let k_distinct_or_k_all = p.advance();
                opt_result = Option::<Token>::Some(k_distinct_or_k_all);
            }
            opt_result
        } else {
            null
        };
        let result_column = parse_result_column(p)?;
        let mut comma_result_column_list: Array<CommaResultColumnItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let result_column = parse_result_column(p)?;
            let comma_result_column = CommaResultColumnItem {
                comma,
                result_column,
            };
            comma_result_column_list.push(comma_result_column);
        }
        let k_from_item: Option<KFromItemItem> = if p.peek_kind() == TK_K_FROM {
            let k_from = p.expect(TK_K_FROM, "K_FROM")?;
            let mut group_0_inner: Option<SelectOrValuesGroup0> = null;
            let grp_kind = p.peek_kind();
            if grp_kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
                let saved_pos = p.pos;
                let mut bt_done = false;
                if !bt_done {
                    bt_try: {
                        let _bt_r = parse_join_clause(p);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                        let join_clause = _bt_r.unwrap();
                        group_0_inner = Option::<SelectOrValuesGroup0>::Some(SelectOrValuesGroup0::Alt1(SelectOrValuesGroup0Alt1 {
                            join_clause,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    let table_or_subquery = parse_table_or_subquery(p)?;
                    let mut comma_table_or_subquery_list: Array<CommaTableOrSubqueryItem> = [];
                    while p.peek_kind() == TK_LIT_COMMA {
                        let comma = p.expect(TK_LIT_COMMA, "','")?;
                        let table_or_subquery = parse_table_or_subquery(p)?;
                        let comma_table_or_subquery = CommaTableOrSubqueryItem {
                            comma,
                            table_or_subquery,
                        };
                        comma_table_or_subquery_list.push(comma_table_or_subquery);
                    }
                    group_0_inner = Option::<SelectOrValuesGroup0>::Some(SelectOrValuesGroup0::Alt0(SelectOrValuesGroup0Alt0 {
                        table_or_subquery,
                        comma_table_or_subquery_list,
                    }));
                }
            }
            let group_0 = group_0_inner;
            let k_from_item = KFromItemItem {
                k_from,
                group_0,
            };
            Option::<KFromItemItem>::Some(k_from_item)
        } else {
            null
        };
        let k_where_expr: Option<KWhereExprItem> = if p.peek_kind() == TK_K_WHERE {
            let k_where = p.expect(TK_K_WHERE, "K_WHERE")?;
            let expr = parse_expr(p)?;
            let k_where_expr = KWhereExprItem {
                k_where,
                expr,
            };
            Option::<KWhereExprItem>::Some(k_where_expr)
        } else {
            null
        };
        let k_group_k_by_expr_item_item: Option<KGroupKByExprItemItemItem> = if p.peek_kind() == TK_K_GROUP && p.peek_at(1) == TK_K_BY {
            let k_group = p.expect(TK_K_GROUP, "K_GROUP")?;
            let k_by = p.expect(TK_K_BY, "K_BY")?;
            let expr = parse_expr(p)?;
            let mut comma_expr_list: Array<CommaExprItem> = [];
            while p.peek_kind() == TK_LIT_COMMA {
                let comma = p.expect(TK_LIT_COMMA, "','")?;
                let expr = parse_expr(p)?;
                let comma_expr = CommaExprItem {
                    comma,
                    expr,
                };
                comma_expr_list.push(comma_expr);
            }
            let k_having_expr: Option<KHavingExprItem> = if p.peek_kind() == TK_K_HAVING {
                let k_having = p.expect(TK_K_HAVING, "K_HAVING")?;
                let expr = parse_expr(p)?;
                let k_having_expr = KHavingExprItem {
                    k_having,
                    expr,
                };
                Option::<KHavingExprItem>::Some(k_having_expr)
            } else {
                null
            };
            let k_group_k_by_expr_item_item = KGroupKByExprItemItemItem {
                k_group,
                k_by,
                expr,
                comma_expr_list,
                k_having_expr,
            };
            Option::<KGroupKByExprItemItemItem>::Some(k_group_k_by_expr_item_item)
        } else {
            null
        };
        return Result::<SelectCoreNode, ParseError>::Ok(SelectCoreNode::Alt0(SelectCoreAlt0 {
            span: Span::new(start, p.last_end()),
            k_select,
            k_distinct_or_k_all,
            result_column,
            comma_result_column_list,
            k_from_item,
            k_where_expr,
            k_group_k_by_expr_item_item,
        }));
    }
    if kind == TK_K_VALUES {
        let k_values = p.expect(TK_K_VALUES, "K_VALUES")?;
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let expr = parse_expr(p)?;
        let mut comma_expr_list: Array<CommaExprItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let expr = parse_expr(p)?;
            let comma_expr = CommaExprItem {
                comma,
                expr,
            };
            comma_expr_list.push(comma_expr);
        }
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        let mut comma_lparen_expr_item_rparen_list: Array<CommaLparenExprItemRparenItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
            let expr = parse_expr(p)?;
            let mut comma_expr_list: Array<CommaExprItem> = [];
            while p.peek_kind() == TK_LIT_COMMA {
                let comma = p.expect(TK_LIT_COMMA, "','")?;
                let expr = parse_expr(p)?;
                let comma_expr = CommaExprItem {
                    comma,
                    expr,
                };
                comma_expr_list.push(comma_expr);
            }
            let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
            let comma_lparen_expr_item_rparen = CommaLparenExprItemRparenItem {
                comma,
                lparen,
                expr,
                comma_expr_list,
                rparen,
            };
            comma_lparen_expr_item_rparen_list.push(comma_lparen_expr_item_rparen);
        }
        return Result::<SelectCoreNode, ParseError>::Ok(SelectCoreNode::Alt1(SelectCoreAlt1 {
            span: Span::new(start, p.last_end()),
            k_values,
            lparen,
            expr,
            comma_expr_list,
            rparen,
            comma_lparen_expr_item_rparen_list,
        }));
    }
    return Result::<SelectCoreNode, ParseError>::Err(ParseError::new(
        "expected select_core",
        p.peek().span,
        ["TK_K_SELECT", "TK_K_VALUES"],
    ));
}

fn parse_compound_operator_bt_1(p: &mut Parser) -> Result<CompoundOperatorNode, ParseError> {
    let start = p.peek().span.start;
    let k_union = p.expect(TK_K_UNION, "K_UNION")?;
    let k_all = p.expect(TK_K_ALL, "K_ALL")?;
    return Result::<CompoundOperatorNode, ParseError>::Ok(CompoundOperatorNode::Alt1(CompoundOperatorAlt1 {
        span: Span::new(start, p.last_end()),
        k_union,
        k_all,
    }));
}

fn parse_compound_operator_bt_0(p: &mut Parser) -> Result<CompoundOperatorNode, ParseError> {
    let start = p.peek().span.start;
    let k_union = p.expect(TK_K_UNION, "K_UNION")?;
    return Result::<CompoundOperatorNode, ParseError>::Ok(CompoundOperatorNode::Alt0(CompoundOperatorAlt0 {
        span: Span::new(start, p.last_end()),
        k_union,
    }));
}

fn parse_compound_operator(p: &mut Parser) -> Result<CompoundOperatorNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_K_UNION {
        let k_union = p.expect(TK_K_UNION, "K_UNION")?;
        if p.peek_kind() == TK_K_ALL {
            let k_all = p.expect(TK_K_ALL, "K_ALL")?;
            return Result::<CompoundOperatorNode, ParseError>::Ok(CompoundOperatorNode::Alt1(CompoundOperatorAlt1 {
                span: Span::new(start, p.last_end()),
                k_union,
                k_all,
            }));
        }
    }
    if kind == TK_K_INTERSECT {
        let k_intersect = p.expect(TK_K_INTERSECT, "K_INTERSECT")?;
        return Result::<CompoundOperatorNode, ParseError>::Ok(CompoundOperatorNode::Alt2(CompoundOperatorAlt2 {
            span: Span::new(start, p.last_end()),
            k_intersect,
        }));
    }
    if kind == TK_K_EXCEPT {
        let k_except = p.expect(TK_K_EXCEPT, "K_EXCEPT")?;
        return Result::<CompoundOperatorNode, ParseError>::Ok(CompoundOperatorNode::Alt3(CompoundOperatorAlt3 {
            span: Span::new(start, p.last_end()),
            k_except,
        }));
    }
    return Result::<CompoundOperatorNode, ParseError>::Err(ParseError::new(
        "expected compound_operator",
        p.peek().span,
        ["TK_K_UNION", "TK_K_INTERSECT", "TK_K_EXCEPT"],
    ));
}

fn parse_signed_number(p: &mut Parser) -> Result<SignedNumberNode, ParseError> {
    let start = p.peek().span.start;
    let plus_or_minus: Option<Token> = if p.peek_kind() matches { TK_LIT_PLUS | TK_LIT_MINUS } {
        let opt_saved = p.pos;
        let mut opt_result: Option<Token> = null;
        opt_bt: {
            let plus_or_minus = p.advance();
            opt_result = Option::<Token>::Some(plus_or_minus);
        }
        opt_result
    } else {
        null
    };
    let numeric_literal = p.expect(TK_NUMERIC_LITERAL, "NUMERIC_LITERAL")?;
    return Result::<SignedNumberNode, ParseError>::Ok(SignedNumberNode {
        span: Span::new(start, p.last_end()),
        plus_or_minus,
        numeric_literal,
    });
}

fn parse_literal_value(p: &mut Parser) -> Result<LiteralValueNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_NUMERIC_LITERAL {
        let numeric_literal = p.expect(TK_NUMERIC_LITERAL, "NUMERIC_LITERAL")?;
        return Result::<LiteralValueNode, ParseError>::Ok(LiteralValueNode::Alt0(LiteralValueAlt0 {
            span: Span::new(start, p.last_end()),
            numeric_literal,
        }));
    }
    if kind == TK_STRING_LITERAL {
        let string_literal = p.expect(TK_STRING_LITERAL, "STRING_LITERAL")?;
        return Result::<LiteralValueNode, ParseError>::Ok(LiteralValueNode::Alt1(LiteralValueAlt1 {
            span: Span::new(start, p.last_end()),
            string_literal,
        }));
    }
    if kind == TK_BLOB_LITERAL {
        let blob_literal = p.expect(TK_BLOB_LITERAL, "BLOB_LITERAL")?;
        return Result::<LiteralValueNode, ParseError>::Ok(LiteralValueNode::Alt2(LiteralValueAlt2 {
            span: Span::new(start, p.last_end()),
            blob_literal,
        }));
    }
    if kind == TK_K_NULL {
        let k_null = p.expect(TK_K_NULL, "K_NULL")?;
        return Result::<LiteralValueNode, ParseError>::Ok(LiteralValueNode::Alt3(LiteralValueAlt3 {
            span: Span::new(start, p.last_end()),
            k_null,
        }));
    }
    if kind == TK_K_CURRENT_TIME {
        let k_current_time = p.expect(TK_K_CURRENT_TIME, "K_CURRENT_TIME")?;
        return Result::<LiteralValueNode, ParseError>::Ok(LiteralValueNode::Alt4(LiteralValueAlt4 {
            span: Span::new(start, p.last_end()),
            k_current_time,
        }));
    }
    if kind == TK_K_CURRENT_DATE {
        let k_current_date = p.expect(TK_K_CURRENT_DATE, "K_CURRENT_DATE")?;
        return Result::<LiteralValueNode, ParseError>::Ok(LiteralValueNode::Alt5(LiteralValueAlt5 {
            span: Span::new(start, p.last_end()),
            k_current_date,
        }));
    }
    if kind == TK_K_CURRENT_TIMESTAMP {
        let k_current_timestamp = p.expect(TK_K_CURRENT_TIMESTAMP, "K_CURRENT_TIMESTAMP")?;
        return Result::<LiteralValueNode, ParseError>::Ok(LiteralValueNode::Alt6(LiteralValueAlt6 {
            span: Span::new(start, p.last_end()),
            k_current_timestamp,
        }));
    }
    return Result::<LiteralValueNode, ParseError>::Err(ParseError::new(
        "expected literal_value",
        p.peek().span,
        ["TK_NUMERIC_LITERAL", "TK_STRING_LITERAL", "TK_BLOB_LITERAL", "TK_K_NULL", "TK_K_CURRENT_TIME", "TK_K_CURRENT_DATE", "TK_K_CURRENT_TIMESTAMP"],
    ));
}

fn parse_unary_operator(p: &mut Parser) -> Result<UnaryOperatorNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_MINUS {
        let minus = p.expect(TK_LIT_MINUS, "'-'")?;
        return Result::<UnaryOperatorNode, ParseError>::Ok(UnaryOperatorNode::Alt0(UnaryOperatorAlt0 {
            span: Span::new(start, p.last_end()),
            minus,
        }));
    }
    if kind == TK_LIT_PLUS {
        let plus = p.expect(TK_LIT_PLUS, "'+'")?;
        return Result::<UnaryOperatorNode, ParseError>::Ok(UnaryOperatorNode::Alt1(UnaryOperatorAlt1 {
            span: Span::new(start, p.last_end()),
            plus,
        }));
    }
    if kind == TK_LIT_TILDE {
        let tilde = p.expect(TK_LIT_TILDE, "'~'")?;
        return Result::<UnaryOperatorNode, ParseError>::Ok(UnaryOperatorNode::Alt2(UnaryOperatorAlt2 {
            span: Span::new(start, p.last_end()),
            tilde,
        }));
    }
    if kind == TK_K_NOT {
        let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        return Result::<UnaryOperatorNode, ParseError>::Ok(UnaryOperatorNode::Alt3(UnaryOperatorAlt3 {
            span: Span::new(start, p.last_end()),
            k_not,
        }));
    }
    return Result::<UnaryOperatorNode, ParseError>::Err(ParseError::new(
        "expected unary_operator",
        p.peek().span,
        ["TK_LIT_MINUS", "TK_LIT_PLUS", "TK_LIT_TILDE", "TK_K_NOT"],
    ));
}

fn parse_error_message(p: &mut Parser) -> Result<ErrorMessageNode, ParseError> {
    let start = p.peek().span.start;
    let string_literal = p.expect(TK_STRING_LITERAL, "STRING_LITERAL")?;
    return Result::<ErrorMessageNode, ParseError>::Ok(ErrorMessageNode {
        span: Span::new(start, p.last_end()),
        string_literal,
    });
}

fn parse_module_argument_bt_1(p: &mut Parser) -> Result<ModuleArgumentNode, ParseError> {
    let start = p.peek().span.start;
    let column_def = parse_column_def(p)?;
    return Result::<ModuleArgumentNode, ParseError>::Ok(ModuleArgumentNode::Alt1(ModuleArgumentAlt1 {
        span: Span::new(start, p.last_end()),
        column_def,
    }));
}

fn parse_module_argument_bt_0(p: &mut Parser) -> Result<ModuleArgumentNode, ParseError> {
    let start = p.peek().span.start;
    let expr = parse_expr(p)?;
    return Result::<ModuleArgumentNode, ParseError>::Ok(ModuleArgumentNode::Alt0(ModuleArgumentAlt0 {
        span: Span::new(start, p.last_end()),
        expr,
    }));
}

fn parse_module_argument(p: &mut Parser) -> Result<ModuleArgumentNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN | TK_NUMERIC_LITERAL | TK_BLOB_LITERAL | TK_BIND_PARAMETER | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
        if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
            let saved = p.pos;
            let r_0 = parse_module_argument_bt_0(p);
            if let Err(_) = r_0 {
                p.pos = saved;
            } else {
                return r_0;
            }
            return parse_module_argument_bt_1(p);
        } else if p.peek_kind() matches { TK_NUMERIC_LITERAL | TK_BLOB_LITERAL | TK_BIND_PARAMETER | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
            return parse_module_argument_bt_0(p);
        }
    }
    return Result::<ModuleArgumentNode, ParseError>::Err(ParseError::new(
        "expected module_argument",
        p.peek().span,
