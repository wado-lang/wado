fn parse_foreign_table(p: &mut Parser) -> Result<ForeignTableNode, ParseError> {
    let start = p.peek().span.start;
    let any_name = parse_any_name(p)?;
    return Result::<ForeignTableNode, ParseError>::Ok(ForeignTableNode {
        span: Span::new(start, p.last_end()),
        any_name,
    });
}

