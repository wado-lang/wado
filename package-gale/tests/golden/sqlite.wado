fn parse_expr_lr_10(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
        let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        Option::<Token>::Some(k_not)
    } else {
        null
    };
    let k_in = p.expect(TK_K_IN, "K_IN")?;
    let mut group_0_inner: Option<ExprGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_LIT_LPAREN | TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let _bt_r = p.expect(TK_LIT_LPAREN, "'('");
                if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                let lparen = _bt_r.unwrap();
                let group_1: Option<ExprGroup1> = if p.peek_kind() matches { TK_K_WITH | TK_K_SELECT | TK_K_VALUES | TK_NUMERIC_LITERAL | TK_STRING_LITERAL | TK_BLOB_LITERAL | TK_K_NULL | TK_K_CURRENT_TIME | TK_K_CURRENT_DATE | TK_K_CURRENT_TIMESTAMP | TK_BIND_PARAMETER | TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITHOUT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
                    let opt_saved = p.pos;
                    let mut opt_result: Option<ExprGroup1> = null;
                    opt_bt: {
                        let mut group_1_opt: Option<ExprGroup1> = null;
                        let grp_kind = p.peek_kind();
                        if grp_kind matches { TK_K_WITH | TK_K_SELECT | TK_K_VALUES | TK_NUMERIC_LITERAL | TK_STRING_LITERAL | TK_BLOB_LITERAL | TK_K_NULL | TK_K_CURRENT_TIME | TK_K_CURRENT_DATE | TK_K_CURRENT_TIMESTAMP | TK_BIND_PARAMETER | TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITHOUT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
                            let saved_pos = p.pos;
                            let mut bt_done = false;
                            if !bt_done {
                                bt_try: {
                                    let _bt_r = parse_select_stmt(p);
                                    if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                                    let select_stmt = _bt_r.unwrap();
                                    group_1_opt = Option::<ExprGroup1>::Some(ExprGroup1::Alt0(ExprGroup1Alt0 {
                                        select_stmt,
                                    }));
                                    bt_done = true;
                                }
                            }
                            if !bt_done {
                                let expr = parse_expr(p)?;
                                let mut comma_expr_list: Array<CommaExprItem> = [];
                                while p.peek_kind() == TK_LIT_COMMA {
                                    let comma = p.expect(TK_LIT_COMMA, "','")?;
                                    let expr = parse_expr(p)?;
                                    let comma_expr = CommaExprItem {
                                        comma,
                                        expr,
                                    };
                                    comma_expr_list.push(comma_expr);
                                }
                                group_1_opt = Option::<ExprGroup1>::Some(ExprGroup1::Alt1(ExprGroup1Alt1 {
                                    expr,
                                    comma_expr_list,
                                }));
                            }
                        }
                        if let None = group_1_opt {
                            p.expect(-1, "group alternative")?;
                        }
                        let group_1 = group_1_opt.unwrap();
                        opt_result = Option::<ExprGroup1>::Some(group_1);
                    }
                    opt_result
                } else {
                    null
                };
                let _bt_r_2 = p.expect(TK_LIT_RPAREN, "')'");
                if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try; }
                let rparen = _bt_r_2.unwrap();
                group_0_inner = Option::<ExprGroup0>::Some(ExprGroup0::Alt0(ExprGroup0Alt0 {
                    lparen,
                    group_1,
                    rparen,
                }));
                bt_done = true;
            }
        }
        if !bt_done {
            let database_name_dot: Option<DatabaseNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
                let opt_saved = p.pos;
                let mut opt_result: Option<DatabaseNameDotItem> = null;
                opt_bt: {
                    let _bt_r = parse_database_name(p);
                    if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
                    let database_name = _bt_r.unwrap();
                    let _bt_r_2 = p.expect(TK_LIT_DOT, "'.'");
                    if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
                    let dot = _bt_r_2.unwrap();
                    let database_name_dot = DatabaseNameDotItem {
                        database_name,
                        dot,
                    };
                    opt_result = Option::<DatabaseNameDotItem>::Some(database_name_dot);
                }
                opt_result
            } else {
                null
            };
            let table_name = parse_table_name(p)?;
            group_0_inner = Option::<ExprGroup0>::Some(ExprGroup0::Alt1(ExprGroup0Alt1 {
                database_name_dot,
                table_name,
            }));
        }
    }
    let group_0 = group_0_inner;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt10(ExprAlt10 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_not,
        k_in,
        group_0,
    }));
}

fn parse_expr_lr_11(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_and = p.expect(TK_K_AND, "K_AND")?;
    let expr_2 = parse_expr_prec(p, 8)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt11(ExprAlt11 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_and,
        expr_2,
    }));
}

fn parse_expr_lr_12(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_or = p.expect(TK_K_OR, "K_OR")?;
    let expr_2 = parse_expr_prec(p, 7)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt12(ExprAlt12 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_or,
        expr_2,
    }));
}

fn parse_expr_lr_16(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_collate = p.expect(TK_K_COLLATE, "K_COLLATE")?;
    let collation_name = parse_collation_name(p)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt16(ExprAlt16 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_collate,
        collation_name,
    }));
}

fn parse_expr_lr_17(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
        let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        Option::<Token>::Some(k_not)
    } else {
        null
    };
    let k_like_or_k_glob_or_k_regexp_or_k_match = p.advance();
    let expr_2 = parse_expr_prec(p, 5)?;
    let k_escape_expr: Option<KEscapeExprItem> = if p.peek_kind() == TK_K_ESCAPE {
        let k_escape = p.expect(TK_K_ESCAPE, "K_ESCAPE")?;
        let expr = parse_expr(p)?;
        let k_escape_expr = KEscapeExprItem {
            k_escape,
            expr,
        };
        Option::<KEscapeExprItem>::Some(k_escape_expr)
    } else {
        null
    };
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt17(ExprAlt17 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_not,
        k_like_or_k_glob_or_k_regexp_or_k_match,
        expr_2,
        k_escape_expr,
    }));
}

fn parse_expr_lr_18(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let mut group_3_inner: Option<ExprGroup3> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_ISNULL {
        let k_isnull = p.expect(TK_K_ISNULL, "K_ISNULL")?;
        group_3_inner = Option::<ExprGroup3>::Some(ExprGroup3::Alt0(ExprGroup3Alt0 {
            k_isnull,
        }));
    } else if grp_kind == TK_K_NOTNULL {
        let k_notnull = p.expect(TK_K_NOTNULL, "K_NOTNULL")?;
        group_3_inner = Option::<ExprGroup3>::Some(ExprGroup3::Alt1(ExprGroup3Alt1 {
            k_notnull,
        }));
    } else if grp_kind == TK_K_NOT {
        let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        let k_null = p.expect(TK_K_NULL, "K_NULL")?;
        group_3_inner = Option::<ExprGroup3>::Some(ExprGroup3::Alt2(ExprGroup3Alt2 {
            k_not,
            k_null,
        }));
    }
    let group_3 = group_3_inner;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt18(ExprAlt18 {
        span: Span::new(start, p.last_end()),
        expr: left,
        group_3,
    }));
}

fn parse_expr_lr_19(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_is = p.expect(TK_K_IS, "K_IS")?;
    let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
        let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        Option::<Token>::Some(k_not)
    } else {
        null
    };
    let expr_2 = parse_expr_prec(p, 3)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt19(ExprAlt19 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_is,
        k_not,
        expr_2,
    }));
}

fn parse_expr_lr_20(p: &mut Parser, left: ExprNode, start: i32) -> Result<ExprNode, ParseError> {
    let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
        let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        Option::<Token>::Some(k_not)
    } else {
        null
    };
    let k_between = p.expect(TK_K_BETWEEN, "K_BETWEEN")?;
    let expr_2 = parse_expr_prec(p, 8)?;
    let k_and = p.expect(TK_K_AND, "K_AND")?;
    let expr_3 = parse_expr_prec(p, 8)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt20(ExprAlt20 {
        span: Span::new(start, p.last_end()),
        expr: left,
        k_not,
        k_between,
        expr_2,
        k_and,
        expr_3,
    }));
}

fn parse_expr_prec(p: &mut Parser, min_prec: i32) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let mut result = parse_expr_atom(p)?;
    loop {
        let suffix_kind = p.peek_kind();
        if suffix_kind == TK_LIT_PIPEPIPE {
            if 14 >= min_prec {
                result = parse_expr_lr_4(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind matches { TK_LIT_STAR | TK_LIT_SLASH | TK_LIT_PERCENT } {
            if 13 >= min_prec {
                result = parse_expr_lr_5(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind matches { TK_LIT_PLUS | TK_LIT_MINUS } {
            if 12 >= min_prec {
                result = parse_expr_lr_6(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind matches { TK_LIT_LTLT | TK_LIT_GTGT | TK_LIT_AMP | TK_LIT_PIPE } {
            if 11 >= min_prec {
                result = parse_expr_lr_7(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind matches { TK_LIT_LT | TK_LIT_LTEQ | TK_LIT_GT | TK_LIT_GTEQ } {
            if 10 >= min_prec {
                result = parse_expr_lr_8(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind matches { TK_LIT_EQ | TK_LIT_EQEQ | TK_LIT_BANGEQ | TK_LIT_LTGT } {
            if 9 >= min_prec {
                result = parse_expr_lr_9(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind matches { TK_K_NOT | TK_K_IN | TK_K_LIKE | TK_K_GLOB | TK_K_REGEXP | TK_K_MATCH | TK_K_ISNULL | TK_K_NOTNULL | TK_K_BETWEEN } {
            if suffix_kind == TK_K_IN {
                if 8 >= min_prec {
                    result = parse_expr_lr_10(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_LIKE {
                if 4 >= min_prec {
                    result = parse_expr_lr_17(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_GLOB {
                if 4 >= min_prec {
                    result = parse_expr_lr_17(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_REGEXP {
                if 4 >= min_prec {
                    result = parse_expr_lr_17(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_MATCH {
                if 4 >= min_prec {
                    result = parse_expr_lr_17(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_ISNULL {
                if 3 >= min_prec {
                    result = parse_expr_lr_18(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_NOTNULL {
                if 3 >= min_prec {
                    result = parse_expr_lr_18(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_BETWEEN {
                if 1 >= min_prec {
                    result = parse_expr_lr_20(p, result, start)?;
                } else {
                    break;
                }
            } else if suffix_kind == TK_K_NOT {
                if p.peek_at(1) == TK_K_IN {
                    if 8 >= min_prec {
                        result = parse_expr_lr_10(p, result, start)?;
                    } else {
                        break;
                    }
                } else if p.peek_at(1) matches { TK_K_LIKE | TK_K_GLOB | TK_K_REGEXP | TK_K_MATCH } {
                    if 4 >= min_prec {
                        result = parse_expr_lr_17(p, result, start)?;
                    } else {
                        break;
                    }
                } else if p.peek_at(1) == TK_K_NULL {
                    if 3 >= min_prec {
                        result = parse_expr_lr_18(p, result, start)?;
                    } else {
                        break;
                    }
                } else {
                    if 1 >= min_prec {
                        result = parse_expr_lr_20(p, result, start)?;
                    } else {
                        break;
                    }
                }
            }
        } else if suffix_kind == TK_K_AND {
            if 7 >= min_prec {
                result = parse_expr_lr_11(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_K_OR {
            if 6 >= min_prec {
                result = parse_expr_lr_12(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_K_COLLATE {
            if 5 >= min_prec {
                result = parse_expr_lr_16(p, result, start)?;
            } else {
                break;
            }
        } else if suffix_kind == TK_K_IS {
            if 2 >= min_prec {
                result = parse_expr_lr_19(p, result, start)?;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    return Result::<ExprNode, ParseError>::Ok(result);
}

fn parse_expr(p: &mut Parser) -> Result<ExprNode, ParseError> {
    return parse_expr_prec(p, 0);
}

fn parse_foreign_key_clause(p: &mut Parser) -> Result<ForeignKeyClauseNode, ParseError> {
    let start = p.peek().span.start;
    let k_references = p.expect(TK_K_REFERENCES, "K_REFERENCES")?;
    let foreign_table = parse_foreign_table(p)?;
    let lparen_column_name_item_rparen: Option<LparenColumnNameItemRparenItem> = if p.peek_kind() == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let column_name = parse_column_name(p)?;
        let mut comma_column_name_list: Array<CommaColumnNameItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let column_name = parse_column_name(p)?;
            let comma_column_name = CommaColumnNameItem {
                comma,
                column_name,
            };
            comma_column_name_list.push(comma_column_name);
        }
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        let lparen_column_name_item_rparen = LparenColumnNameItemRparenItem {
            lparen,
            column_name,
            comma_column_name_list,
            rparen,
        };
        Option::<LparenColumnNameItemRparenItem>::Some(lparen_column_name_item_rparen)
    } else {
        null
    };
    while p.peek_kind() matches { TK_K_ON | TK_K_MATCH } {
        let mut group_0_inner: Option<ForeignKeyClauseGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_K_ON {
            let k_on = p.expect(TK_K_ON, "K_ON")?;
            let k_delete_or_k_update = p.advance();
            let mut group_1_inner: Option<ForeignKeyClauseGroup1> = null;
            let grp_kind = p.peek_kind();
            if grp_kind == TK_K_SET {
                let saved_pos = p.pos;
                let mut bt_done = false;
                if !bt_done {
                    bt_try: {
                        let _bt_r = p.expect(TK_K_SET, "K_SET");
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                        let k_set = _bt_r.unwrap();
                        let _bt_r_2 = p.expect(TK_K_NULL, "K_NULL");
                        if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try; }
                        let k_null = _bt_r_2.unwrap();
                        group_1_inner = Option::<ForeignKeyClauseGroup1>::Some(ForeignKeyClauseGroup1::Alt0(ForeignKeyClauseGroup1Alt0 {
                            k_set,
                            k_null,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    let k_set = p.expect(TK_K_SET, "K_SET")?;
                    let k_default = p.expect(TK_K_DEFAULT, "K_DEFAULT")?;
                    group_1_inner = Option::<ForeignKeyClauseGroup1>::Some(ForeignKeyClauseGroup1::Alt1(ForeignKeyClauseGroup1Alt1 {
                        k_set,
                        k_default,
                    }));
                }
            } else if grp_kind == TK_K_CASCADE {
                let k_cascade = p.expect(TK_K_CASCADE, "K_CASCADE")?;
                group_1_inner = Option::<ForeignKeyClauseGroup1>::Some(ForeignKeyClauseGroup1::Alt2(ForeignKeyClauseGroup1Alt2 {
                    k_cascade,
                }));
            } else if grp_kind == TK_K_RESTRICT {
                let k_restrict = p.expect(TK_K_RESTRICT, "K_RESTRICT")?;
                group_1_inner = Option::<ForeignKeyClauseGroup1>::Some(ForeignKeyClauseGroup1::Alt3(ForeignKeyClauseGroup1Alt3 {
                    k_restrict,
                }));
            } else if grp_kind == TK_K_NO {
                let k_no = p.expect(TK_K_NO, "K_NO")?;
                let k_action = p.expect(TK_K_ACTION, "K_ACTION")?;
                group_1_inner = Option::<ForeignKeyClauseGroup1>::Some(ForeignKeyClauseGroup1::Alt4(ForeignKeyClauseGroup1Alt4 {
                    k_no,
                    k_action,
                }));
            }
            let group_1 = group_1_inner;
            group_0_inner = Option::<ForeignKeyClauseGroup0>::Some(ForeignKeyClauseGroup0::Alt0(ForeignKeyClauseGroup0Alt0 {
                k_on,
                k_delete_or_k_update,
                group_1,
            }));
        } else if grp_kind == TK_K_MATCH {
            let k_match = p.expect(TK_K_MATCH, "K_MATCH")?;
            let name = parse_name(p)?;
            group_0_inner = Option::<ForeignKeyClauseGroup0>::Some(ForeignKeyClauseGroup0::Alt1(ForeignKeyClauseGroup0Alt1 {
                k_match,
                name,
            }));
        }
        let group_0 = group_0_inner;
    }
    let k_not_k_deferrable_item: Option<KNotKDeferrableItemItem> = if p.peek_kind() == TK_K_NOT && p.peek_at(1) == TK_K_DEFERRABLE && p.peek_at(2) == TK_K_INITIALLY {
        let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
            let k_not = p.expect(TK_K_NOT, "K_NOT")?;
            Option::<Token>::Some(k_not)
        } else {
            null
        };
        let k_deferrable = p.expect(TK_K_DEFERRABLE, "K_DEFERRABLE")?;
        let group_2: Option<ForeignKeyClauseGroup2> = if p.peek_kind() == TK_K_INITIALLY {
            let opt_saved = p.pos;
            let mut opt_result: Option<ForeignKeyClauseGroup2> = null;
            opt_bt: {
                let mut group_2_opt: Option<ForeignKeyClauseGroup2> = null;
                let grp_kind = p.peek_kind();
                if grp_kind == TK_K_INITIALLY {
                    let saved_pos = p.pos;
                    let mut bt_done = false;
                    if !bt_done {
                        bt_try: {
                            let _bt_r = p.expect(TK_K_INITIALLY, "K_INITIALLY");
                            if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                            let k_initially = _bt_r.unwrap();
                            let _bt_r_2 = p.expect(TK_K_DEFERRED, "K_DEFERRED");
                            if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try; }
                            let k_deferred = _bt_r_2.unwrap();
                            group_2_opt = Option::<ForeignKeyClauseGroup2>::Some(ForeignKeyClauseGroup2::Alt0(ForeignKeyClauseGroup2Alt0 {
                                k_initially,
                                k_deferred,
                            }));
                            bt_done = true;
                        }
                    }
                    if !bt_done {
                        let k_initially = p.expect(TK_K_INITIALLY, "K_INITIALLY")?;
                        let k_immediate = p.expect(TK_K_IMMEDIATE, "K_IMMEDIATE")?;
                        group_2_opt = Option::<ForeignKeyClauseGroup2>::Some(ForeignKeyClauseGroup2::Alt1(ForeignKeyClauseGroup2Alt1 {
                            k_initially,
                            k_immediate,
                        }));
                    }
                }
                if let None = group_2_opt {
                    p.expect(-1, "group alternative")?;
                }
                let group_2 = group_2_opt.unwrap();
                opt_result = Option::<ForeignKeyClauseGroup2>::Some(group_2);
            }
            opt_result
        } else {
            null
        };
        let k_not_k_deferrable_item = KNotKDeferrableItemItem {
            k_not,
            k_deferrable,
            group_2,
        };
        Option::<KNotKDeferrableItemItem>::Some(k_not_k_deferrable_item)
    } else if p.peek_kind() == TK_K_DEFERRABLE && p.peek_at(1) == TK_K_INITIALLY {
        let k_not: Option<Token> = null;
        let k_deferrable = p.expect(TK_K_DEFERRABLE, "K_DEFERRABLE")?;
        let group_2: Option<ForeignKeyClauseGroup2> = if p.peek_kind() == TK_K_INITIALLY {
            let opt_saved = p.pos;
            let mut opt_result: Option<ForeignKeyClauseGroup2> = null;
            opt_bt: {
                let mut group_2_opt: Option<ForeignKeyClauseGroup2> = null;
                let grp_kind = p.peek_kind();
                if grp_kind == TK_K_INITIALLY {
                    let saved_pos = p.pos;
                    let mut bt_done = false;
                    if !bt_done {
                        bt_try: {
                            let _bt_r = p.expect(TK_K_INITIALLY, "K_INITIALLY");
                            if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                            let k_initially = _bt_r.unwrap();
                            let _bt_r_2 = p.expect(TK_K_DEFERRED, "K_DEFERRED");
                            if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try; }
                            let k_deferred = _bt_r_2.unwrap();
                            group_2_opt = Option::<ForeignKeyClauseGroup2>::Some(ForeignKeyClauseGroup2::Alt0(ForeignKeyClauseGroup2Alt0 {
                                k_initially,
                                k_deferred,
                            }));
                            bt_done = true;
                        }
                    }
                    if !bt_done {
                        let k_initially = p.expect(TK_K_INITIALLY, "K_INITIALLY")?;
                        let k_immediate = p.expect(TK_K_IMMEDIATE, "K_IMMEDIATE")?;
                        group_2_opt = Option::<ForeignKeyClauseGroup2>::Some(ForeignKeyClauseGroup2::Alt1(ForeignKeyClauseGroup2Alt1 {
                            k_initially,
                            k_immediate,
                        }));
                    }
                }
                if let None = group_2_opt {
                    p.expect(-1, "group alternative")?;
                }
                let group_2 = group_2_opt.unwrap();
                opt_result = Option::<ForeignKeyClauseGroup2>::Some(group_2);
            }
            opt_result
        } else {
            null
        };
        let k_not_k_deferrable_item = KNotKDeferrableItemItem {
            k_not,
            k_deferrable,
            group_2,
        };
        Option::<KNotKDeferrableItemItem>::Some(k_not_k_deferrable_item)
    } else if p.peek_kind() == TK_K_NOT && p.peek_at(1) == TK_K_DEFERRABLE {
        let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
            let k_not = p.expect(TK_K_NOT, "K_NOT")?;
            Option::<Token>::Some(k_not)
        } else {
            null
        };
        let k_deferrable = p.expect(TK_K_DEFERRABLE, "K_DEFERRABLE")?;
        let group_2: Option<ForeignKeyClauseGroup2> = null;
        let k_not_k_deferrable_item = KNotKDeferrableItemItem {
            k_not,
            k_deferrable,
            group_2,
        };
        Option::<KNotKDeferrableItemItem>::Some(k_not_k_deferrable_item)
    } else if p.peek_kind() == TK_K_DEFERRABLE {
        let k_not: Option<Token> = null;
        let k_deferrable = p.expect(TK_K_DEFERRABLE, "K_DEFERRABLE")?;
        let group_2: Option<ForeignKeyClauseGroup2> = null;
        let k_not_k_deferrable_item = KNotKDeferrableItemItem {
            k_not,
            k_deferrable,
            group_2,
        };
        Option::<KNotKDeferrableItemItem>::Some(k_not_k_deferrable_item)
    } else {
        null
    };
    return Result::<ForeignKeyClauseNode, ParseError>::Ok(ForeignKeyClauseNode {
        span: Span::new(start, p.last_end()),
        k_references,
        foreign_table,
        lparen_column_name_item_rparen,
        k_not_k_deferrable_item,
    });
}

fn parse_raise_function(p: &mut Parser) -> Result<RaiseFunctionNode, ParseError> {
    let start = p.peek().span.start;
    let k_raise = p.expect(TK_K_RAISE, "K_RAISE")?;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let mut group_0_inner: Option<RaiseFunctionGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_IGNORE {
        let k_ignore = p.expect(TK_K_IGNORE, "K_IGNORE")?;
        group_0_inner = Option::<RaiseFunctionGroup0>::Some(RaiseFunctionGroup0::Alt0(RaiseFunctionGroup0Alt0 {
            k_ignore,
        }));
    } else if grp_kind matches { TK_K_ROLLBACK | TK_K_ABORT | TK_K_FAIL } {
        let k_rollback_or_k_abort_or_k_fail = p.advance();
        let comma = p.expect(TK_LIT_COMMA, "','")?;
        let error_message = parse_error_message(p)?;
        group_0_inner = Option::<RaiseFunctionGroup0>::Some(RaiseFunctionGroup0::Alt1(RaiseFunctionGroup0Alt1 {
            k_rollback_or_k_abort_or_k_fail,
            comma,
            error_message,
        }));
    }
    let group_0 = group_0_inner;
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    return Result::<RaiseFunctionNode, ParseError>::Ok(RaiseFunctionNode {
        span: Span::new(start, p.last_end()),
        k_raise,
        lparen,
        group_0,
        rparen,
    });
}

fn parse_indexed_column(p: &mut Parser) -> Result<IndexedColumnNode, ParseError> {
    let start = p.peek().span.start;
    let column_name = parse_column_name(p)?;
    let k_collate_collation_name: Option<KCollateCollationNameItem> = if p.peek_kind() == TK_K_COLLATE {
        let k_collate = p.expect(TK_K_COLLATE, "K_COLLATE")?;
        let collation_name = parse_collation_name(p)?;
        let k_collate_collation_name = KCollateCollationNameItem {
            k_collate,
            collation_name,
        };
        Option::<KCollateCollationNameItem>::Some(k_collate_collation_name)
    } else {
        null
    };
    let k_asc_or_k_desc: Option<Token> = if p.peek_kind() matches { TK_K_ASC | TK_K_DESC } {
        let opt_saved = p.pos;
        let mut opt_result: Option<Token> = null;
        opt_bt: {
            let k_asc_or_k_desc = p.advance();
            opt_result = Option::<Token>::Some(k_asc_or_k_desc);
        }
        opt_result
    } else {
        null
    };
    return Result::<IndexedColumnNode, ParseError>::Ok(IndexedColumnNode {
        span: Span::new(start, p.last_end()),
        column_name,
        k_collate_collation_name,
        k_asc_or_k_desc,
    });
}

fn parse_table_constraint(p: &mut Parser) -> Result<TableConstraintNode, ParseError> {
    let start = p.peek().span.start;
    let k_constraint_name: Option<KConstraintNameItem> = if p.peek_kind() == TK_K_CONSTRAINT {
        let k_constraint = p.expect(TK_K_CONSTRAINT, "K_CONSTRAINT")?;
        let name = parse_name(p)?;
        let k_constraint_name = KConstraintNameItem {
            k_constraint,
            name,
        };
        Option::<KConstraintNameItem>::Some(k_constraint_name)
    } else {
        null
    };
    let mut group_0_inner: Option<TableConstraintGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_K_PRIMARY | TK_K_UNIQUE } {
        let mut group_1_inner: Option<TableConstraintGroup1> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_K_PRIMARY {
            let k_primary = p.expect(TK_K_PRIMARY, "K_PRIMARY")?;
            let k_key = p.expect(TK_K_KEY, "K_KEY")?;
            group_1_inner = Option::<TableConstraintGroup1>::Some(TableConstraintGroup1::Alt0(TableConstraintGroup1Alt0 {
                k_primary,
                k_key,
            }));
        } else if grp_kind == TK_K_UNIQUE {
            let k_unique = p.expect(TK_K_UNIQUE, "K_UNIQUE")?;
            group_1_inner = Option::<TableConstraintGroup1>::Some(TableConstraintGroup1::Alt1(TableConstraintGroup1Alt1 {
                k_unique,
            }));
        }
        let group_1 = group_1_inner;
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let indexed_column = parse_indexed_column(p)?;
        let mut comma_indexed_column_list: Array<CommaIndexedColumnItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let indexed_column = parse_indexed_column(p)?;
            let comma_indexed_column = CommaIndexedColumnItem {
                comma,
                indexed_column,
            };
            comma_indexed_column_list.push(comma_indexed_column);
        }
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        let conflict_clause = parse_conflict_clause(p)?;
        group_0_inner = Option::<TableConstraintGroup0>::Some(TableConstraintGroup0::Alt0(TableConstraintGroup0Alt0 {
            group_1,
            lparen,
            indexed_column,
            comma_indexed_column_list,
            rparen,
            conflict_clause,
        }));
    } else if grp_kind == TK_K_CHECK {
        let k_check = p.expect(TK_K_CHECK, "K_CHECK")?;
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let expr = parse_expr(p)?;
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        group_0_inner = Option::<TableConstraintGroup0>::Some(TableConstraintGroup0::Alt1(TableConstraintGroup0Alt1 {
            k_check,
            lparen,
            expr,
            rparen,
        }));
    } else if grp_kind == TK_K_FOREIGN {
        let k_foreign = p.expect(TK_K_FOREIGN, "K_FOREIGN")?;
        let k_key = p.expect(TK_K_KEY, "K_KEY")?;
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let column_name = parse_column_name(p)?;
        let mut comma_column_name_list: Array<CommaColumnNameItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let column_name = parse_column_name(p)?;
            let comma_column_name = CommaColumnNameItem {
                comma,
                column_name,
            };
            comma_column_name_list.push(comma_column_name);
        }
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        let foreign_key_clause = parse_foreign_key_clause(p)?;
        group_0_inner = Option::<TableConstraintGroup0>::Some(TableConstraintGroup0::Alt2(TableConstraintGroup0Alt2 {
            k_foreign,
            k_key,
            lparen,
            column_name,
            comma_column_name_list,
            rparen,
            foreign_key_clause,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<TableConstraintNode, ParseError>::Ok(TableConstraintNode {
        span: Span::new(start, p.last_end()),
        k_constraint_name,
        group_0,
    });
}

fn parse_with_clause(p: &mut Parser) -> Result<WithClauseNode, ParseError> {
    let start = p.peek().span.start;
    let k_with = p.expect(TK_K_WITH, "K_WITH")?;
    let k_recursive: Option<Token> = if p.peek_kind() == TK_K_RECURSIVE {
        let k_recursive = p.expect(TK_K_RECURSIVE, "K_RECURSIVE")?;
        Option::<Token>::Some(k_recursive)
    } else {
        null
    };
    let common_table_expression = parse_common_table_expression(p)?;
    let mut comma_common_table_expression_list: Array<CommaCommonTableExpressionItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA, "','")?;
        let common_table_expression = parse_common_table_expression(p)?;
        let comma_common_table_expression = CommaCommonTableExpressionItem {
            comma,
            common_table_expression,
        };
        comma_common_table_expression_list.push(comma_common_table_expression);
    }
    return Result::<WithClauseNode, ParseError>::Ok(WithClauseNode {
        span: Span::new(start, p.last_end()),
        k_with,
        k_recursive,
        common_table_expression,
        comma_common_table_expression_list,
    });
}

fn parse_qualified_table_name(p: &mut Parser) -> Result<QualifiedTableNameNode, ParseError> {
    let start = p.peek().span.start;
    let database_name_dot: Option<DatabaseNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let opt_saved = p.pos;
        let mut opt_result: Option<DatabaseNameDotItem> = null;
        opt_bt: {
            let _bt_r = parse_database_name(p);
            if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
            let database_name = _bt_r.unwrap();
            let _bt_r_2 = p.expect(TK_LIT_DOT, "'.'");
            if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
            let dot = _bt_r_2.unwrap();
            let database_name_dot = DatabaseNameDotItem {
                database_name,
                dot,
            };
            opt_result = Option::<DatabaseNameDotItem>::Some(database_name_dot);
        }
        opt_result
    } else {
        null
    };
    let table_name = parse_table_name(p)?;
    let group_0: Option<QualifiedTableNameGroup0> = if p.peek_kind() matches { TK_K_INDEXED | TK_K_NOT } {
        let opt_saved_2 = p.pos;
        let mut opt_result_2: Option<QualifiedTableNameGroup0> = null;
        opt_bt_2: {
            let group_0: QualifiedTableNameGroup0 = if p.peek_kind() == TK_K_INDEXED {
                let k_indexed = p.expect(TK_K_INDEXED, "K_INDEXED")?;
                let k_by = p.expect(TK_K_BY, "K_BY")?;
                let index_name = parse_index_name(p)?;
                QualifiedTableNameGroup0::Alt0(QualifiedTableNameGroup0Alt0 {
                    k_indexed,
                    k_by,
                    index_name,
                })
            } else {
                let k_not = p.expect(TK_K_NOT, "K_NOT")?;
                let k_indexed = p.expect(TK_K_INDEXED, "K_INDEXED")?;
                QualifiedTableNameGroup0::Alt1(QualifiedTableNameGroup0Alt1 {
                    k_not,
                    k_indexed,
                })
            };
            opt_result_2 = Option::<QualifiedTableNameGroup0>::Some(group_0);
        }
        opt_result_2
    } else {
        null
    };
    return Result::<QualifiedTableNameNode, ParseError>::Ok(QualifiedTableNameNode {
        span: Span::new(start, p.last_end()),
        database_name_dot,
        table_name,
        group_0,
    });
}

fn parse_ordering_term(p: &mut Parser) -> Result<OrderingTermNode, ParseError> {
    let start = p.peek().span.start;
    let expr = parse_expr(p)?;
    let k_collate_collation_name: Option<KCollateCollationNameItem> = if p.peek_kind() == TK_K_COLLATE {
        let k_collate = p.expect(TK_K_COLLATE, "K_COLLATE")?;
        let collation_name = parse_collation_name(p)?;
        let k_collate_collation_name = KCollateCollationNameItem {
            k_collate,
            collation_name,
        };
        Option::<KCollateCollationNameItem>::Some(k_collate_collation_name)
    } else {
        null
    };
    let k_asc_or_k_desc: Option<Token> = if p.peek_kind() matches { TK_K_ASC | TK_K_DESC } {
        let opt_saved = p.pos;
        let mut opt_result: Option<Token> = null;
        opt_bt: {
            let k_asc_or_k_desc = p.advance();
            opt_result = Option::<Token>::Some(k_asc_or_k_desc);
        }
        opt_result
    } else {
        null
    };
    return Result::<OrderingTermNode, ParseError>::Ok(OrderingTermNode {
        span: Span::new(start, p.last_end()),
        expr,
        k_collate_collation_name,
        k_asc_or_k_desc,
    });
}

fn parse_pragma_value_bt_1(p: &mut Parser) -> Result<PragmaValueNode, ParseError> {
    let start = p.peek().span.start;
    let name = parse_name(p)?;
    return Result::<PragmaValueNode, ParseError>::Ok(PragmaValueNode::Alt1(PragmaValueAlt1 {
        span: Span::new(start, p.last_end()),
        name,
    }));
}

fn parse_pragma_value_bt_2(p: &mut Parser) -> Result<PragmaValueNode, ParseError> {
    let start = p.peek().span.start;
    let string_literal = p.expect(TK_STRING_LITERAL, "STRING_LITERAL")?;
    return Result::<PragmaValueNode, ParseError>::Ok(PragmaValueNode::Alt2(PragmaValueAlt2 {
        span: Span::new(start, p.last_end()),
        string_literal,
    }));
}

fn parse_pragma_value(p: &mut Parser) -> Result<PragmaValueNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_LIT_PLUS | TK_LIT_MINUS | TK_NUMERIC_LITERAL } {
        let signed_number = parse_signed_number(p)?;
        return Result::<PragmaValueNode, ParseError>::Ok(PragmaValueNode::Alt0(PragmaValueAlt0 {
            span: Span::new(start, p.last_end()),
            signed_number,
        }));
    }
    if kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        if p.peek_kind() == TK_STRING_LITERAL {
            let saved = p.pos;
            let r_1 = parse_pragma_value_bt_1(p);
            if let Err(_) = r_1 {
                p.pos = saved;
            } else {
                return r_1;
            }
            return parse_pragma_value_bt_2(p);
        } else if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_LIT_LPAREN } {
            return parse_pragma_value_bt_1(p);
        }
    }
    return Result::<PragmaValueNode, ParseError>::Err(ParseError::new(
        "expected pragma_value",
        p.peek().span,
        ["TK_LIT_PLUS", "TK_LIT_MINUS", "TK_NUMERIC_LITERAL", "TK_IDENTIFIER", "TK_K_ABORT", "TK_K_ACTION", "TK_K_ADD", "TK_K_AFTER", "TK_K_ALL", "TK_K_ALTER", "TK_K_ANALYZE", "TK_K_AND", "TK_K_AS", "TK_K_ASC", "TK_K_ATTACH", "TK_K_AUTOINCREMENT", "TK_K_BEFORE", "TK_K_BEGIN", "TK_K_BETWEEN", "TK_K_BY", "TK_K_CASCADE", "TK_K_CASE", "TK_K_CAST", "TK_K_CHECK", "TK_K_COLLATE", "TK_K_COLUMN", "TK_K_COMMIT", "TK_K_CONFLICT", "TK_K_CONSTRAINT", "TK_K_CREATE", "TK_K_CROSS", "TK_K_CURRENT_DATE", "TK_K_CURRENT_TIME", "TK_K_CURRENT_TIMESTAMP", "TK_K_DATABASE", "TK_K_DEFAULT", "TK_K_DEFERRABLE", "TK_K_DEFERRED", "TK_K_DELETE", "TK_K_DESC", "TK_K_DETACH", "TK_K_DISTINCT", "TK_K_DROP", "TK_K_EACH", "TK_K_ELSE", "TK_K_END", "TK_K_ESCAPE", "TK_K_EXCEPT", "TK_K_EXCLUSIVE", "TK_K_EXISTS", "TK_K_EXPLAIN", "TK_K_FAIL", "TK_K_FOR", "TK_K_FOREIGN", "TK_K_FROM", "TK_K_FULL", "TK_K_GLOB", "TK_K_GROUP", "TK_K_HAVING", "TK_K_IF", "TK_K_IGNORE", "TK_K_IMMEDIATE", "TK_K_IN", "TK_K_INDEX", "TK_K_INDEXED", "TK_K_INITIALLY", "TK_K_INNER", "TK_K_INSERT", "TK_K_INSTEAD", "TK_K_INTERSECT", "TK_K_INTO", "TK_K_IS", "TK_K_ISNULL", "TK_K_JOIN", "TK_K_KEY", "TK_K_LEFT", "TK_K_LIKE", "TK_K_LIMIT", "TK_K_MATCH", "TK_K_NATURAL", "TK_K_NO", "TK_K_NOT", "TK_K_NOTNULL", "TK_K_NULL", "TK_K_OF", "TK_K_OFFSET", "TK_K_ON", "TK_K_OR", "TK_K_ORDER", "TK_K_OUTER", "TK_K_PLAN", "TK_K_PRAGMA", "TK_K_PRIMARY", "TK_K_QUERY", "TK_K_RAISE", "TK_K_RECURSIVE", "TK_K_REFERENCES", "TK_K_REGEXP", "TK_K_REINDEX", "TK_K_RELEASE", "TK_K_RENAME", "TK_K_REPLACE", "TK_K_RESTRICT", "TK_K_RIGHT", "TK_K_ROLLBACK", "TK_K_ROW", "TK_K_SAVEPOINT", "TK_K_SELECT", "TK_K_SET", "TK_K_TABLE", "TK_K_TEMP", "TK_K_TEMPORARY", "TK_K_THEN", "TK_K_TO", "TK_K_TRANSACTION", "TK_K_TRIGGER", "TK_K_UNION", "TK_K_UNIQUE", "TK_K_UPDATE", "TK_K_USING", "TK_K_VACUUM", "TK_K_VALUES", "TK_K_VIEW", "TK_K_VIRTUAL", "TK_K_WHEN", "TK_K_WHERE", "TK_K_WITH", "TK_K_WITHOUT", "TK_STRING_LITERAL", "TK_LIT_LPAREN"],
    ));
}

fn parse_common_table_expression(p: &mut Parser) -> Result<CommonTableExpressionNode, ParseError> {
    let start = p.peek().span.start;
    let table_name = parse_table_name(p)?;
    let lparen_column_name_item_rparen: Option<LparenColumnNameItemRparenItem> = if p.peek_kind() == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let column_name = parse_column_name(p)?;
        let mut comma_column_name_list: Array<CommaColumnNameItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let column_name = parse_column_name(p)?;
            let comma_column_name = CommaColumnNameItem {
                comma,
                column_name,
            };
            comma_column_name_list.push(comma_column_name);
        }
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        let lparen_column_name_item_rparen = LparenColumnNameItemRparenItem {
            lparen,
            column_name,
            comma_column_name_list,
            rparen,
        };
        Option::<LparenColumnNameItemRparenItem>::Some(lparen_column_name_item_rparen)
    } else {
        null
    };
    let k_as = p.expect(TK_K_AS, "K_AS")?;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let select_stmt = parse_select_stmt(p)?;
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    return Result::<CommonTableExpressionNode, ParseError>::Ok(CommonTableExpressionNode {
        span: Span::new(start, p.last_end()),
        table_name,
        lparen_column_name_item_rparen,
        k_as,
        lparen,
        select_stmt,
        rparen,
    });
}

fn parse_result_column_bt_1(p: &mut Parser) -> Result<ResultColumnNode, ParseError> {
    let start = p.peek().span.start;
    let table_name = parse_table_name(p)?;
    let dot = p.expect(TK_LIT_DOT, "'.'")?;
    let star = p.expect(TK_LIT_STAR, "'*'")?;
    return Result::<ResultColumnNode, ParseError>::Ok(ResultColumnNode::Alt1(ResultColumnAlt1 {
        span: Span::new(start, p.last_end()),
        table_name,
        dot,
        star,
    }));
}

fn parse_result_column_bt_2(p: &mut Parser) -> Result<ResultColumnNode, ParseError> {
    let start = p.peek().span.start;
    let expr = parse_expr(p)?;
    let k_as_column_alias: Option<KAsColumnAliasItem> = if p.peek_kind() == TK_K_AS && (p.peek_at(1) == TK_IDENTIFIER || p.peek_at(1) == TK_STRING_LITERAL) {
        let k_as: Option<Token> = if p.peek_kind() == TK_K_AS {
            let k_as = p.expect(TK_K_AS, "K_AS")?;
            Option::<Token>::Some(k_as)
        } else {
            null
        };
        let column_alias = parse_column_alias(p)?;
        let k_as_column_alias = KAsColumnAliasItem {
            k_as,
            column_alias,
        };
        Option::<KAsColumnAliasItem>::Some(k_as_column_alias)
    } else if (p.peek_kind() == TK_IDENTIFIER || p.peek_kind() == TK_STRING_LITERAL) {
        let k_as: Option<Token> = null;
        let column_alias = parse_column_alias(p)?;
        let k_as_column_alias = KAsColumnAliasItem {
            k_as,
            column_alias,
        };
        Option::<KAsColumnAliasItem>::Some(k_as_column_alias)
    } else {
        null
    };
    return Result::<ResultColumnNode, ParseError>::Ok(ResultColumnNode::Alt2(ResultColumnAlt2 {
        span: Span::new(start, p.last_end()),
        expr,
        k_as_column_alias,
    }));
}

fn parse_result_column(p: &mut Parser) -> Result<ResultColumnNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_STAR {
        let star = p.expect(TK_LIT_STAR, "'*'")?;
        return Result::<ResultColumnNode, ParseError>::Ok(ResultColumnNode::Alt0(ResultColumnAlt0 {
            span: Span::new(start, p.last_end()),
            star,
        }));
    }
    if kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN | TK_NUMERIC_LITERAL | TK_BLOB_LITERAL | TK_BIND_PARAMETER | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
        if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
            let saved = p.pos;
            let r_1 = parse_result_column_bt_1(p);
            if let Err(_) = r_1 {
                p.pos = saved;
            } else {
                return r_1;
            }
            return parse_result_column_bt_2(p);
        } else if p.peek_kind() matches { TK_NUMERIC_LITERAL | TK_BLOB_LITERAL | TK_BIND_PARAMETER | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
            return parse_result_column_bt_2(p);
        }
    }
    return Result::<ResultColumnNode, ParseError>::Err(ParseError::new(
        "expected result_column",
        p.peek().span,
        ["TK_LIT_STAR", "TK_IDENTIFIER", "TK_K_ABORT", "TK_K_ACTION", "TK_K_ADD", "TK_K_AFTER", "TK_K_ALL", "TK_K_ALTER", "TK_K_ANALYZE", "TK_K_AND", "TK_K_AS", "TK_K_ASC", "TK_K_ATTACH", "TK_K_AUTOINCREMENT", "TK_K_BEFORE", "TK_K_BEGIN", "TK_K_BETWEEN", "TK_K_BY", "TK_K_CASCADE", "TK_K_CASE", "TK_K_CAST", "TK_K_CHECK", "TK_K_COLLATE", "TK_K_COLUMN", "TK_K_COMMIT", "TK_K_CONFLICT", "TK_K_CONSTRAINT", "TK_K_CREATE", "TK_K_CROSS", "TK_K_CURRENT_DATE", "TK_K_CURRENT_TIME", "TK_K_CURRENT_TIMESTAMP", "TK_K_DATABASE", "TK_K_DEFAULT", "TK_K_DEFERRABLE", "TK_K_DEFERRED", "TK_K_DELETE", "TK_K_DESC", "TK_K_DETACH", "TK_K_DISTINCT", "TK_K_DROP", "TK_K_EACH", "TK_K_ELSE", "TK_K_END", "TK_K_ESCAPE", "TK_K_EXCEPT", "TK_K_EXCLUSIVE", "TK_K_EXISTS", "TK_K_EXPLAIN", "TK_K_FAIL", "TK_K_FOR", "TK_K_FOREIGN", "TK_K_FROM", "TK_K_FULL", "TK_K_GLOB", "TK_K_GROUP", "TK_K_HAVING", "TK_K_IF", "TK_K_IGNORE", "TK_K_IMMEDIATE", "TK_K_IN", "TK_K_INDEX", "TK_K_INDEXED", "TK_K_INITIALLY", "TK_K_INNER", "TK_K_INSERT", "TK_K_INSTEAD", "TK_K_INTERSECT", "TK_K_INTO", "TK_K_IS", "TK_K_ISNULL", "TK_K_JOIN", "TK_K_KEY", "TK_K_LEFT", "TK_K_LIKE", "TK_K_LIMIT", "TK_K_MATCH", "TK_K_NATURAL", "TK_K_NO", "TK_K_NOT", "TK_K_NOTNULL", "TK_K_NULL", "TK_K_OF", "TK_K_OFFSET", "TK_K_ON", "TK_K_OR", "TK_K_ORDER", "TK_K_OUTER", "TK_K_PLAN", "TK_K_PRAGMA", "TK_K_PRIMARY", "TK_K_QUERY", "TK_K_RAISE", "TK_K_RECURSIVE", "TK_K_REFERENCES", "TK_K_REGEXP", "TK_K_REINDEX", "TK_K_RELEASE", "TK_K_RENAME", "TK_K_REPLACE", "TK_K_RESTRICT", "TK_K_RIGHT", "TK_K_ROLLBACK", "TK_K_ROW", "TK_K_SAVEPOINT", "TK_K_SELECT", "TK_K_SET", "TK_K_TABLE", "TK_K_TEMP", "TK_K_TEMPORARY", "TK_K_THEN", "TK_K_TO", "TK_K_TRANSACTION", "TK_K_TRIGGER", "TK_K_UNION", "TK_K_UNIQUE", "TK_K_UPDATE", "TK_K_USING", "TK_K_VACUUM", "TK_K_VALUES", "TK_K_VIEW", "TK_K_VIRTUAL", "TK_K_WHEN", "TK_K_WHERE", "TK_K_WITH", "TK_K_WITHOUT", "TK_STRING_LITERAL", "TK_LIT_LPAREN", "TK_NUMERIC_LITERAL", "TK_BLOB_LITERAL", "TK_BIND_PARAMETER", "TK_LIT_MINUS", "TK_LIT_PLUS", "TK_LIT_TILDE"],
    ));
}

fn parse_table_or_subquery_bt_2(p: &mut Parser) -> Result<TableOrSubqueryNode, ParseError> {
    let start = p.peek().span.start;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let mut group_1_inner: Option<TableOrSubqueryGroup1> = null;
    let grp_kind = p.peek_kind();
    if grp_kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let _bt_r = parse_join_clause(p);
                if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                let join_clause = _bt_r.unwrap();
                group_1_inner = Option::<TableOrSubqueryGroup1>::Some(TableOrSubqueryGroup1::Alt1(TableOrSubqueryGroup1Alt1 {
                    join_clause,
                }));
                bt_done = true;
            }
        }
        if !bt_done {
            let table_or_subquery = parse_table_or_subquery(p)?;
            let mut comma_table_or_subquery_list: Array<CommaTableOrSubqueryItem> = [];
            while p.peek_kind() == TK_LIT_COMMA {
                let comma = p.expect(TK_LIT_COMMA, "','")?;
                let table_or_subquery = parse_table_or_subquery(p)?;
                let comma_table_or_subquery = CommaTableOrSubqueryItem {
                    comma,
                    table_or_subquery,
                };
                comma_table_or_subquery_list.push(comma_table_or_subquery);
            }
            group_1_inner = Option::<TableOrSubqueryGroup1>::Some(TableOrSubqueryGroup1::Alt0(TableOrSubqueryGroup1Alt0 {
                table_or_subquery,
                comma_table_or_subquery_list,
            }));
        }
    }
    let group_1 = group_1_inner;
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    return Result::<TableOrSubqueryNode, ParseError>::Ok(TableOrSubqueryNode::Alt2(TableOrSubqueryAlt2 {
        span: Span::new(start, p.last_end()),
        lparen,
        group_1,
        rparen,
    }));
}

fn parse_table_or_subquery_bt_3(p: &mut Parser) -> Result<TableOrSubqueryNode, ParseError> {
    let start = p.peek().span.start;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let select_stmt = parse_select_stmt(p)?;
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    let k_as_table_alias: Option<KAsTableAliasItem> = if p.peek_kind() == TK_K_AS && (p.peek_at(1) == TK_IDENTIFIER || p.peek_at(1) == TK_STRING_LITERAL || p.peek_at(1) == TK_LIT_LPAREN) {
        let k_as: Option<Token> = if p.peek_kind() == TK_K_AS {
            let k_as = p.expect(TK_K_AS, "K_AS")?;
            Option::<Token>::Some(k_as)
        } else {
            null
        };
        let table_alias = parse_table_alias(p)?;
        let k_as_table_alias = KAsTableAliasItem {
            k_as,
            table_alias,
        };
        Option::<KAsTableAliasItem>::Some(k_as_table_alias)
    } else if (p.peek_kind() == TK_IDENTIFIER || p.peek_kind() == TK_STRING_LITERAL || p.peek_kind() == TK_LIT_LPAREN) {
        let k_as: Option<Token> = null;
        let table_alias = parse_table_alias(p)?;
        let k_as_table_alias = KAsTableAliasItem {
            k_as,
            table_alias,
        };
        Option::<KAsTableAliasItem>::Some(k_as_table_alias)
    } else {
        null
    };
    return Result::<TableOrSubqueryNode, ParseError>::Ok(TableOrSubqueryNode::Alt3(TableOrSubqueryAlt3 {
        span: Span::new(start, p.last_end()),
        lparen,
        select_stmt,
        rparen,
        k_as_table_alias,
    }));
}

fn parse_table_or_subquery_bt_1(p: &mut Parser) -> Result<TableOrSubqueryNode, ParseError> {
    let start = p.peek().span.start;
    let schema_name_dot: Option<SchemaNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let opt_saved = p.pos;
        let mut opt_result: Option<SchemaNameDotItem> = null;
        opt_bt: {
            let _bt_r = parse_schema_name(p);
            if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
            let schema_name = _bt_r.unwrap();
            let _bt_r_2 = p.expect(TK_LIT_DOT, "'.'");
            if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
            let dot = _bt_r_2.unwrap();
            let schema_name_dot = SchemaNameDotItem {
                schema_name,
                dot,
            };
            opt_result = Option::<SchemaNameDotItem>::Some(schema_name_dot);
        }
        opt_result
    } else {
        null
    };
    let table_function_name = parse_table_function_name(p)?;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let expr_item: Option<ExprItemItem> = if p.peek_kind() matches { TK_NUMERIC_LITERAL | TK_STRING_LITERAL | TK_BLOB_LITERAL | TK_K_NULL | TK_K_CURRENT_TIME | TK_K_CURRENT_DATE | TK_K_CURRENT_TIMESTAMP | TK_BIND_PARAMETER | TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
        let opt_saved_2 = p.pos;
        let mut opt_result_2: Option<ExprItemItem> = null;
        opt_bt_2: {
            let _bt_r = parse_expr(p);
            if let Err(_) = _bt_r { p.pos = opt_saved_2; break opt_bt_2; }
            let expr = _bt_r.unwrap();
            let mut comma_expr_list: Array<CommaExprItem> = [];
            while p.peek_kind() == TK_LIT_COMMA {
                let comma = p.expect(TK_LIT_COMMA, "','")?;
                let expr = parse_expr(p)?;
                let comma_expr = CommaExprItem {
                    comma,
                    expr,
                };
                comma_expr_list.push(comma_expr);
            }
            let expr_item = ExprItemItem {
                expr,
                comma_expr_list,
            };
            opt_result_2 = Option::<ExprItemItem>::Some(expr_item);
        }
        opt_result_2
    } else {
        null
    };
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    let k_as_table_alias: Option<KAsTableAliasItem> = if p.peek_kind() == TK_K_AS && (p.peek_at(1) == TK_IDENTIFIER || p.peek_at(1) == TK_STRING_LITERAL || p.peek_at(1) == TK_LIT_LPAREN) {
        let k_as: Option<Token> = if p.peek_kind() == TK_K_AS {
            let k_as = p.expect(TK_K_AS, "K_AS")?;
            Option::<Token>::Some(k_as)
        } else {
            null
        };
        let table_alias = parse_table_alias(p)?;
        let k_as_table_alias = KAsTableAliasItem {
            k_as,
            table_alias,
        };
