        let mut update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner: Option<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup> = null;
        let grp_kind = p.peek_kind();
        if grp_kind matches { TK_K_WITH | TK_K_UPDATE | TK_K_INSERT | TK_K_REPLACE | TK_K_DELETE | TK_K_SELECT | TK_K_VALUES } {
            let saved_pos = p.pos;
            let mut bt_done = false;
            if !bt_done {
                bt_try: {
                    let opt_r = parse_update_stmt(p);
                    if let Err(_) = opt_r { p.pos = saved_pos; break bt_try; }
                    update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner = Option::<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup>::Some(UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup::UpdateStmt(opt_r.unwrap()));
