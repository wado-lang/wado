fn parse_detach_stmt(p: &mut Parser) -> Result<DetachStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_detach = p.expect(TK_K_DETACH, "K_DETACH")?;
    let k_database: Option<Token> = if p.peek_kind() == TK_K_DATABASE {
        let k_database = p.expect(TK_K_DATABASE, "K_DATABASE")?;
        Option::<Token>::Some(k_database)
