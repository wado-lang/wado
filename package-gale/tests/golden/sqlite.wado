        let k_transaction = p.expect(TK_K_TRANSACTION, "K_TRANSACTION")?;
        let transaction_name: Option<TransactionNameNode> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
            let transaction_name = parse_transaction_name(p)?;
            Option::<TransactionNameNode>::Some(transaction_name)
        } else {
            null
        };
        let k_transaction_transaction_name = KTransactionTransactionNameItem {
            k_transaction,
            transaction_name,
        };
        Option::<KTransactionTransactionNameItem>::Some(k_transaction_transaction_name)
    } else {
        null
    };
    return Result::<CommitStmtNode, ParseError>::Ok(CommitStmtNode {
        span: Span::new(start, p.last_end()),
        k_commit_or_k_end,
        k_transaction_transaction_name,
    });
}

fn parse_compound_select_stmt(p: &mut Parser) -> Result<CompoundSelectStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let select_core = parse_select_core(p)?;
    let mut item_select_core_list: Array<ItemSelectCoreItem> = [];
    let mut _plus_first = true;
    while _plus_first || p.peek_kind() matches { TK_K_UNION | TK_K_INTERSECT | TK_K_EXCEPT } {
        _plus_first = false;
        let mut group_0_inner: Option<CompoundSelectStmtGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_K_UNION {
            let k_union = p.expect(TK_K_UNION, "K_UNION")?;
            let k_all: Option<Token> = if p.peek_kind() == TK_K_ALL {
                let k_all = p.expect(TK_K_ALL, "K_ALL")?;
                Option::<Token>::Some(k_all)
            } else {
                null
            };
            group_0_inner = Option::<CompoundSelectStmtGroup0>::Some(CompoundSelectStmtGroup0::Alt0(CompoundSelectStmtGroup0Alt0 {
                k_union,
                k_all,
            }));
        } else if grp_kind == TK_K_INTERSECT {
            let k_intersect = p.expect(TK_K_INTERSECT, "K_INTERSECT")?;
            group_0_inner = Option::<CompoundSelectStmtGroup0>::Some(CompoundSelectStmtGroup0::Alt1(CompoundSelectStmtGroup0Alt1 {
                k_intersect,
            }));
        } else if grp_kind == TK_K_EXCEPT {
            let k_except = p.expect(TK_K_EXCEPT, "K_EXCEPT")?;
            group_0_inner = Option::<CompoundSelectStmtGroup0>::Some(CompoundSelectStmtGroup0::Alt2(CompoundSelectStmtGroup0Alt2 {
                k_except,
            }));
        }
        let group_0 = group_0_inner;
        let select_core = parse_select_core(p)?;
        let item_select_core = ItemSelectCoreItem {
            group_0,
            select_core,
        };
        item_select_core_list.push(item_select_core);
    }
    let k_order_k_by_ordering_term_item: Option<KOrderKByOrderingTermItemItem> = if p.peek_kind() == TK_K_ORDER && p.peek_at(1) == TK_K_BY {
        let k_order = p.expect(TK_K_ORDER, "K_ORDER")?;
        let k_by = p.expect(TK_K_BY, "K_BY")?;
        let ordering_term = parse_ordering_term(p)?;
        let mut comma_ordering_term_list: Array<CommaOrderingTermItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let ordering_term = parse_ordering_term(p)?;
            let comma_ordering_term = CommaOrderingTermItem {
                comma,
                ordering_term,
            };
            comma_ordering_term_list.push(comma_ordering_term);
        }
        let k_order_k_by_ordering_term_item = KOrderKByOrderingTermItemItem {
            k_order,
            k_by,
            ordering_term,
            comma_ordering_term_list,
        };
        Option::<KOrderKByOrderingTermItemItem>::Some(k_order_k_by_ordering_term_item)
    } else {
        null
    };
    let k_limit_expr_item: Option<KLimitExprItemItem> = if p.peek_kind() == TK_K_LIMIT {
        let k_limit = p.expect(TK_K_LIMIT, "K_LIMIT")?;
        let expr = parse_expr(p)?;
        let item_expr: Option<ItemExprItem> = if p.peek_kind() matches { TK_K_OFFSET | TK_LIT_COMMA } {
            let opt_saved = p.pos;
            let mut opt_result: Option<ItemExprItem> = null;
            opt_bt: {
                let k_offset_or_comma = p.advance();
                let _bt_r = parse_expr(p);
                if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
                let expr = _bt_r.unwrap();
                let item_expr = ItemExprItem {
                    k_offset_or_comma,
                    expr,
                };
                opt_result = Option::<ItemExprItem>::Some(item_expr);
            }
            opt_result
        } else {
            null
        };
        let k_limit_expr_item = KLimitExprItemItem {
            k_limit,
            expr,
            item_expr,
        };
        Option::<KLimitExprItemItem>::Some(k_limit_expr_item)
    } else {
        null
    };
    return Result::<CompoundSelectStmtNode, ParseError>::Ok(CompoundSelectStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        select_core,
        item_select_core_list,
        k_order_k_by_ordering_term_item,
        k_limit_expr_item,
    });
}

fn parse_create_index_stmt(p: &mut Parser) -> Result<CreateIndexStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_create = p.expect(TK_K_CREATE, "K_CREATE")?;
    let k_unique: Option<Token> = if p.peek_kind() == TK_K_UNIQUE {
        let k_unique = p.expect(TK_K_UNIQUE, "K_UNIQUE")?;
        Option::<Token>::Some(k_unique)
    } else {
        null
    };
    let k_index = p.expect(TK_K_INDEX, "K_INDEX")?;
    let k_if_k_not_k_exists: Option<KIfKNotKExistsItem> = if p.peek_kind() == TK_K_IF && p.peek_at(1) == TK_K_NOT && p.peek_at(2) == TK_K_EXISTS {
        let k_if = p.expect(TK_K_IF, "K_IF")?;
        let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        let k_exists = p.expect(TK_K_EXISTS, "K_EXISTS")?;
        let k_if_k_not_k_exists = KIfKNotKExistsItem {
            k_if,
            k_not,
            k_exists,
        };
        Option::<KIfKNotKExistsItem>::Some(k_if_k_not_k_exists)
    } else {
        null
    };
    let database_name_dot: Option<DatabaseNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let opt_saved = p.pos;
        let mut opt_result: Option<DatabaseNameDotItem> = null;
        opt_bt: {
            let _bt_r = parse_database_name(p);
            if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
            let database_name = _bt_r.unwrap();
            let _bt_r_2 = p.expect(TK_LIT_DOT, "'.'");
            if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
            let dot = _bt_r_2.unwrap();
            let database_name_dot = DatabaseNameDotItem {
                database_name,
                dot,
            };
            opt_result = Option::<DatabaseNameDotItem>::Some(database_name_dot);
        }
        opt_result
    } else {
        null
    };
    let index_name = parse_index_name(p)?;
    let k_on = p.expect(TK_K_ON, "K_ON")?;
    let table_name = parse_table_name(p)?;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let indexed_column = parse_indexed_column(p)?;
    let mut comma_indexed_column_list: Array<CommaIndexedColumnItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA, "','")?;
        let indexed_column = parse_indexed_column(p)?;
        let comma_indexed_column = CommaIndexedColumnItem {
            comma,
            indexed_column,
        };
        comma_indexed_column_list.push(comma_indexed_column);
    }
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    let k_where_expr: Option<KWhereExprItem> = if p.peek_kind() == TK_K_WHERE {
        let k_where = p.expect(TK_K_WHERE, "K_WHERE")?;
        let expr = parse_expr(p)?;
        let k_where_expr = KWhereExprItem {
            k_where,
            expr,
        };
        Option::<KWhereExprItem>::Some(k_where_expr)
    } else {
        null
    };
    return Result::<CreateIndexStmtNode, ParseError>::Ok(CreateIndexStmtNode {
        span: Span::new(start, p.last_end()),
        k_create,
        k_unique,
        k_index,
        k_if_k_not_k_exists,
        database_name_dot,
        index_name,
        k_on,
        table_name,
        lparen,
        indexed_column,
        comma_indexed_column_list,
        rparen,
        k_where_expr,
    });
}

fn parse_create_table_stmt(p: &mut Parser) -> Result<CreateTableStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_create = p.expect(TK_K_CREATE, "K_CREATE")?;
    let k_temp_or_k_temporary: Option<Token> = if p.peek_kind() matches { TK_K_TEMP | TK_K_TEMPORARY } {
