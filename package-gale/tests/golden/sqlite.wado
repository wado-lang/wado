pub fn walk_module_argument<V: Visitor>(v: &mut V, node: &ModuleArgumentNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"module_argument", &n.span);
            walk_expr(v, &n.expr);
            v.exit_rule(&"module_argument", &n.span);
