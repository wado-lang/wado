                    let opt_r_2 = parse_insert_stmt(p);
                    if let Err(_) = opt_r_2 { p.pos = saved_pos; break bt_try_2; }
                    update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner = Option::<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup>::Some(UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup::InsertStmt(opt_r_2.unwrap()));
                    bt_done = true;
                }
            }
            if !bt_done {
                bt_try_3: {
                    let opt_r_3 = parse_delete_stmt(p);
                    if let Err(_) = opt_r_3 { p.pos = saved_pos; break bt_try_3; }
                    update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner = Option::<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup>::Some(UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup::DeleteStmt(opt_r_3.unwrap()));
                    bt_done = true;
                }
            }
            if !bt_done {
                let select_stmt = parse_select_stmt(p)?;
                update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner = Option::<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup>::Some(UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup::SelectStmt(select_stmt));
            }
        }
        let update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt = update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner;
        let semicolon = p.expect(TK_LIT_SEMI)?;
        let item_semicolon = ItemSemicolonItem {
            update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt,
            semicolon,
        };
        item_semicolon_list.push(item_semicolon);
    }
    let k_end = p.expect(TK_K_END)?;
    return Result::<CreateTriggerStmtNode, ParseError>::Ok(CreateTriggerStmtNode {
        span: Span::new(start, p.last_end()),
        k_create,
        k_temp_or_k_temporary,
        k_trigger,
        k_if_k_not_k_exists,
        database_name_dot,
        trigger_name,
        group_0,
        group_1,
        k_on,
        database_name_dot_2,
        table_name,
        k_for_k_each_k_row,
        k_when_expr,
        k_begin,
        item_semicolon_list,
        k_end,
    });
}

fn parse_create_view_stmt(p: &mut Parser) -> Result<CreateViewStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_create = p.expect(TK_K_CREATE)?;
    let k_temp_or_k_temporary: Option<Token> = if p.peek_kind() matches { TK_K_TEMP | TK_K_TEMPORARY } {
        let opt_saved = p.pos;
        let mut opt_result: Option<Token> = null;
        opt_bt: {
            let k_temp_or_k_temporary = p.advance();
            opt_result = Option::<Token>::Some(k_temp_or_k_temporary);
        }
        opt_result
    } else {
        null
    };
    let k_view = p.expect(TK_K_VIEW)?;
    let k_if_k_not_k_exists: Option<KIfKNotKExistsItem> = if p.peek_kind() == TK_K_IF && p.peek_at(1) == TK_K_NOT && p.peek_at(2) == TK_K_EXISTS {
        let k_if = p.expect(TK_K_IF)?;
        let k_not = p.expect(TK_K_NOT)?;
        let k_exists = p.expect(TK_K_EXISTS)?;
        let k_if_k_not_k_exists = KIfKNotKExistsItem {
            k_if,
            k_not,
            k_exists,
        };
        Option::<KIfKNotKExistsItem>::Some(k_if_k_not_k_exists)
    } else {
        null
    };
    let database_name_dot: Option<DatabaseNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let opt_saved_2 = p.pos;
        let mut opt_result_2: Option<DatabaseNameDotItem> = null;
        opt_bt_2: {
            let _bt_r = parse_database_name(p);
            if let Err(_) = _bt_r { p.pos = opt_saved_2; break opt_bt_2; }
            let database_name = _bt_r.unwrap();
            let _bt_r_2 = p.expect(TK_LIT_DOT);
            if let Err(_) = _bt_r_2 { p.pos = opt_saved_2; break opt_bt_2; }
            let dot = _bt_r_2.unwrap();
            let database_name_dot = DatabaseNameDotItem {
                database_name,
                dot,
            };
            opt_result_2 = Option::<DatabaseNameDotItem>::Some(database_name_dot);
        }
        opt_result_2
    } else {
        null
    };
    let view_name = parse_view_name(p)?;
    let k_as = p.expect(TK_K_AS)?;
    let select_stmt = parse_select_stmt(p)?;
    return Result::<CreateViewStmtNode, ParseError>::Ok(CreateViewStmtNode {
        span: Span::new(start, p.last_end()),
        k_create,
        k_temp_or_k_temporary,
        k_view,
        k_if_k_not_k_exists,
        database_name_dot,
        view_name,
        k_as,
        select_stmt,
    });
}

fn parse_create_virtual_table_stmt(p: &mut Parser) -> Result<CreateVirtualTableStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_create = p.expect(TK_K_CREATE)?;
    let k_virtual = p.expect(TK_K_VIRTUAL)?;
    let k_table = p.expect(TK_K_TABLE)?;
    let k_if_k_not_k_exists: Option<KIfKNotKExistsItem> = if p.peek_kind() == TK_K_IF && p.peek_at(1) == TK_K_NOT && p.peek_at(2) == TK_K_EXISTS {
        let k_if = p.expect(TK_K_IF)?;
        let k_not = p.expect(TK_K_NOT)?;
        let k_exists = p.expect(TK_K_EXISTS)?;
        let k_if_k_not_k_exists = KIfKNotKExistsItem {
            k_if,
            k_not,
            k_exists,
        };
        Option::<KIfKNotKExistsItem>::Some(k_if_k_not_k_exists)
    } else {
        null
    };
    let database_name_dot: Option<DatabaseNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let opt_saved = p.pos;
        let mut opt_result: Option<DatabaseNameDotItem> = null;
        opt_bt: {
            let _bt_r = parse_database_name(p);
            if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
            let database_name = _bt_r.unwrap();
            let _bt_r_2 = p.expect(TK_LIT_DOT);
            if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
            let dot = _bt_r_2.unwrap();
            let database_name_dot = DatabaseNameDotItem {
                database_name,
                dot,
            };
            opt_result = Option::<DatabaseNameDotItem>::Some(database_name_dot);
        }
        opt_result
    } else {
        null
    };
    let table_name = parse_table_name(p)?;
    let k_using = p.expect(TK_K_USING)?;
    let module_name = parse_module_name(p)?;
    let lparen_module_argument_item_rparen: Option<LparenModuleArgumentItemListRparenItem> = if p.peek_kind() == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let module_argument = parse_module_argument(p)?;
        let mut comma_module_argument_list: Array<CommaModuleArgumentItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let module_argument = parse_module_argument(p)?;
            let comma_module_argument = CommaModuleArgumentItem {
                comma,
                module_argument,
            };
            comma_module_argument_list.push(comma_module_argument);
        }
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let lparen_module_argument_item_rparen = LparenModuleArgumentItemListRparenItem {
            lparen,
            module_argument,
            comma_module_argument_list,
            rparen,
        };
        Option::<LparenModuleArgumentItemListRparenItem>::Some(lparen_module_argument_item_rparen)
    } else {
        null
    };
    return Result::<CreateVirtualTableStmtNode, ParseError>::Ok(CreateVirtualTableStmtNode {
        span: Span::new(start, p.last_end()),
        k_create,
        k_virtual,
        k_table,
        k_if_k_not_k_exists,
        database_name_dot,
        table_name,
        k_using,
        module_name,
        lparen_module_argument_item_rparen,
    });
}

fn parse_delete_stmt(p: &mut Parser) -> Result<DeleteStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let k_delete = p.expect(TK_K_DELETE)?;
    let k_from = p.expect(TK_K_FROM)?;
    let qualified_table_name = parse_qualified_table_name(p)?;
    let k_where_expr: Option<KWhereExprItem> = if p.peek_kind() == TK_K_WHERE {
        let k_where = p.expect(TK_K_WHERE)?;
        let expr = parse_expr(p)?;
        let k_where_expr = KWhereExprItem {
            k_where,
            expr,
        };
        Option::<KWhereExprItem>::Some(k_where_expr)
    } else {
        null
    };
    return Result::<DeleteStmtNode, ParseError>::Ok(DeleteStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        k_delete,
        k_from,
        qualified_table_name,
        k_where_expr,
    });
}

