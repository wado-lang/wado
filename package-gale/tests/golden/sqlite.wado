    if kind == TK_K_CURRENT_TIME { return "K_CURRENT_TIME"; }
    if kind == TK_K_CURRENT_TIMESTAMP { return "K_CURRENT_TIMESTAMP"; }
    if kind == TK_K_DATABASE { return "K_DATABASE"; }
    if kind == TK_K_DEFAULT { return "K_DEFAULT"; }
    if kind == TK_K_DEFERRABLE { return "K_DEFERRABLE"; }
    if kind == TK_K_DEFERRED { return "K_DEFERRED"; }
    if kind == TK_K_DELETE { return "K_DELETE"; }
