    let k_for_k_each_k_row: Option<KForKEachKRowItem> = if p.peek_kind() == TK_K_FOR && p.peek_at(1) == TK_K_EACH && p.peek_at(2) == TK_K_ROW {
        let k_for = p.expect(TK_K_FOR, "K_FOR")?;
