fn try_k_abort(chars: &Array<char>, start: i32) -> i32 {
    let mut pos = start;
    if pos >= chars.len() { return -1; }
    if !(false || chars[pos] == 'a' || chars[pos] == 'A') { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
    if !(false || chars[pos] == 'b' || chars[pos] == 'B') { return -1; }
    pos += 1;
    if pos >= chars.len() { return -1; }
