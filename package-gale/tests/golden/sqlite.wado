fn parse_vacuum_stmt(p: &mut Parser) -> Result<VacuumStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_vacuum = p.expect(TK_K_VACUUM, "K_VACUUM")?;
    return Result::<VacuumStmtNode, ParseError>::Ok(VacuumStmtNode {
        span: Span::new(start, p.last_end()),
        k_vacuum,
    });
}

fn parse_column_def(p: &mut Parser) -> Result<ColumnDefNode, ParseError> {
    let start = p.peek().span.start;
    let column_name = parse_column_name(p)?;
    let type_name: Option<TypeNameNode> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOTNULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
        let type_name = parse_type_name(p)?;
        Option::<TypeNameNode>::Some(type_name)
    } else {
        null
    };
    let mut column_constraint_list: Array<ColumnConstraintNode> = [];
    while p.peek_kind() matches { TK_K_CONSTRAINT | TK_K_PRIMARY | TK_K_NOT | TK_K_NULL | TK_K_UNIQUE | TK_K_CHECK | TK_K_DEFAULT | TK_K_COLLATE | TK_K_REFERENCES } {
        let column_constraint = parse_column_constraint(p)?;
        column_constraint_list.push(column_constraint);
    }
    return Result::<ColumnDefNode, ParseError>::Ok(ColumnDefNode {
        span: Span::new(start, p.last_end()),
        column_name,
        type_name,
        column_constraint_list,
    });
}

fn parse_type_name(p: &mut Parser) -> Result<TypeNameNode, ParseError> {
    let start = p.peek().span.start;
    let name = parse_name(p)?;
    let mut name_list: Array<NameNode> = [name];
    let group_0: Option<TypeNameGroup0> = if p.peek_kind() == TK_LIT_LPAREN {
        let opt_saved = p.pos;
        let mut opt_result: Option<TypeNameGroup0> = null;
        opt_bt: {
            let mut group_0_opt: Option<TypeNameGroup0> = null;
            let grp_kind = p.peek_kind();
            if grp_kind == TK_LIT_LPAREN {
                let saved_pos = p.pos;
                let mut bt_done = false;
                if !bt_done {
                    bt_try: {
                        let _bt_r = p.expect(TK_LIT_LPAREN, "'('");
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                        let lparen = _bt_r.unwrap();
                        let _bt_r_2 = parse_signed_number(p);
                        if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try; }
                        let signed_number = _bt_r_2.unwrap();
                        let _bt_r_3 = p.expect(TK_LIT_RPAREN, "')'");
                        if let Err(_) = _bt_r_3 { p.pos = saved_pos; break bt_try; }
                        let rparen = _bt_r_3.unwrap();
                        group_0_opt = Option::<TypeNameGroup0>::Some(TypeNameGroup0::Alt0(TypeNameGroup0Alt0 {
                            lparen,
                            signed_number,
                            rparen,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
                    let signed_number = parse_signed_number(p)?;
                    let comma = p.expect(TK_LIT_COMMA, "','")?;
                    let signed_number_2 = parse_signed_number(p)?;
                    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
                    group_0_opt = Option::<TypeNameGroup0>::Some(TypeNameGroup0::Alt1(TypeNameGroup0Alt1 {
                        lparen,
                        signed_number,
                        comma,
                        signed_number_2,
                        rparen,
                    }));
                }
            }
            if let None = group_0_opt {
                p.expect(-1, "group alternative")?;
            }
            let group_0 = group_0_opt.unwrap();
            opt_result = Option::<TypeNameGroup0>::Some(group_0);
        }
        opt_result
    } else {
        null
    };
    return Result::<TypeNameNode, ParseError>::Ok(TypeNameNode {
        span: Span::new(start, p.last_end()),
        name_list,
        group_0,
    });
}

fn parse_column_constraint(p: &mut Parser) -> Result<ColumnConstraintNode, ParseError> {
    let start = p.peek().span.start;
    let k_constraint_name: Option<KConstraintNameItem> = if p.peek_kind() == TK_K_CONSTRAINT {
        let k_constraint = p.expect(TK_K_CONSTRAINT, "K_CONSTRAINT")?;
        let name = parse_name(p)?;
        let k_constraint_name = KConstraintNameItem {
            k_constraint,
            name,
        };
        Option::<KConstraintNameItem>::Some(k_constraint_name)
    } else {
        null
    };
    let mut group_0_inner: Option<ColumnConstraintGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_PRIMARY {
        let k_primary = p.expect(TK_K_PRIMARY, "K_PRIMARY")?;
        let k_key = p.expect(TK_K_KEY, "K_KEY")?;
        let k_asc_or_k_desc: Option<Token> = if p.peek_kind() matches { TK_K_ASC | TK_K_DESC } {
            let opt_saved = p.pos;
            let mut opt_result: Option<Token> = null;
            opt_bt: {
                let k_asc_or_k_desc = p.advance();
                opt_result = Option::<Token>::Some(k_asc_or_k_desc);
            }
            opt_result
        } else {
            null
        };
        let conflict_clause = parse_conflict_clause(p)?;
        let k_autoincrement: Option<Token> = if p.peek_kind() == TK_K_AUTOINCREMENT {
            let k_autoincrement = p.expect(TK_K_AUTOINCREMENT, "K_AUTOINCREMENT")?;
            Option::<Token>::Some(k_autoincrement)
        } else {
            null
        };
        group_0_inner = Option::<ColumnConstraintGroup0>::Some(ColumnConstraintGroup0::Alt0(ColumnConstraintGroup0Alt0 {
            k_primary,
            k_key,
            k_asc_or_k_desc,
            conflict_clause,
            k_autoincrement,
        }));
    } else if grp_kind matches { TK_K_NOT | TK_K_NULL } {
        let k_not: Option<Token> = if p.peek_kind() == TK_K_NOT {
            let k_not = p.expect(TK_K_NOT, "K_NOT")?;
            Option::<Token>::Some(k_not)
        } else {
            null
        };
        let k_null = p.expect(TK_K_NULL, "K_NULL")?;
        let conflict_clause = parse_conflict_clause(p)?;
        group_0_inner = Option::<ColumnConstraintGroup0>::Some(ColumnConstraintGroup0::Alt1(ColumnConstraintGroup0Alt1 {
            k_not,
            k_null,
            conflict_clause,
        }));
    } else if grp_kind == TK_K_UNIQUE {
        let k_unique = p.expect(TK_K_UNIQUE, "K_UNIQUE")?;
        let conflict_clause = parse_conflict_clause(p)?;
        group_0_inner = Option::<ColumnConstraintGroup0>::Some(ColumnConstraintGroup0::Alt2(ColumnConstraintGroup0Alt2 {
            k_unique,
            conflict_clause,
        }));
    } else if grp_kind == TK_K_CHECK {
        let k_check = p.expect(TK_K_CHECK, "K_CHECK")?;
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let expr = parse_expr(p)?;
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        group_0_inner = Option::<ColumnConstraintGroup0>::Some(ColumnConstraintGroup0::Alt3(ColumnConstraintGroup0Alt3 {
            k_check,
            lparen,
            expr,
            rparen,
        }));
    } else if grp_kind == TK_K_DEFAULT {
        let k_default = p.expect(TK_K_DEFAULT, "K_DEFAULT")?;
        let mut group_1_inner: Option<ColumnConstraintGroup1> = null;
        let grp_kind = p.peek_kind();
        if grp_kind matches { TK_LIT_PLUS | TK_LIT_MINUS | TK_NUMERIC_LITERAL | TK_STRING_LITERAL | TK_BLOB_LITERAL | TK_K_NULL | TK_K_CURRENT_TIME | TK_K_CURRENT_DATE | TK_K_CURRENT_TIMESTAMP } {
            let saved_pos = p.pos;
            let mut bt_done = false;
            if !bt_done {
                bt_try: {
                    let _bt_r = parse_signed_number(p);
                    if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                    let signed_number = _bt_r.unwrap();
                    group_1_inner = Option::<ColumnConstraintGroup1>::Some(ColumnConstraintGroup1::Alt0(ColumnConstraintGroup1Alt0 {
                        signed_number,
                    }));
                    bt_done = true;
                }
            }
            if !bt_done {
                let literal_value = parse_literal_value(p)?;
                group_1_inner = Option::<ColumnConstraintGroup1>::Some(ColumnConstraintGroup1::Alt1(ColumnConstraintGroup1Alt1 {
                    literal_value,
                }));
            }
        } else if grp_kind == TK_LIT_LPAREN {
            let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
            let expr = parse_expr(p)?;
            let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
            group_1_inner = Option::<ColumnConstraintGroup1>::Some(ColumnConstraintGroup1::Alt2(ColumnConstraintGroup1Alt2 {
                lparen,
                expr,
                rparen,
            }));
        }
        let group_1 = group_1_inner;
        group_0_inner = Option::<ColumnConstraintGroup0>::Some(ColumnConstraintGroup0::Alt4(ColumnConstraintGroup0Alt4 {
            k_default,
            group_1,
        }));
    } else if grp_kind == TK_K_COLLATE {
        let k_collate = p.expect(TK_K_COLLATE, "K_COLLATE")?;
        let collation_name = parse_collation_name(p)?;
        group_0_inner = Option::<ColumnConstraintGroup0>::Some(ColumnConstraintGroup0::Alt5(ColumnConstraintGroup0Alt5 {
            k_collate,
            collation_name,
        }));
    } else if grp_kind == TK_K_REFERENCES {
        let foreign_key_clause = parse_foreign_key_clause(p)?;
        group_0_inner = Option::<ColumnConstraintGroup0>::Some(ColumnConstraintGroup0::Alt6(ColumnConstraintGroup0Alt6 {
            foreign_key_clause,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<ColumnConstraintNode, ParseError>::Ok(ColumnConstraintNode {
        span: Span::new(start, p.last_end()),
        k_constraint_name,
        group_0,
    });
}

fn parse_conflict_clause(p: &mut Parser) -> Result<ConflictClauseNode, ParseError> {
    let start = p.peek().span.start;
    let k_on_k_conflict_item: Option<KOnKConflictItemItem> = if p.peek_kind() == TK_K_ON && p.peek_at(1) == TK_K_CONFLICT {
        let k_on = p.expect(TK_K_ON, "K_ON")?;
        let k_conflict = p.expect(TK_K_CONFLICT, "K_CONFLICT")?;
        let k_rollback_or_k_abort_or_k_fail_or_k_ignore_or_k_replace = p.advance();
        let k_on_k_conflict_item = KOnKConflictItemItem {
            k_on,
            k_conflict,
            k_rollback_or_k_abort_or_k_fail_or_k_ignore_or_k_replace,
        };
        Option::<KOnKConflictItemItem>::Some(k_on_k_conflict_item)
    } else {
        null
    };
    return Result::<ConflictClauseNode, ParseError>::Ok(ConflictClauseNode {
        span: Span::new(start, p.last_end()),
        k_on_k_conflict_item,
    });
}

fn parse_expr_bt_14(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let expr = parse_expr(p)?;
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt14(ExprAlt14 {
        span: Span::new(start, p.last_end()),
        lparen,
        expr,
        rparen,
    }));
}

fn parse_expr_bt_15(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let k_cast = p.expect(TK_K_CAST, "K_CAST")?;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let expr = parse_expr(p)?;
    let k_as = p.expect(TK_K_AS, "K_AS")?;
    let type_name = parse_type_name(p)?;
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt15(ExprAlt15 {
        span: Span::new(start, p.last_end()),
        k_cast,
        lparen,
        expr,
        k_as,
        type_name,
        rparen,
    }));
}

fn parse_expr_bt_22(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let k_case = p.expect(TK_K_CASE, "K_CASE")?;
    let expr: Option<ExprNode> = if p.peek_kind() matches { TK_NUMERIC_LITERAL | TK_STRING_LITERAL | TK_BLOB_LITERAL | TK_K_NULL | TK_K_CURRENT_TIME | TK_K_CURRENT_DATE | TK_K_CURRENT_TIMESTAMP | TK_BIND_PARAMETER | TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE } {
        let expr = parse_expr(p)?;
        Option::<ExprNode>::Some(expr)
    } else {
        null
    };
    let mut k_when_expr_k_then_expr_list: Array<KWhenExprKThenExprItem> = [];
    let mut _plus_first = true;
    while _plus_first || p.peek_kind() == TK_K_WHEN {
        _plus_first = false;
        let k_when = p.expect(TK_K_WHEN, "K_WHEN")?;
        let expr = parse_expr(p)?;
        let k_then = p.expect(TK_K_THEN, "K_THEN")?;
        let expr_2 = parse_expr(p)?;
        let k_when_expr_k_then_expr = KWhenExprKThenExprItem {
            k_when,
            expr,
            k_then,
            expr_2,
        };
        k_when_expr_k_then_expr_list.push(k_when_expr_k_then_expr);
    }
    let k_else_expr: Option<KElseExprItem> = if p.peek_kind() == TK_K_ELSE {
        let k_else = p.expect(TK_K_ELSE, "K_ELSE")?;
        let expr = parse_expr(p)?;
        let k_else_expr = KElseExprItem {
            k_else,
            expr,
        };
        Option::<KElseExprItem>::Some(k_else_expr)
    } else {
        null
    };
    let k_end = p.expect(TK_K_END, "K_END")?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt22(ExprAlt22 {
        span: Span::new(start, p.last_end()),
        k_case,
        expr,
        k_when_expr_k_then_expr_list,
        k_else_expr,
        k_end,
    }));
}

fn parse_expr_bt_21(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let item_k_exists: Option<ItemKExistsItem> = if p.peek_kind() == TK_K_NOT && p.peek_at(1) == TK_K_EXISTS {
        if p.peek_kind() == TK_K_NOT {
            let k_not = p.expect(TK_K_NOT, "K_NOT")?;
        }
        let k_exists = p.expect(TK_K_EXISTS, "K_EXISTS")?;
        let item_k_exists = ItemKExistsItem {
            k_exists,
        };
        Option::<ItemKExistsItem>::Some(item_k_exists)
    } else if p.peek_kind() == TK_K_EXISTS {
        let k_exists = p.expect(TK_K_EXISTS, "K_EXISTS")?;
        let item_k_exists = ItemKExistsItem {
            k_exists,
        };
        Option::<ItemKExistsItem>::Some(item_k_exists)
    } else {
        null
    };
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let select_stmt = parse_select_stmt(p)?;
    let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt21(ExprAlt21 {
        span: Span::new(start, p.last_end()),
        item_k_exists,
        lparen,
        select_stmt,
        rparen,
    }));
}

fn parse_expr_bt_23(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let raise_function = parse_raise_function(p)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt23(ExprAlt23 {
        span: Span::new(start, p.last_end()),
        raise_function,
    }));
}

fn parse_expr_bt_0(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let literal_value = parse_literal_value(p)?;
    return Result::<ExprNode, ParseError>::Ok(ExprNode::Alt0(ExprAlt0 {
        span: Span::new(start, p.last_end()),
        literal_value,
    }));
}

fn parse_expr_bt_13(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let function_name = parse_function_name(p)?;
    let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
    let group_2: Option<ExprGroup2> = if p.peek_kind() matches { TK_K_DISTINCT | TK_NUMERIC_LITERAL | TK_STRING_LITERAL | TK_BLOB_LITERAL | TK_K_NULL | TK_K_CURRENT_TIME | TK_K_CURRENT_DATE | TK_K_CURRENT_TIMESTAMP | TK_BIND_PARAMETER | TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_LIT_LPAREN | TK_LIT_MINUS | TK_LIT_PLUS | TK_LIT_TILDE | TK_LIT_STAR } {
