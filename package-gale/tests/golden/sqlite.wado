        sg_203_done: {
            sg_203: {
                if pos < tokens.len() && tokens[pos].kind == TK_K_NOT {
                    let sp = pos;
                    sg_204_done: {
                        sg_204: {
                            if pos >= tokens.len() || tokens[pos].kind != TK_K_NOT { break sg_204; }
                            pos += 1;
                            break sg_204_done;
                        }
                        pos = -1;
                    }
                    if pos < 0 { pos = sp; }
                }
                if pos >= tokens.len() || tokens[pos].kind != TK_K_EXISTS { break sg_203; }
                pos += 1;
                break sg_203_done;
            }
            pos = -1;
        }
        if pos < 0 { pos = sp; }
    }
    if pos >= tokens.len() || tokens[pos].kind != TK_LIT_LPAREN { return -1; }
    pos += 1;
    return pos;
}

