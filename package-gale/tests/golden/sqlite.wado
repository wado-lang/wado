    if kind == TK_K_BEFORE { return "K_BEFORE"; }
    if kind == TK_K_BEGIN { return "K_BEGIN"; }
    if kind == TK_K_BETWEEN { return "K_BETWEEN"; }
    if kind == TK_K_BY { return "K_BY"; }
