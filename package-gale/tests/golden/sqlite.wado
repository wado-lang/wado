fn parse_factored_select_stmt(p: &mut Parser) -> Result<FactoredSelectStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let select_core = parse_select_core(p)?;
    let mut compound_operator_select_core_list: Array<CompoundOperatorSelectCoreItem> = [];
    while p.peek_kind() matches { TK_K_UNION | TK_K_INTERSECT | TK_K_EXCEPT } {
        let compound_operator = parse_compound_operator(p)?;
        let select_core = parse_select_core(p)?;
        let compound_operator_select_core = CompoundOperatorSelectCoreItem {
            compound_operator,
            select_core,
        };
        compound_operator_select_core_list.push(compound_operator_select_core);
    }
    let k_order_k_by_ordering_term_item: Option<KOrderKByOrderingTermItemItem> = if p.peek_kind() == TK_K_ORDER && p.peek_at(1) == TK_K_BY {
        let k_order = p.expect(TK_K_ORDER, "K_ORDER")?;
        let k_by = p.expect(TK_K_BY, "K_BY")?;
        let ordering_term = parse_ordering_term(p)?;
        let mut comma_ordering_term_list: Array<CommaOrderingTermItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let ordering_term = parse_ordering_term(p)?;
            let comma_ordering_term = CommaOrderingTermItem {
                comma,
                ordering_term,
            };
            comma_ordering_term_list.push(comma_ordering_term);
        }
        let k_order_k_by_ordering_term_item = KOrderKByOrderingTermItemItem {
            k_order,
            k_by,
            ordering_term,
            comma_ordering_term_list,
        };
        Option::<KOrderKByOrderingTermItemItem>::Some(k_order_k_by_ordering_term_item)
    } else {
        null
    };
    let k_limit_expr_item: Option<KLimitExprItemItem> = if p.peek_kind() == TK_K_LIMIT {
        let k_limit = p.expect(TK_K_LIMIT, "K_LIMIT")?;
        let expr = parse_expr(p)?;
        let item_expr: Option<ItemExprItem> = if p.peek_kind() matches { TK_K_OFFSET | TK_LIT_COMMA } {
            let opt_saved = p.pos;
            let mut opt_result: Option<ItemExprItem> = null;
            opt_bt: {
                let k_offset_or_comma = p.advance();
                let _bt_r = parse_expr(p);
                if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
                let expr = _bt_r.unwrap();
                let item_expr = ItemExprItem {
                    k_offset_or_comma,
                    expr,
                };
                opt_result = Option::<ItemExprItem>::Some(item_expr);
            }
            opt_result
        } else {
            null
        };
        let k_limit_expr_item = KLimitExprItemItem {
            k_limit,
            expr,
            item_expr,
        };
        Option::<KLimitExprItemItem>::Some(k_limit_expr_item)
    } else {
        null
    };
    return Result::<FactoredSelectStmtNode, ParseError>::Ok(FactoredSelectStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        select_core,
        compound_operator_select_core_list,
        k_order_k_by_ordering_term_item,
        k_limit_expr_item,
    });
}

fn parse_insert_stmt(p: &mut Parser) -> Result<InsertStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let mut group_0_inner: Option<InsertStmtGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_INSERT {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let _bt_r = p.expect(TK_K_INSERT, "K_INSERT");
                if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                let k_insert = _bt_r.unwrap();
                let _bt_r_2 = p.expect(TK_K_OR, "K_OR");
                if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try; }
                let k_or = _bt_r_2.unwrap();
                let _bt_r_3 = p.expect(TK_K_REPLACE, "K_REPLACE");
                if let Err(_) = _bt_r_3 { p.pos = saved_pos; break bt_try; }
                let k_replace = _bt_r_3.unwrap();
                group_0_inner = Option::<InsertStmtGroup0>::Some(InsertStmtGroup0::Alt2(InsertStmtGroup0Alt2 {
                    k_insert,
                    k_or,
                    k_replace,
                }));
                bt_done = true;
            }
        }
        if !bt_done {
            bt_try_2: {
                let _bt_r = p.expect(TK_K_INSERT, "K_INSERT");
                if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try_2; }
                let k_insert = _bt_r.unwrap();
                let _bt_r_2 = p.expect(TK_K_OR, "K_OR");
                if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try_2; }
                let k_or = _bt_r_2.unwrap();
                let _bt_r_3 = p.expect(TK_K_ROLLBACK, "K_ROLLBACK");
                if let Err(_) = _bt_r_3 { p.pos = saved_pos; break bt_try_2; }
                let k_rollback = _bt_r_3.unwrap();
                group_0_inner = Option::<InsertStmtGroup0>::Some(InsertStmtGroup0::Alt3(InsertStmtGroup0Alt3 {
                    k_insert,
                    k_or,
                    k_rollback,
                }));
                bt_done = true;
            }
        }
        if !bt_done {
            bt_try_3: {
                let _bt_r = p.expect(TK_K_INSERT, "K_INSERT");
                if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try_3; }
                let k_insert = _bt_r.unwrap();
                let _bt_r_2 = p.expect(TK_K_OR, "K_OR");
