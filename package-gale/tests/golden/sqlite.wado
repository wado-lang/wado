        let tok_14 = p.expect(TK_K_FOREIGN, "K_FOREIGN")?;
        let tok_15 = p.expect(TK_K_KEY, "K_KEY")?;
        let tok_16 = p.expect(TK_LIT_LPAREN, "'('")?;
        let tok_17 = parse_column_name(p)?;
        while p.peek_kind() == TK_LIT_COMMA {
            let tok = p.expect(TK_LIT_COMMA, "','")?;
            let tok_2 = parse_column_name(p)?;
        }
        let tok_18 = p.expect(TK_LIT_RPAREN, "')'")?;
        let tok_19 = parse_foreign_key_clause(p)?;
