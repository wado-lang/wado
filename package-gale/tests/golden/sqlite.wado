}

fn parse_any_name(p: &mut Parser) -> Result<AnyNameNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_IDENTIFIER {
        let identifier = p.expect(TK_IDENTIFIER)?;
        return Result::<AnyNameNode, ParseError>::Ok(AnyNameNode::Alt0(AnyNameAlt0 {
            span: Span::new(start, p.last_end()),
            identifier,
        }));
    }
    if kind matches { TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT } {
        let keyword = parse_keyword(p)?;
        return Result::<AnyNameNode, ParseError>::Ok(AnyNameNode::Alt1(AnyNameAlt1 {
            span: Span::new(start, p.last_end()),
            keyword,
        }));
    }
    if kind == TK_STRING_LITERAL {
        let string_literal = p.expect(TK_STRING_LITERAL)?;
        return Result::<AnyNameNode, ParseError>::Ok(AnyNameNode::Alt2(AnyNameAlt2 {
            span: Span::new(start, p.last_end()),
            string_literal,
        }));
    }
    if kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let any_name = parse_any_name(p)?;
        let rparen = p.expect(TK_LIT_RPAREN)?;
        return Result::<AnyNameNode, ParseError>::Ok(AnyNameNode::Alt3(AnyNameAlt3 {
            span: Span::new(start, p.last_end()),
            lparen,
            any_name,
            rparen,
        }));
    }
    return Result::<AnyNameNode, ParseError>::Err(ParseError::new(
        "expected any_name",
        p.peek().span,
        ["TK_IDENTIFIER", "TK_K_ABORT", "TK_K_ACTION", "TK_K_ADD", "TK_K_AFTER", "TK_K_ALL", "TK_K_ALTER", "TK_K_ANALYZE", "TK_K_AND", "TK_K_AS", "TK_K_ASC", "TK_K_ATTACH", "TK_K_AUTOINCREMENT", "TK_K_BEFORE", "TK_K_BEGIN", "TK_K_BETWEEN", "TK_K_BY", "TK_K_CASCADE", "TK_K_CASE", "TK_K_CAST", "TK_K_CHECK", "TK_K_COLLATE", "TK_K_COLUMN", "TK_K_COMMIT", "TK_K_CONFLICT", "TK_K_CONSTRAINT", "TK_K_CREATE", "TK_K_CROSS", "TK_K_CURRENT_DATE", "TK_K_CURRENT_TIME", "TK_K_CURRENT_TIMESTAMP", "TK_K_DATABASE", "TK_K_DEFAULT", "TK_K_DEFERRABLE", "TK_K_DEFERRED", "TK_K_DELETE", "TK_K_DESC", "TK_K_DETACH", "TK_K_DISTINCT", "TK_K_DROP", "TK_K_EACH", "TK_K_ELSE", "TK_K_END", "TK_K_ESCAPE", "TK_K_EXCEPT", "TK_K_EXCLUSIVE", "TK_K_EXISTS", "TK_K_EXPLAIN", "TK_K_FAIL", "TK_K_FOR", "TK_K_FOREIGN", "TK_K_FROM", "TK_K_FULL", "TK_K_GLOB", "TK_K_GROUP", "TK_K_HAVING", "TK_K_IF", "TK_K_IGNORE", "TK_K_IMMEDIATE", "TK_K_IN", "TK_K_INDEX", "TK_K_INDEXED", "TK_K_INITIALLY", "TK_K_INNER", "TK_K_INSERT", "TK_K_INSTEAD", "TK_K_INTERSECT", "TK_K_INTO", "TK_K_IS", "TK_K_ISNULL", "TK_K_JOIN", "TK_K_KEY", "TK_K_LEFT", "TK_K_LIKE", "TK_K_LIMIT", "TK_K_MATCH", "TK_K_NATURAL", "TK_K_NO", "TK_K_NOT", "TK_K_NOTNULL", "TK_K_NULL", "TK_K_OF", "TK_K_OFFSET", "TK_K_ON", "TK_K_OR", "TK_K_ORDER", "TK_K_OUTER", "TK_K_PLAN", "TK_K_PRAGMA", "TK_K_PRIMARY", "TK_K_QUERY", "TK_K_RAISE", "TK_K_RECURSIVE", "TK_K_REFERENCES", "TK_K_REGEXP", "TK_K_REINDEX", "TK_K_RELEASE", "TK_K_RENAME", "TK_K_REPLACE", "TK_K_RESTRICT", "TK_K_RIGHT", "TK_K_ROLLBACK", "TK_K_ROW", "TK_K_SAVEPOINT", "TK_K_SELECT", "TK_K_SET", "TK_K_TABLE", "TK_K_TEMP", "TK_K_TEMPORARY", "TK_K_THEN", "TK_K_TO", "TK_K_TRANSACTION", "TK_K_TRIGGER", "TK_K_UNION", "TK_K_UNIQUE", "TK_K_UPDATE", "TK_K_USING", "TK_K_VACUUM", "TK_K_VALUES", "TK_K_VIEW", "TK_K_VIRTUAL", "TK_K_WHEN", "TK_K_WHERE", "TK_K_WITH", "TK_K_WITHOUT", "TK_STRING_LITERAL", "TK_LIT_LPAREN"],
    ));
}

pub fn parse(input: &String) -> Result<ParseNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_parse(&mut parser);
}

pub fn walk_parse<V: Visitor>(v: &mut V, node: &ParseNode) {
    v.enter_rule(&"parse", &node.span);
    for let item of &node.sql_stmt_list_or_error_list {
        match item {
            SqlStmtList(inner) => {
                walk_sql_stmt_list(v, inner);
            }
            Error(inner) => {
                walk_error(v, inner);
            }
        }
    }
    v.visit_token(&node.eof);
    v.exit_rule(&"parse", &node.span);
}

pub fn walk_error<V: Visitor>(v: &mut V, node: &ErrorNode) {
    v.enter_rule(&"error", &node.span);
    v.visit_token(&node.unexpected_char);
    v.exit_rule(&"error", &node.span);
}

pub fn walk_sql_stmt_list<V: Visitor>(v: &mut V, node: &SqlStmtListNode) {
    v.enter_rule(&"sql_stmt_list", &node.span);
    for let item of &node.semicolon_list {
        v.visit_token(item);
    }
    walk_sql_stmt(v, &node.sql_stmt);
    for let item of &node.semicolon_sql_stmt_list {
        for let item of &item.semicolon_list {
            v.visit_token(item);
        }
        walk_sql_stmt(v, &item.sql_stmt);
    }
    for let item of &node.semicolon_list_2 {
        v.visit_token(item);
    }
    v.exit_rule(&"sql_stmt_list", &node.span);
}

pub fn walk_sql_stmt<V: Visitor>(v: &mut V, node: &SqlStmtNode) {
    v.enter_rule(&"sql_stmt", &node.span);
    if let Some(item) = &node.k_explain_item {
        v.visit_token(&item.k_explain);
        if let Some(item) = &item.k_query_k_plan {
            v.visit_token(&item.k_query);
            v.visit_token(&item.k_plan);
        }
    }
    if let Some(item) = &node.alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt {
        match item {
            AlterTableStmt(inner) => {
                walk_alter_table_stmt(v, inner);
            }
            AnalyzeStmt(inner) => {
                walk_analyze_stmt(v, inner);
            }
            AttachStmt(inner) => {
                walk_attach_stmt(v, inner);
            }
            BeginStmt(inner) => {
                walk_begin_stmt(v, inner);
            }
            CommitStmt(inner) => {
                walk_commit_stmt(v, inner);
            }
            CompoundSelectStmt(inner) => {
                walk_compound_select_stmt(v, inner);
            }
            CreateIndexStmt(inner) => {
                walk_create_index_stmt(v, inner);
            }
            CreateTableStmt(inner) => {
                walk_create_table_stmt(v, inner);
            }
            CreateTriggerStmt(inner) => {
                walk_create_trigger_stmt(v, inner);
            }
            CreateViewStmt(inner) => {
                walk_create_view_stmt(v, inner);
            }
            CreateVirtualTableStmt(inner) => {
                walk_create_virtual_table_stmt(v, inner);
            }
            DeleteStmt(inner) => {
                walk_delete_stmt(v, inner);
            }
            DeleteStmtLimited(inner) => {
                walk_delete_stmt_limited(v, inner);
            }
            DetachStmt(inner) => {
                walk_detach_stmt(v, inner);
            }
            DropIndexStmt(inner) => {
                walk_drop_index_stmt(v, inner);
            }
            DropTableStmt(inner) => {
                walk_drop_table_stmt(v, inner);
            }
            DropTriggerStmt(inner) => {
                walk_drop_trigger_stmt(v, inner);
            }
            DropViewStmt(inner) => {
                walk_drop_view_stmt(v, inner);
            }
            FactoredSelectStmt(inner) => {
                walk_factored_select_stmt(v, inner);
            }
            InsertStmt(inner) => {
                walk_insert_stmt(v, inner);
            }
            PragmaStmt(inner) => {
                walk_pragma_stmt(v, inner);
            }
            ReindexStmt(inner) => {
                walk_reindex_stmt(v, inner);
            }
            ReleaseStmt(inner) => {
                walk_release_stmt(v, inner);
            }
            RollbackStmt(inner) => {
                walk_rollback_stmt(v, inner);
            }
            SavepointStmt(inner) => {
                walk_savepoint_stmt(v, inner);
            }
            SimpleSelectStmt(inner) => {
                walk_simple_select_stmt(v, inner);
            }
            SelectStmt(inner) => {
                walk_select_stmt(v, inner);
            }
            UpdateStmt(inner) => {
                walk_update_stmt(v, inner);
            }
            UpdateStmtLimited(inner) => {
                walk_update_stmt_limited(v, inner);
            }
            VacuumStmt(inner) => {
                walk_vacuum_stmt(v, inner);
            }
        }
    }
    v.exit_rule(&"sql_stmt", &node.span);
}

pub fn walk_alter_table_stmt<V: Visitor>(v: &mut V, node: &AlterTableStmtNode) {
    v.enter_rule(&"alter_table_stmt", &node.span);
    v.visit_token(&node.k_alter);
    v.visit_token(&node.k_table);
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_table_name(v, &node.table_name);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_rename);
                v.visit_token(&inner.k_to);
                walk_new_table_name(v, &inner.new_table_name);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_add);
                if let Some(item) = &inner.k_column {
                    v.visit_token(item);
                }
                walk_column_def(v, &inner.column_def);
            }
        }
    }
    v.exit_rule(&"alter_table_stmt", &node.span);
}

pub fn walk_analyze_stmt<V: Visitor>(v: &mut V, node: &AnalyzeStmtNode) {
    v.enter_rule(&"analyze_stmt", &node.span);
    v.visit_token(&node.k_analyze);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_database_name(v, &inner.database_name);
            }
            Alt1(inner) => {
                walk_table_or_index_name(v, &inner.table_or_index_name);
            }
            Alt2(inner) => {
                walk_database_name(v, &inner.database_name);
                v.visit_token(&inner.dot);
                walk_table_or_index_name(v, &inner.table_or_index_name);
            }
        }
    }
    v.exit_rule(&"analyze_stmt", &node.span);
}

pub fn walk_attach_stmt<V: Visitor>(v: &mut V, node: &AttachStmtNode) {
    v.enter_rule(&"attach_stmt", &node.span);
    v.visit_token(&node.k_attach);
    if let Some(item) = &node.k_database {
        v.visit_token(item);
    }
    walk_expr(v, &node.expr);
    v.visit_token(&node.k_as);
    walk_database_name(v, &node.database_name);
    v.exit_rule(&"attach_stmt", &node.span);
}

pub fn walk_begin_stmt<V: Visitor>(v: &mut V, node: &BeginStmtNode) {
    v.enter_rule(&"begin_stmt", &node.span);
    v.visit_token(&node.k_begin);
    if let Some(item) = &node.k_deferred_or_k_immediate_or_k_exclusive {
        v.visit_token(item);
    }
    if let Some(item) = &node.k_transaction_transaction_name {
        v.visit_token(&item.k_transaction);
        if let Some(item) = &item.transaction_name {
            walk_transaction_name(v, item);
        }
    }
    v.exit_rule(&"begin_stmt", &node.span);
}

pub fn walk_commit_stmt<V: Visitor>(v: &mut V, node: &CommitStmtNode) {
    v.enter_rule(&"commit_stmt", &node.span);
    v.visit_token(&node.k_commit_or_k_end);
    if let Some(item) = &node.k_transaction_transaction_name {
        v.visit_token(&item.k_transaction);
        if let Some(item) = &item.transaction_name {
            walk_transaction_name(v, item);
        }
    }
    v.exit_rule(&"commit_stmt", &node.span);
}

pub fn walk_compound_select_stmt<V: Visitor>(v: &mut V, node: &CompoundSelectStmtNode) {
    v.enter_rule(&"compound_select_stmt", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    walk_select_core(v, &node.select_core);
    for let item of &node.item_select_core_list {
        if let Some(item) = &item.group_0 {
            match item {
                Alt0(inner) => {
                    v.visit_token(&inner.k_union);
                    if let Some(item) = &inner.k_all {
                        v.visit_token(item);
                    }
                }
                Alt1(inner) => {
                    v.visit_token(&inner.k_intersect);
                }
                Alt2(inner) => {
                    v.visit_token(&inner.k_except);
                }
            }
        }
        walk_select_core(v, &item.select_core);
    }
    if let Some(item) = &node.k_order_k_by_ordering_term_item {
        v.visit_token(&item.k_order);
        v.visit_token(&item.k_by);
        walk_ordering_term(v, &item.ordering_term);
        for let item of &item.comma_ordering_term_list {
            v.visit_token(&item.comma);
            walk_ordering_term(v, &item.ordering_term);
        }
    }
    if let Some(item) = &node.k_limit_expr_item {
        v.visit_token(&item.k_limit);
        walk_expr(v, &item.expr);
        if let Some(item) = &item.item_expr {
            v.visit_token(&item.k_offset_or_comma);
            walk_expr(v, &item.expr);
        }
    }
    v.exit_rule(&"compound_select_stmt", &node.span);
}

pub fn walk_create_index_stmt<V: Visitor>(v: &mut V, node: &CreateIndexStmtNode) {
    v.enter_rule(&"create_index_stmt", &node.span);
    v.visit_token(&node.k_create);
    if let Some(item) = &node.k_unique {
        v.visit_token(item);
    }
    v.visit_token(&node.k_index);
    if let Some(item) = &node.k_if_k_not_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_not);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_index_name(v, &node.index_name);
    v.visit_token(&node.k_on);
    walk_table_name(v, &node.table_name);
    v.visit_token(&node.lparen);
    walk_indexed_column(v, &node.indexed_column);
    for let item of &node.comma_indexed_column_list {
        v.visit_token(&item.comma);
        walk_indexed_column(v, &item.indexed_column);
    }
    v.visit_token(&node.rparen);
    if let Some(item) = &node.k_where_expr {
        v.visit_token(&item.k_where);
        walk_expr(v, &item.expr);
    }
    v.exit_rule(&"create_index_stmt", &node.span);
}

pub fn walk_create_table_stmt<V: Visitor>(v: &mut V, node: &CreateTableStmtNode) {
    v.enter_rule(&"create_table_stmt", &node.span);
    v.visit_token(&node.k_create);
    if let Some(item) = &node.k_temp_or_k_temporary {
        v.visit_token(item);
    }
    v.visit_token(&node.k_table);
    if let Some(item) = &node.k_if_k_not_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_not);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_table_name(v, &node.table_name);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.lparen);
                walk_column_def(v, &inner.column_def);
                for let item of &inner.comma_column_def_list {
                    v.visit_token(&item.comma);
                    walk_column_def(v, &item.column_def);
                }
                for let item of &inner.comma_table_constraint_list {
                    v.visit_token(&item.comma);
                    walk_table_constraint(v, &item.table_constraint);
                }
                v.visit_token(&inner.rparen);
                if let Some(item) = &inner.k_without_identifier {
                    v.visit_token(&item.k_without);
                    v.visit_token(&item.identifier);
                }
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_as);
                walk_select_stmt(v, &inner.select_stmt);
            }
        }
    }
    v.exit_rule(&"create_table_stmt", &node.span);
}

pub fn walk_create_trigger_stmt<V: Visitor>(v: &mut V, node: &CreateTriggerStmtNode) {
    v.enter_rule(&"create_trigger_stmt", &node.span);
    v.visit_token(&node.k_create);
    if let Some(item) = &node.k_temp_or_k_temporary {
        v.visit_token(item);
    }
    v.visit_token(&node.k_trigger);
    if let Some(item) = &node.k_if_k_not_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_not);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_trigger_name(v, &node.trigger_name);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_before);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_after);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_instead);
                v.visit_token(&inner.k_of);
            }
        }
    }
    if let Some(item) = &node.group_1 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_delete);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_insert);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_update);
                if let Some(item) = &inner.k_of_column_name_item {
                    v.visit_token(&item.k_of);
                    walk_column_name(v, &item.column_name);
                    for let item of &item.comma_column_name_list {
                        v.visit_token(&item.comma);
                        walk_column_name(v, &item.column_name);
                    }
                }
            }
        }
    }
    v.visit_token(&node.k_on);
    if let Some(item) = &node.database_name_dot_2 {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_table_name(v, &node.table_name);
    if let Some(item) = &node.k_for_k_each_k_row {
        v.visit_token(&item.k_for);
        v.visit_token(&item.k_each);
        v.visit_token(&item.k_row);
    }
    if let Some(item) = &node.k_when_expr {
        v.visit_token(&item.k_when);
        walk_expr(v, &item.expr);
    }
    v.visit_token(&node.k_begin);
    for let item of &node.item_semicolon_list {
        if let Some(item) = &item.update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt {
            match item {
                UpdateStmt(inner) => {
                    walk_update_stmt(v, inner);
                }
                InsertStmt(inner) => {
                    walk_insert_stmt(v, inner);
                }
                DeleteStmt(inner) => {
                    walk_delete_stmt(v, inner);
                }
                SelectStmt(inner) => {
                    walk_select_stmt(v, inner);
                }
            }
        }
        v.visit_token(&item.semicolon);
    }
    v.visit_token(&node.k_end);
    v.exit_rule(&"create_trigger_stmt", &node.span);
}

pub fn walk_create_view_stmt<V: Visitor>(v: &mut V, node: &CreateViewStmtNode) {
    v.enter_rule(&"create_view_stmt", &node.span);
    v.visit_token(&node.k_create);
    if let Some(item) = &node.k_temp_or_k_temporary {
        v.visit_token(item);
    }
    v.visit_token(&node.k_view);
    if let Some(item) = &node.k_if_k_not_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_not);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_view_name(v, &node.view_name);
    v.visit_token(&node.k_as);
    walk_select_stmt(v, &node.select_stmt);
    v.exit_rule(&"create_view_stmt", &node.span);
}

pub fn walk_create_virtual_table_stmt<V: Visitor>(v: &mut V, node: &CreateVirtualTableStmtNode) {
    v.enter_rule(&"create_virtual_table_stmt", &node.span);
    v.visit_token(&node.k_create);
    v.visit_token(&node.k_virtual);
    v.visit_token(&node.k_table);
    if let Some(item) = &node.k_if_k_not_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_not);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_table_name(v, &node.table_name);
    v.visit_token(&node.k_using);
    walk_module_name(v, &node.module_name);
    if let Some(item) = &node.lparen_module_argument_item_rparen {
        v.visit_token(&item.lparen);
        walk_module_argument(v, &item.module_argument);
        for let item of &item.comma_module_argument_list {
            v.visit_token(&item.comma);
            walk_module_argument(v, &item.module_argument);
        }
        v.visit_token(&item.rparen);
    }
    v.exit_rule(&"create_virtual_table_stmt", &node.span);
}

pub fn walk_delete_stmt<V: Visitor>(v: &mut V, node: &DeleteStmtNode) {
    v.enter_rule(&"delete_stmt", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    v.visit_token(&node.k_delete);
    v.visit_token(&node.k_from);
    walk_qualified_table_name(v, &node.qualified_table_name);
    if let Some(item) = &node.k_where_expr {
        v.visit_token(&item.k_where);
        walk_expr(v, &item.expr);
    }
    v.exit_rule(&"delete_stmt", &node.span);
}

pub fn walk_delete_stmt_limited<V: Visitor>(v: &mut V, node: &DeleteStmtLimitedNode) {
    v.enter_rule(&"delete_stmt_limited", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    v.visit_token(&node.k_delete);
    v.visit_token(&node.k_from);
    walk_qualified_table_name(v, &node.qualified_table_name);
    if let Some(item) = &node.k_where_expr {
        v.visit_token(&item.k_where);
        walk_expr(v, &item.expr);
    }
    if let Some(item) = &node.item_k_limit_expr_item {
        if let Some(item) = &item.k_order_k_by_ordering_term_item {
            v.visit_token(&item.k_order);
            v.visit_token(&item.k_by);
            walk_ordering_term(v, &item.ordering_term);
            for let item of &item.comma_ordering_term_list {
                v.visit_token(&item.comma);
                walk_ordering_term(v, &item.ordering_term);
            }
        }
        v.visit_token(&item.k_limit);
        walk_expr(v, &item.expr);
        if let Some(item) = &item.item_expr {
            v.visit_token(&item.k_offset_or_comma);
            walk_expr(v, &item.expr);
        }
    }
    v.exit_rule(&"delete_stmt_limited", &node.span);
}

pub fn walk_detach_stmt<V: Visitor>(v: &mut V, node: &DetachStmtNode) {
    v.enter_rule(&"detach_stmt", &node.span);
    v.visit_token(&node.k_detach);
    if let Some(item) = &node.k_database {
        v.visit_token(item);
    }
    walk_database_name(v, &node.database_name);
    v.exit_rule(&"detach_stmt", &node.span);
}

pub fn walk_drop_index_stmt<V: Visitor>(v: &mut V, node: &DropIndexStmtNode) {
    v.enter_rule(&"drop_index_stmt", &node.span);
    v.visit_token(&node.k_drop);
    v.visit_token(&node.k_index);
    if let Some(item) = &node.k_if_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_index_name(v, &node.index_name);
    v.exit_rule(&"drop_index_stmt", &node.span);
}

pub fn walk_drop_table_stmt<V: Visitor>(v: &mut V, node: &DropTableStmtNode) {
    v.enter_rule(&"drop_table_stmt", &node.span);
    v.visit_token(&node.k_drop);
    v.visit_token(&node.k_table);
    if let Some(item) = &node.k_if_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_table_name(v, &node.table_name);
    v.exit_rule(&"drop_table_stmt", &node.span);
}

pub fn walk_drop_trigger_stmt<V: Visitor>(v: &mut V, node: &DropTriggerStmtNode) {
    v.enter_rule(&"drop_trigger_stmt", &node.span);
    v.visit_token(&node.k_drop);
    v.visit_token(&node.k_trigger);
    if let Some(item) = &node.k_if_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_trigger_name(v, &node.trigger_name);
    v.exit_rule(&"drop_trigger_stmt", &node.span);
}

pub fn walk_drop_view_stmt<V: Visitor>(v: &mut V, node: &DropViewStmtNode) {
    v.enter_rule(&"drop_view_stmt", &node.span);
    v.visit_token(&node.k_drop);
    v.visit_token(&node.k_view);
    if let Some(item) = &node.k_if_k_exists {
        v.visit_token(&item.k_if);
        v.visit_token(&item.k_exists);
    }
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_view_name(v, &node.view_name);
    v.exit_rule(&"drop_view_stmt", &node.span);
}

pub fn walk_factored_select_stmt<V: Visitor>(v: &mut V, node: &FactoredSelectStmtNode) {
    v.enter_rule(&"factored_select_stmt", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    walk_select_core(v, &node.select_core);
    for let item of &node.compound_operator_select_core_list {
        walk_compound_operator(v, &item.compound_operator);
        walk_select_core(v, &item.select_core);
    }
    if let Some(item) = &node.k_order_k_by_ordering_term_item {
        v.visit_token(&item.k_order);
        v.visit_token(&item.k_by);
        walk_ordering_term(v, &item.ordering_term);
        for let item of &item.comma_ordering_term_list {
            v.visit_token(&item.comma);
            walk_ordering_term(v, &item.ordering_term);
        }
    }
    if let Some(item) = &node.k_limit_expr_item {
        v.visit_token(&item.k_limit);
        walk_expr(v, &item.expr);
        if let Some(item) = &item.item_expr {
            v.visit_token(&item.k_offset_or_comma);
            walk_expr(v, &item.expr);
        }
    }
    v.exit_rule(&"factored_select_stmt", &node.span);
}

pub fn walk_insert_stmt<V: Visitor>(v: &mut V, node: &InsertStmtNode) {
    v.enter_rule(&"insert_stmt", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_insert);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_replace);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_insert);
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_replace);
            }
            Alt3(inner) => {
                v.visit_token(&inner.k_insert);
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_rollback);
            }
            Alt4(inner) => {
                v.visit_token(&inner.k_insert);
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_abort);
            }
            Alt5(inner) => {
                v.visit_token(&inner.k_insert);
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_fail);
            }
            Alt6(inner) => {
                v.visit_token(&inner.k_insert);
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_ignore);
            }
        }
    }
    v.visit_token(&node.k_into);
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_table_name(v, &node.table_name);
    if let Some(item) = &node.lparen_column_name_item_rparen {
        v.visit_token(&item.lparen);
        walk_column_name(v, &item.column_name);
        for let item of &item.comma_column_name_list {
            v.visit_token(&item.comma);
            walk_column_name(v, &item.column_name);
        }
        v.visit_token(&item.rparen);
    }
    if let Some(item) = &node.group_1 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_values);
                v.visit_token(&inner.lparen);
                walk_expr(v, &inner.expr);
                for let item of &inner.comma_expr_list {
                    v.visit_token(&item.comma);
                    walk_expr(v, &item.expr);
                }
                v.visit_token(&inner.rparen);
                for let item of &inner.comma_lparen_expr_item_rparen_list {
                    v.visit_token(&item.comma);
                    v.visit_token(&item.lparen);
                    walk_expr(v, &item.expr);
                    for let item of &item.comma_expr_list {
                        v.visit_token(&item.comma);
                        walk_expr(v, &item.expr);
                    }
                    v.visit_token(&item.rparen);
                }
            }
            Alt1(inner) => {
                walk_select_stmt(v, &inner.select_stmt);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_default);
                v.visit_token(&inner.k_values);
            }
        }
    }
    v.exit_rule(&"insert_stmt", &node.span);
}

pub fn walk_pragma_stmt<V: Visitor>(v: &mut V, node: &PragmaStmtNode) {
    v.enter_rule(&"pragma_stmt", &node.span);
    v.visit_token(&node.k_pragma);
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_pragma_name(v, &node.pragma_name);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.eq);
                walk_pragma_value(v, &inner.pragma_value);
            }
            Alt1(inner) => {
                v.visit_token(&inner.lparen);
                walk_pragma_value(v, &inner.pragma_value);
                v.visit_token(&inner.rparen);
            }
        }
    }
    v.exit_rule(&"pragma_stmt", &node.span);
}

pub fn walk_reindex_stmt<V: Visitor>(v: &mut V, node: &ReindexStmtNode) {
    v.enter_rule(&"reindex_stmt", &node.span);
    v.visit_token(&node.k_reindex);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                walk_collation_name(v, &inner.collation_name);
            }
            Alt1(inner) => {
                if let Some(item) = &inner.database_name_dot {
                    walk_database_name(v, &item.database_name);
                    v.visit_token(&item.dot);
                }
                if let Some(item) = &inner.table_name_or_index_name {
                    match item {
                        TableName(inner) => {
                            walk_table_name(v, inner);
                        }
                        IndexName(inner) => {
                            walk_index_name(v, inner);
                        }
                    }
                }
            }
        }
    }
    v.exit_rule(&"reindex_stmt", &node.span);
}

pub fn walk_release_stmt<V: Visitor>(v: &mut V, node: &ReleaseStmtNode) {
    v.enter_rule(&"release_stmt", &node.span);
    v.visit_token(&node.k_release);
    if let Some(item) = &node.k_savepoint {
        v.visit_token(item);
    }
    walk_savepoint_name(v, &node.savepoint_name);
    v.exit_rule(&"release_stmt", &node.span);
}

pub fn walk_rollback_stmt<V: Visitor>(v: &mut V, node: &RollbackStmtNode) {
    v.enter_rule(&"rollback_stmt", &node.span);
    v.visit_token(&node.k_rollback);
    if let Some(item) = &node.k_transaction_transaction_name {
        v.visit_token(&item.k_transaction);
        if let Some(item) = &item.transaction_name {
            walk_transaction_name(v, item);
        }
    }
    if let Some(item) = &node.k_to_k_savepoint_savepoint_name {
        v.visit_token(&item.k_to);
        if let Some(item) = &item.k_savepoint {
            v.visit_token(item);
        }
        walk_savepoint_name(v, &item.savepoint_name);
    }
    v.exit_rule(&"rollback_stmt", &node.span);
}

pub fn walk_savepoint_stmt<V: Visitor>(v: &mut V, node: &SavepointStmtNode) {
    v.enter_rule(&"savepoint_stmt", &node.span);
    v.visit_token(&node.k_savepoint);
    walk_savepoint_name(v, &node.savepoint_name);
    v.exit_rule(&"savepoint_stmt", &node.span);
}

pub fn walk_simple_select_stmt<V: Visitor>(v: &mut V, node: &SimpleSelectStmtNode) {
    v.enter_rule(&"simple_select_stmt", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    walk_select_core(v, &node.select_core);
    if let Some(item) = &node.k_order_k_by_ordering_term_item {
        v.visit_token(&item.k_order);
        v.visit_token(&item.k_by);
        walk_ordering_term(v, &item.ordering_term);
        for let item of &item.comma_ordering_term_list {
            v.visit_token(&item.comma);
            walk_ordering_term(v, &item.ordering_term);
        }
    }
    if let Some(item) = &node.k_limit_expr_item {
        v.visit_token(&item.k_limit);
        walk_expr(v, &item.expr);
        if let Some(item) = &item.item_expr {
            v.visit_token(&item.k_offset_or_comma);
            walk_expr(v, &item.expr);
        }
    }
    v.exit_rule(&"simple_select_stmt", &node.span);
}

pub fn walk_select_stmt<V: Visitor>(v: &mut V, node: &SelectStmtNode) {
    v.enter_rule(&"select_stmt", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    walk_select_or_values(v, &node.select_or_values);
    for let item of &node.compound_operator_select_or_values_list {
        walk_compound_operator(v, &item.compound_operator);
        walk_select_or_values(v, &item.select_or_values);
    }
    if let Some(item) = &node.k_order_k_by_ordering_term_item {
        v.visit_token(&item.k_order);
        v.visit_token(&item.k_by);
        walk_ordering_term(v, &item.ordering_term);
        for let item of &item.comma_ordering_term_list {
            v.visit_token(&item.comma);
            walk_ordering_term(v, &item.ordering_term);
        }
    }
    if let Some(item) = &node.k_limit_expr_item {
        v.visit_token(&item.k_limit);
        walk_expr(v, &item.expr);
        if let Some(item) = &item.item_expr {
            v.visit_token(&item.k_offset_or_comma);
            walk_expr(v, &item.expr);
        }
    }
    v.exit_rule(&"select_stmt", &node.span);
}

pub fn walk_select_or_values<V: Visitor>(v: &mut V, node: &SelectOrValuesNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"select_or_values", &n.span);
            v.visit_token(&n.k_select);
            if let Some(item) = &n.k_distinct_or_k_all {
                v.visit_token(item);
            }
            walk_result_column(v, &n.result_column);
            for let item of &n.comma_result_column_list {
                v.visit_token(&item.comma);
                walk_result_column(v, &item.result_column);
            }
            if let Some(item) = &n.k_from_item {
                v.visit_token(&item.k_from);
                if let Some(item) = &item.group_0 {
                    match item {
                        Alt0(inner) => {
                            walk_table_or_subquery(v, &inner.table_or_subquery);
                            for let item of &inner.comma_table_or_subquery_list {
                                v.visit_token(&item.comma);
                                walk_table_or_subquery(v, &item.table_or_subquery);
                            }
                        }
                        Alt1(inner) => {
                            walk_join_clause(v, &inner.join_clause);
                        }
                    }
                }
            }
            if let Some(item) = &n.k_where_expr {
                v.visit_token(&item.k_where);
                walk_expr(v, &item.expr);
            }
            if let Some(item) = &n.k_group_k_by_expr_item_item {
                v.visit_token(&item.k_group);
                v.visit_token(&item.k_by);
                walk_expr(v, &item.expr);
                for let item of &item.comma_expr_list {
                    v.visit_token(&item.comma);
                    walk_expr(v, &item.expr);
                }
                if let Some(item) = &item.k_having_expr {
                    v.visit_token(&item.k_having);
                    walk_expr(v, &item.expr);
                }
            }
            v.exit_rule(&"select_or_values", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"select_or_values", &n.span);
            v.visit_token(&n.k_values);
            v.visit_token(&n.lparen);
            walk_expr(v, &n.expr);
            for let item of &n.comma_expr_list {
                v.visit_token(&item.comma);
                walk_expr(v, &item.expr);
            }
            v.visit_token(&n.rparen);
            for let item of &n.comma_lparen_expr_item_rparen_list {
                v.visit_token(&item.comma);
                v.visit_token(&item.lparen);
                walk_expr(v, &item.expr);
                for let item of &item.comma_expr_list {
                    v.visit_token(&item.comma);
                    walk_expr(v, &item.expr);
                }
                v.visit_token(&item.rparen);
            }
            v.exit_rule(&"select_or_values", &n.span);
        }
    }
}

pub fn walk_update_stmt<V: Visitor>(v: &mut V, node: &UpdateStmtNode) {
    v.enter_rule(&"update_stmt", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    v.visit_token(&node.k_update);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_rollback);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_abort);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_replace);
            }
            Alt3(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_fail);
            }
            Alt4(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_ignore);
            }
        }
    }
    walk_qualified_table_name(v, &node.qualified_table_name);
    v.visit_token(&node.k_set);
    walk_column_name(v, &node.column_name);
    v.visit_token(&node.eq);
    walk_expr(v, &node.expr);
    for let item of &node.comma_column_name_eq_expr_list {
        v.visit_token(&item.comma);
        walk_column_name(v, &item.column_name);
        v.visit_token(&item.eq);
        walk_expr(v, &item.expr);
    }
    if let Some(item) = &node.k_where_expr {
        v.visit_token(&item.k_where);
        walk_expr(v, &item.expr);
    }
    v.exit_rule(&"update_stmt", &node.span);
}

pub fn walk_update_stmt_limited<V: Visitor>(v: &mut V, node: &UpdateStmtLimitedNode) {
    v.enter_rule(&"update_stmt_limited", &node.span);
    if let Some(item) = &node.with_clause {
        walk_with_clause(v, item);
    }
    v.visit_token(&node.k_update);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_rollback);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_abort);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_replace);
            }
            Alt3(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_fail);
            }
            Alt4(inner) => {
                v.visit_token(&inner.k_or);
                v.visit_token(&inner.k_ignore);
            }
        }
    }
    walk_qualified_table_name(v, &node.qualified_table_name);
    v.visit_token(&node.k_set);
    walk_column_name(v, &node.column_name);
    v.visit_token(&node.eq);
    walk_expr(v, &node.expr);
    for let item of &node.comma_column_name_eq_expr_list {
        v.visit_token(&item.comma);
        walk_column_name(v, &item.column_name);
        v.visit_token(&item.eq);
        walk_expr(v, &item.expr);
    }
    if let Some(item) = &node.k_where_expr {
        v.visit_token(&item.k_where);
        walk_expr(v, &item.expr);
    }
    if let Some(item) = &node.item_k_limit_expr_item {
        if let Some(item) = &item.k_order_k_by_ordering_term_item {
            v.visit_token(&item.k_order);
            v.visit_token(&item.k_by);
            walk_ordering_term(v, &item.ordering_term);
            for let item of &item.comma_ordering_term_list {
                v.visit_token(&item.comma);
                walk_ordering_term(v, &item.ordering_term);
            }
        }
        v.visit_token(&item.k_limit);
        walk_expr(v, &item.expr);
        if let Some(item) = &item.item_expr {
            v.visit_token(&item.k_offset_or_comma);
            walk_expr(v, &item.expr);
        }
    }
    v.exit_rule(&"update_stmt_limited", &node.span);
}

pub fn walk_vacuum_stmt<V: Visitor>(v: &mut V, node: &VacuumStmtNode) {
    v.enter_rule(&"vacuum_stmt", &node.span);
    v.visit_token(&node.k_vacuum);
    v.exit_rule(&"vacuum_stmt", &node.span);
}

pub fn walk_column_def<V: Visitor>(v: &mut V, node: &ColumnDefNode) {
    v.enter_rule(&"column_def", &node.span);
    walk_column_name(v, &node.column_name);
    if let Some(item) = &node.type_name {
        walk_type_name(v, item);
    }
    for let item of &node.column_constraint_list {
        walk_column_constraint(v, item);
    }
    v.exit_rule(&"column_def", &node.span);
}

pub fn walk_type_name<V: Visitor>(v: &mut V, node: &TypeNameNode) {
    v.enter_rule(&"type_name", &node.span);
    for let item of &node.name_list {
        walk_name(v, item);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.lparen);
                walk_signed_number(v, &inner.signed_number);
                v.visit_token(&inner.rparen);
            }
            Alt1(inner) => {
                v.visit_token(&inner.lparen);
                walk_signed_number(v, &inner.signed_number);
                v.visit_token(&inner.comma);
                walk_signed_number(v, &inner.signed_number_2);
                v.visit_token(&inner.rparen);
            }
        }
    }
    v.exit_rule(&"type_name", &node.span);
}

pub fn walk_column_constraint<V: Visitor>(v: &mut V, node: &ColumnConstraintNode) {
    v.enter_rule(&"column_constraint", &node.span);
    if let Some(item) = &node.k_constraint_name {
        v.visit_token(&item.k_constraint);
        walk_name(v, &item.name);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_primary);
                v.visit_token(&inner.k_key);
                if let Some(item) = &inner.k_asc_or_k_desc {
                    v.visit_token(item);
                }
                walk_conflict_clause(v, &inner.conflict_clause);
                if let Some(item) = &inner.k_autoincrement {
                    v.visit_token(item);
                }
            }
            Alt1(inner) => {
                if let Some(item) = &inner.k_not {
                    v.visit_token(item);
                }
                v.visit_token(&inner.k_null);
                walk_conflict_clause(v, &inner.conflict_clause);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_unique);
                walk_conflict_clause(v, &inner.conflict_clause);
            }
            Alt3(inner) => {
                v.visit_token(&inner.k_check);
                v.visit_token(&inner.lparen);
                walk_expr(v, &inner.expr);
                v.visit_token(&inner.rparen);
            }
            Alt4(inner) => {
                v.visit_token(&inner.k_default);
                if let Some(item) = &inner.group_1 {
                    match item {
                        Alt0(inner) => {
                            walk_signed_number(v, &inner.signed_number);
                        }
                        Alt1(inner) => {
                            walk_literal_value(v, &inner.literal_value);
                        }
                        Alt2(inner) => {
                            v.visit_token(&inner.lparen);
                            walk_expr(v, &inner.expr);
                            v.visit_token(&inner.rparen);
                        }
                    }
                }
            }
            Alt5(inner) => {
                v.visit_token(&inner.k_collate);
                walk_collation_name(v, &inner.collation_name);
            }
            Alt6(inner) => {
                walk_foreign_key_clause(v, &inner.foreign_key_clause);
            }
        }
    }
    v.exit_rule(&"column_constraint", &node.span);
}

pub fn walk_conflict_clause<V: Visitor>(v: &mut V, node: &ConflictClauseNode) {
    v.enter_rule(&"conflict_clause", &node.span);
    if let Some(item) = &node.k_on_k_conflict_item {
        v.visit_token(&item.k_on);
        v.visit_token(&item.k_conflict);
        v.visit_token(&item.k_rollback_or_k_abort_or_k_fail_or_k_ignore_or_k_replace);
    }
    v.exit_rule(&"conflict_clause", &node.span);
}

pub fn walk_expr<V: Visitor>(v: &mut V, node: &ExprNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_literal_value(v, &n.literal_value);
            v.exit_rule(&"expr", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"expr", &n.span);
            v.visit_token(&n.bind_parameter);
            v.exit_rule(&"expr", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"expr", &n.span);
            if let Some(item) = &n.item_table_name_dot {
                if let Some(item) = &item.database_name_dot {
                    walk_database_name(v, &item.database_name);
                    v.visit_token(&item.dot);
                }
                walk_table_name(v, &item.table_name);
                v.visit_token(&item.dot);
            }
            walk_column_name(v, &n.column_name);
            v.exit_rule(&"expr", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_unary_operator(v, &n.unary_operator);
            walk_expr(v, &n.expr);
            v.exit_rule(&"expr", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.lit___);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.star_or_slash_or_percent);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.plus_or_minus);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt7(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.lit____or_lit____or_amp_or_pipe);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt8(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.lt_or_lit____or_gt_or_lit___);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt9(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.eq_or_lit____or_lit____or_lit___);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt10(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            if let Some(item) = &n.k_not {
                v.visit_token(item);
            }
            v.visit_token(&n.k_in);
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.lparen);
                        if let Some(item) = &inner.group_1 {
                            match item {
                                Alt0(inner) => {
                                    walk_select_stmt(v, &inner.select_stmt);
                                }
                                Alt1(inner) => {
                                    walk_expr(v, &inner.expr);
                                    for let item of &inner.comma_expr_list {
                                        v.visit_token(&item.comma);
                                        walk_expr(v, &item.expr);
                                    }
                                }
                            }
                        }
                        v.visit_token(&inner.rparen);
                    }
                    Alt1(inner) => {
                        if let Some(item) = &inner.database_name_dot {
                            walk_database_name(v, &item.database_name);
                            v.visit_token(&item.dot);
                        }
                        walk_table_name(v, &inner.table_name);
                    }
                }
            }
            v.exit_rule(&"expr", &n.span);
        }
        Alt11(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.k_and);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt12(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.k_or);
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt13(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_function_name(v, &n.function_name);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.group_2 {
                match item {
                    Alt0(inner) => {
                        if let Some(item) = &inner.k_distinct {
                            v.visit_token(item);
                        }
                        walk_expr(v, &inner.expr);
                        for let item of &inner.comma_expr_list {
                            v.visit_token(&item.comma);
                            walk_expr(v, &item.expr);
                        }
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.star);
                    }
                }
            }
            v.visit_token(&n.rparen);
            v.exit_rule(&"expr", &n.span);
        }
        Alt14(n) => {
            v.enter_rule(&"expr", &n.span);
            v.visit_token(&n.lparen);
            walk_expr(v, &n.expr);
            v.visit_token(&n.rparen);
            v.exit_rule(&"expr", &n.span);
        }
        Alt15(n) => {
            v.enter_rule(&"expr", &n.span);
            v.visit_token(&n.k_cast);
            v.visit_token(&n.lparen);
            walk_expr(v, &n.expr);
            v.visit_token(&n.k_as);
            walk_type_name(v, &n.type_name);
            v.visit_token(&n.rparen);
            v.exit_rule(&"expr", &n.span);
        }
        Alt16(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.k_collate);
            walk_collation_name(v, &n.collation_name);
            v.exit_rule(&"expr", &n.span);
        }
        Alt17(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            if let Some(item) = &n.k_not {
                v.visit_token(item);
            }
            v.visit_token(&n.k_like_or_k_glob_or_k_regexp_or_k_match);
            walk_expr(v, &n.expr_2);
            if let Some(item) = &n.k_escape_expr {
                v.visit_token(&item.k_escape);
                walk_expr(v, &item.expr);
            }
            v.exit_rule(&"expr", &n.span);
        }
        Alt18(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            if let Some(item) = &n.group_3 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.k_isnull);
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.k_notnull);
                    }
                    Alt2(inner) => {
                        v.visit_token(&inner.k_not);
                        v.visit_token(&inner.k_null);
                    }
                }
            }
            v.exit_rule(&"expr", &n.span);
        }
        Alt19(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            v.visit_token(&n.k_is);
            if let Some(item) = &n.k_not {
                v.visit_token(item);
            }
            walk_expr(v, &n.expr_2);
            v.exit_rule(&"expr", &n.span);
        }
        Alt20(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_expr(v, &n.expr);
            if let Some(item) = &n.k_not {
                v.visit_token(item);
            }
            v.visit_token(&n.k_between);
            walk_expr(v, &n.expr_2);
            v.visit_token(&n.k_and);
            walk_expr(v, &n.expr_3);
            v.exit_rule(&"expr", &n.span);
        }
        Alt21(n) => {
            v.enter_rule(&"expr", &n.span);
            if let Some(item) = &n.item_k_exists {
                v.visit_token(&item.k_exists);
            }
            v.visit_token(&n.lparen);
            walk_select_stmt(v, &n.select_stmt);
            v.visit_token(&n.rparen);
            v.exit_rule(&"expr", &n.span);
        }
        Alt22(n) => {
            v.enter_rule(&"expr", &n.span);
            v.visit_token(&n.k_case);
            if let Some(item) = &n.expr {
                walk_expr(v, item);
            }
            for let item of &n.k_when_expr_k_then_expr_list {
                v.visit_token(&item.k_when);
                walk_expr(v, &item.expr);
                v.visit_token(&item.k_then);
                walk_expr(v, &item.expr_2);
            }
            if let Some(item) = &n.k_else_expr {
                v.visit_token(&item.k_else);
                walk_expr(v, &item.expr);
            }
            v.visit_token(&n.k_end);
            v.exit_rule(&"expr", &n.span);
        }
        Alt23(n) => {
            v.enter_rule(&"expr", &n.span);
            walk_raise_function(v, &n.raise_function);
            v.exit_rule(&"expr", &n.span);
        }
    }
}

pub fn walk_foreign_key_clause<V: Visitor>(v: &mut V, node: &ForeignKeyClauseNode) {
    v.enter_rule(&"foreign_key_clause", &node.span);
    v.visit_token(&node.k_references);
    walk_foreign_table(v, &node.foreign_table);
    if let Some(item) = &node.lparen_column_name_item_rparen {
        v.visit_token(&item.lparen);
        walk_column_name(v, &item.column_name);
        for let item of &item.comma_column_name_list {
            v.visit_token(&item.comma);
            walk_column_name(v, &item.column_name);
        }
        v.visit_token(&item.rparen);
    }
    if let Some(item) = &node.k_not_k_deferrable_item {
        if let Some(item) = &item.k_not {
            v.visit_token(item);
        }
        v.visit_token(&item.k_deferrable);
        if let Some(item) = &item.group_2 {
            match item {
                Alt0(inner) => {
                    v.visit_token(&inner.k_initially);
                    v.visit_token(&inner.k_deferred);
                }
                Alt1(inner) => {
                    v.visit_token(&inner.k_initially);
                    v.visit_token(&inner.k_immediate);
                }
            }
        }
    }
    v.exit_rule(&"foreign_key_clause", &node.span);
}

pub fn walk_raise_function<V: Visitor>(v: &mut V, node: &RaiseFunctionNode) {
    v.enter_rule(&"raise_function", &node.span);
    v.visit_token(&node.k_raise);
    v.visit_token(&node.lparen);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_ignore);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_rollback_or_k_abort_or_k_fail);
                v.visit_token(&inner.comma);
                walk_error_message(v, &inner.error_message);
            }
        }
    }
    v.visit_token(&node.rparen);
    v.exit_rule(&"raise_function", &node.span);
}

pub fn walk_indexed_column<V: Visitor>(v: &mut V, node: &IndexedColumnNode) {
    v.enter_rule(&"indexed_column", &node.span);
    walk_column_name(v, &node.column_name);
    if let Some(item) = &node.k_collate_collation_name {
        v.visit_token(&item.k_collate);
        walk_collation_name(v, &item.collation_name);
    }
    if let Some(item) = &node.k_asc_or_k_desc {
        v.visit_token(item);
    }
    v.exit_rule(&"indexed_column", &node.span);
}

pub fn walk_table_constraint<V: Visitor>(v: &mut V, node: &TableConstraintNode) {
    v.enter_rule(&"table_constraint", &node.span);
    if let Some(item) = &node.k_constraint_name {
        v.visit_token(&item.k_constraint);
        walk_name(v, &item.name);
    }
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                if let Some(item) = &inner.group_1 {
                    match item {
                        Alt0(inner) => {
                            v.visit_token(&inner.k_primary);
                            v.visit_token(&inner.k_key);
                        }
                        Alt1(inner) => {
                            v.visit_token(&inner.k_unique);
                        }
                    }
                }
                v.visit_token(&inner.lparen);
                walk_indexed_column(v, &inner.indexed_column);
                for let item of &inner.comma_indexed_column_list {
                    v.visit_token(&item.comma);
                    walk_indexed_column(v, &item.indexed_column);
                }
                v.visit_token(&inner.rparen);
                walk_conflict_clause(v, &inner.conflict_clause);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_check);
                v.visit_token(&inner.lparen);
                walk_expr(v, &inner.expr);
                v.visit_token(&inner.rparen);
            }
            Alt2(inner) => {
                v.visit_token(&inner.k_foreign);
                v.visit_token(&inner.k_key);
                v.visit_token(&inner.lparen);
                walk_column_name(v, &inner.column_name);
                for let item of &inner.comma_column_name_list {
                    v.visit_token(&item.comma);
                    walk_column_name(v, &item.column_name);
                }
                v.visit_token(&inner.rparen);
                walk_foreign_key_clause(v, &inner.foreign_key_clause);
            }
        }
    }
    v.exit_rule(&"table_constraint", &node.span);
}

pub fn walk_with_clause<V: Visitor>(v: &mut V, node: &WithClauseNode) {
    v.enter_rule(&"with_clause", &node.span);
    v.visit_token(&node.k_with);
    if let Some(item) = &node.k_recursive {
        v.visit_token(item);
    }
    walk_common_table_expression(v, &node.common_table_expression);
    for let item of &node.comma_common_table_expression_list {
        v.visit_token(&item.comma);
        walk_common_table_expression(v, &item.common_table_expression);
    }
    v.exit_rule(&"with_clause", &node.span);
}

pub fn walk_qualified_table_name<V: Visitor>(v: &mut V, node: &QualifiedTableNameNode) {
    v.enter_rule(&"qualified_table_name", &node.span);
    if let Some(item) = &node.database_name_dot {
        walk_database_name(v, &item.database_name);
        v.visit_token(&item.dot);
    }
    walk_table_name(v, &node.table_name);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_indexed);
                v.visit_token(&inner.k_by);
                walk_index_name(v, &inner.index_name);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_not);
                v.visit_token(&inner.k_indexed);
            }
        }
    }
    v.exit_rule(&"qualified_table_name", &node.span);
}

pub fn walk_ordering_term<V: Visitor>(v: &mut V, node: &OrderingTermNode) {
    v.enter_rule(&"ordering_term", &node.span);
    walk_expr(v, &node.expr);
    if let Some(item) = &node.k_collate_collation_name {
        v.visit_token(&item.k_collate);
        walk_collation_name(v, &item.collation_name);
    }
    if let Some(item) = &node.k_asc_or_k_desc {
        v.visit_token(item);
    }
    v.exit_rule(&"ordering_term", &node.span);
}

pub fn walk_pragma_value<V: Visitor>(v: &mut V, node: &PragmaValueNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"pragma_value", &n.span);
            walk_signed_number(v, &n.signed_number);
            v.exit_rule(&"pragma_value", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"pragma_value", &n.span);
            walk_name(v, &n.name);
            v.exit_rule(&"pragma_value", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"pragma_value", &n.span);
            v.visit_token(&n.string_literal);
            v.exit_rule(&"pragma_value", &n.span);
        }
    }
}

pub fn walk_common_table_expression<V: Visitor>(v: &mut V, node: &CommonTableExpressionNode) {
    v.enter_rule(&"common_table_expression", &node.span);
    walk_table_name(v, &node.table_name);
    if let Some(item) = &node.lparen_column_name_item_rparen {
        v.visit_token(&item.lparen);
        walk_column_name(v, &item.column_name);
        for let item of &item.comma_column_name_list {
            v.visit_token(&item.comma);
            walk_column_name(v, &item.column_name);
        }
        v.visit_token(&item.rparen);
    }
    v.visit_token(&node.k_as);
    v.visit_token(&node.lparen);
    walk_select_stmt(v, &node.select_stmt);
    v.visit_token(&node.rparen);
    v.exit_rule(&"common_table_expression", &node.span);
}

pub fn walk_result_column<V: Visitor>(v: &mut V, node: &ResultColumnNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"result_column", &n.span);
            v.visit_token(&n.star);
            v.exit_rule(&"result_column", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"result_column", &n.span);
            walk_table_name(v, &n.table_name);
            v.visit_token(&n.dot);
            v.visit_token(&n.star);
            v.exit_rule(&"result_column", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"result_column", &n.span);
            walk_expr(v, &n.expr);
            if let Some(item) = &n.k_as_column_alias {
                if let Some(item) = &item.k_as {
                    v.visit_token(item);
                }
                walk_column_alias(v, &item.column_alias);
            }
            v.exit_rule(&"result_column", &n.span);
        }
    }
}

pub fn walk_table_or_subquery<V: Visitor>(v: &mut V, node: &TableOrSubqueryNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"table_or_subquery", &n.span);
            if let Some(item) = &n.schema_name_dot {
                walk_schema_name(v, &item.schema_name);
                v.visit_token(&item.dot);
            }
            walk_table_name(v, &n.table_name);
            if let Some(item) = &n.k_as_table_alias {
                if let Some(item) = &item.k_as {
                    v.visit_token(item);
                }
                walk_table_alias(v, &item.table_alias);
            }
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.k_indexed);
                        v.visit_token(&inner.k_by);
                        walk_index_name(v, &inner.index_name);
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.k_not);
                        v.visit_token(&inner.k_indexed);
                    }
                }
            }
            v.exit_rule(&"table_or_subquery", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"table_or_subquery", &n.span);
            if let Some(item) = &n.schema_name_dot {
                walk_schema_name(v, &item.schema_name);
                v.visit_token(&item.dot);
            }
            walk_table_function_name(v, &n.table_function_name);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.expr_item {
                walk_expr(v, &item.expr);
                for let item of &item.comma_expr_list {
                    v.visit_token(&item.comma);
                    walk_expr(v, &item.expr);
                }
            }
            v.visit_token(&n.rparen);
            if let Some(item) = &n.k_as_table_alias {
                if let Some(item) = &item.k_as {
                    v.visit_token(item);
                }
                walk_table_alias(v, &item.table_alias);
            }
            v.exit_rule(&"table_or_subquery", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"table_or_subquery", &n.span);
            v.visit_token(&n.lparen);
            if let Some(item) = &n.group_1 {
                match item {
                    Alt0(inner) => {
                        walk_table_or_subquery(v, &inner.table_or_subquery);
                        for let item of &inner.comma_table_or_subquery_list {
                            v.visit_token(&item.comma);
                            walk_table_or_subquery(v, &item.table_or_subquery);
                        }
                    }
                    Alt1(inner) => {
                        walk_join_clause(v, &inner.join_clause);
                    }
                }
            }
            v.visit_token(&n.rparen);
            v.exit_rule(&"table_or_subquery", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"table_or_subquery", &n.span);
            v.visit_token(&n.lparen);
            walk_select_stmt(v, &n.select_stmt);
            v.visit_token(&n.rparen);
            if let Some(item) = &n.k_as_table_alias {
                if let Some(item) = &item.k_as {
                    v.visit_token(item);
                }
                walk_table_alias(v, &item.table_alias);
            }
            v.exit_rule(&"table_or_subquery", &n.span);
        }
    }
}

pub fn walk_join_clause<V: Visitor>(v: &mut V, node: &JoinClauseNode) {
    v.enter_rule(&"join_clause", &node.span);
    walk_table_or_subquery(v, &node.table_or_subquery);
    for let item of &node.join_operator_table_or_subquery_join_constraint_list {
        walk_join_operator(v, &item.join_operator);
        walk_table_or_subquery(v, &item.table_or_subquery);
        walk_join_constraint(v, &item.join_constraint);
    }
    v.exit_rule(&"join_clause", &node.span);
}

pub fn walk_join_operator<V: Visitor>(v: &mut V, node: &JoinOperatorNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"join_operator", &n.span);
            v.visit_token(&n.comma);
            v.exit_rule(&"join_operator", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"join_operator", &n.span);
            if let Some(item) = &n.k_natural {
                v.visit_token(item);
            }
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.k_left);
                        if let Some(item) = &inner.k_outer {
                            v.visit_token(item);
                        }
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.k_inner);
                    }
                    Alt2(inner) => {
                        v.visit_token(&inner.k_cross);
                    }
                }
            }
            v.visit_token(&n.k_join);
            v.exit_rule(&"join_operator", &n.span);
        }
    }
}

pub fn walk_join_constraint<V: Visitor>(v: &mut V, node: &JoinConstraintNode) {
    v.enter_rule(&"join_constraint", &node.span);
    if let Some(item) = &node.group_0 {
        match item {
            Alt0(inner) => {
                v.visit_token(&inner.k_on);
                walk_expr(v, &inner.expr);
            }
            Alt1(inner) => {
                v.visit_token(&inner.k_using);
                v.visit_token(&inner.lparen);
                walk_column_name(v, &inner.column_name);
                for let item of &inner.comma_column_name_list {
                    v.visit_token(&item.comma);
                    walk_column_name(v, &item.column_name);
                }
                v.visit_token(&inner.rparen);
            }
        }
    }
    v.exit_rule(&"join_constraint", &node.span);
}

pub fn walk_select_core<V: Visitor>(v: &mut V, node: &SelectCoreNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"select_core", &n.span);
            v.visit_token(&n.k_select);
            if let Some(item) = &n.k_distinct_or_k_all {
                v.visit_token(item);
            }
            walk_result_column(v, &n.result_column);
            for let item of &n.comma_result_column_list {
                v.visit_token(&item.comma);
                walk_result_column(v, &item.result_column);
            }
            if let Some(item) = &n.k_from_item {
                v.visit_token(&item.k_from);
                if let Some(item) = &item.group_0 {
                    match item {
                        Alt0(inner) => {
                            walk_table_or_subquery(v, &inner.table_or_subquery);
                            for let item of &inner.comma_table_or_subquery_list {
                                v.visit_token(&item.comma);
                                walk_table_or_subquery(v, &item.table_or_subquery);
                            }
                        }
                        Alt1(inner) => {
                            walk_join_clause(v, &inner.join_clause);
                        }
                    }
                }
            }
            if let Some(item) = &n.k_where_expr {
                v.visit_token(&item.k_where);
                walk_expr(v, &item.expr);
            }
            if let Some(item) = &n.k_group_k_by_expr_item_item {
                v.visit_token(&item.k_group);
                v.visit_token(&item.k_by);
                walk_expr(v, &item.expr);
                for let item of &item.comma_expr_list {
                    v.visit_token(&item.comma);
                    walk_expr(v, &item.expr);
                }
                if let Some(item) = &item.k_having_expr {
                    v.visit_token(&item.k_having);
                    walk_expr(v, &item.expr);
                }
            }
            v.exit_rule(&"select_core", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"select_core", &n.span);
            v.visit_token(&n.k_values);
            v.visit_token(&n.lparen);
            walk_expr(v, &n.expr);
            for let item of &n.comma_expr_list {
                v.visit_token(&item.comma);
                walk_expr(v, &item.expr);
            }
            v.visit_token(&n.rparen);
            for let item of &n.comma_lparen_expr_item_rparen_list {
                v.visit_token(&item.comma);
                v.visit_token(&item.lparen);
                walk_expr(v, &item.expr);
                for let item of &item.comma_expr_list {
                    v.visit_token(&item.comma);
                    walk_expr(v, &item.expr);
                }
                v.visit_token(&item.rparen);
            }
            v.exit_rule(&"select_core", &n.span);
        }
    }
}

pub fn walk_compound_operator<V: Visitor>(v: &mut V, node: &CompoundOperatorNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"compound_operator", &n.span);
            v.visit_token(&n.k_union);
            v.exit_rule(&"compound_operator", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"compound_operator", &n.span);
            v.visit_token(&n.k_union);
            v.visit_token(&n.k_all);
            v.exit_rule(&"compound_operator", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"compound_operator", &n.span);
            v.visit_token(&n.k_intersect);
            v.exit_rule(&"compound_operator", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"compound_operator", &n.span);
            v.visit_token(&n.k_except);
            v.exit_rule(&"compound_operator", &n.span);
        }
    }
}

pub fn walk_signed_number<V: Visitor>(v: &mut V, node: &SignedNumberNode) {
    v.enter_rule(&"signed_number", &node.span);
    if let Some(item) = &node.plus_or_minus {
        v.visit_token(item);
    }
    v.visit_token(&node.numeric_literal);
    v.exit_rule(&"signed_number", &node.span);
}

pub fn walk_literal_value<V: Visitor>(v: &mut V, node: &LiteralValueNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"literal_value", &n.span);
            v.visit_token(&n.numeric_literal);
            v.exit_rule(&"literal_value", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"literal_value", &n.span);
            v.visit_token(&n.string_literal);
            v.exit_rule(&"literal_value", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"literal_value", &n.span);
            v.visit_token(&n.blob_literal);
            v.exit_rule(&"literal_value", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"literal_value", &n.span);
            v.visit_token(&n.k_null);
            v.exit_rule(&"literal_value", &n.span);
        }
        Alt4(n) => {
            v.enter_rule(&"literal_value", &n.span);
            v.visit_token(&n.k_current_time);
            v.exit_rule(&"literal_value", &n.span);
        }
        Alt5(n) => {
            v.enter_rule(&"literal_value", &n.span);
            v.visit_token(&n.k_current_date);
            v.exit_rule(&"literal_value", &n.span);
        }
        Alt6(n) => {
            v.enter_rule(&"literal_value", &n.span);
            v.visit_token(&n.k_current_timestamp);
            v.exit_rule(&"literal_value", &n.span);
        }
    }
}

pub fn walk_unary_operator<V: Visitor>(v: &mut V, node: &UnaryOperatorNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"unary_operator", &n.span);
            v.visit_token(&n.minus);
            v.exit_rule(&"unary_operator", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"unary_operator", &n.span);
            v.visit_token(&n.plus);
            v.exit_rule(&"unary_operator", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"unary_operator", &n.span);
            v.visit_token(&n.tilde);
            v.exit_rule(&"unary_operator", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"unary_operator", &n.span);
            v.visit_token(&n.k_not);
            v.exit_rule(&"unary_operator", &n.span);
        }
    }
}

pub fn walk_error_message<V: Visitor>(v: &mut V, node: &ErrorMessageNode) {
    v.enter_rule(&"error_message", &node.span);
    v.visit_token(&node.string_literal);
    v.exit_rule(&"error_message", &node.span);
}

pub fn walk_module_argument<V: Visitor>(v: &mut V, node: &ModuleArgumentNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"module_argument", &n.span);
            walk_expr(v, &n.expr);
            v.exit_rule(&"module_argument", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"module_argument", &n.span);
            walk_column_def(v, &n.column_def);
            v.exit_rule(&"module_argument", &n.span);
        }
    }
}

pub fn walk_column_alias<V: Visitor>(v: &mut V, node: &ColumnAliasNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"column_alias", &n.span);
            v.visit_token(&n.identifier);
            v.exit_rule(&"column_alias", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"column_alias", &n.span);
            v.visit_token(&n.string_literal);
            v.exit_rule(&"column_alias", &n.span);
        }
    }
}

