        let k_update = p.expect(TK_K_UPDATE, "K_UPDATE")?;
        let k_of_column_name_item: Option<KOfColumnNameItemItem> = if p.peek_kind() == TK_K_OF {
            let k_of = p.expect(TK_K_OF, "K_OF")?;
            let column_name = parse_column_name(p)?;
            let mut comma_column_name_list: Array<CommaColumnNameItem> = [];
