                    let opt_r_2 = parse_insert_stmt(p);
                    if let Err(_) = opt_r_2 { p.pos = saved_pos; break bt_try_2; }
                    update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner = Option::<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup>::Some(UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup::InsertStmt(opt_r_2.unwrap()));
                    bt_done = true;
                }
            }
            if !bt_done {
                bt_try_3: {
                    let opt_r_3 = parse_delete_stmt(p);
                    if let Err(_) = opt_r_3 { p.pos = saved_pos; break bt_try_3; }
                    update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner = Option::<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup>::Some(UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup::DeleteStmt(opt_r_3.unwrap()));
                    bt_done = true;
                }
            }
            if !bt_done {
                let select_stmt = parse_select_stmt(p)?;
                update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner = Option::<UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup>::Some(UpdateStmtOrInsertStmtOrDeleteStmtOrSelectStmtGroup::SelectStmt(select_stmt));
            }
        }
        let update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt = update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt_inner;
        let semicolon = p.expect(TK_LIT_SEMI, "';'")?;
        let item_semicolon = ItemSemicolonItem {
            update_stmt_or_insert_stmt_or_delete_stmt_or_select_stmt,
            semicolon,
        };
        item_semicolon_list.push(item_semicolon);
    }
    let k_end = p.expect(TK_K_END, "K_END")?;
    return Result::<CreateTriggerStmtNode, ParseError>::Ok(CreateTriggerStmtNode {
        span: Span::new(start, p.last_end()),
        k_create,
        k_temp_or_k_temporary,
        k_trigger,
        k_if_k_not_k_exists,
        database_name_dot,
        trigger_name,
        group_0,
        group_1,
        k_on,
        database_name_dot_2,
        table_name,
        k_for_k_each_k_row,
        k_when_expr,
        k_begin,
        item_semicolon_list,
        k_end,
    });
}

