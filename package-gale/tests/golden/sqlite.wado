pub fn walk_name<V: Visitor>(v: &mut V, node: &NameNode) {
    v.enter_rule(&"name", &node.span);
    walk_any_name(v, &node.any_name);
    v.exit_rule(&"name", &node.span);
}

pub fn walk_function_name<V: Visitor>(v: &mut V, node: &FunctionNameNode) {
    v.enter_rule(&"function_name", &node.span);
