    let table_name = parse_table_name(p)?;
    let mut group_0_inner: Option<CreateTableStmtGroup0> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_LIT_LPAREN {
        let lparen = p.expect(TK_LIT_LPAREN, "'('")?;
        let column_def = parse_column_def(p)?;
        let mut comma_column_def_list: Array<CommaColumnDefItem> = [];
        while (p.peek_kind() == TK_LIT_COMMA) && (p.peek_at(1) matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN }) {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let column_def = parse_column_def(p)?;
            let comma_column_def = CommaColumnDefItem {
                comma,
                column_def,
            };
            comma_column_def_list.push(comma_column_def);
        }
        let mut comma_table_constraint_list: Array<CommaTableConstraintItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA, "','")?;
            let table_constraint = parse_table_constraint(p)?;
            let comma_table_constraint = CommaTableConstraintItem {
                comma,
                table_constraint,
            };
            comma_table_constraint_list.push(comma_table_constraint);
        }
        let rparen = p.expect(TK_LIT_RPAREN, "')'")?;
        let k_without_identifier: Option<KWithoutIdentifierItem> = if p.peek_kind() == TK_K_WITHOUT && p.peek_at(1) == TK_IDENTIFIER {
            let k_without = p.expect(TK_K_WITHOUT, "K_WITHOUT")?;
            let identifier = p.expect(TK_IDENTIFIER, "IDENTIFIER")?;
            let k_without_identifier = KWithoutIdentifierItem {
                k_without,
                identifier,
            };
            Option::<KWithoutIdentifierItem>::Some(k_without_identifier)
        } else {
            null
        };
        group_0_inner = Option::<CreateTableStmtGroup0>::Some(CreateTableStmtGroup0::Alt0(CreateTableStmtGroup0Alt0 {
            lparen,
            column_def,
            comma_column_def_list,
            comma_table_constraint_list,
            rparen,
            k_without_identifier,
        }));
    } else if grp_kind == TK_K_AS {
        let k_as = p.expect(TK_K_AS, "K_AS")?;
        let select_stmt = parse_select_stmt(p)?;
        group_0_inner = Option::<CreateTableStmtGroup0>::Some(CreateTableStmtGroup0::Alt1(CreateTableStmtGroup0Alt1 {
            k_as,
            select_stmt,
        }));
    }
    let group_0 = group_0_inner;
    return Result::<CreateTableStmtNode, ParseError>::Ok(CreateTableStmtNode {
        span: Span::new(start, p.last_end()),
        k_create,
        k_temp_or_k_temporary,
        k_table,
        k_if_k_not_k_exists,
        database_name_dot,
        table_name,
        group_0,
    });
}

