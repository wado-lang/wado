        }
        let k_exists = p.expect(TK_K_EXISTS)?;
        let item_k_exists = ItemOptKExistsItem {
            k_exists,
        };
        Option::<ItemOptKExistsItem>::Some(item_k_exists)
    } else if p.peek_kind() == TK_K_EXISTS {
        let k_exists = p.expect(TK_K_EXISTS)?;
        let item_k_exists = ItemOptKExistsItem {
            k_exists,
        };
        Option::<ItemOptKExistsItem>::Some(item_k_exists)
