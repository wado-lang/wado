                    let database_name_dot: Option<DatabaseNameDotItem> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
                        let opt_saved = p.pos;
                        let mut opt_result: Option<DatabaseNameDotItem> = null;
                        opt_bt: {
                            let _bt_r = parse_database_name(p);
                            if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
                            let database_name = _bt_r.unwrap();
                            let _bt_r_2 = p.expect(TK_LIT_DOT);
                            if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
                            let dot = _bt_r_2.unwrap();
                            let database_name_dot = DatabaseNameDotItem {
                                database_name,
                                dot,
                            };
                            opt_result = Option::<DatabaseNameDotItem>::Some(database_name_dot);
                        }
                        opt_result
                    } else {
                        null
                    };
                    let mut table_name_or_index_name_inner: Option<TableNameOrIndexNameGroup> = null;
                    let grp_kind = p.peek_kind();
                    if grp_kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
                        let saved_pos = p.pos;
                        let mut bt_done = false;
                        if !bt_done {
                            bt_try: {
                                let opt_r = parse_table_name(p);
                                if let Err(_) = opt_r { p.pos = saved_pos; break bt_try; }
                                table_name_or_index_name_inner = Option::<TableNameOrIndexNameGroup>::Some(TableNameOrIndexNameGroup::TableName(opt_r.unwrap()));
                                bt_done = true;
                            }
                        }
                        if !bt_done {
                            let index_name = parse_index_name(p)?;
                            table_name_or_index_name_inner = Option::<TableNameOrIndexNameGroup>::Some(TableNameOrIndexNameGroup::IndexName(index_name));
                        }
                    }
                    let table_name_or_index_name = table_name_or_index_name_inner;
                    group_0_opt = Option::<ReindexStmtGroup0>::Some(ReindexStmtGroup0::Alt1(ReindexStmtGroup0Alt1 {
                        database_name_dot,
                        table_name_or_index_name,
                    }));
                }
            }
            if let None = group_0_opt {
                p.fail("group alternative")?;
            }
            let group_0 = group_0_opt.unwrap();
            opt_result = Option::<ReindexStmtGroup0>::Some(group_0);
        }
        opt_result
    } else {
        null
    };
    return Result::<ReindexStmtNode, ParseError>::Ok(ReindexStmtNode {
        span: Span::new(start, p.last_end()),
        k_reindex,
        group_0,
    });
}

fn parse_release_stmt(p: &mut Parser) -> Result<ReleaseStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_release = p.expect(TK_K_RELEASE)?;
    let k_savepoint: Option<Token> = if p.peek_kind() == TK_K_SAVEPOINT {
        let k_savepoint = p.expect(TK_K_SAVEPOINT)?;
        Option::<Token>::Some(k_savepoint)
    } else {
        null
    };
    let savepoint_name = parse_savepoint_name(p)?;
    return Result::<ReleaseStmtNode, ParseError>::Ok(ReleaseStmtNode {
        span: Span::new(start, p.last_end()),
        k_release,
        k_savepoint,
        savepoint_name,
    });
}

fn parse_rollback_stmt(p: &mut Parser) -> Result<RollbackStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_rollback = p.expect(TK_K_ROLLBACK)?;
    let k_transaction_transaction_name: Option<KTransactionTransactionNameOptItem> = if p.peek_kind() == TK_K_TRANSACTION {
        let k_transaction = p.expect(TK_K_TRANSACTION)?;
        let transaction_name: Option<TransactionNameNode> = if p.peek_kind() matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
            let transaction_name = parse_transaction_name(p)?;
            Option::<TransactionNameNode>::Some(transaction_name)
        } else {
            null
        };
        let k_transaction_transaction_name = KTransactionTransactionNameOptItem {
            k_transaction,
            transaction_name,
        };
        Option::<KTransactionTransactionNameOptItem>::Some(k_transaction_transaction_name)
    } else {
        null
    };
    let k_to_k_savepoint_savepoint_name: Option<KToKSavepointOptSavepointNameItem> = if p.peek_kind() == TK_K_TO {
        let k_to = p.expect(TK_K_TO)?;
        let k_savepoint: Option<Token> = if p.peek_kind() == TK_K_SAVEPOINT {
            let k_savepoint = p.expect(TK_K_SAVEPOINT)?;
            Option::<Token>::Some(k_savepoint)
        } else {
            null
        };
        let savepoint_name = parse_savepoint_name(p)?;
        let k_to_k_savepoint_savepoint_name = KToKSavepointOptSavepointNameItem {
            k_to,
            k_savepoint,
            savepoint_name,
        };
        Option::<KToKSavepointOptSavepointNameItem>::Some(k_to_k_savepoint_savepoint_name)
    } else {
        null
    };
    return Result::<RollbackStmtNode, ParseError>::Ok(RollbackStmtNode {
        span: Span::new(start, p.last_end()),
        k_rollback,
        k_transaction_transaction_name,
        k_to_k_savepoint_savepoint_name,
    });
}

fn parse_savepoint_stmt(p: &mut Parser) -> Result<SavepointStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_savepoint = p.expect(TK_K_SAVEPOINT)?;
    let savepoint_name = parse_savepoint_name(p)?;
    return Result::<SavepointStmtNode, ParseError>::Ok(SavepointStmtNode {
        span: Span::new(start, p.last_end()),
        k_savepoint,
        savepoint_name,
    });
}

fn parse_simple_select_stmt(p: &mut Parser) -> Result<SimpleSelectStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let select_core = parse_select_core(p)?;
    let k_order_k_by_ordering_term_item: Option<KOrderKByOrderingTermItemListItem> = if p.peek_kind() == TK_K_ORDER && p.peek_at(1) == TK_K_BY {
        let k_order = p.expect(TK_K_ORDER)?;
        let k_by = p.expect(TK_K_BY)?;
        let ordering_term = parse_ordering_term(p)?;
        let mut comma_ordering_term_list: Array<CommaOrderingTermItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let ordering_term = parse_ordering_term(p)?;
            let comma_ordering_term = CommaOrderingTermItem {
                comma,
                ordering_term,
            };
            comma_ordering_term_list.push(comma_ordering_term);
        }
        let k_order_k_by_ordering_term_item = KOrderKByOrderingTermItemListItem {
            k_order,
            k_by,
            ordering_term,
            comma_ordering_term_list,
        };
        Option::<KOrderKByOrderingTermItemListItem>::Some(k_order_k_by_ordering_term_item)
    } else {
        null
    };
    let k_limit_expr_item: Option<KLimitExprItemOptItem> = if p.peek_kind() == TK_K_LIMIT {
        let k_limit = p.expect(TK_K_LIMIT)?;
        let expr = parse_expr(p)?;
        let item_expr: Option<ItemExprItem> = if p.peek_kind() matches { TK_K_OFFSET | TK_LIT_COMMA } {
            let opt_saved = p.pos;
            let mut opt_result: Option<ItemExprItem> = null;
            opt_bt: {
                let k_offset_or_comma = p.advance();
                let _bt_r = parse_expr(p);
                if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
                let expr = _bt_r.unwrap();
                let item_expr = ItemExprItem {
                    k_offset_or_comma,
                    expr,
                };
                opt_result = Option::<ItemExprItem>::Some(item_expr);
            }
            opt_result
        } else {
            null
        };
        let k_limit_expr_item = KLimitExprItemOptItem {
            k_limit,
            expr,
            item_expr,
        };
        Option::<KLimitExprItemOptItem>::Some(k_limit_expr_item)
    } else {
        null
    };
    return Result::<SimpleSelectStmtNode, ParseError>::Ok(SimpleSelectStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        select_core,
        k_order_k_by_ordering_term_item,
        k_limit_expr_item,
    });
}

fn parse_select_stmt(p: &mut Parser) -> Result<SelectStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let select_or_values = parse_select_or_values(p)?;
    let mut compound_operator_select_or_values_list: Array<CompoundOperatorSelectOrValuesItem> = [];
    while p.peek_kind() matches { TK_K_UNION | TK_K_INTERSECT | TK_K_EXCEPT } {
        let compound_operator = parse_compound_operator(p)?;
        let select_or_values = parse_select_or_values(p)?;
        let compound_operator_select_or_values = CompoundOperatorSelectOrValuesItem {
            compound_operator,
            select_or_values,
        };
        compound_operator_select_or_values_list.push(compound_operator_select_or_values);
    }
    let k_order_k_by_ordering_term_item: Option<KOrderKByOrderingTermItemListItem> = if p.peek_kind() == TK_K_ORDER && p.peek_at(1) == TK_K_BY {
        let k_order = p.expect(TK_K_ORDER)?;
        let k_by = p.expect(TK_K_BY)?;
        let ordering_term = parse_ordering_term(p)?;
        let mut comma_ordering_term_list: Array<CommaOrderingTermItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let ordering_term = parse_ordering_term(p)?;
            let comma_ordering_term = CommaOrderingTermItem {
                comma,
                ordering_term,
            };
            comma_ordering_term_list.push(comma_ordering_term);
        }
        let k_order_k_by_ordering_term_item = KOrderKByOrderingTermItemListItem {
            k_order,
            k_by,
            ordering_term,
            comma_ordering_term_list,
        };
        Option::<KOrderKByOrderingTermItemListItem>::Some(k_order_k_by_ordering_term_item)
    } else {
        null
    };
    let k_limit_expr_item: Option<KLimitExprItemOptItem> = if p.peek_kind() == TK_K_LIMIT {
        let k_limit = p.expect(TK_K_LIMIT)?;
        let expr = parse_expr(p)?;
        let item_expr: Option<ItemExprItem> = if p.peek_kind() matches { TK_K_OFFSET | TK_LIT_COMMA } {
            let opt_saved = p.pos;
            let mut opt_result: Option<ItemExprItem> = null;
            opt_bt: {
                let k_offset_or_comma = p.advance();
                let _bt_r = parse_expr(p);
                if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
                let expr = _bt_r.unwrap();
                let item_expr = ItemExprItem {
                    k_offset_or_comma,
                    expr,
                };
                opt_result = Option::<ItemExprItem>::Some(item_expr);
            }
            opt_result
        } else {
            null
        };
        let k_limit_expr_item = KLimitExprItemOptItem {
            k_limit,
            expr,
            item_expr,
        };
        Option::<KLimitExprItemOptItem>::Some(k_limit_expr_item)
    } else {
        null
    };
    return Result::<SelectStmtNode, ParseError>::Ok(SelectStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        select_or_values,
        compound_operator_select_or_values_list,
        k_order_k_by_ordering_term_item,
        k_limit_expr_item,
    });
}

fn parse_select_or_values(p: &mut Parser) -> Result<SelectOrValuesNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_K_SELECT {
        let k_select = p.expect(TK_K_SELECT)?;
        let k_distinct_or_k_all: Option<Token> = if p.peek_kind() matches { TK_K_DISTINCT | TK_K_ALL } {
            let opt_saved = p.pos;
            let mut opt_result: Option<Token> = null;
            opt_bt: {
                let k_distinct_or_k_all = p.advance();
                opt_result = Option::<Token>::Some(k_distinct_or_k_all);
            }
            opt_result
        } else {
            null
        };
        let result_column = parse_result_column(p)?;
        let mut comma_result_column_list: Array<CommaResultColumnItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let result_column = parse_result_column(p)?;
            let comma_result_column = CommaResultColumnItem {
                comma,
                result_column,
            };
            comma_result_column_list.push(comma_result_column);
        }
        let k_from_item: Option<KFromItemItem> = if p.peek_kind() == TK_K_FROM {
            let k_from = p.expect(TK_K_FROM)?;
            let mut group_0_inner: Option<SelectOrValuesGroup0> = null;
            let grp_kind = p.peek_kind();
            if grp_kind matches { TK_IDENTIFIER | TK_K_ABORT | TK_K_ACTION | TK_K_ADD | TK_K_AFTER | TK_K_ALL | TK_K_ALTER | TK_K_ANALYZE | TK_K_AND | TK_K_AS | TK_K_ASC | TK_K_ATTACH | TK_K_AUTOINCREMENT | TK_K_BEFORE | TK_K_BEGIN | TK_K_BETWEEN | TK_K_BY | TK_K_CASCADE | TK_K_CASE | TK_K_CAST | TK_K_CHECK | TK_K_COLLATE | TK_K_COLUMN | TK_K_COMMIT | TK_K_CONFLICT | TK_K_CONSTRAINT | TK_K_CREATE | TK_K_CROSS | TK_K_CURRENT_DATE | TK_K_CURRENT_TIME | TK_K_CURRENT_TIMESTAMP | TK_K_DATABASE | TK_K_DEFAULT | TK_K_DEFERRABLE | TK_K_DEFERRED | TK_K_DELETE | TK_K_DESC | TK_K_DETACH | TK_K_DISTINCT | TK_K_DROP | TK_K_EACH | TK_K_ELSE | TK_K_END | TK_K_ESCAPE | TK_K_EXCEPT | TK_K_EXCLUSIVE | TK_K_EXISTS | TK_K_EXPLAIN | TK_K_FAIL | TK_K_FOR | TK_K_FOREIGN | TK_K_FROM | TK_K_FULL | TK_K_GLOB | TK_K_GROUP | TK_K_HAVING | TK_K_IF | TK_K_IGNORE | TK_K_IMMEDIATE | TK_K_IN | TK_K_INDEX | TK_K_INDEXED | TK_K_INITIALLY | TK_K_INNER | TK_K_INSERT | TK_K_INSTEAD | TK_K_INTERSECT | TK_K_INTO | TK_K_IS | TK_K_ISNULL | TK_K_JOIN | TK_K_KEY | TK_K_LEFT | TK_K_LIKE | TK_K_LIMIT | TK_K_MATCH | TK_K_NATURAL | TK_K_NO | TK_K_NOT | TK_K_NOTNULL | TK_K_NULL | TK_K_OF | TK_K_OFFSET | TK_K_ON | TK_K_OR | TK_K_ORDER | TK_K_OUTER | TK_K_PLAN | TK_K_PRAGMA | TK_K_PRIMARY | TK_K_QUERY | TK_K_RAISE | TK_K_RECURSIVE | TK_K_REFERENCES | TK_K_REGEXP | TK_K_REINDEX | TK_K_RELEASE | TK_K_RENAME | TK_K_REPLACE | TK_K_RESTRICT | TK_K_RIGHT | TK_K_ROLLBACK | TK_K_ROW | TK_K_SAVEPOINT | TK_K_SELECT | TK_K_SET | TK_K_TABLE | TK_K_TEMP | TK_K_TEMPORARY | TK_K_THEN | TK_K_TO | TK_K_TRANSACTION | TK_K_TRIGGER | TK_K_UNION | TK_K_UNIQUE | TK_K_UPDATE | TK_K_USING | TK_K_VACUUM | TK_K_VALUES | TK_K_VIEW | TK_K_VIRTUAL | TK_K_WHEN | TK_K_WHERE | TK_K_WITH | TK_K_WITHOUT | TK_STRING_LITERAL | TK_LIT_LPAREN } {
                let saved_pos = p.pos;
                let mut bt_done = false;
                if !bt_done {
                    bt_try: {
                        let _bt_r = parse_join_clause(p);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                        let join_clause = _bt_r.unwrap();
                        group_0_inner = Option::<SelectOrValuesGroup0>::Some(SelectOrValuesGroup0::Alt1(SelectOrValuesGroup0Alt1 {
                            join_clause,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    let table_or_subquery = parse_table_or_subquery(p)?;
                    let mut comma_table_or_subquery_list: Array<CommaTableOrSubqueryItem> = [];
                    while p.peek_kind() == TK_LIT_COMMA {
                        let comma = p.expect(TK_LIT_COMMA)?;
                        let table_or_subquery = parse_table_or_subquery(p)?;
                        let comma_table_or_subquery = CommaTableOrSubqueryItem {
                            comma,
                            table_or_subquery,
                        };
                        comma_table_or_subquery_list.push(comma_table_or_subquery);
                    }
                    group_0_inner = Option::<SelectOrValuesGroup0>::Some(SelectOrValuesGroup0::Alt0(SelectOrValuesGroup0Alt0 {
                        table_or_subquery,
                        comma_table_or_subquery_list,
                    }));
                }
            }
            let group_0 = group_0_inner;
            let k_from_item = KFromItemItem {
                k_from,
                group_0,
            };
            Option::<KFromItemItem>::Some(k_from_item)
        } else {
            null
        };
        let k_where_expr: Option<KWhereExprItem> = if p.peek_kind() == TK_K_WHERE {
            let k_where = p.expect(TK_K_WHERE)?;
            let expr = parse_expr(p)?;
            let k_where_expr = KWhereExprItem {
                k_where,
                expr,
            };
            Option::<KWhereExprItem>::Some(k_where_expr)
        } else {
            null
        };
        let k_group_k_by_expr_item_item: Option<KGroupKByExprItemListItemOptItem> = if p.peek_kind() == TK_K_GROUP && p.peek_at(1) == TK_K_BY {
            let k_group = p.expect(TK_K_GROUP)?;
            let k_by = p.expect(TK_K_BY)?;
            let expr = parse_expr(p)?;
            let mut comma_expr_list: Array<CommaExprItem> = [];
            while p.peek_kind() == TK_LIT_COMMA {
                let comma = p.expect(TK_LIT_COMMA)?;
                let expr = parse_expr(p)?;
                let comma_expr = CommaExprItem {
                    comma,
                    expr,
                };
                comma_expr_list.push(comma_expr);
            }
            let k_having_expr: Option<KHavingExprItem> = if p.peek_kind() == TK_K_HAVING {
                let k_having = p.expect(TK_K_HAVING)?;
                let expr = parse_expr(p)?;
                let k_having_expr = KHavingExprItem {
                    k_having,
                    expr,
                };
                Option::<KHavingExprItem>::Some(k_having_expr)
            } else {
                null
            };
            let k_group_k_by_expr_item_item = KGroupKByExprItemListItemOptItem {
                k_group,
                k_by,
                expr,
                comma_expr_list,
                k_having_expr,
            };
            Option::<KGroupKByExprItemListItemOptItem>::Some(k_group_k_by_expr_item_item)
        } else {
            null
        };
        return Result::<SelectOrValuesNode, ParseError>::Ok(SelectOrValuesNode::Alt0(SelectOrValuesAlt0 {
            span: Span::new(start, p.last_end()),
            k_select,
            k_distinct_or_k_all,
            result_column,
            comma_result_column_list,
            k_from_item,
            k_where_expr,
            k_group_k_by_expr_item_item,
        }));
    }
    if kind == TK_K_VALUES {
        let k_values = p.expect(TK_K_VALUES)?;
        let lparen = p.expect(TK_LIT_LPAREN)?;
        let expr = parse_expr(p)?;
        let mut comma_expr_list: Array<CommaExprItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let expr = parse_expr(p)?;
            let comma_expr = CommaExprItem {
                comma,
                expr,
            };
            comma_expr_list.push(comma_expr);
        }
        let rparen = p.expect(TK_LIT_RPAREN)?;
        let mut comma_lparen_expr_item_rparen_list: Array<CommaLparenExprItemListRparenItem> = [];
        while p.peek_kind() == TK_LIT_COMMA {
            let comma = p.expect(TK_LIT_COMMA)?;
            let lparen = p.expect(TK_LIT_LPAREN)?;
            let expr = parse_expr(p)?;
            let mut comma_expr_list: Array<CommaExprItem> = [];
            while p.peek_kind() == TK_LIT_COMMA {
                let comma = p.expect(TK_LIT_COMMA)?;
                let expr = parse_expr(p)?;
                let comma_expr = CommaExprItem {
                    comma,
                    expr,
                };
                comma_expr_list.push(comma_expr);
            }
            let rparen = p.expect(TK_LIT_RPAREN)?;
            let comma_lparen_expr_item_rparen = CommaLparenExprItemListRparenItem {
                comma,
                lparen,
                expr,
                comma_expr_list,
                rparen,
            };
            comma_lparen_expr_item_rparen_list.push(comma_lparen_expr_item_rparen);
        }
        return Result::<SelectOrValuesNode, ParseError>::Ok(SelectOrValuesNode::Alt1(SelectOrValuesAlt1 {
            span: Span::new(start, p.last_end()),
            k_values,
            lparen,
            expr,
            comma_expr_list,
            rparen,
            comma_lparen_expr_item_rparen_list,
        }));
    }
    return Result::<SelectOrValuesNode, ParseError>::Err(ParseError::new(
        "expected select_or_values",
        p.peek().span,
        ["TK_K_SELECT", "TK_K_VALUES"],
    ));
}

fn parse_update_stmt(p: &mut Parser) -> Result<UpdateStmtNode, ParseError> {
    let start = p.peek().span.start;
    let with_clause: Option<WithClauseNode> = if p.peek_kind() == TK_K_WITH {
        let with_clause = parse_with_clause(p)?;
        Option::<WithClauseNode>::Some(with_clause)
    } else {
        null
    };
    let k_update = p.expect(TK_K_UPDATE)?;
    let group_0: Option<UpdateStmtGroup0> = if p.peek_kind() == TK_K_OR {
        let opt_saved = p.pos;
        let mut opt_result: Option<UpdateStmtGroup0> = null;
        opt_bt: {
            let mut group_0_opt: Option<UpdateStmtGroup0> = null;
            let grp_kind = p.peek_kind();
            if grp_kind == TK_K_OR {
                let saved_pos = p.pos;
                let mut bt_done = false;
                if !bt_done {
                    bt_try: {
                        let _bt_r = p.expect(TK_K_OR);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try; }
                        let k_or = _bt_r.unwrap();
                        let _bt_r_2 = p.expect(TK_K_ROLLBACK);
                        if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try; }
                        let k_rollback = _bt_r_2.unwrap();
                        group_0_opt = Option::<UpdateStmtGroup0>::Some(UpdateStmtGroup0::Alt0(UpdateStmtGroup0Alt0 {
                            k_or,
                            k_rollback,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    bt_try_2: {
                        let _bt_r = p.expect(TK_K_OR);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try_2; }
                        let k_or = _bt_r.unwrap();
                        let _bt_r_2 = p.expect(TK_K_ABORT);
                        if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try_2; }
                        let k_abort = _bt_r_2.unwrap();
                        group_0_opt = Option::<UpdateStmtGroup0>::Some(UpdateStmtGroup0::Alt1(UpdateStmtGroup0Alt1 {
                            k_or,
                            k_abort,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    bt_try_3: {
                        let _bt_r = p.expect(TK_K_OR);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try_3; }
                        let k_or = _bt_r.unwrap();
                        let _bt_r_2 = p.expect(TK_K_REPLACE);
                        if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try_3; }
                        let k_replace = _bt_r_2.unwrap();
                        group_0_opt = Option::<UpdateStmtGroup0>::Some(UpdateStmtGroup0::Alt2(UpdateStmtGroup0Alt2 {
                            k_or,
                            k_replace,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    bt_try_4: {
                        let _bt_r = p.expect(TK_K_OR);
                        if let Err(_) = _bt_r { p.pos = saved_pos; break bt_try_4; }
                        let k_or = _bt_r.unwrap();
                        let _bt_r_2 = p.expect(TK_K_FAIL);
                        if let Err(_) = _bt_r_2 { p.pos = saved_pos; break bt_try_4; }
                        let k_fail = _bt_r_2.unwrap();
                        group_0_opt = Option::<UpdateStmtGroup0>::Some(UpdateStmtGroup0::Alt3(UpdateStmtGroup0Alt3 {
                            k_or,
                            k_fail,
                        }));
                        bt_done = true;
                    }
                }
                if !bt_done {
                    let k_or = p.expect(TK_K_OR)?;
                    let k_ignore = p.expect(TK_K_IGNORE)?;
                    group_0_opt = Option::<UpdateStmtGroup0>::Some(UpdateStmtGroup0::Alt4(UpdateStmtGroup0Alt4 {
                        k_or,
                        k_ignore,
                    }));
                }
            }
            if let None = group_0_opt {
                p.fail("group alternative")?;
            }
            let group_0 = group_0_opt.unwrap();
            opt_result = Option::<UpdateStmtGroup0>::Some(group_0);
        }
        opt_result
    } else {
        null
    };
    let qualified_table_name = parse_qualified_table_name(p)?;
    let k_set = p.expect(TK_K_SET)?;
    let column_name = parse_column_name(p)?;
    let eq = p.expect(TK_LIT_EQ)?;
    let expr = parse_expr(p)?;
    let mut comma_column_name_eq_expr_list: Array<CommaColumnNameEqExprItem> = [];
    while p.peek_kind() == TK_LIT_COMMA {
        let comma = p.expect(TK_LIT_COMMA)?;
        let column_name = parse_column_name(p)?;
        let eq = p.expect(TK_LIT_EQ)?;
        let expr = parse_expr(p)?;
        let comma_column_name_eq_expr = CommaColumnNameEqExprItem {
            comma,
            column_name,
            eq,
            expr,
        };
        comma_column_name_eq_expr_list.push(comma_column_name_eq_expr);
    }
    let k_where_expr: Option<KWhereExprItem> = if p.peek_kind() == TK_K_WHERE {
        let k_where = p.expect(TK_K_WHERE)?;
        let expr = parse_expr(p)?;
        let k_where_expr = KWhereExprItem {
            k_where,
            expr,
        };
        Option::<KWhereExprItem>::Some(k_where_expr)
    } else {
        null
    };
    return Result::<UpdateStmtNode, ParseError>::Ok(UpdateStmtNode {
        span: Span::new(start, p.last_end()),
        with_clause,
        k_update,
        group_0,
        qualified_table_name,
        k_set,
        column_name,
        eq,
        expr,
        comma_column_name_eq_expr_list,
        k_where_expr,
    });
}

