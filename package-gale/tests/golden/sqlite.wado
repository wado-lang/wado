struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32, name: String) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }
}

fn parse_parse(p: &mut Parser) -> Result<ParseNode, ParseError> {
    let start = p.peek().span.start;
    let mut sql_stmt_list_or_error_list: Array<SqlStmtListOrErrorGroup> = [];
    while p.peek_kind() matches { TK_LIT_SEMI | TK_K_EXPLAIN | TK_K_ALTER | TK_K_ANALYZE | TK_K_ATTACH | TK_K_BEGIN | TK_K_COMMIT | TK_K_END | TK_K_WITH | TK_K_SELECT | TK_K_VALUES | TK_K_CREATE | TK_K_DELETE | TK_K_DETACH | TK_K_DROP | TK_K_INSERT | TK_K_REPLACE | TK_K_PRAGMA | TK_K_REINDEX | TK_K_RELEASE | TK_K_ROLLBACK | TK_K_SAVEPOINT | TK_K_UPDATE | TK_K_VACUUM | TK_UNEXPECTED_CHAR } {
        let sql_stmt_list_or_error: SqlStmtListOrErrorGroup = if p.peek_kind() matches { TK_LIT_SEMI | TK_K_EXPLAIN | TK_K_ALTER | TK_K_ANALYZE | TK_K_ATTACH | TK_K_BEGIN | TK_K_COMMIT | TK_K_END | TK_K_WITH | TK_K_SELECT | TK_K_VALUES | TK_K_CREATE | TK_K_DELETE | TK_K_DETACH | TK_K_DROP | TK_K_INSERT | TK_K_REPLACE | TK_K_PRAGMA | TK_K_REINDEX | TK_K_RELEASE | TK_K_ROLLBACK | TK_K_SAVEPOINT | TK_K_UPDATE | TK_K_VACUUM } {
            let sql_stmt_list = parse_sql_stmt_list(p)?;
            SqlStmtListOrErrorGroup::SqlStmtList(sql_stmt_list)
        } else {
            let error = parse_error(p)?;
            SqlStmtListOrErrorGroup::Error(error)
        };
        sql_stmt_list_or_error_list.push(sql_stmt_list_or_error);
    }
    let eof = p.expect(TK_EOF, "EOF")?;
    return Result::<ParseNode, ParseError>::Ok(ParseNode {
        span: Span::new(start, p.last_end()),
        sql_stmt_list_or_error_list,
        eof,
    });
}

fn parse_error(p: &mut Parser) -> Result<ErrorNode, ParseError> {
    let start = p.peek().span.start;
    let unexpected_char = p.expect(TK_UNEXPECTED_CHAR, "UNEXPECTED_CHAR")?;
    return Result::<ErrorNode, ParseError>::Ok(ErrorNode {
        span: Span::new(start, p.last_end()),
        unexpected_char,
    });
}

fn parse_sql_stmt_list(p: &mut Parser) -> Result<SqlStmtListNode, ParseError> {
    let start = p.peek().span.start;
    let mut semicolon_list: Array<Token> = [];
    while p.peek_kind() == TK_LIT_SEMI {
        let semicolon = p.expect(TK_LIT_SEMI, "';'")?;
        semicolon_list.push(semicolon);
    }
    let sql_stmt = parse_sql_stmt(p)?;
    let mut semicolon_sql_stmt_list: Array<SemicolonSqlStmtItem> = [];
    while p.peek_kind() == TK_LIT_SEMI {
        let mut semicolon_list: Array<Token> = [];
        let mut _plus_first = true;
        while _plus_first || p.peek_kind() == TK_LIT_SEMI {
            _plus_first = false;
            let semicolon = p.expect(TK_LIT_SEMI, "';'")?;
            semicolon_list.push(semicolon);
        }
        let sql_stmt = parse_sql_stmt(p)?;
        let semicolon_sql_stmt = SemicolonSqlStmtItem {
            semicolon_list,
            sql_stmt,
        };
        semicolon_sql_stmt_list.push(semicolon_sql_stmt);
    }
    let mut semicolon_list_2: Array<Token> = [];
    while p.peek_kind() == TK_LIT_SEMI {
        let semicolon = p.expect(TK_LIT_SEMI, "';'")?;
        semicolon_list_2.push(semicolon);
    }
    return Result::<SqlStmtListNode, ParseError>::Ok(SqlStmtListNode {
        span: Span::new(start, p.last_end()),
        semicolon_list,
        sql_stmt,
        semicolon_sql_stmt_list,
        semicolon_list_2,
    });
}

fn parse_sql_stmt(p: &mut Parser) -> Result<SqlStmtNode, ParseError> {
    let start = p.peek().span.start;
    let k_explain_item: Option<KExplainItemItem> = if p.peek_kind() == TK_K_EXPLAIN {
        let k_explain = p.expect(TK_K_EXPLAIN, "K_EXPLAIN")?;
        let k_query_k_plan: Option<KQueryKPlanItem> = if p.peek_kind() == TK_K_QUERY && p.peek_at(1) == TK_K_PLAN {
            let k_query = p.expect(TK_K_QUERY, "K_QUERY")?;
            let k_plan = p.expect(TK_K_PLAN, "K_PLAN")?;
            let k_query_k_plan = KQueryKPlanItem {
                k_query,
                k_plan,
            };
            Option::<KQueryKPlanItem>::Some(k_query_k_plan)
        } else {
            null
        };
        let k_explain_item = KExplainItemItem {
            k_explain,
            k_query_k_plan,
        };
        Option::<KExplainItemItem>::Some(k_explain_item)
    } else {
        null
    };
    let mut alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner: Option<> = null;
    let grp_kind = p.peek_kind();
    if grp_kind == TK_K_ALTER {
        let alter_table_stmt = parse_alter_table_stmt(p)?;
        alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner = Option::<>::Some(::AlterTableStmt(alter_table_stmt));
    } else if grp_kind == TK_K_ANALYZE {
        let analyze_stmt = parse_analyze_stmt(p)?;
        alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner = Option::<>::Some(::AnalyzeStmt(analyze_stmt));
    } else if grp_kind == TK_K_ATTACH {
        let attach_stmt = parse_attach_stmt(p)?;
        alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner = Option::<>::Some(::AttachStmt(attach_stmt));
    } else if grp_kind == TK_K_BEGIN {
        let begin_stmt = parse_begin_stmt(p)?;
        alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner = Option::<>::Some(::BeginStmt(begin_stmt));
    } else if grp_kind matches { TK_K_COMMIT | TK_K_END } {
        let commit_stmt = parse_commit_stmt(p)?;
        alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner = Option::<>::Some(::CommitStmt(commit_stmt));
    } else if grp_kind matches { TK_K_WITH | TK_K_SELECT | TK_K_VALUES | TK_K_DELETE | TK_K_INSERT | TK_K_REPLACE | TK_K_UPDATE } {
        let saved_pos = p.pos;
        let mut bt_done = false;
        if !bt_done {
            bt_try: {
                let opt_r = parse_compound_select_stmt(p);
                if let Err(_) = opt_r { p.pos = saved_pos; break bt_try; }
                alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner = Option::<>::Some(::CompoundSelectStmt(opt_r.unwrap()));
                bt_done = true;
            }
        }
        if !bt_done {
            bt_try_2: {
                let opt_r_2 = parse_delete_stmt(p);
                if let Err(_) = opt_r_2 { p.pos = saved_pos; break bt_try_2; }
                alter_table_stmt_or_analyze_stmt_or_attach_stmt_or_begin_stmt_or_commit_stmt_or_compound_select_stmt_or_create_index_stmt_or_create_table_stmt_or_create_trigger_stmt_or_create_view_stmt_or_create_virtual_table_stmt_or_delete_stmt_or_delete_stmt_limited_or_detach_stmt_or_drop_index_stmt_or_drop_table_stmt_or_drop_trigger_stmt_or_drop_view_stmt_or_factored_select_stmt_or_insert_stmt_or_pragma_stmt_or_reindex_stmt_or_release_stmt_or_rollback_stmt_or_savepoint_stmt_or_simple_select_stmt_or_select_stmt_or_update_stmt_or_update_stmt_limited_or_vacuum_stmt_inner = Option::<>::Some(::DeleteStmt(opt_r_2.unwrap()));
                bt_done = true;
            }
        }
        if !bt_done {
