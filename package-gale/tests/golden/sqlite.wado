fn parse_name(p: &mut Parser) -> Result<NameNode, ParseError> {
    let start = p.peek().span.start;
    let any_name = parse_any_name(p)?;
    return Result::<NameNode, ParseError>::Ok(NameNode {
        span: Span::new(start, p.last_end()),
        any_name,
    });
}

