            let k_temp_or_k_temporary = p.advance();
            opt_result = Option::<Token>::Some(k_temp_or_k_temporary);
        }
        opt_result
    } else {
        null
    };
    let k_table = p.expect(TK_K_TABLE, "K_TABLE")?;
    let k_if_k_not_k_exists: Option<KIfKNotKExistsItem> = if p.peek_kind() == TK_K_IF && p.peek_at(1) == TK_K_NOT && p.peek_at(2) == TK_K_EXISTS {
