fn parse_expr_bt_21(p: &mut Parser) -> Result<ExprNode, ParseError> {
    let start = p.peek().span.start;
    let item_k_exists: Option<ItemOptKExistsItem> = if p.peek_kind() == TK_K_NOT && p.peek_at(1) == TK_K_EXISTS {
