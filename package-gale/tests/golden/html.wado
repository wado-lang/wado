                        let opt_saved_36 = pos;
                        let mut opt_ok_36 = false;
                        rep_36: {
                            if pos >= chars.len() || chars[pos] != '%' { break rep_36; }
                            pos += 1;
                            opt_ok_36 = true;
                        }
                        if !opt_ok_36 { pos = opt_saved_36; }
                        alts_ok_27 = true;
                    }
                }
            }
        }
    }
    if !alts_ok_27 { return -1; }
    return pos;
}

pub fn tokenize(input: &String) -> Array<Token> {
    let mut lexer = Lexer::new(input);
    let mut tokens: Array<Token> = [];
    let mut trivia: Array<Token> = [];
    let mut mode_stack: Array<i32> = [];
    let mut current_mode: i32 = 0;
    while !lexer.at_end() {
        let start = lexer.pos;
        let mut best_end: i32 = -1;
        let mut best_kind: i32 = TK_ERROR;
        let mut end: i32 = -1;
        let mut best_push_mode: i32 = -1;
        let mut best_pop_mode = false;
        if current_mode == 0 {
            end = try_html_comment(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_HTML_COMMENT; best_push_mode = -1; best_pop_mode = false; }
            end = try_html_conditional_comment(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_HTML_CONDITIONAL_COMMENT; best_push_mode = -1; best_pop_mode = false; }
            end = try_xml(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_XML; best_push_mode = -1; best_pop_mode = false; }
            end = try_cdata(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_CDATA; best_push_mode = -1; best_pop_mode = false; }
            end = try_dtd(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_DTD; best_push_mode = -1; best_pop_mode = false; }
            end = try_scriptlet(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCRIPTLET; best_push_mode = -1; best_pop_mode = false; }
            end = try_sea_ws(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SEA_WS; best_push_mode = -1; best_pop_mode = false; }
            end = try_script_open(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCRIPT_OPEN; best_push_mode = 1; best_pop_mode = false; }
            end = try_style_open(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STYLE_OPEN; best_push_mode = 2; best_pop_mode = false; }
            end = try_tag_open(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAG_OPEN; best_push_mode = 3; best_pop_mode = false; }
            end = try_html_text(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_HTML_TEXT; best_push_mode = -1; best_pop_mode = false; }
        } else if current_mode == 1 {
            end = try_script_body(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCRIPT_BODY; best_push_mode = -1; best_pop_mode = true; }
            end = try_script_short_body(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_SCRIPT_SHORT_BODY; best_push_mode = -1; best_pop_mode = true; }
        } else if current_mode == 2 {
            end = try_style_body(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STYLE_BODY; best_push_mode = -1; best_pop_mode = true; }
            end = try_style_short_body(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_STYLE_SHORT_BODY; best_push_mode = -1; best_pop_mode = true; }
        } else if current_mode == 3 {
            end = try_tag_close(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAG_CLOSE; best_push_mode = -1; best_pop_mode = true; }
            end = try_tag_slash_close(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAG_SLASH_CLOSE; best_push_mode = -1; best_pop_mode = true; }
            end = try_tag_slash(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAG_SLASH; best_push_mode = -1; best_pop_mode = false; }
            end = try_tag_equals(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAG_EQUALS; best_push_mode = 4; best_pop_mode = false; }
            end = try_tag_name(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAG_NAME; best_push_mode = -1; best_pop_mode = false; }
            end = try_tag_whitespace(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_TAG_WHITESPACE; best_push_mode = -1; best_pop_mode = false; }
        } else if current_mode == 4 {
            end = try_attvalue_value(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ATTVALUE_VALUE; best_push_mode = -1; best_pop_mode = true; }
            end = try_attribute(&lexer.chars, start);
            if end > best_end { best_end = end; best_kind = TK_ATTRIBUTE; best_push_mode = -1; best_pop_mode = false; }
        }
        if best_end <= start {
            let tok = Token::with_trivia(TK_ERROR, lexer.slice(start, start + 1), Span::new(start, start + 1), trivia);
            tokens.push(tok);
            trivia = [];
            lexer.pos = start + 1;
        } else {
            let is_skip = best_kind matches { TK_TAG_WHITESPACE };
            if is_skip {
                trivia.push(Token::new(best_kind, lexer.slice(start, best_end), Span::new(start, best_end)));
            } else {
                let tok = Token::with_trivia(best_kind, lexer.slice(start, best_end), Span::new(start, best_end), trivia);
                tokens.push(tok);
                trivia = [];
            }
            if best_push_mode >= 0 {
                mode_stack.push(current_mode);
                current_mode = best_push_mode;
                best_push_mode = -1;
            }
            if best_pop_mode {
                if mode_stack.is_empty() {
                    current_mode = 0;
                } else {
                    current_mode = mode_stack[mode_stack.len() - 1];
                    mode_stack.pop();
                }
                best_pop_mode = false;
            }
            lexer.pos = best_end;
        }
    }
    tokens.push(Token::with_trivia(TK_EOF, "", Span::new(lexer.pos, lexer.pos), trivia));
    return tokens;
}

pub fn token_kind_name(kind: i32) -> String {
    return match kind {
        TK_HTML_COMMENT => "HTML_COMMENT",
        TK_HTML_CONDITIONAL_COMMENT => "HTML_CONDITIONAL_COMMENT",
        TK_XML => "XML",
        TK_CDATA => "CDATA",
        TK_DTD => "DTD",
        TK_SCRIPTLET => "SCRIPTLET",
        TK_SEA_WS => "SEA_WS",
        TK_SCRIPT_OPEN => "SCRIPT_OPEN",
        TK_STYLE_OPEN => "STYLE_OPEN",
        TK_TAG_OPEN => "TAG_OPEN",
        TK_HTML_TEXT => "HTML_TEXT",
        TK_TAG_CLOSE => "TAG_CLOSE",
        TK_TAG_SLASH_CLOSE => "TAG_SLASH_CLOSE",
        TK_TAG_SLASH => "TAG_SLASH",
        TK_TAG_EQUALS => "TAG_EQUALS",
        TK_TAG_NAME => "TAG_NAME",
        TK_TAG_WHITESPACE => "TAG_WHITESPACE",
        TK_SCRIPT_BODY => "SCRIPT_BODY",
        TK_SCRIPT_SHORT_BODY => "SCRIPT_SHORT_BODY",
        TK_STYLE_BODY => "STYLE_BODY",
        TK_STYLE_SHORT_BODY => "STYLE_SHORT_BODY",
        TK_ATTVALUE_VALUE => "ATTVALUE_VALUE",
        TK_ATTRIBUTE => "ATTRIBUTE",
        TK_EOF => "Eof",
        TK_ERROR => "Error",
        _ => "Unknown",
    };
}

struct Parser {
    tokens: Array<Token>,
    pos: i32,
}

impl Parser {
    fn new(tokens: Array<Token>) -> Parser {
        return Parser { tokens, pos: 0 };
    }

    fn peek(&self) -> &Token {
        return &self.tokens[self.pos];
    }

    fn peek_kind(&self) -> i32 {
        return self.tokens[self.pos].kind;
    }

    fn peek_at(&self, offset: i32) -> i32 {
        let idx = self.pos + offset;
        if idx >= self.tokens.len() { return TK_EOF; }
        return self.tokens[idx].kind;
    }

    fn advance(&mut self) -> Token {
        let tok = self.tokens[self.pos];
        self.pos += 1;
        return tok;
    }

    fn last_end(&self) -> i32 {
        if self.pos == 0 { return 0; }
        return self.tokens[self.pos - 1].span.end;
    }

    fn expect(&mut self, kind: i32, name: String) -> Result<Token, ParseError> {
        if self.tokens[self.pos].kind == kind {
            return Result::<Token, ParseError>::Ok(self.advance());
        }
        let tok = &self.tokens[self.pos];
        return Result::<Token, ParseError>::Err(ParseError::new(
            `expected {name}, got "{tok.text}"`,
            tok.span,
            [name],
        ));
    }
}

fn parse_html_document(p: &mut Parser) -> Result<HtmlDocumentNode, ParseError> {
    let start = p.peek().span.start;
    let mut scriptlet_or_sea_ws_list: Array<ScriptletOrSeaWsNode> = [];
    while p.peek_kind() matches { TK_SCRIPTLET | TK_SEA_WS } {
        let scriptlet_or_sea_ws = parse_scriptlet_or_sea_ws(p)?;
        scriptlet_or_sea_ws_list.push(scriptlet_or_sea_ws);
    }
    let xml: Option<Token> = if p.peek_kind() == TK_XML {
        let xml = p.expect(TK_XML, "XML")?;
        Option::<Token>::Some(xml)
    } else {
        null
    };
    let mut scriptlet_or_sea_ws_list_2: Array<ScriptletOrSeaWsNode> = [];
    while p.peek_kind() matches { TK_SCRIPTLET | TK_SEA_WS } {
        let scriptlet_or_sea_ws = parse_scriptlet_or_sea_ws(p)?;
        scriptlet_or_sea_ws_list_2.push(scriptlet_or_sea_ws);
    }
    let dtd: Option<Token> = if p.peek_kind() == TK_DTD {
        let dtd = p.expect(TK_DTD, "DTD")?;
        Option::<Token>::Some(dtd)
    } else {
        null
    };
    let mut scriptlet_or_sea_ws_list_3: Array<ScriptletOrSeaWsNode> = [];
    while p.peek_kind() matches { TK_SCRIPTLET | TK_SEA_WS } {
        let scriptlet_or_sea_ws = parse_scriptlet_or_sea_ws(p)?;
        scriptlet_or_sea_ws_list_3.push(scriptlet_or_sea_ws);
    }
    let mut html_elements_list: Array<HtmlElementsNode> = [];
    while p.peek_kind() matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SEA_WS | TK_TAG_OPEN | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN } {
        let html_elements = parse_html_elements(p)?;
        html_elements_list.push(html_elements);
    }
    return Result::<HtmlDocumentNode, ParseError>::Ok(HtmlDocumentNode {
        span: Span::new(start, p.last_end()),
        scriptlet_or_sea_ws_list,
        xml,
        scriptlet_or_sea_ws_list_2,
        dtd,
        scriptlet_or_sea_ws_list_3,
        html_elements_list,
    });
}

fn parse_scriptlet_or_sea_ws(p: &mut Parser) -> Result<ScriptletOrSeaWsNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_SCRIPTLET {
        let scriptlet = p.expect(TK_SCRIPTLET, "SCRIPTLET")?;
        return Result::<ScriptletOrSeaWsNode, ParseError>::Ok(ScriptletOrSeaWsNode::Alt0(ScriptletOrSeaWsAlt0 {
            span: Span::new(start, p.last_end()),
            scriptlet,
        }));
    }
    if kind == TK_SEA_WS {
        let sea_ws = p.expect(TK_SEA_WS, "SEA_WS")?;
        return Result::<ScriptletOrSeaWsNode, ParseError>::Ok(ScriptletOrSeaWsNode::Alt1(ScriptletOrSeaWsAlt1 {
            span: Span::new(start, p.last_end()),
            sea_ws,
        }));
    }
    return Result::<ScriptletOrSeaWsNode, ParseError>::Err(ParseError::new(
        "expected scriptletOrSeaWs",
        p.peek().span,
        ["TK_SCRIPTLET", "TK_SEA_WS"],
    ));
}

fn parse_html_elements(p: &mut Parser) -> Result<HtmlElementsNode, ParseError> {
    let start = p.peek().span.start;
    let mut html_misc_list: Array<HtmlMiscNode> = [];
    while p.peek_kind() matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SEA_WS } {
        let html_misc = parse_html_misc(p)?;
        html_misc_list.push(html_misc);
    }
    let html_element = parse_html_element(p)?;
    let mut html_misc_list_2: Array<HtmlMiscNode> = [];
    while p.peek_kind() matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT | TK_SEA_WS } {
        let html_misc = parse_html_misc(p)?;
        html_misc_list_2.push(html_misc);
    }
    return Result::<HtmlElementsNode, ParseError>::Ok(HtmlElementsNode {
        span: Span::new(start, p.last_end()),
        html_misc_list,
        html_element,
        html_misc_list_2,
    });
}

fn parse_html_element(p: &mut Parser) -> Result<HtmlElementNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_TAG_OPEN {
        let tag_open = p.expect(TK_TAG_OPEN, "TAG_OPEN")?;
        let tag_name = p.expect(TK_TAG_NAME, "TAG_NAME")?;
        let mut html_attribute_list: Array<HtmlAttributeNode> = [];
        while p.peek_kind() == TK_TAG_NAME {
            let html_attribute = parse_html_attribute(p)?;
            html_attribute_list.push(html_attribute);
        }
        let mut group_0_inner: Option<HtmlElementGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind == TK_TAG_CLOSE {
            let tag_close = p.expect(TK_TAG_CLOSE, "TAG_CLOSE")?;
            let html_content_tag_open_tag_slash_tag_name_tag_close: Option<HtmlContentTagOpenTagSlashTagNameTagCloseItem> = if p.peek_kind() matches { TK_HTML_TEXT | TK_SEA_WS | TK_TAG_OPEN | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN | TK_CDATA | TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT } {
                let opt_saved = p.pos;
                let mut opt_result: Option<HtmlContentTagOpenTagSlashTagNameTagCloseItem> = null;
                opt_bt: {
                    let _bt_r = parse_html_content(p);
                    if let Err(_) = _bt_r { p.pos = opt_saved; break opt_bt; }
                    let html_content = _bt_r.unwrap();
                    let _bt_r_2 = p.expect(TK_TAG_OPEN, "TAG_OPEN");
                    if let Err(_) = _bt_r_2 { p.pos = opt_saved; break opt_bt; }
                    let tag_open = _bt_r_2.unwrap();
                    let _bt_r_3 = p.expect(TK_TAG_SLASH, "TAG_SLASH");
                    if let Err(_) = _bt_r_3 { p.pos = opt_saved; break opt_bt; }
                    let tag_slash = _bt_r_3.unwrap();
                    let _bt_r_4 = p.expect(TK_TAG_NAME, "TAG_NAME");
                    if let Err(_) = _bt_r_4 { p.pos = opt_saved; break opt_bt; }
                    let tag_name = _bt_r_4.unwrap();
                    let _bt_r_5 = p.expect(TK_TAG_CLOSE, "TAG_CLOSE");
                    if let Err(_) = _bt_r_5 { p.pos = opt_saved; break opt_bt; }
                    let tag_close = _bt_r_5.unwrap();
                    let html_content_tag_open_tag_slash_tag_name_tag_close = HtmlContentTagOpenTagSlashTagNameTagCloseItem {
                        html_content,
                        tag_open,
                        tag_slash,
                        tag_name,
                        tag_close,
                    };
                    opt_result = Option::<HtmlContentTagOpenTagSlashTagNameTagCloseItem>::Some(html_content_tag_open_tag_slash_tag_name_tag_close);
                }
                opt_result
            } else {
                null
            };
            group_0_inner = Option::<HtmlElementGroup0>::Some(HtmlElementGroup0::Alt0(HtmlElementGroup0Alt0 {
                tag_close,
                html_content_tag_open_tag_slash_tag_name_tag_close,
            }));
        } else if grp_kind == TK_TAG_SLASH_CLOSE {
            let tag_slash_close = p.expect(TK_TAG_SLASH_CLOSE, "TAG_SLASH_CLOSE")?;
            group_0_inner = Option::<HtmlElementGroup0>::Some(HtmlElementGroup0::Alt1(HtmlElementGroup0Alt1 {
                tag_slash_close,
            }));
        }
        let group_0 = group_0_inner;
        return Result::<HtmlElementNode, ParseError>::Ok(HtmlElementNode::Alt0(HtmlElementAlt0 {
            span: Span::new(start, p.last_end()),
            tag_open,
            tag_name,
            html_attribute_list,
            group_0,
        }));
    }
    if kind == TK_SCRIPTLET {
        let scriptlet = p.expect(TK_SCRIPTLET, "SCRIPTLET")?;
        return Result::<HtmlElementNode, ParseError>::Ok(HtmlElementNode::Alt1(HtmlElementAlt1 {
            span: Span::new(start, p.last_end()),
            scriptlet,
        }));
    }
    if kind == TK_SCRIPT_OPEN {
        let script = parse_script(p)?;
        return Result::<HtmlElementNode, ParseError>::Ok(HtmlElementNode::Alt2(HtmlElementAlt2 {
            span: Span::new(start, p.last_end()),
            script,
        }));
    }
    if kind == TK_STYLE_OPEN {
        let style = parse_style(p)?;
        return Result::<HtmlElementNode, ParseError>::Ok(HtmlElementNode::Alt3(HtmlElementAlt3 {
            span: Span::new(start, p.last_end()),
            style,
        }));
    }
    return Result::<HtmlElementNode, ParseError>::Err(ParseError::new(
        "expected htmlElement",
        p.peek().span,
        ["TK_TAG_OPEN", "TK_SCRIPTLET", "TK_SCRIPT_OPEN", "TK_STYLE_OPEN"],
    ));
}

fn parse_html_content(p: &mut Parser) -> Result<HtmlContentNode, ParseError> {
    let start = p.peek().span.start;
    let html_chardata: Option<HtmlChardataNode> = if p.peek_kind() matches { TK_HTML_TEXT | TK_SEA_WS } {
        let html_chardata = parse_html_chardata(p)?;
        Option::<HtmlChardataNode>::Some(html_chardata)
    } else {
        null
    };
    let mut item_html_chardata_list: Array<ItemHtmlChardataItem> = [];
    while p.peek_kind() matches { TK_TAG_OPEN | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN | TK_CDATA | TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT } {
        let mut group_0_inner: Option<HtmlContentGroup0> = null;
        let grp_kind = p.peek_kind();
        if grp_kind matches { TK_TAG_OPEN | TK_SCRIPTLET | TK_SCRIPT_OPEN | TK_STYLE_OPEN } {
            let html_element = parse_html_element(p)?;
            group_0_inner = Option::<HtmlContentGroup0>::Some(HtmlContentGroup0::Alt0(HtmlContentGroup0Alt0 {
                html_element,
            }));
        } else if grp_kind == TK_CDATA {
            let cdata = p.expect(TK_CDATA, "CDATA")?;
            group_0_inner = Option::<HtmlContentGroup0>::Some(HtmlContentGroup0::Alt1(HtmlContentGroup0Alt1 {
                cdata,
            }));
        } else if grp_kind matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT } {
            let html_comment = parse_html_comment(p)?;
            group_0_inner = Option::<HtmlContentGroup0>::Some(HtmlContentGroup0::Alt2(HtmlContentGroup0Alt2 {
                html_comment,
            }));
        }
        let group_0 = group_0_inner;
        let html_chardata: Option<HtmlChardataNode> = if p.peek_kind() matches { TK_HTML_TEXT | TK_SEA_WS } {
            let html_chardata = parse_html_chardata(p)?;
            Option::<HtmlChardataNode>::Some(html_chardata)
        } else {
            null
        };
        let item_html_chardata = ItemHtmlChardataItem {
            group_0,
            html_chardata,
        };
        item_html_chardata_list.push(item_html_chardata);
    }
    return Result::<HtmlContentNode, ParseError>::Ok(HtmlContentNode {
        span: Span::new(start, p.last_end()),
        html_chardata,
        item_html_chardata_list,
    });
}

fn parse_html_attribute(p: &mut Parser) -> Result<HtmlAttributeNode, ParseError> {
    let start = p.peek().span.start;
    let tag_name = p.expect(TK_TAG_NAME, "TAG_NAME")?;
    let tag_equals_attvalue_value: Option<TagEqualsAttvalueValueItem> = if p.peek_kind() == TK_TAG_EQUALS && p.peek_at(1) == TK_ATTVALUE_VALUE {
        let tag_equals = p.expect(TK_TAG_EQUALS, "TAG_EQUALS")?;
        let attvalue_value = p.expect(TK_ATTVALUE_VALUE, "ATTVALUE_VALUE")?;
        let tag_equals_attvalue_value = TagEqualsAttvalueValueItem {
            tag_equals,
            attvalue_value,
        };
        Option::<TagEqualsAttvalueValueItem>::Some(tag_equals_attvalue_value)
    } else {
        null
    };
    return Result::<HtmlAttributeNode, ParseError>::Ok(HtmlAttributeNode {
        span: Span::new(start, p.last_end()),
        tag_name,
        tag_equals_attvalue_value,
    });
}

fn parse_html_chardata(p: &mut Parser) -> Result<HtmlChardataNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_HTML_TEXT {
        let html_text = p.expect(TK_HTML_TEXT, "HTML_TEXT")?;
        return Result::<HtmlChardataNode, ParseError>::Ok(HtmlChardataNode::Alt0(HtmlChardataAlt0 {
            span: Span::new(start, p.last_end()),
            html_text,
        }));
    }
    if kind == TK_SEA_WS {
        let sea_ws = p.expect(TK_SEA_WS, "SEA_WS")?;
        return Result::<HtmlChardataNode, ParseError>::Ok(HtmlChardataNode::Alt1(HtmlChardataAlt1 {
            span: Span::new(start, p.last_end()),
            sea_ws,
        }));
    }
    return Result::<HtmlChardataNode, ParseError>::Err(ParseError::new(
        "expected htmlChardata",
        p.peek().span,
        ["TK_HTML_TEXT", "TK_SEA_WS"],
    ));
}

fn parse_html_misc(p: &mut Parser) -> Result<HtmlMiscNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind matches { TK_HTML_COMMENT | TK_HTML_CONDITIONAL_COMMENT } {
        let html_comment = parse_html_comment(p)?;
        return Result::<HtmlMiscNode, ParseError>::Ok(HtmlMiscNode::Alt0(HtmlMiscAlt0 {
            span: Span::new(start, p.last_end()),
            html_comment,
        }));
    }
    if kind == TK_SEA_WS {
        let sea_ws = p.expect(TK_SEA_WS, "SEA_WS")?;
        return Result::<HtmlMiscNode, ParseError>::Ok(HtmlMiscNode::Alt1(HtmlMiscAlt1 {
            span: Span::new(start, p.last_end()),
            sea_ws,
        }));
    }
    return Result::<HtmlMiscNode, ParseError>::Err(ParseError::new(
        "expected htmlMisc",
        p.peek().span,
        ["TK_HTML_COMMENT", "TK_HTML_CONDITIONAL_COMMENT", "TK_SEA_WS"],
    ));
}

fn parse_html_comment(p: &mut Parser) -> Result<HtmlCommentNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_HTML_COMMENT {
        let html_comment = p.expect(TK_HTML_COMMENT, "HTML_COMMENT")?;
        return Result::<HtmlCommentNode, ParseError>::Ok(HtmlCommentNode::Alt0(HtmlCommentAlt0 {
            span: Span::new(start, p.last_end()),
            html_comment,
        }));
    }
    if kind == TK_HTML_CONDITIONAL_COMMENT {
        let html_conditional_comment = p.expect(TK_HTML_CONDITIONAL_COMMENT, "HTML_CONDITIONAL_COMMENT")?;
        return Result::<HtmlCommentNode, ParseError>::Ok(HtmlCommentNode::Alt1(HtmlCommentAlt1 {
            span: Span::new(start, p.last_end()),
            html_conditional_comment,
        }));
    }
    return Result::<HtmlCommentNode, ParseError>::Err(ParseError::new(
        "expected htmlComment",
        p.peek().span,
        ["TK_HTML_COMMENT", "TK_HTML_CONDITIONAL_COMMENT"],
    ));
}

fn parse_script(p: &mut Parser) -> Result<ScriptNode, ParseError> {
    let start = p.peek().span.start;
    let script_open = p.expect(TK_SCRIPT_OPEN, "SCRIPT_OPEN")?;
    let script_body_or_script_short_body = p.advance();
    return Result::<ScriptNode, ParseError>::Ok(ScriptNode {
        span: Span::new(start, p.last_end()),
        script_open,
        script_body_or_script_short_body,
    });
}

fn parse_style(p: &mut Parser) -> Result<StyleNode, ParseError> {
    let start = p.peek().span.start;
    let style_open = p.expect(TK_STYLE_OPEN, "STYLE_OPEN")?;
    let style_body_or_style_short_body = p.advance();
    return Result::<StyleNode, ParseError>::Ok(StyleNode {
        span: Span::new(start, p.last_end()),
        style_open,
        style_body_or_style_short_body,
    });
}

pub fn parse(input: &String) -> Result<HtmlDocumentNode, ParseError> {
    let tokens = tokenize(input);
    let mut parser = Parser::new(tokens);
    return parse_html_document(&mut parser);
}

pub fn walk_htmlDocument<V: Visitor>(v: &mut V, node: &HtmlDocumentNode) {
    v.enter_rule(&"htmlDocument", &node.span);
    for let item of &node.scriptlet_or_sea_ws_list {
        walk_scriptletOrSeaWs(v, item);
    }
    if let Some(item) = &node.xml {
        v.visit_token(item);
    }
    for let item of &node.scriptlet_or_sea_ws_list_2 {
        walk_scriptletOrSeaWs(v, item);
    }
    if let Some(item) = &node.dtd {
        v.visit_token(item);
    }
    for let item of &node.scriptlet_or_sea_ws_list_3 {
        walk_scriptletOrSeaWs(v, item);
    }
    for let item of &node.html_elements_list {
        walk_htmlElements(v, item);
    }
    v.exit_rule(&"htmlDocument", &node.span);
}

pub fn walk_scriptletOrSeaWs<V: Visitor>(v: &mut V, node: &ScriptletOrSeaWsNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"scriptletOrSeaWs", &n.span);
            v.visit_token(&n.scriptlet);
            v.exit_rule(&"scriptletOrSeaWs", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"scriptletOrSeaWs", &n.span);
            v.visit_token(&n.sea_ws);
            v.exit_rule(&"scriptletOrSeaWs", &n.span);
        }
    }
}

pub fn walk_htmlElements<V: Visitor>(v: &mut V, node: &HtmlElementsNode) {
    v.enter_rule(&"htmlElements", &node.span);
    for let item of &node.html_misc_list {
        walk_htmlMisc(v, item);
    }
    walk_htmlElement(v, &node.html_element);
    for let item of &node.html_misc_list_2 {
        walk_htmlMisc(v, item);
    }
    v.exit_rule(&"htmlElements", &node.span);
}

pub fn walk_htmlElement<V: Visitor>(v: &mut V, node: &HtmlElementNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            v.visit_token(&n.tag_open);
            v.visit_token(&n.tag_name);
            for let item of &n.html_attribute_list {
                walk_htmlAttribute(v, item);
            }
            if let Some(item) = &n.group_0 {
                match item {
                    Alt0(inner) => {
                        v.visit_token(&inner.tag_close);
                        if let Some(item) = &inner.html_content_tag_open_tag_slash_tag_name_tag_close {
                            walk_htmlContent(v, &item.html_content);
                            v.visit_token(&item.tag_open);
                            v.visit_token(&item.tag_slash);
                            v.visit_token(&item.tag_name);
                            v.visit_token(&item.tag_close);
                        }
                    }
                    Alt1(inner) => {
                        v.visit_token(&inner.tag_slash_close);
                    }
                }
            }
            v.exit_rule(&"htmlElement", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            v.visit_token(&n.scriptlet);
            v.exit_rule(&"htmlElement", &n.span);
        }
        Alt2(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            walk_script(v, &n.script);
            v.exit_rule(&"htmlElement", &n.span);
        }
        Alt3(n) => {
            v.enter_rule(&"htmlElement", &n.span);
            walk_style(v, &n.style);
            v.exit_rule(&"htmlElement", &n.span);
        }
    }
}

pub fn walk_htmlContent<V: Visitor>(v: &mut V, node: &HtmlContentNode) {
    v.enter_rule(&"htmlContent", &node.span);
    if let Some(item) = &node.html_chardata {
        walk_htmlChardata(v, item);
    }
    for let item of &node.item_html_chardata_list {
        if let Some(item) = &item.group_0 {
            match item {
                Alt0(inner) => {
                    walk_htmlElement(v, &inner.html_element);
                }
                Alt1(inner) => {
                    v.visit_token(&inner.cdata);
                }
                Alt2(inner) => {
                    walk_htmlComment(v, &inner.html_comment);
                }
            }
        }
        if let Some(item) = &item.html_chardata {
            walk_htmlChardata(v, item);
        }
    }
    v.exit_rule(&"htmlContent", &node.span);
}

pub fn walk_htmlAttribute<V: Visitor>(v: &mut V, node: &HtmlAttributeNode) {
    v.enter_rule(&"htmlAttribute", &node.span);
    v.visit_token(&node.tag_name);
    if let Some(item) = &node.tag_equals_attvalue_value {
        v.visit_token(&item.tag_equals);
        v.visit_token(&item.attvalue_value);
    }
    v.exit_rule(&"htmlAttribute", &node.span);
}

pub fn walk_htmlChardata<V: Visitor>(v: &mut V, node: &HtmlChardataNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlChardata", &n.span);
            v.visit_token(&n.html_text);
            v.exit_rule(&"htmlChardata", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlChardata", &n.span);
            v.visit_token(&n.sea_ws);
            v.exit_rule(&"htmlChardata", &n.span);
        }
    }
}

pub fn walk_htmlMisc<V: Visitor>(v: &mut V, node: &HtmlMiscNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlMisc", &n.span);
            walk_htmlComment(v, &n.html_comment);
            v.exit_rule(&"htmlMisc", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlMisc", &n.span);
            v.visit_token(&n.sea_ws);
            v.exit_rule(&"htmlMisc", &n.span);
        }
    }
}

pub fn walk_htmlComment<V: Visitor>(v: &mut V, node: &HtmlCommentNode) {
    match node {
        Alt0(n) => {
            v.enter_rule(&"htmlComment", &n.span);
            v.visit_token(&n.html_comment);
            v.exit_rule(&"htmlComment", &n.span);
        }
        Alt1(n) => {
            v.enter_rule(&"htmlComment", &n.span);
            v.visit_token(&n.html_conditional_comment);
            v.exit_rule(&"htmlComment", &n.span);
        }
    }
}

pub fn walk_script<V: Visitor>(v: &mut V, node: &ScriptNode) {
    v.enter_rule(&"script", &node.span);
    v.visit_token(&node.script_open);
    v.visit_token(&node.script_body_or_script_short_body);
    v.exit_rule(&"script", &node.span);
}

pub fn walk_style<V: Visitor>(v: &mut V, node: &StyleNode) {
    v.enter_rule(&"style", &node.span);
    v.visit_token(&node.style_open);
    v.visit_token(&node.style_body_or_style_short_body);
    v.exit_rule(&"style", &node.span);
}

pub fn to_tree(node: &HtmlDocumentNode) -> CstNode {
    let mut recorder = TreeRecorder::new();
    walk_htmlDocument(&mut recorder, node);
    return recorder.build();
}

