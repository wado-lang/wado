fn parse_obj(p: &mut Parser) -> Result<ObjNode, ParseError> {
    let start = p.peek().span.start;
    let kind = p.peek_kind();
    if kind == TK_LIT_LBRACE {
        let saved = p.pos;
        let r_0 = parse_obj_bt_0(p);
        if let Err(_) = r_0 {
            p.pos = saved;
        } else {
            return r_0;
