        return parse_obj_bt_1(p);
    }
    return Result::<ObjNode, ParseError>::Err(ParseError::new(
        "expected obj",
        p.peek().span,
        ["TK_LIT_LBRACE"],
    ));
}

fn parse_pair(p: &mut Parser) -> Result<PairNode, ParseError> {
    let start = p.peek().span.start;
    let string = p.expect(TK_STRING, "STRING")?;
    let colon = p.expect(TK_LIT_COLON, "':'")?;
    let value = parse_value(p)?;
    return Result::<PairNode, ParseError>::Ok(PairNode {
        span: Span::new(start, p.last_end()),
        string,
        colon,
        value,
