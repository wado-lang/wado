    if kind == TK_NUMBER {
        let number = p.expect(TK_NUMBER, "NUMBER")?;
        return Result::<ValueNode, ParseError>::Ok(ValueNode::Alt1(ValueAlt1 {
            span: Span::new(start, p.last_end()),
            number,
        }));
