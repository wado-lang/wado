    let start = p.peek().span.start;
    let lbrace = p.expect(TK_LIT_LBRACE, "'{'")?;
    let pair = parse_pair(p)?;
    while p.peek_kind() == TK_LIT_COMMA {
        let tok = p.expect(TK_LIT_COMMA, "','")?;
        let tok_2 = parse_pair(p)?;
    }
    let rbrace = p.expect(TK_LIT_RBRACE, "'}'")?;
    return Result::<ObjNode, ParseError>::Ok(ObjNode::Alt0(ObjAlt0 {
        span: Span::new(start, p.last_end()),
        lbrace,
        pair,
        rbrace,
    }));
}

