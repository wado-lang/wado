use g from "./grammars/ll_at_end_nullable_gap.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_at_end_nullable_gap" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for {*input}`;
    let actual = g::to_string_tree(&result);
    assert actual == *expected, `\ninput:    {*input}\nexpected: {*expected}\nactual:   {actual}`;
}

test "tree: nullable rule between x and its stolen token yields c to caller" {
    assert_tree(&"a b c", &"(s (x a b) nb c)");
}

test "tree: continuing alt still wins when nb consumes its token" {
    assert_tree(&"a b w c", &"(s (x a b) (nb w) c)");
}
