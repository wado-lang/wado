//! A repeat over a repeat collapses to one repeat, and the collapse has one
//! greediness flag where there were two loops'. They do not compose: the outer
//! loop re-enters whatever the inner one stopped short of, so the surviving
//! loop's greediness is the outer one's. Two *skip* decisions do compose —
//! `(X??)?` still prefers to skip — which is the case the fold was written for.
//!
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use nrg from "./grammars/nested_repeat_greedy.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_nested_repeat_greedy" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = nrg::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}`;
    let actual = nrg::to_string_tree(&result);
    assert actual == *expected, `\ninput:    ${*input}\nexpected: ${*expected}\nactual:   ${actual}`;
}

// The three `+`-then-`'x'` arms are one grammar spelled three ways, and they
// agree because the plain `'d'` arm does: a greedy `+` whose first set holds
// the token its suffix needs leaves it (`RepeatOp.reserve_scan`). Propagating
// the inner `+?` would answer `'a'` alone, and the jar says all three agree.

test "nested repeat: a non-greedy inner loop does not make the outer one non-greedy" {
    assert_tree(&"a x x", &"(s a x x)");
    assert_tree(&"a x x x", &"(s a x x x)");
}

test "nested repeat: the all-greedy twin reads the same" {
    assert_tree(&"b x x", &"(s b x x)");
    assert_tree(&"b x x x", &"(s b x x x)");
}

test "nested repeat: and so does the plain form they collapse to" {
    assert_tree(&"d x x", &"(s d x x)");
    assert_tree(&"d x x x", &"(s d x x x)");
}

test "nested repeat: two skip decisions still prefer to skip" {
    assert_tree(&"e y", &"(s e y)");
    assert_tree(&"e x y", &"(s e x y)");
}

// An outer `?` is not a loop, so the inner loop's preference is the one that
// survives — `('x'+?)?` stays non-greedy where `('x'+?)+` does not. The greedy
// spelling collapses to the plain `'x'* 'x'`, and reaches the same trees the
// other way: the loop reserves the suffix the non-greedy one stops short of.

test "nested repeat: an outer ? keeps the inner loop's preference" {
    assert_tree(&"f x", &"(s f x)");
    assert_tree(&"f x x", &"(s f x x)");
}

test "nested repeat: the greedy twin under an outer ? reserves the same suffix" {
    assert_tree(&"g x", &"(s g x)");
    assert_tree(&"g x x", &"(s g x x)");
}
