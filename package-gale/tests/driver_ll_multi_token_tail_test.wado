use g from "./grammars/ll_multi_token_tail.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/ll_multi_token_tail",
        },
    };
use { normalize_tree } from "./grammars/ll_multi_token_tail.g4";

fn assert_tree(input: &String, expected: &String) {
    let root = g::parse(input).unwrap();
    let tree = g::to_tree(&root);
    let actual = tree.to_string_tree();
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    {*input}\nexpected: {norm}\nactual:   {actual}`;
}

// GAP: `a`'s `(X Y)+` greedy loop swallows the trailing `X Y` that the
// caller's `c : X Y Z` needs. ANTLR4 LL's per-decision lookahead sees
// that consuming a second iter leaves only `Z` for `c` and so picks the
// shorter `a`. Gale today has no variant for `a`'s tail-greedy because
// the inner is multi-token — soundness invariant 1 in
// `antlr4-compatibility.md`. Lift the `#[TODO]` once
// `tail_greedy_first_of_element` admits multi-token inners (see
// `TODO.md`'s "Multi-token tail-greedy inner" entry).
#[TODO]
test "tree: N X Y X Y Z — multi-token tail-greedy yields to caller" {
    assert_tree(&"N X Y X Y Z", &"
        (r (a N X Y) (c X Y Z))
    ");
}
