//! Stage 2b migration probe: mode_gaps (lexer modes — default vs string mode).
use g from "./grammars/mode_gaps.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "./generated/cst_mode_gaps",
        },
    };
fn ok(input: &String) {
    assert g::parse(input).ok(), `unexpected diagnostics for {*input}`;
}
test "mode-gaps: bare word" {
    ok(&"foo");
}
test "mode-gaps: string" {
    ok(&"\"hello\"");
}
test "mode-gaps: string with escape" {
    ok(&"\"a\\nb\"");
}
test "mode-gaps: word string word" {
    ok(&"foo \"bar\" baz");
}
test "mode-gaps: empty string" {
    ok(&"\"\"");
}
