//! Stage C: a `language = Wado` print action executes during the parse and
//! its text is surfaced on `ParseResult.output`. Drives the end-to-end path:
//! `execute_actions` generator option → `Parser.emit` / `output` field →
//! action body emitted inline (guarded on `!p.speculating`) → threaded onto
//! the returned `ParseResult`.

use wa from "./grammars/wado_action.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false, execute_actions: true },
            output_dir: "./generated/action_emit",
        },
    };

test "wado actions emit into ParseResult.output in execution order" {
    let result = wa::parse(&"a b");
    assert result.ok(), "clean parse";
    // Mid-alt `{p.emit("hi")}` then alt-final `{p.emit("!")}`.
    assert result.output == "hi!", `output: '{result.output}'`;
}

test "recovery that still traverses an action executes it" {
    // Missing `A`: error recovery inserts it, so the op path still reaches
    // both actions — they run, matching the design's "executes iff the op
    // path reaches it normally".
    let result = wa::parse(&"b");
    assert !result.ok(), "recovered parse reports the missing token";
    assert result.output == "hi!", `output on recovered parse: '{result.output}'`;
}
