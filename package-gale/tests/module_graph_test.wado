//! The generator's modules import one another without a cycle, and the parser
//! emit imports nothing of the surface IR. Either is how one phase comes to
//! hold another's state: `gen_context` once reached `lower` through
//! `recovery_sets` and `atn`, and the context it carried was filled half by
//! lowering and half by emit.

use fs from "core:fs";
use { Preopens } from "core:fs";
use { HashMap } from "core:collections";

/// The relative `.wado` paths a module's `use` items name, as written.
fn imported_paths(source: &String) -> List<String> {
    let mut out: List<String> = [];
    for let line of source.lines() {
        if line.trim_start().starts_with("//") {
            continue;
        }
        let Some([_, rest]) = line.split_once("from \"") else {
            continue;
        };
        let Some([target, _]) = rest.split_once("\"") else {
            continue;
        };
        if (target.starts_with("./") || target.starts_with("../")) && target.ends_with(".wado") {
            out.push(target.to_string());
        }
    }
    return out;
}

/// Each non-test module under `root` with the modules it imports.
fn import_graph<S: AsStrSlice>(root: S) -> HashMap<String, List<String>> with Preopens {
    let mut graph = HashMap::<String, List<String>>::new();
    for let entry of fs::walk_dir(root).unwrap() {
        let path = entry.unwrap().path;
        if !path.ends_with(".wado") || path.ends_with("_test.wado") {
            continue;
        }
        let dir = fs::parent(&path).unwrap();
        let mut targets: List<String> = [];
        for let target of imported_paths(&fs::read_to_string(&path).unwrap()) {
            targets.push(fs::normalize(fs::join(&dir, &target)).unwrap());
        }
        graph[path] = targets;
    }
    return graph;
}

/// A cycle through `node`, as the path that closes it, or empty.
fn find_cycle(
    graph: &HashMap<String, List<String>>,
    node: &String,
    stack: &mut List<String>,
    done: &mut List<String>,
) -> List<String> {
    if done.contains(node) {
        return [];
    }
    for let mut i = 0; i < stack.len(); i += 1 {
        if stack[i] == *node {
            let mut cycle: List<String> = [];
            for let mut j = i; j < stack.len(); j += 1 {
                cycle.push(stack[j]);
            }
            cycle.push(*node);
            return cycle;
        }
    }
    stack.push(*node);
    if let Some(targets) = graph.get(*node) {
        for let target of targets {
            let cycle = find_cycle(graph, &target, stack, done);
            if !cycle.is_empty() {
                return cycle;
            }
        }
    }
    stack.pop();
    done.push(*node);
    return [];
}

/// The names `source` imports from the module it names `target`, as written.
fn names_imported_from<S: AsStrSlice>(source: &String, target: S) -> List<String> {
    let mut out: List<String> = [];
    let marker = `} from "${target}"`;
    let mut rest = source.as_str_slice();
    while let Some(end) = rest.find(&marker) {
        let head = rest.slice(0, end);
        let start = head.rfind("use {").unwrap() + "use {".len();
        for let name of head.slice(start, head.len()).split(",") {
            if !name.trim().is_empty() {
                out.push(name.trim().to_string());
            }
        }
        rest = rest.slice(end + marker.len(), rest.len());
    }
    return out;
}

test "names_imported_from reads a one-line and a multi-line import" {
    let source = "use { A, B } from \"./ir.wado\";\nuse {\n    C,\n    D,\n} from \"./ir.wado\";\nuse { E } from \"./gir.wado\";\n";
    assert names_imported_from(&source, "./ir.wado") == ["A", "B", "C", "D"] as List<String>;
}

test "the parser emit reads the GIR, not the surface IR" {
    let surface: List<String> = ["Grammar", "ParserRule", "Alternative", "Element"];
    let emit = [
        "action_gen", "cst_gen", "emit_context", "kind_set_gen", "parser_gen", "parser_plan", "parser_runtime_gen",
    ];
    for let module of emit {
        let source = fs::read_to_string(`src/${module}.wado`).unwrap();
        for let name of &names_imported_from(&source, "./ir.wado") {
            assert !surface.contains(name), `${module} imports ${name}`;
        }
    }
}

test "the generator's modules import one another without a cycle" {
    let graph = import_graph("src");
    assert graph.len() > 50;
    for let [_, targets] of graph.entries() {
        for let target of targets {
            assert graph.contains_key(*target);
        }
    }
    let mut done: List<String> = [];
    for let [module, _] of graph.entries() {
        let mut stack: List<String> = [];
        let cycle = find_cycle(&graph, module, &mut stack, &mut done);
        assert cycle.is_empty();
    }
}
