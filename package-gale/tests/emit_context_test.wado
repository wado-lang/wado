use { ParserRule } from "../src/ir.wado";
use { EmitContext } from "../src/emit_context.wado";
use { GrammarAnalysis } from "../src/grammar_analysis.wado";
use { GenSettings } from "../src/gen_settings.wado";
use { RuleFollow } from "../src/follow_env.wado";
use { TableRegistry } from "../src/table_registry.wado";
use { ParserPlan } from "../src/parser_plan.wado";
use { decision_predicates } from "../src/gate_conditions.wado";
use { Diagnostics, admits_is_untestable, admits_or_everything, admits_or_untestable } from "../src/gir.wado";
use { readings_of_position } from "../src/readings.wado";

fn mk_ctx() -> EmitContext {
    let rules: List<ParserRule> = [];
    let mut analysis = GrammarAnalysis::new(&rules);
    let decisions = decision_predicates(&GenSettings {}, &mut analysis);
    return EmitContext::new(
        analysis,
        GenSettings {},
        RuleFollow::unknown(),
        TableRegistry::new(),
        Diagnostics {},
        ParserPlan {},
        decisions,
    );
}

fn ids(ctx: &mut EmitContext, names: List<String>) -> List<i32> {
    return ctx.analysis.token_ids_of(&names);
}

/// The id a site reading one `kind` interns as.
fn intern_site(ctx: &mut EmitContext, kind: String) -> i32 {
    return ctx.tables.intern_follow_site(readings_of_position(&ids(ctx, [kind]), 4));
}

test "an empty set is not a condition until the site says what it admits" {
    // The set does not carry the answer; the site does.
    let mut ctx = mk_ctx();
    let empty: List<i32> = [];
    // Both render `true`; they are still not the same answer. One admits every
    // token and may keep its place among the arms, the other cannot be decided
    // and belongs after every arm that can.
    let exact = admits_or_everything(&empty);
    let undecidable = admits_or_untestable(&empty);
    assert ctx.admits_check_str(&exact, "k") == "true", "a wildcard admits every token";
    assert ctx.admits_check_str(&undecidable, "k") == "true", "an untestable arm has no test to render";
    assert !admits_is_untestable(&exact), "a wildcard decides; ordering it last loses the lowest-alternative rule";
    assert admits_is_untestable(&undecidable), "an arm with no first set does not decide";
}

test "a non-empty set renders the same either way" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO"]);
    let narrows = ctx.admits_check_str(&admits_or_everything(&toks), "k");
    let selects = ctx.admits_check_str(&admits_or_untestable(&toks), "k");
    assert narrows == "k == TK_FOO", "expected \"k == TK_FOO\"";
    assert selects == narrows, "which reading an empty set takes cannot change a non-empty one";
}

/// The kind-set helpers the checks so far defined, as written.
fn kind_set_fns_text(ctx: &mut EmitContext) -> String {
    return ctx.take_kind_set_fns().to_string();
}

test "kind_check_str: single token uses '==' not 'matches'" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO"]);
    let s = ctx.kind_check_str(&toks, "kind");
    assert s == "kind == TK_FOO", "expected \"kind == TK_FOO\"";
    assert kind_set_fns_text(&mut ctx) == "", "a single-token check defines no helper";
}

test "kind_check_str: multi-token uses helper call" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO", "TK_BAR"]);
    let s = ctx.kind_check_str(&toks, "k");
    assert s == "_kind_set_0(k)", "expected helper call";
    assert kind_set_fns_text(&mut ctx).contains("fn _kind_set_0(k: i32) -> bool {");
}

test "a kind set names one helper, in first-seen order" {
    let mut ctx = mk_ctx();
    let ab = ids(&mut ctx, ["TK_A", "TK_B"]);
    let cd = ids(&mut ctx, ["TK_C", "TK_D"]);
    assert ctx.kind_check_str(&ab, "k") == "_kind_set_0(k)";
    assert ctx.kind_check_str(&cd, "k") == "_kind_set_1(k)";
    assert ctx.kind_check_str(&ab, "k") == "_kind_set_0(k)";
    let text = kind_set_fns_text(&mut ctx);
    assert text.find("fn _kind_set_0").unwrap() < text.find("fn _kind_set_1").unwrap();
    assert !text.contains("_kind_set_2");
}

test "a kind set's order and duplicates do not make another helper" {
    let mut ctx = mk_ctx();
    let abc = ids(&mut ctx, ["TK_A", "TK_B", "TK_C"]);
    let cab = ids(&mut ctx, ["TK_C", "TK_A", "TK_B", "TK_A"]);
    assert ctx.kind_check_str(&abc, "k") == ctx.kind_check_str(&cab, "k");
    assert !kind_set_fns_text(&mut ctx).contains("_kind_set_1");
}

#[expect_trap]
test "a kind-set check after the helpers are taken traps, as its helper would never be placed" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_A", "TK_B"]);
    ctx.take_kind_set_fns();
    ctx.kind_check_str(&toks, "k");
}

test "a kind-set helper matches its tokens sorted by name" {
    let mut ctx = mk_ctx();
    let unsorted = ids(&mut ctx, ["TK_C", "TK_A", "TK_B"]);
    ctx.kind_check_str(&unsorted, "k");
    assert kind_set_fns_text(&mut ctx).contains("return k matches { == TK_A | == TK_B | == TK_C };");
}

test "a table reference belongs to the innermost function frame, else to the root" {
    let mut ctx = mk_ctx();
    let outer_site = intern_site(&mut ctx, "TK_X");
    let inner_site = intern_site(&mut ctx, "TK_Y");
    ctx.follow_site_ref(outer_site);
    ctx.cursor.begin_ref_frame();
    ctx.cursor.begin_ref_frame();
    assert ctx.follow_site_ref(inner_site) == "FOLLOW_SITE_1";
    let inner = ctx.cursor.end_ref_frame();
    let outer = ctx.cursor.end_ref_frame();
    assert inner.contains("FOLLOW_SITE_1") && inner.len() == 1;
    assert outer.len() == 0;
    let root = ctx.cursor.take_root_refs();
    assert root.contains("FOLLOW_SITE_0") && root.len() == 1;
}

test "kind_negate_check_str: single token uses '!='" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_FOO"]);
    let s = ctx.kind_negate_check_str(&toks, "k");
    assert s == "k != TK_FOO", "expected \"k != TK_FOO\"";
    assert kind_set_fns_text(&mut ctx) == "";
}

test "kind_negate_check_str: multi-token uses negated helper" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_A", "TK_B"]);
    let s = ctx.kind_negate_check_str(&toks, "k");
    assert s == "!_kind_set_0(k)", "expected negated helper";
    assert kind_set_fns_text(&mut ctx).contains("fn _kind_set_0(k: i32) -> bool {");
}

test "kind_negate_check_str: shares ids with kind_check_str" {
    let mut ctx = mk_ctx();
    let toks = ids(&mut ctx, ["TK_A", "TK_B"]);
    let pos = ctx.kind_check_str(&toks, "k");
    let neg = ctx.kind_negate_check_str(&toks, "k");
    // Both reference the same helper id, just with/without the leading `!`.
    assert pos == "_kind_set_0(k)";
    assert neg == "!_kind_set_0(k)";
    assert !kind_set_fns_text(&mut ctx).contains("_kind_set_1"), "positive and negative must share";
}
