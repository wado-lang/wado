//! An empty alternative has no first set to be selected by: what selects it is
//! what may follow the group, and its alternative index is what ranks it
//! against the alternatives that do have one.
//!
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use eam from "./grammars/empty_alt_mid.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_empty_alt_mid" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = eam::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input}`;
    let actual = eam::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input}\nexpected: ${expected}\nactual:   ${actual}`;
}

test "empty-alt: a first set that matches selects its alternative" {
    assert_tree("k a", "(s k a)");
}

test "empty-alt: an alternative after the empty one is still reachable" {
    // The regression: `EOF` alone may follow the group, so `b` does not select
    // the empty alternative and `B` is what remains.
    assert_tree("k b", "(s k b)");
}

test "empty-alt: the follow set selects the empty alternative" {
    assert_tree("k", "(s k)");
}

test "empty-alt: a first set still beats skipping" {
    assert_tree("m a", "(s m a x)");
}

test "empty-alt: the lowest alternative that lets the rule complete wins" {
    // `x` is nullable, so `A`, the empty alternative and `B` all admit `a` and
    // `b`, and the lookahead cannot separate them.
    assert_tree("m a b", "(s m a (x b))");
    assert_tree("m b a", "(s m b (x a))");
}

test "empty-alt: nothing to scan leaves the empty alternative" {
    assert_tree("m", "(s m x)");
}

test "empty-alt: a viable empty alternative outranks a longer later one" {
    // Both complete, so the empty alternative (index 1) beats `B` (index 2)
    // and `x` takes the `b`.
    assert_tree("m b", "(s m (x b))");
}
