//! An alternative whose head is a rule reference with an all-optional body.
//!
//! `fnDecl : mods 'fn' ID ';'` with `mods : 'pub'?` puts a nullable rule
//! reference at the front of `member`'s second alternative, so `FIRST(member)`
//! only contains `'fn'` if it is computed *through* the nullable reference.
//! Gale stops at `mods`, so the `member*` loop declines to enter on a bare
//! `fn` and `prog` reports "expected Eof". ANTLR4 parses it.

use g from "./grammars/ll_nullable_rule_head.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_nullable_rule_head" },
    };

fn assert_parses(input: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}: ${result.diagnostics:?}`;
}

// Control: the nullable rule matches something, so `FIRST` never has to see
// past it.
test "a present modifier reaches the fn" {
    assert_parses(&"pub fn a;");
}

#[TODO]
test "an absent modifier still reaches the fn" {
    assert_parses(&"fn a;");
}

test "the sibling alternative is unaffected" {
    assert_parses(&"type T;");
}

#[TODO]
test "both members in one file" {
    assert_parses(&"type T; fn a; pub fn b;");
}
