//! Stage 2 corpus migration: `opt_sep_list.g4` exercises a nested optional
//! separated list — `(arm (',' arm)* ','?)?` — plus a Direct multi-alt
//! (`wrapped : braced | arm`), all non-ATN, through the emitter.

use osl from "./grammars/opt_sep_list.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_opt_sep_list" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = osl::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = osl::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "opt-sep-list: empty list" {
    assert_tree("", "(prog list)");
}

test "opt-sep-list: single arm" {
    assert_tree("a", "(prog (list (arm a)))");
}

test "opt-sep-list: comma-separated arms" {
    assert_tree("a , b", "(prog (list (arm a) , (arm b)))");
}

test "opt-sep-list: trailing comma yields to the optional `,?`" {
    assert_tree("a , b ,", "(prog (list (arm a) , (arm b) ,))");
}
