//! `<rule>_alt` returns `Option`, and this pins *why* it must — rather than
//! panicking — on a node whose alternative was never stamped.
//!
//! The error-resilient parser opens a rule node before it dispatches and closes
//! it even when no alternative matches (fail-soft), so an error parse leaves
//! `expr` nodes with `alt` unset (-1) in the tree. A consumer reading that tree
//! must see them as `None` — not a crash, and not a silent first alternative.
//! A clean parse stamps every `expr` node, so the accessor returns
//! `Some(<label>)` there.

use ao from "./grammars/alt_opt.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "./generated/cst_alt_option",
        },
    };

// Count stamped `expr` nodes (alt >= 0), asserting each maps to `Some`. A flat
// scan over the store's open rows; no node value is ever constructed.
fn count_stamped(s: &ao::CstStore) -> i32 {
    let mut n = 0;
    for let mut r = 0; r < s.row_count(); r += 1 {
        if s.is_node(r) && s.kind(r) == ao::RK_EXPR && s.alt(r) >= 0 {
            assert s.expr_alt(r) matches { Some(_) }, `stamped expr (alt={s.alt(r)}) must map to Some`;
            n += 1;
        }
    }
    return n;
}

// Count unstamped `expr` nodes (alt < 0), asserting each maps to `None`.
fn count_unstamped(s: &ao::CstStore) -> i32 {
    let mut n = 0;
    for let mut r = 0; r < s.row_count(); r += 1 {
        if s.is_node(r) && s.kind(r) == ao::RK_EXPR && s.alt(r) < 0 {
            assert s.expr_alt(r) matches { None }, "unstamped expr must map to None, not a silent first alt";
            n += 1;
        }
    }
    return n;
}

test "a stamped expr node maps to Some(label)" {
    let result = ao::parse(&"(42)");
    assert result.ok(), "clean input should parse without diagnostics";
    // Outer Paren expr + inner Num expr, both stamped; none unstamped.
    assert count_stamped(&result.cst) == 2;
    assert count_unstamped(&result.cst) == 0;
}

test "an unstamped error-recovery expr node maps to None, not a silent first alt" {
    // `( )`: the inner expr position's lookahead `)` matches no alternative,
    // so the parser opens an RK_EXPR node, picks no alt, and closes it with
    // alt unset. Were the accessor to panic, this test would crash; were it
    // to fall back to the first label, count_unstamped's assert would fail.
    let result = ao::parse(&"()");
    assert !result.ok(), "`( )` is a syntax error";
    assert count_unstamped(&result.cst) >= 1, "expected an unstamped expr node in the error tree";
}
