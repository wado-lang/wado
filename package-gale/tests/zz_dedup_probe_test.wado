use z from "./grammars/zz_dedup_probe.g4"
    with { generator: { module: "../src/generator.wado", options: { highlight: false }, output_dir: "./generated/zz_dedup_probe" } };
test "dedup probe" {
    let r = z::parse(&"e n");
    assert r.ok(), "parse";
    assert r.output == "v=7", `output: '{r.output}'`;
}
