//! Stage 2b migration: precedence climbing with a right-associative operator
//! (`^`) alongside a left-associative one (`+`). The LR loop must
//! nest `^` to the right and `+` to the left, matching the typed tree.

use ra from "./grammars/right_assoc_gaps.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_right_assoc_gaps" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = ra::parse(input);
    assert result.ok(), `unexpected diagnostics for {*input}`;
    let actual = ra::to_string_tree(&result);
    assert actual == *expected, `\ninput:    {*input}\nexpected: {*expected}\nactual:   {actual}`;
}

test "right-assoc: single atom" {
    assert_tree(&"42", &"(expr 42)");
}
test "right-assoc: left-associative +" {
    assert_tree(&"1 + 2 + 3", &"(expr (expr (expr 1) + (expr 2)) + (expr 3))");
}
test "right-assoc: ^ nests right" {
    assert_tree(&"2 ^ 3 ^ 4", &"(expr (expr 2) ^ (expr (expr 3) ^ (expr 4)))");
}
test "right-assoc: four-level ^ chain" {
    assert_tree(&"2 ^ 3 ^ 4 ^ 5", &"(expr (expr 2) ^ (expr (expr 3) ^ (expr (expr 4) ^ (expr 5))))");
}
test "right-assoc: mixed + and ^" {
    assert_tree(&"1 + 2 ^ 3 ^ 4", &"(expr (expr 1) + (expr (expr 2) ^ (expr (expr 3) ^ (expr 4))))");
}
