//! sink_v2 parity on rule-level tournament dispatch (longest-match scan) — the
//! prediction emission is reused verbatim; only the leaf/alt actions differ.

use t from "./grammars/amb_tour.g4"
    with { generator: { module: "../src/generator.wado", options: { highlight: false, homogeneous: true, sink_v2: true }, output_dir: "tests/generated/cst_v2_tour" } };
fn assert_tree(input: &String, expected: &String) {
    let result = t::parse(input);
    assert result.ok(), `unexpected diagnostics for {*input}`;
    let actual = t::to_string_tree(&result);
    assert actual == *expected, `\ninput:    {*input}\nexpected: {*expected}\nactual:   {actual}`;
}
test "v2-tour: assignment wins on '='" { assert_tree(&"x = 5", &"(prog (stat x = (expr 5)))"); }
test "v2-tour: bare identifier expr" { assert_tree(&"x", &"(prog (stat (expr x)))"); }
test "v2-tour: bare integer expr" { assert_tree(&"42", &"(prog (stat (expr 42)))"); }
