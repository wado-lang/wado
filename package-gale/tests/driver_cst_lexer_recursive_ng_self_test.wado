//! The recursive non-greedy shape as one rule, where the recursion is the entry
//! rule's own.
//!
//! `STR : '#' STR '#' | '"' .*? '"'` is `lexer_recursive_ng_fragment.g4`'s
//! grammar with the fragment folded in. The recursion and the `.*?` are still
//! separate alternatives and the loop still has to stop at a `"` that is a
//! different one at each `#` depth, so the rule is ATN-class for the same
//! reason. Reaching it through a fragment is the only route Gale takes:
//! `lexer_rule_is_atn_class` seeds its reachability walk with the entry rule, so
//! the walk answers `false` at exactly the reference it is looking for when the
//! entry rule *is* the recursion.
//!
//! Removing that seed routes this correctly, and also routes
//! `CMT : '//' .*? '\n' CMT*` to the ATN, where the loop ends at `'\n'` at every
//! depth and the static path is right. Which trigger the two shapes should share
//! is an open question, so the hashed cases below are `#[TODO]`.

use g from "./grammars/lexer_recursive_ng_self.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_lexer_recursive_ng_self" },
    };

fn kinds(input: &String) -> List<String> {
    let tokens = g::tokenize(input);
    let mut out: List<String> = [];
    for let mut i = 0; i < tokens.len(); i += 1 {
        out.push(g::token_kind_name(tokens.kinds[i]));
    }
    return out;
}

fn assert_kinds(input: &String, expected: &List<String>) {
    let actual = kinds(input);
    assert actual == *expected, `\ninput:    ${*input}\nexpected: ${*expected}\nactual:   ${actual}`;
}

// Unhashed, so the `.*?` has only one `"` to stop at and the static path is
// already right. Asserted outside the `#[TODO]`s so a regression here fails
// rather than staying pending.
test "an unhashed string is one token" {
    assert_kinds(&"\"abc\"", &["STR", "Eof"]);
}

#[TODO]
test "a quoted hash-delimited string is one token" {
    assert_kinds(&"#\"a \"b\" c\"#", &["STR", "Eof"]);
}

#[TODO]
test "two hashes nest the same way" {
    assert_kinds(&"##\"a \"#\" b\"##", &["STR", "Eof"]);
}
