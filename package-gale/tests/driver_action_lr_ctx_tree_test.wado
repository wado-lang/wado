//! Stage A `$ctx.toStringTree()` on a LEFT-RECURSIVE rule. Precedence climbing
//! closes each level's node before `@after` runs, so the render must read the
//! most-recently-finished node (the LR context), not the open stack.

use lct from "./grammars/wado_lr_ctx_tree.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/action_lr_ctx_tree" },
    };

test "$ctx.toStringTree renders the LR node at a single (atom-only) level" {
    let result = lct::parse(&"1");
    assert result.ok(), "clean parse of 1";
    // `e` is the start rule, so at `@after` the open stack is empty; the render
    // must still produce the just-closed `e` node, not "".
    assert result.output == "[(e 1)]", `output: '${result.output}'`;
    assert result.output == `[${lct::to_string_tree(&result)}]`, `render mismatch: '${result.output}'`;
}

test "$ctx.toStringTree renders each LR level's own node" {
    let result = lct::parse(&"1 + 2");
    assert result.ok(), "clean parse of 1 + 2";
    // One `@after` per precedence level: the two atoms, then the wrapping node.
    // The outermost render is the whole expression.
    assert result.output.contains("[(e (e 1) + (e 2))]"), `output: '${result.output}'`;
}
