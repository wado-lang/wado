//! A mid-alternative self-reference in a left-recursive alternative is a full
//! sub-expression (`e[0]`), so it climbs a shared delimiter while the enclosing
//! alternative can still find its own. Expected trees are the published ANTLR4
//! jar's (black-box oracle).
//!
//! The operand's loop is decided without the simulator: it climbs greedily and
//! stops at the last iteration boundary where a scan of what its alternative
//! still needs succeeds.

use g from "./grammars/lr_mid_operand.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_lr_mid_operand" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok();
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string();
}

test "between's middle operand stops at the enclosing and" {
    assert_tree("a between b and c", "(s (e (e a) between (e b) and (e c)))");
}

test "between's middle operand climbs the shared and when one is left over" {
    assert_tree("a between b and c and d", "(s (e (e a) between (e (e b) and (e c)) and (e d)))");
}

// The climb that must stop sits in a nested operand, below a looser `or`.
test "a nested operand leaves between its and" {
    assert_tree(
        "a between b or c and d and e",
        "(s (e (e a) between (e (e b) or (e (e c) and (e d))) and (e e)))",
    );
}

test "between's trailing operand takes a looser operator" {
    assert_tree("a between b and c or d", "(s (e (e a) between (e b) and (e (e c) or (e d))))");
    assert_tree("a or b between c and d or e", "(s (e (e (e a) or (e b)) between (e c) and (e (e d) or (e e))))");
    assert_tree(
        "a between b and c and d or e",
        "(s (e (e a) between (e (e b) and (e c)) and (e (e d) or (e e))))",
    );
    assert_tree(
        "a between b and c between d and e",
        "(s (e (e (e a) between (e b) and (e c)) between (e d) and (e e)))",
    );
}

// The inner middle operand must leave an `and` to each enclosing `between`.
test "a mid operand holding another mid-operand alternative" {
    assert_tree(
        "a between b between c and d and e",
        "(s (e (e a) between (e (e b) between (e c) and (e d)) and (e e)))",
    );
    assert_tree(
        "a between b between c and d and e and f",
        "(s (e (e a) between (e (e b) between (e (e c) and (e d)) and (e e)) and (e f)))",
    );
    assert_tree(
        "a between b between c between d and e and f and g",
        "(s (e (e a) between (e (e b) between (e (e c) between (e d) and (e e)) and (e f)) and (e g)))",
    );
    assert_tree(
        "a between b or c between d and e and f",
        "(s (e (e a) between (e (e (e b) or (e c)) between (e d) and (e e)) and (e f)))",
    );
    assert_tree(
        "a between b and c between d and e and f",
        "(s (e (e a) between (e (e (e b) and (e c)) between (e d) and (e e)) and (e f)))",
    );
    assert_tree(
        "a between b between c and d or e and f",
        "(s (e (e a) between (e (e b) between (e c) and (e (e d) or (e e))) and (e f)))",
    );
}

test "binary and chains left-associatively" {
    assert_tree("a and b and c", "(s (e (e (e a) and (e b)) and (e c)))");
}

// Each operand in the chain stops by itself, so finding where the middle
// operand stops reads the chain once rather than from every operand.
test "a long chain after a mid operand parses" {
    for let op of ["and", "or"] {
        let mut input = "a between b and c";
        for let _ of 0..<2000 {
            input.push_str(` ${op} c`);
        }
        assert g::parse(&input).ok();
    }
}
