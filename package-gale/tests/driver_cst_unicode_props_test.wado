//! Stage 2b migration: unicode_props parses through the emitter.
use g from "./grammars/unicode_props.g4"
    with { generator: { module: "../src/generator.wado", options: { highlight: false }, output_dir: "tests/generated/cst_unicode_props" } };
fn ok(input: &String) { assert g::parse(input).ok(), `unexpected diagnostics for {*input}`; }
test "unicode: ascii word" { ok(&"hello"); }
test "unicode: digits" { ok(&"12345"); }
test "unicode: word and number" { ok(&"foo 42"); }
test "unicode: latin accents" { ok(&"café"); ok(&"naïve"); ok(&"résumé"); }
test "unicode: greek" { ok(&"αβγδε"); ok(&"ΑΒΓΔΕ"); }
test "unicode: cyrillic" { ok(&"Привет"); }
test "unicode: cjk" { ok(&"世界"); ok(&"日本語"); ok(&"ひらがな"); }
