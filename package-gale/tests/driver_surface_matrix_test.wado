//! The surface matrix: fixtures whose job is to be *compiled*.
//!
//! Every defect the matrix was added for had one signature — generation
//! succeeded and the generated module did not compile. `src/*_test.wado` asserts
//! on emitted text, which cannot see that, and a driver test only sees it for a
//! grammar someone had already written. These fixtures exist so each action
//! surface has been through the Wado compiler at least once: importing them is
//! the assertion, and the bodies below only prove the generated code also runs.

use acts from "./grammars/surface_actions.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/surface_actions" },
    };
use names from "./grammars/surface_names.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/surface_names" },
    };
use lexmem from "./grammars/surface_lexer_members.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/surface_lexer_members" },
    };

test "the action surface compiles and runs" {
    // `bump` through the value channel and `label` across the second members
    // block, plus the lexer action's own print.
    let r = acts::parse("( x");
    assert r.ok();
    assert r.output == "open\nn=1\n";
}

test "elements named after generated locals compile and parse" {
    let one = names::parse("p k");
    assert one.ok();
    assert one.output == "one";

    let two = names::parse("v f m");
    assert two.ok();
    assert two.output == "two";

    let three = names::parse("m + m");
    assert three.ok();
    assert three.output == "three";
}

test "a members-only lexer compiles and tokenizes" {
    let ts = lexmem::tokenize("a b");
    assert ts.len() == 3;
}
