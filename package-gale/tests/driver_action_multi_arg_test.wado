//! Stage C multi-alt rule argument + overlap-group @init: the arg (`e[100]`)
//! and the @init seed (`$acc = $base`) thread through the `_alt_<n>` dispatch
//! helpers, so an alt in an overlapping group (`A B` vs `A C`) still sees them.

use ma from "./grammars/wado_multi_arg.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            output_dir: "./generated/action_multi_arg",
        },
    };

test "arg and @init seed reach an overlapping alt via the _alt_n helper" {
    let ab = ma::parse(&"a b");
    assert ab.ok(), "clean parse of a b";
    assert ab.output == "sum=100", `output: '{ab.output}'`;

    let ac = ma::parse(&"a c");
    assert ac.ok(), "clean parse of a c";
    assert ac.output == "alt2 100", `output: '{ac.output}'`;

    let d = ma::parse(&"d");
    assert d.ok(), "clean parse of d";
    assert d.output == "d 100", `output: '{d.output}'`;
}
