//! Stage 2b: the Rust ATN-class grammar parses homogeneously end-to-end.
use rust from "./grammars/RustLexer.g4"
    with { generator: { module: "../src/generator.wado",
        inputs: ["./grammars/RustParser.g4"],
        options: { highlight: false, homogeneous: true },
        output_dir: "tests/generated/cst_rust" } };

test "rust: const item parses clean" {
    let r = rust::parse(&"const X: i32 = if return { 1 } else { 2 };");
    assert r.ok(), `unexpected diagnostics`;
}
