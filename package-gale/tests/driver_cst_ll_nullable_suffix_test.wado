use g from "./grammars/ll_nullable_suffix.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_nullable_suffix" },
    };

fn assert_tree(input: &String, expected: &String) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${*input}`;
    let actual = g::to_string_tree(&result);
    assert actual == *expected, `\ninput:    ${*input}\nexpected: ${*expected}\nactual:   ${actual}`;
}

// The caller's `b?` and the callee's own `Y?` compete for the same `Y`, and
// `driver_cst_ll_greedy_optional_cross_rule_test` is that shape with the
// opposite answer: there ANTLR4's greedy subrule gives the token to the
// innermost, here full-context LL gives it to alt 0's `b?`. The static
// evidence at the call site is identical — mask `{Y, EOF}` against mask
// `{'else', ';'}` — so one policy has to lose, and greedy is the one a real
// grammar depends on. Deciding it needs the runtime ATN simulator.
#[TODO]
test "tree: X Y picks (a b?) under LL" {
    assert_tree(&"X Y", &"(r (a X) (b Y))");
}
