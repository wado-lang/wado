use g from "./grammars/ll_nullable_suffix.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_ll_nullable_suffix" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = g::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = g::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

// Pinned against the published jar: `antlr4-oracle.sh ll_nullable_suffix.g4 r`
// on `X Y` prints `(r (a X Y) <EOF>)`. Both readings complete, so `Y?` is a
// greedy subrule over an ambiguity and takes the token —
// `driver_cst_ll_greedy_optional_cross_rule_test` is the same rule with the
// `else`.
test "tree: X Y is the greedy subrule's, not the caller's b?" {
    assert_tree(&"X Y", &"(r (a X Y))");
}
