use sexpression from "./grammars/sexpression.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/sexpression",
        },
    };
use { SexprNode, ItemNode, AtomNode, TK_NUMBER, TK_SYMBOL, TK_EOF } from "./grammars/sexpression.g4";

// Terminals in the typed AST are `i32` indices into `ParseResult.tokens`;
// assert each atom's kind/text through the stream rather than comparing a
// hand-built Token-valued tree.
test "parse single symbol atom" {
    let r = sexpression::parse(&"hello").unwrap();
    let root = &r.root;
    assert root.item_list.len() == 1;
    if let Alt0(item) = &root.item_list[0] {
        assert r.tokens.kinds[item.atom.token] == TK_SYMBOL;
        assert r.tokens.token_text(item.atom.token) == "hello";
    } else {
        panic("expected a single atom item");
    }
    assert r.tokens.kinds[root.eof] == TK_EOF;
}

test "parse number atom" {
    let r = sexpression::parse(&"42").unwrap();
    let root = &r.root;
    assert root.item_list.len() == 1;
    if let Alt0(item) = &root.item_list[0] {
        assert r.tokens.kinds[item.atom.token] == TK_NUMBER;
        assert r.tokens.token_text(item.atom.token) == "42";
    } else {
        panic("expected a single atom item");
    }
    assert r.tokens.kinds[root.eof] == TK_EOF;
}

test "parse nested list" {
    // "(define (square x) (* x x))"
    let input = "(define (square x) (* x x))";
    let result = sexpression::parse(&input);
    let tree = result.unwrap();
    let cst = sexpression::to_tree(&tree);
    let actual = cst.to_string_tree();
    let expected = "(sexpr (item (list_ ( (item (atom define)) (item (list_ ( (item (atom square)) (item (atom x)) ))) (item (list_ ( (item (atom *)) (item (atom x)) (item (atom x)) ))) ))))";
    assert actual == expected, `AST mismatch for nested define\nactual:   {actual}\nexpected: {expected}`;
}
