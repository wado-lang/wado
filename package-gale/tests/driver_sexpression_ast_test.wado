use sexpression from "./grammars/sexpression.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            options: { highlight: false },
            output_dir: "tests/generated/sexpression",
        },
    };
use {
    LexerSlice,
    Span,
    Token,
    SexprNode,
    ItemNode,
    ItemAlt0,
    ItemAlt1,
    ItemAlt2,
    ListNode,
    AtomNode,
    AtomAlt0,
    AtomAlt1,
    AtomAlt2,
    AtomAlt3,
    TK_STRING,
    TK_WHITESPACE,
    TK_NUMBER,
    TK_SYMBOL,
    TK_LPAREN,
    TK_RPAREN,
    TK_DOT,
    TK_EOF,
} from "./grammars/sexpression.g4";

fn tok(kind: i32, text: String, start: i32, end: i32) -> Token {
    return Token {
        kind,
        text: LexerSlice::from_string(text),
        span: Span { start, end },
        leading_trivia: [],
        channel: 0,
    };
}

fn s(start: i32, end: i32) -> Span {
    return Span { start, end };
}

test "parse single symbol atom" {
    // "hello"
    let result = sexpression::parse(&"hello");
    let tree = result.unwrap();
    let expected = SexprNode {
        span: s(0, 5),
        item_list: [
            ItemNode::Alt0(ItemAlt0 {
                span: s(0, 5),
                atom: AtomNode::Alt1(AtomAlt1 {
                    span: s(0, 5),
                    symbol: tok(TK_SYMBOL, "hello", 0, 5),
                }),
            }),
        ] as List<ItemNode>,
        eof: tok(TK_EOF, "", 5, 5),
    };
    assert tree == expected, `AST mismatch for "hello"`;
}

test "parse number atom" {
    // "42"
    let result = sexpression::parse(&"42");
    let tree = result.unwrap();
    let expected = SexprNode {
        span: s(0, 2),
        item_list: [
            ItemNode::Alt0(ItemAlt0 {
                span: s(0, 2),
                atom: AtomNode::Alt2(AtomAlt2 {
                    span: s(0, 2),
                    number: tok(TK_NUMBER, "42", 0, 2),
                }),
            }),
        ] as List<ItemNode>,
        eof: tok(TK_EOF, "", 2, 2),
    };
    assert tree == expected, `AST mismatch for "42"`;
}

test "parse nested list" {
    // "(define (square x) (* x x))"
    let input = "(define (square x) (* x x))";
    let result = sexpression::parse(&input);
    let tree = result.unwrap();
    let cst = sexpression::to_tree(&tree);
    let actual = cst.to_string_tree();
    let expected = "(sexpr (item (list_ ( (item (atom define)) (item (list_ ( (item (atom square)) (item (atom x)) ))) (item (list_ ( (item (atom *)) (item (atom x)) (item (atom x)) ))) ))))";
    assert actual == expected, `AST mismatch for nested define\nactual:   {actual}\nexpected: {expected}`;
}
