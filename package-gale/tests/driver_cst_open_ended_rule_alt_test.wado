//! A rule alternative can have a first set and still admit every token:
//! `A? . C` is selected by `a` and by everything else too. The rule's
//! decision has to offer it on every token, and its own `A?` has to yield
//! where the wildcard after it needs the `a`.
//!
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use oera from "./grammars/open_ended_rule_alt.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_open_ended_rule_alt" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = oera::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input}`;
    let actual = oera::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input}\nexpected: ${expected}\nactual:   ${actual}`;
}

fn assert_rejected<S: AsStrSlice>(input: S) {
    let result = oera::parse(input);
    assert !result.ok(), `expected diagnostics for ${input}, got ${oera::to_string_tree(&result)}`;
}

test "open-ended rule alt: the alternatives after it are still reachable" {
    assert_tree("b d", "(r b d)");
    assert_tree("b e", "(r b e)");
}

test "open-ended rule alt: its own first set selects it" {
    assert_tree("a b c", "(r a b c)");
    assert_tree("a a c", "(r a a c)");
    assert_tree("a d c", "(r a d c)");
}

// The rule partitions its arms by raw first sets, so alt 0 is offered only
// for the `a` its `A?` prefix names; `build_prediction` cannot rank it yet.
#[TODO]
test "open-ended rule alt: the wildcard takes a token the prefix does not name" {
    assert_tree("b c", "(r b c)");
    assert_tree("c c", "(r c c)");
    assert_tree("d c", "(r d c)");
    assert_tree("e c", "(r e c)");
}

test "open-ended rule alt: a nullable prefix yields to the wildcard" {
    assert_tree("a c", "(r a c)");
}

test "open-ended rule alt: no alternative completes" {
    assert_rejected("a b");
    assert_rejected("a a");
    assert_rejected("a");
    assert_rejected("b");
    assert_rejected("c");
}
