/// Driver test for the TypeScript grammar parser.
///
/// The TypeScript grammar uses semantic predicates extensively, so full
/// parsing is not supported without predicate evaluation. These tests
/// verify tokenization of various TypeScript constructs.
use ts from "./grammars/TypeScriptLexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["./grammars/TypeScriptParser.g4"],
            output_dir: "./generated/cst_typescript",
        },
    };
use { normalize_tree } from "./support/tree_compare.wado";
use {
    TK_BackTick,
    TK_BackTickInside,
    TK_WhiteSpaces,
    TK_Let,
    TK_Divide,
    TK_RegularExpressionLiteral,
    TK_Identifier,
    TK_NullLiteral,
    TK_BooleanLiteral,
    TK_This,
    TK_CloseBracket,
    TK_CloseParen,
    TK_OctalIntegerLiteral,
    TK_DecimalLiteral,
    TK_HexIntegerLiteral,
    TK_StringLiteral,
    TK_PlusPlus,
    TK_MinusMinus,
} from "./grammars/TypeScriptLexer.g4";
use { TypeScriptLexerBase, LexerView, Lexer } from "./grammars/TypeScriptLexer.g4";
use { TypeScriptParserBase, Parser, TK_OpenBrace, TK_CloseBrace, TK_Function_, TK_Interface } from "./grammars/TypeScriptLexer.g4";

// The parser's base. Every operation is a question about the tokens around the
// decision, which the recognizer answers directly — upstream reads the same
// facts off its token stream, so the base carries no state of its own.
struct TsParserBase {}

impl TypeScriptParserBase for TsParserBase {
    /// No line break between the token just consumed and the next one — what
    /// JavaScript's automatic semicolon insertion turns on.
    fn not_line_terminator(&self, p: &Parser) -> bool {
        resume p.token_line(p.lt(1)) == p.token_line(p.lt(0));
    }

    fn line_terminator_ahead(&self, p: &Parser) -> bool {
        resume p.token_line(p.lt(1)) != p.token_line(p.lt(0));
    }

    fn close_brace(&self, p: &Parser) -> bool {
        resume p.la(1) == TK_CloseBrace;
    }

    /// An expression statement may not start with `{`, `function` or
    /// `interface` — those open a block, a declaration and a type instead.
    fn not_open_brace_and_not_function_and_not_interface(&self, p: &Parser) -> bool {
        resume !(p.la(1) matches { TK_OpenBrace | TK_Function_ | TK_Interface });
    }

    /// The token just consumed is `a0` — `for (x of xs)` asks it of `of`.
    fn p(&self, p: &Parser, a0: String) -> bool {
        resume p.token_text(p.lt(0)) == a0;
    }

    /// The next token is `a0` — a getter / setter asks it of `get` / `set`.
    fn n(&self, p: &Parser, a0: String) -> bool {
        resume p.token_text(p.lt(1)) == a0;
    }
}

// A hand-written TypeScriptLexerBase port, installed around every recognizer
// call: the action ops carry the brace / template state the predicate ops read,
// and the `emit` hook carries the last default-channel token.
//
// `IsStrictMode` still sees only the `'use strict'` literal the lexer passes,
// not the parser's notion of scope (see TODO.md, Stage C).
struct TsBase {
    // One entry per `${` interpolation still open: how many plain `{` are open
    // inside it. A `}` ends the interpolation only at count 0.
    interp_braces: List<i32>,
    // Where each open template's interpolation entries start, so a closing
    // backtick drops what its interpolations left behind.
    template_marks: List<i32>,
    strict: bool,
    /// `-1` before the first token. Upstream tracks this by overriding
    /// `nextToken`.
    last_token: i32 = -1,
}

/// Whether a token ends an operand, so a following `/` is a division rather
/// than the start of a regular expression.
fn ends_operand(kind: i32) -> bool {
    return kind matches { TK_Identifier | TK_NullLiteral | TK_BooleanLiteral | TK_This | TK_CloseBracket | TK_CloseParen | TK_OctalIntegerLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_StringLiteral | TK_PlusPlus | TK_MinusMinus };
}

impl TypeScriptLexerBase for TsBase {
    fn emit(&mut self, view: LexerView, ty: i32, channel: i32) -> i32 {
        if channel == 0 {
            self.last_token = ty;
        }
        resume ty;
    }

    fn is_regex_possible(&self, view: LexerView) -> bool {
        resume !ends_operand(self.last_token);
    }

    fn is_in_template_string(&self, view: LexerView) -> bool {
        if self.template_marks.is_empty() {
            resume false;
        }
        resume self.interp_braces.last() matches { Some(n) && n == 0 };
    }

    fn is_strict_mode(&self, view: LexerView) -> bool {
        resume self.strict;
    }

    fn process_open_brace(&mut self, view: LexerView, lx: &mut Lexer) {
        let n = self.interp_braces.len();
        if n > 0 {
            self.interp_braces[n - 1] += 1;
        }
        resume ();
    }

    fn process_close_brace(&mut self, view: LexerView, lx: &mut Lexer) {
        let n = self.interp_braces.len();
        if n > 0 && self.interp_braces[n - 1] > 0 {
            self.interp_braces[n - 1] -= 1;
        }
        resume ();
    }

    fn process_string_literal(&mut self, view: LexerView, lx: &mut Lexer) {
        let text = view.text();
        if text == "'use strict'" || text == "\"use strict\"" {
            self.strict = true;
        }
        resume ();
    }

    fn increase_template_depth(&mut self, view: LexerView, lx: &mut Lexer) {
        self.template_marks.push(self.interp_braces.len());
        resume ();
    }

    fn decrease_template_depth(&mut self, view: LexerView, lx: &mut Lexer) {
        if let Some(mark) = self.template_marks.pop() {
            self.interp_braces.truncate(mark);
        }
        resume ();
    }

    fn start_template_string(&mut self, view: LexerView, lx: &mut Lexer) {
        self.interp_braces.push(0);
        resume ();
    }
}

fn new_ts_base() -> TsBase {
    return TsBase { interp_braces: [], template_marks: [], strict: false };
}

fn ts_tokenize(input: &String) -> ts::TokenStream {
    let mut base = new_ts_base();
    with TypeScriptLexerBase => &mut base do {
        return ts::tokenize(input);
    };
}

fn ts_parse(input: &String) -> ts::ParseResult {
    let mut base = new_ts_base();
    let mut pbase = TsParserBase {};
    with TypeScriptLexerBase => &mut base do {
        with TypeScriptParserBase => &mut pbase do {
            return ts::parse(input);
        };
    };
}

fn assert_tree(input: &String, expected: &String) {
    let result = ts_parse(input);
    let actual = ts::to_string_tree(&result);
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    ${*input}\nexpected: ${norm}\nactual:   ${actual}`;
}

fn assert_parses(input: &String) {
    let result = ts_parse(input);
    if !result.ok() {
        panic(`parse failed: ${result.diagnostics[0].message}`);
    }
}

test "tokenize variable declaration" {
    let tokens = ts_tokenize(&"let x = 42;");
    assert tokens.len() >= 4, `expected at least 4 tokens, got ${tokens.len()}`;
    let first = ts::token_kind_name(tokens.kinds[0]);
    assert first == "Let", `expected Let, got ${first}`;
}

test "tokenize const declaration" {
    let tokens = ts_tokenize(&"const name = \"hello\";");
    assert tokens.len() >= 4, `expected at least 4 tokens, got ${tokens.len()}`;
    let first = ts::token_kind_name(tokens.kinds[0]);
    assert first == "Const", `expected Const, got ${first}`;
}

test "tokenize function declaration" {
    let tokens = ts_tokenize(&"function add(a, b) { return a + b; }");
    assert tokens.len() >= 10, `expected at least 10 tokens, got ${tokens.len()}`;
    let first = ts::token_kind_name(tokens.kinds[0]);
    assert first == "Function_", `expected Function_, got ${first}`;
}

test "tokenize class declaration" {
    let tokens = ts_tokenize(&"class Foo extends Bar { constructor() {} }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got ${tokens.len()}`;
    let first = ts::token_kind_name(tokens.kinds[0]);
    assert first == "Class", `expected Class, got ${first}`;
}

test "tokenize arrow function" {
    let tokens = ts_tokenize(&"const f = (x) => x + 1;");
    assert tokens.len() >= 8, `expected at least 8 tokens, got ${tokens.len()}`;
}

test "tokenize import statement" {
    let tokens = ts_tokenize(&"import { foo } from 'bar';");
    assert tokens.len() >= 6, `expected at least 6 tokens, got ${tokens.len()}`;
    let first = ts::token_kind_name(tokens.kinds[0]);
    assert first == "Import", `expected Import, got ${first}`;
}

test "tokenize template literal" {
    let tokens = ts_tokenize(&"let s = `hello ${name}`;");
    assert tokens.len() >= 4, `expected at least 4 tokens, got ${tokens.len()}`;
}

test "tokenize operators" {
    let tokens = ts_tokenize(&"a === b && c !== d || e > f");
    assert tokens.len() >= 9, `expected at least 9 tokens, got ${tokens.len()}`;
}

test "tokenize interface" {
    let tokens = ts_tokenize(&"interface Foo { x: number; }");
    assert tokens.len() >= 6, `expected at least 6 tokens, got ${tokens.len()}`;
}

test "tokenize enum" {
    let tokens = ts_tokenize(&"enum Color { Red, Green, Blue }");
    assert tokens.len() >= 8, `expected at least 8 tokens, got ${tokens.len()}`;
    let first = ts::token_kind_name(tokens.kinds[0]);
    assert first == "Enum", `expected Enum, got ${first}`;
}

// The TypeScript grammar's generated entry rule is `initializer: '=' singleExpression`,
// so only `= <expression>` inputs can be parsed. Identifiers are not tokenized
// correctly due to missing semantic predicates, so only literal expressions work.

test "parse initializer number" {
    assert_parses(&"= 1");
}

test "parse initializer string" {
    assert_parses(&"= 'hello'");
}

test "parse initializer boolean true" {
    assert_parses(&"= true");
}

test "parse initializer boolean false" {
    assert_parses(&"= false");
}

test "parse initializer null" {
    assert_parses(&"= null");
}

test "parse initializer arithmetic" {
    assert_parses(&"= 1 + 2 * 3");
}

test "parse initializer negation" {
    assert_parses(&"= -1");
}

test "parse initializer logical not" {
    assert_parses(&"= !true");
}

test "parse initializer parenthesized" {
    assert_parses(&"= (1 + 2)");
}

test "parse initializer equality" {
    assert_parses(&"= 1 === 2");
}

test "parse initializer ternary" {
    assert_parses(&"= 1 ? 2 : 3");
}

test "parse nested arithmetic" {
    assert_parses(&"= (1 + 2) * 3");
}

test "parse logical and/or" {
    assert_parses(&"= true && false || true");
}

test "parse bitwise operators" {
    assert_parses(&"= 1 | 2 & 3 ^ 4");
}

test "parse comparison greater than" {
    assert_parses(&"= 1 > 2");
}

test "parse comparison less than" {
    assert_parses(&"= 1 < 2");
}

test "parse comparison less than or equal" {
    assert_parses(&"= 1 <= 2");
}

test "parse comparison greater than or equal" {
    assert_parses(&"= 1 >= 2");
}

test "parse shift left" {
    assert_parses(&"= 1 << 2");
}

test "parse shift right" {
    assert_parses(&"= 1 >> 2");
}

test "parse string concatenation" {
    assert_parses(&"= 'a' + 'b'");
}

test "parse deeply nested parens" {
    assert_parses(&"= ((((1))))");
}

test "parse complex mixed expression" {
    assert_parses(&"= (1 + 2) * 3 === 9 ? true : false");
}

test "parse bitwise not" {
    assert_parses(&"= ~1");
}

test "parse double negation" {
    assert_parses(&"= !!true");
}

test "parse unary plus" {
    assert_parses(&"= +1");
}

test "parse strict inequality" {
    assert_parses(&"= 1 !== 2");
}

test "parse void" {
    assert_parses(&"= void 0");
}

test "parse comma expression" {
    assert_parses(&"= (1, 2, 3)");
}

test "parse unsigned right shift" {
    assert_parses(&"= 1 >>> 2");
}

test "parse nested ternary" {
    assert_parses(&"= 1 ? 2 ? 3 : 4 : 5");
}

test "tree: unsigned right shift" {
    assert_tree(&"= 1 >>> 2", &"
        (initializer =
          (singleExpression
            (singleExpression (literal (numericLiteral 1)))
            > > >
            (singleExpression (literal (numericLiteral 2)))))
    ");
}

test "tree: shift right" {
    assert_tree(&"= 1 >> 2", &"
        (initializer =
          (singleExpression
            (singleExpression (literal (numericLiteral 1)))
            > >
            (singleExpression (literal (numericLiteral 2)))))
    ");
}

test "tree: nested ternary" {
    assert_tree(&"= 1 ? 2 ? 3 : 4 : 5", &"
        (initializer =
          (singleExpression
            (singleExpression (literal (numericLiteral 1)))
            ?
            (singleExpression
              (singleExpression (literal (numericLiteral 2)))
              ?
              (singleExpression (literal (numericLiteral 3)))
              :
              (singleExpression (literal (numericLiteral 4))))
            :
            (singleExpression (literal (numericLiteral 5)))))
    ");
}

test "tree: simple ternary" {
    assert_tree(&"= 1 ? 2 : 3", &"
        (initializer =
          (singleExpression
            (singleExpression (literal (numericLiteral 1)))
            ?
            (singleExpression (literal (numericLiteral 2)))
            :
            (singleExpression (literal (numericLiteral 3)))))
    ");
}

//
// TypeScriptParser.g4 marks the `**` alternative of `singleExpression` with
// `<assoc=right>`. `2 ** 3 ** 4` must parse as `2 ** (3 ** 4)`, which in the
// CST means the nested `**` appears on the RHS of the outer one (the right
// operand's singleExpression contains another `**` alternative).
//
// End-to-end gate: this fails if ANY link between element-option parsing,
// `Alternative.options`, `is_right_associative`, and the inner-min-prec
// formula in `compute_lr_conflict_min_prec` regresses.

test "tree: power operator is right-associative" {
    assert_tree(&"= 2 ** 3 ** 4", &"
        (initializer =
          (singleExpression
            (singleExpression (literal (numericLiteral 2)))
            **
            (singleExpression
              (singleExpression (literal (numericLiteral 3)))
              **
              (singleExpression (literal (numericLiteral 4))))))
    ");
}

test "tree: power operator over addition binds tighter on the right" {
    // `2 ** 3 + 4` — `+` has lower precedence than `**`, so this is
    // `(2 ** 3) + 4`. Left-deep for the `+` itself, with the `**` grouping
    // nested as its left operand.
    assert_tree(&"= 2 ** 3 + 4", &"
        (initializer =
          (singleExpression
            (singleExpression
              (singleExpression (literal (numericLiteral 2)))
              **
              (singleExpression (literal (numericLiteral 3))))
            +
            (singleExpression (literal (numericLiteral 4)))))
    ");
}

//
// These exercise code paths that used to be silently dropped by the IR and
// are now wired through the lexer generator: `type(X)` kind override,
// `channel(HIDDEN)` routing, and the TEMPLATE-mode `pushMode` / `popMode`
// that surrounds the type override.

test "type override: BackTickInside rewrites kind to BackTick" {
    // TypeScriptLexer declares:
    //   BackTick:       '`' -> pushMode(TEMPLATE);
    //   BackTickInside: '`' -> type(BackTick), popMode;
    //
    // Both the opening and closing backticks must be emitted with kind
    // BackTick. The raw BackTickInside kind must NEVER appear in the
    // token stream; if it did, the closing backtick would be classified
    // as a separate token kind and the parser would see an inconsistent
    // pair of open/close delimiters.
    let tokens = ts_tokenize(&"`hi`");
    let mut backtick_count = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_BackTickInside, "BackTickInside leaked into stream — type(BackTick) override dropped";
        if tokens.kinds[i] == TK_BackTick {
            backtick_count += 1;
        }
    }
    assert backtick_count == 2, `expected 2 BackTick tokens (open + close), got ${backtick_count}`;
}

test "HIDDEN channel: TypeScript WhiteSpaces routed to trivia" {
    // TypeScriptLexer routes `WhiteSpaces` through HIDDEN. The token stream
    // must contain `let` and `x` as adjacent main-channel tokens, with the
    // space carried as trivia on `x`. The `x` becomes an Identifier token
    // after keyword classification; we locate it by position (second
    // non-EOF main-channel token).
    let tokens = ts_tokenize(&"let x");
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_WhiteSpaces, "WhiteSpaces leaked into main stream — HIDDEN routing dropped";
    }
    // `let` must be the first main-channel token.
    assert tokens.kinds[0] == TK_Let, `expected first token = Let, got kind ${tokens.kinds[0]}`;
    // The second token (the `x` identifier) must carry the HIDDEN
    // whitespace as leading trivia on channel 1.
    let mut found_hidden = false;
    for let mut j = tokens.triv_lo[1]; j < tokens.triv_hi[1]; j += 1 {
        if tokens.triv_kinds[j] == TK_WhiteSpaces {
            assert tokens.triv_chans[j] == 1, `expected HIDDEN channel 1, got ${tokens.triv_chans[j]}`;
            found_hidden = true;
        }
    }
    assert found_hidden, "WhiteSpaces trivia missing from token following `let`";
}

//
// Stage C: the lexer's `superClass` base now runs, so the regex-vs-division
// predicate decides these instead of every candidate being admitted.

test "regex vs division: a slash after an operand is a division" {
    // Without the base predicate `/ b /` matches RegularExpressionLiteral and
    // swallows the middle of the expression.
    let tokens = ts_tokenize(&"a / b / c");
    let mut divides = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_RegularExpressionLiteral, "a division was tokenized as a regex";
        if tokens.kinds[i] == TK_Divide {
            divides += 1;
        }
    }
    assert divides == 2, `expected 2 Divide tokens, got ${divides}`;
}

test "regex vs division: a slash after an operator starts a regex" {
    let tokens = ts_tokenize(&"x = /ab+/;");
    let mut regexes = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        if tokens.kinds[i] == TK_RegularExpressionLiteral {
            regexes += 1;
        }
    }
    assert regexes == 1, `expected 1 RegularExpressionLiteral, got ${regexes}`;
}

test "regex vs division: a slash after a keyword starts a regex" {
    // `return` ends in an identifier character but is not an operand, so
    // reading the last token is what separates this from `a / b`.
    let tokens = ts_tokenize(&"return /ab+/;");
    let mut regexes = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_Divide, "a regex was tokenized as a division";
        if tokens.kinds[i] == TK_RegularExpressionLiteral {
            regexes += 1;
        }
    }
    assert regexes == 1, `expected 1 RegularExpressionLiteral, got ${regexes}`;
}

test "regex vs division: a comment between the operand and the slash is skipped" {
    // The hook records only default-channel tokens, so the comment does not
    // become the "last token" and `/ c` stays a division.
    let tokens = ts_tokenize(&"a /* note */ / c");
    let mut divides = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_RegularExpressionLiteral, "a division was tokenized as a regex";
        if tokens.kinds[i] == TK_Divide {
            divides += 1;
        }
    }
    assert divides == 1, `expected 1 Divide token, got ${divides}`;
}

test "template interpolation: the base tracks which brace closes the hole" {
    // `${` pushes DEFAULT_MODE; the object literal's own braces must not end the
    // interpolation, so the closing `}` of `{ a: 1 }` is a CloseBrace and the
    // last one a TemplateCloseBrace popping back into the template.
    let tokens = ts_tokenize(&"`v=${ { a: 1 } }`");
    let mut backticks = 0;
    for let mut i = 0; i < tokens.len(); i += 1 {
        assert tokens.kinds[i] != TK_BackTickInside, "BackTickInside leaked into stream";
        if tokens.kinds[i] == TK_BackTick {
            backticks += 1;
        }
    }
    assert backticks == 2, `expected 2 BackTick tokens (open + close), got ${backticks}`;
}
