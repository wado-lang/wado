//! Text helpers for comparing a printed parse tree against an expected one.
//! Test-only, so they are not part of the runtime a generated parser inlines;
//! both are `String -> String` and touch no generated type.

/// Collapse whitespace runs to single spaces and trim, so an expected tree can
/// be written indented across lines. Whitespace inside double quotes is kept.
pub fn normalize_tree(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    let mut in_string = false;
    let mut space_pending = false;
    for let c of s.chars() {
        if in_string {
            out.push(c);
            if c == '"' {
                in_string = false;
            }
        } else if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            if out.len() > 0 {
                space_pending = true;
            }
        } else {
            if space_pending {
                out.push(' ');
                space_pending = false;
            }
            if c == '"' {
                in_string = true;
            }
            out.push(c);
        }
    }
    return out;
}

/// Drop Gale's `<skip …>` markers, leaving the deleted terminal bare — the
/// shape ANTLR4's `Trees.toStringTree` prints. See "Deleted terminals in parse
/// trees" in `antlr4-compatibility.md`.
///
/// A marker closes at the first `>` followed by a space, `)`, or end of input.
/// A deleted token whose own text holds such a `>` therefore cuts early and
/// leaves a stray `>`, which surfaces as a mismatch rather than a false match.
pub fn strip_skip_markers(s: &String) -> String {
    let chars: List<char> = s.chars().collect();
    let n = chars.len();
    let mut out = String::with_capacity(s.len());
    let mut i = 0;
    while i < n {
        let close = if opens_skip_marker(&chars, i) { skip_marker_close(&chars, i) } else { -1 };
        if close < 0 {
            out.push(chars[i]);
            i += 1;
            continue;
        }
        out.push(' ');
        for let mut k = i + SKIP_MARKER_OPEN_LEN; k < close; k += 1 {
            out.push(chars[k]);
        }
        i = close + 1;
    }
    return out;
}

/// The length of ` <skip `.
global SKIP_MARKER_OPEN_LEN: i32 = 7;

fn opens_skip_marker(chars: &List<char>, i: i32) -> bool {
    return i + SKIP_MARKER_OPEN_LEN <= chars.len()
        && chars[i] == ' '
        && chars[i + 1] == '<'
        && chars[i + 2] == 's'
        && chars[i + 3] == 'k'
        && chars[i + 4] == 'i'
        && chars[i + 5] == 'p'
        && chars[i + 6] == ' ';
}

/// Index of the `>` closing the marker opened at `open`, or -1 when no `>` in
/// the rest of the string sits in closing position.
fn skip_marker_close(chars: &List<char>, open: i32) -> i32 {
    let n = chars.len();
    for let mut j = open + SKIP_MARKER_OPEN_LEN; j < n; j += 1 {
        if chars[j] != '>' {
            continue;
        }
        if j + 1 >= n || chars[j + 1] == ' ' || chars[j + 1] == ')' {
            return j;
        }
    }
    return -1;
}
