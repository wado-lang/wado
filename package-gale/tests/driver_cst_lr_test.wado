//! Stage 2 left recursion: the CST emitter parses a directly
//! left-recursive, precedence grammar via precedence climbing + the builder
//! `checkpoint`/`start_node_at` wrap. Labelled alternatives do not add tree
//! nodes (one node per rule).

use lr from "./grammars/arith_lr.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_lr" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = lr::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = lr::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "lr: single atom" {
    assert_tree("1", "(expr 1)");
}

test "lr: left-associative addition" {
    assert_tree("1 + 2 + 3", "(expr (expr (expr 1) + (expr 2)) + (expr 3))");
}

test "lr: precedence, * binds tighter than +" {
    assert_tree("1 + 2 * 3", "(expr (expr 1) + (expr (expr 2) * (expr 3)))");
}

test "lr: precedence, left operand is a product" {
    assert_tree("1 * 2 + 3", "(expr (expr (expr 1) * (expr 2)) + (expr 3))");
}
