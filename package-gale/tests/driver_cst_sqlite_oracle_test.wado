    assert_tree(
        &"DELETE FROM t WHERE id = 1",
        &"(parse (sql_stmt_list (sql_stmt (delete_stmt DELETE FROM (qualified_table_name (table_name (any_name t))) WHERE (expr (expr (column_name (any_name id))) = (expr (literal_value 1)))))))",
    );
}

test "oracle: UPDATE t SET a = 1 WHERE id = 2" {
    assert_tree(
        &"UPDATE t SET a = 1 WHERE id = 2",
        &"(parse (sql_stmt_list (sql_stmt (update_stmt UPDATE (qualified_table_name (table_name (any_name t))) SET (column_name (any_name a)) = (expr (literal_value 1)) WHERE (expr (expr (column_name (any_name id))) = (expr (literal_value 2)))))))",
    );
