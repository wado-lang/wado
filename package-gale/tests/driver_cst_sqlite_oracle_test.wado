#![generated(by = "package-gale/scripts/regen-oracle.sh")]
// Do not edit by hand — re-run scripts/regen-oracle.sh sqlite to regenerate.
// Generated against ANTLR4 4.13.2 (the published jar, run as a black box).
//
// Stage B' for a real grammar: Gale's SQLite.g4 parse trees pinned
// against ANTLR4's over tests/oracle/sqlite/cases.sql. The expected tree is ANTLR4's; a case
// Gale parses differently is #[TODO] (resolving it = the divergence closed).

use sqlite from "./grammars/SQLite.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_sqlite" },
    };
use { normalize_tree } from "./grammars/SQLite.g4";

fn assert_tree(input: &String, expected: &String) {
    let result = sqlite::parse(input);
    let actual = sqlite::to_string_tree(&result);
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    ${*input}\nexpected: ${norm}\nactual:   ${actual}`;
}

test "oracle: SELECT 1" {
    assert_tree(
        &"SELECT 1",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (literal_value 1))))))))",
    );
}

test "oracle: SELECT a, b FROM t" {
    assert_tree(
        &"SELECT a, b FROM t",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (column_name (any_name a)))) , (result_column (expr (column_name (any_name b)))) FROM (table_or_subquery (table_name (any_name t))))))))",
    );
}

