#![generated(by = "package-gale/scripts/regen-oracle.sh")]
// Do not edit by hand — re-run scripts/regen-oracle.sh sqlite to regenerate.
// Generated against ANTLR4 4.13.2 (the published jar, run as a black box).
//
// Stage B' for a real grammar: Gale's SQLite.g4 parse trees pinned
// against ANTLR4's over tests/oracle/sqlite/cases.sql. The expected tree is ANTLR4's; a case
// Gale parses differently is #[TODO] (resolving it = the divergence closed).

use sqlite from "./grammars/SQLite.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_sqlite" },
    };
use { normalize_tree } from "./grammars/SQLite.g4";

fn assert_tree(input: &String, expected: &String) {
    let result = sqlite::parse(input);
    let actual = sqlite::to_string_tree(&result);
    let norm = normalize_tree(expected);
    assert actual == norm, `\ninput:    ${*input}\nexpected: ${norm}\nactual:   ${actual}`;
}

test "oracle: SELECT 1" {
    assert_tree(
        &"SELECT 1",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (literal_value 1))))))))",
    );
}

test "oracle: SELECT a, b FROM t" {
    assert_tree(
        &"SELECT a, b FROM t",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (column_name (any_name a)))) , (result_column (expr (column_name (any_name b)))) FROM (table_or_subquery (table_name (any_name t))))))))",
    );
}

test "oracle: SELECT * FROM t WHERE x BETWEEN 1 AND 10" {
    assert_tree(
        &"SELECT * FROM t WHERE x BETWEEN 1 AND 10",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column *) FROM (table_or_subquery (table_name (any_name t))) WHERE (expr (expr (column_name (any_name x))) BETWEEN (expr (literal_value 1)) AND (expr (literal_value 10))))))))",
    );
}

test "oracle: SELECT a FROM t1 JOIN t2 ON t1.id = t2.id" {
    assert_tree(
        &"SELECT a FROM t1 JOIN t2 ON t1.id = t2.id",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (column_name (any_name a)))) FROM (join_clause (table_or_subquery (table_name (any_name t1))) (join_operator JOIN) (table_or_subquery (table_name (any_name t2))) (join_constraint ON (expr (expr (table_name (any_name t1)) . (column_name (any_name id))) = (expr (table_name (any_name t2)) . (column_name (any_name id)))))))))))",
    );
}

test "oracle: SELECT count(*) FROM t GROUP BY a HAVING count(*) > 1" {
    assert_tree(
        &"SELECT count(*) FROM t GROUP BY a HAVING count(*) > 1",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (function_name (any_name count)) ( * ))) FROM (table_or_subquery (table_name (any_name t))) GROUP BY (expr (column_name (any_name a))) HAVING (expr (expr (function_name (any_name count)) ( * )) > (expr (literal_value 1))))))))",
    );
}

test "oracle: SELECT a FROM t ORDER BY a DESC LIMIT 10" {
    assert_tree(
        &"SELECT a FROM t ORDER BY a DESC LIMIT 10",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (column_name (any_name a)))) FROM (table_or_subquery (table_name (any_name t)))) ORDER BY (ordering_term (expr (column_name (any_name a))) DESC) LIMIT (expr (literal_value 10))))))",
    );
}

test "oracle: SELECT a FROM t UNION SELECT b FROM u" {
    assert_tree(
        &"SELECT a FROM t UNION SELECT b FROM u",
        &"(parse (sql_stmt_list (sql_stmt (compound_select_stmt (select_core SELECT (result_column (expr (column_name (any_name a)))) FROM (table_or_subquery (table_name (any_name t)))) UNION (select_core SELECT (result_column (expr (column_name (any_name b)))) FROM (table_or_subquery (table_name (any_name u))))))))",
    );
}

test "oracle: SELECT CASE WHEN a > 0 THEN 1 ELSE 2 END FROM t" {
    assert_tree(
        &"SELECT CASE WHEN a > 0 THEN 1 ELSE 2 END FROM t",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr CASE WHEN (expr (expr (column_name (any_name a))) > (expr (literal_value 0))) THEN (expr (literal_value 1)) ELSE (expr (literal_value 2)) END)) FROM (table_or_subquery (table_name (any_name t))))))))",
    );
}

