test "oracle: CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL)" {
    assert_tree(
        &"CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT NOT NULL)",
        &"(parse (sql_stmt_list (sql_stmt (create_table_stmt CREATE TABLE (table_name (any_name t)) ( (column_def (column_name (any_name id)) (type_name (name (any_name INTEGER))) (column_constraint PRIMARY KEY conflict_clause)) , (column_def (column_name (any_name name)) (type_name (name (any_name TEXT))) (column_constraint NOT NULL conflict_clause)) )))))",
    );
}

test "oracle: CREATE INDEX idx ON t (a, b)" {
    assert_tree(
        &"CREATE INDEX idx ON t (a, b)",
        &"(parse (sql_stmt_list (sql_stmt (create_index_stmt CREATE INDEX (index_name (any_name idx)) ON (table_name (any_name t)) ( (indexed_column (column_name (any_name a))) , (indexed_column (column_name (any_name b))) )))))",
    );
}

test "oracle: SELECT a + b * c FROM t" {
    assert_tree(
        &"SELECT a + b * c FROM t",
        &"(parse (sql_stmt_list (sql_stmt (factored_select_stmt (select_core SELECT (result_column (expr (expr (column_name (any_name a))) + (expr (expr (column_name (any_name b))) * (expr (column_name (any_name c)))))) FROM (table_or_subquery (table_name (any_name t))))))))",
    );
}
