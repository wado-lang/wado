    assert_tree(
        &"INSERT INTO t (a, b) VALUES (1, 2)",
        &"(parse (sql_stmt_list (sql_stmt (insert_stmt INSERT INTO (table_name (any_name t)) ( (column_name (any_name a)) , (column_name (any_name b)) ) VALUES ( (expr (literal_value 1)) , (expr (literal_value 2)) )))))",
    );
}

