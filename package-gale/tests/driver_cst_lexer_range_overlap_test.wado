//! A char shared by two lexer rules' first-char ranges must try both rules.
//! The dispatch groups ranges by guard, so a char in the intersection lands in
//! the first group and every later rule — plus the fallback — is unreachable
//! for it unless the group carries every rule the interval admits.

use g from "./grammars/lexer_range_overlap.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_lexer_range_overlap" },
    };
use { TK_EOF } from "./grammars/lexer_range_overlap.g4";

fn dump(input: &String) -> String {
    return g::to_lexer_string(&g::tokenize(input), TK_EOF);
}

test "a char outside the intersection still reaches its own rule" {
    let actual = dump(&"a1 z2");
    let expected = "[@0,0:1='a1',<1>,1:0]\n[@1,3:4='z2',<2>,1:3]\n[@2,5:4='<EOF>',<-1>,1:5]\n";
    assert actual == expected, `actual:\n${actual}\nexpected:\n${expected}`;
}

test "a char in the range intersection reaches the later rule" {
    let actual = dump(&"e2");
    let expected = "[@0,0:1='e2',<2>,1:0]\n[@1,2:1='<EOF>',<-1>,1:2]\n";
    assert actual == expected, `actual:\n${actual}\nexpected:\n${expected}`;
}

test "a char in the range intersection still prefers the earlier rule" {
    let actual = dump(&"e1");
    let expected = "[@0,0:1='e1',<1>,1:0]\n[@1,2:1='<EOF>',<-1>,1:2]\n";
    assert actual == expected, `actual:\n${actual}\nexpected:\n${expected}`;
}
