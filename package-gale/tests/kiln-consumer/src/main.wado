//! Trivial consumer of the Kiln-generated calculator parser.
//!
//! The inline `with { generator: { ... } }` clause routes the `.g4`
//! schema through the Gale generator at compile time; the loader
//! redirect (see WEP 2026-04-12 §"Loader redirect") rewrites the
//! `use ... from "./grammar.g4"` import to the generated entry module
//! that the pipeline emits, so the consumer never has to hand-spell
//! the generated filename.

use calculator from "./grammar.g4"
    with {
        generator: {
            module: "../../../src/generator.wado",
            options: { highlight: false },
        },
    };

export fn run() {
    let _ = calculator::parse("1+2=3");
}
