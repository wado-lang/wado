//! An optional whose body admits every token is held back by what follows it,
//! and nothing else. Taking the follow set out of "everything" leaves
//! everything *except* it — a negative test, not a smaller set.
//!
//! Every tree below was taken from the published ANTLR4 jar
//! (`scripts/antlr4-oracle.sh`, `<EOF>` marker dropped).

use ooe from "./grammars/opt_open_ended_rule.g4"
    with {
        generator: { module: "../src/generator.wado", output_dir: "./generated/cst_opt_open_ended_rule" },
    };

fn assert_tree<S: AsStrSlice, S1: AsStrSlice>(input: S, expected: S1) {
    let result = ooe::parse(input);
    assert result.ok(), `unexpected diagnostics for ${input.to_string()}`;
    let actual = ooe::to_string_tree(&result);
    assert actual == expected.to_string(), `\ninput:    ${input.to_string()}\nexpected: ${expected.to_string()}\nactual:   ${actual}`;
}

test "optional over an open-ended rule: the follow token is left alone" {
    assert_tree(&"b", &"(s (t b))");
}

test "optional over an open-ended rule: a token that is not the follow enters it" {
    assert_tree(&"a b", &"(s (t (x a) b))");
}
