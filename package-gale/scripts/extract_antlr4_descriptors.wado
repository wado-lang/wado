#!/usr/bin/env wado
//! Extract ANTLR4 runtime-testsuite descriptors into Wado parse-only tests.
//!
//! Source:  vendor/antlr4/runtime-testsuite/resources/org/antlr/v4/test/runtime/descriptors/
//! Outputs:
//!   package-gale/tests/antlr4-compat/grammars/<Category>/<Name>.g4
//!   package-gale/tests/antlr4-compat/<category>_test.wado
//!
//! Triage data lives in package-gale/tests/antlr4-compat/status.toml:
//!   [todo]
//!   "LexerExec/CharSetWithMissingEscapeChar" = "Gale rejects malformed escape"
//!   [skip]
//!   "Listeners/SomeJavaSpecific" = "target-language only"
//!
//! The script never initializes the antlr4 submodule itself. If the source
//! directory is missing it errors out with instructions and exits non-zero.
//!
//! Usage (from the repository root):
//!   wado run package-gale/scripts/extract_antlr4_descriptors.wado [Category ...]
//!   wado run package-gale/scripts/extract_antlr4_descriptors.wado all
//!
//! Default categories (Phase 1): Sets, LexerExec, ParseTrees.

use { args, env, println, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use {
    Preopens,
    Descriptor,
    DescriptorType,
    DescriptorFlags,
    PathFlags,
    OpenFlags,
    DirectoryEntry,
    Filesize,
} from "wasi:filesystem";
use { ErrorCode } from "wasi:filesystem/types.wado";
use { CodeWriter } from "../src/wadopoet.wado";
use { expand_action_templates } from "../src/g4/action_templates.wado";
use { to_snake_case } from "../src/ident.wado";

// ===== Constants =====

/// Bytes per `Stream<u8>::read` when slurping a descriptor / grammar file.
global FILE_READ_CHUNK: i32 = 8192;
/// Directory entries per `Stream<DirectoryEntry>::read` when listing a dir.
global DIR_READ_CHUNK: i32 = 64;

fn descriptors_root() -> String {
    return "vendor/antlr4/runtime-testsuite/resources/org/antlr/v4/test/runtime/descriptors";
}

/// Root of the generated artefacts (everything compat-related lives here).
fn compat_root_dir() -> String {
    return "package-gale/tests/antlr4-compat";
}

/// Subdirectory holding the extracted `.g4` files (`<Category>/<Name>.g4`).
fn grammars_subdir() -> String {
    return "grammars";
}

/// Path to the triage file relative to repo root.
fn status_file_path() -> String {
    return "package-gale/tests/antlr4-compat/status.toml";
}

fn default_categories() -> List<String> {
    return ["Sets", "LexerExec", "ParseTrees"];
}

/// `#![generated(by = ...)]` attribute string written at the top of every
/// generated test file. The `by` value is the canonical path of the
/// generator script (relative to repo root) per the Wado convention used
/// by `wado-from-idl` etc.
fn generator_attr() -> String {
    return "#![generated(by = \"package-gale/scripts/extract_antlr4_descriptors.wado\")]";
}

/// The shared `// Triage data: …([<axis>_*]).` comment line. `axis` is
/// `stage_a` / `stage_b` / `stage_b_oracle`.
fn triage_doc_line(axis: &String) -> String {
    return `// Triage data: package-gale/tests/antlr4-compat/status.toml ([${*axis}_*]).`;
}

// ===== Descriptor format =====

fn is_known_section(name: &String) -> bool {
    return match *name {
        "notes" | "type" | "grammar" | "slaveGrammar" | "start" | "input" | "output" | "errors" | "flags" | "skip" => true,
        _ => false,
    };
}

struct DescriptorPair {
    name: String,
    value: String,  // raw collected value, before post-processing
}

struct ParsedDescriptor {
    grammar: String,
    slave_grammars: List<String>,
    /// `[type]` block — `Parser`, `Lexer`, `CompositeParser`, or
    /// `CompositeLexer`. Stage A only emits for `Parser` because Gale's
    /// generated `parse(&input)` entry point exists only for parser-type
    /// grammars; lexer-only descriptors are deferred to Stage L.
    descriptor_type: String,
    /// `[input]` block — the raw test input fed to the generated parser.
    /// Empty when the descriptor declares no `[input]` (lexer-only smoke
    /// tests, etc.).
    input: String,
    /// `[output]` block — the expected `to_string_tree()` (or host-language
    /// artefact) the upstream test runner asserts. Empty when missing.
    /// Stage B's `normalize_output_for_stage_b` decides whether this is a
    /// parse-tree shape we can compare against.
    output: String,
    /// `[errors]` block — non-empty when the descriptor expects the parser
    /// to report errors. Stage A (parse-accepts-input) auto-skips
    /// error-bearing descriptors because the input is not guaranteed to
    /// parse to `Ok`; those are Stage E territory.
    errors: String,
    /// `[start]` field — the rule the upstream runner enters at. Gale's
    /// generated parser exposes both `parse(input)` (an alias for the
    /// first parser rule) and `parse_<rule>(input)` for every parser
    /// rule, so the emitted Stage A drivers dispatch via
    /// `t::parse_<start>(&input)` when this field is non-empty and via
    /// `t::parse(&input)` otherwise. See `parse_call_for_start`.
    start: String,
}

/// Mirrors `RuntimeTestDescriptorParser.parse` — section detection plus the
/// triple-quote / trailing-newline post-processing applied to each value.
/// We only return the fields we care about (grammar text + slave grammars).
fn parse_descriptor_text(text: &String) -> ParsedDescriptor {
    let mut pairs: List<DescriptorPair> = [];
    let mut current_name: String = "";
    let mut have_current = false;
    let mut current_value = String::with_capacity(256);

    for let line of text.lines() {
        let section_name = section_header_of(&line);
        match section_name {
            Some(name) => {
                if have_current {
                    pairs.push(DescriptorPair {
                        name: current_name,
                        value: current_value,
                    });
                }
                current_name = name;
                have_current = true;
                current_value = String::with_capacity(256);
            },
            None => {
                current_value.push_str(&line);
                current_value.push('\n');
            },
        }
    }
    if have_current {
        pairs.push(DescriptorPair {
            name: current_name,
            value: current_value,
        });
    }

    let mut grammar: String = "";
    let mut slaves: List<String> = [];
    let mut descriptor_type: String = "";
    let mut input: String = "";
    let mut output: String = "";
    let mut errors: String = "";
    let mut start: String = "";
    for let p of pairs {
        let processed = post_process(&p.value);
        match p.name {
            "grammar" => {
                grammar = unescape_st_text(&processed);
            },
            "slaveGrammar" => {
                slaves.push(unescape_st_text(&processed));
            },
            "type" => {
                descriptor_type = processed.trim();
            },
            "input" => {
                input = processed;
            },
            "output" => {
                output = processed;
            },
            "errors" => {
                errors = processed;
            },
            "start" => {
                start = processed;
            },
            _ => {
            },
        }
    }
    return ParsedDescriptor {
        grammar,
        slave_grammars: slaves,
        descriptor_type,
        input,
        output,
        errors,
        start,
    };
}

/// Mirror StringTemplate's text-mode escape handling for the descriptor's
/// `[grammar]` / `[slaveGrammar]` blocks. The upstream test runner wraps
/// the descriptor text in `new ST(group, descriptor.grammar)` with `<` /
/// `>` delimiters before handing it to `antlr4`, so any literal that needs
/// to survive ST as `\` must be written as `\\` in the descriptor (and any
/// literal `<` / `>` as `\<` / `\>`). Without this step, descriptors like
/// `LETTERS : ('a'|'\\u00E0'..'\\u00E5')` reach the g4 parser with the
/// 6-character escape text `\u00E0`, which cannot serve as a range bound.
///
/// We deliberately leave non-delimiter backslash sequences (`\n`, `\u…`,
/// `\t`, …) intact: ST's text mode does not interpret them, so passing
/// them through preserves the upstream-equivalent input for the g4 lexer.
fn unescape_st_text(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    let chars: List<char> = s.chars().collect();
    let n = chars.len();
    let mut i = 0;
    while i < n {
        let c = chars[i];
        if c == '\\' && i + 1 < n {
            let next = chars[i + 1];
            if next == '\\' || next == '<' || next == '>' {
                out.push(next);
                i += 2;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    return out;
}

/// If `line` is a known `[section]` header, return the section name.
fn section_header_of(line: &String) -> Option<String> {
    if line.len() <= 2 {
        return null;
    }
    if !line.starts_with("[") {
        return null;
    }
    let last_idx = line.len() - 1;
    if line.get_byte_unchecked(last_idx) != 0x5D {
        // ']'
        return null;
    }
    let candidate = line.substr_bytes(1, last_idx);
    if !is_known_section(&candidate) {
        return null;
    }
    return Option::Some(candidate);
}

/// Apply the same trim / triple-quote / trailing-newline rules as
/// RuntimeTestDescriptorParser.parse.
fn post_process(raw: &String) -> String {
    let trimmed = raw.trim();
    if trimmed.starts_with("\"\"\"") {
        return trimmed.replace("\"\"\"", "");
    }
    if trimmed.contains("\n") {
        let mut s = String::with_capacity(trimmed.len() + 1);
        s.push_str(&trimmed);
        s.push('\n');
        return s;
    }
    return trimmed;
}

// ===== Status file =====

variant Triage {
    Pass,
    Todo(String),  // reason
    Skip(String),  // reason
}

struct TriageMap {
    /// Entries keyed by `"Category/Name"` (no `.txt` suffix).
    pub entries: List<TriageEntry>,
}

struct TriageEntry {
    pub key: String,
    pub triage: Triage,
}

impl TriageMap {
    pub fn new() -> TriageMap {
        return TriageMap { entries: [] };
    }

    pub fn lookup(&self, key: &String) -> Triage {
        for let e of &self.entries {
            if e.key == *key {
                return e.triage;
            }
        }
        return Triage::Pass;
    }
}

/// Holds the orthogonal triage axes parsed from `status.toml`:
///
/// - **category** comes from the `[todo]` / `[skip]` buckets and applies to
///   the per-category `<category>_test.wado` (Stage A claim (a): the
///   extracted `.g4` parses cleanly with `g4::parse`). Drives whether a
///   descriptor is emitted at all and whether it is `#[TODO]`-marked.
/// - **stage_a** comes from the `[stage_a_todo]` / `[stage_a_skip]` buckets
///   and applies to per-descriptor generated-code-behaviour drivers
///   (Stage A claims (b) parse-accepts-input, (c) parse-must-error,
///   (d) tokens-equivalence). At most one variant per descriptor exists
///   today (the variants are mutually exclusive on `[type]` / `[errors]`),
///   so a single `Category/Name` triage entry unambiguously addresses the
///   right test file.
/// - **stage_b** comes from the `[stage_b_todo]` / `[stage_b_skip]` buckets
///   and applies to the per-descriptor tree-shape equivalence tests
///   (full-tree or sub-tree). A descriptor can be Stage A green and Stage B
///   skipped if its `[output]` block is a host-language artefact rather
///   than a parse tree, and vice versa.
/// - **stage_b_oracle** comes from the `[stage_b_oracle_skip]` /
///   `[stage_b_oracle_todo]` buckets and applies to Stage B′ tests
///   (JVM-oracle-derived expected trees). `_skip` suppresses manifest
///   emission so the oracle never runs; `_todo` runs the oracle but
///   marks the resulting test `#[TODO]` (used for descriptors where
///   the oracle's tree is right but Gale's prediction can't reproduce
///   it yet).
///
/// The maps are deliberately independent so triaging one axis never quietly
/// toggles the others.
struct TriageMaps {
    pub category: TriageMap,
    pub stage_a: TriageMap,
    pub stage_b: TriageMap,
    pub stage_b_oracle: TriageMap,
    pub stage_c: TriageMap,
}

/// Parse the status file. Tolerant of missing file (returns empty maps).
/// Format is intentionally a strict subset of TOML:
///
///   # comments
///   [todo]
///   "Category/Name" = "reason text"
///   [skip]
///   "Category/Name" = "reason text"
///   [stage_a_todo]
///   "Category/Name" = "reason text"
///   [stage_a_skip]
///   "Category/Name" = "reason text"
///   [stage_b_todo]
///   "Category/Name" = "reason text"
///   [stage_b_skip]
///   "Category/Name" = "reason text"
///   [stage_b_oracle_skip]
///   "Category/Name" = "reason text"
///   [stage_b_oracle_todo]
///   "Category/Name" = "reason text"
fn load_triage_maps(content: &Option<String>) -> TriageMaps {
    let mut category = TriageMap::new();
    let mut stage_a = TriageMap::new();
    let mut stage_b = TriageMap::new();
    let mut stage_b_oracle = TriageMap::new();
    let mut stage_c = TriageMap::new();
    let text = match content {
        Some(t) => t,
        None => {
            return TriageMaps { category, stage_a, stage_b, stage_b_oracle, stage_c };
        },
    };
    let mut section: String = "";
    for let raw_line of text.lines() {
        let line = raw_line.trim();
        if line.is_empty() || line.starts_with("#") {
            continue;
        }
        if line.starts_with("[") && line.ends_with("]") {
            section = line.substr_bytes(1, line.len() - 1);
            continue;
        }
        // Expect `"key" = "value"`
        let eq_idx = match line.find("=") {
            Some(i) => i,
            None => {
                continue;
            },
        };
        let reason = unquote(&line.substr_bytes(eq_idx + 1, line.len()).trim());
        let key = unquote(&line.substr_bytes(0, eq_idx).trim());
        match section {
            "todo" => category.entries.push(TriageEntry { key, triage: Triage::Todo(reason) }),
            "skip" => category.entries.push(TriageEntry { key, triage: Triage::Skip(reason) }),
            "stage_a_todo" => stage_a.entries.push(TriageEntry { key, triage: Triage::Todo(reason) }),
            "stage_a_skip" => stage_a.entries.push(TriageEntry { key, triage: Triage::Skip(reason) }),
            "stage_b_todo" => stage_b.entries.push(TriageEntry { key, triage: Triage::Todo(reason) }),
            "stage_b_skip" => stage_b.entries.push(TriageEntry { key, triage: Triage::Skip(reason) }),
            "stage_b_oracle_skip" => stage_b_oracle.entries.push(TriageEntry { key, triage: Triage::Skip(reason) }),
            "stage_b_oracle_todo" => stage_b_oracle.entries.push(TriageEntry { key, triage: Triage::Todo(reason) }),
            "stage_c_todo" => stage_c.entries.push(TriageEntry { key, triage: Triage::Todo(reason) }),
            "stage_c_skip" => stage_c.entries.push(TriageEntry { key, triage: Triage::Skip(reason) }),
            _ => {
            },
        }
    }
    return TriageMaps { category, stage_a, stage_b, stage_b_oracle, stage_c };
}

fn unquote(s: &String) -> String {
    if s.len() >= 2 && s.starts_with("\"") && s.ends_with("\"") {
        return s.substr_bytes(1, s.len() - 1);
    }
    return *s;
}

// ===== File system helpers =====

fn read_file_to_string(dir: &Descriptor, path: &String) -> Result<String, ErrorCode> {
    let opened = match dir.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait() {
        Ok(file) => file,
        Err(e) => {
            return Result::Err(e);
        },
    };
    let [stream, done] = opened.read_via_stream(0 as Filesize);
    let mut bytes: List<u8> = [];
    loop {
        let chunk = stream.read(FILE_READ_CHUNK);
        if chunk.len() == 0 {
            break;
        }
        for let b of chunk {
            bytes.push(b);
        }
    }
    stream.drop();
    // Consume the completion future so a mid-stream error is distinguished
    // from clean EOF instead of committing a silently truncated grammar.
    let read_result = done.read();
    done.drop();
    if let Some(Err(e)) = read_result {
        return Result::Err(e);
    }
    return match String::from_utf8(bytes) {
        Ok(s) => Result::Ok(s),
        Err(_) => Result::Err(ErrorCode::IllegalByteSequence),
    };
}

fn write_file_string(dir: &Descriptor, path: &String, content: &String) -> Result<(), ErrorCode> {
    let file = match dir.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Read | DescriptorFlags::Write,
    ).wait() {
        Ok(f) => f,
        Err(e) => {
            return Result::Err(e);
        },
    };
    let bytes: List<u8> = content.bytes().collect();
    let [rx, tx] = Stream::<u8>::new();
    let sub = file.write_via_stream(rx, 0 as Filesize);
    tx.write(bytes);
    tx.drop();
    // Await the completion future so a failed or partial write is reported
    // instead of returning Ok(()).
    let write_result = sub.read();
    sub.drop();
    if let Some(Err(e)) = write_result {
        return Result::Err(e);
    }
    return Result::Ok(());
}

/// Expand testsuite StringTemplate helpers (`<writeln(...)>` etc.) in an
/// extracted grammar into their Java-target form. Unknown helpers are left
/// verbatim; each one is reported to stderr so it can be added to the
/// table in `src/g4/action_templates.wado` or triaged into `[skip]`.
fn expand_grammar_templates(key: &String, grammar: &String) -> String with Stderr {
    let outcome = expand_action_templates(grammar);
    for let w of outcome.warnings {
        eprintln(`extract: ${*key}: ${w}`);
    }
    return outcome.text;
}

/// Remove a regular file. `Err(NoEntry)` is treated like other errors — the
/// caller decides whether a missing file is fatal (typical use is "best
/// effort cleanup", where any failure is silently ignored).
fn remove_file(dir: &Descriptor, path: &String) -> Result<(), ErrorCode> {
    return dir.unlink_file_at(*path).wait();
}

fn ensure_dir(parent: &Descriptor, name: &String) -> Result<Descriptor, ErrorCode> {
    // Ignore "exists" — we just want the directory to be present.
    let _ = parent.create_directory_at(*name).wait();
    return parent.open_at(
        PathFlags::none(),
        *name,
        OpenFlags::Directory,
        DescriptorFlags::Read | DescriptorFlags::MutateDirectory,
    ).wait();
}

fn open_dir(parent: &Descriptor, name: &String, mutate: bool) -> Result<Descriptor, ErrorCode> {
    let flags = if mutate { DescriptorFlags::Read | DescriptorFlags::MutateDirectory } else { DescriptorFlags::Read };
    return parent.open_at(
        PathFlags::none(),
        *name,
        OpenFlags::Directory,
        flags,
    ).wait();
}

fn list_files_with_suffix(dir: &Descriptor, suffix: &String) -> List<String> {
    let mut out: List<String> = [];
    let [stream, done] = dir.read_directory();
    loop {
        let chunk = stream.read(DIR_READ_CHUNK);
        if chunk.len() == 0 {
            break;
        }
        for let e of chunk {
            if e.type matches { RegularFile } && e.name.ends_with(*suffix) {
                out.push(e.name);
            }
        }
    }
    stream.drop();
    done.drop();
    out.sort();
    return out;
}

fn list_subdirs(dir: &Descriptor) -> List<String> {
    let mut out: List<String> = [];
    let [stream, done] = dir.read_directory();
    loop {
        let chunk = stream.read(DIR_READ_CHUNK);
        if chunk.len() == 0 {
            break;
        }
        for let e of chunk {
            if e.type matches { Directory } {
                out.push(e.name);
            }
        }
    }
    stream.drop();
    done.drop();
    out.sort();
    return out;
}

// ===== Test file emission =====


/// Escape a string so it can sit between Wado `"..."` quotes.
fn escape_for_wado_str(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    for let c of s.chars() {
        match c {
            '\\' => {
                out.push_str(&"\\\\");
            },
            '"' => {
                out.push_str(&"\\\"");
            },
            _ => {
                out.push(c);
            },
        }
    }
    return out;
}

struct DescriptorEntry {
    /// e.g. "Sets/CharSetLiteral"
    key: String,
    /// e.g. "CharSetLiteral"
    name: String,
    /// e.g. "Sets"
    category: String,
    /// e.g. "Sets/CharSetLiteral.g4" (relative to `grammars/`).
    g4_relpath: String,
    /// Slave grammars (relative paths; empty for non-composite descriptors).
    slave_relpaths: List<String>,
    triage: Triage,
}

fn emit_test_file_for_category(category: &String, entries: &List<DescriptorEntry>) -> String {
    let mut w = CodeWriter::new();
    w.line(&generator_attr());
    w.line(&"// Do not edit by hand — re-run the generator to regenerate.");
    w.line(&"//");
    w.line(&`// Source category: ${*category} (ANTLR4 runtime-testsuite).`);
    w.line(&"// Triage data: package-gale/tests/antlr4-compat/status.toml");
    w.blank();
    w.line(&"use { parse } from \"../../src/g4/parser.wado\";");
    w.blank();
    for let e of entries {
        match &e.triage {
            Skip(_) => {
                continue;
            },
            Todo(reason) => {
                w.line(&`// triage: ${escape_for_wado_str(reason)}`);
                w.line(&"#[TODO]");
            },
            Pass => {
            },
        }
        w.begin(&`test "${*category}/${e.name}"`);
        w.line(&`let input = #include_str("./grammars/${e.g4_relpath}");`);
        for let slave of &e.slave_relpaths {
            w.line(&`let _slave = #include_str("./grammars/${*slave}");`);
        }
        w.line(&"let result = parse(input);");
        w.line(&"if let Err(err) = &result {");
        w.indent();
        // Single-quoted Wado string keeps `{...}` literal so the
        // backticks land in the generated file unmolested.
        w.line(&"panic(`parse failed: ${err.message} at ${err.span.start}..${err.span.end}`);");
        w.dedent();
        w.line(&"}");
        w.end();
        w.blank();
    }
    return w.to_string();
}

/// The parts of a per-descriptor driver test file that vary by claim.
/// `emit_test_file` builds the common skeleton (`#![generated]` attr,
/// provenance comments, Kiln `use ... with { generator }`, triage
/// decoration, `test { ... }` wrapper) and each `emit_*` fills this in
/// plus an assertion-body closure.
struct TestFileSpec {
    category: String,
    name: String,
    /// `#![generated(by = ...)]` line; the oracle claim uses a
    /// `--finalize-stage-b-oracle` variant.
    attr: String,
    /// Comment lines after `// Source descriptor:`, each `//`-prefixed.
    doc_lines: List<String>,
    /// `tests/generated/<subdir>/...` segment: `antlr4_compat_a` / `_b` / `_b_oracle`.
    output_subdir: String,
    /// Runtime symbols imported from the grammar module; empty for none.
    import_names: List<String>,
    test_label: String,
    triage: Triage,
}

fn emit_test_file(spec: &TestFileSpec, body: fn(&mut CodeWriter)) -> String {
    let mut w = CodeWriter::new();
    w.line(&spec.attr);
    w.line(&"// Do not edit by hand — re-run the generator to regenerate.");
    w.line(&"//");
    w.line(&`// Source descriptor: ${spec.category}/${spec.name} (ANTLR4 runtime-testsuite).`);
    for let dl of &spec.doc_lines {
        w.line(dl);
    }
    w.blank();
    w.line(&`use t from "../../grammars/${spec.category}/${spec.name}.g4"`);
    w.line(&"    with {");
    w.line(&"        generator: {");
    w.line(&`            module: "../../../../src/generator.wado",`);
    w.line(&`            output_dir: "../../../generated/${spec.output_subdir}/${spec.category}/${spec.name}",`);
    w.line(&"        },");
    w.line(&"    };");
    for let sym of &spec.import_names {
        w.line(&`use \{ ${*sym} \} from "../../grammars/${spec.category}/${spec.name}.g4";`);
    }
    w.blank();
    if let Todo(reason) = &spec.triage {
        w.line(&`// triage: ${escape_for_wado_str(reason)}`);
        w.line(&"#[TODO]");
    }
    w.begin(&`test "${spec.test_label}: ${spec.category}/${spec.name}"`);
    body(&mut w);
    w.end();
    return w.to_string();
}

/// Emit one Stage B driver test file for a single descriptor.
///
/// The file lives at
/// `tests/antlr4-compat/stage_b/<Category>/<Name>_test.wado` so each
/// descriptor's grammar can be imported via Kiln (`use ... with {
/// generator: ... }`) under its own `output_dir`, which avoids the
/// one-grammar-per-file aliasing that a single per-category test file
/// would require.
///
/// The emitted test:
///   1. Imports the descriptor's `.g4` through Gale's generator,
///   2. Runs the generated parser on `[input]`,
///   3. Compares `to_string_tree()` against the normalised `[output]`.
///
/// Triage (`[stage_b_todo]` / `[stage_b_skip]`) decorates the emission:
/// `Skip` callers should not invoke this function at all; `Todo` causes
/// the test to be `#[TODO]`-marked so a known-failing assertion is
/// recorded on a separate axis from real failures (matches Stage A).
fn emit_stage_b_test_file(
    category: &String,
    name: &String,
    input: &String,
    start: &String,
    expected_tree: &String,
    triage: &Triage,
) -> String {
    let spec = TestFileSpec {
        category: *category,
        name: *name,
        attr: generator_attr(),
        doc_lines: [triage_doc_line(&"stage_b")],
        output_subdir: "antlr4_compat_b",
        import_names: ["normalize_tree"],
        test_label: "stage_b",
        triage: *triage,
    };
    return emit_test_file(&spec, |w: &mut CodeWriter| {
        w.line(&`let input = "${escape_for_wado_str(input)}";`);
        w.line(&`let expected = "${escape_for_wado_str(expected_tree)}";`);
        w.line(&`let result = t::${parse_call_for_start(start)}(&input);`);
        w.line(&"let actual = t::to_string_tree(&result);");
        w.line(&"let norm = normalize_tree(&expected);");
        // Backticks land in the generated source verbatim; the Wado compiler
        // there interprets them as a template string with `{actual}` etc.
        w.line(&"assert actual == norm, `actual:   ${actual}\\nexpected: ${norm}`;");
    });
}

/// Emit a Stage B sub-tree driver test file. Variant of
/// `emit_stage_b_test_file` for descriptors whose `[output]` is a
/// sub-tree of the start rule's tree — typically produced by an
/// `@after { <ToStringTree("$r.ctx"):writeln()> }` action that prints
/// the labelled child rather than the start rule itself.
///
/// Eligibility is decided by the caller: the normalised `[output]`
/// root rule name (extracted via `extract_root_rule_name`) must differ
/// from `[start]`. The emitted test navigates from the full tree down
/// to the first child node of that name via `find_first_child_node`.
fn emit_stage_sub_b_test_file(
    category: &String,
    name: &String,
    input: &String,
    start: &String,
    expected_tree: &String,
    sub_rule: &String,
    triage: &Triage,
) -> String {
    let spec = TestFileSpec {
        category: *category,
        name: *name,
        attr: generator_attr(),
        doc_lines: [
            triage_doc_line(&"stage_b"), "//",
            `// Stage B sub-tree: [output] is the labelled child '${*sub_rule}' subtree,`,
            "// not the start rule's full tree. Navigate via find_first_child_node.",
        ],
        output_subdir: "antlr4_compat_b",
        import_names: ["normalize_tree"],
        test_label: "stage_b_sub",
        triage: *triage,
    };
    return emit_test_file(&spec, |w: &mut CodeWriter| {
        w.line(&`let input = "${escape_for_wado_str(input)}";`);
        w.line(&`let expected = "${escape_for_wado_str(expected_tree)}";`);
        w.line(&`let result = t::${parse_call_for_start(start)}(&input);`);
        w.line(&`let actual = t::to_string_subtree(&result, &"${*sub_rule}");`);
        w.line(&"let norm = normalize_tree(&expected);");
        w.line(&"assert actual == norm, `actual:   ${actual}\\nexpected: ${norm}`;");
    });
}

/// Emit one Stage A claim (b) driver test file (parse-accepts-input)
/// for a single descriptor.
///
/// Asserts that Gale's *generated parser* accepts the descriptor's
/// `[input]` without error. Covers descriptors whose `[output]` is a
/// host-language artefact (action-print, token-name stream, `$text`
/// echo, sub-tree print) and therefore auto-skipped by
/// `normalize_output_for_stage_b`, but for which the generated parser
/// must still accept the canonical input.
///
/// Triage (`[stage_a_todo]` / `[stage_a_skip]`) decorates the emission
/// the same way Stage B does.
fn emit_stage_a_parse_test_file(
    category: &String,
    name: &String,
    input: &String,
    start: &String,
    triage: &Triage,
) -> String {
    let spec = TestFileSpec {
        category: *category,
        name: *name,
        attr: generator_attr(),
        doc_lines: [
            triage_doc_line(&"stage_a"), "//", "// Stage A claim (b): the generated parser must accept the descriptor's",
            "// [input] without returning an error. No parse-tree shape comparison.",
        ],
        output_subdir: "antlr4_compat_a",
        import_names: [],
        test_label: "stage_a_parse",
        triage: *triage,
    };
    return emit_test_file(&spec, |w: &mut CodeWriter| {
        w.line(&`let input = "${escape_for_wado_str(input)}";`);
        w.line(&`let result = t::${parse_call_for_start(start)}(&input);`);
        w.line(&"if !result.ok() {");
        w.indent();
        w.line(&"let d = &result.diagnostics[0];");
        w.line(&"panic(`parse failed: ${d.message} at ${d.span.start}..${d.span.end}`);");
        w.dedent();
        w.line(&"}");
    });
}

/// Whether a descriptor is a Stage C output-compare candidate: a Parser whose
/// `[output]` is host-language action-print text (a print action in the grammar,
/// and an output that is not a `Token.toString` dump). The caller reaches this
/// only when the `[output]` failed `normalize_output_for_stage_b` (i.e. it is
/// not a clean parse tree) and `[input]`/`[output]` are non-empty.
fn descriptor_is_stage_c_eligible(parsed: &ParsedDescriptor) -> bool {
    let t = parsed.descriptor_type.trim();
    if t != "Parser" {
        return false;
    }
    if !parsed.grammar.contains("System.out.print") {
        return false;
    }
    if parsed.output.contains("[@") {
        return false;
    }
    return true;
}

/// Stage C claim: the generated parser, run on the descriptor's `[input]`,
/// produces action-print output (`result.output`, the `p.emit` buffer) equal to
/// the descriptor's `[output]`. Emitted for Parser descriptors whose `[output]`
/// is host-language action-print text (rejected by `normalize_output_for_stage_b`
/// as a non-tree). Reuses the Stage A generated parser (`antlr4_compat_a`) — the
/// parser is identical; only the assertion differs.
fn emit_stage_c_output_test_file(
    category: &String,
    name: &String,
    input: &String,
    output: &String,
    start: &String,
    triage: &Triage,
) -> String {
    let spec = TestFileSpec {
        category: *category,
        name: *name,
        attr: generator_attr(),
        doc_lines: [
            triage_doc_line(&"stage_c"), "//", "// Stage C claim: the generated parser's action-print output",
            "// (result.output, the p.emit buffer) equals the descriptor's [output].",
        ],
        output_subdir: "antlr4_compat_a",
        import_names: [],
        test_label: "stage_c_output",
        triage: *triage,
    };
    // Normalise the descriptor's tree-print `[output]` the same way Stage B
    // normalises its oracle tree: drop a tail ` <EOF>` marker so the expected
    // matches Gale's `to_string_tree()` shape (which omits EOF by design).
    // A no-op for non-tree output (no ` <EOF>)` tail).
    let expected = strip_tail_eof_marker(output);
    return emit_test_file(&spec, |w: &mut CodeWriter| {
        w.line(&`let input = "${escape_for_wado_str(input)}";`);
        w.line(&`let expected = "${escape_for_wado_str(&expected)}";`);
        w.line(&`let result = t::${parse_call_for_start(start)}(&input);`);
        w.line(&"assert result.output == expected, `output:\\n${result.output}\\nexpected:\\n${expected}`;");
    });
}

/// Pick the public parser entry to call for a descriptor's `[start]`.
/// Returns `parse` (the first-rule alias) when no `[start]` is set, or
/// `parse_<snake_case(start)>` otherwise — Gale's codegen normalises
/// rule names to snake_case (e.g. `cppCompilationUnit` →
/// `parse_cpp_compilation_unit`).
fn parse_call_for_start(start: &String) -> String {
    let trimmed = start.trim();
    if trimmed.is_empty() {
        return "parse";
    }
    return `parse_${to_snake_case(&trimmed)}`;
}

/// Categories whose descriptors are emitted as Stage A claim (c)
/// (parse-must-error) drivers. Other categories may carry non-empty
/// `[errors]` blocks for ambiguity reports, predicate failures, or
/// other diagnostics that don't actually fail the parse — those are
/// not parse-must-error candidates.
fn stage_a_err_category_eligible(category: &String) -> bool {
    return match *category {
        "ParserErrors" | "LexerErrors" => true,
        _ => false,
    };
}

/// Decide whether a descriptor `[output]` block is a Stage A claim (d)
/// (tokens-equivalence) target. ANTLR4's `Token.toString()` dump has
/// the form
///
///   [@<idx>,<start>:<end>='<text>',<<type>>,<line>:<col>]
///
/// one line per token, optionally prefixed by action-print output
/// (`<writeln("foo")>` echoes inside `{ ... }` action bodies).
///
/// Returns the normalised expectation, or `None` when the output cannot be
/// reduced to a tokens dump at all (empty, or no `[@…]` line ever appears —
/// auto-skip). Action-print prefix lines stay in the expectation: the lexer
/// executes its action bodies and `to_lexer_string` renders the output sink
/// ahead of the dump. Whether a descriptor still diverges is a
/// `[stage_a_todo]` decision, not something this classifier can know — it never
/// sees Gale's actual output.

/// Whether `line` opens a row of ANTLR4's lexer DFA dump (`s0-' '->:s5=>3`,
/// `:s1=>2-'n'->:s2=>2`), which `showDFA` descriptors append after the token
/// rows. A row opens with a state id — an optional `:`, `s`, digits — followed
/// immediately by its transition (`-`) or accept (`=>`) marker. It describes
/// ANTLR's own simulator rather than the token stream, so it is not part of what
/// a Gale-generated lexer can ever produce.
fn is_lexer_dfa_row_start(line: &String) -> bool {
    let cs: List<char> = line.trim().chars().collect();
    let mut i = 0;
    if i < cs.len() && cs[i] == ':' {
        i += 1;
    }
    if i >= cs.len() || cs[i] != 's' {
        return false;
    }
    i += 1;
    let digits_at = i;
    while i < cs.len() && cs[i] matches { '0'..='9' } {
        i += 1;
    }
    if i == digits_at || i >= cs.len() {
        return false;
    }
    return cs[i] == '-' || cs[i] == '=';
}

/// Drop the `showDFA` DFA dump from a descriptor `[output]` so claim (d)
/// compares only the token stream. Without this every `showDFA` descriptor is
/// permanently unmatchable and its real token-level gap stays hidden behind an
/// unreachable expectation.
///
/// A row's transition char is quoted verbatim, so a transition on a newline
/// (`s0-'\n'->:s2=>3`) spans two physical lines. A row therefore ends at the
/// line carrying its `->`, not necessarily at the line it started on.
fn strip_lexer_dfa_dump(raw: &String) -> String {
    let mut lines: List<String> = [];
    for let line of raw.lines() {
        lines.push(line);
    }
    let mut out = String::with_capacity(raw.len());
    let mut i = 0;
    while i < lines.len() {
        if is_lexer_dfa_row_start(&lines[i]) {
            if lines[i].contains("->") {
                i += 1;
                continue;
            }
            // A transition on a literal newline splits the row over exactly two
            // physical lines, the second carrying the `->`. Require that, so a
            // line that merely looks like a row start (an action print such as
            // `s1=5`) does not swallow the rest of the output.
            if i + 1 < lines.len() && lines[i + 1].contains("->") {
                i += 2;
                continue;
            }
        }
        out.push_str(&lines[i]);
        out.push('\n');
        i += 1;
    }
    return out;
}

fn classify_output_for_tokens(input: &String) -> Option<String> {
    let raw = &strip_lexer_dfa_dump(input);
    let mut seen_token_line = false;
    for let line of raw.lines() {
        let t = line.trim();
        if t.is_empty() {
            continue;
        }
        if t.starts_with("[@") {
            seen_token_line = true;
        }
    }
    if !seen_token_line {
        // No `[@…]` line at all — not a tokens dump even with Stage C.
        return null;
    }
    // Re-emit with a trailing newline per line — matches what
    // `to_lexer_string` (claim (d)) produces — and trim outer whitespace.
    let mut out = String::with_capacity(raw.len());
    for let line of raw.lines() {
        let t = line.trim();
        if t.is_empty() {
            continue;
        }
        out.push_str(&t);
        out.push('\n');
    }
    return Option::<String>::Some(out);
}

/// Emit one Stage A claim (c) driver test file (parse-must-error) for
/// a single descriptor.
///
/// Inverts Stage A claim (b): instead of asserting `Ok`, asserts that
/// `g::parse(&input)` (for Parser-type grammars) returns `Err`, or
/// that `g::tokenize(&input)` (for Lexer-type grammars) produces at
/// least one `TK_ERROR` token. ANTLR4 may report errors yet continue
/// via error recovery and produce a tree — Gale does not (yet) do
/// error recovery, so `Err` is the well-defined "Gale noticed the
/// error" check.
///
/// Eligibility is decided by the caller (Parser/Lexer type, non-empty
/// `[input]`, non-empty `[errors]`, single grammar, category in the
/// whitelist via `stage_a_err_category_eligible`).
fn emit_stage_a_err_test_file(
    category: &String,
    name: &String,
    input: &String,
    start: &String,
    is_lexer: bool,
    triage: &Triage,
) -> String {
    let mut import_names: List<String> = [];
    if is_lexer {
        import_names.push("TK_ERROR");
    }
    let spec = TestFileSpec {
        category: *category,
        name: *name,
        attr: generator_attr(),
        doc_lines: [
            triage_doc_line(&"stage_a"), "//",
            "// Stage A claim (c): the generated parser/lexer must report an error for [input].",
            "//   - Parser-type: t::parse(&input) must return Err.",
            "//   - Lexer-type:  t::tokenize(&input) must produce at least one TK_ERROR.",
        ],
        output_subdir: "antlr4_compat_a",
        import_names,
        test_label: "stage_a_err",
        triage: *triage,
    };
    return emit_test_file(&spec, |w: &mut CodeWriter| {
        w.line(&`let input = "${escape_for_wado_str(input)}";`);
        if is_lexer {
            w.line(&"let tokens = t::tokenize(&input);");
            w.line(&"let mut has_err = false;");
            w.begin(&"for let mut i = 0; i < tokens.len(); i += 1");
            w.begin(&"if tokens.kinds[i] == TK_ERROR");
            w.line(&"has_err = true;");
            w.line(&"break;");
            w.end();
            w.end();
            w.line(&"assert has_err, `expected at least one TK_ERROR token in tokenize output`;");
        } else {
            w.line(&`let result = t::${parse_call_for_start(start)}(&input);`);
            w.line(&"assert !result.ok(), `expected parse to fail but it succeeded`;");
        }
    });
}

/// Emit one Stage A claim (d) driver test file (tokens-equivalence)
/// for a single descriptor.
///
/// Runs `t::tokenize(&input)` and renders the result through
/// `to_lexer_string` (defined in `runtime/tools.wado`, inlined into every
/// generated module). The output is compared verbatim against the
/// descriptor's `[output]` after `normalize_output_for_tokens` has
/// stripped surrounding whitespace.
///
/// Eligibility is decided by the caller (Lexer type, non-empty
/// `[input]`, non-empty `[output]`, empty `[errors]`, single grammar,
/// output is a clean `[@…]` dump).
fn emit_stage_a_tokens_test_file(
    category: &String,
    name: &String,
    input: &String,
    expected: &String,
    triage: &Triage,
) -> String {
    let spec = TestFileSpec {
        category: *category,
        name: *name,
        attr: generator_attr(),
        doc_lines: [
            triage_doc_line(&"stage_a"), "//",
            "// Stage A claim (d): t::tokenize(&input) renders to the same ANTLR4-format",
            "// dump as the descriptor's [output] block.",
        ],
        output_subdir: "antlr4_compat_a",
        import_names: ["TK_EOF"],
        test_label: "stage_a_tokens",
        triage: *triage,
    };
    return emit_test_file(&spec, |w: &mut CodeWriter| {
        w.line(&`let input = "${escape_for_wado_str(input)}";`);
        w.line(&`let expected = "${escape_for_wado_str(expected)}";`);
        w.line(&"let tokens = t::tokenize(&input);");
        w.line(&"let actual = t::to_lexer_string(&tokens, TK_EOF);");
        w.line(&"assert actual == expected, `actual:\\n${actual}\\nexpected:\\n${expected}`;");
    });
}

// ===== Main =====

struct CliArgs {
    want_all: bool,
    categories: List<String>,
    /// When true, skip the descriptor walk entirely and instead drain
    /// `tests/antlr4-compat/oracle-pending/` into
    /// `tests/antlr4-compat/stage_b_oracle/`. Driven by the shell
    /// wrapper after it has invoked the JVM oracle for each pending
    /// candidate; see `scripts/extract-antlr4-descriptors.sh`.
    finalize_stage_b_oracle: bool,
}

fn parse_cli_args(arguments: List<String>) -> Result<CliArgs, String> {
    let mut want_all = false;
    let mut categories: List<String> = [];
    let mut finalize_stage_b_oracle = false;
    for let a of arguments {
        match a {
            "all" => {
                want_all = true;
            },
            "--finalize-stage-b-oracle" => {
                finalize_stage_b_oracle = true;
            },
            _ => {
                // A leading `-` marks an option, not a category. Reject
                // unknown flags loudly: silently dropping a typo'd flag
                // (e.g. `--finalize-stage-b-oracl`) would otherwise run a
                // full extract with the intended behaviour disabled.
                if a.starts_with("-") {
                    return Result::<CliArgs, String>::Err(`extract: unknown flag '${a}'`);
                }
                categories.push(a);
            },
        }
    }
    if !want_all && categories.is_empty() {
        categories = default_categories();
    }
    return Result::<CliArgs, String>::Ok(CliArgs { want_all, categories, finalize_stage_b_oracle });
}

export fn run() with Stdout, Stderr, Environment, Preopens, Exit {
    let cli = match parse_cli_args(args()) {
        Ok(c) => c,
        Err(msg) => {
            eprintln(msg);
            eprintln(
                "extract: usage: extract_antlr4_descriptors.wado [all | <Category> ...] [--finalize-stage-b-oracle]",
            );
            exit(2);
        },
    };
    let want_all = cli.want_all;
    let mut categories = cli.categories;

    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("extract: no preopened directories available (run via `wado run`)");
        exit(1);
    }
    let root = dirs[0].0;

    if cli.finalize_stage_b_oracle {
        finalize_stage_b_oracle(&root);
        return;
    }

    // Open the antlr4 descriptors source. If missing, error out — never auto-init.
    let src_root = match open_dir(&root, &descriptors_root(), false) {
        Ok(d) => d,
        Err(_) => {
            eprintln(`extract: cannot open '${descriptors_root()}'`);
            eprintln("extract: the antlr4 submodule appears to be missing.");
            eprintln("extract: run: git submodule update --init --recommend-shallow vendor/antlr4");
            eprintln("extract: (this script never auto-initializes submodules)");
            exit(1);
        },
    };

    if want_all {
        categories = list_subdirs(&src_root);
    }

    println(`extract: source root  = ${descriptors_root()}`);
    println(`extract: target dir   = ${compat_root_dir()}`);
    println(`extract: status file  = ${status_file_path()}`);
    let mut categories_str = String::with_capacity(64);
    for let mut i = 0; i < categories.len(); i += 1 {
        if i > 0 {
            categories_str.push_str(&", ");
        }
        categories_str.push_str(&categories[i]);
    }
    println(`extract: categories   = ${categories_str}`);

    // Open the package-gale tests directory (mutable: we will create files there).
    let tests_dir = match open_dir(&root, &"package-gale/tests", true) {
        Ok(d) => d,
        Err(_) => {
            eprintln("extract: cannot open 'package-gale/tests' for writing");
            exit(1);
        },
    };

    // Ensure the compat root exists — everything we generate is rooted here.
    let compat_dir = match ensure_dir(&tests_dir, &"antlr4-compat") {
        Ok(d) => d,
        Err(_) => {
            eprintln("extract: cannot create or open antlr4-compat/");
            exit(1);
        },
    };

    let status_text = match read_file_to_string(&root, &status_file_path()) {
        Ok(s) => Option::Some(s),
        Err(_) => null,
    };
    let triage_maps = load_triage_maps(&status_text);
    let triage_map = triage_maps.category;
    let stage_a_triage_map = triage_maps.stage_a;
    let stage_b_triage_map = triage_maps.stage_b;
    let stage_b_oracle_triage_map = triage_maps.stage_b_oracle;
    let stage_c_triage_map = triage_maps.stage_c;

    let grammars_dir = match ensure_dir(&compat_dir, &grammars_subdir()) {
        Ok(d) => d,
        Err(_) => {
            eprintln("extract: cannot create or open antlr4-compat/grammars/");
            exit(1);
        },
    };

    let stage_b_dir = match ensure_dir(&compat_dir, &"stage_b") {
        Ok(d) => d,
        Err(_) => {
            eprintln("extract: cannot create or open antlr4-compat/stage_b/");
            exit(1);
        },
    };

    let stage_a_dir = match ensure_dir(&compat_dir, &"stage_a") {
        Ok(d) => d,
        Err(_) => {
            eprintln("extract: cannot create or open antlr4-compat/stage_a/");
            exit(1);
        },
    };

    let stage_c_dir = match ensure_dir(&compat_dir, &"stage_c") {
        Ok(d) => d,
        Err(_) => {
            eprintln("extract: cannot create or open antlr4-compat/stage_c/");
            exit(1);
        },
    };

    // Stage B′ manifest: `<base>.input` / `.start` per candidate,
    // drained by `extract-antlr4-descriptors.sh` after this run.
    let oracle_pending_dir = match ensure_dir(&compat_dir, &"oracle-pending") {
        Ok(d) => d,
        Err(_) => {
            eprintln("extract: cannot create or open antlr4-compat/oracle-pending/");
            exit(1);
        },
    };

    let mut total_emitted = 0;
    let mut total_todo = 0;
    let mut total_skip = 0;
    let mut stage_a_parse_emitted = 0;
    let mut stage_a_err_emitted = 0;
    let mut stage_a_tokens_emitted = 0;
    let mut stage_a_todo = 0;
    let mut stage_a_skip = 0;
    let mut stage_a_auto_skip = 0;
    // Descriptors that need infrastructure we don't have yet. Tracked
    // separately so the extractor summary line surfaces the gap instead
    // of folding them into the generic auto-skip count.
    let mut deferred_composite = 0;
    let mut stage_b_emitted = 0;
    let mut stage_b_todo = 0;
    let mut stage_b_skip = 0;
    let mut stage_b_auto_skip = 0;
    let mut stage_b_oracle_pending = 0;
    let mut stage_b_oracle_suppressed = 0;
    let mut stage_c_emitted = 0;
    let mut stage_c_todo = 0;

    for let category of &categories {
        let cat_src_dir = match open_dir(&src_root, category, false) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`extract: missing category '${*category}', skipping`);
                continue;
            },
        };
        let cat_out_dir = match ensure_dir(&grammars_dir, category) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`extract: cannot create category dir '${*category}', skipping`);
                continue;
            },
        };
        let stage_b_cat_dir = match ensure_dir(&stage_b_dir, category) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`extract: cannot create stage_b/${*category}/, skipping`);
                continue;
            },
        };
        let stage_a_cat_dir = match ensure_dir(&stage_a_dir, category) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`extract: cannot create stage_a/${*category}/, skipping`);
                continue;
            },
        };
        let stage_c_cat_dir = match ensure_dir(&stage_c_dir, category) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`extract: cannot create stage_c/${*category}/, skipping`);
                continue;
            },
        };
        let oracle_pending_cat_dir = match ensure_dir(&oracle_pending_dir, category) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`extract: cannot create oracle-pending/${*category}/, skipping`);
                continue;
            },
        };

        let txt_files = list_files_with_suffix(&cat_src_dir, &".txt");
        let mut entries: List<DescriptorEntry> = [];
        // Tracks per-category I/O / parse failures separately from triage
        // skips. `entries.is_empty()` alone cannot distinguish "every
        // descriptor was [skip]-triaged" (intentional, we want to drop
        // the file) from "every descriptor errored out" (real failure;
        // we must not silently delete the previous run's output).
        let mut category_errors = 0;

        for let txt_name of &txt_files {
            // Strip ".txt" → descriptor name.
            let base = txt_name.substr_bytes(0, txt_name.len() - 4);
            let key = `${*category}/${base}`;

            let triage = triage_map.lookup(&key);
            if let Skip(reason) = &triage {
                println(`  skip:  ${key} — ${*reason}`);
                total_skip += 1;
                // Category-level [skip] supersedes all per-stage emission, so
                // sweep any stale per-stage files away. Without this, flipping
                // a descriptor from a per-stage [todo] / pass into [skip] would
                // leave the previous Stage A / Stage B test files behind.
                let stale_b_filename = `${base}_test.wado`;
                if let Err(_) = remove_file(&stage_b_cat_dir, &stale_b_filename) {
                }
                for let suffix of ["_parse_test.wado", "_err_test.wado", "_tokens_test.wado"] {
                    let stale = `${base}${suffix}`;
                    if let Err(_) = remove_file(&stage_a_cat_dir, &stale) {
                    }
                }
                // Also sweep the grammar file and its slaves — a [skip]
                // descriptor's .g4 usually carries StringTemplate directives,
                // i.e. it is not even a valid grammar, and leaving it behind
                // makes the committed corpus look larger than the supported
                // set. (Slave names are `{base}.slave<N>.g4`; enumerate by
                // prefix since N is unknown without parsing the descriptor.)
                if let Err(_) = remove_file(&cat_out_dir, &`${base}.g4`) {
                }
                let slave_prefix = `${base}.slave`;
                for let existing of list_files_with_suffix(&cat_out_dir, &".g4") {
                    if existing.starts_with(slave_prefix) {
                        let _ = remove_file(&cat_out_dir, &existing);
                    }
                }
                continue;
            }

            let raw = match read_file_to_string(&cat_src_dir, txt_name) {
                Ok(s) => s,
                Err(_) => {
                    eprintln(`extract: cannot read ${key}`);
                    category_errors += 1;
                    continue;
                },
            };

            let mut parsed = parse_descriptor_text(&raw);
            if parsed.grammar.is_empty() {
                eprintln(`extract: ${key} has no [grammar] section, skipping`);
                category_errors += 1;
                continue;
            }

            // Bake the Java-target expansion of the testsuite's
            // StringTemplate helpers (`<writeln(...)>`, `<True()>`, ...)
            // into the extracted grammar, so the committed corpus carries
            // real action bodies. Unknown helpers stay verbatim and warn.
            parsed.grammar = expand_grammar_templates(&key, &parsed.grammar);
            for let mut i = 0; i < parsed.slave_grammars.len(); i += 1 {
                parsed.slave_grammars[i] = expand_grammar_templates(&key, &parsed.slave_grammars[i]);
            }

            // Write the main grammar.
            let g4_filename = `${base}.g4`;
            if let Err(_) = write_file_string(&cat_out_dir, &g4_filename, &parsed.grammar) {
                eprintln(`extract: cannot write ${key}.g4`);
                category_errors += 1;
                continue;
            }

            // Write slave grammars if present.
            let mut slave_relpaths: List<String> = [];
            let mut slave_failed = false;
            for let mut i = 0; i < parsed.slave_grammars.len(); i += 1 {
                let slave_name = `${base}.slave${i + 1}.g4`;
                if let Err(_) = write_file_string(&cat_out_dir, &slave_name, &parsed.slave_grammars[i]) {
                    eprintln(`extract: cannot write ${key} ${slave_name}`);
                    slave_failed = true;
                    break;
                }
                slave_relpaths.push(`${*category}/${slave_name}`);
            }
            if slave_failed {
                // Skip emitting the whole descriptor — a composite that
                // references a slave we failed to write is corrupt. Count it
                // like a failed main-grammar write so the "leave previous
                // files untouched" protection fires for the category.
                category_errors += 1;
                continue;
            }

            if let Todo(_) = &triage {
                total_todo += 1;
            }
            total_emitted += 1;

            entries.push(DescriptorEntry {
                key,
                name: base,
                category: *category,
                g4_relpath: `${*category}/${g4_filename}`,
                slave_relpaths,
                triage,
            });

            // ----- Stage A claim (b/c/d): per-descriptor driver(s)
            // asserting Gale's generated parser/lexer behaviour on
            // `[input]`. The three claims are mutually exclusive on the
            // descriptor's `[type]` / `[errors]` pair, so at most one
            // variant is emitted per descriptor:
            //
            //   * (b) parse-accepts-input — Parser, empty `[errors]`
            //         → stage_a/<C>/<N>_parse_test.wado
            //   * (c) parse-must-error    — `ParserErrors` /
            //         `LexerErrors` category, non-empty `[errors]`
            //         → stage_a/<C>/<N>_err_test.wado
            //   * (d) tokens-equivalence  — Lexer, empty `[errors]`,
            //         `[output]` is a clean `[@…` dump
            //         → stage_a/<C>/<N>_tokens_test.wado
            //
            // A single `[stage_a_todo]` / `[stage_a_skip]` triage entry
            // keyed by `Category/Name` addresses whichever variant fires.
            // All variants share the same generated grammar under
            // `tests/generated/antlr4_compat_a/<C>/<N>/`.
            let parse_eligible = parsed.descriptor_type == "Parser"
                && !parsed.input.is_empty()
                && parsed.errors.is_empty()
                && parsed.slave_grammars.len() == 0;
            let err_eligible = stage_a_err_category_eligible(category)
                && (parsed.descriptor_type == "Parser" || parsed.descriptor_type == "Lexer")
                && !parsed.input.is_empty()
                && !parsed.errors.is_empty()
                && parsed.slave_grammars.len() == 0;
            let tokens_basic = parsed.descriptor_type == "Lexer"
                && !parsed.input.is_empty()
                && !parsed.output.is_empty()
                && parsed.errors.is_empty()
                && parsed.slave_grammars.len() == 0;
            let tokens_target = if tokens_basic { classify_output_for_tokens(&parsed.output) } else { null };

            let parse_filename = `${base}_parse_test.wado`;
            let err_filename = `${base}_err_test.wado`;
            let tokens_filename = `${base}_tokens_test.wado`;

            // Stale-file sweep: only the variant that fires keeps its file;
            // the other two get removed. Filename uniqueness across stages
            // makes this idempotent without tracking the previous state.
            if !parse_eligible {
                if let Err(_) = remove_file(&stage_a_cat_dir, &parse_filename) {
                }
            }
            if !err_eligible {
                if let Err(_) = remove_file(&stage_a_cat_dir, &err_filename) {
                }
            }
            if tokens_target matches { None } {
                if let Err(_) = remove_file(&stage_a_cat_dir, &tokens_filename) {
                }
            }

            let stage_a_triage = stage_a_triage_map.lookup(&key);
            let any_eligible = parse_eligible || err_eligible || tokens_target matches { Some(_) };
            if !any_eligible {
                stage_a_auto_skip += 1;
                // Composite descriptors (slave grammars) cannot reach Kiln's
                // single-grammar `use ... from "..."` directive today — track
                // them separately so they don't disappear into the generic
                // auto-skip bucket. They will become eligible once the `use`
                // directive learns to resolve `import S;` against sibling
                // `<Name>.slaveN.g4` files.
                if parsed.slave_grammars.len() > 0 {
                    deferred_composite += 1;
                }
            } else if let Skip(reason) = &stage_a_triage {
                println(`  skipA: ${key} — ${*reason}`);
                stage_a_skip += 1;
                // Remove the variant's file if it exists (above sweep only
                // touches the non-eligible variants; an eligible-but-skipped
                // variant still needs removal).
                if let Err(_) = remove_file(&stage_a_cat_dir, &parse_filename) {
                }
                if let Err(_) = remove_file(&stage_a_cat_dir, &err_filename) {
                }
                if let Err(_) = remove_file(&stage_a_cat_dir, &tokens_filename) {
                }
            } else if parse_eligible {
                let src = emit_stage_a_parse_test_file(category, &base, &parsed.input, &parsed.start, &stage_a_triage);
                if let Err(_) = write_file_string(&stage_a_cat_dir, &parse_filename, &src) {
                    eprintln(`extract: cannot write stage_a/${*category}/${parse_filename}`);
                } else {
                    if let Todo(_) = &stage_a_triage {
                        stage_a_todo += 1;
                    }
                    stage_a_parse_emitted += 1;
                }
            } else if err_eligible {
                let is_lexer = parsed.descriptor_type == "Lexer";
                let src = emit_stage_a_err_test_file(
                    category,
                    &base,
                    &parsed.input,
                    &parsed.start,
                    is_lexer,
                    &stage_a_triage,
                );
                if let Err(_) = write_file_string(&stage_a_cat_dir, &err_filename, &src) {
                    eprintln(`extract: cannot write stage_a/${*category}/${err_filename}`);
                } else {
                    if let Todo(_) = &stage_a_triage {
                        stage_a_todo += 1;
                    }
                    stage_a_err_emitted += 1;
                }
            } else if let Some(target) = tokens_target {
                let src = emit_stage_a_tokens_test_file(category, &base, &parsed.input, &target, &stage_a_triage);
                if let Err(_) = write_file_string(&stage_a_cat_dir, &tokens_filename, &src) {
                    eprintln(`extract: cannot write stage_a/${*category}/${tokens_filename}`);
                } else {
                    if let Todo(_) = &stage_a_triage {
                        stage_a_todo += 1;
                    }
                    stage_a_tokens_emitted += 1;
                }
            }

            // ----- Stage B: emit a tree-shape equivalence test if eligible.
            // Eligibility (all must hold):
            //   * descriptor has a non-empty [output] block,
            //   * descriptor has a non-empty [input] block (otherwise there is
            //     nothing to feed to the generated parser),
            //   * descriptor is single-grammar (composite descriptors with
            //     slave grammars cannot be reached through one `use` directive,
            //     and Stage B currently has no machinery for grammar imports),
            //   * the [output] normaliser recognises it as a parse tree,
            //   * the [output] tree's root rule equals [start]. ANTLR4
            //     descriptors often print a sub-tree via an `@after` action
            //     like `<ToStringTree("$labeled.ctx"):writeln()>`; their
            //     [output] starts with a non-start rule name. Gale's
            //     `t::parse(input)` always returns the start rule's full
            //     tree, so wrapping would cause a false-negative. Detect by
            //     checking that the normalised output starts with `(<start>`.
            // Anything else is silently skipped (auto-skip counter); explicit
            // [stage_b_skip] / [stage_b_todo] entries override the default.
            let stage_b_filename_pre = `${base}_test.wado`;
            // Stage B′ manifest: default-clear here so every Stage B
            // path leaves a clean slate; the auto-skip branches below
            // re-write the files when the descriptor is a candidate.
            let oracle_input_filename = `${base}.input`;
            let oracle_start_filename = `${base}.start`;
            let _ = remove_file(&oracle_pending_cat_dir, &oracle_input_filename);
            let _ = remove_file(&oracle_pending_cat_dir, &oracle_start_filename);
            let oracle_triage = stage_b_oracle_triage_map.lookup(&key);
            let oracle_intrinsic = stage_b_oracle_eligible(&parsed);
            let oracle_eligible = oracle_intrinsic && !oracle_triage matches { Skip(_) };
            if oracle_intrinsic && oracle_triage matches { Skip(_) } {
                stage_b_oracle_suppressed += 1;
            }
            if parsed.output.is_empty() || parsed.input.is_empty() || parsed.slave_grammars.len() > 0 {
                // Stale-file sweep mirrors the per-stage paths: drop a
                // previously-emitted file when the descriptor lost its
                // [output] (no Stage B at all) or became composite.
                if let Err(_) = remove_file(&stage_b_cat_dir, &stage_b_filename_pre) {
                }
                continue;
            }
            let normalised = match normalize_output_for_stage_b(&parsed.output) {
                Some(t) => t,
                None => {
                    // Stage C: the descriptor's own [output] is action-print
                    // text, not a tree — emit an output-compare test (parses
                    // [input], asserts result.output == [output]). Independent
                    // of the Stage B′ oracle path below, which derives a tree.
                    if descriptor_is_stage_c_eligible(&parsed) {
                        let stage_c_triage = stage_c_triage_map.lookup(&key);
                        let stage_c_filename = `${base}_output_test.wado`;
                        if let Skip(_) = &stage_c_triage {
                            let _ = remove_file(&stage_c_cat_dir, &stage_c_filename);
                        } else {
                            let src = emit_stage_c_output_test_file(
                                category,
                                &base,
                                &parsed.input,
                                &parsed.output,
                                &parsed.start,
                                &stage_c_triage,
                            );
                            if let Err(_) = write_file_string(&stage_c_cat_dir, &stage_c_filename, &src) {
                                eprintln(`extract: cannot write stage_c/${*category}/${stage_c_filename}`);
                            } else {
                                stage_c_emitted += 1;
                                if let Todo(_) = &stage_c_triage {
                                    stage_c_todo += 1;
                                }
                            }
                        }
                    }
                    stage_b_auto_skip += 1;
                    if let Err(_) = remove_file(&stage_b_cat_dir, &stage_b_filename_pre) {
                    }
                    if oracle_eligible {
                        if let Err(_) = write_oracle_pending_files(
                            &oracle_pending_cat_dir,
                            &oracle_input_filename,
                            &oracle_start_filename,
                            &parsed,
                        ) {
                            eprintln(`extract: cannot write oracle-pending/${*category}/${base}.*`);
                        } else {
                            stage_b_oracle_pending += 1;
                        }
                    }
                    continue;
                },
            };
            let start_trimmed = parsed.start.trim();
            let start_prefix = `(${start_trimmed}`;
            let is_sub_tree = !start_trimmed.is_empty() && !normalised.starts_with(start_prefix);
            let sub_rule_opt = if is_sub_tree { extract_root_rule_name(&normalised) } else { null };
            // Descriptors whose `[output]` root rule equals `[start]` use the
            // direct full-tree comparator. When the root differs (typical
            // `@after { <ToStringTree("$r.ctx"):writeln()> }` pattern), drop
            // into the sub-tree emitter when we can identify the child rule
            // name; auto-skip otherwise.
            let stage_b_triage = stage_b_triage_map.lookup(&key);
            if let Skip(reason) = &stage_b_triage {
                println(`  skipB: ${key} — ${*reason}`);
                stage_b_skip += 1;
                // Sweep the stale Stage B test, mirroring the Stage A skip
                // branch: flipping a previously-emitted descriptor into
                // [stage_b_skip] must not leave the old test behind.
                let _ = remove_file(&stage_b_cat_dir, &`${base}_test.wado`);
                continue;
            }
            let stage_b_filename = `${base}_test.wado`;
            if is_sub_tree {
                let sub_rule = match sub_rule_opt {
                    Some(r) => r,
                    None => {
                        stage_b_auto_skip += 1;
                        if let Err(_) = remove_file(&stage_b_cat_dir, &stage_b_filename) {
                        }
                        // Oracle produces the full tree for `[start]`,
                        // so the sub-tree-identification concern doesn't
                        // apply on the Stage B′ path.
                        if oracle_eligible {
                            if let Err(_) = write_oracle_pending_files(
                                &oracle_pending_cat_dir,
                                &oracle_input_filename,
                                &oracle_start_filename,
                                &parsed,
                            ) {
                                eprintln(`extract: cannot write oracle-pending/${*category}/${base}.*`);
                            } else {
                                stage_b_oracle_pending += 1;
                            }
                        }
                        continue;
                    },
                };
                let stage_b_src = emit_stage_sub_b_test_file(
                    category,
                    &base,
                    &parsed.input,
                    &parsed.start,
                    &normalised,
                    &sub_rule,
                    &stage_b_triage,
                );
                if let Err(_) = write_file_string(&stage_b_cat_dir, &stage_b_filename, &stage_b_src) {
                    eprintln(`extract: cannot write stage_b/${*category}/${stage_b_filename}`);
                    continue;
                }
            } else {
                let stage_b_src = emit_stage_b_test_file(
                    category,
                    &base,
                    &parsed.input,
                    &parsed.start,
                    &normalised,
                    &stage_b_triage,
                );
                if let Err(_) = write_file_string(&stage_b_cat_dir, &stage_b_filename, &stage_b_src) {
                    eprintln(`extract: cannot write stage_b/${*category}/${stage_b_filename}`);
                    continue;
                }
            }
            if let Todo(_) = &stage_b_triage {
                stage_b_todo += 1;
            }
            stage_b_emitted += 1;
        }

        // Emit the per-category test file. Skip when nothing would land in
        // the file *and* no descriptor errored out along the way — i.e. the
        // empty result is the intentional case where every descriptor was
        // `[skip]`-triaged (currently only `Listeners`). When at least one
        // descriptor failed to load / parse / write, leave any previous
        // file in place: deleting it would silently hide the failure
        // behind an `empty:` line, and rewriting it as a header-only stub
        // would erase the last good run's coverage.
        let test_filename = `${to_snake_case(category)}_test.wado`;
        if entries.is_empty() {
            if category_errors > 0 {
                eprintln(
                    `extract: ${*category} had ${category_errors} descriptor failure(s); leaving antlr4-compat/${test_filename} untouched`,
                );
                continue;
            }
            if let Err(_) = remove_file(&compat_dir, &test_filename) {
                // No prior file is fine; only a real I/O failure would surface here.
            }
            println(`  empty: antlr4-compat/${test_filename} (no descriptors emitted; not writing)`);
            continue;
        }
        let test_src = emit_test_file_for_category(category, &entries);
        if let Err(_) = write_file_string(&compat_dir, &test_filename, &test_src) {
            eprintln(`extract: cannot write ${test_filename}`);
            continue;
        }
        println(`  wrote: antlr4-compat/${test_filename} (${entries.len()} tests)`);
    }

    println("");
    println(
        `extract: stage A claim (a) — .g4 parses cleanly: emitted ${total_emitted} descriptor(s) across ${categories.len(
        )} categor(ies)`,
    );
    println(`extract:           ${total_todo} marked #[TODO]`);
    println(`extract:           ${total_skip} skipped`);
    let stage_a_emitted = stage_a_parse_emitted + stage_a_err_emitted + stage_a_tokens_emitted;
    println(
        `extract: stage A claims (b/c/d) — generated parser/lexer behaviour: emitted ${stage_a_emitted} per-descriptor driver(s)`,
    );
    println(`extract:           ${stage_a_parse_emitted} parse-accepts-input (_parse_test.wado)`);
    println(`extract:           ${stage_a_err_emitted} parse-must-error    (_err_test.wado)`);
    println(`extract:           ${stage_a_tokens_emitted} tokens-equivalence  (_tokens_test.wado)`);
    println(`extract:           ${stage_a_todo} marked #[TODO]`);
    println(`extract:           ${stage_a_skip} explicit skip`);
    println(`extract:           ${stage_a_auto_skip} auto-skip (no eligible variant)`);
    println(`extract: stage B — tree-shape equivalence: emitted ${stage_b_emitted} per-descriptor driver(s)`);
    println(`extract:           ${stage_b_todo} marked #[TODO]`);
    println(`extract:           ${stage_b_skip} explicit skip`);
    println(`extract:           ${stage_b_auto_skip} auto-skip (output is not a parse tree)`);
    println(
        `extract: stage B' — JVM-oracle candidates: ${stage_b_oracle_pending} pending (handed to scripts/extract-antlr4-descriptors.sh post-processor)`,
    );
    println(`extract:           ${stage_b_oracle_suppressed} suppressed via [stage_b_oracle_skip]`);
    println(
        `extract: stage C — action-print output: emitted ${stage_c_emitted} output-compare driver(s), ${stage_c_todo} marked #[TODO]`,
    );
    println(`extract: deferred — gaps blocked on missing infrastructure:`);
    println(
        `extract:           ${deferred_composite} composite descriptors — need Kiln multi-grammar \`use\` support to resolve \`import S;\` against sibling \`<Name>.slaveN.g4\``,
    );
}

// ===== Stage B: descriptor [output] normaliser =====

/// Decide whether a descriptor is eligible for Stage B′ oracle handling.
/// Lexer-only descriptors have no parse tree to compare; error-bearing
/// inputs produce trees with `<missing>` / `<error>` placeholders that
/// can't be pinned; ANTLR4's TestRig (unlike Gale) requires an explicit
/// start rule. Composites and empty input/output are filtered earlier.
fn stage_b_oracle_eligible(parsed: &ParsedDescriptor) -> bool {
    return parsed.descriptor_type == "Parser" && parsed.errors.is_empty() && !parsed.start.is_empty();
}

/// On failure, rolls back the partial write so the caller sees an
/// all-or-nothing manifest entry.
fn write_oracle_pending_files(
    dir: &Descriptor,
    input_filename: &String,
    start_filename: &String,
    parsed: &ParsedDescriptor,
) -> Result<(), ErrorCode> {
    if let Err(e) = write_file_string(dir, input_filename, &parsed.input) {
        return Result::Err(e);
    }
    if let Err(e) = write_file_string(dir, start_filename, &parsed.start) {
        let _ = remove_file(dir, input_filename);
        return Result::Err(e);
    }
    return Result::Ok(());
}

/// Emit `stage_b_oracle/<C>/<N>_test.wado` for every
/// `oracle-pending/<C>/<N>` triple where `.expected` exists (i.e. the
/// shell wrapper successfully ran the oracle); sweep any prior test
/// whose `.input` has gone away. `ORACLE_VERSION` env stamps the test
/// header with the resolved jar version.
fn finalize_stage_b_oracle(root: &Descriptor) with Stdout, Stderr, Environment, Exit {
    let pending_root = match open_dir(root, &"package-gale/tests/antlr4-compat/oracle-pending", false) {
        Ok(d) => d,
        Err(_) => {
            return;
        },
    };
    let compat_dir = match open_dir(root, &"package-gale/tests/antlr4-compat", true) {
        Ok(d) => d,
        Err(_) => {
            eprintln("finalize: cannot open antlr4-compat/");
            exit(1);
        },
    };
    let oracle_out_root = match ensure_dir(&compat_dir, &"stage_b_oracle") {
        Ok(d) => d,
        Err(_) => {
            eprintln("finalize: cannot create stage_b_oracle/");
            exit(1);
        },
    };
    let status_text = match read_file_to_string(root, &status_file_path()) {
        Ok(s) => Option::Some(s),
        Err(_) => null,
    };
    let oracle_triage_map = load_triage_maps(&status_text).stage_b_oracle;
    let oracle_version = match env("ORACLE_VERSION") {
        Some(v) => v,
        None => "<unspecified>",
    };
    let mut emitted = 0;
    let mut emitted_todo = 0;
    let mut swept = 0;
    let mut pending_no_expected = 0;
    let mut skip_dropped = 0;
    for let category of list_subdirs(&pending_root) {
        let pending_cat = match open_dir(&pending_root, &category, false) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`finalize: cannot open oracle-pending/${category}/`);
                continue;
            },
        };
        let oracle_cat = match ensure_dir(&oracle_out_root, &category) {
            Ok(d) => d,
            Err(_) => {
                eprintln(`finalize: cannot create stage_b_oracle/${category}/`);
                continue;
            },
        };
        let input_files = list_files_with_suffix(&pending_cat, &".input");
        let mut keep_test_files: List<String> = [];
        for let input_filename of &input_files {
            // Strip ".input" (6 chars) to get the descriptor base name.
            let base = input_filename.substr_bytes(0, input_filename.len() - 6);
            let start_filename = `${base}.start`;
            let expected_filename = `${base}.expected`;
            let test_filename = `${base}_test.wado`;
            keep_test_files.push(test_filename);
            let key = `${category}/${base}`;
            // A broken manifest (unreadable .start / .input) is the same
            // state as a missing .expected: the descriptor cannot be
            // (re-)emitted this run, so the previously committed test is
            // stale and must be dropped — keeping it would pin an outcome
            // that no longer has a manifest behind it.
            let start_text = match read_file_to_string(&pending_cat, &start_filename) {
                Ok(s) => s,
                Err(_) => {
                    eprintln(`finalize: missing oracle-pending/${category}/${start_filename} — dropping stale test`);
                    pending_no_expected += 1;
                    let _ = remove_file(&oracle_cat, &test_filename);
                    continue;
                },
            };
            let expected_raw = match read_file_to_string(&pending_cat, &expected_filename) {
                Ok(s) => s,
                Err(_) => {
                    // Oracle didn't run successfully — drop stale test.
                    pending_no_expected += 1;
                    let _ = remove_file(&oracle_cat, &test_filename);
                    continue;
                },
            };
            let input_text = match read_file_to_string(&pending_cat, input_filename) {
                Ok(s) => s,
                Err(_) => {
                    eprintln(
                        `finalize: cannot read oracle-pending/${category}/${*input_filename} — dropping stale test`,
                    );
                    pending_no_expected += 1;
                    let _ = remove_file(&oracle_cat, &test_filename);
                    continue;
                },
            };
            let expected_tree = strip_eof_marker(&expected_raw);
            let triage = oracle_triage_map.lookup(&key);
            // Honoured here too (not just in the extract filter) so a
            // skip-triage added between extract runs takes effect on
            // the next `--finalize-stage-b-oracle` alone.
            if triage matches { Skip(_) } {
                let _ = remove_file(&oracle_cat, &test_filename);
                skip_dropped += 1;
                continue;
            }
            let src = emit_stage_b_oracle_test_file(
                &category,
                &base,
                &input_text,
                &start_text,
                &expected_tree,
                &triage,
                &oracle_version,
            );
            if let Err(_) = write_file_string(&oracle_cat, &test_filename, &src) {
                eprintln(`finalize: cannot write stage_b_oracle/${category}/${test_filename}`);
                continue;
            }
            if triage matches { Todo(_) } {
                emitted_todo += 1;
            }
            emitted += 1;
        }
        // Sweep stale tests: anything in oracle_cat not in keep_test_files.
        for let existing of list_files_with_suffix(&oracle_cat, &"_test.wado") {
            if !keep_test_files.contains(&existing) {
                let _ = remove_file(&oracle_cat, &existing);
                swept += 1;
            }
        }
    }
    println(`finalize: emitted ${emitted} Stage B′ test(s) (${emitted_todo} #[TODO])`);
    println(`finalize:           swept ${swept} stale test(s)`);
    println(`finalize:           ${skip_dropped} dropped via [stage_b_oracle_skip]`);
    println(`finalize:           ${pending_no_expected} pending without .expected (oracle did not produce output)`);
}

/// Drop TestRig's trailing ` <EOF>` so the oracle's tree matches
/// Gale's `to_string_tree()` shape (which omits EOF). The match
/// requires the closing `)` so token text containing `<EOF>` mid-tree
/// stays untouched.
fn strip_eof_marker(raw: &String) -> String {
    let trimmed = raw.trim();
    return strip_tail_eof_marker(&trimmed);
}

/// Drop a ` <EOF>` marker in tail position — i.e. followed by at least one
/// closing paren (then only more closing parens and trailing whitespace) — so
/// the tree matches Gale's `to_string_tree()` shape (which omits EOF). EOF can
/// only ever be the last token of a parse, so this covers both the top-level
/// trailing form `(s a <EOF>)` and the nested-at-end form `(s (t <EOF>))`. The
/// closing-paren requirement is what distinguishes a tree tail from arbitrary
/// action-print output that merely ends in ` <EOF>` (a non-tree Stage C
/// `[output]` — `a b <EOF>`), which is left untouched; likewise any mid-tree
/// ` <EOF>` that is token *text* (the Stage B normalizer's `<` / `>` rejection
/// then auto-skips such descriptors instead of silently corrupting the pinned
/// tree). Trailing whitespace is skipped over but preserved, so a Stage C
/// `[output]` keeps its exact trailing newline (Stage B trims first, so it is
/// unaffected).
fn strip_tail_eof_marker(s: &String) -> String {
    let chars: List<char> = s.chars().collect();
    let mut end = chars.len();
    while end > 0 && chars[end - 1].is_ascii_whitespace() {
        end -= 1;
    }
    let mut close = end;
    while close > 0 && chars[close - 1] == ')' {
        close -= 1;
    }
    // A tree tail has at least one closing paren after the marker; without one
    // this is not a tree, so leave a trailing ` <EOF>` in place.
    if close == end || close < 6 {
        return *s;
    }
    // " <EOF>" is 6 chars; check chars[close-6 .. close] spell it.
    let marker: List<char> = [' ', '<', 'E', 'O', 'F', '>'];
    for let mut i = 0; i < 6; i += 1 {
        if chars[close - 6 + i] != marker[i] {
            return *s;
        }
    }
    let mut out = String::with_capacity(s.len());
    for let mut i = 0; i < chars.len(); i += 1 {
        if i < close - 6 || i >= close {
            out.push(chars[i]);
        }
    }
    return out;
}

fn emit_stage_b_oracle_test_file(
    category: &String,
    name: &String,
    input: &String,
    start: &String,
    expected_tree: &String,
    triage: &Triage,
    oracle_version: &String,
) -> String {
    let spec = TestFileSpec {
        category: *category,
        name: *name,
        attr: "#![generated(by = \"package-gale/scripts/extract_antlr4_descriptors.wado --finalize-stage-b-oracle\")]",
        doc_lines: [
            `// Expected tree: antlr-${*oracle_version}-complete.jar on the action-body-stripped grammar.`,
            triage_doc_line(&"stage_b_oracle"),
        ],
        output_subdir: "antlr4_compat_b_oracle",
        import_names: ["normalize_tree"],
        test_label: "stage_b_oracle",
        triage: *triage,
    };
    return emit_test_file(&spec, |w: &mut CodeWriter| {
        w.line(&`let input = "${escape_for_wado_str(input)}";`);
        w.line(&`let expected = "${escape_for_wado_str(expected_tree)}";`);
        w.line(&`let result = t::${parse_call_for_start(start)}(&input);`);
        w.line(&"let actual = t::to_string_tree(&result);");
        w.line(&"let norm = normalize_tree(&expected);");
        w.line(&"assert actual == norm, `actual:   ${actual}\\nexpected: ${norm}`;");
    });
}

/// Decide whether a descriptor `[output]` block can be checked as a Stage B
/// parse-tree shape. The descriptor format is documented in
/// `vendor/antlr4/runtime-testsuite/test/.../RuntimeTestDescriptorParser.java`;
/// in practice `[output]` carries one of:
///
/// - **a parse tree** in `to_string_tree()` form, e.g. `(s (declarator a))`.
///   These are emitted by descriptors whose grammar prequel ends with
///   `@after { <ToStringTree("$ctx"):writeln()> }`. Stage B can compare
///   against `tree.to_string_tree()`.
/// - **a host-language artefact** — lexer token-type names (one per
///   line), `Lexer.next()` token dumps (`[@0,0:-1='<EOF>',<-1>,1:0]`),
///   ATN decision traces (`Decision 0:\n s0-ID->:s1`), or arbitrary
///   action-block prints. None of these reflect the parse tree, so they
///   are not Stage B testable and must be triaged as `[stage_b_skip]`.
///
/// Returns `Some(tree)` for the parse-tree case, with ANTLR4's literal
/// ` <EOF>` token stripped — Gale's `to_string_tree()` omits empty-text
/// tokens (see `package-gale/CLAUDE.md` "Driver Tests"). Returns `None`
/// for everything else.
///
/// The detector is intentionally conservative: any leftover `<…>` token
/// in the output (after `<EOF>` stripping) is treated as a testsuite
/// StringTemplate substitution (e.g. `<AltNum()>`) rather than a real
/// parse-tree node, and the descriptor is rejected. Likewise, `${…}`
/// always denotes an action-block reference. False rejections are
/// triaged as `[stage_b_todo]` once the underlying capability lands.
fn normalize_output_for_stage_b(raw: &String) -> Option<String> {
    let s = raw.trim();
    if s.is_empty() {
        return null;
    }
    if !s.starts_with("(") {
        return null;
    }
    let chars: List<char> = s.chars().collect();
    if chars.len() < 2 {
        return null;
    }
    if !is_tree_node_name_start(chars[1]) {
        return null;
    }
    // Skip over the rule-name identifier; the character that follows must
    // be `)` (childless tree) or ASCII whitespace (children follow). This
    // rejects action-print outputs like `(a+b)` or `(x=1)` — those start
    // with `(` + identifier but are NOT trees, since real `to_string_tree`
    // output always separates the rule name from its children by a single
    // space.
    let mut idx = 2;
    while idx < chars.len() && is_tree_node_name_continue(chars[idx]) {
        idx += 1;
    }
    if idx >= chars.len() {
        return null;
    }
    let after_name = chars[idx];
    if after_name != ')' && after_name != ' ' && after_name != '\n' && after_name != '\t' {
        return null;
    }
    if s.contains("${") {
        return null;
    }
    // Tail-position-only strip (shared with the oracle path): a global
    // ` <EOF>` replace would silently corrupt a tree whose token text
    // contains the marker; leaving it in place lets the `<` / `>` check
    // below auto-skip such descriptors instead.
    let stripped = strip_tail_eof_marker(&s);
    if stripped.contains("<") || stripped.contains(">") {
        return null;
    }
    return Option::<String>::Some(stripped);
}

fn is_tree_node_name_start(c: char) -> bool {
    return 'a' <= c && c <= 'z' || 'A' <= c && c <= 'Z' || c == '_';
}

fn is_tree_node_name_continue(c: char) -> bool {
    return is_tree_node_name_start(c) || '0' <= c && c <= '9';
}

/// Extract the root rule name from a normalised `[output]` tree of the form
/// `(<name> ...)`. Returns `None` when the input does not begin with a
/// well-formed `(name` prefix.
///
/// Used by Stage B sub-tree dispatch: when the descriptor's root rule
/// differs from `[start]`, the test must navigate down to the sub-tree
/// rooted at this name before comparing.
fn extract_root_rule_name(s: &String) -> Option<String> {
    let chars: List<char> = s.chars().collect();
    if chars.len() < 2 || chars[0] != '(' || !is_tree_node_name_start(chars[1]) {
        return null;
    }
    let mut end = 2;
    while end < chars.len() && is_tree_node_name_continue(chars[end]) {
        end += 1;
    }
    let mut name = String::with_capacity(end - 1);
    for let mut i = 1; i < end; i += 1 {
        name.push(chars[i]);
    }
    return Option::<String>::Some(name);
}

test "normalize: clean parse tree passes through trimmed" {
    let result = normalize_output_for_stage_b(&"(a x y)\n");
    assert result matches { Some(s) && s == "(a x y)" };
}

test "normalize: trailing <EOF> token is stripped" {
    // ANTLR4 emits the EOF token literally because `to_string_tree(rule)`
    // includes every consumed terminal, but Gale's runtime drops empty-text
    // tokens (CLAUDE.md "Driver Tests"). The normaliser bridges this gap
    // so descriptor `[output]` blocks line up with Gale's actual emission.
    let result = normalize_output_for_stage_b(&"(s (declarator a) <EOF>)");
    assert result matches { Some(s) && s == "(s (declarator a))" };
}

test "normalize: nested tree with literal token text is preserved" {
    // Bracket characters are legitimate token text from grammars whose
    // alphabet contains them; the detector must not reject them.
    let result = normalize_output_for_stage_b(&"(s (declarator (declarator a) [ ]) <EOF>)");
    assert result matches { Some(s) && s == "(s (declarator (declarator a) [ ]))" };
}

test "normalize: empty output is not Stage B testable" {
    assert normalize_output_for_stage_b(&"") matches { None };
    assert normalize_output_for_stage_b(&"\n") matches { None };
    assert normalize_output_for_stage_b(&"   ") matches { None };
}

test "normalize: nested-at-end EOF marker is stripped" {
    // EOF consumed by a sub-rule still sits at the tree's end, just inside
    // extra closing parens.
    let result = normalize_output_for_stage_b(&"(s (t a <EOF>))");
    assert result matches { Some(s) && s == "(s (t a))" };
}

test "normalize: mid-tree EOF-looking token text auto-skips, not corrupts" {
    // ` <EOF>` NOT in tail position is token text; the old global replace
    // silently deleted it. It must survive the strip and then hit the
    // `<` / `>` rejection (auto-skip).
    assert normalize_output_for_stage_b(&"(r <EOF> y)") matches { None };
}

test "strip_eof_marker: mid-tree marker untouched, tail marker stripped" {
    assert strip_eof_marker(&"(s a <EOF>)\n") == "(s a)";
    assert strip_eof_marker(&"(s (t <EOF>))") == "(s (t))";
    assert strip_eof_marker(&"(r <EOF> y)") == "(r <EOF> y)";
}

test "strip_tail_eof_marker: strips a tree tail while preserving the trailing newline" {
    assert strip_tail_eof_marker(&"(s (e a) <EOF>)\n") == "(s (e a))\n";
    assert strip_tail_eof_marker(&"(s (t <EOF>))\n") == "(s (t))\n";
}

test "strip_tail_eof_marker: leaves a non-tree ' <EOF>' (no closing paren) untouched" {
    // A Stage C action-print ending in ' <EOF>' with only whitespace after it
    // is not a tree tail; stripping it would spuriously diverge from Gale's output.
    assert strip_tail_eof_marker(&"a b <EOF>\n") == "a b <EOF>\n";
    assert strip_tail_eof_marker(&"a b <EOF>") == "a b <EOF>";
}

test "normalize: action $text echo is not a tree" {
    // `[output]` like `abc` comes from a grammar whose action prints
    // `$text` after a successful parse — not a tree shape.
    assert normalize_output_for_stage_b(&"abc") matches { None };
    assert normalize_output_for_stage_b(&"alt 1") matches { None };
    assert normalize_output_for_stage_b(&"alt 2\n") matches { None };
}

test "normalize: lexer token-type names are not a tree" {
    // LexerExec descriptors print one token-type name per line.
    assert normalize_output_for_stage_b(&"I\nI\n") matches { None };
    assert normalize_output_for_stage_b(&"DASHBRACK\nDASHBRACK\n") matches { None };
}

test "normalize: lexer token dump is not a tree" {
    // `[@0,0:-1='<EOF>',<-1>,1:0]` is `Token.toString()` from the runtime
    // — looks like a tree at first glance because of the `[`, but starts
    // with `[` rather than `(`.
    assert normalize_output_for_stage_b(&"[@0,0:-1='<EOF>',<-1>,1:0]") matches { None };
}

test "normalize: ATN decision trace is not a tree" {
    // FullContextParsing descriptors that exercise ATN decisions emit a
    // `<DecisionInfo>`-style dump. It does not start with `(`.
    assert normalize_output_for_stage_b(&"Decision 0:\ns0-ID->:s1^=>1") matches { None };
}

test "normalize: testsuite ${...} substitution is rejected" {
    // `(s ${ (v ? a) ? })` from ParseTrees/ExtraTokensAndAltLabels carries
    // an action-block reference the testsuite resolves at runtime. Not a
    // self-contained parse tree.
    assert normalize_output_for_stage_b(&"(s ${ (v ? a) ? })") matches { None };
}

test "normalize: leftover <...> substitution is rejected" {
    // Any `<…>` other than the literal `<EOF>` token is a testsuite
    // StringTemplate directive (e.g. `<AltNum()>` injects `:N`). After
    // stripping `<EOF>` we should see no remaining angle brackets in a
    // clean tree; if any do, the descriptor is not Stage B testable.
    assert normalize_output_for_stage_b(&"(s <AltNum()> x)") matches { None };
}

test "normalize: action print like (a+b) without separator after name is rejected" {
    // PrefixOpWithActionAndLabel_2 prints `<writeln("$e.result")>` whose
    // value is `(a+b)`. The string looks like `(<ident><op><ident>)` but
    // is NOT a tree: real `to_string_tree` always separates the rule name
    // from its children by a single space.
    assert normalize_output_for_stage_b(&"(a+b)") matches { None };
    assert normalize_output_for_stage_b(&"(x=1)") matches { None };
    assert normalize_output_for_stage_b(&"(foo,bar)") matches { None };
    // A childless tree (`(foo)`) is still valid.
    assert normalize_output_for_stage_b(&"(foo)") matches { Some(_) };
    // Whitespace-separated children are still valid (space, newline, tab).
    assert normalize_output_for_stage_b(&"(s a)") matches { Some(_) };
    assert normalize_output_for_stage_b(&"(s\n  a)") matches { Some(_) };
    assert normalize_output_for_stage_b(&"(s\ta)") matches { Some(_) };
}

test "normalize: line-noise output starting with paren but no name is rejected" {
    // `()`, `( )`, or `(123 ...)` are not valid `to_string_tree()` output
    // — every node starts with an identifier (the rule name).
    assert normalize_output_for_stage_b(&"()") matches { None };
    assert normalize_output_for_stage_b(&"( a)") matches { None };
    assert normalize_output_for_stage_b(&"(123 abc)") matches { None };
}

// ===== Stage B: status.toml triage parser =====

fn lookup_for_axis(maps: &TriageMaps, axis: &String, key: &String) -> Triage {
    return match *axis {
        "cat" => maps.category.lookup(key),
        "a" => maps.stage_a.lookup(key),
        "oracle" => maps.stage_b_oracle.lookup(key),
        _ => maps.stage_b.lookup(key),
    };
}

fn assert_triage_skip(maps: &TriageMaps, axis: &String, key: &String, expected_reason: &String) {
    if let Skip(reason) = &lookup_for_axis(maps, axis, key) {
        assert *reason == *expected_reason, `axis ${*axis} key '${*key}': expected Skip('${*expected_reason}'), got Skip('${*reason}')`;
    } else {
        panic(`axis ${*axis} key '${*key}': expected Skip, got other`);
    }
}

fn assert_triage_todo(maps: &TriageMaps, axis: &String, key: &String, expected_reason: &String) {
    if let Todo(reason) = &lookup_for_axis(maps, axis, key) {
        assert *reason == *expected_reason, `axis ${*axis} key '${*key}': expected Todo('${*expected_reason}'), got Todo('${*reason}')`;
    } else {
        panic(`axis ${*axis} key '${*key}': expected Todo, got other`);
    }
}

fn assert_triage_pass(maps: &TriageMaps, axis: &String, key: &String) {
    assert lookup_for_axis(maps, axis, key) matches { Pass }, `axis ${*axis} key '${*key}': expected Pass, got other`;
}

test "triage: missing file yields empty maps on all axes" {
    let none_text: Option<String> = null;
    let maps = load_triage_maps(&none_text);
    assert maps.category.entries.is_empty();
    assert maps.stage_a.entries.is_empty();
    assert maps.stage_b.entries.is_empty();
}

test "triage: stage_a skip and todo populate stage_a only" {
    let toml = Option::<String>::Some(
        "[stage_a_todo]
\"ParserExec/Foo\" = \"parse fails on input — gap pending\"
[stage_a_skip]
\"ParserExec/Bar\" = \"start rule differs from first parser rule\"
",
    );
    let maps = load_triage_maps(&toml);
    assert_triage_todo(&maps, &"a", &"ParserExec/Foo", &"parse fails on input — gap pending");
    assert_triage_skip(&maps, &"a", &"ParserExec/Bar", &"start rule differs from first parser rule");
    // Per-category and Stage B must not be touched.
    assert_triage_pass(&maps, &"cat", &"ParserExec/Foo");
    assert_triage_pass(&maps, &"b", &"ParserExec/Foo");
}

test "triage: per-category skip and todo populate category only" {
    let toml = Option::<String>::Some(
        "[todo]
\"LeftRecursion/Foo\" = \"reason category todo\"
[skip]
\"Listeners/Bar\" = \"reason category skip\"
",
    );
    let maps = load_triage_maps(&toml);
    assert_triage_todo(&maps, &"cat", &"LeftRecursion/Foo", &"reason category todo");
    assert_triage_skip(&maps, &"cat", &"Listeners/Bar", &"reason category skip");
    // Stage A and Stage B maps must remain untouched — the three axes are independent.
    assert_triage_pass(&maps, &"a", &"LeftRecursion/Foo");
    assert_triage_pass(&maps, &"b", &"LeftRecursion/Foo");
    assert_triage_pass(&maps, &"b", &"Listeners/Bar");
}

test "triage: stage B skip and todo populate stage_b only" {
    let toml = Option::<String>::Some(
        "[stage_b_todo]
\"ParserExec/AltLabels\" = \"alt-num emission not yet supported\"
[stage_b_skip]
\"LexerExec/Foo\" = \"output is a lexer token type list\"
",
    );
    let maps = load_triage_maps(&toml);
    assert_triage_todo(&maps, &"b", &"ParserExec/AltLabels", &"alt-num emission not yet supported");
    assert_triage_skip(&maps, &"b", &"LexerExec/Foo", &"output is a lexer token type list");
    // Symmetric: Stage B entries must not bleed into the other axes.
    assert_triage_pass(&maps, &"cat", &"ParserExec/AltLabels");
    assert_triage_pass(&maps, &"a", &"ParserExec/AltLabels");
    assert_triage_pass(&maps, &"cat", &"LexerExec/Foo");
    assert_triage_pass(&maps, &"a", &"LexerExec/Foo");
}

test "triage: stage_b_oracle skip and todo populate stage_b_oracle only" {
    let toml = Option::<String>::Some(
        "[stage_b_oracle_todo]
\"ParserExec/Foo\" = \"oracle tree diverges — ATN-class\"
[stage_b_oracle_skip]
\"ParserExec/Bar\" = \"StringTemplate directive outside action body\"
",
    );
    let maps = load_triage_maps(&toml);
    assert_triage_todo(&maps, &"oracle", &"ParserExec/Foo", &"oracle tree diverges — ATN-class");
    assert_triage_skip(&maps, &"oracle", &"ParserExec/Bar", &"StringTemplate directive outside action body");
    // The oracle axis is independent: an oracle verdict must not leak into
    // category / Stage A / Stage B (the `_ => stage_b` fall-through hazard).
    assert_triage_pass(&maps, &"cat", &"ParserExec/Foo");
    assert_triage_pass(&maps, &"a", &"ParserExec/Foo");
    assert_triage_pass(&maps, &"b", &"ParserExec/Foo");
    assert_triage_pass(&maps, &"b", &"ParserExec/Bar");
}

test "triage: same key can carry independent category and stage B verdicts" {
    // A descriptor whose .g4 parses fine (category pass) but whose
    // [output] is host-language chatter (Stage B skip) is the canonical
    // case.
    let toml = Option::<String>::Some(
        "[stage_b_skip]
\"FullContextParsing/AmbigYieldsCtxSensitiveDFA\" = \"output is an ATN decision trace\"
",
    );
    let maps = load_triage_maps(&toml);
    assert_triage_pass(&maps, &"cat", &"FullContextParsing/AmbigYieldsCtxSensitiveDFA");
    assert_triage_skip(
        &maps,
        &"b",
        &"FullContextParsing/AmbigYieldsCtxSensitiveDFA",
        &"output is an ATN decision trace",
    );
}

test "triage: comments and blank lines are tolerated" {
    let toml = Option::<String>::Some(
        "# per-category
[todo]

# real entry
\"LeftRecursion/X\" = \"reason\"

# Stage B
[stage_b_skip]
\"LexerExec/Y\" = \"reason\"
",
    );
    let maps = load_triage_maps(&toml);
    assert_triage_todo(&maps, &"cat", &"LeftRecursion/X", &"reason");
    assert_triage_skip(&maps, &"b", &"LexerExec/Y", &"reason");
}

test "triage: unknown bucket section is silently ignored" {
    // Forward compatibility: a future bucket name (e.g. [stage_c_todo])
    // must not crash today's extractor. Entries under unknown sections
    // are dropped quietly.
    let toml = Option::<String>::Some(
        "[stage_c_todo]
\"Foo/Bar\" = \"future feature\"
[stage_b_skip]
\"Baz/Qux\" = \"present feature\"
",
    );
    let maps = load_triage_maps(&toml);
    assert maps.category.entries.is_empty();
    assert maps.stage_a.entries.is_empty();
    assert maps.stage_b.entries.len() == 1;
    assert_triage_skip(&maps, &"b", &"Baz/Qux", &"present feature");
    assert_triage_pass(&maps, &"cat", &"Foo/Bar");
    assert_triage_pass(&maps, &"a", &"Foo/Bar");
    assert_triage_pass(&maps, &"b", &"Foo/Bar");
}

test "triage: stage_a entry applies to whichever variant (parse / err / tokens) fires for the descriptor" {
    // The three Stage A variants are mutually exclusive on type+errors so
    // a single `Category/Name` key in [stage_a_todo] unambiguously routes
    // to the right test file regardless of which variant was emitted.
    let toml = Option::<String>::Some(
        "[stage_a_todo]
\"ParserErrors/Foo\" = \"variant: parse must error — Gale's set-element dispatch elides the kind-check\"
",
    );
    let maps = load_triage_maps(&toml);
    assert_triage_todo(
        &maps,
        &"a",
        &"ParserErrors/Foo",
        &"variant: parse must error — Gale's set-element dispatch elides the kind-check",
    );
    assert_triage_pass(&maps, &"cat", &"ParserErrors/Foo");
    assert_triage_pass(&maps, &"b", &"ParserErrors/Foo");
}

test "extract_root_rule_name: simple tree returns the first identifier" {
    assert extract_root_rule_name(&"(a b c)") matches { Some(_) };
    if let Some(name) = extract_root_rule_name(&"(a b c)") {
        assert name == "a", `got '${name}'`;
    }
    if let Some(name) = extract_root_rule_name(&"(expr (lit 1) + (lit 2))") {
        assert name == "expr";
    }
    if let Some(name) = extract_root_rule_name(&"(rule_with_underscore_123 x)") {
        assert name == "rule_with_underscore_123";
    }
}

test "extract_root_rule_name: rejects malformed prefixes" {
    assert extract_root_rule_name(&"") matches { None };
    assert extract_root_rule_name(&"(") matches { None };
    // Must start with `(` followed by an identifier.
    assert extract_root_rule_name(&"a b") matches { None };
    assert extract_root_rule_name(&"( a b)") matches { None };  // space after (
    assert extract_root_rule_name(&"(123 abc)") matches { None };  // starts with digit
}

test "classify_tokens: clean token dump returns Clean(normalised)" {
    let input = "[@0,0:2='end',<1>,1:0]\n[@1,3:3=' ',<3>,1:3]\n";
    let result = classify_output_for_tokens(&input);
    assert result matches { Some(s) && s == input };
}

test "classify_tokens: action-print prefix is part of the expectation" {
    // LexerExec descriptors with `{<writeln(...)>}` actions emit action output
    // BEFORE the token dump; the lexer executes those bodies and
    // `to_lexer_string` renders the sink ahead of the dump, so the prefix stays
    // in the expectation rather than routing the test to `#[TODO]`.
    let raw = "stuff0:\nstuff1: a\n[@0,0:0='a',<1>,1:0]\n";
    let result = classify_output_for_tokens(&raw);
    assert result matches { Some(s) && s == "stuff0:\nstuff1: a\n[@0,0:0='a',<1>,1:0]\n" };
}

test "classify_tokens: empty output is not tokens-testable at all" {
    // Genuinely no `[@…]` line anywhere — not even a Stage C target.
    assert classify_output_for_tokens(&"") matches { None };
    assert classify_output_for_tokens(&"\n\n") matches { None };
}

test "classify_tokens: output with no token-dump line at all is None" {
    // Pure action-print without any `[@…]` row has no token-dump payload
    // for `to_lexer_string` to render against; not a claim (d) target.
    assert classify_output_for_tokens(&"hello\nworld\n") matches { None };
}

test "classify_tokens: leading garbage before the token dump is kept" {
    let raw = "abc\n[@0,0:0='a',<1>,1:0]\n";
    let result = classify_output_for_tokens(&raw);
    assert result matches { Some(_) };
}

test "classify_tokens: showDFA dump is dropped, leaving a clean token dump" {
    // `SemPredEvalLexer` descriptors with `showDFA` append ANTLR's internal DFA
    // state table after the token rows. Gale has no such table, so it must not
    // sit in the expectation — the token rows alone are the claim (d) target.
    let raw = "[@0,0:3='enum',<1>,1:0]\n[@1,4:3='<EOF>',<-1>,1:4]\ns0-' '->:s3=>3\n:s1=>2-'n'->:s2=>2\n";
    let result = classify_output_for_tokens(&raw);
    assert result matches { Some(s) && s == "[@0,0:3='enum',<1>,1:0]\n[@1,4:3='<EOF>',<-1>,1:4]\n" };
}

test "is_lexer_dfa_row_start: only DFA rows, not action prints or token rows" {
    assert is_lexer_dfa_row_start(&"s0-' '->:s5=>3");
    assert is_lexer_dfa_row_start(&":s1=>2-'n'->:s2=>2");
    assert !is_lexer_dfa_row_start(&"[@0,0:0='a',<1>,1:0]");
    // Action prints that merely contain an arrow, or start with `s`.
    assert !is_lexer_dfa_row_start(&"stuff0: a->b");
    assert !is_lexer_dfa_row_start(&"s0 without a transition");
    assert !is_lexer_dfa_row_start(&"sad-story");
}

test "strip_lexer_dfa_dump: a row-shaped action print keeps the token dump" {
    // `s1=5` looks like a row start but never reaches a `->`; treating it as one
    // would swallow every following line, silently auto-skipping the descriptor.
    let raw = "s1=5\n[@0,0:0='a',<1>,1:0]\n";
    let out = strip_lexer_dfa_dump(&raw);
    assert out == raw, `unexpected: '${out}'`;
}

test "strip_lexer_dfa_dump: a row whose transition char is a newline" {
    // `NL : '\n'` gives ANTLR a transition on a literal newline, so the row
    // spans two physical lines and only the second carries the `->`.
    let raw = "[@0,0:0='a',<1>,1:0]\ns0-'\n'->:s2=>3\n";
    let out = strip_lexer_dfa_dump(&raw);
    assert out == "[@0,0:0='a',<1>,1:0]\n", `unexpected: '${out}'`;
}

test "stage_a_err_category_eligible: only ParserErrors and LexerErrors" {
    assert stage_a_err_category_eligible(&"ParserErrors") == true;
    assert stage_a_err_category_eligible(&"LexerErrors") == true;
    // Categories with [errors] for ambiguity / predicate reports, not real
    // parse failures, are not parse-must-error candidates.
    assert stage_a_err_category_eligible(&"FullContextParsing") == false;
    assert stage_a_err_category_eligible(&"SemPredEvalParser") == false;
    assert stage_a_err_category_eligible(&"LexerExec") == false;
    assert stage_a_err_category_eligible(&"") == false;
}

test "strip_eof_marker: drops trailing ' <EOF>' before closing ')'" {
    let r = strip_eof_marker(&"(start (statement x) <EOF>)");
    assert r == "(start (statement x))", `got '${r}'`;
}

test "strip_eof_marker: trims surrounding whitespace and newlines" {
    let r = strip_eof_marker(&"  (start (statement x) <EOF>)\n");
    assert r == "(start (statement x))", `got '${r}'`;
}

test "strip_eof_marker: passes tree through when no EOF marker is present" {
    let r = strip_eof_marker(&"(start (statement x))");
    assert r == "(start (statement x))", `got '${r}'`;
}

test "strip_eof_marker: does not strip ' <EOF>' that is not at the end" {
    // Defensive: ` <EOF>` in token-text position (followed by space
    // rather than the closing ')') stays untouched.
    let r = strip_eof_marker(&"(start <EOF> x)");
    assert r == "(start <EOF> x)", `got '${r}'`;
}

test "parse_cli_args: unknown -- flag is rejected" {
    // A typo'd flag must not silently run a default extract: it should
    // be reported as an error so the caller (`run`) can exit non-zero.
    let r = parse_cli_args(["--finalize-stage-b-oracl"]);
    assert r matches { Err(_) }, `expected Err for typo'd flag`;
    let r2 = parse_cli_args(["-x"]);
    assert r2 matches { Err(_) }, `expected Err for short unknown flag`;
}

test "parse_cli_args: known flags parse without error" {
    let all = parse_cli_args(["all"]).unwrap();
    assert all.want_all == true;
    assert all.finalize_stage_b_oracle == false;

    let fin = parse_cli_args(["--finalize-stage-b-oracle"]).unwrap();
    assert fin.finalize_stage_b_oracle == true;
    assert fin.want_all == false;
}

test "parse_cli_args: positional categories are collected" {
    let r = parse_cli_args(["LexerExec", "ParserExec"]).unwrap();
    assert r.want_all == false;
    assert r.categories.len() == 2;
    assert r.categories[0] == "LexerExec";
    assert r.categories[1] == "ParserExec";
}

test "parse_cli_args: empty args fall back to default categories" {
    let r = parse_cli_args([]).unwrap();
    assert r.want_all == false;
    assert !r.categories.is_empty();
}

// Regenerating the committed corpus exercises the Stage A / Stage B
// emitters end-to-end, but the Stage B′ oracle emitter only runs in the
// JDK-gated finalize phase, so pin its output against a committed file.
test "emit_stage_b_oracle_test_file reproduces the committed file byte-for-byte" {
    let expected = #include_str("../tests/antlr4-compat/stage_b_oracle/Sets/StarSet_test.wado");
    let actual = emit_stage_b_oracle_test_file(
        &"Sets",
        &"StarSet",
        &"abaac",
        &"a",
        &"(a a b a a c)",
        &Triage::Pass,
        &"4.13.2",
    );
    assert actual == expected, `\nactual:\n${actual}\nexpected:\n${expected}`;
}

test "emit_test_file: Todo triage decorates the test and wires Stage A paths" {
    let src = emit_stage_a_parse_test_file(&"Foo", &"Bar", &"x", &"start", &Triage::Todo("flaky"));
    assert src.contains("#[TODO]"), src;
    assert src.contains("// triage: flaky"), src;
    assert src.contains("output_dir: \"../../../generated/antlr4_compat_a/Foo/Bar\""), src;
    assert src.contains("test \"stage_a_parse: Foo/Bar\""), src;
    assert src.contains("t::parse_start(&input)"), src;
    // Stage A parse needs no extra runtime import.
    assert !src.contains("normalize_tree"), src;
}

test "emit_test_file: per-claim imports and output dirs differ" {
    let b = emit_stage_b_test_file(&"C", &"N", &"i", &"", &"(t)", &Triage::Pass);
    assert b.contains("use { normalize_tree }"), b;
    assert b.contains("output_dir: \"../../../generated/antlr4_compat_b/C/N\""), b;
    assert b.contains("t::parse(&input)"), b;

    let lexer_err = emit_stage_a_err_test_file(&"C", &"N", &"i", &"", true, &Triage::Pass);
    assert lexer_err.contains("use { TK_ERROR }"), lexer_err;
    assert lexer_err.contains("has_err"), lexer_err;

    let parser_err = emit_stage_a_err_test_file(&"C", &"N", &"i", &"r", false, &Triage::Pass);
    assert !parser_err.contains("use { TK_ERROR }"), parser_err;
    assert parser_err.contains("expected parse to fail"), parser_err;

    let tokens = emit_stage_a_tokens_test_file(&"C", &"N", &"i", &"[@0]", &Triage::Pass);
    assert tokens.contains("use { TK_EOF }"), tokens;
    assert tokens.contains("to_lexer_string"), tokens;
}
