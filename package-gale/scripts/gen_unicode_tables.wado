#!/usr/bin/env wado
//! Emit `src/g4/unicode_tables.wado` from the Unicode Character Database.
//! Reads the UCD files from the preopened directory and takes the version on
//! argv, printing the module to stdout; `scripts/regen-unicode-tables.sh`
//! fetches the UCD and drives it.
//!
//! Gale expands `\p{...}` / `\P{...}` in a lexer char set into code-point
//! ranges at grammar-parse time. `\P` is the complement of `\p`, so an
//! approximate table does not merely miss characters — it admits them. The
//! table is generated from the UCD rather than hand-maintained.

use { args, print, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { encode as base64_encode } from "core:base64";
use { CodeWriter, FnSpec, GlobalSpec, Vis, str_lit } from "../src/wadopoet.wado";

global CODE_POINT_MAX: i32 = 0x10FFFF;

/// General categories in the order they are emitted, with the long alias
/// `PropertyValueAliases.txt` gives each. Group letters (`L`, `M`, …) are
/// unions of their subcategories and are resolved by the consumer.
global CATEGORIES: List<[String, String]> = [
    ["Cc", "Control"],
    ["Cf", "Format"],
    ["Cn", "Unassigned"],
    ["Co", "Private_Use"],
    ["Cs", "Surrogate"],
    ["Ll", "Lowercase_Letter"],
    ["Lm", "Modifier_Letter"],
    ["Lo", "Other_Letter"],
    ["Lt", "Titlecase_Letter"],
    ["Lu", "Uppercase_Letter"],
    ["Mc", "Spacing_Mark"],
    ["Me", "Enclosing_Mark"],
    ["Mn", "Nonspacing_Mark"],
    ["Nd", "Decimal_Number"],
    ["Nl", "Letter_Number"],
    ["No", "Other_Number"],
    ["Pc", "Connector_Punctuation"],
    ["Pd", "Dash_Punctuation"],
    ["Pe", "Close_Punctuation"],
    ["Pf", "Final_Punctuation"],
    ["Pi", "Initial_Punctuation"],
    ["Po", "Other_Punctuation"],
    ["Ps", "Open_Punctuation"],
    ["Sc", "Currency_Symbol"],
    ["Sk", "Modifier_Symbol"],
    ["Sm", "Math_Symbol"],
    ["So", "Other_Symbol"],
    ["Zl", "Line_Separator"],
    ["Zp", "Paragraph_Separator"],
    ["Zs", "Space_Separator"],
];

global GROUPS: List<[String, String]> = [
    ["L", "Letter"],
    ["M", "Mark"],
    ["N", "Number"],
    ["P", "Punctuation"],
    ["S", "Symbol"],
    ["Z", "Separator"],
    ["C", "Other"],
];

/// The enumerated `Property=Value` names ANTLR4 answers beyond
/// `General_Category`, `Script` and `Block`, with the UCD file each is read
/// from, the field its value sits in, and its `PropertyValueAliases.txt`
/// prefix. `gc_default` marks the one file stating its default as a rule over
/// `General_Category` rather than as an `@missing` line.
global ENUMERATED: List<EnumeratedProperty> = [
    EnumeratedProperty {
        name: "Bidi_Class",
        prefix: "bc",
        file: "extracted/DerivedBidiClass.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty { name: "Line_Break", prefix: "lb", file: "LineBreak.txt", field: 1, gc_default: false },
    EnumeratedProperty {
        name: "Word_Break",
        prefix: "WB",
        file: "auxiliary/WordBreakProperty.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty {
        name: "Sentence_Break",
        prefix: "SB",
        file: "auxiliary/SentenceBreakProperty.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty {
        name: "Grapheme_Cluster_Break",
        prefix: "GCB",
        file: "auxiliary/GraphemeBreakProperty.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty {
        name: "Numeric_Type",
        prefix: "nt",
        file: "extracted/DerivedNumericType.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty {
        name: "East_Asian_Width",
        prefix: "ea",
        file: "EastAsianWidth.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty {
        name: "Hangul_Syllable_Type",
        prefix: "hst",
        file: "HangulSyllableType.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty { name: "Joining_Type", prefix: "jt", file: "ArabicShaping.txt", field: 2, gc_default: true },
    EnumeratedProperty {
        name: "Indic_Syllabic_Category",
        prefix: "InSC",
        file: "IndicSyllabicCategory.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty {
        name: "Decomposition_Type",
        prefix: "dt",
        file: "extracted/DerivedDecompositionType.txt",
        field: 1,
        gc_default: false,
    },
    EnumeratedProperty {
        name: "Vertical_Orientation",
        prefix: "vo",
        file: "VerticalOrientation.txt",
        field: 1,
        gc_default: false,
    },
];

struct EnumeratedProperty {
    name: String,
    prefix: String,
    file: String,
    field: i32,
    gc_default: bool,
}

/// One emitted `<property>_ranges` table; `keys` are the folded property names
/// that select it.
struct EnumeratedTable {
    name: String,
    fn_name: String,
    keys: List<String>,
    entries: List<NamedRanges>,
}

/// One `START;NAME;CATEGORY` run of the UCD, with the `, First>` / `, Last>`
/// pairs already joined into a single range.
struct CategoryRun {
    start: i32,
    end: i32,
    category: String,
}

/// One `START[..END] ; VALUE` line of a UCD property file (`Scripts.txt`,
/// `PropList.txt`, `DerivedCoreProperties.txt`, `Blocks.txt`).
struct PropRun {
    start: i32,
    end: i32,
    value: String,
}

/// A property (or property value) and the names that resolve to it: the
/// canonical one plus every alias `PropertyAliases.txt` /
/// `PropertyValueAliases.txt` give it.
struct NamedRanges {
    names: List<String>,
    ranges: List<[i32, i32]>,
}

export fn run() with (Stdout, Stderr, Environment, Preopens, Exit) {
    let arguments = args();
    if arguments.len() != 1 {
        eprintln("usage: gen_unicode_tables <version>   (UCD files come from the preopened directory)");
        exit(1);
    }
    let version = arguments[0];

    let categories = parse_runs(&read_file(&"UnicodeData.txt"));
    let value_aliases = read_file(&"PropertyValueAliases.txt");
    let script_aliases = parse_alias_lines(&value_aliases, &"sc");
    let block_aliases = parse_alias_lines(&value_aliases, &"blk");
    // `Script` and `Block` partition the space too: ANTLR4 answers
    // `\p{sc=Zzzz}` / `\p{blk=NB}` from their `@missing` default.
    let scripts = partition_runs(&read_file(&"Scripts.txt"), 1, false, &categories, &script_aliases, &"Script");
    let blocks = partition_runs(&read_file(&"Blocks.txt"), 1, false, &categories, &block_aliases, &"Block");
    let mut binary = parse_prop_runs(&read_file(&"PropList.txt"));
    for let run of parse_prop_runs(&read_file(&"DerivedCoreProperties.txt")) {
        binary.push(run);
    }
    // `Extended_Pictographic` and the `Emoji*` properties live in the emoji
    // data file, and ANTLR4's documented property surface includes them.
    for let run of parse_prop_runs(&read_file(&"emoji-data.txt")) {
        binary.push(run);
    }
    let prop_aliases = parse_alias_lines(&read_file(&"PropertyAliases.txt"), &"");

    let mut enumerated: List<EnumeratedTable> = [];
    for let prop of &ENUMERATED {
        let aliases = parse_alias_lines(&value_aliases, &prop.prefix);
        let runs = partition_runs(
            &read_file(&prop.file),
            prop.field,
            prop.gc_default,
            &categories,
            &aliases,
            &prop.name,
        );
        enumerated.push(EnumeratedTable {
            name: prop.name,
            fn_name: table_fn_name(&prop.name),
            keys: property_keys(&prop_aliases, &prop.name),
            entries: named_ranges(&runs, &aliases),
        });
    }

    print(
        emit_module(
            &categories,
            &named_ranges(&scripts, &script_aliases),
            &named_ranges(&blocks, &block_aliases),
            &named_ranges(&binary, &prop_aliases),
            &enumerated,
            &version,
        ),
    );
}

fn table_fn_name(property: &String) -> String {
    let mut out = String::with_capacity(property.len() + 7);
    for let c of property.chars() {
        out.push(c.to_ascii_lowercase());
    }
    out.push_str(&"_ranges");
    return out;
}

/// The folded names that select one property's table (`lb`, `linebreak`),
/// from `PropertyAliases.txt`.
fn property_keys(aliases: &List<NamedRanges>, property: &String) -> List<String> {
    for let alias of aliases {
        if !names_contain_folded(alias, property) {
            continue;
        }
        let mut keys: List<String> = [];
        for let n of &alias.names {
            let key = normalize_name(n);
            if !keys.contains(&key) {
                keys.push(key);
            }
        }
        return keys;
    }
    panic(`PropertyAliases.txt names no property '${*property}'`);
}

/// Property matching ignores case, `_`, `-` and spaces (UAX #44 loose
/// matching), so every table key is emitted folded and the consumer folds the
/// name it looks up the same way.
fn normalize_name(name: &String) -> String {
    let mut out = String::with_capacity(name.len());
    for let c of name.chars() {
        if c == '_' || c == '-' || c == ' ' {
            continue;
        }
        out.push(c.to_ascii_lowercase());
    }
    return out;
}

/// `#`-comment stripped, leading / trailing space removed.
fn strip_comment(line: &String) -> String {
    let mut out = String::with_capacity(line.len());
    for let c of line.chars() {
        if c == '#' {
            break;
        }
        out.push(c);
    }
    return out.trim();
}

fn parse_prop_runs(content: &String) -> List<PropRun> {
    let mut runs: List<PropRun> = [];
    for let line of content.lines() {
        let body = strip_comment(&line);
        if body.is_empty() {
            continue;
        }
        let mut fields: List<String> = [];
        for let f of body.split(";") {
            fields.push(f.trim());
        }
        // An enumerated property writes `RANGE ; NAME ; VALUE` (`InCB`); only
        // the two-field form is a set of code points named by one string.
        if fields.len() != 2 || fields[1].is_empty() {
            continue;
        }
        let bounds = parse_bounds(&fields[0]);
        runs.push(PropRun { start: bounds.0, end: bounds.1, value: fields[1] });
    }
    return runs;
}

/// Like `parse_prop_runs`, taking the value from `field` — `ArabicShaping.txt`
/// writes `CODE; NAME; JOINING_TYPE; JOINING_GROUP`.
fn parse_prop_runs_at(content: &String, field: i32) -> List<PropRun> {
    let mut runs: List<PropRun> = [];
    for let line of content.lines() {
        let body = strip_comment(&line);
        if body.is_empty() {
            continue;
        }
        let mut fields: List<String> = [];
        for let f of body.split(";") {
            fields.push(f.trim());
        }
        if fields.len() <= field || fields[field].is_empty() {
            continue;
        }
        let bounds = parse_bounds(&fields[0]);
        runs.push(PropRun { start: bounds.0, end: bounds.1, value: fields[field] });
    }
    return runs;
}

fn parse_bounds(text: &String) -> [i32, i32] {
    let mut bounds = text.split("..");
    let start = i32::from_str_hex(&bounds.next().unwrap()).unwrap();
    let end = match bounds.next() {
        Some(hi) => i32::from_str_hex(&hi).unwrap(),
        None => start,
    };
    return [start, end];
}

/// Every code point's value for one enumerated property, as runs covering the
/// whole space: the file's own lines, then its `@missing` defaults, then
/// `ArabicShaping.txt`'s `General_Category` rule.
///
/// `\P{...}` complements what `\p` selects, so a code point left without a
/// value would be admitted rather than merely missed. The partition is
/// asserted, not assumed.
fn partition_runs(
    content: &String,
    field: i32,
    gc_default: bool,
    categories: &List<CategoryRun>,
    aliases: &List<NamedRanges>,
    property: &String,
) -> List<PropRun> {
    let mut names: List<String> = [];
    let mut slot: List<i32> = List::filled(CODE_POINT_MAX + 1, 0);
    for let run of parse_prop_runs_at(content, field) {
        let id = intern(&mut names, &canonical_value(aliases, &run.value));
        fill(&mut slot, run.start, run.end, id);
    }

    // Their own layer: a narrower `@missing` line overrides a wider one
    // (`DerivedBidiClass.txt` gives whole blocks their own default), but none
    // of them overrides a code point the file lists.
    let missing = parse_missing(content);
    assert missing.is_empty() == gc_default, `${*property}: expected either @missing lines or the General_Category default rule, not both or neither`;
    let mut widest = missing;
    widest.sort_by(|a: &PropRun, b: &PropRun| (b.end - b.start).cmp(&(a.end - a.start)));
    let mut default_slot: List<i32> = List::filled(CODE_POINT_MAX + 1, 0);
    for let run of &widest {
        let id = intern(&mut names, &canonical_value(aliases, &run.value));
        fill(&mut default_slot, run.start, run.end, id);
    }
    for let mut c = 0; c <= CODE_POINT_MAX; c += 1 {
        if slot[c] == 0 {
            slot[c] = default_slot[c];
        }
    }

    if gc_default {
        // ArabicShaping.txt: a code point it does not list is Joining_Type=T
        // when its General_Category is Mn, Me or Cf, and U otherwise.
        let transparent = intern(&mut names, &canonical_value(aliases, &"T"));
        let non_joining = intern(&mut names, &canonical_value(aliases, &"U"));
        let mut is_transparent: List<bool> = List::filled(CODE_POINT_MAX + 1, false);
        for let run of categories {
            if run.category != "Mn" && run.category != "Me" && run.category != "Cf" {
                continue;
            }
            for let mut c = run.start; c <= run.end; c += 1 {
                is_transparent[c] = true;
            }
        }
        for let mut c = 0; c <= CODE_POINT_MAX; c += 1 {
            if slot[c] == 0 {
                slot[c] = if is_transparent[c] { transparent } else { non_joining };
            }
        }
    }

    let mut runs: List<PropRun> = [];
    let mut start = 0;
    for let mut c = 0; c <= CODE_POINT_MAX; c += 1 {
        assert slot[c] != 0, `${*property}: U+${c:X} has no value; the values do not partition the code-point space`;
        if c == CODE_POINT_MAX || slot[c + 1] != slot[c] {
            runs.push(PropRun { start, end: c, value: names[slot[c] - 1] });
            start = c + 1;
        }
    }
    return runs;
}

fn fill(slot: &mut List<i32>, start: i32, end: i32, id: i32) {
    for let mut c = start; c <= end; c += 1 {
        slot[c] = id;
    }
}

/// The alias row's canonical name, so a data line's `AL` and an `@missing`
/// line's `Arabic_Letter` intern as one value instead of splitting the
/// property in two.
fn canonical_value(aliases: &List<NamedRanges>, value: &String) -> String {
    for let alias of aliases {
        if names_contain_folded(alias, value) {
            return alias.names[0];
        }
    }
    return *value;
}

/// 1-based so 0 stays free as "no value yet".
fn intern(names: &mut List<String>, value: &String) -> i32 {
    for let mut i = 0; i < names.len(); i += 1 {
        if names[i] == *value {
            return i + 1;
        }
    }
    names.push(*value);
    return names.len();
}

/// `# @missing: START..END; VALUE` — the value a code point the file does not
/// list takes. Most files carry one line covering the whole space;
/// `DerivedBidiClass.txt` adds narrower ones for the RTL and Arabic blocks.
fn parse_missing(content: &String) -> List<PropRun> {
    let mut out: List<PropRun> = [];
    for let line of content.lines() {
        if !line.trim().starts_with("#") {
            continue;
        }
        let mut halves = line.split("@missing:");
        halves.next();
        if let Some(rest) = halves.next() {
            let mut fields = rest.split(";");
            let bounds = parse_bounds(&fields.next().unwrap().trim());
            out.push(PropRun {
                start: bounds.0,
                end: bounds.1,
                value: fields.next().unwrap().trim(),
            });
        }
    }
    return out;
}

/// Alias lines as `CANONICAL -> [alias, ...]`. `PropertyAliases.txt` is
/// `SHORT ; LONG [; …]` (pass an empty `prefix`); `PropertyValueAliases.txt`
/// is `PROPERTY ; SHORT ; LONG [; …]`, read by passing the property (`sc`,
/// `blk`). Either way the long name is canonical and everything else on the
/// line resolves to it.
fn parse_alias_lines(content: &String, prefix: &String) -> List<NamedRanges> {
    let mut out: List<NamedRanges> = [];
    for let line of content.lines() {
        let body = strip_comment(&line);
        if body.is_empty() {
            continue;
        }
        let mut fields: List<String> = [];
        for let f of body.split(";") {
            fields.push(f.trim());
        }
        let first = if prefix.is_empty() { 0 } else { 1 };
        if fields.len() < first + 2 || !prefix.is_empty() && fields[0] != *prefix {
            continue;
        }
        let mut names: List<String> = [fields[first + 1]];
        for let mut i = first; i < fields.len(); i += 1 {
            if i == first + 1 || fields[i].is_empty() || fields[i] == "n/a" {
                continue;
            }
            names.push(fields[i]);
        }
        out.push(NamedRanges { names, ranges: [] });
    }
    return out;
}

fn names_contain_folded(entry: &NamedRanges, name: &String) -> bool {
    let folded = normalize_name(name);
    for let n of &entry.names {
        if normalize_name(n) == folded {
            return true;
        }
    }
    return false;
}

/// Group `runs` by value, in first-seen order, attaching the aliases the
/// canonical name carries. Ranges are sorted and merged so the emitted table
/// is one entry per contiguous span.
fn named_ranges(runs: &List<PropRun>, aliases: &List<NamedRanges>) -> List<NamedRanges> {
    let mut out: List<NamedRanges> = [];
    let mut values: List<String> = [];
    for let run of runs {
        if !values.contains(&run.value) {
            values.push(run.value);
        }
    }
    for let value of &values {
        let mut ranges: List<[i32, i32]> = [];
        for let run of runs {
            if run.value == *value {
                ranges.push([run.start, run.end]);
            }
        }
        ranges.sort_by(|a: &[i32, i32], b: &[i32, i32]| a.0.cmp(&b.0));
        let mut merged: List<[i32, i32]> = [];
        for let r of &ranges {
            if !merged.is_empty() && merged[merged.len() - 1].1 + 1 >= r.0 {
                merged[merged.len() - 1] = [
                    merged[merged.len() - 1].0,
                    i32::max(merged[merged.len() - 1].1, r.1),
                ];
            } else {
                merged.push(*r);
            }
        }
        let mut names: List<String> = [*value];
        let mut matched = 0;
        for let alias of aliases {
            // A data file writes whichever alias it likes — `Scripts.txt` the
            // long name, `LineBreak.txt` the short one — so the row is found by
            // any of its names, folded (Blocks.txt spells a block with spaces
            // where the alias file uses underscores).
            if !names_contain_folded(alias, value) {
                continue;
            }
            matched += 1;
            for let n of &alias.names {
                if !names.contains(n) {
                    names.push(*n);
                }
            }
        }
        assert matched <= 1, `two alias rows both name '${*value}'; the table key would be ambiguous`;
        out.push(NamedRanges { names, ranges: merged });
    }
    return out;
}

fn read_file(path: &String) -> String with (Stderr, Preopens, Exit) {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("gen_unicode_tables: no preopened directories available");
        exit(1);
    }
    let opened = dirs[0].0.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait();
    if let Err(_) = opened {
        eprintln(`gen_unicode_tables: cannot open file: ${*path}`);
        exit(1);
    }
    let file = opened.unwrap();
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let bytes = read_stream.read_to_end();
    return String::from_utf8_unchecked(bytes);
}

fn parse_runs(content: &String) -> List<CategoryRun> {
    let mut runs: List<CategoryRun> = [];
    let mut range_start = -1;
    for let line of content.lines() {
        let mut fields: List<String> = [];
        for let f of line.split(";") {
            fields.push(f);
            if fields.len() == 3 {
                break;
            }
        }
        if fields.len() < 3 {
            continue;
        }
        let code = i32::from_str_hex(&fields[0]).unwrap();
        let name = &fields[1];
        let category = fields[2];
        if name.ends_with(", First>") {
            range_start = code;
            continue;
        }
        if name.ends_with(", Last>") {
            runs.push(CategoryRun { start: range_start, end: code, category });
            range_start = -1;
            continue;
        }
        runs.push(CategoryRun { start: code, end: code, category });
    }
    assert range_start < 0, "unterminated First> range in UnicodeData.txt";
    return runs;
}

/// Ranges of `category`, adjacent runs merged. UnicodeData.txt is in code-point
/// order, so a single forward pass suffices.
fn ranges_of(runs: &List<CategoryRun>, category: &String) -> List<[i32, i32]> {
    let mut out: List<[i32, i32]> = [];
    for let run of runs {
        if run.category != *category {
            continue;
        }
        if !out.is_empty() && out[out.len() - 1].1 + 1 >= run.start {
            out[out.len() - 1] = [out[out.len() - 1].0, run.end];
        } else {
            out.push([run.start, run.end]);
        }
    }
    return out;
}

/// `Cn` is exactly the code points UnicodeData.txt does not assign, so it is
/// the gaps between the runs rather than a category any run carries.
fn unassigned_ranges(runs: &List<CategoryRun>) -> List<[i32, i32]> {
    let mut out: List<[i32, i32]> = [];
    let mut next = 0;
    for let run of runs {
        if run.start > next {
            out.push([next, run.start - 1]);
        }
        if run.end + 1 > next {
            next = run.end + 1;
        }
    }
    if next <= CODE_POINT_MAX {
        out.push([next, CODE_POINT_MAX]);
    }
    return out;
}

/// Base64 over a varint stream: per range, the gap from the previous range's
/// end, shifted up one bit whose value says whether a length follows. Most of
/// the table is a single code point a short way past the previous one, so most
/// ranges are one byte; spelling the endpoints out costs six times as much.
fn encode(ranges: &List<[i32, i32]>) -> String {
    let mut bytes: ByteList = [];
    let mut prev = -1;
    for let r of ranges {
        assert prev < r.0 <= r.1, "encode expects sorted, merged ranges";
        let length = r.1 - r.0;
        push_varint(&mut bytes, (r.0 - prev - 1) * 2 + if length > 0 { 1 } else { 0 });
        if length > 0 {
            push_varint(&mut bytes, length - 1);
        }
        prev = r.1;
    }
    return base64_encode(&bytes);
}

fn push_varint(bytes: &mut ByteList, value: i32) {
    let mut rest = value;
    while rest >= 0x80 {
        bytes.push((rest & 0x7F | 0x80) as u8);
        rest >>= 7;
    }
    bytes.push(rest as u8);
}

fn emit_module(
    runs: &List<CategoryRun>,
    scripts: &List<NamedRanges>,
    blocks: &List<NamedRanges>,
    binary: &List<NamedRanges>,
    enumerated: &List<EnumeratedTable>,
    version: &String,
) -> String {
    let mut w = CodeWriter::with_capacity(1024 * 1024);
    emit_module_doc(&mut w, version);
    GlobalSpec::new(&"UNICODE_VERSION", &"String", &`${str_lit(*version)}`, Vis::Pub).emit(&mut w);
    w.blank();
    emit_category_ranges(&mut w, runs);
    w.blank();
    emit_category_groups(&mut w);
    w.blank();
    emit_named_table(
        &mut w,
        &"script_ranges",
        &"/// Ranges of one script (`Greek`, `Grek`, …), or an empty string when the\n/// name is not a script.",
        scripts,
    );
    w.blank();
    emit_named_table(
        &mut w,
        &"block_ranges",
        &"/// Ranges of one block, addressed without the `In` prefix a grammar writes\n/// (`\\p{InGreek}` → `greekandcoptic`), or an empty string when the name is\n/// not a block.",
        blocks,
    );
    w.blank();
    emit_named_table(
        &mut w,
        &"binary_property_ranges",
        &"/// Ranges of one binary property (`White_Space`, `Pattern_Syntax`, …), or\n/// an empty string when the name is not one.",
        binary,
    );
    for let table of enumerated {
        w.blank();
        emit_named_table(
            &mut w,
            &table.fn_name,
            &`/// Ranges of one \`${table.name}\` value, or an empty string when the name\n/// is not one of its values.`,
            &table.entries,
        );
    }
    w.blank();
    emit_enumerated_dispatch(&mut w, enumerated);
    return w.to_string();
}

/// Emit the `Property=Value` entry point: the property selects a table, which
/// answers the value. One flat table keyed by `property=value` would carry the
/// cross product of both alias sets.
fn emit_enumerated_dispatch(w: &mut CodeWriter, tables: &List<EnumeratedTable>) {
    w.line(&"/// Ranges of one enumerated property's value (`\\p{lb=AL}`), or an empty");
    w.line(&"/// string when the property is not one of these or the value is not one of");
    w.line(&"/// its own. `General_Category`, `Script` and `Block` have their own tables.");
    let mut spec = FnSpec::new(&"enumerated_property_ranges", Vis::Pub);
    spec.add_param(&"property", &"&String").add_param(&"value", &"&String").set_return_type(&"String");
    spec.emit_begin(w);
    w.begin(&"return match *property");
    for let table of tables {
        let mut keys = String::with_capacity(64);
        let mut first = true;
        for let key of &table.keys {
            if !first {
                keys.push_str(&" | ");
            }
            first = false;
            keys.push_str(&`${str_lit(*key)}`);
        }
        w.line(&`${keys} => ${table.fn_name}(value),`);
    }
    w.line(&`_ => ${str_lit("")},`);
    w.end_with(&";");
    w.end();
}

/// Emit `fn <name>(name: &String) -> String` as a match over folded keys. A
/// key already claimed by an earlier arm is dropped: match arms must stay
/// unique, and the first table entry to claim a name owns it.
fn emit_named_table(w: &mut CodeWriter, name: &String, doc: &String, entries: &List<NamedRanges>) {
    for let line of doc.lines() {
        w.line(&line);
    }
    let mut spec = FnSpec::new(name, Vis::Pub);
    spec.add_param(&"name", &"&String").set_return_type(&"String");
    spec.emit_begin(w);
    w.begin(&"return match *name");
    let mut claimed: List<String> = [];
    for let entry of entries {
        let mut keys = String::with_capacity(64);
        let mut first = true;
        for let n of &entry.names {
            let key = normalize_name(n);
            if claimed.contains(&key) {
                continue;
            }
            claimed.push(key);
            if !first {
                keys.push_str(&" | ");
            }
            first = false;
            keys.push_str(&`${str_lit(key)}`);
        }
        if first {
            // Every name this entry answers to is already an arm, so the entry
            // would be unreachable and `\p{...}` would call it unsupported.
            // The UCD has no such collision today; one appearing needs a
            // resolution rule, not a silent drop.
            panic(`unicode table ${*name}: ${entry.names[0]} has no unclaimed key`);
        }
        w.line(&`${keys} => ${str_lit(encode(&entry.ranges))},`);
    }
    w.line(&`_ => ${str_lit("")},`);
    w.end_with(&";");
    w.end();
}

fn emit_module_doc(w: &mut CodeWriter, version: &String) {
    w.line(&`#![generated(by = ${str_lit("scripts/regen-unicode-tables.sh")}, sources = [])]`);
    w.line(&"//! Unicode property ranges for `\\p{...}` / `\\P{...}` char sets: general");
    w.line(&"//! categories, scripts, blocks, binary properties, and the enumerated");
    w.line(&"//! `Property=Value` names ANTLR4 answers.");
    w.line(&"//!");
    w.line(&`//! Do not edit by hand — regenerate from UCD ${*version} with`);
    w.line(&"//! `scripts/regen-unicode-tables.sh`.");
    w.line(&"//!");
    w.line(&"//! A property's ranges are base64 over `(gap from the previous range's");
    w.line(&"//! end, length)` varint pairs, and its keys are folded (lowercase, no");
    w.line(&"//! `_` / `-` / space) as UAX #44 matches them. `\\P` complements what");
    w.line(&"//! `\\p` selects, so an approximate table would admit real members of the");
    w.line(&"//! property, not merely miss some.");
    w.blank();
}

fn emit_category_ranges(w: &mut CodeWriter, runs: &List<CategoryRun>) {
    w.line(&"/// Ranges of one general category (`Lu`, `Nd`, …), or an empty string when");
    w.line(&"/// the name is not a general category. Group letters (`L`, `N`, …) are");
    w.line(&"/// unions of their subcategories and are resolved by the caller.");
    let mut spec = FnSpec::new(&"general_category_ranges", Vis::Pub);
    spec.add_param(&"name", &"&String").set_return_type(&"String");
    spec.emit_begin(w);
    w.begin(&"return match *name");
    for let cat of &CATEGORIES {
        let ranges = if cat.0 == "Cn" { unassigned_ranges(runs) } else { ranges_of(runs, &cat.0) };
        w.line(
            &`${str_lit(normalize_name(&cat.0))} | ${str_lit(normalize_name(&cat.1))} => ${str_lit(encode(&ranges))},`,
        );
    }
    w.line(&`_ => ${str_lit("")},`);
    w.end_with(&";");
    w.end();
}

fn emit_category_groups(w: &mut CodeWriter) {
    w.line(&"/// Subcategories of a general-category group letter (`L` -> `Lu`, `Ll`, …),");
    w.line(&"/// or an empty list when the name is not a group.");
    let mut spec = FnSpec::new(&"general_category_group", Vis::Pub);
    spec.add_param(&"name", &"&String").set_return_type(&"List<String>");
    spec.emit_begin(w);
    w.begin(&"return match *name");
    for let group of &GROUPS {
        let mut subs = String::with_capacity(64);
        let mut first = true;
        for let cat of &CATEGORIES {
            if !cat.0.starts_with(group.0) {
                continue;
            }
            if !first {
                subs.push_str(&", ");
            }
            first = false;
            subs.push_str(&`${str_lit(normalize_name(&cat.0))}`);
        }
        w.line(&`${str_lit(normalize_name(&group.0))} | ${str_lit(normalize_name(&group.1))} => [${subs}],`);
    }
    w.line(&"_ => [],");
    w.end_with(&";");
    w.end();
}
