#!/usr/bin/env wado
//! Emit `src/g4/unicode_tables.wado` from the Unicode Character Database.
//! Reads `UnicodeData.txt` on argv, prints the module to stdout;
//! `scripts/regen-unicode-tables.sh` fetches the UCD and drives it.
//!
//! Gale expands `\p{...}` / `\P{...}` in a lexer char set into code-point
//! ranges at grammar-parse time. `\P` is the complement of `\p`, so an
//! approximate table does not merely miss characters — it admits them. The
//! table is generated from the UCD rather than hand-maintained.

use { args, print, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { CodeWriter, FnSpec, GlobalSpec, Vis, str_lit } from "../src/wadopoet.wado";

global CODE_POINT_MAX: i32 = 0x10FFFF;

/// General categories in the order they are emitted, with the long alias
/// `PropertyValueAliases.txt` gives each. Group letters (`L`, `M`, …) are
/// unions of their subcategories and are resolved by the consumer.
global CATEGORIES: List<[String, String]> = [
    ["Cc", "Control"],
    ["Cf", "Format"],
    ["Cn", "Unassigned"],
    ["Co", "Private_Use"],
    ["Cs", "Surrogate"],
    ["Ll", "Lowercase_Letter"],
    ["Lm", "Modifier_Letter"],
    ["Lo", "Other_Letter"],
    ["Lt", "Titlecase_Letter"],
    ["Lu", "Uppercase_Letter"],
    ["Mc", "Spacing_Mark"],
    ["Me", "Enclosing_Mark"],
    ["Mn", "Nonspacing_Mark"],
    ["Nd", "Decimal_Number"],
    ["Nl", "Letter_Number"],
    ["No", "Other_Number"],
    ["Pc", "Connector_Punctuation"],
    ["Pd", "Dash_Punctuation"],
    ["Pe", "Close_Punctuation"],
    ["Pf", "Final_Punctuation"],
    ["Pi", "Initial_Punctuation"],
    ["Po", "Other_Punctuation"],
    ["Ps", "Open_Punctuation"],
    ["Sc", "Currency_Symbol"],
    ["Sk", "Modifier_Symbol"],
    ["Sm", "Math_Symbol"],
    ["So", "Other_Symbol"],
    ["Zl", "Line_Separator"],
    ["Zp", "Paragraph_Separator"],
    ["Zs", "Space_Separator"],
];

global GROUPS: List<[String, String]> = [
    ["L", "Letter"],
    ["M", "Mark"],
    ["N", "Number"],
    ["P", "Punctuation"],
    ["S", "Symbol"],
    ["Z", "Separator"],
    ["C", "Other"],
];

/// One `START;NAME;CATEGORY` run of the UCD, with the `, First>` / `, Last>`
/// pairs already joined into a single range.
struct CategoryRun {
    start: i32,
    end: i32,
    category: String,
}

export fn run() with Stdout, Stderr, Environment, Preopens, Exit {
    let arguments = args();
    if arguments.len() != 2 {
        eprintln("usage: gen_unicode_tables <UnicodeData.txt> <version>");
        exit(1);
    }
    let content = read_file(&arguments[0]);
    let version = arguments[1];

    print(emit_module(&parse_runs(&content), &version));
}

fn read_file(path: &String) -> String with Stderr, Preopens, Exit {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("gen_unicode_tables: no preopened directories available");
        exit(1);
    }
    let opened = dirs[0].0.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait();
    if let Err(_) = opened {
        eprintln(`gen_unicode_tables: cannot open file: ${*path}`);
        exit(1);
    }
    let file = opened.unwrap();
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let mut bytes: List<u8> = [];
    loop {
        let chunk = read_stream.read(65536);
        if chunk.len() == 0 {
            break;
        }
        for let b of chunk {
            bytes.push(b);
        }
    }
    return String::from_utf8_unchecked(bytes);
}

fn parse_runs(content: &String) -> List<CategoryRun> {
    let mut runs: List<CategoryRun> = [];
    let mut range_start = -1;
    for let line of content.lines() {
        let mut fields: List<String> = [];
        for let f of line.split(";") {
            fields.push(f);
            if fields.len() == 3 {
                break;
            }
        }
        if fields.len() < 3 {
            continue;
        }
        let code = i32::from_str_hex(&fields[0]).unwrap();
        let name = &fields[1];
        let category = fields[2];
        if name.ends_with(", First>") {
            range_start = code;
            continue;
        }
        if name.ends_with(", Last>") {
            runs.push(CategoryRun { start: range_start, end: code, category });
            range_start = -1;
            continue;
        }
        runs.push(CategoryRun { start: code, end: code, category });
    }
    assert range_start < 0, "unterminated First> range in UnicodeData.txt";
    return runs;
}

/// Ranges of `category`, adjacent runs merged. UnicodeData.txt is in code-point
/// order, so a single forward pass suffices.
fn ranges_of(runs: &List<CategoryRun>, category: &String) -> List<[i32, i32]> {
    let mut out: List<[i32, i32]> = [];
    for let run of runs {
        if run.category != *category {
            continue;
        }
        if !out.is_empty() && out[out.len() - 1].1 + 1 >= run.start {
            out[out.len() - 1] = [out[out.len() - 1].0, run.end];
        } else {
            out.push([run.start, run.end]);
        }
    }
    return out;
}

/// `Cn` is exactly the code points UnicodeData.txt does not assign, so it is
/// the gaps between the runs rather than a category any run carries.
fn unassigned_ranges(runs: &List<CategoryRun>) -> List<[i32, i32]> {
    let mut out: List<[i32, i32]> = [];
    let mut next = 0;
    for let run of runs {
        if run.start > next {
            out.push([next, run.start - 1]);
        }
        if run.end + 1 > next {
            next = run.end + 1;
        }
    }
    if next <= CODE_POINT_MAX {
        out.push([next, CODE_POINT_MAX]);
    }
    return out;
}

/// `START[-END]` in hex, comma separated. A single code point drops its
/// `-END` half, which is most of the table.
fn encode(ranges: &List<[i32, i32]>) -> String {
    let mut out = String::with_capacity(ranges.len() * 8);
    let mut first = true;
    for let r of ranges {
        if !first {
            out.push_str(&",");
        }
        first = false;
        out.push_str(&`${r.0:X}`);
        if r.0 != r.1 {
            out.push_str(&`-${r.1:X}`);
        }
    }
    return out;
}

fn emit_module(runs: &List<CategoryRun>, version: &String) -> String {
    let mut w = CodeWriter::with_capacity(64 * 1024);
    emit_module_doc(&mut w, version);
    GlobalSpec::new(&"UNICODE_VERSION", &"String", &`${str_lit(*version)}`, Vis::Pub).emit(&mut w);
    w.blank();
    emit_category_ranges(&mut w, runs);
    w.blank();
    emit_category_groups(&mut w);
    return w.to_string();
}

fn emit_module_doc(w: &mut CodeWriter, version: &String) {
    w.line(&`#![generated(by = ${str_lit("scripts/regen-unicode-tables.sh")}, sources = [])]`);
    w.line(&"//! Unicode general-category ranges for `\\p{...}` / `\\P{...}` char sets.");
    w.line(&"//!");
    w.line(&`//! Do not edit by hand — regenerate from UCD ${*version} with`);
    w.line(&"//! `scripts/regen-unicode-tables.sh`.");
    w.line(&"//!");
    w.line(&"//! A category's ranges are `START[-END]` in hex, comma separated. `\\P`");
    w.line(&"//! complements what `\\p` selects, so an approximate table would admit real");
    w.line(&"//! members of the property, not merely miss some.");
    w.blank();
}

fn emit_category_ranges(w: &mut CodeWriter, runs: &List<CategoryRun>) {
    w.line(&"/// Ranges of one general category (`Lu`, `Nd`, …), or an empty string when");
    w.line(&"/// the name is not a general category. Group letters (`L`, `N`, …) are");
    w.line(&"/// unions of their subcategories and are resolved by the caller.");
    let mut spec = FnSpec::new(&"general_category_ranges", Vis::Pub);
    spec.add_param(&"name", &"&String").set_return_type(&"String");
    spec.emit_begin(w);
    w.begin(&"return match *name");
    for let cat of &CATEGORIES {
        let ranges = if cat.0 == "Cn" { unassigned_ranges(runs) } else { ranges_of(runs, &cat.0) };
        w.line(&`${str_lit(cat.0)} | ${str_lit(cat.1)} => ${str_lit(encode(&ranges))},`);
    }
    w.line(&`_ => ${str_lit("")},`);
    w.end_with(&";");
    w.end();
}

fn emit_category_groups(w: &mut CodeWriter) {
    w.line(&"/// Subcategories of a general-category group letter (`L` -> `Lu`, `Ll`, …),");
    w.line(&"/// or an empty list when the name is not a group.");
    let mut spec = FnSpec::new(&"general_category_group", Vis::Pub);
    spec.add_param(&"name", &"&String").set_return_type(&"List<String>");
    spec.emit_begin(w);
    w.begin(&"return match *name");
    for let group of &GROUPS {
        let mut subs = String::with_capacity(64);
        let mut first = true;
        for let cat of &CATEGORIES {
            if !cat.0.starts_with(group.0) {
                continue;
            }
            if !first {
                subs.push_str(&", ");
            }
            first = false;
            subs.push_str(&`${str_lit(cat.0)}`);
        }
        w.line(&`${str_lit(group.0)} | ${str_lit(group.1)} => [${subs}],`);
    }
    w.line(&"_ => [],");
    w.end_with(&";");
    w.end();
}
