//! The TypeScript recognizer with its base ports installed, for the benchmark
//! and the driver test.

use ts from "../tests/grammars/TypeScriptLexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["../tests/grammars/TypeScriptParser.g4"],
            output_dir: "../tests/generated/cst_typescript",
        },
    };
use {
    TypeScriptLexerBase,
    TypeScriptParserBase,
    LexerView,
    Lexer,
    Parser,
    TK_Identifier,
    TK_NullLiteral,
    TK_BooleanLiteral,
    TK_This,
    TK_CloseBracket,
    TK_CloseParen,
    TK_OctalIntegerLiteral,
    TK_DecimalLiteral,
    TK_HexIntegerLiteral,
    TK_StringLiteral,
    TK_PlusPlus,
    TK_MinusMinus,
    TK_OpenBrace,
    TK_CloseBrace,
    TK_Function_,
    TK_Interface,
} from "../tests/grammars/TypeScriptLexer.g4";

// The Wado twin of `grammars/java/TypeScriptParserBase.java`, which
// `antlr4-oracle.sh --super` runs ANTLR4 against. Edit both or neither.
struct TsParserBase {
}

impl TypeScriptParserBase for TsParserBase {
    /// No line break between the token just consumed and the next one — what
    /// JavaScript's automatic semicolon insertion turns on.
    fn not_line_terminator(&self, p: &Parser) -> bool {
        resume p.token_line(p.lt(1)) == p.token_line(p.lt(0));
    }

    fn line_terminator_ahead(&self, p: &Parser) -> bool {
        resume p.token_line(p.lt(1)) != p.token_line(p.lt(0));
    }

    fn close_brace(&self, p: &Parser) -> bool {
        resume p.la(1) == TK_CloseBrace;
    }

    /// An expression statement may not start with `{`, `function` or
    /// `interface` — those open a block, a declaration and a type instead.
    fn not_open_brace_and_not_function_and_not_interface(&self, p: &Parser) -> bool {
        resume !p.la(1) matches { TK_OpenBrace | TK_Function_ | TK_Interface };
    }

    /// The token just consumed is `a0` — `for (x of xs)` asks it of `of`.
    fn p(&self, p: &Parser, a0: String) -> bool {
        resume p.token_text(p.lt(0)) == a0;
    }

    /// The next token is `a0` — a getter / setter asks it of `get` / `set`.
    fn n(&self, p: &Parser, a0: String) -> bool {
        resume p.token_text(p.lt(1)) == a0;
    }
}

// A hand-written TypeScriptLexerBase port, installed around every recognizer
// call: the action ops carry the brace / template state the predicate ops read,
// and the `emit` hook carries the last default-channel token.
//
// `IsStrictMode` still sees only the `'use strict'` literal the lexer passes,
// not the parser's notion of scope (see TODO.md, Stage C).
struct TsBase {
    // One entry per `${` interpolation still open: how many plain `{` are open
    // inside it. A `}` ends the interpolation only at count 0.
    interp_braces: List<i32>,
    // Where each open template's interpolation entries start, so a closing
    // backtick drops what its interpolations left behind.
    template_marks: List<i32>,
    strict: bool,
    /// `-1` before the first token. Upstream tracks this by overriding
    /// `nextToken`.
    last_token: i32 = -1,
}

/// Whether a token ends an operand, so a following `/` is a division rather
/// than the start of a regular expression.
fn ends_operand(kind: i32) -> bool {
    return kind matches { TK_Identifier | TK_NullLiteral | TK_BooleanLiteral | TK_This | TK_CloseBracket | TK_CloseParen | TK_OctalIntegerLiteral | TK_DecimalLiteral | TK_HexIntegerLiteral | TK_StringLiteral | TK_PlusPlus | TK_MinusMinus };
}

impl TypeScriptLexerBase for TsBase {
    fn emit(&mut self, view: LexerView, ty: i32, channel: i32) -> i32 {
        if channel == 0 {
            self.last_token = ty;
        }
        resume ty;
    }

    fn is_regex_possible(&self, view: LexerView) -> bool {
        resume !ends_operand(self.last_token);
    }

    fn is_in_template_string(&self, view: LexerView) -> bool {
        if self.template_marks.is_empty() {
            resume false;
        }
        resume self.interp_braces.last() matches { Some(n) && n == 0 };
    }

    fn is_strict_mode(&self, view: LexerView) -> bool {
        resume self.strict;
    }

    fn process_open_brace(&mut self, view: LexerView, lx: &mut Lexer) {
        let n = self.interp_braces.len();
        if n > 0 {
            self.interp_braces[n - 1] += 1;
        }
        resume ();
    }

    fn process_close_brace(&mut self, view: LexerView, lx: &mut Lexer) {
        let n = self.interp_braces.len();
        if n > 0 && self.interp_braces[n - 1] > 0 {
            self.interp_braces[n - 1] -= 1;
        }
        resume ();
    }

    fn process_string_literal(&mut self, view: LexerView, lx: &mut Lexer) {
        let text = view.text();
        if text == "'use strict'" || text == "\"use strict\"" {
            self.strict = true;
        }
        resume ();
    }

    fn increase_template_depth(&mut self, view: LexerView, lx: &mut Lexer) {
        self.template_marks.push(self.interp_braces.len());
        resume ();
    }

    fn decrease_template_depth(&mut self, view: LexerView, lx: &mut Lexer) {
        if let Some(mark) = self.template_marks.pop() {
            self.interp_braces.truncate(mark);
        }
        resume ();
    }

    fn start_template_string(&mut self, view: LexerView, lx: &mut Lexer) {
        self.interp_braces.push(0);
        resume ();
    }
}

/// Runs `recognize` with the base ports installed.
pub fn with_typescript_bases<T>(recognize: fn() -> T with (TypeScriptLexerBase, TypeScriptParserBase)) -> T {
    let mut base = TsBase { interp_braces: [], template_marks: [], strict: false };
    let mut pbase = TsParserBase {};
    with TypeScriptLexerBase => &mut base, TypeScriptParserBase => &mut pbase do {
        return recognize();
    };
}

/// Parses a whole TypeScript source file.
pub fn parse_typescript<S: AsStrSlice>(source: S) -> ts::ParseResult {
    return with_typescript_bases(|| ts::parse_program(source));
}
