//! Every `crate::` / `super::` path a Rust file writes outside a `use` item
//! (`AGENTS.md` > General Rules), found with the Gale-generated Rust parser.
//! The grammar decides what is a path: a comment, a string, `$crate` and a raw
//! identifier are settled by the lexer, and what encloses a path by the parse
//! tree, rather than by a regular expression reading bytes.
//!
//! A file the grammar cannot parse is reported, never counted: recovery drops
//! tokens, so a count taken from a broken tree would license whatever it failed
//! to see.
//!
//! The corpus predates the rule, so `scripts/rust-inline-paths.json` records
//! what each file still carries and `--check` fails only on a file that grew
//! past it. `scripts/check-rust-paths.sh` drives every mode; paths open
//! relative to the first preopen, so run it from the repository root.

use rust from "../tests/grammars/RustLexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["../tests/grammars/RustParser.g4"],
            output_dir: "../tests/generated/cst_rust",
        },
    };
use { RustLexerBase, RustParserBase, LexerView, Parser } from "../tests/grammars/RustLexer.g4";
use { args, println, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use { Preopens, Descriptor, Filesize, PathFlags, OpenFlags, DescriptorFlags } from "wasi:filesystem";
use { TreeMap } from "core:collections";
use { from_string, to_string_pretty } from "core:json";

global BASELINE_PATH: String = "scripts/rust-inline-paths.json";

// The same ports the driver test installs; see `tests/driver_cst_rust_test.wado`.
struct RustBase {
}

impl RustLexerBase for RustBase {
    fn sof(&self, view: LexerView) -> bool {
        resume view.la(-1) == -1;
    }

    fn float_literal_possible(&self, view: LexerView) -> bool {
        resume view.la(-1) != '.' as i32;
    }

    fn float_dot_possible(&self, view: LexerView) -> bool {
        let c = view.la(1);
        if c == '.' as i32 || c == '_' as i32 {
            resume false;
        }
        if c >= 'a' as i32 && c <= 'z' as i32 || c >= 'A' as i32 && c <= 'Z' as i32 {
            resume false;
        }
        resume true;
    }
}

struct RustPBase {
}

impl RustParserBase for RustPBase {
    fn next_lt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(0)) == 1;
    }

    fn next_gt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(0)) == 1;
    }
}

/// One path written where its item is read, at a 1-based line and column.
pub struct InlinePath {
    pub line: i32,
    pub column: i32,
    pub text: String,
}

fn parse_rust(source: &String) -> rust::ParseResult {
    let mut base = RustBase {};
    let mut pbase = RustPBase {};
    with RustLexerBase => &mut base, RustParserBase => &mut pbase do {
        return rust::parse(source);
    };
}

/// The character offset of every `crate` / `super` that opens a path outside a
/// `use` item, paired with the text a report quotes for it.
///
/// A `useDeclaration` subtree is the one place the rule allows such a path, and
/// the row scan tracks it by the depth it opened at: a `use` item nests no
/// other, so the first one seen owns every row until its own close.
fn path_roots(result: &rust::ParseResult) -> List<[i32, String]> {
    let cst = &result.cst;
    let toks = &result.tokens;
    let mut out: List<[i32, String]> = [];
    let mut depth = 0;
    let mut use_depth = -1;
    for let mut row = 0; row < cst.row_count(); row += 1 {
        match cst.tag[row] {
            Open => {
                depth += 1;
                if use_depth < 0 && cst.kind(row) == rust::RK_USEDECLARATION {
                    use_depth = depth;
                }
            },
            Close => {
                if use_depth == depth {
                    use_depth = -1;
                }
                depth -= 1;
            },
            Tok => {
                if use_depth < 0 {
                    let tok = cst.token_index(row);
                    let kind = toks.kind_at(tok);
                    let root = kind == rust::TK_KW_CRATE || kind == rust::TK_KW_SUPER;
                    if root && tok + 1 < toks.len() && toks.kind_at(tok + 1) == rust::TK_PATHSEP {
                        let text = if kind == rust::TK_KW_CRATE { "crate::" } else { "super::" };
                        out.push([toks.span_at(tok).start, text]);
                    }
                }
            },
            Miss => {
            },
            Skip => {
            },
        }
    }
    return out;
}

/// `roots` carries source-ordered offsets, so one walk of the characters
/// resolves every line and column.
fn locate(chars: &List<char>, roots: &List<[i32, String]>) -> List<InlinePath> {
    let mut out: List<InlinePath> = List::with_capacity(roots.len());
    let mut line = 1;
    let mut column = 1;
    let mut i = 0;
    for let mut k = 0; k < roots.len(); k += 1 {
        let at = roots[k].0;
        assert at >= i, "path roots must arrive in source order";
        while i < at {
            if chars[i] == '\n' {
                line += 1;
                column = 1;
            } else {
                column += 1;
            }
            i += 1;
        }
        out.push(InlinePath { line, column, text: roots[k].1 });
    }
    return out;
}

/// Every inline path in `source`, or why the file could not be parsed.
///
/// An unparsable file is an error rather than a clean zero: recovery drops
/// tokens, and a count taken from a broken tree would license whatever it
/// failed to see.
pub fn find_inline_paths(source: &String) -> Result<List<InlinePath>, String> {
    let result = parse_rust(source);
    if result.diagnostics.len() > 0 {
        let first = result.diagnostics[0];
        return Result::Err(`${first.message} at ${first.rule_path()}`);
    }
    return Result::Ok(locate(result.tokens.chars, &path_roots(&result)));
}

fn read_file(root: &Descriptor, path: &String) -> Option<String> with Stderr {
    let file = match root.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::none(),
        DescriptorFlags::Read,
    ).wait() {
        Ok(f) => f,
        Err(e) => {
            eprintln(`error: ${*path}: cannot open: ${e:?}`);
            return null;
        },
    };
    let [read_stream, _done] = file.read_via_stream(0 as Filesize);
    let bytes = read_stream.read_to_end();
    read_stream.drop();
    return match String::from_utf8(bytes) {
        Ok(s) => Option::Some(s),
        Err(e) => {
            eprintln(`error: ${*path}: not UTF-8: ${e}`);
            return null;
        },
    };
}

fn write_file(root: &Descriptor, path: &String, content: &String) -> bool with Stderr {
    let file = match root.open_at(
        PathFlags::none(),
        *path,
        OpenFlags::Create | OpenFlags::Truncate,
        DescriptorFlags::Read | DescriptorFlags::Write,
    ).wait() {
        Ok(f) => f,
        Err(e) => {
            eprintln(`error: ${*path}: cannot write: ${e:?}`);
            return false;
        },
    };
    let bytes: List<u8> = content.bytes().collect();
    let [rx, tx] = Stream::<u8>::new();
    let sub = file.write_via_stream(rx, 0 as Filesize);
    tx.write_all(bytes);
    tx.drop();
    let written = sub.read();
    sub.drop();
    if let Some(Err(e)) = written {
        eprintln(`error: ${*path}: cannot write: ${e:?}`);
        return false;
    }
    return true;
}

fn corpus_root() -> Option<Descriptor> with (Stderr, Preopens) {
    let dirs = Preopens::get_directories();
    if dirs.len() == 0 {
        eprintln("error: no preopened directories available");
        return null;
    }
    return Option::Some(dirs[0].0);
}

fn collect_paths(root: &Descriptor, argv: &List<String>) -> List<String> with Stderr {
    let mut paths: List<String> = [];
    for let mut i = 0; i < argv.len(); i += 1 {
        if argv[i] == "--paths-from" {
            // Without this the option falls through the `.rs` arm and the run
            // reports a clean zero files.
            assert i + 1 < argv.len(), "--paths-from needs a file";
            i += 1;
            // An unreadable list yields no paths, which would otherwise read as
            // a clean run. Keep it as the one path that reports itself.
            let Some(list) = read_file(root, &argv[i]) else {
                paths.push(argv[i]);
                continue;
            };
            for let line of list.lines() {
                if !line.is_empty() {
                    paths.push(line);
                }
            }
        } else if argv[i].ends_with(".rs") {
            paths.push(argv[i]);
        }
    }
    return paths;
}

/// File path to the number of inline paths it carries, omitting the clean ones.
fn census(root: &Descriptor, paths: &List<String>, failed: &mut i32) -> List<[String, i32]> with Stderr {
    let mut counts: List<[String, i32]> = [];
    for let path of paths {
        let Some(source) = read_file(root, path) else {
            *failed += 1;
            continue;
        };
        match find_inline_paths(&source) {
            Ok(hits) => {
                if hits.len() > 0 {
                    counts.push([*path, hits.len()]);
                }
            },
            Err(why) => {
                eprintln(`error: ${path}: ${why}`);
                *failed += 1;
            },
        }
    }
    counts.sort_by(|a: &[String, i32], b: &[String, i32]| a.0.cmp(&b.0));
    return counts;
}

fn read_baseline(root: &Descriptor) -> Option<TreeMap<String, i32>> with Stderr {
    let Some(text) = read_file(root, &BASELINE_PATH) else {
        return null;
    };
    return match from_string::<TreeMap<String, i32>>(text) {
        Ok(map) => Option::Some(map),
        Err(e) => {
            eprintln(`error: ${BASELINE_PATH}: ${e:?}`);
            return null;
        },
    };
}

fn write_baseline(root: &Descriptor, counts: &List<[String, i32]>) -> bool with Stderr {
    let mut map = TreeMap::<String, i32>::new();
    for let entry of counts {
        map[entry.0] = entry.1;
    }
    let text = match to_string_pretty(&map, Option::Some('\n')) {
        Ok(s) => s,
        Err(e) => {
            eprintln(`error: cannot serialize the baseline: ${e:?}`);
            return false;
        },
    };
    return write_file(root, &BASELINE_PATH, &text);
}

fn total(counts: &List<[String, i32]>) -> i32 {
    let mut sum = 0;
    for let entry of counts {
        sum += entry.1;
    }
    return sum;
}

fn baseline_total(baseline: &TreeMap<String, i32>) -> i32 {
    let mut sum = 0;
    for let [_path, n] of baseline.entries() {
        sum += *n;
    }
    return sum;
}

/// Every file carrying more than its baseline allows, as `[file, was, now]`.
fn grown(counts: &List<[String, i32]>, baseline: &TreeMap<String, i32>) -> List<[String, i32, i32]> {
    let mut out: List<[String, i32, i32]> = [];
    for let entry of counts {
        let was = match baseline.get(entry.0) {
            Some(n) => n,
            None => 0,
        };
        if entry.1 > was {
            out.push([entry.0, was, entry.1]);
        }
    }
    return out;
}

fn report_grown(rows: &List<[String, i32, i32]>) with Stderr {
    eprintln("error: inline `crate::` / `super::` paths added; import them with `use`:");
    for let row of rows {
        eprintln(`  ${row.0}: ${row.1} -> ${row.2}`);
    }
    eprintln("");
    eprintln("Run `scripts/check-rust-paths.sh <file>` to list them.");
}

fn list_mode(root: &Descriptor, paths: &List<String>) -> i32 with (Stdout, Stderr) {
    let mut found = 0;
    let mut failed = 0;
    for let path of paths {
        let Some(source) = read_file(root, path) else {
            failed += 1;
            continue;
        };
        match find_inline_paths(&source) {
            Ok(hits) => {
                for let hit of hits {
                    println(`${*path}:${hit.line}:${hit.column}: ${hit.text}`);
                    found += 1;
                }
            },
            Err(why) => {
                eprintln(`error: ${path}: ${why}`);
                failed += 1;
            },
        }
    }
    println(`${found} inline paths`);
    return if failed > 0 { 1 } else { 0 };
}

fn ratchet_mode(root: &Descriptor, paths: &List<String>, update: bool) -> i32 with (Stdout, Stderr) {
    let mut failed = 0;
    let counts = census(root, paths, &mut failed);
    if failed > 0 {
        eprintln(`error: ${failed} of ${paths.len()} files could not be measured`);
        return 1;
    }
    let Some(baseline) = read_baseline(root) else {
        return 1;
    };
    // The baseline only ever ratchets down. Recording a file that grew would
    // license the paths `--check` is there to refuse.
    let rows = grown(&counts, &baseline);
    if rows.len() > 0 {
        report_grown(&rows);
        return 1;
    }
    if update {
        if !write_baseline(root, &counts) {
            return 1;
        }
        println(`baseline: ${total(&counts)} inline paths in ${counts.len()} files`);
        return 0;
    }
    let left = total(&counts);
    let shrunk = baseline_total(&baseline) - left;
    let ratchet = if shrunk > 0 { `, ${shrunk} fewer than the baseline — run --update` } else { "" };
    println(`ok: no file gained an inline path (${left} left${ratchet})`);
    return 0;
}

export fn run() with (Stdout, Stderr, Environment, Preopens, Exit) {
    let Some(root) = corpus_root() else {
        exit(1);
    };
    let argv = args();
    let paths = collect_paths(&root, &argv);
    let update = argv.into_iter().any(|a: String| a == "--update");
    let check = argv.into_iter().any(|a: String| a == "--check");
    let status = if update || check { ratchet_mode(&root, &paths, update) } else { list_mode(&root, &paths) };
    if status != 0 {
        exit(status as u8);
    }
}

test "a path outside a use item is reported with its position" {
    let hits = find_inline_paths(&"fn f() -> super::T { crate::g() }\n").unwrap();
    assert hits.len() == 2;
    assert hits[0].line == 1 && hits[0].column == 11 && hits[0].text == "super::";
    assert hits[1].line == 1 && hits[1].column == 22 && hits[1].text == "crate::";
}

test "a use item may name any path" {
    let hits = find_inline_paths(&"use crate::a::B;\nuse super::c::D;\nuse crate::{e, f::G};\n").unwrap();
    assert hits.len() == 0;
}

test "a use item inside a function body is still a use item" {
    let hits = find_inline_paths(&"fn f() {\n    use crate::a::B;\n    B::new();\n}\n").unwrap();
    assert hits.len() == 0;
}

test "comments and strings hold no paths" {
    let source = "// crate::a\n/* super::b */\nfn f() -> String { \"crate::c\".to_string() }\n";
    assert find_inline_paths(&source).unwrap().len() == 0;
}

test "a raw string holds no paths" {
    let source = "fn f() -> &'static str { r#\"crate::a and super::b\"# }\n";
    assert find_inline_paths(&source).unwrap().len() == 0;
}

test "macro hygiene is not an import" {
    let source = "macro_rules! m {\n    () => { $crate::a::B };\n}\n";
    assert find_inline_paths(&source).unwrap().len() == 0;
}

// `RustParser.g4` predates edition-2024 precise capturing, so `use<..>` in a
// bound position is a parse error today — reported as an unmeasurable file
// rather than silently counted wrong. Remove the `#[TODO]` once the grammar
// gains `useBound`.
#[TODO]
test "a precise capture list is not a use item" {
    let source = "fn f<T>(t: T) -> impl Sized + use<T> { crate::wrap(t) }\n";
    let hits = find_inline_paths(&source).unwrap();
    assert hits.len() == 1;
    assert hits[0].text == "crate::";
}

test "a bare crate or super with no path separator is not a path root" {
    let source = "pub(crate) fn f() {}\npub(super) fn g() {}\npub(in crate::a) fn h() {}\n";
    let hits = find_inline_paths(&source).unwrap();
    assert hits.len() == 1;
    assert hits[0].line == 3;
}

test "every path root in a chain counts" {
    let hits = find_inline_paths(&"fn f() -> super::super::T { crate::a::crate_b() }\n").unwrap();
    assert hits.len() == 3;
}

test "a file that does not parse is an error, not a clean count" {
    assert find_inline_paths(&"fn f( {\n").is_err();
}
