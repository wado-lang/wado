//! The Rust recognizer with its base ports installed, for the tools here and
//! the driver test.

use rust from "../tests/grammars/RustLexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["../tests/grammars/RustParser.g4"],
            output_dir: "../tests/generated/cst_rust",
        },
    };
use { RustLexerBase, RustParserBase, LexerView, Parser } from "../tests/grammars/RustLexer.g4";

// A hand-written RustLexerBase port (the real base class is Java, outside the
// .g4). Stateless: the predicates read only the match window.
// `grammars/java/RustLexerBase.java` is its Java twin, which
// `antlr4-oracle.sh --super` runs ANTLR4 against. Edit both or neither.
struct RustBase {
}

impl RustLexerBase for RustBase {
    fn sof(&self, view: LexerView) -> bool {
        resume view.la(-1) == -1;
    }

    fn float_literal_possible(&self, view: LexerView) -> bool {
        resume view.la(-1) != '.' as i32;
    }

    fn float_dot_possible(&self, view: LexerView) -> bool {
        let c = view.la(1);
        if c == '.' as i32 || c == '_' as i32 {
            resume false;
        }
        if c >= 'a' as i32 && c <= 'z' as i32 || c >= 'A' as i32 && c <= 'Z' as i32 {
            resume false;
        }
        resume true;
    }
}

// The parser base, likewise a port. The lexer emits `<` and `>` one character
// at a time so nested generics close cleanly, so `shl` / `shr` reassemble a
// shift only for a pair one start offset apart — what `NextLT` / `NextGT` ask.
struct RustPBase {
}

impl RustParserBase for RustPBase {
    fn next_lt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(0)) == 1;
    }

    fn next_gt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(0)) == 1;
    }
}

/// Runs `recognize` with the base ports installed.
pub fn with_rust_bases<T>(recognize: fn() -> T with (RustLexerBase, RustParserBase)) -> T {
    let mut base = RustBase {};
    let mut pbase = RustPBase {};
    with RustLexerBase => &mut base, RustParserBase => &mut pbase do {
        return recognize();
    };
}

/// Parses a whole Rust source file.
pub fn parse_rust<S: AsStrSlice>(source: S) -> rust::ParseResult {
    return with_rust_bases(|| rust::parse(source));
}
