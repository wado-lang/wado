//! What both Rust tools here need: the recognizer with its base ports
//! installed, and the WASI plumbing from a command line to file contents.

use rust from "../tests/grammars/RustLexer.g4"
    with {
        generator: {
            module: "../src/generator.wado",
            inputs: ["../tests/grammars/RustParser.g4"],
            output_dir: "../tests/generated/cst_rust",
        },
    };
use { RustLexerBase, RustParserBase, LexerView, Parser } from "../tests/grammars/RustLexer.g4";
use { eprintln, Stderr } from "core:cli";
use fs from "core:fs";
use { Preopens } from "wasi:filesystem";

// The Wado twin of `grammars/java/RustLexerBase.java`, which the ANTLR4 oracle
// runs; `tests/driver_cst_rust_test.wado` holds the copy that pins the pair.
struct RustBase {
}

impl RustLexerBase for RustBase {
    fn sof(&self, view: LexerView) -> bool {
        resume view.la(-1) == -1;
    }

    fn float_literal_possible(&self, view: LexerView) -> bool {
        resume view.la(-1) != '.' as i32;
    }

    fn float_dot_possible(&self, view: LexerView) -> bool {
        let c = view.la(1);
        if c == '.' as i32 || c == '_' as i32 {
            resume false;
        }
        if c >= 'a' as i32 && c <= 'z' as i32 || c >= 'A' as i32 && c <= 'Z' as i32 {
            resume false;
        }
        resume true;
    }
}

struct RustPBase {
}

impl RustParserBase for RustPBase {
    fn next_lt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(0)) == 1;
    }

    fn next_gt(&self, p: &Parser) -> bool {
        resume p.token_start(p.lt(1)) - p.token_start(p.lt(0)) == 1;
    }
}

pub fn parse_rust(source: &String) -> rust::ParseResult {
    let mut base = RustBase {};
    let mut pbase = RustPBase {};
    with RustLexerBase => &mut base, RustParserBase => &mut pbase do {
        return rust::parse(source);
    };
}

/// The `.rs` files an argument list names, directly or through
/// `--paths-from <file>`, which reads one path per line.
pub fn collect_paths(argv: &List<String>) -> List<String> with (Stderr, Preopens) {
    let mut paths: List<String> = [];
    for let mut i = 0; i < argv.len(); i += 1 {
        if argv[i] == "--paths-from" {
            assert i + 1 < argv.len(), "--paths-from needs a file";
            i += 1;
            match fs::read_to_string(&argv[i]) {
                Ok(list) => {
                    for let line of list.lines() {
                        if !line.is_empty() {
                            paths.push(line);
                        }
                    }
                },
                // An unreadable list yields no paths, which would otherwise
                // read as a clean run. Keep it as the one path that reports
                // itself.
                Err(e) => {
                    eprintln(`error: ${e}`);
                    paths.push(argv[i]);
                },
            }
        } else if argv[i].ends_with(".rs") {
            paths.push(argv[i]);
        }
    }
    return paths;
}
