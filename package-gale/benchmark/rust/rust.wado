// Parse throughput of the Gale-generated Rust parser, over a small program
// that `rustc --edition 2024` builds without a warning.

use { Stdout } from "core:cli";
use { MonotonicClock } from "wasi:clocks";
use { Benchmark } from "core:benchmark";
use { parse_rust } from "../../tools/rust_corpus.wado";

global INPUT: String = #include_str("./input.rs");

fn parse_input() {
    let result = parse_rust(&INPUT);
    if !result.ok() {
        let d = &result.diagnostics[0];
        panic(`rust: ${d.line}:${d.col}: ${d.message}`);
    }
}

test "input parses" {
    parse_input();
}

export fn run() with (Stdout, MonotonicClock) {
    let mut b = Benchmark { name: "gale-parse (Rust)", input_size: Option::Some(INPUT.len()) };
    b.run("", || parse_input());
}
