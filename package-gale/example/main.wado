//! CLI front end for the calculator: `arith <expression>` prints the result.
//!
//! `eval.wado` does the Kiln `use ... with { generator: ... }`, so building
//! this entry (re)generates the parser from `Arith.g4` as part of the
//! compile. Run it straight from source:
//!
//!   wado run package-gale/example/main.wado '2 * (3 + 4)'

use { args, println, eprintln, exit, Stdout, Stderr, Environment, Exit } from "core:cli";
use { eval } from "./eval.wado";

export fn run() with Stdout, Stderr, Environment, Exit {
    let arguments = args();
    if arguments.len() != 1 {
        eprintln("usage: arith <expression>");
        exit(1);
    }
    match eval(&arguments[0]) {
        Ok(v) => println(`{v}`),
        Err(m) => {
            eprintln(`error: {m}`);
            exit(1);
        },
    }
}
