//! Fails when a compiler source outside `name.rs` formats a minted name: a
//! `format!` whose text opens with the `$` every minted name starts with, or
//! with `INTERNAL_PREFIX`. Only `name.rs` knows a name format.
//!
//! Run from the repository root: `wado run` reaches only the current directory.

use { eprintln, exit, Stderr, Exit } from "core:cli";
use fs from "core:fs";
use { Preopens } from "core:fs";

global SRC: String = "wado-compiler/src";
global NAME_RS: String = "wado-compiler/src/name.rs";
global FORMAT: String = "format!(";

export fn run() with (Preopens, Stderr, Exit) {
    let walk = match fs::walk_dir(&SRC) {
        Ok(walk) => walk,
        Err(e) => fail(`${e}`),
    };
    let mut found = 0;
    for let walked of walk {
        let entry = match walked {
            Ok(entry) => entry,
            Err(e) => fail(`${e}`),
        };
        if !entry.path.ends_with(".rs") || entry.path == NAME_RS {
            continue;
        }
        let text = match fs::read_to_string(&entry.path) {
            Ok(text) => text,
            Err(e) => fail(`${e}`),
        };
        for let line of minted_name_lines(&text) {
            eprintln(`${entry.path}:${line}: a minted name formatted outside name.rs`);
            found += 1;
        }
    }
    if found > 0 {
        exit(1);
    }
}

/// The 1-based line of each `format!` in `text` whose format string opens a
/// minted name.
fn minted_name_lines(text: &String) -> List<i32> {
    let mut lines: List<i32> = [];
    let mut from = 0;
    while let Some(at) = text.substr_bytes(from, text.len()).find(&FORMAT) {
        let start = from + at;
        from = start + FORMAT.len();
        let rest = text.substr_bytes(from, text.len()).trim_start();
        if rest.starts_with("\"{INTERNAL_PREFIX}")
            || (rest.starts_with("\"$") && !rest.starts_with("\"${{"))
        {
            lines.push(line_of(text, start));
        }
    }
    return lines;
}

fn line_of(text: &String, offset: i32) -> i32 {
    let mut line = 1;
    for let b of text.substr_bytes(0, offset).bytes() {
        if b == b'\n' {
            line += 1;
        }
    }
    return line;
}

fn fail(message: String) -> ! with (Stderr, Exit) {
    eprintln(message);
    exit(1);
}

test "a minted name in a format string is found" {
    let text = "a\nlet x = format!(\"$v{i}\");\nlet y = format!(\n    \"{INTERNAL_PREFIX}e\",\n);";
    assert minted_name_lines(&text) == [2, 3];
}

test "a literal `${` and a plain format string pass" {
    let text = "format!(\"${{{}}}\", t); format!(\"{n}:{t}\"); \"$env\"";
    assert minted_name_lines(&text).is_empty();
}
